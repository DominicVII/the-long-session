# nothing to build and nothing to install — the game is one file
*.log
.DS_Store
Thumbs.db

# Scratch and debug artifacts. The underscore prefix is the convention
# used here for throwaway smoke-test scripts and their screenshot output;
# several had been committed by accident and were carrying ~2 MB of dead
# weight in the tree.
_*.ps1
_*.png
_*.log

# Backup copies of the game file taken before a risky change. Git history
# already holds every previous version, so a second copy in the tree is
# duplication that also doubles what the pack has to store.
*.bak
*.pre-*.html

# Agent and editor working directories — local tooling, not the project.
.claude/
.vscode/
