function onumLedgerCard(){
  const pool = [];
  try{ onumTablePeople().forEach(p => pool.push(p)); }catch(e){}
  try{ (G.members || []).forEach(p => { if(pool.length < 10 && p && !p.gone && p !== G.you && pool.indexOf(p) < 0 && (p.met || (p.manner && p.manner.held))) pool.push(p); }); }catch(e){}
  const rows = pool.slice(0, 8).map(p => {
    let L = null; try{ L = ledgerEnsure(p); }catch(e){}
    const M = onumManner(p);
    const saw = L && L.saw ? L.saw.slice(0, 3).map(x => onumEsc(x.t)).join("<br>") : "";
    const told = L && L.told ? L.told.slice(0, 2).map(x => onumEsc(x.t)).join("<br>") : "";
    return '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + onumEsc(p.name) + '</b> <span class="muted">· held ' + (M ? M.held : 0) + ' · said ' + (M ? M.said : 0) + ' · slips ' + (M ? M.slips : 0) + '</span><div class="muted">' + onumEsc(M ? M.rule : "") + '</div>' +
      (saw ? '<div><b>Saw.</b> ' + saw + '</div>' : '') + (told ? '<div><b>Was told.</b> ' + told + '</div>' : '') + '</div>';
  }).join("");
  const holds = onumEtiq().log.slice(0, 6).map(x => '<div class="muted">d' + x.d + ' · ' + onumEsc(x.who) + ' · ' + onumEsc(x.where) + ' · ' + onumEsc(x.why) + '</div>').join("");
  govCardOpen("The ledger", "What they know, and what they would not say", "A thing is on their ledger when they saw it or were told it. A hold is also on it. They keep the manner.", rows + '<div class="eyebrow">What was not said</div>' + (holds || '<p class="muted">Nobody has held a sentence yet.</p>'), null);
}
function onumPaperTail(){
  const E = onumEtiq();
  const held = E.log.filter(x => x.d === G.day).slice(0, 3);
  const press = (G.press || []).filter(p => p && !p.gone)[0] || (G.members || []).filter(p => p && p.kind === "press")[0];
  let voice = "";
  if(press && typeof onumSay === "function"){
    const M = onumManner(press);
    if(M && (M.strict || 0) >= 1 && onumNeedRoll(press, "paper", "news") > 55) voice = press.name + " spiked the line. It was not needed on the front, and it was not theirs to invent.";
    else voice = onumSay(press, "I will print what I stood in front of. I will not print a voice that was not in the room.");
  }
  const B = onumBillBits();
  const foe = (typeof WORLD_POWERS !== "undefined" && G.world) ? WORLD_POWERS.find(p => p.k === G.world.foe) : null;
  let foreign = "";
  if(foe){
    const rel = Math.round((G.realmRel || {})[foe.k] || 0);
    foreign = foe.t + " is " + ((typeof realmRelLabel === "function") ? realmRelLabel(rel) : "on the page") + " (" + rel + "). Their head is not your head.";
  }
  return '<div class="np__band">What was not printed</div><p class="np__matter">' + onumEsc(voice || "No reporter in the room chose a sentence.") + '</p>' +
    (held.length ? '<p class="np__matter">' + held.map(x => onumEsc(x.who) + " held a line (" + onumEsc(x.where) + ").").join(" ") + '</p>' : '<p class="np__matter">Nothing was held back this morning. That is also a fact.</p>') +
    '<div class="np__band">The bill, and the neighbours</div><p class="np__matter">' + onumEsc(B.title) + '. ' + onumEsc(B.line) + (foreign ? ' ' + onumEsc(foreign) : '') + '</p>';
}
{ const _np = npHTML; npHTML = function(){
