setInterval(function(){
  try{
    if(!G || !G.you) return;
    const N = onumNewsroom();
    if(N.airDay == null) N.airDay = G.day;
    else if(N.airDay !== G.day){ N.airDay = G.day; onumAirFileDay(); }
    const d = document.getElementById("onumSeeDock");
