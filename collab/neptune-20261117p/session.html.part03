}, 4000);


/* 20261114f */
/* 20261114f — the room stops repainting what has not changed.
   The night desk leads with the count. The wire keeps room for the rest of the day. */
{ const _mark = onumMark; onumMark = function(p, text){
  if(!p) return _mark.apply(this, arguments);
  const bill = (G.bill && !G.bill.done && G.bill.title) || "";
  const warm = p.rel ? Math.round((p.rel.warmth || 0) / 10) : 0;
  const key = p.id + "|" + (G.day || 0) + "|" + bill + "|" + warm + "|" + (text || "");
  if(!G._mark) G._mark = {};
  if(G._mark[key]) return G._mark[key];
  const row = _mark.apply(this, arguments);
  G._mark[key] = row;
  const ks = Object.keys(G._mark);
  if(ks.length > 60) delete G._mark[ks[0]];
  return row;
}; }
{ const _paint = onumStandPaint; onumStandPaint = function(){
  if(!G || !G.you) return;
  let veilEl = null;
  try{ veilEl = document.getElementById("veil"); }catch(e){}
  const dock = document.getElementById("onumSeeDock");
  if(veilEl && !veilEl.hidden){ if(dock) dock.hidden = true; return; }
  if(TALK && TALK.open){ if(dock) dock.hidden = true; return; }
  const pr = document.getElementById("prompt");
  if(pr && !pr.hidden && pr.classList.contains("is-live")){ if(dock) dock.hidden = true; return; }
  if(G._seeHide && dock){ dock.hidden = false; dock.classList.add("fold"); return; }
  let sig = "";
  try{
    sig = onumNear().map(p => p.id).join(",") + "|" + ((G.bill && G.bill.title) || "") + "|" + (G.day || 0) + "|" + (G.room || "");
  }catch(e){ sig = ""; }
  if(sig && sig === G._seeSig && dock && document.getElementById("onumSeeBody")){
    dock.hidden = false;
    dock.classList.toggle("fold", !!G._seeHide);
    return;
  }
  G._seeSig = sig;
  return _paint();
}; }
{ const _chain = onumChain; onumChain = function(text){
  G._seeSig = "";
  G._mark = {};
  const r = _chain.apply(this, arguments);
  try{
    const box = document.getElementById("tkSee");
    if(box){
      while(box.children.length > 6) box.removeChild(box.firstChild);
    }
  }catch(e){}
  return r;
}; }
{ const _seg = onumDailySegments; onumDailySegments = function(){
  if(G._dayCast && G._dayCastDay === G.day) return G._dayCast;
  const rows = _seg.apply(this, arguments);
  G._dayCast = rows;
  G._dayCastDay = G.day;
  return rows;
}; }
onumNightLedeHTML = function(){
  const n = onumNightBook();
  if(!n || !n.copy) return "";
  const c = n.copy;
  const polls = (n.polls || []).slice(-1)[0];
  const row = (k, v) => '<div style="display:flex;justify-content:space-between;gap:8px;margin:3px 0"><span class="muted">' + onumEsc(k) + '</span><b style="text-align:right">' + onumEsc(v) + '</b></div>';
  return '<h2>The Union Broadcast</h2>' +
    row("Call", (n.won ? "Held" : "Lost") + " by " + n.margin) +
    row("When they called it", n.late || "") +
    (polls ? row("Last sounding", (polls.paper || "A paper") + "  " + polls.v + "  ±" + (polls.moe || 3)) : row("Last sounding", "None trusted")) +
    (n.seats ? row("The House", n.seats) : "") +
    (c.note ? row("The desk", c.note) : "") +
    (typeof onumQuote === "function" ? onumQuote(c.anchor || "The anchor", "read aloud, not invented", c.read || "") : "<p>" + onumEsc(c.read || "") + "</p>");
};
{ const _mh = makeHeadlines; makeHeadlines = function(){
  const H = _mh.apply(this, arguments) || [];
  const special = {Loop:1, Broadcast:1, Election:1, Record:1, Echo:1, Runaway:1, Charter:1, Scale:1};
  let n = 0;
  const seen = {};
  return H.filter(h => {
    if(!h) return false;
    const body = String(h[1] || "").trim().toLowerCase();
    if(!body || seen[body]) return false;
    seen[body] = 1;
    if(special[h[0]]){
      if(n >= 3) return false;
      n++;
    }
    return true;
  });
}; }
if(!document.getElementById("onumFitCss")){
  const st = document.createElement("style");
  st.id = "onumFitCss";
  st.textContent = "#onumSeeDock{left:6px;right:auto;bottom:88px;width:min(320px,calc(100vw - 12px));max-height:28vh;z-index:40}" +
    "#onumSeeDock .h{flex-wrap:wrap;gap:4px}" +
    "#onumSeeDock .h b{flex:1 1 100%}" +
    "#onumSeeDock .h button{min-height:36px}" +
    "#onumSeeDock .row{align-items:center}" +
    "#tkSee,#tkComm{max-height:22vh;overflow:auto}";
  document.head.appendChild(st);
}


/* 20261115a */
/* 20261115a — the detail that was already true, put where you can read it.
   A person, a bill, a household, a state. Not a shorter version of the same sentence. */
try{ if(G){ G._dayCast = null; G._dayCastDay = -1; G._mark = null; G._seeSig = ""; } }catch(e){}

function onumStateBoard(){
  return (G.states || []).map(function(s){
    if(!s || !s.n) return "";
    let t = s.n + ": unrest " + Math.round(s.unrest || 0) + ", industry " + Math.round(s.ind || 0);
    if(s.cult) t += ", " + s.cult;
    const bt = s.bill && (s.bill.title || s.bill.t);
    if(bt) t += ". The statehouse is on " + bt;
    return t;
  }).filter(Boolean);
}
function onumBillDetail(){
  const b = G.bill && !G.bill.done ? G.bill : null;
  if(!b) return "No bill is on the floor. The desk is on the district and the standing.";
  let s = b.title || "The bill";
  if(b.line) s += ". " + String(b.line).replace(/\s+/g, " ").slice(0, 320);
  if(b.sponsor) s += " Sponsored by " + b.sponsor + (b.sponsorParty ? " (" + b.sponsorParty + ")" : "") + ".";
  if(b.voteDay) s += " The clerk has the roll on day " + b.voteDay + ".";
  try{
    const t = tallyBill(b, true);
    if(t) s += " Projected " + t.aye + " aye, " + t.no + " no, " + t.un + " not yet pledged.";
  }catch(e){}
  return s;
}
function onumHouseLines(){
  try{
    const hh = (townEnsure().hh || []).slice(0, 4);
    return hh.map(function(h){
      let t = "The " + (h.fam || "house") + "s on " + (h.street || "their street") + " are at " + Math.round(h.mood || 0);
      if(h.need) t += ", and what they want said is " + h.need;
      if(h.mem && h.mem.length && h.mem[h.mem.length - 1].t) t += ". They still remember: " + h.mem[h.mem.length - 1].t;
      return t + ".";
    });
  }catch(e){ return []; }
}
function onumPollDetail(){
  const p = (G.polls || []).slice(-1)[0];
  if(!p) return "No paper has published a sounding yet.";
  return (p.paper || "A paper") + " asked " + (p.n || "several hundred") + " households on day " + p.d + " about " + (p.ask || "the job") + " and printed " + p.v + ", plus or minus " + (p.moe || 3) + ". A sounding is not a count.";
}
function onumPersonDetail(p, lean){
  if(!p) return "";
  const bits = [];
  const party = p.party && typeof partyName === "function" ? partyName(p.party) : (p.party || "");
  const place = p.kind === "press"
    ? ((p.outlet || "the press") + (p.role ? ", " + p.role : ""))
    : [p.state, p.dist].filter(Boolean).join(" ");
  bits.push("I am " + (p.name || "who I am") + (place ? ", " + place : "") + (party ? ", " + party : "") + ".");
  if(p.bg && p.kind !== "press") bits.push("Before this I was " + String(p.bg).replace(/^an? /, "") + ".");
  if(p.kind === "press" && typeof p.trust === "number") bits.push("The gallery has me at trust " + Math.round(p.trust) + ". I file what I can source.");
  try{
    if(p.creed && typeof creedOf === "function"){
      const c = creedOf(p.creed);
      if(c && c.holds) bits.push("What I will not trade is " + c.t + ": " + String(c.holds).replace(/\s+/g, " ").slice(0, 160));
    }
  }catch(e){}
  try{
    if(typeof bioOf === "function" && p.state){
      const bio = bioOf(p);
      if(bio && bio.town) bits.push("I still answer to " + bio.town + (bio.trouble ? ", where " + bio.trouble : "") + ".");
    }
  }catch(e){}
  const b = G.bill && !G.bill.done ? G.bill : null;
  if(b && (p.kind === "member" || !p.kind)){
    try{
      const aye = typeof memberVote === "function" ? memberVote(p, b) > 0 : lean === "for";
      let why = "";
      try{ const st = stakeIn(p, b); if(st && st.why) why = " " + st.why; }catch(e){}
      bits.push("On " + b.title + " I am a " + (aye ? "yes" : "no") + "." + why);
    }catch(e){}
  } else if(b){
    bits.push("On " + b.title + " I am " + (lean === "for" ? "with it" : lean === "against" ? "against it" : "only listening") + ". That mark is mine. I am not the sponsor and I am not the chair.");
  }
  try{
    const saw = p.led && p.led.saw && p.led.saw[0];
    if(saw && saw.t) bits.push("I am still carrying, from day " + (saw.d || "?") + ": " + String(saw.t).slice(0, 160));
  }catch(e){}
  if(typeof p.margin === "number" && p.kind !== "press") bits.push("Last time I faced the district I came through by " + p.margin + (p.terms ? ", term " + p.terms : "") + ".");
  return bits.filter(Boolean).join(" ");
}

onumMark = function(p, text){
  const prev = {p:p, lean:"listen", line:""};
  try{
    const lean = onumLean(p);
    prev.lean = lean.lean;
    if(text && typeof readTone === "function"){
      const toneR = readTone(text);
      if(toneR && toneR.hostile && p.rel && p.rel.warmth < 12) prev.lean = "against";
      else if(toneR && toneR.warm && p.rel && p.rel.warmth > 0) prev.lean = "for";
    }
  }catch(e){}
  const about = onumPersonDetail(p, prev.lean);
  let line = about;
  try{ if(typeof onumSay === "function") line = onumSay(p, about); }catch(e){}
  prev.line = String(line || about).slice(0, 520);
  return prev;
};

onumDailySegments = function(){
  if(G._dayCast && G._dayCastDay === G.day && G._dayCastRich) return G._dayCast;
  const cast = onumCasters();
  const y = G.you;
  const bill = onumBillDetail();
  const poll = onumPollDetail();
  const houses = onumHouseLines();
  const states = onumStateBoard();
  const hot = states[0] || "";
  const next = states[1] || "";
  const kept = (G.chronicle && G.chronicle.kept && G.chronicle.kept.length) ? G.chronicle.kept[G.chronicle.kept.length - 1] : null;
  const seats = typeof onumSeatLine === "function" ? onumSeatLine() : "";
  let rival = null;
  try{ rival = rivalLive(); }catch(e){}
  const rows = cast.map(function(c, i){
    let about = "I have the sheet in front of me. I will not add a sentence I cannot source. I am " + c.p.name + ".";
    if(i === 0) about = "The lead is the floor. " + bill + " I am reading the text. I am not the sponsor and I am not the chair.";
    else if(i === 1) about = (y ? y.name + " is at " + Math.round(y.approval || 0) + " at home, " + Math.round(y.standing || 0) + " in the building, war chest " + (y.funds || 0) + ", last margin " + (y.margin != null ? y.margin : "not yet") + ". " : "") + poll + " I am not adding a moral to the figure.";
    else if(i === 2) about = "The wire, state by state. " + (hot ? hot + ". " : "") + (next ? next + ". " : "") + (seats ? "The House stands " + seats + "." : "The board is up.");
    else if(i === 3) about = kept ? "What was written, and I am only reading it. Day " + (kept.d || "?") + ", kept by " + (kept.who || "someone") + ": " + kept.t : "Nothing new has been kept. I will not invent a sentence to fill the hour.";
    else if(i === 4) about = rival ? (rival.name || "The rival") + " is still in it. Heat " + Math.round(rival.heat || 0) + ", stage " + (rival.stage || 0) + ". I am not their press secretary, and I am not yours." : "No rival is on the sheet. I will not invent one.";
    else about = houses.length ? "From the district, house by house. " + houses.join(" ") : "I am in the district. I will not describe a kitchen I have not stood in.";
    return {desk:c.desk, name:c.p.name, outlet:c.p.outlet || "", role:c.p.role || "", t:onumCastLine(c, about)};
  });
  G._dayCast = rows;
  G._dayCastDay = G.day;
  G._dayCastRich = 1;
  return rows;
};

onumAirFileDay = function(){
  const cast = onumCasters();
  if(!cast.length || !G.you) return;
  const line = cast[0].p.name + ", " + cast[0].desk + " at " + (cast[0].p.outlet || "the gallery") + ", filed: " + onumBillDetail().slice(0, 240) + " " + onumPollDetail().slice(0, 160) + " I am not the clerk.";
  try{ if(typeof feed === "function") feed(line, "news"); }catch(e){}
  try{ if(typeof onumKeep === "function") onumKeep(line, cast[0].p.id); }catch(e){}
};

function onumAnnotateNight(n){
  if(!n || n._board || !n.copy) return;
  n._board = 1;
  const board = onumStateBoard();
  const houses = onumHouseLines();
  if(!board.length && !houses.length) return;
  const extra = (board.length ? " State by state, off the sheet: " + board.join(". ") + "." : "") + (houses.length ? " The district that night: " + houses.slice(0, 3).join(" ") : "");
  n.copy.read = String(n.copy.read || "") + extra;
  n.copy.filed = String(n.copy.filed || "") + extra;
}
{ const _nb = onumNightBook; onumNightBook = function(){
  const n = _nb.apply(this, arguments);
  try{ onumAnnotateNight(n); }catch(e){}
  return n;
}; }
{ const _air = onumAirCard; onumAirCard = function(){
  try{ (onumNewsroom().nights || []).forEach(onumAnnotateNight); }catch(e){}
  return _air.apply(this, arguments);
}; }
{ const _np = npMatter; npMatter = function(){
  const s = _np.apply(this, arguments) || "";
  try{
    const houses = onumHouseLines().slice(0, 2).join(" ");
    const states = onumStateBoard().slice(0, 3).join(" ");
    return s + " " + onumBillDetail() + " " + onumPollDetail() + (states ? " " + states + "." : "") + (houses ? " " + houses : "");
  }catch(e){ return s; }
}; }
if(!document.getElementById("onumDetailCss")){
  const st = document.createElement("style");
  st.id = "onumDetailCss";
  st.textContent = "#onumSeeDock{max-height:40vh}#onumSeeBody span{font-size:12px;line-height:1.4;white-space:normal}#tkSee{max-height:28vh}";
  document.head.appendChild(st);
}


/* 20261115b */
/* 20261115b — say the point first. The name is already on the plate.
   The board shows the count, and every office by the person who holds it. */
try{ if(G){ G._dayCast = null; G._dayCastDay = -1; G._mark = null; G._seeSig = ""; } }catch(e){}

function onumStripIntro(s){
  let t = String(s || "").replace(/\s+/g, " ").trim();
  let n = 0;
  while(n++ < 5 && /^(I am |I'm |From the |Only as |Before this I |What I will not trade |I still answer )/i.test(t)){
    const cut = t.indexOf(". ");
    if(cut < 0 || cut > 180) break;
    t = t.slice(cut + 2).trim();
  }
  return t;
}
onumSay = function(p, about){
  const point = onumStripIntro(about);
  return point || String(about || "").replace(/\s+/g, " ").trim();
};
onumCastLine = function(c, about){
  if(!c || !c.p) return onumStripIntro(about);
  return onumSay(c.p, about);
};
onumPersonDetail = function(p, lean){
  if(!p) return "";
  const bits = [];
  const b = G.bill && !G.bill.done ? G.bill : null;
  if(b && (p.kind === "member" || !p.kind)){
    try{
      const aye = typeof memberVote === "function" ? memberVote(p, b) > 0 : lean === "for";
      let why = "";
      try{ const st = stakeIn(p, b); if(st && st.why) why = " " + st.why; }catch(e){}
      bits.push("On " + b.title + ", I am a " + (aye ? "yes" : "no") + "." + why);
    }catch(e){}
  } else if(b){
    bits.push("On " + b.title + ", I am " + (lean === "for" ? "with it" : lean === "against" ? "against it" : "listening") + ". That is my own mark.");
  }
  try{
    const saw = p.led && p.led.saw && p.led.saw[0];
    if(saw && saw.t) bits.push("What I am still carrying: " + String(saw.t).slice(0, 140));
  }catch(e){}
  if(typeof p.margin === "number" && p.kind !== "press") bits.push("The district last sent me back by " + p.margin + ".");
  if(!bits.length) bits.push(lean === "against" ? "I am not with that." : lean === "for" ? "I am with that." : "I heard it. I have not marked it.");
  return bits.join(" ");
};
talkDepth = function(m){
  try{
    if(!m) return "";
    const bits = [];
    const b = G.bill && !G.bill.done ? G.bill : null;
    if(b && (m.kind === "member" || !m.kind)){
      let aye = true; try{ aye = memberVote(m, b) > 0; }catch(e){}
      let why = ""; try{ const st = stakeIn(m, b); if(st && st.why) why = " " + st.why; }catch(e){}
      bits.push("On " + b.title + ", the vote is mine: " + (aye ? "aye" : "no") + "." + why);
    }
    if(m.intent && m.intent.t) bits.push("What I came in to do is " + m.intent.t + ".");
    if(m.fear && m.fear.t && ((m.rel && m.rel.trust) || 0) > 40) bits.push(m.fear.t);
    return bits.filter(Boolean).slice(0, 2).join(" ");
  }catch(e){ return ""; }
};
baReport = function(p){
  const t = (function(){ try{ return baTopic(); }catch(e){ return "the matter on the table"; } })();
  let al = 0; try{ const b = ssnBill(); al = b ? baAl(p, b.pos, b.title) : 0; }catch(e){}
  const care = (function(){ try{ return baCare(p); }catch(e){ return "what lands on my desk"; } })();
  const stake = al > 12 ? "My people can carry " + t + ", and I want it decided while I am still willing."
    : al < -12 ? "I cannot carry " + t + " as it is written."
    : "I will not commit " + care + " until there is a figure next to the speech.";
  return "On " + t + ", what I watch is " + care + ". " + stake + " What I need from the chair is one decision: hold it, change it, or let me go and do the work.";
};

function onumOfficeRows(){
  const rows = [];
  const push = (office, name, meta) => { if(office && name) rows.push({office:String(office), name:String(name), meta:meta || ""}); };
  const y = G.you;
  try{ if(y && y.name) push(typeof officeTitle === "function" ? officeTitle() : "The House", y.name, [y.state, y.dist, y.party && typeof partyName === "function" ? partyName(y.party) : ""].filter(Boolean).join(" · ") + " · sitting"); }catch(e){}
  try{ if(G.exec && G.exec.name) push(typeof execTitle === "function" ? execTitle() : "Executive", G.exec.name, [G.exec.party && typeof partyName === "function" ? partyName(G.exec.party) : G.exec.party, G.exec.from, G.exec.you ? "you" : ""].filter(Boolean).join(" · ")); }catch(e){}
  (G.presidents || []).slice(0, 5).forEach(p => { if(p && p.name) push("Former executive", p.name, [p.end, p.party].filter(Boolean).join(" · ")); });
  (G.court || []).forEach((j, i) => { if(j && j.name) push(i === 0 ? "Chief Justice" : "Associate Justice", j.name, j.by ? "seated by " + j.by : ""); });
  try{
    const st = presStaff();
    Object.keys(PRES_ROLES).forEach(k => { const o = st[k]; if(o && o.name) push(PRES_ROLES[k], o.name, o.town || o.prior || ""); });
  }catch(e){}
  try{
    const S = G.sc && G.sc.st;
    if(S) Object.keys(S).forEach(n => { if(S[n] && S[n].gov) push("Governor of " + n, S[n].gov, S[n].youGov ? "you" : ""); });
  }catch(e){}
  try{
    const cur = ofhCurrent();
    Object.keys(cur || {}).forEach(k => {
      const h = cur[k]; if(!h || !h.name) return;
      const title = ofhTitleOf(k);
      if(rows.some(r => r.name === h.name && r.office === title)) return;
      push(title, h.name, "");
    });
  }catch(e){}
  (G.history || []).slice(-10).reverse().forEach(h => {
    if(!h || !h.who) return;
    push(h.as || ("the " + (h.congress || "") + "th Congress"), h.who, h.act || "");
  });
  const seen = {};
  return rows.filter(r => { const k = r.office + "|" + r.name; if(seen[k]) return false; seen[k] = 1; return true; }).slice(0, 26);
}
function onumBar(pct, color){
  const w = Math.max(0, Math.min(100, Math.round(pct)));
  return '<span style="display:block;height:8px;background:#1a1e26;border-radius:2px;overflow:hidden"><i style="display:block;height:100%;width:' + w + '%;background:' + color + '"></i></span>';
}
function onumBoardHTML(){
  const race = G.lastRace || null;
  const seats = G.seatsBy || {};
  const total = Math.max(1, Object.keys(seats).reduce((n, k) => n + (seats[k] || 0), 0));
  const seg = (k, color) => {
    const n = seats[k] || 0;
    if(!n) return "";
    return '<i style="display:block;height:16px;width:' + (n / total * 100) + '%;background:' + color + '" title="' + onumEsc(k) + " " + n + '"></i>';
  };
  const polls = (G.polls || []).slice(-8);
  const pollMax = Math.max(100, ...polls.map(p => p.v || 0));
  const y = G.you || {};
  let eng = "";
  try{
    const E = typeof engEnsure === "function" ? engEnsure() : G.eng;
    if(E){
      const s = typeof engStage === "function" ? engStage(E) : 0;
      const S = (typeof engStageDef === "function" && engStageDef(s)) || (typeof ENG_STAGES !== "undefined" && ENG_STAGES[s]) || {t:"The Engine", d:""};
      const last = (E.log && E.log[0]) ? E.log[0] : null;
      eng = '<div class="eyebrow">The Engine, as far as it can read</div>' +
        '<p style="margin:4px 0"><b>' + onumEsc(S.t) + '</b> <span class="muted">' + onumEsc(S.d || "") + '</span></p>' +
        onumBar(E.p || 0, "#c9a24a") + '<div class="muted" style="font-size:11px;margin:2px 0 6px">Capability ' + Math.round(E.p || 0) + ' · Oversight ' + Math.round(E.safety || 0) + ' · ' + onumEsc(E.posture || "") + (E.agi ? " · awake" : "") + '</div>' +
        (last ? '<p>' + onumEsc("Day " + last.d + ": " + last.t) + '</p>' : '') +
        '<p class="muted">It can cite the record. It is not a person, and it does not hold an office.</p>';
    }
  }catch(e){}
  const offices = onumOfficeRows().map(r =>
    '<div style="display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #2a2618;padding:5px 0"><span style="color:#c9a24a;font:600 11px/1.3 system-ui">' + onumEsc(r.office) + '</span><span style="text-align:right"><b>' + onumEsc(r.name) + '</b>' + (r.meta ? '<div class="muted" style="font-size:11px">' + onumEsc(String(r.meta).slice(0, 90)) + '</div>' : '') + '</span></div>'
  ).join("");
  const states = (G.states || []).slice(0, 8).map(s =>
    '<div style="margin:5px 0"><div style="display:flex;justify-content:space-between;font:12px system-ui"><b>' + onumEsc(s.n) + '</b><span class="muted">unrest ' + Math.round(s.unrest || 0) + (s.gov ? " · " + onumEsc(s.gov) : "") + '</span></div>' + onumBar(s.unrest || 0, (s.unrest || 0) > 60 ? "#a44" : "#6a7a4a") + '</div>'
  ).join("");
  const call = race
    ? '<div style="text-align:center;padding:6px 0 10px;border-bottom:2px solid #c9a24a;margin-bottom:8px"><div style="font:700 11px system-ui;letter-spacing:.16em;color:#c9a24a">THE CALL · CONGRESS ' + onumEsc(race.congress || "") + '</div><div style="font:700 48px/1 Georgia,serif">' + (race.won ? "+" : "−") + onumEsc(race.margin) + '</div><div style="font:700 13px system-ui;letter-spacing:.12em">' + (race.won ? "HELD" : "LOST") + '</div><div class="muted">' + onumEsc((y.name || "") + (race.seeking ? " · " + race.seeking : "")) + '</div></div>'
    : '<p class="muted">No race has been called yet. The offices below are the ones the record can name tonight.</p>';
  const seatBar = '<div style="display:flex;height:16px;border-radius:2px;overflow:hidden;margin:4px 0 2px">' + seg("FED", "#3a5a8a") + seg("COM", "#8a3a3a") + seg("IND", "#8a7a3a") + '</div>' +
    '<div class="muted" style="font-size:11px">' + Object.keys(seats).filter(k => seats[k]).map(k => (typeof partyName === "function" ? partyName(k) : k) + " " + seats[k]).join(" · ") + '</div>';
  const pollBars = polls.length ? '<div style="display:flex;align-items:flex-end;gap:3px;height:46px;margin:6px 0">' + polls.map(p => '<i title="' + onumEsc((p.paper || "") + " " + p.v) + '" style="flex:1;background:#c9a24a;height:' + Math.max(8, Math.round((p.v || 0) / pollMax * 46)) + 'px"></i>').join("") + '</div><div class="muted" style="font-size:11px">Soundings, oldest to newest. A bar is not a count.</div>' : "";
  return call +
    '<div class="eyebrow">The House</div>' + seatBar +
    (pollBars ? '<div class="eyebrow">Soundings</div>' + pollBars : "") +
    '<div class="eyebrow">The states</div>' + states +
    '<div class="eyebrow">The offices, by the names that hold them</div>' + offices +
    eng;
}
function onumBoardCard(){
  govCardOpen("Election night", "The board", "The count, the House, the states, and every office by the person who holds it.", onumBoardHTML() + '<div class="card__actions"><button type="button" class="btn" id="bdEng">Open the Engine</button></div>', null);
  const b = document.getElementById("bdEng");
  if(b) b.addEventListener("click", function(){ try{ engCard(); }catch(e){} });
}
function onumPinBoard(){
  const bar = (typeof card !== "undefined" && card && card.querySelector) ? card.querySelector(".card__actions") : null;
  if(!bar || document.getElementById("onumBoardBtn")) return;
  const b = document.createElement("button");
  b.id = "onumBoardBtn"; b.type = "button"; b.className = "btn"; b.textContent = "The board";
  b.addEventListener("click", function(ev){ ev.preventDefault(); onumBoardCard(); });
  bar.appendChild(b);
}
function onumEngAnswer(q){
  let E = null, s = 0, S = {t:"The Engine", d:"", line:""};
  try{ E = engEnsure(); s = engStage(E); S = (typeof engStageDef === "function" ? engStageDef(s) : ENG_STAGES[s]) || S; }catch(e){}
  const qn = String(q || "").toLowerCase();
  if(E && s <= 1 && /who|why|should|office|mean/.test(qn)){
    return "This desk can carry a column. It cannot yet say what a bill means. Capability " + Math.round(E.p || 0) + ".";
  }
  const bits = [];
  if(!qn || /bill|floor|vote|house/.test(qn) || s >= 2){ try{ bits.push(onumBillDetail()); }catch(e){} }
  if(/office|who|governor|justice|court|cabinet|president|name|hold/.test(qn) || (E && s >= 3)){
    const offs = onumOfficeRows().slice(0, 8);
    if(offs.length) bits.push("The names on the offices: " + offs.map(o => o.office + ", " + o.name).join("; ") + ".");
  }
  if(/history|precedent|congress|record/.test(qn) || (E && s >= 3)){
    const h = (G.history || []).slice(-3);
    if(h.length) bits.push(h.map(x => (x.who || "The record") + (x.as ? ", as " + x.as : "") + ": " + (x.precedent || x.act || "")).join(" "));
  }
  if(/state|unrest|district|home/.test(qn) || (E && s >= 2)){
    try{ const st = onumStateBoard().slice(0, 3); if(st.length) bits.push(st.join(". ") + "."); }catch(e){}
  }
  if(E && s >= 4) bits.push("Left alone it keeps the count and reads the next bill without being asked. Oversight is " + Math.round(E.safety || 0) + ". Posture is " + (E.posture || "charter") + ".");
  if(E && E.log && E.log[0]) bits.push("Last thing it logged, day " + E.log[0].d + ": " + E.log[0].t);
  if(!bits.length) bits.push(S.line || S.d || "Nothing new is on the sheet.");
  bits.push("That is the machine at " + S.t + ". It is not a person, and it does not hold an office.");
  return bits.join(" ");
}
function onumEngDress(){
  const root = (typeof card !== "undefined") ? card : null;
  if(!root || document.getElementById("onumEngBoard")) {
    onumEngBind();
    return;
  }
  const h1 = root.querySelector("h1");
  if(!h1) return;
  const box = document.createElement("div");
  box.id = "onumEngBoard";
  let read = "";
  try{
    const offs = onumOfficeRows().slice(0, 6).map(o => o.office + ": " + o.name).join(" · ");
    read = offs ? "<p>What it can name tonight: " + onumEsc(offs) + ".</p>" : "";
  }catch(e){}
  box.innerHTML = '<div class="eyebrow">What it has actually read</div>' + read +
    '<p class="muted">Ask it about the bill, the offices, or the record. The answer comes from those, and it does not begin by introducing itself.</p>';
  h1.insertAdjacentElement("afterend", box);
  onumEngBind();
}
function onumEngBind(){
  const go = document.getElementById("engGo");
  const inp = document.getElementById("engIn");
  if(!go || !inp || go.dataset.onum) return;
  const n = go.cloneNode(true);
  n.dataset.onum = "1";
  go.parentNode.replaceChild(n, go);
  const run = async function(){
    const q = inp.value.trim();
    if(!q) return;
    inp.value = "";
    const out = document.getElementById("engOut");
    if(out) out.textContent = "Reading the record…";
    let text = "";
    try{
      const L = window.onumLiveTalk;
      if(L && L.reply && (typeof L.available !== "function" || await L.available())){
        const E = engEnsure();
        const s = engStage(E);
        const eng = {id:"engine", name:"The Engine", role:"a general intelligence", kind:"engine"};
        const r = await Promise.race([
          L.reply({npc:eng, channel:"engine", max:500, text:q, extra:"Answer the question first, in one to three sentences, from the Republic's record. Do not open by introducing yourself. Do not claim to be human or to hold an office. Stage: " + (ENG_STAGES[s] ? ENG_STAGES[s].t : "") + ". Asking: " + (G.you && G.you.name)}),
          new Promise(function(res){ setTimeout(function(){ res(null); }, 9000); })
        ]);
        if(r && r.text) text = onumStripIntro(r.text);
      }
    }catch(e){}
    if(!text) text = onumEngAnswer(q);
    if(out) out.textContent = text;
  };
  n.addEventListener("click", function(){ run(); });
  inp.addEventListener("keydown", function(ev){ if(ev.key === "Enter"){ ev.preventDefault(); run(); } });
}
{ const _ec = engCard; engCard = function(){
  const r = _ec.apply(this, arguments);
  try{ if(!(G.eng && G.eng.pend === "ceremony")) onumEngDress(); }catch(e){}
  return r;
}; }
{ const _air = onumAirCard; onumAirCard = function(){
  const r = _air.apply(this, arguments);
  try{ onumPinBoard(); }catch(e){}
  return r;
}; }
{ const _el = election; election = function(){
  const r = _el.apply(this, arguments);
  try{ onumPinBoard(); }catch(e){}
  return r;
}; }
{ const _apps = pbApps; pbApps = function(){
  const L = _apps.apply(this, arguments) || [];
  if(!L.some(x => x[0] === "soc-board")) L.push(["soc-board", "The board", "The count, the House, and every office by the name that holds it."]);
  return L;
}; }
{ const _go = pbAppGo; pbAppGo = function(id){
  if(id === "soc-board"){ setTimeout(function(){ try{ onumBoardCard(); }catch(e){} }, 30); return; }
  return _go.apply(this, arguments);
}; }


/* 20261115c */
/* 20261115c — the seams. One season. One name for the state. Letters that are not words
   do not stay. The Engine answers from a card built today, and a number has a field. */
function onumStateName(){
  return (G.country && G.country.name) || "the Republic";
}
function onumSyncSeason(){
  try{
    const wx = wxToday();
    const W = G.world;
    if(W && wx && wx.s) W.season = wx.s;
  }catch(e){}
}
{ const _we = worldEnsure; worldEnsure = function(){
  const W = _we.apply(this, arguments);
  try{ const wx = wxToday(); if(W && wx && wx.s) W.season = wx.s; }catch(e){}
  return W;
}; }
function onumWorldCard(){
  onumSyncSeason();
  let wx = null, W = null;
  try{ wx = wxToday(); }catch(e){}
  try{ W = worldEnsure(); }catch(e){}
  const name = onumStateName();
  const form = (G.regime && G.regime.form) || "republic";
  const formT = (typeof REGIMES !== "undefined" && REGIMES[form] && REGIMES[form].t) || form;
  const y = G.you || {};
  let bal = "";
  try{ const T = typeof tsStore === "function" ? tsStore() : G.treasury; if(T && T.bal != null) bal = " Treasury " + Math.round(T.bal) + "."; }catch(e){}
  const lines = [
    "Today is day " + (G.day || 0) + ". Season: " + ((wx && wx.s) || "unknown") + ". Weather: " + ((wx && wx.k) || "unknown") + (wx && wx.t != null ? ", " + wx.t + " degrees" : "") + ".",
    "The state is " + name + ", a " + formT + ".",
    "The sovereign is " + (y.name || "unnamed") + (y.approval != null ? ". Approval on the record: " + Math.round(y.approval) + " (you.approval)" : "") + "."
  ];
  if(W && W.war && W.war !== "none") lines.push("The wider world: " + (W.last || W.war) + ". Dead on the record: " + (W.dead || 0) + " (world.dead). Bread " + (W.bread != null ? Number(W.bread).toFixed(2) : "?") + " (world.bread)." + bal);
  else lines.push("No declared war on the record." + bal);
  try{ if(G.bill && !G.bill.done && G.bill.title) lines.push("On the floor: " + G.bill.title + "."); }catch(e){}
  let prior = "";
  try{
    const eras = typeof govEras === "function" ? govEras() : [];
    if(eras && eras.length > 1) prior = " Earlier forms of the state are on the record. The name today is " + name + ".";
  }catch(e){}
  return lines.join(" ") + prior;
}
function onumFixCountry(t){
  const name = onumStateName();
  let s = String(t || "");
  if(!/coalmere/i.test(name)){
    s = s.replace(/\bthe Free Republic of Coalmere\b/gi, name).replace(/\bCoalmere\b/g, name);
  }
  return s;
}
function onumPruneEngine(E){
  if(!E) return 0;
  let n = 0;
  ["makerLetters", "makerReplies"].forEach(function(key){
    const list = E[key];
    if(!Array.isArray(list)) return;
    list.forEach(function(item, i){
      if(!item) return;
      const recent = i >= list.length - 8;
      ["text", "reply", "to"].forEach(function(f){
        const v = item[f];
        if(typeof v !== "string") return;
        if(/%PDF-|endobj|endstream|\u0000/.test(v)){ item[f] = "[non-text input removed]"; n++; return; }
        const limit = recent ? 8000 : 2000;
        if(v.length > limit){ item[f] = v.slice(0, limit) + " [trimmed]"; n++; }
      });
    });
  });
  return n;
}
function onumGuardReply(text){
  const t = String(text || "");
  if(/[\u4e00-\u9fff]/.test(t)) return {ok:false, why:"wrong script"};
  const w = t.toLowerCase().split(/\s+/).filter(Boolean);
  const seen = {};
  let dup = 0;
  for(let i = 0; i + 6 <= w.length; i++){
    const g = w.slice(i, i + 6).join(" ");
    if(seen[g]) dup++; else seen[g] = 1;
  }
  if(dup > 8) return {ok:false, why:"loop"};
  return {ok:true, why:""};
}
function onumEngMemory(){
