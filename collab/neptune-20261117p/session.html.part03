{ const _ev = window.onumSessionEvent; window.onumSessionEvent = function(e){
  const r = _ev.apply(this, arguments);
  try{
    if(e && e.action === "speak" && typeof SSN !== "undefined" && SSN && (SSN.kind === "cabinet_meeting" || SSN.kind === "governor_council" || SSN.kind === "house_floor" || SSN.kind === "senate_floor")){
      const who = (e.actorId === "you" || (G.you && e.actorId === G.you.id)) ? G.you : byId(e.actorId);
      onumLiveReact(who, e.text);
    }
  }catch(x){}
  return r;
}; }

function onumRealmVoice(folk, pwr, about){
  const rel = (G.realmRel || {})[pwr.k] || 0;
  const g = (typeof REALM_GOV !== "undefined" && REALM_GOV[pwr.k]) || {};
  const seat = g.head || folk.title || "the chair at home";
  return folk.name + ", " + folk.title + " of " + pwr.t + ": I am not your head of state, and I will not speak as one. " + about + " What I carry home is mine. " + (rel < -25 ? "We are cold, and I will not warm it for the cable." : rel > 25 ? "We are on decent terms. That is not a blank." : "We are correct with each other. That is enough for today.") + (g.seat ? " I sit at " + g.seat + ", not in your capital." : "");
}
function onumSummitCard(k){
  const pwr = (typeof WORLD_POWERS !== "undefined" ? WORLD_POWERS : []).find(x => x.k === k);
  if(!pwr) return;
  let folk = []; try{ folk = realmFolk(k) || []; }catch(e){}
  const three = folk.filter(f => f && f.id !== "envoy").slice(0, 3);
  if(!three.length) three.push({id:"head", name:pwr.t, title:"head of government"});
  const rel = Math.round((G.realmRel || {})[k] || 0);
  const label = (typeof realmRelLabel === "function") ? realmRelLabel(rel) : "";
  const B = onumBillBits();
  const rows = three.map(f => {
    const lean = rel >= 20 ? "with the ask" : rel <= -20 ? "against the ask" : "not marking it";
    return '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + onumEsc(f.name) + '</b> <span class="muted">· ' + onumEsc(f.title) + ' · ' + lean + '</span><div>“' + onumEsc(onumRealmVoice(f, pwr, "I speak only for " + pwr.t + ".")) + '”</div></div>';
  }).join("");
  const body = '<p>' + onumEsc(pwr.t) + ' is ' + onumEsc(label || "at the table") + ' (' + rel + '). You are ' + onumEsc((typeof officeTitle === "function" ? officeTitle() : "the chair")) + '. They are not.</p>' +
    '<div class="eyebrow">The bill, if you raise it</div><p><b>' + onumEsc(B.title) + '</b> ' + onumEsc(B.line) + '</p>' + rows +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" data-sm="bill">Raise the bill</button><button type="button" class="btn btn--ghost" data-sm="trade">Offer trade</button><button type="button" class="btn btn--ghost" data-sm="press">Press a point</button><button type="button" class="btn btn--ghost" data-sm="hold">Say nothing</button></div><div class="dream" id="smOut"></div>';
  govCardOpen(pwr.t, "Heads, not costumes", "Each of them answers from their own chair. Posted to the three of them: who is with the ask, who is not, who holds.", body, null);
  card.querySelectorAll("[data-sm]").forEach(b => b.addEventListener("click", () => {
    const a = b.getAttribute("data-sm");
    G.realmRel = G.realmRel || {};
    const was = G.realmRel[k] || 0;
    let msg = "";
    if(a === "hold"){
      msg = "You do not say it. They notice the hold, and they do not fill it for you.";
      three.forEach(f => { const line = onumRealmVoice(f, pwr, "You kept it. I will not invent the sentence you did not say."); try{ onumWebPush(f.name, "personal", line.slice(0, 180)); }catch(e){} });
    } else {
      const bump = a === "trade" ? 4 : a === "press" ? (was > 0 ? 2 : -3) : 1;
      G.realmRel[k] = Math.max(-100, Math.min(100, was + bump));
      const about = a === "bill" ? "You raised " + B.title + ". I will answer for " + pwr.t + " only." : a === "trade" ? "A trade is a paper, not a friendship. I can carry a paper." : "You pressed. I will say at home that you pressed, in my name.";
      msg = three.map(f => onumRealmVoice(f, pwr, about)).join(" ");
      try{ setPrecedent("sat with " + pwr.t + " (" + a + ")", "a head of state speaks with another head, and neither wears the other's office", true); }catch(e){}
      try{ if(typeof onumKeep === "function") onumKeep(pwr.t + ": " + about, null); }catch(e){}
    }
    const o = el("smOut"); if(o) o.textContent = msg;
  }));
}
function onumPowersCard(){
  const powers = (typeof WORLD_POWERS !== "undefined" ? WORLD_POWERS : []);
  const rows = powers.map(p => {
    const rel = Math.round((G.realmRel || {})[p.k] || 0);
    const label = (typeof realmRelLabel === "function") ? realmRelLabel(rel) : "";
    let head = ""; try{ const f = (realmFolk(p.k) || []).find(x => x.id === "head"); if(f) head = f.name + ", " + f.title; }catch(e){}
    return '<div style="margin:8px 0"><b>' + onumEsc(p.t) + '</b> <span class="muted">· ' + onumEsc(label) + ' ' + rel + (head ? " · " + onumEsc(head) : "") + '</span><div class="card__actions"><button type="button" class="btn" data-pw="' + onumEsc(p.k) + '">Sit with their leaders</button></div></div>';
  }).join("");
  govCardOpen("The powers", "Your chair, and theirs", "You meet them as the head of this state. They answer as the heads of theirs.", rows || "<p class='muted'>No neighbours are on the map.</p>", null);
  card.querySelectorAll("[data-pw]").forEach(b => b.addEventListener("click", () => onumSummitCard(b.getAttribute("data-pw"))));
}
