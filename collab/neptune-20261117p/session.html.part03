c(p.name) + '</b><p>“' + onumEsc(onumSay(p, "I was there. I am not speaking for the couple.")) + '”</p></div>').join("");
  const vow = onumSay(m, "Yes. Not to the office. To you. We will tell it in our own names.");
  try{ setPrecedent("married " + m.name, "a marriage is two named people, and it stays on the record only if someone writes it down", true); }catch(e){}
  const kept = onumKeep(y.name + " married " + m.name + ".", m.id);
  try{ onumWebPush(m.name, "personal", "I married " + y.name.split(" ")[0] + ". I am saying it myself."); }catch(e){}
  setTimeout(function(){
    try{
      govCardOpen("The wedding", m.name, kept ? ((kept.outlet || kept.name) + " wrote it down.") : "Nobody wrote it down. The people who were there still know.", '<p>“' + onumEsc(vow) + '”</p>' + (lines || '<p class="muted">The room was small. That was the wedding.</p>') + '<div class="card__actions"><button type="button" class="btn btn--ghost" id="wedFam">The family book</button></div>', null);
      const b = el("wedFam"); if(b) b.addEventListener("click", () => onumFamilyCard());
    }catch(e){}
  }, 40);
  return vow;
};

onumPhoneVox = function(){
  try{ voxInit(); }catch(e){}
  const all = ((G.vox && G.vox.posts) || []);
  const mine = all.filter(p => p.mine);
  const nested = {};
  let b = '<div class="pb__h">Vox</div><p><small>Every post under your name, then what other people wrote back in their own words. Nothing here is rewritten.</small></p>';
  b += '<p><small>' + mine.length + ' under your name.</small></p>';
  if(!all.length) b += '<p>Nobody has spoken yet.</p>';
  let loose = true;
  mine.forEach(p => {
    b += '<div class="pb__row" style="border-left:3px solid #c9a24a;padding-left:6px"><span><b>' + onumEsc((G.you && G.you.name) || "You") + ' · you</b><br><small>' + onumEsc(String(p.t || "")) + '</small></span></div>';
    const replies = all.filter(r => r && !r.mine && r.reply === p.id);
    if(loose){
      all.filter(r => r && !r.mine && r.reply === true && r.day === p.day).slice(0, 2).forEach(r => replies.push(r));
      loose = false;
    }
    replies.slice(0, 3).forEach(r => {
      nested[r.id] = 1;
      let nm = "Someone"; try{ const a = byId(r.by); if(a && a.name) nm = a.name; }catch(e){}
      b += '<div class="pb__row"><span><b>' + onumEsc(nm) + '</b><br><small>' + onumEsc(String(r.t || "")) + '</small></span></div>';
    });
  });
  all.filter(r => r && !r.mine && r.reply === true && !nested[r.id]).slice(0, 4).forEach(r => {
    nested[r.id] = 1;
    let nm = "Someone"; try{ const a = byId(r.by); if(a && a.name) nm = a.name; }catch(e){}
    b += '<div class="pb__row"><span><b>' + onumEsc(nm) + '</b><br><small>' + onumEsc(String(r.t || "")) + '</small></span></div>';
  });
  all.filter(p => p && !p.mine && !p.reply && !nested[p.id]).slice(0, 8).forEach(p => {
    let nm = "Someone"; try{ const a = byId(p.by); if(a && a.name) nm = a.name; }catch(e){}
    b += '<div class="pb__row"><span><b>' + onumEsc(nm) + '</b><br><small>' + onumEsc(String(p.t || "").slice(0, 220)) + '</small></span></div>';
  });
  b += '<div class="pb__row"><button data-pbvoxw="1">Write on Vox</button></div>';
  return b;
};
{ const _vy = voxYouPost; voxYouPost = function(kind, target, written){
  const r = _vy.apply(this, arguments);
  try{
    const text = String(written || "");
    if(!text) return r;
    const pool = (G.members || []).filter(m => m && !m.gone && m.traits && ((m.voxAppetite || 0) > 35 || m.traits.temper > 60));
    const m = pool.length ? pool[Math.floor(Math.random() * Math.min(6, pool.length))] : null;
    if(!m) return r;
    const hot = /\b(lie|lied|resign|shame|corrupt)\b/i.test(text);
    const line = (hot ? "I will not pass that along as if it were mine. " : "I saw what was posted. I am not repeating it. ") + onumSay(m, hot ? "I have my own sentence, and it is not a kinder version of theirs." : "If it concerns my state, I will answer it there, not in their words.");
    voxInit();
    voxAdd({id:G.vox.id++, by:m.id, t:line, k:"human", v:hot ? -1 : 0, day:G.day, at:hhmm(), backs:0, hits:0, voices:[], mine:false, reply:true});
  }catch(e){}
  return r;
}; }

{ const _rm = renderMap; renderMap = function(sel){
  let g = "";
