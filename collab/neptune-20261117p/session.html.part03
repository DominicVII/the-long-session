/* 20261114a */
/* 20261114a — etiquette, the table, the powers, the ledger, the race, the paper, every path.
   No new kind of person. They keep a manner, and they do not speak as someone they are not. */
function onumEtiq(){
  if(!G.etiq || G.etiq.v !== 1) G.etiq = {v:1, log:[]};
  return G.etiq;
}
function onumManner(p){
  if(!p || p === G.you) return null;
  if(!p.manner || p.manner.v !== 1){
    const disc = (p.traits && p.traits.discretion) || 50;
    p.manner = {v:1, held:0, said:0, slips:0, strict:disc >= 64 ? 1 : 0, taught:false,
      rule:"I do not say aloud an office, a creed, or a name that is not mine. I do not say what the room does not need."};
  }
  return p.manner;
}
function onumNeedRoll(p, text, where){
  try{ return Math.abs(seedOf(String(p && p.id) + ":" + where + ":" + (G.day || 0) + ":" + String(text || "").length)) % 100; }
  catch(e){ return ((G.day || 0) * 13 + String(text || "").length) % 100; }
}
function onumNeeded(p, text, where){
  if(where === "cabinet" || where === "summit" || where === "reply") return true;
  const T = (p && p.traits) || {};
  const M = onumManner(p);
  const strict = M ? (M.strict || 0) : 0;
  const low = String(text || "").toLowerCase();
  const bill = G.bill && !G.bill.done ? String(G.bill.title || "") : "";
  const onBill = bill && low.indexOf(bill.toLowerCase().slice(0, 14)) >= 0;
  const home = p && p.state && low.indexOf(String(p.state).toLowerCase()) >= 0;
  const hot = (T.temper || 0) > 74;
  if(onBill || home || hot) return true;
  const disc = T.discretion || 42;
  const cut = (where === "vox" ? 46 : 62) + strict * 10;
  if(disc < cut && (T.temper || 40) > 48) return true;
  return onumNeedRoll(p, text, where) > (38 + strict * 12);
}
function onumHeld(p, why, where){
  const M = onumManner(p);
  if(!M) return;
  M.held++;
  if(M.held === 3 || M.held === 8) M.strict = Math.min(4, (M.strict || 0) + 1);
  if(!M.taught && M.held >= 3){
    M.taught = true;
    try{ remember(p, M.rule, 2, true); }catch(e){}
  }
  M.last = {d:G.day, where:where, why:why};
  const line = (p.name || "They") + " did not say it (" + where + "). " + why;
  try{ remember(p, "I did not say it. " + M.rule, 1); }catch(e){}
  try{ ledgerOwn(p, line); }catch(e){}
  const E = onumEtiq();
  E.log.unshift({d:G.day, id:p.id, who:p.name, where:where, why:why});
  if(E.log.length > 40) E.log.pop();
}
function onumGate(p, text, where){
  const raw = String(text || "").replace(/\s+/g, " ").trim();
  if(!p || p === G.you || !raw) return {say:true, text:raw, why:""};
  const key = String(p.id) + "|" + where + "|" + raw.slice(0, 70);
  if(p._gk === key && p._gr) return p._gr;
  const M = onumManner(p);
  let t = raw.replace(/[\u201c"]([^\u201d"]{32,})[\u201d"]/g, "what was said");
  const role = String(p.role || p.post || "").toLowerCase();
  const titles = ["president", "governor", "speaker", "secretary of state", "secretary of the treasury", "secretary of war", "secretary of defense", "attorney general", "chief justice"];
  let slip = false;
  titles.forEach(function(title){
    const re = new RegExp("\\b(I am|as|I'm) the " + title + "\\b", "i");
    if(re.test(t) && role.indexOf(title) < 0){
      slip = true;
      t = t.replace(re, "not as the " + title);
    }
  });
  if(G.you && G.you.name && t.indexOf("I am " + G.you.name) >= 0){
    slip = true;
    t = t.replace("I am " + G.you.name, "I am not " + G.you.name);
  }
  if(slip){
    if(M) M.slips++;
    t = "I will not speak as someone I am not. I am " + (p.role || p.name) + ". " + t;
    try{ remember(p, "I nearly spoke as someone else. I stopped.", 2); }catch(e){}
  }
  let res;
  if(!onumNeeded(p, t, where)){
    const why = "It was not needed, and it was not " + String(p.name || "theirs").split(" ")[0] + "'s to put in the room.";
    res = {say:false, text:"", why:why};
    onumHeld(p, why, where);
  } else {
    if(M) M.said++;
    if(where === "vox" && t.length > 320 && (p.traits && p.traits.discretion > 58)) t = t.slice(0, 300).replace(/\s+\S*$/, "") + ".";
    res = {say:true, text:t, why:""};
  }
  p._gk = key;
  p._gr = res;
  return res;
}

{ const _ss = setSay; setSay = function(t, n){
  try{
    const m = (typeof TALK !== "undefined" && TALK && TALK.open && TALK.m) ? TALK.m : null;
    const s = String(t || "");
    if(m && s && s.charAt(0) !== "\u201c" && s.charAt(0) !== '"'){
      const g = onumGate(m, s, "talk");
      if(!g.say){
        t = m.name.split(" ")[0] + " does not say it.";
        n = (n || "") + " " + g.why;
      } else t = g.text;
    }
  }catch(e){}
  return _ss.call(this, t, n);
}; }
