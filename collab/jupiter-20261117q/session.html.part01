  }
  g.globalCompositeOperation = "destination-out"; const fd = g.createLinearGradient(0, H * 0.62, 0, H); fd.addColorStop(0, "rgba(0,0,0,0)"); fd.addColorStop(1, "rgba(0,0,0,1)"); g.fillStyle = fd; g.fillRect(0, 0, W, H); g.globalCompositeOperation = "source-over";
  return VST.tex[kind] = vTex(c, kind === "far" ? 2 : kind === "mid" ? 3 : 4);
}
function vSkylineTexture(){
