  if(s.odd >= 5 && s.odd > good && s.odd > bad) return ["a thing no one can account for", "odd"];
  if(s.r > 0.35 && good > bad * 1.5) return ["a steward that looks after the country", "good"];
  if(s.r < -0.35 && bad > good) return ["a power that has taken the country out of its own hands", "bad"];
  if(s.fail >= 2 && s.fail > s.gift) return ["clever, and not as sure as it sounds", "doubt"];
