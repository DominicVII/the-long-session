async function cabAsk(p, you, text, kind, callOn){
  if(!p) return; const LT = window.onumLiveTalk; if(!LT || !LT.reply){ if(callOn){ const f = cabFallback(p); cabPaint(p, f); try{ tlog(p.name, f, "talk"); }catch(e){} try{ if(SSN) ssnPublish(); }catch(e){} } return; }
  const ctx = "You are in a " + (kind === "governor_council" ? "governor's council" : "cabinet meeting") + " chaired by " + (typeof ndYou === "function" ? ndYou().address || "the chair" : "the chair") + ", who has just spoken to the room or to you. Answer as the person you are, in your own words, in five to eight sentences: what is actually happening in your office, who at home pays, what you need from the chair, and one thing you will not pretend. Do not speak for anyone else. If it belongs to another office, say whose it is and why.";
  let out = ""; try{ const r = await Promise.race([LT.reply({npcId:p.id, channel:"face", text, extra:ctx, max:640}), new Promise(res => setTimeout(() => res(null), callOn ? 25000 : 120000))]); out = r && r.text ? String(r.text).trim() : ""; }catch(e){}
  if(!out){ if(!callOn) return; out = cabFallback(p); } else out = liveClean ? (liveClean(out) || out) : out;
  try{ speakAt(p, out); }catch(e){} cabPaint(p, out); try{ tlog(p.name, out, "talk"); }catch(e){} try{ lLog(p.name + ": " + out.slice(0, 160), "session"); }catch(e){}
  try{ if(SSN) ssnPublish(); }catch(e){}
}
