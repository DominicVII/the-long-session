  e.sal = clamp(Math.abs(w) / 16, 0.1, 1); e.rc = 0; e.last = e.d; if(e.who === undefined) e.who = /\byou\b|\byour\b/i.test(t) ? "you" : null;
  const neg = MOR_NEG.test(t), pos = MOR_POS.test(t); e.mor = neg && !pos ? -1 : pos && !neg ? 1 : (w < 0 ? -0.4 : w > 0 ? 0.4 : 0); e.trauma = e.sal >= 0.75 && e.mor < 0; return e;
}
function memRetention(m, e){
  psyEnrich(e); const conv = (m.traits && m.traits.conviction) || 50, since = Math.max(0, G.day - Math.max(e.d, e.last || e.d));
