  out.push({id:"senate", day, room:"senate", s:11, e:13, kind:"sits", title:"The Senate sits", topic:"the calendar", info:true});
  if(w === 1 || w === 3) out.push({id:"court", day, room:"court", s:10, e:12, kind:"argument", title:"The Court hears argument", topic:"the docket", info:true});
  out.forEach(e => { e.key = day + ":" + e.id; e.host = null; });
  return out;
}
function stdNowF(){ return (G.minute || 0) / 60; }
function stdActive(room){ if(dayType() !== "session") return null; const h = stdNowF(); return stdEntries().find(e => e.room === room && h >= e.s && h < e.e) || null; }
function stdAttends(m, e){
  if(!m || m.gone || e.info) return false;
  const roll = seedOf("att:" + m.id + ":" + e.key) % 100;
  if(m.kind === "member"){
    if(e.kind === "caucus") return m.party === e.party && roll < 88;
    if(e.kind === "hearing") return (m.cmte === e.com || m.post === e.com) && roll < 86;
