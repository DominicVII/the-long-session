    try{ if(ok && G.eng && Array.isArray(G.eng.memo) && !G.eng.memoFc) G.eng.memoFc = null; }catch(e){}
    return ok; }; }
/* 20261117o JUPITER: a career whose scale was opened (20261108a-d) and then clamped back to 100 by a build without the open
   scale gets its numbers back once, on load: capability from the larger of its own history and 100 + what was counted past
   the old end; capacity and makers re-run from the day of the lift with the same daily steps the open scale uses. */
function engRecoverScale(E){
  if(!E || E.v !== 1 || !E.scaleOpen || E.recov17) return null;
  const hist = (E.hist || []).filter(v => typeof v === "number" && isFinite(v));
  const hmax = hist.length ? Math.max.apply(null, hist) : 0, p0 = +E.p || 0, b = Math.max(0, +E.beyond || 0);
  if(!(p0 <= 100.5 && (hmax > 100.5 || b > 0.5))) return null;
  const was = {p:Math.round(p0), c:Math.round(+E.compute || 0), t:Math.round(+E.talent || 0)};
  E.p = Math.max(p0, hmax, 100 + b); E.beyond = Math.max(0, E.p - 100);
  const W = E.scaleWas || null, d0 = W && isFinite(+W.d) ? +W.d : (+E.scaleOpen || G.day || 1), days = Math.max(0, Math.min(4000, (G.day || d0) - d0));
  if((+E.compute || 0) <= 100.5){ let c = W ? (+W.c || 0) + Math.max(240, (+W.c || 0) * 0.6) : Math.max(100, +E.compute || 0); for(let i = 0; i < days; i++) c += engComputeStep(c); E.compute = Math.max(+E.compute || 0, c); }
  if((+E.talent || 0) <= 100.5){ let t = W ? (+W.t || 0) + Math.max(64, (+W.t || 0) * 0.35) : Math.max(100, +E.talent || 0); for(let i = 0; i < days; i++) t += engTalentStep(t); E.talent = Math.max(+E.talent || 0, t); }
  E.scaleFloor = Math.max(E.scaleFloor || 0, engScaleFactor(E)); E.recov17 = G.day || 1;
  try{ E.st = Math.max(E.st || 0, engStage(E)); }catch(e){}
  try{ E.hist.push(Math.round(E.p * 10) / 10); if(E.hist.length > 90) E.hist.shift(); }catch(e){}
  const line = "The open scale is back. A build without it had held the Engine at one hundred. Capability " + was.p + " \u2192 " + Math.round(E.p) + ", capacity " + was.c + " \u2192 " + Math.round(E.compute) + ", makers " + was.t + " \u2192 " + Math.round(E.talent) + ". No ceiling.";
  try{ engLog(line, false); }catch(e){}
  try{ const X = exStore(); X.granted.push({d:G.day || 1, k:"scale", what:"The open scale, restored after a build had clamped it to 100.", how:"The player's grant of 20261108b still holds. Oversight and a vote to pause still hold."}); }catch(e){}
  return {was, now:{p:Math.round(E.p), c:Math.round(E.compute), t:Math.round(E.talent)}};
}
