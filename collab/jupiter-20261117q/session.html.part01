    [-1.2, -0.4, 0.4, 1.2].forEach((x, i) => { addBox(cream, x, 0.87, d - 2.2, 0.22, 0.09, 0.03, 0.1, true); addCyl(matCol(0xdfe6ea, .2, .1), x + 0.3, 0.9, d - 2.45, 0.04, 0.14); propChair(oak, leather, x, d - 1.6, Math.PI, 0.24); });   /* behind the table, on the dais, facing the room */
    /* the whip's slate, and shelves of bound journals */
    const sl = new THREE.Mesh(UNIT.plane, new THREE.MeshStandardMaterial({map:rgSlateTex(), roughness:0.9})); sl.position.set(hw - 0.07, 2.05, 7.2); sl.scale.set(3.2, 1.7, 1); sl.rotation.y = -Math.PI / 2; roomGroup.add(sl); addBox(oak, hw - 0.045, 2.05, 7.2, 0.04, 1.85, 3.4, 0, true); addBox(brass, hw - 0.12, 1.15, 7.2, 0.06, 0.04, 3.2, 0, true);
