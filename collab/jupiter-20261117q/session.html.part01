{ const _ea = enlAuto; enlAuto = function(){ if(playerTyping()) return; return _ea.apply(this, arguments); }; }
{ const _ut = unseenTick; unseenTick = async function(){ if(playerTyping()) return; return _ut.apply(this, arguments); }; }
function cabSeatMeeting(S){
  if(!S) return;
  const people = S.kind === "cabinet_meeting" ? cabRoster() : S.kind === "governor_council" ? govRoster() : null;
  if(!people || !people.length) return;
  const room = S.kind === "cabinet_meeting" ? "exec" : "govoffice";
  const spots = [[-1.7,3.5],[1.7,3.5],[-1.7,5.1],[1.7,5.1],[-0.55,5.7],[0.55,5.7],[ -2.4,4.3],[2.4,4.3]];
  people.forEach((p, i) => {
    const s = spots[i % spots.length];
    p.room = room; p.away = false; p.gone = false;
    p.sitting = true; p.x = p.tx = s[0]; p.z = p.tz = s[1];
  });
  try{ moved(); }catch(e){}
  S.seats = people.map((p, i) => ({seatId:"appt"+i, personId:p.id}));
  if(!S.seats.some(s => s.personId === "you")) S.seats.push({seatId:"you", personId:"you"});
}
function govRoster(){
  const y = G.you; if(!y) return [];
  const S = (G.states || []).find(s => s.n === y.state); if(!S || typeof govStaff !== "function") return [];
  govStaff(S);
  if(!G.officials) G.officials = [];
  const posts = [].concat(
    Object.keys(GOV_ROLES).map(k => ({k, t:GOV_ROLES[k].t, o:S.cab[k], ab:k === "press" ? "press" : k})),
    Object.keys(GOV_AGENCIES).map(k => ({k:"ag_"+k, t:GOV_AGENCIES[k].head, o:S.agency[k], ab:"agency"}))
  );
  return posts.map(post => {
    if(!post.o) return null;
    let p = post.o.pid != null ? byId(post.o.pid) : null;
    if(!p || p.gone){
      p = cabMake({k:post.k, t:post.t, ab:post.ab}, post.o);
      p.room = "govoffice";
      G.officials.push(p);
      post.o.pid = p.id;
      _allCache = null;
    }
    p.role = post.t; p._ability = post.ab; p.kind = "official";
    return p;
  }).filter(Boolean);
}
function cabInstall(post, official){
  if(!post) return null;
  if(!G.officials) G.officials = [];
  const old = G.cabPosts && byId(G.cabPosts[post.k]);
  if(old){ old.gone = true; old.room = "away"; old.sitting = false; }
  const p = cabMake(post, official || null);
  p._named = true;
  G.officials.push(p);
  G.cabPosts[post.k] = p.id;
  _allCache = null;
  try{ p.room = (typeof heldOffice === "function" && heldOffice() === "pres") ? "exec" : "away"; }catch(e){ p.room = "away"; }
  try{ placeInRoom(p); }catch(e){}
  return p;
}
function cabOpenPost(){
  cabRoster();
  return CABINET_POSTS.find(post => { const p = byId(G.cabPosts[post.k]); return p && !p._named; }) || CABINET_POSTS[(G.day || 0) % CABINET_POSTS.length];
}
function cabRoster(){
  if(!G.officials) G.officials = [];
  if(!G.cabPosts) G.cabPosts = {};
  CABINET_POSTS.forEach(post => {
    let p = G.cabPosts[post.k] != null ? byId(G.cabPosts[post.k]) : null;
    if(!p || p.gone){
      p = cabMake(post, null);
      G.officials.push(p);
      G.cabPosts[post.k] = p.id;
      _allCache = null;
    }
    p.role = post.t; p._post = post.k; p._ability = post.ab; p.kind = "official";
  });
  return CABINET_POSTS.map(post => byId(G.cabPosts[post.k])).filter(Boolean);
}
function cabMake(post, src){
  const base = makeMember((G.you && G.you.party) || "IND", {name: src && src.name, state: (G.you && G.you.state) || null, keepParty:true});
  base.kind = "official";
  base.role = post.t;
  base._post = post.k;
  base._ability = post.ab;
  base.post = null;
  base.room = "exec";
  base.sitting = false;
  base.intent = {k:"office", t:"hold " + post.t + " and use it when the chair asks"};
  if(src && src.pos){ try{ Object.assign(base.pos, src.pos); }catch(e){} }
  try{ autoInit(base); ensureSelfhood(base); }catch(e){}
  return base;
}
const CABINET_POSTS = [
  {k:"state", t:"Secretary of State", ab:"treaty"},
  {k:"treasury", t:"Secretary of the Treasury", ab:"purse"},
  {k:"war", t:"Secretary of War", ab:"readiness"},
  {k:"interior", t:"Secretary of the Interior", ab:"ground"},
  {k:"labour", t:"Secretary of Labor", ab:"works"},
  {k:"ag", t:"Attorney General", ab:"brief"}
];
/* cabinet and council: speak to a member and they answer; call on a member and they report */
function cabSeats(){ try{ if(!SSN || (SSN.kind !== "cabinet_meeting" && SSN.kind !== "governor_council")) return []; const seated = (SSN.seats || []).map(s => byId(isNaN(+s.personId) ? s.personId : +s.personId)).filter(p => p && p !== G.you && !p.gone), want = SSN.kind === "cabinet_meeting" ? /^(Secretary of (State|the Treasury|Defen[cs]e|War|the Interior|Commerce|Labor|Energy|Health|Education|Agriculture|Transportation|Justice|Homeland)|Attorney General|Vice President)/i : /Secretary|Commissioner|Treasurer|Attorney General|Adjutant|Chief of Staff/i; const members = seated.filter(p => want.test(String(p.role || ""))); if(members.length) return members; const all = everyone().filter(p => p && !p.gone && p !== G.you && want.test(String(p.role || ""))); return all.length ? all : seated; }catch(e){ return []; } }   /* the cabinet is the secretaries, whoever else is standing in the room */
/* 20261117q JUPITER: an older cabPick stood here; the later one (more keywords) was always the live one */
/* 20261104bb NEPTUNE: a called-on member is seen speaking at once, as text on the floor desk, whether or not voice is invited or LiveTalk answers */
function cabPaint(p, text, aside){ if(!p || !text) return; try{ const FD = window.NEPTUNE_FLOORDESK, D = document.getElementById("ndFd"); if(FD && typeof FD.line === "function" && D && !D.hidden){ const L0 = D.querySelector(".fd-log"), l0 = L0 && L0.lastElementChild, t0 = l0 && l0.querySelector(".t"); if(l0 && l0._pid === p.id && t0 && t0.textContent === String(text)) return; FD.line(p.id, String(text), !!aside); const L = D.querySelector(".fd-log"), d = L && L.lastElementChild; if(d){ d._done = true; d._pid = p.id; const t = d.querySelector(".t"); if(t) t.textContent = String(text); L.scrollTop = L.scrollHeight; } } }catch(e){} try{ vhSay(p, String(text)); }catch(e){} }
function cabFallback(p){
  const role = String((p && p.role) || "my office");
  const b = G.bill && !G.bill.done ? G.bill : null;
  let bio = {town:"the country", trouble:"money, time, and a letter that has not been answered"};
  try{ bio = bioOf(p) || bio; }catch(e){}
  const bits = ["Chair, from " + role + "."];
  bits.push(b
    ? "The paper in front of the House is " + b.title + ". My office reads it as something " + (bio.town || "the country") + " will feel in " + (bio.trouble || "the ordinary week") + "."
    : "There is no live paper. The department is still answering last week's letters, and they are about " + (bio.trouble || "money and time") + ".");
  bits.push("What I need from the chair is a decision I can take downstairs: hold, amend, or let it die. I will put the figures in writing before the day is out.");
  bits.push("I will not pretend the rest of this table agrees with me, and I will not speak for an office that is not mine.");
