    [0, 1, 2, 3].forEach(i => { addCyl(brass, -hw + 0.4 + i * 0.5, 1.7, 0.45, 0.012, 0.18); }); addBox(oak, -hw + 1.3, 1.82, 0.4, 2.2, 0.06, 0.2, 0, true); addBox(oak, -hw + 1.3, 1.4, 0.4, 2.2, 0.04, 0.12, 0, true);
