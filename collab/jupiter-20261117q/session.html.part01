    [-hw + 0.9, hw - 0.9].forEach(x => { [0.25, -0.25].forEach(o => addCyl(black, x + o * 0.6, 0.7, 0.9, 0.02, 1.4)); addBox(black, x, 1.45, 0.9, 0.36, 0.24, 0.5, 0, true); addSphere(matCol(0x2a3440, .2), x, 1.45, 0.62, 0.07); addCyl(black, x, 0.7, 0.9, 0.025, 1.4); });
