  {id:"market", label:"The market", sub:"Bread, cloth and the better end of the district", x:-5.2, z:8.4, r:2.4, acts:() => purseShopActs("market")},
  {id:"hardware", label:"Hardware", sub:"Hinges, nails and neighbours", x:5.15, z:12.85, r:2.2, acts:() => purseShopActs("hardware")}); } }catch(e){}
try{ const _ch = (PROPS.district || []).find(p => p.id === "church"); if(_ch && !_ch._pu){ _ch._pu = true; const a0 = _ch.acts; _ch.acts = function(){ return a0.apply(this, arguments).concat(purseShopActs("church")); }; } }catch(e){}
let _purseT = 20;
function purseLive(dt){
  try{ purseChip(); }catch(e){}
  if(!G.running || G.room !== "district" || !G.you) return; _purseT -= dt; if(_purseT > 0) return; _purseT = 25 + Math.random() * 25;
  const cand = pursePeople().filter(p => p.room === "district"); if(!cand.length) return;
