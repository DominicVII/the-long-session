        {t:"Walk the corridor with them", c:"20m", off:done, run(){ spend(20, 3); c.kday = G.day; c.met = true; c.rapport = Math.min(4, (c.rapport || 0) + 1); try{ ripple(c, 3, "We walked the corridor together and it was almost pleasant.", 3); }catch(x){} you.standing = clamp(you.standing + 1, 0, 100);
