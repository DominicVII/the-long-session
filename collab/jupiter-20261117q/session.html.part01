    if(item.infl) y.influence = clamp(y.influence + item.infl, 0, 100);
    if(item.paper){ try{ paperCard(); }catch(e){} }
    if(item.gift === "hh"){ try{ const T = townEnsure(); const h = pick(T.hh); h.mood = clamp((h.mood || 50) + 8, 0, 100); h.mem = h.mem || []; h.mem.push({t:"a basket of groceries from you", d:G.day}); }catch(e){} }
