/* 20261117o JUPITER: end a sitting you chair (cabinet, council, press) for real: the chair adjourns, the engine session
   closes through window.onumSession.close(), and the floor desk is torn down, so E, walking and talk are yours again. */
window.onumEndChairedSitting = function(why){
  try{
    const S = window.ONUM_SESSION || {}; const live = (typeof SSN !== "undefined" && SSN) || (S.stage && S.stage !== "idle");
    if(!live) return false;
    const chair = (typeof SSN !== "undefined" && SSN && SSN.chairId === "you") || S.chairId === "you";
    if(!chair) return false;
    try{ G._ssnDismiss = {room:G.room, d:G.day}; }catch(e){}
    try{ tlog("You", "The meeting is adjourned.", "you"); }catch(e){}
    try{ if(window.onumSession && typeof window.onumSession.close === "function") window.onumSession.close(); }catch(e){}
    try{ leaveSittingQuiet(); }catch(e){}
    try{ G._chairEnded = {d:G.day, m:G.minute, why:why || "close"}; G._ssnDismiss = {room:G.room, d:G.day}; }catch(e){}
    try{ note("You adjourn the meeting. The room is yours again.", false); }catch(e){}
    return true;
  }catch(e){ return false; }
};
/* 20261117o JUPITER: Esc adjourns a sitting you chair, when nothing else is open to close first (a card, a talk, a prompt, the pause menu).
