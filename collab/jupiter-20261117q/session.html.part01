function execRich(w, d, h, hw){
  try{
    if(roomGroup.userData.rgExec) return; roomGroup.userData.rgExec = 1;
    const brass = matCol(0xb08b45, .35, .8), oak = matCol(0x4a2e1a, .6), cream = matCol(0xf3ecd9, .7), dark = matCol(0x1d1f26, .6), navy = matCol(0x1f2f4a, .9);
    [3.6, 6.6].forEach(z => nepWindow(-hw + 0.04, z, 0, 1.3, 1.9, 1.7));
    nepPortrait(hw - 0.04, 1.9, 4.2, 0, 0x3a2f26); nepPortrait(hw - 0.04, 1.9, 6.4, 0, 0x2f3a4a); nepPortrait(-hw + 0.04, 2.0, 9.6, 0, 0x4a2a22, 0.9, 1.2);
    nepFloorSeal("THE EXECUTIVE", 0, 4.4, 2.0);
    /* the desk, as it is actually kept: blotter, a pen set, the out-tray overflowing, a framed photograph, the nameplate */
    const dy = (DIM && DIM.desk) || 0.78, dz = 8.7;
    addBox(matCol(0x2f5a3a, .8), 0, dy + 0.006, dz, 1.1, 0.012, 0.6, 0, true);
    addBox(brass, -0.55, dy + 0.03, dz - 0.15, 0.24, 0.05, 0.12, 0, true); addCyl(dark, -0.6, dy + 0.12, dz - 0.15, 0.008, 0.16); addCyl(dark, -0.5, dy + 0.12, dz - 0.15, 0.008, 0.16);
    for(let k = 0; k < 7; k++) addBox(cream, 0.6, dy + 0.02 + k * 0.022, dz + 0.05, 0.3, 0.016, 0.22, 0.12 * ((k % 3) - 1), true);
    addBox(brass, -0.3, dy + 0.1, dz + 0.2, 0.18, 0.22, 0.02, 0.3, true);
    try{ propPlaque(0, dy + 0.12, dz - 0.36, Math.PI, "THE EXECUTIVE", "", 0.7, 0.1); }catch(e){}
    /* the cabinet table, under the windows: chairs and blotters set, nothing on it yet (inert placeholder) */
    const C = NEP_BF_SPOTS.cabinetTable; addBox(oak, C.x, 0.38, C.z, 1.1, 0.76, 2.8, 0, true);
    for(let i = 0; i < 4; i++){ const z = C.z - 1.05 + i * 0.7; [-1, 1].forEach(sd => { addBox(navy, C.x + sd * 0.8, 0.26, z, 0.42, 0.52, 0.42, 0, true); addBox(navy, C.x + sd * 1.0, 0.7, z, 0.06, 0.5, 0.42, 0, true); addBox(cream, C.x + sd * 0.32, 0.77, z, 0.24, 0.01, 0.3, 0, true); }); }
    nepPlaceholder(C.x, C.z, "THE CABINET TABLE", "The Cabinet Room");
    try{ propPlaque(0, 2.35, 0.1, 0, "THE OFFICE OF THE EXECUTIVE", "South wing", 1.6, 0.22); }catch(e){}
  }catch(e){ try{ console.warn("exec rich", e); }catch(x){} }
}
function govRich(w, d, h, hw){
