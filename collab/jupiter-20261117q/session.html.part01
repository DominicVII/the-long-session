function purseShopActs(shop){
  const y = G.you, P = purseOf(y);
  return Object.keys(PURSE_ITEMS).filter(k => PURSE_ITEMS[k].shop === shop).map(k => { const it = PURSE_ITEMS[k], base = {c:"ƒ " + it.price + (it.min ? " · " + it.min + "m" : ""), off:P.cash < it.price};
    const go = mode => () => { const r = purseBuy(y, k, {mode}); setSay(it.line ? "“" + it.line + "”" : cap(it.t) + ".", r.ok ? fx(r.lines.slice(0, 3).join(" · ") || "Nobody paid it any mind.", "ƒ " + Math.floor(purseOf(y).cash) + " left") : fx(r.msg, "")); };
