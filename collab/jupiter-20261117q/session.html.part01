function inqGen(){ const S = inqStore(); if(!S.gen) S.gen = []; S.gen.forEach(n => { if(!INQ_BY[n.id]) INQ_BY[n.id] = n; }); return S.gen; }
function engGenCount(){ try{ const S = G.inq; return S && S.gen ? S.gen.filter(n => S.done[n.id]).length + (S.genGone || 0) : 0; }catch(e){ return 0; } }
