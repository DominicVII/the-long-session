    try{ if(ok && G.eng && G.eng.v === 1){ if(!G.eng.scaleOpen) engGrantScale(G.eng); const r = engRecoverScale(G.eng); if(r) G._engRecov17 = r; } }catch(e){ console.warn("eng recover", e); }
    return ok; }; }
