    if(w === G.you){ G.you.saw = G.you.saw || []; G.you.saw.push({actor:actor.id, name:actor.name, item:item.t, key:item.key, r, day:G.day}); if(G.you.saw.length > 8) G.you.saw.shift(); lines.push("You see " + actor.name + " buying " + item.t + ". Your own feeling about it: " + r + "."); return; }
    if(actor === G.you){ try{ ripple(w, dW, "They bought " + item.t + " where everyone could see. I felt " + r + ".", Math.abs(dW), r === "jealous" || r === "envy"); }catch(e){} net += dW; }
    else { const P = purseOf(w); P.feel[actor.id] = (P.feel[actor.id] || 0) + dW; }
    if(line){ try{ w.say = line; w.sayT = 4.2; w.sayTo = actor.id; speakAt(w, line); }catch(e){} }
    /* and they may do something about it, by their own will */
