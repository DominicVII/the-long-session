    g.fillStyle = "rgba(255,226,150,.7)"; for(let wy = ground - bh + 8; wy < ground - 8; wy += 14) for(let wx = x + 7; wx < x + bw - 8; wx += 13) if(r() < 0.5) g.fillRect(wx, wy, 5, 7);
    x += bw + 2 + r() * 14; }
