      const aff = Object.keys(PURSE_ITEMS).filter(k => PURSE_ITEMS[k].price <= P.cash * (will.thrift > 60 ? 0.4 : 0.8) && PURSE_ITEMS[k].shop !== "newsstand" && k !== "box" && k !== "rent");
      if(aff.length){ const k = will.boast > 55 ? aff.sort((a, b) => PURSE_ITEMS[b].show * 1000 + PURSE_ITEMS[b].price - (PURSE_ITEMS[a].show * 1000 + PURSE_ITEMS[a].price))[0] : pick(aff); if(PURSE_ITEMS[k].show < 2 || chance(0.5)) purseBuy(p, k, {quiet:PURSE_ITEMS[k].show < 2}); }
