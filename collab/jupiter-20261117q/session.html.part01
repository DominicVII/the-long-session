/* the wire, as one quiet line above the bottom bar: the newest headline, then the next, every few seconds. Click it for the Ledger. */
(function(){
  let el0 = null, i = 0, last = "";
  const mk = () => { if(el0 && el0.isConnected) return el0; el0 = document.createElement("div"); el0.id = "hmWire"; el0.title = "The wire. Click to read the Ledger.";
    el0.style.cssText = "position:fixed;left:8px;right:8px;z-index:10049;background:#12151a;color:#d8d2bf;border:1px solid #3a424d;border-radius:6px;padding:3px 10px;font:12px/1.3 system-ui,sans-serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;opacity:.95";
    el0.addEventListener("click", () => { try{ if(G.you && veil.hidden) paperCard(); }catch(e){} }); document.body.appendChild(el0); return el0; };
  const place = () => { const w = mk(); const tops = ["hmBar", "ndFd"].map(id => document.getElementById(id)).filter(e => { if(!e || e.hidden || (e.closest && e.closest("#sxDock"))) return false; const cs = getComputedStyle(e), r = e.getBoundingClientRect(); return cs.display !== "none" && cs.visibility !== "hidden" && r.width > 0 && r.height > 0; }).map(e => e.getBoundingClientRect().top); const top = tops.length ? Math.min.apply(null, tops) : innerHeight; w.style.bottom = Math.max(4, Math.round(innerHeight - top + 4)) + "px"; };
  const tick = () => { try{ const w = mk(); if(!G || !G.running || !G.you || !veil.hidden){ w.style.display = "none"; return; } let H = []; try{ H = makeHeadlines(); }catch(e){} if(!H.length){ w.style.display = "none"; return; } w.style.display = "block"; const h = H[i++ % H.length]; const txt = String(h[0]).toUpperCase() + "  " + String(h[1]).replace(/<[^>]+>/g, ""); if(txt !== last){ w.innerHTML = '<b style="color:#c9a24a;letter-spacing:.12em;font-size:10px;margin-right:8px">THE WIRE</b>'; w.appendChild(document.createTextNode(String(h[0]).toUpperCase() + "  " + String(h[1]).replace(/<[^>]+>/g, ""))); last = txt; } place(); }catch(e){} };
  setInterval(tick, 7000); setInterval(() => { try{ place(); }catch(e){} }, 1500); setTimeout(tick, 1500);
})();
function engTick(){ try{ const E = G.eng; if(!E || E.pend !== "ceremony" || E.cerDay === G.day || !G.running || !veil.hidden || (TALK && TALK.open)) return; engCeremony(); }catch(e){} }

/* ordinary people talk about it, in the words of their own stake */
const ENG_TALK = [
  [["The Treasury's adding engines never miss a column. I miss that.", "My brother-in-law keeps the Treasury books. He says the machines do them by lunch."], ["Then what does he do after lunch?", "He says that is the question."]],
  [["The Post Office has a machine that reads my handwriting. Mine. Nobody reads my handwriting.", "They sorted the pension mail by machine. It came on time for once."], ["I would take that. I would also take being asked.", "On time is on time. Do not complain."]],
  [["Did you read about the reading engines? They summarise a bill in one page.", "My clerk's been reading with one of those machines. She says it reads faster than she thinks."], ["Does it read the footnotes?", "That is where she says it earns its keep."]],
  [["A machine found the clause nobody read in the Budget Act. Someone is going to be embarrassed.", "They say the reasoning engines argue better than the committee staff."], ["Better than the committee is a low bar.", "Better than me is the bar I am worried about."]],
  [["They gave a machine a week and a goal and it came back with the goal done.", "My daughter's school has a working engine. It teaches her what I cannot."], ["Does she still need you?", "More than ever, which is the odd part."]],
  [["The Engine is awake. My mother asked it about her knees. It answered her.", "I asked the Engine whether I should run again. It asked what I wanted first."], ["Did you tell it?", "I told it. I am still thinking about what it said back."]]
];
(function(){ const prev = lifeContext; lifeContext = function(){ const out = prev(); try{ const E = G.eng; if(E){ const s = Math.min(5, engStage(E)), t = ENG_TALK[s]; if(t) out.push({k:"eng:" + s, a:t[0], b:t[1], w:3}); const eco = E.eco; if(eco && eco.riots) out.push({k:"eng:strike", a:["They closed the clerks' hall in the next county over a machine.", "Did you hear about the hall that shut for the machines?"], b:["I heard. I do not know whose side to be on.", "Both sides are right, that is what makes it ugly."], w:3}); } }catch(e){} return out; }; })();

/* ══ 20261017d · who speaks aloud: the first line is typed; they speak out loud only when you speak or ask them to; they keep typing if they have more ══ */
const NPCV = {mode:"ask", until:0, more:0};
try{ const v = localStorage.getItem("onum.npcv"); if(v === "always" || v === "never" || v === "ask") NPCV.mode = v; }catch(e){}
function voiceInvited(){ return NPCV.preview || NPCV.mode === "always" || (NPCV.mode === "ask" && (G.t || 0) < NPCV.until); }
{ const _sp = speak; speak = function(p, text, vol){ try{ if(p && p !== G.you && !voiceInvited()) return; }catch(e){} return _sp.apply(this, arguments); }; }
{ const _ms = micStart; micStart = function(){ try{ if(micReady()) NPCV.until = (G.t || 0) + 90; }catch(e){} return _ms.apply(this, arguments); }; }
{ const st = document.createElement("style"); st.textContent = "#tkOwnMic.is-live{background:var(--bad,#8e2f3b);color:#fff;border-color:var(--bad,#8e2f3b)}"; document.head.appendChild(st); }
{ const _am = appendMsg; appendMsg = function(kind, text, who){
    try{ if(kind === "you" && text){ if(/\b(be quiet|stop talking|keep it down|no voices?|just type|text only|shut up)\b/i.test(text)) NPCV.until = 0; else if(/\b(speak|say it|say that|out loud|aloud|talk to me|use your voice|tell me out loud)\b/i.test(text)) NPCV.until = (G.t || 0) + 120; NPCV.more = 0; } }catch(e){}
    return _am.apply(this, arguments); }; }
/* ── you can always just say it: a line to type into, and a microphone, whoever you are talking to; the buttons are things you can do, not the only things you can say ── */
const TKOWN_BUSY = {};
function tkOwnMount(m){
  const T = el("talk"); if(!T) return; let box = el("tkOwn");
  if(!box){
    box = document.createElement("div"); box.id = "tkOwn"; box.style.cssText = "display:flex;gap:6px;margin:8px 0 4px;align-items:center";
    box.innerHTML = '<input id="tkOwnIn" type="text" maxlength="400" autocomplete="off" placeholder="Say it in your own words…" style="flex:1;min-width:0;padding:7px 9px;border:1px solid var(--line-soft,#555);border-radius:4px;background:rgba(0,0,0,.25);color:inherit"><button type="button" class="btn" id="tkOwnGo">Say it</button><button type="button" class="btn btn--ghost" id="tkOwnMic" title="Speak aloud (or hold V)">🎤</button>';
    const anchor = el("tkNote") || el("tkActs"); if(anchor && anchor.parentNode) anchor.parentNode.insertBefore(box, anchor); else T.appendChild(box);
    ["keydown", "keyup", "keypress"].forEach(k => box.addEventListener(k, e => e.stopPropagation()));
    /* a line is only taken from the box when it can be sent: a second one typed while the first is being answered stays where it is */
    const send = () => { const i = el("tkOwnIn"), t = (i.value || "").trim(); if(!t || !TALK.open || !TALK.m || TKOWN_BUSY[TALK.m.id]) return; i.value = ""; tkOwnSay(TALK.m, t); };
    el("tkOwnGo").addEventListener("click", send);
    el("tkOwnIn").addEventListener("keydown", e => { if(e.key === "Enter"){ e.preventDefault(); send(); } else if(e.key === "Escape"){ e.preventDefault(); const i = el("tkOwnIn"); if(i.value.trim()){ i.blur(); } else { i.blur(); try{ closeTalk(); }catch(x){} } } });
    /* a key you were holding when the box took focus never sends its release to the walk, so let go of everything as the box is entered */
    el("tkOwnIn").addEventListener("focus", () => { try{ for(const k in keys) keys[k] = false; }catch(e){} });
    el("tkOwnMic").addEventListener("click", () => { try{
      if(typeof listening !== "undefined" && listening){ micStop(); el("tkOwnMic").classList.remove("is-live"); return; }
      if(!micReady()){ aloudFallback("This browser cannot listen."); try{ el("tkOwnIn").focus(); }catch(e){} return; }
      micStart(); el("tkOwnMic").classList.toggle("is-live", !!listening);
      const poll = setInterval(() => { try{ if(typeof listening === "undefined" || !listening || !TALK.open){ const b = el("tkOwnMic"); if(b) b.classList.remove("is-live"); clearInterval(poll); } }catch(e){ clearInterval(poll); } }, 400);
    }catch(e){} });
  }
  box.hidden = false; try{ const c = el("chat"); if(c) c.hidden = false; }catch(e){}
  /* type first, on a desktop with a pointer: the cursor is waiting in the box. On a touch screen it is not, or the keyboard would cover the talk */
  /* 20261110by: focus the box even if the canvas still has pointer capture,
     so a typed W/S does not walk you out of the talk. Skip only if already typing. */
  setTimeout(() => { try{
    if(!TALK.open || TALK.m !== m) return;
    const a = document.activeElement;
    const typing = a && (a.tagName === "INPUT" || a.tagName === "TEXTAREA" || a.isContentEditable);
    if(!typing && window.matchMedia && matchMedia("(pointer:fine)").matches) el("tkOwnIn").focus();
  }catch(e){} }, 120);
}
async function tkOwnSay(m, text){
  if(TKOWN_BUSY[m.id]) return; TKOWN_BUSY[m.id] = 1; try{ const g = el("tkOwnGo"); if(g) g.disabled = true; }catch(e){}
  try{
    appendMsg("you", text); setSay("…", "");
    let out = ""; const LT = window.onumLiveTalk;
    try{ if(LT && typeof LT.reply === "function" && (typeof LT.available !== "function" || await LT.available())){ const r = await Promise.race([LT.reply({npcId:m.id, channel:"face", text}), new Promise(r => setTimeout(() => r(null), 25000))]); if(r && r.text) out = liveClean(r.text) || r.text; } }catch(e){}
    if(!out){ try{ out = improvise(m, text); }catch(e){} }
    if(!out) out = pick(["Go on.", "Mm.", "Say that again, slowly?"]);
    try{ m.chat = m.chat || []; m.chat.push({role:"user", content:text}, {role:"assistant", content:out}); if(m.chat.length > onumLim(40,"npc")) m.chat.splice(0, m.chat.length - onumLim(40,"npc")); }catch(e){}
    if(TALK.open && TALK.m === m){ appendMsg("them", out, surname(m.name)); setSay(out, ""); }
    try{ speakAt(m, out); }catch(e){}
  } finally { delete TKOWN_BUSY[m.id]; try{ const g = el("tkOwnGo"); if(g) g.disabled = false; }catch(e){} }
}
/* they may keep typing if they have more to say; they may also decide they do not */
function fwMore(m, onText){
  try{ const LT = window.onumLiveTalk; if(!LT || typeof LT.reply !== "function") return false; const tok = FW.n;
    Promise.resolve(LT.reply({npcId:m.id, channel:"face", stage:"You spoke first and the player has not answered yet. Decide whether you have anything more to add, as a person would who is not sure they were heard. If you do, say it in one or two sentences, in your own words, and do not repeat yourself. If you are content to wait, reply with exactly: ...", text:"(waiting)"}))
      .then(r => { if(tok !== FW.n || !r || !r.live || !r.text) return; const t = liveClean(r.text); if(t && !/^\.{2,}$|^…$/.test(t.trim())) onText(t); }).catch(() => {});
    return true; }catch(e){ return false; }
}
