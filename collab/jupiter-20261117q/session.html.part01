/* ══ 20261016i · gateways, not floating doors: the outdoor doors are now arches and a State House front, people are kept out of walls, and strangers talk through what they understand ══ */
const GATE = {grp:null, room:null, tex:{}};
function gatePlate(a, b){
  const k = a + "|" + b; if(GATE.tex[k]) return GATE.tex[k]; const c = vCanvas(512, 128), g = c.getContext("2d");
  g.fillStyle = "#1d2a22"; g.fillRect(0, 0, 512, 128); g.strokeStyle = "#c9a24a"; g.lineWidth = 4; g.strokeRect(8, 8, 496, 112);
  g.fillStyle = "#e3c06a"; g.textAlign = "center"; g.textBaseline = "middle"; g.font = "bold 46px Georgia, 'Times New Roman', serif"; g.fillText(a, 256, 52); g.font = "italic 26px Georgia, serif"; g.fillStyle = "#cdb98a"; g.fillText(b, 256, 94);
  const t = new THREE.CanvasTexture(c); try{ t.encoding = THREE.sRGBEncoding; }catch(e){} return GATE.tex[k] = t;
}
function gateAdd(g, mat, x, y, z, w, h, d, ry){ const m = new THREE.Mesh(UNIT.box, mat); m.position.set(x, y, z); m.scale.set(w, h, d); if(ry) m.rotation.y = ry; m.castShadow = false; m.receiveShadow = true; g.add(m); return m; }
function gateArch(g, x, z, dirZ, gap, wingHalf, wallH, title, sub){
  const stone = new THREE.MeshStandardMaterial({color:0xd8cfbb, roughness:0.9}), dark = new THREE.MeshStandardMaterial({color:0x2a2f33, roughness:0.6, metalness:0.4}), gold = new THREE.MeshStandardMaterial({color:0xb8964a, roughness:0.35, metalness:0.7}), shade = new THREE.MeshStandardMaterial({color:0xb9b09c, roughness:0.95});
  const pierW = 1.15, pierH = 5.0, d = 1.1, ph = x, off = dirZ;                       /* dirZ: +1 when the viewer stands at +z of the gate */
  [-1, 1].forEach(s => { const px = x + s * (gap / 2 + pierW / 2);
    gateAdd(g, shade, px, 0.35, z, pierW + 0.3, 0.7, d + 0.3); gateAdd(g, stone, px, pierH / 2 + 0.35, z, pierW, pierH, d); gateAdd(g, stone, px, pierH + 0.5, z, pierW + 0.35, 0.28, d + 0.35);
    for(let i = 0; i < 4; i++) gateAdd(g, shade, px, 1.2 + i * 1.0, z + off * (d / 2 + 0.01), pierW - 0.2, 0.06, 0.04);
    /* a lantern on each pier */
    const lm = new THREE.MeshStandardMaterial({color:0xfff2d4, emissive:0xffd9a0, emissiveIntensity:0.5, roughness:0.4}); gateAdd(g, dark, px, pierH + 0.78, z, 0.34, 0.1, 0.34); gateAdd(g, lm, px, pierH + 1.0, z, 0.26, 0.36, 0.26); gateAdd(g, dark, px, pierH + 1.25, z, 0.34, 0.08, 0.34); g.userData.lanterns = (g.userData.lanterns || []).concat([lm]); });
  const span = gap + pierW * 2 + 0.3;
