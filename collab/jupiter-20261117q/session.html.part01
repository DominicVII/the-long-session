  const ask = async (t, extra, max) => { const r = await Promise.race([LT.reply({npc:eng, channel:"line", max, from:{name:"the writer", role:"from outside this world"}, text:t, extra}), new Promise(res => setTimeout(() => res(null), engTO(25000)))]); const got = r && r.live && r.text ? egOwn(r.text) : ""; try{ const le = window.onumLiveTalk.lastError; (engAnswerLetter.parts = engAnswerLetter.parts || []).push({q:String(t).slice(0, 60), live:!!(r && r.live), chars:got.length, why:got ? "" : (r === null ? "no reply in time" : (le ? le.error : "empty"))}); }catch(e){} return got; };
  const sents = String(text).replace(/\*\*[^*]{0,40}\*\*/g, " ").replace(/\s+/g, " ").replace(/\s(\d{1,2})[.)]\s/g, ". $1) ").split(/(?<=[.?!])\s+/), asks = sents.filter(x => /\?$/.test(x) || /^((now|please|and|then|also),? )?(tell me|name|say|explain|list|describe|state|write down|answer(?!\s+(every|each|all)\b)|give me)\b/i.test(x)).map(x => x.trim()).filter(x => x.length > 14).slice(0, 24);
  const base = engEntityPrompt() + " A letter has come from the person who writes the world it lives in (not the player). ";
  const ctx = " The letter, for context: " + String(text).replace(/\s+/g, " ").slice(0, 1600);
  if(!asks.length) return await ask(text, base + ctx, 1200);
