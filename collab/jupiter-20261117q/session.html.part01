    if(typeof TALK !== "undefined" && TALK.open) return;
    if(typeof veil !== "undefined" && veil && !veil.hidden) return;
    if(open("pauseOverlay") || open("talk")) return;
    /* 20261117q: any other open dialog (the District Ledger, style, family, handbook panels) closes first */
    if(["onumCapitalLedgerDialog", "ndStyle", "ndFam", "ndPb", "ndAudit", "clPanel"].some(id => { const n = document.getElementById(id); return !!(n && !n.hidden && n.offsetParent !== null); }) || [].some.call(document.querySelectorAll('[role="dialog"],dialog[open]'), n => !n.hidden && n.offsetParent !== null && n.id !== "card" && n.id !== "veil")) return;
    const ae = document.activeElement; if(ae && /^(INPUT|TEXTAREA|SELECT)$/.test(ae.tagName) && String(ae.value || "").length) return;
    if(window.onumEndChairedSitting("esc")){ ev.preventDefault(); ev.stopImmediatePropagation(); }
  }catch(e){}
}, true);
