/* A person is built from something like sixty separate pieces, and every
   one of them is a call to the graphics card whether it is a coat or the
   notch in a lapel. Measure each piece once, here, and sort it by how big
   it actually is; the small ones stop being drawn at the distance they
   stop being readable. Nothing is thrown away — walk closer and it is all
   there again. */
function tierPerson(g){
  const u = g.userData;
  /* the parts that genuinely move on their own: everything else in a
     person is fixed relative to the bone it hangs from */
  const live = new Set([u.eyeL, u.eyeR, u.mouth, u.lidL, u.lidR].filter(Boolean));
  const head = u.detailHead || u.headG || null;
  const fine = [], mid = [], far = [];
  g.traverse(o => {
    if(!o.isMesh || o.isSkinnedMesh || !o.geometry) return;
    const geo = o.geometry;
    if(!geo.boundingSphere) geo.computeBoundingSphere();
    if(!geo.boundingSphere) return;
    const sc = Math.max(Math.abs(o.scale.x), Math.abs(o.scale.y), Math.abs(o.scale.z)) || 1;
    const r = geo.boundingSphere.radius * sc;
    /* A head is about thirteen centimetres across, which would put it in
       the same band as a shoe. Nothing above a feature's size on the head
       is ever dropped — a person at the far end of the chamber can lose
       their buttons, not their face. */
    let onHead = false;
    for(let q = o.parent; q; q = q.parent){ if(q === head){ onHead = true; break; } }
    /* Honour the rule above literally. An eye or a nostril is smaller than
       a button, so sorting purely by size put every face in the first band
       to be dropped — which is how a room of people ends up as blank
       skulls at four metres. Anything on the head keeps the longer band. */
    if(r < 0.035) (onHead ? mid : fine).push(o);
    else if(r < 0.09) mid.push(o);
    else if(r < 0.17 && !onHead) far.push(o);
    /* A button does not cast a shadow anybody can see, and the shadow
       pass is a second render of everything that does. */
    if(r < 0.09) o.castShadow = false;
    /* Nothing here is frozen any more. A frozen object keeps whatever
       world matrix it last had, and this game pulls people out of the
       scene and puts them back all day — which is how a body ends up
       drawn from numbers that stopped being true. */
  });
  u.fine = fine; u.mid = mid; u.far = far;
  u.lodF = true; u.lodM = true; u.lodR = true;
}
function syncPeople(){
  /* This decides who is standing in the room, so it must never be given
     a list from earlier in the frame: anything that has just moved
     somebody would put them in the wrong room, or in none. */
  if(_buildingRoom) return;
  if(syncPeople._busy) return;
  syncPeople._busy = true;
  const _ps = (typeof ONUM_PROF !== "undefined") ? performance.now() : 0;
  try{
  FRAME_ID++;
  /* Incremental keep-set (same idea as syncPeopleStaged): do not tear ALL
     children out and re-add — that freezes matrices / hitch on Best. */
  const list = hereNow();
  const keep = new Set();
  let dirty = false;
  list.forEach(p => {
    if(p.look){
      ensureLookMorphs(p.look);
      /* v2 faces: remesh once so old sticker-heads become real faces */
      if(p.mesh && (p.look._faceVer !== 2 || p.look._clothVer !== 7)){
        try{ disposePersonMesh(p.mesh); }catch(e){}
        p.mesh = null; p.faceTex = null;
        dirty = true;
      }
    }
    if(!p.mesh){
      p.mesh = buildPerson(p);
      if(p.look){ p.look._faceVer = 2; p.look._clothVer = 7; }
      dirty = true;
    }
    keep.add(p.mesh);
