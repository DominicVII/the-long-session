  try{ if(e && e.action === "speak" && (e.actorId === "you" || (G.you && e.actorId === G.you.id)) && r && r.ok !== false && SSN && (SSN.kind === "cabinet_meeting" || SSN.kind === "governor_council")){ const p = cabPick(e.text); if(p) setTimeout(() => cabAsk(p, G.you, String(e.text || ""), SSN && SSN.kind), 900); } }catch(x){} return r; }; }
function cabCallOn(id){
