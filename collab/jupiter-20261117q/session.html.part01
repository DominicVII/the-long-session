  const k = will.boast > 55 ? aff.sort((a, b) => PURSE_ITEMS[b].show - PURSE_ITEMS[a].show || PURSE_ITEMS[b].price - PURSE_ITEMS[a].price)[0] : pick(aff);
  const it = PURSE_ITEMS[k]; try{ if(it.line) { p.say = it.line; p.sayT = 4; speakAt(p, it.line); } }catch(e){}
