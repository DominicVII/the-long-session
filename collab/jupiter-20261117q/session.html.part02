  const r = _rt.apply(this, arguments);
  try{ onumCommBox(); onumShowRoom("", false); }catch(e){}
  return r;
}; }
{ const _ar = addressRoom; addressRoom = function(text){
  const r = _ar.apply(this, arguments);
  try{ onumShowRoom(text, true); }catch(e){}
  return r;
}; }
{ const _cv = converseLive; converseLive = function(m, text){
