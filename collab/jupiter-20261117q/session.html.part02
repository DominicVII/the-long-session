    if(want) S.push((blunt ? "I want " : "What I'd like is ") + want.replace(/^to /, "to ").replace(/\.$/, "") + (why ? ", because " + why.replace(/\.$/, "") : "") + ".");
    if(g && (g.what || g.why)) S.push((blunt ? "You " : "I haven't forgotten you ") + String(g.what || g.why).replace(/^you /i, "").replace(/\.$/, "") + (g.day != null ? ", day " + g.day : "") + ".");
    if(d && d.what) S.push((blunt ? "You owe me. You " : "There's the matter of how you ") + String(d.what).replace(/^you /i, "").replace(/\.$/, "") + ".");
    if(mem.length) S.push((blunt ? "Last time you " : "I remember you ") + mem[mem.length - 1].replace(/^you /i, "").replace(/\.$/, "") + (blunt ? ". Still true?" : "."));
    if(stance) S.push((blunt ? "I'm " : "I suppose I'm ") + String(stance).replace(/\.$/, "") + ".");
    if(!S.length) S.push(pickR(["I don't know.", "Ask me later.", "Not now.", "I was just going to\u2026 never mind."]));
