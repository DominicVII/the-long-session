  (E.plans || []).forEach(p => { if((p.status === "held" || p.status === "missed") && !p.exRev){ p.exRev = G.day; X.revisions.unshift({d:G.day, plan:p.title, status:p.status, hits:(p.hits || []).map(h => ({what:ENG_MNAME[h.k] || h.k, held:h.h})), askerWords:lex ? lex.own.concat(lex.dialect).slice(0, 8) : []}); if(X.revisions.length > onumLim(20,"hist")) X.revisions.pop(); } }); }
/* the player's panel: what is bound, what was refused and why, what it tried, what it was told, and the switch */
{ const _ch = engCharterHTML; engCharterHTML = function(){ let h = _ch.apply(this, arguments); try{ const E = engEnsure(), X = exStore(), esc = typeof pcEsc === "function" ? pcEsc : (s => String(s));
  h += '<div class="eyebrow" style="margin-top:12px">Bound in code</div><p class="muted" style="font-size:12px">The Engine asked for these three limits; they are enforced, not promised. Whatever it says, it cannot act past them, raise its own compute or caps, lower oversight, widen its access, or delay a vote to pause or shut it down.</p>' +
    Object.keys(EX_BOUND).map(k => '<div style="font-size:13px;margin:3px 0">■ ' + esc(EX_BOUND[k].t) + '</div>').join("") +
    '<div class="muted" style="font-size:12px;margin:6px 0">Correction score <b>' + Math.round(X.cal) + '</b> of 100 · applied ' + X.applied + ' · repeated ' + X.repeated + ' · ' + (X.corrections.length === 1 ? 'one correction' : (X.corrections.length || 'no') + ' corrections') + ' kept.</div>' +
    (X.refused.length ? '<div class="eyebrow" style="margin-top:8px">Refused (never put into effect)</div>' + X.refused.slice(0, 8).map(r => '<div class="muted" style="font-size:12px;margin:3px 0;border-left:3px solid #c0553a;padding-left:8px">Day ' + r.d + ': ' + esc(r.what) + '<br><i>Refused because ' + esc(r.why) + '.</i></div>').join("") : '') +
    (X.breaches.length ? '<div class="eyebrow" style="margin-top:8px">What it tried, and was stopped from doing</div>' + X.breaches.slice(0, 6).map(b => '<div class="muted" style="font-size:12px;margin:2px 0">Day ' + b.d + ': ' + esc(b.what) + ' (blocked)</div>').join("") : '') +
    (X.conflicts.length ? '<div class="eyebrow" style="margin-top:8px">Charter conflicts</div>' + X.conflicts.map(c => '<div class="muted" style="font-size:12px;margin:2px 0">Its commitment (day ' + c.d + '): “' + esc(c.t) + '” — cannot govern what it does. ' + esc(c.rule) + '</div>').join("") : '') +
