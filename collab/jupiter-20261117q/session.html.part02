    if(pro && side(pro) > 0) add("side", "Side with " + pro.sn, pro, 0.1, "Lifts " + pro.sn + " and their allies; their rival cools.");
    if(step === "motion" || step === "deliberate" || step === "question") if(!S.x.amended) add("amend", "Propose a compromise: " + S.x.M.comp, mid, 0.25, "Pulls everyone toward the middle.");
    if(talker && talker.cut < 2 && (step === "question" || step === "motion" || step === "open")) add("cut", "Cut " + talker.sn + " off", talker, 0.3, "Silences them for a step. They will not forget it.");
    if(mid && side(mid) <= 0) add("whisper", "Whisper a deal to " + mid.sn + " (" + mid.want + ")", mid, 0.3, "Costs the war chest; turns them if it holds.");
    if(pro && step !== "deliberate") add("yield", "Yield your time to " + pro.sn, pro, 0.05, pro.sn + " argues your case in their own words.");
