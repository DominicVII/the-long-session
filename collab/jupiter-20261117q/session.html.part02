setInterval(() => { try{ if(G && G.you && G.day != null && G._liveDay !== G.day){ const first = G._liveDay == null; G._liveDay = G.day; senStore(); benchEnsure(); if(!first){ benchDay(); tsDay(); } } }catch(e){} }, 2600);
window.onumInstitutions = () => ({bench:(G.court || []).map(j => j.vacant ? {vacant:true, was:j.was, how:j.how} : {name:j.name, age:Math.round(jAge(j)), since:j.since}), vacancy:G.benchVac || null, treasury:G.treasury ? {balance:G.treasury.bal, last:G.treasury.last} : null, guilder:G.money ? G.money.index : null, senate:G.sen ? Object.keys(G.sen.seats).length : 0});
