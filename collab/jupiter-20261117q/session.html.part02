onumWebFound = function(){
  const y = G.you; if(!y) return;
  const kinds = [
    ["personal", surname(y.name) + " — from the desk", "A page that is mine. I will write what I mean."],
    ["campaign", surname(y.name) + " — the race", "I am running on the record, and the record will be written here in my words."],
    ["chapel", "A page for what I hold", "The office does not replace what I hold. I will say so where people can read it."]
  ];
  const body = kinds.map((k, i) => '<div style="margin:8px 0"><button type="button" class="btn" data-wf="' + i + '">' + onumEsc(k[1]) + '</button><div class="muted">' + onumEsc(k[2]) + '</div></div>').join("");
