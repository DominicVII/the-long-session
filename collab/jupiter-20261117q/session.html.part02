  try{ if(!PC_TABS.some(t => t[0] === "chat")) PC_TABS.push(["chat", "Chat"]);
    const pcTab0 = pcTab; pcTab = function(){ if(PC.tab === "chat") return '<div class="pc__h">Chat · anyone you know, or your aide</div><div id="ltPcDock"></div>'; return pcTab0.apply(this, arguments); };
    const pcRender0 = pcRender; pcRender = function(){ const r = pcRender0.apply(this, arguments); try{ const d = document.getElementById("ltPcDock"); if(PC.open && PC.tab === "chat" && d) chatOpen(d); else { const C = document.getElementById("ltChat"); if(C && C.classList.contains("is-dock")) chatClose(); } }catch(e){} return r; };
    const pcClose0 = pcClose; pcClose = function(){ const C = document.getElementById("ltChat"); if(C && C.classList.contains("is-dock")) chatClose(); return pcClose0.apply(this, arguments); };
