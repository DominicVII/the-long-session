          govCardOpen("Answer", "Under your own name", "They wrote as themselves. You answer as yourself.",
            '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" data-wr="warm">Warm</button><button type="button" class="btn btn--ghost" data-wr="note">Just the record</button><button type="button" class="btn btn--ghost" data-wr="hard">Hard</button></div>', null);
          card.querySelectorAll("[data-wr]").forEach(x => x.addEventListener("click", () => { onumWebReply(id, x.getAttribute("data-wr")); const s = el("gcSay"); if(s) s.textContent = "Sent. If it was unkind, they will write again."; }));
        }
      };
      if(k.indexOf("web:") === 0 && k !== "web") go();
      else if(typeof pcAway === "function" && PC.open && k.indexOf("web") !== 0) pcAway(go);
      else go();
    }));
  }catch(e){}
}; }
{ const _sd = standDay; standDay = function(){ const r = _sd.apply(this, arguments); try{ onumWebDay(); onumCamp(); }catch(e){} return r; }; }
{ const _sl = sitLines; sitLines = function(room, step, C, ctx){
  const L = _sl.apply(this, arguments) || [];
  try{
    if(room !== "exec" || !kHolds("exec")) return L;
    const st = presStaff(); const keys = ["treasury","state","war","justice"];
    return L.map((line, i) => {
      const k = keys[i % keys.length]; const o = st[k]; if(!o) return line;
      const said = (step === "gavel") ? "Everyone sit. I have read the file and I am not here to repeat it in your voice."
        : (step === "adjourn") ? "Go and do the part that is actually yours."
        : (typeof presAdvice === "function" && (G.lastActs || [])[0]) ? presAdvice(o, k, (G.lastActs || [])[0]) : onumCabQuiet(o, k);
      return [o.name + ", " + PRES_ROLES[k], said];
    });
  }catch(e){ return L; }
}; }
