  const freeLot = (pos, w, d, own) => { const solids = [].concat((typeof NM !== "undefined" && NM.solids) || [], CHG.solids.filter(s => s.owner !== own));
    const near = new Set(); const addC = (x, z) => { const [i, j] = cellOf(x, z); for(let a = -1; a <= 1; a++) for(let b = -1; b <= 1; b++){ const k = (i + a) + "," + (j + b); if(!near.has(k)){ near.add(k); try{ cellSolids(i + a, j + b).forEach(q => solids.push(q)); }catch(e){} } } };
    addC(+((pos && pos.x) || 0), +((pos && pos.z) || 0)); addC(+((pos && pos.x) || 0) + 50, +((pos && pos.z) || 0) + 50); addC(+((pos && pos.x) || 0) - 50, +((pos && pos.z) || 0) - 50);
