    church:["St. Bavo's", "Grace Chapel", "First Reformed", "Holy Cross", "Our Lady of the Dike", "Westerkerk"], civic:["City Hall", "Public Library", "Hall of Records", "County Courthouse", "Consular Exchange"]};
