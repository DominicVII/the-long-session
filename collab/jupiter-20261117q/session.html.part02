  const isRoad = (x, z) => { if(Math.abs(x) < 8.2 && z > -6 && z < 50) return true; if(z > 18 && z < 26 && Math.abs(x) < 45) return true; if(z > -5 && z < -1.4 && Math.abs(x) < 14) return true;
