    else if(type === "residential"){ for(let k = 0; k < 4; k++) homesSide(k); noFrame(); if(lvl < 2) for(let k = 0; k < 5; k++) tree(bx0 + 14 + r() * (L - 28), bz0 + 14 + r() * (L - 28), 2.8, 1.3, sd + 70 + k); }
