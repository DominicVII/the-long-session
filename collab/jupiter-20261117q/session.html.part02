      try{ ROOMS.home.t = homeTitle(); }catch(e){} try{ spend(3, 1); }catch(e){} enterRoom("home", "district"); return true; }catch(e){ return false; } };
  try{ if(typeof enterRoom === "function"){ const _er = enterRoom; enterRoom = function(dest, fromRoom){ const prev = fromRoom || G.room; if(dest === "home"){ try{ ROOMS.home.t = homeTitle(); }catch(e){} }
        const r = _er.apply(this, arguments);
