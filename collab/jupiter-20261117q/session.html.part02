    if(!cands.length || (!force && f.rounds >= floorCap(S))){
      if(f.rounds && !f.closed){ f.closed = true; out.push(chairLine(S, ch.you ? "Nobody else seeks the floor on that. We move on." : cands.length ? "Order. The chair has heard enough on that point. We move on." : "Order. Everyone who wished to answer on that point has been heard. We move on.")); }
