      const ctx = S.D.title + ": " + S.x.M.q + ". Reply in your own words, one or two sentences, standing where you stand. Nobody has prompted you.";
      Promise.resolve(vs && vs.lastText ? LT.reply({npcId:p.m.id, channel:"sitting", from:{name:vs.name, role:vs.role}, text:String(vs.lastText).slice(0, 220), extra:ctx}) : LT.reply({npcId:p.m.id, channel:"sitting", stage:"Speak up, unasked. " + ctx, text:ctx}))
