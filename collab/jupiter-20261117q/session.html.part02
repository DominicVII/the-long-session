    L.unshift({kind:"nomination", title:"A seat on the high bench", line:(V.was ? V.was + " " + V.how + " on day " + V.d + "." : "The seat is vacant.") + " Nominate; the Senate votes five days later.", sponsor:"the Charter", pos:{econ:0, lib:0, def:0, wel:0}, body:"The Senate", by:{},
      acts:V.cands.o.map(o => ({t:"Nominate " + o.name + " (" + viewWords(o.pos) + ")", run(){ benchNominate(o); return o.name + " is nominated. The Judiciary committee will hear them; the Senate votes on day " + G.benchVac.vote + "."; }}))}); } }catch(e){} return L; }; }
/* the hearing a senator holds: the real nominee when a seat is vacant, a circuit nominee otherwise; the vote is the Senate's, yours is one of forty */
confirmCard = function(){
  const y = G.you, V = benchVacancy(), high = !!(V && V.nom);
  if(!high && !(G.lowerNom && G.lowerNom.d === G.day)) G.lowerNom = {d:G.day, o:mkOfficial("nom:" + G.day + ":" + y.name, {n:pick(STATES)}, "Nominee to the circuit court")};
