/* 20261110bx: main IIFE now closes after the ba block (was here; ba ran outside it and threw ReferenceError: reactEmit) */

/* ══ 20261104ba · JUPITER · cause → effect, and sittings that finish what they start.
   (1) Every desk/docket act schedules a concrete beat 1–2 days on (G.followUps): a wire line, a person who cares (remembered, so talk opens on it),
       a letter, and a desk card. Fired from the morning (lMorning). Appointments, signatures and vetoes, feuds and the national mood each get named
       stakes before the act and named consequences after it.
   (2) Cabinet/council: Call on always produces words (fallback report when LiveTalk is empty or slow) and holds the floor until they finish;
       2–4 named exchanges between secretaries before Decisions; Decisions is Call the vote → each seat casts → tally → adjourn. Typing only freezes
       a sitting when focus is the session say-box. ══ */
const BA = {stamp:"20261104ba"};
function baMembers(){ return (G.members || []).filter(m => m && !m.gone && m.kind === "member"); }
function baSn(p){ try{ return surname(p.name); }catch(e){ return String((p && p.name) || "").split(/\s+/).slice(-1)[0]; } }
function baPick(pred){ const L = baMembers().filter(pred || (() => true)); return L.length ? L[Math.floor(Math.random() * L.length)] : null; }
function baHome(pred){ const st = G.you && G.you.state; return baPick(m => m.state === st && (!pred || pred(m))) || baPick(pred) || baPick(); }
function baAl(m, pos, title){ try{ return alignment(m, {pos:pos || {econ:0, lib:0, def:0, wel:0}, title:title || "act", id:"ba:" + (title || "")}); }catch(e){ return 0; } }
function baQ(){ return (G.followUps = G.followUps || []); }
/* {in, kind, title, whoId, text, wire, desk} */
function baFollow(o){ const Q = baQ(); if(Q.some(x => !x.fired && x.title === o.title && x.day === G.day + (o.in || 1))) return;
  Q.push({day:(G.day || 0) + (o.in || 1), from:G.day, kind:o.kind || "act", title:o.title, whoId:o.whoId != null ? o.whoId : null, text:o.text, wire:o.wire || o.text, desk:o.desk !== false});
  if(Q.length > onumLim(40,"cap")) Q.splice(0, Q.length - onumLim(40,"cap")); }
function baFire(){
  const Q = baQ(), due = Q.filter(x => !x.fired && x.day <= G.day); if(!due.length) return;
  G.baDesk = (G.baDesk || []).filter(d => d.day >= G.day - 1);
  due.forEach((x, i) => { x.fired = G.day; const m = x.whoId != null ? byId(x.whoId) : null;
    try{ feed(x.wire, "news"); }catch(e){}
    try{ G.reactNews = (G.reactNews || []).concat([{t:x.wire, d:G.day}]).slice(-12); }catch(e){}
    try{ pushMail(m ? {name:m.name, id:m.id} : null, x.title, x.text + (m ? "\n\n" + m.name + " wants a word about it. Find them, or call." : ""), {kind:"note"}); }catch(e){}
    if(m){ try{ remember(m, x.title + ": " + x.text, 7, true); }catch(e){} m.baHook = {day:G.day, t:x.title, text:x.text, kind:x.kind}; }
    if(x.desk) G.baDesk.push({day:G.day, key:"ba" + G.day + "_" + i, t:x.title, d:x.text, whoId:x.whoId, kind:x.kind}); });
  if(Q.length > onumLim(40,"cap")) G.followUps = Q.filter(x => !x.fired || x.fired >= G.day - 3);
}
/* the national mood and the fad, in words */
function baMoodWord(v){ v = v || 0; return v > 30 ? "buoyant" : v > 10 ? "hopeful" : v > -10 ? "uneasy and watching" : v > -30 ? "sour" : "angry"; }
function baZeit(){ const f = (G.fads || [])[0], b = G.baMood;
  return "The country is " + baMoodWord(G.mood) + " (national mood " + ((G.mood || 0) > 0 ? "+" : "") + Math.round(G.mood || 0) + ")." + (f ? " Everyone is on about " + f.t + "." : "") + (b && b.day >= G.day - 3 ? " Since day " + b.day + ": " + b.t : ""); }
function baShiftMood(d, beat, who){ G.mood = clamp((G.mood || 0) + d, -100, 100); G.baMood = {day:G.day, t:beat, whoId:who ? who.id : null};
  G.fads = G.fads || []; G.fads.unshift({t:beat.replace(/\.$/, ""), k:"zeitgeist", by:who ? who.id : null, day:G.day}); if(G.fads.length > 28) G.fads.length = 28;
  if(who) baFollow({in:1, kind:"mood", title:"The talk of the country", whoId:who.id, text:beat + " " + who.name + " has been saying so to anyone who will listen.", wire:"ZEITGEIST · " + beat}); }
/* who stands where on an act, by name */
function baSides(pos, title, pool){ const L = (pool || baMembers()).map(m => ({m, a:baAl(m, pos, title)})).sort((x, y) => y.a - x.a);
  return {fr:L.length ? L.filter(x => x.a > 0).length / L.length : 0.5, sponsors:L.slice(0, 2).filter(x => x.a > 0).map(x => x.m), opponents:L.slice(-2).reverse().filter(x => x.a < 0).map(x => x.m)}; }
function baNames(L){ return L.length ? L.map(m => m.name + (m.party ? " (" + m.party + ")" : "")).join(" and ") : "nobody on record"; }
function baActContext(title, pos){ const s = baSides(pos, title), ov = Math.round(clamp((s.fr - 0.55) * 4, 0, 0.95) * 100);
  return "Chamber lean: about " + Math.round(s.fr * 100) + "% of members favour it. Override odds if you veto: about " + ov + "%. Sponsors: " + baNames(s.sponsors) + ". Opponents: " + baNames(s.opponents) + ". " + baZeit(); }
function baStateContext(S, b){ let a = 0, n = 0, u = 0; try{ const by = dkStatehouse(S, {title:b.title, pos:b.pos || {econ:b.dir * 20, lib:0, def:0, wel:0}}); Object.keys(by).forEach(p => { a += by[p].aye; n += by[p].no; u += by[p].un; }); }catch(e){}
  const tot = a + n + u, ov = tot ? Math.round(clamp(((a + u * 0.4) / tot - 0.6) * 4, 0, 0.95) * 100) : 0, sp = baHome(m => (m.party === G.you.party)), op = baHome(m => m.party !== G.you.party);
  return "Statehouse lean: " + a + " for, " + n + " against, " + u + " undecided. Override odds if you veto: about " + ov + "%. Sponsor: " + (sp ? sp.name : "the majority leader") + ". Loudest opponent: " + (op ? op.name : "the minority") + ". " + baZeit(); }
/* consequences, scheduled the moment the act lands */
{ const _re = reactEmit; reactEmit = function(kind, data, delay){ const r = _re.apply(this, arguments);
  try{ const d = data || {}, y = G.you;
    if(kind === "appoint"){ const sen = baPick(m => m.chamber === "senate" || /senat/i.test(String(m.post || ""))) || baHome(m => m.party !== y.party), loser = baHome(), pr = baHome(m => m.party === y.party);
      if(d.ok){ baFollow({in:1, kind:"appoint", title:"Morning after: " + d.name, whoId:sen && sen.id, text:(sen ? sen.name : "A senator") + " is asking why " + d.name + " got the seat as " + String(d.post || "appointee").toLowerCase() + ", and who was promised it first.", wire:"APPOINTMENT · " + d.name + " takes up the post; " + (sen ? baSn(sen) : "the Senate") + " wants hearings on how it was filled."});
        baFollow({in:2, kind:"appoint", title:"Who remembers", whoId:loser && loser.id, text:(loser ? loser.name : "Someone") + " backed another name for the post and has not forgotten. The department's first line under " + d.name + " is already in the papers.", wire:"PRESS · The first order from " + d.name + " draws a column and two letters."});
        baShiftMood(1, "Talk of " + d.name + " as the new " + String(d.post || "appointee").toLowerCase() + ".", pr); }
      else baFollow({in:1, kind:"appoint", title:"The seat stays open", whoId:sen && sen.id, text:(sen ? sen.name : "The opposition") + " is claiming the defeat of " + d.name + " as a win, and asking whom you will send next.", wire:"APPOINTMENT · " + d.name + " withdrawn after the vote; " + (sen ? baSn(sen) : "the opposition") + " claims it."}); }
    if(kind === "actSigned" || kind === "actVetoed"){ const s = baSides(d.pos, d.title), sp = s.sponsors[0], op = s.opponents[0], ok = kind === "actSigned";
      if(ok){ baFollow({in:1, kind:"sign", title:"Suit filed: " + d.title, whoId:op && op.id, text:(op ? op.name : "Its opponents") + " has backed a suit against the " + d.title + ". The bench will hear it.", wire:"COURTS · A suit against the " + d.title + " is filed; " + (op ? baSn(op) : "opponents") + " behind it."});
        baShiftMood(ok ? 2 : -2, "Everyone is arguing about the " + d.title + ".", sp || op); }
      else { baFollow({in:1, kind:"veto", title:"Override attempt: " + d.title, whoId:sp && sp.id, text:(sp ? sp.name + ", its sponsor," : "Its sponsors") + " is counting votes to override your veto of the " + d.title + ", and says it is personal now.", wire:"HOUSE · " + (sp ? baSn(sp) : "Sponsors") + " moves to override the veto of the " + d.title + "."});
        if(sp){ try{ sp.rel.warmth = clamp(sp.rel.warmth - 12, -100, 100); remember(sp, "You vetoed my " + d.title + ".", 9, true); }catch(e){} baFollow({in:2, kind:"feud", title:"A sponsor's grudge", whoId:sp.id, text:sp.name + " is telling the cloakroom you killed the " + d.title + " to spite them.", wire:"CLOAKROOM · " + baSn(sp) + " on your veto: \u201cI will remember it.\u201d"}); }
        baShiftMood(-2, "The veto of the " + d.title + " is the only thing on the radio.", op || sp); } }
    if(kind === "stateBill"){ const sp = baHome(m => m.party === y.party), op = baHome(m => m.party !== y.party);
      baFollow({in:1, kind:d.signed ? "sign" : "veto", title:(d.signed ? "After you signed " : "After your veto of ") + d.title, whoId:(d.signed ? op : sp) && (d.signed ? op : sp).id, text:d.signed ? (op ? op.name : "The minority") + " is taking the " + d.title + " to the state court." : (sp ? sp.name : "The majority leader") + " is whipping an override of the " + d.title + " in the statehouse.", wire:"STATEHOUSE · " + (d.signed ? "Suit filed over the " : "Override drive on the ") + d.title + "."});
      baShiftMood(d.signed ? 1 : -1, d.state + " is talking about the " + d.title + ".", d.signed ? sp : op); }
  }catch(e){ try{ console.warn("ba react", e); }catch(_){} } return r; }; }
/* universal: anything done at the desk or on the docket comes back within two days */
const BA_KEYNAME = {gbrief:"the morning briefing", gbud:"the budget", gpress:"the press availability", gdesk:"the statehouse desk", gpard:"the pardons", gemer:"the emergency file", gleg:"the legislature", gappt:"the appointment", scalls:"the calls from home", sbrief:"the staff meeting", conf:"the confirmation hearing", treaty:"the treaty", pcab:"the cabinet", bread:"the briefs"};
{ const _km = kMark; kMark = function(key){ const was = (() => { try{ return kOnceToday(key); }catch(e){ return true; } })(); const r = _km.apply(this, arguments);
  try{ if(!was && G.you && heldOffice() && heldOffice() !== "house" && !/^ba/.test(key) && key !== "chamber"){ const nm = BA_KEYNAME[key] || "what you did at the desk today", m = baHome();
      baFollow({in:chance(0.5) ? 1 : 2, kind:"desk", title:"Back on " + nm, whoId:m && m.id, text:(m ? m.name : "Someone from home") + " heard about " + nm + " and has a stake in how it lands" + (m && m.state ? " in " + m.state : "") + ".", wire:"WIRE · Word of " + nm + " reaches " + ((m && m.state) || "the districts") + "; " + (m ? baSn(m) : "a member") + " is asking questions."}); } }catch(e){}
  return r; }; }
/* the desk carries the beats, and the country's mood */
{ const _rd = roleDuties; roleDuties = function(){ const L = _rd.apply(this, arguments); try{ if(!L.length) return L;
    (G.baDesk || []).filter(d => d.day >= G.day - 1).forEach(d => { const m = d.whoId != null ? byId(d.whoId) : null;
      L.push({key:d.key, t:d.t, d:d.d, extra:true, run(){ spend(20, 2); if(m){ try{ remember(m, "The " + (typeof roleTitle === "function" ? roleTitle() : "member") + " took up " + d.t.toLowerCase() + " with me.", 5, true); m.rel.warmth = clamp(m.rel.warmth + 3, -100, 100); }catch(e){} }
        return "You take it up: " + d.d + (m ? " " + m.name + " will hear you did, and wants to talk it through." : ""); }}); }); }catch(e){} return L; }; }
