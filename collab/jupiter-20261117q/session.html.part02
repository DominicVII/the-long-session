      out.push({st:st.n, was:s.name, wasP:s.party, now:name, p:party, how:retire && r < hold ? "retired" : "was defeated"}); S.seats[k] = {party, name, since:G.term + 1, cls:s.cls}; } });
  if(out.length){ try{ const flips = out.filter(o => o.p !== o.wasP).length; note("The Senate: " + out.length + " seats were contested; " + flips + " changed party. " + out.slice(0, 4).map(o => o.now + " takes a seat for " + o.st + " (" + o.was + " " + o.how + ")").join("; ") + (out.length > 4 ? "; and others." : "."), true); }catch(e){} }
