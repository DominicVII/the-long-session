  const chairOf = function(S){
    if(S.x.chair){ try{ const c0 = S.x.chair; if(c0.mem && c0.pre && typeof ndNm === "function") c0.label = c0.pre + sn(ndNm(c0.mem)); }catch(e){} return S.x.chair; }
    let you = false, k = null; try{ k = heldOffice(); }catch(e){}
    if(S.room === "govoffice" && k === "gov") you = true;
    if(S.room === "exec" && k === "pres") you = true;
    try{ if(S.room === "floor" && G.you && G.you.post === "speaker") you = true; if(S.room === "caucus" && G.you && G.you.post === "whip") you = true; }catch(e){}
    const mem = you ? null : chairMember(S.room), cp = mem ? S.x.cast.find(p => p.m === mem) || null : null;
    let lean = 0; try{ if(cp) lean = side(cp); else if(mem && G.bill && !G.bill.done) lean = alignment(mem, G.bill) >= 0 ? 1 : -1; }catch(e){}
    const pre = mem ? (S.room === "floor" ? "Speaker " : S.room === "senate" ? "Senator " : "Chair ") : "";
    const label = you ? "You (in the chair)" : mem ? pre + sn(typeof ndNm === "function" ? ndNm(mem) : mem.name) : S.D.chair;
    return S.x.chair = {you, label, mem, p:cp, lean, pre};
  };
  const chairHTML = function(S){ try{ const ch = chairOf(S); return '<p class="sx-q"><b>In the chair:</b> ' + esc(ch.you ? "you" : ch.label) + ' <small>· ' + (ch.you ? "you call the objections, in the order you choose" : "calls objections in order, fewest words first" + (ch.lean ? ", leaning to its own side" : "")) + '</small></p>'; }catch(e){ return ""; } };
  const RETORT = {
    facts:["Read the schedule, not the speech. The figure for {s} is not the one {q} gave.", "That is not in the record, {q}. I have the record in front of me.", "{q} quoted one line of a six-page file. Read the rest.", "Give me the section number, {q}. I will wait."],
    cost:["And who pays for {s}, {q}? Name the number.", "It sounds cheap until the bill reaches {st}.", "Every dollar for {s} is a dollar not spent on {w}.", "Show me where the money comes from, {q}, and I will listen."],
    own:["{st} tried it {q}'s way once. It did not end well.", "Ask the people of {st} what they make of that.", "I answer to {st}, and {st} wants {w}.", "{q} has not been to {st} in a year."],
    principle:["There is a principle here, {q}, and it is not for sale.", "I did not come here to split the difference on something I believe is wrong.", "If we do this once, we have done it for good.", "Some things are not a matter of degrees."],
    pers:["{q} argued the opposite last session. The Journal is here.", "With respect, {q} has not been consistent.", "That is rich, coming from {q}.", "Say that to the people who sent you, {q}."],
    agree:["I will give {q} that much. It is the rest I cannot swallow.", "{q} is right about the cost and wrong about the conclusion.", "On that, {q} and I agree, which makes the rest of it harder.", "Fairly put. I still want {w}."],
    ally:["Let me add to what {q} said: {w}.", "{q} has it right, and I will say why: {st} needs it.", "I stand with {q} on {s}, and I will not be moved off it.", "What {q} said. And more besides."],
    cool:["I hear {q}, and I am still in the middle. Convince me about {s}.", "If {q} can show me {w}, I can move. Nobody has yet.", "I came undecided and I am leaving that way unless someone gives me a reason."]
  };
  const retort = function(S, p, q, M){
    const hot = p.temper > 62, sp = side(p), sq = side(q), used = S.x.usedR = S.x.usedR || {};
    let cats = sp === 0 ? ["cool", "agree", "facts"] : sp === sq ? ["ally", "agree", "own"] : hot ? ["pers", "facts", "own", "principle"] : ["facts", "cost", "principle", "agree", "own"];
    if(p.rival === q.id || q.rival === p.id) cats = ["pers", "pers", "facts"].concat(cats);
    const fill = t => t.replace(/\{q\}/g, q.sn).replace(/\{s\}/g, M.short || "this").replace(/\{st\}/g, p.state || "my state").replace(/\{w\}/g, String(p.want || "an answer").replace(/[.\s]+$/, ""));
    let text = null;
    for(let tries = 0; tries < 12 && !text; tries++){ const bank = RETORT[one(cats)]; const t = fill(one(bank)); if(!used[t]){ used[t] = 1; text = t; } }
