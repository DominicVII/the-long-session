function onumSecs(prefix){
  return (G.civ || []).filter(c => c && !c.gone && String(c.kslot || "").indexOf(prefix) === 0);
}
function onumSeatCouncil(){
  if(!G || !G.you || heldOffice() !== "gov") return;
  const S = (G.states || []).find(s => s && s.n === G.you.state);
  if(!S) return;
  try{ govStaff(S); }catch(e){ return; }
  G.civ = G.civ || [];
  Object.keys(GOV_ROLES).forEach(k => {
    const o = S.cab && S.cab[k]; if(!o) return;
    const slot = "gov:sec:" + k;
    let c = G.civ.find(x => x && x.kslot === slot);
    if(!c){
      try{ c = makeCivilian(); }catch(e){ c = null; }
      if(!c) return;
      c.kslot = slot; c.chamber = "gov"; c.krole = "aide";
      G.civ.push(c);
    }
    c.name = o.name; c.role = GOV_ROLES[k].t; c.pos = o.pos || c.pos; c.creed = o.creed || c.creed;
    c.bg = o.bg || c.bg; c.party = G.you.party; c.state = G.you.state; c.room = "govoffice";
    c.met = c.met || false;
    if(!c.rel) c.rel = {warmth:4, trust:30, debtFromYou:0, debtToThem:0};
    if(!c.traits) c.traits = {temper:o.temper || 40, discretion:50, loyalty:48, conviction:44, ambition:36, vanity:22};
    try{ if(c.x == null) placeInRoom(c); }catch(e){}
  });
  try{ _hereCache = null; _allCache = null; }catch(e){}
}
