        acts.style.setProperty("z-index", "4", "important");
        acts.style.setProperty("max-height", actsMax + "px", "important");
        acts.style.setProperty("overflow", "auto", "important");
        acts.style.setProperty("min-height", "88px", "important");
      }
      const ah = acts ? Math.min(actsMax, Math.max(88, acts.getBoundingClientRect().height)) : 0;
      if(own && !own.hidden){
        own.style.setProperty("position", "absolute", "important");
        own.style.setProperty("left", "14px", "important");
        own.style.setProperty("right", "14px", "important");
        own.style.setProperty("bottom", (innerB + (acts ? ah + 6 : 0)) + "px", "important");
        own.style.setProperty("z-index", "4", "important");
      }
      const reserved = innerB + (acts ? ah + 6 : 0) + ((own && !own.hidden) ? ((own.getBoundingClientRect().height) + 6) : 0);
      T.style.setProperty("padding-bottom", reserved + "px", "important");
