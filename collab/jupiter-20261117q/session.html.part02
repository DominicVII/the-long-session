const BA_CARE = [[/treasur/i, "the cost, and who pays it"], [/defen[cs]e|war/i, "readiness, and what the other side reads into it"], [/state\b|foreign/i, "how it plays with our neighbours"], [/attorney|justice/i, "whether it survives the courts"], [/interior|public works|roads/i, "the roads and the counties"], [/health/i, "the hospitals and the poor rolls"], [/school|education/i, "the schools"], [/safety|constab|police/i, "order on the streets"], [/labou?r/i, "the men on the line and their wages"]];
