  /* one candid line, offline, checked; up to 2 retries */
  function offlineLine(p, ctx){ CD.n++; const st = ctx.state || sv(() => window.onumSpeakerState(p.id, ctx.audience)) || {}; const last = lastOf(p.id, st), K = known();
    const terse = !!(st.voice && st.voice.terse);
