}
function exAskerBlock(L){
  if(!L) return ""; const bits = [];
  if(L.own.length) bits.push("words they use themselves: " + L.own.join(", "));
  if(L.dialect.length) bits.push("words from where they come from (" + (L.region || "their region") + "): " + L.dialect.join(", "));
  if(L.phrases.length) bits.push("things they say: " + L.phrases.map(x => "“" + x + "”").join(" "));
  if(L.register) bits.push("they speak in a " + L.register + " register");
  return bits.length ? " THE ASKER'S OWN WORDS (" + (L.id === "you" ? "the player" : L.name) + "): " + bits.join("; ") + ". Explain your answer, and any result or forecast you mention, in their words rather than yours, so it makes sense to them. What you think is still your own." : "";
}
function exWrapLT(){
