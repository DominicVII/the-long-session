  function paintPill(){ const p = document.getElementById("ltPill") || {classList:{toggle(){}}}; p.textContent = LT.up ? "🗣 Live · " + CFG.model : "🗣 Offline mind"; const cb = document.getElementById("ltcBadge"); if(cb){ cb.textContent = LT.up ? "Live" : "Offline mind"; cb.classList.toggle("is-up", !!LT.up); } p.classList.toggle("is-up", !!LT.up); }
