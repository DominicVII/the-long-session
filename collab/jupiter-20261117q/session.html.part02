  const churchAt = (cx, cz, name) => {
    box("stone", cx, 4, cz, 7.5, 8, 9, 0xcfc6b2); put("paint", T.prism, cx, 8, cz, 9.2, 3.6, 7.9, 0x3c3a3a, 0, Math.PI / 2, 0);
    box("stone", cx, 6.5, cz - 4.9, 3.2, 13, 3.2, 0xd6cdb8); put("paint", T.cyl(4, 0.02), cx, 16.5, cz - 4.9, 3.6, 7, 3.6, 0x3c4a4a, 0, Math.PI / 4, 0); ico("brass", cx, 20.1, cz - 4.9, 0.18, 0.3, 0.18);
