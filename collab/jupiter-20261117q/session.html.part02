  /* the pocketbook card */
  function css(){ if(document.getElementById("ndPbCss")) return; const st = document.createElement("style"); st.id = "ndPbCss";
    st.textContent = "#ndPb{position:fixed;inset:0;z-index:10050;background:rgba(0,0,0,.72);display:flex;align-items:center;justify-content:center}" +
      "#ndPb .pb{background:#14161b;color:#f4f1e8;border:2px solid #c9a24a;border-radius:8px;width:min(560px,94vw);max-height:90vh;overflow:auto;padding:12px 16px;font:14px/1.35 system-ui,sans-serif;box-shadow:0 10px 40px #000}" +
      "#ndPb h2{margin:0 0 6px;font:700 19px Georgia,serif;color:#ffe08a;display:flex;justify-content:space-between;align-items:center}#ndPb button{background:#2a2d35;color:#fff;border:1px solid #6b6f7a;border-radius:4px;cursor:pointer;font:13px system-ui;padding:3px 9px}#ndPb button:hover{border-color:#ffe08a}" +
      "#ndPb .pb-home{color:#e8e2d0;margin-bottom:8px}#ndPb table{width:100%;border-collapse:collapse}#ndPb td{padding:3px 2px;border-bottom:1px solid #2d3038}#ndPb td.n{text-align:right;font-variant-numeric:tabular-nums;font-weight:600}" +
      "#ndPb .pb-h{color:#ffe08a;font:600 11px system-ui;letter-spacing:.08em;text-transform:uppercase;margin:10px 0 3px}#ndPb .neg{color:#ff9d8a}#ndPb .pos{color:#9fe0a8}#ndPb .pb-a{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}#ndPb small{color:#cfc8b4}";
    document.head.appendChild(st); }
  function draw(){ const W = document.getElementById("ndPb"); if(!W) return; const B = book(), H = home(); const box = document.createElement("div"); box.className = "pb";
    if(!B){ box.innerHTML = '<h2><span>Pocketbook</span><button type="button" id="pbX">Close</button></h2><p>No accounts yet. Start a career first.</p>'; }
    else {
      const sal = +B.salary || 0, rent = +B.rentOrMortgage || 0, net = sal - rent, days = rent > 0 ? Math.floor((+B.savings || 0) / rent) : null;
      const rentWord = H && H.ownedOrRented === "owned" ? "Mortgage" : "Rent";
      const rs = (B.recentSpend || []);
      box.innerHTML = '<h2><span>Pocketbook</span><button type="button" id="pbX">Close</button></h2>' +
        (H ? '<div class="pb-home"><b>' + esc(H.address) + '</b><br><small>' + esc((H.kind || "home").replace(/^./, c => c.toUpperCase())) + ', ' + esc(H.ownedOrRented || "rented") + (H.monthly ? ' \u00b7 ' + fl(H.monthly) + ' a month' : '') + '</small></div>' : '') +
        '<table><tr><td>Savings</td><td class="n">' + fl(B.savings) + '</td></tr>' +
        '<tr><td>Salary, a day</td><td class="n pos">+' + fl(sal) + '</td></tr>' +
        '<tr><td>' + rentWord + ', a day</td><td class="n neg">' + fl(-rent) + '</td></tr>' +
        '<tr><td>Left over each day</td><td class="n ' + (net < 0 ? "neg" : "pos") + '">' + (net >= 0 ? "+" : "") + fl(net) + '</td></tr>' +
        (days != null ? '<tr><td>Savings cover the ' + rentWord.toLowerCase() + ' for</td><td class="n">' + days + ' day' + (days === 1 ? '' : 's') + '</td></tr>' : '') +
        '<tr><td>Campaign war chest <small>(not yours to spend at home)</small></td><td class="n">' + fl((+B.warChest || 0) * 1000) + '</td></tr></table>' +
