  return [0, 1, 2].map(i => { const o = mkOfficial("bnom:" + G.day + ":" + i + ":" + (G.benchVac ? G.benchVac.fails : 0), {n:pick(STATES)}, "Nominee to the high bench"); AXES.forEach(a => { o.pos[a.k] = clamp(Math.round(base[a.k] * (i === 0 ? 0.9 : i === 1 ? 0.5 : 0.1) + o.pos[a.k] * (i === 0 ? 0.3 : 0.6)), -100, 100); }); return o; }); }
function benchNominate(o){ const V = benchVacancy(); if(!V || !o) return null; V.nom = o; V.vote = G.day + 5; o.since = G.day;
  try{ const line = (G.exec && G.exec.you ? "You nominate " : (G.exec ? G.exec.name : "The President") + " nominates ") + o.name + " to the high bench. " + cap(viewWords(o.pos)) + ". The Senate votes on day " + V.vote + "."; note(line, true); journal(line); }catch(e){}
  return V; }
function benchNomTick(){
  const V = benchVacancy(); if(!V) return;
  if(!V.nom && !(G.exec && G.exec.you) && G.day >= V.next) benchNominate(benchCands()[0]);
  if(V.nom && G.day >= V.vote) benchConfirm(null, 0);
}
/* the Senate's vote on a nominee: a roll call of the forty, the nominee's views read as the docket reads a bill */
function benchConfirm(youVote, shift){
  const V = benchVacancy(); if(!V || !V.nom) return null; const o = V.nom;
  const sen = lxSenate({title:"Nomination of " + o.name, pos:o.pos, senateVote:youVote === 1 ? "aye" : youVote === -1 ? "nay" : null, senShift:shift || 0});
  if(sen.ok){ G.court[V.seat] = {name:o.name, by:"the Senate", pos:o.pos, born:(G.day || 1) - Math.round((50 + (seedOf(o.name) % 14)) * 365), since:G.day}; G.benchVac = null; }
  else { V.nom = null; V.fails = (V.fails || 0) + 1; V.next = G.day + 4; }
  try{ const line = "The Senate " + (sen.ok ? "confirms " : "rejects ") + o.name + " to the high bench, " + sen.aye + " to " + sen.no + "."; note(line, true); journal(line); pushWireScrap("Senate", o.name + " — " + (sen.ok ? "CONFIRMED" : "REJECTED") + " " + sen.aye + "–" + sen.no); }catch(e){}
  try{ OH.list = []; ohEnsure(); ofhSync(); }catch(e){}
  return sen;
}
/* a vacant seat is nobody: it is not drawn, not listed, and casts no vote */
{ const _oh = ohSpec; ohSpec = function(){ const L = _oh.apply(this, arguments); try{ return L.filter(o => !(/^bench:/.test(o.k) && G.court && G.court[+o.k.slice(6)] && G.court[+o.k.slice(6)].vacant)); }catch(e){ return L; } }; }
{ const _db = dkBench; dkBench = function(c){ const r = _db.apply(this, arguments); try{ return r.filter((x, i) => !(G.court && G.court[i] && G.court[i].vacant)); }catch(e){ return r; } }; }
