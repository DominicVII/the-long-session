  function node(id, me){ const r = P(id); if(!r) return null; const d = document.createElement("div"); d.className = "nf-n" + (me ? " me" : "") + (r.alive === false ? " dead" : ""); d.setAttribute("role", "button"); d.tabIndex = 0;
