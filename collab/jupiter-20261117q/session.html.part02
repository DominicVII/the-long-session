          const r = offlineLine(p, {stage:o.channel || o.kind || "face", text:o.text || "", audience:"you"}); if(r && r.text){ said(p.id, r.text); try{ window.onumSpoke(p.id, r.text); }catch(e){} return r.text; } } }catch(e){} return _or.apply(this, arguments); }; } }catch(e){}
