      drop(key); grp.add(g); cells.set(key, {g, lvl, solids:geo.solids, lamps:geo.lamps, geo, cacheKey:ck});
      if(solidsSink) geo.solids.forEach(s => solidsSink.push(s)); if(lampsSink) geo.lamps.forEach(s => lampsSink.push(s)); };
    const pump = () => { busy = false; const job = queue.shift(); if(!job) return; const c = cells.get(job[0]);
      if(!c || c.lvl !== job[1]){ const t0 = performance.now(); try{ build(job[0], job[1]); }catch(e){ ndWarn("cell " + job[0], e); } ND.stats.cellMs = Math.round(performance.now() - t0); }
