      PROPS.home.push({id:"nh:kit", label:"Your kitchen", sub:"A stove, an icebox, a loaf; the food is yours", x:-2.4, z:3.4, r:2.0,
        acts:() => { const b = bodyOf(G.you), full = b.hunger < 0.15, eat = (t, m, g, line) => ({t, c:m + "m", off:full, run(){ spend(m, -g); try{ bodyEat(G.you); }catch(e){} setSay(line, fx("+" + (g + 6) + " energy", m + " minutes")); }});
          return [eat("Make breakfast", 20, 8, "Eggs, toast, and the quiet before the building wakes."), eat("Cook a proper supper", 45, 14, "You cook for one, and it is better than the dining room."), eat("Something cold from the icebox", 8, 4, "Standing up, in the dark, with the door open."), {t:"Put the kettle on", c:"10m", run(){ spend(10, -8); setSay("Tea. Not food, but it helps.", fx("+8 energy", "10 minutes")); }}]; }});
