    let n = 0; ids.forEach((id, i) => { if(id === "&"){ const a = document.createElement("span"); a.className = "nf-amp"; a.textContent = "\u2665"; g.appendChild(a); return; } const d = node(id, id == focus); if(d){ g.appendChild(d); n++; } }); return n ? g : null; }
