  function fitTalk(){ const T = el("talk"); if(!T) return; if(!T.classList.contains("is-open")){
    T.style.removeProperty("bottom"); T.style.removeProperty("padding-bottom");
    try{ ["tkActs","tkOwn"].forEach(id => { const n = el(id); if(!n) return; ["position","left","right","bottom","z-index","max-height","min-height","overflow","width"].forEach(p => n.style.removeProperty(p)); }); }catch(e){}
