    box("leaf", cx, 0.03, cz, w, 0.04, d, 0x4e7a3a); box("stone", cx, 0.055, cz, 2.0, 0.02, d, 0xc9b99a); box("stone", cx, 0.056, cz, w, 0.02, 2.0, 0xc9b99a);
