  }
  const STAT = {settle:[{standing:1, influence:1}, {}], question:[{standing:2, influence:1, heat:-3}, {standing:-2, heat:5}], object:[{influence:2}, {standing:-1, influence:-1}], side:[{standing:1}, {}], amend:[{standing:2, approval:1}, {standing:-1}],
    cut:[{influence:2, heat:4}, {standing:-2, heat:8}], whisper:[{pledge:1, funds:-2}, {funds:-2, standing:-2}], yield:[{standing:1}, {}], silent:[{}, {}], aide:[{standing:1}, {}], limits:[{standing:1}, {}], openfloor:[{approval:1}, {}],
    rule:[{standing:2, influence:2}, {standing:-3}], rulecomp:[{standing:1, approval:1}, {}], room:[{}, {}]};
  const SCORE = {question:2, settle:1, object:1, side:1, amend:2, cut:1, whisper:2, yield:1, silent:0, aide:1, limits:1, openfloor:1, rule:2, rulecomp:1, room:0};
  const shift = function(S, p, d, why){ if(!p || p.gone) return; const o = p.stance; p.stance = cl(Math.round(p.stance + d * (1 - p.conv / 260)), 0, 100); p.moved += p.stance - o; if(p.stance !== o) p.hist.push((p.stance > o ? "+" : "") + (p.stance - o) + " " + why); }
  /* the aide argues your side, in their own words, to whoever is not yet with you */
  const aideSpeak = function(S, n){
    const A = S.x.aide; if(!A) return [];
    const C = S.x.cast.filter(p => !p.gone), out = [], M = S.x.M, y = G.you;
    const tg = C.filter(p => side(p) <= 0).sort((a, b) => a.stance - b.stance);
    const delta = Math.max(2, Math.min(8, Math.round(A.infl / 100 * 7)));
    for(let i = 0; i < (n || 1); i++){
      const t = tg[i] || C[0]; if(!t) break;
      let reason = "";
      try{ const b = M.bill; if(b && b.pos){ const ax = AXES.slice().sort((x, z) => Math.abs(b.pos[z.k] || 0) - Math.abs(b.pos[x.k] || 0))[0], dir = (b.pos[ax.k] || 0) > 0 ? 1 : -1, yAye = alignment(y, b) >= 0, bank = DK_READ[ax.k] && DK_READ[ax.k][dir] && DK_READ[ax.k][dir][yAye ? "for" : "against"]; if(bank) reason = bank[Math.floor(Math.random() * bank.length)]; } }catch(e){}
      if(t.case && t.case.settleShort){ const text2 = (i === 0 ? one(["The chair will forgive me; I speak for the Governor. ", "Let me put the Governor's case, since it is not being put. "]) : "And to " + t.sn + " directly: ") + "The Governor does not doubt " + t.case.short + ". The question is how: " + t.case.settleShort + " gets " + t.sn + " most of what they came for, and the rest has a date. " + capS(t.case.stakeShort || "") + ", which is why it should not be left.";
        shift(S, t, Math.round(delta * 1.2), "argued by " + A.sn); C.filter(o => o !== t && side(o) === 0).forEach(o => shift(S, o, 2, A.sn + " argued your line"));
