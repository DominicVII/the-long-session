/* 20261114a */
/* 20261114a — etiquette, the table, the powers, the ledger, the race, the paper, every path.
   No new kind of person. They keep a manner, and they do not speak as someone they are not. */
function onumEtiq(){
  if(!G.etiq || G.etiq.v !== 1) G.etiq = {v:1, log:[]};
  return G.etiq;
}
function onumManner(p){
  if(!p || p === G.you) return null;
  if(!p.manner || p.manner.v !== 1){
    const disc = (p.traits && p.traits.discretion) || 50;
    p.manner = {v:1, held:0, said:0, slips:0, strict:disc >= 64 ? 1 : 0, taught:false,
      rule:"I do not say aloud an office, a creed, or a name that is not mine. I do not say what the room does not need."};
  }
  return p.manner;
}
function onumNeedRoll(p, text, where){
  try{ return Math.abs(seedOf(String(p && p.id) + ":" + where + ":" + (G.day || 0) + ":" + String(text || "").length)) % 100; }
  catch(e){ return ((G.day || 0) * 13 + String(text || "").length) % 100; }
}
function onumNeeded(p, text, where){
  if(where === "cabinet" || where === "summit" || where === "reply") return true;
  const T = (p && p.traits) || {};
  const M = onumManner(p);
  const strict = M ? (M.strict || 0) : 0;
  const low = String(text || "").toLowerCase();
  const bill = G.bill && !G.bill.done ? String(G.bill.title || "") : "";
  const onBill = bill && low.indexOf(bill.toLowerCase().slice(0, 14)) >= 0;
  const home = p && p.state && low.indexOf(String(p.state).toLowerCase()) >= 0;
  const hot = (T.temper || 0) > 74;
  if(onBill || home || hot) return true;
  const disc = T.discretion || 42;
  const cut = (where === "vox" ? 46 : 62) + strict * 10;
  if(disc < cut && (T.temper || 40) > 48) return true;
  return onumNeedRoll(p, text, where) > (38 + strict * 12);
}
function onumHeld(p, why, where){
  const M = onumManner(p);
  if(!M) return;
  M.held++;
  if(M.held === 3 || M.held === 8) M.strict = Math.min(4, (M.strict || 0) + 1);
  if(!M.taught && M.held >= 3){
    M.taught = true;
    try{ remember(p, M.rule, 2, true); }catch(e){}
  }
  M.last = {d:G.day, where:where, why:why};
  const line = (p.name || "They") + " did not say it (" + where + "). " + why;
  try{ remember(p, "I did not say it. " + M.rule, 1); }catch(e){}
  try{ ledgerOwn(p, line); }catch(e){}
  const E = onumEtiq();
  E.log.unshift({d:G.day, id:p.id, who:p.name, where:where, why:why});
  if(E.log.length > 40) E.log.pop();
}
function onumGate(p, text, where){
  const raw = String(text || "").replace(/\s+/g, " ").trim();
  if(!p || p === G.you || !raw) return {say:true, text:raw, why:""};
  const key = String(p.id) + "|" + where + "|" + raw.slice(0, 70);
  if(p._gk === key && p._gr) return p._gr;
  const M = onumManner(p);
  let t = raw.replace(/[\u201c"]([^\u201d"]{32,})[\u201d"]/g, "what was said");
  const role = String(p.role || p.post || "").toLowerCase();
  const titles = ["president", "governor", "speaker", "secretary of state", "secretary of the treasury", "secretary of war", "secretary of defense", "attorney general", "chief justice"];
  let slip = false;
  titles.forEach(function(title){
    const re = new RegExp("\\b(I am|as|I'm) the " + title + "\\b", "i");
    if(re.test(t) && role.indexOf(title) < 0){
      slip = true;
      t = t.replace(re, "not as the " + title);
    }
  });
  if(G.you && G.you.name && t.indexOf("I am " + G.you.name) >= 0){
    slip = true;
    t = t.replace("I am " + G.you.name, "I am not " + G.you.name);
  }
  if(slip){
    if(M) M.slips++;
    t = "I will not speak as someone I am not. I am " + (p.role || p.name) + ". " + t;
    try{ remember(p, "I nearly spoke as someone else. I stopped.", 2); }catch(e){}
  }
  let res;
  if(!onumNeeded(p, t, where)){
    const why = "It was not needed, and it was not " + String(p.name || "theirs").split(" ")[0] + "'s to put in the room.";
    res = {say:false, text:"", why:why};
    onumHeld(p, why, where);
  } else {
    if(M) M.said++;
    if(where === "vox" && t.length > 320 && (p.traits && p.traits.discretion > 58)) t = t.slice(0, 300).replace(/\s+\S*$/, "") + ".";
    res = {say:true, text:t, why:""};
  }
  p._gk = key;
  p._gr = res;
  return res;
}

{ const _ss = setSay; setSay = function(t, n){
  try{
    const m = (typeof TALK !== "undefined" && TALK && TALK.open && TALK.m) ? TALK.m : null;
    const s = String(t || "");
    if(m && s && s.charAt(0) !== "\u201c" && s.charAt(0) !== '"'){
      const g = onumGate(m, s, "talk");
      if(!g.say){
        t = m.name.split(" ")[0] + " does not say it.";
        n = (n || "") + " " + g.why;
      } else t = g.text;
    }
  }catch(e){}
  return _ss.call(this, t, n);
}; }
{ const _am = appendMsg; appendMsg = function(kind, text, who){
  try{
    if(kind === "them" && TALK && TALK.m){
      const g = onumGate(TALK.m, text, "talk");
      if(!g.say) text = TALK.m.name.split(" ")[0] + " does not say it. " + g.why;
      else text = g.text;
    }
  }catch(e){}
  return _am.call(this, kind, text, who);
}; }
{ const _nl = ssnNpcLine; ssnNpcLine = function(m){
  const l = _nl.apply(this, arguments);
  try{
    const where = (typeof SSN !== "undefined" && SSN && (SSN.kind === "cabinet_meeting" || SSN.kind === "governor_council")) ? "cabinet" : "floor";
    const g = onumGate(m, l, where);
    if(!g.say) return (m && m.name ? m.name.split(" ")[0] : "They") + " does not take it up. It was not theirs.";
    return g.text;
  }catch(e){ return l; }
}; }
{ const _cs = (typeof cabShow === "function") ? cabShow : null; if(_cs) cabShow = function(p, out){
  try{
    const g = onumGate(p, out, "cabinet");
    if(!g.say) out = (p && p.name ? p.name.split(" ")[0] : "They") + " does not add it. " + g.why;
    else out = g.text;
  }catch(e){}
  return _cs.call(this, p, out);
}; }
{ const _va = voxAdd; voxAdd = function(post){
  try{
    if(post && !post.mine && post.by != null){
      const p = byId(post.by);
      if(p){
        const g = onumGate(p, post.t, post.reply ? "reply" : "vox");
        if(!g.say) return;
        post.t = g.text;
      }
    }
    if(post && !post.mine && !String(post.t || "").trim()) return;
  }catch(e){}
  return _va.apply(this, arguments);
}; }

function onumLean(p){
  let lean = "quiet", why = "Not their point to mark.";
  const bill = G.bill && !G.bill.done ? G.bill : null;
  try{
    if(bill && p && p !== G.you && typeof memberVote === "function" && p.kind === "member"){
      const v = memberVote(p, bill);
      if(v > 0) return {id:p.id, name:p.name, role:p.role || "", lean:"for", why:"With " + bill.title + "."};
      if(v < 0) return {id:p.id, name:p.name, role:p.role || "", lean:"against", why:"Against " + bill.title + "."};
    }
  }catch(e){}
  if(p && G.you && p.party && p.party === G.you.party){ lean = "for"; why = "Same caucus. Not a signature they handed over."; }
  else if(p && G.you && p.party && G.you.party && p.party !== G.you.party){ lean = "against"; why = "Not their caucus, and they will not pretend."; }
  else if(p && p.traits && p.traits.discretion > 70){ lean = "quiet"; why = "They are in the room. The point is not theirs to mark."; }
  return {id:p ? p.id : null, name:p ? p.name : "Someone", role:(p && p.role) || "", lean:lean, why:why};
}
function onumTablePeople(){
  const out = [];
  const seen = {};
  const add = p => { if(!p || p === G.you || p.gone || seen[p.id]) return; seen[p.id] = 1; out.push(p); };
  try{ if(typeof cabSeats === "function") cabSeats().forEach(add); }catch(e){}
  try{
    if(typeof presStaff === "function" && typeof PRES_ROLES !== "undefined"){
      const st = presStaff();
      Object.keys(PRES_ROLES).forEach(k => add(st && st[k]));
    }
  }catch(e){}
  try{ if(typeof SSN !== "undefined" && SSN && SSN.seats) SSN.seats.forEach(s => { if(s.personId !== "you") add(byId(s.personId)); }); }catch(e){}
  return out.slice(0, 8);
}
function onumLiveReact(speaker, text){
  const rows = onumTablePeople().filter(p => !speaker || p !== speaker).map(onumLean);
  const last = function(n){ return String(n || "").split(" ").slice(-1)[0]; };
  const forN = rows.filter(r => r.lean === "for").map(r => last(r.name));
  const agN = rows.filter(r => r.lean === "against").map(r => last(r.name));
  const qN = rows.filter(r => r.lean === "quiet").map(r => last(r.name));
  const posted = "Posted to the table: with it, " + (forN.join(", ") || "no one") + ". Against, " + (agN.join(", ") || "no one") + ". Held, " + (qN.join(", ") || "no one") + ".";
  rows.forEach(r => { const p = byId(r.id); try{ if(p) ledgerOwn(p, posted); }catch(e){} });
  try{ if(G.you) ledgerOwn(G.you, posted); }catch(e){}
  try{ if(typeof SSN !== "undefined" && SSN){ ssnEnsure().log.push({d:G.day, kind:SSN.kind, act:"live", who:"the table", t:posted.slice(0, 160)}); } }catch(e){}
  const live = {at:Date.now(), speaker:speaker && speaker.name, text:String(text || "").slice(0, 180), rows:rows, posted:posted};
  try{ if(typeof SSN !== "undefined" && SSN) SSN.live = live; }catch(e){}
  try{ if(window.ONUM_SESSION) window.ONUM_SESSION.live = live; }catch(e){}
  G._live = live;
  try{ onumSessStrip(); }catch(e){}
  return live;
}
function onumBillBits(){
  const b = G.bill && !G.bill.done ? G.bill : null;
  if(!b) return {title:"No bill on the table", line:"The chair has not laid a paper down. There is nothing to be for yet."};
  const bits = [b.title];
  if(b.line) bits.push(b.line);
  if(b.sponsor) bits.push("In under " + b.sponsor + (b.sponsorParty ? " (" + b.sponsorParty + ")" : "") + ".");
  return {title:b.title, line:bits.slice(1).join(" ") || "The clerk has the title. The argument is whose it is."};
}
function onumTableTalk(text){
  const said = String(text || "").trim();
  if(!said) return;
  try{ if(window.onumSession && typeof SSN !== "undefined" && SSN && window.onumSession.speak) window.onumSession.speak(said); }catch(e){}
  const live = onumLiveReact(G.you, said);
  const answers = [];
  onumTablePeople().slice(0, 5).forEach(p => {
    const take = onumLean(p);
    const about = take.lean === "for"
      ? "On the bill I am with it, in my own office, not in yours."
      : take.lean === "against"
        ? "On the bill I am against it. I will not dress that up to keep the afternoon kind."
        : "I am not marking it. It is not mine to mark, and I will not borrow a voice.";
    const g = onumGate(p, (typeof onumSay === "function" ? onumSay(p, about) : about), "cabinet");
    if(!g.say) answers.push({p:p, t:p.name.split(" ")[0] + " does not add it.", lean:"quiet"});
    else answers.push({p:p, t:g.text, lean:take.lean});
  });
  G._liveAnswers = answers;
  return {live:live, answers:answers};
}
function onumTableCard(){
  const B = onumBillBits();
  const live = G._live;
  const rows = (live && live.rows) || onumTablePeople().map(onumLean);
  const paint = r => '<div style="margin:4px 0"><b>' + onumEsc(r.name) + '</b> <span class="muted">· ' + onumEsc(r.role || "") + ' · ' + (r.lean === "for" ? "with it" : r.lean === "against" ? "against it" : "held") + '</span><div class="muted">' + onumEsc(r.why || "") + '</div></div>';
  const ans = (G._liveAnswers || []).map(a => '<div style="margin:6px 0"><b>' + onumEsc(a.p.name) + '</b><div>“' + onumEsc(a.t) + '”</div></div>').join("");
  const body = '<p><b>' + onumEsc(B.title) + '</b></p><p>' + onumEsc(B.line) + '</p>' +
    '<div class="eyebrow">Posted to all of them</div>' + (rows.length ? rows.map(paint).join("") : '<p class="muted">Nobody is at the table yet.</p>') +
    (live && live.posted ? '<p class="muted">' + onumEsc(live.posted) + '</p>' : '') +
    '<div class="eyebrow">Say it, about the bill</div><textarea id="tbSay" maxlength="240" style="width:100%;min-height:64px" placeholder="Your own words. They will answer as themselves."></textarea>' +
    '<div class="card__actions"><button type="button" class="btn" id="tbGo">Say it to the table</button></div><div class="dream" id="tbOut"></div>' + ans;
  govCardOpen("The table", "Who is with it, who is not", "The same slip is posted to every person in the room. They can see it. You can see the bill, and you can talk about it.", body, null);
  const go = el("tbGo"); if(go) go.addEventListener("click", () => {
    const inp = el("tbSay");
