  ["onum-engine", "onum-engine-audit"].forEach(ev => addEventListener(ev, () => setTimeout(redraw, 30)));
  /* the Audit panel */
  const esc = s => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({"&":"&"+"amp;", "<":"&"+"lt;", ">":"&"+"gt;", '"':"&"+"quot;"})[c]);
  let P = null;
  function fill(){ const A = audit(); const col = (h, L) => '<div class="nd-au-col"><h3>' + h + ' <small>' + L.length + '</small></h3>' + (L.length ? '<ul>' + L.map(r => '<li><b>' + (r.day != null ? "Day " + esc(r.day) : "") + '</b> ' + esc(r.what || "a proposal") + (r.why ? '<br><i>' + esc(r.why) + '</i>' : '') + '</li>').join("") + '</ul>' : '<p class="nd-au-none">' + (A.live ? "None." : "Awaiting record.") + '</p>') + '</div>';
    P.querySelector(".nd-au-body").innerHTML = col("Asked", A.asked) + col("Granted", A.granted) + col("Refused", A.refused);
    const TAG = {unverified:["Unverified", "nd-cl-u"], verified:["Verified", "nd-cl-v"], refuted:["Refuted", "nd-cl-r"]};
    let cl = P.querySelector(".nd-au-claims"); if(!cl){ cl = document.createElement("div"); cl.className = "nd-au-claims"; P.appendChild(cl); }
    cl.innerHTML = '<h3>Claims <small>' + A.claims.length + '</small></h3>' + (A.claims.length ? '<ul>' + A.claims.map(c => '<li class="' + TAG[c.status][1] + '"><span class="nd-cl-tag">' + TAG[c.status][0] + '</span> ' + (c.day != null ? '<b>Day ' + esc(c.day) + '</b> ' : '') + '<span class="nd-cl-t">' + esc(c.what) + '</span>' + (c.why ? '<br><i>' + esc(c.why) + '</i>' : '') + '</li>').join("") + '</ul>' : '<p class="nd-au-none">' + (A.live ? "No claims on record." : "Awaiting record.") + '</p>'); }
  function open(){ try{ if(!P){ const st = document.createElement("style"); st.textContent = "#ndAudit{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:10050;width:min(920px,92vw);max-height:80vh;overflow:auto;background:#101418;color:#fff;border:2px solid #c9a85a;border-radius:8px;padding:14px 18px;font:14px/1.4 system-ui,sans-serif;box-shadow:0 10px 40px #000}" +
        "#ndAudit h2{margin:0 0 10px;font:700 20px Georgia,serif;color:#f6e7b8}#ndAudit .nd-au-body{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}#ndAudit h3{margin:0 0 6px;font:700 15px system-ui;color:#f0c674;border-bottom:1px solid #c9a85a;padding-bottom:4px}#ndAudit h3 small{color:#d9cfb4;font-weight:400}" +
        "#ndAudit ul{margin:0;padding-left:16px}#ndAudit li{margin:0 0 7px}#ndAudit i{color:#e7d9a8}#ndAudit .nd-au-none{color:#d9cfb4;font-style:italic}#ndAudit .nd-au-x{position:absolute;right:10px;top:8px;background:#2a2f36;color:#fff;border:1px solid #c9a85a;border-radius:4px;cursor:pointer}" +
        ".nd-au-claims{margin-top:14px;border-top:1px solid #c9a85a;padding-top:8px}.nd-au-claims ul{list-style:none;padding:0}.nd-cl-tag{display:inline-block;min-width:78px;text-align:center;font:700 11px system-ui;padding:1px 6px;border-radius:9px;margin-right:4px}" +
