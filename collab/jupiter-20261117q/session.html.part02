      if(cv && (cv.asked || []).length < 6) add("question", "Ask " + cv.sn + " about " + cv.case.short, cv, 0.1, "An honest answer: the cost, the cause, who it touches, or what happens if the state waits. You learn what the room is arguing over.");
      const sc = C.find(q => q.case && !q.settleKnown); if(sc) add("settle", "Ask " + sc.sn + " what they would settle for", sc, 0.1, "Finds the part they cannot do without. That is the shape of a deal."); }
