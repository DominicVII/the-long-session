function baHoldFloor(p, out){ if(!SSN) return; SSN.floorId = p.id; SS2.spkUntil = Date.now() + ss2Read(out); SSN._busy = SS2.spkUntil + 800; ss2Pub();
  const tok = SSN._tok; setTimeout(() => { try{ if(SSN && SSN.floorId === p.id && SSN._tok === tok){ SSN.floorId = null; SSN._busy = 0; ss2Pub(); } }catch(e){} }, ss2Read(out) + 900); }
{ const _ca = cabAsk; cabAsk = async function(p, you, text, kind){ if(!p || !SSN) return; const n0 = (SSN._th || []).length; /* 20261104bk: do not bump _baGen here — cabCallOn owns supersede; capture current gen */
  const gen = SSN._baGen || 0; SSN.floorId = p.id; try{ ss2Pub(); }catch(e){}
