  const cbtn = document.createElement("button"); cbtn.type = "button"; cbtn.id = "ltChatBtn"; cbtn.title = "Chat (Ctrl+Shift+K)"; cbtn.textContent = "💬 Chat"; cbtn.onclick = () => { const C = document.getElementById("ltChat"); if(C && !C.hidden && !C.classList.contains("is-dock")) chatClose(); else chatOpen(); }; document.body.appendChild(cbtn);

