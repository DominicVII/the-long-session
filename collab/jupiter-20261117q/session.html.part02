      else if(String(ch.status) === "built"){ const lb = nameLabel(o.name, o.lot.x - (ch.kind === "home" ? 7.5 : 9) / 2 + 0.6, 1.2, o.lot.z + (ch.kind === "home" ? 9 : 11) / 2 + 1.46); if(lb) g.add(lb); }
      if(String(ch.status) === "planned"){ const lb = nameLabel(o.name, o.lot.x - (ch.kind === "home" ? 7.5 : 9) / 2 + 1.5, 1.62, o.lot.z + (ch.kind === "home" ? 9 : 11) / 2 + 0.47); if(lb) g.add(lb); }
