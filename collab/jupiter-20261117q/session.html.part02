}
/* ── the retired fade: the most recent former officials stay, and anyone the ledger still names ── */
function formerPrune(){
  const civ = G.civ || [], led = new Set(); try{ Object.values(ofhEnsure().seats).forEach(R => R.holders.forEach(h => { if(typeof h.personId === "number") led.add(h.personId); })); }catch(e){}
  const formers = civ.filter(c => c && /^former:/.test(c.scKey || "")).sort((a, b) => b.id - a.id), keep = new Set(formers.slice(0, 60).map(c => c.id));
