/* ── the press corps ── */
const PRESS_OUTLETS = ["The Clarion", "Bell & Post", "Northern Wire", "The Register", "Capitol Daily", "The Evening Wire", "The Capitol Ledger", "The Republic Gazette"];
function pressMend(){
  if(!Array.isArray(G.press)) G.press = []; let n = 0; const have = new Set();
  G.press.forEach(p => { if(have.has(p.outlet)){ const o = PRESS_OUTLETS.find(x => !have.has(x) && !G.press.some(q => q.outlet === x)); if(o){ p.outlet = o; n++; } } have.add(p.outlet); });   /* two reporters, two papers */
