  /* the static place list for NPC schedules: every cell within RINGS of the core, computed without geometry */
  const staticPois = (seed, rings) => { const out = []; const sv = [POIS, SOLIDS, LAMPS, BK, DRY]; POIS = out; SOLIDS = null; LAMPS = null; BK = {}; DRY = true;
    try{ const keys = new Set(); for(let i = -rings; i <= rings; i++) for(let j = -rings; j <= rings + 1; j++) if(cellExists(i, j)) keys.add(i + "," + j); EXTRA.forEach(k => keys.add(k));
      keys.forEach(k => { const [i, j] = k.split(",").map(Number); try{ genCell(i, j, seed, 1); }catch(e){} }); } finally { [POIS, SOLIDS, LAMPS, BK, DRY] = sv; noFrame(); house.lod = 0; }
    out.forEach((p, k) => { p.id = p.kind + "_c" + (k + 1); p.cell = cellOf(p.pos.x, p.pos.z).join(","); }); return out; };
  const SOLC = new Map();
  const cellSolids = (i, j) => { const k = i + "," + j; if(SOLC.has(k)) return SOLC.get(k); const out = [];
    if(cellExists(i, j)){ const sv = [POIS, SOLIDS, LAMPS, BK, DRY]; POIS = null; SOLIDS = out; LAMPS = null; BK = {}; DRY = true;
      try{ genCell(i, j, 7, 1); }catch(e){} finally { [POIS, SOLIDS, LAMPS, BK, DRY] = sv; noFrame(); house.lod = 0; } }
    SOLC.set(k, out); return out; };
  const CELL_KMAP = {leaf:"paint", brass:"paint", asphalt:"stone"};
  const buildCellGeo = (i, j, seed, lvl, style) => { const sv = [BK, SOLIDS, POIS, LAMPS, CHUNK, KMAP, ST, signI];
    BK = {}; SOLIDS = lvl < 2 ? [] : null; POIS = null; LAMPS = []; CHUNK = "x"; KMAP = CELL_KMAP; ST = STYLES[style] || STYLES.brick_row; signI = (i * 7 + j * 3) & 15;
    let out; try{ const type = genCell(i, j, seed, lvl); const parts = []; Object.keys(BK).forEach(k => parts.push({b:{k:BK[k].k, ch:"cell"}, geo:makeGeo(BK[k])})); out = {parts, solids:SOLIDS || [], lamps:LAMPS, type}; }
    finally { [BK, SOLIDS, POIS, LAMPS, CHUNK, KMAP, ST, signI] = sv; noFrame(); house.lod = 0; }
