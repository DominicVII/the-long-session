    while((m = re.exec(t))){ const a = m[1].toLowerCase(), b = m[2].toLowerCase(); if(COMMON.has(a) || COMMON.has(b)) continue; if(!K.has(a) && !K.has(b)) out.push(m[0]); }
    return out; }
  function okLine(t, last, K){ t = String(t || "").trim(); if(!t) return "empty"; if(STOCK.test(t)) return "stock";
    const n = norm(t); if((last || []).some(x => { const y = norm(memText(x)); return y && (y === n || (n.length > 24 && (y.indexOf(n) >= 0 || n.indexOf(y) >= 0))); })) return "repeat";
