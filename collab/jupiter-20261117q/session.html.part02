  clearTimeout(timer); if(!live()) return; if(!done){ if(SSN && (SSN._th || []).length > n0){ done = true; const last = SSN._th[SSN._th.length - 1]; baHoldFloor(p, last.text); } else fall(); } }; }
cabCallOn = function(id){ try{ const p = byId(isNaN(+id) ? id : +id); if(!p || !SSN) return false; const kind = SSN.kind;
    /* 20261104bi C4: calling on B while A holds the floor supersedes A — cancel A's stream/rebut (tok), BA fallback (gen), hold and busy */
    try{ SSN._tok = (SSN._tok || 0) + 1; SSN._baGen = (SSN._baGen || 0) + 1; SSN._busy = 0; SSN._arg = null; if(typeof SS2 !== "undefined" && SS2){ SS2.spkUntil = 0; } }catch(e){}
