    for(let i = 0; i < 14; i++){ const tx = x0 + 3 + r() * (w - 6), tz = z0 + 3 + r() * (d - 6); if(Math.abs(tx - cx) < 2.5 || Math.abs(tz - cz) < 2.5) continue; tree(tx, tz, 2.4 + r(), 1.0 + r() * 0.6, (r() * 1e6) | 0); }
