  function chatClose(){ const C = document.getElementById("ltChat"); if(C){ C.hidden = true; if(C.parentNode !== document.body) document.body.appendChild(C); } }
  LT.chatOpen = chatOpen; LT.chatClose = chatClose; LT.contacts = contacts;
  window.addEventListener("keydown", e => { if(e.ctrlKey && e.shiftKey && (e.key === "K" || e.key === "k")){ e.preventDefault(); const C = document.getElementById("ltChat"); if(C && !C.hidden) chatClose(); else chatOpen(); } }, true);
