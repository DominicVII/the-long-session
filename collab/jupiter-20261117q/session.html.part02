      if(!reason) reason = one(["the cost is known and the delay costs more", "the people who asked for this have waited long enough", "the alternative is to do nothing, and nothing has a price too", "it is a fair settlement, and fair is rarer than perfect"]);
      const own = A.pos && M.bill && M.bill.pos ? (alignment({pos:A.pos}, M.bill) >= 0) === (alignment(y, M.bill) >= 0) : true;
      const text = (i === 0 ? one(["The chair will forgive me; I speak for " + (function(){ try{ return ndYou().address; }catch(e){ return "the member"; } })() + ". ", "Allow me to say what my principal has said to me. ", "Let me put the case, since it is not being put. "]) : "And to " + t.sn + " directly: ") + (own ? "I believe it myself: " : "I would not always have chosen it, but the line is clear and here is the best of it: ") + reason + ".";
      const f = A.party && t.party === A.party ? 1.3 : 1, d = Math.round(delta * f * (Math.random() < Math.max(0, (A.temper - 70) / 120) ? -0.3 : 1));
