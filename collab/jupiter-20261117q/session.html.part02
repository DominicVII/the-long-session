      const a = mk(charterCanvas(), x, 1.45, 9.2, ry); a.name = "ndCharter"; const b = mk(refusedCanvas(), x, 1.45, 3.9, ry); b.name = "ndRefused"; meshes = [[a, charterCanvas], [b, refusedCanvas]]; }catch(e){ try{ console.warn("NEPTUNE-ENGINE-WALL", e); }catch(x){} } }
  function redraw(){ try{ if(G.room !== "engine") return; meshes.forEach(([m, f]) => { if(m && m.parent){ m.material.map.image = f(); m.material.map.needsUpdate = true; } }); }catch(e){} try{ if(P && !P.hidden) fill(); }catch(e){} }
  EW.redraw = redraw;
