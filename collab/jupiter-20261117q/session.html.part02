  function wrap(g, s, maxW){ const W = String(s).split(/\s+/), out = []; let l = ""; W.forEach(w => { const t = l ? l + " " + w : w; if(g.measureText(t).width > maxW && l){ out.push(l); l = w; } else l = t; }); if(l) out.push(l); return out; }
  function board(title, sub, rows, note){ const c = document.createElement("canvas"); c.width = 768; c.height = 560; const g = c.getContext("2d");
    g.fillStyle = "#101418"; g.fillRect(0, 0, 768, 560); g.strokeStyle = "#c9a85a"; g.lineWidth = 5; g.strokeRect(12, 12, 744, 536);
    g.fillStyle = "#f6e7b8"; g.textAlign = "center"; g.font = "700 40px Georgia,serif"; g.fillText(title, 384, 66);
    g.font = "italic 20px Georgia,serif"; g.fillStyle = "#d9cfb4"; g.fillText(sub, 384, 96); g.fillStyle = "#c9a85a"; g.fillRect(200, 110, 368, 2);
    g.textAlign = "left"; let y = 146;
    for(const r of rows){ if(y > 500) { g.font = "italic 18px Georgia,serif"; g.fillStyle = "#d9cfb4"; g.fillText("\u2026 and more in the Audit", 44, 528); break; }
      g.font = (r.b ? "700 " : "") + "23px Georgia,serif"; g.fillStyle = "#ffffff";
      const L = wrap(g, r.t, 680); L.forEach((l, i) => { if(y > 515) return; g.fillText((i === 0 ? (r.lead || "") : "") + l, 44 + (i ? 28 : 0), y); y += 29; });
      if(r.s){ g.font = "19px Georgia,serif"; g.fillStyle = "#e7d9a8"; wrap(g, r.s, 650).forEach(l => { if(y > 515) return; g.fillText(l, 72, y); y += 25; }); }
      y += 10; }
    if(note){ g.font = "italic 19px Georgia,serif"; g.fillStyle = "#f0c674"; g.textAlign = "center"; g.fillText(note, 384, 536); }
    return c; }
  function charterCanvas(){ const A = audit(); return board("The Charter", "the Engine's binding limits", A.charter.map((t, i) => ({t, lead:(i + 1) + ".  "})), A.charterLive ? "" : "awaiting record"); }
  function refusedCanvas(){ const A = audit(); const rows = A.refused.slice(0, 8).map(r => ({t:(r.day != null ? "Day " + r.day + ": " : "") + (r.what || "a proposal"), s:r.why ? "Refused: " + r.why : "", b:true}));
