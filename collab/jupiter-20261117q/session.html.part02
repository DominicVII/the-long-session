    solidAt(cx, cz, 3.8, 4.6); solidAt(cx, cz - 4.9, 1.6, 1.6);
    poi("church", name, cx, cz, cx, cz - 6.9, [[cx - 1.2, cz - 7.8], [cx + 1.2, cz - 7.8], [cx, cz - 8.6]]); };
  const civicAt = (cx, cz, w, name, kind) => { const H = 9;
    box("stone", cx, 0.4, cz, w + 2, 0.8, 16, 0xd6cfbe); box("stone", cx, H / 2 + 0.8, cz + 1, w, H, 12, 0xe2dccd);
    for(let i = 0; i < 6; i++) cyl("stone", cx - w / 2 + 0.8 + i * (w - 1.6) / 5, 4.6, cz - 5.6, 0.32, 7.6, 0xece6d8, 12);
