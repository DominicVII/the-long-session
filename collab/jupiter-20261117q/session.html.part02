    if(chairOf(S).you) return false;
    const ln = floorRound(S, null, false); if(!ln.length) return false;
    S.x.queue = S.x.queue.concat(ln); S.lines = S.x.queue; return true;
  };

  /* ── your moves ── */
  const movesFor = function(S, step){
