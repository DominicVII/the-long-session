  }catch(e){ console.warn("ex html", e); } return h; }; }
document.addEventListener("click", ev => { try{ const t = ev.target && ev.target.closest ? ev.target.closest("[data-exc],[data-exh]") : null; if(!t) return; let r = "";
  if(t.hasAttribute("data-exc")){ const g = id => (document.getElementById(id) || {}).value || ""; const c = exAddCorrection({claim:g("exClaim"), why:g("exWhy"), right:g("exRight")}, "player"); r = c ? "Kept. The Engine will be shown it, and is scored on whether it uses it." : "Write at least what it said, or the right answer."; }
  else { const k = t.getAttribute("data-exh"); r = k === "resume" ? exResume("player") : exHalt(k, "player"); }
