  const L = _pbA.apply(this, arguments) || [];
  [["soc-elect","Elections","Polls, coverage, the field, and what you spend. Its own page."],
   ["soc-web","The Web","Pages and posts the country writes for itself. You may answer."],
   ["soc-people","People","Friendship and courtship, whichever office you hold."],
   ["soc-party","The party","Your caucus, in their own voices."]
  ].forEach(a => { if(!L.some(x => x[0] === a[0])) L.push(a); });
  return L;
