    const con = C.slice().sort((a, b) => a.stance - b.stance)[0], pro = C.slice().sort((a, b) => b.stance - a.stance)[0];
    const mid = C.filter(p => !p.dealt).sort((a, b) => Math.abs(a.stance - 50) - Math.abs(b.stance - 50))[0];
    const talker = C.slice().sort((a, b) => (b.spoke + b.temper / 50) - (a.spoke + a.temper / 50))[0];
    const A = [];
    const add = (k, t, tgt, risk, why) => A.push({k, t, tgt:tgt ? tgt.id : null, risk, why});
    if(step === "gavel"){
      add("limits", "Set strict time limits", null, 0.1, "Hot tempers bristle; the room moves faster.");
      add("openfloor", "Let everyone have their say", null, 0.05, "Speakers soften toward you; it takes longer.");
      add("silent", "Stay silent and watch", null, 0, "You learn who is loud. No cost.");
      return A;
    }
    { const ch = chairOf(S); if(["open", "question", "motion"].indexOf(step) >= 0 && last){ const cs = floorCands(S, last), f = floorState(S);
        if(ch.you){ cs.slice(0, 2).forEach(c => add("recog", "Recognize " + c.sn + " to answer " + last.sn, c, 0, "You hold the chair. " + c.sn + " has been waiting to answer; the others keep their objections until you call them."));
          if(cs.length) add("letrun", "Let the argument run another round", null, 0, "You call the next objectors in order without taking a side.");
        } else if(cs.length && !f.refused && (f.closed || f.rounds >= floorCap(S))) add("letrun", "Ask the chair to let " + cs[0].sn + " answer " + last.sn, cs[0], 0.15, ch.label + " has the gavel. The chair may refuse; you cannot call the order yourself." ); } }
    if(S.x.aide) add("aide", "Have " + S.x.aide.sn + " argue your side", null, 0.05, S.x.aide.name + ", your highest-influence " + (S.x.aide.official ? "administration aide" : "party member") + ", argues your line in their own words while you stay seated.");
    if(step === "vote" || step === "ruling"){
      const t = S.x.tally();
      add("rule", (S.D.kind === "vote" ? "Call the vote on your line" : "Rule with your line") + " (" + t.yes + " with you)", null, t.yes >= t.no ? 0.1 : 0.5, "Wins big if the room is with you; backfires if it is not.");
      if(S.x.amended) add("rulecomp", "Settle it on the compromise: " + S.x.M.comp, null, 0.1, "Safer; nobody gets all they wanted.");
      else add("amend", "Propose a compromise before the vote: " + S.x.M.comp, mid, 0.25, "Moves the middle; costs your firmest allies a little.");
      add("room", "Go with the room", null, 0, "No risk. You follow the majority, and the record says so.");
