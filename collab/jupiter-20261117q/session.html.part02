/* D. before Decisions, two to four named exchanges between secretaries; B. Decisions is a called, cast, tallied vote */
function baArgue(done){ const seats = cabSeats(); if(!SSN || seats.length < 2){ done(); return; }
  const n = 2 + Math.floor(Math.random() * 3), tok = SSN._tok = (SSN._tok || 0) + 1; let i = 0, prev = null;
  const a0 = seats[Math.floor(Math.random() * seats.length)], b0 = seats.filter(x => x !== a0).sort((x, y) => (y.party !== a0.party) - (x.party !== a0.party))[0];
  try{ feed("Before the decision, " + a0.name + " and " + b0.name + " have it out.", ""); }catch(e){}
  const step = async () => { if(!SSN || tok !== SSN._tok) return; if(i >= n){ SSN._busy = 0; SSN.floorId = null; done(); return; }
    const sp = i % 2 ? b0 : a0, other = i % 2 ? a0 : b0; SSN._busy = Date.now() + 70000; SSN.floorId = sp.id; ss2Pub();
    let out = ""; try{ out = await Promise.race([cabLive(sp, prev ? other.name + " has just said: \u201c" + prev + "\u201d" : "The chair wants the room's views before deciding.", "Argue the matter with " + other.name + " before the vote, in one to three sentences, by name."), new Promise(r => setTimeout(() => r(""), 9000))]); }catch(e){}
    if(!SSN || tok !== SSN._tok) return; out = out || (i === 0 ? baReport(sp) : baRebut(sp, other)); prev = out; i++;
    cabShow(sp, out); SSN.floorId = sp.id; SSN._busy = Date.now() + ss2Read(out) + 1200; setTimeout(step, ss2Read(out) + 700); };
  step(); }
function baCallVote(){ if(!SSN || !cabKind() || SSN._baVote) return false; const st = ssnStage(); if(!st || st.id !== "decisions") return false;
  SSN._baVote = 1; const seats = cabSeats(), b = (() => { try{ return ssnBill(); }catch(e){ return null; } })(), tok = SSN._tok = (SSN._tok || 0) + 1, chair = byId(SSN.chairId);
  const say = (p, t) => { try{ if(p){ speakAt(p, t); vhSay(p, t); } }catch(e){} try{ tlog(p ? p.name : "The chair", t, p ? "talk" : "you"); lLog((p ? p.name + ": " : "") + t, "session"); }catch(e){} };
  say(SSN.chairId === "you" ? null : chair, "The question is on " + baTopic() + ". The secretaries will cast in turn, aye or nay."); SSN._busy = Date.now() + 60000; let i = 0;
  /* 20261117o JUPITER: your fixed vote is cast first and out loud, so the table votes knowing where the chair stands */
  try{ if(ss2Entitled(SSN.kind) && SSN.votes.you == null){ const pv = b ? preferredVote(b) : null;
    if(pv === 1 || pv === -1 || pv === 0){ SSN.votes.you = pv === 1 ? "aye" : pv === -1 ? "no" : "present"; say(null, (SSN.chairId === "you" ? "The chair" : "You") + " votes " + (pv === 1 ? "aye" : pv === -1 ? "nay" : "present") + (b ? " on " + b.title : "") + "."); }
    else if(b){ try{ note("You have not fixed a vote on " + b.title + ". Set Aye or No on the docket or the phone now, or you are recorded present."); }catch(e){} } } }catch(e){}
  const next = () => { if(!SSN || tok !== SSN._tok) return;
    if(i >= seats.length){ if(SSN.votes.you == null && ss2Entitled(SSN.kind)){ const pv = b ? preferredVote(b) : null; SSN.votes.you = pv === 1 ? "aye" : pv === -1 ? "no" : "present"; } ssnTally(); const R = SSN.result || {aye:0, no:0};
      /* 20261117o: the roll, by name, and the outcome kept on the matter */
      const roll = {aye:[], no:[], present:[]}; try{ Object.keys(SSN.votes).forEach(id => { const w = SSN.votes[id], nm = id === "you" ? "you" : (function(){ const p = byId(isNaN(+id) ? id : +id); return p ? baSn(p) : String(id); })(); (roll[w === "aye" ? "aye" : w === "no" ? "no" : "present"]).push(nm); }); }catch(e){}
      const line = "Decided, " + R.aye + " to " + R.no + ": " + (R.aye > R.no ? "carried." : "the motion fails.") + " Aye: " + (roll.aye.join(", ") || "none") + ". Nay: " + (roll.no.join(", ") || "none") + "." + (roll.present.length ? " Present: " + roll.present.join(", ") + "." : ""); say(SSN.chairId === "you" ? null : chair, line); try{ feed(line, R.aye > R.no ? "good" : "bad"); }catch(e){}
      try{ SSN.result.roll = roll; if(b){ b.cabinetVote = {d:G.day, kind:SSN.kind, aye:R.aye, no:R.no, carried:R.aye > R.no, roll, you:SSN.votes.you || null}; } }catch(e){}
      const m = seats.find(p => SSN.votes[p.id] === (R.aye > R.no ? "no" : "aye")); if(m) baFollow({in:1, kind:"cabinet", title:"Outvoted in " + (SSN.kind === "governor_council" ? "council" : "cabinet"), whoId:m.id, text:m.name + " lost the vote on " + baTopic() + " and is telling people why.", wire:"CAPITOL · " + baSn(m) + " was outvoted on " + baTopic() + "."});
      SSN._busy = 0; ss2Pub(); setTimeout(() => { try{ if(SSN && tok === SSN._tok && ssnStage().id === "decisions") ssnNext(); }catch(e){} }, ss2Read(line) + 800); return; }
    const p = seats[i++]; let v = 0; try{ v = b ? baAl(p, b.pos, b.title) : ((p.rel && p.rel.warmth) || 0) + (Math.random() * 40 - 20); }catch(e){}
    SSN.votes[p.id] = v >= 0 ? "aye" : "no"; SSN.floorId = p.id; const t = v >= 0 ? "Aye." : "No."; say(p, t + (Math.abs(v) > 25 ? " " + (v > 0 ? "Gladly." : "And I want it minuted.") : "")); ss2Pub(); setTimeout(next, 1400); };
  setTimeout(next, 1800); return true; }
window.onumSession.callVote = baCallVote;
{ const _nx = ssnNext; ssnNext = function(){ try{ if(SSN && cabKind()){ const nx = SSN.def.stages[SSN.si + 1], cur = ssnStage();
      if(nx && nx.id === "decisions" && !SSN._baArg){ SSN._baArg = 1; const me = this, a = arguments; baArgue(() => { try{ _nx.apply(me, a); }catch(e){} }); return; }
      if(cur && cur.id === "decisions" && !SSN._baVoted){ if(!SSN._baVote){ baCallVote(); return; } if(SSN.result == null) return; SSN._baVoted = 1; } } }catch(e){} return _nx.apply(this, arguments); }; }
