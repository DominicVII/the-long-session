/* NEPTUNE-STYLE END */
/* NEPTUNE-OFFLINE BEGIN — 20261020q: an offline reply generator for when Ollama is missing. window.onumOfflineReply({npc, text,
   channel, from, to, stage}) returns a line built from the person's traits, party, mood and memory, never repeating their
   last ten lines. Player-facing talk uses LiveTalk's own offline voice; person-to-person and narrated moments get their
   own. The Engine is left to say less rather than read a template: it gets "". onumLiveTalk.reply({..., offline:true})
   uses it when no model answers. */
try{
  const OG = {
    agree:["{P} has it right, for once.", "I am with {P} on that.", "{P}, you will get no argument from me.", "That is what I have been saying all week, {P}."],
    doubt:["I am not sure that holds, {P}.", "Say that again on the floor, {P}, and see who nods.", "Maybe. I would want the numbers first.", "That is one way to read it, {P}."],
    oppose:["No, {P}. Not on my vote.", "{P}, that is the kind of thing that loses a seat.", "With respect, {P}, you are wrong.", "I would sooner adjourn than agree to that."],
    hot:["Do not lecture me, {P}.", "You have a nerve, {P}.", "Keep your voice down, {P}, people are listening."],
    warm:["Good to see you, {P}.", "{P}. How is the family?", "You look well, {P}. Coffee later?"],
    stage:["Hm.", "Well. There it is.", "I have seen this before.", "Not today.", "Let us see how the room takes it.", "Somebody should write that down."],
    topic:{money:"Who pays for it, is what I want to know.", votes:"Count the room before you count on it.", faith:"The Rite will have a view, and they will share it.", family:"Leave the families out of it.", war:"Nobody in this building has to carry a rifle.", machines:"The Engine will have read it before we have.", weather:"Rain on the steps again.", gossip:"I only repeat what I hear twice.", work:"The office keeps me late enough as it is.", looks:"Nice suit. New?"}
  };
  const rnd = a => a[(Math.random() * a.length) | 0];
  const sn2 = n => { try{ return surname(n || ""); }catch(e){ return String(n || "").split(" ").pop(); } };
  const recent = {};
  const topicOf = t => { try{ return tlxTopic(String(t || "")); }catch(e){ return "talk"; } };
  function peerLine(m, peer, text){
    const t = m.traits || {}, temper = t.temper || 40, warmth = (m.rel && m.rel.warmth) || 0, same = !!(peer && peer.party && m.party && peer.party === m.party);
    const P = peer ? sn2(peer.name || "") || "friend" : "friend", low = String(text || ""), A = [];
    if(/\?\s*$/.test(low) && temper < 60) A.push(rnd(["Good question.", "You would have to ask the whip.", "Ask me after the roll call."]));
    const r = Math.random() * 100 + (same ? 25 : -10) + (warmth > 20 ? 10 : 0);
    if(temper > 70 && r < 40) A.push(rnd(OG.hot)); else if(r > 70) A.push(rnd(OG.agree)); else if(r > 40) A.push(rnd(OG.doubt)); else A.push(rnd(OG.oppose));
    const tp = topicOf(low); if(OG.topic[tp] && Math.random() < 0.6) A.push(OG.topic[tp]);
    if(!low && Math.random() < 0.5) A.unshift(rnd(OG.warm));
    return A.join(" ").replace(/\{P\}/g, P);
  }
  window.onumOfflineReply = function(o){
    try{ o = o || {}; const m = o.npc || null; if(!m || m.kind === "engine") return "";
      const ch = o.channel || "face", text = String(o.text || "").trim(), peer = o.from || o.to || null, stage = o.stage ? String(o.stage) : "";
      const LTn = window.NEPTUNE_LIVETALK;
      const key = String(m.id != null ? m.id : m.name), R = recent[key] || (recent[key] = []);
      for(let k = 0; k < 6; k++){
        let out = "";
        if(!peer && !stage && LTn && typeof LTn.offline === "function"){ try{ out = LTn.offline(m, ch, text) || ""; }catch(e){ out = ""; } }
        if(!out && peer) out = peerLine(m, peer, text);
        if(!out && stage){ const tp = topicOf(stage + " " + text); out = (OG.topic[tp] && Math.random() < 0.6 ? OG.topic[tp] + " " : "") + rnd(OG.stage); }
        if(!out) out = rnd(OG.stage);
        if(R.indexOf(out) < 0 || k === 5){ R.push(out); if(R.length > 10) R.shift(); return out; }
      }
      return "";
    }catch(e){ return ""; }
  };
  try{ const L = window.onumLiveTalk; if(L && typeof L.reply === "function" && !L._ndOff){ const r0 = L.reply; L._ndOff = true;
      L.reply = async function(o){ const r = await r0.apply(this, arguments); try{ if(o && o.offline === true && r && !r.text && o.npc && o.npc.kind !== "engine"){ const t = window.onumOfflineReply(o); if(t) return Object.assign({}, r, {text:t, live:false, offline:true}); } }catch(e){} return r; }; } }catch(e){}
  console.log("NEPTUNE offline ready");
}catch(e){ try{ console.warn("NEPTUNE-OFFLINE block", e); }catch(e2){} }
/* NEPTUNE-OFFLINE END */
/* NEPTUNE-SESSION BEGIN — 20261020t: renders whatever session JUPITER publishes in window.ONUM_SESSION (and re-renders on the
   'onum-session' event): the seats, a spotlight on whoever has the floor, the gavel, the clock, the speakers' queue and the
   roll-call board. Every button goes through window.onumSession (requestFloor, yieldFloor, vote, gavel... whatever it
   offers); nothing here changes the session itself. With no ONUM_SESSION, or one that is not open, nothing is drawn.
   Accepted shape (all optional): {open|active, title, room, seats:[{id,name,party,state,present}], floor:id|{id},
   chair:id, gavel:{at,kind}|bool, clock:{left|remaining|seconds, label}, queue:[id|{id,name}], roll:{open, aye|yes, no|nay,
   present|abstain, votes:{id:"aye"|"no"|...}, needed}, actions:[{id,label}]} */
try{
  const SN = window.NEPTUNE_SESSIONVIEW = {ver:"20261020t", min:false};
  const esc4 = s => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({"&":"&"+"amp;", "<":"&"+"lt;", ">":"&"+"gt;", '"':"&"+"quot;"})[c]);
  const idOf = x => x == null ? null : (typeof x === "object" ? (x.id != null ? x.id : x.name) : x);
  const nm = (id, fb) => { try{ if(id === "you" || (G.you && id === G.you.id)) return "You"; if(typeof window.onumNameOf === "function"){ const n = window.onumNameOf(id); if(n) return n; } }catch(e){} return fb || String(id); };
