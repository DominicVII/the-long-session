    sv(() => document.querySelectorAll(".ticker, #wire, .wire").forEach(e => add(e.textContent)));
    sv(() => (G.states || []).forEach(s => add(s && (s.n || s.name)))); sv(() => (window.ONUM_TOWN_POIS || []).forEach(p => add(p && p.name)));
    sv(() => { const L = window.onumTownLexicon && window.onumTownLexicon(); (Array.isArray(L) ? L : Object.keys(L || {})).forEach(add); });
