  const floorState = function(S){ let f = S.x.floor; if(!f || f.step !== S.i) f = S.x.floor = {step:S.i, rounds:0, ans:{}, closed:false, refused:false}; return f; };
  const floorCap = function(S){ const C = S.x.cast; const avg = C.reduce((a, p) => a + p.temper, 0) / Math.max(1, C.length); return S.x.brisk ? 1 : 2 + (avg > 58 ? 1 : 0); };
  const floorCands = function(S, last){
    const f = floorState(S), ans = f.ans[last.id] || [], ch = chairOf(S);
    const cs = S.x.cast.filter(c => !c.gone && (c.m || (c.case && last.case)) && c !== last && ans.indexOf(c.id) < 0 && S.x.silenced !== c.id && ((c.case && last.case) || c.rival === last.id || last.rival === c.id || side(c) * side(last) < 0 || (side(c) === 0 && c.temper > 55)));
    return cs.sort((a, b) => (a.spoke * 2 - (ch.lean && side(a) === ch.lean ? 1.5 : 0) - a.temper / 100) - (b.spoke * 2 - (ch.lean && side(b) === ch.lean ? 1.5 : 0) - b.temper / 100));
  };
  /* with a live model on the other end, they say it in their own words; the scripted line is the fallback */
  const liveFill = function(S, ln, p, vs){
