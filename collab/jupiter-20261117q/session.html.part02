  const genCell = (i, j, seed, lvl) => {
    const x0 = cellX0(i), z0 = cellZ0(j), type = cellType(i, j, seed), r = rngOf(hashS("cell:" + seed + ":" + i + "," + j));
    const rd = 0x55575a, sw = 0xc4beb0;
