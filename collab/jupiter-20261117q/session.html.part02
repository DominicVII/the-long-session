  const streamer = (grp, seed, style, solidsSink, lampsSink) => {
    const cells = new Map(), lru = new Map(); let busy = false, queue = [];
    const want = cp => { const [ci, cj] = cellOf(cp.x, cp.z), w = new Map();
      for(let di = -RING; di <= RING; di++) for(let dj = -RING; dj <= RING; dj++){ const i = ci + di, j = cj + dj, ch = Math.max(Math.abs(di), Math.abs(dj));
        if(!cellExists(i, j)) continue;
        const ccx = cellX0(i) + 32, ccz = cellZ0(j) + 32, dist = Math.hypot(ccx - cp.x, ccz - cp.z);
        w.set(i + "," + j, ch === 0 || dist < 70 ? 0 : ch === 1 ? 1 : 2); }
      return w; };
    const drop = key => { const c = cells.get(key); if(!c) return; grp.remove(c.g); cells.delete(key);
      if(solidsSink) c.solids.forEach(s => { const k = solidsSink.indexOf(s); if(k >= 0) solidsSink.splice(k, 1); });
      if(lampsSink) c.lamps.forEach(s => { const k = lampsSink.indexOf(s); if(k >= 0) lampsSink.splice(k, 1); });
      lru.set(c.cacheKey, c.geo); while(lru.size > 10){ const [k0, g0] = lru.entries().next().value; lru.delete(k0); g0.parts.forEach(p => p.geo.dispose()); } };
    const build = (key, lvl) => { const [i, j] = key.split(",").map(Number), ck = key + "|" + lvl;
