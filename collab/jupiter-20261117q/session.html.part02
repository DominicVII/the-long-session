        [[0, 0, w, 0.02], [0, -d, w, 0.02], [-w / 2, -d / 2, 0.02, d], [w / 2, -d / 2, 0.02, d]].forEach(q => box("paint", q[0], 0.5, q[1], q[2], 0.015, q[3] || 0.02, 0xf0e6c0));
