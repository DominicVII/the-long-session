  if(rep){ H.splice(H.indexOf(rep), 1); rep.hop = false; rep.voteDay = (G.day || 1) + rint(2, 5); rep.voteHour = rep.voteHour || 14 + rint(0, 3);
    (G.members || []).forEach(m => { m.sway = 0; if(rep.road && rep.road.report) m.sway += (rep.road.report.fav ? 1.5 : -1.5) * (m.party === rep.sponsorParty ? 0.5 : 1); });
    try{ note("The " + rep.title + ", reported by the Committee on " + rep.road.t + " " + rep.road.report.aye + " to " + rep.road.report.no + ", is placed on the calendar for day " + rep.voteDay + ".", true); }catch(e){}
    return rep; }
  return _nb.apply(this, arguments); }; }
{ const _lb3 = lxBook; lxBook = function(f){ if(f === "hopper"){ const H = hopStore(), D = (lxStore().died || []);
    lxOpen('<div class="eyebrow">The committees</div><h1>Bills filed, in committee, and died there</h1><p class="muted">Most bills never reach the floor. Each is referred to the committee whose field it touches; the chair decides when to mark it up, and the committee decides whether the House ever sees it.</p>' +
      '<div class="card__actions" style="justify-content:flex-start"><button type="button" class="btn btn--ghost" style="padding:3px 9px;font-size:12px" data-lxbook="all">Back to the acts</button></div>' +
      '<div class="eyebrow" style="margin-top:8px">In committee (' + H.length + ')</div>' + (H.length ? H.map(b => '<div style="margin:5px 0;padding:5px 10px;border-left:3px solid ' + (b.reported ? '#3a7' : '#c9a24a') + '"><b>' + pcEsc(b.title) + '</b> <span class="muted" style="font-size:12px">· ' + pcEsc(b.sponsor || "") + ' · filed day ' + b.filed + ' · ' + pcEsc(b.road ? "Committee on " + b.road.t : "") + '</span><div style="font-size:13px">' + (b.reported ? 'Reported favourably, ' + b.road.report.aye + ' to ' + b.road.report.no + '; waiting for the floor.' : b.road && !b.road.done ? 'Markup set for day ' + b.road.mark + '.' : '') + '</div></div>').join("") : '<p class="muted">Nothing in committee.</p>') +
