  const arr = x => Array.isArray(x) ? x : x && typeof x === "object" ? (x.items || x.list || x.limits || x.rules || Object.values(x)) : [];
  function audit(){ const A = sv(() => typeof window.onumEngineAudit === "function" ? window.onumEngineAudit() : null) || {};
    const C = sv(() => window.ONUM_ENGINE_CHARTER);
    let charter = arr(C && (C.limits || C.rules || C)).map(txt).filter(Boolean); if(!charter.length) charter = arr(A.charter).map(txt).filter(Boolean);
    const refusedSrc = A.refused || sv(() => window.ONUM_ENGINE_REFUSED) || (C && C.refused) || null;
    const norm = r => ({day:r && (r.day != null ? r.day : r.d), what:txt(r), why:r && (r.reason || r.why || r.because || "")});
    const asked = arr(A.asked || A.asks || A.proposals).map(norm), granted = arr(A.granted || A.approved).map(norm), refused = arr(refusedSrc).map(norm);
    const byDay = (a, b) => (b.day || 0) - (a.day || 0); [asked, granted, refused].forEach(L => L.sort(byDay));
    /* 20261021i: claims with a status; anything unknown is unverified */
    const ST = {verified:"verified", true:"verified", confirmed:"verified", refuted:"refuted", false:"refuted", disproved:"refuted"};
    const claims = arr(A.claims).map(c => ({day:c && (c.day != null ? c.day : c.d), what:txt(c) || (c && c.claim) || "", why:c && (c.why || c.note || c.source || ""), status:ST[String(c && c.status).toLowerCase()] || "unverified"})).filter(c => c.what);
    claims.sort(byDay);
    return {claims, live:!!(charter.length || refusedSrc || A.asked || A.granted), charter:charter.length ? charter : CHARTER0, charterLive:!!charter.length, asked, granted, refused, refusedLive:!!refusedSrc}; }
