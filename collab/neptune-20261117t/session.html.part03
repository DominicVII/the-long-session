/* 20261113f — detail under the desks, the hearing, the book, the match, the marriage, and the record */
/* 20261113f — the detail under the desks, the hearing, the book, the match, the marriage, and the record.
   No new kinds of person. A sentence comes from who they already are. */
function onumPrecHit(word){
  try{
    const H = G.history || [];
    const w = String(word || "").toLowerCase();
    for(let i = H.length - 1; i >= 0; i--){
      const h = H[i];
      if(!h) continue;
      const blob = ((h.precedent || "") + " " + (h.act || "")).toLowerCase();
      if(w && blob.indexOf(w) >= 0) return h;
    }
  }catch(e){}
  return null;
}
function onumPrecExact(word){
  const h = onumPrecHit(word);
  if(h && h.precedent) return "The record already holds, from " + (h.who || "the last time") + ": " + h.precedent + ".";
  return onumPrecLine();
}
function onumSay(p, about){
  if(!p) return "";
  const bits = [];
  try{ const own = onumOwn(p); if(own) bits.push(own); }catch(e){}
  const tr = p.traits || {};
  if(tr.temper > 68) bits.push("I will not dress it up.");
  else if((tr.discretion || 0) > 68) bits.push("I am saying this once, and not for the corridor.");
  else if((tr.conviction || 0) > 70) bits.push("I will not trade what I hold to make the afternoon easier.");
  if(about) bits.push(about);
  return bits.filter(Boolean).slice(0, 3).join(" ");
}
function onumPeoplePool(){
  const out = [];
  try{ (G.members || []).forEach(p => { if(p && !p.gone && p.name && p !== G.you) out.push(p); }); }catch(e){}
  try{ (G.civ || []).forEach(p => { if(p && !p.gone && p.name && p !== G.you) out.push(p); }); }catch(e){}
  try{ (G.press || []).forEach(p => { if(p && !p.gone && p.name) out.push(p); }); }catch(e){}
  return out;
}
function onumPick(list, salt){
  if(!list || !list.length) return null;
  let n = 0;
  try{ n = Math.abs(seedOf(String(salt || "") + ":" + (G.day || 0))) % list.length; }
  catch(e){ n = (G.day || 0) % list.length; }
  return list[n];
}

onumKeep = function(text, aboutId){
  const L = onumLore();
  const line = String(text || "").slice(0, 420);
  if(!line) return null;
  const pool = onumPeoplePool().filter(p => {
    if(p.kind === "press") return true;
    const d = p.traits && p.traits.discretion;
    return d != null && d >= 48;
  });
  const keeper = pool.length ? pool[Math.floor(Math.random() * Math.min(pool.length, 8))] : null;
  let writes = false;
  if(keeper){
    const disc = (keeper.traits && keeper.traits.discretion) || (keeper.kind === "press" ? 62 : 40);
    const shy = (keeper.traits && keeper.traits.temper) || 40;
    writes = keeper.kind === "press" ? Math.random() < 0.8 : (disc / 140 + (100 - shy) / 400) > Math.random();
  }
  if(keeper && writes){
    const who = keeper.kind === "press" ? (keeper.outlet || keeper.name) : keeper.name;
    L.kept.push({d:G.day, who:who, id:keeper.id || null, t:line, about:aboutId || null});
    if(L.kept.length > 80) L.kept.shift();
    try{ onumWebPush(who, keeper.kind === "press" ? "paper" : "personal", line); }catch(e){}
    try{ if(aboutId){ const m = byId(aboutId); if(m && typeof remember === "function") remember(m, "It was written down by " + who + ": " + line.slice(0, 120), 2); } }catch(e){}
    try{ if(keeper.kind !== "press" && typeof remember === "function") remember(keeper, "I wrote it down: " + line.slice(0, 120), 1); }catch(e){}
    return keeper;
  }
  const why = keeper ? (keeper.name + " was there and chose not to write it down.") : "Nobody in the room keeps a book.";
  L.lost.push({d:G.day, t:line, why:why, who:keeper ? keeper.name : null});
  if(L.lost.length > 40) L.lost.shift();
  try{ if(aboutId){ const m = byId(aboutId); if(m && typeof remember === "function") remember(m, line.slice(0, 140), 2); } }catch(e){}
  return null;
};

function onumChronicleCard(){
  const L = onumLore();
  const kept = (L.kept || []).slice().reverse().slice(0, 16).map(x => '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid #c9a24a"><b>' + onumEsc(x.who) + '</b> <span class="muted">kept it, day ' + (x.d || "?") + '</span><div>' + onumEsc(x.t) + '</div></div>').join("");
  const lost = (L.lost || []).slice().reverse().slice(0, 10).map(x => '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><span class="muted">Not written, day ' + (x.d || "?") + '. ' + onumEsc(x.why || "Nobody wrote it.") + '</span><div>' + onumEsc(x.t) + '</div></div>').join("");
  const prec = onumPrecExact("record");
  govCardOpen("The record", "Kept, or lost", "A thing is history only when a person who was there decides to write it. The others remember it, and that is not the same thing." + (prec ? " " + prec : ""), '<div class="eyebrow">Written down</div>' + (kept || '<p class="muted">Nothing has been kept yet.</p>') + '<div class="eyebrow">Remembered, and not written</div>' + (lost || '<p class="muted">Nothing has been let go yet.</p>'), null);
}

function onumCabRoster(){
  let st = null; try{ st = presStaff(); }catch(e){ st = null; }
  if(!st) return "";
  return Object.keys(PRES_ROLES).map(k => {
    const o = st[k]; if(!o) return "";
    let creed = ""; try{ const c = creedOf(o.creed); if(c) creed = c.t; }catch(e){}
    let view = ""; try{ if(typeof viewWords === "function" && o.pos) view = viewWords(o.pos); }catch(e){}
    return '<div style="margin:6px 0"><b>' + onumEsc(o.name) + '</b> <span class="muted">· ' + onumEsc(PRES_ROLES[k]) + (o.town ? " · " + onumEsc(o.town) : "") + (creed ? " · " + onumEsc(creed) : "") + '</span>' + (view ? '<div class="muted">' + onumEsc(view) + '</div>' : '') + '</div>';
  }).join("");
}

onumDeskCard = function(o){
  try{ closeTalk(); }catch(e){}
  const acts = onumWorkActs(o).filter(a => a && a.t && a.t.indexOf("Open this as a page") !== 0 && a.t.indexOf("Open the work page") !== 0);
  const id = o && o.id;
  let status = '<p class="muted">Day ' + (G.day || 1) + '. The guilder is ' + ((typeof guilderIndex === "function") ? guilderIndex().toFixed(1) : "?") + '. The chest has ' + ((G.you && G.you.funds) || 0) + '.</p>';
  if(id === "xcab" || id === "jxcabc") status += '<div class="eyebrow">Who actually holds the chairs</div>' + (onumCabRoster() || '<p class="muted">The chairs have not been filled.</p>');
  const prec = onumPrecExact(id === "xcab" || id === "jxcabc" ? "cabinet" : "desk");
  if(prec) status += '<p class="muted">' + onumEsc(prec) + '</p>';
  status += '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" id="dkRec">The record</button><button type="button" class="btn btn--ghost" id="dkFam">The family</button><button type="button" class="btn btn--ghost" id="dkMkt">The market</button></div>';
  const body = status + acts.map((a, i) => '<div style="margin:8px 0"><button type="button" class="btn" data-dkx="' + i + '">' + onumEsc(a.t) + '</button> <span class="muted">' + onumEsc(a.c || "") + '</span></div>').join("") || status;
  govCardOpen(o.label || "The desk", "This page stays up", "The line in the room can flicker. The work, the names, and the record are here.", body, null);
  const rec = el("dkRec"); if(rec) rec.addEventListener("click", () => onumChronicleCard());
  const fam = el("dkFam"); if(fam) fam.addEventListener("click", () => onumFamilyCard());
  const mk = el("dkMkt"); if(mk) mk.addEventListener("click", () => onumMarketCard());
  card.querySelectorAll("[data-dkx]").forEach(b => b.addEventListener("click", () => {
    const a = acts[+b.getAttribute("data-dkx")];
    if(!a || !a.run) return;
    try{
      const r = a.run();
      const s = el("gcSay");
      if(s && r) s.textContent = String(r);
    }catch(err){
      const s = el("gcSay");
      if(s) s.textContent = "That would not open. It is still on this page. Try it again.";
    }
  }));
};

function onumApptQuestions(post){
  const Q = {
    treasury:["The shops are bound to one book, and the guilder moves while the day is still going. What do you do on a morning it slips?", "Who pays if the chest is thin and a state is asking?"],
    state:["A neighbour is at odds. Whose name do you put on the cable, yours or the chair's?", "What will you not promise a realm, even if the chair wants the afternoon quiet?"],
    war:["The frontier is hot. What do you send, and what do you refuse to send?", "Who decides when it is no longer a briefing and has become a war?"],
    justice:["Whose case do you bring, and whose do you leave on the table?", "Will you tell the chair when the law is not on our side?"]
  };
  return Q[post.k] || ["What will you do on the first morning, in your own name?", "What will you refuse, even if it would be easier to agree?"];
}
onumApptFile = function(post){
  const people = onumApptPeople(post);
  const body = people.map((o, i) => {
    let creed = "", view = "";
    try{ const c = creedOf(o.creed); if(c) creed = c.t + " — " + (c.holds || ""); }catch(e){}
    try{ if(typeof viewWords === "function" && o.pos) view = viewWords(o.pos); }catch(e){}
    return '<div style="margin:10px 0;padding:8px 10px;border-left:3px solid var(--line-soft)">' +
      (typeof officialHTML === "function" ? officialHTML(o) : "<b>" + onumEsc(o.name) + "</b>") +
      '<p style="margin:6px 0">' + onumEsc(o.name) + " comes from " + onumEsc(o.town || "") + ". Before this chair, " + onumEsc(o.prior || o.bg || "the work") + ".</p>" +
      (view ? '<p class="muted">' + onumEsc(view) + '</p>' : '') +
      (creed ? '<p class="muted">' + onumEsc(creed) + '</p>' : '') +
      '<div class="card__actions"><button type="button" class="btn btn--ghost" data-aq="' + i + '">Ask them, as themselves</button><button type="button" class="btn" data-an="' + i + '">Send this name to the Senate</button></div><div class="dream" id="aq_' + i + '"></div></div>';
  }).join("");
  const prec = onumPrecExact("cabinet");
  govCardOpen(post.t, "Three people. One name.", "Interview is not the appointment. Each of them already has a town, a creed, and a view. The name still has to survive a hearing." + (prec ? " " + prec : ""), body, null);
  card.querySelectorAll("[data-aq]").forEach(b => b.addEventListener("click", () => {
    const o = people[+b.getAttribute("data-aq")];
    const q = onumApptQuestions(post)[0];
    el("aq_" + b.getAttribute("data-aq")).textContent = o.name + ": " + onumSay(o, "You asked me " + q + " I will do the work of " + post.t + " as I see it, and I will tell you when I think you are wrong.");
  }));
  card.querySelectorAll("[data-an]").forEach(b => b.addEventListener("click", () => onumApptHearing(post, people[+b.getAttribute("data-an")])));
};
onumApptHearing = function(post, o){
  if(!o) return;
  const members = (G.members || []).filter(m => m && !m.gone && m.kind === "member" && m.name);
  const sens = [];
  members.forEach(m => { if(sens.length < 5 && !sens.some(x => x.party === m.party && x.state === m.state)) sens.push(m); });
  while(sens.length < 3 && sens.length < members.length){ const m = members[sens.length]; if(sens.indexOf(m) < 0) sens.push(m); else break; }
  let av = {ok:true, aye:11, no:7, body:"the Senate"};
  try{ av = apptVote("cab", o, (G.states || []).find(s => s.n === G.you.state)) || av; }catch(e){}
  const qs = onumApptQuestions(post);
  const rows = sens.map((m, i) => {
    let aye = true;
    try{
      const al = (typeof alignment === "function" && o.pos) ? alignment(m, {pos:o.pos, title:post.t}) : 0;
      if(m.party && G.you && m.party !== G.you.party && al < 12) aye = false;
      else if(al < -10) aye = false;
      else if(m.party === G.you.party && al > -18) aye = true;
      else aye = !!av.ok;
    }catch(e){ aye = !!av.ok; }
    const q = qs[i % qs.length];
    const why = aye
      ? "Aye. " + (m.state || "My state") + " can live with " + o.name + ". I am not doing the chair a favour."
      : "No. I have read the file on " + o.name + ". I do not owe this chair a quiet afternoon, and " + (m.state || "my state") + " did not send me here to nod.";
    const voice = onumSay(m, "The question was: " + q + " " + why);
    return {m:m, aye:aye, voice:voice};
  });
  const roomAye = rows.filter(r => r.aye).length;
  const prec = onumPrecExact("confirmed");
  const html = rows.map(r => '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + onumEsc(r.m.name) + '</b> <span class="muted">· ' + onumEsc(r.m.state || "") + (r.m.party ? " · " + onumEsc(r.m.party) : "") + " · " + (r.aye ? "aye" : "no") + '</span><p>“' + onumEsc(r.voice) + '”</p></div>').join("");
  const answer = onumSay(o, "I heard them. On " + post.t + " I will answer for the work, not for their mood.");
  const body = '<p>' + onumEsc(o.name) + ' sits at the table. The questions are about ' + onumEsc(post.t) + '.</p>' +
    '<p>“' + onumEsc(answer) + '”</p>' +
    (prec ? '<p class="muted">' + onumEsc(prec) + '</p>' : '') + html +
    '<p><b>In the room:</b> ' + roomAye + ' aye, ' + (rows.length - roomAye) + ' no, of the voices who spoke. <b>The roll of the Senate:</b> ' + av.aye + ' aye, ' + av.no + ' no. ' + (av.ok ? "The name carries." : "The name fails.") + '</p>' +
    '<div class="card__actions"><button type="button" class="btn" id="apSeal">' + (av.ok ? "Swear them in" : "Withdraw the name") + '</button></div>';
  govCardOpen("The hearing", o.name, "Confirmed or refused, someone in the room decides whether this is written down.", body, null);
  const seal = el("apSeal");
  if(!seal) return;
  seal.addEventListener("click", () => {
    let held = null; try{ const st0 = presStaff(); held = st0 && st0[post.k]; }catch(e){}
    if(av.ok){
      try{ const st = presStaff(); st[post.k] = o; }catch(e){}
      try{ onumSeatCabinet(); _hereCache = null; _allCache = null; }catch(e){}
      const leave = (held && held.name && held.name !== o.name) ? held.name + " had the chair this morning. " + held.name + ": It was mine. It is not mine now. I will say so myself. " : "";
      const monday = o.name + ": On Monday I do the work of " + post.t + " in my own name. I will not speak in yours.";
      try{ setPrecedent("confirmed " + o.name + " as " + post.t + ", " + av.aye + " to " + av.no, "a cabinet secretary is a named person, confirmed by the Senate, and seated at that chair", true); }catch(e){}
      const kept = onumKeep(leave + o.name + " was confirmed as " + post.t + ", " + av.aye + " to " + av.no + ". " + monday, null);
      try{ onumWebPush(o.name, "personal", monday); }catch(e){}
      try{ voxInit(); voxYouPost("note", null, "The Senate confirmed " + o.name + " as " + post.t + ", " + av.aye + " to " + av.no + "."); }catch(e){}
      el("gcSay").textContent = leave + monday + (kept ? " " + (kept.outlet || kept.name) + " wrote it down." : " Nobody wrote it down.");
    } else {
      const refusal = o.name + ": I heard the no. The chair is not mine. I will not pretend otherwise, and I will not let someone else invent a graceful version.";
      const holder = (held && held.name) ? held.name + " is still " + post.t + ". " + held.name + ": The hearing did not move me. The work on the desk this morning is still mine." : "The chair stays empty of this name.";
      const kept = onumKeep("The Senate refused " + o.name + " for " + post.t + ", " + av.aye + " to " + av.no + ". " + refusal + " " + holder, null);
      try{ onumWebPush(o.name, "personal", refusal); }catch(e){}
      try{ if(held && held.name) onumWebPush(held.name, "personal", "I am still " + post.t + ". The name that was sent did not take my chair."); }catch(e){}
      el("gcSay").textContent = refusal + " " + holder + (kept ? " " + (kept.outlet || kept.name) + " wrote the refusal." : " The refusal was not written down.");
    }
    seal.disabled = true;
  });
};

function onumFleshShops(){
  const shops = onumShops();
  const pool = onumPeoplePool();
  shops.forEach((s, i) => {
    if(s.ownerId) return;
    const hit = pool.find(p => p.name === s.owner) || (pool.length ? pool[i % pool.length] : null);
    if(!hit) return;
    s.owner = hit.name;
    s.ownerId = hit.id;
    if(hit.state) s.town = s.town || hit.state;
  });
  return shops;
}
onumShopper = function(){
  const shops = onumFleshShops();
  if(!shops.length) return;
  const pool = onumPeoplePool().filter(p => !shops.some(s => s.ownerId === p.id));
  const who = pool.length ? pool[Math.floor(Math.random() * pool.length)] : null;
  if(!who) return;
  const book = shops[Math.floor(Math.random() * shops.length)].book;
  const opts = shops.filter(s => s.book === book).slice().sort((a, b) => onumPrice(a) - onumPrice(b));
  if(!opts.length) return;
  const cheap = opts[0];
  const dear = opts[opts.length - 1];
  const tr = who.traits || {};
  const frugal = (tr.discretion || 50) >= (tr.vanity || 30);
  const goesCheap = opts.length < 2 || frugal || onumPrice(dear) > onumPrice(cheap) * 1.08;
  const pickShop = goesCheap ? cheap : dear;
  pickShop.loyal = pickShop.loyal || [];
  if(pickShop.loyal.indexOf(who.name) < 0) pickShop.loyal.push(who.name);
  if(pickShop.loyal.length > 8) pickShop.loyal.shift();
  if(pickShop === cheap) pickShop.till += 1; else pickShop.till = Math.max(0, pickShop.till - 1);
  const prec = onumPrecHit("share") || onumPrecHit("guilder");
  const because = pickShop === cheap
    ? "The book is " + onumPrice(cheap) + ". I am not paying a door that marks it up."
    : "I know " + cheap.owner + " has it for " + onumPrice(cheap) + ". I still went to " + pickShop.owner + ".";
  pickShop.last = who.name + " (" + (who.state || pickShop.town || "here") + ") paid " + onumPrice(pickShop) + " for " + book + " at " + pickShop.owner + "'s. " + because + (prec ? " They had heard the record: " + prec.precedent : "");
};
onumLiveDay = function(){
  const M = onumMkt();
  if(M.day === G.day) return;
  M.day = G.day;
  onumMktTick(1);
  const shops = onumFleshShops();
  const book = {};
  shops.forEach(s => { const p = onumPrice(s); if(book[s.book] == null || p < book[s.book]) book[s.book] = p; });
  shops.forEach(s => {
    const p = onumPrice(s), cheap = book[s.book];
    if(p > cheap * 1.08){ s.till = Math.max(0, s.till - 4); }
    else s.till += 3;
  });
  const teams = onumTeams();
  if(teams.length >= 2 && ((G.day || 0) % 2 === 0)){
    const a = teams[(G.day || 0) % teams.length], b = teams[((G.day || 0) + 3) % teams.length];
    if(a !== b){
      const as = 1 + ((G.day || 0) % 4), bs = (as + ((G.day || 1) % 3)) % 5;
      const aw = as !== bs ? as > bs : Math.random() < 0.5;
      const hs = aw ? as : (as === bs ? as : bs), los = aw ? bs : as;
      if(aw){ a.w++; b.l++; } else { b.w++; a.l++; }
      const winner = aw ? a : b, loser = aw ? b : a;
      const cap = onumPick((G.members || []).filter(m => m && !m.gone && m.state === winner.from), "cap:" + winner.from) ;
      const line = (cap ? cap.name + ", who plays for " + winner.name + ": " + onumSay(cap, "We won " + hs + " to " + los + ". I am not a slogan. I was on the field.") : winner.name + " won " + hs + " to " + los + ".");
      M.lastMatch = winner.name + " beat " + loser.name + ", " + hs + "–" + los + ".";
      M.matches = M.matches || [];
      M.matches.unshift({d:G.day, t:M.lastMatch, line:line, cap:cap ? cap.name : null});
      if(M.matches.length > 8) M.matches.pop();
      try{ onumWebPush(cap ? cap.name : winner.name, "personal", line); }catch(e){}
      onumKeep(M.lastMatch + " " + line, cap ? cap.id : null);
    }
  }
  const pool = onumPeoplePool();
  if(pool.length && Math.random() < 0.55){
    const who = onumPick(pool, "song");
    if(who){
      const week = (G.bill && G.bill.title) ? G.bill.title : ((who.state || "home") + ", an ordinary week");
      const title = "About " + week.split(" ").slice(0, 4).join(" ");
      const line = onumSay(who, "The song is called " + title + ". It is about the week I actually had, not the week the capital is selling.");
      M.songs = M.songs || [];
      M.songs.unshift({d:G.day, who:who.name, id:who.id, title:title, t:line});
      if(M.songs.length > 10) M.songs.pop();
      try{ voxInit(); voxAdd({id:G.vox.id++, by:who.id, t:title + ". " + line, k:"human", v:0, day:G.day, at:hhmm(), backs:0, hits:0, voices:[], mine:false}); }catch(e){}
      onumKeep(who.name + " put a song in the hall: " + title + ".", who.id);
    }
  }
  if(pool.length && shops.length){
    const who = onumPick(pool.filter(p => !shops.some(s => s.ownerId === p.id)), "shift") || onumPick(pool, "shift2");
    const jobs = (typeof CA_JOBS !== "undefined" && CA_JOBS.length) ? CA_JOBS : [["clerk", 90]];
    const job = jobs[(G.day || 0) % jobs.length][0];
    const shop = shops[(G.day || 0) % shops.length];
    if(who && shop){
      const t = who.name + " took the " + job + " shift at " + shop.owner + "'s " + shop.kind + " in " + (shop.town || "town") + ", on the book price, and did not ask to be famous for it.";
      M.shifts = M.shifts || [];
      M.shifts.unshift({d:G.day, t:t, who:who.name});
      if(M.shifts.length > 10) M.shifts.pop();
      onumKeep(t, who.id);
    }
  }
};

onumMarketCard = function(){
  onumLiveDay();
  const M = onumMkt();
  const g = (typeof guilderIndex === "function") ? guilderIndex() : 100;
  const bars = (M.hist || []).slice(-18).map(h => '<i title="' + h.g + '" style="display:inline-block;width:8px;height:' + Math.max(4, Math.round((h.g || 100) * 0.32)) + 'px;background:#c9a24a;margin:0 1px;vertical-align:bottom"></i>').join("");
  const shops = onumFleshShops();
  const px = Object.keys(M.px).map(k => {
    const doors = shops.filter(s => s.book === k);
    const prices = doors.map(s => onumPrice(s));
    const lo = prices.length ? Math.min.apply(null, prices) : M.px[k];
    const hi = prices.length ? Math.max.apply(null, prices) : M.px[k];
    return '<div><b>' + onumEsc(k) + '</b> · book ' + M.px[k] + ' · doors ' + lo + ' to ' + hi + '</div>';
  }).join("");
  const stocks = onumStocks();
  let hold = 0; stocks.forEach(s => { hold += (s.own || 0) * s.px; });
  const rows = stocks.map(s => '<div style="margin:6px 0"><b>' + onumEsc(s.t) + '</b> <span class="muted">· ' + s.px + ' · you hold ' + (s.own || 0) + '</span> <button type="button" class="btn" data-stk="b:' + s.k + '">Buy</button> <button type="button" class="btn btn--ghost" data-stk="s:' + s.k + '">Sell</button></div>').join("");
  const tape = (M.tape || []).slice(0, 6).map(x => '<div class="muted">' + onumEsc(x) + '</div>').join("");
  const prec = onumPrecExact("share") || onumPrecExact("guilder");
  govCardOpen("The market", "One book. Named doors. Named shares.", "Every door is bound to the same book. A shop may mark it up. A person may walk. The guilder moves while you are standing here.", '<p>The guilder stands at <b>' + g.toFixed(1) + '</b>. The chest has <b>' + ((G.you && G.you.funds) || 0) + '</b>. Shares you hold are worth <b>' + Math.round(hold) + '</b>.</p><div style="line-height:0;margin:6px 0">' + bars + '</div><div class="eyebrow">The book, and what the doors charge</div>' + px + '<div class="eyebrow">The shares</div>' + rows + (tape ? '<div class="eyebrow">The tape</div>' + tape : '') + (prec ? '<p class="muted">' + onumEsc(prec) + '</p>' : '') + '<div class="card__actions"><button type="button" class="btn" id="mktShops">Who owns the doors</button><button type="button" class="btn btn--ghost" id="mktRec">The record</button></div><div class="dream" id="mktSay"></div>', null);
  const b = el("mktShops"); if(b) b.addEventListener("click", () => onumDistrictCard());
  const r = el("mktRec"); if(r) r.addEventListener("click", () => onumChronicleCard());
  card.querySelectorAll("[data-stk]").forEach(btn => btn.addEventListener("click", () => {
    const parts = (btn.getAttribute("data-stk") || "").split(":");
    const msg = onumTrade(parts[1], parts[0] === "b" ? "buy" : "sell");
    M.tape = M.tape || [];
    M.tape.unshift("Day " + (G.day || 1) + " · " + msg);
    if(M.tape.length > 12) M.tape.pop();
    const s = el("mktSay"); if(s) s.textContent = msg;
  }));
};
onumDistrictCard = function(){
  onumLiveDay();
  const shops = onumFleshShops();
  const M = onumMkt();
  const rows = shops.map(s => {
    const owner = s.ownerId ? (function(){ try{ return byId(s.ownerId); }catch(e){ return null; } })() : null;
    const voice = owner ? onumSay(owner, "This door is mine. The book is the book. I can mark it up, and people can walk.") : "";
    return '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + onumEsc(s.owner) + '</b> <span class="muted">· ' + onumEsc(s.kind) + ' · ' + onumEsc(s.town || "") + ' · ' + onumEsc(s.book) + ' at ' + onumPrice(s) + ' · till ' + s.till + '</span>' +
      (s.loyal && s.loyal.length ? '<div class="muted">Through the door: ' + onumEsc(s.loyal.slice(-4).join(", ")) + '</div>' : '') +
      '<div class="muted">' + onumEsc(s.last || "Open.") + '</div>' +
      (voice ? '<div>“' + onumEsc(voice) + '”</div>' : '') + '</div>';
  }).join("");
  const match = (M.matches && M.matches[0]) ? '<p><b>' + onumEsc(M.matches[0].t) + '</b></p><p>' + onumEsc(M.matches[0].line || "") + '</p>' : (M.lastMatch ? '<p>' + onumEsc(M.lastMatch) + '</p>' : '<p class="muted">No match yet.</p>');
  const side = onumTeams().map(t => onumEsc(t.name) + " " + t.w + "-" + t.l).join(" · ");
  const songs = (M.songs || []).slice(0, 3).map(x => '<div><b>' + onumEsc(x.who) + '</b> · ' + onumEsc(x.title || "a song") + '<div class="muted">' + onumEsc(x.t) + '</div></div>').join("");
  const shifts = (M.shifts || []).slice(0, 3).map(x => '<div class="muted">d' + x.d + ' · ' + onumEsc(x.t) + '</div>').join("");
  const L = onumLore();
  const kept = (L.kept || []).slice(-3).map(x => '<div>Kept by ' + onumEsc(x.who) + ': ' + onumEsc(x.t) + '</div>').join("");
  govCardOpen("The district", "Owned doors, a match, a song, a shift", "The same people who sit in the building also own a door, play, write, or take a shift. Nobody new was invented for it.", rows + '<div class="eyebrow">The match</div>' + match + '<p class="muted">' + side + '</p><div class="eyebrow">What they made</div>' + (songs || '<p class="muted">No song yet.</p>') + (shifts || '') + '<div class="eyebrow">What was kept</div>' + (kept || '<p class="muted">Nothing written down yet.</p>') + '<div class="card__actions"><button type="button" class="btn btn--ghost" id="distRec">The whole record</button><button type="button" class="btn btn--ghost" id="distFam">The family</button></div>', null);
  const a = el("distRec"); if(a) a.addEventListener("click", () => onumChronicleCard());
  const f = el("distFam"); if(f) f.addEventListener("click", () => onumFamilyCard());
};

function onumFamilyCard(){
  try{ famEnsure(); }catch(e){}
  const y = G.you || {};
  const F = G.fam || {p:{}, events:[]};
  const mine = (F.p && (F.p[y.id] || F.p["you"])) || {};
  const sp = mine.spouse;
  let block = '<p>' + onumEsc(y.name || "You") + (sp ? " is married to " + onumEsc(sp.name) + (sp.job ? ", " + onumEsc(sp.job) : "") + "." : " is not married.") + '</p>';
  if(mine.kids && mine.kids.length) block += '<p>Children: ' + mine.kids.map(k => onumEsc(k.name) + (k.age != null ? " (" + k.age + ")" : "")).join(", ") + '.</p>';
  const ev = (F.events || []).slice().reverse().slice(0, 8).map(e => {
    const L = onumLore();
    const kept = (L.kept || []).some(k => k.t && e.t && k.t.indexOf(e.t.slice(0, 40)) >= 0);
    return '<div style="margin:6px 0"><b>' + onumEsc(e.k || "family") + '</b> <span class="muted">· day ' + (e.d || "?") + ' · ' + (kept ? "written down" : "not written down") + '</span><div>' + onumEsc(e.t) + '</div></div>';
  }).join("");
  const prec = onumPrecExact("married");
  govCardOpen("The family", "Names, not a backdrop", "Births, weddings, and burials happen to people who already exist. They go on the record only if someone keeps them." + (prec ? " " + prec : ""), block + '<div class="eyebrow">What the family did</div>' + (ev || '<p class="muted">No family news yet.</p>'), null);
}
onumMarry = function(m){
  const y = G.you; if(!y || !m) return "There is no one to ask.";
  const sp = onumSpouse(m);
  if(sp) return onumSay(m, "I am already married to " + sp.name.split(" ")[0] + ". Ask me for anything else.");
  let mine = null; try{ mine = onumSpouse(y); }catch(e){}
  if(mine) return "You already have " + mine.name + ". I will not be a second house.";
  const w = (m.rel && m.rel.warmth) || 0;
  const days = (G.day || 1) - (y.courtSince || G.day || 1);
  if(y.courtId !== m.id) return onumSay(m, "You have not been courting me. A marriage is not a favour you spend on the way past.");
  if(w < 36) return onumSay(m, "I know how warm this is, and it is not a life yet. Do not ask me to pretend it is.");
  if(days < 2) return onumSay(m, "It has not even been two days. I will not marry a hurry.");
  try{ famEnsure(); }catch(e){}
  const F = G.fam; if(F){
    F.p[m.id] = F.p[m.id] || {name:m.name, spouse:null, kids:[], parents:[], sibs:[], kin:[], feuds:[]};
    F.p[y.id] = F.p[y.id] || {name:y.name, spouse:null, kids:[], parents:[], sibs:[], kin:[], feuds:[]};
    F.p[m.id].spouse = {name:y.name, job:officeTitle()};
    F.p[y.id].spouse = {name:m.name, job:m.role || m.post || "in the building"};
    F.events = F.events || [];
    F.events.push({k:"wedding", t:y.name + " and " + m.name + " were married.", id:m.id, d:G.day});
    try{ famPublish(); }catch(e){}
  }
  try{ onumTouch(m, 8, "spouse"); }catch(e){}
  y.courtId = null;
  const guests = [];
  try{
    const kin = ((F && F.p[m.id] && F.p[m.id].kin) || []).slice(0, 3);
    kin.forEach(k => { const p = byId(k.id); if(p) guests.push(p); });
  }catch(e){}
  if(guests.length < 2){
    (G.members || []).forEach(p => { if(guests.length < 3 && p && !p.gone && p !== m && p.state === m.state) guests.push(p); });
  }
  const lines = guests.slice(0, 3).map(p => '<div style="margin:8px 0"><b>' + onumEsc(p.name) + '</b><p>“' + onumEsc(onumSay(p, "I was there. I am not speaking for the couple.")) + '”</p></div>').join("");
  const vow = onumSay(m, "Yes. Not to the office. To you. We will tell it in our own names.");
  try{ setPrecedent("married " + m.name, "a marriage is two named people, and it stays on the record only if someone writes it down", true); }catch(e){}
  const kept = onumKeep(y.name + " married " + m.name + ".", m.id);
  try{ onumWebPush(m.name, "personal", "I married " + y.name.split(" ")[0] + ". I am saying it myself."); }catch(e){}
  setTimeout(function(){
    try{
      govCardOpen("The wedding", m.name, kept ? ((kept.outlet || kept.name) + " wrote it down.") : "Nobody wrote it down. The people who were there still know.", '<p>“' + onumEsc(vow) + '”</p>' + (lines || '<p class="muted">The room was small. That was the wedding.</p>') + '<div class="card__actions"><button type="button" class="btn btn--ghost" id="wedFam">The family book</button></div>', null);
      const b = el("wedFam"); if(b) b.addEventListener("click", () => onumFamilyCard());
    }catch(e){}
  }, 40);
  return vow;
};

onumPhoneVox = function(){
  try{ voxInit(); }catch(e){}
  const all = ((G.vox && G.vox.posts) || []);
  const mine = all.filter(p => p.mine);
  const nested = {};
  let b = '<div class="pb__h">Vox</div><p><small>Every post under your name, then what other people wrote back in their own words. Nothing here is rewritten.</small></p>';
  b += '<p><small>' + mine.length + ' under your name.</small></p>';
  if(!all.length) b += '<p>Nobody has spoken yet.</p>';
  let loose = true;
  mine.forEach(p => {
    b += '<div class="pb__row" style="border-left:3px solid #c9a24a;padding-left:6px"><span><b>' + onumEsc((G.you && G.you.name) || "You") + ' · you</b><br><small>' + onumEsc(String(p.t || "")) + '</small></span></div>';
    const replies = all.filter(r => r && !r.mine && r.reply === p.id);
    if(loose){
      all.filter(r => r && !r.mine && r.reply === true && r.day === p.day).slice(0, 2).forEach(r => replies.push(r));
      loose = false;
    }
    replies.slice(0, 3).forEach(r => {
      nested[r.id] = 1;
      let nm = "Someone"; try{ const a = byId(r.by); if(a && a.name) nm = a.name; }catch(e){}
      b += '<div class="pb__row"><span><b>' + onumEsc(nm) + '</b><br><small>' + onumEsc(String(r.t || "")) + '</small></span></div>';
    });
  });
  all.filter(r => r && !r.mine && r.reply === true && !nested[r.id]).slice(0, 4).forEach(r => {
    nested[r.id] = 1;
    let nm = "Someone"; try{ const a = byId(r.by); if(a && a.name) nm = a.name; }catch(e){}
    b += '<div class="pb__row"><span><b>' + onumEsc(nm) + '</b><br><small>' + onumEsc(String(r.t || "")) + '</small></span></div>';
  });
  all.filter(p => p && !p.mine && !p.reply && !nested[p.id]).slice(0, 8).forEach(p => {
    let nm = "Someone"; try{ const a = byId(p.by); if(a && a.name) nm = a.name; }catch(e){}
    b += '<div class="pb__row"><span><b>' + onumEsc(nm) + '</b><br><small>' + onumEsc(String(p.t || "").slice(0, 220)) + '</small></span></div>';
  });
  b += '<div class="pb__row"><button data-pbvoxw="1">Write on Vox</button></div>';
  return b;
};
{ const _vy = voxYouPost; voxYouPost = function(kind, target, written){
  const r = _vy.apply(this, arguments);
  try{
    const text = String(written || "");
    if(!text) return r;
    const pool = (G.members || []).filter(m => m && !m.gone && m.traits && ((m.voxAppetite || 0) > 35 || m.traits.temper > 60));
    const m = pool.length ? pool[Math.floor(Math.random() * Math.min(6, pool.length))] : null;
    if(!m) return r;
    const hot = /\b(lie|lied|resign|shame|corrupt)\b/i.test(text);
    const line = (hot ? "I will not pass that along as if it were mine. " : "I saw what was posted. I am not repeating it. ") + onumSay(m, hot ? "I have my own sentence, and it is not a kinder version of theirs." : "If it concerns my state, I will answer it there, not in their words.");
    voxInit();
    voxAdd({id:G.vox.id++, by:m.id, t:line, k:"human", v:hot ? -1 : 0, day:G.day, at:hhmm(), backs:0, hits:0, voices:[], mine:false, reply:true});
  }catch(e){}
  return r;
}; }

{ const _rm = renderMap; renderMap = function(sel){
  let g = "";
  try{ g = _rm.apply(this, arguments); }catch(e){ g = ""; }
  if(!g) return g;
  try{
    const mode = (typeof MAP !== "undefined" && MAP.mode) ? MAP.mode : "lean";
    const names = {lean:"lean", party:"party", faith:"faith", tension:"tension"};
    const powers = (typeof WORLD_POWERS !== "undefined" ? WORLD_POWERS : []).map(p => {
      let rel = "";
      try{ if(typeof realmRelLabel === "function") rel = realmRelLabel((G.realmRel || {})[p.k] || 0); }catch(e){}
      const foe = G.world && G.world.foe === p.k;
      return onumEsc(p.t) + (rel ? " (" + rel + ")" : "") + (foe ? " · at odds" : "");
    }).join(" · ");
    const home = (G.states || []).filter(s => s && (s.cult === "mountain" || s.cult === "pacific" || s.cult === "delta" || s.cult === "dutch")).slice(0, 4).map(s => onumEsc(s.n) + " (" + onumEsc(s.cult) + ")").join(", ");
    g += '<div class="muted" style="font-size:11px;margin-top:4px">Filter on this map: <b>' + onumEsc(names[mode] || mode) + '</b>. The coasts are the states you already have — ' + (home || "west mountains, east capital, south water") + '. Around them: ' + (powers || "the Pale, the Marches, the Reach, the Horn, the Isles") + '.</div>';
  }catch(e){}
  return g;
}; }

{ const _apps = pbApps; pbApps = function(){
  const L = _apps.apply(this, arguments) || [];
  [["soc-rec","The record","What was written down, and what somebody chose not to write."],
   ["soc-fam","The family","Marriage, children, and which of it was kept."]
  ].forEach(a => { if(!L.some(x => x[0] === a[0])) L.push(a); });
  return L;
}; }
{ const _go = pbAppGo; pbAppGo = function(id){
  if(id === "soc-rec"){ setTimeout(function(){ try{ onumChronicleCard(); }catch(e){} }, 30); return; }
  if(id === "soc-fam"){ setTimeout(function(){ try{ onumFamilyCard(); }catch(e){} }, 30); return; }
  return _go.apply(this, arguments);
}; }

{ const _sc = saveCaptureBase; saveCaptureBase = function(){
  const o = _sc.apply(this, arguments);
  try{
    o.mkt = G.mkt || null;
    o.chronicle = G.chronicle || null;
    o.web = G.web || null;
    if(G.vox && G.vox.posts) o.vox = {id:G.vox.id || 1, posts:G.vox.posts.slice(0, 80)};
  }catch(e){}
  return o;
}; }


/* 20261114a */
/* 20261114a — etiquette, the table, the powers, the ledger, the race, the paper, every path.
   No new kind of person. They keep a manner, and they do not speak as someone they are not. */
function onumEtiq(){
  if(!G.etiq || G.etiq.v !== 1) G.etiq = {v:1, log:[]};
  return G.etiq;
}
function onumManner(p){
  if(!p || p === G.you) return null;
  if(!p.manner || p.manner.v !== 1){
    const disc = (p.traits && p.traits.discretion) || 50;
    p.manner = {v:1, held:0, said:0, slips:0, strict:disc >= 64 ? 1 : 0, taught:false,
      rule:"I do not say aloud an office, a creed, or a name that is not mine. I do not say what the room does not need."};
  }
  return p.manner;
}
function onumNeedRoll(p, text, where){
  try{ return Math.abs(seedOf(String(p && p.id) + ":" + where + ":" + (G.day || 0) + ":" + String(text || "").length)) % 100; }
  catch(e){ return ((G.day || 0) * 13 + String(text || "").length) % 100; }
}
function onumNeeded(p, text, where){
  if(where === "cabinet" || where === "summit" || where === "reply") return true;
  const T = (p && p.traits) || {};
  const M = onumManner(p);
  const strict = M ? (M.strict || 0) : 0;
  const low = String(text || "").toLowerCase();
  const bill = G.bill && !G.bill.done ? String(G.bill.title || "") : "";
  const onBill = bill && low.indexOf(bill.toLowerCase().slice(0, 14)) >= 0;
  const home = p && p.state && low.indexOf(String(p.state).toLowerCase()) >= 0;
  const hot = (T.temper || 0) > 74;
  if(onBill || home || hot) return true;
  const disc = T.discretion || 42;
  const cut = (where === "vox" ? 46 : 62) + strict * 10;
  if(disc < cut && (T.temper || 40) > 48) return true;
  return onumNeedRoll(p, text, where) > (38 + strict * 12);
}
function onumHeld(p, why, where){
  const M = onumManner(p);
  if(!M) return;
  M.held++;
  if(M.held === 3 || M.held === 8) M.strict = Math.min(4, (M.strict || 0) + 1);
  if(!M.taught && M.held >= 3){
    M.taught = true;
    try{ remember(p, M.rule, 2, true); }catch(e){}
  }
  M.last = {d:G.day, where:where, why:why};
  const line = (p.name || "They") + " did not say it (" + where + "). " + why;
  try{ remember(p, "I did not say it. " + M.rule, 1); }catch(e){}
  try{ ledgerOwn(p, line); }catch(e){}
  const E = onumEtiq();
  E.log.unshift({d:G.day, id:p.id, who:p.name, where:where, why:why});
  if(E.log.length > 40) E.log.pop();
}
function onumGate(p, text, where){
  const raw = String(text || "").replace(/\s+/g, " ").trim();
  if(!p || p === G.you || !raw) return {say:true, text:raw, why:""};
  const key = String(p.id) + "|" + where + "|" + raw.slice(0, 70);
  if(p._gk === key && p._gr) return p._gr;
  const M = onumManner(p);
  let t = raw.replace(/[\u201c"]([^\u201d"]{32,})[\u201d"]/g, "what was said");
  const role = String(p.role || p.post || "").toLowerCase();
  const titles = ["president", "governor", "speaker", "secretary of state", "secretary of the treasury", "secretary of war", "secretary of defense", "attorney general", "chief justice"];
  let slip = false;
  titles.forEach(function(title){
    const re = new RegExp("\\b(I am|as|I'm) the " + title + "\\b", "i");
    if(re.test(t) && role.indexOf(title) < 0){
      slip = true;
      t = t.replace(re, "not as the " + title);
    }
  });
  if(G.you && G.you.name && t.indexOf("I am " + G.you.name) >= 0){
    slip = true;
    t = t.replace("I am " + G.you.name, "I am not " + G.you.name);
  }
  if(slip){
    if(M) M.slips++;
    t = "I will not speak as someone I am not. I am " + (p.role || p.name) + ". " + t;
    try{ remember(p, "I nearly spoke as someone else. I stopped.", 2); }catch(e){}
  }
  let res;
  if(!onumNeeded(p, t, where)){
    const why = "It was not needed, and it was not " + String(p.name || "theirs").split(" ")[0] + "'s to put in the room.";
    res = {say:false, text:"", why:why};
    onumHeld(p, why, where);
  } else {
    if(M) M.said++;
    if(where === "vox" && t.length > 320 && (p.traits && p.traits.discretion > 58)) t = t.slice(0, 300).replace(/\s+\S*$/, "") + ".";
    res = {say:true, text:t, why:""};
  }
  p._gk = key;
  p._gr = res;
  return res;
}

{ const _ss = setSay; setSay = function(t, n){
