  if(k && String(k).indexOf("path:") === 0) return onumElectPath(String(k).slice(5));
  return _ed.apply(this, arguments);
}; }

function onumPossTake(key){
  const y = G.you; if(!y) return "No career yet.";
  const parts = String(key || "").split(":");
  const kind = parts[0], act = parts[1];
  if(kind === "bill"){
    const b = G.bill && !G.bill.done ? G.bill : null;
    if(!b) return "There is no bill. That path is not open.";
    if(act === "hold") return "You do not declare. The roll does not get a quote you did not give.";
    y.vote = act === "aye" ? 1 : act === "no" ? -1 : 0;
    const live = onumLiveReact(y, act + " on " + b.title);
    try{ if(typeof onumKeep === "function") onumKeep(y.name + " is " + act + " on " + b.title + ".", null); }catch(e){}
    return "You are " + act + " on " + b.title + ". " + (live.posted || "");
  }
  if(kind === "eng"){
    const E = (typeof engEnsure === "function") ? engEnsure() : null;
    if(!E || !E.memo) return "The Engine has no memo waiting. The other paths are the bill, the race, and the powers.";
    if(act === "hold"){
      const quiet = "You have not said which way. The memo is still on the desk. The papers do not have it.";
      try{ engLog("The memo was not announced.", false); }catch(e){}
      return quiet;
    }
    return "Open the Engine and take " + (act === "yes" ? "the first" : "the second") + " choice on the memo. Both are still there, and so is saying nothing.";
  }
  if(kind === "race") return onumElectPath(act === "aye" ? "declare" : act === "no" ? "concede" : "quiet");
  if(kind === "realm"){
    onumSummitCard(act);
    return "Their leaders are up. You are not them.";
  }
  return "That path is not on the board.";
}
function onumPossCard(){
  const B = onumBillBits();
  const rows = [];
  const add = (key, title, why) => { rows.push({key:key, title:title, why:why}); };
  if(G.bill && !G.bill.done){
    add("bill:aye", "Aye on " + B.title, "The members already with it stay with it. It is posted to the table.");
    add("bill:no", "No on " + B.title, "The members already against it are not surprised. It is posted to the table.");
    add("bill:present", "Present", "You are in the room and not on a side. They can see that too.");
    add("bill:hold", "Do not declare", "The manner. It is not needed yet, so it is not said.");
  } else add("bill:hold", "No bill is down", "There is nothing to be for. Inventing one would be speaking as a clerk you are not.");
  const E = (typeof engEnsure === "function") ? (function(){ try{ return engEnsure(); }catch(e){ return null; } })() : null;
  if(E && E.memo){
    add("eng:yes", "Engine: " + E.memo[1], E.memo[0]);
    add("eng:no", "Engine: " + E.memo[2], "The other fork of the same memo.");
    add("eng:hold", "Engine: do not announce a choice", "The memo stays. The papers do not get a decision you did not give.");
  } else add("eng:hold", "The Engine has no memo today", "No fork is pretending to be open.");
  add("race:aye", "The race: declare", "Your name, your office, your sentence.");
  add("race:quiet", "The race: say nothing", "A hold. The other name does not get a quote to wear.");
  add("race:no", "The race: concede a point", "One real point. They answer as themselves.");
  (typeof WORLD_POWERS !== "undefined" ? WORLD_POWERS : []).forEach(p => {
    const rel = Math.round((G.realmRel || {})[p.k] || 0);
    add("realm:" + p.k, "Sit with " + p.t, "Their head is not yours. Relations " + rel + ".");
  });
  const body = rows.map((r, i) => '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + onumEsc(r.title) + '</b><div class="muted">' + onumEsc(r.why) + '</div><button type="button" class="btn" data-ps="' + i + '">Take this path</button></div>').join("") + '<div class="dream" id="psOut"></div>';
  govCardOpen("Every path", "What can still happen", "Nothing here is a costume of another path. Take one and it is the one that happened.", body, null);
  card.querySelectorAll("[data-ps]").forEach(b => b.addEventListener("click", () => {
    const r = rows[+b.getAttribute("data-ps")];
    const msg = r ? onumPossTake(r.key) : "";
    const o = el("psOut"); if(o) o.textContent = msg;
  }));
}

onumPhoneVox = function(){
  try{ voxInit(); }catch(e){}
  const all = ((G.vox && G.vox.posts) || []);
  const mine = all.filter(p => p.mine);
  const nested = {};
  let b = '<div class="pb__h">Vox</div><p><small>Your posts, the answers under them, then the rest. A person who is not you does not wear your sentence. If it was not needed, it is not here.</small></p>';
  const holds = onumEtiq().log.filter(x => x.where === "vox").slice(0, 3);
  if(holds.length) b += holds.map(x => '<p><small>' + onumEsc(x.who) + ' did not post. ' + onumEsc(x.why) + '</small></p>').join("");
  b += '<p><small>' + mine.length + ' under your name.</small></p>';
  if(!all.length && !holds.length) b += '<p>Nobody has spoken yet.</p>';
  const voiceLine = function(p){
    const vs = (p.voices || []).slice(0, 4).map(v => {
      let nm = "Someone"; try{ const a = byId(v.id); if(a && a.name) nm = a.name; }catch(e){}
      const mark = /back/.test(v.t || "") ? "with it" : "against it";
      return onumEsc(nm) + " " + mark;
    });
    return vs.length ? '<br><small>' + vs.join(" · ") + '</small>' : "";
  };
  let loose = true;
  mine.forEach(p => {
    b += '<div class="pb__row" style="border-left:3px solid #c9a24a;padding-left:6px"><span><b>' + onumEsc((G.you && G.you.name) || "You") + ' · you</b><br><small>' + onumEsc(String(p.t || "")) + '</small>' + voiceLine(p) + '</span></div>';
    const replies = all.filter(r => r && !r.mine && r.reply === p.id);
    if(loose){
      all.filter(r => r && !r.mine && r.reply === true && r.day === p.day).slice(0, 2).forEach(r => replies.push(r));
      loose = false;
    }
    replies.slice(0, 3).forEach(r => {
      nested[r.id] = 1;
      let nm = "Someone"; try{ const a = byId(r.by); if(a && a.name) nm = a.name; }catch(e){}
      b += '<div class="pb__row"><span><b>' + onumEsc(nm) + '</b><br><small>' + onumEsc(String(r.t || "")) + '</small>' + voiceLine(r) + '</span></div>';
    });
  });
  all.filter(r => r && !r.mine && r.reply === true && !nested[r.id]).slice(0, 4).forEach(r => {
    nested[r.id] = 1;
    let nm = "Someone"; try{ const a = byId(r.by); if(a && a.name) nm = a.name; }catch(e){}
    b += '<div class="pb__row"><span><b>' + onumEsc(nm) + '</b><br><small>' + onumEsc(String(r.t || "")) + '</small></span></div>';
  });
  all.filter(p => p && !p.mine && !p.reply && !nested[p.id]).slice(0, 8).forEach(p => {
    let nm = "Someone"; try{ const a = byId(p.by); if(a && a.name) nm = a.name; }catch(e){}
    b += '<div class="pb__row"><span><b>' + onumEsc(nm) + '</b><br><small>' + onumEsc(String(p.t || "").slice(0, 220)) + '</small>' + voiceLine(p) + '</span></div>';
  });
  b += '<div class="pb__row"><button data-pbvoxw="1">Write on Vox</button></div>';
  return b;
};

{ const _apps = pbApps; pbApps = function(){
