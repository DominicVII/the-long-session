function onumFelt(text, listener){
  if(!text || !G || !G.you) return "";
  if(G._feltText === text && G._feltAt && Date.now() - G._feltAt < 900) return "";
  const pool = [].concat(G.members || [], G.civ || [], G.press || []);
  const here = new Set();
  try{ onumNear().forEach(function(p){ here.add(p); }); }catch(e){}
  if(listener) here.add(listener);
  here.add(G.you);
  const absent = [];
  pool.forEach(function(p){
    if(!p || !p.name || here.has(p) || p.gone) return;
    let sur = "";
    try{ sur = surname(p.name); }catch(e){}
    if(String(text).indexOf(p.name) >= 0 || (sur && sur.length > 3 && String(text).indexOf(sur) >= 0)) absent.push(p);
  });
  const secret = /\b(don't tell|do not tell|between us|behind (his|her|their) back|keep this (quiet|between)|not a word|don't repeat|do not repeat)\b/i.test(text);
  if(!absent.length && !secret) return "";
  G._feltText = text; G._feltAt = Date.now();
  G.you.stain = (G.you.stain || 0) + 1;
  if(listener && listener.rel){
    listener.rel.trust = Math.max(-40, (listener.rel.trust || 0) - 8);
    listener.rel.warmth = Math.max(-40, (listener.rel.warmth || 0) - 5);
  }
  const who = absent[0];
  const hearer = listener && listener.name ? listener.name.split(" ")[0] : "The one in front of you";
  const line = who
    ? "You said it about " + who.name + ", and " + who.name.split(" ")[0] + " is not here to answer. " + hearer + " watched you do it."
    : "You asked for it to stay in this room. You can feel that it should have been said to their face.";
  if(listener) listener._flinch = who ? who.name : "that";
  try{ note(line); }catch(e){}
  try{ if(typeof setSay === "function") setSay(line, ""); }catch(e){}
  const disc = listener && listener.traits ? listener.traits.discretion : 50;
  if(listener && who && disc < 42){
    try{ feed(listener.name + " is not going to keep that. " + who.name + " will hear which mouth it came from.", "bad"); }catch(e){}
    try{ if(typeof remember === "function") remember(who, G.you.name + " spoke about me to " + listener.name + " on day " + G.day + ".", 3); }catch(e){}
  } else if(who){
    try{ if(typeof remember === "function" && listener) remember(listener, "They said it about " + who.name + " where " + who.name.split(" ")[0] + " could not hear.", 2); }catch(e){}
  }
  return line;
}
{ const _imp = improvise; improvise = function(m, text){
  const r = _imp.apply(this, arguments);
  if(m && m._flinch){
    const name = m._flinch;
    m._flinch = "";
    return "I heard you. " + name + " is not in this room. " + r;
  }
  return r;
}; }
