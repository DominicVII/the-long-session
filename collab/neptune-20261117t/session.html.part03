  return h;
}; }

function onumElectPaths(){
  const y = G.you; if(!y) return "";
  const foe = (G.camp && G.camp.field || []).filter(f => !f.out).sort((a, b) => b.poll - a.poll)[0];
  const paths = [
    ["declare", "Declare, in your own name", "The papers get a sentence you actually said. The sounding moves a little, toward you or away, depending who reads it."],
    ["quiet", "Do not announce it", "You hold the line. A high-discretion reporter may spike it. The race does not get a quote you did not give."],
    ["concede", "Concede one point to the other name", "You give a real point. They have to answer as themselves, not as a costume of you."]
  ];
  return '<div class="eyebrow">Every path still open</div>' + paths.map(p => '<div style="margin:6px 0"><button type="button" class="btn btn--ghost" data-el="path:' + p[0] + '">' + onumEsc(p[1]) + '</button><div class="muted">' + onumEsc(p[2]) + (foe ? " Facing " + onumEsc(foe.name) + "." : "") + '</div></div>').join("") + '<div class="dream" id="elPath"></div>';
}
function onumElectPath(k){
  const y = G.you; if(!y) return "";
  try{ onumCamp(); }catch(e){}
  const foe = (G.camp.field || []).filter(f => !f.out).sort((a, b) => b.poll - a.poll)[0];
  const press = (G.press || []).filter(p => p && !p.gone)[0];
  if(k === "quiet"){
    if(press) onumHeld(press, "The announcement was not made, so there was nothing to print.", "news");
    return "You do not announce it. " + (press ? press.name + " has nothing to print that you said." : "No paper has a quote.");
  }
  if(k === "concede"){
    if(foe){ foe.poll = Math.max(0, Math.min(100, foe.poll + 2)); foe.heat = Math.max(0, (foe.heat || 0) - 4); }
    y.approval = Math.max(0, Math.min(100, (y.approval || 0) - 1));
    const line = (foe ? foe.name : "The other name") + " heard a real point, not a costume. They will answer it themselves or not at all.";
    try{ if(press && typeof onumKeep === "function") onumKeep(press.name + " printed the concession.", press.id); }catch(e){}
    return line;
  }
  y.approval = Math.max(0, Math.min(100, (y.approval || 0) + 1));
  if(foe) foe.poll = Math.max(0, Math.min(100, foe.poll - 1));
  const line = "You declared, as " + (typeof officeTitle === "function" ? officeTitle() : "yourself") + ", and not as anyone else.";
  try{ if(press) onumWebPush(press.outlet || press.name, "paper", line); }catch(e){}
  try{ voxInit(); voxYouPost("note", null, line); }catch(e){}
  return line;
}
{ const _eb = onumElectBody; onumElectBody = function(){
