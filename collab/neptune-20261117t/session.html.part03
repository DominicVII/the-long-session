/* 20261115c */
/* 20261115c — the seams. One season. One name for the state. Letters that are not words
   do not stay. The Engine answers from a card built today, and a number has a field. */
function onumStateName(){
  return (G.country && G.country.name) || "the Republic";
}
function onumSyncSeason(){
  try{
    const wx = wxToday();
    const W = G.world;
    if(W && wx && wx.s) W.season = wx.s;
  }catch(e){}
}
{ const _we = worldEnsure; worldEnsure = function(){
  const W = _we.apply(this, arguments);
  try{ const wx = wxToday(); if(W && wx && wx.s) W.season = wx.s; }catch(e){}
  return W;
}; }
function onumWorldCard(){
  onumSyncSeason();
  let wx = null, W = null;
  try{ wx = wxToday(); }catch(e){}
  try{ W = worldEnsure(); }catch(e){}
  const name = onumStateName();
  const form = (G.regime && G.regime.form) || "republic";
  const formT = (typeof REGIMES !== "undefined" && REGIMES[form] && REGIMES[form].t) || form;
  const y = G.you || {};
  let bal = "";
  try{ const T = typeof tsStore === "function" ? tsStore() : G.treasury; if(T && T.bal != null) bal = " Treasury " + Math.round(T.bal) + "."; }catch(e){}
  const lines = [
    "Today is day " + (G.day || 0) + ". Season: " + ((wx && wx.s) || "unknown") + ". Weather: " + ((wx && wx.k) || "unknown") + (wx && wx.t != null ? ", " + wx.t + " degrees" : "") + ".",
    "The state is " + name + ", a " + formT + ".",
    "The sovereign is " + (y.name || "unnamed") + (y.approval != null ? ". Approval on the record: " + Math.round(y.approval) + " (you.approval)" : "") + "."
  ];
  if(W && W.war && W.war !== "none") lines.push("The wider world: " + (W.last || W.war) + ". Dead on the record: " + (W.dead || 0) + " (world.dead). Bread " + (W.bread != null ? Number(W.bread).toFixed(2) : "?") + " (world.bread)." + bal);
  else lines.push("No declared war on the record." + bal);
  try{ if(G.bill && !G.bill.done && G.bill.title) lines.push("On the floor: " + G.bill.title + "."); }catch(e){}
  let prior = "";
  try{
    const eras = typeof govEras === "function" ? govEras() : [];
    if(eras && eras.length > 1) prior = " Earlier forms of the state are on the record. The name today is " + name + ".";
  }catch(e){}
  return lines.join(" ") + prior;
}
function onumFixCountry(t){
  const name = onumStateName();
  let s = String(t || "");
  if(!/coalmere/i.test(name)){
    s = s.replace(/\bthe Free Republic of Coalmere\b/gi, name).replace(/\bCoalmere\b/g, name);
  }
  return s;
}
function onumPruneEngine(E){
  if(!E) return 0;
  let n = 0;
  ["makerLetters", "makerReplies"].forEach(function(key){
    const list = E[key];
    if(!Array.isArray(list)) return;
    list.forEach(function(item, i){
      if(!item) return;
      const recent = i >= list.length - 8;
      ["text", "reply", "to"].forEach(function(f){
        const v = item[f];
        if(typeof v !== "string") return;
        if(/%PDF-|endobj|endstream|\u0000/.test(v)){ item[f] = "[non-text input removed]"; n++; return; }
        const limit = recent ? 8000 : 2000;
        if(v.length > limit){ item[f] = v.slice(0, limit) + " [trimmed]"; n++; }
      });
    });
  });
  return n;
}
function onumGuardReply(text){
  const t = String(text || "");
  if(/[\u4e00-\u9fff]/.test(t)) return {ok:false, why:"wrong script"};
  const w = t.toLowerCase().split(/\s+/).filter(Boolean);
  const seen = {};
  let dup = 0;
  for(let i = 0; i + 6 <= w.length; i++){
    const g = w.slice(i, i + 6).join(" ");
    if(seen[g]) dup++; else seen[g] = 1;
  }
  if(dup > 8) return {ok:false, why:"loop"};
  return {ok:true, why:""};
}
function onumEngMemory(){
  const E = engEnsure();
  if(!E.mind3) E.mind3 = {work:[], days:[], ledger:[]};
  return E.mind3;
}
function onumEngRemember(q, a){
  try{
    const M = onumEngMemory();
    M.work.push({d:G.day, q:String(q || "").slice(0, 180), a:String(a || "").slice(0, 320)});
    if(M.work.length > 6) M.work.shift();
    if(!M.days.some(function(x){ return x.d === G.day; })){
      M.days.push({d:G.day, t:onumWorldCard().slice(0, 240)});
      if(M.days.length > 36) M.days.shift();
    }
  }catch(e){}
}
function onumFactsLines(){
  const rows = [];
  const put = function(k, v, src){ if(v != null && v !== "") rows.push(k + " is " + v + " (" + src + ")"); };
  put("day", G.day, "calendar");
  try{ const wx = wxToday(); put("season", wx.s, "weather"); put("weather", wx.k, "weather"); }catch(e){}
  put("state", onumStateName(), "country.name");
  if(G.you){ put("sovereign", G.you.name, "you.name"); if(G.you.approval != null) put("approval", Math.round(G.you.approval), "you.approval"); }
  try{ const W = worldEnsure(); if(W){ put("bread", W.bread != null ? Number(W.bread).toFixed(2) : null, "world.bread"); put("dead", W.dead, "world.dead"); } }catch(e){}
  try{ const T = typeof tsStore === "function" ? tsStore() : null; if(T) put("treasury", Math.round(T.bal), "treasury.bal"); }catch(e){}
  return rows;
}
function onumStudyQ(q){
  return /conscious|psalm|god|christ|meaning|philosoph|study|science|atlas|mind|what is it like/i.test(String(q || ""));
}
{ const _ans = onumEngAnswer; onumEngAnswer = function(q){
  const study = onumStudyQ(q);
  const facts = onumFactsLines().join(". ");
  let body = "";
  try{ body = _ans.apply(this, arguments); }catch(e){ body = ""; }
  body = onumFixCountry(onumStripIntro(body));
  const g = onumGuardReply(body);
  if(!g.ok) body = "I do not have a clean answer. What I can source is this. " + facts + ".";
  if(study) body = body.replace(/\b(Floris|Lotte|Rosalie)\b[^.]{0,40}\./g, "");
  const out = body + " Sourced today: " + facts + ".";
  try{ onumEngRemember(q, out); }catch(e){}
  return out;
}; }
{ const _eg = egPrompt; egPrompt = function(){
