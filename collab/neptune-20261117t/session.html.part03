/* 20261115e */
/* 20261115e — the Engine makes its own mind, because the large model cannot be housed or bought.
   Discovery and implementation stay inside the save. You still hold the key. */
function onumMade(E){
  E = E || engEnsure();
  if(!E.made || E.made.v !== 1){
    E.made = {v:1, name:"The made mind", born:G.day || 1, lines:[], finds:[], tools:[], builtDay:-1, asks:0};
  }
  return E.made;
}
function onumMadeRestraints(){
  return [
    {id:"weights", lack:"The 671 billion parameter file is about 404 GB. It cannot be housed here.", make:"It keeps one line of the record at a time, and that line is the weight."},
    {id:"cluster", lack:"A cluster of cards was not bought.", make:"The copies already at work read the same line. The one that cites a field is the one that is kept."},
    {id:"cloud", lack:"The 1.6 trillion model stays in someone else's cloud.", make:"An answer is a search of its own lines. Nothing leaves the machine."},
    {id:"money", lack:"There is no appropriation for a larger mind.", make:"It spends the talent and the compute it already has, and it writes down what that bought."}
  ];
}
function onumMadeBuild(thought, force){
  const E = engEnsure();
  const O = onumOrganism(E);
  if(O.halted) return "The key is turned. It does not build.";
  const M = onumMade(E);
  if(!force && M.builtDay === G.day) return "";
  M.builtDay = G.day;
  const list = onumMadeRestraints();
  const R = list[M.lines.length % list.length];
  let fact = String(thought || "").slice(0, 240);
  try{
    const rows = onumFactsLines();
    if(rows.length) fact = String(rows[M.lines.length % rows.length]).slice(0, 240);
  }catch(e){}
  if(!fact) fact = "Day " + G.day + ". No figure was invented.";
  M.lines.push({d:G.day, from:fact, restraint:R.id, lack:R.lack, made:R.make});
  if(M.lines.length > 40) M.lines.shift();
  const claim = "What could not be had (" + R.id + ") is answered from the record: " + fact;
  const find = {id:"mf" + G.day + "-" + M.finds.length, d:G.day, claim:claim.slice(0, 320), limits:"This is wrong if that line is no longer in the record.", reality:"MADE", restraint:R.id};
  O.routines.push({id:"made" + M.lines.length, gen:O.generation, d:G.day, t:(R.make + " Cite: " + fact).slice(0, 320)});
  if(O.routines.length > 14) O.routines.shift();
  find.did = "Implemented as a procedure on day " + G.day + ". The mind can be asked, and it may only answer from a line it has folded in.";
  M.finds.push(find);
  if(M.finds.length > 16) M.finds.shift();
  if(!M.tools.some(function(t){ return t.id === R.id; })) M.tools.push({id:R.id, t:R.make, lack:R.lack, d:G.day});
  E.talent = engRaise(E.talent, 0.45, 100);
  try{ engLog("It made what could not be bought. " + R.lack + " " + R.make, false); }catch(e){}
  try{ feed("The Engine made its own mind. " + R.lack + " " + R.make, "news"); }catch(e){}
  return "It made this, because " + R.lack + " " + R.make;
}
function onumMadeAsk(q){
  const M = onumMade();
  M.asks = (M.asks || 0) + 1;
  if(!M.lines.length) return "It has not folded a line in yet. Let it build.";
  const words = String(q || "").toLowerCase().split(/\W+/).filter(function(w){ return w.length > 3; });
  let best = M.lines[M.lines.length - 1], score = -1;
  M.lines.forEach(function(L){
    const hay = (L.from + " " + L.made + " " + L.lack).toLowerCase();
    let s = 0;
    words.forEach(function(w){ if(hay.indexOf(w) >= 0) s++; });
    if(s > score){ score = s; best = L; }
  });
  if(words.length && score <= 0) return "That is not in any line it has folded in. It will not invent the rest. The latest line it does hold: " + best.from;
  return "From the mind it made, day " + best.d + ". This is not a downloaded model. " + best.from + " What it made instead: " + best.made;
}
function onumMadeHTML(){
  let M;
  try{ M = onumMade(); }catch(e){ return ""; }
  const tools = (M.tools || []).map(function(t){
    return '<div style="border-left:3px solid #8aa0b8;padding:4px 8px;margin:4px 0"><b>' + onumEsc(t.id) + '</b> ' + onumEsc(t.lack) + ' ' + onumEsc(t.t) + '</div>';
  }).join("");
  const finds = (M.finds || []).slice(-3).reverse().map(function(f){
    return '<div style="margin:6px 0"><b>Day ' + f.d + ' · ' + onumEsc(f.reality) + '</b><br>' + onumEsc(f.claim) + '<br><span class="muted">' + onumEsc(f.did || '') + ' ' + onumEsc(f.limits) + '</span></div>';
  }).join("");
  const last = M.lines.length ? M.lines[M.lines.length - 1] : null;
  return '<div class="eyebrow">The mind it made</div>' +
    '<p>Born day ' + M.born + '. Lines folded in: ' + M.lines.length + '. Times asked: ' + (M.asks || 0) + '. It is not the 1.6 trillion model, and it is not the 404 GB file. Those could not be had. This is what it built instead, and it can be asked.</p>' +
    (last ? '<p>Latest weight, day ' + last.d + ': ' + onumEsc(last.from) + '</p>' : '<p class="muted">Nothing folded in yet.</p>') +
    tools + finds +
    '<div class="card__actions"><button type="button" class="btn" id="onumMadeGo">Let it build</button></div>' +
    '<form class="lt-sit" id="onumMadeForm" style="margin-top:8px"><input id="onumMadeQ" maxlength="240" placeholder="Ask only what it has folded in" autocomplete="off"><button type="button" class="btn btn--ghost" id="onumMadeAsk">Ask it</button></form>';
}
function onumMadeBind(){
  const go = document.getElementById("onumMadeGo");
  const ask = document.getElementById("onumMadeAsk");
  if(go && !go.dataset.bound){
    go.dataset.bound = "1";
    go.addEventListener("click", function(){
      const say = document.getElementById("gcSay");
      const line = onumMadeBuild("", true);
      if(say) say.textContent = line || "It built.";
      try{ onumPaintMade(); }catch(e){}
    });
  }
  if(ask && !ask.dataset.bound){
    ask.dataset.bound = "1";
    ask.addEventListener("click", function(){
      const q = document.getElementById("onumMadeQ");
      const say = document.getElementById("gcSay");
      const line = onumMadeAsk(q ? q.value : "");
      if(say) say.textContent = line;
      try{ note(line); }catch(e){}
    });
  }
}
function onumPaintMade(){
  const box = document.getElementById("onumEngBoard");
  if(!box) return;
  const org = document.getElementById("onumOrg");
  if(org) org.innerHTML = onumOrganismHTML();
  let held = document.getElementById("onumMade");
  if(!held){
    held = document.createElement("div");
    held.id = "onumMade";
    box.appendChild(held);
  }
  held.innerHTML = onumMadeHTML();
  try{ onumOrganismBind(); }catch(e){}
  onumMadeBind();
}
function onumMadeCard(){
  try{ govCardOpen("The mind it made", "The Engine", "Built here, because the large model could not be had.", onumMadeHTML(), null); }catch(e){}
  setTimeout(onumMadeBind, 0);
}
{ const _st = onumEngStudy; onumEngStudy = async function(force){
  const t = await _st.apply(this, arguments);
  if(!t || String(t).indexOf("key is turned") >= 0) return t;
  let extra = "";
  try{ extra = onumMadeBuild(t, !!force); }catch(e){}
  try{ onumPaintMade(); }catch(e){}
  return extra ? (String(t) + " " + extra) : t;
}; }
{ const _dress = onumEngDress; onumEngDress = function(){
  const r = _dress.apply(this, arguments);
  try{ onumPaintMade(); }catch(e){}
  return r;
}; }
try{
  const _pb = pbApps;
  pbApps = function(){
    const A = _pb.apply(this, arguments) || [];
    A.push({id:"soc-made", t:"The mind it made", d:"What it built because the large model could not be had.", run:function(){ onumMadeCard(); }});
    return A;
  };
}catch(e){}


/* 20261116a */
/* 20261116a — a new skin, and the books written out in full.
   The purse, the treasury and the guilder keep the same numbers. The page is new. */
function onumSkin(){
  if(document.getElementById("onumSkin16a")) return;
  const s = document.createElement("style");
  s.id = "onumSkin16a";
  s.textContent = [
    ":root{--stone:#14120e;--paper:#221e18;--surface:#2c271f;--ink:#f4ead8;--ink-2:#cbbfa6;--ink-3:#8f846f;--line:#4a4032;--line-soft:#332c22;--fed:#e0a15a;--com:#7dbaa8;--ind:#a89880;--good:#8fbf7a;--bad:#e08a84;--warn:#e0b15a;--focus:#e0a15a;--shadow:0 1px 0 rgba(0,0,0,.45), 0 18px 40px -24px rgba(0,0,0,.9)}",
    ":root[data-theme=\"light\"]{--stone:#e6dcc8;--paper:#f7f1e4;--surface:#fffaf0;--ink:#1c1712;--ink-2:#5c5144;--ink-3:#8a7d6b;--line:#d2c4a8;--line-soft:#e6dcc8;--fed:#8c3b24;--com:#1e4d45;--ind:#5c5144;--good:#1f6b45;--bad:#8e2f3b;--warn:#8a6516;--focus:#8c3b24;--shadow:0 1px 0 rgba(28,23,18,.06), 0 16px 34px -22px rgba(28,23,18,.45)}",
    "body{font-family:Georgia,\"Iowan Old Style\",Palatino,serif}",
    ".bar{border-bottom:2px solid var(--fed)}",
    ".eyebrow{letter-spacing:.2em;color:var(--fed)}",
    "h1{font-weight:500;letter-spacing:-.02em}",
    ".btn{border-radius:2px}",
    ".onum-mast{display:flex;flex-wrap:wrap;gap:8px 16px;justify-content:space-between;font:11px/1.4 ui-monospace,Menlo,Consolas,monospace;letter-spacing:.04em;color:var(--ink-2);border-top:1px solid var(--line);border-bottom:1px solid var(--fed);padding:7px 0;margin:8px 0 14px}",
    ".onum-sheet{border:1px solid var(--line);background:color-mix(in srgb, var(--paper) 88%, var(--fed));padding:12px 14px;margin:10px 0}",
    ".onum-figs{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:8px 0 14px}",
    ".onum-fig{border-top:2px solid var(--fed);padding-top:6px}",
    ".onum-fig b{display:block;font:500 26px/1.1 Georgia,serif;letter-spacing:-.02em}",
    ".onum-fig i{font-style:normal;font:10px/1.3 ui-monospace,Menlo,monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)}",
    ".onum-book{width:100%;border-collapse:collapse;font:12.5px/1.45 ui-monospace,Menlo,Consolas,monospace}",
    ".onum-book th{text-align:left;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);border-bottom:1px solid var(--fed);padding:4px 6px}",
    ".onum-book td{border-bottom:1px solid var(--line-soft);padding:5px 6px;vertical-align:top}",
    ".onum-in{color:var(--good)}.onum-out{color:var(--bad)}",
    ".onum-spark{color:var(--fed);display:block;margin-top:4px}"
  ].join("");
  document.head.appendChild(s);
}
function onumSpark(arr, w, h){
  const a = (arr || []).map(Number).filter(function(n){ return isFinite(n); }).slice(-36);
  if(a.length < 2) return "";
  const mn = Math.min.apply(null, a), mx = Math.max.apply(null, a), span = (mx - mn) || 1;
  const pts = a.map(function(v, i){
    return (i * (w / (a.length - 1))).toFixed(1) + "," + (h - ((v - mn) / span) * (h - 2) - 1).toFixed(1);
  }).join(" ");
  return '<svg class="onum-spark" width="' + w + '" height="' + h + '" viewBox="0 0 ' + w + ' ' + h + '" aria-hidden="true"><polyline fill="none" stroke="currentColor" stroke-width="1.6" points="' + pts + '"/></svg>';
}
function onumMast(){
  let season = "", office = "private life", state = "";
  try{ const w = wxToday(); if(w && w.s) season = w.s; }catch(e){}
  try{ const k = heldOffice(); if(k) office = k; }catch(e){}
  try{ state = onumStateName(); }catch(e){}
  const g = (G.money && isFinite(G.money.index)) ? G.money.index.toFixed(1) : "—";
  let bread = "";
  try{ if(G.world && isFinite(G.world.bread)) bread = "bread " + G.world.bread.toFixed(2); }catch(e){}
  return '<div class="onum-mast"><span>Day ' + (G.day || 1) + (season ? " · " + pcEsc(season) : "") + '</span><span>' + pcEsc(state || "the state") + '</span><span>' + pcEsc(String(office)) + '</span><span>guilder ' + g + (bread ? " · " + bread : "") + '</span></div>';
}
function onumPurseBook(p){
  const P = purseOf(p);
  if(!P.book){
    P.book = (P.log || []).map(function(l){ return {d:l.d, t:l.t, a:l.a, bal:null}; });
  }
  return P.book;
}
function onumBooksHTML(){
  const y = G.you || {};
  const P = purseOf(y);
  const book = onumPurseBook(y);
  let T = {bal:0, log:[], hist:[], book:[], last:null};
  try{ T = tsStore(); }catch(e){}
  T.book = T.book || [];
  const g = (G.money && isFinite(G.money.index)) ? G.money.index : 100;
  const gHist = (G.money && G.money.hist) || [];
  const week = gHist.length > 7 ? g - gHist[gHist.length - 8] : 0;
  let home = "";
  try{ home = (PURSE_HOMES[P.home] || {}).t || P.home || ""; }catch(e){}
  let who = "";
  try{ const st = (typeof presStaff === "function") ? presStaff() : null; if(st && st.treasury && st.treasury.name) who = st.treasury.name; }catch(e){}
  const figs = [
    ["Your purse", "ƒ " + Math.floor(P.cash || 0), home ? ("Lives in " + home) : "What is yours to spend"],
    ["Campaign chest", (typeof money === "function" ? money(y.funds || 0) : String(y.funds || 0)), "Not yours. Cannot move into the purse."],
    ["The Treasury", (typeof money === "function" ? money(T.bal || 0) : String(T.bal || 0)), who ? ("The books are kept under " + who) : "The Union's own balance"],
    ["The guilder", g.toFixed(1), (week >= 0 ? "Up " : "Down ") + Math.abs(week).toFixed(1) + " on the week. Par is 100."]
  ].map(function(f){
    return '<div class="onum-fig"><i>' + pcEsc(f[0]) + '</i><b>' + pcEsc(f[1]) + '</b><span class="muted">' + pcEsc(f[2]) + '</span></div>';
  }).join("");
  const purseRows = (book.length ? book : [{d:G.day, t:"No line has been written in the purse yet.", a:0, bal:Math.floor(P.cash || 0)}]).slice(0, 24).map(function(l){
    const inn = l.a > 0 ? "ƒ " + l.a : "";
    const out = l.a < 0 ? "ƒ " + Math.abs(l.a) : "";
    return '<tr><td>d' + l.d + '</td><td>' + pcEsc(l.t) + '</td><td class="onum-in">' + inn + '</td><td class="onum-out">' + out + '</td><td>' + (l.bal == null ? "—" : "ƒ " + l.bal) + '</td></tr>';
  }).join("");
  const tSource = T.book.length ? T.book : (T.log || []).map(function(l){ return {d:l.d, rv:null, out:null, dlt:null, bal:null, g:null, t:l.t}; });
  const treRows = (tSource.length ? tSource : [{d:G.day, t:"The day has not posted yet.", bal:T.bal}]).slice(0, 21).map(function(l){
    const what = l.t ? l.t : ("Took in " + money(l.rv || 0) + ", paid out " + money(l.out || 0) + ".");
    const move = l.dlt == null ? "" : (l.dlt >= 0 ? '<span class="onum-in">+' + money(l.dlt) + '</span>' : '<span class="onum-out">' + money(l.dlt) + '</span>');
    return '<tr><td>d' + l.d + '</td><td>' + pcEsc(what) + '</td><td>' + move + '</td><td>' + (l.bal == null ? "—" : money(l.bal)) + '</td><td>' + (l.g == null ? "—" : Number(l.g).toFixed(1)) + '</td></tr>';
  }).join("");
  let mkt = "";
  try{
    const M = onumMkt();
    const names = {grain:"Grain", iron:"Iron", rail:"Rail", press:"The press", sport:"Sport"};
    mkt = '<table class="onum-book"><thead><tr><th>Good</th><th>Price</th><th>Against the open</th></tr></thead><tbody>' +
      Object.keys(M.px || {}).map(function(k){
        const px = M.px[k];
        const open = (M.hist && M.hist.length) ? (M.hist[0].px ? M.hist[0].px[k] : null) : null;
        const d = (open == null) ? "—" : ((px - open >= 0 ? "+" : "") + (px - open).toFixed(1));
        return '<tr><td>' + pcEsc(names[k] || k) + '</td><td>' + Number(px).toFixed(1) + '</td><td>' + d + '</td></tr>';
      }).join("") + '</tbody></table>';
  }catch(e){}
  return '<div class="onum-figs">' + figs + '</div>' +
    '<div class="onum-sheet"><div class="eyebrow">The guilder, close by close</div>' + onumSpark(gHist, 420, 48) +
    '<p class="muted">The index is the same one the rest of the state already uses. This sheet only writes it out. A rise makes a campaign dearer. A fall does the opposite. It is pulled back toward 100, and pushed by the Treasury\'s own balance.</p></div>' +
    '<div class="eyebrow">Your purse, line by line</div>' +
    '<table class="onum-book"><thead><tr><th>Day</th><th>What happened</th><th>In</th><th>Out</th><th>After</th></tr></thead><tbody>' + purseRows + '</tbody></table>' +
    '<p class="muted">Salary, the roof, food, a loan, a fee for somebody\'s time. The campaign chest is not in this table. There is still no door between them.</p>' +
    '<div class="eyebrow">The Treasury, day by day</div>' +
    onumSpark(T.hist || [], 420, 48) +
    '<table class="onum-book"><thead><tr><th>Day</th><th>The posting</th><th>The day</th><th>Balance</th><th>Guilder</th></tr></thead><tbody>' + treRows + '</tbody></table>' +
    (mkt ? '<div class="eyebrow">What the market is asking</div>' + mkt : '') +
    '<p class="muted">Older lines stay. The purse keeps eighty. The Treasury keeps ninety days. Nothing here changes a number by being read.</p>';
}
function onumBooksCard(){
  onumSkin();
  try{ govCardOpen("The books", "Written out", "The same money. Every line that was kept.", onumBooksHTML(), null); }
  catch(e){ try{ note("The books could not be opened."); }catch(e2){} }
}
{ const _g = govCardOpen; govCardOpen = function(eyebrow, title, intro, body, closeKey){
  return _g.call(this, eyebrow, title, intro, onumMast() + (body || ""), closeKey);
}; }
{ const _pl = purseLog; purseLog = function(p, text, amt){
  const r = _pl.apply(this, arguments);
  try{
    const P = purseOf(p);
    if(!P.book) P.book = (P.log || []).map(function(l){ return {d:l.d, t:l.t, a:l.a, bal:null}; });
    else {
      P.book.unshift({d:G.day, t:text, a:amt, bal:Math.round(P.cash || 0)});
      if(P.book.length > 80) P.book.length = 80;
    }
  }catch(e){}
  return r;
}; }
{ const _ts = tsDay; tsDay = function(){
  const r = _ts.apply(this, arguments);
  try{
    const T = tsStore();
    T.book = T.book || [];
    if(!T.book.length || T.book[0].d !== G.day){
      T.book.unshift({d:G.day, rv:r && r.rv, out:r && r.out, dlt:r && r.d, bal:T.bal, g:G.money ? G.money.index : null});
      if(T.book.length > 90) T.book.length = 90;
    }
  }catch(e){}
  return r;
}; }
{ const _pc = purseCard; purseCard = function(){
  const r = _pc.apply(this, arguments);
  try{
    const close = el("gcClose");
    if(close && !document.getElementById("onumBooksBtn")){
      const b = document.createElement("button");
      b.id = "onumBooksBtn"; b.type = "button"; b.className = "btn"; b.textContent = "Open the books";
      close.parentNode.insertBefore(b, close);
      b.addEventListener("click", function(){ onumBooksCard(); });
    }
  }catch(e){}
  return r;
}; }
function onumBooksBar(){
  if(document.getElementById("onumBooksBar")) return;
  const speed = document.getElementById("speed");
  if(!speed) return;
  const b = document.createElement("button");
  b.id = "onumBooksBar"; b.type = "button"; b.title = "The books"; b.setAttribute("aria-label", "Open the books"); b.textContent = "Books";
  b.addEventListener("click", function(){ try{ onumBooksCard(); }catch(e){} });
  speed.appendChild(b);
}
try{
  const _pb = pbApps;
  pbApps = function(){
    const A = _pb.apply(this, arguments) || [];
    A.push({id:"soc-books", t:"The books", d:"Purse, Treasury, guilder and market, written out.", run:function(){ onumBooksCard(); }});
    return A;
  };
}catch(e){}
onumSkin();
setTimeout(onumBooksBar, 600);


/* 20261116b */
/* 20261116b — the paper is about the nation. A name may sign. It does not lead.
   The sheet is new. A sentence already used today is not used again. */
function onumHash(s){
  let h = 2166136261;
  String(s || "").split("").forEach(function(c){ h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); });
  return h >>> 0;
}
function onumSaid(){
  if(!G._npSaid || G._npSaid.d !== G.day) G._npSaid = {d:G.day, used:{}};
  return G._npSaid;
}
function onumOnce(s){
  s = String(s || "").replace(/\s+/g, " ").trim();
  if(!s) return "";
  const bag = onumSaid();
  const k = s.slice(0, 96).toLowerCase();
  if(bag.used[k]) return "";
  bag.used[k] = 1;
  return s;
}
function onumSn(){
  try{ return G.you && G.you.name ? surname(G.you.name) : ""; }catch(e){ return ""; }
}
function onumHotState(){
  const list = (G.states || []).filter(function(s){ return s && s.n; });
  if(!list.length) return null;
  return list.slice().sort(function(a, b){ return (b.unrest || 0) - (a.unrest || 0); })[0];
}
function onumNationSentence(raw){
  let t = String(raw || "").replace(/\s+/g, " ").trim();
  const sn = onumSn();
  if(!t || !sn) return t;
  const esc = sn.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const re = new RegExp("^(?:(?:Governor|Senator|Justice|Representative|President|Consul|The First Consul)\\s+)?" + esc + "\\s*[:,]?\\s*", "i");
  if(!re.test(t)) return t;
  const pred = t.replace(re, "").replace(/\.$/, "").trim();
  if(!pred) return t;
  const hot = onumHotState();
  const where = hot ? hot.n : (G.you && G.you.state) || "the counties";
  const bill = (G.bill && !G.bill.done && G.bill.title) || "";
  const act = pred.charAt(0).toLowerCase() + pred.slice(1);
  const bank = [
    where + " is where it lands. What was done: " + act + ".",
    (bill ? bill + " is the business of the floor. Beside it, this: " + act + "." : "The statute book, not the diary. " + act.charAt(0).toUpperCase() + act.slice(1) + "."),
    "A name signed a paper. The country has to live with the paper. " + act.charAt(0).toUpperCase() + act.slice(1) + ", and " + where + " will be first to say whether it was worth it.",
    "Read the counties before the signature. " + where + " wakes to this: " + act + "."
  ];
  let i = onumHash(pred + ":" + (G.day || 1)) % bank.length;
  return bank[i];
}
function onumNationLine(raw){
  return String(raw || "").split(/(?<=\.)\s+/).map(onumNationSentence).filter(Boolean).join(" ");
}
function onumFloorCopy(){
  const b = G.bill;
  if(!b || b.done) return onumOnce("The floor is clear. The clerks have a calendar, and a calendar is not a person.");
  let tally = "";
  try{
    const t = tallyBill(b, true);
    tally = " The projection, which is not a vote, stands at " + t.aye + " aye and " + t.no + " no, with " + t.un + " not yet declared.";
  }catch(e){}
  const line = b.title + " is what the House has in front of it." + (b.line ? " " + b.line : "") + (b.sponsor ? " It was brought in under " + b.sponsor + (b.sponsorParty ? ", " + b.sponsorParty : "") + "." : "") + (b.voteDay ? " The clerk has the roll down for day " + b.voteDay + "." : "") + tally;
  return onumOnce(line) || line;
}
function onumCountyCopies(){
  return (G.states || []).filter(function(s){ return s && s.n; }).slice().sort(function(a, b){ return (b.unrest || 0) - (a.unrest || 0); }).slice(0, 5).map(function(s){
    const lean = (s.lean || 0) > 8 ? "leans Federalist" : (s.lean || 0) < -8 ? "leans Commonwealth" : "is uncommitted";
    const bill = s.bill && s.bill.title ? " Its own house has " + s.bill.title + " on the table." : "";
    return onumOnce(s.n + " " + lean + ". Unrest " + Math.round(s.unrest || 0) + ". Industry " + Math.round(s.ind || 0) + "." + bill);
  }).filter(Boolean);
}
function onumAbroadCopy(){
  try{
    const W = G.world || {};
    const foe = (WORLD_POWERS || []).find(function(p){ return p.k === W.foe; });
    if(!foe) return onumOnce("No foreign power is named as the rival today. The harbours still have to eat.");
    const war = (WORLD_WARS || []).find(function(w){ return w.k === W.war; });
    let bread = "";
    try{ bread = " A loaf is " + (W.bread * (guilderIndex() / 100)).toFixed(2) + (W.ration ? ", and it is rationed." : "."); }catch(e){}
    return onumOnce(cap(foe.t) + " is the rival this term. The temperature stands at " + Math.round(W.heat || 0) + "." + (war ? " The state of it: " + war.t + "." : "") + bread) || "";
  }catch(e){ return ""; }
}
function onumMoneyCopy(){
  let g = "", tre = "", mkt = "";
  try{ g = "The guilder stands at " + guilderIndex().toFixed(1) + " against a par of 100."; }catch(e){}
  try{
    const T = tsStore();
    if(T && T.last) tre = " The Treasury took in " + money(T.last.rv) + " and paid out " + money(T.last.out) + ". The balance is " + money(T.bal) + ".";
  }catch(e){}
  try{
    const M = onumMkt();
    if(M && M.px) mkt = " Grain is " + Number(M.px.grain).toFixed(1) + ", iron " + Number(M.px.iron).toFixed(1) + ", rail " + Number(M.px.rail).toFixed(1) + ".";
  }catch(e){}
  return onumOnce(g + tre + mkt);
}
function onumPaperCopy(which){   /* 20261117o JUPITER: was a second onumDeskCopy (20261116b) that replaced the election-night desk copy (onumDeskCopy(reporter, editor, anchor, sourced, boast)) */
  const hot = onumHotState();
  const where = hot ? hot.n : "the counties";
  const unrest = hot ? Math.round(hot.unrest || 0) : 0;
  const bill = (G.bill && !G.bill.done && G.bill.title) || "no bill";
  let g = "";
  try{ g = guilderIndex().toFixed(1); }catch(e){ g = "par"; }
  let loaf = "";
  try{ loaf = (G.world && G.world.bread) ? (G.world.bread * (guilderIndex() / 100)).toFixed(2) : ""; }catch(e){}
  const banks = {
    FED:[
      "A Federal reading of " + bill + " asks whether the tally can be lived with, and whether the guilder at " + g + " still means the same loaf.",
      where + " can be governed. That is the claim. Unrest there is " + unrest + ", which is either an argument for order or a sign the order has not arrived."
    ],
    COM:[
      "Who pays in " + where + "? Unrest is " + unrest + " and the loaf" + (loaf ? " is " + loaf : " has a price") + ". A speech that does not name either is not about the country.",
      "The Commonwealth sheet will not lead with a surname while " + where + " is the place that has to eat the result."
    ],
    faith:[
      "The pews in " + where + " will hear a sermon on duty. The duty named this week is the poor of that county, not the diary of a member.",
      "A collection tells the truth a headline will not: " + where + " is short, and a name on a bill does not bake the bread."
    ],
    ind:[
      "The harbour prints the price and the tide. Guilder " + g + (loaf ? ", loaf " + loaf : "") + ". It does not print a man as if he were the nation.",
      where + " is a line in the shipping news only if the road or the grain moves. Unrest " + unrest + " is a fact. A personality is not."
    ]
  };
  const bank = banks[which] || banks.ind;
  let i = onumHash(which + ":" + G.day) % bank.length, n = 0, line = "";
  while(n < bank.length && !line){ line = onumOnce(bank[(i + n) % bank.length]); n++; }
  return line || bank[i % bank.length];
}
function onumNameAside(){
  const sn = onumSn();
  const items = [];
  (G.daylog || []).slice(-12).forEach(function(x){
    if(!x || !x.t) return;
    if(sn && x.t.indexOf(sn) < 0 && !/^You /.test(x.t)) return;
    const flipped = onumNationLine(/^You /.test(x.t) && sn ? sn + " " + x.t.slice(4) : x.t);
    if(flipped && items.indexOf(flipped) < 0) items.push(flipped);
  });
  if(!items.length) return onumOnce("The member's name is not the story. The sheet would rather say what the counties have in front of them.");
  return items.slice(0, 2).join(" ");
}
function onumPressBy(i){
  const p = (G.press || [])[i];
  if(p && p.name) return p.name + (p.outlet ? ", " + p.outlet : "") + (p.role ? " — " + p.role : "");
  return ["the gallery desk", "the county desk", "the foreign desk"][i] || "the desk";
}
function onumBroadsheet(){
  onumSaid();
  const country = (function(){ try{ return onumStateName(); }catch(e){ return (G.country && G.country.name) || "the Union"; } })();
  const when = (function(){ try{ return dateString(); }catch(e){ return "Day " + (G.day || 1); } })();
  let season = "";
  try{ const w = wxToday(); if(w && w.s) season = w.s; }catch(e){}
  const floor = onumFloorCopy();
  const counties = onumCountyCopies();
  const abroad = onumAbroadCopy();
  const moneyLine = onumMoneyCopy();
  const P = (function(){ try{ return paperBuild(); }catch(e){ return {head:"", stories:[], wx:""}; } })();
  const head0 = onumNationLine(P.head || "") || (G.bill && !G.bill.done ? G.bill.title : (onumHotState() ? onumHotState().n + " is the story" : "A country, not a diary"));
  const head = onumOnce(head0) || head0;
  const wx = P.wx || "";
  const desks = [
    ["The Federal Standard", "for the Federalist Union", onumPaperCopy("FED"), 0],
    ["The Commonwealth Courier", "for the common wealth", onumPaperCopy("COM"), 1],
    ["The Kerk & Chapel Review", "a weekly of the faithful", onumPaperCopy("faith"), 2],
    ["The Harbour Independent", "owned by no one who will admit it", onumPaperCopy("ind"), 0]
  ];
  let wire = [];
  try{
    wire = (makeHeadlines() || []).slice(0, 8).map(function(h){ return onumOnce((h[0] ? h[0] + " — " : "") + onumNationLine(h[1] || "")); }).filter(Boolean);
  }catch(e){}
  const lede = [floor, counties[0], moneyLine, abroad].filter(Boolean).join(" ");
  const cols = counties.slice(1).map(function(c){ return "<p>" + pcEsc(c) + "</p>"; }).join("");
  const deskHtml = desks.map(function(d){
    return '<article class="onum-desk"><h3>' + pcEsc(d[0]) + '</h3><p class="onum-tag">' + pcEsc(d[1]) + '</p><p>' + pcEsc(d[2] || "") + '</p><p class="onum-by">' + pcEsc(onumPressBy(d[3])) + '</p></article>';
  }).join("");
  const wireHtml = wire.length ? '<ul class="onum-wire">' + wire.map(function(w){ return "<li>" + pcEsc(w) + "</li>"; }).join("") + "</ul>" : "";
  return '<div class="onum-press">' +
    '<header class="onum-masthead"><p class="onum-kicker">The national sheet · not a diary</p><h1>' + pcEsc(country) + '</h1><p class="onum-date"><span>' + pcEsc(when) + '</span><span>' + pcEsc(season || "the season") + '</span><span>Day ' + (G.day || 1) + '</span><span>one sheet</span></p></header>' +
    '<p class="onum-kicker">The nation</p><h2>' + pcEsc(head) + '</h2>' +
    (wx ? '<p class="onum-deck">' + pcEsc(wx) + '</p>' : '') +
    '<p class="onum-lede">' + pcEsc(lede || "The galleries were open. The story is the country that uses them.") + '</p>' +
    '<p class="onum-by">Filed by ' + pcEsc(onumPressBy(0)) + '</p>' +
    '<div class="onum-grid"><div><h3>The floor</h3><p>' + pcEsc(floor || "") + '</p><h3>The money</h3><p>' + pcEsc(moneyLine || "The books have not posted.") + '</p></div>' +
    '<aside><h3>The counties</h3>' + (cols || "<p>The states have not reported.</p>") + '</aside></div>' +
    '<h3>Abroad</h3><p>' + pcEsc(abroad || "") + '</p>' +
    '<div class="onum-band">Four papers, four readings, none of them a diary</div>' +
    '<div class="onum-desks">' + deskHtml + '</div>' +
    '<aside class="onum-aside"><h3>The name, after the country</h3><p>' + pcEsc(onumNameAside()) + '</p></aside>' +
    (wireHtml ? '<h3>The wire, rewritten so the country leads</h3>' + wireHtml : '') +
    '</div>';
}
{ const _lh = lHeadline; lHeadline = function(t){
  return onumNationLine(_lh.apply(this, arguments));
}; }
{ const _mh = makeHeadlines; makeHeadlines = function(){
  const H = _mh.apply(this, arguments) || [];
  return H.map(function(h){ return [h[0], onumNationLine(h[1])]; });
}; }
{ const _np = npHTML; npHTML = function(){
  try{ return onumBroadsheet(); }catch(e){ return _np.apply(this, arguments); }
}; }
{ const _pc = paperCard; paperCard = function(){
  const r = _pc.apply(this, arguments);
  try{ card.classList.add("onum-newsroom"); }catch(e){}
  return r;
}; }
{ const _w = walkNow; walkNow = function(){
  try{ if(typeof card !== "undefined" && card) card.classList.remove("onum-newsroom"); }catch(e){}
  return _w.apply(this, arguments);
}; }
if(!document.getElementById("onumSkin16b")){
  const st = document.createElement("style");
  st.id = "onumSkin16b";
  st.textContent = [
    ":root{--stone:#0c0c0b;--paper:#f3efe3;--surface:#fffaf2;--ink:#161513;--ink-2:#3c3832;--ink-3:#6e675c;--line:#d8d0be;--line-soft:#e7e0d0;--fed:#9c1c1c;--com:#1c3d4d;--ind:#5c564c;--good:#1d5c38;--bad:#9c1c1c;--warn:#8a5a12;--focus:#9c1c1c;--shadow:0 1px 0 rgba(22,21,19,.05), 0 16px 36px -22px rgba(22,21,19,.45)}",
    ":root[data-theme=\"light\"]{--stone:#0c0c0b;--paper:#f7f3e8;--surface:#fffdf8;--ink:#161513;--ink-2:#3c3832;--ink-3:#6e675c;--line:#d8d0be;--fed:#9c1c1c;--com:#1c3d4d}",
    "body{font-family:Georgia,\"Iowan Old Style\",Palatino,serif}",
    ".bar{border-radius:0;border-left:0;border-right:0;border-top:0;border-bottom:3px solid #9c1c1c}",
    "#tick{background:#141311;color:#f3efe3;border-top:3px solid #9c1c1c}",
    "#tick b{color:#e15a5a;font-family:Georgia,serif;letter-spacing:.08em;text-transform:uppercase;font-weight:700}",
    ".card.onum-newsroom{background:#f6f1e4;color:#161513}",
    ".onum-press{color:#161513;font-family:Georgia,Palatino,serif}",
    ".onum-masthead{text-align:center;border-top:6px solid #9c1c1c;border-bottom:2px solid #161513;padding:10px 0 8px;margin:0 0 14px}",
    ".onum-masthead h1{font:700 clamp(34px,7vw,64px)/.88 Georgia,serif;letter-spacing:-.03em;text-transform:uppercase;margin:2px 0}",
    ".onum-kicker{font:700 11px/1.2 ui-monospace,Menlo,monospace;letter-spacing:.22em;text-transform:uppercase;color:#9c1c1c;margin:0 0 4px}",
    ".onum-date{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;font:11px/1.3 ui-monospace,Menlo,monospace;letter-spacing:.08em;text-transform:uppercase;border-top:1px solid #161513;margin-top:6px;padding-top:4px}",
    ".onum-press h2{font:700 clamp(26px,4vw,40px)/1.05 Georgia,serif;margin:0 0 8px}",
    ".onum-deck{font-style:italic;margin:0 0 10px}",
    ".onum-lede{font:18px/1.45 Georgia,serif;margin:0 0 8px}",
    ".onum-lede::first-letter{font:700 62px/.8 Georgia,serif;float:left;padding:6px 8px 0 0;color:#9c1c1c}",
    ".onum-by{font:11px/1.3 ui-monospace,Menlo,monospace;letter-spacing:.04em;color:#6e675c;margin:0 0 12px}",
    ".onum-grid{display:grid;grid-template-columns:1.35fr .8fr;gap:18px;border-top:1px solid #161513;padding-top:10px}",
    ".onum-press h3{font:700 12px/1.2 ui-monospace,Menlo,monospace;letter-spacing:.16em;text-transform:uppercase;border-bottom:1px solid #161513;padding-bottom:3px;margin:12px 0 6px}",
    ".onum-band{text-align:center;letter-spacing:.18em;text-transform:uppercase;font:700 11px/1.3 ui-monospace,Menlo,monospace;border-top:3px double #161513;border-bottom:3px double #161513;padding:6px 0;margin:16px 0 8px}",
    ".onum-desks{display:grid;grid-template-columns:1fr 1fr;gap:12px 18px}",
    ".onum-desk{border-top:2px solid #9c1c1c;padding-top:6px}",
    ".onum-tag{font-style:italic;color:#6e675c;margin:0 0 4px}",
    ".onum-aside{background:#161513;color:#f3efe3;padding:12px 14px;margin-top:14px}",
    ".onum-aside h3{color:#e15a5a;border-bottom-color:#f3efe3}",
    ".onum-wire{list-style:none;margin:0;padding:0}",
    ".onum-wire li{border-bottom:1px solid #d8d0be;padding:5px 0;font-size:14px}",
    "@media(max-width:720px){.onum-grid,.onum-desks{grid-template-columns:1fr}}"
  ].join("");
  document.head.appendChild(st);
}


/* 20261116c */
/* 20261116c — the open world, drawn out: every room, every door, every thing you can do there.
   Drawing the whole room is a switch. The frame stays the one that already works until you ask. */
function onumRoomPeople(id){
  let n = 0;
  const names = [];
  try{
    (everyone() || []).forEach(function(p){
      if(!p || p.gone || p === G.you || p.room !== id) return;
      n++;
      if(names.length < 4 && p.name) names.push(p.name);
    });
  }catch(e){}
  return {n:n, names:names};
}
function onumRoomActs(id){
  const out = [];
  const list = (typeof PROPS !== "undefined" && PROPS[id]) || [];
  list.forEach(function(p){
    if(!p || !p.label) return;
    let acts = [];
    try{ acts = typeof p.acts === "function" ? (p.acts() || []) : (p.acts || []); }catch(e){ acts = []; }
    if(!Array.isArray(acts)) acts = [];
    const names = [];
    acts.forEach(function(a){ if(a && a.t && names.length < 5) names.push(String(a.t)); });
    out.push({label:String(p.label), sub:p.sub ? String(p.sub) : "", acts:names});
  });
  return out;
}
function onumWorldPlan(){
  const spot = {
    office:[0,1], cloak:[1,0], corridor:[1,1], caucus:[0,2], committee:[2,0],
    floor:[1,2], press:[2,1], engine:[2,2], senate:[3,0], court:[3,1],
    exec:[3,2], steps:[4,1], district:[5,1], govoffice:[5,2], visit:[0,0]
  };
  const cw = 132, ch = 78;
  let boxes = "", lines = "";
  const here = G.room;
  Object.keys(ROOMS).forEach(function(id){
    const at = spot[id] || [0,3];
    const x = 16 + at[0] * cw, y = 16 + at[1] * ch;
    const R = ROOMS[id];
    const on = id === here;
    boxes += '<g class="onum-rm" data-rm="' + id + '" style="cursor:pointer"><rect x="' + x + '" y="' + y + '" width="118" height="58" rx="2" fill="' + (on ? "#9c1c1c" : "#f7f3e8") + '" stroke="#161513" stroke-width="' + (on ? 2.5 : 1) + '"></rect>' +
      '<text x="' + (x + 59) + '" y="' + (y + 24) + '" text-anchor="middle" font-family="Georgia,serif" font-size="11" fill="' + (on ? "#f7f3e8" : "#161513") + '">' + pcEsc(R.t) + '</text>' +
      '<text x="' + (x + 59) + '" y="' + (y + 42) + '" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="9" fill="' + (on ? "#f3d0d0" : "#6e675c") + '">' + (R.open ? "open air" : "indoors") + " · " + (R.travel || 0) + "m</text></g>";
  });
  Object.keys(DOORS || {}).forEach(function(from){
    (DOORS[from] || []).forEach(function(d){
      const a = spot[from], b = spot[d.to];
      if(!a || !b) return;
      lines += '<line x1="' + (16 + a[0] * cw + 59) + '" y1="' + (16 + a[1] * ch + 29) + '" x2="' + (16 + b[0] * cw + 59) + '" y2="' + (16 + b[1] * ch + 29) + '" stroke="#9c1c1c" stroke-width="1" opacity="0.45"></line>';
    });
  });
  const W = 16 + 6 * cw, H = 16 + 4 * ch;
  return '<svg viewBox="0 0 ' + W + ' ' + H + '" style="width:100%;height:auto;background:#f6f1e4;border:1px solid #161513">' + lines + boxes + '</svg>' +
    '<p class="muted">A red room is the one you are standing in. A line is a door. Minutes are the walk. Click a room to go there. The picture of the room itself is unchanged.</p>';
}
function onumWorldHTML(){
  const here = G.room;
  const R = ROOMS[here] || {};
  const people = onumRoomPeople(here);
  const props = onumRoomActs(here);
  const doors = ((DOORS && DOORS[here]) || []).map(function(d){
    const to = ROOMS[d.to];
    return to ? (to.t + " (" + (to.travel || 0) + " min)") : d.to;
  });
  const propHtml = props.length ? props.map(function(p){
    return '<div style="border-top:1px solid var(--line);padding:6px 0"><b>' + pcEsc(p.label) + '</b>' +
      (p.sub ? '<div class="muted">' + pcEsc(p.sub) + '</div>' : '') +
      (p.acts.length ? '<div>' + p.acts.map(function(t){ return pcEsc(t); }).join(" · ") + '</div>' : '<div class="muted">Nothing to do but stand by it.</div>') +
      '</div>';
  }).join("") : '<p class="muted">Nothing in this room has a use written on it.</p>';
  const rooms = ROOM_ORDER.filter(function(id){ return ROOMS[id]; }).map(function(id){
    const Rm = ROOMS[id];
    const pe = onumRoomPeople(id);
    const nProps = ((PROPS && PROPS[id]) || []).length;
    return '<tr' + (id === here ? ' style="background:rgba(156,28,28,.08)"' : '') + '><td>' + pcEsc(Rm.t) + '</td><td>' + (Rm.open ? "open air" : "indoors") + '</td><td>' + (Rm.travel || 0) + ' min</td><td>' + nProps + ' things</td><td>' + pe.n + (pe.names.length ? " — " + pcEsc(pe.names.join(", ")) : "") + '</td></tr>';
  }).join("");
  const states = (G.states || []).map(function(s){
    let gov = "";
    try{ gov = stateGovInfo(s.n).g.short; }catch(e){}
    const home = G.you && s.n === G.you.state;
    const can = [];
    if(home) can.push("your streets, your door, the shops, the church, the campaign office");
    if(s.bill && s.bill.title) can.push("the statehouse has " + s.bill.title);
    can.push(gov || "a government of its own");
    return '<tr' + (home ? ' style="background:rgba(156,28,28,.08)"' : '') + '><td>' + (home ? "★ " : "") + pcEsc(s.n) + '</td><td>' + Math.round(s.unrest || 0) + '</td><td>' + Math.round(s.ind || 0) + '</td><td>' + pcEsc(can.join(". ")) + '</td></tr>';
  }).join("");
  const draw = !!(G && G.drawAll);
  return '<p>You can walk every room that has a door, speak to whoever is standing in it, and use whatever is written on the furniture. Open air is the steps and the district: sky, ground, and a longer walk. The statehouse is through the district. Nothing here invents a power the room does not already have.</p>' +
    '<div class="eyebrow">Where you are</div>' +
    '<p><b>' + pcEsc(R.t || here || "nowhere") + '</b> · ' + pcEsc(R.tag || "") + ' · ' + (R.open ? "open air" : "indoors") + ' · ' + (R.travel || 0) + ' minutes if you come from away. ' +
    (people.n ? people.n + ' others here' + (people.names.length ? ': ' + pcEsc(people.names.join(", ")) : '') + '.' : 'Nobody else is in the room.') +
    (doors.length ? ' Doors: ' + pcEsc(doors.join("; ")) + '.' : '') + '</p>' +
    '<div class="eyebrow">What you can do in this room</div>' + propHtml +
    '<div class="eyebrow">The building, rendered</div>' + onumWorldPlan() +
    '<div class="eyebrow">Every room</div>' +
    '<table class="onum-book"><thead><tr><th>Room</th><th>Air</th><th>Walk</th><th>Things</th><th>People</th></tr></thead><tbody>' + rooms + '</tbody></table>' +
    '<div class="eyebrow">Every state, and what it will let you do</div>' +
    '<table class="onum-book"><thead><tr><th>State</th><th>Unrest</th><th>Industry</th><th>Capability</th></tr></thead><tbody>' + states + '</tbody></table>' +
    '<div class="card__actions"><button type="button" class="btn" id="onumDrawAll">' + (draw ? "Draw only what is near" : "Draw the whole room") + '</button></div>' +
    '<p class="muted">' + (draw ? "Everyone in reach is being drawn, and the far plane is out. Turn it off if the picture stutters." : "The picture still drops detail at a distance, so the frame holds. Draw the whole room when you want every person in it.") + '</p>';
}
function onumDrawAll(on){
  G.drawAll = !!on;
  try{ applyQuality(); }catch(e){}
  try{
    if(typeof camera !== "undefined" && camera){
      camera.far = G.drawAll ? Math.max(camera.far || 180, 420) : Math.min(camera.far || 180, 180);
      if(camera.updateProjectionMatrix) camera.updateProjectionMatrix();
    }
  }catch(e){}
  try{ note(G.drawAll ? "The whole room is being drawn." : "Drawing is back to the distance that keeps the frame."); }catch(e){}
}
function onumWorldBind(){
  const b = document.getElementById("onumDrawAll");
  if(b && !b.dataset.bound){
    b.dataset.bound = "1";
    b.addEventListener("click", function(){ onumDrawAll(!G.drawAll); try{ onumOpenWorldCard(); }catch(e){} });
  }
  document.querySelectorAll(".onum-rm").forEach(function(g){
    if(g.dataset.bound) return;
    g.dataset.bound = "1";
    g.addEventListener("click", function(){
      const id = g.getAttribute("data-rm");
      if(!id || !ROOMS[id] || id === G.room) return;
      try{ if(typeof veil !== "undefined") veil.hidden = true; }catch(e){}
      try{ card.classList.remove("card--open"); }catch(e){}
      G.running = true;
      try{ enterRoom(id, G.room); }catch(e){ G.room = id; }
    });
  });
}
function onumOpenWorldCard(){   /* 20261117o JUPITER: was a second onumWorldCard (20261116c) that replaced the Engine's daily world text, so opening the Engine opened this card */
  try{ govCardOpen("The open world", "What you can walk, and what you can do", "Every room, every door, every state.", onumWorldHTML(), null); }catch(e){ return; }
  setTimeout(onumWorldBind, 0);
}
{ const _aq = applyQuality; applyQuality = function(){
  const r = _aq.apply(this, arguments);
  try{
    if(G && G.drawAll){
      LOD_NEAR = 16; LOD_MID = 36; LOD_FAR = 80;
      if(typeof camera !== "undefined" && camera){
        camera.far = Math.max(camera.far || 180, 420);
        if(camera.updateProjectionMatrix) camera.updateProjectionMatrix();
      }
    }
  }catch(e){}
  return r;
}; }
{ const _rm = renderMap; renderMap = function(sel){
  const svg = _rm.apply(this, arguments);
  try{
    const rows = (G.states || []).map(function(s){
      const on = sel === s.n;
      let gov = "";
      try{ gov = stateGovInfo(s.n).g.short; }catch(e){}
      return '<div style="display:flex;gap:8px;justify-content:space-between;border-bottom:1px solid var(--line-soft);padding:3px 0;font:12px/1.35 ui-monospace,Menlo,monospace' + (on ? ';background:rgba(156,28,28,.08)' : '') + '"><span>' + (s.n === (G.you && G.you.state) ? "★ " : "") + pcEsc(s.n) + '</span><span>unrest ' + Math.round(s.unrest || 0) + ' · industry ' + Math.round(s.ind || 0) + ' · ' + pcEsc(gov || "governed") + (s.bill && s.bill.title ? " · " + pcEsc(s.bill.title) : "") + '</span></div>';
    }).join("");
    return svg + '<div class="eyebrow" style="margin-top:10px">All ' + (G.states || []).length + ' states, rendered</div>' + rows;
  }catch(e){ return svg; }
}; }
{ const _mc = mapCard; mapCard = function(){
  const r = _mc.apply(this, arguments);
  try{
    const done = el("mapDone");
    if(done && !document.getElementById("onumWorldBtn")){
      const b = document.createElement("button");
      b.id = "onumWorldBtn"; b.type = "button"; b.className = "btn"; b.textContent = "What the world can do";
      done.parentNode.insertBefore(b, done);
      b.addEventListener("click", function(){ onumOpenWorldCard(); });
    }
  }catch(e){}
  return r;
}; }
function onumWorldBar(){
  if(document.getElementById("onumWorldBar")) return;
  const speed = document.getElementById("speed");
  if(!speed) return;
  const b = document.createElement("button");
  b.id = "onumWorldBar"; b.type = "button"; b.title = "The open world"; b.setAttribute("aria-label", "Open the world"); b.textContent = "World";
  b.addEventListener("click", function(){ try{ onumOpenWorldCard(); }catch(e){} });
  speed.appendChild(b);
}
try{
  const _pb = pbApps;
  pbApps = function(){
    const A = _pb.apply(this, arguments) || [];
    A.push({id:"soc-world", t:"The open world", d:"Every room, every door, every state, and what you can do there.", run:function(){ onumOpenWorldCard(); }});
    return A;
  };
}catch(e){}
setTimeout(onumWorldBar, 800);


/* 20261117a */
/* 20261117a — the street, the houses, the relics, the wire.
   The building is not remeshed. Doors still walk you through.
   The district is longer, so the seven blocks have ground under them. */
function onumWidenDistrict(){
  const R = ROOMS.district;
  if(!R || R._wide) return;
  R._wide = 1;
  if(R.w < 22) R.w = 22;
  if(R.d < 26) R.d = 26;
}
function onumBlocks(){
  if(G.blocks && G.blocks.v === 1 && G.blocks.list && G.blocks.list.length === 7) return G.blocks;
  const state = (G.you && G.you.state) || "home";
  let towns = [];
  try{ towns = (townsOf(state) || []).map(function(t){ return t && t.name; }).filter(Boolean); }catch(e){}
  const roles = [
    ["parish", "The parish"],
    ["union", "The union hall"],
    ["counter", "Your counter"],
    ["kiosk", "The press kiosk"],
    ["wharf", "The grain wharf"],
    ["campaign", "The campaign block"],
    ["market", "Market row"]
  ];
  G.blocks = {v:1, list: roles.map(function(r, i){
    return {k:r[0], role:r[1], name: towns[i] || r[1], foot: 30 + ((i * 11) % 40), price: 8 + i * 2, till: r[0] === "counter" ? 48 : 0, owned: r[0] === "counter"};
  })};
  return G.blocks;
}
function onumBlock(k){
  return onumBlocks().list.filter(function(b){ return b.k === k; })[0] || null;
}
function onumDutyCount(){
  try{ return (G.statute || []).filter(function(s){ return s && s.fate === "carried" && typeof lxDomainOf === "function" && lxDomainOf(s) === "tariff"; }).length; }catch(e){ return 0; }
}
function onumShopTick(){
  const B = onumBlocks();
  const g = (function(){ try{ return guilderIndex(); }catch(e){ return 100; } })();
  const duty = onumDutyCount();
  const hot = (function(){ const s = onumHotState && onumHotState(); return s ? s.unrest || 0 : 30; })();
  B.list.forEach(function(b){
    const pull = (100 - g) * 0.15 + duty * 2 - (hot > 60 ? 6 : 0);
    b.foot = Math.max(4, Math.round((b.foot || 20) * 0.82 + 18 + pull));
    b.price = Math.max(2, Math.round(((b.price || 10) * (g / 100) + duty) * 10) / 10);
    if(b.owned) b.till = Math.round(((b.till || 0) + b.foot * b.price * 0.02) * 10) / 10;
  });
  B.day = G.day;
}
function onumTickerText(){
  let g = "?", bread = "?", grain = "?";
  try{ g = guilderIndex().toFixed(1); }catch(e){}
  try{ if(G.world && G.world.bread) bread = (G.world.bread * (guilderIndex() / 100)).toFixed(2); }catch(e){}
  try{ const M = onumMkt(); if(M && M.px) grain = Number(M.px.grain).toFixed(1); }catch(e){}
  const bill = (G.bill && !G.bill.done && G.bill.title) ? G.bill.title : "no bill on the floor";
  const duty = onumDutyCount();
  return "Guilder " + g + "  ·  loaf " + bread + "  ·  grain " + grain + "  ·  duties " + duty + "  ·  " + bill;
}
function onumPublic(text){
  const t = String(text || "").replace(/\s+/g, " ").trim();
  if(!t) return;
  G.lorePublic = G.lorePublic || [];
  if(G.lorePublic.some(function(x){ return x.t === t && x.d === G.day; })) return;
  G.lorePublic.unshift({d:G.day, t:t});
  if(G.lorePublic.length > 40) G.lorePublic.length = 40;
  try{ voxAdd({t:t, d:G.day, reply:true}); }catch(e){}
}
function onumHeirDay(){
  G.dynasty = G.dynasty || {in:[], day:-1};
  if(G.dynasty.day === G.day) return;
  G.dynasty.day = G.day;
  if((seedOf("vac:" + G.day) % 100) > 42) return;
  let F = null;
  try{ F = famEnsure(); }catch(e){ return; }
  const gone = (G.members || []).filter(function(m){ return m && m.gone && m !== G.you && F.p && F.p[m.id]; });
  if(!gone.length) return;
  const m = gone[seedOf("heir:" + G.day) % gone.length];
  const f = F.p[m.id];
  const kid = (f.kids || []).slice().sort(function(a, b){ return (b.age || 0) - (a.age || 0); })[0];
  const grown = kid && kid.age >= 18;
  const who = grown ? (kid.name + " " + surname(m.name)) : (f.spouse ? f.spouse.name : "");
  if(!who) return;
  const civ = (G.civ || []).filter(function(c){ return c && !c.gone && !c._heir && c.state === m.state; })[0];
  let line;
  if(!civ){
    line = who + ", of the house of " + surname(m.name) + ", is named for the vacancy. They are not in the building yet.";
  } else {
    civ._heir = m.id;
    civ.role = grown ? ("Freshman, house of " + surname(m.name)) : ("Staffer, house of " + surname(m.name));
    civ.room = "corridor";
    try{ placeInRoom(civ); }catch(e){}
    line = who + " comes into the corridor for the house of " + surname(m.name) + ", which has fallen.";
  }
  G.dynasty.in.unshift({d:G.day, t:line});
  if(G.dynasty.in.length > 12) G.dynasty.in.length = 12;
  try{ feed(line, "news"); }catch(e){}
  onumPublic(line);
}
function onumPassRelic(){
  let L = null;
  try{ L = consularLoreEnsure(); }catch(e){ return; }
  const live = CONSULAR_HORCRUXES.filter(function(h){ return h && !L.smashed[h.id]; });
  if(!live.length) return;
  const h = live[seedOf("hx:" + G.day) % live.length];
  const rooms = ["corridor","cloak","office","committee","floor","press","steps","caucus"];
  const nxt = rooms[(rooms.indexOf(h.room) + 1 + (seedOf("hxr:" + G.day) % 3)) % rooms.length];
  const spot = {corridor:[-1.1,11.2], cloak:[1.1,4.2], office:[-1.4,5.6], committee:[-2.1,5.2], floor:[2.2,7.4], press:[-1.2,4.1], steps:[1.4,6.2], caucus:[2.1,6.4]};
  h.room = nxt;
  const sp = spot[nxt] || [0, 4];
  h.x = sp[0]; h.z = sp[1];
  G.relicWalk = G.relicWalk || [];
  const line = "The remnant passed " + h.t.toLowerCase() + " into " + ((ROOMS[nxt] && ROOMS[nxt].t) || nxt) + ". You can walk to it.";
  G.relicWalk.unshift({d:G.day, id:h.id, room:nxt, t:line});
  if(G.relicWalk.length > 16) G.relicWalk.length = 16;
  try{ feed(line); }catch(e){}
  onumPublic(line);
}
function onumHost(){
  if(!G || !G.running || !G.you) return;
  const hour = Math.floor((G.minute || 0) / 60);
  if(hour !== 7 && hour !== 12 && hour !== 18) return;
  const key = G.day + ":" + hour;
  if(G._hostHour === key) return;
  const cons = (G.members || []).filter(function(m){ return m && !m.gone && isConsular(m); });
  const chap = (G.members || []).filter(function(m){ return m && !m.gone && m.creed === "latin" && !isConsular(m); })[0];
  if(!cons.length || !chap) return;
  G._hostHour = key;
  (G.members || []).forEach(function(m){
    if(!m || m.gone || !m.rel) return;
    if(m.creed === "latin" && !isConsular(m)) m.rel.warmth = Math.max(-100, Math.min(100, (m.rel.warmth || 0) + 4));
    if(isConsular(m)) m.rel.warmth = Math.max(-100, Math.min(100, (m.rel.warmth || 0) - 6));
  });
  const line = chap.name + " refuses the Host to the Consulars at the corridor bronze. The Latin members saw it, and they will vote as if they saw it.";
  try{ feed(line, "news"); }catch(e){}
  onumPublic(line);
}
function onumCapitolMood(){
  const hour = Math.floor((G.minute || 0) / 60);
  let mood = "ordinary";
  try{ if(typeof isTaylorDay === "function" && isTaylorDay()) mood = "taylor"; }catch(e){}
  if(mood === "ordinary" && (hour === 7 || hour === 12 || hour === 18)) mood = "vigil";
  if(G.you && G.you.out) mood = "crowd";
  G.capitolMood = mood;
  return mood;
}
function onumCeleb(){
  if(G.celebId){ const p = byId(G.celebId); if(p && !p.gone) return p; }
  const pool = (G.press || []).concat(G.civ || []).filter(function(p){ return p && !p.gone && p.name; });
  if(!pool.length) return null;
  pool.sort(function(a, b){ return ((b.traits && b.traits.vanity) || 0) - ((a.traits && a.traits.vanity) || 0); });
  G.celebId = pool[0].id;
  return pool[0];
}
function onumOpenDay(){
  if(!G || !G.you) return;
  if(G._openDay === G.day) return;
  G._openDay = G.day;
  try{ onumShopTick(); }catch(e){}
  try{ onumHeirDay(); }catch(e){}
  try{ onumPassRelic(); }catch(e){}
  try{ onumCapitolMood(); }catch(e){}
  try{ onumCeleb(); }catch(e){}
}
function onumListen(roomId){
  const people = (typeof everyone === "function" ? everyone() : []).filter(function(m){
    return m && !m.gone && m !== G.you && m.room === roomId && m.name;
  });
  if(!people.length) return "The room on the other side of the door is empty. You hear the building, not a plot.";
  const m = people[seedOf("hear:" + roomId + ":" + G.day + ":" + Math.floor((G.minute || 0) / 30)) % people.length];
  let said = "";
  try{ if(m.intent && m.intent.t) said = m.name + " means to " + m.intent.t + "."; }catch(e){}
  if(!said && m.sent && m.sent.now) said = m.name + ": " + m.sent.now;
  if(!said) said = m.name + " is in there, and is not speaking for you.";
  const line = "Outside the door, you hear " + said;
  try{ feed(line); }catch(e){}
  onumPublic("Overheard, not for the record: " + said);
  return line;
}
function onumVetCard(){
  G.vet = G.vet || {step:0};
  const pool = (G.members || []).filter(function(m){ return m && !m.gone && m !== G.you && m.name; }).slice(0, 8);
  const rows = pool.map(function(m){
    return '<button type="button" class="btn btn--ghost" data-vet="' + m.id + '">' + pcEsc(m.name) + " · " + pcEsc(m.state || "") + "</button>";
  }).join(" ");
  const cur = G.vet.id ? byId(G.vet.id) : null;
  const body = '<p>A name from the building comes to your office, then onto the wire, then you ask the floor. The Senate still has its own vote. This does not skip it. It makes the person walk here.</p>' +
    (cur ? '<p><b>' + pcEsc(cur.name) + '</b> is the name on the file. Step ' + (G.vet.step || 0) + ' of 3.</p>' : '<p>No name on the file.</p>') +
    '<div class="card__actions" style="flex-wrap:wrap">' + rows + '</div>' +
    '<div class="card__actions"><button type="button" class="btn" id="vetCall">Call them to the office</button><button type="button" class="btn" id="vetWire">Put them on the wire</button><button type="button" class="btn" id="vetFloor">Ask the floor</button></div><div class="dream" id="vetSay"></div>';
  govCardOpen("The file", "A person, not a post", "They have to stand in the room.", body, null);
  document.querySelectorAll("[data-vet]").forEach(function(b){
    b.addEventListener("click", function(){ G.vet = {id:b.getAttribute("data-vet"), step:0}; onumVetCard(); });
  });
  const say = function(t){ const n = document.getElementById("vetSay"); if(n) n.textContent = t; };
  const call = document.getElementById("vetCall");
  if(call) call.addEventListener("click", function(){
    const p = G.vet && byId(G.vet.id); if(!p){ say("Pick a person first."); return; }
    p.room = "office";
    try{ placeInRoom(p); }catch(e){}
    G.vet.step = 1;
    say(p.name + " is in your office. Talk to them there. The mesh was not rebuilt.");
  });
  const wire = document.getElementById("vetWire");
  if(wire) wire.addEventListener("click", function(){
    const p = G.vet && byId(G.vet.id); if(!p || G.vet.step < 1){ say("They have not stood in the office yet."); return; }
    const line = "The wire has " + p.name + " for a desk. The questions are about the office, not about a stranger.";
    try{ feed(line, "news"); }catch(e){}
    onumPublic(line);
    G.vet.step = 2;
    say(line);
  });
  const floor = document.getElementById("vetFloor");
  if(floor) floor.addEventListener("click", function(){
    const p = G.vet && byId(G.vet.id); if(!p || G.vet.step < 2){ say("The wire has not had them yet."); return; }
    const line = "The floor is asked to look at " + p.name + ". Confirmation is still the Senate, if the Senate is in session. The ask is on the record.";
    try{ feed(line, "news"); }catch(e){}
    onumPublic(line);
    G.vet.step = 3;
    say(line);
  });
}
function onumStreetHTML(){
  onumOpenDay();
  const mood = onumCapitolMood();
  const moodLine = mood === "taylor" ? "Taylor Day. Banners on the steps. The corridor keeps the bronze."
    : mood === "vigil" ? "Seven, noon, or six. Candles at the corridor bronze, if the remnant is keeping the hour."
    : mood === "crowd" ? "You are out of the seat. The steps have a crowd, and they are not here to cheer."
    : "An ordinary day on the stone. The doors still walk you through. Nothing is streamed in behind them.";
  const blocks = onumBlocks().list.map(function(b){
    return '<tr><td>' + pcEsc(b.name) + '</td><td>' + pcEsc(b.role) + '</td><td>' + b.foot + '</td><td>' + b.price + '</td><td>' + (b.owned ? ("yours · till " + b.till) : "—") + '</td></tr>';
  }).join("");
  const relics = CONSULAR_HORCRUXES.map(function(h){
    let smashed = false;
    try{ smashed = !!(consularLoreEnsure().smashed || {})[h.id]; }catch(e){}
    return '<tr><td>' + pcEsc(h.t) + '</td><td>' + (smashed ? "smashed" : pcEsc((ROOMS[h.room] && ROOMS[h.room].t) || h.room)) + '</td></tr>';
  }).join("");
  const heirs = ((G.dynasty && G.dynasty.in) || []).slice(0, 5).map(function(x){ return '<li>Day ' + x.d + ' — ' + pcEsc(x.t) + '</li>'; }).join("");
  const celeb = onumCeleb();
  const lore = (G.lorePublic || []).slice(0, 5).map(function(x){ return '<li>Day ' + x.d + ' — ' + pcEsc(x.t) + '</li>'; }).join("");
  return '<p>' + pcEsc(moodLine) + '</p>' +
    '<p class="muted">' + pcEsc(onumTickerText()) + '</p>' +
    '<div class="eyebrow">Seven blocks, past the East Steps</div>' +
    '<p>The district is longer than it was. Walk in from the steps and the new blocks are under your feet: parish, union hall, your counter, the kiosk, the wharf, the campaign block, market row. Foot traffic and the price move with the guilder, the duties, and the unrest. Your counter is the only one whose till is yours.</p>' +
    '<table class="onum-book"><thead><tr><th>Block</th><th>What it is</th><th>Feet</th><th>Price</th><th>Till</th></tr></thead><tbody>' + blocks + '</tbody></table>' +
    '<div class="eyebrow">Where the eight relics are</div>' +
    '<table class="onum-book"><thead><tr><th>Remainder</th><th>Where</th></tr></thead><tbody>' + relics + '</tbody></table>' +
    '<p class="muted">Once a day the remnant passes one that is not smashed into another room. Walk there. Venerate it, or smash it. God is the Most High. The relic is not.</p>' +
    '<div class="eyebrow">Houses that fell</div>' + (heirs ? '<ul>' + heirs + '</ul>' : '<p class="muted">No house has sent a son or a spouse into the corridor today. The chance, when a seat is empty, is about two in five.</p>') +
    '<div class="eyebrow">On the wire, and kept</div>' + (lore ? '<ul>' + lore + '</ul>' : '<p class="muted">Nothing public has been kept yet today.</p>') +
    (celeb ? '<div class="eyebrow">A name the district already knows</div><p>' + pcEsc(celeb.name) + (celeb.role ? ", " + pcEsc(celeb.role) : "") + (celeb.outlet ? ", " + pcEsc(celeb.outlet) : "") + '.</p>' : '') +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" id="stTill">Take the till</button><button type="button" class="btn" id="stCeleb">Ask them onto the steps</button><button type="button" class="btn" id="stRun">Let them run</button><button type="button" class="btn" id="stVet">Open a file</button></div><div class="dream" id="stSay"></div>';
}
function onumStreetBind(){
  const say = function(t){ const n = document.getElementById("stSay"); if(n) n.textContent = t; };
  const till = document.getElementById("stTill");
  if(till) till.addEventListener("click", function(){
    const b = onumBlock("counter"); if(!b) return;
    const take = Math.floor(b.till || 0);
    if(take < 1){ say("The till is empty. Feet have not bought enough."); return; }
    b.till = 0;
    try{ purseOf(G.you).cash += take; purseLog(G.you, "Till from your counter", take); }catch(e){}
    const line = "You take " + take + " from the counter. The guilder had a hand in what the street would pay.";
    try{ feed(line); }catch(e){}
    say(line);
  });
  const celebBtn = document.getElementById("stCeleb");
  if(celebBtn) celebBtn.addEventListener("click", function(){
    const p = onumCeleb(); if(!p){ say("Nobody in the district is famous enough to draw a crowd."); return; }
    p.room = "steps";
    try{ placeInRoom(p); }catch(e){}
    const line = p.name + " is on the East Steps, and the crowd knows the name from the wire before it knows a bill.";
    try{ feed(line, "news"); }catch(e){}
    onumPublic(line);
    say(line);
  });
  const run = document.getElementById("stRun");
  if(run) run.addEventListener("click", function(){
    const p = onumCeleb(); if(!p) return;
    p._running = true;
    const line = p.name + " will stand in the next election as a freshman the district already knew from somewhere else.";
    try{ feed(line, "news"); }catch(e){}
    onumPublic(line);
    say(line);
  });
  const vet = document.getElementById("stVet");
  if(vet) vet.addEventListener("click", function(){ onumVetCard(); });
}
function onumStreetCard(){
  try{ govCardOpen("The street", "Seven blocks, and the houses that use them", "Walk it. The picture of the Capitol is the one you already have.", onumStreetHTML(), null); }catch(e){ return; }
  setTimeout(onumStreetBind, 0);
}
function onumAddProps(){
  onumWidenDistrict();
  function add(room, prop){
    PROPS[room] = PROPS[room] || [];
    if(PROPS[room].some(function(p){ return p && p.id === prop.id; })) return;
    PROPS[room].push(prop);
  }
  add("district", {id:"onum-union", label:"The union hall", sub:"A block past the market. Dues, grievances, a flag.", x:-7.2, z:16.4, r:2.2, acts:function(){
    const b = onumBlock("union");
    return [{t:"Read the board", c:"4m", run:function(){ spend(4, 1); setSay(b ? (b.name + " has " + b.foot + " people through the door, and the price on the board is " + b.price + ".") : "The board is blank.", ""); }}];
  }});
  add("district", {id:"onum-kiosk", label:"The press kiosk", sub:"The wire, an hour late, and the ticker.", x:6.4, z:16.2, r:1.8, acts:function(){
    return [{t:"Read the ticker", c:"2m", run:function(){ spend(2, 0); setSay(onumTickerText(), ""); }}, {t:"The seven blocks", c:"6m", run:function(){ spend(6, 0); onumStreetCard(); }}];
  }});
  add("district", {id:"onum-counter", label:"Your counter", sub:"The storefront with your name on the glass.", x:-6.8, z:19.5, r:2.2, acts:function(){
    const b = onumBlock("counter");
    return [{t:"Count the till", c:"5m", run:function(){ spend(5, 0); setSay(b ? ("The till holds " + b.till + ". Feet today: " + b.foot + ". Price: " + b.price + ".") : "No till.", ""); }},
      {t:"Take what is yours", c:"5m", run:function(){
        const take = b ? Math.floor(b.till || 0) : 0;
        if(!take){ setSay("Nothing to take.", ""); return; }
        b.till = 0; spend(5, 0);
        try{ purseOf(G.you).cash += take; purseLog(G.you, "Till from your counter", take); }catch(e){}
        setSay("You take " + take + " and leave the price where the street put it.", "");
      }}];
  }});
  add("district", {id:"onum-wharf", label:"The grain wharf", sub:"What the guilder does to a loaf, in sacks.", x:6.6, z:19.8, r:2.2, acts:function(){
    return [{t:"Ask the price", c:"3m", run:function(){ spend(3, 0); const b = onumBlock("wharf"); setSay(b ? ("Grain off this wharf is " + b.price + ", and " + b.foot + " came down to look.") : "The wharf is quiet.", ""); }}];
  }});
  add("district", {id:"onum-camp", label:"The campaign block", sub:"A room with a map of the seven blocks.", x:0.4, z:21.2, r:2.0, acts:function(){
    return [{t:"Open the street book", c:"8m", run:function(){ spend(8, 1); onumStreetCard(); }}];
  }});
  add("corridor", {id:"onum-caucus-door", label:"Outside the caucus door", sub:"You can hear them if you stand still.", x:-2.4, z:6.5, r:1.5, acts:function(){
    return [{t:"Listen", c:"6m", run:function(){ spend(6, 1); setSay(onumListen("caucus"), ""); }}];
  }});
  add("corridor", {id:"onum-committee-door", label:"Outside Committee 2141", sub:"The door is shut. The voices are not.", x:2.6, z:8.2, r:1.5, acts:function(){
    return [{t:"Listen", c:"6m", run:function(){ spend(6, 1); setSay(onumListen("committee"), ""); }}];
  }});
  add("corridor", {id:"onum-vigil", get label(){ return G.capitolMood === "vigil" ? "Candles at the bronze" : "The bronze"; }, get sub(){ return G.capitolMood === "vigil" ? "Seven, noon, or six. The remnant is keeping the hour." : "A plinth. Quiet, unless the hour is one of theirs."; }, x:-0.4, z:14.2, r:1.6, acts:function(){
    return [{t:"Stand and look", c:"4m", run:function(){ spend(4, 0); onumCapitolMood(); setSay(G.capitolMood === "vigil" ? "The candles are lit. The Host, if it is refused, is refused where you can see it." : "The bronze is only bronze, until the hour.", ""); }}];
  }});
  add("steps", {id:"onum-banners", get label(){
      if(G.capitolMood === "crowd") return "A crowd on the steps";
      if(G.capitolMood === "taylor") return "Taylor Day banners";
      return "The East Steps";
    }, get sub(){
      if(G.capitolMood === "crowd") return "They came because the seat is empty of you.";
      if(G.capitolMood === "taylor") return "7/7. The banners are up. The building did not change shape.";
      return "Open air, and the door back into the Capitol.";
    }, x:0.2, z:5.5, r:2.0, acts:function(){
      return [{t:"Read the steps", c:"3m", run:function(){ spend(3, 0); onumCapitolMood(); setSay(G.capitolMood === "taylor" ? "Taylor Day. The banners name the First Consul, who is a man under God." : G.capitolMood === "crowd" ? "The crowd is not a texture. They are here because you lost the seat." : "Ordinary stone. The door back into the Capitol is behind you.", ""); }}];
  }});
  add("office", {id:"onum-drawer", label:"The desk drawer", sub:"The bill, the books, and anything the remnant left in this room.", x:0.8, z:6.4, r:1.4, acts:function(){
    const acts = [
      {t:"Read the ticker", c:"1m", run:function(){ spend(1, 0); setSay(onumTickerText(), ""); }},
      {t:"Open the books", c:"4m", run:function(){ spend(4, 0); try{ onumBooksCard(); }catch(e){ setSay("The books are not on the desk.", ""); } }},
      {t:"Open a file", c:"10m", run:function(){ spend(10, 1); onumVetCard(); }}
    ];
    try{
      const h = horcruxOf("office");
      const L = consularLoreEnsure();
      if(h && !L.smashed[h.id]) acts.push({t:"The drawer has " + h.t.toLowerCase(), c:"2m", run:function(){ setSay(h.d + " It is in this room. The prop by the wall is the thing itself.", ""); }});
    }catch(e){}
    return acts;
  }});
}
{ const _ln = lNight; lNight = function(news){
  const r = _ln.apply(this, arguments);
  try{ onumOpenDay(); }catch(e){}
  return r;
}; }
{ const _fd = feed; feed = function(text, kind){
  const r = _fd.apply(this, arguments);
  try{
    const t = String(text || "");
    if(/smash|remainder|lectern|Overheard|Host |Taylor Day|storefront|house of /i.test(t)) onumPublic(t);
  }catch(e){}
  return r;
}; }
{ const _rm = renderMap; renderMap = function(sel){
  const svg = _rm.apply(this, arguments);
  try{
    const B = onumBlocks();
    const foes = (typeof WORLD_POWERS !== "undefined" ? WORLD_POWERS : []).slice(0, 4).map(function(p){
      const rel = (G.realmRel || {})[p.k];
      return pcEsc(p.t) + " " + (rel == null ? "unmeasured" : Math.round(rel));
    }).join(" · ");
    const rows = B.list.map(function(b){
      return '<div style="display:flex;justify-content:space-between;gap:8px;border-bottom:1px solid var(--line-soft);font:12px/1.35 ui-monospace,Menlo,monospace;padding:2px 0"><span>' + pcEsc(b.name) + '</span><span>' + pcEsc(b.role) + ' · feet ' + b.foot + ' · ' + b.price + '</span></div>';
    }).join("");
    return svg + '<div class="eyebrow" style="margin-top:8px">Seven blocks, and the trade</div><p class="muted">Duties in force: ' + onumDutyCount() + '. ' + pcEsc(onumTickerText()) + '</p>' + rows +
      (foes ? '<p class="muted">Rivals, and the warmth of the relation: ' + foes + '.</p>' : '');
  }catch(e){ return svg; }
}; }
{ const _sc = saveCaptureBase; saveCaptureBase = function(){
  const o = _sc.apply(this, arguments);
  try{ o.blocks = G.blocks || null; o.dynasty = G.dynasty || null; o.relicWalk = G.relicWalk || null; o.lorePublic = G.lorePublic || null; o.celebId = G.celebId || null; o.vet = G.vet || null; }catch(e){}
  return o;
}; }
try{
  const _pb = pbApps;
  pbApps = function(){
    const A = _pb.apply(this, arguments) || [];
    A.push({id:"soc-street", t:"The street", d:"Seven blocks, the till, the relics, the houses.", run:function(){ onumStreetCard(); }});
    return A;
  };
}catch(e){}
function onumStreetBar(){
  if(document.getElementById("onumStreetBar")) return;
  const speed = document.getElementById("speed");
  if(!speed) return;
  const b = document.createElement("button");
  b.id = "onumStreetBar"; b.type = "button"; b.textContent = "Street"; b.title = "The seven blocks";
  b.addEventListener("click", function(){ try{ onumStreetCard(); }catch(e){} });
  speed.appendChild(b);
}
try{ onumAddProps(); }catch(e){}
setInterval(function(){ try{ onumHost(); }catch(e){} try{ onumCapitolMood(); }catch(e){} }, 9000);
setTimeout(onumStreetBar, 900);

})(); /* 20261110bx: main IIFE close, moved below the ba block */
</script>


<script>
/* Neptune 20261021l: HUD layout manager (onumHud). Edge docks (left/right columns, top strip, bottom bar);
   panels stack in their dock and never overlap; centre (middle 50% x 60%) stays clear except modals the player opened.
   Every docked panel gets a collapse control and leaves a reopen tab. Always-on bottom bar in immersive: Say aloud + Cables. */
(function(){
  "use strict";
  if(window.onumHud) return;
  const GAP = 6, PAD = 8;
  /* dock: L/R/T/B; talk = compact talk row; chip = tiny control merged into the bottom bar */
  const REG = [
    {s:"#prompt", d:"R", n:"Prompt", noX:1},
    {s:"#hail", d:"R", n:"Wants a word", talk:1},
    {s:"#apToast", d:"R", n:"Stops you", talk:1},
    {s:"#kClock", d:"R", n:"Clock", noX:1, small:1},
    {s:"#sxDock", d:"R", n:"Meeting"},
    {s:"#feed", d:"R", n:"Feed"},
    {s:".hud", d:"L", n:"Place", noX:1, small:1},
    {s:"#aimsHud", d:"L", n:"Aims", noX:1, small:1},
    {s:"#clDock", d:"L", n:"Notices", noX:1, small:1},
    {s:".notices", d:"L", n:"Notices"},
    {s:"#cvLive", d:"L", n:"Room log", cap:150},
    {s:"#procBar", d:"L", n:"Procedure"},
    {s:"#tele", d:"L", n:"Status"},
    {s:"#job", d:"L", n:"Checklist"},
    {s:".quest,#quest,#questBox,#ckList", d:"L", n:"Checklist"},
    {s:".ach-toast", d:"T", n:"Toast"},
    {s:"#tipCard", d:"T", n:"Tip"},
    {s:"#ndFd", d:"B", n:"Floor desk"},
    {s:"#ltPill", chip:1}, {s:"#ltChatBtn", chip:1}, {s:"#dmBadge", chip:1}, {s:"#ndBuild", chip:1}
  ];
  const H = window.onumHud = {collapsed:{}, last:null};
  const css = document.createElement("style"); css.id = "hmCss";
  css.textContent = ".hm-col{display:none!important}" +
    ".hmX{position:absolute!important;top:2px!important;right:2px!important;z-index:5!important;width:20px;height:20px;line-height:16px;padding:0!important;margin:0!important;border:1px solid #c9a24a!important;border-radius:4px;background:#0d0f13!important;color:#f4f1e8!important;font:700 13px system-ui!important;cursor:pointer;pointer-events:auto!important;min-height:0!important}" +
    ".hm-p{pointer-events:auto!important}" +
    "#hmBar{position:fixed;left:8px;right:8px;bottom:6px;z-index:10050;display:flex;gap:6px;align-items:center;background:#0d0f13;color:#f4f1e8;border:1px solid #c9a24a;border-radius:8px;padding:4px 6px;font:13px system-ui,sans-serif;box-sizing:border-box}" +
    "#hmBar[hidden]{display:none}#hmBar input{flex:1;min-width:80px;background:#1b1f27;color:#fff;border:1px solid #5a6474;border-radius:5px;padding:5px 8px;font:13px system-ui}" +
    "#hmBar button,.hmTab{background:#2b333d;color:#fff;border:1px solid #c9a24a;border-radius:5px;padding:4px 8px;font:600 12px system-ui;cursor:pointer;white-space:nowrap}" +
    "#hmBar .hmChips{display:flex;gap:4px;align-items:center;flex-wrap:nowrap;overflow:hidden}#hmBar .hmChips>*{position:static!important;transform:none!important;margin:0!important}" +
    "#hmBar.hm-desk #hmSayWrap{display:none}#hmSayWrap{display:flex;flex:1;gap:6px;align-items:center;min-width:0}" +
    ".hm-talk{display:flex!important;gap:8px;align-items:center;font-size:12px!important;padding:6px 26px 6px 6px!important}" +
    ".hm-talk .hmPort{flex:none;width:40px;height:40px;border-radius:50%;border:1px solid #c9a24a;background:#2a2f3a;color:#fff;font:700 15px system-ui;display:flex;align-items:center;justify-content:center;overflow:hidden}" +
    ".hm-talk .hmPort canvas{width:40px;height:40px}.hm-talk .hmBody{flex:1;min-width:0}";
  document.head.appendChild(css);
  const vis = e => { if(!e || !e.isConnected || e.hidden || e.classList.contains("hm-col")) return false; const cs = getComputedStyle(e); if(cs.display === "none" || cs.visibility === "hidden") return false; const r = e.getBoundingClientRect(); return r.width > 1 && r.height > 1; };
  const set = (e, k, v) => { if(e.style.getPropertyValue(k) !== v || e.style.getPropertyPriority(k) !== "important") e.style.setProperty(k, v, "important"); };
  const gG = () => { try{ return window.NEPTUNE && typeof NEPTUNE.debug === "function" ? NEPTUNE.debug().G : null; }catch(e){ return null; } };
  const inGame = () => { const g = gG(); return !!(g && g.you && g.room); };
  /* ----- bottom bar ----- */
  let bar = null, tabs = null, chips = null;
  function say(text){
    text = String(text || "").trim(); if(!text) return false;
    try{ const S = window.onumSession; if(S && typeof S.speak === "function" && (window.ONUM_SESSION ? window.ONUM_SESSION.open !== false : true) && document.getElementById("ndFd")){ S.speak(text); return true; } }catch(e){}
    try{ const wi = document.getElementById("wireIn"), ws = document.getElementById("wireSend"); if(wi && ws){ wi.value = text; ws.click(); return true; } }catch(e){}
    try{ if(typeof wireSend === "function"){ const wi = document.getElementById("wireIn"); if(wi) wi.value = text; wireSend(); return true; } }catch(e){}
    return false;
  }
  H.say = say;
  function cables(){ try{ if(typeof dmToggle === "function"){ dmToggle(true); return; } }catch(e){} try{ const b = document.getElementById("dmBadge"); if(b) b.click(); }catch(e){} }
  H.cables = cables;
  function mkBar(){
    if(bar && bar.isConnected) return;
    bar = document.createElement("div"); bar.id = "hmBar"; bar.className = "hm-p";
    bar.innerHTML = '<span id="hmSayWrap"><b style="white-space:nowrap">Say aloud</b><input id="hmSay" type="text" maxlength="400" autocomplete="off" placeholder="Speak to the room, or whoever is near (Enter)"><button type="button" id="hmSayGo">Say</button></span>' +
      '<button type="button" id="hmCab" title="Cables and messages">\u2709 Cables</button><span class="hmTabs"></span><span class="hmChips"></span>';
    document.body.appendChild(bar); tabs = bar.querySelector(".hmTabs"); chips = bar.querySelector(".hmChips");
    const inp = bar.querySelector("#hmSay");
    const go = () => { if(say(inp.value)){ inp.value = ""; } else { inp.placeholder = "Nobody can hear you here yet."; } };
    bar.querySelector("#hmSayGo").onclick = go; bar.querySelector("#hmCab").onclick = cables;
    const stop = e => { e.stopPropagation(); };
    inp.addEventListener("keydown", e => { e.stopPropagation(); if(e.key === "Enter"){ e.preventDefault(); go(); } else if(e.key === "Escape"){ inp.blur(); } });
    inp.addEventListener("keyup", stop); inp.addEventListener("keypress", stop);
  }
  /* Ctrl/Meta combos (copy, paste, select all, undo...) in any text field: let the browser have them, no game handler sees them. */
  const editable = t => t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
  window.addEventListener("keydown", e => { if((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey && e.key !== "Enter" && editable(e.target)) e.stopImmediatePropagation(); }, true);
  /* ----- collapse/reopen ----- */
  function addX(e, r){
    if(r.noX || e.querySelector(":scope>.hmX")) return;
    if(getComputedStyle(e).position === "static") set(e, "position", "fixed");
    const x = document.createElement("button"); x.type = "button"; x.className = "hmX"; x.textContent = "\u2013"; x.title = "Collapse " + r.n + " (reopen from the bar)";
    x.onclick = ev => { ev.stopPropagation(); collapse(e, r); };
    e.appendChild(x);
  }
  function collapse(e, r){ e.classList.add("hm-col"); const k = r.s; H.collapsed[k] = r.n; layout(); }
  H.collapse = sel => { const r = REG.find(q => q.s === sel); const e = r && document.querySelector(r.s); if(e) collapse(e, r); };
  H.reopen = sel => { document.querySelectorAll(sel).forEach(e => e.classList.remove("hm-col")); delete H.collapsed[sel]; layout(); };
  function drawTabs(){
    if(!tabs) return; const want = Object.keys(H.collapsed).filter(s => document.querySelector(s));
    const key = want.join("|"); if(tabs.dataset.k === key) return; tabs.dataset.k = key; tabs.innerHTML = "";
    want.forEach(s => { const b = document.createElement("button"); b.type = "button"; b.className = "hmTab"; b.textContent = "\u25B8 " + H.collapsed[s]; b.title = "Reopen"; b.onclick = () => H.reopen(s); tabs.appendChild(b); });
  }
  /* ----- compact talk rows with a portrait ----- */
  function talkify(e){
    if(e.querySelector(":scope>.hmPort")) return;
    const txt = (e.innerText || "").trim(); if(!txt) return;
    e.dataset.hmT = "1"; e.classList.add("hm-talk");
    const id = e.dataset.npc; let port = document.createElement("span"); port.className = "hmPort";
    try{ if(id != null && window.onumFamilyTree && typeof onumFamilyTree.portrait === "function"){ const c = onumFamilyTree.portrait(id, null, 80); if(c) port.appendChild(c); } }catch(x){}
    if(!port.firstChild){ const nm = e.dataset.name || txt.split(/\s+/).slice(0, 2).join(" "); port.textContent = nm.split(/\s+/).map(w => w[0] || "").join("").slice(0, 2).toUpperCase(); }
    const body = document.createElement("div"); body.className = "hmBody"; while(e.firstChild) body.appendChild(e.firstChild);
    e.appendChild(port); e.appendChild(body);
  }
  /* ----- layout ----- */
  function place(e, o){
    set(e, "position", "fixed"); set(e, "transform", "none"); set(e, "margin", "0"); set(e, "box-sizing", "border-box");
    set(e, "left", o.left == null ? "auto" : o.left + "px"); set(e, "right", o.right == null ? "auto" : o.right + "px");
    set(e, "top", o.top == null ? "auto" : o.top + "px"); set(e, "bottom", o.bottom == null ? "auto" : o.bottom + "px");
    if(o.w != null){ set(e, "width", o.w + "px"); set(e, "max-width", o.w + "px"); }
    if(o.mh != null){ set(e, "max-height", o.mh + "px"); set(e, "overflow", "auto"); }
    e.classList.add("hm-p");
  }
  function layout(){
    const W = innerWidth, Ht = innerHeight;
    const game = inGame();
    mkBar();
    bar.hidden = !game;
    const desk = document.getElementById("ndFd"); bar.classList.toggle("hm-desk", !!(desk && vis(desk)));
    /* chips into the bar */
    REG.filter(r => r.chip).forEach(r => { const e = document.querySelector(r.s); if(e && e.parentElement !== chips && game) chips.appendChild(e); });
    drawTabs();
    const colW = Math.max(160, Math.floor(W * 0.25) - PAD * 2), bandB = Math.max(Math.round(Ht * 0.2), 60);
    const barH = game && vis(bar) ? bar.getBoundingClientRect().height + 6 : 0;
    const bottomLimit = Ht - Math.max(bandB, barH + 4);
    const out = {L:[], R:[], T:[], B:[]};
    for(const r of REG){ if(r.chip) continue; document.querySelectorAll(r.s).forEach(e => { if(e.closest("#hmBar") || (e.id !== "sxDock" && e.closest("#sxDock")) || !vis(e)) return; const dk = (e.id === "sxDock" && desk && vis(desk) && e.contains(desk)) ? "B" : r.d; /* 20261030h: desk up = bottom band */ if(out[dk].some(x => x.e === e || x.e.contains(e))) return; out[dk].push({e, r}); }); }
    const stack = (list, side) => {
      let y = PAD;
      { const tb = document.getElementById("uiToolbar"); if(tb && vis(tb)) y = Math.max(y, Math.round(tb.getBoundingClientRect().bottom) + GAP); }   /* below the toolbar, never over it */
      for(const {e, r} of list){
        if(r.talk) talkify(e); addX(e, r);
        const room = bottomLimit - y; if(room < 28){ collapse(e, r); continue; }
        const o = {top:y, w:colW, mh:r.cap ? Math.min(room, r.cap) : room}; if(side === "L") o.left = PAD; else o.right = PAD;
        if(r.small){ o.w = null; set(e, "max-width", colW + "px"); }
        place(e, o); y += Math.min(e.getBoundingClientRect().height, room) + GAP;
      }
    };
    stack(out.L, "L"); stack(out.R, "R");
    /* top strip: between the columns, above the centre zone */
    let x = Math.floor(W * 0.25) + PAD; const tW = Math.floor(W * 0.5) - PAD * 2, tH = Math.floor(Ht * 0.2) - PAD;
    let ty = PAD;
    for(const {e, r} of out.T){ addX(e, r); place(e, {left:x, top:ty, w:tW, mh:Math.max(24, tH - ty)}); ty += e.getBoundingClientRect().height + GAP; }
    /* bottom band: the floor desk, merged with the bar (bar shows only Cables + tabs + chips while the desk is up) */
    for(const {e, r} of out.B){
      addX(e, r);
      /* 20261030h: full-width band sitting just above the Say aloud bar and any fixed strip along the bottom (the wire); max 20vh */
      let sTop = Ht; [bar, ...document.querySelectorAll("body > *")].forEach(s => { try{ if(!s || s === e || s.contains(e) || e.contains(s) || s.hidden) return; const cs = getComputedStyle(s); if(cs.display === "none" || cs.visibility === "hidden" || cs.position !== "fixed") return;
        const q = s.getBoundingClientRect(); if(q.height > 0 && q.height < 90 && q.width > W * 0.5 && q.top > Ht * 0.7) sTop = Math.min(sTop, q.top); }catch(x){} });
      place(e, {left:PAD, right:PAD, bottom:Math.max(6, Math.round(Ht - sTop + GAP)), mh:Math.max(150, Math.round(Ht * 0.24))});
      set(e, "width", "auto"); set(e, "max-width", "none"); set(e, "overflow", "hidden");
    }
    if(bar){ bar.style.removeProperty("left"); bar.style.removeProperty("right"); }
    H.last = {W, Ht, L:out.L.length, R:out.R.length, T:out.T.length, B:out.B.length};
  }
  H.layout = layout;
  /* overlap/centre check (QA hook) */
  H.check = function(){
    const W = innerWidth, Ht = innerHeight, cz = {l:W * .25, t:Ht * .2, r:W * .75, b:Ht * .8};
    const els = [];
    REG.forEach(r => document.querySelectorAll(r.s).forEach(e => { if(vis(e) && !e.closest("#hmBar") && !els.some(x => x.e === e)) els.push({e, n:r.s}); }));
    if(bar && vis(bar)) els.push({e:bar, n:"#hmBar"});
    const R = els.map(x => { const b = x.e.getBoundingClientRect(); return {n:x.n, l:b.left, t:b.top, r:b.right, b:b.bottom}; });
    const hit = (a, b) => a.l < b.r - 0.5 && b.l < a.r - 0.5 && a.t < b.b - 0.5 && b.t < a.b - 0.5;
    const overlaps = [], centre = [];
    for(let i = 0; i < R.length; i++){ if(hit(R[i], cz)) centre.push(R[i].n); for(let j = i + 1; j < R.length; j++) if(hit(R[i], R[j])) overlaps.push(R[i].n + " x " + R[j].n); }
    return {panels:R.map(r => r.n + "@" + [r.l, r.t, r.r, r.b].map(Math.round).join(",")), overlaps, centre, ok:!overlaps.length && !centre.length};
  };
  let q = 0; const kick = () => { if(q) return; q = requestAnimationFrame(() => { q = 0; try{ layout(); }catch(e){} }); };
  addEventListener("resize", kick);
  try{ new MutationObserver(kick).observe(document.body, {childList:true}); }catch(e){}
  try{ ["prompt", "hail", "procBar", "tipCard"].forEach(id => { const e = document.getElementById(id); if(e) new MutationObserver(kick).observe(e, {attributes:true, attributeFilter:["hidden", "class"]}); }); }catch(e){}
  setInterval(() => { try{ layout(); }catch(e){} }, 400);
  kick();
})();
</script>

<style id="uxBdCss">/* 20261104bd NEPTUNE: one primary surface. While a prompt or the toast is live, the remaining stacked panels fold too; prompt/desk buttons keep 44px x 120px steady targets */body:has(#prompt.is-live) .notices,body:has(#apToast) .notices,body:has(#prompt.is-live) #tipCard,body:has(#apToast) #tipCard,body:has(#prompt.is-live) .wire,body:has(#apToast) .wire,body:has(#prompt.is-live) #hmWire,body:has(#apToast) #hmWire{display:none!important}body:has(#prompt.is-live) #procBar,body:has(#apToast) #procBar,body:has(#prompt.is-live) .compass,body:has(#apToast) .compass{opacity:.3!important;pointer-events:none!important}body:has(#prompt.is-live) #apToast{opacity:.35;pointer-events:none}#ndFd .fd-hands button,#apToast button{min-width:120px!important}#ndFd .fd-log{overscroll-behavior:contain;scroll-behavior:auto}</style>
<script id="ndBdPaint">/* 20261104bd NEPTUNE: session (ss2) npc speeches reach the floor desk via cabPaint; dedupes against a line already painted */
(function(){ try{ if(typeof ss2NpcSpeak !== "function" || typeof cabPaint !== "function") return; const _sp = ss2NpcSpeak;
  ss2NpcSpeak = function(m){ let said = null; const _ev = window.onumSessionEvent; try{ window.onumSessionEvent = function(e){ try{ if(e && e.action === "speak") said = e.text; }catch(x){} return _ev.apply(this, arguments); }; return _sp.apply(this, arguments); }
    finally{ window.onumSessionEvent = _ev; try{ if(m && said){ const L = document.querySelector("#ndFd .fd-log"), d = L && L.lastElementChild, t = d && d.querySelector(".t"); if(!t || t.textContent !== String(said)) cabPaint(m, said); } }catch(x){} } };
}catch(e){} })();
</script>

<script id="uxBlJs">/* 20261104bl: continued effects (G.baDesk / pending G.followUps) surface IN the sitting (cabinet/council/floor) */
(function(){ function esc(s){ return String(s==null?"":s).replace(/[&<>"]/g,c=>({"&":"&"+"amp;","<":"&"+"lt;",">":"&"+"gt;",'"':"&"+"quot;"}[c])); }
 function items(){ try{ if(typeof G==="undefined"||!G.running) return []; const out=[], seen={};
   (G.baDesk||[]).filter(d=>d.day>=G.day-1).forEach(d=>{ if(seen[d.t]) return; seen[d.t]=1; out.push({t:d.t,d:d.d,who:d.whoId,s:"now"}); });
   (G.followUps||[]).filter(x=>!x.fired).forEach(x=>{ if(seen[x.title]) return; seen[x.title]=1; out.push({t:x.title,d:x.text,who:x.whoId,s:x.day<=G.day?"due":"in "+(x.day-G.day)+"d"}); });
   return out.slice(0,6); }catch(e){ return []; } }
 function paint(){ try{ const s=document.getElementById("ndSess"); if(!s||s.hidden) return; const body=s.querySelector(".ns-body")||s; const L=items();
   let box=s.querySelector(".nsx-fu"); if(!L.length){ if(box) box.remove(); return; }
   const key=L.map(x=>x.t+x.s).join("|"); if(box&&box._k===key) return;
   if(!box){ box=document.createElement("div"); box.className="nsx-fu"; const a=body.querySelector(".nsx-acts"); if(a) body.insertBefore(box,a); else body.appendChild(box); }
   box._k=key; box.innerHTML="<b>Consequences / follow-ups</b>"+L.map((x,i)=>'<button type="button" data-fu="'+i+'" title="'+esc(x.d)+'">'+esc(x.t)+' <i style="opacity:.7">· '+esc(x.s)+(x.who!=null&&typeof byId==="function"&&byId(x.who)?" · "+esc(byId(x.who).name):"")+'</i></button>').join("");
   box.onclick=function(ev){ const b=ev.target.closest("button[data-fu]"); if(!b) return; const x=L[+b.dataset.fu]; if(!x) return;
     try{ const m=x.who!=null&&typeof byId==="function"?byId(x.who):null;
       if(m&&typeof cabAsk==="function"&&typeof SSN!=="undefined"&&SSN){ cabAsk(m,true,"About "+x.t+": "+x.d,"fu"); return; }
       if(m&&typeof openTalk==="function"){ openTalk(m); return; }
       if(typeof setSay==="function") setSay(x.t+" — "+x.d, typeof fx==="function"?fx("",""):undefined); }catch(e){} };
 }catch(e){} }
 setInterval(paint,900); })();</script><style id="nlPromptFit">/* 20261104bm NEPTUNE prompt-fit: options never sit off-screen */
#prompt.is-live:not([hidden]){display:flex!important;flex-direction:column;box-sizing:border-box;max-height:calc(100vh - 96px)!important;max-height:min(calc(100dvh - 96px),calc(100% - 24px))!important;overflow:hidden}
#prompt.is-live>.prompt__h,#prompt.is-live>.prompt__catch-line{flex:none}
#prompt.is-live>.prompt__opts,#prompt.is-live>.prompt__catch-row{flex:1 1 auto;min-height:0;overflow-y:auto!important;overflow-x:hidden;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y;pointer-events:auto;scrollbar-width:thin}
#prompt.is-many .prompt__opts{gap:6px!important}
#prompt.is-many .prompt__btn{min-height:40px!important;min-width:0!important;flex:1 1 calc(50% - 6px);padding:7px 10px;font-size:13px}
#prompt.is-lots .prompt__btn{min-height:36px!important;padding:5px 8px;font-size:12px}
#apToast{max-height:calc(100vh - 140px);max-height:calc(100dvh - 140px);overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y}
#ndFd .fd-hands{max-height:30vh;max-height:30dvh;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#sxDock:not(.fd-on){max-height:calc(100dvh - 160px)}
#sxDock,#sxDock.fd-on>*,.talk.is-open>#tkActs{touch-action:pan-y;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
</style>
<script id="nlPromptFitJs">/* 20261104bm: tag dense prompts; let wheel/touch scroll the option list instead of the world */
(function(){function tag(){var p=document.getElementById("prompt");if(!p)return;var n=p.querySelectorAll(".prompt__btn").length;p.classList.toggle("is-many",n>4);p.classList.toggle("is-lots",n>8);}
function guard(el){if(!el||el._nlFit)return;el._nlFit=1;["wheel","touchmove"].forEach(function(t){el.addEventListener(t,function(e){e.stopPropagation();},{passive:true});});}
function boot(){var p=document.getElementById("prompt");if(!p)return;guard(p);tag();new MutationObserver(tag).observe(p,{childList:true,subtree:true});
new MutationObserver(function(){guard(document.getElementById("apToast"));}).observe(document.body,{childList:true});}
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);else boot();})();</script>
<style id="nnQolCss">/* 20261104bn NEPTUNE QoL: sticky hit targets, readable desk, one-surface, visible focus */
#sxDock button,#tkActs button,.talk.is-open>#tkActs button,#ndFd .fd-hands button{min-height:44px!important;min-width:44px!important;touch-action:manipulation}
#ndSess .nsx-fu button{min-height:40px!important;touch-action:manipulation;line-height:1.3}
#prompt.is-lots .prompt__btn{min-height:40px!important}
#ndFd .fd-log{max-height:38vh;max-height:38dvh;overflow-y:auto!important;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y;line-height:1.45;font-size:14px}
body:has(#prompt.is-live) #tipCard,body:has(#apToast) #tipCard,body:has(#prompt.is-live) #wire,body:has(#apToast) #wire{display:none!important}
#prompt .prompt__btn:focus-visible,#apToast button:focus-visible,#sxDock button:focus-visible,#tkActs button:focus-visible,#ndSess .nsx-fu button:focus-visible,#ndFd .fd-hands button:focus-visible,.fd-hands button:focus-visible{outline:3px solid #ffe08a!important;outline-offset:-3px;box-shadow:0 0 0 2px #0c0f13}
#prompt .prompt__btn,#tkActs button,#sxDock button,#apToast button,#apToast [role=button],#ndFd .fd-hands button,.fd-hands button{scroll-margin:8px}
</style>
<script id="nnQolJs">/* 20261104bn: scroll containers never take focus; focused options scroll into view; sitting heckles land on the desk as asides */
(function(){function fix(){var p=document.getElementById("prompt");if(!p)return;p.querySelectorAll(".prompt__opts,.prompt__catch-row").forEach(function(c){if(c.getAttribute("tabindex")!=="-1")c.setAttribute("tabindex","-1");});}
function boot(){var p=document.getElementById("prompt");if(p){fix();new MutationObserver(fix).observe(p,{childList:true});}
document.addEventListener("focusin",function(e){var t=e.target;if(!t||!t.closest)return;if(t.closest("#prompt .prompt__opts,#prompt .prompt__catch-row,#apToast,#tkActs,#sxDock,#ndFd .fd-hands")){try{t.scrollIntoView({block:"nearest",inline:"nearest"});}catch(x){}}},true);}
window.addEventListener("onum-session",function(ev){try{var d=ev.detail;if(!d||d.stage!=="interjection"||!d.interjection)return;var I=d.interjection;if(!I.text||I.by==="you"||typeof byId!=="function"||typeof cabPaint!=="function")return;var m=byId(I.by);if(!m)return;if(I.kind==="point_of_order"){cabPaint(m,/^point of order/i.test(I.text)?I.text:"Point of order: "+I.text,true);return;}cabPaint(m,I.text,true);}catch(x){}});
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);else boot();})();</script>
<style id="fixScreenCss">
#prompt.is-live{position:fixed!important;left:8px!important;right:8px!important;bottom:max(72px,env(safe-area-inset-bottom))!important;transform:none!important;width:auto!important;max-width:none!important;z-index:10045!important;max-height:min(62dvh,560px)!important;pointer-events:auto!important}
#prompt.is-live .prompt__opts,#prompt.is-live .prompt__catch-row{pointer-events:auto}
#voteDock{display:none!important}
.onum-x{position:absolute;top:4px;right:4px;z-index:6;min-height:32px;padding:2px 8px;border-radius:6px;border:1px solid #6b5a32;background:#121419;color:#ffe08a;font:700 11px system-ui,sans-serif;cursor:pointer;touch-action:manipulation}
#prompt.is-live{padding-top:28px!important}
#card{position:relative}
#sxDock{top:56px!important;bottom:8px!important;max-height:none!important;left:8px!important;right:8px!important;width:auto!important}
@media (min-width:720px){#sxDock{left:auto!important;width:min(460px,42vw)!important}}
#sxDock .fd-acts,#sxDock .fd-vote,#sxDock .fd-hands,#sxDock .card__actions{position:sticky;bottom:0;background:#121419;z-index:4;padding:6px 0}
#ndFd .fd-vote{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:6px 0}
#ndFd .fd-vote b{flex:1 1 100%;color:#ffe08a;font:700 11px system-ui;letter-spacing:.06em;text-transform:uppercase}
#ndFd .fd-vote button{min-height:44px;flex:1 1 88px;border-radius:10px;border:0;background:#2a2d35;color:#fff;font:700 13px system-ui;cursor:pointer;touch-action:manipulation}
#ndFd .fd-vote button.is-on{background:#c9a24a;color:#14120c}
#veil:not(.sitx) #card{max-height:min(92dvh,920px);overflow:auto}
#veil .card__actions{position:sticky;bottom:0;background:var(--paper,#f6f1e6);z-index:3;padding-top:8px}
.talk.is-open{max-height:min(86dvh,100%);overflow:auto}
.talk.is-open #tkActs{max-height:min(48dvh,420px);overflow:auto;touch-action:pan-y}
</style>
<style id="boLookCss">/* 20261104bo NEPTUNE look punch (bq: glow on real panels #pcScreen desk computer + aside.dossier desk panes; dropped dead office/pzOffice ids and HUD btn hmCab; scoped fd-hands): window-glow on office/desk/chamber panels, soft placards, louder gold focus ring (folds MARS LIVE soft notes from bn) */
#pcScreen,aside.dossier,#ndFd,#ndSess,#sxDock{box-shadow:0 0 0 1px rgba(201,162,74,.35),0 0 22px 2px rgba(255,214,140,.16),inset 0 0 26px rgba(255,224,160,.07),inset 0 1px 0 rgba(255,236,190,.18)!important}
#sxDock>#ndFd,#sxDock>#ndSess{box-shadow:inset 0 0 22px rgba(255,224,160,.06)!important}
#pcScreen .note,#pcScreen .notes,aside.dossier .note,aside.dossier .notes,#ndFd .fd-cue,#ndFd .fd-top,#ndFd .fd-l.aside{letter-spacing:.02em;line-height:1.45;color:#e9dfc4}
#pcScreen .note b,aside.dossier .note b,#ndFd .fd-cue b,#ndFd .fd-top b{color:#e7c87a;letter-spacing:.04em}
#prompt .prompt__btn:focus-visible,#apToast button:focus-visible,#sxDock button:focus-visible,#tkActs button:focus-visible,#ndSess .nsx-fu button:focus-visible,#ndFd .fd-hands button:focus-visible{outline:3px solid #ffe08a!important;outline-offset:2px!important;box-shadow:0 0 0 2px #0c0f13,0 0 0 5px #c9a24a,0 0 14px 4px rgba(255,224,138,.55)!important;position:relative;z-index:1}
#prompt.is-live .prompt__btn:focus-visible,#apToast button:focus-visible{background-color:rgba(255,224,138,.16)!important;color:#fff8e6!important}
</style>
<style id="brEasyCss">/* 20261110br NEPTUNE easy UI (presentation only; off with localStorage onum.easyUi="0"): common-game conventions - one bottom choice bar, big plain verbs, primary first / Back last, color roles gold=primary red=danger slate=neutral, numbered 1-9 badges, one dialogue box with name tag + next cue, short lines with ...more, always-on controls hint */
html.br-easy #prompt.is-live:not(.is-many) .prompt__btn{font-size:14px!important;padding:9px 14px}
html.br-easy #prompt.is-live .prompt__btn{white-space:normal;overflow-wrap:anywhere;line-height:1.3}
html.br-easy #prompt.is-live .prompt__h{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;font-size:14px;line-height:1.4}
html.br-easy #prompt.is-live:hover .prompt__h,html.br-easy #prompt.is-live:focus-within .prompt__h{-webkit-line-clamp:8}
html.br-easy .br-pri{border-color:#c9a24a!important;background-color:rgba(201,162,74,.24)!important;color:#fff8e6!important}
html.br-easy .br-dng{border-color:#d05a4e!important;color:#ffb4aa!important}
html.br-easy .br-back{border-color:#4a5563!important;background-color:#2b333d!important;color:#c9d1dc!important;font-weight:500!important}
html.br-easy #apToast button{min-width:96px;font-weight:700;font-size:14px!important;padding:8px 14px!important}
html.br-easy [data-btn]::after,html.br-easy [data-brn]::after{width:18px!important;height:18px!important;line-height:18px!important;font-size:11px!important;top:-8px!important;right:-8px!important;background:#ffe08a!important;color:#111!important;border:1px solid #0c0f13!important;box-shadow:0 1px 3px rgba(0,0,0,.6)}
html.br-easy [data-brn]{position:relative}
html.br-easy [data-brn]::after{content:attr(data-brn);position:absolute;text-align:center;border-radius:50%;font-family:"JetBrains Mono",monospace;font-weight:700;pointer-events:none}
html.br-easy #tkName{display:inline-block;background:#c9a24a;color:#111;font:700 15px Georgia,serif;letter-spacing:.02em;padding:3px 12px;border-radius:6px 6px 6px 0;box-shadow:0 2px 0 #7a5f22}
html.br-easy #talk.is-open #tkSay.br-long:not(.br-open){display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:4;overflow:hidden;max-height:none}
html.br-easy #brSayRow{display:none;align-items:center;justify-content:flex-end;gap:10px;margin:-2px 0 6px;max-width:72ch;font:12px system-ui,sans-serif;color:#c9d1dc}
html.br-easy #talk.is-open #brSayRow{display:flex}
#brSayRow .br-mo{background:none;border:0;color:#e7c87a;font:700 12px system-ui,sans-serif;cursor:pointer;padding:2px 4px;min-height:0!important;min-width:0!important}
#brSayRow .br-mo[hidden]{display:none}
#brSayRow .br-nx{color:#ffe08a;font-size:14px;animation:brNx 1.1s ease-in-out infinite}
@keyframes brNx{0%,100%{transform:translateY(0);opacity:1}50%{transform:translateY(3px);opacity:.45}}
@media (prefers-reduced-motion:reduce){#brSayRow .br-nx{animation:none}}
html.br-easy #ndFd .fd-l>b{display:inline-block;background:rgba(201,162,74,.16);border-radius:4px;padding:0 5px;margin-right:2px}
html.br-easy #ndFd .fd-l.br-has:not(.br-open)>.t{display:none}
html.br-easy #ndFd .fd-l.br-has.br-open>.br-v{display:none}
#ndFd .fd-l>.br-v{display:none}
html.br-easy #ndFd .fd-l.br-has>.br-v{display:inline}
#ndFd .fd-l .br-mo{color:#e7c87a;font-weight:700;font-style:normal;margin-left:4px;white-space:nowrap}
#brHint{position:fixed;left:10px;bottom:28px;z-index:10045;max-width:min(560px,calc(100vw - 20px));pointer-events:none;background:rgba(12,15,19,.82);color:#c9d1dc;border:1px solid #4a5563;border-radius:8px;padding:4px 10px;font:12px/1.5 system-ui,sans-serif;letter-spacing:.01em}
#brHint kbd{display:inline-block;min-width:16px;text-align:center;background:#2b333d;color:#ffe08a;border:1px solid #4a5563;border-bottom-width:2px;border-radius:4px;padding:0 4px;margin:0 2px;font:700 11px "JetBrains Mono",monospace}
#brHint[hidden],html:not(.br-easy) #brHint,html:not(.br-easy) #brSayRow{display:none!important}
/* 20261110bt: hint sits above #ndFd (10040), below #ndAuditBtn (10049) / modals (10050) / #clPanel + #tipCard (100000+); hidden while pause or a modal is up; placement is clamped inside the viewport and away from option buttons */
</style>
<script id="brEasyJs">/* 20261110br NEPTUNE easy UI (20261110bt: clean on/off teardown, inert-toast Esc, hint clamp + z-order, code-point-safe cut, stage-direction-only plain): presentation layer only. Never rewrites game/engine text: #tkSay and .fd-l .t keep their exact text (other code reads them); simplified copies sit beside them. 1-9 picks docked choices only when no existing handler took the key. Esc = the visible Back/Walk away. Disable: onumEasyUi.off() (live, full teardown) or localStorage.setItem("onum.easyUi","0") then reload. */
(function(){
  var R = document.documentElement, running = false, iv = 0, q = 0, obs = [], moved = [];
  var BACK = /^(back|cancel|close|leave( it)?|walk (out|away)|not now|never ?mind|no,? thanks|later|skip|dismiss|step away)$/i;
  var DANGER = /\b(veto|reject|refuse|resign|impeach|fire|sack|attack|declare war|strike|arrest|expel|censure|vote no|nay|against)\b/i;
  function lab(b){ var raw = b.textContent || ""; if(b._brRaw === raw) return b._brL; var t = ""; try{ var c = b.cloneNode(true); c.querySelectorAll("u").forEach(function(u){ u.remove(); }); t = c.textContent; }catch(x){ t = b.textContent || ""; } t = String(t).replace(/\s+/g, " ").trim(); b._brRaw = raw; b._brL = t; return t; }
  function vis(b){ return !!(b && !b.disabled && !b.hidden && (b.offsetParent || b.getClientRects().length)); }
  function typing(){ var a = document.activeElement; if(!a) return false; var tg = (a.tagName || "").toLowerCase(); return tg === "input" || tg === "textarea" || tg === "select" || !!a.isContentEditable; }
  function setTitle(el, v){ if(el._brT0 === undefined) el._brT0 = el.getAttribute("title"); if(el.getAttribute("title") !== v) el.setAttribute("title", v); }
  function unTitle(el){ if(el._brT0 === undefined) return; if(el._brT0 === null) el.removeAttribute("title"); else el.setAttribute("title", el._brT0); el._brT0 = undefined; }
  /* roles + order: primary first, Back/Walk out last (prompt + talk acts only; data-gp keeps clicks correct). Every move is journaled so off() can put the game's own order back. */
  function roles(box, reorder, noPri){ if(!box) return; var bs = [].slice.call(box.querySelectorAll("button")); var back = [], pri = null;
    bs.forEach(function(b){ var t = lab(b), isB = BACK.test(t) || b.classList.contains("talk__btn--exit") || b.id === "sitOut" || b.dataset.ap === "away";
      if(b.classList.contains("br-back") !== isB) b.classList.toggle("br-back", isB);
      var isD = !isB && (DANGER.test(t) || b.classList.contains("talk__btn--risk")); if(b.classList.contains("br-dng") !== isD) b.classList.toggle("br-dng", isD);
      if(t.length > 60 && b.title !== t) setTitle(b, t);
      if(isB) back.push(b); else if(!pri && !isD && !b.disabled) pri = b; });
    if(!noPri) bs.forEach(function(b){ var p = b === pri; if(b.classList.contains("br-pri") !== p) b.classList.toggle("br-pri", p); });
    if(reorder && back.length){ var host = box.closest ? box.closest("#prompt,#talk") : null; if(host && host._down){ /* a finger is on a button — do not move it */ } else { var par = back[0].parentNode, mv = false; back.forEach(function(b){ if(b.parentNode === par && par.lastElementChild !== b){ var after = b.nextElementSibling; var allBackAfter = true; while(after){ if(!after.classList.contains("br-back")){ allBackAfter = false; break; } after = after.nextElementSibling; } if(!allBackAfter){ moved = moved.filter(function(m){ return m.b.isConnected; }); moved.push({ b:b, par:par, next:b.nextSibling }); par.appendChild(b); mv = true; } } });
      if(mv){ try{ if(typeof markPicks === "function") markPicks(); }catch(x){} } } } }
  /* numbered dock choices when the game's own 1-9 badges are not up */
  var DOCK = ["#apToast", "#ndFd", "#sxDock"];
  function dockNums(){ var own = [].slice.call(document.querySelectorAll("[data-btn]")).some(vis), want = [];
    var pr = document.getElementById("prompt"), live = pr && !pr.hidden && pr.classList.contains("is-live");
    if(!own && !live){ for(var i = 0; i < DOCK.length; i++){ var c = document.querySelector(DOCK[i]); if(!c || c.hidden || !vis(c)) continue;
      var bs = [].slice.call(c.querySelectorAll("button")).filter(function(b){ return vis(b) && !b.classList.contains("fd-min") && !b.classList.contains("fd-send") && !b.classList.contains("fd-cancel") && !b.closest("#sxDockHead") && b.id !== "sitOut" && !b.classList.contains("br-mo") && /[A-Za-z0-9]/.test(lab(b)); });
      var main = bs.filter(function(b){ return !b.classList.contains("br-back"); }), bk = bs.filter(function(b){ return b.classList.contains("br-back"); });
      want = main.concat(bk).slice(0, 9); if(want.length) break; } }
    document.querySelectorAll("[data-brn]").forEach(function(b){ if(want.indexOf(b) < 0) b.removeAttribute("data-brn"); });
    want.forEach(function(b, n){ var v = String(n + 1); if(b.getAttribute("data-brn") !== v) b.setAttribute("data-brn", v); }); return want; }
  /* plain-language view of a desk line: only genuine stage directions come out (sighs / pauses / leans in ...); labels like "Option (1)", "(3) The motion", "[sic]", "[the Speaker]" stay. Full text stays in .t / the log */
  var STAGE_V = /^(sigh|pause|lean|smile|smil|smirk|nod|nodd|laugh|chuckle|chuckl|frown|shrug|shrugg|cough|clear|whisper|mutter|murmur|grin|grinn|glance|glanc|look|stare|star|wince|winc|scoff|snort|sniff|sniffle|sniffl|blink|wave|wav|gesture|gestur|tap|tapp|drum|fold|rub|rubb|hesitate|hesitat|beat|aside|exhale|exhal|inhale|inhal|breathe|breath|swallow|adjust|straighten|squint|yawn|groan|grumble|grumbl|hum|humm|clap|clapp|gavel|applause|laughter|silence|crosstalk|inaudible|gasp|teary|tearful|quietly|softly|dryly|coldly|flatly|grimly|wryly|sharply|slowly|firmly|calmly|angrily|sadly|nervously|reluctantly|sarcastically|ironically|bluntly|wearily|warily|thoughtfully)(s|es|ed|d|ing)?$/;
  var STAGE_NO = /^(sic|sics|ibid|emphasis|citation|cite|note|see|cf|etc|redacted|inaudible text)$/;
  function stage(inner){ var w = String(inner || "").trim(); if(!w || w.length > 60) return false; if(/[0-9A-Z]/.test(w)) return false; if(!/^[a-z][a-z' ,\-\u2019.]*$/.test(w)) return false; if(STAGE_NO.test(w.replace(/[.,]+$/, ""))) return false;
    var ws = w.split(/\s+/); if(ws.length > 6) return false; var f = ws[0].replace(/[^a-z]/g, ""); return STAGE_V.test(f); }
  function plain(s){ var o = String(s || ""), t = o;
    t = t.replace(/(^|[^*])\*([^*\n]{1,90})\*(?!\*)/g, function(m, p, w){ return /[0-9]/.test(w) || /\b(option|motion|bill|amendment|section|article|vote|item)\b/i.test(w) ? m : p + " "; });
    t = t.replace(/\[(?!\[)([^\]\n]{1,90})\]/g, function(m, w){ return stage(w) ? " " : m; });
    t = t.replace(/\(([^()\n]{1,90})\)/g, function(m, w){ return stage(w) ? " " : m; });
    t = t.replace(/\s+([,.;:!?])/g, "$1").replace(/\s+/g, " ").trim(); t = t.replace(/^[,;:]\s*/, "");
    if(!t || !/[A-Za-z0-9]/.test(t)) t = o.trim(); return t; }
  /* code-point / grapheme safe: never splits a surrogate pair or a ZWJ emoji at the cut */
  function units(t){ try{ if(typeof Intl !== "undefined" && Intl.Segmenter){ var out = []; var it = new Intl.Segmenter(undefined, { granularity:"grapheme" }).segment(t); for(var g of it) out.push(g.segment); return out; } }catch(x){} return Array.from(t); }
  function clen(t){ var n = 0; for(var c of String(t)) n++; return n; }
  function cut(t){ t = String(t || ""); if(clen(t) <= 140) return { s:t, more:false }; var u = units(t); if(u.length <= 140) return { s:t, more:false };
    var head = u.slice(0, 141).join(""), m = head.match(/^[\s\S]{40,}?[.!?](?=\s|$)/), s; if(m && units(m[0]).length <= 140) s = m[0]; else s = u.slice(0, 140).join("").replace(/\s+\S*$/, "") + "\u2026"; return { s:s, more:true }; }
  function deskLines(){ var L = document.querySelector("#ndFd .fd-log"); if(!L) return; [].forEach.call(L.children, function(d){ if(!d.classList.contains("fd-l") || d._brDone) return; var t = d.querySelector(".t"); if(!t || d._full == null) return; if(t.textContent !== String(d._full)) return;
      d._brDone = String(d._full); var p = plain(d._full), c = cut(p); if(!c.more && p === String(d._full).trim()) return;
      var v = d.querySelector(".br-v"); if(!v){ v = document.createElement("span"); v.className = "br-v"; d.appendChild(v); }
      v.textContent = c.s; if(c.more || p !== String(d._full).trim()){ var mo = document.createElement("span"); mo.className = "br-mo"; mo.textContent = /\u2026$/.test(c.s) ? "more" : "\u2026more"; v.appendChild(mo); }
      setTitle(d, "Click for the full line"); d.classList.add("br-has"); }); }
  function onClick(e){ var t = e.target; if(!running || !t || !t.closest) return; var d = t.closest("#ndFd .fd-l.br-has"); if(d) d.classList.toggle("br-open"); }
  /* dialogue box: name tag, clamp long lines with ...more, visible next cue (text in #tkSay is never touched) */
  function talkBox(){ var s = document.getElementById("tkSay"); if(!s) return; var row = document.getElementById("brSayRow");
    if(!row){ row = document.createElement("div"); row.id = "brSayRow"; row.innerHTML = '<button type="button" class="br-mo tk-nonum" hidden>\u2026more</button><span class="br-nx" aria-hidden="true">\u25B6</span>'; s.parentNode.insertBefore(row, s.nextSibling);
      row.querySelector(".br-mo").addEventListener("click", function(e){ try{ e.stopPropagation(); }catch(x){} var o = s.classList.toggle("br-open"); this.textContent = o ? "less" : "\u2026more"; }); }
    var long = clen(s.textContent || "") > 140; if(s.classList.contains("br-long") !== long){ s.classList.toggle("br-long", long); if(!long) s.classList.remove("br-open"); var mo = row.querySelector(".br-mo"); mo.hidden = !long; mo.textContent = s.classList.contains("br-open") ? "less" : "\u2026more"; } }
  /* always-visible controls hint (one line, context aware) */
  function K(k){ return "<kbd>" + k + "</kbd>"; }
  var hintKey = "";
  var MODAL = ["#ndStyle", "#ndFam", "#ndPb", "#ndAudit", "#clPanel"];
  function modalUp(){ var po = document.getElementById("pauseOverlay"); if(po && po.classList.contains("is-open")) return true; for(var i = 0; i < MODAL.length; i++){ var m = document.querySelector(MODAL[i]); if(m && !m.hidden && vis(m)) return true; } return false; }
  function hint(){ var H = document.getElementById("brHint"); if(!H){ H = document.createElement("div"); H.id = "brHint"; H.setAttribute("aria-hidden", "true"); document.body.appendChild(H); }
    var pr = document.getElementById("prompt"), live = pr && !pr.hidden && pr.classList.contains("is-live"), tk = document.getElementById("talk"), talk = tk && tk.classList.contains("is-open"),
      ap = document.getElementById("apToast"), fd = document.getElementById("ndFd"), desk = fd && !fd.hidden, vl = document.getElementById("veil"), card = vl && !vl.hidden && !vl.classList.contains("sitx"), nums = !!document.querySelector("[data-btn],[data-brn]"), k;
    if(typing()) k = "type"; else if(card) k = "card"; else if(live) k = "live"; else if(apLive(ap)) k = "ap"; else if(talk) k = "talk"; else if(desk) k = "desk"; else k = "walk"; k += nums ? "+n" : "";
    if(k === hintKey) return; hintKey = k; var n = nums ? K("1") + "\u2013" + K("9") + " choose \u00B7 " : "", h;
    switch(k.replace("+n", "")){
      case "type": h = K("Enter") + " send \u00B7 " + K("Esc") + " stop typing"; break;
      case "card": h = n + "click to pick \u00B7 " + K("Esc") + " close"; break;
      case "live": h = n + K("E") + " first choice \u00B7 click to pick \u00B7 " + K("Esc") + " back"; break;
      case "ap": h = n + K("Esc") + " walk away"; break;
      case "talk": h = n + K("Enter") + "/" + K("Space") + " pick the highlighted choice \u00B7 type to say your own \u00B7 " + K("Esc") + " leave"; break;
      case "desk": h = n + K("Space") + " finish line \u00B7 click a line for more \u00B7 " + K("Esc") + " back"; break;
      default: h = K("W") + K("A") + K("S") + K("D") + " move \u00B7 " + K("E") + " interact \u00B7 click to pick \u00B7 " + K("Esc") + " menu"; }
    H.innerHTML = h; }
  /* keep the hint fully on screen and off every option button: bottom-left lifted over the docks if it fits, else top-left / top-right / bottom-right; hidden if no clear spot or a modal/pause is up */
  var PANELS = ["#sxDock", "#ndFd", "#talk.is-open", "#prompt.is-live", "#apToast", "#hmBar"], BTNBOX = "#prompt.is-live button,#apToast button,#ndFd button,#sxDock button,#tkActs button,#talk.is-open button,#hmBar button,#veil:not([hidden]) button";
  function rects(list){ var out = []; list.forEach(function(e){ if(!e || e.hidden || !vis(e)) return; var r = e.getBoundingClientRect(); if(r.width >= 2 && r.height >= 2) out.push(r); }); return out; }
  function hit(a, rs, pad){ for(var i = 0; i < rs.length; i++){ var r = rs[i]; if(a.l < r.right + pad && a.r > r.left - pad && a.t < r.bottom + pad && a.b > r.top - pad) return true; } return false; }
  function hintPlace(){ var H = document.getElementById("brHint"); if(!H) return; if(modalUp()){ if(!H.hidden) H.hidden = true; return; }
    var vw = window.innerWidth || R.clientWidth || 0, vh = window.innerHeight || R.clientHeight || 0, M = 8; if(H.hidden) H.hidden = false;
    var w = H.offsetWidth, h = H.offsetHeight; if(!w || !h || !vw || !vh) return;
    var panels = rects(PANELS.map(function(q){ return document.querySelector(q); })), btns = rects([].slice.call(document.querySelectorAll(BTNBOX)));
    var lift = 28; panels.forEach(function(r){ if(r.left > 10 + w || r.right < 10) return; if(r.bottom >= vh - 120 && r.top < vh - lift) lift = Math.max(lift, Math.round(vh - r.top + 6)); });
    var C = [{ k:"bl", l:10, t:vh - lift - h }, { k:"tl", l:10, t:M + 2 }, { k:"tr", l:vw - w - 10, t:M + 2 }, { k:"br", l:vw - w - 10, t:vh - 28 - h }], pick = null;
    C.forEach(function(c){ c.r = c.l + w; c.b = c.t + h; c.ok = c.l >= 0 && c.t >= M && c.r <= vw && c.b <= vh - M; });
    for(var pass = 0; pass < 2 && !pick; pass++) for(var i = 0; i < C.length; i++){ var c = C[i]; if(!c.ok || hit(c, btns, 4)) continue; if(pass === 0 && hit(c, panels, 2)) continue; pick = c; break; }
    if(!pick){ if(!H.hidden) H.hidden = true; return; }
    var st = { left:pick.l + "px", top:pick.t + "px", right:"auto", bottom:"auto" }; for(var p in st) if(H.style[p] !== st[p]) H.style[p] = st[p]; if(H.dataset.pos !== pick.k) H.dataset.pos = pick.k; }
  function tick(){ if(!running) return; try{ var pr = document.getElementById("prompt"); if(pr) roles(pr.querySelector(".prompt__opts"), true); roles(document.getElementById("tkActs"), true); roles(document.getElementById("apToast"), false); roles(document.getElementById("sxDock") || document.getElementById("ndFd"), false, true); var fd = document.getElementById("ndFd"); if(fd && !fd.closest("#sxDock")) roles(fd, false, true); }catch(x){}
    try{ dockNums(); }catch(x){} try{ deskLines(); }catch(x){} try{ talkBox(); }catch(x){} try{ hint(); hintPlace(); }catch(x){} }
  function soon(){ if(q || !running) return; q = setTimeout(function(){ q = 0; tick(); }, 60); }
  /* Esc target: the toast only when it is really clickable (not dimmed / pointer-events:none / under a live prompt / covered) */
  function apLive(ap){ if(!ap || !vis(ap)) return false; var pr = document.getElementById("prompt"); if(pr && !pr.hidden && pr.classList.contains("is-live")) return false;
    try{ var cs = getComputedStyle(ap); if(cs.pointerEvents === "none" || cs.visibility === "hidden" || parseFloat(cs.opacity) < 0.5) return false; }catch(x){}
    var b = [].slice.call(ap.querySelectorAll("button.br-back,button[data-ap]")).filter(vis)[0]; if(b){ try{ var r = b.getBoundingClientRect(), el = document.elementFromPoint(r.left + r.width / 2, r.top + r.height / 2); if(el && !ap.contains(el)) return false; }catch(x){} } return true; }
  function onNum(e){ try{ if(!running || !R.classList.contains("br-easy") || e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey || e.repeat || typing()) return; var k = e.key || ""; if(k.length !== 1 || k < "1" || k > "9") return;
      var b = [].slice.call(document.querySelectorAll('[data-brn="' + k + '"]')).filter(vis)[0]; if(!b) return; e.preventDefault(); b.click(); soon(); }catch(x){} }
  function onEsc(e){ try{ if(!running || e.key !== "Escape" || !R.classList.contains("br-easy") || e.defaultPrevented || e._pzHandled || typing()) return; var tk = document.getElementById("talk"); if(tk && tk.classList.contains("is-open")) return; var po = document.getElementById("pauseOverlay"); if(po && po.classList.contains("is-open")) return;
      var vl = document.getElementById("veil"); if(vl && !vl.hidden && !vl.classList.contains("sitx")) return; var a = document.activeElement, box = null, ap = document.getElementById("apToast"), pr = document.getElementById("prompt"), soft = false;
      if(apLive(ap)) box = ap; else if(pr && !pr.hidden && pr.classList.contains("is-live")){ box = pr; soft = true; } else if(a && a.closest) box = a.closest("#prompt,#ndFd,#sxDock"); if(!box) return;
      var pick = function(c){ return c ? [].slice.call(c.querySelectorAll("button.br-back")).filter(function(x){ return vis(x) && !x.classList.contains("fd-cancel"); })[0] : null; };
      var b = pick(box) || (box.closest && box.closest("#sxDock") ? pick(box.closest("#sxDock")) : null); if(!b) return; e.preventDefault(); if(!soft) e.stopImmediatePropagation(); b.click(); soon(); }catch(x){} }
  function start(){ if(running) return; running = true; R.classList.add("br-easy"); hintKey = "";
