function onumPatchAmen2(){
  try{
    Object.keys(PROPS || {}).forEach(room => {
      (PROPS[room] || []).forEach(p => {
        if(!p || p._soc2) return;
        if(p.id !== "amenDesk" && p.id !== "ksdesk" && p.id !== "kbench" && p.id !== "kgdesk" && p.id !== "kxdesk") return;
        p._soc2 = 1;
        const a0 = p.acts;
        p.acts = function(){
          let A = [];
          try{ A = (typeof a0 === "function" ? a0() : (a0 || [])) || []; }catch(e){}
          try{
            if(kHolds(room)) onumLifeActs().forEach(a => { if(!A.some(x => x && x.t === a.t)) A.push(a); });
          }catch(e){}
          return A;
        };
      });
    });
  }catch(e){}
}

function onumOpp(){
  const y = G.you; if(!y) return;
  const opp = y.party === "FED" ? "COM" : "FED";
  const mine = (G.members || []).filter(m => m && !m.gone && m.kind === "member" && m.party === opp).slice(0, 5);
  const rows = mine.map((m, i) => {
    const say = onumMemberMouth(m) + " I am not in your caucus, and I did not come here to be managed.";
    return '<div style="margin:8px 0;padding:8px 10px;border-left:3px solid var(--line-soft)"><b>' + onumEsc(m.name) + '</b> <span class="muted">· ' + onumEsc(partyName(m.party)) + ' · ' + onumEsc(m.state || "") + '</span><p>“' + onumEsc(say) + '”</p><div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" data-op="' + i + ':hear">Hear them out</button><button type="button" class="btn btn--ghost" data-op="' + i + ':deal">Offer a narrow deal</button><button type="button" class="btn btn--ghost" data-op="' + i + ':hard">Draw the line</button></div><div class="dream" id="op_' + i + '"></div></div>';
  }).join("");
  govCardOpen("The other party", partyName(opp), "They keep their own towns, creeds, and votes. A deal is a sentence both of you can say at home.", rows || "<p>The other party is not in the building.</p>", null);
  card.querySelectorAll("[data-op]").forEach(b => b.addEventListener("click", () => {
    const parts = b.getAttribute("data-op").split(":"); const m = mine[+parts[0]]; if(!m) return;
    const box = el("op_" + parts[0]);
    try{ spend(12, 2); }catch(e){}
    if(parts[1] === "hear"){
      onumTouch(m, 2, "colleague");
      box.textContent = m.name + ": “Then listen. My town is not your footnote. If the paper helps them, I can be in the room. If it only helps you, I will say so on the floor.”";
    } else if(parts[1] === "deal"){
      if((y.influence || 0) < 4){ box.textContent = "A deal costs influence you do not have."; return; }
      y.influence -= 4;
      onumTouch(m, 5, "colleague");
      y.standing = clamp(y.standing + 1, 0, 100);
      box.textContent = m.name + ": “A narrow deal. I will say what I agreed to, in my words, and nothing past it.”";
      try{ onumWebPush(m.name, "personal", "I took a narrow deal across the aisle. Here is the edge of it, so nobody invents the rest."); }catch(e){}
    } else {
      onumTouch(m, -4, "estranged");
      y.standing = clamp(y.standing + 1, 0, 100);
      box.textContent = m.name + ": “Then we are opponents, plainly. I prefer that to a friendship that was a tactic.”";
      try{ onumWebPush(m.name, "personal", "No deal. I will oppose this in my own sentences, and my people can judge the sentences."); }catch(e){}
    }
  }));
}

{ const _sa = onumSocActs; onumSocActs = function(m){
  const A = _sa.apply(this, arguments) || [];
  if(!m || m === G.you || m.machine) return A;
  A.splice(Math.max(0, A.length - 1), 0, {t:"The people who sent them", c:"15m", run(){
    try{ spend(15, 2); }catch(e){}
    let town = m.state || "home", trouble = "the ordinary hard week", pride = "what they still have";
    try{ const b = bioOf(m); if(b){ town = b.town || town; trouble = b.trouble || trouble; pride = b.pride || pride; } }catch(e){}
    onumTouch(m, 2, null);
    setSay("I was sent from " + town + ". This week it is " + trouble + ". What they still have is " + pride + ". If you want a vote, start there. If you want me, start there too. I will not be a warmer copy of the whip.", "");
  }});
  const w = (m.rel && m.rel.warmth) || 0;
  if(w < -4) A.splice(Math.max(0, A.length - 1), 0, {t:"Mend it, without a speech", c:"20m", run(){
    try{ spend(20, 3); }catch(e){}
    onumTouch(m, 6, "colleague");
    setSay(onumOwn(m) + " I will take the mend. I will not pretend the thing did not happen. We start from colleagues, not from a clean page.", "");
  }});
  if(m.kind === "member" && (G.you.influence || 0) >= 4) A.splice(Math.max(0, A.length - 1), 0, {t:"Put a word in for their town", c:"20m · 4 influence", run(){
    try{ spend(20, 3); }catch(e){}
    G.you.influence = clamp(G.you.influence - 4, 0, 100);
    onumTouch(m, 7, w > 20 ? "friend" : "colleague");
    let town = m.state || "home";
    try{ town = (bioOf(m) || {}).town || town; }catch(e){}
    setSay("A word for " + town + ", from you, with nothing asked in the same breath. I heard the difference. My people will hear that I was not forgotten, and I will say who said it.", "");
    try{ onumWebPush(m.name, "personal", "Someone with a title put a word in for " + town + " and did not send an invoice with it. I am writing that down."); }catch(e){}
  }});
  return A;
}; }

function onumWebAgency(){
  const W = onumWeb();
  try{
    const press = (G.press || []).filter(p => p && !p.gone);
    if(press.length){
      const p = press[(G.day || 1) % press.length];
      const outlet = p.outlet || p.name || "A paper";
      onumSite(outlet, "press", outlet);
      const b = G.bill && !G.bill.done ? G.bill : null;
      onumWebPush(outlet, "press", (p.name || "The desk") + " files it this way: " + (b ? b.title + " is not the story the whips are telling. The story is who pays, and who was not asked." : "A quiet day is still a day. I will not invent a crisis to fill the page.") + " That is the paper's line, not a member's.");
    }
  }catch(e){}
  try{
    const civ = (G.civ || []).filter(c => c && !c.gone && (c.met || (c.rel && Math.abs(c.rel.warmth || 0) > 6)));
    if(civ.length){
      const c = civ[(G.day || 1) % civ.length];
      const title = (c.cause || "A petition") + " — " + (c.name || "a citizen");
      onumSite(c.name, "union", title);
      onumWebPush(c.name, "union", "I am " + c.name + ", and I am here about " + (c.cause || "what the building keeps postponing") + ". I am not a colour on a chart. If you answer, answer me.");
    }
  }catch(e){}
  try{
    const creedish = (G.members || []).filter(m => m && !m.gone && m.creed);
    if(creedish.length && (G.day % 3 === 1)){
      const m = creedish[(G.day || 1) % creedish.length];
      let ct = "a faith"; try{ const c = creedOf(m.creed); if(c && c.t) ct = c.t; }catch(e){}
      onumSite(ct, "chapel", ct);
      onumWebPush(m.name, "chapel", "From the " + ct + " page, in my name: I will not trade what I hold for a quieter week. The building can read that or not.");
    }
  }catch(e){}
  try{
    const posts = W.posts || [];
    if(posts.length && Math.random() < 0.8){
      const p = posts[Math.floor(Math.random() * Math.min(6, posts.length))];
      const pool = (G.members || []).filter(m => m && !m.gone && m.name !== p.owner);
      if(pool.length && !(p.replies || []).some(r => r.npc)){
        const m = pool[(G.day * 7 + p.owner.length) % pool.length];
        const aye = (function(){ try{ return G.bill && memberVote(m, G.bill) > 0; }catch(e){ return true; } })();
        const t = (m.party && G.you && m.party === G.you.party)
          ? "I am " + m.name + ". I read that. I am not signing someone else's sentence. On the week, I am " + (aye ? "with the paper" : "against the paper") + " for my own reasons."
          : "I am " + m.name + ", and I am not in that person's pocket. I read it. Here is my objection, in my words: my town was not in the sentence.";
        p.replies = p.replies || [];
        p.replies.push({by:m.name, t:t, d:G.day, npc:1});
      }
    }
  }catch(e){}
  try{
    onumCamp();
    const foe = (G.camp.field || []).filter(f => !f.out).sort((a, b) => (b.heat || 0) - (a.heat || 0))[0];
    if(foe){
      onumSite(foe.name, "campaign", foe.name + " for " + (OFFICES[foe.for] ? OFFICES[foe.for].t : foe.for));
      onumWebPush(foe.name, "campaign", "I am " + foe.name + ", from " + foe.from + ", and I am running. I am not running against a rumour. I am running because the chair has a record, and I will argue the record in my own voice.");
    }
  }catch(e){}
}
{ const _wd = onumWebDay; onumWebDay = function(){
  const W = onumWeb();
  const fresh = W.day !== G.day;
  const r = _wd.apply(this, arguments);
  if(fresh){ try{ onumWebAgency(); }catch(e){} }
  return r;
}; }

onumWebHTML = function(){
  try{ onumWebDay(); }catch(e){}
  const W = onumWeb();
  const y = G.you;
  const mine = W.mine;
  const sites = W.sites || [];
  const cur = PC._site || "";
  let h = '<div class="pc__h">The Web</div><div class="pc__m">Papers, parties, chapels, unions, campaigns, and anyone with a name. They write what they think. They answer each other. You may found a page and answer under your own name.</div>';
  h += '<div style="margin:6px 0">' +
    (mine ? '<button class="pc__btn" data-soc="web:post">Post on ' + onumEsc(mine.title) + '</button>' : '<button class="pc__btn" data-soc="web:found">Found a page of your own</button>') +
    ' <button class="pc__btn" data-ws="">The whole wire</button></div>';
  h += '<div class="pc__m">Sites: ' + (sites.slice(-14).map(s => '<button type="button" class="pc__btn" data-ws="' + onumEsc(s.id) + '">' + onumEsc(s.title || s.owner) + '</button>').join(" ") || "none yet") + '</div>';
  const posts = (W.posts || []).filter(p => !cur || p.site === cur).slice(0, 16);
  const site = cur ? sites.find(s => s.id === cur) : null;
  if(site) h += '<div class="pc__h">' + onumEsc(site.title) + '</div><div class="pc__m">' + onumEsc(site.kind) + ' · kept by ' + onumEsc(site.owner) + ' since day ' + site.since + '</div>';
  posts.forEach(p => {
    h += '<div class="pc__row"><span class="d">d' + p.d + ' · ' + onumEsc(p.at || "") + ' · ' + onumEsc(p.kind) + '</span><b>' + onumEsc(p.owner) + '</b><div class="pc__m">' + onumEsc(p.t) + '</div>';
    (p.replies || []).slice(-3).forEach(r => { h += '<div class="pc__m">↳ ' + onumEsc(r.by) + ': ' + onumEsc(r.t) + '</div>'; });
    if(!y || p.owner !== y.name) h += '<button class="pc__btn" data-soc="web:re:' + p.id + '">Answer in your own name</button>';
    h += '</div>';
  });
  if(!posts.length) h += '<p class="pc__m">Nothing on this page yet. Morning fills the wire. You can found one now.</p>';
  return h;
};
{ const _pr = pcRender; pcRender = function(){
