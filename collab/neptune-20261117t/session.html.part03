    }
  }catch(e){}
  return s;
}; }
{ const _cr = engChannelRead; engChannelRead = async function(file){
  try{
    const raw = await file.text();
    if(/%PDF-|endobj|endstream/.test(raw) && !/^\s*\{/.test(raw)) return "That is not words. The Engine reads a letter, not a pressed document.";
  }catch(e){}
  const r = await _cr.apply(this, arguments);
  try{ onumPruneEngine(engEnsure()); }catch(e){}
  return r;
}; }
function onumEngIdle(){
  try{
    const E = engEnsure();
    E.idle = E.idle || [];
    if(E.idleDay === G.day) return E.idle;
    E.idleDay = G.day;
    const q = (G.bill && !G.bill.done && G.bill.title) ? ("Whether " + G.bill.title + " does what its title says.") : "What the season is doing to the price of bread.";
    E.idle.push({d:G.day, t:q});
    if(E.idle.length > 12) E.idle.shift();
    return E.idle;
  }catch(e){ return []; }
}
function onumWorkPage(){
