function onumLean(p){
  let lean = "quiet", why = "Not their point to mark.";
  const bill = G.bill && !G.bill.done ? G.bill : null;
  try{
    if(bill && p && p !== G.you && typeof memberVote === "function" && p.kind === "member"){
      const v = memberVote(p, bill);
      if(v > 0) return {id:p.id, name:p.name, role:p.role || "", lean:"for", why:"With " + bill.title + "."};
      if(v < 0) return {id:p.id, name:p.name, role:p.role || "", lean:"against", why:"Against " + bill.title + "."};
    }
  }catch(e){}
  if(p && G.you && p.party && p.party === G.you.party){ lean = "for"; why = "Same caucus. Not a signature they handed over."; }
  else if(p && G.you && p.party && G.you.party && p.party !== G.you.party){ lean = "against"; why = "Not their caucus, and they will not pretend."; }
  else if(p && p.traits && p.traits.discretion > 70){ lean = "quiet"; why = "They are in the room. The point is not theirs to mark."; }
  return {id:p ? p.id : null, name:p ? p.name : "Someone", role:(p && p.role) || "", lean:lean, why:why};
}
function onumTablePeople(){
  const out = [];
  const seen = {};
  const add = p => { if(!p || p === G.you || p.gone || seen[p.id]) return; seen[p.id] = 1; out.push(p); };
  try{ if(typeof cabSeats === "function") cabSeats().forEach(add); }catch(e){}
  try{
    if(typeof presStaff === "function" && typeof PRES_ROLES !== "undefined"){
      const st = presStaff();
      Object.keys(PRES_ROLES).forEach(k => add(st && st[k]));
    }
  }catch(e){}
  try{ if(typeof SSN !== "undefined" && SSN && SSN.seats) SSN.seats.forEach(s => { if(s.personId !== "you") add(byId(s.personId)); }); }catch(e){}
  return out.slice(0, 8);
}
function onumLiveReact(speaker, text){
  const rows = onumTablePeople().filter(p => !speaker || p !== speaker).map(onumLean);
  const last = function(n){ return String(n || "").split(" ").slice(-1)[0]; };
  const forN = rows.filter(r => r.lean === "for").map(r => last(r.name));
  const agN = rows.filter(r => r.lean === "against").map(r => last(r.name));
  const qN = rows.filter(r => r.lean === "quiet").map(r => last(r.name));
  const posted = "Posted to the table: with it, " + (forN.join(", ") || "no one") + ". Against, " + (agN.join(", ") || "no one") + ". Held, " + (qN.join(", ") || "no one") + ".";
  rows.forEach(r => { const p = byId(r.id); try{ if(p) ledgerOwn(p, posted); }catch(e){} });
  try{ if(G.you) ledgerOwn(G.you, posted); }catch(e){}
  try{ if(typeof SSN !== "undefined" && SSN){ ssnEnsure().log.push({d:G.day, kind:SSN.kind, act:"live", who:"the table", t:posted.slice(0, 160)}); } }catch(e){}
  const live = {at:Date.now(), speaker:speaker && speaker.name, text:String(text || "").slice(0, 180), rows:rows, posted:posted};
  try{ if(typeof SSN !== "undefined" && SSN) SSN.live = live; }catch(e){}
  try{ if(window.ONUM_SESSION) window.ONUM_SESSION.live = live; }catch(e){}
  G._live = live;
  try{ onumSessStrip(); }catch(e){}
  return live;
}
function onumBillBits(){
  const b = G.bill && !G.bill.done ? G.bill : null;
  if(!b) return {title:"No bill on the table", line:"The chair has not laid a paper down. There is nothing to be for yet."};
  const bits = [b.title];
  if(b.line) bits.push(b.line);
  if(b.sponsor) bits.push("In under " + b.sponsor + (b.sponsorParty ? " (" + b.sponsorParty + ")" : "") + ".");
  return {title:b.title, line:bits.slice(1).join(" ") || "The clerk has the title. The argument is whose it is."};
}
function onumTableTalk(text){
  const said = String(text || "").trim();
  if(!said) return;
  try{ if(window.onumSession && typeof SSN !== "undefined" && SSN && window.onumSession.speak) window.onumSession.speak(said); }catch(e){}
  const live = onumLiveReact(G.you, said);
  const answers = [];
  onumTablePeople().slice(0, 5).forEach(p => {
    const take = onumLean(p);
    const about = take.lean === "for"
      ? "On the bill I am with it, in my own office, not in yours."
      : take.lean === "against"
        ? "On the bill I am against it. I will not dress that up to keep the afternoon kind."
        : "I am not marking it. It is not mine to mark, and I will not borrow a voice.";
    const g = onumGate(p, (typeof onumSay === "function" ? onumSay(p, about) : about), "cabinet");
    if(!g.say) answers.push({p:p, t:p.name.split(" ")[0] + " does not add it.", lean:"quiet"});
    else answers.push({p:p, t:g.text, lean:take.lean});
  });
  G._liveAnswers = answers;
  return {live:live, answers:answers};
}
function onumTableCard(){
  const B = onumBillBits();
  const live = G._live;
  const rows = (live && live.rows) || onumTablePeople().map(onumLean);
  const paint = r => '<div style="margin:4px 0"><b>' + onumEsc(r.name) + '</b> <span class="muted">· ' + onumEsc(r.role || "") + ' · ' + (r.lean === "for" ? "with it" : r.lean === "against" ? "against it" : "held") + '</span><div class="muted">' + onumEsc(r.why || "") + '</div></div>';
  const ans = (G._liveAnswers || []).map(a => '<div style="margin:6px 0"><b>' + onumEsc(a.p.name) + '</b><div>“' + onumEsc(a.t) + '”</div></div>').join("");
  const body = '<p><b>' + onumEsc(B.title) + '</b></p><p>' + onumEsc(B.line) + '</p>' +
    '<div class="eyebrow">Posted to all of them</div>' + (rows.length ? rows.map(paint).join("") : '<p class="muted">Nobody is at the table yet.</p>') +
    (live && live.posted ? '<p class="muted">' + onumEsc(live.posted) + '</p>' : '') +
    '<div class="eyebrow">Say it, about the bill</div><textarea id="tbSay" maxlength="240" style="width:100%;min-height:64px" placeholder="Your own words. They will answer as themselves."></textarea>' +
    '<div class="card__actions"><button type="button" class="btn" id="tbGo">Say it to the table</button></div><div class="dream" id="tbOut"></div>' + ans;
  govCardOpen("The table", "Who is with it, who is not", "The same slip is posted to every person in the room. They can see it. You can see the bill, and you can talk about it.", body, null);
  const go = el("tbGo"); if(go) go.addEventListener("click", () => {
    const inp = el("tbSay");
    const r = onumTableTalk(inp && inp.value);
    if(!r) return;
    const o = el("tbOut");
    if(o) o.textContent = r.live.posted;
    onumTableCard();
  });
}
function onumSessStrip(){
  const P = document.getElementById("ndSess");
  const body = P && P.querySelector(".ns-body");
  if(!body) return;
  let box = body.querySelector("#nsxLive");
  if(!box){ box = document.createElement("div"); box.id = "nsxLive"; box.style.cssText = "margin-top:6px;padding:6px;border:1px solid #c9a24a;border-radius:6px;background:#1a160e"; body.appendChild(box); }
  const B = onumBillBits();
  const live = (typeof SSN !== "undefined" && SSN && SSN.live) || G._live;
  const rows = (live && live.rows) || [];
  const last = n => String(n || "").split(" ").slice(-1)[0];
  const line = rows.length ? ("With it: " + (rows.filter(r => r.lean === "for").map(r => last(r.name)).join(", ") || "—") + ". Against: " + (rows.filter(r => r.lean === "against").map(r => last(r.name)).join(", ") || "—") + ". Held: " + (rows.filter(r => r.lean === "quiet").map(r => last(r.name)).join(", ") || "—") + ".") : "The leans post when somebody speaks.";
  box.innerHTML = '<div style="color:#ffe08a;font:700 12px Georgia,serif">The bill</div><div>' + onumEsc(B.title) + '</div><div style="color:#e8e2d0;font-size:12px;margin:4px 0">' + onumEsc(line) + '</div><button type="button" id="nsxTable" style="background:#ffe08a;color:#111;border:0;border-radius:4px;padding:4px 8px;font:700 12px system-ui;cursor:pointer">Open the table</button>';
}
setTimeout(function(){
  try{
    const SN = window.NEPTUNE_SESSIONVIEW;
    if(!SN || !SN.render || SN._onumLive) return;
    SN._onumLive = 1;
