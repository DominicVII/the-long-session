onumElectBody = function(){
  onumCamp(); try{ onumWebDay(); }catch(e){}
  const y = G.you; if(!y) return "<p>No campaign yet.</p>";
  const left = Math.max(0, (G.termLength || 40) - (G.sittingDay || 1));
  const hist = (G.polls || []).slice(-8);
  const bars = hist.map(p => '<i title="day ' + p.d + ' · ' + p.v + '" style="display:inline-block;width:14px;height:' + Math.max(4, Math.round((p.v || 0) * 0.7)) + 'px;background:#c9a24a;margin:0 2px;vertical-align:bottom"></i>').join("");
  const last = hist.length ? hist[hist.length - 1] : null;
  let cover = last ? last.paper + " asked " + (last.n || "several hundred") + " households" + (last.ask ? " about " + last.ask : "") + " and printed " + last.v + " (±" + (last.moe || 3) + "). The other papers will spend tomorrow disagreeing about the same number." : "No sounding has been trusted yet. The clerks are covering the race off the canvass and the quarrels.";
  const races = (G.races || []).slice(-4).reverse().map(r => '<div>The ' + r.congress + 'th · ' + onumEsc(r.seeking || "house") + ' · you ' + (r.won ? "won" : "lost") + ' by ' + r.margin + (r.poll != null ? ' · sounding ' + r.poll : '') + (r.paper ? ' · ' + onumEsc(r.paper) : '') + '</div>').join("");
  const seeking = y.seeking || heldOffice() || "house";
  const field = (G.camp.field || []).filter(f => !f.out).map(f => {
    const youP = Math.round(y.approval || 0);
    const gap = youP - f.poll;
    const primary = f.party === y.party;
    const voice = f.name + " of " + f.from + " (" + partyName(f.party) + "): “I am running for this office because the chair has a record. I will argue the record. I will not argue a sentence I did not hear.”";
    return '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + onumEsc(f.for === "pres" ? (function(){ try{ return execTitle(); }catch(e){ return "Executive"; } })() : (OFFICES[f.for] ? OFFICES[f.for].t : f.for)) + '</b>' + (f.for === seeking ? ' · you have declared' : '') + (primary ? ' · primary' : ' · general') +
      '<div>' + onumEsc(f.name) + ' at ' + f.poll + ' · you ' + youP + ' · ' + (gap >= 0 ? "you lead by " + gap : "you trail by " + (-gap)) + ' · heat ' + Math.round(f.heat || 0) + '</div><div class="muted" style="font-size:12px">' + onumEsc(voice) + '</div></div>';
  }).join("");
  const states = (G.states || []).slice().sort((a, b) => (b.unrest || 0) - (a.unrest || 0)).slice(0, 6).map(s => {
    const lean = Math.round(s.lean || 0);
    return '<div>' + onumEsc(s.n) + ' · unrest ' + Math.round(s.unrest || 0) + ' · lean ' + (lean > 0 ? "+" : "") + lean + '</div>';
  }).join("");
  const open = Object.keys(OFFICES).filter(k => { try{ return (k === "house" && !termLimited("house")) || qualifies(k); }catch(e){ return k === "house"; } });
  const decl = open.map(k => '<button type="button" class="btn btn--ghost" data-el="decl:' + k + '">Declare for ' + onumEsc(k === "pres" ? (function(){ try{ return execTitle(); }catch(e){ return "the executive"; } })() : OFFICES[k].t) + '</button>').join("");
  const primaryWarn = (y.standing || 50) < 42 ? '<p>Your standing is ' + Math.round(y.standing) + '. Your own party is already talking about a primary. They will say it on the Web before they say it to your face.</p>' : '';
  return '<p class="muted">' + left + ' sitting day' + (left === 1 ? '' : 's') + ' left in the term. You hold ' + onumEsc(officeTitle()) + '. You are standing for ' + onumEsc(seeking === "pres" ? (function(){ try{ return execTitle(); }catch(e){ return "the executive"; } })() : ((OFFICES[seeking] && OFFICES[seeking].t) || seeking)) + '.</p>' +
    primaryWarn +
    '<div class="eyebrow">The soundings</div><div style="line-height:0;margin:6px 0">' + (bars || '') + '</div><p>' + onumEsc(cover) + '</p>' +
    '<div class="eyebrow">The map, as the clerks have it</div>' + (states || '<p class="muted">The states have not reported.</p>') +
    '<div class="eyebrow">Who is actually running</div>' + field +
    '<div class="eyebrow">Declare</div><div class="card__actions" style="flex-wrap:wrap">' + decl + '</div>' +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" data-el="rally">Rally at home (12 from the chest)</button><button type="button" class="btn btn--ghost" data-el="ad">Buy the ad (28)</button><button type="button" class="btn btn--ghost" data-el="canv">Canvass with the field</button><button type="button" class="btn btn--ghost" data-el="debate">Prep the debate</button></div><div class="dream" id="elSay"></div>' +
    (races ? '<div class="eyebrow">What the last elections were</div>' + races : '');
};
{ const _ed = onumElectDo; onumElectDo = function(k){
  if(k && String(k).indexOf("decl:") === 0){
    const off = String(k).slice(5);
    const y = G.you; if(!y) return "";
    let ok = false; try{ ok = (off === "house" && !termLimited("house")) || qualifies(off); }catch(e){ ok = off === "house"; }
    if(!ok) return "The law says you may not stand for that.";
    y.seeking = off;
    try{ onumWebPush(y.name, "campaign", "I am standing for " + (off === "pres" ? execTitle() : OFFICES[off].t) + ". The page can quote me on that and on nothing I did not say."); }catch(e){}
    try{ feed("You declared for " + off + "."); }catch(e){}
    return "Declared. The field will answer on the Web, in their own names.";
  }
  return _ed.apply(this, arguments);
}; }

setInterval(() => { try{ if(!G || !G.you) return; onumPatchAmen2(); if(heldOffice() === "gov" && G.room === "govoffice" && G._govSeat !== G.day){ G._govSeat = G.day; onumSeatCouncil(); } }catch(e){} }, 5000);


/* 20261113d — desks that stay, cabinet appointments as real people,
   memory and families, markets, the district, maps, Vox on the phone.
   No new kinds of person. They already are who they are; they choose. */
function onumIsWork(o){
  if(!o || !o.id) return false;
  return /^(xcab|jxcabc|kxdesk|amenDesk|desk|xsit|xphone|xacts|jxsec|xcal|gbrief|gbook|gwait|gbread|kgdesk|scal|streaty|cconf|cclerk|cmarshal)$/.test(o.id);
}
function onumNearWork(){
  try{
    const list = (PROPS && PROPS[G.room]) || [];
    let best = null, bd = 1e9;
    for(let i = 0; i < list.length; i++){
      const o = list[i];
      if(!onumIsWork(o)) continue;
      const d = Math.hypot((o.x || 0) - cam.x, (o.z || 0) - cam.z);
      if(d < (o.r || 2.2) + 0.55 && d < bd){ bd = d; best = o; }
    }
    return best;
  }catch(e){ return null; }
}
function onumDeskCard(o){
  try{ closeTalk(); }catch(e){}
  const acts = onumWorkActs(o).filter(a => a && a.t && a.t.indexOf("Open this as a page") !== 0 && a.t.indexOf("Open the work page") !== 0);
  const body = acts.map((a, i) => '<div style="margin:8px 0"><button type="button" class="btn" data-dkx="' + i + '">' + onumEsc(a.t) + '</button> <span class="muted">' + onumEsc(a.c || "") + '</span></div>').join("") || "<p class=\"muted\">Nothing is on this desk.</p>";
  const prec = onumPrecLine();
  govCardOpen(o.label || "The desk", "This page stays up", "The line in the room can flicker. The work is here, and it does not vanish." + (prec ? " " + prec : ""), body, null);
  card.querySelectorAll("[data-dkx]").forEach(b => b.addEventListener("click", () => {
    const a = acts[+b.getAttribute("data-dkx")];
    if(!a || !a.run) return;
    try{
      const r = a.run();
      const s = el("gcSay");
      if(s && r) s.textContent = String(r);
    }catch(err){
      const s = el("gcSay");
      if(s) s.textContent = "That would not open. It is still on this page. Try it again.";
    }
  }));
}
function onumWorkActs(o){
  const A = [];
  const go = (t, c, fn) => A.push({t:t, c:c, run:fn});
  const id = o && o.id;
  if(id === "xcab" || id === "jxcabc"){
    go("Convene the cabinet", "they sit, in their own chairs", function(){ try{ closeTalk(); }catch(e){} onumOpenCabinet(); });
    go("Hear each secretary", "their department, their words", function(){ try{ closeTalk(); }catch(e){} try{ presBrief(); }catch(e){ onumCabinetCard(); } });
    go("Appoint a secretary", "file, hearing, vote, the chair", function(){ try{ closeTalk(); }catch(e){} onumAppointDeep("cab"); });
    go("Open this as a page", "it will not vanish", function(){ onumDeskCard(o); });
    return A;
  }
  if(id === "kxdesk" || id === "amenDesk" || id === "desk" || id === "kgdesk"){
    go("Open the work page", "the tasks, as a card that stays", function(){ onumDeskCard(o); });
    go("The computer", "mail, the Web, elections, Vox", function(){
      try{ if(G.room === "office" && !G.you.sitting && typeof sitCasuallyAtDesk === "function") sitCasuallyAtDesk(); }catch(e){}
      try{ if((id === "amenDesk" || id === "kgdesk") && !G.you.sitting && typeof sitAtMyDesk === "function") sitAtMyDesk(); }catch(e){}
      try{ pcOpen(); }catch(e){}
    });
    if(id === "desk"){
      go(G.you && G.you.sitting ? "Stand" : "Sit at the desk", "the chair does not vanish", function(){
        try{
          if(G.you && G.you.sitting){ if(typeof toggleSit === "function") toggleSit(); else G.you.sitting = false; }
          else if(typeof sitCasuallyAtDesk === "function") sitCasuallyAtDesk();
        }catch(e){}
      });
    }
    if(id === "amenDesk" || id === "kxdesk" || id === "kgdesk"){
      go(G.you && G.you.sitting ? "Stand" : "Sit", "then the work is in reach", function(){
        try{
          if(G.you && G.you.sitting){ if(typeof toggleSit === "function") toggleSit(); else G.you.sitting = false; }
          else if(typeof sitAtMyDesk === "function") sitAtMyDesk();
          else if(typeof sitCasuallyAtDesk === "function") sitCasuallyAtDesk();
        }catch(e){}
      });
    }
    try{
      if(heldOffice() === "pres" && (id === "kxdesk" || id === "amenDesk")) onumExecActs().forEach(a => A.push(a));
    }catch(e){}
    try{ onumLifeActs().forEach(a => { if(!A.some(x => x.t === a.t)) A.push(a); }); }catch(e){}
    go("The market", "prices, shops, the guilder", function(){ onumMarketCard(); });
    go("The district", "shops, work, the match", function(){ onumDistrictCard(); });
    return A;
  }
  try{
    const raw = (typeof o.acts === "function" ? o.acts() : o.acts) || [];
    raw.forEach(a => { if(a && a.t && a.t !== "Leave it") A.push(a); });
  }catch(e){}
  go("Open this as a page", "stays up", function(){ onumDeskCard(o); });
  return A;
}
function onumFixCabProps(){
