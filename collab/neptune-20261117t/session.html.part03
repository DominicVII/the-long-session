    const n = 420 + (Math.abs(seedOf("pn" + G.day)) % 680);
    const ask = (G.bill && !G.bill.done) ? "the " + G.bill.title : "the job " + (y.name || "the member") + " is doing";
    G.polls = (G.polls || []).concat([{d:G.day, v:poll, moe:3, n, paper, ask}]).slice(-20);
    try{ feed("POLL · " + paper + " asked " + n + " households about " + ask + ". " + (y.name || "You") + " at " + poll + " (±3).", "news"); }catch(e){} }
  return T;
}
{ const _idm = idMend; idMend = function(){ const r = _idm.apply(this, arguments); try{ r.seats = seatMend(); r.career = careerMend(); r.envoys = envoyMend(); realmSync();
  (G.states || []).forEach(st => { if(st && st.bill && !st.bill.title && st.bill.t) st.bill.title = st.bill.t; });   /* a state bill has a name: the docket and the news read it */
  (G.journal || []).forEach(j => { if(j && typeof j.t === "string" && /over the undefined\.$/.test(j.t)) j.t = j.t.replace(/ over the undefined\.$/, " over its bill."); }); }catch(e){} return r; }; }
{ const _scb6 = saveCaptureBase; saveCaptureBase = function(){ const o = _scb6.apply(this, arguments); try{ o.realmRel = G.realmRel || null; o.rsync = G.rsync || null; o.polls = G.polls || null; o.seats = G.seats || null; o.lastSwing = G.lastSwing || null; o.races = G.races || null; o.raceBook = G.raceBook || null; o.speechHold = G.speechHold || null; o.lastRace = G.lastRace || null; }catch(e){} return o; }; }
setInterval(() => { try{ if(G && G.you){ realmSync(); if(G._standDay !== G.day){ const first = G._standDay == null; G._standDay = G.day; if(!first) standDay(); } } }catch(e){} }, 2500);

/* ══ 20261027a · NO COIN DECIDES A CASE. A suit between the Union and a State over the State's own measures, or between the
   House and the President, is decided justice by justice on the question it raises: how far the Union reaches into the States,
   or how far the President may act without the Congress; each with an opinion and a dissent, kept in the bench's reports. ══ */
const GX_TEXT = {
  states:{pl:"The State's measure intrudes on what the Charter gives the Union, and cannot stand.", df:"What the State did is within the powers the Charter leaves to it.", plS:"The Union has reached past the powers the Charter gives it.", dfS:"The Union acted within its powers, and the State must comply."},
  separation:{pl:"The President acted without authority that the Charter or any Act provides.", df:"The action lies within the powers of the office."}
};
function lxGenericCase(c){
  if(!c || c.done || c.dual != null || c.lx) return null; const t = String(c.t || ""), J = lxBench(); if(!J.length) return null;
  const parts = t.split(" v. "), plaintiff = parts[0] || "the plaintiff", defendant = (parts[1] || "the defendant").replace(/\s*\(.*$/, "");
  const th = /^the House v\. the President/i.test(t) ? "separation" : "states", T = LX_TH[th];
  const side = th === "separation" ? 1 : (/^the Union$/i.test(plaintiff) ? -1 : 1);
  const prior = (G.cases || []).filter(x => x !== c && x.done && x.gx && x.gx.th === th).sort((u, v) => (v.dday || v.day) - (u.dday || u.day))[0];
  const prec = prior ? (prior.gx.lean > 0 ? 0.15 : -0.15) : 0;
  const votes = J.map((j, i) => { const lean = clamp(((j.pos && j.pos[T.ax]) || 0) * T.sg / 60, -1, 1), sc = (lean + prec) * 0.7 * side + (knH(j.name, t) - 0.5) * 0.3 + 0.03; return {name:j.name, pl:sc > 0, chief:i === 0}; });
  const won = votes.filter(v => v.pl).length * 2 > votes.length, maj = votes.filter(v => v.pl === won), min = votes.filter(v => v.pl !== won);
  const pickOf = (L, k) => L.length ? L[Math.floor(knH(t, k) * L.length)] : null, author = pickOf(maj, "a"), diss = pickOf(min, "d"), X = GX_TEXT[th];
  const why = th === "separation" ? (won ? X.pl : X.df) : side < 0 ? (won ? X.pl : X.df) : (won ? X.plS : X.dfS);
  const op = "Justice " + author.name + " wrote for the Court: " + (won ? plaintiff : defendant) + " prevails. " + why + (prior ? " The Court has been here before, in " + prior.t + "." : "") + (diss ? " Justice " + diss.name + " dissented." : "");
  c.done = true; c.dday = G.day; c.gx = {th, won, count:maj.length + "–" + min.length, op, author:author.name, lean:(won ? side : -side)};
  c.ruled = won ? (/^the Union$/i.test(plaintiff) ? "union" : "state") : (/^the Union$/i.test(plaintiff) ? "state" : "union");
  try{ const S = (G.states || []).find(x => x.n === c.state); if(S) S.unrest = clamp((S.unrest || 0) + (c.ruled === "union" ? 3 : -2), 0, 100); }catch(e){}
  try{ feed("The high bench, " + c.gx.count + ", finds for " + (won ? plaintiff : defendant) + " in " + t + ".", "news"); journal("Court: " + t + " — for " + (won ? plaintiff : defendant) + ", " + c.gx.count + "."); }catch(e){}
  return c.gx;
}
{ const _oca2 = orgCourtAct; orgCourtAct = function(){ try{ let k = null; try{ k = roleKey(); }catch(e){}
    (G.cases || []).forEach(c => { if(!c || c.done || c.lx || c.dual != null) return; lxEnrich(c); if(c.lx) return; if(k === "bench" && c.state !== (G.you && G.you.state)) return; if(G.day - (c.day || 0) < 4 || !chance(0.35)) return; lxGenericCase(c); }); }catch(e){}
  return _oca2.apply(this, arguments); }; }
{ const _rh = lxReportsHTML; lxReportsHTML = function(){ let h = _rh.apply(this, arguments); try{ const C = (G.cases || []).filter(c => c && c.done && c.gx).sort((u, v) => (v.dday || v.day) - (u.dday || u.day));
  if(C.length){ const add = '<div class="eyebrow" style="margin-top:12px">Between the Union, the States and the branches</div>' + C.map(c => '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid #6a7fa0"><b>' + pcEsc(c.t) + '</b> <span class="muted" style="font-size:12px">· decided day ' + (c.dday || "?") + ' · ' + pcEsc(c.gx.count) + ' · on ' + pcEsc(LX_TH[c.gx.th].t) + '</span><div style="font-size:13px;margin-top:3px">' + pcEsc(c.gx.op) + '</div></div>').join("");
    h = h.replace('<div class="card__actions"><button type="button" class="btn btn--ghost" id="lxClose">Close</button></div>', add + '<div class="card__actions"><button type="button" class="btn btn--ghost" id="lxClose">Close</button></div>'); } }catch(e){} return h; }; }

/* ══ 20261027b · INSTITUTIONS THAT LIVE. The justices age, and retire or die at the rates people do; a vacant seat stays vacant
   until the President nominates and the Senate confirms, by a roll call of all forty senators (you are one of them when you
   sit there); a confirmed justice takes the vacant seat and nobody else's. Appointments to the cabinet and the state bench go
   to the body that confirms them. The treasury takes in what the States and the duties pay and pays out what the acts in force
   appropriate and what the fighting costs; the guilder answers to the balance and is pulled back toward par. Every Senate seat
   has a named senator and keeps its party, and a third of the seats are contested at each election. ══ */
function jAge(j){ return ((G.day || 1) - (j.born || 0)) / 365; }
function benchEnsure(){ (G.court || []).forEach(j => { if(!j || j.vacant) return; if(j.born == null){ const r = rng(seedOf("jage:" + j.name)); j.born = (G.day || 1) - Math.round((54 + r() * 22) * 365); } if(j.since == null) j.since = 1; }); return G.court || []; }
function benchVacancy(){ const V = G.benchVac; return V && G.court && G.court[V.seat] && G.court[V.seat].vacant ? V : null; }
function benchVacate(i, how){
  const j = G.court[i]; if(!j || j.vacant || j.you) return null;
  G.court[i] = {vacant:true, name:"", by:"", pos:{econ:0, lib:0, def:0, wel:0}, was:j.name, how, d:G.day};
  G.benchVac = {seat:i, d:G.day, was:j.name, how, nom:null, fails:0, next:G.day + 3 + (seedOf(j.name) % 6)};
  try{ const line = (i === 0 ? "Chief Justice " : "Justice ") + j.name + " " + how + ". A seat on the high bench is vacant until the President nominates and the Senate confirms."; note(line, true); journal(line); pushWireScrap("Bench", j.name + " — " + how); }catch(e){}
  try{ (G.cases || []).forEach(c => {}); }catch(e){}
  return G.benchVac;
}
/* realistic hazards: mortality rising with age (about 1% a year at sixty, 6% at eighty, for people this healthy), retirement more likely past seventy */
function benchDay(){
  benchEnsure(); const C = G.court || [];
  C.forEach((j, i) => { if(!j || j.vacant || j.you || benchVacancy()) return; const a = jAge(j), death = 0.011 * Math.exp((a - 60) * 0.0866), ret = a < 70 ? 0.015 : a < 80 ? 0.07 : 0.15, r = knH(j.name, "bench:" + G.day);
    if(r < death / 365) benchVacate(i, "died in office"); else if(r < (death + ret) / 365) benchVacate(i, "retired from the bench"); });
  benchNomTick();
}
function benchCands(){ const ex = G.exec || {}, base = (G.exec && G.exec.you ? G.you.pos : ex.pos) || {econ:0, lib:0, def:0, wel:0};
  return [0, 1, 2].map(i => { const o = mkOfficial("bnom:" + G.day + ":" + i + ":" + (G.benchVac ? G.benchVac.fails : 0), {n:pick(STATES)}, "Nominee to the high bench"); AXES.forEach(a => { o.pos[a.k] = clamp(Math.round(base[a.k] * (i === 0 ? 0.9 : i === 1 ? 0.5 : 0.1) + o.pos[a.k] * (i === 0 ? 0.3 : 0.6)), -100, 100); }); return o; }); }
