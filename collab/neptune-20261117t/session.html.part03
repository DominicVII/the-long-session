/* 20261114b */
/* 20261114b — what you can see in the room, and a sentence that is allowed to land.
   A hold does not erase a conversation. If someone is there, you can speak to them. */
{ const _need = onumNeeded; onumNeeded = function(p, text, where){
  if(where === "talk" || where === "reply" || where === "cabinet" || where === "floor" || where === "summit" || where === "room") return true;
  return _need.apply(this, arguments);
}; }

function onumNear(){
  const out = [];
  const add = p => { if(p && p !== G.you && !p.gone && out.indexOf(p) < 0) out.push(p); };
  try{ if(TALK && TALK.m) add(TALK.m); }catch(e){}
  try{ hereNow().forEach(add); }catch(e){}
  try{ if(typeof audience === "function") audience(null).forEach(add); }catch(e){}
  return out.slice(0, 6);
}
function onumMark(p, text){
  const lean = onumLean(p);
  let tone = lean.lean;
  try{
    if(text && typeof readTone === "function"){
      const toneR = readTone(text);
      if(toneR && toneR.hostile && (p.rel && p.rel.warmth < 10)) tone = "against";
      else if(toneR && toneR.warm && (p.rel && p.rel.warmth > 0)) tone = "for";
    }
  }catch(e){}
  const about = tone === "for"
    ? "I am with what was just said. I am saying so as myself."
    : tone === "against"
      ? "I am not with that. I will not pretend I am."
      : "I heard it. I am not marking it, and I am not speaking for anyone else.";
  let line = about;
  try{ if(typeof onumSay === "function") line = onumSay(p, about); }catch(e){}
  return {p:p, lean:tone, line:String(line || about).slice(0, 180)};
}
function onumSeePaint(rows){
  const T = el("talk");
  if(!T) return;
  let box = document.getElementById("tkSee");
  if(!box){
    box = document.createElement("div");
    box.id = "tkSee";
    const acts = el("tkActs");
    if(acts && acts.parentNode) acts.parentNode.insertBefore(box, acts);
    else T.appendChild(box);
  }
  const word = r => r.lean === "for" ? "with it" : r.lean === "against" ? "against it" : "listening";
  box.innerHTML = '<b style="color:#ffe08a">What you see</b>' + (rows.length ? rows.map(r =>
    '<div style="margin-top:4px"><b>' + onumEsc(r.p.name) + '</b> <span style="opacity:.8">· ' + word(r) + '</span><div>“' + onumEsc(r.line) + '”</div></div>'
  ).join("") : '<div>Nobody else is close enough to mark it. You can still say it.</div>');
}
function onumShowRoom(text, speak){
  const rows = onumNear().map(p => onumMark(p, text));
  const posted = "Posted where they stand: " + rows.map(r => r.p.name.split(" ").slice(-1)[0] + " " + (r.lean === "for" ? "with" : r.lean === "against" ? "against" : "listening")).join(", ");
  if(speak){
    rows.forEach(r => { try{ ledgerOwn(r.p, posted); }catch(e){} });
    try{ if(G.you) ledgerOwn(G.you, posted); }catch(e){}
  }
  onumSeePaint(rows);
  if(speak){
    rows.forEach((r, i) => {
      if(TALK && TALK.m === r.p) return;
      setTimeout(function(){
        try{
          if(!r.p || r.p.gone || r.p.room !== G.room) return;
          r.p.say = r.line;
          r.p.sayT = 6;
          r.p.sayTo = "you";
          r.p.faceUntil = (G.t || 0) + 6;
        }catch(e){}
      }, 400 + i * 700);
    });
  }
  try{
    const n = el("tkNote");
    if(speak && n && rows.length && !String(n.textContent || "").trim()) n.textContent = posted;
  }catch(e){}
  return rows;
}
function onumCommBox(){
  const T = el("talk");
  if(!T || document.getElementById("tkComm")) return;
  const d = document.createElement("div");
  d.id = "tkComm";
  d.innerHTML = '<input id="tkCommIn" maxlength="400" placeholder="Say anything. They answer as themselves."><button type="button" id="tkCommGo">Say it</button><button type="button" id="tkCommRoom">To the room</button>';
  const see = document.getElementById("tkSee");
  if(see && see.parentNode) see.parentNode.insertBefore(d, see);
  else {
    const acts = el("tkActs");
    if(acts && acts.parentNode) acts.parentNode.insertBefore(d, acts);
    else T.appendChild(d);
  }
}
function onumSayTo(text, room){
  const said = String(text || "").trim();
  if(!said) return;
  if(room || !(TALK && TALK.m)){
    try{ addressRoom(said); }catch(e){ try{ onumShowRoom(said, true); }catch(x){} }
    return;
  }
  const m = TALK.m;
  try{
    if(typeof converse === "function"){
      const p = converse(m, said);
      if(p && typeof p.then === "function") p.then(function(){ try{ onumShowRoom(said, true); }catch(e){} });
      else onumShowRoom(said, true);
      return;
    }
  }catch(e){}
  try{ converseLive(m, said); }catch(e){}
  onumShowRoom(said, true);
}
if(!document.getElementById("onumCommCss")){
  const st = document.createElement("style");
  st.id = "onumCommCss";
  st.textContent = "#tkComm{display:flex;gap:6px;margin:6px 10px;align-items:center;flex:none!important}" +
    "#tkComm input{flex:1;min-height:40px;background:#0d0f13;color:#fff;border:1px solid #c9a24a;border-radius:4px;padding:6px 8px}" +
    "#tkComm button{background:#ffe08a;color:#111;border:0;border-radius:4px;font:700 13px system-ui;padding:8px 10px;cursor:pointer}" +
    "#tkComm #tkCommRoom{background:#2a2d35;color:#fff;border:1px solid #c9a24a}" +
    "#tkSee{margin:4px 10px 8px;padding:6px 8px;border:1px solid #c9a24a;border-radius:6px;background:#1a160e;color:#f4f1e8;font:12px/1.35 system-ui;flex:none!important;overflow:visible!important}" +
    ".talk.tk-one.is-open #wire.wire--in .wire__in,.talk.tk-one.is-open #wire.wire--in #wireSend,.talk.is-open #wire .wire__in,.talk.is-open #wire #wireSend{display:inline-flex!important;visibility:visible!important}";
  document.head.appendChild(st);
}
document.addEventListener("click", function(ev){
  const t = ev.target;
  if(!t || !t.closest) return;
  if(t.closest("#tkCommGo")){
    ev.preventDefault();
    const inp = document.getElementById("tkCommIn");
    const said = inp && inp.value;
    if(inp) inp.value = "";
    onumSayTo(said, false);
  } else if(t.closest("#tkCommRoom")){
    ev.preventDefault();
    const inp = document.getElementById("tkCommIn");
    const said = inp && inp.value;
    if(inp) inp.value = "";
    onumSayTo(said, true);
  }
});
