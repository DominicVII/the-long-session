  return {approval:clamp(52 - (un - 25) * 0.4 + rec + war * 1.5 + econ + (k === "house" || k === "gov" ? home : 0), 15, 85),
    influence:clamp(({house:35, senate:45, gov:50, pres:65, bench:40})[k] || 35, 10, 90), standing:clamp(55 + rec, 20, 85)};
}
function standDay(){
