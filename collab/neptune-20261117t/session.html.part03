      line = who + ". " + line;
    }
    line = onumDequote(line, m);
  }catch(e){}
  return line;
}; }

roleDutyRun = function(key){
  let it = null;
  try{ it = roleDuties().find(x => x.key === key); }catch(e){}
  if(!it || (typeof kOnceToday === "function" && kOnceToday(key))) return;
  if(it.dock){ try{ docketRun(it.dock); }catch(e){ try{ feed("That duty would not open."); }catch(x){} } return; }
  if(key === "gappt"){
    try{
      kMark("gappt");
      const ks = Object.keys(APPT).filter(k => k !== "cab");
      appointCard(ks[Math.floor(Math.random() * ks.length)] || "judge");
    }catch(e){ try{ appointCard("judge"); }catch(x){} }
    return;
  }
  let line = "";
  try{ line = it.run(); }catch(e){ try{ feed("That duty would not open."); }catch(x){} return; }
  if(line == null) return;
  try{ kMark(key); }catch(e){}
  try{ setSay(String(line || ""), ""); feed(it.t + "."); }catch(e){}
  try{ refreshPanels(); }catch(e){}
};

