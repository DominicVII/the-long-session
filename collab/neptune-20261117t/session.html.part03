    const R = typeof rsEnsure === "function" ? rsEnsure() : null;
    if(q && R && R.qs) st = R.qs[q.id];
  }catch(e){}
  if(!q){
    govCardOpen("The Academy", "Nothing on the bench", "No open question is far enough along to read.", "<p>When a question is open, this page will show the claim, the method, what would prove it wrong, and whether it is a real question, a model, or invented inside the world.</p>", null);
    return;
  }
  const prog = st && st.prog != null ? Math.round(st.prog * 100) : 0;
  const tries = st && st.tries != null ? st.tries : 0;
  const html = '<p class="muted">REALITY: the question is a real kind of question. Nothing below is a discovery. No number here was produced by a simulation.</p>' +
    '<div class="eyebrow">Claim</div><p>' + onumEsc(q.q || q.f) + '</p>' +
    '<div class="eyebrow">Plain</div><p>The Academy has this filed under ' + onumEsc(q.f || "a field") + '. It is at the question stage. Reading it teaches you what is being asked, not an answer the game invented.</p>' +
    '<div class="eyebrow">Method</div><p>Progress on the record is ' + prog + ' out of 100. Tries: ' + tries + '. Those two numbers come from the research ledger, not from a laboratory the game ran.</p>' +
    '<div class="eyebrow">What would prove it wrong</div><p>A result that answers ' + onumEsc(q.q || "the question") + ' in the other direction, checked by someone who did not write it.</p>' +
    '<div class="eyebrow">Limits</div><p>This page will not pretend a small model discovered new science. When a calculation is added later, it will be marked as a model and the inputs will be shown.</p>';
  govCardOpen("The Academy", onumEsc(q.f || "A question"), "A page you can read. Not a label.", html, null);
}
