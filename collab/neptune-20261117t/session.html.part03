      (on && !R.done ? '<span class="whip__b"><button type="button" class="btn ' + (p.you === 1 ? '' : 'btn--ghost') + '" style="padding:2px 8px;font-size:12px" data-lxam="' + i + ':1">Aye</button><button type="button" class="btn ' + (p.you === -1 ? '' : 'btn--ghost') + '" style="padding:2px 8px;font-size:12px" data-lxam="' + i + ':-1">No</button></span>' : '') + '</div>').join("") : '<p class="muted" style="margin:2px 0">No amendments offered.</p>') +
    (on && !R.done ? '<div class="whip__row"><span class="whip__n">Report</span><span class="whip__w">to the House, favourably</span><span class="whip__b"><button type="button" class="btn ' + (R.youReport === 1 ? '' : 'btn--ghost') + '" style="padding:2px 8px;font-size:12px" data-lxam="r:1">Aye</button><button type="button" class="btn ' + (R.youReport === -1 ? '' : 'btn--ghost') + '" style="padding:2px 8px;font-size:12px" data-lxam="r:-1">No</button></span></div>' : '');
}
