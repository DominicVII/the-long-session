    if(ch && !ch._d13){
      ch._d13 = 1;
      ch.acts = function(){ return onumWorkActs(ch); };
    }
  }catch(e){}
}
{ const _up = updatePrompt; let _stick = null, _stickAt = 0;
  updatePrompt = function(thing, dr, seat){
