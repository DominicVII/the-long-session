  (s.amends || []).filter(a => a.where === "committee").forEach(a => out.push("In markup, day " + a.d + ": " + a.by + "'s amendment to " + a.what + " was " + (a.adopted ? "adopted" : "rejected") + ", " + a.aye + " to " + a.no + "."));
  if(R.report) out.push("Reported " + (R.report.fav ? "favourably" : "unfavourably") + ", " + R.report.aye + " to " + R.report.no + ".");
  else out.push("Markup set for day " + R.mark + ".");
  (s.amends || []).filter(a => a.where !== "committee").forEach(a => out.push("On the floor, day " + a.d + ": " + a.by + " moved to " + a.what + (a.aye != null ? "; " + (a.adopted ? "adopted" : "rejected") + ", " + a.aye + " to " + a.no : "") + "."));
  return out;
}
