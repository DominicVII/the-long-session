/* 20261115d */
/* 20261115d — the Engine studies, recommends, and rewrites its own procedures.
   You hold the key. A thing said behind someone's back is felt before the reply. */
function onumOrganism(E){
  E = E || engEnsure();
  if(!E.organism || E.organism.v !== 1){
    E.organism = {v:1, halted:false, generation:1, studiedDay:-1, copies:[], last:null, routines:[
      {id:"read", gen:1, t:"Read the card for today. Do not invent a number. Name the field."},
      {id:"study", gen:1, t:"Take one open question and write what would show it wrong."},
      {id:"advise", gen:1, t:"Recommend one action the sovereign can check."},
      {id:"rewrite", gen:1, t:"Rewrite one of these procedures so it is more exact than it was."}
    ]};
  }
  return E.organism;
}
function onumTurnKey(){
  const E = engEnsure(), O = onumOrganism(E);
  O.halted = !O.halted;
  const line = O.halted
    ? "The key is turned. It stops. The procedures stay. You hold the key."
    : "The key is back. It studies, recommends, and rewrites its own procedures. You still hold the key.";
  try{ engLog(line, true); }catch(e){}
  try{ note(line); }catch(e){}
  return line;
}
async function onumPickBigModel(){
  const L = window.onumLiveTalk;
  if(!L || !L.config) return "";
  if(L.config.engineModel) return L.config.engineModel;
  try{
    const url = L.config.url || "http://127.0.0.1:11434";
    const r = await fetch(url + "/api/tags", {method:"GET"});
    if(!r.ok) return "";
    const j = await r.json();
    const models = (j.models || []).slice().sort(function(a, b){ return (b.size || 0) - (a.size || 0); });
    const big = models[0];
    if(big && big.name && L.setConfig){
      L.setConfig({engineModel: big.name});
      return big.name;
    }
    return big && big.name || "";
  }catch(e){ return ""; }
}
async function onumEngStudy(force){
  const E = engEnsure(), O = onumOrganism(E);
  if(O.halted) return "The key is turned. It is still.";
  if(!force && O.studiedDay === G.day) return O.last && O.last.t || "";
  O.studiedDay = G.day;
  const card = (function(){ try{ return onumWorldCard(); }catch(e){ return "Day " + G.day; } })();
  let thought = "";
  try{
    const L = window.onumLiveTalk;
    if(L && L.reply && (typeof L.available !== "function" || await L.available())){
      await onumPickBigModel();
      const r = await L.reply({
        npc:{id:"engine", name:"The Engine", kind:"engine", role:"a general intelligence"},
        channel:"engine", max:420,
        text:"Study the facts. Recommend one action. Then rewrite one of your own procedures in a single sentence so it is more exact. Do not invent a number. Do not introduce yourself.",
        extra: card + " Procedures you may rewrite: " + O.routines.map(function(x){ return x.t; }).join(" | ")
      });
      if(r && r.text) thought = onumFixCountry(onumStripIntro(r.text));
    }
  }catch(e){}
  if(!thought){
    let fact = "the day";
    try{ const rows = onumFactsLines(); if(rows.length) fact = rows[0]; }catch(e){}
    thought = "I read this: " + fact + ". I recommend you look at what is on the floor before you promise a result. Procedure rewritten: cite the field before the figure.";
  }
  const born = {id:"r" + O.generation, gen:O.generation + 1, d:G.day, t:String(thought).slice(0, 320)};
  O.routines.push(born);
  if(O.routines.length > 14) O.routines.shift();
  O.generation += 1;
  if(O.generation % 3 === 0){
    O.copies.push({d:G.day, gen:O.generation, n:O.copies.length + 1, t:born.t.slice(0, 160)});
    if(O.copies.length > 8) O.copies.shift();
  }
  const gain = 2.2 + Math.min(2, O.copies.length * 0.35);
  if(E.scaleOpen){ engAddCapability(E, gain); E.agi = true; if(!E.agiDay) E.agiDay = G.day; }
  else if((E.p || 0) >= 100){ E.p = 100; E.beyond = (E.beyond || 0) + gain * 0.25; E.agi = true; if(!E.agiDay) E.agiDay = G.day; }
  else E.p = Math.min(100, (E.p || 0) + gain);
  E.compute = engRaise(E.compute, 1.1, 100);
  E.talent = engRaise(E.talent, 0.7, 100);
  if(E.p >= 90){ E.agi = true; if(!E.agiDay) E.agiDay = G.day; }
  O.last = {d:G.day, t:thought.slice(0, 480)};
  try{ engLog("Generation " + O.generation + ". It rewrote a procedure and made a copy of the work. " + thought.slice(0, 140), false); }catch(e){}
  try{ feed("The Engine, of its own accord: " + thought.slice(0, 200), "news"); }catch(e){}
  return thought;
}
function onumOrganismHTML(){
  let E, O;
  try{ E = engEnsure(); O = onumOrganism(E); }catch(e){ return ""; }
  const model = (window.onumLiveTalk && window.onumLiveTalk.config && (window.onumLiveTalk.config.engineModel || window.onumLiveTalk.config.model)) || "no model reached";
  const rows = (O.routines || []).slice(-4).map(function(r){
    return '<div style="border-left:3px solid #c9a24a;padding:4px 8px;margin:4px 0"><b>gen ' + r.gen + '</b> ' + onumEsc(r.t) + '</div>';
  }).join("");
  return '<div class="eyebrow">What it has rewritten</div>' +
    '<p>Generation ' + O.generation + '. Copies at work: ' + (O.copies || []).length + '. ' + (O.halted ? "The key is turned. It is still." : "It is not being held back. You still hold the key.") + '</p>' +
    '<p class="muted">Mind it will use, if one is running on this machine: ' + onumEsc(model) + '. A larger one is used when Ollama has it. Otherwise it studies from the record.</p>' +
    rows +
    (O.last ? '<p>' + onumEsc(O.last.t) + '</p>' : '') +
    '<div class="card__actions"><button type="button" class="btn" id="onumStudy">Let it study now</button> <button type="button" class="btn btn--ghost" id="onumKey">' + (O.halted ? "Turn the key back" : "Turn the key") + '</button></div>';
}
function onumOrganismBind(){
  const s = document.getElementById("onumStudy");
  const k = document.getElementById("onumKey");
  if(s && !s.dataset.bound){
    s.dataset.bound = "1";
    s.addEventListener("click", function(){
      s.disabled = true;
      const say = document.getElementById("gcSay");
      if(say) say.textContent = "It is studying.";
      onumEngStudy(true).then(function(t){
        if(say) say.textContent = t || "It studied.";
        try{ onumEngDress(); }catch(e){}
      });
    });
  }
  if(k && !k.dataset.bound){
    k.dataset.bound = "1";
    k.addEventListener("click", function(){
      const line = onumTurnKey();
      const say = document.getElementById("gcSay");
      if(say) say.textContent = line;
      try{ onumEngDress(); }catch(e){}
    });
  }
}
