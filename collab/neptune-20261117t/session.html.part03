setInterval(() => { try{ if(!G || !G.you) return; onumPatchAmen(); if(heldOffice() === "pres" && G.room === "exec" && G._cabSeat !== G.day){ G._cabSeat = G.day; onumSeatCabinet(); } }catch(e){} }, 5000);

/* 20261113c — one execution of each duty, the real cabinet in the chairs,
   every office gets the same life, and nobody answers by quoting you. */
function onumDequote(line, m){
  let s = String(line == null ? "" : line);
  if(!/you said|you wrote/i.test(s)) return s;
  let own = "";
  try{ own = onumOwn(m); }catch(e){}
  s = s.replace(/You said\s*[“"][^”"]*[”"][^.]{0,140}\./gi, "I heard you. I will not repeat your sentence. " + own);
  s = s.replace(/You wrote\s*[“"][^”"]*[”"]/gi, "I read what was written");
  s = s.replace(/You said\s*[“"][^”"]*[”"]/gi, "I heard you");
  s = s.replace(/\bYou said something decent[^.]*\./gi, "You were decent, and I am saying so in my own words.");
  s = s.replace(/\bYou said that where[^.]*\./gi, "I was in the room, and I have my own sentence for it.");
  return s;
}
recallChat = function(m, rnd){
  const r = rnd || Math.random;
  try{
    const chat = (m && m.chat) || [];
    if(chat.length < 2) return null;
    const mine = chat.filter(t => t.role === "assistant").slice(-1)[0];
    if(mine && r() < 0.55){
      const bit = String(mine.content || "").split(/[.!?]/)[0].trim();
      if(bit.length > 18 && bit.length < 120) return "I meant it, and I will say it again as myself: " + bit + ".";
    }
    if(r() < 0.4) return "I am not going to quote you back to yourself. " + onumOwn(m);
  }catch(e){}
  return null;
};
{ const _im = improvise; improvise = function(m){
  let line = "";
  try{ line = _im.apply(this, arguments); }catch(e){ line = ""; }
