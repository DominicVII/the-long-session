  return r;
}; }
{ const _sm = sendMessageTo; sendMessageTo = function(m, text){
  const r = _sm.apply(this, arguments);
  try{
    let reply = "";
    try{ reply = improvise(m, text); }catch(e){ reply = ""; }
    if(!reply && typeof onumSay === "function") reply = onumSay(m, "I got what you sent. I will answer it as myself, not in your words.");
    const st = el("wireState");
    if(st && reply) st.textContent = (typeof surname === "function" ? surname(m.name) : m.name) + ": " + String(reply).slice(0, 160);
    try{ m.say = String(reply).slice(0, 160); m.sayT = 5; m.sayTo = "you"; }catch(e){}
  }catch(e){}
  return r;
}; }


/* 20261114c */
/* 20261114c — the room keeps talking, and you can see it without opening a card.
   One sentence gets an answer, then the people standing there answer each other. */
onumMark = function(p, text){
  const lean = onumLean(p);
  let tone = lean.lean;
  try{
    if(text && typeof readTone === "function"){
      const toneR = readTone(text);
      if(toneR && toneR.hostile && p.rel && p.rel.warmth < 12) tone = "against";
      else if(toneR && toneR.warm && p.rel && p.rel.warmth > 0) tone = "for";
    }
  }catch(e){}
  const seat = p.state || p.role || p.post || "where I stand";
  const bill = (G.bill && !G.bill.done && G.bill.title) ? G.bill.title : "what is in front of us";
  const about = tone === "for"
    ? "On " + bill + ", from " + seat + ", I am with it. That mark is mine."
    : tone === "against"
      ? "On " + bill + ", from " + seat + ", I am against it. I will not dress that up."
      : "On " + bill + " I am listening. " + seat + " did not send me here to nod.";
  let line = about;
  try{ if(typeof onumSay === "function") line = onumSay(p, about); }catch(e){}
  return {p:p, lean:tone, line:String(line || about).slice(0, 200)};
};

function onumChainLog(beats){
  const box = document.getElementById("tkSee");
  if(!box || !beats.length) return;
  const more = beats.map(b => '<div style="margin-top:4px"><b>' + onumEsc(b.p.name) + '</b> <span style="opacity:.75">answers</span><div>“' + onumEsc(b.t) + '”</div></div>').join("");
  box.insertAdjacentHTML("beforeend", '<div style="margin-top:6px;border-top:1px solid #6b5a2a;padding-top:4px"><b style="color:#ffe08a">They keep going</b>' + more + '</div>');
}
function onumChain(text){
  if(!G || !G.you) return;
  if(G._chainUntil && Date.now() < G._chainUntil) return;
  const near = onumNear();
  if(!near.length) return;
  G._chainUntil = Date.now() + 4500;
  const first = (TALK && TALK.m && near.indexOf(TALK.m) >= 0) ? TALK.m : near[0];
  const rest = near.filter(p => p !== first).slice(0, 3);
  const bill = (G.bill && G.bill.title) ? G.bill.title : "this";
  const beats = [];
  const say = (p, about) => {
    let line = about;
    try{ line = onumSay(p, about); }catch(e){}
    return String(line || about).slice(0, 200);
  };
  beats.push({p:first, t:say(first, "I heard you on " + bill + ". I am answering for myself, not in your words."), delay:500});
  rest.forEach((p, i) => {
    const lean = onumLean(p);
    const who = first.name.split(" ").slice(-1)[0];
    const about = lean.lean === "against"
      ? "I heard " + who + ". I do not agree, and I will not let that sit as if the room were one person."
      : lean.lean === "for"
        ? "I heard " + who + ". I am with the point. I am not with a crowd."
        : "I heard " + who + ". I am not taking a side I have not taken.";
    beats.push({p:p, t:say(p, about), delay:1400 + i * 1200});
  });
  if(rest[0]){
    const back = rest[0].name.split(" ").slice(-1)[0];
    beats.push({p:first, t:say(first, "I heard " + back + ". I am answering them. I am not repeating what was said to me."), delay:1400 + rest.length * 1200});
  }
  onumChainLog(beats);
  beats.forEach(b => {
    setTimeout(function(){
      try{
        if(!b.p || b.p.gone) return;
        if(b.p.room && G.room && b.p.room !== G.room) return;
        b.p.say = b.t;
        b.p.sayT = 7.5;
        b.p.sayTo = "you";
        b.p.faceUntil = (G.t || 0) + 8;
        if(TALK && TALK.open){
          try{ appendMsg("them", b.t, (typeof surname === "function" ? surname(b.p.name) : b.p.name)); }catch(e){}
          if(TALK.m === b.p){ try{ setSay(b.t, ""); }catch(e){} }
        }
      }catch(e){}
    }, b.delay);
  });
}

function onumStandDock(){
  let d = document.getElementById("onumSeeDock");
  if(!d){
    d = document.createElement("div");
    d.id = "onumSeeDock";
    d.setAttribute("role", "region");
    d.setAttribute("aria-label", "Who is in the room");
    d.innerHTML = '<div class="h"><b>Who is here</b><button type="button" id="onumSeeX">Hide</button></div><div id="onumSeeBody"></div><div class="row"><input id="onumSeeIn" maxlength="240" placeholder="Say it. They answer, then the room does."><button type="button" id="onumSeeGo">Say</button></div>';
    document.body.appendChild(d);
  }
  return d;
}
function onumStandPaint(){
  const d = onumStandDock();
  if(!d) return;
  const pr = document.getElementById("prompt");
  const live = pr && !pr.hidden && pr.classList.contains("is-live");
  if((TALK && TALK.open) || live || !(G && G.you)){ d.hidden = true; return; }
  d.hidden = false;
  d.classList.toggle("fold", !!(G && G._seeHide));
  const rows = onumNear().slice(0, 4).map(p => onumMark(p, ""));
  const body = document.getElementById("onumSeeBody");
  if(!body) return;
  const word = r => r.lean === "for" ? "with it" : r.lean === "against" ? "against it" : "listening";
  body.innerHTML = rows.length ? rows.map(r =>
    '<button type="button" data-seeid="' + onumEsc(r.p.id) + '"><b>' + onumEsc(r.p.name) + '</b> <i>' + word(r) + '</i><span>' + onumEsc(r.line) + '</span></button>'
  ).join("") : '<p>Nobody is close. Walk up to someone, or say it anyway.</p>';
}
if(!document.getElementById("onumSeeCss")){
  const st = document.createElement("style");
  st.id = "onumSeeCss";
  st.textContent = "#onumSeeDock{position:fixed;left:8px;bottom:70px;z-index:42;width:min(300px,92vw);max-height:34vh;overflow:auto;background:#121419;color:#f4f1e8;border:2px solid #c9a24a;border-radius:8px;padding:6px 8px;font:12px/1.35 system-ui}" +
    "#onumSeeDock .h{display:flex;justify-content:space-between;align-items:center;color:#ffe08a}" +
    "#onumSeeDock .h button,#onumSeeDock .row button{background:#ffe08a;color:#111;border:0;border-radius:4px;font:700 12px system-ui;padding:6px 8px}" +
    "#onumSeeDock .row{display:flex;gap:6px;margin-top:6px}" +
    "#onumSeeDock input{flex:1;min-height:36px;background:#0d0f13;color:#fff;border:1px solid #c9a24a;border-radius:4px;padding:4px 6px}" +
    "#onumSeeDock.fold #onumSeeBody,#onumSeeDock.fold .row{display:none}" +
    "#onumSeeBody button{display:block;width:100%;text-align:left;margin:4px 0;background:#1a160e;color:#f4f1e8;border:1px solid #6b5a2a;border-radius:4px;padding:4px 6px}" +
    "#onumSeeBody i{color:#ffe08a;font-style:normal}#onumSeeBody span{display:block;opacity:.9}";
  document.head.appendChild(st);
}
document.addEventListener("click", function(ev){
  const t = ev.target;
  if(!t || !t.closest) return;
  if(t.closest("#onumSeeX")){
    if(G) G._seeHide = !G._seeHide;
    const d = document.getElementById("onumSeeDock");
    if(d) d.classList.toggle("fold", !!(G && G._seeHide));
    const b = document.getElementById("onumSeeX");
    if(b) b.textContent = (G && G._seeHide) ? "Show" : "Hide";
    return;
  }
  const who = t.closest("[data-seeid]");
  if(who){
    ev.preventDefault();
    let p = null;
    try{ p = byId(who.getAttribute("data-seeid")); }catch(e){}
    if(!p) p = onumNear().find(x => String(x.id) === String(who.getAttribute("data-seeid")));
    if(p && typeof openTalk === "function"){ try{ openTalk(p); }catch(e){} }
    return;
  }
  if(t.closest("#onumSeeGo")){
    ev.preventDefault();
    const inp = document.getElementById("onumSeeIn");
    const said = inp && inp.value;
    if(inp) inp.value = "";
    const m = onumNear()[0];
    if(m && typeof openTalk === "function"){ try{ if(!TALK.open || TALK.m !== m) openTalk(m); }catch(e){} }
    try{ onumSayTo(said, !m); }catch(e){}
  }
});
{ const _ar = addressRoom; addressRoom = function(text){
  const r = _ar.apply(this, arguments);
  try{ onumChain(text); }catch(e){}
  return r;
}; }
{ const _cv = converse; converse = function(m, text){
  const r = _cv.apply(this, arguments);
  const go = function(){ try{ onumChain(text); }catch(e){} };
  try{ if(r && typeof r.then === "function") r.then(go, go); else go(); }catch(e){ go(); }
  return r;
}; }
{ const _live = converseLive; converseLive = function(m, text){
  const r = _live.apply(this, arguments);
  try{ onumChain(text); }catch(e){}
  return r;
}; }
setInterval(function(){
  try{ if(!G || !G.you) return; onumStandPaint(); }catch(e){}
}, 2500);


/* 20261114d */
/* 20261114d — the world reads its own record.
   Outputs rewrite the reading of the inputs. Five anchors do not move.
   A loop that nests too far stops. It does not freeze the sitting. */
const ONUM_ANCHORS = ["The charter", "The capital", "The guilder unit", "A person is only their own name", "A vote is counted once"];

function onumLoop(){
  if(!G.loop || G.loop.v !== 1){
    G.loop = {v:1, epoch:1, scars:[], gloss:[], echoes:[], measured:{}, copies:[],
      weight:1, runaway:0, depth:0, frozen:null, doorDay:-1, lastDay:-1, histN:null,
      rule:"A day weighs 1. The anchors do not move.", told:0, weightApplied:0, voxEpoch:0};
  }
  const L = G.loop;
  L.scars = L.scars || []; L.gloss = L.gloss || []; L.echoes = L.echoes || [];
  L.measured = L.measured || {}; L.copies = L.copies || [];
  if(typeof L.epoch !== "number") L.epoch = 1;
  if(typeof L.runaway !== "number") L.runaway = 0;
  if(typeof L.weight !== "number") L.weight = 1;
  return L;
}
function onumLoopWrite(line){
  const t = String(line || "").slice(0, 280);
  if(!t) return;
  try{
    const C = onumLore();
    C.kept.push({d:G.day, who:"The record", t:t, about:null});
    if(C.kept.length > 80) C.kept.shift();
  }catch(e){}
  try{ if(G.you && typeof ledgerOwn === "function") ledgerOwn(G.you, t); }catch(e){}
}
function onumLoopVoice(p){
  if(!p) return "I can see the record writing itself. I am not the record.";
  const about = "I can see the record writing itself. I am not the record, and I am not the office that keeps it. I am " + p.name + ".";
  try{ if(typeof onumSay === "function") return onumSay(p, about); }catch(e){}
  return about;
}
function onumLoopWitness(){
  try{ const n = onumNear(); if(n && n[0]) return n[0]; }catch(e){}
  return (G.members || []).find(m => m && !m.gone) || null;
}
function onumLoopVox(p, text){
  try{
    if(!p || !text) return;
    if(typeof voxInit === "function" && !G.vox) voxInit();
    if(!G.vox || typeof voxAdd !== "function") return;
    voxAdd({id:G.vox.id++, by:p.id, t:String(text).slice(0, 240), k:"loop", v:0,
      day:G.day, at:(typeof hhmm === "function" ? hhmm() : ""),
      backs:0, hits:0, voices:[], mine:false});
  }catch(e){}
}
function onumFractalLines(){
  const mood = Math.round(G.mood || 0);
  return (G.states || []).slice(0, 4).map(s =>
    (s.n || "A state") + " repeats the realm at a smaller scale. Unrest " + Math.round(s.unrest || 0) + ". The national mood is " + (mood > 0 ? "+" : "") + mood + ".");
}
function onumShopLines(){
  let shops = [];
  try{ shops = onumShops() || []; }catch(e){}
  return shops.slice(0, 3).map(s =>
    "The " + (s.kind || "shop") + " in " + (s.town || "town") + " is kept by " + (s.owner || "its owner") + ". The till (" + (s.till || 0) + ") buys " + (s.book || "stock") + ", and that stock is what the till exists to sell.");
}
function onumLoopBrief(){
  const L = onumLoop();
  const scar = L.scars[0] ? " Epoch " + L.scars[0].n + " still carries: " + L.scars[0].t : "";
  const gloss = L.gloss[0] ? " " + L.gloss[0].t : "";
  return "Epoch " + L.epoch + ". A day weighs " + L.weight + ". Runaway " + L.runaway + " of 92." + gloss + scar;
}
function onumLoopHeads(){
  const L = onumLoop();
  const H = [];
  H.push(["Loop", "Epoch " + L.epoch + ". A day weighs " + L.weight + ". The anchors do not move."]);
  if(L.gloss[0]) H.push(["Record", L.gloss[0].t]);
  else if(L.echoes[0]) H.push(["Echo", L.echoes[0].t]);
  if(L.runaway > 70) H.push(["Runaway", "The copy is spending the world on more copies (" + L.runaway + "). Set the anchor."]);
  else H.push(["Charter", ONUM_ANCHORS[4] + ". The charter can cite every law but the one that would prove the charter."]);
  const fr = onumFractalLines()[0];
  if(fr) H.push(["Scale", fr]);
  return H.slice(0, 3);
}
function onumLoopDay(L){
  const dest = G.room;
  const name = (ROOMS[dest] && ROOMS[dest].t) || dest || "here";
  if(dest && !L.measured[dest]) L.measured[dest] = "Stood in on day " + G.day + ", so " + name + " holds.";
  if(G.bill && G.bill.title && L.copyBill !== G.bill.title){
    L.copyBill = G.bill.title;
    L.copies.unshift({d:G.day, t:"A smaller copy of " + G.bill.title + " sits in the next sitting's papers. It is a copy, not a second vote."});
    if(L.copies.length > 8) L.copies.pop();
  }
  if((G.day % 7) === 0) onumLoopEpoch(L);
  if(!L.told){
    L.told = 1;
    try{ note("The world is reading its own record. Open The loop on Who is here, or on the phone."); }catch(e){}
  }
}
function onumLoopEpoch(L){
  L.epoch = (L.epoch || 1) + 1;
  const scar = (L.gloss[0] && L.gloss[0].t) || (L.echoes[0] && L.echoes[0].t) || "The sitting left the fact that it sat.";
  L.scars.unshift({d:G.day, n:L.epoch, t:String(scar).slice(0, 180)});
  if(L.scars.length > 8) L.scars.pop();
  L.weight = Math.round(clamp(1 + (G.mood || 0) / 500, 0.9, 1.1) * 100) / 100;
  L.rule = "Epoch " + L.epoch + " weighs a day at " + L.weight + ". The anchors do not move.";
  L.runaway = Math.min(92, (L.runaway || 0) + (G.eng ? 10 : 8));
  try{
    if(L.weightApplied !== L.epoch){
      L.weightApplied = L.epoch;
      const w = worldEnsure();
      w.bread = clamp((w.bread || 1) * (0.99 + (L.weight - 1) * 0.5), 0.7, 2.6);
    }
  }catch(e){}
  const p = onumLoopWitness();
  if(p){
    const said = onumLoopVoice(p);
    L.echoes.unshift({d:G.day, room:G.room || "", who:p.name, t:said});
    if(L.echoes.length > 12) L.echoes.pop();
    try{ p.say = String(said).slice(0, 180); p.sayT = 6.5; p.sayTo = "you"; }catch(e){}
    onumLoopVox(p, said);
  }
  onumLoopWrite(L.rule);
  if(L.runaway > 78){
    onumLoopWrite("The copy is eating the copy. Runaway stands at " + L.runaway + ". Only an anchor stops it.");
    try{ note("The world is spending itself on copying itself. Set the anchor."); }catch(e){}
  }
}
function onumLoopCatchUp(){
  if(!G || !G.you) return;
  const L = onumLoop();
  const n = (G.history && G.history.length) || 0;
  if(L.histN == null) L.histN = n;
  else if(n > L.histN){
    const h = G.history[n - 1];
    L.histN = n;
    if(h && !h._looped){
      h._looped = 1;
      const what = h.precedent || h.act || "the act";
      const line = "What was done is now read as the cause of the record that led to it: " + String(what).slice(0, 160);
      L.gloss.unshift({d:G.day, t:line, who:h.who || ""});
      if(L.gloss.length > 12) L.gloss.pop();
      onumLoopWrite(line);
      L.runaway = Math.min(92, (L.runaway || 0) + 3);
    }
  }
  if(L.lastDay !== G.day){
    const prev = L.lastDay;
    L.lastDay = G.day;
    if(prev >= 0) onumLoopDay(L);
  }
}
function onumSetAnchor(){
  const L = onumLoop();
  const before = L.runaway || 0;
  L.runaway = Math.max(0, before - 28);
  L.frozen = null;
  L.depth = 0;
  const line = "The anchor was set. Runaway fell from " + before + " to " + L.runaway + ". " + ONUM_ANCHORS.join(". ") + " did not move.";
  onumLoopWrite(line);
  try{ note("The anchor held."); }catch(e){}
  onumLoopCard();
}
function onumLetCopy(){
  const L = onumLoop();
  if((L.copies || []).length >= 8){
    L.frozen = (ROOMS[G.room] && ROOMS[G.room].t) || G.room || "here";
    L.depth = 0;
    const line = L.frozen + " tried to hold another copy. It stopped. The anchor held. The sitting did not.";
    onumLoopWrite(line);
    try{ note(line); }catch(e){}
    onumLoopCard();
    return;
  }
  const bill = (G.bill && G.bill.title) || "the sitting";
  L.copies.unshift({d:G.day, t:"A copy of " + bill + ", small enough to sit inside the last copy."});
  L.runaway = Math.min(92, (L.runaway || 0) + 10);
  onumLoopCard();
}
function onumMeasureHere(){
  const L = onumLoop();
  const dest = G.room || "here";
  const name = (ROOMS[dest] && ROOMS[dest].t) || dest;
  L.measured[dest] = "Looked at on day " + G.day + ". " + name + " holds because someone measured it. Before that it was only the rule.";
  const prior = (G.history && G.history.length) ? (G.history[G.history.length - 1].precedent || G.history[G.history.length - 1].act || "") : "";
  if(prior){
    L.echoes.unshift({d:G.day, room:dest, t:"An earlier line is standing in this room: " + String(prior).slice(0, 140)});
    if(L.echoes.length > 12) L.echoes.pop();
  }
  onumLoopCard();
}
function onumWalkLoop(){
  const L = onumLoop();
  const dest = G._lastDoorFrom;
  if(!dest || dest === G.room || !ROOMS[dest]){
    try{ note("There is no earlier room for the walk to return into."); }catch(e){}
    return;
  }
  if(L.doorDay === G.day){
    try{ note("The loop already closed once today. The anchor will not open it again."); }catch(e){}
    return;
  }
  L.doorDay = G.day;
  const from = G.room;
  const fromN = (ROOMS[from] && ROOMS[from].t) || from;
  const toN = (ROOMS[dest] && ROOMS[dest].t) || dest;
  L.echoes.unshift({d:G.day, room:from, t:"A straight walk out of " + fromN + " returned to " + toN + ". Same rooms. Not the same scale."});
  if(L.echoes.length > 12) L.echoes.pop();
  onumLoopWrite(L.echoes[0].t);
  try{ walkNow(); }catch(e){}
  try{ enterRoom(dest, from); }catch(e){}
}
function onumLoopCard(){
  const L = onumLoop();
  const p = onumLoopWitness();
  const voice = p ? onumLoopVoice(p) : "";
  const measured = Object.keys(L.measured || {}).slice(0, 6).map(k => L.measured[k]);
  const sec = (title, lines) => "<h3 style=\"margin:12px 0 4px;color:#ffe08a;font:700 15px Georgia,serif\">" + onumEsc(title) + "</h3>" +
    (lines.filter(Boolean).map(t => "<p>" + onumEsc(t) + "</p>").join("") || "<p>Nothing written yet.</p>");
  const body =
    sec("What holds", [
      L.rule,
      "Runaway " + L.runaway + " of 92." + (L.frozen ? " Last place that stopped: " + L.frozen + "." : " Nothing is frozen."),
      "These do not rewrite: " + ONUM_ANCHORS.join(". ") + "."
    ]) +
    sec("The same shape, smaller", onumFractalLines().concat([
      "Vox is a sitting inside this sitting. It can cite day " + (G.day || 1) + ". It cannot leave it.",
      "The door you came through can be walked so it opens into the room you left."
    ])) +
    sec("What was measured", measured) +
    sec("Copies", (L.copies || []).slice(0, 5).map(c => "Day " + c.d + ": " + c.t).concat(onumShopLines())) +
    sec("The record, after the fact", (L.gloss || []).slice(0, 4).map(g => "Day " + g.d + ": " + g.t).concat([
      "The charter can cite every law but the law that would prove the charter."
    ])) +
    sec("What the last sitting left", (L.scars || []).slice(0, 4).map(s => "Epoch " + s.n + ", day " + s.d + ": " + s.t)) +
    sec("In the room with an earlier hour", (L.echoes || []).slice(0, 4).map(e => (e.who ? e.who + ": " : "") + e.t)) +
    (voice ? sec("Said as themselves", [p.name + ": " + voice]) : "") +
    '<div class="card__actions" style="flex-wrap:wrap;gap:6px">' +
      '<button type="button" class="btn" id="loopAnchor">Set the anchor</button>' +
      '<button type="button" class="btn" id="loopCopy">Let it copy once</button>' +
      '<button type="button" class="btn" id="loopMeasure">Look, so it holds</button>' +
      '<button type="button" class="btn" id="loopWalk">Walk the loop</button></div>';
  govCardOpen("The world reading itself", "The loop", "What is done is written back into the reason it was done. Five things do not move. A person does not speak as the world.", body, null);
  const bind = (id, fn) => { const b = document.getElementById(id); if(b) b.addEventListener("click", function(ev){ ev.preventDefault(); try{ fn(); }catch(e){} }); };
  bind("loopAnchor", onumSetAnchor);
  bind("loopCopy", onumLetCopy);
  bind("loopMeasure", onumMeasureHere);
  bind("loopWalk", onumWalkLoop);
}

{ const _mh = makeHeadlines; makeHeadlines = function(){
  const H = _mh.apply(this, arguments) || [];
  try{ onumLoopHeads().reverse().forEach(h => H.unshift(h)); }catch(e){}
  return H;
}; }
{ const _np = npMatter; npMatter = function(){
  const s = _np.apply(this, arguments) || "";
  try{ return s + " " + onumLoopBrief(); }catch(e){ return s; }
}; }
{ const _life = lifeContext; lifeContext = function(){
  const out = _life.apply(this, arguments) || [];
  try{
    const L = onumLoop();
    const gloss = L.gloss[0] ? L.gloss[0].t : "Yesterday now reads as if it had to cause today.";
    const scar = L.scars[0] ? L.scars[0].t : "I am not speaking for the sitting. Only for myself.";
    out.push({k:"loop", a:[
      "The county looks like the realm, only smaller. Have you stood still long enough to see it?",
      gloss
    ], b:[
      "I see it. I am not it, and I will not speak as if I were.",
      scar
    ], w:2});
  }catch(e){}
  return out;
}; }
{ const _apps = pbApps; pbApps = function(){
  const L = _apps.apply(this, arguments) || [];
  if(!L.some(x => x[0] === "soc-loop")) L.push(["soc-loop", "The loop", "What the world does to its own record, and what it is not allowed to touch."]);
  return L;
}; }
{ const _go = pbAppGo; pbAppGo = function(id){
  if(id === "soc-loop"){ setTimeout(function(){ try{ onumLoopCard(); }catch(e){} }, 30); return; }
  return _go.apply(this, arguments);
}; }
{ const _sc = saveCaptureBase; saveCaptureBase = function(){
  const o = _sc.apply(this, arguments);
  try{ o.loop = G.loop || null; }catch(e){}
  return o;
}; }

setInterval(function(){
  try{ onumLoopCatchUp(); }catch(e){}
  try{
    const d = document.getElementById("onumSeeDock");
    if(!d || document.getElementById("onumLoopBtn")) return;
    const h = d.querySelector(".h");
    if(!h) return;
    const b = document.createElement("button");
    b.id = "onumLoopBtn";
    b.type = "button";
    b.textContent = "The loop";
    b.addEventListener("click", function(ev){
      ev.preventDefault();
      ev.stopPropagation();
      try{ onumLoopCard(); }catch(e){}
    });
    h.appendChild(b);
  }catch(e){}
}, 4000);


/* 20261114e */
/* 20261114e — a newsroom, and the written record where it can be read.
   The people are the press already in the gallery. Nobody new. Nobody speaks as the clerk. */
function onumNewsroom(){
  if(!G.newsroom || G.newsroom.v !== 1){
    G.newsroom = {v:1, nights:[], cast:null, castDay:-1, airDay:null, pg:0};
  }
  G.newsroom.nights = G.newsroom.nights || [];
  return G.newsroom;
}
function onumCasters(){
  const N = onumNewsroom();
  const press = (G.press || []).filter(p => p && !p.gone && p.name);
  if(press.length < 1) return [];
  if(N.castDay === G.day && N.cast && N.cast.length){
    const live = N.cast.map(c => ({desk:c.desk, p: (typeof byId === "function" ? byId(c.id) : null)})).filter(c => c.p && !c.p.gone);
    if(live.length) return live;
  }
  const used = {};
  const take = (desk, pred) => {
    let p = press.find(x => !used[x.id] && pred(x));
    if(!p) p = press.find(x => !used[x.id]);
    if(!p) return null;
    used[p.id] = 1;
    return {desk:desk, p:p};
  };
  const cast = [
    take("Anchor", p => (p.trust || 0) >= 48),
    take("Editor", p => /editor|chief/i.test(p.role || "")),
    take("Wire", p => /wire/i.test(p.outlet || "")),
    take("Capitol desk", p => /clarion|ledger|gazette|daily/i.test(p.outlet || "")),
    take("The other paper", p => /register|bell|post/i.test(p.outlet || "")),
    take("District", function(){ return true; })
  ].filter(Boolean);
  N.cast = cast.map(c => ({desk:c.desk, id:c.p.id}));
  N.castDay = G.day;
  return cast;
}
function onumCastLine(c, about){
  if(!c || !c.p) return String(about || "");
  const p = c.p;
  const base = "From the " + c.desk + " at " + (p.outlet || "the gallery") + ", and only as " + p.name + ". " + about;
  try{ if(typeof onumSay === "function") return onumSay(p, base); }catch(e){}
  return base;
}
function onumDeskCopy(reporter, editor, anchor, sourced, boast){
  const filed = onumCastLine(reporter || anchor, sourced + (boast ? " " + boast : ""));
  let held = filed;
  let note = "The editor aired it as filed.";
  if(boast && editor){
    held = onumCastLine(editor, sourced + " I am cutting this, and I will say what I cut: " + boast + " We do not have it, so it does not air.");
    note = "Cut before air: " + boast;
  } else if(editor && editor !== reporter){
    held = onumCastLine(editor, "I held the filing. I did not add to it. " + sourced);
    note = "Held, and not added to.";
  }
  const read = onumCastLine(anchor || reporter, "I am reading what the desk held. I am not the clerk, and I am not the candidate. " + sourced);
  return {
    filed:filed, held:held, read:read, note:note,
    reporter: reporter && reporter.p ? reporter.p.name : "",
    editor: editor && editor.p ? editor.p.name : "",
    anchor: anchor && anchor.p ? anchor.p.name : "",
    rDesk: reporter ? reporter.p.outlet : "",
    eDesk: editor ? editor.p.outlet : "",
    aDesk: anchor ? anchor.p.outlet : ""
  };
}
function onumSeatLine(){
  try{
    return Object.keys(G.seatsBy || {}).filter(p => (G.seatsBy[p] || 0) > 0)
      .sort((a, b) => G.seatsBy[b] - G.seatsBy[a])
      .map(p => G.seatsBy[p] + " " + (typeof partyName === "function" ? partyName(p) : p)).join(", ");
  }catch(e){ return ""; }
}
function onumHomeLine(){
  try{
    const T = townEnsure();
    const hh = (T.hh || []).slice().sort((a, b) => (a.mood || 50) - (b.mood || 50));
    if(!hh.length) return "";
    const cold = hh[0], warm = hh[hh.length - 1];
    let s = "On " + cold.street + " the " + cold.fam + "s are at " + Math.round(cold.mood || 0);
    if(cold.need) s += ", and what they want said is " + cold.need;
    s += ".";
    if(warm && warm !== cold) s += " On " + warm.street + " the " + warm.fam + "s are at " + Math.round(warm.mood || 0) + ".";
    return s;
  }catch(e){ return ""; }
}
function onumNightBook(){
  const race = G.lastRace;
  if(!race) return null;
  const N = onumNewsroom();
  const key = (race.congress || 0) + ":" + (race.d || 0) + ":" + (race.seeking || "");
  const had = (N.nights || []).find(n => n.key === key);
  if(had) return had;
  const y = G.you || {};
  const cast = onumCasters();
  const anchor = cast[0] || null;
  const editor = cast[1] || anchor;
  const reporter = cast[2] || cast[cast.length - 1] || anchor;
  const office = (typeof OFFICES !== "undefined" && OFFICES[race.seeking] && OFFICES[race.seeking].t) || race.seeking || "the seat";
  const called = Math.abs(Math.round(race.margin || 0));
  const late = called > 12 ? "The desk called it before the western counties were in."
    : called > 4 ? "They waited for the river towns, then they called it."
    : "They would not use the word certain until past midnight.";
  const polls = (G.polls || []).slice(-4);
  const last = polls[polls.length - 1];
  const pollLine = last
    ? last.paper + " asked " + (last.n || "several hundred") + " households on day " + last.d + " about " + (last.ask || "the job") + " and printed " + last.v + ", plus or minus " + (last.moe || 3) + ". A sounding is not a count."
    : "No late sounding was trusted. The desk covered the race off the canvass and the county clerks.";
  const result = (race.seeking === "midterm")
    ? (y.name || "The officeholder") + " was not on the ballot. The term runs on. The country voted for everyone else."
    : (y.name || "The candidate") + (race.won ? " holds " : " loses ") + office + " by " + called + ".";
  const seats = onumSeatLine();
  const home = onumHomeLine();
  const holds = (G.members || []).filter(m => m && !m.gone).slice().sort((a, b) => (b.margin || 0) - (a.margin || 0)).slice(0, 5);
  const holdLine = holds.length
    ? "The wide holds still in the House: " + holds.map(m => m.name + " (" + (m.party || "") + ") by " + (m.margin || 0)).join("; ") + "."
    : "";
  const sourced = result + " " + late + " " + pollLine + (seats ? " The House stands " + seats + "." : "") + (home ? " " + home : "") + (holdLine ? " " + holdLine : "");
  const boast = called < 8 ? "The west is a landslide." : "";
  const copy = (anchor ? onumDeskCopy(reporter, editor, anchor, sourced, boast) : {filed:sourced, held:sourced, read:sourced, note:"No caster was in the gallery. The number is still the number.", reporter:"", editor:"", anchor:"", rDesk:"", eDesk:"", aDesk:""});
  const others = cast.slice(3, 6).map(c => {
    const about = c.desk === "District"
      ? (home || "I am in the district. I will not describe a kitchen I have not stood in.")
      : "Mood moved " + (race.swing > 0 ? "+" : "") + (race.swing || 0) + ". I am not speaking for a party. I am " + c.p.name + ".";
    return {desk:c.desk, name:c.p.name, outlet:c.p.outlet || "", t:onumCastLine(c, about)};
  });
  const night = {
    key:key, d:race.d, congress:race.congress, seeking:race.seeking, won:!!race.won,
    margin:called, swing:race.swing || 0, late:late, home:home, seats:seats,
    pollLine:pollLine, result:result, copy:copy, others:others,
    polls:polls.map(p => ({d:p.d, v:p.v, paper:p.paper, n:p.n, moe:p.moe, ask:p.ask}))
  };
  N.nights.unshift(night);
  if(N.nights.length > 8) N.nights.pop();
  try{ if(anchor && typeof onumKeep === "function") onumKeep(copy.read, anchor.p.id); }catch(e){}
  try{
    if(anchor && typeof voxInit === "function" && !G.vox) voxInit();
    if(anchor && G.vox && typeof voxAdd === "function"){
      voxAdd({id:G.vox.id++, by:anchor.p.id, t:String(copy.read).slice(0, 220), k:"air", v:0,
        day:G.day, at:(typeof hhmm === "function" ? hhmm() : ""), backs:0, hits:0, voices:[], mine:false});
    }
  }catch(e){}
  return night;
}
function onumAirFileDay(){
  const cast = onumCasters();
  if(!cast.length || !G.you) return;
  const y = G.you;
  const b = G.bill && !G.bill.done ? G.bill : null;
  const about = b
    ? "Day " + G.day + ". The floor is on " + b.title + "."
    : "Day " + G.day + ". " + y.name + " is at " + Math.round(y.approval || 0) + " at home.";
  const line = cast[0].p.name + ", " + cast[0].desk + " at " + (cast[0].p.outlet || "the gallery") + ", filed: " + about + " I am not the clerk.";
  try{ if(typeof feed === "function") feed(line, "news"); }catch(e){}
  try{ if(typeof onumKeep === "function") onumKeep(line, cast[0].p.id); }catch(e){}
}
function onumDailySegments(){
  const cast = onumCasters();
  const y = G.you;
  const b = G.bill && !G.bill.done ? G.bill : null;
  const hot = (G.states || []).slice().sort((a, c) => (c.unrest || 0) - (a.unrest || 0))[0];
  const kept = (G.chronicle && G.chronicle.kept && G.chronicle.kept.length) ? G.chronicle.kept[G.chronicle.kept.length - 1] : null;
  const rival = (typeof rivalLive === "function") ? rivalLive() : null;
  return cast.map((c, i) => {
    let about = "The desk is up. I will not fill the hour with a sentence I do not have.";
    if(i === 0) about = b ? "The House is on " + b.title + ". I have the text. I am not the sponsor, and I am not the chair." : "There is no bill on the floor. We are on the district and the standing.";
    else if(i === 1) about = y ? y.name + " stands at " + Math.round(y.approval || 0) + " at home, " + Math.round(y.standing || 0) + " in the building, war chest " + (y.funds || 0) + ". That is the figure. I am not adding a moral." : "The member is not on the set.";
    else if(i === 2) about = hot ? hot.n + " is the restless state tonight. Unrest " + Math.round(hot.unrest || 0) + ". I have not been to every courthouse." : "The states are quiet enough to read.";
    else if(i === 3) about = kept ? "What was written, and I am only reading it, day " + (kept.d || "?") + ", kept by " + (kept.who || "someone") + ": " + kept.t : "Nothing new has been kept. I will not invent a sentence to fill the hour.";
    else if(i === 4) about = rival ? "The rival is still in it. Heat " + Math.round(rival.heat || 0) + ". I am not their press secretary." : "No rival is on the sheet tonight.";
    else about = G.loop ? "Epoch " + G.loop.epoch + ". A day weighs " + G.loop.weight + ". I am not the record." : onumHomeLine() || "I am in the district.";
    return {desk:c.desk, name:c.p.name, outlet:c.p.outlet || "", role:c.p.role || "", t:onumCastLine(c, about)};
  });
}
function onumP(t){ return "<p>" + onumEsc(t) + "</p>"; }
function onumQuote(who, meta, t){
  return '<p style="border-left:3px solid #c9a24a;padding:4px 8px;margin:8px 0"><b>' + onumEsc(who) + '</b> <span class="muted">' + onumEsc(meta) + '</span><br>' + onumEsc(t) + '</p>';
}
function onumAirCard(mode){
  try{ if(G.lastRace) onumNightBook(); }catch(e){}
  const cast = onumCasters();
  const outlets = (typeof PRESS_OUTLETS !== "undefined" ? PRESS_OUTLETS : []).join(", ");
  const roster = cast.length
    ? cast.map(c => onumQuote(c.p.name, c.desk + " · " + (c.p.outlet || "") + (c.p.role ? " · was " + c.p.role : ""), "Trust " + Math.round(c.p.trust || 0) + ". I read what the desk held. I do not speak as the clerk.")).join("")
    : onumP("The press gallery has not been filled yet. The papers still print. There is nobody at the desk to read them aloud.");
  let body = '<p class="muted">Eight outlets already in the building. A reporter files. An editor holds. An anchor reads only what was held. ' + onumEsc(outlets) + '.</p>' + roster;
  if(mode === "night"){
    const nights = onumNewsroom().nights || [];
    body += nights.length ? nights.map((n, i) =>
      '<div style="margin:10px 0"><button type="button" class="btn" data-night="' + i + '">Congress ' + onumEsc(n.congress) + ' · day ' + onumEsc(n.d) + ' · ' + (n.won ? "held" : "lost") + ' by ' + onumEsc(n.margin) + '</button></div>'
    ).join("") : onumP("No election night has been filed yet. When the country votes, the desk files it here.");
  } else if(mode === "one" && arguments[1] != null){
    const n = (onumNewsroom().nights || [])[arguments[1]];
    if(!n) body += onumP("That night is not on the desk.");
    else {
      const c = n.copy || {};
      body += onumP(n.result || "") + onumP(n.late || "") + onumP(n.pollLine || "") + (n.seats ? onumP("The House stands " + n.seats + ".") : "") + (n.home ? onumP(n.home) : "");
      body += '<div class="eyebrow">Filed</div>' + onumQuote(c.reporter || "The reporter", c.rDesk || "", c.filed || "");
      body += '<div class="eyebrow">Held</div>' + onumQuote(c.editor || "The editor", (c.eDesk || "") + " · " + (c.note || ""), c.held || "");
      body += '<div class="eyebrow">Read</div>' + onumQuote(c.anchor || "The anchor", c.aDesk || "", c.read || "");
      (n.others || []).forEach(o => { body += onumQuote(o.name, o.desk + " · " + (o.outlet || ""), o.t); });
      if(n.polls && n.polls.length){
        body += '<div class="eyebrow">Soundings that night</div>';
        n.polls.forEach(p => { body += onumP("Day " + p.d + ": " + (p.paper || "A paper") + " asked " + (p.n || "?") + " households about " + (p.ask || "the job") + ". " + p.v + ", plus or minus " + (p.moe || 3) + "."); });
      }
    }
  } else {
    onumDailySegments().forEach(s => { body += onumQuote(s.name, s.desk + " · " + s.outlet + (s.role ? " · " + s.role : ""), s.t); });
  }
  body += '<div class="card__actions" style="flex-wrap:wrap;gap:6px">' +
    '<button type="button" class="btn" id="airDay">Tonight\'s cast</button>' +
    '<button type="button" class="btn" id="airNights">Election nights</button>' +
    '<button type="button" class="btn" id="airWrite">What was written</button></div>';
  govCardOpen("The Union Broadcast", mode === "night" ? "Nights on file" : "The desk is up", "A caster is a person who already works a paper. They do not become the count by reading it.", body, null);
  const dayB = document.getElementById("airDay"); if(dayB) dayB.addEventListener("click", function(){ onumAirCard("day"); });
  const nB = document.getElementById("airNights"); if(nB) nB.addEventListener("click", function(){ onumAirCard("night"); });
  const wB = document.getElementById("airWrite"); if(wB) wB.addEventListener("click", function(){ onumWrittenCard("index"); });
  card.querySelectorAll("[data-night]").forEach(b => b.addEventListener("click", function(){ onumAirCard("one", +b.getAttribute("data-night")); }));
}
function onumBookWindow(dir){
  const N = onumNewsroom();
  const T = (typeof LORE_BOOK_TEXT === "string") ? LORE_BOOK_TEXT : "";
  const size = 900;
  const pages = Math.max(1, Math.ceil((T.length || 1) / size));
  N.pg = Math.max(0, Math.min(pages - 1, (N.pg || 0) + (dir || 0)));
  return {text:T.slice(N.pg * size, N.pg * size + size), page:N.pg + 1, pages:pages};
}
function onumWrittenCard(which, dir){
  let title = "What was written";
  let body = "";
  const back = '<div class="card__actions" style="flex-wrap:wrap;gap:6px"><button type="button" class="btn" id="wrIndex">All of it</button><button type="button" class="btn" id="wrAir">The broadcast</button></div>';
  if(which === "book"){
    title = "The book";
    const w = onumBookWindow(dir || 0);
    let lore = "";
    try{
      const L = playerFamilyLore();
      lore = onumP("The book is an atlas of a career. Two witnesses in it are not people in the building, and they are not a second family.") +
        (L.player && L.player.text ? onumQuote(L.player.name, L.player.order || "the player", L.player.text) : "") +
        (L.children || []).map(c => onumQuote(c.name, (c.rel || "") + (c.rite ? " · " + c.rite : "") + " · in the book, not in the gallery", c.text || "")).join("") +
        (L.founder && L.founder.text ? onumQuote(L.founder.name, L.founder.title || "", L.founder.text) : "") +
        (L.note ? onumQuote("The book", "on what was invented", L.note) : "");
    }catch(e){}
    body = lore + '<p class="muted">Page ' + w.page + ' of ' + w.pages + '.</p><div style="white-space:pre-wrap;font-family:Georgia,serif;font-size:14px;line-height:1.45">' + onumEsc(w.text) + '</div>' +
      '<div class="card__actions"><button type="button" class="btn" id="wrPrev">Previous</button><button type="button" class="btn" id="wrNext">Next</button></div>';
  } else if(which === "kept"){
    title = "Kept, and not written";
    const C = (typeof onumLore === "function") ? onumLore() : {kept:[], lost:[]};
    body = '<div class="eyebrow">Written down</div>' + ((C.kept || []).slice().reverse().slice(0, 20).map(x => onumQuote(x.who || "Someone", "kept it, day " + (x.d || "?"), x.t || "")).join("") || onumP("Nothing has been kept yet.")) +
      '<div class="eyebrow">Remembered, and not written</div>' + ((C.lost || []).slice().reverse().slice(0, 12).map(x => onumQuote("Not written", "day " + (x.d || "?"), x.t || "")).join("") || onumP("Nothing has been let go yet."));
  } else if(which === "prec"){
    title = "Precedent";
    const rows = (G.history || []).slice(-12).reverse();
    body = rows.length ? rows.map(h => onumQuote(h.byYou ? "You" + (h.as ? ", as " + h.as : "") : (h.who || "The record"), (h.congress ? "the " + h.congress + "th Congress" : "the record") + (h.act ? " · " + h.act : ""), h.precedent || h.act || "")).join("") : onumP("The record has no precedent yet.");
  } else if(which === "poll"){
    title = "The soundings";
    const rows = (G.polls || []).slice().reverse();
    body = rows.length ? rows.map(p => onumP("Day " + p.d + ". " + (p.paper || "A paper") + " asked " + (p.n || "?") + " households about " + (p.ask || "the job") + ". Result " + p.v + ", plus or minus " + (p.moe || 3) + ". A sounding is not a count.")).join("") : onumP("No paper has asked yet. The first sounding is on the seventh day.");
  } else if(which === "races"){
    title = "Races on file";
    const nights = onumNewsroom().nights || [];
    const races = (G.races || []).slice().reverse();
    body = (nights.length ? nights.map(n => onumP("Congress " + n.congress + ", day " + n.d + ": " + (n.result || "") + " " + ((n.copy && n.copy.note) || ""))).join("") : "") +
      (races.length ? races.map(r => onumP("Day " + r.d + ", Congress " + r.congress + ". " + (r.seeking || "the seat") + (r.won ? " held" : " lost") + " by " + r.margin + ". Mood " + (r.swing > 0 ? "+" : "") + r.swing + ". Home approval " + (r.approval != null ? r.approval : "—") + (r.poll != null ? ". Last sounding " + r.poll : "") + (r.paper ? " by " + r.paper : "") + ".")).join("") : onumP("No race has been counted yet."));
  } else if(which === "letters"){
    title = "From the district";
    let letters = [];
    try{ letters = (townEnsure().letters || []).slice().reverse().slice(0, 10); }catch(e){}
    body = onumP(onumHomeLine() || "The households have not been read yet.") +
      (letters.length ? letters.map(l => onumQuote("The " + (l.fam || "house") + "s", l.street || "home" + " · day " + (l.d || "?"), l.t || "")).join("") : onumP("No letter this week."));
    body += '<div class="card__actions"><button type="button" class="btn" id="wrFam">The family, as it is lived</button></div>';
  } else {
    title = "What was written";
    const keptN = (G.chronicle && G.chronicle.kept) ? G.chronicle.kept.length : 0;
    const lostN = (G.chronicle && G.chronicle.lost) ? G.chronicle.lost.length : 0;
    body = onumP("The book, the lines a person kept, the lines nobody wrote, the precedents, the soundings, the races, and the letters. Each one opens in full.") +
      '<div class="card__actions" style="flex-wrap:wrap;gap:6px">' +
      '<button type="button" class="btn" data-wr="book">The book</button>' +
      '<button type="button" class="btn" data-wr="kept">Kept (' + keptN + ') and lost (' + lostN + ')</button>' +
      '<button type="button" class="btn" data-wr="prec">Precedent</button>' +
      '<button type="button" class="btn" data-wr="poll">The soundings</button>' +
      '<button type="button" class="btn" data-wr="races">The races</button>' +
      '<button type="button" class="btn" data-wr="letters">Letters and the houses</button></div>';
  }
  body += back;
  govCardOpen("The written record", title, "A thing is history when a person who was there writes it down. The rest is remembered, and that is not the same thing.", body, null);
  const idx = document.getElementById("wrIndex"); if(idx) idx.addEventListener("click", function(){ onumWrittenCard("index"); });
  const air = document.getElementById("wrAir"); if(air) air.addEventListener("click", function(){ onumAirCard("day"); });
  const prev = document.getElementById("wrPrev"); if(prev) prev.addEventListener("click", function(){ onumWrittenCard("book", -1); });
  const next = document.getElementById("wrNext"); if(next) next.addEventListener("click", function(){ onumWrittenCard("book", 1); });
  const fam = document.getElementById("wrFam"); if(fam) fam.addEventListener("click", function(){ try{ onumFamilyCard(); }catch(e){} });
  card.querySelectorAll("[data-wr]").forEach(b => b.addEventListener("click", function(){ onumWrittenCard(b.getAttribute("data-wr")); }));
}
function onumNightLedeHTML(){
  const n = onumNightBook();
  if(!n || !n.copy) return "";
  const c = n.copy;
  return '<h2>The Union Broadcast</h2>' +
    onumP(n.late + (n.home ? " " + n.home : "")) +
    '<div class="eyebrow">Filed by ' + onumEsc(c.reporter || "the desk") + '</div>' + onumP(c.filed || "") +
    '<div class="eyebrow">Held' + (c.note ? " · " + onumEsc(c.note) : "") + '</div>' + onumP(c.held || "") +
    '<div class="eyebrow">Read by ' + onumEsc(c.anchor || "the anchor") + '</div>' + onumP(c.read || "");
}

{ const _el = election; election = function(){
  const r = _el.apply(this, arguments);
  try{
    const block = document.createElement("div");
    block.innerHTML = onumNightLedeHTML();
    const actions = card.querySelector(".card__actions");
    if(actions) card.insertBefore(block, actions);
    if(actions && !document.getElementById("elAir")){
      const b = document.createElement("button");
      b.id = "elAir"; b.type = "button"; b.className = "btn";
      b.textContent = "The whole night";
      b.addEventListener("click", function(){ onumAirCard("one", 0); });
      actions.insertBefore(b, actions.firstChild);
    }
  }catch(e){}
  return r;
}; }
{ const _pc = paperCard; paperCard = function(){
  const r = _pc.apply(this, arguments);
  try{
    const bar = card && card.querySelector(".card__actions");
    if(bar && !document.getElementById("lpAir")){
      const b = document.createElement("button");
      b.id = "lpAir"; b.type = "button"; b.className = "btn";
      b.textContent = "The broadcast";
      b.addEventListener("click", function(){ onumAirCard("day"); });
      bar.insertBefore(b, bar.firstChild);
      const w = document.createElement("button");
      w.type = "button"; w.className = "btn btn--ghost";
      w.textContent = "What was written";
      w.addEventListener("click", function(){ onumWrittenCard("index"); });
      bar.insertBefore(w, b.nextSibling);
    }
  }catch(e){}
  return r;
}; }
{ const _mh = makeHeadlines; makeHeadlines = function(){
  const H = _mh.apply(this, arguments) || [];
  try{
    const cast = onumCasters();
    if(cast[0]) H.unshift(["Broadcast", cast[0].p.name + " at " + (cast[0].p.outlet || "the desk") + " is on the night cast. The editor holds the copy before it airs."]);
    const n = (G.newsroom && G.newsroom.nights && G.newsroom.nights[0]) || null;
    if(n) H.unshift(["Election", "Congress " + n.congress + ": " + (n.won ? "held" : "lost") + " by " + n.margin + ". " + (n.copy && n.copy.note ? n.copy.note : "")]);
  }catch(e){}
  return H;
}; }
{ const _life = lifeContext; lifeContext = function(){
  const out = _life.apply(this, arguments) || [];
  try{
    const cast = onumCasters();
    const a = cast[0];
    if(a) out.push({k:"air", a:[
      "Did you watch " + a.p.name + "? They read the count and then they said they were not the clerk.",
      "The editor cut a line tonight. I want to know what was cut."
    ], b:[
      "I heard the number. I did not hear them pretend it was theirs.",
      "If it was not sourced, it should not have aired. That is the whole job."
    ], w:2});
  }catch(e){}
  return out;
}; }
{ const _dk = onumDeskCard; onumDeskCard = function(o){
  const r = _dk.apply(this, arguments);
  try{
    const rec = document.getElementById("dkRec");
    if(rec && rec.parentNode && !document.getElementById("dkAir")){
      const b = document.createElement("button");
      b.id = "dkAir"; b.type = "button"; b.className = "btn btn--ghost"; b.textContent = "The broadcast";
      b.addEventListener("click", function(){ onumAirCard("day"); });
      rec.parentNode.appendChild(b);
      const w = document.createElement("button");
      w.type = "button"; w.className = "btn btn--ghost"; w.textContent = "What was written";
      w.addEventListener("click", function(){ onumWrittenCard("index"); });
      rec.parentNode.appendChild(w);
    }
  }catch(e){}
  return r;
}; }
{ const _apps = pbApps; pbApps = function(){
  const L = _apps.apply(this, arguments) || [];
  if(!L.some(x => x[0] === "soc-air")) L.push(["soc-air", "The broadcast", "The night desk: who filed it, who held it, who read it."]);
  if(!L.some(x => x[0] === "soc-written")) L.push(["soc-written", "What was written", "The book, the kept lines, the precedents, the soundings, the races."]);
  return L;
}; }
{ const _go = pbAppGo; pbAppGo = function(id){
  if(id === "soc-air"){ setTimeout(function(){ try{ onumAirCard("day"); }catch(e){} }, 30); return; }
  if(id === "soc-written"){ setTimeout(function(){ try{ onumWrittenCard("index"); }catch(e){} }, 30); return; }
  return _go.apply(this, arguments);
}; }
{ const _sc = saveCaptureBase; saveCaptureBase = function(){
  const o = _sc.apply(this, arguments);
  try{ o.newsroom = G.newsroom || null; }catch(e){}
  return o;
}; }

setInterval(function(){
  try{
    if(!G || !G.you) return;
    const N = onumNewsroom();
    if(N.airDay == null) N.airDay = G.day;
    else if(N.airDay !== G.day){ N.airDay = G.day; onumAirFileDay(); }
    const d = document.getElementById("onumSeeDock");
