  return _nb.apply(this, arguments); }; }
{ const _lb3 = lxBook; lxBook = function(f){ if(f === "hopper"){ const H = hopStore(), D = (lxStore().died || []);
    lxOpen('<div class="eyebrow">The committees</div><h1>Bills filed, in committee, and died there</h1><p class="muted">Most bills never reach the floor. Each is referred to the committee whose field it touches; the chair decides when to mark it up, and the committee decides whether the House ever sees it.</p>' +
