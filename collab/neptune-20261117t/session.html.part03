  try{ mine.forEach(t => { const m = /^(.+?) (passed|threw out) its (.+?)(?:, (\d+) to (\d+))?\.$/.exec(t); if(m){ const L = lxStore(); (L.sacts = L.sacts || []).unshift({st:m[1], t:m[3], d:G.day, ok:m[2] === "passed", aye:m[4] != null ? +m[4] : null, no:m[5] != null ? +m[5] : null}); if(L.sacts.length > onumLim(60,"hist")) L.sacts.length = onumLim(60,"hist"); } }); }catch(e){}
