function onumPrecLine(){
  try{
    const h = citePrecedent();
    if(h && h.precedent) return "The record already holds: " + h.precedent + ".";
  }catch(e){}
  return "";
}
function onumLore(){
  if(!G.chronicle || G.chronicle.v !== 1) G.chronicle = {v:1, kept:[], lost:[]};
  return G.chronicle;
}
function onumKeep(text, aboutId){
  const L = onumLore();
  const line = String(text || "").slice(0, 320);
  if(!line) return;
  let keeper = null;
  try{
    const press = (G.press || []).filter(p => p && !p.gone);
    const clerks = (G.members || []).filter(m => m && !m.gone && m.traits && m.traits.discretion > 58);
    keeper = (Math.random() < 0.55 ? press[0] : clerks[0]) || press[0] || clerks[0] || null;
  }catch(e){}
  if(keeper && Math.random() < 0.7){
    L.kept.push({d:G.day, who:keeper.name, t:line, about:aboutId || null});
    if(L.kept.length > 80) L.kept.shift();
    try{ onumWebPush(keeper.kind === "press" ? (keeper.outlet || keeper.name) : keeper.name, keeper.kind === "press" ? "paper" : "personal", line); }catch(e){}
    try{ if(aboutId){ const m = byId(aboutId); if(m) remember(m, "It was written down: " + line.slice(0, 140), 2); } }catch(e){}
  } else {
    L.lost.push({d:G.day, t:line});
    if(L.lost.length > 40) L.lost.shift();
    try{ if(aboutId){ const m = byId(aboutId); if(m) remember(m, line.slice(0, 140), 2); } }catch(e){}
  }
}

function onumAppointDeep(kind){
  const y = G.you; if(!y) return;
  if(kind === "cab" && heldOffice() !== "pres"){ try{ note("Only the Executive sends a cabinet name."); }catch(e){} return; }
  if(kind !== "cab" && heldOffice() !== "gov" && heldOffice() !== "pres"){ try{ note("That appointment is not yours to make."); }catch(e){} return; }
  const posts = kind === "cab"
    ? [{k:"treasury", t:"Secretary of the Treasury"}, {k:"state", t:"Secretary of State"}, {k:"war", t:"Secretary of War"}, {k:"justice", t:"Attorney General"}]
    : [{k:kind, t:(APPT[kind] && APPT[kind].post) || "the open chair"}];
  let st = null; try{ st = presStaff(); }catch(e){}
  const body = posts.map((p, i) => {
    const cur = st && st[p.k];
    return '<div style="margin:8px 0"><button type="button" class="btn" data-apch="' + i + '">' + onumEsc(p.t) + '</button> <span class="muted">' + (cur ? "now " + onumEsc(cur.name) : "empty") + "</span></div>";
  }).join("");
  govCardOpen("A cabinet chair", "A person, a hearing, a vote", "You do not appoint a title. You appoint a person. The Senate says yes or no in their own names. " + onumPrecLine(), body, null);
  card.querySelectorAll("[data-apch]").forEach(b => b.addEventListener("click", () => onumApptFile(posts[+b.getAttribute("data-apch")])));
}
function onumApptPeople(post){
  const y = G.you;
  const S = (G.states || []).find(s => s.n === y.state) || {n:y.state};
  return [0, 1, 2].map(i => {
    const o = mkOfficial("seat:" + post.k + ":" + G.day + ":" + i, S, post.t);
    if(i === 0 && o.pos) o.pos.econ = clamp((o.pos.econ || 0) + 28, -100, 100);
    if(i === 1 && o.pos) o.pos.lib = clamp((o.pos.lib || 0) + 28, -100, 100);
    let town = y.state; try{ const ts = townsOf(y.state); if(ts && ts.length) town = ts[i % ts.length].name || town; }catch(e){}
    o.town = town;
    o.prior = (o.bg || "the work") + " in " + town;
    return o;
  });
}
function onumApptFile(post){
  const people = onumApptPeople(post);
  const body = people.map((o, i) => '<div style="margin:10px 0;padding:8px 10px;border-left:3px solid var(--line-soft)">' +
    (typeof officialHTML === "function" ? officialHTML(o) : "<b>" + onumEsc(o.name) + "</b>") +
    '<p style="margin:6px 0">' + onumEsc(o.name) + " comes from " + onumEsc(o.town) + ". Before this, " + onumEsc(o.prior) + ".</p>" +
    '<div class="card__actions"><button type="button" class="btn btn--ghost" data-aq="' + i + '">Ask them, as themselves</button><button type="button" class="btn" data-an="' + i + '">Send this name to the Senate</button></div><div class="dream" id="aq_' + i + '"></div></div>').join("");
  govCardOpen(post.t, "Three people. One name.", "Interview is not the appointment. The name still has to survive a hearing.", body, null);
  card.querySelectorAll("[data-aq]").forEach(b => b.addEventListener("click", () => {
    const o = people[+b.getAttribute("data-aq")];
    let creed = ""; try{ const c = creedOf(o.creed); if(c) creed = " I hold " + c.t + "."; }catch(e){}
    el("aq_" + b.getAttribute("data-aq")).textContent = o.name + ": I am " + (o.bg || "what the file says") + ", from " + o.town + "." + creed + " I will do the work of " + post.t + " as I see it, and I will tell you when I think you are wrong.";
  }));
  card.querySelectorAll("[data-an]").forEach(b => b.addEventListener("click", () => onumApptHearing(post, people[+b.getAttribute("data-an")])));
}
function onumApptHearing(post, o){
  if(!o) return;
  const sens = (G.members || []).filter(m => m && !m.gone && m.kind === "member").slice(0, 3);
  while(sens.length < 3) sens.push(null);
  let av = {ok:true, aye:11, no:7, body:"the Senate"};
  try{ av = apptVote("cab", o, (G.states || []).find(s => s.n === G.you.state)) || av; }catch(e){}
  const rows = sens.map((m, i) => {
    if(!m) return "";
    let aye = true; try{ aye = (m.party === G.you.party) ? av.ok || (m.traits && m.traits.loyalty > 40) : !av.ok; }catch(e){}
    if(i === 2) aye = !aye;
    const why = aye
      ? "I will vote aye. Not because the chair asked. Because " + (m.state || "my state") + " can live with this name."
      : "I will vote no. I have read the file. I do not owe this chair a quiet afternoon.";
    return '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + onumEsc(m.name) + '</b> <span class="muted">· ' + onumEsc(m.state || "") + ' · ' + (aye ? "aye" : "no") + '</span><p>“' + onumEsc(why) + '”</p></div>';
  }).join("");
  const prec = onumPrecLine();
  const body = '<p>' + onumEsc(o.name) + ' sits at the table. The questions are about ' + onumEsc(post.t) + ', not about a mood.</p>' +
    (prec ? '<p class="muted">' + onumEsc(prec) + '</p>' : '') + rows +
    '<p><b>The roll:</b> ' + av.aye + ' aye, ' + av.no + ' no. ' + (av.ok ? "The name carries." : "The name fails.") + '</p>' +
    '<div class="card__actions"><button type="button" class="btn" id="apSeal">' + (av.ok ? "Swear them in" : "Withdraw the name") + '</button></div>';
  govCardOpen("The hearing", o.name, "Confirmed or not, this is on the record if someone writes it down.", body, null);
  const seal = el("apSeal");
  if(seal) seal.addEventListener("click", () => {
    if(av.ok){
      try{ const st = presStaff(); st[post.k] = o; }catch(e){}
      try{ onumSeatCabinet(); _hereCache = null; _allCache = null; }catch(e){}
      try{ setPrecedent("confirmed " + o.name + " as " + post.t, "a cabinet secretary is a named person, confirmed by the Senate, and seated at the table", true); }catch(e){}
      onumKeep(o.name + " was confirmed as " + post.t + ", " + av.aye + " to " + av.no + ", and took the chair.", null);
      try{ onumWebPush(o.name, "personal", "I was confirmed as " + post.t + ". I will do the work in my own name."); }catch(e){}
      try{ voxInit(); voxYouPost("note", null, "The Senate confirmed " + o.name + " as " + post.t + "."); }catch(e){}
      el("gcSay").textContent = o.name + " is sworn. They have the chair, the file, and a seat at the cabinet table.";
    } else {
      onumKeep("The Senate refused " + o.name + " for " + post.t + ", " + av.aye + " to " + av.no + ". The chair stays as it was.", null);
      try{ onumWebPush(o.name, "personal", "My name was refused for " + post.t + ". I will say so myself. The work was not given to me."); }catch(e){}
      el("gcSay").textContent = o.name + " is not sworn. The seat is still the person who held it this morning. The hearing is in the record" + (onumLore().kept.length ? ", written down." : ", if anyone kept it.");
    }
    seal.disabled = true;
  });
}

function onumMkt(){
  if(!G.mkt || G.mkt.v !== 1) G.mkt = {v:1, px:{grain:42, iron:70, rail:55, press:28, sport:22}, hist:[], day:-1};
  return G.mkt;
}
function onumMktTick(scale){
  const M = onumMkt();
  if(!G.money) G.money = {index:100, hist:[100]};
  const wobble = (Math.random() - 0.48) * 0.35 * (scale || 0.4);
  G.money.index = Math.round(clamp(G.money.index + wobble, 42, 190) * 10) / 10;
  G.money.hist = G.money.hist || [];
  G.money.hist.push(G.money.index);
  if(G.money.hist.length > 48) G.money.hist.shift();
  const g = G.money.index;
  const pull = (g - 100) / 100;
  Object.keys(M.px).forEach(k => {
    const j = (Math.random() - 0.48) * (scale || 0.4) + pull * 0.15;
    M.px[k] = Math.round(clamp(M.px[k] * (1 + j * 0.012), 8, 240) * 10) / 10;
  });
  onumStocks().forEach(s => {
    const j = (Math.random() - 0.47) * (scale || 0.4) + pull * 0.2;
    const next = Math.round(clamp(s.px * (1 + j * 0.02), 4, 400) * 10) / 10;
    if(s.px && next < s.px * 0.9) onumKeep(s.t + " fell from " + s.px + " to " + next + " while the guilder stood at " + g.toFixed(1) + ".", null);
    s.px = next;
  });
  M.hist.push({d:G.day, m:G.minute || 0, g:Math.round(g * 10) / 10, px:Object.assign({}, M.px)});
  if(M.hist.length > 48) M.hist.shift();
  if(Math.random() < 0.45) onumShopper();
}
function onumShops(){
  const M = onumMkt();
  if(M.shops && M.shops.length) return M.shops;
  const y = G.you || {state:"home"};
  let towns = [y.state];
  try{ const ts = townsOf(y.state); if(ts && ts.length) towns = ts.map(t => t.name).slice(0, 4); }catch(e){}
  const kinds = [["grocer","grain"],["ironmonger","iron"],["bookseller","press"],["cloth","rail"],["tavern","grain"],["music hall","sport"]];
  M.shops = kinds.map((pair, i) => {
    let owner = "A. Keeper"; try{ owner = newName(y.state); }catch(e){}
    return {id:"sh" + i, kind:pair[0], book:pair[1], owner:owner, town:towns[i % towns.length], markup:Math.round((0.92 + (i % 5) * 0.05) * 100) / 100, till:40 + i * 7, loyal:[]};
  });
  return M.shops;
}
function onumPrice(shop){
  const M = onumMkt();
  const base = (M.px && M.px[shop.book]) || 40;
  const g = (typeof guilderIndex === "function") ? guilderIndex() : 100;
  return Math.round(base * (g / 100) * (shop.markup || 1) * 10) / 10;
}
function onumStocks(){
  const M = onumMkt();
  if(M.stocks && M.stocks.length) return M.stocks;
  M.stocks = [
    {k:"dock", t:"Oranje Dock", px:48, own:0},
    {k:"line", t:"Havenport Lines", px:36, own:0},
    {k:"seam", t:"Coalport Seam", px:22, own:0},
    {k:"grange", t:"Grange & Grain", px:31, own:0},
    {k:"ord", t:"Ordnance Works", px:64, own:0},
    {k:"press", t:"Evening Press", px:18, own:0},
    {k:"isle", t:"Salt Isle Fisheries", px:27, own:0},
    {k:"silv", t:"Kestrel Silver", px:41, own:0}
  ];
  return M.stocks;
}
function onumShopper(){
  const shops = onumShops();
  if(!shops.length) return;
  let who = null;
  try{
    const pool = (G.members || []).concat(G.civ || []).filter(p => p && !p.gone && p !== G.you && p.name);
    if(pool.length) who = pool[Math.floor(Math.random() * pool.length)];
  }catch(e){}
  if(!who) return;
  const book = shops[Math.floor(Math.random() * shops.length)].book;
  const opts = shops.filter(s => s.book === book).slice().sort((a, b) => onumPrice(a) - onumPrice(b));
  if(!opts.length) return;
  const cheap = opts[0];
  const goesCheap = opts.length < 2 || Math.random() < 0.62 || onumPrice(opts[opts.length - 1]) > onumPrice(cheap) * 1.08;
  const pickShop = goesCheap ? cheap : opts[opts.length - 1];
  pickShop.loyal = pickShop.loyal || [];
  if(pickShop.loyal.indexOf(who.name) < 0) pickShop.loyal.push(who.name);
  if(pickShop.loyal.length > 6) pickShop.loyal.shift();
  if(pickShop === cheap) pickShop.till += 1;
  else pickShop.till = Math.max(0, pickShop.till - 1);
  const prec = onumPrecLine();
  pickShop.last = who.name + " paid " + onumPrice(pickShop) + " for " + book + (pickShop === cheap ? ", the same book everyone else is bound to." : " at " + pickShop.owner + "'s, though " + cheap.owner + " had it for " + onumPrice(cheap) + ".") + (prec && Math.random() < 0.25 ? " " + prec : "");
}
function onumTrade(k, side){
  const s = onumStocks().find(x => x.k === k);
  const y = G.you;
  if(!s || !y) return "The book is closed.";
  const px = s.px;
  if(side === "buy"){
    if((y.funds || 0) < px) return "The chest does not cover " + s.t + " at " + px + ".";
    y.funds = Math.round(((y.funds || 0) - px) * 10) / 10;
    s.own = (s.own || 0) + 1;
    try{ setPrecedent("bought " + s.t + " at " + px, "a share is a named company at the book price, paid from the chest", true); }catch(e){}
    onumKeep(y.name + " bought one share of " + s.t + " at " + px + ".", null);
    return "Bought one " + s.t + " at " + px + ". You hold " + s.own + ".";
  }
  if(!s.own) return "You do not hold " + s.t + ".";
  s.own -= 1;
  y.funds = Math.round(((y.funds || 0) + px) * 10) / 10;
  onumKeep(y.name + " sold one share of " + s.t + " at " + px + ".", null);
  return "Sold one " + s.t + " at " + px + ". The chest has it.";
}
function onumTeams(){
  const M = onumMkt();
  if(M.teams && M.teams.length) return M.teams;
  const sts = (G.states || []).slice(0, 6);
  M.teams = (sts.length ? sts : [{n:(G.you && G.you.state) || "Home"}]).map(s => ({name:s.n + " Side", from:s.n, w:0, l:0}));
  if(M.teams.length === 1) M.teams.push({name:"the County Seat", from:M.teams[0].from, w:0, l:0});
  return M.teams;
}
function onumLiveDay(){
  const M = onumMkt();
  if(M.day === G.day) return;
  M.day = G.day;
  onumMktTick(1);
  const shops = onumShops();
  const book = {};
  shops.forEach(s => { const p = onumPrice(s); if(book[s.book] == null || p < book[s.book]) book[s.book] = p; });
  shops.forEach(s => {
    const p = onumPrice(s);
    const cheap = book[s.book];
    const elsewhere = p > cheap * 1.08 && Math.random() < 0.55;
    if(elsewhere){ s.till = Math.max(0, s.till - 4); s.last = "Some regulars went to the cheaper " + s.kind + " rather than pay " + p + "."; }
    else { s.till += 3; s.last = "The counter took the book price, " + p + ", and people stayed."; }
  });
  const teams = onumTeams();
  if(teams.length >= 2 && (G.day % 2 === 0)){
    const a = teams[(G.day || 0) % teams.length], b = teams[((G.day || 0) + 1) % teams.length];
    const aw = Math.random() < 0.5;
    if(aw){ a.w++; b.l++; } else { b.w++; a.l++; }
    M.lastMatch = (aw ? a.name : b.name) + " beat " + (aw ? b.name : a.name) + ".";
    try{ onumWebPush(aw ? a.name : b.name, "personal", M.lastMatch + " We play as ourselves, not as a slogan."); }catch(e){}
    onumKeep(M.lastMatch, null);
  }
  if(Math.random() < 0.35){
    let who = "Someone"; try{ who = newName((G.you && G.you.state) || null); }catch(e){}
    const made = Math.random() < 0.5
      ? who + " put a song in the music hall. It is about the week, not about the capital."
      : who + " took a shift as " + (typeof CA_JOBS !== "undefined" ? CA_JOBS[(G.day || 0) % CA_JOBS.length][0] : "a clerk") + " and did not ask to be famous for it.";
    M.made = M.made || []; M.made.unshift({d:G.day, t:made}); if(M.made.length > 12) M.made.pop();
    onumKeep(made, null);
  }
}
function onumMarketCard(){
  onumLiveDay();
  const M = onumMkt();
  const g = (typeof guilderIndex === "function") ? guilderIndex() : 100;
  const bars = (M.hist || []).slice(-16).map(h => '<i title="' + h.g + '" style="display:inline-block;width:8px;height:' + Math.max(4, Math.round((h.g || 100) * 0.35)) + 'px;background:#c9a24a;margin:0 1px;vertical-align:bottom"></i>').join("");
  const px = Object.keys(M.px).map(k => '<div>' + onumEsc(k) + ' · ' + M.px[k] + '</div>').join("");
  const stocks = onumStocks().map(s => '<div style="margin:6px 0"><b>' + onumEsc(s.t) + '</b> <span class="muted">· ' + s.px + ' · you hold ' + (s.own || 0) + '</span> <button type="button" class="btn" data-stk="b:' + s.k + '">Buy</button> <button type="button" class="btn btn--ghost" data-stk="s:' + s.k + '">Sell</button></div>').join("");
  const prec = onumPrecLine();
  govCardOpen("The market", "One price book, and the shares", "Every shop uses the same prices. A shop may mark them up. People may walk to the cheaper door. The guilder and the shares move while you stand here, not only when the day turns.", '<p>The guilder stands at <b>' + g.toFixed(1) + '</b>. The chest has <b>' + ((G.you && G.you.funds) || 0) + '</b>.</p><div style="line-height:0;margin:6px 0">' + bars + '</div><div class="eyebrow">The book</div>' + px + '<div class="eyebrow">The shares</div>' + stocks + (prec ? '<p class="muted">' + onumEsc(prec) + '</p>' : '') + '<div class="card__actions"><button type="button" class="btn" id="mktShops">Who owns the shops</button></div><div class="dream" id="mktSay"></div>', null);
  const b = el("mktShops"); if(b) b.addEventListener("click", () => onumDistrictCard());
  card.querySelectorAll("[data-stk]").forEach(btn => btn.addEventListener("click", () => {
    const parts = (btn.getAttribute("data-stk") || "").split(":");
    const msg = onumTrade(parts[1], parts[0] === "b" ? "buy" : "sell");
    const s = el("mktSay"); if(s) s.textContent = msg;
    const chest = card.querySelector("b"); if(chest && G.you) { /* leave the guilder line; the say is enough */ }
  }));
}
function onumDistrictCard(){
  onumLiveDay();
  const shops = onumShops();
  const teams = onumTeams();
  const M = onumMkt();
  const rows = shops.map(s => '<div style="margin:6px 0"><b>' + onumEsc(s.owner) + '</b> <span class="muted">· ' + onumEsc(s.kind) + ' · ' + onumEsc(s.town) + ' · book ' + s.book + ' at ' + onumPrice(s) + ' · till ' + s.till + (s.loyal && s.loyal.length ? ' · ' + onumEsc(s.loyal.slice(-3).join(", ")) : '') + '</span><div class="muted">' + onumEsc(s.last || "Open.") + '</div></div>').join("");
  const match = M.lastMatch ? '<p>' + onumEsc(M.lastMatch) + '</p>' : '<p class="muted">No match today.</p>';
  const side = teams.map(t => onumEsc(t.name) + " " + t.w + "-" + t.l).join(" · ");
  const made = (M.made || []).slice(0, 4).map(x => '<div class="muted">d' + x.d + ' · ' + onumEsc(x.t) + '</div>').join("");
  const L = onumLore();
  const kept = (L.kept || []).slice(-3).map(x => '<div>Kept by ' + onumEsc(x.who) + ': ' + onumEsc(x.t) + '</div>').join("");
  govCardOpen("The district", "It runs when you are not looking", "Shops have owners. Prices are the book. Some people shop elsewhere. Some write the day down. Some do not.", rows + '<div class="eyebrow">The match</div>' + match + '<p class="muted">' + side + '</p><div class="eyebrow">What people made</div>' + (made || '<p class="muted">An ordinary day.</p>') + '<div class="eyebrow">What was kept</div>' + (kept || '<p class="muted">Nothing written down yet.</p>'), null);
}

function onumMarry(m){
  const y = G.you; if(!y || !m) return "There is no one to ask.";
  const sp = onumSpouse(m);
  if(sp) return m.name + ": I am already married to " + sp.name.split(" ")[0] + ". Ask me for anything else.";
  let mine = null; try{ mine = onumSpouse(y); }catch(e){}
  if(mine) return "You already have " + mine.name + ".";
  const w = (m.rel && m.rel.warmth) || 0;
  const days = (G.day || 1) - (y.courtSince || G.day || 1);
  if(y.courtId !== m.id || w < 36 || days < 2) return onumOwn(m) + " That is a life, not a favour. We are not there.";
  try{ famEnsure(); }catch(e){}
  const F = G.fam; if(F){
    F.p[m.id] = F.p[m.id] || {name:m.name, spouse:null, kids:[], parents:[], sibs:[], kin:[], feuds:[]};
    F.p[y.id] = F.p[y.id] || {name:y.name, spouse:null, kids:[], parents:[], sibs:[], kin:[], feuds:[]};
    F.p[m.id].spouse = {name:y.name, job:officeTitle()};
    F.p[y.id].spouse = {name:m.name, job:m.role || "in the building"};
    F.events = F.events || [];
    F.events.push({k:"wedding", t:y.name + " and " + m.name + " were married.", id:m.id, d:G.day});
    try{ famPublish(); }catch(e){}
  }
  onumTouch(m, 8, "spouse");
  y.courtId = null;
  try{ setPrecedent("married " + m.name, "a marriage is two named people, and it stays on the record only if someone writes it down", true); }catch(e){}
  onumKeep(y.name + " married " + m.name + ".", m.id);
  try{ onumWebPush(m.name, "personal", "I married " + y.name.split(" ")[0] + ". I am saying it myself, so nobody else gets to invent it."); }catch(e){}
  return m.name + ": Yes. Not to the office. To you. We will tell it in our own names.";
}
{ const _sa = onumSocActs; onumSocActs = function(m){
  const A = _sa.apply(this, arguments) || [];
  if(!m || m === G.you || m.machine) return A;
  A.push({t:"Ask them to marry you", c:"a life", risk:true, run:function(){
    try{ spend(20, 2); }catch(e){}
    const t = onumMarry(m);
    try{ setSay(t, ""); }catch(e){}
  }});
  return A;
}; }
{ const _fd = famDay; famDay = function(){
  const n0 = (G.fam && G.fam.events) ? G.fam.events.length : 0;
  const r = _fd.apply(this, arguments);
  try{
    const evs = (G.fam && G.fam.events) || [];
    for(let i = n0; i < evs.length; i++) onumKeep(evs[i].t, evs[i].id);
  }catch(e){}
  return r;
}; }
{ const _sd = standDay; standDay = function(){ const r = _sd.apply(this, arguments); try{ onumLiveDay(); }catch(e){} return r; }; }

function onumPhoneVox(){
  try{ voxInit(); }catch(e){}
  const all = ((G.vox && G.vox.posts) || []);
  const mine = all.filter(p => p.mine);
  const rest = all.filter(p => !p.mine).slice(0, 12);
  const posts = mine.concat(rest);
  let b = '<div class="pb__h">Vox</div><p><small>Your posts, all of them, then the rest of the feed. Nothing here is rewritten.</small></p>';
  b += '<p><small>' + mine.length + ' under your name.</small></p>';
  if(!posts.length) b += '<p>Nobody has spoken yet.</p>';
  posts.forEach(p => {
    const a = p.mine ? G.you : (function(){ try{ return byId(p.by); }catch(e){ return null; } })();
    const nm = p.mine ? ((G.you && G.you.name) || "You") : (a ? a.name : "Someone");
    b += '<div class="pb__row" style="' + (p.mine ? 'border-left:3px solid #c9a24a;padding-left:6px' : '') + '"><span><b>' + onumEsc(nm) + (p.mine ? ' · you' : '') + '</b><br><small>' + onumEsc(String(p.t || "")) + '</small></span></div>';
  });
  b += '<div class="pb__row"><button data-pbvoxw="1">Write on Vox</button></div>';
  return b;
}
{ const _pb = pbHTML; pbHTML = function(){
  let html = _pb.apply(this, arguments);
  const on = PB.tab === "vox" ? ' class="is-on"' : "";
  html = html.replace(">Chat</button>", '>Chat</button><button data-pbt="vox"' + on + '>Vox</button>');
  if(PB.tab === "vox") html = html.replace(/<div class="pb__body">[\s\S]*<\/div>\s*$/, '<div class="pb__body">' + onumPhoneVox() + '</div>');
  return html;
}; }
document.addEventListener("click", function(ev){
  const t = ev.target && ev.target.closest && ev.target.closest("[data-pbvoxw]");
  if(!t) return;
  ev.preventDefault(); ev.stopPropagation();
  const opts = [
    ["The work", "I did the work today and I am saying so in my own words."],
    ["Home", "Home is not a backdrop. I am writing what they actually asked me."],
    ["A person", "There is a person in this, not only a vote. I will not let the feed invent them."]
  ];
  const body = opts.map((o, i) => '<div style="margin:8px 0"><button type="button" class="btn" data-vx="' + i + '">' + onumEsc(o[0]) + '</button><div class="muted">' + onumEsc(o[1]) + '</div></div>').join("") +
    '<div style="margin-top:10px"><input id="vxOwn" placeholder="Or write the sentence yourself" style="width:100%;box-sizing:border-box"><div style="margin-top:6px"><button type="button" class="btn" id="vxSend">Post that, as I wrote it</button></div></div>';
  govCardOpen("Vox", "Under your name", "It posts the words you chose. The feed does not improve them.", body, null);
  const say = t => {
    const text = String(t || "").trim();
    if(!text) return;
    try{ voxYouPost("note", null, text); }catch(e){}
    const s = el("gcSay"); if(s) s.textContent = "Posted on Vox, in your name, as written.";
    try{ if(typeof pbRender === "function" && PB.tab === "vox") pbRender(); }catch(e){}
  };
  card.querySelectorAll("[data-vx]").forEach(b => b.addEventListener("click", () => {
    const o = opts[+b.getAttribute("data-vx")];
    say(o && o[1]);
  }));
  const send = el("vxSend");
  if(send) send.addEventListener("click", () => { const i = el("vxOwn"); say(i && i.value); });
}, true);
{ const _apps = pbApps; pbApps = function(){
  const L = _apps.apply(this, arguments) || [];
  [["soc-desk","The desk","Every desk task, including the cabinet table, on a page that does not vanish."],
   ["soc-mkt","The market","The guilder, the price book, and who is charging more."],
   ["soc-dist","The district","Shops with owners, the match, and what was written down."]
  ].forEach(a => { if(!L.some(x => x[0] === a[0])) L.push(a); });
  return L;
}; }
{ const _go = pbAppGo; pbAppGo = function(id){
  if(id === "soc-desk"){ setTimeout(function(){ try{ onumDeskCard({id:"kxdesk", label:"The desk"}); }catch(e){} }, 30); return; }
  if(id === "soc-mkt"){ setTimeout(function(){ try{ onumMarketCard(); }catch(e){} }, 30); return; }
  if(id === "soc-dist"){ setTimeout(function(){ try{ onumDistrictCard(); }catch(e){} }, 30); return; }
  return _go.apply(this, arguments);
}; }

{ const _rm = renderMap; renderMap = function(sel){
  try{
    const S = G.states || [];
    if(!S.length) return _rm.apply(this, arguments);
    const CW = 72, CH = 58, OX = 230, OY = 168, W = 980, H = 720;
    const cols = Math.max.apply(null, S.map(s => (s.col | 0))) + 1;
    const rows = Math.max.apply(null, S.map(s => (s.row | 0))) + 1;
    const cell = (c, r) => S.find(s => (s.col | 0) === c && (s.row | 0) === r);
    const vx = (c, r) => {
      const x = OX + c * CW, y = OY + r * CH;
      let land = 0;
      for(let dc = -1; dc <= 0; dc++) for(let dr = -1; dr <= 0; dr++) if(cell(c + dc, r + dr)) land++;
      if(!land || land === 4) return [x, y];
      let ox = 0, oy = 0;
      if(!cell(c - 1, r - 1) && !cell(c - 1, r)) ox -= 16;
      if(!cell(c, r - 1) && !cell(c, r)) ox += 16;
      if(!cell(c - 1, r - 1) && !cell(c, r - 1)) oy -= 12;
      if(!cell(c - 1, r) && !cell(c, r)) oy += 12;
      ox += Math.sin(c * 2.1 + r * 0.7) * 6;
      oy += Math.cos(c * 0.9 + r * 1.8) * 5;
      return [x + ox, y + oy];
    };
    const foe = k => !!(G.world && G.world.foe === k);
    const fillOf = k => foe(k) ? "#6e2e2e" : (k === "pale" ? "#5c6e78" : k === "horn" ? "#6a5432" : k === "isles" ? "#2f4a44" : "#3e5344");
    let g = '<svg viewBox="0 0 ' + W + ' ' + H + '" style="width:100%;height:auto;background:#16344c" role="img" aria-label="The world, and the nation in it">';
    g += '<rect width="' + W + '" height="' + H + '" fill="#16344c"/>';
    g += '<text x="24" y="30" fill="#e7eef4" font-family="Georgia,serif" font-size="18">The world</text>';
    g += '<path d="M48,70 C140,36 300,28 460,58 C430,108 250,124 90,112 C40,104 28,88 48,70 Z" fill="' + fillOf("pale") + '" stroke="#d8c78f" stroke-width="1.3"/>';
    g += '<text x="86" y="86" fill="#f3ead2" font-size="12" font-family="Georgia,serif">the Pale · north' + (foe("pale") ? " · at odds" : "") + '</text>';
    g += '<path d="M36,148 C78,124 150,138 162,210 C154,360 148,500 118,575 C62,552 22,400 20,270 C18,190 22,160 36,148 Z" fill="' + fillOf("marches") + '" stroke="#d8c78f" stroke-width="1.3"/>';
    g += '<text x="52" y="360" fill="#f3ead2" font-size="12" font-family="Georgia,serif" transform="rotate(-90 52 360)">the Free Marches · west' + (foe("marches") ? " · at odds" : "") + '</text>';
    g += '<path d="M828,140 C910,112 968,168 956,290 C948,430 924,545 848,568 C792,500 786,330 802,210 C808,160 800,148 828,140 Z" fill="' + fillOf("reach") + '" stroke="#d8c78f" stroke-width="1.3"/>';
    g += '<text x="908" y="360" fill="#f3ead2" font-size="12" font-family="Georgia,serif" transform="rotate(90 908 360)">the Reach · east' + (foe("reach") ? " · at odds" : "") + '</text>';
    g += '<path d="M90,590 C240,556 460,568 640,598 C660,652 480,706 230,708 C100,696 36,650 90,590 Z" fill="' + fillOf("horn") + '" stroke="#d8c78f" stroke-width="1.3"/>';
    g += '<text x="200" y="662" fill="#f3ead2" font-size="13" font-family="Georgia,serif">the Horn League · south' + (foe("horn") ? " · at odds" : "") + '</text>';
    g += '<ellipse cx="790" cy="640" rx="48" ry="18" fill="' + fillOf("isles") + '" stroke="#d8c78f"/>';
    g += '<ellipse cx="878" cy="668" rx="28" ry="12" fill="' + fillOf("isles") + '" stroke="#d8c78f"/>';
    g += '<ellipse cx="748" cy="678" rx="16" ry="8" fill="' + fillOf("isles") + '" stroke="#d8c78f"/>';
    g += '<text x="760" y="616" fill="#f3ead2" font-size="11" font-family="Georgia,serif">the Salt Isles' + (foe("isles") ? " · at odds" : "") + '</text>';
    S.forEach(s => {
      const c = s.col | 0, r = s.row | 0;
      const p00 = vx(c, r), p10 = vx(c + 1, r), p11 = vx(c + 1, r + 1), p01 = vx(c, r + 1);
      const d = "M" + p00[0].toFixed(1) + "," + p00[1].toFixed(1) + " L" + p10[0].toFixed(1) + "," + p10[1].toFixed(1) + " L" + p11[0].toFixed(1) + "," + p11[1].toFixed(1) + " L" + p01[0].toFixed(1) + "," + p01[1].toFixed(1) + " Z";
      let fill = "#888";
      try{ fill = mapColor(s); }catch(err){ fill = (s.lean || 0) > 8 ? "#8a4b4b" : (s.lean || 0) < -8 ? "#4b5f8a" : "#6d6a62"; }
      const on = sel === s.n;
      const home = G.you && G.you.state === s.n;
      const cx = (p00[0] + p10[0] + p11[0] + p01[0]) / 4, cy = (p00[1] + p10[1] + p11[1] + p01[1]) / 4;
      g += '<g class="mapstate' + (on ? " is-sel" : "") + '" data-st="' + onumEsc(s.n) + '" style="cursor:pointer">';
      g += '<path d="' + d + '" fill="' + fill + '" fill-opacity="0.92" stroke="' + (on ? "#fff" : "#1b140c") + '" stroke-width="' + (on ? 2.4 : 1) + '"></path>';
      g += '<text x="' + cx.toFixed(1) + '" y="' + (cy - 1).toFixed(1) + '" text-anchor="middle" fill="#fff" font-size="9" font-family="Georgia,serif" style="paint-order:stroke;stroke:#000;stroke-width:2px">' + (home ? "★ " : "") + onumEsc(s.n.length > 12 ? s.n.slice(0, 11) : s.n) + '</text>';
      g += '<text x="' + cx.toFixed(1) + '" y="' + (cy + 10).toFixed(1) + '" text-anchor="middle" fill="#f3ead2" font-size="8" font-family="Georgia,serif">' + (s.seats || "") + '</text>';
      g += '</g>';
    });
    const river = [];
    for(let r = 0; r <= rows; r++){
      const p = vx(3, r);
      river.push((r === 0 ? "M" : "L") + (p[0] - 8).toFixed(1) + "," + p[1].toFixed(1));
    }
    g += '<path d="' + river.join(" ") + '" fill="none" stroke="#8fb7d6" stroke-width="3" stroke-dasharray="5 3"/>';
    g += '<text x="' + (OX + 3 * CW) + '" y="' + (OY - 14) + '" text-anchor="middle" fill="#d5e6c8" font-size="11" font-family="Georgia,serif">the Rift</text>';
    const nm = (G.country && G.country.name) || "the nation";
    g += '<text x="' + (OX + cols * CW / 2) + '" y="' + (OY - 30) + '" text-anchor="middle" fill="#e7eef4" font-size="13" font-family="Georgia,serif">' + onumEsc(nm) + '</text>';
    g += '</svg>';
    g += '<div class="muted" style="font-size:11px;margin-top:4px">Continents keep their places: Pale north, Free Marches west, Reach east, Horn south, Salt Isles in the southern sea. The nation is the inland coast — west mountains, east capital, south indented. Shade is the filter already on the map. ★ is home. Click a state.</div>';
    return g;
  }catch(e){ return _rm.apply(this, arguments); }
}; }

{ const _oc = onumOpenCabinet; onumOpenCabinet = function(){
