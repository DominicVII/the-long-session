  return "Facts that are true today. Do not contradict them. Do not use an older name for the state. If a number is not here, say you do not have it and name no substitute. Answer the question first. " + card + " " + onumFixCountry(base);
}; }
try{ engEntityPrompt = egPrompt; }catch(e){}
setTimeout(function(){ try{ engEntityPrompt = egPrompt; }catch(e){} }, 0);
{ const _own = egOwn; egOwn = function(t){
  let s = onumFixCountry(_own.apply(this, arguments));
