        const prop = thing && thing.type === "prop" ? thing.ref : null;
        const person = thing && thing.type === "person";
        const now = (typeof performance !== "undefined") ? performance.now() : Date.now();
        if(person) _stick = null;
        else if(prop && onumIsWork(prop)){ _stick = prop; _stickAt = now; }
        const use = (prop && onumIsWork(prop)) ? prop : (!person && _stick && now - _stickAt < 2800 ? _stick : null);
        if(use){
          const acts = onumWorkActs(use).slice(0, 8);
