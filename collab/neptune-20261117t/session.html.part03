/* C. typing freezes a sitting only when focus is the session say-box; otherwise the secretaries keep going */
function baSayFocus(){ try{ const a = document.activeElement; if(!a || !/^(INPUT|TEXTAREA)$/.test(a.tagName)) return false; return !!(a.closest && a.closest("#ndSess,[id*=Sess],[id*=ssn],[data-ssn],[data-session]")) || /sess|ssn/i.test(a.id || "") || /sess|ssn/i.test(a.name || ""); }catch(e){ return false; } }
{ const _pt = playerTyping; playerTyping = function(){ try{ if(SSN && cabKind() && !baSayFocus()) return false; }catch(e){} return _pt.apply(this, arguments); }; }
{ const _tk = ssnTick; ssnTick = function(){ try{ if(SSN && cabKind()){ if(SS2.hold && !baSayFocus()) SS2.hold = false; const st = ssnStage();
      if(st && st.id === "decisions"){ if(!SSN._baVote && !SSN._busy){ SSN._baDecAt = SSN._baDecAt || Date.now(); if(SSN.chairId !== "you" || Date.now() - SSN._baDecAt > 20000) baCallVote(); else if(!SSN._baHint){ SSN._baHint = 1; try{ note("Decisions: call the vote when you are ready (Pass also calls it)."); }catch(e){} } } return; }
      if(st && (st.id === "briefings" || st.id === "reports") && SSN.chairId === "you" && !(SSN.roundLeft || []).length && SSN.floorId == null && !(SSN._busy && Date.now() < SSN._busy)){ SSN._baIdle = SSN._baIdle || Date.now(); if(Date.now() - SSN._baIdle > 25000){ SSN._baIdle = 0; ssnNext(); return; } } else SSN._baIdle = 0; } }catch(e){}
  return _tk.apply(this, arguments); }; }


/* 20261113b — executive actions, own voices, relationships, elections, the Web.
   Inserted inside the main game function. Uses existing cards, sittings, and people. */
function onumEsc(s){
  return String(s == null ? "" : s).replace(/[&<>"]/g, function(c){
    if(c === "&") return "&" + "amp;";
    if(c === "<") return "&" + "lt;";
    if(c === ">") return "&" + "gt;";
    return "&" + "quot;";
  });
}

function onumSelfBits(p){
  const bits = [];
  if(!p) return bits;
  const role = p.role || (p.post ? postTitle(p.post) : (p.kind === "press" ? (p.outlet || "the press") : "this chair"));
  bits.push("I am " + (p.name || "who I am") + (role ? ", " + role : "") + ".");
  try{ if(p.pos && typeof viewWords === "function") bits.push(cap(viewWords(p.pos)) + ", and that is mine, not a line I was handed."); }catch(e){}
  try{
    if(p.creed && typeof creedOf === "function"){
      const c = creedOf(p.creed);
      if(c && c.holds) bits.push("What I will not trade is " + c.t + ": " + c.holds);
    }
  }catch(e){}
  try{
    if(typeof bioOf === "function" && p.kind === "member"){
      const bio = bioOf(p);
      if(bio && bio.town) bits.push("I still answer to " + bio.town + ", where " + (bio.trouble || "the week is ordinary and hard") + ".");
      if(bio && bio.pride) bits.push("What they still have, and what I will not spend, is " + bio.pride + ".");
    }
  }catch(e){}
  try{
    if(p.krole && typeof kMeta === "function"){
      const M = kMeta(p);
      if(M) bits.push("Around here I am " + M.arch + ": I " + M.quirk + ". " + cap(M.story) + ". What I want out of the years left is " + M.want + ".");
    }
  }catch(e){}
  if(p.bg && p.kind === "member") bits.push("Before any of this I was " + String(p.bg).replace(/^an? /, "") + ", and it still decides how I hear a room.");
  const w = (p.rel && p.rel.warmth) || 0;
  if(w > 28) bits.push("I will be plain with you. I would rather say it to your face than have it said for me.");
  else if(w < -18) bits.push("We are not easy, and I will not perform ease for the corridor.");
  else if(p.met) bits.push("I do not owe you a private version of myself. Ask, and I will decide.");
  return bits.filter(Boolean);
}
function onumOwn(p){ return onumSelfBits(p).slice(0, 3).join(" "); }

talkDepth = function(m, u){
  try{
    if(!m) return "";
    const bits = onumSelfBits(m);
    if(m.party && G.you){
      if(m.party === G.you.party) bits.push(((m.traits && m.traits.loyalty) || 50) > 62 ? "Same caucus as you. That is a fact about Tuesday. It is not a blank I signed." : "We wear the same label. Do not spend it as if you printed it.");
      else bits.push("I am " + (typeof partyName === "function" ? partyName(m.party) : m.party) + ". I did not cross the room to be improved.");
    }
    const b = G.bill && !G.bill.done ? G.bill : null;
    if(b && m.kind === "member" && !(u && u.topics && u.topics[0] === "bill")){
      let aye = true; try{ aye = memberVote(m, b) > 0; }catch(e){}
      let why = ""; try{ const st = stakeIn(m, b); if(st && st.why) why = " " + st.why; }catch(e){}
      bits.push("On " + b.title + " the vote is mine: I am " + (aye ? "an aye" : "a no") + "." + why);
    }
    if(m.intent && m.intent.t) bits.push("What I came in to do, for myself, is " + m.intent.t + ".");
    if(m.fear && m.fear.t && ((m.rel && m.rel.trust) || 0) > 35) bits.push("What I will not risk, and I am telling you because I choose to, is " + m.fear.t + ".");
    return bits.filter(Boolean).slice(0, 4).join(" ");
  }catch(e){ return ""; }
};

baReport = function(p){
  const t = (function(){ try{ return baTopic(); }catch(e){ return "the matter on the table"; } })();
  let al = 0; try{ const b = ssnBill(); al = b ? baAl(p, b.pos, b.title) : 0; }catch(e){}
  const care = (function(){ try{ return baCare(p); }catch(e){ return "what lands on my desk"; } })();
  const own = onumOwn(p);
  const stake = al > 12 ? "My people can carry " + t + ", and I want it decided while I am still willing."
    : al < -12 ? "I cannot carry " + t + " as it is written. That is my department speaking, not a mood."
    : "I will not commit " + care + " until somebody puts a figure next to the speech.";
  const need = "What I need from you, chair, is one decision I can take downstairs: hold it, change it, or let me go and do the work. I will not speak for the person on my left.";
  return [own, "On " + t + ", what I actually watch is " + care + ".", stake, need].filter(Boolean).join(" ");
};
baRebut = function(a, b){
  const t = (function(){ try{ return baTopic(); }catch(e){ return "this"; } })();
  const mine = (function(){ try{ return baCare(a); }catch(e){ return "my office"; } })();
  const theirs = (function(){ try{ return baCare(b); }catch(e){ return "their office"; } })();
  let lean = "";
  try{ if(a.pos && b.pos && typeof viewWords === "function") lean = " I read the country as someone who " + viewWords(a.pos) + ". " + baSn(b) + " " + viewWords(b.pos) + ", and we are not the same person."; }catch(e){}
  return baSn(b) + " has just spoken for " + theirs + ". I am not them. On " + t + " I answer for " + mine + "." + lean + " If we leave this table pretending we agreed, my office will be the one that has to explain it.";
};
cabFallback = function(p){ try{ return baReport(p); }catch(e){ return (p && p.name ? p.name : "I") + " will speak for my own office and nobody else's."; } };

function onumSeatCabinet(){
  /* 20261117s: the record seats its holders through cabSeat; a new holder is a new person, the old one retires */
  if(!G || !G.you || heldOffice() !== "pres") return;
  cabSeatPres();
}
function onumOpenCabinet(){
  onumSeatCabinet();
  const open = () => {
    try{
      const r = ssnOpen({gov:"executive", kind:"cabinet_meeting", room:"exec", auto:false});
      if(r){ try{ feed("The cabinet is in. Each of them speaks for their own department."); }catch(e){} return; }
    }catch(e){}
    onumCabinetCard();
  };
  if(G.room !== "exec"){ try{ goTo("exec"); }catch(e){} setTimeout(open, 700); }
  else open();
}

function onumCabinetCard(){
  const y = G.you; if(!y || heldOffice() !== "pres"){ try{ note("The cabinet does not sit for you."); }catch(e){} return; }
  let st; try{ st = presStaff(); }catch(e){ return; }
  const act = (G.lastActs || []).find(a => a && !a.signed && !a.vetoed) || null;
  const keys = Object.keys(PRES_ROLES);
  const body = keys.map(k => {
    const o = st[k]; if(!o) return "";
    const say = act && typeof presAdvice === "function" ? presAdvice(o, k, act) : onumCabQuiet(o, k);
    return '<div style="margin:10px 0;padding:8px 10px;border-left:3px solid var(--line-soft)">' +
      (typeof officialHTML === "function" ? officialHTML(o) : '<b>' + onumEsc(o.name) + '</b>') +
      '<p style="margin:6px 0">“' + onumEsc(say) + '”</p>' +
      '<div class="card__actions" style="flex-wrap:wrap">' +
      '<button type="button" class="btn btn--ghost" data-cab="' + k + ':why">Ask them why, as themselves</button>' +
      '<button type="button" class="btn btn--ghost" data-cab="' + k + ':take">Take their counsel</button>' +
      '<button type="button" class="btn btn--ghost" data-cab="' + k + ':over">Overrule them</button>' +
      '<button type="button" class="btn btn--ghost" data-cab="' + k + ':sup">Ask them to supper</button>' +
      '</div><div class="dream" id="cab_' + k + '"></div></div>';
  }).join("") +
    (act ? '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" data-cab="act:s">Sign the ' + onumEsc(act.title) + '</button><button type="button" class="btn btn--ghost" data-cab="act:v">Veto it</button></div><div class="dream" id="cab_act"></div>' : '<p class="muted">Nothing is enrolled for signature. The secretaries still have the day.</p>') +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" data-cab="more:seat">Seat them in the wing and open the sitting</button><button type="button" class="btn btn--ghost" data-cab="more:appt">Appoint or replace</button><button type="button" class="btn btn--ghost" data-cab="more:pardon">Clemency</button></div>';
  govCardOpen("Cabinet", "They speak for their departments", "Not your words. Theirs: the office, the creed, the town, the quarrel.", body, "cab");
  const sayTo = (k, t) => { const n = el("cab_" + k); if(n) n.textContent = t; };
  card.querySelectorAll("[data-cab]").forEach(b => b.addEventListener("click", () => {
    const [k, how] = b.getAttribute("data-cab").split(":");
    if(k === "act" && act && !act.signed && !act.vetoed){
      if(how === "s"){ act.signed = true; y.approval = clamp(y.approval + 2, 0, 100); try{ reactAct(act.title, act.pos, true); }catch(e){} el("cab_act").textContent = "Signed. The secretaries will carry it, including the ones who told you not to."; try{ feed(execTitle() + " signed the " + act.title + "."); }catch(e){} }
      else { act.vetoed = true; y.standing = clamp(y.standing - 2, 0, 100); try{ reactAct(act.title, act.pos, false); }catch(e){} el("cab_act").textContent = "Vetoed. Expect two of them to say they warned you, and one to be relieved."; try{ feed(execTitle() + " vetoed the " + act.title + ".", "bad"); }catch(e){} }
      return;
    }
    if(k === "more"){
      if(how === "seat"){ try{ walkNow(); }catch(e){} onumOpenCabinet(); }
      else if(how === "appt"){ try{ appointCard("cab"); }catch(e){} }
      else onumPardon();
      return;
    }
    const o = st[k]; if(!o) return;
    G.cabRel = G.cabRel || {};
    const rel = G.cabRel[o.name] || 0;
    if(how === "why"){
      let creed = ""; try{ const c = creedOf(o.creed); creed = c ? " I came up in " + c.t + "." : ""; }catch(e){}
      let og = ""; try{ const g = originOf(o.origin); og = g && g.grievance ? " My people still carry " + g.grievance + "." : ""; }catch(e){}
      sayTo(k, o.name + ": “I am " + (o.bg || "what the file says") + "." + creed + og + " Weigh the advice knowing whose life it comes from, not as if it were yours.”");
    } else if(how === "take"){
      G.cabRel[o.name] = rel + 6; y.influence = clamp(y.influence + 1, 0, 100);
      sayTo(k, o.name + " nods, once. “Then I will do it as I described it, not as the press will describe it.”");
      try{ onumWebPush(o.name, "personal", "The chair took my counsel today on " + PRES_ROLES[k] + ". I will say so, because it was mine."); }catch(e){}
    } else if(how === "over"){
      G.cabRel[o.name] = rel - 8; y.standing = clamp(y.standing + 1, 0, 100);
      sayTo(k, o.name + ": “Noted. I will carry the order. I will also remember that you heard me and went the other way. That is your right. It is not nothing.”");
      try{ onumWebPush(o.name, "personal", "Overruled in my own department. The order stands. So does my view."); }catch(e){}
    } else {
      G.cabRel[o.name] = rel + (rel > -10 ? 4 : 1);
      sayTo(k, rel < -12 ? o.name + ": “Not supper. Not while this is between us. Ask me about the work.”" : o.name + ": “Supper, and we leave the portfolio at the door for one hour. I will tell you what my people say when you are not in the room.”");
    }
  }));
}
function onumCabQuiet(o, k){
  const hot = (G.states || []).slice().sort((a, c) => (c.unrest || 0) - (a.unrest || 0))[0];
  const vw = (function(){ try{ return viewWords(o.pos || {}); }catch(e){ return "has a view"; } })();
  if(k === "treasury") return "The books are what they are. " + (hot ? hot.n + " will ask for money before the week is out. " : "") + "I " + vw + ". I would rather tell you the number than have you invent one.";
  if(k === "state") return "The neighbours are reading us whether we speak or not. I " + vw + ". Give me a channel or give me a warning, but do not give me both in the same sentence.";
  if(k === "war") return "The fleet is short of what the speeches promise. I " + vw + ". Tell me what you want them to do before you tell me what to buy.";
  return "The courts will read whatever you sign. I " + vw + ". I will give you the law as I see it, including the part that binds you.";
}

function onumPardon(){
  const y = G.you; if(!y) return;
  const names = [0, 1, 2].map(i => { let n = "A. Prisoner"; try{ n = newName(y.state); }catch(e){} return n; });
  const cases = [
    {name:names[0], t:"served eleven years of a fifteen-year term for a warehouse theft. The victim's family is split.", home:"a mill town"},
    {name:names[1], t:"a protest conviction from the spring. The papers already have a side.", home:"the capital"},
    {name:names[2], t:"a tax case the Attorney General calls sloppy and the county calls theft.", home:y.state}
  ];
  const body = cases.map((c, i) => '<div style="margin:10px 0;padding:8px 10px;border-left:3px solid var(--line-soft)"><b>' + onumEsc(c.name) + '</b> <span class="muted">· ' + onumEsc(c.home) + '</span><p>' + onumEsc(c.t) + '</p><div class="card__actions"><button type="button" class="btn" data-pn="' + i + ':g">Grant</button><button type="button" class="btn btn--ghost" data-pn="' + i + ':d">Deny</button></div><div class="dream" id="pn_' + i + '"></div></div>').join("");
  govCardOpen("Clemency", "Three names, not a pile", "Each one has a town. The Attorney General will speak after, in their own voice.", body, null);
  card.querySelectorAll("[data-pn]").forEach(b => b.addEventListener("click", () => {
    const [i, k] = b.getAttribute("data-pn").split(":"); const c = cases[+i]; if(c.done) return; c.done = 1;
    try{ spend(10, 1); }catch(e){}
    let ag = ""; try{ const o = presStaff().justice; ag = " " + o.name + " (" + viewWords(o.pos) + "): “" + ((o.pos.lib || 0) > 15 ? "Mercy here is the law remembering it is about people." : "Mercy here teaches the next one that the sentence was theatre.") + "”"; }catch(e){}
    if(k === "g"){ y.approval = clamp(y.approval + (i === 1 ? -1 : 1), 0, 100); y.standing = clamp(y.standing + 1, 0, 100); el("pn_" + i).textContent = "Granted. " + c.name + " goes home to " + c.home + "." + ag; try{ onumWebPush("The Capitol Ledger", "paper", execTitle() + " pardons " + c.name + ". The county is already arguing about it."); }catch(e){} }
    else { y.approval = clamp(y.approval + (i === 1 ? 1 : -1), 0, 100); el("pn_" + i).textContent = "Denied. The family in " + c.home + " will hear it from a clerk." + ag; }
    card.querySelectorAll('[data-pn^="' + i + ':"]').forEach(z => z.disabled = true);
  }));
}

function onumParty(){
  const y = G.you; if(!y) return;
  const mine = (G.members || []).filter(m => m && !m.gone && m.kind === "member" && m.party === y.party).slice(0, 5);
  const avg = mine.length ? Math.round(mine.reduce((a, m) => a + ((m.traits && m.traits.loyalty) || 50), 0) / mine.length) : 50;
  const rows = mine.map((m, i) => {
    const say = onumMemberMouth(m);
    return '<div style="margin:8px 0;padding:8px 10px;border-left:3px solid var(--line-soft)"><b>' + onumEsc(m.name) + '</b> <span class="muted">· ' + onumEsc(m.state || "") + ' ' + onumEsc(m.dist || "") + ' · loyalty ' + Math.round((m.traits && m.traits.loyalty) || 50) + ' · warmth ' + Math.round((m.rel && m.rel.warmth) || 0) + '</span><p>“' + onumEsc(say) + '”</p><div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" data-py="' + i + ':hold">Ask them to hold the line</button><button type="button" class="btn btn--ghost" data-py="' + i + ':job">Offer a patronage word</button><button type="button" class="btn btn--ghost" data-py="' + i + ':cut">Cut them loose</button><button type="button" class="btn btn--ghost" data-py="' + i + ':sup">Supper, not strategy</button></div><div class="dream" id="py_' + i + '"></div></div>';
  }).join("");
  govCardOpen("The party", partyName(y.party) + ", in their own voices", "Caucus loyalty is " + avg + ". They are not a single mouth. A primary starts to breathe when standing is under 40 (yours is " + Math.round(y.standing) + ").", rows || "<p>Nobody from your party is in the building.</p>", null);
  card.querySelectorAll("[data-py]").forEach(b => b.addEventListener("click", () => {
    const [i, k] = b.getAttribute("data-py").split(":"); const m = mine[+i]; if(!m || m._py) return;
    if(k !== "sup") m._py = 1;
    try{ spend(12, 2); }catch(e){}
    const box = el("py_" + i);
    if(k === "hold"){
      const ok = (((m.traits && m.traits.loyalty) || 50) + ((m.rel && m.rel.warmth) || 0)) > 40;
      if(ok){ m.traits.loyalty = clamp(m.traits.loyalty + 4, 0, 100); if(m.rel) m.rel.warmth = clamp(m.rel.warmth + 1, -100, 100); y.standing = clamp(y.standing + 1, 0, 100); box.textContent = m.name + ": “I will hold it in public. Do not make me defend a sentence I did not write.”"; }
      else { if(m.rel) m.rel.warmth = clamp(m.rel.warmth - 3, -100, 100); box.textContent = m.name + ": “No. Not for a line my town cannot say back. Find someone whose people agree with you.”"; }
    } else if(k === "job"){
      if(y.influence < 3){ box.textContent = "You are short of influence. Patronage is not free."; m._py = 0; return; }
      y.influence -= 3; m.traits.loyalty = clamp((m.traits.loyalty || 50) + 8, 0, 100); if(m.rel) m.rel.warmth = clamp(m.rel.warmth + 6, -100, 100);
      box.textContent = m.name + ": “A word in the right office. I heard it. My people will hear that I was not forgotten. I will remember who said it.”";
      try{ onumWebPush(m.name, "personal", "A quiet word from the top of my own party. I am not naming the office. I am naming that I was asked."); }catch(e){}
    } else if(k === "cut"){
      m.traits.loyalty = clamp((m.traits.loyalty || 50) - 10, 0, 100); if(m.rel) m.rel.warmth = clamp(m.rel.warmth - 12, -100, 100); y.standing = clamp(y.standing - 2, 0, 100);
      box.textContent = m.name + ": “Then we are finished as colleagues. I will say so in my own words, not yours, and my district will hear me.”";
      try{ onumWebPush(m.name, "personal", "I was read out of a conversation I am still elected to. Here is my side, in my name."); }catch(e){}
    } else {
      const w = (m.rel && m.rel.warmth) || 0;
      if(m.rel) m.rel.warmth = clamp(w + (w > 0 ? 4 : 1), -100, 100);
      box.textContent = w < 0 ? m.name + ": “Not supper. The politics is still in the room.”" : m.name + ": “All right. No whip, no bill, no ask. Tell me who you are when the title is off.”";
    }
  }));
}
function onumMemberMouth(m){
  let bio = {town:m.state || "home", trouble:"they are tired of being an example"};
  try{ bio = bioOf(m) || bio; }catch(e){}
  const loy = (m.traits && m.traits.loyalty) || 50;
  const b = G.bill && !G.bill.done ? G.bill : null;
  let vote = "";
  if(b){ let aye = true; try{ aye = memberVote(m, b) > 0; }catch(e){} vote = " On " + b.title + " I am " + (aye ? "an aye" : "a no") + ", and I will say why in my own sentences."; }
  let creed = ""; try{ const c = creedOf(m.creed); if(c && c.t) creed = " I hold " + c.t + "."; }catch(e){}
  const spine = loy > 66 ? "I will hold our line where the cameras are. In here I will tell you where it cuts my people." : loy < 38 ? "Do not count me as a number you already own. I have walked off a whip before." : "I go with the party until it costs the people who sent me. Then I do not.";
  return spine + " In " + (bio.town || m.state) + ", " + (bio.trouble || "the week is hard") + "." + vote + creed;
}

function onumBond(m){
  m.soc = m.soc || {k:"acquaintance", since:G.day || 1};
  return m.soc;
}
function onumTouch(m, dW, k){
  if(m && m.rel){
    m.rel.warmth = clamp((m.rel.warmth || 0) + dW, -100, 100);
    if(dW > 0) m.rel.trust = clamp((m.rel.trust || 30) + 1, 0, 100);
  }
  const s = onumBond(m);
  if(k) s.k = k;
  s.d = G.day;
}
function onumSpouse(m){
  try{ const f = famEnsure().p[m.id]; return f && f.spouse ? f.spouse : null; }catch(e){ return null; }
}
function onumSocReply(m, kind){
  const w = (m.rel && m.rel.warmth) || 0;
  const own = onumOwn(m);
  const sp = onumSpouse(m);
  if(kind === "know") return own + " If you want the person and not the vote, ask about " + ((function(){ try{ return bioOf(m).town; }catch(e){ return m.state || "home"; } })()) + ", and then listen.";
  if(kind === "sup"){
    if(w < 8) return own + " Supper is a private room. We are not there. Ask me something I can answer standing up.";
    onumTouch(m, 4, w > 35 ? "friend" : "colleague");
    return own + " All right. Supper, and the first half hour is not the bill. I will tell you what my people say when the capital is not inventing them.";
  }
  if(kind === "party"){
    return onumMemberMouth(m);
  }
  if(kind === "court"){
    if(sp){
      onumTouch(m, -2, "colleague");
      try{ onumWebPush(m.name, "personal", "Someone in the building forgot I am married to " + sp.name.split(" ")[0] + ". I have not."); }catch(e){}
      return own + " I have " + sp.name.split(" ")[0] + " at home. Do not make me say that twice. If you meant friendship, say friendship.";
    }
    if(w < 22) return own + " That is a larger ask than the warmth between us can hold. Be a colleague first. I am not a prize of the office.";
    onumTouch(m, 6, "court");
    yCourt(m);
    return own + " I heard you. I am not saying yes to a life. I am saying I will not pretend I did not hear it. We will see what we are when the title is off.";
  }
  if(kind === "confide"){
    const disc = (m.traits && m.traits.discretion) || 50;
    onumTouch(m, 2, w > 20 ? "friend" : null);
    return own + (disc > 60 ? " It stays in this room. I am not a corridor." : " I will try to keep it. I am not famous for trying, so do not hand me what you cannot survive.");
  }
  return own;
}
function yCourt(m){ G.you.courtId = m.id; G.you.courtSince = G.day; }
function onumSocActs(m){
  if(!m || m === G.you || m.machine) return [];
  const w = (m.rel && m.rel.warmth) || 0;
  const A = [];
  A.push({t:w > 16 ? "Have supper — not as politics" : "I want to know you, not the vote", c:"25m", run(){
    try{ spend(25, 3); }catch(e){}
    const k = w > 16 ? "sup" : "know";
    setSay(onumSocReply(m, k), "");
    try{ if(m.rel) ripple(m, k === "sup" ? 3 : 1, "They wanted to know me, not my vote.", 2); }catch(e){}
  }});
  if(m.party && G.you && m.party === G.you.party) A.push({t:"The party, between us", c:"15m", run(){
    try{ spend(15, 2); }catch(e){}
    setSay(onumSocReply(m, "party"), "");
  }});
  A.push({t:"Tell them something only they should hear", c:"10m", run(){
    try{ spend(10, 1); }catch(e){}
    setSay(onumSocReply(m, "confide"), "");
  }});
  if(w > 24 || (m.soc && m.soc.k === "court")) A.push({t:m.soc && m.soc.k === "court" ? "Where we stand, personally" : "More than colleagues", c:"20m", risk:true, run(){
    try{ spend(20, 2); }catch(e){}
    setSay(onumSocReply(m, "court"), "");
  }});
  return A;
}
{ const _af = actionsFor; actionsFor = function(m){
  const A = _af.apply(this, arguments) || [];
  try{ if(TALK.thread) return A; onumSocActs(m).forEach(a => A.splice(Math.max(0, A.length - 1), 0, a)); }catch(e){}
  return A;
}; }
{ const _sg = suggestions; suggestions = function(m){
  const out = _sg.apply(this, arguments) || [];
  try{
    const w = (m.rel && m.rel.warmth) || 0;
    out.push(w > 16 ? {t:"Supper, not the vote", say:"Come to supper. I want the person, not the position."} : {t:"Who are you, really", say:"Who are you when the building is closed? I am asking you, not your office."});
    if(m.party && G.you && m.party === G.you.party) out.push({t:"Your party, your words", say:"Forget the whip. Where do you yourself refuse to follow?"});
    if(w > 24) out.push({t:"More than this", say:"I am not asking for a vote. I am asking if there is room in your life for me."});
  }catch(e){}
  return out.slice(0, 6);
}; }

function onumWeb(){
  if(!G.web || G.web.v !== 1) G.web = {v:1, sites:[], posts:[], seq:1, day:-1, mine:null};
  return G.web;
}
function onumSite(owner, kind, title){
  const W = onumWeb();
  let s = W.sites.find(x => x.owner === owner && x.kind === kind);
  if(!s){ s = {id:"s" + (W.seq++), owner, kind, title, since:G.day || 1}; W.sites.push(s); }
  return s;
}
function onumWebPush(owner, kind, text){
  const W = onumWeb();
  const title = kind === "paper" ? owner : kind === "party" ? owner : owner + " — a page of their own";
  const s = onumSite(owner, kind, title);
  const post = {id:"p" + (W.seq++), site:s.id, owner, kind, t:String(text || "").slice(0, 420), d:G.day || 1, at:(function(){ try{ return hhmm(); }catch(e){ return ""; } })(), replies:[]};
  W.posts.unshift(post);
  if(W.posts.length > 80) W.posts.length = 80;
  return post;
}
function onumWebDay(){
  const W = onumWeb(); if(W.day === G.day) return; W.day = G.day;
  try{ onumSite("The Capitol Ledger", "paper", "The Capitol Ledger"); }catch(e){}
  try{ onumSite(partyName("FED"), "party", partyName("FED")); onumSite(partyName("COM"), "party", partyName("COM")); }catch(e){}
  const pool = (G.members || []).filter(m => m && !m.gone && m.kind === "member");
  const n = 2 + ((G.day || 1) % 3);
  for(let i = 0; i < n && pool.length; i++){
    const m = pool[(G.day * 3 + i * 5) % pool.length];
    if(!m) continue;
    onumWebPush(m.name, "personal", onumWebLine(m));
  }
  try{
    if(heldOffice() === "pres"){
      const st = presStaff();
      const k = Object.keys(PRES_ROLES)[(G.day || 0) % 4];
      const o = st[k];
      if(o) onumWebPush(o.name, "personal", onumCabQuiet(o, k));
    }
  }catch(e){}
  const b = G.bill && !G.bill.done ? G.bill : null;
  if(b && (G.day % 2 === 0)){
    try{ onumWebPush("The Capitol Ledger", "paper", "The Ledger's own reading of " + b.title + ": the galleries are split, the whip is not, and the towns have not been asked in their own words."); }catch(e){}
  }
}
function onumWebLine(m){
  const b = G.bill && !G.bill.done ? G.bill : null;
  const bits = [];
  if(b){ let aye = true; try{ aye = memberVote(m, b) > 0; }catch(e){} bits.push("Under my own name: on " + b.title + " I am " + (aye ? "for the text" : "against the text") + ". Anyone quoting a softer version is not quoting me."); }
  try{ const bio = bioOf(m); if(bio && bio.town) bits.push("From " + bio.town + ": " + (bio.trouble || "we are still here") + "."); }catch(e){}
  try{ const c = creedOf(m.creed); if(c && c.t && Math.random() < 0.5) bits.push("I check the week against " + c.t + "."); }catch(e){}
  const w = (m.rel && m.rel.warmth) || 0;
  if(w < -25 && G.you) bits.push("I will not pretend " + surname(G.you.name) + " and I are easy. The page can hold that.");
  if(!bits.length) bits.push("A note from my own desk. The day was ordinary. I would rather say so than invent a crisis for the feed.");
  return bits.slice(0, 2).join(" ");
}
function onumWebHTML(){
  try{ onumWebDay(); }catch(e){}
  const W = onumWeb();
  const y = G.you;
  const mine = W.mine;
  let h = '<div class="pc__h">The Web</div><div class="pc__m">Anyone with a name can keep a page. The papers, the parties, the members, the cabinet. They write what they think. You can answer, and they will remember the answer.</div>';
  h += '<div style="margin:6px 0">' +
    (mine ? '<button class="pc__btn" data-soc="web:post">Post on ' + onumEsc(mine.title) + '</button>' : '<button class="pc__btn" data-soc="web:found">Found a page of your own</button>') +
    '</div>';
  W.posts.slice(0, 18).forEach(p => {
    h += '<div class="pc__row"><span class="d">d' + p.d + ' · ' + onumEsc(p.at || "") + ' · ' + onumEsc(p.kind) + '</span><b>' + onumEsc(p.owner) + '</b><div class="pc__m">' + onumEsc(p.t) + '</div>';
    (p.replies || []).slice(-2).forEach(r => { h += '<div class="pc__m">↳ ' + onumEsc(r.by) + ': ' + onumEsc(r.t) + '</div>'; });
    if(p.owner !== (y && y.name)) h += '<button class="pc__btn" data-soc="web:re:' + p.id + '">Answer in your own name</button>';
    h += '</div>';
  });
  if(!W.posts.length) h += '<p class="pc__m">The wire is quiet. Found a page, or wait until morning. People post when the day turns.</p>';
  return h;
}
function onumWebReply(id, tone){
  const W = onumWeb(); const p = W.posts.find(x => x.id === id); if(!p || !G.you) return;
  const y = G.you;
  const line = tone === "hard"
    ? "I read that. I do not accept it, and I am answering under my own name."
    : tone === "warm"
    ? "I read that. Thank you for saying it as yourself. I am answering as myself."
    : "Noted, in public, so nobody has to repeat it in a corridor.";
  p.replies = p.replies || []; p.replies.push({by:y.name, t:line, d:G.day});
  const m = (G.members || []).find(x => x && x.name === p.owner) || (G.civ || []).find(x => x && x.name === p.owner);
  if(m) onumTouch(m, tone === "hard" ? -4 : tone === "warm" ? 3 : 0, null);
  if(tone === "hard") y.approval = clamp(y.approval + (Math.random() < 0.5 ? -1 : 0), 0, 100);
  if(tone === "warm") y.approval = clamp(y.approval + 1, 0, 100);
  try{ feed("You answered " + p.owner + " on the Web."); }catch(e){}
}
function onumWebFound(){
  const y = G.you; if(!y) return;
  const W = onumWeb();
  const title = surname(y.name) + " — from the desk";
  W.mine = {title, owner:y.name};
  onumSite(y.name, "personal", title);
  onumWebPush(y.name, "personal", "This page is mine. I will write what I mean, not what a release says I meant.");
}
function onumWebPost(){
  const y = G.you; const W = onumWeb(); if(!y || !W.mine) return;
  const b = G.bill && !G.bill.done ? G.bill : null;
  const opts = [
    ["state", "The statesman's note", b ? "On " + b.title + " I have a view and I will vote it in the open." : "The day was for the work, and I am saying so without a slogan."],
    ["party", "The party note", "My party knows where I stand. The country can know it too."],
    ["person", "The personal note", "I am a person in this office, not only the office. Anyone writing otherwise is writing fiction."]
  ];
  const body = opts.map((o, i) => '<div style="margin:8px 0"><button type="button" class="btn" data-wp="' + i + '">' + onumEsc(o[1]) + '</button><div class="muted">' + onumEsc(o[2]) + '</div></div>').join("");
  govCardOpen("Your page", W.mine.title, "It goes up under your name. People will answer it as themselves.", body, null);
  card.querySelectorAll("[data-wp]").forEach(b => b.addEventListener("click", () => {
    const o = opts[+b.getAttribute("data-wp")];
    onumWebPush(y.name, "personal", o[2]);
    if(o[0] === "party") y.standing = clamp(y.standing + 1, 0, 100);
    if(o[0] === "person") y.approval = clamp(y.approval + 1, 0, 100);
    try{ feed("Posted: " + o[1] + "."); }catch(e){}
    const s = el("gcSay"); if(s) s.textContent = "Up. It is on your page, and it will be on theirs by morning if it stings.";
  }));
}

function onumCamp(){
  if(!G.camp || G.camp.v !== 1) G.camp = {v:1, field:[], log:[]};
  const y = G.you; if(!y) return G.camp;
  const offs = ["house", "senate", "gov", "pres"];
  offs.forEach(k => {
    if(G.camp.field.some(f => f.for === k && !f.out)) return;
    let name = "A. Challenger"; try{ name = newName(y.state); }catch(e){}
    const opp = y.party === "FED" ? "COM" : "FED";
    G.camp.field.push({for:k, name, party:k === "house" ? opp : (Math.random() < 0.55 ? opp : y.party), from:y.state, poll:38 + Math.round(Math.random() * 18), heat:10 + Math.round(Math.random() * 20)});
  });
  return G.camp;
}
function onumElectBody(){
  onumCamp(); try{ onumWebDay(); }catch(e){}
  const y = G.you; if(!y) return "<p>No campaign yet.</p>";
  const left = Math.max(0, (G.termLength || 40) - (G.sittingDay || 1));
  const hist = (G.polls || []).slice(-8);
  const bars = hist.map(p => '<i title="day ' + p.d + ' · ' + p.v + '" style="display:inline-block;width:14px;height:' + Math.max(4, Math.round((p.v || 0) * 0.7)) + 'px;background:#c9a24a;margin:0 2px;vertical-align:bottom"></i>').join("");
  const last = hist.length ? hist[hist.length - 1] : null;
  let cover = last ? last.paper + " asked " + (last.n || "several hundred") + " households" + (last.ask ? " about " + last.ask : "") + " and printed " + last.v + " (±" + (last.moe || 3) + "). The other papers will spend tomorrow disagreeing about the same number." : "No sounding has been trusted yet. The clerks are covering the race off the canvass and the quarrels.";
  const races = (G.races || []).slice(-4).reverse().map(r => '<div>The ' + r.congress + 'th · ' + onumEsc(r.seeking || "house") + ' · you ' + (r.won ? "won" : "lost") + ' by ' + r.margin + (r.poll != null ? ' · sounding ' + r.poll : '') + (r.paper ? ' · ' + onumEsc(r.paper) : '') + '</div>').join("");
  const field = G.camp.field.filter(f => !f.out).map(f => {
    const youP = Math.round(y.approval);
    const gap = youP - f.poll;
    return '<div style="margin:6px 0"><b>' + onumEsc(f.for === "pres" ? (function(){ try{ return execTitle(); }catch(e){ return "Executive"; } })() : (OFFICES[f.for] ? OFFICES[f.for].t : f.for)) + '</b> · ' + onumEsc(f.name) + ' (' + f.party + ', ' + onumEsc(f.from) + ') at ' + f.poll + ' · you ' + youP + ' · ' + (gap >= 0 ? "you lead by " + gap : "you trail by " + (-gap)) + '</div>';
  }).join("");
  const open = Object.keys(OFFICES).filter(k => { try{ return (k === "house" && !termLimited("house")) || qualifies(k); }catch(e){ return k === "house"; } });
  return '<p class="muted">' + left + ' sitting day' + (left === 1 ? '' : 's') + ' left in the term. You hold ' + onumEsc(officeTitle()) + '. A bigger office is a harder race; the law still decides who may stand.</p>' +
    '<div class="eyebrow">The soundings</div><div style="line-height:0;margin:6px 0">' + (bars || '') + '</div><p>' + onumEsc(cover) + '</p>' +
    '<div class="eyebrow">Who is actually running</div>' + field +
    '<div class="eyebrow">You may reach for</div><p class="muted">' + (open.length ? open.map(k => (k === "pres" ? (function(){ try{ return execTitle(); }catch(e){ return "the executive"; } })() : OFFICES[k].t)).join(", ") : "the law says you are done standing") + '.</p>' +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" data-el="rally">Rally at home (12 from the chest)</button><button type="button" class="btn btn--ghost" data-el="ad">Buy the ad (28)</button><button type="button" class="btn btn--ghost" data-el="canv">Canvass with the field</button><button type="button" class="btn btn--ghost" data-el="debate">Prep the debate</button></div><div class="dream" id="elSay"></div>' +
    (races ? '<div class="eyebrow">What the last elections were</div>' + races : '');
}
function onumElectDo(k){
  const y = G.you; if(!y) return "";
  onumCamp();
  const foe = G.camp.field.filter(f => !f.out).sort((a, b) => b.poll - a.poll)[0];
  let msg = "";
  if(k === "rally"){
    if((y.funds || 0) < 12) return "The chest is short of 12.";
    y.funds -= 12; y.approval = clamp(y.approval + 2, 0, 100); y.field = (y.field || 0) + 1;
    if(foe) foe.poll = clamp(foe.poll - 1, 0, 100);
    msg = "You stood on the step at home and said the vote out loud. The sounding will notice before the capital does.";
    try{ onumWebPush("The Harbour Independent", "paper", y.name + " rallied at home. The speech was the vote, not the smile. A local clerk counted the crowd and refused to round up."); }catch(e){}
  } else if(k === "ad"){
    if((y.funds || 0) < 28) return "The chest is short of 28.";
    y.funds -= 28; y.approval = clamp(y.approval + 3, 0, 100);
    if(foe){ foe.poll = clamp(foe.poll - 2, 0, 100); foe.heat = clamp((foe.heat || 0) + 8, 0, 100); }
    msg = "The ad ran. It used your own vote, which is why it worked, and why they will answer it.";
    try{ onumWebPush(foe ? foe.name : "A challenger", "personal", "Their ad used a vote. Here is the rest of the vote, in my words, not their edit."); }catch(e){}
  } else if(k === "canv"){
    y.approval = clamp(y.approval + 1, 0, 100); y.standing = clamp(y.standing + 1, 0, 100);
    msg = "Doors. The third house wanted the road, not the speech. You wrote the road down.";
  } else if(k === "debate"){
    y.influence = clamp(y.influence + 1, 0, 100); y.standing = clamp(y.standing + 1, 0, 100);
    msg = "You drilled the hard question until the answer was yours. A debate is a person, not a card.";
  }
  try{ G.camp.log.unshift({d:G.day, t:msg}); }catch(e){}
  return msg;
}
function onumElectCard(){
  govCardOpen("Elections", "The race, as a page of its own", "Polls, coverage, the people running, and what you do about them. The ballot itself still comes when the term ends.", onumElectBody(), null);
  const wire = () => card.querySelectorAll("[data-el]").forEach(b => b.addEventListener("click", () => {
    const msg = onumElectDo(b.getAttribute("data-el"));
    const s = el("elSay"); if(s) s.textContent = msg;
  }));
  wire();
}

function onumPeopleCard(){
  const y = G.you; if(!y) return;
  const list = []
    .concat(G.members || [])
    .concat(G.civ || [])
    .concat(G.press || [])
    .filter(m => m && !m.gone && m !== y && (m.met || (m.rel && Math.abs(m.rel.warmth || 0) > 8) || (m.soc && m.soc.k)));
  list.sort((a, b) => ((b.rel && b.rel.warmth) || 0) - ((a.rel && a.rel.warmth) || 0));
  const rows = list.slice(0, 14).map((m, i) => {
    const w = Math.round((m.rel && m.rel.warmth) || 0);
    const bond = (m.soc && m.soc.k) || (w > 35 ? "friend" : w > 12 ? "colleague" : w < -15 ? "estranged" : "acquaintance");
    const sp = onumSpouse(m);
    return '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + onumEsc(m.name) + '</b> <span class="muted">· ' + onumEsc(m.role || m.kind || "") + ' · ' + bond + ' · warmth ' + w + (sp ? ' · married to ' + onumEsc(sp.name) : '') + (y.courtId === m.id ? ' · you are courting' : '') + '</span><div class="muted" style="font-size:12px">' + onumEsc(onumOwn(m).slice(0, 220)) + '</div><div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" data-pp="' + i + ':sup">Supper</button><button type="button" class="btn btn--ghost" data-pp="' + i + ':confide">Confide</button><button type="button" class="btn btn--ghost" data-pp="' + i + ':court">Court</button><button type="button" class="btn btn--ghost" data-pp="' + i + ':cool">Step back</button></div><div class="dream" id="pp_' + i + '"></div></div>';
  }).join("");
  govCardOpen("People", "The same life, whichever chair you hold", "The House did not invent friendship. The wing does not cancel it. They answer as themselves.", rows || "<p class=\"muted\">You have not met anyone yet. Walk up to them.</p>", null);
  const shown = list.slice(0, 14);
  card.querySelectorAll("[data-pp]").forEach(b => b.addEventListener("click", () => {
    const [i, k] = b.getAttribute("data-pp").split(":"); const m = shown[+i]; if(!m) return;
    let t = "";
    if(k === "cool"){ onumTouch(m, -4, "colleague"); if(y.courtId === m.id) y.courtId = null; t = m.name + " takes the step back without a scene. “All right. Colleagues, then.”"; }
    else t = onumSocReply(m, k === "sup" ? "sup" : k === "court" ? "court" : "confide");
    const n = el("pp_" + i); if(n) n.textContent = t;
  }));
}

function onumExecActs(){
  const go = (t, c, fn) => ({t, c, run(){ try{ fn(); }catch(e){ try{ console.warn(t, e); setSay("That would not open.", ""); }catch(x){} } return null; }});
  return [
    go("Convene the cabinet", "they speak for their own departments", () => onumOpenCabinet()),
    go("Hear them at the table, one by one", "briefing", () => { try{ presBrief(); }catch(e){ onumCabinetCard(); } }),
    go("The situation room", "what the law lets you do", () => warCard()),
    go("Acts awaiting your name", "sign or veto", () => presActs()),
    go("Call a foreign capital", "their words, then yours", () => presForeign()),
    go("The press room", "on the record", () => officePress("the Executive's press room")),
    go("Appoint or replace a secretary", "three names", () => appointCard("cab")),
    go("Clemency", "three lives", () => onumPardon()),
    go("Call your party in", "they are not one voice", () => onumParty()),
    go("The people in your life", "same as the House", () => onumPeopleCard()),
    go("The election", "its own page", () => onumElectCard())
  ];
}
