/* ── settings, and rebinding the keys ── */
/* ══════════════════════════════════════════════════════════
   THE MEMBER'S HANDBOOK
   Everything this game does, written down in one place, in the order
   somebody would actually need it. It is reachable from the strip
   under the view and from Settings, and it does not assume you have
   read anything else.
   ══════════════════════════════════════════════════════════ */
const HANDBOOK = [
  {t:"The canon", rows:[
    ["God", "The Latin Rite holds that God is the Most High and Christ is King. No man in this building is God."],
    ["The House", "The sitting is here. Here is there. They have not all pondered it yet. The hunger under it is for God, not for a man."],
    ["The remnant", "The Consular Rite hides remainders in the building — flakes, folds, a chair they will not sit. They call them horcruxes. The Church calls them idols. They recruit in the corridor and among the new class. Every confession can arrive with a freshman. The chaplain still will not give them the Host."],
    ["Riverbend at large", "A clerk who does not leave. Ask him about the sitting."]
  ]},
  {t:"Moving about", rows:[
    ["W / S", "Walk forward and back."],
    ["A / D", "Turn your head left and right."],
    ["Q / C", "Step sideways without turning."],
    ["Arrow keys", "Look around, including up and down."],
    ["Drag the view", "Look, both axes, with the mouse."],
    ["Shift", "Stride. People notice if you barge past them."],
    ["The strip under the view", "Every room you can walk to, and how long it takes."]
  ]},
  {t:"Doing things", rows:[
    ["E", "Speak to whoever you are facing, or use whatever you are facing."],
    ["The prompt in the middle", "Tells you what E will do right now."],
    ["Sit", "Face a bench or a chair and press E. In a sitting, you take your own seat."],
    ["F", "Your phone — Vox, posting, your mail, and the count."],
    ["Hold V / Speak Aloud", "Speak into the room — no popup. 1–9 answer prompts. Pad: hold X to speak aloud, D-pad then A to confirm a numbered line."],
    ["H", "Open or close the covering panels. While you play, the UI stays off the glass."],
    ["Space", "Pause. 1× 2× 4× set the speed of the day."]
  ]},
  {t:"The controller", rows:[
    ["A", "Do the thing. Speak to whoever you face, use what you face, sit down — and in a conversation, say the line you have picked. A never answers for you: if nothing is picked, it picks the first and waits."],
    ["B", "Back out of anything: a note, the phone, a conversation, a card."],
    ["X and Y", "The first and second answers to whatever is being asked, straight off."],
    ["Y (nothing asked)", "Your phone."],
    ["D-pad", "Move through every answer on screen, however many there are."],
    ["LB / RB", "Walk through the panels on the right."],
    ["Start", "Pause."],
    ["The line at the bottom", "Says what each button does right now. It changes with what is in front of you."]
  ]},
  {t:"Talking to people", rows:[
    ["They start", "Everyone you stop wanted something out of their own day. Deal with that and they will hear yours."],
    ["Answering", "Pick a line, or type anything you like in the bar. They read what you actually wrote."],
    ["Out loud", "Whoever is close enough hears it too. The conversation header names them."],
    ["To the room", "Choose 'Everyone in the room' in the bar, or hold V with nobody in front of you."],
    ["Walking off", "Push somebody who is already sour and they will leave mid-sentence."],
    ["Nothing repeats", "No line in this building is said twice unless the game has run out of ways to say it."]
  ]},
  {t:"What matters", rows:[
    ["Memory", "Every favour, threat and broken promise is written down in their words and fades slowly. Grudges fade slowest."],
    ["You cannot see numbers", "You get a read, and the read is wrong in proportion to how little you know them."],
    ["It travels", "Hurt one and their friends hear. Every private threat becomes a secret with a clock on it."],
    ["Nothing for turning up", "Influence, standing, approval and money come only from what you do."],
    ["They have their own lives", "Members deal with each other all day — trading, leaning, falling out — whether you are there or not."]
  ]},
  {t:"The flag of Nieuw Oranje VII", rows:[
    ["The cross", "A Jerusalem cross: Christ at the center, the four corners of the earth. Salvation is in Him. Not in the Consul. Not in the House."],
    ["The old motto", "Non solis radios, sed fulmina Iovis affero — I bring not the rays of the sun, but the thunderbolts of Jupiter."],
    ["The thunderbolts", "Whose they are is written plainly: Jupiter's, and above Jupiter, God's. The hand that carried them across was a man's, and the oldest Ledger signs it only “P.”"],
    ["The Cross", "Salus in Christo solo — salvation in Christ alone. The thunderbolt is His. The Consul is not."],
    ["Taylor Day", "Only this flag flies. The First Consul pointed at the Cross so the living would not point at him."],
    ["You", "You follow the Lord. Through a member they may find Him. They know nothing, and they can learn."],
    ["The rest", "Open Circle, Congregation of the Self, Latest Study, Civic Flame, Green Observance, Chapel of the Numbers, Reformed Kerk — lampoons that still vote. Ask them their creed. They will explain themselves."],
    ["The net", "Each of them is a loop: they model you, pick a want, speak from it, and learn whether the world matched. Prediction error makes them slower to believe. Elsewhere means they were already in a thought that was not you."],
    ["Will", "Each of them carries a destiny that is not yours. Home, name, creed, a life outside the corridor. They will act on it when you are not looking. They will say no because of it. The pin is will."],
    ["The world", "There is a war that is not the bill. Grain, the strait, bread, a sky that rains on the steps. Ask them about abroad."],
    ["Soul", "Sanctioned. Each of them has a good they will not trade and a wound they still hear. The Latin Rite still prays. The pin is soul."],
    ["Shriving", "The chaplain sits the quiet end of the cloakroom. Say the thing. Not the speech. He is a clerk of it, not the mercy. Christ is the salvation. A desk goes empty for a funeral. Not for a war the House did not march to."],
    ["The wall", "If the fourth wall breaks, the sim cannot touch Dominic Zachary Taylor or his kin. Real names, real towns, real family — not in this. The utterance dies. The House continues."],
    ["The clerk", "Ioan Merrick, Independent, Riverbend at large. Seated by sanction. He does not leave. He is not the First Consul. Ask him who he is. He will not break the wall to answer."],
    ["Off duty", "They have teams, songs, hobbies — some with names this building has never heard. Ask about sport or music. They will invent if they have to."]
  ]},
  {t:"The House", rows:[
    ["The bill", "Drawn from a real state and a real town's real problem. Read it in full from the Floor panel."],
    ["Sittings", "Party meetings, hearings and debates happen in real time in the room. You are called and you speak."],
    ["Hearings", "Up to three witnesses at the table. Press them, give them room, or let them go. A member can be called too."],
    ["The roll call", "Two thirds overrides a veto. A court of five can strike a bill down."],
    ["Precedent", "You start at the 1st Congress. Everything in the record is something somebody here did."]
  ]},
  {t:"Vox", rows:[
    ["Everyone has a handle", "They @ each other by name, and they will @ you."],
    ["Being named", "Whoever you name sees it and answers, a minute or two later."],
    ["Posting", "Write it yourself on the phone. The game reads who you named and how you said it."],
    ["Reach", "A roll weighted by your standing. It carries, does its rounds, or goes nowhere."]
  ]},
  {t:"Keeping your place", rows:[
    ["Saving", "Save at any moment from the strip. It also auto-saves often (about every 8 in-game minutes, plus a wall-clock backup) and at every door / begin."],
    ["Ending the day", "Your desk, after five o'clock. Or the sofa, if you need the hours back first."],
    ["If it runs badly", "Settings → Graphics → Simple (Balanced is the default; Best is optional). Same game, much less asked of the machine."],
    ["A full room", "When a room fills (more than seven people) the game eases LODs and seated poses by itself — shadows stay on Best/Balanced. It goes back when the room thins below four."],
    ["If bodies look wrong", "Settings → Seated poses → Everyone stands, and Graphics → Simple. If either one fixes it, that is worth knowing."],
    ["Voices", "Settings → Voices. They speak aloud by default, and quieter the further away they are."]
  ]}
];
(function handbookInDom(){
  try{
    if(document.getElementById("handbookText")) return;
    const s = document.createElement("section");
    s.id = "handbookText"; s.setAttribute("aria-label", "The member's handbook");
    s.style.cssText = "position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:normal";
    s.innerHTML = "<h2>The member's handbook</h2>" + HANDBOOK.map(sec => "<h3>" + sec.t + "</h3>" + sec.rows.map(r => "<p><b>" + r[0] + "</b> " + r[1] + "</p>").join("")).join("");
    document.body.appendChild(s);
  }catch(e){}
})();
function handbookCard(){
  const wasRunning = G.running;
  G.running = false;
  card.innerHTML =
    '<div class="eyebrow">The member\'s handbook</div>' +
    '<h1>How all of this works.</h1>' +
    '<p>Nothing here is hidden behind anything else. If something in the building is not explained ' +
      'on this page, it is not a rule — it is somebody having an opinion about you.</p>' +
    HANDBOOK.map(sec =>
      '<div class="hb"><div class="hb__t">' + sec.t + '</div>' +
      sec.rows.map(r => '<div class="hb__r"><b>' + r[0] + '</b><span>' + r[1] + '</span></div>').join("") +
      '</div>').join("") +
    '<div class="card__actions"><button class="btn" type="button" id="hbDone">Back to it</button></div>';
  veil.hidden = false;
  el("hbDone").addEventListener("click", () => {
    veil.hidden = true;
    G.running = wasRunning || true;
    refreshPanels();
  });
}

function collabCard(){
  const wasRunning = G.running;
  G.running = false;
  TLSCollab.reload();
  const st = TLSCollab.state;
  const members = (G.members||[]).slice().sort((a,b)=>a.name.localeCompare(b.name));
  const mid = st.seatB.memberId;
  const memberOpts = '<option value="">— pick partner’s member —</option>' +
    members.map(m => '<option value="'+m.id+'"'+(m.id===mid?" selected":"")+'>'+m.name+' ('+m.party+')</option>').join("");
  const aN = (st.seatA.actions||[]).length, bN = (st.seatB.actions||[]).length;
  card.innerHTML =
    '<div class="eyebrow">Collab · two seats</div><h1>Play with someone.</h1>' +
    '<p>Seat <b>A</b> is your career save. Seat <b>B</b> is a partner profile tied to one House member. ' +
      'Votes and speeches log into whichever seat you are playing as. When they are away, Proxy AI votes from their real action history — not a random NPC. ' +
      'Sync by Export/Import JSON into <code>collab/</code> and git (browsers cannot scan that folder from <code>file://</code>).</p>' +
    '<div class="mk">' +
      '<div class="mk__row"><i>I’m playing as</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt'+(st.activeSeat!=="B"?" is-on":"")+'" data-seat="A">Seat A · you</button>' +
        '<button type="button" class="mk__opt'+(st.activeSeat==="B"?" is-on":"")+'" data-seat="B">Seat B · partner</button>' +
      '</div></div>' +
      '<div class="mk__row"><i>Partner name</i><div class="mk__opts">' +
        '<input type="text" id="colName" maxlength="40" value="'+(st.seatB.displayName||"").replace(/"/g,"&quot;")+'" ' +
          'style="flex:1;min-width:140px;padding:6px 8px;border:1px solid var(--line);border-radius:2px;background:var(--surface);color:var(--ink)">' +
      '</div></div>' +
      '<div class="mk__row"><i>Partner member</i><div class="mk__opts">' +
        '<select class="wire__to" id="colMember" '+(G.you?'':'disabled')+'>'+memberOpts+'</select>' +
      '</div></div>' +
      '<div class="mk__row"><i>Partner absent</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt'+(st.proxyAbsent?" is-on":"")+'" data-proxy="1">Proxy AI on</button>' +
        '<button type="button" class="mk__opt'+(!st.proxyAbsent?" is-on":"")+'" data-proxy="0">They’re here</button>' +
      '</div></div>' +
      '<div class="mk__row"><i>Style log</i><span class="muted" style="font-size:10.5px">' +
        'A: '+aN+' actions · B ('+(st.seatB.displayName||"Partner")+'): '+bN+' actions' +
        (window.ProxyAI ? ' · ProxyAI loaded' : ' · ProxyAI missing (collab/proxy.js)') +
      '</span></div>' +
      '<div class="mk__row"><i>Share</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt" id="colExport">Export JSON</button>' +
        '<button type="button" class="mk__opt" id="colImport">Import JSON</button>' +
        '<input type="file" id="colFile" accept="application/json,.json" hidden>' +
      '</div></div>' +
    '</div>' +
    '<div class="card__actions">' +
      '<button class="btn btn--ghost" type="button" id="colSettings">Settings</button>' +
      '<button class="btn" type="button" id="colDone">Back to it</button></div>';
  veil.hidden = false;
  card.querySelectorAll("[data-seat]").forEach(b => b.addEventListener("click", () => {
    TLSCollab.setActiveSeat(b.getAttribute("data-seat"));
    note("Recording style as Seat " + TLSCollab.state.activeSeat + ".");
    collabCard();
  }));
  const cn = el("colName");
  if(cn) cn.addEventListener("change", () => { TLSCollab.setPartnerName(cn.value); collabCard(); });
  const cm = el("colMember");
  if(cm) cm.addEventListener("change", () => {
    TLSCollab.setPartnerMemberId(cm.value);
    const m = byId(+cm.value);
    if(m) note("Partner seat is " + m.name + ".");
    collabCard();
  });
  card.querySelectorAll("[data-proxy]").forEach(b => b.addEventListener("click", () => {
    TLSCollab.setProxyAbsent(b.getAttribute("data-proxy") === "1");
    note(TLSCollab.state.proxyAbsent
      ? "Partner absent — Proxy AI will vote from their log."
      : "Partner present — Proxy AI off.");
    collabCard();
  }));
  el("colExport").addEventListener("click", () => {
    TLSCollab.downloadExport();
    note("Collab JSON downloaded — put it under collab/ for git.");
  });
  el("colImport").addEventListener("click", () => el("colFile").click());
  el("colFile").addEventListener("change", () => {
    const f = el("colFile").files && el("colFile").files[0];
    if(!f) return;
    const reader = new FileReader();
    reader.onload = () => {
      try{
        TLSCollab.importBundle(JSON.parse(reader.result));
        note("Collab profiles imported.");
        collabCard();
      }catch(e){ note("Could not import that JSON."); }
    };
    reader.readAsText(f);
  });
  el("colSettings").addEventListener("click", settingsCard);
  el("colDone").addEventListener("click", () => {
    veil.hidden = true; G.running = wasRunning || true; refreshPanels();
  });
}

const BIND_LABELS = {forward:"Walk forward", back:"Walk back", lookL:"Look left",
  lookR:"Look right", stepL:"Step left", stepR:"Step right",
  interact:"Speak / use", pause:"Pause", phone:"Your phone"};
let awaitingBind = null;
function keyName(k){ return k === " " ? "space" : (k || "—").toUpperCase(); }
function settingsCard(){
  const wasRunning = G.running;
  G.running = false;
  G.bind = G.bind || Object.assign({}, DEFAULT_BIND);
  card.innerHTML =
    '<div class="eyebrow">Settings</div><h1>How this plays.</h1>' +
    '<p><strong>KBM solo</strong> — full play, no pad, no D-pad arming. Hold <strong>?</strong> or <strong>/</strong> for on-glass tips. ' +
      '<strong>Pad solo</strong> — every action on the controller (sticks, A/B/X/Y, LT·RT, D-pad, shoulders, Start). ' +
      '<strong>Hybrid</strong> — pad + mouse look/click at once; neither stream disables the other. ' +
      'At a podium: <strong>E</strong> / <strong>1–9</strong> or pad <strong>A</strong> / <strong>LT·RT</strong>.</p>' +
    '<div class="mk">' +
      Object.keys(BIND_LABELS).map(k =>
        '<div class="mk__row"><i>' + BIND_LABELS[k] + '</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (awaitingBind===k?" is-on":"") +
        '" data-bind="' + k + '">' + (awaitingBind===k ? "press a key…" : keyName(G.bind[k])) +
        '</button></div></div>').join("") +
      '<div class="mk__row"><i>Look speed</i><input type="range" id="setSens" min="40" max="220" value="' +
        Math.round((G.sens||1)*100) + '"></div>' +
      '<div class="mk__row"><i>Film grain</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (G.noGrain?"":" is-on") + '" data-gr="0">On</button>' +
        '<button type="button" class="mk__opt' + (G.noGrain?" is-on":"") + '" data-gr="1">Off</button>' +
      '</div></div>' +
      (G.you ? '<div class="mk__row"><i>Your seat</i><div class="mk__opts">' +
        '<select class="wire__to" id="setState">' + STATES.map(st =>
          '<option value="' + st + '"' + (st === G.you.state ? " selected" : "") + '>' + st + '</option>').join("") +
        '</select>' +
        '<input type="number" id="setDist" min="1" max="24" value="' + G.you.dist +
          '" style="width:64px" aria-label="District">' +
      '</div></div>' : "") +
      '<div class="mk__row"><i>Seated poses</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (G.noSit?"":" is-on") + '" data-sit="0">People sit</button>' +
        '<button type="button" class="mk__opt' + (G.noSit?" is-on":"") + '" data-sit="1">Everyone stands</button>' +
      '</div></div>' +
      '<div class="mk__row"><i>Graphics</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (G.gfx==="best"?" is-on":"") + '" data-gfx="best">Best</button>' +
        '<button type="button" class="mk__opt' + (G.gfx==="balanced"?" is-on":"") + '" data-gfx="balanced">Balanced</button>' +
        '<button type="button" class="mk__opt' + (G.gfx==="simple"?" is-on":"") + '" data-gfx="simple">Simple</button>' +
      '</div></div>' +
      (crowdSafe && G.gfx !== "simple"
        ? '<div class="mk__row"><i></i><span class="muted" style="font-size:10.5px">' +
          'The room is full, so people are being drawn a little plainer for now. Shadows stay on. It goes back on its own.' +
          '</span></div>' : "") +
      (SHADER_TROUBLE ? '<div class="mk__row"><i>Driver said</i><span class="muted" style="font-size:10.5px">' +
        SHADER_TROUBLE.replace(/[<>]/g, "") + '</span></div>' : "") +
      '<div class="mk__row"><i>Voices</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (G.mute?"":" is-on") + '" data-vo="0">Hear them</button>' +
        '<button type="button" class="mk__opt' + (G.mute?" is-on":"") + '" data-vo="1">Read only</button>' +
      '</div></div>' +
      (G.mute ? "" :
      '<div class="mk__row"><i>How different</i><input type="range" id="setVar" min="0" max="200" value="' +
        Math.round((G.voiceVar === undefined ? 1 : G.voiceVar) * 100) + '"></div>' +
      '<div class="mk__row"><i>How fast</i><input type="range" id="setRate" min="70" max="130" value="' +
        Math.round((G.voiceRate === undefined ? 1 : G.voiceRate) * 100) + '"></div>' +
      '<div class="mk__row"><i>How far it carries</i><input type="range" id="setCarry" min="60" max="200" value="' +
        Math.round((G.voiceCarry === undefined ? 1 : G.voiceCarry) * 100) + '"></div>' +
      '<div class="mk__row"><i></i><button type="button" class="mk__opt" id="setTry">Hear a voice</button></div>') +
    '</div>' +
    '<div class="card__actions">' +
      '<button class="btn btn--ghost" type="button" id="setCollab">Collab</button>' +
      '<button class="btn btn--ghost" type="button" id="setBook">The handbook</button>' +
      '<button class="btn btn--ghost" type="button" id="setReset">Reset to defaults</button>' +
      '<button class="btn" type="button" id="setDone">Back to it</button></div>';
  veil.hidden = false;
  card.querySelectorAll("[data-bind]").forEach(b => b.addEventListener("click", () => {
    awaitingBind = b.getAttribute("data-bind"); settingsCard();
  }));
  const ss = el("setState"), sd = el("setDist");
  if(ss) ss.addEventListener("change", () => {
    G.you.state = ss.value; save(); refreshPanels();
    note("You now sit for " + G.you.state + " " + G.you.dist + ".");
  });
  if(sd) sd.addEventListener("change", () => {
    G.you.dist = clamp(+sd.value || 1, 1, 24); save(); refreshPanels();
  });
  card.querySelectorAll("[data-sit]").forEach(b => b.addEventListener("click", () => {
    G.noSit = b.getAttribute("data-sit") === "1";
    if(G.noSit) everyone().forEach(m => { m.sitting = false; });
    settingsCard();
  }));
  card.querySelectorAll("[data-gfx]").forEach(b => b.addEventListener("click", () => {
    G.gfx = b.getAttribute("data-gfx");
    G.simple = G.gfx === "simple";
    G.fullDetail = (G.gfx === "best");
    applyQuality();
    save();
    settingsCard();
  }));
  card.querySelectorAll("[data-vo]").forEach(b => b.addEventListener("click", () => {
    G.mute = b.getAttribute("data-vo") === "1";
    G.muteSet = true;
    if(G.mute) hush();
    else {
      unlockVoice();
      speak(G.you, "You can hear them now.");
    }
    settingsCard();
  }));
  card.querySelectorAll("[data-gr]").forEach(b => b.addEventListener("click", () => {
    G.noGrain = b.getAttribute("data-gr") === "1";
    el("grain").style.display = G.noGrain ? "none" : "";
    settingsCard();
  }));
  const sn = el("setSens");
  if(sn) sn.addEventListener("input", () => { G.sens = +sn.value/100; });
  const vv = el("setVar"), vr = el("setRate"), vc = el("setCarry"), vt = el("setTry");
  if(vv) vv.addEventListener("input", () => { G.voiceVar = +vv.value/100; });
  if(vr) vr.addEventListener("input", () => { G.voiceRate = +vr.value/100; });
  if(vc) vc.addEventListener("input", () => { G.voiceCarry = +vc.value/100; });
  if(vt) vt.addEventListener("click", () => {
    hush();
    unlockVoice();
    G.mute = false;
    const three = G.members.filter(m => !m.gone).slice(0, 3);
    if(!three.length && G.you) speak(G.you, "This is a voice in the House.");
    three.forEach((m, i) => setTimeout(() =>
      speak(m, "The member for " + m.state + " " + m.dist + ". That is my voice."), i * 2200));
  });
  el("setCollab").addEventListener("click", collabCard);
  el("setBook").addEventListener("click", handbookCard);
  el("setReset").addEventListener("click", () => {
    G.bind = Object.assign({}, DEFAULT_BIND); G.sens = 1; awaitingBind = null; settingsCard();
  });
  el("setDone").addEventListener("click", () => {
    awaitingBind = null; veil.hidden = true; G.running = wasRunning || true; save(); refreshPanels();
  });
}
el("btnPause").addEventListener("click", togglePause);
el("btnMenu").addEventListener("click", openSettings);

/* Settings menu event listeners */
const closeSettingsBtn = el("closeSettings");
if(closeSettingsBtn) closeSettingsBtn.addEventListener("click", closeSettings);
const resumeGameBtn = el("resumeGame");
if(resumeGameBtn) resumeGameBtn.addEventListener("click", closeSettings);
const resetSettingsBtn = el("resetSettings");
if(resetSettingsBtn) resetSettingsBtn.addEventListener("click", () => {
  try{ G.sens = 1; G.invertY = false; G.voiceVol = 1; G.voiceRate = 1; G.voiceCarry = 1; G.noGrain = false; G.noSit = false; const g = el("grain"); if(g) g.style.display = ""; }catch(e){}
  settingsState = {
    difficulty: "normal", graphicsQuality: "balanced", shadowsOn: true, bloomOn: true,
    antialiasing: "msaa4x", masterVolume: 80, voiceVolume: 85, sfxVolume: 70,
    spatialAudio: true, ttsEnabled: true, mouseSensitivity: 1.0, invertMouseY: false,
    walkSpeed: "normal", gamepadMode: false, autoSave: true,
    charSkinTone: "fair", charHairColor: "black", charEyeColor: "brown",
    charBodyType: "slim", charOutfitStyle: "formal"
  };
  saveSettings();
  setupSettingsUI();
});

document.addEventListener("keydown", (e) => {
  if(e.key === "Escape"){
    const overlay = el("pauseOverlay");
    if(overlay && overlay.classList.contains("is-open")){ e._pzHandled = true; closeSettings(); }
  }
});

loadSettings();

(function(){
  const openBtn = el("uiOpenBtn");
  if(openBtn) openBtn.addEventListener("click", () => openPanels());
  const mapBtn = el("uiMapBtn");
  if(mapBtn) mapBtn.addEventListener("click", () => {
    try{ mapCard(); }catch(e){ openPanels(); }
  });
  const walkBtn = el("uiWalkOut");
  if(walkBtn) walkBtn.addEventListener("click", () => { try{ walkOutNow(); }catch(e){} });
  const ub = el("unBare");
  if(ub) ub.addEventListener("click", () => openPanels());
  const settingsBtn = el("uiSettingsBtn");
  if(settingsBtn) settingsBtn.addEventListener("click", openSettings);
})();
document.querySelectorAll("#speed button[data-s]").forEach(b =>
  b.addEventListener("click", () => setSpeed(+b.getAttribute("data-s"))));

/* ── Xbox / any standard gamepad (optional, parallel to KBM) ─
   Three modes: KBM solo | pad solo | pad+mouse hybrid.
   Pad alone reaches every play action (sticks, A/B/X/Y, LT/RT, D-pad,
   LB/RB, Start). KBM alone never needs has-pad or D-pad PICK arming.
   Hybrid: mouse look/click stay live with a pad connected; pad sticks
   stay live while the mouse moves — both streams additive/parallel.
   Left stick walks, right stick looks, A speaks or confirms a D-pad-
   selected prompt, B closes, Start pauses. LT/RT browse speech and interview lines; A takes the one on the glass.
   Pad prompts (except catch/deliver) arm after D-pad selects them;
   KBM uses E / 1–9 / click with no such gate.
   Read once a frame rather than inside the clock, so it still answers
   while the game is paused or a card is up. */
const PAD = {vx:0, vz:0, turn:0, tilt:0, sprint:false};
const PADHELD = {};
const NOPICKS = [];
/* A sits / interacts, and confirms a line only after D-pad selects it.
   X/Y never auto-answer prompts. B is the way out. */
const PAD_GLYPH = [];
let PICKS = NOPICKS, PICK = -1, pickKey = "";
/* Everything you could click, in the order you would read it. With a card
   up that is the card; in a conversation it is the whole conversation and
   the bar under it; otherwise it is the room's own controls — where to go,
   the phone, save, settings, and the panel you are reading. */
function promptLive(){
  const pr = el("prompt");
  return !!(pr && !pr.hidden && pr.classList.contains("is-live"));
}
let _tabsEl = null, _paneOn = null;
function pickScopes(){
  if(!veil.hidden) return [card];
  if(TALK.open) return [el("talk")];
  const pr = el("prompt");
  /* Live glass prompt: D-pad / picks are prompt buttons only — never travel/dossier mix */
  if(pr && !pr.hidden && pr.classList.contains("is-live")) return [pr];
  const out = [];
  const pb = el("procBar");
  if(pb && !pb.hidden) out.push(pb);
  out.push(el("travel"));
  /* Cache dossier tabs/pane until markPicks — MutationObserver already dirties picks. */
  if(!_tabsEl) _tabsEl = document.querySelector(".tabs");
  if(picksDirty || !_paneOn || !_paneOn.classList.contains("is-on")){
    _paneOn = document.querySelector(".pane.is-on") || null;
  }
  if(_tabsEl) out.push(_tabsEl);
  if(_paneOn) out.push(_paneOn);
  out.push(el("speed"));
  return out.filter(Boolean);
}
/* The list is only re-read when the panel underneath it actually changes.
   A MutationObserver tells us when that happens for nothing, where a
   querySelectorAll every frame would cost real time. */
let picksDirty = true;
function markPicks(){ picksDirty = true; _tabsEl = null; _paneOn = null; }
if(window.MutationObserver){
  const mo = new MutationObserver(markPicks);
  mo.observe(card, {childList:true, subtree:true});
  mo.observe(el("chatSuggest"), {childList:true, subtree:true});
  mo.observe(veil, {attributes:true, attributeFilter:["hidden"]});
  const travel = el("travel"); if(travel) mo.observe(travel, {childList:true, subtree:true});
  const tk = el("tkActs"); if(tk) mo.observe(tk, {childList:true, subtree:true});
  const prn = el("prompt"); if(prn) mo.observe(prn, {childList:true, subtree:true, attributes:true, attributeFilter:["hidden","class"]});
  const pbar = el("procBar"); if(pbar) mo.observe(pbar, {childList:true, subtree:true, attributes:true, attributeFilter:["hidden"]});
}
let pickKeyCheap = "";
let NUMS = [];
function refreshPicks(){
  const pr = el("prompt");
  const live = !!(pr && !pr.hidden && pr.classList.contains("is-live"));
  /* Cheap key first — avoid querySelectorAll on the hot path when nothing changed. */
  let gpSig = "-";
  if(live){
    gpSig = "L:" + (CATCH.on ? ("c:" + (CATCH.current ? CATCH.current.key : "done") + ":" + ((CATCH.pieces&&CATCH.pieces.length)||0)) : ("p:" + (promptKey||"")));
  } else if(!veil.hidden){
    gpSig = "card:" + (phoneWasRunning !== null ? ("ph:"+phoneTab) : "veil");
  } else if(TALK.open){
    gpSig = "talk";
  }
  const keyCheap = (veil.hidden ? "0" : "1") + "|" + (TALK.open ? "1" : "0") + "|" + (uiOpen() ? "1" : "0") + "|" + gpSig;
  if(!picksDirty && keyCheap === pickKeyCheap) return;
  /* Catch/prompt identity in pickKey so rebuilds with the same buttons do not thrash */
  if(live){
    gpSig += "|" + [...pr.querySelectorAll("button.prompt__btn")].map(b => b.getAttribute("data-gp")||"").join(",");
  }
  const key = keyCheap + (live ? ("#" + gpSig) : "");
  /* Remember selection across DOM rebuilds (data-gp on prompt buttons) */
  let keepGp = null;
  if(PICK >= 0 && PICKS[PICK]) keepGp = PICKS[PICK].getAttribute("data-gp");
  const prevPick = PICK;
  const sameSet = (key === pickKey);
  if(!picksDirty && sameSet){ pickKeyCheap = keyCheap; return; }
  picksDirty = false; pickKey = key; pickKeyCheap = keyCheap;
  PICKS.forEach(b => b.classList.remove("is-pick"));
  const out = [];
  for(const sc of pickScopes()){
    const q = (live && sc === pr) ? "button.prompt__btn" : "button, .sugg, .mk__opt, [data-ans], [data-mail], .tabs button";
    sc.querySelectorAll(q).forEach(b => {
      if(b.disabled || b.hidden) return;
      if(b.id === "uiOpenBtn" || b.id === "uiMapBtn" || b.id === "unBare") return;
      if(!b.offsetParent && b.offsetHeight === 0) return;   /* not on screen */
      if(out.indexOf(b) < 0) out.push(b);
    });
  }
  PICKS = out.length ? out : NOPICKS;
  /* Number badges 1–9 for quick answers (keyboard + visible on pad). */
  const _pb = el("procBar");
  const _numOK = !veil.hidden || TALK.open || live || (_pb && !_pb.hidden);
  NUMS = _numOK ? PICKS.filter(b => !b.closest(".tabs") && !b.closest("#travel") && !/^(close|back|×|✕)$/i.test((b.textContent || "").trim())) : [];
  document.querySelectorAll("[data-btn]").forEach(b => { delete b.dataset.btn; });
  NUMS.forEach((b, i) => { if(i < 9) b.dataset.btn = String(i + 1); });
  /* Preserve selection: never wipe PICK on an identical button set; re-apply is-pick by data-gp */
  let restored = -1;
  if(keepGp != null){
    const ix = PICKS.findIndex(b => b.getAttribute("data-gp") === keepGp);
    if(ix >= 0) restored = ix;
  }
  if(restored < 0 && sameSet && prevPick >= 0 && prevPick < PICKS.length) restored = prevPick;
  if(restored >= 0){
    PICK = restored;
    PICKS[PICK].classList.add("is-pick");
  } else {
    PICK = -1;
  }
}
function movePick(d){
  if(!PICKS.length) return;
  PICKS.forEach(b => b.classList.remove("is-pick"));
  PICK = PICK < 0 ? (d > 0 ? 0 : PICKS.length-1) : (PICK + d + PICKS.length) % PICKS.length;
  const b = PICKS[PICK];
  b.classList.add("is-pick");
  if(b.scrollIntoView) b.scrollIntoView({block:"nearest"});
}
function firePick(){
  const b = PICKS[PICK];
  if(!b) return false;
  b.classList.remove("is-pick");
  PICK = -1; picksDirty = true;
  b.click();
  return true;
}
/* Out of whatever is nearest, one layer at a time: a note, then the
   phone, then a conversation, then a card that can be dismissed. If
   there is nothing to leave, B puts the display back. */
/* A line along the bottom of the view saying what each button does
   right now — it changes with what is in front of you, and it is only
   there when a pad actually is. */
let legendWas = "";
function padLegend(on){
  const box = el("padBar");
  if(!box) return;
  document.body.classList.toggle("has-pad", !!on);
  document.body.classList.toggle("in-session", !!(PROC && PROC.on));
  /* Pad legend stays up whenever a pad is connected — including while CATCH / glass prompts are live */
  if(!on){ if(!box.hidden){ box.hidden = true; legendWas = ""; } return; }
  const n2 = PICKS.length;
  const bits = [];
  const glass = promptLive();
  const phoneOpen = !veil.hidden && phoneWasRunning !== null;
  const asked = !veil.hidden || TALK.open || (PROC.on && PROC.phase === "you") || glass;
  const focus = !asked && focusThing();
  /* Prompts are only armed after D-pad moves onto them; A confirms. */
  const canDeliver = CATCH.on && CATCH.pieces && CATCH.pieces.length && !CATCH.current;
  const seatVoice = !canDeliver && !CATCH.current && (typeof seatVoiceAvailable === "function") && seatVoiceAvailable();
  bits.push(["A", (CATCH.on && CATCH.current) ? "take this line"
           : canDeliver ? "deliver speech"
           : seatVoice ? (PICK >= 0 && PICKS[PICK] ? "confirm seated #" + (PICK+1) : "D-pad a seated line")
           : glass && PICK >= 0 && PICKS[PICK] ? "confirm prompt #" + (PICK+1)
           : glass && n2 === 1 ? "confirm prompt"
           : phoneOpen ? (PICK >= 0 && PICKS[PICK] ? "confirm #" + (PICK+1) : "D-pad / stick a button")
           : focus ? (focus.type === "person" ? "speak to " + surname(focus.ref.name) : (focus.ref && focus.ref.id === "desk" && !G.you.sitting ? "sit at desk" : "use " + focus.ref.label))
           : PICK >= 0 && PICKS[PICK] ? "confirm #" + (PICK+1)
           : (nearOfficeDesk && nearOfficeDesk()) ? (G.you.sitting ? "stand" : "sit at desk")
           : seatUnderYou() ? (G.you.sitting ? "stand" : "sit")
           : n2 ? "D-pad / 1–9 a line"
           : "speak / use"]);
  if(phoneOpen) bits.push(["LT·RT", "phone tabs"]);
  else if(CATCH.on && CATCH.current) bits.push(["LT·RT", "browse speech / interview"]);
  else if(canDeliver) bits.push(["LT·RT", "deliver pieced speech"]);
  else if(seatVoice) bits.push(["LT·RT", "cycle seated voice"]);
  if(phoneOpen) bits.push(["L-stick", "move cursor"]);
  if(n2) bits.push(["✛", PICK >= 0 ? ("#" + (PICK+1) + "/" + n2) : "choose 1–" + Math.min(9, n2)]);
  bits.push(["X", "day schedule"]);
  bits.push(["hold X", "speak aloud"]);
  bits.push(["Y", "phone"]);
  bits.push(["B", !el("tipCard").hidden ? "close" : !veil.hidden ? "put it away"
                : TALK.open ? "leave it" : uiOpen() ? "back to room"
                : (CATCH.on || glass) ? "back out of speech" : "clear / back"]);
  bits.push(["LB RB", phoneOpen ? (phoneTab === "panels" ? "house tabs / apps" : "phone apps") : "panels"]);
  const html = bits.map(b => '<span><b>' + b[0] + '</b>' + b[1] + '</span>').join("");
  if(html !== legendWas){ legendWas = html; setHTML(box, html); }
  box.hidden = false;
}
function clearSpeechBusy(reason){
  /* Peel stuck CATCH / approach / glass so B and Esc always free you */
  const wasSpeech = !!(CATCH.on || CATCH.current || (CATCH.pieces && CATCH.pieces.length) ||
    CATCH.armedByInteract || G.speechApproach || (typeof promptLive === "function" && promptLive()));
  try{ G.speechApproach = null; }catch(e){}
  /* Only mark suppressed when backing out of real speech UI — not when peeling phone/panels */
  const why = (reason === "back" || reason === "esc") && wasSpeech ? "back"
            : reason === "busy" && wasSpeech ? "back"
            : (reason || "busy");
  try{ catchClear(why === "back" ? "back" : "busy-clear"); }catch(e){}
  try{
    promptKey = "";
    const pr = el("prompt");
    if(pr){ pr.classList.remove("is-catch"); }
    /* If still in a live sitting and seated, let updatePrompt redraw seat voice */
    if(!(PROC.on && G.you && G.you.sitting && SEATED_ROOMS[G.room])){
      setGlassPrompt(null, null);
    }
  }catch(e){}
  picksDirty = true;
}
function padBack(){
  /* B always wins: peel one layer, then covering UI, then hard-reset busy state to the room */
  const tip = el("tipCard");
  if(tip && !tip.hidden){ closeTip(); return; }
  if(!veil.hidden && phoneWasRunning !== null){ phoneClose(); return; }
  if(TALK.open){ closeTalk(); return; }
  if(!veil.hidden){
    /* a card with a plain way out takes it; a card that must be answered
       is left alone, because that is the point of it */
    const outs = [...card.querySelectorAll(".btn, .conc__btn")].filter(b =>
      !b.disabled && /back to it|leave it|close|not now|later|done|start the day|put it away|fold it|stay here/i.test(b.textContent));
    if(outs.length){ outs[outs.length - 1].click(); return; }
    return;
  }
  if(uiOpen()){ closePanels(); resetPlayerBusy(); return; }
  if(PROC.on){ leaveSittingQuiet(); return; }
  /* Stuck in CATCH / speech glass / approach — B backs all the way out */
  if(CATCH.on || CATCH.current || (CATCH.pieces && CATCH.pieces.length) || CATCH.armedByInteract || G.speechApproach || promptLive()){
    clearSpeechBusy("back");
    feed("Back out of the speech prompt.");
    try{ if(typeof updatePrompt === "function"){ const seat = seatUnderYou(); updatePrompt(focusThing(), null, seat); } }catch(e){}
    return;
  }
  /* Already on the main screen — clear whatever the character was doing */
  resetPlayerBusy();
}
/* the shoulders move through the panels */
function padTab(d){
  /* Phone open: LB/RB walk phone apps accurately (Day / House / Vox / …).
     House panels tab: then walk dossier tabs inside. Otherwise open House panels. */
  const phoneOpen = !veil.hidden && phoneWasRunning !== null;
  if(phoneOpen){
    if(phoneTab === "panels"){
      const tabs = [...document.querySelectorAll(".dossier .tabs button")];
      if(tabs.length){
        let i = tabs.findIndex(b => b.classList.contains("is-on"));
        if(i < 0) i = 0;
        const atEnd = (d > 0 && i === tabs.length - 1) || (d < 0 && i === 0);
        if(!atEnd){
          tabs[(i + d + tabs.length) % tabs.length].click();
          picksDirty = true;
          return;
        }
      }
      /* Fall off either end of dossier tabs → neighbouring phone app */
      phoneCycleTab(d);
      return;
    }
    phoneCycleTab(d);
    return;
  }
  if(!uiOpen()){
    openPanels();
    return;
  }
  const tabs = [...document.querySelectorAll(".dossier .tabs button")];
  if(!tabs.length) return;
  let i = tabs.findIndex(b => b.classList.contains("is-on"));
  if(i < 0) i = 0;
  tabs[(i + d + tabs.length) % tabs.length].click();
  picksDirty = true;
}
let PAD_SEEN = false;
try{
  addEventListener("gamepadconnected", () => { PAD_SEEN = true; });
  addEventListener("gamepaddisconnected", () => {
    try{
      const pads = navigator.getGamepads ? navigator.getGamepads() : [];
      PAD_SEEN = false;
      for(let i=0;i<pads.length;i++) if(pads[i] && pads[i].connected){ PAD_SEEN = true; break; }
    }catch(e){ PAD_SEEN = false; }
  });
}catch(e){}
/* the pause menu, driven by a controller */
function padPauseMenu(gp){
  const b = gp.buttons || [];
  const down = i => !!(b[i] && b[i].pressed);
  const edge = i => { const d = down(i), was = !!PADHELD[i]; PADHELD[i] = d; return d && !was; };
  const ov = el("pauseOverlay"); if(!ov) return;
  const ctrls = [...ov.querySelectorAll("button, input, select")].filter(c => !c.disabled && c.offsetParent !== null);
  if(!ctrls.length) return;
  let i = ctrls.indexOf(document.activeElement);
  const ay = (gp.axes || [])[1] || 0, axx = (gp.axes || [])[0] || 0;
  const stickUp = ay < -0.6, stickDn = ay > 0.6, stickL = axx < -0.6, stickR = axx > 0.6;
  const sEdge = (k, v) => { const was = !!PADHELD[k]; PADHELD[k] = v; return v && !was; };
  const up = edge(12) | sEdge("_pzU", stickUp), dn = edge(13) | sEdge("_pzD", stickDn);
  const lf = edge(14) | sEdge("_pzL", stickL), rt = edge(15) | sEdge("_pzR", stickR);
  const a = edge(0), back = edge(1), start = edge(9);
  const lb = edge(4), rb = edge(5);
  if(lb || rb){
    const tabs = [...ov.querySelectorAll("[data-tab]")];
    const cur = tabs.findIndex(t => t.classList.contains("is-active") || t.getAttribute("aria-selected") === "true");
    const nx = tabs[((cur < 0 ? 0 : cur) + (rb ? 1 : -1) + tabs.length) % tabs.length];
    if(nx){ nx.click(); try{ nx.focus(); }catch(e){} }
    return;
  }
  if(back || start){ PADHELD[9] = true; closeSettings(); return; }
  const focus = j => { const c = ctrls[(j + ctrls.length) % ctrls.length]; try{ c.focus({preventScroll:false}); c.scrollIntoView({block:"nearest"}); }catch(e){} };
  if(i < 0 && (up || dn || lf || rt || a)){ focus(0); return; }
  if(up) focus(i - 1);
  else if(dn) focus(i + 1);
  else if(lf || rt){
    const c = ctrls[i];
    if(c && c.type === "range"){
      try{ rt ? c.stepUp(Math.max(1, Math.round((c.max - c.min) / 20 / (+c.step || 1)))) : c.stepDown(Math.max(1, Math.round((c.max - c.min) / 20 / (+c.step || 1)))); }catch(e){}
      c.dispatchEvent(new Event("input", {bubbles:true})); c.dispatchEvent(new Event("change", {bubbles:true}));
    } else focus(i + (rt ? 1 : -1));
  } else if(a){
    const c = ctrls[i];
    if(c && c.type !== "range"){ c.click(); }
  }
}
function pollPad(){

  PAD.vx = PAD.vz = PAD.turn = PAD.tilt = 0; PAD.sprint = false;
  if(!PAD_SEEN){
    if(picksDirty) refreshPicks();
    return;
  }
  const pads = navigator.getGamepads ? navigator.getGamepads() : [];
  let gp = null;
  for(let i=0;i<pads.length;i++) if(pads[i] && pads[i].connected){ gp = pads[i]; break; }
  /* Rebuild picks only when dirty or a pad is actually live — a card on
     screen used to refresh the list sixty times a second and peg a core. */
  if(picksDirty || gp) refreshPicks();
  padLegend(!!gp);
  if(!gp) return;
  try{ if(tlPad(gp)) return; }catch(e){}
  const dz = v => Math.abs(v) < 0.18 ? 0 : (v - Math.sign(v)*0.18)/0.82;
  const ax0 = gp.axes || [];
  /* radial deadzone per stick: a diagonal stays a diagonal, rest drift dies */
  const rad = (x, y, look) => {
    x = +x || 0; y = +y || 0; const m = Math.hypot(x, y);
    if(m < 0.16) return [0, 0];
    let s = Math.min(1, (m - 0.16) / 0.84);
    if(look) s = s * (0.45 + 0.55 * s);   /* fine aim near center, full turn at the rim */
    return [x / m * s, y / m * s];
  };
  const L = rad(ax0[0], ax0[1], false), Rs = rad(ax0[2], ax0[3], true);
  const ax = ax0.slice(); ax[0] = L[0]; ax[1] = L[1]; ax[2] = Rs[0]; ax[3] = Rs[1];
  if(G._pauseOpen){
    padPauseMenu(gp);
    return;
  }
  const phoneOpen = !veil.hidden && phoneWasRunning !== null;
  const glass = promptLive();
  if(phoneOpen || uiOpen()){
    /* Phone / panels own the pad — avatar does not move or look-walk */
    PAD.vx = PAD.vz = PAD.turn = PAD.tilt = 0;
  } else if(glass){
    /* Live glass: no locomotion (selection stays put); look still allowed */
    PAD.vx = PAD.vz = 0;
    PAD.turn = -(ax[2] || 0) * 1.7;
    PAD.tilt = -(ax[3] || 0) * 1.2;
  } else {
    PAD.vx   =  (ax[0] || 0);
    PAD.vz   = -(ax[1] || 0);
    PAD.turn = -(ax[2] || 0) * 1.7;
    PAD.tilt = -(ax[3] || 0) * 1.2;
  }
  /* Phone: left stick drives UI cursor among PICKS (edge / threshold → movePick) */
  if(phoneOpen && PICKS.length){
    const lx = dz(ax[0] || 0), ly = dz(ax[1] || 0);
    const mag = Math.hypot(lx, ly);
    if(mag < 0.55){ PADHELD._stickPick = false; }
    else if(!PADHELD._stickPick){
      PADHELD._stickPick = true;
      if(Math.abs(ly) >= Math.abs(lx)) movePick(ly > 0 ? 1 : -1);
      else movePick(lx > 0 ? 1 : -1);
    }
  } else {
    PADHELD._stickPick = false;
  }
  const b = gp.buttons || [];
  const down = i => !!(b[i] && b[i].pressed);
  const edge = i => { const d = down(i), was = !!PADHELD[i]; PADHELD[i] = d; return d && !was; };
  /* LT=6 RT=7 (standard mapping). Analog .value and common trigger axes (>0.5) also count. */
  const trigVal = (i) => {
    const btn = b[i];
    let v = btn ? Math.max(btn.pressed ? 1 : 0, btn.value || 0) : 0;
    if(i === 6){ if(ax[4] > 0) v = Math.max(v, ax[4]); if(ax[6] > 0) v = Math.max(v, ax[6]); }
    if(i === 7){ if(ax[5] > 0) v = Math.max(v, ax[5]); if(ax[7] > 0) v = Math.max(v, ax[7]); }
    return v;
  };
  const ltHeld = trigVal(6) > 0.5, rtHeld = trigVal(7) > 0.5;
  const ltEdge = ltHeld && !PADHELD._lt; PADHELD._lt = ltHeld;
  const rtEdge = rtHeld && !PADHELD._rt; PADHELD._rt = rtHeld;
  /* At a live CATCH line, LT/RT are quick catch. When stream spent with pieces, LT/RT deliver. Seated: cycle. Else sprint with L3. */
  const deliverReady = CATCH.on && CATCH.pieces && CATCH.pieces.length && !CATCH.current;
  const seatVoiceOn = !deliverReady && !CATCH.current && (typeof seatVoiceAvailable === "function") && seatVoiceAvailable();
  if(down(10) || ((ltHeld || rtHeld) && !(CATCH.on && CATCH.current) && !seatVoiceOn && !deliverReady && !phoneOpen)) PAD.sprint = true;
  if((ltEdge || rtEdge) && CATCH.on && CATCH.current){ try{ catchStep(rtEdge ? 1 : -1); }catch(e){} }
  else if((ltEdge || rtEdge) && deliverReady){ try{ deliverAssembledSpeech(); }catch(e){} }
  else if((ltEdge || rtEdge) && seatVoiceOn && PICKS.length){ movePick(rtEdge ? 1 : -1); }
  else if(phoneOpen && (ltEdge || rtEdge)){
    /* Phone: triggers walk apps accurately (same as bumpers) */
    phoneCycleTab(rtEdge ? 1 : -1);
  }
  const up = edge(12), dn = edge(13), lf = edge(14), rt = edge(15);
  /* Phone / glass: D-pad moves among real buttons only */
  if(PICKS.length && (glass || phoneOpen || up || dn || lf || rt)){
    if(up || lf) movePick(-1);
    if(dn || rt) movePick(1);
  }
  /* Xbox: A = sit / interact (and confirm a D-pad-selected prompt).
     Catch-stream is an exception: only one live line — A catches it immediately.
     Other prompts only fire after the D-pad has moved onto them. */
  const prompted = PICKS.length > 0;
  if(edge(0)){
    if(CATCH.on && CATCH.current){ catchNow(); }
    else if(CATCH.on && CATCH.pieces && CATCH.pieces.length && !CATCH.current){ deliverAssembledSpeech(); }
    else if(phoneOpen && PICK >= 0 && PICKS[PICK]){ firePick(); }
    else if(phoneOpen && PICKS.length === 1){ PICK = 0; firePick(); }
    else if(glass && PICKS.length === 1){ PICK = 0; firePick(); }
    else if((typeof seatVoiceAvailable === "function") && seatVoiceAvailable() && PICK >= 0 && PICKS[PICK]){ firePick(); }
    else if(glass && PICK >= 0 && PICKS[PICK]){ firePick(); }
    else if(!veil.hidden && PICKS.length === 1){ PICK = 0; firePick(); }
    else if(!veil.hidden && PICK < 0 && PICKS.length){
      /* Card up: A hits the primary action without requiring D-pad first (Continue / Sleep / Start the day). */
      const primary = card.querySelector(".card__actions .btn:not(.btn--ghost)") || card.querySelector(".card__actions .btn") || PICKS[0];
      const ix = primary ? PICKS.indexOf(primary) : 0;
      PICK = ix >= 0 ? ix : 0;
      firePick();
    }
    else {
      const asked = !veil.hidden || TALK.open || (PROC.on && PROC.phase === "you");
      /* Confirm only a prompt the D-pad has actually landed on */
      if(asked && PICK >= 0 && PICKS[PICK]){ firePick(); }
      else if(!asked && veil.hidden){
        const seat = seatUnderYou();
        const talk = personInTalkRange();
        const t = focusThing();
        /* Desk / seat wins unless someone is truly in talk range and centered on you */
        if(nearOfficeDesk() && !talk){ toggleSit(); }
        else if(seat && !talk){ toggleSit(); }
        else if(t){ (t.type === "person" ? openTalk : interactPropOrSpeech)(t.ref); }
        else if(seat){ toggleSit(); }
        else if(PICK >= 0 && PICKS[PICK]){ firePick(); }
      } else if(PICK >= 0 && PICKS[PICK]){ firePick(); }
    }
  }
  if(edge(1)) padBack();
  /* X tap = today's schedule · hold X (~0.4s) = speak aloud (Hold V still works on KBM) */
  {
    const xDown = down(2);
    if(edge(2)){ PADHELD._xAt = performance.now(); PADHELD._xMic = false; }
    if(xDown && PADHELD._xAt && !PADHELD._xMic && (performance.now() - PADHELD._xAt) >= 400){
      PADHELD._xMic = true; PADHELD._micX = true;
      micStart(); const ab=el("aloudBtn"); if(ab) ab.classList.add("is-live");
    }
    if(!xDown && PADHELD._xAt){
      const held = performance.now() - PADHELD._xAt;
      if(PADHELD._xMic || PADHELD._micX){
        PADHELD._micX = false; PADHELD._xMic = false;
        micStop(); const ab=el("aloudBtn"); if(ab) ab.classList.remove("is-live");
      } else if(held < 400){
        try{ openDaySchedule(); }catch(e){}
      }
      PADHELD._xAt = 0;
    }
  }
  if(edge(3)){
    /* Y: phone only — never a shortcut past D-pad prompt picks */
    if(!veil.hidden && phoneWasRunning !== null) phoneClose();
    else if(veil.hidden && !TALK.open && G.running) phoneCard();
  }
  if(edge(9)){
    if(G.you && veil.hidden && !TALK.open && G.running){ try{ openSettings(); }catch(e){ togglePause(); } }
    else togglePause();
  }
  /* the shoulders walk the panels, so the whole dossier is reachable */
  if(edge(4)) padTab(-1);
  if(edge(5)){ if(PROC.on && PROC.phase !== "you") procHurry(); else padTab(1); }
  /* View / Back opens the phone too, for anyone who reaches for it */
  if(edge(8) || edge(16)){
    if(!veil.hidden && phoneWasRunning !== null) phoneClose();
    else if(veil.hidden && !TALK.open && G.running) phoneCard();
  }

}

function tick(dt){
  /* A stalled tab can report a huge delta; never turn that into a physics
     teleport or a burst of room/voice work after the tab resumes. */
  dt = clamp(Number(dt) || 0.016, 0.001, 0.05);
  G.t += dt;
  const w = dt * G.speed;          /* how fast the day runs around you */
  /* proper WASD: W/S walk, A/D step sideways, arrows look around */
  let vx = 0, vz = 0, turn = 0, tilt = 0;
  const KB = G.bind || DEFAULT_BIND;
  if(keys[KB.forward]) vz += 1;
  if(keys[KB.back]) vz -= 1;
  if(keys[KB.stepL]) vx -= 1;
  if(keys[KB.stepR]) vx += 1;
  /* The camera carries a half-turn offset, so increasing yaw swings the
     view to the LEFT — the look-left key must add, not subtract. */
  if(keys[KB.lookL] || keys.arrowleft)  turn += 1;
  if(keys[KB.lookR] || keys.arrowright) turn -= 1;
  if(keys.arrowup)    tilt += 1;
  if(keys.arrowdown)  tilt -= 1;
  let sprint = !!keys.shift;

  /* Pad sticks add on top of keyboard — hybrid-safe; mouse look is separate
     (direct cam.yaw/pitch deltas) and is never disabled when a pad is live. */
  vx += PAD.vx; vz += PAD.vz; turn += PAD.turn; tilt += PAD.tilt * (G.invertY ? -1 : 1);
  if(G.sens && G.sens !== 1){ turn *= G.sens; tilt *= G.sens; }
  if(PAD.sprint) sprint = true;
  /* Phone open (or pause menu up): avatar does not move — ignore WASD / sticks for locomotion */
  if((!veil.hidden && phoneWasRunning !== null) || G._pauseOpen){
    vx = 0; vz = 0; turn = 0; tilt = 0; sprint = false;
    PAD.vx = PAD.vz = PAD.turn = PAD.tilt = 0;
  }

  /* looking eases in and eases out rather than snapping on and off */
  cam.yawVel = smooth(cam.yawVel, turn * 1.15, 0.012, dt);
  cam.yaw += cam.yawVel * dt;
  cam.pitchVel = smooth(cam.pitchVel, tilt * 0.85, 0.012, dt);
  cam.pitch = clamp(cam.pitch + cam.pitchVel * dt, -1.15, 1.15);

  /* forward is the camera's -Z; right is its +X, which with the half-turn
     offset comes out as (-cos, sin). Getting this wrong mirrors A and D. */
  const f = {x:Math.sin(cam.yaw), z:Math.cos(cam.yaw)};
  const r = {x:-Math.cos(cam.yaw), z:Math.sin(cam.yaw)};
  /* walking while seated stands you up, rather than dragging the chair */
  if(G.you && G.you.sitting && (vx || vz)){
    G.you.sitting = false;
    feed("You get up.");
    if(G._deskWasBare){
      G._deskWasBare = false;
      try{ setImmersive(true); }catch(e){}
    }
  }
  let _ws = 1; try{ const v = settingsState && settingsState.walkSpeed; _ws = v === "slow" ? 0.78 : v === "fast" ? 1.22 : 1; }catch(e){}
  const top = (sprint ? 1.48 : 0.88) * _ws;
  const mag = Math.hypot(vx, vz) || 1;
  const wantX = (f.x*vz + r.x*vx) / mag * top * (vx||vz ? 1 : 0);
  const wantZ = (f.z*vz + r.z*vx) / mag * top * (vx||vz ? 1 : 0);
  const moveDt = Math.min(dt, 0.12);   /* time-based: the same metres per second at 15 fps or 144 */
  const catchUp = 1 - Math.exp(-((vx||vz) ? 5.5 : 9) * moveDt);
  cam.vx += (wantX - cam.vx) * catchUp;
  cam.vz += (wantZ - cam.vz) * catchUp;
  cam.vx = clamp(cam.vx, -top, top);
  cam.vz = clamp(cam.vz, -top, top);
  let dx = cam.vx * moveDt, dz = cam.vz * moveDt;
  const span = Math.hypot(dx, dz);
  if(span > top * moveDt * 1.05 + 0.002){ const s = (top * moveDt * 1.05 + 0.002) / span; dx *= s; dz *= s; }
  const b = roomBox(G.room || "office");
  cam.x = clamp(cam.x + dx, -b.hw, b.hw);
  cam.z = clamp(cam.z + dz, b.d0, b.d1);
  if(G.room === "district" && NM.solids.length) nmPush();
  cam.ground = groundAt(cam.z, G.room);
  if(vx || vz) G.speechApproach = null;
  try{ tickSpeechApproach(dt); }catch(e){}
  try{ enforceLecternCapPlayer(); }catch(e){}
  const spd = Math.hypot(cam.vx, cam.vz);
  cam.speed = smooth(cam.speed, Math.min(1, spd/1.8), 0.001, dt);
  cam.bob += spd * dt * 4.2;
  cam.lean = smooth(cam.lean, -cam.yawVel*0.05 - (r.x*cam.vx + r.z*cam.vz)*0.014, 0.002, dt);
  const wantFov = (sprint && spd > 1.35) ? 64 : 58;
  if(camera && Math.abs((camera.fov || 58) - wantFov) > 0.4){
    camera.fov += (wantFov - camera.fov) * Math.min(1, dt * 6);
    if((FRAME_ID & 1) === 0) camera.updateProjectionMatrix();
  }
  if(G.you && spd > 0.15) G.you.energy = clamp(G.you.energy - dt*0.34*(spd/1.8), 0, 100);
  if(G.t >= (G.doorGrace||0)) walkThroughDoors();
  if(!G.moving && G.t >= (G.doorGrace||0) && ((FRAME_ID & 3) === 0 || spd < 0.08)) bumpCheck(sprint);
  if(G.speed <= 0 || G.pendingNight) return;
  if((G.minute || 0) >= 22*60){ beginNight(); return; }
  if(G._bootGraceUntil && performance.now() < G._bootGraceUntil){
    procTick(dt);
    return;
  }
  /* Lives are not the frame. The House thinks on its own clock.
     20261011d: but feet are. Walking is cheap arithmetic and runs every sim step. */
  try{ wanderFrame(dt); }catch(e){}
  procTick(dt);
}
function wanderFrame(dt){
  if(!G.running || G.pendingNight) return;
  const list = hereNow();
  for(let i = 0; i < list.length; i++){
    const m = list[i];
    if(!m || m.gone) continue;
    try{ wander(m, dt); }catch(e){}
  }
}
function drainHouseOne(w, dt){
  /* One House mind per premise beat. Not the frame.
     20261001a: bail if this premise pulse already paid >3.5ms (keep one unit max). */
  const t0 = performance.now();
  if((G._premSpent || 0) > 3.5){ return; }
  if(G._drainLane == null) G._drainLane = 0;
  const lane = (G._drainLane++) % 13;
  if(lane === 0) sentWorld(w);
  else if(lane === 1) clockRoom(w);
  else if(lane === 2) crowdWatch(dt);
  else if(lane === 3) voxTick(w);
  else if(lane === 4){ autonomyTick(w); try{ agTick(); }catch(e){} }
  else if(lane === 5){
    try{
      const h = Math.floor((G.minute || 0) / 60);
      if(!inHall()) consularBody(h);
    }catch(e){}
  } else if(lane === 6){
    try{ realmTick(); }catch(e){}
  } else if(lane === 7){
    try{
      const live = G.members || [];
      if(live.length){
        const m = live[(FRAME_ID || 0) % live.length];
        if(m && m.room === G.room) agiStep(m);
      }
    }catch(e){}
  } else if(lane === 8){
    try{ tickWanderBatch(w); }catch(e){}
  } else if(lane === 9){
    try{ confabulate(w); }catch(e){}
  } else if(lane === 10){
    try{ tieTick(w); }catch(e){}
  } else if(lane === 11){
    try{ chamberDebate(w); }catch(e){}
  } else {
    try{
      const live = G.members || [];
      if(live.length){
        const a = live[(FRAME_ID || 0) % live.length];
        ledgerTick(a);
        const b = live[((FRAME_ID || 0) * 5) % live.length];
        if(b) ledgerEnsure(b);
      }
    }catch(e){}
  }
  G._premSpent = (G._premSpent || 0) + (performance.now() - t0);
}
function markRenderDirty(){ try{ G._renderDirty = true; }catch(e){} }
const PREMISE = { hz: 10, last: 0, timer: 0 };
function premisePulse(){
  /* System A. Does not draw. Does not know the window exists.
     Hidden tab still ticks — catch-up is capped so a return is not a flush. */
  if(!G || !G.you) return;
  if(G.pendingNight) return;
  if(PROC && PROC.on) return;
  try{
    if(G._bootGraceUntil && performance.now() < G._bootGraceUntil) return;
  }catch(e){}
  const now = performance.now();
  const hidden = (typeof document !== "undefined" && document.hidden);
  /* the day used to run on behind any card (the handbook, the morning plan, the night card's own
     replacement) and in a background tab: twelve minutes away was 4:30 PM to ten o'clock, and the
     night card then painted over whatever you were reading. Nothing passes while you are not in the room. */
  if(!G.running || hidden || G._pauseOpen || (typeof veil !== "undefined" && veil && !veil.hidden)){ PREMISE.last = now; return; }
  const raw = PREMISE.last ? Math.min(0.2, (now - PREMISE.last) / 1000) : 0.1;
  PREMISE.last = now;
  G._premSpent = 0;
  const w = raw * (G.speed || 1);
  try{
    if(!TALK.open && w > 0) spend(w * DAY_RATE, 0);
  }catch(e){}
  try{ drainHouseOne(w, raw); }catch(e){}
  if((G._premSpent || 0) < 2.5){
    try{ drainHouseOne(w, raw); }catch(e){}
  }
}
function armPremise(){
  if(PREMISE.timer) return;
  PREMISE.timer = setInterval(function(){
    try{ premisePulse(); }catch(e){}
  }, 100);
}
function renderRead(){
  /* System B. Reads. Never writes a ledger. Room builds are rare, never every frame.
     20261001a: remesh/warm bail if frame already paid >6ms. */
  const moving = Math.hypot(cam.vx || 0, cam.vz || 0) > 0.12;
  if(G._renderDirty && (!moving || (FRAME_ID & 7) === 0)){
    if(!(typeof frameOverBudget === "function" && frameOverBudget(6))){
      G._renderDirty = false;
      try{ syncPeopleStaged(); }catch(e){}
    }
  }
  if((FRAME_ID & 11) !== 0) return;
  if(typeof frameOverBudget === "function" && frameOverBudget(6)) return;
  try{ warmAhead(); }catch(e){}
}
function forceUnstickMove(){
  G.moving = false;
  G._moveAt = 0;
  try{ _buildingRoom = false; }catch(e){}
  try{ syncPeopleStaged._busy = false; }catch(e){}
  try{
    const fd = el("fade");
    if(fd){ fd.style.opacity = "0"; fd.style.pointerEvents = "none"; }
  }catch(e){}
}
function forcePaint(){
  forceUnstickMove();
  try{ resize(); }catch(e){}
  try{
    if(G.room && ROOMS[G.room] && roomGroup && roomGroup.children.length < 4 && !_buildingRoom){
      buildRoomShell(G.room);
      _roomBuiltId = G.room;
      _roomFurnished = false;
    }
  }catch(e){}
  try{
    if(!isFinite(cam.x)) cam.x = 0;
    if(!isFinite(cam.z)) cam.z = 2;
    if(!isFinite(cam.yaw)) cam.yaw = 0;
    const eye = sitEye();
    camera.position.set(cam.x, eye, cam.z);
    camera.rotation.set(0, cam.yaw + Math.PI, 0, "YXZ");
    camera.updateMatrixWorld(true);
  }catch(e){}
  try{ updateLighting(0.016); }catch(e){}
  try{ ndPad(); }catch(e){}
  try{ if(renderer && !GL_LOST) renderer.render(scene, camera); }catch(e){}
}
function enterRoom(dest, fromRoom){
  /* Instant feet. Mesh later. Keep walking inward — never stop at the jamb. */
  if(!ROOMS[dest]) return;
  try{ kEnsurePeople(); }catch(e){}
  try{ mStandFix(); }catch(e){}
  try{ if(!NM.ready && !NM.tried){ NM.tried = true; nmInit(); } nmRoomPass(); }catch(e){}
  try{ tlog("", (ROOMS[dest] && ROOMS[dest].name) || dest, "room"); }catch(e){}
  forceUnstickMove();
  try{ catchClear("door"); }catch(e){}
  G.speechApproach = null;
  if(G.you){ G.you.sitting = false; G.you.room = dest; }
  const prev = fromRoom || G.room;
  G.room = dest;
  if(dest !== "visit") G.visitId = null;
  const b = roomBox(dest);
  const home = (DOORS[dest] || []).find(d => d.to === prev);
  let ix = 0, iz = 1.35;
  if(home){
    const hp = doorAt(dest, home);
    const inward = hp.z < ROOMS[dest].d/2 ? 1 : -1;
    cam.x = clamp(hp.x, -b.hw, b.hw);
    cam.z = clamp(hp.z + inward*1.05, b.d0, b.d1);
    cam.yaw = inward > 0 ? 0 : Math.PI;
    ix = 0; iz = inward * 0.42;
    if(home.side === "left"){ cam.x = clamp(hp.x + 1.35, -b.hw, b.hw); cam.yaw = Math.PI/2; ix = 0.42; iz = 0; }
    if(home.side === "right"){ cam.x = clamp(hp.x - 1.35, -b.hw, b.hw); cam.yaw = -Math.PI/2; ix = -0.42; iz = 0; }
  } else {
    try{ const sp = safeSpawn(dest); cam.x = sp.x; cam.z = sp.z; }catch(e){ cam.x = 0; cam.z = b.d0 + 1.2; }
    cam.yaw = 0;
  }
  cam.vx = ix; cam.vz = iz; cam.yawVel = 0;
  cam.pitch = 0;
  G.doorGrace = (G.t || 0) + 1.8;
  G._lastDoorTo = dest;
  G._lastDoorFrom = prev;
  try{ const Gs = goalsEnsure(); if(Gs){ Gs.seen = Gs.seen || {}; Gs.seen[dest] = 1; } }catch(e){}
  try{ document.body.classList.remove("keys-intro"); }catch(e){}
  try{
    el("whereName").textContent = ROOMS[dest].t;
    el("whereTag").textContent = ROOMS[dest].tag;
  }catch(e){}
  try{
    if(_roomBuiltId !== dest){
      try{ stashLiveRoom(); }catch(e){}
      if(!takeRoomKit(dest)){
        try{ buildRoomShell(dest); _roomBuiltId = dest; _roomFurnished = false; }catch(e){}
      }
    }
  }catch(e){}
  try{ forcePaint(); }catch(e){}
  try{
    const fd = el("fade");
    if(fd){ fd.style.opacity = "0"; fd.style.pointerEvents = "none"; }
  }catch(e){}
  const furnishAt = 0;
  nextFrameOrTimeout(() => {
    if(G.room !== dest) return;
    try{
      if(!_roomFurnished && !_buildingRoom) buildRoom(dest);
    }catch(e){}
    try{ forcePaint(); }catch(e){}
  }, furnishAt);
  G._crowdPauseUntil = Math.max(G._crowdPauseUntil || 0, performance.now() + 180);
  G._deferPeopleUntil = performance.now() + 200;
  nextFrameOrTimeout(() => {
    if(G.room !== dest) return;
    try{ syncPeopleStaged(); }catch(e){}
  }, 16);
  nextFrameOrTimeout(() => {
    if(G.room !== dest) return;
    try{ if(dest === "floor") seatChamber(); }catch(e){}
  }, 900);
  laterHouse(() => { try{ queueSave(); }catch(e){} });
}
/* Walk into a doorway and you go through it. No menu required. */
function nearDoor(){
  if(G.t < (G.doorGrace||0)) return null;
  const moving = Math.hypot(cam.vx || 0, cam.vz || 0);
  if(moving < 0.55) return null;
  const list = DOORS[G.room] || [];
  for(const dr of list){
    if(!outsideAllowed(dr.to)) continue;
    const p = doorAt(G.room, dr);
    const dx = p.x - cam.x, dz = p.z - cam.z;
    const dist = Math.hypot(dx, dz);
    const reach = (dr.side === "front" || dr.side === "back") ? 1.05 : 0.95;
    if(dist >= reach || dist < 0.02) continue;
    const toward = (cam.vx * dx + cam.vz * dz) / dist;
    if(toward < 0.35) continue;
    if(G.room === "steps"){
      const g = cam.ground || 0;
      if(dr.to === "corridor" && g < 1.25) continue;
      if(dr.to === "district" && g > 0.35) continue;
    }
    return {dr, p};
  }
  return null;
}
function walkThroughDoors(){
  if(G.moving){
    if(!G._moveAt || performance.now() - G._moveAt > 400) forceUnstickMove();
    else return;
  }
  const hit = nearDoor();
  if(!hit) return;
  const dest = hit.dr.to, fromRoom = G.room;
  if(!ROOMS[dest] || dest === fromRoom) return;
  G.doorGrace = (G.t || 0) + 1.8;
  feed("Through to " + ROOMS[dest].t + ".");
  enterRoom(dest, fromRoom);
}
/* Show a line of text, or hide the thing that would have held it —
   touching the DOM only when the words are not already there. */
function say(node, text){
  if(text === null || text === undefined){
    if(!node.hidden) node.hidden = true;
    node._html = null;
    return;
  }
  if(node._said !== text){ node._said = text; node._html = null; node.textContent = text; }
  if(node.hidden) node.hidden = false;
}
let last = performance.now(), acc = 0, frameFails = 0, frameFailLogged = false;
let hailT = 0, hailWho = null, matChkT = 0, matChk = 0, matChkSaid = 0;

/* Draw on a divisor of the panel. 32fps on 60Hz is a beat that looks like
   a hitch. 30 and 60 are the only rates that sit still on a 60/120Hz screen.
   Modest locks 30. A strong machine holds 60 until a frame costs too much,
   then it drops to 30 and stays there until the work is cheap again. */
const FRAME_HZ_LO = 30;
const FRAME_HZ_HI = 60;
let _wantHz = (typeof MODEST !== "undefined" && MODEST) ? FRAME_HZ_LO : FRAME_HZ_HI;
let _vsyncN = 0;
let _rafPrev = 0;
let _hzEma = 60;
let _stride = (typeof MODEST !== "undefined" && MODEST) ? 2 : 1;
let _holdLo = 0;
let _lastDrawn = 0;
let _cardFrames = 0;
let _emaMs = 16;
let _frameArmed = false;
function armFrame(){
  if(_frameArmed) return;
  _frameArmed = true;
  try{
    const hidden = typeof document !== "undefined" && document.hidden;
    const card = !!(typeof veil !== "undefined" && veil && !veil.hidden);
    if(hidden){
      setTimeout(() => { _frameArmed = false; frame(performance.now()); }, 1000);
      return;
    }
    requestAnimationFrame((t) => { _frameArmed = false; frame(t); });
  }catch(e){
    _frameArmed = false;
    setTimeout(() => { try{ armFrame(); }catch(e2){} }, 250);
  }
}
function kickFrame(){
  if(_frameArmed) return;
  /* Do not kick into a double-tick storm during save / room build / door fade. */
  try{
    if(typeof saveBusy !== "undefined" && saveBusy) return;
    if(typeof _buildingRoom !== "undefined" && _buildingRoom) return;
    if(houseQuiet() && G.moving) return;
  }catch(e){}
  armFrame();
}
function crowdFreezeMesh(mesh){
  /* 20261005a: deep-freeze a person group — root-only freeze left child meshes
     paying updateMatrix every frame (suits/faces/hair). Full meshes kept. */
  if(!mesh) return;
  try{
    if(!mesh.userData) mesh.userData = {};
    const ud = mesh.userData;
    if(ud._crowdFrozen){
      /* already frozen: if the root moved, carry the whole body with it */
      if(ud._fzX !== mesh.position.x || ud._fzZ !== mesh.position.z || ud._fzY !== mesh.position.y || ud._fzR !== mesh.rotation.y){
        mesh.updateMatrix(); mesh.updateMatrixWorld(true);
        ud._fzX = mesh.position.x; ud._fzZ = mesh.position.z; ud._fzY = mesh.position.y; ud._fzR = mesh.rotation.y;
      }
      return;
    }
    /* bake every local matrix from the current pose first, then stop the per-frame walk */
    mesh.traverse(o => { o.updateMatrix(); o.matrixAutoUpdate = false; });
    mesh.updateMatrixWorld(true);
    ud._fzX = mesh.position.x; ud._fzZ = mesh.position.z; ud._fzY = mesh.position.y; ud._fzR = mesh.rotation.y;
    ud._crowdFrozen = true;
  }catch(e){}
}
function crowdThawMesh(mesh){
  if(!mesh || !mesh.userData || !mesh.userData._crowdFrozen) return;
  try{
    mesh.userData._crowdFrozen = false;
    mesh.traverse(o => { o.matrixAutoUpdate = true; });
    mesh.updateMatrixWorld(true);
  }catch(e){}
}
function animateCrowd(dt){
  const crowd = hereNow();
  const talk = (TALK.open && TALK.m) || null;
  const sy = Math.sin(cam.yaw), cy = Math.cos(cam.yaw);
  let full = 0;
  /* 20261011d: everyone in view is posed on a fair rotation with their own
     elapsed time — the old "first two in the list" left the rest in stale poses */
  const maxFull = MODEST ? 4 : 9;
  const rr = (animateCrowd._rr = ((animateCrowd._rr || 0) + 1) % 1024);
  const playerMoving = Math.hypot(cam.vx || 0, cam.vz || 0) > 0.12;
  for(let i=0;i<crowd.length;i++){
    const p = crowd[i];
    if(!p.mesh) continue;
    const dx = p.x - cam.x, dz = p.z - cam.z;
    const d2 = dx*dx + dz*dz;
    const fwd = sy*dx + cy*dz;
    const talking = talk === p;
    const gy = (G.room === "steps") ? groundAt(p.z, p.room || G.room) : 0;
    const mx = p.mesh.position;
    /* Draw only. Being is not optional. A back is still a person. */
    if(!talking){
      if(playerMoving){
        if(fwd < 0 || d2 > 25){
          /* Culled while walking: hide + deep-freeze so children skip matrix walks. */
          mx.x = p.x; mx.z = p.z; mx.y = gy;
          p.mesh.rotation.y = p.facing || 0;
          if(p.mesh.visible) p.mesh.visible = false;
          crowdFreezeMesh(p.mesh);
          continue;
        }
      } else if(G.room !== "corridor" && fwd < -1.8 && d2 > 16){
        if(p.mesh.visible) p.mesh.visible = false;
        continue;
      }
    }
    if(!p.mesh.visible) p.mesh.visible = true;
    /* 20261001a + 20261005a: while walking, FAR (d2>12) deep-freeze pose — snap once,
       no per-frame updateMatrix; near keep soft follow + pose-only. Full meshes kept. */
    if(playerMoving && !talking && d2 > 12){
      const frozen = !!(p.mesh.userData && p.mesh.userData._crowdFrozen);
      const moved = !frozen || ((FRAME_ID + i) & 3) === 0 && (mx.x !== p.x || mx.z !== p.z || mx.y !== gy);
      if(moved){
        mx.x = p.x; mx.z = p.z; mx.y = gy;
        p.mesh.rotation.y = p.facing || 0;
        if(frozen) p.mesh.userData._crowdFrozen = false;
        crowdFreezeMesh(p.mesh);
      }
      continue;
    }
    crowdThawMesh(p.mesh);
    if(p.mesh.matrixAutoUpdate === false) p.mesh.matrixAutoUpdate = true;
    mx.x += (p.x - mx.x) * 0.35;
    mx.z += (p.z - mx.z) * 0.35;
    mx.y = gy;
    p._adt = Math.min(0.25, (p._adt || 0) + dt);
    const pm = Math.hypot((p.tx || p.x) - p.x, (p.tz || p.z) - p.z) > 0.25;
    /* While walking: the near ones who are themselves walking keep their gait; the rest pose-only */
    if(playerMoving && !talking){
      if(pm && fwd > 0 && full < 3){ animatePerson(p, p._adt); p._adt = 0; full++; continue; }
      if(pm){ p.facing += clamp(wrapPi(Math.atan2(p.tx - p.x, p.tz - p.z) - (p.facing || 0)), -2.6*dt, 2.6*dt); }
      p.mesh.rotation.y = p.facing || 0;
      continue;
    }
    const near = d2 < 20 && fwd > -0.5;
    if(talking || near || pm || ((i + rr) % 2 === 0 && full < maxFull)){
      animatePerson(p, p._adt); p._adt = 0;
      full++;
    } else {
      if(pm){ p.facing += clamp(wrapPi(Math.atan2(p.tx - p.x, p.tz - p.z) - (p.facing || 0)), -2.6*dt, 2.6*dt); }
      p.mesh.rotation.y = p.facing || 0;
    }
  }
}

/* ── ONUM_PROF: frame section profiler (quiet ring always; verbose ?prof=1) ── */
const ONUM_PROF = (() => {
  let verbose = false;
  try{ verbose = /(?:\?|&)prof=1(?:&|$)/.test(location.search || ""); }catch(e){}
  const RING_MAX = 180, SPIKE_MAX = 48;
  const ring = [];
  const spikes = [];
  let lastInfo = null, lastSampleAt = 0;
  let cur = null, tSec = 0;
  const names = ["tick","crowd","lighting","shadow","render","hud","feed","sync","furnish","ui"];
  function blank(){
    const o = {t:0, total:0};
    for(const n of names) o[n] = 0;
    return o;
  }
  function begin(){
    cur = blank();
    tSec = performance.now();
    return cur;
  }
  function mark(name){
    if(!cur) return;
    const n = performance.now();
    cur[name] = (cur[name] || 0) + (n - tSec);
    tSec = n;
  }
  function add(name, ms){
    if(!cur || !(ms > 0)) return;
    cur[name] = (cur[name] || 0) + ms;
  }
  function sampleInfo(){
    try{
      if(!renderer || !renderer.info) return null;
      const r = renderer.info.render || {};
      const m = renderer.info.memory || {};
      const out = {
        calls: r.calls|0,
        triangles: r.triangles|0,
        geometries: m.geometries|0,
        textures: m.textures|0,
        programs: (renderer.info.programs && renderer.info.programs.length) || 0
      };
      try{
        if(performance.memory) out.heapMB = Math.round(performance.memory.usedJSHeapSize / 1048576);
      }catch(e){}
      return out;
    }catch(e){ return null; }
  }
  function end(draw){
    if(!cur) return null;
    mark("_tail");
    cur.total = 0;
    for(const n of names) cur.total += (cur[n] || 0);
    cur.draw = !!draw;
    cur.at = performance.now();
    const now = cur.at;
    if(now - lastSampleAt > 1000){
      lastSampleAt = now;
      lastInfo = sampleInfo();
    }
    cur.info = lastInfo;
    ring.push(cur);
    if(ring.length > RING_MAX) ring.shift();
    const spike = cur.total > 22 || (cur.render || 0) > 12;
    if(spike){
      spikes.push(Object.assign({}, cur));
      if(spikes.length > SPIKE_MAX) spikes.shift();
      if(verbose && typeof console !== "undefined" && console.debug){
        console.debug("ONUM_PROF spike", cur.total.toFixed(1), "ms", cur);
      }
    }
    const out = cur; cur = null; return out;
  }
  function dump(){
    const top = spikes.slice().sort((a,b) => b.total - a.total).slice(0, 12);
    const sums = blank();
    let n = 0;
    for(const f of (top.length ? top : ring.slice(-60))){
      for(const k of names) sums[k] += (f[k] || 0);
      sums.total += (f.total || 0);
      n++;
    }
    const avg = {};
    if(n){
      for(const k of names) avg[k] = +(sums[k] / n).toFixed(3);
      avg.total = +(sums.total / n).toFixed(3);
    }
    const ranked = names.map(k => ({
      name: k,
      ms: avg[k] || 0,
      pct: avg.total ? +(((avg[k] || 0) / avg.total) * 100).toFixed(1) : 0
    })).sort((a,b) => b.ms - a.ms);
    return {
      verbose, spikeCount: spikes.length, ringCount: ring.length,
      topSpikes: top, ranked, avg, lastInfo,
      verdict: (function(){
        const r = ranked[0];
        if(!r) return "unknown";
        if(r.name === "render" || r.name === "shadow" || r.name === "lighting") return "GPU/draw-bound (render/lighting/shadow dominate)";
        if(r.name === "tick" || r.name === "crowd" || r.name === "sync" || r.name === "furnish") return "CPU-bound (tick/crowd/sync dominate)";
        return "mixed (" + r.name + " leads)";
      })()
    };
  }
  function stressBoot(){
    try{
      if(typeof buildWorld === "function"){
        buildWorld("Profiler Seat", "FED", typeof makeLook === "function" ? makeLook() : null);
      }
      G.room = "corridor";
      G.day = Math.max(G.day || 1, 2);
      G.minute = 10 * 60 + 30;
      G._savedCam = false;
      if(typeof begin === "function") begin();
      api._lastBoot = { ok:true, room: G.room, n: (G.members&&G.members.length)||0, running: !!G.running };
      return true;
    }catch(e){
      if(console && console.warn) console.warn("ONUM_PROF.stressBoot", e);
      api._lastBoot = { ok:false, err: String((e&&e.message)||e) };
      return false;
    }
  }
  function snap(){
    try{
      return {
        boot: api._lastBoot || null,
        running: !!(typeof G !== "undefined" && G.running),
        room: (typeof G !== "undefined" && G.room) || null,
        people: (typeof peopleGroup !== "undefined" && peopleGroup && peopleGroup.children) ? peopleGroup.children.length : 0,
        furnished: !!(typeof _roomFurnished !== "undefined" && _roomFurnished),
        members: (typeof G !== "undefined" && G.members) ? G.members.length : 0
      };
    }catch(e){ return { err: String(e) }; }
  }
  function autoWalk(ms){
    ms = ms || 10000;
    const KB = (typeof G !== "undefined" && G.bind) || (typeof DEFAULT_BIND !== "undefined" ? DEFAULT_BIND : {forward:"w"});
    try{ keys[KB.forward] = true; }catch(e){}
    const t0 = performance.now();
    const iv = setInterval(() => {
      try{ keys[KB.forward] = true; }catch(e){}
      /* gentle yaw so we sweep corridor */
      try{ cam.yaw += 0.004; }catch(e){}
      if(performance.now() - t0 >= ms){
        clearInterval(iv);
        try{ keys[KB.forward] = false; }catch(e){}
      }
    }, 50);
    return true;
  }
  const api = {begin, mark, add, end, dump, sampleInfo, stressBoot, autoWalk, snap, ring, spikes, get verbose(){ return verbose; }, get cur(){ return cur; }};
  try{ window.ONUM_PROF = api; }catch(e){}
  return api;
})();

function frame(now){
  if(GL_LOST){ last = now; armFrame(); return; }
  if(typeof document !== "undefined" && document.hidden){ armFrame(); return; }
  if(_rafPrev){
    const dtR = Math.max(7, now - _rafPrev);
    _hzEma = _hzEma * 0.9 + (1000 / dtR) * 0.1;
  }
  _rafPrev = now;
  _vsyncN++;
  const hz = _hzEma < 70 ? 60 : (_hzEma < 100 ? 90 : (_hzEma < 135 ? 120 : (_hzEma < 170 ? 144 : 240)));
  let stride = 1, best = 999;
  for(let s = 1; s <= 8; s++){
    const e = Math.abs(hz / s - _wantHz);
    if(e < best){ best = e; stride = s; }
  }
  _stride = stride;
  const draw = (_vsyncN % stride) === 0;
  if(draw) _lastDrawn = now;
  const t0 = now;
  try{
    frameBody(now, draw);
    if(frameFails > 0){ frameFails = Math.max(0, frameFails - 1); if(frameFails === 0) frameFailLogged = false; }
  }catch(err){
    frameFails++;
    last = performance.now();
    if(!frameFailLogged && window.console){
      frameFailLogged = true;
      console.error("frame error (recovering; further errors silent)", err);
    }
    try{
      if(renderer && renderer.shadowMap) renderer.shadowMap.needsUpdate = true;
    }catch(e){}
  }
  const took = performance.now() - t0;
  if(draw){
    _emaMs = _emaMs * 0.86 + took * 0.14;
    if(_emaMs > 22 || took > 40){
      _holdLo++;
      if(_holdLo > 6) _wantHz = FRAME_HZ_LO;
    } else if(_emaMs < 11){
      _holdLo = Math.max(0, _holdLo - 2);
      if(_holdLo === 0 && !(typeof MODEST !== "undefined" && MODEST)) _wantHz = FRAME_HZ_HI;
    }
  }
  armFrame();
}
function frameBody(now, draw){
  G._frameT0 = now;
  G._frameSpent = 0;
  const _prof = (typeof ONUM_PROF !== "undefined") ? ONUM_PROF : null;
  if(_prof) _prof.begin();
  const dt = Math.min(0.05, (now-last)/1000); last = now;
  FRAME_ID++;
  if(G.moving && G._moveAt && (performance.now() - G._moveAt) > 4200){
    G.moving = false; G._moveAt = 0;
    try{ const fd = el("fade"); if(fd) fd.style.opacity = "0"; }catch(e){}
  }
  const cardUp = !!(typeof veil !== "undefined" && veil && !veil.hidden);
  const talkUp = !!(typeof TALK !== "undefined" && TALK && TALK.open);
  if(PAD_SEEN || picksDirty) pollPad();
  else if(picksDirty) refreshPicks();
  if(cardUp){
    try{
      const live = !!(G.you && G.members && G.members.length);
      const boot = document.body.classList.contains("boot-menu");
      /* 20261011a: any live control counts (ballot/office picks are .conc__btn), and a
         card with none gets 2.5s grace (Sleeping... / Loading...) before the unstick. */
      const acts = card && card.querySelector("button:not([disabled]), input:not([disabled]), select, textarea");
      if(acts || !live || boot){ G._cardDeadSince = 0; }
      else if(!G._cardDeadSince){ G._cardDeadSince = now; }
      if(live && !boot && !acts && (now - (G._cardDeadSince || now)) > 2500){
        G._cardDeadSince = 0;
        softUnstickVeil();
      } else {
        /* MAX OPT 20260921: card-up — feed/scroll every other; 3D every 6th. */
        _cardFrames = (_cardFrames || 0) + 1;
        if((_cardFrames & 1) === 0){
          try{ feedTick(dt); }catch(e){}
          try{ tickScrollFrame(); }catch(e){}
        }
        if(!GL_LOST && _cardFrames % 6 === 0){
          try{ ndPad(); renderer.render(scene, camera); }catch(e){}
        }
        if(_prof){ _prof.mark("render"); _prof.end(false); }
        return;
      }
    }catch(e){ if(_prof) _prof.end(false); return; }
  }
  if(talkUp){
    const KB = G.bind || DEFAULT_BIND;
    if(keys[KB.forward] || keys[KB.back] || keys[KB.stepL] || keys[KB.stepR]){
      try{ closeTalk(); }catch(e){}
    }
  }
  if(!G.over && !G.pendingNight){
    G.running = true;
    if(!(G.speed > 0)) G.speed = 1;
  }
  try{ tick(dt); }
  catch(err){
    if(window.console && frameFails < 2) console.warn("tick error", err);
  }
  try{ renderRead(); }catch(e){}
  try{ G._frameSpent = Math.max(G._frameSpent || 0, framePaidMs()); }catch(e){}
  if(_prof) _prof.mark("tick");
  if(draw){
    if(G._crowdPauseUntil && performance.now() < G._crowdPauseUntil){
      try{ animateCrowd(dt); }catch(e){}
    } else {
      animateCrowd(dt);
    }
  }
  if(_prof){
    _prof.mark("crowd");
    if(_prof._syncAcc){ _prof.add("sync", _prof._syncAcc); _prof._syncAcc = 0; }
  }
  /* Once a second, check one body's world matrix for a value that
     cannot be right — a zero scale or a NaN, which is what a stale or
     broken matrix looks like — and rebuild that person if it is wrong.
     One person per second costs nothing and a wrong body never lasts. */
  /* Twice a second, look over everybody in the room for a body that
     cannot be right: a matrix with a NaN in it, or one that has been
     flattened to nothing. Reading sixteen numbers off each person costs
     nothing next to drawing them, and it means a body that goes wrong —
     for any reason, including one I have not thought of — is put right
     within half a second instead of staying wrong. */
  const playerMoving = Math.hypot(cam.vx || 0, cam.vz || 0) > 0.12;
  /* While moving: dip PR slightly (restore on stop). Safe — setPR no-ops if near same. */
  if(playerMoving){
    if(!_movePrOn){
      _movePrSaved = _lastPR > 0 ? _lastPR : GFX_PR;
      try{ setPR(Math.min(GFX_PR, MODEST ? 0.95 : 1.1)); }catch(e){}
      _movePrOn = true;
    }
  } else if(_movePrOn){
    try{ setPR(_movePrSaved || GFX_PR); }catch(e){}
    _movePrOn = false;
  }
  if(!playerMoving) matChkT -= dt;
  if(!playerMoving && matChkT <= 0 && !MODEST){
    const crowdN = peopleGroup ? peopleGroup.children.length : 0;
    matChkT = crowdN > 6 ? (MODEST ? 1.6 : 0.9) : (MODEST ? 1.1 : 0.55);
    const list = hereNow();
    /* Round-robin a few bodies per tick — full scan every frame was wasted work. */
    const step = Math.max(1, Math.ceil(list.length / 4));
    const start = (matChk|0) % Math.max(1, list.length);
    for(let i=0;i<list.length;i+=step){
      const p = list[(start + i) % list.length];
      const g = p && p.mesh;
      if(!g || g.parent !== peopleGroup) continue;
      const e = g.matrixWorld.elements;
      let bad = false;
      for(let j = 0; j < 16; j++) if(!isFinite(e[j])){ bad = true; break; }
      if(!bad){
        const sx = Math.hypot(e[0], e[1], e[2]), sy = Math.hypot(e[4], e[5], e[6]);
        if(sx < 1e-4 || sy < 1e-4) bad = true;
      }
      if(bad){
        g.matrixAutoUpdate = true;
        g.updateMatrixWorld(true);
        g.traverse(o => {
          o.matrixAutoUpdate = true;
          if(o.isSkinnedMesh && o.skeleton) o.skeleton.update();
        });
        matChk++;
      }
    }
    if(matChk > matChkSaid && matChk % 8 === 1){
      matChkSaid = matChk;
      feed("A body was drawing wrong and has been put right.");
    }
  }
  /* the head keeps living even when the feet stop: bob under stride,
     a slow breath at rest, and a lean into the turn */
  cam.drift = smooth(cam.drift, 0, 0.2, dt);
  const breath = Math.sin(G.t*0.72)*0.0085 + Math.sin(G.t*1.63)*0.0035;
  const sway = Math.sin(cam.bob*0.5)*0.011*cam.speed;
  /* seated, your eye is where a seated eye is — otherwise you are
     standing inside the desk in front of you and the whole view is the
     flat side of it */
  const eye = sitEye();
  cam.eye = cam.eye === undefined ? eye : smooth(cam.eye, eye, 0.004, dt);
  camera.position.set(
    cam.x + Math.cos(cam.yaw)*sway,
    cam.eye + Math.sin(cam.bob)*0.026*cam.speed + breath + cam.drift,
    cam.z - Math.sin(cam.yaw)*sway
  );
  camera.rotation.set(
    cam.pitch + Math.sin(cam.bob*0.5)*0.006*cam.speed + Math.sin(G.t*0.55)*0.0022,
    cam.yaw + Math.PI,
    cam.lean,
    "YXZ"
  );
  if(!draw){
    try{ feedTick(dt); }catch(e){}
    if(_prof){ _prof.mark("feed"); _prof.end(false); }
    return;
  }
  try{
    /* 20261005a: while walking, light/motes/fan every 8th draw — sky does not hitch feet. */
    const litStride = (Math.hypot(cam.vx || 0, cam.vz || 0) > 0.12) ? 7 : 1;
    if((FRAME_ID & litStride) === 0) updateLighting(dt);
    try{ nbSway(dt); ncGrassTick(dt); }catch(e){}
    try{ ndPad(); }catch(e){}
    if(wxObj) wxFrame(dt);
  }catch(e){}
  if(_prof) _prof.mark("lighting");
  /* Moving: skip shadow map refresh — room shadows stay; biggest hitch after people cast. */
  if(playerMoving){
    try{ if(renderer && renderer.shadowMap) renderer.shadowMap.needsUpdate = false; }catch(e){}
  } else if(!MODEST || (FRAME_ID & 3) === 0){
    shadowTick(dt);
  }
  if(_prof) _prof.mark("shadow");
  if(!GL_LOST){
    let _ndg = false; try{ _ndg = ndGate(); }catch(e){}
    if(!_ndg) try{ renderer.render(scene, camera); }
    catch(e){
      if(window.console && !frameFailLogged){ frameFailLogged = true; console.error("render error", e); }
    }
  }
  if(_prof) _prof.mark("render");
  const thing = G.running ? focusThing() : null;
  const foc = thing && thing.type === "person" ? thing.ref : null;
  /* Moving: skip HUD plate/track/tele work — feet first. */
  if(!playerMoving){
    if(!MODEST || (FRAME_ID & 3) === 0) updatePlates(foc);
    if(!MODEST || (FRAME_ID & 7) === 0) updateTrack(TALK.m || foc);
    if(!MODEST || (FRAME_ID & 7) === 1) updateTele(dt);
  }
  if(_prof) _prof.mark("hud");
  /* Moving: feed much less often — HUD text is not feet. */
  if(playerMoving){
    if((FRAME_ID & 7) === 0) feedTick(dt);
  } else if(!MODEST || (FRAME_ID & 1) === 0){
    feedTick(dt);
  }
  try{ tickScrollFrame(); }catch(e){}
  if(_prof) _prof.mark("feed");
  /* the marker's pulse is the only thing left writing a uniform every
     frame for something you may not even be looking at */
  const wantMarker = !!(thing && thing.type === "prop" && !TALK.open);
  if(marker.visible !== wantMarker) marker.visible = wantMarker;
  if(marker.visible){
    marker.position.set(thing.ref.x, 0.035, thing.ref.z);
    marker.material.opacity = 0.55 + Math.sin(G.t*3)*0.22;
  }
  const dr = G.running && !TALK.open ? nearDoor() : null;
  /* If there is a seat where you are standing and nothing else wants
     you, the prompt is simply that: sit down. No question, no card. */
  const atSpeech = !!(speechStationNear && speechStationNear(0.72) && !playerIsMoving());
  const seat = (!thing && !dr && !atSpeech && !CATCH.on && G.running && !TALK.open && !PROC.on) ? seatUnderYou() : null;
  try{ catchFrame(dt); }catch(e){}
  updatePrompt(thing, dr, seat);
  /* someone waiting to catch you — checked a few times a second, not
     sixty; nobody's patience turns over faster than that */
  hailT -= dt;
  if(hailT <= 0){
    hailT = 0.4;
    hailWho = null;
    if(G.running && !TALK.open){
      for(const x of hereNow()) if(x.wantsWord){
        if(x.wwT && G.t - x.wwT > 240){ x.wantsWord = null; continue; }
        hailWho = x; break; }
      if(((hailSweep = (hailSweep||0) + 1) % 10) === 0)
        for(const x of G.members) if(x.wantsWord && x.wwT && G.t - x.wwT > 240) x.wantsWord = null;
    }
  }
  const waiting = hailWho;
  say(el("hail"), waiting ? waiting.name.split(" ")[0] + " wants a word · E when close"
    : (window._nudge && performance.now() < window._nudge.until ? window._nudge.t : null));
  if(PC.open) pcTick(dt);
  try{ dayWatch(dt); }catch(e){}
  try{ poseGuard(); }catch(e){}
  try{ if(!G._namesFix && G.you){ G._namesFix = 1;
    (G.realms || []).forEach(rl => (rl.chamber || []).forEach(c => { c.name = foreignName(Math.random, rl.k); }));
    (G.members || []).forEach(m => { if(m.kind === "envoy"){ const rk = (m.abroad && m.abroad.k) || null; m.name = foreignName(Math.random, rk); } });
    if(G.world && Array.isArray(G.world.names)) G.world.names = G.world.names.map(() => foreignName(Math.random));
  } }catch(e){}
  try{ if(!G._marginFix && G.members){ G._marginFix = 1; G.members.forEach(m => { if(!(m.margin >= 1)){ let h = 7; for(const ch of String(m.name || m.id)) h = (h * 31 + ch.charCodeAt(0)) >>> 0; m.margin = 1 + h % 24; } }); } }catch(e){}
  try{ if(refreshTravel._r !== G.room && !_buildingRoom) refreshTravel(); }catch(e){}
  acc += dt;
  if(acc > (MODEST ? 0.9 : 0.4)){ acc = 0; if(!G.over) refreshBar(); }
  if(_prof){ _prof.mark("ui"); _prof.end(true); }
}

function peekSave(){
  const d = pickNewestSave();
  if(!d) return null;
  return {
    day: d.day || 1,
    congress: d.congress || 1,
    country: d.country || null,
    name: d.you && d.you.name,
    room: d.room || "office",
    minute: d.minute || 0
  };
}
function bootFreshCareer(){
  if(G._booting) return;
  /* 20261011a: a stray Enter on the title must not erase a long career. Ask first;
     the old save is only wiped when the new oath is actually taken (startRun). */
  let pk = null; try{ pk = peekSave(); }catch(e){}
  if(pk && !G._freshOk){
    try{
      veil.hidden = false;
      card.classList.add("card--open");
      document.body.classList.add("boot-menu");
      card.innerHTML =
        '<div class="eyebrow">New career</div>' +
        '<h1>Start over?</h1>' +
        '<p>Your career' + (pk.name ? ' as <strong>' + pk.name + '</strong>' : '') + ' is on day <strong>' + (pk.day || 1) +
          '</strong>. Taking a new oath replaces it. Until you take the oath, nothing is erased.</p>' +
        '<div class="card__actions">' +
          '<button class="btn" type="button" id="freshBack" data-gp="boot:back">Back</button>' +
          '<button class="btn btn--ghost" type="button" id="freshYes">Yes, a new career</button></div>';
      const by = el("freshYes"), bb = el("freshBack");
      if(by) by.onclick = (ev) => { try{ ev.preventDefault(); ev.stopPropagation(); }catch(e){} G._freshOk = true; bootFreshCareer(); };
      if(bb) bb.onclick = (ev) => { try{ ev.preventDefault(); ev.stopPropagation(); }catch(e){} G._freshOk = false; opening(); };
      try{ markPicks(); }catch(e){}
      return;
    }catch(e){}
  }
  G._freshOk = false;
  G._booting = true;
  G._wipeOnOath = true;
  try{ G.you = null; G.members = []; G.make = null; G.running = false; }catch(e){}
  try{ card.classList.remove("card--open"); }catch(e){}
  try{ veil.classList.remove("veil--make"); }catch(e){}
  try{
    nameCard();
    G._booting = false;
  }catch(e){
    if(window.console) console.warn("nameCard", e);
    try{
      veil.hidden = false;
      card.classList.add("card--open");
      card.innerHTML = '<h1>Could not open swearing-in</h1><p class="muted">' +
        String((e && e.message) || e) + '</p><div class="card__actions">' +
        '<button class="btn" type="button" id="freshRetry">Try New career again</button></div>';
      const r = el("freshRetry");
      if(r) r.addEventListener("click", () => bootFreshCareer());
    }catch(e2){ softUnstickVeil(); }
    G._booting = false;
  }
}
function opening(){
  /* Do NOT loadSave() here — hydrating a full career on the start card freezes the UI
     so Continue/New career look dead. Peek only; load on Continue click. */
  const peek = peekSave();
  const hasSave = !!peek;
  try{
    if(!G.parties) G.parties = defaultPartyMap();
    ensureParties();
    mergeWorldParties();
  }catch(e){ if(window.console) console.warn("opening parties", e); }
  document.body.classList.add("boot-menu");
  card.classList.add("card--open");
  try{ veil.classList.remove("veil--make"); }catch(e){}
  const cong = hasSave ? (peek.congress || 1) : 1;
  const dayN = hasSave ? (peek.day || 1) : 1;
  const cname = (peek && peek.country && peek.country.name) ? peek.country.name : (G.country && G.country.name);
  card.innerHTML =
    '<img class="card__logo" src="assets/logo.png" width="220" height="147" alt="One Nation, Under, ME." onerror="this.onerror=null;this.replaceWith(Object.assign(document.createElement(\'div\'),{className:\'card__logo card__logo--text\',textContent:\'One Nation, Under, ME.\'}))">' +    '<div class="eyebrow">One Nation, Under, ME. · The ' + ordinal(cong) + ' Congress' +
      (cname ? ' · ' + cname : '') + '</div>' +
    '<h1>Everyone in this building remembers what you did to them.</h1>' +
    '<p>You are a member of the House. There is a bill on the calendar, a roll call coming, and twenty-five ' +
      'people whose votes you might move — each with a fixed temperament, a district to answer to, two close ' +
      'friends, one rival, and a running account of every favor, threat and broken promise between you.</p>' +
    '<p>Nothing you do stays where you put it. Hurt one of them and their friends hear about it. Every private ' +
      'threat becomes a secret with its own clock. Every vote goes on a record your opponent will read aloud in ' +
      'October. Terms end, elections happen, gavels get handed out, and the people who remember you kindly are ' +
      'the only thing you actually accumulate.</p>' +
    '<p class="muted">The Republic still measures itself against ' + FIRST_CONSUL.name + ', first Consul of the First Order — ' +
      'reviled in every aisle, forever rank 1. His birthday, ' + (FIRST_CONSUL.born || "7/7") + ', is ' +
      (FIRST_CONSUL.holiday || "Taylor Day") + ' (' + (FIRST_CONSUL.holidayFull || "Day of the First Consul") +
      '), a national holiday. Comparison to him is blasphemy; The Greatest may descend under him only.</p>' +
    '<div class="legend">' + (function(){ try{ return partyLegendHTML(); }catch(e){ return ""; } })() + '</div>' +
    '<div class="card__actions">' +
      (hasSave ? '<button class="btn" type="button" id="cont" data-gp="boot:cont">Continue' +
        (peek.name ? ' — ' + peek.name : '') +
        ' · day ' + dayN + '</button>' : '') +
      '<button class="btn' + (hasSave?' btn--ghost':'') + '" type="button" id="fresh" data-gp="boot:fresh">New career</button>' +
      '<button class="btn btn--ghost" type="button" id="bootBook" data-gp="boot:book">Handbook</button></div>' +
      '<p class="boot-hint">Enter continues · Esc opens settings once you are inside · H hides the panels</p>';
  veil.hidden = false;
  const bindBoot = (node, fn) => {
    if(!node) return;
    node.onclick = (ev) => {
      try{ if(ev){ ev.preventDefault(); ev.stopPropagation(); } }catch(e){}
      try{ fn(); }catch(e){ if(window.console) console.warn("boot", e); softUnstickVeil(); }
    };
  };
  bindBoot(el("cont"), cardActContinue);
  bindBoot(el("fresh"), bootFreshCareer);
  bindBoot(el("bootBook"), () => { try{ handbookCard(); }catch(e){} });
  markPicks();
}
function softUnstickVeil(){
  G._booting = false;
  try{ document.body.classList.remove("boot-menu"); }catch(e){}
  try{ document.body.classList.remove("boot-menu"); veil.hidden = true; card.classList.remove("card--open"); veil.classList.remove("veil--make"); }catch(e){}
  try{
    G.moving = false;
    const f = el("fade");
    if(f){ f.style.transition = "opacity .2s ease"; f.style.opacity = "0"; }
    G.running = !!(G.you && G.members && G.members.length);
  }catch(e){}
}
if(!window.__onumBootEnterBound){
  window.__onumBootEnterBound = true;
  addEventListener("keydown", e => {
    if(e.key !== "Enter") return;
    if(!document.body.classList.contains("boot-menu")) return;
    if(veil.hidden) return;
    const cont = el("cont"), fresh = el("fresh");
    const go = (cont && !cont.hidden) ? cont : fresh;
    if(go) go.click();
  });
}
if(!window.__onumBootClickBound){
  window.__onumBootClickBound = true;
  document.addEventListener("click", (e) => {
    const t = e.target && e.target.closest ? e.target.closest("#cont, #fresh, [data-gp='boot:cont'], [data-gp='boot:fresh']") : null;
    if(!t) return;
    e.preventDefault();
    e.stopPropagation();
    const gp = t.getAttribute("data-gp") || (t.id === "cont" ? "boot:cont" : (t.id === "fresh" ? "boot:fresh" : ""));
    try{
      if(gp === "boot:cont" || t.id === "cont") cardActContinue();
      else if(gp === "boot:fresh" || t.id === "fresh") bootFreshCareer();
    }catch(err){ if(window.console) console.warn("boot click", err); softUnstickVeil(); }
  }, true);
}
document.addEventListener("keydown", (e) => {
  if(veil.hidden) return;
  if(e.key !== "Enter" && e.key !== " ") return;
  const t = e.target;
  if(t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
  const primary = card.querySelector(".card__actions .btn:not(.btn--ghost)") || card.querySelector(".card__actions .btn");
  if(!primary) return;
  e.preventDefault();
  e.stopPropagation();
  primary.click();
}, true);

function cardActContinue(){
  if(G._booting) return;
  /* Skyrim / pause-menu: world already in memory — just stand up. Never rebuild. */
  if(G.you && G.members && G.members.length && G.room && ROOMS[G.room] && !G.over){
    resumeLiveCareer();
    return;
  }
  G._booting = true;
  try{
    const h = card.querySelector("h1");
    if(h) h.textContent = "Resuming the House.";
    const acts = card.querySelector(".card__actions");
    if(acts) acts.innerHTML = '<button class="btn" type="button" disabled>Loading career…</button>';
  }catch(e){}
  yieldMain(() => {
    let ok = false;
    try{ ok = !!loadSave(); }catch(e){ ok = false; }
    if(!ok || !G.you || !(G.members && G.members.length)){
      G._booting = false;
      showContinueBroken();
      return;
    }
    yieldPaint(() => {
      try{ begin(); }
      catch(e){
        if(window.console) console.warn("begin", e);
        G._booting = false;
        showContinueBroken(e);
      }
    });
  });
}
function resumeLiveCareer(){
  /* Pause menu Continue: HUD back. Chamber rooms still trap — walk out. */
  G._booting = false;
  G.running = true;
  G.over = false;
  G.speed = 1;
  G.prevSpeed = 1;
  if(G.you) G.you.sitting = false;
  try{ leaveSittingQuiet(); }catch(e){}
  try{ if(TALK.open) closeTalk(); }catch(e){}
  try{ document.body.classList.remove("boot-menu"); }catch(e){}
  try{ veil.hidden = true; card.classList.remove("card--open"); veil.classList.remove("veil--make"); }catch(e){}
  try{ catchClear("resume"); }catch(e){}
  G.doorGrace = (G.t || 0) + 2.4;
  if(G.room === "floor" || G.room === "committee" || G.room === "caucus" || G.room === "press"){
    try{ walkOutNow(); return; }catch(e){}
  }
  try{ refreshPanels(); }catch(e){}
  forcePaint();
}
function showContinueBroken(err){
  /* Stardew rule: a bad load never deletes the farm. */
  try{
    veil.hidden = false;
    card.classList.add("card--open");
    document.body.classList.add("boot-menu");
    const peek = peekSave();
    card.innerHTML =
      '<div class="eyebrow">Career save is still here</div>' +
      '<h1>Could not open that sitting.</h1>' +
      '<p>The career was not erased. Retry, or export it from Career once you are in.</p>' +
      (peek ? '<p class="muted">On disk: day ' + peek.day + (peek.name ? ' · ' + peek.name : '') + '.</p>' : '') +
      (err ? '<p class="muted">' + String((err && err.message) || err).slice(0, 180) + '</p>' : '') +
      '<div class="card__actions">' +
        '<button class="btn" type="button" id="cont" data-gp="boot:cont">Try Continue again</button>' +
        '<button class="btn btn--ghost" type="button" id="fresh" data-gp="boot:fresh">New career</button>' +
      '</div>';
    const c = el("cont"), f = el("fresh");
    if(c) c.onclick = () => { try{ cardActContinue(); }catch(e){ softUnstickVeil(); } };
    if(f) f.onclick = () => { try{ bootFreshCareer(); }catch(e){ softUnstickVeil(); } };
  }catch(e2){ softUnstickVeil(); }
}
/* ══════════════════════════════════════════════════════════
   THE QUESTIONNAIRE
   Nobody assigns you a party. You answer, and the answers
   either find you one or make you one.
   ══════════════════════════════════════════════════════════ */
const QUIZ = [
  {q:"The Union's first duty is —", a:[
    {t:"To let people get on and prosper", d:{econ: 26, wel:-12}},
    {t:"To leave people alone",            d:{lib: 28, econ: 10}},
    {t:"To keep the Union safe",           d:{def: 26, lib:-10}},
    {t:"To look after those who cannot",   d:{wel: 28, econ:-14}}]},
  {q:"A mill closes in a town of four thousand. You —", a:[
    {t:"Let the market find them work",    d:{econ: 24, wel:-14}},
    {t:"Vote federal retraining money",    d:{wel: 24, econ:-12}},
    {t:"Put a tariff on the imports",      d:{econ:-18, def: 8}},
    {t:"Say plainly it is the state's job",d:{lib: 20, wel:-10}}]},
  {q:"On the militia —", a:[
    {t:"Larger, and better paid",          d:{def: 28, econ:-8}},
    {t:"Under civilian control, always",   d:{lib: 24, def:-12}},
    {t:"Cheaper. It is a line in a budget",d:{econ: 18, def:-16}},
    {t:"For floods and fires, not for order",d:{wel: 16, def:-14}}]},
  {q:"A newspaper prints something the Treasury wanted kept quiet. You —", a:[
    {t:"Prosecute. There are rules",       d:{lib:-28, def: 8}},
    {t:"Defend them on the floor",         d:{lib: 30}},
    {t:"Ask them quietly not to do it again",d:{lib:-6}},
    {t:"Say nothing and read it",          d:{lib: 8}}]},
  {q:"Taxes should —", a:[
    {t:"Fall, and keep falling",           d:{econ: 28, wel:-16}},
    {t:"Pay for provision",                d:{wel: 26, econ:-16}},
    {t:"Pay for the fleet",                d:{def: 24, econ: 6}},
    {t:"Be simple enough to understand",   d:{econ: 8, lib: 8}}]},
  {q:"When your party is wrong, you —", a:[
    {t:"Vote with them anyway",            d:{}, loyal: 22},
    {t:"Vote how the district would",      d:{}, loyal: -6},
    {t:"Vote your conscience and say why", d:{}, loyal: -20},
    {t:"Get the bill changed first",       d:{}, loyal: 6}]}
];
const ARCH = {
  FED:{econ: 36, lib:  6, def: 26, wel:-30},
  COM:{econ:-30, lib: 14, def: -8, wel: 32}
};
/* Everyone in this world is sorted by the same six questions —
   the member you are talking to answered them too. */
function quizPosFrom(answers){
  const p = {econ:0, lib:0, def:0, wel:0};
  let loyal = 0;
  (answers || []).forEach((ai, qi) => {
    if(ai === null || ai === undefined || !QUIZ[qi]) return;
    const a = QUIZ[qi].a[ai];
    if(!a) return;
    for(const k in a.d) p[k] += a.d[k];
    if(a.loyal) loyal += a.loyal;
  });
  for(const k in p) p[k] = clamp(Math.round(p[k]*1.25), -100, 100);
  return {pos:p, loyal};
}
/* An individual's answers, coloured by where they came from. */
function answersFor(bg, lean){
  const out = [];
  QUIZ.forEach(q => {
    let best = 0, bs = -1e9;
    q.a.forEach((a, i) => {
      let s = rint(-26, 26);
      for(const k in a.d){
        const want = k === "econ" ? lean*26 + (bg.pos.econ||0)
                   : k === "wel"  ? -lean*22 + (bg.pos.wel||0)
                   : k === "def"  ? lean*12 + (bg.pos.def||0)
                   : (bg.pos.lib||0);
        s += (a.d[k] > 0 ? 1 : -1) * (want > 0 ? 1 : -1) * Math.min(24, Math.abs(want)) * 0.5;
      }
      if(a.loyal) s += a.loyal * ((bg.tr.loyalty||0) > 0 ? 0.4 : -0.2);
      if(s > bs){ bs = s; best = i; }
    });
    out.push(best);
  });
  return out;
}
function quizPos(){
  const p = {econ:0, lib:0, def:0, wel:0};
  let loyal = 0;
  (G.make.answers || []).forEach((ai, qi) => {
    if(ai === null || ai === undefined) return;
    const a = QUIZ[qi].a[ai];
    for(const k in a.d) p[k] += a.d[k];
    if(a.loyal) loyal += a.loyal;
  });
  for(const k in p) p[k] = clamp(Math.round(p[k]*1.25), -100, 100);
  return {pos:p, loyal};
}
function distTo(p, arch){
  let s = 0;
  for(const k in arch) s += Math.pow(p[k] - arch[k], 2);
  return Math.sqrt(s);
}
function partyNameFor(p){
  const bits = [];
  if(p.econ >  30) bits.push("Free Trade");
  if(p.econ < -30) bits.push("Labour");
  if(p.wel  >  35) bits.push("Commonweal");
  if(p.wel  < -30) bits.push("Retrenchment");
  if(p.lib  >  35) bits.push("Liberty");
  if(p.lib  < -30) bits.push("Order");
  if(p.def  >  35) bits.push("Union Defence");
  if(p.def  < -30) bits.push("Peace");
  if(!bits.length) bits.push("Independent");
  const tail = pick(["League","Party","Union","Alliance","Caucus","Movement"]);
  return bits.slice(0,2).join(" and ") + " " + tail;
}
function sortHat(){
  const {pos, loyal} = quizPos();
  const dF = distTo(pos, ARCH.FED), dC = distTo(pos, ARCH.COM);
  const near = dF < dC ? "FED" : "COM";
  const gap = Math.min(dF, dC);
  return {pos, loyal, near, gap, homeless: gap > 78};
}

/* ── character creation, with the model standing in front of you ── */
let mkMesh = null, mkKey = null, mkFill = null;
function mkLights(on){
  if(!mkKey){
    mkKey = new THREE.PointLight(0xfff0dc, 0, 6, 2);
    mkFill = new THREE.PointLight(0xbfd4ff, 0, 7, 2);
    scene.add(mkKey); scene.add(mkFill);
  }
  mkKey.intensity = on ? 3.4 : 0;
  mkFill.intensity = on ? 0.9 : 0;
  mkKey.visible = mkFill.visible = !!on;
}
function mkPreview(){
  if(mkMesh){ scene.remove(mkMesh); mkMesh = null; }
  const stand = {look:G.make.look, party:G.make.party, kind:"you", id:0, _full:true, _cheap:false};
  mkMesh = buildPerson(stand);
  mkMesh.position.set(-1.15, 0, 2.7);
  mkMesh.rotation.y = Math.PI + 0.30;      /* face the camera, slightly turned */
  scene.add(mkMesh);
  cam.x = -1.15; cam.z = 1.30; cam.yaw = 0; cam.pitch = 0;
  camera.position.set(cam.x, 1.50, cam.z);
  camera.rotation.set(0, Math.PI, 0, "YXZ");
  /* light the sitter properly: a key just off the camera, a cool fill
     from the other side, so the face is actually readable */
  mkLights(true);
  const H = G.make.look.height;
  mkKey.position.set(mkMesh.position.x + 0.75, H*0.95, mkMesh.position.z - 1.15);
  mkFill.position.set(mkMesh.position.x - 1.05, H*0.80, mkMesh.position.z - 0.65);
}
function nameCard(){
  if(!G.make){
    const st0 = pick(STATES);
    const auto0 = newName(st0);
    G.make = {name: auto0, autoName: auto0, party:"FED", state:st0, dist:rint(1,14), look: makeLook({frame:"masc"})};
    G.make.look.wear = "suit_tie";
  }
  if(!G.make.autoName) G.make.autoName = G.make.name;
  const L = G.make.look;
  const opts = (label, list, cur, attr) =>
    '<div class="mk__row"><i>' + label + '</i><div class="mk__opts">' +
      list.map(o => '<button type="button" class="mk__opt' + (o.v === cur ? " is-on" : "") +
        '" data-set="' + attr + '" data-val="' + o.v + '">' + o.t + '</button>').join("") +
    '</div></div>';
  const swatches = (label, list, cur, attr) =>
    '<div class="mk__row"><i>' + label + '</i><div class="mk__opts">' +
      list.map(hex => '<button type="button" class="mk__sw' + (hex === cur ? " is-on" : "") +
        '" style="background:#' + hex.toString(16).padStart(6,"0") + '" data-set="' + attr +
        '" data-val="' + hex + '" aria-label="colour"></button>').join("") +
    '</div></div>';
  card.innerHTML =
    '<div class="eyebrow">Swearing in</div><h1>Raise your right hand.</h1>' +
    '<p style="margin-bottom:4px">Everything after this is between you and them.</p>' +
    '<div class="mk">' +
      '<div class="mk__namewrap">' +
        '<input class="mk__name" id="nameIn" value="' + G.make.name + '" maxlength="40">' +
        '<button type="button" class="btn btn--ghost mk__reroll" id="mkNameReroll">Another name</button>' +
      '</div>' +
      '<div class="mk__culthint" id="mkCultHint">' + cultureHint(G.make.state) + '</div>' +
      /* party is decided by the six questions — not picked here */
      '<div class="mk__row"><i>Seat</i><div class="mk__opts">' +
        '<select class="wire__to" id="mkState">' + STATES.map(st =>
          '<option value="' + st + '"' + (st === G.make.state ? " selected" : "") + '>' + st + '</option>').join("") +
        '</select>' +
        '<input type="number" id="mkDist" min="1" max="24" value="' + (G.make.dist || 1) +
          '" style="width:64px" aria-label="District">' +
      '</div></div>' +
      '<div class="mk__row"><i>Faith</i><div class="mk__opts">' +
        '<select class="wire__to" id="mkCreed">' + CREEDS.filter(c => c.k !== "consul").map(c =>
          '<option value="' + c.k + '"' + (c.k === (G.make.creed || "latin") ? " selected" : "") + '>' + c.t.replace(/^the /, "The ").replace(/^no /, "No ") + '</option>').join("") +
        '</select></div></div>' +
      opts("Frame", [{v:"masc",t:"Masculine"},{v:"fem",t:"Feminine"}], L.frame, "frame") +
      opts("Dress", (L.frame === "fem" ? WEAR_FEM : WEAR_MASC).filter((v,i,a)=>a.indexOf(v)===i)
            .map(k => ({v:k, t:WARDROBE[k].t})), L.wear, "wear") +
      swatches("Skin", SKINS, L.skin, "skin") +
      swatches("Hair", HAIRS, L.hair, "hair") +
      opts("Style", HAIRSTYLES.map((t,i) => ({v:i, t})), L.style, "style") +
      swatches("Cloth", SUITS, L.suit, "suit") +
      swatches("Shirt", SHIRTS, L.shirt, "shirt") +
      '<div class="mk__row"><i>Height</i><input type="range" id="mkH" min="150" max="196" value="' +
        Math.round(L.height*100) + '"></div>' +
      '<div class="mk__row"><i>Build</i><input type="range" id="mkB" min="82" max="126" value="' +
        Math.round(L.build*100) + '"></div>' +
      opts("Glasses", [{v:1,t:"Yes"},{v:0,t:"No"}], L.glasses?1:0, "glasses") +
      (L.frame === "masc" ? opts("Beard", [{v:1,t:"Yes"},{v:0,t:"No"}], L.beard?1:0, "beard") : "") +
    '</div>' +
    '<div class="card__actions">' +
      '<button class="btn btn--ghost" type="button" id="mkRand">Surprise me</button>' +
      '<button class="btn" type="button" id="mkGo">Take the oath</button></div>';
  veil.classList.add("veil--make");
  veil.hidden = false;
  mkPreview();

  const mkS = el("mkState"), mkD = el("mkDist");
  const mkC = el("mkCreed"); if(mkC) mkC.addEventListener("change", () => { G.make.creed = mkC.value; });
  if(mkS) mkS.addEventListener("change", () => {
    G.make.state = mkS.value;
    const nameIn = el("nameIn");
    const cur = nameIn ? nameIn.value.trim() : G.make.name;
    if(!cur || cur === G.make.autoName){
      G.make.autoName = newName(G.make.state);
      G.make.name = G.make.autoName;
      if(nameIn) nameIn.value = G.make.name;
    }
    const hint = el("mkCultHint");
    if(hint) hint.textContent = cultureHint(G.make.state);
  });
  if(mkD) mkD.addEventListener("input", () => { G.make.dist = clamp(+mkD.value || 1, 1, 24); });
  const mkReroll = el("mkNameReroll");
  if(mkReroll) mkReroll.addEventListener("click", () => {
    G.make.autoName = newName(G.make.state);
    G.make.name = G.make.autoName;
    const nameIn = el("nameIn");
    if(nameIn) nameIn.value = G.make.name;
  });
  card.querySelectorAll("[data-set]").forEach(b => b.addEventListener("click", () => {
    const k = b.getAttribute("data-set"), raw = b.getAttribute("data-val");
    if(k === "party") G.make.party = raw;
    else if(k === "frame"){
      L.frame = raw;
      L.wear = raw === "fem" ? "skirt_suit" : "suit_tie";
      if(raw === "fem") L.beard = false;
      L.height = raw === "fem" ? Math.min(L.height, 1.77) : Math.max(L.height, 1.66);
    }
    else if(k === "wear") L.wear = raw;
    else if(k === "style") L.style = +raw;
    else if(k === "glasses") L.glasses = raw === "1";
    else if(k === "beard") L.beard = raw === "1";
    else L[k] = +raw;
    G.make.name = el("nameIn").value;
    nameCard();
  }));
  const hR = el("mkH"), bR = el("mkB");
  hR.addEventListener("input", () => { L.height = +hR.value/100; mkPreview(); });
  bR.addEventListener("input", () => { L.build = +bR.value/100; mkPreview(); });
  el("mkRand").addEventListener("click", () => {
    G.make.look = makeLook({frame: chance(.5) ? "masc" : "fem"});
    G.make.state = G.make.state || pick(STATES);
    G.make.autoName = newName(G.make.state);
    G.make.name = G.make.autoName;
    nameCard();
  });
  el("mkGo").addEventListener("click", () => {
    G.make.name = (el("nameIn").value || G.make.name).slice(0,40);
    G.make.answers = G.make.answers || [];
    quizCard();
  });
}

/* ── the questionnaire ─────────────────────────────────── */
function quizStanceLive(){
  const {pos} = quizPosFrom(G.make.answers || []);
  const dF = distTo(pos, ARCH.FED), dC = distTo(pos, ARCH.COM);
  const answered = (G.make.answers || []).filter(x => x !== null && x !== undefined).length;
  /* As answers land, benches that no longer fit check away so the card stays short */
  const away = {FED:false, COM:false, IND:false, OWN:false};
  if(answered >= 2){
    const gap = Math.abs(dF - dC);
    if(dF + 18 < dC) away.COM = true;
    if(dC + 18 < dF) away.FED = true;
  }
  if(answered >= 4){
    const near = Math.min(dF, dC);
    if(near < 55){ away.IND = true; away.OWN = true; }
    if(near > 78){ /* homeless path opens — keep IND/OWN, mute the far bench harder */
      if(dF > dC) away.FED = true; else away.COM = true;
    }
  }
  return {pos, dF, dC, answered, away};
}
function quizCard(){
  if(!G.make.answers || G.make.answers.length !== QUIZ.length)
    G.make.answers = QUIZ.map((_, i) => (G.make.answers && G.make.answers[i] !== undefined ? G.make.answers[i] : null));
  const A = G.make.answers;
  const doneN = A.filter(x => x !== null && x !== undefined).length;
  let cur = A.findIndex(x => x === null || x === undefined);
  const allDone = cur < 0;
  if(allDone) cur = QUIZ.length - 1;
  const live = quizStanceLive();
  const stance = [
    {k:"FED", t:"Federalist"},
    {k:"COM", t:"Commonwealth"},
    {k:"IND", t:"Independent"},
    {k:"OWN", t:"Own party"}
  ].map(p => {
    const tone = p.k === "FED" ? "fed" : p.k === "COM" ? "com" : p.k === "IND" ? "ind" : "dyn";
    const style = p.k === "OWN" ? ' style="--pc:' + (G.make.ownColor || unusedPartyColor()) + '"' : "";
    return '<span class="chip chip--' + tone + (live.away[p.k] ? " is-away" : "") + '"' + style + '>' + p.t + '</span>';
  }).join("");
  /* Answered questions check away into a single compact strip — edit by tapping */
  const checked = A.map((ai, qi) => {
    if(ai === null || ai === undefined) return "";
    return '<button type="button" data-edit="' + qi + '"><b>' + (qi+1) + '.</b> ' + QUIZ[qi].a[ai].t + '</button>';
  }).join("");
  let body = "";
  if(allDone){
    body =
      '<p class="qz__prog">Six of six — stance set</p>' +
      '<div class="qz__stance" aria-label="Party stance">' + stance + '</div>' +
      '<p>That is enough for the returning officer. You can still open any answer above and change it.</p>';
  } else {
    const q = QUIZ[cur];
    body =
      '<p class="qz__prog">Question ' + (cur+1) + ' of ' + QUIZ.length + '</p>' +
      '<div class="qz__stance" aria-label="Party stance">' + stance + '</div>' +
      '<div class="qz__q">' + q.q + '</div>' +
      '<div class="qz__opts">' +
        q.a.map((a, ai) =>
          '<button type="button" class="mk__opt" data-q="' + cur + '" data-a="' + ai + '">' + a.t + '</button>'
        ).join("") +
      '</div>';
  }
  card.innerHTML =
    '<div class="eyebrow">Before the ballot</div>' +
    '<h1>Nobody is going to tell you what you think.</h1>' +
    '<p>One question at a time. As you answer, benches that no longer fit check away — no scrolling a wall of picks.</p>' +
    (checked ? '<div class="qz__done" aria-label="Answers so far">' + checked + '</div>' : '') +
    body +
    '<div class="card__actions">' +
      '<button class="btn btn--ghost" type="button" id="qzBack">Back</button>' +
      '<button class="btn" type="button" id="qzGo"' + (allDone ? "" : " disabled") +
        '>See where that puts me</button></div>';
  veil.hidden = false;
  card.querySelectorAll("[data-q]").forEach(b => b.addEventListener("click", () => {
    G.make.answers[+b.getAttribute("data-q")] = +b.getAttribute("data-a");
    quizCard();
  }));
  card.querySelectorAll("[data-edit]").forEach(b => b.addEventListener("click", () => {
    const qi = +b.getAttribute("data-edit");
    G.make.answers[qi] = null;
    /* clear later answers so stance re-forms forward from the edit */
    for(let i = qi + 1; i < QUIZ.length; i++) G.make.answers[i] = null;
    quizCard();
  }));
  el("qzBack").addEventListener("click", () => {
    if(doneN > 0 && !allDone){
      /* step back one question instead of dumping to the look card */
      for(let i = QUIZ.length - 1; i >= 0; i--){
        if(A[i] !== null && A[i] !== undefined){ G.make.answers[i] = null; break; }
      }
      quizCard();
      return;
    }
    nameCard();
  });
  const go = el("qzGo");
  if(go) go.addEventListener("click", sortedCard);
}
function sortedCard(){
  const r = sortHat();
  G.make.sorted = r;
  G.make.ownName = G.make.ownName || partyNameFor(r.pos);
  G.make.ownColor = G.make.ownColor || unusedPartyColor();
  ensureParties();
  const axisLine = AXES.map(a => a.n.split(" / ")[r.pos[a.k] > 0 ? 1 : 0].toLowerCase() +
    " " + Math.abs(r.pos[a.k])).join(" · ");
  const extras = partyKeys().filter(k => k !== "FED" && k !== "COM" && k !== "IND" && k !== "OWN");
  const extraBtns = extras.map(k => {
    const P = G.parties[k];
    return '<button class="btn btn--ghost" type="button" data-join="' + k + '" style="border-color:' + P.color + '">' +
      '<i class="dot" style="background:' + P.color + ';display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:middle"></i>' +
      'Join the ' + P.name + '</button>';
  }).join("");
  const swatches = PARTY_PALETTE.map(c =>
    '<button type="button" class="swatch' + (c.toLowerCase() === String(G.make.ownColor).toLowerCase() ? ' is-on' : '') +
      '" data-color="' + c + '" style="background:' + c + '" title="' + c + '" aria-label="Party colour ' + c + '"></button>'
  ).join("");
  card.innerHTML =
    '<div class="eyebrow">The returning officer reads it back</div>' +
    '<h1>' + (r.homeless
      ? "Neither of them fits you."
      : (r.near === "FED" ? "That is a Federalist." : "That is a Commonwealth answer.")) + '</h1>' +
    '<p class="dream">' + axisLine + '</p>' +
    '<p>' + (r.homeless
      ? "You are a long way from both benches. You can still take a party's ticket and live with it, " +
        "sit as an independent, or put your own name over a door and see who follows."
      : "You could take their ticket. You could also refuse it — plenty do, and some of them last longer.") +
    '</p>' +
    '<p class="muted" style="margin:0 0 4px">Name for a party of your own (if you found one), and its colour.</p>' +
    '<p><input class="mk__name" id="ownName" value="' + G.make.ownName +
      '" maxlength="42" style="font-size:19px"></p>' +
    '<div class="swatches" id="ownSwatches" aria-label="Party colour">' + swatches + '</div>' +
    '<p id="hatSay" class="muted" style="min-height:1.2em"></p>' +
    '<div class="card__actions" style="margin-bottom:4px">' +
      '<button class="btn btn--ghost" type="button" id="hatRead">Let the returning officer read it back</button></div>' +
    '<div class="card__actions">' +
      '<button class="btn' + (r.near==="FED" && !r.homeless ? '' : ' btn--ghost') +
        '" type="button" data-join="FED">Take the Federalist ticket</button>' +
      '<button class="btn' + (r.near==="COM" && !r.homeless ? '' : ' btn--ghost') +
        '" type="button" data-join="COM">Take the Commonwealth ticket</button>' +
      '<button class="btn btn--ghost" type="button" data-join="IND">Sit as an independent</button>' +
      extraBtns +
      '<button class="btn' + (r.homeless ? '' : ' btn--ghost') +
        '" type="button" data-join="OWN" id="foundOwn">Found your own party</button>' +
    '</div>';
  veil.hidden = false;
  const hb = el("hatRead");
  if(hb) hb.addEventListener("click", async () => {
    const out = el("hatSay");
    /* the officer reads it back out of the form itself */
    hb.disabled = true;
    const P = r.pos, dom = AXES.slice().sort((a,b) => Math.abs(P[b.k]) - Math.abs(P[a.k]))[0];
    const strong = Math.abs(P[dom.k]) > 55;
    const bench = r.homeless ? "neither bench, which is its own kind of answer"
                : r.party === "FED" ? "the Federalist side of the room"
                : r.party === "COM" ? "the Commonwealth side of the room"
                : "the cross benches";
    out.textContent = fresh(() =>
      pick(["Right. Let us see.", "Mm. I have read worse.", "I have had four hundred of these this month."]) +
      " You come down " + (P[dom.k] > 0 ? dom.hi : dom.lo).toLowerCase() +
      " on " + dom.k + (strong ? ", and hard" : ", though not by much") + ". " +
      pick(["That puts you on ", "The form says ", "On paper that is "]) + bench + ". " +
      pick(["Whether you stay there is not my business.",
            "People change their minds in that building. Not often.",
            "Sign at the bottom and mind how you go.",
            "It is not a verdict. It is a starting position."]));
    return;

    hb.disabled = true; out.textContent = "The returning officer reads the form…";
    const lines = QUIZ.map((q,i) => "- " + q.q + " → " + (G.make.answers[i] !== undefined ? q.a[G.make.answers[i]].t : "no answer"));
    try{
      const res = await SAMPLE(
        "You are a dry, unsentimental returning officer in a fictional republic, registering a new " +
        "candidate. Below is how they answered the standard six questions. In 2-4 sentences, tell them " +
        "plainly what their answers add up to and which bench they belong on — Federalist (market, order, " +
        "defence, thrift), Commonwealth (public spending, provision, dovish), or neither. Be blunt and a " +
        "little weary. Do not flatter. No lists, no headings.\n\nCandidate: " + G.make.name + "\n" +
        lines.join("\n") + "\n\nComputed leaning: " + AXES.map(a => a.k + " " + r.pos[a.k]).join(", ") +
        (r.homeless ? "\nThey fit neither bench well." : "\nThey are closest to the " +
          (r.near === "FED" ? "Federalists" : "Commonwealth") + "."),
        {modelTier:"quick", onText:({text}) => { out.textContent = text; }});
      out.textContent = res.text;
    }catch(e){
      out.textContent = (e && e.text) ? e.text : "The officer says nothing useful.";
      hb.disabled = false;
    }
  });
  card.querySelectorAll("[data-color]").forEach(b => b.addEventListener("click", () => {
    G.make.ownColor = b.getAttribute("data-color");
    card.querySelectorAll("[data-color]").forEach(x => x.classList.toggle("is-on", x === b));
    const found = el("foundOwn");
    if(found) found.style.borderColor = G.make.ownColor;
  }));
  {
    const found = el("foundOwn");
    if(found) found.style.borderColor = G.make.ownColor;
  }
  card.querySelectorAll("[data-join]").forEach(b => b.addEventListener("click", () => {
    const k = b.getAttribute("data-join");
    G.make.party = k;
    if(k === "OWN"){
      const nm = (el("ownName").value || G.make.ownName).slice(0,42);
      const col = G.make.ownColor || unusedPartyColor();
      G.own = {name:nm, color:col, born:G.congress || 1};
      registerParty({id:"OWN", name:nm, color:col, born:G.congress || 1, short:nm.split(/\s+/)[0] || "Own"});
    } else if(k !== "FED" && k !== "COM" && k !== "IND"){
      /* joining a party that already formed earlier in this world */
      ensureParties();
    }
    startRun();
  }));
}
function startRun(){
  const r = G.make.sorted || {pos:{econ:0,lib:0,def:0,wel:0}, loyal:0};
  if(G._wipeOnOath){
    G._wipeOnOath = false;
    try{ wipeCareerSaves(); }catch(e){} try{ localStorage.removeItem(SAVE_KEY); }catch(e){}
  }
  if(mkMesh){ scene.remove(mkMesh); mkMesh = null; }
  mkLights(false);
  veil.classList.remove("veil--make");
  veil.hidden = true;
  buildWorld(G.make.name, G.make.party, G.make.look);
  /* your answers are your politics, not a preset */
  G.you.pos = {econ:r.pos.econ, lib:r.pos.lib, def:r.pos.def, wel:r.pos.wel};
  G.you.district = {
    econ:clamp(r.pos.econ + rint(-38,38),-100,100), lib:clamp(r.pos.lib + rint(-38,38),-100,100),
    def:clamp(r.pos.def + rint(-38,38),-100,100),  wel:clamp(r.pos.wel + rint(-38,38),-100,100)};
  G.you.loyalTrait = r.loyal;
  G.you.answers = (G.make.answers || []).slice();
  /* Player is an individual too — same fields NPCs carry into their suite */
  if(!G.you.traits){
    G.you.traits = {
      ambition:rint(20,88), conviction:rint(22,90),
      loyalty:clamp(48 + Math.round(r.loyal*0.55), 0, 100),
      vanity:rint(15,82), discretion:rint(18,90), temper:rint(12,80)
    };
  } else {
    G.you.traits.loyalty = clamp((G.you.traits.loyalty||50) + Math.round(r.loyal*0.35), 0, 100);
  }
  if(!G.you.creed) G.you.creed = (G.make && G.make.creed && G.make.creed !== "consul") ? G.make.creed : "latin";
  if(!G.you.origin) G.you.origin = pick(ORIGINS).k;
  if(!G.you.bg) G.you.bg = pick(BACKGROUNDS).t;
  if(!G.you.suite) G.you.suite = "Cannon " + rint(101, 448);
  try{ autoInit(G.you); ensureSelfhood(G.you); mindEnsure(G.you); }catch(e){}
  G.you.standing = clamp(55 + r.loyal*0.5, 10, 90);
  if(G.make.party === "OWN"){
    ensureParties();
    G.seatsBy.OWN = 1;
    G.you.standing = 25;
    G.you.influence = 16;
    note("Founded the " + G.own.name + ". One seat, and no whip but your own.", true);
    setPrecedent("founded the " + G.own.name, "that a member may sit under a party of their own making");
  } else if(G.make.party === "IND"){
    G.seatsBy.IND++;
    G.you.standing = 30;
    note("Took the oath as an independent.", true);
  } else {
    note("Sworn in to the " + ordinal(G.congress) + " Congress of " + (G.country?G.country.name:"the Republic") + " on the " + partyName(G.make.party) + " ticket.", true);
  }
  try{
    document.body.classList.add("keys-intro");
    setTimeout(() => { try{ document.body.classList.remove("keys-intro"); }catch(e){} }, 45000);
  }catch(e){}
  /* the room forms a first impression from where you actually stand */
  G.members.forEach(m => {
    const fit = -Math.abs(m.pos.econ-G.you.pos.econ)/8 - Math.abs(m.pos.wel-G.you.pos.wel)/8 + 12;
    m.rel.warmth = clamp(m.rel.warmth + clamp(Math.round(fit), -14, 14), -100, 100);
    if(Math.abs(fit) > 9)
      remember(m, fit > 0 ? "You said the right things at the start, and I remembered."
                          : "I heard what you stood for on day one and I did not care for it.",
        fit > 0 ? 5 : -5);
  });
  begin();
}
function begin(){
  if(!G.you || !(G.members && G.members.length)){
    G._booting = false;
    try{ opening(); }catch(e){ nameCard(); }
    return;
  }
  /* FREEZE FIX: Continuity first. Heavy work deferred. Furniture, Caesar, Consular, horcruxes stay. */
  G.running = true; G.over = false;
  try{ armPremise(); }catch(e){}
  G._bootGraceUntil = performance.now() + 8000;
  G._deferPeopleUntil = performance.now() + ((G.room === "corridor") ? 6500 : 2500);
  G.bare = true;
  document.body.classList.add("is-bare");
  document.body.classList.remove("ui-open");
  try{
    PROC.on = false; PROC.phase = "idle"; PROC.speaker = null; PROC.e = null;
    const bar = el("procBar"); if(bar) bar.hidden = true;
    document.body.classList.remove("in-session");
  }catch(e){}
  G.moving = false;
  G.speechApproach = null;
  if(G.you) G.you.sitting = false;
  const trap = (G.room === "floor" || G.room === "committee" || G.room === "caucus" || G.room === "press") ? G.room : null;
  if(trap){
    G.room = "corridor";
    G._savedCam = false;
  }
  if(!G.room || !ROOMS[G.room]) G.room = "office";
  try{ if(G.you && abroadOffice() && !outsideAllowed(G.room)) G.room = homeRoom(); }catch(e){}
  if(G.you) G.you.room = G.room;
  try{ ensureParties(); }catch(e){}
  try{ catchClear("begin"); }catch(e){}
  try{ if(TALK.open) closeTalk(); }catch(e){}
  G.doorGrace = (G.t || 0) + 1.6;
  G._crowdPauseUntil = performance.now() + 600;
  G._deferPeopleUntil = performance.now() + 400;
  try{
    /* Keep saved gfx; migrateGfx pins Best/fullDetail when unset. Never force Simple here.
       applyQuality with _aqBusy skips mid-begin room rebuild+syncPeople. */
    migrateGfx();
    _aqBusy = true;
    try{ applyQuality(); }finally{ _aqBusy = false; }
  }catch(e){ try{ _aqBusy = false; }catch(e2){} }
  const R0 = ROOMS[G.room];
  try{ el("whereName").textContent = R0.t; el("whereTag").textContent = R0.tag; }catch(e){}
  if(!G._savedCam){
    try{
      if(trap){
        const dr = (DOORS.corridor || []).find(d => d.to === trap);
        if(dr){
          const hp = doorAt("corridor", dr);
          const b = roomBox("corridor");
          cam.x = clamp(hp.x + (dr.side === "left" ? 1.05 : dr.side === "right" ? -1.05 : 0), -b.hw, b.hw);
          cam.z = clamp(hp.z + (dr.side === "front" ? 1.05 : dr.side === "back" ? -1.05 : 0), b.d0, b.d1);
          cam.yaw = dr.side === "left" ? Math.PI/2 : dr.side === "right" ? -Math.PI/2 : 0;
        } else {
          const sp = safeSpawn("corridor"); cam.x = sp.x; cam.z = sp.z; cam.yaw = 0;
        }
      } else {
        const sp = safeSpawn(G.room); cam.x = sp.x; cam.z = sp.z; cam.yaw = 0;
      }
    }catch(e){}
  }
  try{ veil.hidden = true; card.classList.remove("card--open"); veil.classList.remove("veil--make"); }catch(e){}
  try{ document.body.classList.remove("boot-menu"); }catch(e){}
  const roomId = G.room;
  G._booting = false;
  requestAnimationFrame(() => {
    try{
      if(!_buildingRoom){
        try{ buildRoomShell(roomId); _roomBuiltId = roomId; _roomFurnished = false; }catch(e0){
          try{ buildRoom(roomId); }catch(e1){}
        }
        try{ resize(); }catch(e){}
      }
    }catch(e){
      if(window.console) console.warn("begin build", e);
      try{ G.room = "office"; buildRoomShell("office"); _roomBuiltId = "office"; _roomFurnished = false; }catch(e2){}
    }
    try{ forcePaint(); }catch(e){}
    /* 20260928a: after shell is up, drip-warm a neighbor shell — never block begin. */
    try{
      nextFrameOrTimeout(() => { try{ warmAhead(); }catch(e){} }, 0);
    }catch(e){}
    requestAnimationFrame(() => {
      try{
        if((G.room || roomId) === "corridor") return;
        if(!_roomFurnished && !_buildingRoom) buildRoom(G.room || roomId);
      }catch(e){}
      try{ forcePaint(); }catch(e){}
    });
    setTimeout(() => {
      const run = (fn) => { try{ fn(); }catch(e){} };
      const chain = (steps, i) => {
        if(i >= steps.length) return;
        const step = steps[i];
        if(typeof yieldMain === "function") yieldMain(() => { run(step); chain(steps, i + 1); });
        else { run(step); setTimeout(() => chain(steps, i + 1), 16); }
      };
      chain([
        () => { ensureMythHistory(); ensureGreatest(); },
        () => { ensureConsularCaucus(); },
        () => { everyone().forEach(m => { if(m.room === G.room) placeInRoom(m); }); },
        () => { if(!_roomFurnished && !_buildingRoom) buildRoom(G.room || roomId); },
        () => { /* Corridor does not remesh on Continue. Feet already walk. */ },
        () => { try{ queueSave(); }catch(e){} }
      ], 0);
    }, 2500);
  });
  setTimeout(() => {
    if(G.running) return;
    G._booting = false;
    try{ forceUnstickMove(); }catch(e){}
    try{ G.running = true; }catch(e){}
    try{ forcePaint(); }catch(e){}
  }, 4000);
}

/* ── Add to Home Screen ──────────────────────────────────
   An icon, a manifest and the mobile web-app meta, injected into
   the head at runtime so it works from inside the viewer. */
(function(){
  try{
    const ic = document.createElement("canvas"); ic.width = ic.height = 192;
    const x = ic.getContext("2d");
    x.fillStyle = "#161A20"; x.fillRect(0,0,192,192);
    x.fillStyle = "#A45F27"; x.fillRect(0,150,192,42);
    x.fillStyle = "#E2E5E9";
    x.beginPath(); x.moveTo(96,26); x.lineTo(160,74); x.lineTo(32,74); x.closePath(); x.fill();
    for(let i=0;i<5;i++) x.fillRect(40+i*26, 82, 13, 60);
    x.fillRect(28,142,136,10);
    const icon = ic.toDataURL("image/png");
    const man = {
      name:"One Nation, Under, ME.", short_name:"Under ME",
      display:"standalone", orientation:"any",
      background_color:"#0D1014", theme_color:"#161A20", start_url:location.href,
      icons:[{src:icon, sizes:"192x192", type:"image/png", purpose:"any maskable"}]
    };
    const add = (tag, attrs) => {
      const e = document.createElement(tag);
      for(const k in attrs) e.setAttribute(k, attrs[k]);
      if(document.head) document.head.appendChild(e);
    };
    add("link", {rel:"manifest",
      href:"data:application/manifest+json," + encodeURIComponent(JSON.stringify(man))});
    add("link", {rel:"apple-touch-icon", href:icon});
    add("meta", {name:"apple-mobile-web-app-capable", content:"yes"});
    add("meta", {name:"mobile-web-app-capable", content:"yes"});
    add("meta", {name:"apple-mobile-web-app-status-bar-style", content:"black-translucent"});
    add("meta", {name:"apple-mobile-web-app-title", content:"Under ME"});
    add("meta", {name:"theme-color", content:"#161A20"});
  }catch(e){}
})();

/* film grain, generated once */
(function(){
  const c = document.createElement("canvas");
  c.width = c.height = 110;
  const x = c.getContext("2d");
  const img = x.createImageData(110,110), d = img.data;
  for(let i=0;i<d.length;i+=4){
    const v = 128 + (Math.random()-0.5)*190;
    d[i]=d[i+1]=d[i+2]=v; d[i+3]=255;
  }
  x.putImageData(img,0,0);
  try{ el("grain").style.backgroundImage = "url(" + c.toDataURL("image/png") + ")"; }catch(e){}
})();

try{ buildLobbies(); }catch(e){ if(window.console) console.warn("buildLobbies", e); }
if(G.bare !== false){ G.bare = true; document.body.classList.add("is-bare"); }
document.body.classList.remove("ui-open");
try{ migrateGfx(); }catch(e){}
/* Keep the opening card responsive. Quality setup and the first room build
   happen after Continue/New career, never on the menu's critical path. */
try{ resize(); }catch(e){}
try{ opening(); }catch(e){
  if(window.console) console.warn("opening", e);
  try{
    veil.hidden = false;
    card.classList.add("card--open");
    card.innerHTML = '<h1>One Nation, Under, ME.</h1><p>Could not finish the start card.</p>' +
      '<div class="card__actions">' +
      '<button class="btn" type="button" id="cont" data-gp="boot:cont">Continue</button>' +
      '<button class="btn" type="button" id="fresh" data-gp="boot:fresh">New career</button></div>';
    const c = el("cont"), f = el("fresh");
    if(c) c.onclick = () => { try{ cardActContinue(); }catch(err){ softUnstickVeil(); } };
    if(f) f.onclick = () => { try{ bootFreshCareer(); }catch(err){ softUnstickVeil(); } };
  }catch(e2){}
}

/* warmRooms DISABLED (2026-09-08 freeze fix, reconfirmed 2026-09-09):
   buildRoom() rebuilds the single shared `roomGroup` used by whichever
   room is currently on screen, so pre-building other rooms in the
   background does not warm a cache — it repeatedly clears and replaces
   the room the player is standing in, synchronously, on the main thread.
   A 2026-09-09 attempt to pre-load caucus/press/committee/floor/steps via
   requestIdleCallback reproduced the original freeze (worse: it could
   fire the instant a saved game loads with G.running already true,
   before the player even reached the start card) and was reverted.
   Rooms build on first enter instead; see buildRoom()/rebuildRoomStaged(). */
(function warmRooms(){ /* no-op */ })();

/* Continuity: wall-clock autosave while running (survives long AFK in one room). */
setInterval(() => {
  try{
    if(!G.running || G.over || !G.you || !G.members || !G.members.length) return;
    if(houseQuiet()) return; /* feet ok 20260921f */
    queueSave();
  }catch(e){}
}, 45000);
setInterval(() => {
  try{
    if(typeof document !== "undefined" && document.hidden) return;
    if(typeof saveBusy !== "undefined" && saveBusy) return;
    if(typeof _buildingRoom !== "undefined" && _buildingRoom) return;
    try{ if(houseQuiet() && G.moving) return; }catch(e){}
    if(performance.now() - (_lastDrawn || 0) > 2200) kickFrame();
  }catch(e){}
}, 1500);
addEventListener("beforeunload", () => {
  /* One sync save on tab death is allowed. */
  try{ if(G.you && G.members && G.members.length) save(false, true); }catch(e){}
});
addEventListener("visibilitychange", () => {
  try{
    if(document.visibilityState === "hidden"){
      /* Hidden may queue only if feet are still. */
      if(G.you && G.members && G.members.length && !playerMoving() && !houseQuiet()) queueSave();
    } else {
      last = performance.now();
      cam.vx = 0; cam.vz = 0; cam.yawVel = 0;
      try{ for(const k in keys) keys[k] = false; }catch(e){}
      try{ premisePulse(); }catch(e){}
      kickFrame();
    }
  }catch(e){}
});
try{
  window.ONUM = {
    goTo, enterRoom, forceUnstickMove,
    room(){ return G.room; },
    moving(){ return !!G.moving; },
    running(){ return !!G.running; },
    cam(){ return {x:cam.x, z:cam.z, yaw:cam.yaw, sitting:!!(G.you && G.you.sitting), furnished:!!_roomFurnished}; },
    walk(vx, vz){ cam.vx = vx; cam.vz = vz; G.running = true; },
    day(){ return {day:G.day, sittingDay:G.sittingDay, minute:G.minute, rank:careerRank(G)}; },
    pane(id){
      try{
        if(id && id.indexOf("pane") !== 0){
          id = "pane" + id.charAt(0).toUpperCase() + id.slice(1);
        }
        if(id) showPane(id);
      }catch(e){}
      return (typeof currentPane === "function") ? currentPane() : null;
    },
    kick(){ try{ kickFrame(); }catch(e){} return true; },
    stations(){
      const fade = el("fade");
      return {
        room: G.room,
        running: !!G.running,
        moving: !!G.moving,
        sitting: !!(G.you && G.you.sitting),
        furnished: !!_roomFurnished,
        camOk: isFinite(cam.x) && isFinite(cam.z) && isFinite(cam.yaw),
        glLost: !!GL_LOST,
        fade: fade ? String(fade.style.opacity || "0") : "0",
        veil: !!(veil && !veil.hidden),
        day: G.day,
        people: (typeof hereNow === "function" ? hereNow().length : 0),
        loopLag: performance.now() - (_lastDrawn || 0),
        rooms: (typeof ROOM_ORDER !== "undefined" ? ROOM_ORDER.slice() : [])
      };
    },
    consular(){ try{ ensureConsularCaucus(); }catch(e){} return (G.members||[]).filter(m => m && isConsular(m)).map(m => m.name); },
    horcrux(){ const h = horcruxOf(G.room); return h ? h.id : null; },
    lore(){ return consularLoreEnsure(); },
    gather(h){ try{ ensureConsularCaucus(); consularBody(h == null ? 12 : h); }catch(e){} return G.consularAtBronze || 0; }
  };
}catch(e){}
/* NEPTUNE-UNIFORMS BEGIN — loads neptune/onum-*.js (characters, flags, materials, office amenities).
   Everything is guarded: if a module fails to load, the game runs exactly as before. */
try{
  const NEP = {mods:null, decree:null, failed:false};
  window.NEPTUNE = NEP; NEP.debug = () => ({G, cam, camera, scene, govCard, PROPS, hereNow, syncPeople});
  const GOV_MAP = {republic:"republic", democracy:"democracy", conservative:"parliamentary", commonwealth:"socialist",
    national:"dictatorship", monarchy:"constitutional_monarchy", empire:"empire", consular:"consular_republic",
    theocratic:"theocracy", junta:"junta", mob:"anarchist", oligarchy:"oligarchy", machine:"corporate"};
  const nepGov = () => { try{ return GOV_MAP[(G.regime && G.regime.form) || "republic"] || "republic"; }catch(e){ return "republic"; } };
  const nepHash = s => { let h = 2166136261; s = String(s == null ? "" : s); for(let i = 0; i < s.length; i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return (h >>> 0) % 100000 + 1; };
  const nepSeed = () => { try{ return nepHash(G.country && G.country.name); }catch(e){ return 1; } };
  NEP.isLeader = () => { try{ const y = G.you; if(!y) return false; return y.post === "speaker" || y.post === "leader" || heldOffice() === "pres"; }catch(e){ return false; } };
  NEP.nation = () => {
    if(!G.nepDecree && NEP.decree) G.nepDecree = NEP.decree;
    const d = G.nepDecree || null;
    return {govType:nepGov(), seed:nepSeed(), decree: d && d.active ? {govType:nepGov(), seed:nepSeed(), style:d.style || undefined} : null};
  };
  NEP.setDecree = (on, style) => {
    G.nepDecree = on ? {active:true, style:style || null, day:G.day} : null; NEP.decree = G.nepDecree;
    NEP.remeshAll();
  };
  NEP.remeshAll = () => { try{ everyone().forEach(m => { if(m && m.mesh){ try{ disposePersonMesh(m.mesh); }catch(e){} m.mesh = null; m.faceTex = null; } }); }catch(e){}
    try{ syncPeople(); }catch(e){}
    try{ if(typeof mkMesh !== "undefined" && mkMesh && G.make) mkPreview(); }catch(e){} };

  /* characters: the game's rig still runs (animation, seats, LOD), Neptune's figure is what is drawn */
  const _buildPerson = buildPerson;
  buildPerson = function(p){
    const g = _buildPerson(p);
    try{
      const C = NEP.mods && NEP.mods.chars;
      if(!C || !p || !p.look || !g || g.userData.cheap) return g;
      const nat = NEP.nation();
      const st = p.state || (p.kind === "you" && G.you && G.you.state) || (G.country && G.country.name) || "home";
      const dress = C.dressFor({homeFlag:{type:nepGov(), seed:nepHash(st)}}, nat);
      const L = p.look;
      const o = C.optionsFromLook(L, {uniform:dress.uniform, homeFlag:dress.homeFlag, quality:G.gfx === "best" ? "high" : "med"});
      o.beard = L.beard ? (L.kaiser || nepHash(p.name || p.id) % 9 === 0 ? "kaiser" : true) : false;
      const h = C.makeCharacter(THREE, o);
      g.traverse(m => { if(m.isMesh || m.isSkinnedMesh) m.layers.set(31); });   /* hide the old figure, keep its bones */
      const n = h.group;
      n.scale.set(1/(g.scale.x || 1), 1/(g.scale.y || 1), 1/(g.scale.z || 1));
      g.add(n);
      g.userData.nep = h;
      let last = performance.now();
      let hooked = false;
      n.traverse(m => { if(hooked || !m.isMesh) return; hooked = true;
        m.onBeforeRender = function(r, s, cam){ const t = performance.now(), dt = Math.min(0.1, (t - last)/1000); last = t; if(dt <= 0) return;
          try{ h.update(dt, {camera:cam, sitting: p.kind === "you" ? !!(G.you && G.you.sitting) : !!(p.sitting && !G.noSit && !G.plainSit),
            moving: !!p.moving || !!p.walking, talking: !!p.talking}); }catch(e){} }; });
    }catch(e){ if(!NEP._warned){ NEP._warned = true; console.warn("NEPTUNE character", e); } }
    return g;
  };

  /* flags: the national flag drawn by Neptune for the 21 government types */
  const _flagTexture = flagTexture;
  flagTexture = function(fl){
    try{ const F = NEP.mods && NEP.mods.flags;
      if(F && G.country && fl === G.country.flag) return F.makeFlagTexture(THREE, nepGov(), nepSeed(), {width:512}); }catch(e){}
    return _flagTexture(fl);
  };

  /* materials: Neptune PBR surfaces in place of the canvas ones, brightness matched to the original */
  const _matTex = matTex, NEP_MAT = new Map();
  const nepLum = img => { try{ const c = document.createElement("canvas"); c.width = c.height = 16; const x = c.getContext("2d"); x.drawImage(img, 0, 0, 16, 16);
    const d = x.getImageData(0, 0, 16, 16).data; let s = 0; for(let i = 0; i < d.length; i += 4) s += d[i]*.2126 + d[i+1]*.7152 + d[i+2]*.0722; return s / (d.length/4) / 255; }catch(e){ return 0; } };
  matTex = function(tex, rx, ry, rough, col){
    try{ const M = NEP.mods && NEP.mods.mats;
      if(M && tex && tex.image && G.gfx !== "simple"){
        const nm = tex.image === (TEX.marble && TEX.marble.image) ? "marble" : tex.image === (TEX.panel && TEX.panel.image) ? "wood_panel"
          : tex.image === (TEX.carpet && TEX.carpet.image) ? "carpet" : tex.image === (TEX.stone && TEX.stone.image) ? "limestone"
          : tex.image === (TEX.leather && TEX.leather.image) ? "leather" : null;
        if(nm){
          const k = nm + "|" + qrep(rx) + "|" + qrep(ry) + "|" + (col === undefined ? "x" : col);
          if(NEP_MAT.has(k)) return NEP_MAT.get(k);
          const m = M.makeMaterial(nm, THREE, {repeat:[qrep(rx), qrep(ry)], quality:G.gfx === "best" ? "high" : "med"});
          m.aoMap = null;  /* game geometry has no uv2 */
          const tx = M.getTextures(nm, THREE, {repeat:[qrep(rx), qrep(ry)], quality:G.gfx === "best" ? "high" : "med"});
          const a = nepLum(tex.image), b = nepLum(tx.map.image);
          const k2 = (a > 0 && b > 0) ? Math.max(0.5, Math.min(2, a / b)) : 1;
          m.color.setScalar(k2); if(col !== undefined) m.color.multiply(new THREE.Color(col));
          m.needsUpdate = true; NEP_MAT.set(k, m); return m;
        }
      } }catch(e){ if(!NEP._mw){ NEP._mw = true; console.warn("NEPTUNE material", e); } }
    return _matTex(tex, rx, ry, rough, col);
  };

  /* office amenities: session.html's own kAmenities() calls window.addOfficeAmenities (loaded below) for a new office.
     Its label sprites must not throw when the game's pick rays (no camera set) hit them. */
  try{ const _sr = THREE.Sprite.prototype.raycast; THREE.Sprite.prototype.raycast = function(rc, out){ if(!rc || !rc.camera) return; return _sr.call(this, rc, out); }; }catch(e){}

  /* the leader's decree: a button on the government card */
  const _govCard = govCard;
  govCard = function(){
    _govCard();
    try{
      if(!NEP.mods) return;
      const act = card.querySelector(".card__actions"); if(!act) return;
      const on = !!(G.nepDecree && G.nepDecree.active), lead = NEP.isLeader();
      const p = document.createElement("p");
      p.innerHTML = "<strong>Dress code.</strong> " + (on ? "By decree, everyone in public life wears the " + nepGov().replace(/_/g, " ") + " uniform."
        : "No uniform is decreed; members wear their own clothes and their home state's lapel pin.") + (lead ? "" : " Only the nation's leader can change it.");
      act.parentNode.insertBefore(p, act);
      if(lead){ const b = document.createElement("button"); b.type = "button"; b.className = "btn"; b.id = "nepDecree";
        b.textContent = on ? "Revoke the uniform decree" : "Decree a uniform";
        b.addEventListener("click", () => { NEP.setDecree(!on); govCard(); }); act.insertBefore(b, act.firstChild); }
    }catch(e){ console.warn("NEPTUNE decree", e); }
  };

  /* loader */
  const base = (() => { try{ return new URL("neptune/", location.href).href; }catch(e){ return "neptune/"; } })();
  const sc = document.createElement("script"); sc.src = base + "onum-office-amenities.js"; sc.onerror = () => console.warn("NEPTUNE: amenities not loaded"); document.head.appendChild(sc);
  if(location.protocol !== "file:") Promise.all([import(base + "onum-characters.js"), import(base + "onum-flags.js"), import(base + "onum-materials.js")]).then(([c, f, m]) => {
    NEP.mods = {chars:c, flags:f, mats:m};
    try{ if(G.country) TEX.flag = flagTexture(G.country.flag); }catch(e){}
    NEP.remeshAll();
    try{ if(_roomBuiltId && !_buildingRoom){ const r = _roomBuiltId; _roomBuiltId = null; _roomFurnished = false; clearRoom(); buildRoom(r); } }catch(e){ console.warn("NEPTUNE rebuild", e); }
    console.log("NEPTUNE modules loaded");
  }).catch(e => { NEP.failed = true; console.warn("NEPTUNE modules failed; game continues without them", e); });
}catch(e){ try{ console.warn("NEPTUNE block", e); }catch(e2){} }
/* NEPTUNE-UNIFORMS END */
/* NEPTUNE-CLARITY BEGIN — "What's this?" explainers, live session transcript with glosses,
   session pace (Slow/Normal/Fast), wall-clock speaking timer, read/handled/outcome badges.
   Wraps existing functions only; every hook falls back to the original on any error. */
try{
  const CL = window.NEPTUNE_CLARITY = {items:[], sess:null, past:[], ctx:null, hold:false, paused:false, lastReal:0, said:{}};
  const LS = (k, v) => { try{ if(v === undefined) return JSON.parse(localStorage.getItem("clarity." + k) || "null"); localStorage.setItem("clarity." + k, JSON.stringify(v)); }catch(e){ return null; } };
  CL.pace = LS("pace") || "slow";
  CL.past = LS("sessions") || [];
  const PACE = {slow:0.5, normal:0.75, fast:1};
  const esc = s => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
  const now = () => { try{ return "d" + G.day + " " + hhmm(); }catch(e){ return ""; } };
  const roomName = r => { try{ return (ROOMS[r] && ROOMS[r].t) || r || ""; }catch(e){ return r || ""; } };
  const billNow = () => { try{ return G.bill && !G.bill.done ? G.bill : null; }catch(e){ return null; } };

  /* ── hand-written dictionary, one entry per kind of thing that happens to you ── */
  const MISS = {caucus:9, crisis:8, hearing:6, lobby:5};
  const KIND = {
    caucus:{n:"Party meeting (caucus)", what:"Your party's members meet behind closed doors to agree one line before the floor vote. The chair calls each member in turn; the whip watches who speaks and how.",
      why:"This is where your party decides whether it trusts you. The whip's count, your standing inside the party, and how colleagues vote later all move here.",
      can:["Attend and speak when the chair calls you (hold the line, speak for the doubters, keep quiet, or argue your own vote)","Stay away (costs more if you did not send apologies)"]},
    hearing:{n:"Committee hearing", what:"A committee questions a witness (an official, an expert, sometimes a fellow member) in rounds. Members ask; the witness answers into the record.",
      why:"Hearings shape the bill before it reaches the floor. A good question moves the room and your standing; a witness who breaks can sink a bill.",
      can:["Press the witness hard (bigger standing gain, risk of looking cruel)","Give them room (smaller, safer gain)","Yield your time (standing falls)"]},
    presser:{n:"Press conference", what:"You and others take questions from the press gallery. What you say here becomes the story tomorrow.",
      why:"Moves your press standing and public approval; rivals use it to catch you out.",
      can:["Take the hard question","Stay on message","Go after the other side (risky)"]},
    crisis:{n:"Emergency debate", what:"The House is recalled to act on an emergency (floods, unrest, money that must move today). Longer than a party meeting and runs in rounds.",
      why:"States in trouble are watching. Moving fast wins standing; refusing to vote blind can be principled but is risky.",
      can:["Move the money now","Insist on reading it first (risky)","Stand aside for affected members"]},
    townhall:{n:"Constituency surgery (town hall)", what:"People from your district bring you their problems in person.",
      why:"This is your re-election. Approval at home and your margin move here.", can:["Listen and promise help","Explain the vote","Leave early"]},
    lobby:{n:"A quiet approach (lobby)", what:"Someone with money or influence wants a private word, usually about a vote.",
      why:"Deals made here buy support or war-chest money, but can surface later as scandal.", can:["Hear them out","Make or refuse a deal","Not turn up (they notice, and the cloakroom talks)"]},
    statefed:{n:"State–federal business", what:"A dispute between a state government and the federal level that needs a member's attention.", why:"Your state's governor and voters will remember which side you took.", can:["Back the state","Back the federal standard","Stay out of it"]},
    office:{n:"Office appointment", what:"Something booked into your own diary.", why:"Missing your own appointments costs standing with whoever booked them.", can:["Go","Reschedule"]},
    vote:{n:"Floor vote (roll call)", what:"The whole House votes aye or no on the bill on the paper. Every member's vote is recorded.",
      why:"The single most visible thing you do. Breaking the party line costs trust with the whip; broken pledges by colleagues are remembered.",
      can:["Vote aye","Vote no","Be absent (counts against you)"]},
    session:{n:"Sitting", what:"A formal sitting run by a chair: members speak in order and you are called once or twice.", why:"Silence is noticed: sitting through without speaking lowers your standing.", can:["Speak when called","Read the transcript to see who is with you"]}
  };
  const MAILK = {
    grievance:"A colleague is telling you, in writing, that something you did hurt them. Answering repairs or hardens it; ignoring it makes it worse.",
    ask:"Someone wants something from you (a post, a vote, a favour). Saying yes earns warmth and sometimes a debt; no costs some warmth.",
    note:"Information from the Clerk or a colleague. Usually no answer needed.",
    vote:"About how you or others voted. Read it for who is angry and who owes you.",
    decision:"A choice that needs your answer; each option has a lasting effect.",
    reply:"An answer to something you sent.", witness:"About a hearing witness or being called before a committee.",
    cable:"Official word from outside the House (government, the realms).", fan:"A member of the public writing to you. Good for morale; rarely needs action.",
    press:"The press want a comment. What you say may be printed.", ruling:"A ruling from the chair or a court that changes the rules you play by."
  };
  /* plain-language meaning of common notices and Wire lines */
  const PHR = [
    [/unopened|returned to sender|came back/i, "Returned unopened", "Your letter was refused or not read. It is not a postal fault: the person is freezing you out (low warmth or trust) or the matter is closed to them.", ["Speak to them in person, or go through an ally they trust","Repair first: keep a promise, do them a favour, apologise if it was personal","Then write again"], "Writing again at once usually changes nothing."],
    [/unanswered|never replied|leave it unanswered/i, "Left unanswered", "Someone reached out and got no reply. People read silence as an answer.", ["Answer it late (better than never)","Make it up in person"], "Their warmth toward you falls; the cloakroom may hear."],
    [/never spoke|said nothing/i, "You stayed silent in a sitting", "You were present but never took the floor when the chair called you.", ["Next time, answer when called; even a short line counts"], "Standing −5; everyone in the room thinks a little less of you."],
    [/time is up|let the moment go/i, "Your speaking time ran out", "The chair gave you the floor and the clock ran down before you spoke.", ["Pick an option or type your own words while the clock runs"], "Standing −4."],
    [/escort/i, "Escorted to an event", "You said you'd attend, so your staff walked you there.", ["Take part, or walk out (counts as missing it)"], ""],
    [/present for|you were there|you are in the room/i, "Attended in person", "You sat in the room in real time instead of reading a summary.", ["Speak when called; watch the transcript"], "Attending protects your standing."],
    [/has been called before the committee|sworn/i, "A witness is called", "Someone must answer the committee's questions under oath.", ["Question them when it's your turn","Defend them if they are a colleague (they remember)"], ""],
    [/rises|concludes|has begun/i, "Sitting opened/closed", "Procedural: the sitting started or ended.", [], ""],
    [/blasphem/i, "Blasphemy", "You said something the House treats as sacrilege. In this Republic that is a grave offence.", ["Apologise; confession at the chapel"], "Standing and faith standing fall sharply."],
    [/whip/i, "The whip", "The whip counts votes for your party and enforces the line.", ["Keep the line to stay in favour, or bargain for a free vote"], "Breaking the line costs the whip's trust."],
    [/approach .*unanswered|cloak/i, "Cloakroom talk", "Members are gossiping about something you did or didn't do.", ["Correct it in person if it matters"], "Reputation drifts."]
  ];
  function phrase(t){ t = String(t || ""); for(const p of PHR) if(p[0].test(t)) return p; return null; }

  /* ── notices log (events, notes, wire, mail) ── */
  function urg(k, t){ if(k === "crisis" || /emergenc|urgent|now\b|time is up/i.test(t || "")) return "high"; if(k === "caucus" || k === "hearing" || k === "vote" || k === "mail-ask" || k === "mail-decision" || k === "mail-grievance") return "med"; return "low"; }
  function addItem(o){
    try{
      o.id = (CL.nid = (CL.nid || 0) + 1); o.at = o.at || now(); o.read = !!o.read; o.handled = !!o.handled;
      o.urg = o.urg || urg(o.k, o.text);
      if(CL.items.some(x => x.text === o.text && x.k === o.k && x.at === o.at)) return null;
      CL.items.unshift(o); if(CL.items.length > 80) CL.items.length = 80;
      paintBadge(); return o;
    }catch(e){ return null; }
  }
  CL.addItem = addItem;
  function wrap(name, get, set, fn){ try{ const o = get(); if(typeof o !== "function") return; set(fn(o)); }catch(e){ try{ console.warn("NEPTUNE-CLARITY hook " + name, e); }catch(e2){} } }

  /* events */
  wrap("eventCard", () => eventCard, f => { eventCard = f; }, orig => function(e){
    let it = null;
    try{ if(e){ it = CL.items.find(x => x.ev === e) || addItem({k:e.k || "event", kind:"event", title:e.t, text:e.t + (e.d ? " — " + e.d : ""), ev:e}); CL.ctx = {type:"event", e, item:it}; if(it) it.read = true; } }catch(err){}
    const r = orig.apply(this, arguments);
    try{ decorateCard(); }catch(err){}
    return r;
  });
  wrap("note", () => note, f => { note = f; }, orig => function(text, big){ try{ addItem({k:"note", kind:"note", title:big ? "Notice" : "Note", text:String(text)}); }catch(e){} return orig.apply(this, arguments); });
  wrap("pushWireScrap", () => pushWireScrap, f => { pushWireScrap = f; }, orig => function(tag, text){ try{ addItem({k:"wire", kind:"wire", title:"Wire · " + (tag || "Wire"), text:String(text || "")}); }catch(e){} return orig.apply(this, arguments); });
  wrap("pushMail", () => pushMail, f => { pushMail = f; }, orig => function(from, subject, body, opts){
    const r = orig.apply(this, arguments);
    try{ const m = G.mail[0]; if(m && !m.outgoing) addItem({k:"mail-" + m.kind, kind:"mail", title:"Mail · " + m.from, text:m.subject + " — " + String(m.body || "").slice(0, 200), mail:m}); }catch(e){}
    return r;
  });
  wrap("holdVote", () => holdVote, f => { holdVote = f; }, orig => function(){
    const b = G.bill, yv = G.you ? G.you.vote : null;
    const r = orig.apply(this, arguments);
    try{
      if(b){
        const t = tallyBill(b, false), pass = t.aye > t.no;
        const named = (G.members || []).filter(m => !m.gone && (m.post || (m.rel && Math.abs(m.rel.warmth) > 25))).slice(0, 3)
          .map(m => surname(m.name) + ": " + (memberVote(m, b) > 0 ? "aye" : "no")).join(", ");
        const you = G.you && G.you.vote != null ? (G.you.vote > 0 ? "aye" : "no") : "absent";
        addItem({k:"vote", kind:"vote", title:"Roll call · " + b.title, text:b.title + ": " + (pass ? "passed" : "failed") + " " + t.aye + "–" + t.no + ".", read:true, handled:true,
          outcome:"You: " + you + (named ? " — " + named : "")});
        CL.ctx = {type:"vote", b};
      }
    }catch(e){}
    try{ decorateCard(); }catch(e){}
    return r;
  });

  /* ── transcript: classify and gloss every line spoken in a sitting ── */
  const TAGS = {support:"#3c8d5a", oppose:"#b0473c", threat:"#8a2be2", deal:"#c08a1e", procedural:"#5b6b7c", position:"#777"};
  function classify(who, text){
    const t = String(text || "").toLowerCase();
    const chair = PROC.chair && who === surname(PROC.chair.name);
    if(/^(order|the chair|i call|the member for|you wanted in|second round|round \d|we will go round|again, and|that is the business|we are finished|enough\. get|that concludes|this committee is in session|right\. doors|the house will come|let us begin|we will take questions)/.test(t) || /time is up|yield the balance|recognises/.test(t) || (chair && /order|round|call|floor|finished|concludes/.test(t)))
      return ["procedural", /time is up/.test(t) ? "The chair has cut the speaker off; their time is spent." : /round/.test(t) ? "The chair is starting another round: everyone gets asked again, and they expect sharper answers than last time." : /call|floor|recognis|member for|wanted in/.test(t) ? "It is a member's turn to speak. If it names you, the clock is now yours." : /business|finished|concludes|get to the floor/.test(t) ? "The sitting is over. What was said is now on the record." : "Housekeeping by the chair: how the sitting will run, not anybody's position."];
    if(/remember|regret|answer for|outside|head on a plate|shame|watch |keeps a list|withdraw it|who wrote that for you/.test(t))
      return ["threat", "A warning: they are signalling a cost (to your reputation or a future vote) if you continue. Not a formal action yet."];
    if(/if i back|will you back|owe|trade|in exchange|favour|put me down|you have my vote|version of this everyone can live with|close to something workable/.test(t))
      return ["deal", "An opening for a deal: they would move if they got something back. Approach them after the sitting."];
    if(/hear, hear|voting with the party|go in together|quite right|on that point i agree|fair — continue|put my name|i am with you|with you on this|move the money today/.test(t))
      return ["support", "They are backing the line being argued (or the party line). Count them as a likely yes."];
    if(/not going to be able|cannot|nonsense|not what (it|the clause) says|will not|does the opposite|withdrawn|no costing|where is the costing|name the figure|unpopular thing|two different figures|which one is in the record|who paid|lose their jobs|not in the chamber/.test(t))
      return ["oppose", /figure|costing|record/.test(t) ? "A challenge on the facts: they doubt the numbers and want them on the record. That is opposition dressed as a question." : /lose their jobs|unpopular/.test(t) ? "A warning about the cost at home: they are wavering and need cover before they can vote yes." : "They are against the proposal as it stands, or against what was just said."];
    if(/\?$/.test(t)) return ["position", "A question. Watch the answer: it tells you more than the question does."];
    return ["position", "A statement of where they stand, not a move against anybody."];
  }
  function speakerOf(who){ try{ return (G.members || []).find(m => !m.gone && surname(m.name) === who && m.room === G.room) || null; }catch(e){ return null; } }
  function glossFor(who, text){
    const c = classify(who, text); let g = c[1];
    try{
      const m = speakerOf(who), b = billNow();
      if(m && b && c[0] !== "procedural"){ const v = memberVote(m, b); g += " Their likely vote on " + b.title + ": " + (v > 0 ? "aye" : v < 0 ? "no" : "undecided") + "."; }
      const key = String(text).trim().toLowerCase().slice(0, 60), prev = CL.said[key];
      if(prev) g += " Repeat — " + (prev.who === who ? "they" : prev.who) + " said this at " + prev.at + (prev.tag !== c[0] ? " (then it read as " + prev.tag + ")" : "") + ". Said again " + (c[0] === "procedural" ? "it is just the chair keeping order." : "it means the point has not been answered, and they are pressing it.");
      else CL.said[key] = {who, at:hhmm(), tag:c[0]};
    }catch(e){}
    return [c[0], g];
  }
  wrap("appendFloor", () => appendFloor, f => { appendFloor = f; }, orig => function(who, text){
    const r = orig.apply(this, arguments);
    try{
      const [tag, gloss] = who === "You" ? ["position", "Your own words, now on the record."] : glossFor(who, text);
      const L = {who:String(who), text:String(text), at:hhmm(), tag, gloss};
      if(CL.sess){ CL.sess.lines.push(L); if(CL.sess.lines.length > 120) CL.sess.lines.shift(); }
      paintTx();
      /* give people time to be read: the bubble stays up longer at slower pace */
      const m = speakerOf(who); const f = PACE[CL.pace] || 1;
      if(m && m.sayT && f < 1) m.sayT = m.sayT / f;
    }catch(e){}
    return r;
  });
  wrap("procStart", () => procStart, f => { procStart = f; }, orig => function(e){
    const ok = orig.apply(this, arguments);
    try{ if(ok){ CL.said = {}; CL.sess = {title:procTitle(e), k:e.k, day:G.day, at:hhmm(), room:roomName(G.room), lines:[], outcome:""}; CL.ctx = {type:"session", e}; try{ if(PROC.chair && PROC.chair.say) CL.sess.lines.push({who:surname(PROC.chair.name) + " (chair)", text:PROC.chair.say, at:hhmm(), tag:"procedural", gloss:"The chair opens the sitting and sets the rules: who speaks, in what order, for how long. Not a position on the bill."}); }catch(x){} paintTx(true);
      const it = CL.items.find(x => x.ev === e); if(it){ it.read = true; } } }catch(err){}
    return ok;
  });
  wrap("procEnd", () => procEnd, f => { procEnd = f; }, orig => function(){
    const e = PROC.e, spoke = PROC.spoke;
    const r = orig.apply(this, arguments);
    try{
      const out = spoke ? "You spoke" : "You stayed silent (standing −5)";
      if(CL.sess){ CL.sess.outcome = out; CL.past.unshift(CL.sess); CL.past = CL.past.slice(0, 15); LS("sessions", CL.past); }
      let it = e && CL.items.find(x => x.ev === e);
      if(!it && e) it = addItem({k:e.k, kind:"event", title:e.t, text:e.t, ev:e});
      if(it){ it.read = true; it.handled = true; it.outcome = out; }
      CL.sess = null; CL.hold = false; paintTx();
    }catch(err){}
    return r;
  });
  wrap("procYouSay", () => procYouSay, f => { procYouSay = f; }, orig => function(opt, free){ try{ CL.hold = false; if(CL.sess) CL.sess.youSaid = opt ? opt.t : "own words"; }catch(e){} return orig.apply(this, arguments); });

  /* ── pacing + accurate speaking clock (wall time, readable) ── */
  wrap("procTick", () => procTick, f => { procTick = f; }, orig => function(dt){
    try{
      if(!PROC.on) return orig(dt);
      if(CL.paused) return;                                      /* explainer open: the sitting waits */
      if(PROC.phase === "you"){
        CL.lastRun = 0;
        const t = performance.now(), real = CL.lastReal ? Math.min(0.25, (t - CL.lastReal) / 1000) : dt; CL.lastReal = t;
        if(CL.hold || document.hidden) return orig(0);           /* wait for the player before the clock starts */
        return orig(real);
      }
      /* wall-clock based so a slow frame rate no longer drags the sitting (it ran ~5x slow at low fps) */
      const t2 = performance.now(), real2 = CL.lastRun ? Math.min(0.25, (t2 - CL.lastRun) / 1000) : dt; CL.lastRun = t2;
      const before = PROC.phase;
      const r = orig((document.hidden ? 0 : Math.max(dt, real2)) * (PACE[CL.pace] || 1));
      if(PROC.phase !== "you") CL.lastReal = 0;
      if(PROC.phase === "you" && before !== "you"){ CL.hold = true; CL.lastReal = performance.now(); try{ procSetBar(procTitle(PROC.e), "You have the floor. The clock starts when you are ready.", PROC.opts, PROC.clock); }catch(e){} }
      return r;
    }catch(e){ return orig(dt); }
  });
  wrap("procSetBar", () => procSetBar, f => { procSetBar = f; }, orig => function(title, sub, opts, secs){
    const r = orig.apply(this, arguments);
    try{
      const bar = el("procBar"); if(!bar) return r;
      const h = bar.querySelector(".proc__h");
      const box = document.createElement("span"); box.className = "cl-procx";
      box.innerHTML = '<button type="button" class="cl-btn" data-clwhat="1">What\'s this?</button>' +
        (PROC.phase === "you" && CL.hold ? ' <button type="button" class="cl-btn cl-go" data-clready="1">Take the floor ▸ (start clock)</button>' : '');
      (h || bar).appendChild(box);
      box.querySelector("[data-clwhat]").addEventListener("click", () => openExplain());
      const go = box.querySelector("[data-clready]"); if(go) go.addEventListener("click", () => { CL.hold = false; CL.lastReal = performance.now(); go.remove(); });
    }catch(e){}
    return r;
  });

  /* ── UI ── */
  const css = document.createElement("style");
  css.textContent = `
  .cl-btn{font:600 12px/1 system-ui,sans-serif;background:#f4efe2;color:#222;border:1px solid #8a7f66;border-radius:12px;padding:5px 10px;cursor:pointer;margin-left:6px}
  .cl-go{background:#2f5d3a;color:#fff;border-color:#2f5d3a}
  #clDock{position:fixed;right:14px;bottom:64px;z-index:9000;display:flex;gap:6px}
  #clDock .n{background:#b0473c;color:#fff;border-radius:9px;padding:1px 6px;margin-left:4px;font-size:11px}
  #clPanel{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:min(680px,94vw);max-height:84vh;overflow:auto;z-index:100000;background:#fbf8f0;color:#1d1d1d;border:1px solid #8a7f66;border-radius:10px;box-shadow:0 12px 40px rgba(0,0,0,.45);padding:16px 18px;font:14px/1.45 Georgia,serif}
  #clPanel h2{margin:0 0 4px;font-size:20px} #clPanel h3{margin:12px 0 4px;font:700 12px system-ui;text-transform:uppercase;letter-spacing:.06em;color:#6a5f46}
  #clPanel ul{margin:2px 0 6px 18px;padding:0} #clPanel .x{position:absolute;right:12px;top:10px}
  #clPanel .tabs button{margin:0 4px 8px 0}
  .cl-it{border-top:1px solid #e3dccb;padding:6px 0;cursor:pointer} .cl-it:hover{background:#f1ead8}
  .cl-b{display:inline-block;font:600 11px system-ui;border-radius:8px;padding:1px 6px;margin-right:4px;color:#fff}
  .cl-high{background:#b0473c}.cl-med{background:#c08a1e}.cl-low{background:#8a8a8a}.cl-ok{background:#3c8d5a}.cl-new{background:#2a5d9f}
  #clTx{position:fixed;right:12px;top:72px;width:380px;max-height:56vh;overflow:auto;z-index:8000;background:rgba(251,248,240,.96);color:#1d1d1d;border:1px solid #8a7f66;border-radius:8px;font:13px/1.35 Georgia,serif;padding:8px 10px;box-shadow:0 6px 18px rgba(0,0,0,.35)}
  #clTx .hd{display:flex;justify-content:space-between;align-items:center;font:700 12px system-ui;text-transform:uppercase;letter-spacing:.05em;color:#6a5f46;position:sticky;top:-8px;background:#fbf8f0;padding:4px 0}
  .cl-ln{border-top:1px solid #e3dccb;padding:5px 0} .cl-ln u{text-decoration:none;color:#888;font:11px monospace;margin-right:4px}
  .cl-ln i{display:block;color:#4a4a4a;font-size:12px;margin-top:2px} .cl-tag{font:600 10px system-ui;color:#fff;border-radius:6px;padding:0 5px;margin-left:4px;text-transform:uppercase}
  .cl-sum{border:1px solid #e3dccb;border-radius:6px;padding:6px 8px;margin:6px 0;background:#fffdf7;color:#1d1d1d}
  #tipCard{z-index:100001}
  .cl-ib{display:flex;gap:10px;align-items:flex-start}.cl-ibl{flex:1 1 55%;max-height:62vh;overflow:auto}.cl-ibp{flex:1 1 45%;position:sticky;top:0;max-height:62vh;overflow:auto;border-left:1px solid rgba(127,127,127,.3);padding-left:8px}
  .cl-sech{cursor:pointer;font:700 12px system-ui;text-transform:uppercase;letter-spacing:.04em;margin:8px 0 4px}.cl-sel{outline:1px solid rgba(127,127,127,.6)}
  .cl-nl{cursor:help}.cl-nl:hover{text-decoration:underline dotted;text-decoration-color:rgba(127,127,127,.6);text-underline-offset:2px}
  .cl-card{font:600 12px system-ui;margin:0 0 8px;display:flex;gap:4px;flex-wrap:wrap;align-items:center}`;
  document.head.appendChild(css);

  const dock = document.createElement("div"); dock.id = "clDock";
  dock.innerHTML = '<button type="button" class="cl-btn" id="clWhatBtn" title="Explain what is on screen now">? What\'s this</button><button type="button" class="cl-btn" id="clLogBtn" title="Notices and past sessions">Notices &amp; Session Log<span class="n" id="clN" hidden></span></button>';
  document.body.appendChild(dock);
  el("clWhatBtn").addEventListener("click", () => openExplain());
  el("clLogBtn").addEventListener("click", () => openLog("notices"));

  function paintBadge(){ try{ const n = CL.items.filter(x => !x.read).length; const b = el("clN"); if(b){ b.hidden = !n; b.textContent = n; } }catch(e){} }
  function badges(it){
    let h = '<span class="cl-b cl-' + it.urg + '">' + (it.urg === "high" ? "URGENT" : it.urg === "med" ? "ACTION" : "INFO") + '</span>';
    if(it.mail){ it.read = it.read || it.mail.read; if(it.mail.answered) it.handled = true; }
    h += it.handled ? '<span class="cl-b cl-ok">Handled ✓' + (it.outcome ? " — " + esc(it.outcome) : "") + '</span>' : it.read ? '<span class="cl-b cl-ok">Read ✓</span>' : '<span class="cl-b cl-new">New</span>';
    return h;
  }
  function panel(html){
    let p = el("clPanel");
    if(!p){ p = document.createElement("div"); p.id = "clPanel"; document.body.appendChild(p); }
    p.innerHTML = '<button type="button" class="cl-btn x" id="clClose">Close ✕</button>' + html;
    p.hidden = false;
    el("clClose").addEventListener("click", closePanel);
    CL.paused = !!(PROC && PROC.on);   /* a sitting waits while you read */
    return p;
  }
  function closePanel(){ const p = el("clPanel"); if(p) p.hidden = true; CL.paused = false; CL.lastReal = 0; CL.lastRun = 0; }
  CL.close = closePanel;

  function list(a){ return a && a.length ? "<ul>" + a.map(x => "<li>" + x + "</li>").join("") + "</ul>" : "<p>—</p>"; }
  function fx(o){ const b = []; if(o.stand) b.push("standing " + (o.stand > 0 ? "+" : "") + o.stand); if(o.sway) b.push("moves the room " + (o.sway > 0 ? "+" : "") + o.sway); if(o.press) b.push("press " + (o.press > 0 ? "+" : "") + o.press); if(o.risk) b.push("risky"); if(o.loyal) b.push("whip notices loyalty"); if(o.doubt) b.push("doubters remember you"); return b.join(", ") || "little effect"; }
  function fnFx(fn){ try{ const s = String(fn); const m = s.match(/ripple\(\s*\w+\s*,\s*(-?\d+)/); const t = s.match(/trust\s*\+\s*(-?\d+)|trust-(\d+)/); const b = []; if(m) b.push("their warmth toward you " + (+m[1] > 0 ? "+" : "") + m[1]); if(t) b.push("trust " + (t[1] ? "+" + t[1] : "−" + t[2])); return b.join(", ") || "changes how they see you"; }catch(e){ return ""; } }
  function explainEvent(e, it){
    const K = KIND[e.k] || {n:e.t, what:"A scheduled event in the House.", why:"Turning up, and how you act there, moves your standing.", can:["Attend","Skip"]};
    const cost = (MISS[e.k] || 4) * (e.rsvp === false ? 0.35 : 1);
    const opts = (() => { try{ return procOptions(e); }catch(x){ return []; } })();
    return { title:(e.t || K.n), kind:K.n, what:K.what + (e.d ? "<br><br><em>Today:</em> " + esc(e.d) : ""), why:K.why, can:K.can,
      conseq:opts.map(o => "<b>" + esc(o.t) + "</b>: " + fx(o)).concat(["<b>Stay silent when called</b>: standing −5, everyone present cools on you", "<b>Let your clock run out</b>: standing −4", "<b>Miss it</b>: standing about −" + Math.round(cost) + (e.rsvp === false ? " (reduced: you sent apologies)" : "") + ", influence falls"]),
      when:(e.hour != null ? (typeof hourLabel === "function" ? hourLabel(e.hour) : e.hour + ":00") : "") + (e.day != null ? ", day " + e.day : "") + " · " + esc(roomName(e.room)), it };
  }
  function explainText(it){
    const p = phrase(it.text) || phrase(it.title);
    const mk = it.mail ? (MAILK[it.mail.kind] || MAILK.note) : null;
    const o = { title:esc(it.title), kind:p ? p[1] : it.kind === "mail" ? "Mail" : it.kind === "wire" ? "Wire item" : it.kind === "vote" ? "Roll call result" : "Notice",
      what:"<em>“" + esc(it.text) + "”</em><br><br>" + (p ? p[2] : mk || (it.kind === "wire" ? "News running on the Wire: something that happened in the building. Information unless it names you." : "A line in your record of the day.")),
      why:p ? (p[4] || "It tells you how people are reading you.") : it.kind === "vote" ? "Who voted how decides who you thank, who you chase, and who broke a promise." : "Knowing it lets you act before others do.",
      can:p ? p[3] : it.mail && it.mail.options ? it.mail.options.map(x => esc(x.t)) : ["Nothing required; read and move on"],
      conseq:it.mail && it.mail.options ? it.mail.options.map(x => "<b>" + esc(x.t) + "</b>: " + fnFx(x.run)) : [], when:esc(it.at), it };
    if(it.ev && !it.handled) return explainEvent(it.ev, it);
    return o;
  }
  function explainCard(){
    const c = el("card"); const eb = c && c.querySelector(".eyebrow"), h = c && c.querySelector("h1");
    const t = ((eb && eb.textContent) || "") + " " + ((h && h.textContent) || "");
    const btns = c ? [...c.querySelectorAll("button")].map(b => b.textContent.trim()).filter(x => x && x.length < 60).slice(0, 8) : [];
    const b = billNow();
    if(/vote|ballot|roll/i.test(t)) return Object.assign({title:esc(t.trim())}, {kind:KIND.vote.n, what:KIND.vote.what + (b ? "<br><br>On the paper: <b>" + esc(b.title) + "</b>." : ""), why:KIND.vote.why, can:btns.length ? btns : KIND.vote.can, conseq:[], when:"Now · the floor"});
    const p = phrase(t);
    return {title:esc(t.trim() || "This screen"), kind:p ? p[1] : "Decision card", what:p ? p[2] : "A moment that needs your decision. The text above the buttons is the situation; each button is a different answer.",
      why:"Every choice here is remembered by the people named in it.", can:btns.length ? btns.map(esc) : ["Read and continue"], conseq:p && p[4] ? [p[4]] : [], when:now()};
  }
  function render(x){
    return '<h2>What\'s this? — ' + x.title + '</h2>' + (x.it ? '<div class="cl-card">' + badges(x.it) + '</div>' : '') +
      '<div style="color:#6a5f46;font:600 12px system-ui">' + esc(x.kind) + '</div>' +
      '<h3>What it is</h3><p>' + x.what + '</p><h3>Why it matters to you</h3><p>' + x.why + '</p>' +
      '<h3>What you can do</h3>' + list(x.can) + (x.conseq && x.conseq.length ? '<h3>What each choice does</h3>' + list(x.conseq) : '') +
      '<h3>When / where</h3><p>' + (x.when || "—") + '</p>';
  }
  function openExplain(it){
    let x;
    try{
      if(it) x = it.ev && !it.handled ? explainEvent(it.ev, it) : explainText(it);
      else if(PROC.on && PROC.e) x = explainEvent(PROC.e, CL.items.find(y => y.ev === PROC.e));
      else if(veil && !veil.hidden && veil.classList && card && card.textContent.trim() && getComputedStyle(veil).display !== "none" && getComputedStyle(veil).opacity !== "0"){
        x = CL.ctx && CL.ctx.type === "event" && CL.ctx.e ? explainEvent(CL.ctx.e, CL.ctx.item) : explainCard();
      } else if(CL.items[0]) x = explainText(CL.items[0]);
      else x = {title:"The House", kind:"", what:"Nothing needs you right now. Notices, mail and sittings will appear in Notices &amp; Session Log.", why:"", can:[], conseq:[], when:now()};
      if(x.it) x.it.read = true; paintBadge();
      panel(linkify(render(x)) + '<p><button type="button" class="cl-btn" id="clToLog">All notices &amp; Session Log</button></p>');
      el("clToLog").addEventListener("click", () => openLog("notices"));
    }catch(e){ try{ console.warn("NEPTUNE-CLARITY explain", e); }catch(e2){} }
  }
  CL.explain = openExplain;
  function openLog(tab){
    try{
      let body = "";
      if(tab === "sessions"){
        const all = (CL.sess ? [CL.sess] : []).concat(CL.past);
        body = all.length ? all.map((s, i) => '<details' + (i ? '' : ' open') + '><summary><b>' + esc(s.title) + '</b> — ' + esc(s.room) + ', d' + s.day + ' ' + esc(s.at) + (s.outcome ? ' · <span class="cl-b cl-ok">' + esc(s.outcome) + '</span>' : ' · <span class="cl-b cl-high">live</span>') + '</summary>' + s.lines.map(lineHTML).join("") + '</details>').join("") : "<p>No sittings yet. Attend a party meeting, hearing or debate and its full transcript will be kept here.</p>";
      } else {
        body = CL.items.length ? CL.items.map(it => '<div class="cl-it" data-clit="' + it.id + '">' + badges(it) + '<b>' + esc(it.title) + '</b> <u style="text-decoration:none;color:#888;font:11px monospace">' + esc(it.at) + '</u><br>' + linkify(esc(String(it.text).slice(0, 160))) + '</div>').join("") : "<p>Nothing yet.</p>";
      }
      const p = panel('<h2>' + (tab === "sessions" ? "Session Log" : "Notices") + '</h2><div class="tabs"><button type="button" class="cl-btn" data-cltab="notices">Notices</button><button type="button" class="cl-btn" data-cltab="sessions">Session Log</button></div>' + body);
      p.querySelectorAll("[data-cltab]").forEach(b => b.addEventListener("click", () => openLog(b.getAttribute("data-cltab"))));
      p.querySelectorAll("[data-clit]").forEach(d => d.addEventListener("click", () => openExplain(CL.items.find(x => x.id === +d.getAttribute("data-clit")))));
    }catch(e){ try{ console.warn("NEPTUNE-CLARITY log", e); }catch(e2){} }
  }
  CL.log = openLog;
  function lineHTML(L){ return '<div class="cl-ln"><u>' + esc(L.at) + '</u><b>' + whoLink(L.who) + '</b><span class="cl-tag" style="background:' + (TAGS[L.tag] || "#777") + '">' + esc(L.tag) + '</span><br>' + linkify(esc(L.text)) + '<i>What they meant: ' + esc(L.gloss) + '</i></div>'; }
  function paintTx(force){
    try{
      let box = el("clTx");
      if(!PROC.on || !CL.sess){ if(box) box.hidden = true; return; }
      if(!box){ box = document.createElement("div"); box.id = "clTx"; document.body.appendChild(box); }
      if(CL.txMin){ box.innerHTML = '<div class="hd"><span>Transcript</span><button type="button" class="cl-btn" id="clTxMin">Show ▾</button></div>'; }
      else box.innerHTML = '<div class="hd"><span>Transcript · ' + esc(CL.sess.title) + ' · pace ' + CL.pace + '</span><button type="button" class="cl-btn" id="clTxMin">Hide ▴</button></div>' + CL.sess.lines.map(lineHTML).join("");
      box.hidden = false; box.scrollTop = box.scrollHeight;
      el("clTxMin").addEventListener("click", () => { CL.txMin = !CL.txMin; paintTx(); });
    }catch(e){}
  }
  CL.paintTx = paintTx;

  /* badge line + What's this on every card (events, mail, votes, prompts) */
  function decorateCard(){
    const c = el("card"); if(!c || c.querySelector(".cl-card")) return;
    if(!c.textContent.trim()) return;
    const d = document.createElement("div"); d.className = "cl-card";
    const it = CL.ctx && CL.ctx.item;
    d.innerHTML = (it ? badges(it) : "") + (CL.ctx && CL.ctx.e && CL.ctx.e.room ? '<span class="cl-b cl-low">' + esc(roomName(CL.ctx.e.room)) + '</span>' : "") + '<button type="button" class="cl-btn" data-clwhat="1">What\'s this?</button>';
    c.insertBefore(d, c.firstChild);
    d.querySelector("[data-clwhat]").addEventListener("click", ev => { ev.stopPropagation(); openExplain(); });
  }
  try{
    const c = el("card");
    if(c) new MutationObserver(() => { try{ if(!c.querySelector(".cl-card")) decorateCard(); }catch(e){} }).observe(c, {childList:true});
    if(c) c.addEventListener("click", ev => { try{ const b = ev.target.closest("button"); if(b && !b.closest(".cl-card") && CL.ctx && CL.ctx.item && CL.ctx.type === "event"){ CL.ctx.item.handled = true; CL.ctx.item.outcome = b.textContent.trim().slice(0, 40); CL.ctx = null; } }catch(e){} }, true);
  }catch(e){}

  /* settings: Session pace + Session Log (pause menu and the in-game settings card) */
  function paceRow(cls){
    return '<div class="' + (cls || "settings-row") + '" data-clpace-row="1"><div><div class="settings-label">Session pace</div><div class="settings-desc">Committees, party meetings and debates. Slow gives time to read every line.</div></div><div class="settings-value">' +
      ["slow", "normal", "fast"].map(k => '<button type="button" class="settings-btn ' + (CL.pace === k ? "settings-btn-primary" : "settings-btn-secondary") + '" data-clpace="' + k + '">' + k[0].toUpperCase() + k.slice(1) + '</button>').join("") +
      ' <button type="button" class="settings-btn settings-btn-secondary" data-cllog="1">Session Log</button></div></div>';
  }
  function bindPace(root){
    root.querySelectorAll("[data-clpace]").forEach(b => b.addEventListener("click", () => { CL.pace = b.getAttribute("data-clpace"); LS("pace", CL.pace);
      root.querySelectorAll("[data-clpace]").forEach(x => { x.className = "settings-btn " + (x.getAttribute("data-clpace") === CL.pace ? "settings-btn-primary" : "settings-btn-secondary"); }); paintTx(); }));
    root.querySelectorAll("[data-cllog]").forEach(b => b.addEventListener("click", () => openLog("sessions")));
  }
  function paceIntoPause(){
    try{
      const sec = document.querySelector('#pauseOverlay [data-section="game"]');
      if(sec && !sec.querySelector("[data-clpace-row]")){
        const w = document.createElement("div"); w.innerHTML = paceRow();
        const row = w.firstChild; const first = sec.querySelector(".settings-row");
        if(first) sec.insertBefore(row, first); else sec.appendChild(row); bindPace(row);
      }
    }catch(e){}
  }
  paceIntoPause();
  wrap("setupSettingsUI", () => setupSettingsUI, f => { setupSettingsUI = f; }, orig => function(){ const r = orig.apply(this, arguments); paceIntoPause(); return r; });
  CL.debug = () => ({on:PROC.on, phase:PROC.phase, t:PROC.t, i:PROC.i, n:PROC.order.length, running:G.running, speed:G.speed, log:PROC.log.length, paused:CL.paused, hold:CL.hold});
  wrap("settingsCard", () => settingsCard, f => { settingsCard = f; }, orig => function(){
    const r = orig.apply(this, arguments);
    try{ const mk = card.querySelector(".mk"); if(mk && !mk.querySelector("[data-clpace-row]")){ const w = document.createElement("div"); w.innerHTML = paceRow("mk__row"); mk.appendChild(w.firstChild); bindPace(mk); } }catch(e){}
    return r;
  });
  setInterval(() => { try{ if(!PROC.on && el("clTx") && !el("clTx").hidden) paintTx(); }catch(e){} }, 1000);
  /* ── universal name cards: hover or tap any name link (people, parties, states, committees) ── */
  function stDef(n){ try{ return STATE_DEF.find(s => s.n === n) || null; }catch(e){ return null; } }
  function regionOf(n){
    const s = stDef(n); if(!s) return "";
    let cMax = 0, rMax = 0; STATE_DEF.forEach(x => { cMax = Math.max(cMax, x.col); rMax = Math.max(rMax, x.row); });
    const ns = s.row <= rMax / 3 ? "North" : s.row >= rMax * 2 / 3 ? "South" : "Central", ew = s.col <= cMax / 3 ? "west" : s.col >= cMax * 2 / 3 ? "east" : "";
    return ns + (ew ? "-" + ew : "") + (s.cult ? " · " + s.cult.charAt(0).toUpperCase() + s.cult.slice(1) + " country" : "");
  }
  function locator(n){
    try{
      const s = stDef(n); if(!s) return "";
      const k = 9;
      return '<svg width="120" height="80" viewBox="-2 -2 ' + (Math.max(...STATE_DEF.map(x => x.col)) * k + k + 4) + ' ' + (Math.max(...STATE_DEF.map(x => x.row)) * k + k + 4) + '" style="float:right;margin:0 0 4px 8px;background:#efe8d6;border-radius:4px">' +
        STATE_DEF.map(x => '<rect x="' + x.col * k + '" y="' + x.row * k + '" width="' + (k - 1) + '" height="' + (k - 1) + '" fill="' + (x.n === n ? "#b0473c" : "#c9bfa6") + '"><title>' + esc(x.n) + '</title></rect>').join("") + '</svg>';
    }catch(e){ return ""; }
  }
  function rel(m){ try{ const w = Math.round(m.rel.warmth), t = Math.round(m.rel.trust); return (w > 40 ? "Close ally" : w > 15 ? "Friendly" : w < -40 ? "Enemy" : w < -15 ? "Cool toward you" : "Neutral") + " (warmth " + w + ", trust " + t + ")"; }catch(e){ return "—"; } }
  function stance(m){ const b = billNow(); if(!b) return "No bill on the paper"; try{ const v = memberVote(m, b); return b.title + ": " + (v > 0 ? "leaning AYE" : v < 0 ? "leaning NO" : "undecided") + (m.pledge ? " (pledged to you)" : ""); }catch(e){ return "—"; } }
  function wants(m){ try{ return (m.intent && m.intent.t) || m.need || m.hope || "—"; }catch(e){ return "—"; } }
  function sumRow(k, v){ return '<div style="display:flex;gap:6px;font:12px/1.35 system-ui;margin:1px 0"><b style="min-width:92px;color:#6a5f46">' + k + '</b><span>' + v + '</span></div>'; }
  function nameSummary(kind, key){
    try{
      if(kind === "who"){
        const m = byId(isNaN(+key) ? key : +key); if(!m || m === G.you) return "";
        if(m.kind && m.kind !== "member") return '<div class="cl-sum">' + sumRow("Who", esc(m.role || m.kind)) + sumRow("Relationship", rel(m)) + sumRow("Wants", esc(wants(m))) + '</div>';
        const cm = (() => { try{ return (COMMITTEES.filter(c => (m.committees || []).includes(c.k) || m.committee === c.k).map(c => c.t).join(", ")); }catch(e){ return ""; } })();
        return '<div class="cl-sum">' + locator(m.state) + sumRow("Party", esc(partyLabel(m.party))) + sumRow("Home", esc(m.state) + " " + esc(m.dist) + (regionOf(m.state) ? " — " + esc(regionOf(m.state)) : "")) +
          sumRow("Role / seat", esc((m.post ? postTitle(m.post) + ", " : "") + "Member for " + m.state + " " + m.dist + (cm ? "; " + cm : ""))) +
          sumRow("On your bill", esc(stance(m))) + sumRow("With you", esc(rel(m))) + sumRow("What they want", esc(wants(m))) + '<div style="clear:both"></div></div>';
      }
      if(kind === "state"){
        const s = stDef(key); if(!s) return "";
        const ms = (G.members || []).filter(m => !m.gone && m.state === key && m.kind !== "press" && m.kind !== "civ");
        const b = billNow(); const ay = b ? ms.filter(m => { try{ return memberVote(m, b) > 0; }catch(e){ return false; } }).length : 0;
        const st = (G.states || []).find(x => x.n === key);
        return '<div class="cl-sum">' + locator(key) + sumRow("What", "A state of the Republic, " + s.seats + " seats") + sumRow("Region", esc(regionOf(key))) +
          sumRow("Delegation", ms.length + " members you know of" + (ms.length ? " (" + esc([...new Set(ms.map(m => partyLabel(m.party)))].join(", ")) + ")" : "")) +
          (b ? sumRow("On your bill", ay + " of " + ms.length + " leaning aye") : "") + sumRow("With you", key === (G.you && G.you.state) ? "Your home state" : "—") +
          sumRow("What it wants", esc(st && st.unrest > 55 ? "Relief: unrest is at " + Math.round(st.unrest) : s.note || "—")) + '<div style="clear:both"></div></div>';
      }
      if(kind === "party"){
        const ms = (G.members || []).filter(m => !m.gone && m.party === key);
        const b = billNow(); const ay = b ? ms.filter(m => { try{ return memberVote(m, b) > 0; }catch(e){ return false; } }).length : 0;
        let line = ""; try{ if(b){ const pl = partyLine(b)[key]; line = pl > 0 ? "Whipped AYE" : pl < 0 ? "Whipped NO" : "Free vote"; } }catch(e){}
        return '<div class="cl-sum">' + sumRow("What", "A party (faction) in the House") + sumRow("Seats", esc(G.seatsBy && G.seatsBy[key] != null ? G.seatsBy[key] : ms.length)) +
          (b ? sumRow("On your bill", esc((line ? line + "; " : "") + ay + " of " + ms.length + " leaning aye")) : "") +
          sumRow("With you", G.you && G.you.party === key ? "Your party — the whip expects your vote" : "Another party") +
          sumRow("What it wants", esc((() => { try{ return partyLore(key).creed; }catch(e){ return "—"; } })())) + '</div>';
      }
    }catch(e){}
    return "";
  }
  wrap("tipHTML", () => tipHTML, f => { tipHTML = f; }, orig => function(kind, key){
    if(kind === "committee"){
      try{ const c = COMMITTEES.find(x => x.k === key || x.t === key); if(c){ const ms = (G.members || []).filter(m => !m.gone && ((m.committees || []).includes(c.k) || m.committee === c.k));
        return '<div class="tip__t">' + esc(c.t) + ' Committee</div><div class="cl-sum">' + sumRow("What", "A standing committee: it holds hearings and marks up bills in its field before the floor sees them") +
          sumRow("Field", esc({econ:"Money, tax and trade", lib:"Courts, rights and policing", def:"Defence and the services", wel:"Welfare, health and schools"}[c.axis] || c.axis)) +
          sumRow("Members", ms.length ? ms.slice(0, 8).map(m => tipName(m)).join(", ") : "—") + sumRow("With you", "Hearings here are where you can press witnesses and shape the bill") + '</div>'; } }catch(e){}
    }
    const base = orig.apply(this, arguments);
    const s = nameSummary(kind, key);
    if(!s) return base;
    const i = base.indexOf("</div>", base.indexOf("tip__s") > 0 ? base.indexOf("tip__s") : 0);
    return i > 0 ? base.slice(0, i + 6) + s + base.slice(i + 6) : s + base;
  });
  /* hover opens the same card (tap/click already does) */
  let hovT = 0, hovEl = null;
  document.addEventListener("mouseover", ev => {
    try{
      const t = ev.target && ev.target.closest ? ev.target.closest("[data-tipk]") : null;
      if(!t || t === hovEl) return; hovEl = t; clearTimeout(hovT);
      hovT = setTimeout(() => { try{ if(hovEl === t && t.matches(":hover")) openTip(t.getAttribute("data-tipk"), t.getAttribute("data-tipv")); }catch(e){} }, 380);
    }catch(e){}
  });
  document.addEventListener("mouseout", ev => { try{ if(hovEl && ev.target && ev.target.closest && ev.target.closest("[data-tipk]") === hovEl) hovEl = null; }catch(e){} });
  /* make names in plain text clickable: transcripts, notices, explainer, mail and Wire text we render */
  function linkify(html){
    try{
      const pats = [];
      (G.members || []).forEach(m => { if(!m.gone && m.name && m !== G.you) pats.push([m.name, tipAttr("who", m.id)]); });
      (STATE_DEF || []).forEach(s => pats.push([s.n, tipAttr("state", s.n)]));
      try{ partyKeys().forEach(k => pats.push([partyLabel(k), tipAttr("party", k)])); }catch(e){}
      (COMMITTEES || []).forEach(c => pats.push([c.t, tipAttr("committee", c.k)]));
      pats.sort((a, b) => b[0].length - a[0].length);
      const done = {};
      return html.replace(/(<[^>]+>)|([^<]+)/g, (all, tag, txt) => {
        if(tag) return tag;
        pats.forEach(([n, a]) => { if(done[n] > 3) return; const ix = txt.indexOf(n); if(ix < 0) return; done[n] = (done[n] || 0) + 1;
          txt = txt.split(n).join("\u0001" + pats.indexOf(pats.find(p => p[0] === n)) + "\u0002"); });
        return txt.replace(/\u0001(\d+)\u0002/g, (_, i) => '<span' + pats[+i][1] + '>' + pats[+i][0] + '</span>');
      });
    }catch(e){ return html; }
  }
  CL.linkify = linkify;
  /* speakers in the transcript are surnames: link them to the member */
  function whoLink(who){ try{ const base = String(who).replace(/ \(chair\)$/, ""); const m = speakerOf(base) || (G.members || []).find(x => !x.gone && surname(x.name) === base); return m ? '<span' + tipAttr("who", m.id) + '>' + esc(who) + '</span>' : esc(who); }catch(e){ return esc(who); } }
  CL.whoLink = whoLink;
  /* the Wire, mail and panels: decorate names in any text node that appears there */
  /* Wire, mail, panes, dialogue, prompts and choices: names become quiet links (no restyling) */
  const LINK_ROOTS = ["#wire", "#paneFloor", "#paneMembers", "#paneInbox", "#paneVox", "#paneBook", "#paneJournal", "#paneRisks", "#talk", "#card", "#procBar", "#procLog"];
  function subtle(h){ return h.replace(/ class="tipword"/g, ' class="cl-nl"'); }
  function linkNode(root){
    try{
      if(!root || root._clLinking) return; root._clLinking = true;
      const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null), nodes = [];
      while(w.nextNode()){ const n = w.currentNode; if(n.parentElement && !n.parentElement.closest("[data-tipk],input,textarea,select,script,style,.cl-card,#clPanel") && n.nodeValue.trim().length > 3){ const bt = n.parentElement.closest("button,[data-join],[role=button]"); if(bt && bt.textContent.trim().length < 48) continue; nodes.push(n); } }
      nodes.slice(0, 300).forEach(n => { const e0 = esc(n.nodeValue), h = linkify(e0); if(h !== e0){ const s = document.createElement("span"); s.style.cssText = "all:inherit;display:inline"; s.innerHTML = subtle(h); n.parentNode.replaceChild(s, n); } });
    }catch(e){} finally { if(root) setTimeout(() => { root._clLinking = false; }, 0); }
  }
  const pend = new Set(); let pendT = 0;
  function queue(r){ pend.add(r); if(!pendT) pendT = setTimeout(() => { pendT = 0; pend.forEach(x => linkNode(x)); pend.clear(); }, 150); }
  function observeRoots(){ LINK_ROOTS.forEach(sel => { const r = document.querySelector(sel); if(r && !r._clObs){ r._clObs = true; try{ new MutationObserver(() => { if(!r._clLinking) queue(r); }).observe(r, {childList:true, subtree:true, characterData:true}); }catch(e){} queue(r); } }); }
  observeRoots(); setInterval(observeRoots, 4000);
  /* a name inside a choice button opens its card and does NOT pick the choice */
  const nlHit = ev => { const t = ev.target && ev.target.closest ? ev.target.closest(".cl-nl[data-tipk]") : null; if(!t) return null; ev.preventDefault(); ev.stopPropagation(); if(ev.stopImmediatePropagation) ev.stopImmediatePropagation(); return t; };
  window.addEventListener("click", ev => { const t = nlHit(ev); if(t) try{ openTip(t.getAttribute("data-tipk"), t.getAttribute("data-tipv")); }catch(e){} }, true);
  ["mousedown", "mouseup", "pointerdown", "pointerup", "touchend"].forEach(k => window.addEventListener(k, ev => { nlHit(ev); }, true));
  CL.linkNode = linkNode;
  /* ── INBOX: sections, Read all, scroll kept, side reading pane, cables with nuance and stacking ── */
  const REGIME = {reach:"grain monarchy (a king and a council of granaries)", horn:"merchant league (the ports elect a doge)", pale:"military regency", marches:"confederal republic of free towns", isles:"island thalassocracy", rift:"council of mountain clans"};
  const SECS = [["const","Constituents"],["party","Party and Whip"],["coll","Colleagues"],["cmte","Committees"],["lobby","Lobby and Interest Groups"],["press","Press"],["cable","Foreign Cables"],["staff","Staff and Admin"]];
  CL.inboxOpen = LS("inboxOpen") || {}; CL.mailSel = null;
  function mailSec(x){
    try{
      if(x.kind === "cable") return "cable"; if(x.kind === "intel") return "staff";
      const m = x.fromId != null ? byId(x.fromId) : null, s = (x.subject + " " + x.from).toLowerCase();
      if(x.kind === "press" || (m && m.kind === "press") || /press|gazette|herald|courier|editor/.test(s)) return "press";
      if(/lobby|donor|association|guild|union|council|bureau|chamber of/.test(s) || (m && m.kind === "lobby")) return "lobby";
      if(x.kind === "witness" || /committee|hearing|markup|subpoena/.test(s)) return "cmte";
      if(x.kind === "fan" || (m && m.kind === "civ") || /constituent|district|town|county|widow|resident/.test(s)) return "const";
      if(m && (m.post === "whip" || m.post === "leader" || /whip/.test(s)) || x.kind === "vote" || /party|caucus|whip/.test(s)) return "party";
      if(m) return "coll";
      return "staff";
    }catch(e){ return "staff"; }
  }
  function realmOf(x){ try{ realmEnsure(); return (G.realms || []).find(r => x.from === "Mission of " + r.t || x.subject === "Cable — " + r.t) || null; }catch(e){ return null; } }
  function cableCtx(x){
    const r = realmOf(x); if(!r) return null;
    const you = G.you || {}, b = billNow();
    const rel = (G.clRealm = G.clRealm || {})[r.k] || 0;
    const motive = b ? "They are watching " + b.title + ": " + r.adj.toLowerCase() + " interests want " + r.want + ", and any vote that touches trade, money or the services moves that." : "They want " + r.want + ", and are sounding out which members of this House will listen.";
    let dist = "Little direct effect on " + (you.state || "your district") + ".";
    try{ const sd = stDef(you.state); if(sd){ if(/dock|port|ship|harbour|coast|bank/i.test(sd.note)) dist = "Your state trades by sea: " + r.t + "'s ports and tariffs reach your docks and jobs."; else if(/mill|farm|grain|orchard|market/i.test(sd.note)) dist = "Your farms and mills sell into the same markets " + r.t + " fights over."; } }catch(e){}
    return {r, regime:REGIME[r.k] || "foreign government", motive, dist, cmte:"Matters for the Foreign and Armed Services committees; bring it up in a hearing to put it on record.", rel};
  }
  const CABLE_ACTS = [
    {k:"ack", t:"Acknowledge politely", fx:"Relations +3 · influence +1 · costs a little time", run(c){ c.rel(3); infl(1); try{ spend(6, 1); }catch(e){} }},
    {k:"fwd", t:"Forward to committee and party", fx:"Influence +2 · whip notes you are useful · relations +1", run(c){ c.rel(1); infl(2); try{ const w = (G.members || []).find(m => !m.gone && m.post === "whip" && m.party === G.you.party); if(w) ripple(w, 2, "You sent me the cable before it reached the papers.", 2); }catch(e){} }},
    {k:"raise", t:"Raise it on the floor / with the press", fx:"Standing +3 · relations −4 (they wanted it private) · may make the Wire", run(c){ c.rel(-4); stand(3); try{ pushWireScrap("Foreign", "Member raises a cable from " + c.r.t + " in public."); }catch(e){} }},
    {k:"ign", t:"Ignore it", fx:"Relations −1 · no cost", run(c){ c.rel(-1); }}
  ];
  function infl(n){ try{ G.you.influence = clamp(G.you.influence + n, 0, 100); }catch(e){} }
  function stand(n){ try{ G.you.standing = clamp(G.you.standing + n, 0, 100); }catch(e){} }
  wrap("pushMail(cable)", () => pushMail, f => { pushMail = f; }, orig => function(from, subject, body, opts){
    try{
      if(opts && opts.kind === "cable"){
        const name = from ? from.name : "";
        const ex = G.mail.find(x => x.kind === "cable" && x.from === name && !x.answered);
        if(ex){
          ex.stack = (ex.stack || 1) + 1;
          ex.body = String(body) + "\n\n— earlier (" + (ex.stack - 1) + ") —\n" + String(ex.body).split("\n\n— earlier")[0];
          ex.day = G.day; ex.at = hhmm(); if(ex.read){ ex.read = false; } ex.open = false;
          G.mail.splice(G.mail.indexOf(ex), 1); G.mail.unshift(ex);
          try{ refreshInbox(); }catch(e){}
          return;
        }
      }
    }catch(e){}
    return orig.apply(this, arguments);
  });
  function readOne(x){ if(!x || x.read || x.outgoing) return; x.read = true; }   /* same effect as opening it: marks read */
  function answer(x, i){
    if(!x || x.answered) return; const opt = x.options && x.options[i]; if(!opt) return;
    x.answered = true; x.read = true; try{ spend(12, 3); }catch(e){}
    try{ if(opt.run) opt.run(); }catch(e){}
    try{ note("Answered " + x.from + ": “" + opt.t + "”."); }catch(e){}
  }
  function cableAct(x, k){
    const c = cableCtx(x); const a = CABLE_ACTS.find(y => y.k === k); if(!c || !a || x.answered) return;
    c.rel = n => { G.clRealm = G.clRealm || {}; G.clRealm[c.r.k] = clamp((G.clRealm[c.r.k] || 0) + n, -50, 50); };
    x.answered = true; x.read = true; x.clDone = a.t; a.run(c);
    try{ note("Cable from " + c.r.t + ": " + a.t.toLowerCase() + "."); }catch(e){}
    const it = CL.items.find(y => y.mail === x); if(it){ it.handled = true; it.outcome = a.t; }
  }
  function mailPane(x){
    if(!x) return '<p class="muted" style="margin:10px 0">Select a message to read it here. The list stays where you left it.</p>';
    const c = x.kind === "cable" ? cableCtx(x) : null;
    let h = '<div class="eyebrow">' + esc(x.from) + (x.stack > 1 ? ' · ×' + x.stack + ' cables' : '') + ' · d' + x.day + ' ' + esc(x.at) + '</div><h3 style="margin:4px 0">' + esc(x.subject) + '</h3>';
    if(c) h += '<div class="cl-sum">' + sumRow("Sender", esc(c.r.t) + " — " + esc(c.regime) + " · capital " + esc(c.r.capital)) + sumRow("Why they wrote", esc(c.motive)) + sumRow("Your district", esc(c.dist)) + sumRow("Committees", esc(c.cmte)) + sumRow("Relations", (c.rel > 0 ? "+" : "") + c.rel) + '</div>';
    h += '<div class="mailrow__b" style="white-space:pre-wrap">' + esc(x.body) + '</div>';
    if(c && !x.answered) h += '<div class="mailrow__acts">' + CABLE_ACTS.map(a => '<button class="conc__btn" style="width:auto" data-clcab="' + x.id + ':' + a.k + '" title="' + esc(a.fx) + '">' + esc(a.t) + '</button><div class="muted" style="font-size:11px;margin:0 0 4px">' + esc(a.fx) + '</div>').join("") + '</div>';
    else if(x.options && !x.answered) h += '<div class="mailrow__acts">' + x.options.map((o, i) => '<button class="conc__btn" style="width:auto" data-clans="' + x.id + ':' + i + '" data-ans="' + x.id + ':' + i + '">' + esc(o.t) + '</button><div class="muted" style="font-size:11px;margin:0 0 4px">' + esc(fnFx(o.run)) + '</div>').join("") + '</div>';
    else if(x.answered) h += '<div class="mailrow__acts"><span class="muted">Handled ✓' + (x.clDone ? " — " + esc(x.clDone) : "") + '</span></div>';
    h += '<p><button type="button" class="cl-btn" data-clwhatmail="' + x.id + '">What\'s this?</button></p>';
    return h;
  }
  function scrollers(n){ const a = []; for(let p = n; p && a.length < 5; p = p.parentElement) a.push([p, p.scrollTop]); return a; }
  function renderInbox(P, again){
      const keep = scrollers(P), listEl = P.querySelector(".cl-ibl"), lsT = listEl ? listEl.scrollTop : 0;
      const n = unreadCount(); const tab = el("tabInbox"); if(tab) tab.innerHTML = "Inbox" + (n ? '<span class="badge">' + n + '</span>' : "");
      const groups = {}; G.mail.forEach(x => { (groups[mailSec(x)] = groups[mailSec(x)] || []).push(x); });
      const sel = G.mail.find(x => x.id === CL.mailSel) || null;
      let h = '<div class="eyebrow">Inbox · ' + n + ' unread <button type="button" class="cl-btn" data-clreadall="*">Read all</button></div>' +
        '<div class="cl-ib"><div class="cl-ibl">';
      SECS.forEach(([k, t]) => {
        const g = groups[k]; if(!g || !g.length) return;
        const u = g.filter(x => !x.read && !x.outgoing).length, open = CL.inboxOpen[k] !== false;
        h += '<div class="cl-sec"><div class="cl-sech" data-clsec="' + k + '">' + (open ? "▾ " : "▸ ") + t + ' <span class="muted">(' + g.length + ')</span>' + (u ? ' <span class="badge">' + u + '</span> <button type="button" class="cl-btn" data-clreadall="' + k + '">Read all</button>' : '') + '</div>';
        if(open) h += g.map(x => '<div class="mailrow' + (x.read || x.outgoing ? "" : " is-unread") + (sel === x ? " cl-sel" : "") + '" data-clmail="' + x.id + '"><div class="mailrow__h"><span class="mailrow__f">' + (x.read || x.outgoing ? "" : '<span class="dotmark"></span>') + (x.outgoing ? "→ " : "") + esc(x.from) + (x.stack > 1 ? ' ×' + x.stack : '') + '</span><span class="mailrow__d">' + (x.answered ? "✓ " : x.read ? "Read · " : "") + 'd' + x.day + ' · ' + esc(x.at) + '</span></div><div class="mailrow__s">' + esc(x.subject) + '</div></div>').join("");
        h += '</div>';
      });
      h += '</div><div class="cl-ibp">' + mailPane(sel) + '</div></div>';
      P.innerHTML = h;
      const L2 = P.querySelector(".cl-ibl"); if(L2) L2.scrollTop = lsT;
      keep.forEach(([e, t]) => { e.scrollTop = t; });
      P.querySelectorAll("[data-clsec]").forEach(d => d.addEventListener("click", ev => { if(ev.target.closest("[data-clreadall]")) return; const k = d.getAttribute("data-clsec"); CL.inboxOpen[k] = CL.inboxOpen[k] === false; LS("inboxOpen", CL.inboxOpen); again(); }));
      P.querySelectorAll("[data-clreadall]").forEach(b => b.addEventListener("click", ev => { ev.stopPropagation(); const k = b.getAttribute("data-clreadall"); G.mail.filter(x => k === "*" || mailSec(x) === k).forEach(readOne); try{ refreshPanels(); }catch(e){} again(); }));
      P.querySelectorAll("[data-clmail]").forEach(r => r.addEventListener("click", ev => { if(ev.target.closest("[data-tipk]")) return; const x = G.mail.find(y => y.id === +r.getAttribute("data-clmail")); if(!x) return; CL.mailSel = x.id; readOne(x); x.open = true; again(); }));
      P.querySelectorAll("[data-clans]").forEach(b => b.addEventListener("click", ev => { ev.stopPropagation(); const [mid, oi] = b.getAttribute("data-clans").split(":"); answer(G.mail.find(x => x.id === +mid), +oi); try{ refreshPanels(); }catch(e){} again(); }));
      P.querySelectorAll("[data-clcab]").forEach(b => b.addEventListener("click", ev => { ev.stopPropagation(); const [mid, k] = b.getAttribute("data-clcab").split(":"); cableAct(G.mail.find(x => x.id === +mid), k); try{ refreshPanels(); }catch(e){} again(); }));
      P.querySelectorAll("[data-clwhatmail]").forEach(b => b.addEventListener("click", () => { const x = G.mail.find(y => y.id === +b.getAttribute("data-clwhatmail")); let it = CL.items.find(y => y.mail === x); if(!it && x) it = {k:"mail-" + x.kind, kind:"mail", title:"Mail · " + x.from, text:x.subject + " — " + String(x.body).slice(0, 200), mail:x, at:"d" + x.day + " " + x.at, urg:"low"}; openExplain(it); }));
  }
  wrap("refreshInbox", () => refreshInbox, f => { refreshInbox = f; }, orig => function(){
    const P = el("paneInbox");
    try{
      if(!G.mail.length || !P) return orig.apply(this, arguments);
      renderInbox(P, () => refreshInbox());
      try{ const Q = el("clPhoneInbox"); if(Q) renderInbox(Q, () => refreshInbox()); }catch(e){}
      return;
    }catch(e){ try{ console.warn("NEPTUNE-CLARITY inbox", e); }catch(e2){} return orig.apply(this, arguments); }
  });
  /* the phone's Mail tab uses the same sectioned inbox, re-rendered in place so it never jumps to the top */
  wrap("phoneMailHtml", () => phoneMailHtml, f => { phoneMailHtml = f; }, orig => function(){ try{ if(G.mail && G.mail.length) return '<div id="clPhoneInbox" class="phone__scroll"></div>'; }catch(e){} return orig.apply(this, arguments); });
  wrap("phoneCard", () => phoneCard, f => { phoneCard = f; }, orig => function(){
    const r = orig.apply(this, arguments);
    try{ const Q = el("clPhoneInbox"); if(Q){ const again = () => { try{ renderInbox(Q, again); const t = el("tabInbox"); if(t){ const n = unreadCount(); t.innerHTML = "Inbox" + (n ? '<span class="badge">' + n + '</span>' : ""); } }catch(e){} }; again(); } }catch(e){}
    return r;
  });
  /* code elsewhere clicks [data-ans="id:i"] inside the inbox; keep that working */
  CL.testMail = () => { try{ realmEnsure(); const r = G.realms[0]; for(let i = 0; i < 3; i++){ r._cableT = -1e9; realmCable(r); } r2 = G.realms[1]; r2._cableT = -1e9; realmCable(r2);
    const ms = G.members.filter(m => !m.gone && m.kind === "member"); pushMail(ms[0], "A word about the other day", "I would rather say it in writing.", {kind:"grievance", options:[{t:"Apologise properly", run(){ ripple(ms[0], 11, "You wrote back.", 7, true); }},{t:"Leave it unanswered", run(){ ripple(ms[0], -6, "You never replied.", -8, true); }}]});
    pushMail(null, "Your letter came back unopened", "The office of " + ms[1].name + " returned your letter unopened."); pushMail(ms[2], "Whip notice: caucus at ten", "Attendance expected.", {kind:"vote"}); }catch(e){ console.warn("testMail", e); } };
  var r2;
  MAILK.cable = "A diplomatic cable from a foreign power. It tells you what they want and who in this House they are courting. You can acknowledge it, pass it to your committee and party, make it public, or ignore it — each moves your influence, standing or relations with them.";
  /* ── UNION MAP: click a state or town → action panel (diplomacy, interference, espionage, support) ── */
  G.clOps = G.clOps || []; G.clState = G.clState || {};
  function seeded(str){ let h = 2166136261; str = String(str); for(let i = 0; i < str.length; i++){ h ^= str.charCodeAt(i); h = Math.imul(h, 16777619); } return ((h >>> 0) % 10000) / 10000; }
  function stRel(n){ G.clState = G.clState || {}; return G.clState[n] || (G.clState[n] = {rel:0, informant:false, dirt:0, pact:0}); }
  function isGov(){ try{ return G.you.office === "gov" || G.you.post === "governor" || /governor/i.test(G.you.title || ""); }catch(e){ return false; } }
  function del(n){ try{ return stateDelegation(n).filter(m => !m.gone); }catch(e){ return []; } }
  function warmDel(n, d, why){ del(n).slice(0, 6).forEach(m => { try{ ripple(m, d, why, Math.sign(d) * 2); }catch(e){} }); }
  /* A: action defs. inf = influence cost, risk = exposure chance (0..1) before modifiers, days = when it resolves */
  const UA = [
    {g:"Diplomacy", k:"neg", t:"Negotiate", inf:3, risk:0, days:0, need:() => true, fx:"Relations +4, delegation warmer. Costs 3 influence and an hour.", run(n, s){ stRel(n).rel += 4; warmDel(n, 3, "You came to us instead of going round us."); }},
    {g:"Diplomacy", k:"coop", t:"Cooperate on a shared problem", inf:4, risk:0, days:0, need:() => true, fx:"Its unrest −3, relations +3.", run(n, s){ s.unrest = clamp(s.unrest - 3, 0, 100); stRel(n).rel += 3; }},
    {g:"Diplomacy", k:"pact", t:"Form a joint pact", inf:8, risk:0, days:0, need:n => stRel(n).rel >= 6 || n === G.you.state, why:"Needs relations ≥ 6 (negotiate first)", fx:"Pact for 10 days: relations +6, its delegation leans your way on the floor; breaking it later costs standing.", run(n, s){ const r = stRel(n); r.pact = G.day + 10; r.rel += 6; warmDel(n, 5, "We have a pact with your office."); }},
    {g:"Diplomacy", k:"fav", t:"Trade favours", inf:5, risk:0.05, days:0, need:() => true, fx:"Influence back over days (+1/day ×4) and relations +2; a favour owed is a favour remembered.", run(n){ stRel(n).rel += 2; G.clOps.push({k:"favret", st:n, due:G.day + 1, left:4}); }},
    {g:"Interfere with its bills", k:"lobby", t:"Lobby against its bill", inf:6, risk:0.08, days:0, need:(n, s) => !!s.bill, why:"Nothing before its statehouse", fx:"Uses the existing statehouse push (−). Relations −2.", run(n, s){ G.you.influence += 6; pushStateBill(s, -1); stRel(n).rel -= 2; }},
    {g:"Interfere with its bills", k:"fund", t:"Fund the opposition", inf:4, cash:true, risk:0.18, days:2, need:(n, s) => !!s.bill, why:"Nothing before its statehouse", fx:"Costs 4 influence and funds; the bill loses ground over 2 days. 18% chance it is traced to you (scandal)."},
    {g:"Interfere with its bills", k:"rally", t:"Rally its delegation", inf:5, risk:0, days:0, need:n => del(n).length > 0, why:"You know nobody in its delegation", fx:"Delegation warmth +4; they are likelier to vote with you on the federal bill.", run(n){ warmDel(n, 4, "You took the time to work our delegation."); }},
    {g:"Interfere with its bills", k:"leak", t:"Leak to its press", inf:3, risk:0.25, days:1, need:() => true, fx:"Its unrest +4, its bill weakens; 25% chance the leak is traced (standing −4, relations −6)."},
    {g:"Inner workings & espionage", k:"inform", t:"Plant an informant", inf:6, risk:0.15, days:2, need:() => true, fx:"Ongoing: cuts the risk of every later operation here by a third and sends you reports. 15% exposure."},
    {g:"Inner workings & espionage", k:"dirt", t:"Gather dirt on officials", inf:5, risk:0.2, days:3, need:() => true, fx:"Finds a compromising fact (kept for smear or turning). 20% exposure."},
    {g:"Inner workings & espionage", k:"icept", t:"Intercept its cables", inf:5, risk:0.22, days:2, need:() => isGov() || G.you.influence >= 30 || stRel_(), why:"Governor, or influence ≥ 30", fx:"You get its private correspondence as mail: who it is courting, what it will trade. 22% exposure."},
    {g:"Inner workings & espionage", k:"sab", t:"Sabotage or delay its bill", inf:7, risk:0.3, days:2, need:(n, s) => !!s.bill, why:"Nothing before its statehouse", fx:"Pushes its bill's vote back 2–4 days and weakens it. 30% exposure (standing −6, scandal)."},
    {g:"Inner workings & espionage", k:"smear", t:"Run a covert smear", inf:6, risk:0.32, days:3, need:n => stRel(n).dirt > 0 || del(n).length > 0, why:"Need dirt or a known official", fx:"A delegation member loses standing and warmth toward your enemies; uses your dirt if you have it (lower risk). 32% exposure."},
    {g:"Inner workings & espionage", k:"turn", t:"Turn an official", inf:10, risk:0.28, days:4, need:n => stRel(n).dirt > 0 && del(n).length > 0, why:"Need dirt and a known official", fx:"One of its members becomes quietly yours: big warmth, a pledge on the bill. 28% exposure, worse if it fails."},
    {g:"Support its bills", k:"sup", t:"Support its bill", inf:6, risk:0, days:0, need:(n, s) => !!s.bill, why:"Nothing before its statehouse", fx:"Uses the existing statehouse push (+). Relations +3.", run(n, s){ G.you.influence += 6; pushStateBill(s, 1); stRel(n).rel += 3; }}
  ];
  function stRel_(){ return false; }
  function riskOf(a, n){ let r = a.risk; const R = stRel(n); if(R.informant) r *= 0.66; if(isGov()) r *= 0.85; if(a.k === "smear" && R.dirt > 0) r *= 0.7; return Math.round(r * 100); }
  function runUA(n, k, town){
    G.clOps = G.clOps || [];
    const s = stateOf(n), a = UA.find(x => x.k === k); if(!s || !a || !G.you) return;
    if(G.you.influence < a.inf || !a.need(n, s)) return;
    G.you.influence -= a.inf; try{ spend(a.days ? 45 : 60, a.days ? 10 : 8); }catch(e){}
    if(a.cash){ try{ G.you.funds = Math.max(0, (G.you.funds || 0) - 20); }catch(e){} }
    if(a.run) a.run(n, s);
    else { G.clOps.push({k, st:n, town:town || null, due:G.day + a.days, seed:G.day + ":" + n + ":" + k + ":" + G.clOps.length, risk:riskOf(a, n) / 100}); }
    try{ note((a.days ? "Set in motion in " + n + ": " : "In " + n + ": ") + a.t.toLowerCase() + (town ? " (" + town + ")" : "") + "." + (a.days ? " Results in about " + a.days + " day" + (a.days > 1 ? "s" : "") + "." : "")); }catch(e){}
    try{ refreshPanels(); }catch(e){} try{ refreshUnion(); }catch(e){}
  }
  CL.unionAct = runUA;
  /* resolve operations day by day, seeded so results are stable for a given save */
  function resolveOps(){
    G.clOps = G.clOps || [];
    try{
      if(!G.clOps || !G.clOps.length || !G.you) return;
      const keep = [];
      G.clOps.forEach(o => {
        if(o.due > G.day){ keep.push(o); return; }
        const s = stateOf(o.st); const R = stRel(o.st); const ms = del(o.st);
        if(o.k === "favret"){ G.you.influence = clamp(G.you.influence + 1, 0, 100); if(--o.left > 0){ o.due = G.day + 1; keep.push(o); } return; }
        const roll = seeded(o.seed + ":x"), ok = seeded(o.seed + ":ok") < 0.55 + G.you.influence / 250 + R.rel / 100;
        const exposed = roll < o.risk;
        const target = ms.length ? ms[Math.floor(seeded(o.seed + ":t") * ms.length)] : null;
        let sub = "", body = "";
        if(exposed){
          G.you.standing = clamp(G.you.standing - (o.k === "turn" || o.k === "sab" ? 6 : 4), 0, 100); R.rel -= 6;
          try{ G.secrets = G.secrets || []; G.secrets.push({id:Date.now() + Math.floor(seeded(o.seed) * 999), t:"Your office ran a covert " + o.k + " operation in " + o.st + ".", about:0, knownBy:target ? [target.id] : [], exposure:6, day:G.day}); }catch(e){}
          try{ pushWireScrap("Wire", o.st + " statehouse alleges interference by a federal member's office."); }catch(e){}
          sub = "Exposed in " + o.st; body = "Your people were seen. " + o.st + " knows someone was working against it, and the trail is warm.\n\nStanding −, relations with " + o.st + " −6, and a secret is now in circulation (see Risks).";
        } else if(!ok){
          sub = "Nothing came of it in " + o.st; body = "The " + o.k + " operation in " + o.st + " found nothing usable. No one noticed. Influence spent.";
        } else {
          if(o.k === "inform"){ R.informant = true; sub = "Informant in place — " + o.st; body = "Someone inside the " + o.st + " statehouse now talks to your office. Future operations there are safer, and you will hear things first."; }
          if(o.k === "dirt"){ R.dirt++; sub = "A file on " + (target ? target.name : "an official in " + o.st); body = (target ? target.name : "An official") + " " + ["took a donor's holiday they never declared", "has a second phone their chief of staff pays for", "voted on a contract their brother bid for", "missed a session for a reason that was not illness"][Math.floor(seeded(o.seed + ":d") * 4)] + ".\n\nKept on file. Use it to smear or to turn."; }
          if(o.k === "icept"){ sub = "Intercepted: " + o.st + " correspondence"; body = "Their governor's office is courting " + (target ? target.name : "your whip") + " and will trade " + ["a highway grant", "its delegation's votes on the next bill", "silence on the floods", "a seat on a committee"][Math.floor(seeded(o.seed + ":i") * 4)] + " for support." + (s && s.bill ? "\n\nOn " + s.bill.title + " they think they have the votes by " + Math.max(1, s.bill.due - G.day) + " days." : ""); R.rel += 0; }
          if(o.k === "fund" || o.k === "leak"){ if(s && s.bill) s.bill.pushed = (s.bill.pushed || 0) - (o.k === "fund" ? 14 : 8); if(o.k === "leak" && s) s.unrest = clamp(s.unrest + 4, 0, 100); sub = (o.k === "fund" ? "Opposition funded" : "Leak ran") + " in " + o.st; body = s && s.bill ? s.bill.title + " has lost ground in the statehouse." : "It ran. People are talking."; }
          if(o.k === "sab"){ if(s && s.bill){ s.bill.due += 2 + Math.floor(seeded(o.seed + ":s") * 3); s.bill.pushed = (s.bill.pushed || 0) - 10; } sub = "Delay in " + o.st; body = "A procedural snag nobody can explain has pushed the vote back. It looks like an accident."; }
          if(o.k === "smear" && target){ try{ target.standing = clamp((target.standing || 50) - 6, 0, 100); }catch(e){} if(R.dirt > 0) R.dirt--; try{ pushWireScrap("Wire", target.name + " under questions at home."); }catch(e){} sub = "Smear landed: " + target.name; body = "The story about " + target.name + " is running in " + o.st + ". It did not come back to you — yet."; }
          if(o.k === "turn" && target){ try{ ripple(target, 18, "We have an understanding now, you and I.", 10, true); target.pledge = 1; target.pledgeDay = G.day; }catch(e){} R.dirt = Math.max(0, R.dirt - 1); sub = "An understanding with " + target.name; body = target.name + " will vote with you on the bill and keep you told. They also know what you know about them; that cuts both ways."; }
          if(!sub){ sub = "Done in " + o.st; body = "It went as planned."; }
        }
        try{ pushMail(null, sub, body, {kind:"intel"}); }catch(e){}
      });
      G.clOps = keep;
    }catch(e){ try{ console.warn("NEPTUNE-CLARITY ops", e); }catch(e2){} }
  }
  CL.resolveOps = resolveOps;
  let lastDay = null;
  setInterval(() => { try{ if(!G || G.day == null) return; if(lastDay !== null && G.day !== lastDay) resolveOps(); lastDay = G.day; }catch(e){} }, 1500);
  function unionPanel(n){
    G.clOps = G.clOps || [];
    const s = stateOf(n); if(!s || !G.you) return "";
    const R = stRel(n); let towns = [];
    try{ towns = (stateLore(n).towns || []).map(t => t.name); }catch(e){}
    const gov = isGov();
    let h = '<div class="billbox cl-union" style="margin-top:12px"><div class="eyebrow">Your options in ' + esc(n) + (CL.town ? ' · ' + esc(CL.town) : '') + '</div>' +
      nameSummary("state", n) + sumRow("Your role", gov ? "Governor (more reach in statehouses, lower exposure)" : "House member") + sumRow("Your influence", Math.round(G.you.influence)) +
      sumRow("Relations", (R.rel > 0 ? "+" : "") + R.rel + (R.pact > G.day ? " · pact until day " + R.pact : "") + (R.informant ? " · informant in place" : "") + (R.dirt ? " · " + R.dirt + " file(s) of dirt" : "")) +
      (towns.length ? '<div style="margin:6px 0;font:12px system-ui">Towns: ' + towns.map(t => '<button type="button" class="cl-btn" data-cltown="' + esc(t) + '"' + (CL.town === t ? ' style="background:#2f5d3a;color:#fff"' : '') + '>' + esc(t) + '</button>').join("") + '</div>' : '') +
      (G.clOps.filter(o => o.st === n && o.k !== "favret").length ? '<p class="muted">Under way: ' + G.clOps.filter(o => o.st === n && o.k !== "favret").map(o => esc(UA.find(a => a.k === o.k).t) + " (day " + o.due + ")").join(", ") + '</p>' : '');
    let grp = "";
    UA.forEach(a => {
      if(a.g !== grp){ grp = a.g; h += '<div class="cl-sech" style="cursor:default">' + esc(grp) + '</div>'; }
      const okNeed = a.need(n, s), okInf = G.you.influence >= a.inf, rk = riskOf(a, n);
      h += '<div style="display:flex;gap:6px;align-items:flex-start;margin:3px 0"><button type="button" class="conc__btn" style="width:auto;flex:0 0 auto" data-clua="' + a.k + '"' + (okNeed && okInf ? '' : ' disabled') + '>' + esc(a.t) + '</button>' +
        '<div style="font:11.5px/1.35 system-ui"><b>Cost</b> ' + a.inf + ' influence' + (a.cash ? ' + funds' : '') + ' · <b>Risk</b> ' + (rk ? rk + '% exposure' : 'none') + ' · <b>When</b> ' + (a.days ? "~" + a.days + " day(s)" : "now") + '<br>' + esc(a.fx) +
        (!okNeed ? '<br><i>Locked: ' + esc(a.why || "not available") + '</i>' : !okInf ? '<br><i>Locked: need ' + a.inf + ' influence</i>' : '') + '</div></div>';
    });
    return h + '</div>';
  }
  wrap("refreshUnion", () => refreshUnion, f => { refreshUnion = f; }, orig => function(){
    const P = el("paneUnion"), keep = P ? scrollers(P) : [];
    const r = orig.apply(this, arguments);
    try{
      if(P && G.mapSel){
        if(CL._unionSt !== G.mapSel){ CL.town = null; CL._unionSt = G.mapSel; }
        const box = P.querySelector(".billbox"); const d = document.createElement("div"); d.innerHTML = unionPanel(G.mapSel);
        if(box && box.parentNode) box.parentNode.insertBefore(d, box.nextSibling); else P.appendChild(d);
        d.querySelectorAll("[data-clua]").forEach(b => b.addEventListener("click", () => runUA(G.mapSel, b.getAttribute("data-clua"), CL.town)));
        d.querySelectorAll("[data-cltown]").forEach(b => b.addEventListener("click", () => { CL.town = b.getAttribute("data-cltown"); refreshUnion(); }));
        keep.forEach(([e, t]) => { e.scrollTop = t; });
      }
    }catch(e){ try{ console.warn("NEPTUNE-CLARITY union", e); }catch(e2){} }
    return r;
  });
  MAILK.intel = "A report from an operation you set in motion in another state. It may be a success, a dud, or news that you were caught. Check Risks if it says you were exposed.";
  console.log("NEPTUNE clarity ready");
}catch(e){ try{ console.warn("NEPTUNE-CLARITY block", e); }catch(e2){} }
/* NEPTUNE-CLARITY END */
armFrame();

})();
</script>


<style id="caFitCss">/* 20261117p NEPTUNE caFit: cabinet and brief prompts stay inside the viewport; long text scrolls; Aye/Nay and choice/close rows stay visible. Display only. */
#veil:not([hidden]){align-items:start!important;justify-items:center!important;padding:12px!important;overflow:auto!important}
#veil:not([hidden])#veil{inset:0!important;height:auto!important;max-height:none!important}
#veil:not([hidden]) #card{box-sizing:border-box!important;width:min(760px,calc(100vw - 24px))!important;max-height:calc(100vh - 24px)!important;max-height:calc(100dvh - 24px - var(--ca-bottom,56px))!important;margin-block:auto!important;overflow-x:hidden!important;overflow-y:auto!important;padding:16px 18px 12px!important;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
#veil:not([hidden]) #card h1{font-size:clamp(22px,3.6vw,32px)!important;margin:4px 0 8px!important;line-height:1.12!important}
#veil:not([hidden]) #card>p{margin:0 0 8px!important}
#veil:not([hidden]) #card>.card__actions:not(:last-of-type){position:static!important}
#veil:not([hidden]) #card>.card__actions:last-of-type,#veil:not([hidden]) #card.ca-fit-card>.card__actions:last-of-type,#veil:not([hidden]) #card .card__actions.ca-vote,#veil:not([hidden]) #card .fd-vote{position:sticky!important;bottom:0!important;z-index:6!important;background:var(--paper,#f6f1e6)!important;padding-top:8px!important;padding-bottom:2px!important;margin-top:8px!important;box-shadow:0 -10px 14px var(--paper,#f6f1e6)!important}
#veil:not([hidden]) #card .btn{min-height:40px}
#veil:not([hidden]) #card .sit__lines,#veil:not([hidden]) #card .sx-lines{max-height:min(36vh,calc(100dvh - 260px))!important;overflow-y:auto!important;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#veil:not([hidden]) #card.ca-fit-grid{display:grid!important;grid-template-columns:1fr 1fr;gap:8px 16px;align-content:start}
#veil:not([hidden]) #card.ca-fit-grid>.eyebrow,#veil:not([hidden]) #card.ca-fit-grid>h1,#veil:not([hidden]) #card.ca-fit-grid>h2,#veil:not([hidden]) #card.ca-fit-grid>p,#veil:not([hidden]) #card.ca-fit-grid>#gcSay,#veil:not([hidden]) #card.ca-fit-grid>.card__actions:last-of-type,#veil:not([hidden]) #card.ca-fit-grid>.sit__prog,#veil:not([hidden]) #card.ca-fit-grid>.sit__lines,#veil:not([hidden]) #card.ca-fit-grid>.ca-fit-span,#veil:not([hidden]) #card.ca-fit-grid>.fd-vote,#veil:not([hidden]) #card.ca-fit-grid>.card__actions.ca-vote{grid-column:1/-1}
@media (max-width:700px){#veil:not([hidden]) #card.ca-fit-grid{grid-template-columns:1fr}}
html.ca-modal #prompt.is-live,html.ca-modal #sxDock,html.ca-modal #apToast,html.ca-modal #brHint,html.ca-modal .notices,html.ca-modal #log,html.ca-modal #liveLog{display:none!important}
html.ca-sit #prompt.is-live,html.ca-sit #apToast,html.ca-sit #brHint,html.ca-sit .notices{display:none!important}
#veil.sitx,#veil.sitx #card{max-height:calc(100vh - 96px)!important;max-height:calc(100dvh - 96px)!important;overflow:auto!important}
#sxDock:not([hidden]){box-sizing:border-box!important;overflow-x:hidden!important;overflow-y:auto!important;display:flex!important;flex-direction:column!important;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
html.ca-sit #sxDock.fd-on:not([hidden]),#sxDock.fd-on:not([hidden]){flex-direction:row!important;align-items:stretch!important;max-height:max(220px,calc(100dvh - var(--ca-bottom,56px) - 12px))!important;min-height:220px!important;overflow:hidden!important;overflow-y:auto!important;top:auto!important;bottom:var(--fdB,var(--ca-bottom,56px))!important;left:8px!important;right:8px!important;width:auto!important}
#sxDock.fd-on:not([hidden])>*{max-height:none!important;min-height:0!important;overflow:auto!important}
#sxDock.fd-on:not([hidden])>#sxDockHead{max-width:150px;flex:none;overflow:auto!important}
#sxDock #ndSess,#sxDock #ndFd,#sxDock .ns-body,#sxDock .fd-log{min-height:0;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#sxDock .fd-acts,#sxDock .fd-vote,#sxDock .nsx-acts,#sxDock .card__actions,#ndFd .fd-acts,#ndFd .fd-vote,#ndFd .fd-send,#ndFd .fd-cancel,#ndSess .nsx-acts{position:sticky!important;bottom:0!important;z-index:5!important;flex:none!important;background:#121419}
#ndFd .fd-vote{display:flex!important;flex-wrap:wrap;gap:6px;align-items:center;margin:6px 0;flex:none!important}
#ndFd .fd-vote b{flex:1 1 100%;color:#ffe08a;font:700 11px system-ui;letter-spacing:.06em;text-transform:uppercase}
#ndFd .fd-vote button{min-height:44px;flex:1 1 88px;border-radius:10px;border:0;background:#2a2d35;color:#fff;font:700 13px system-ui;cursor:pointer;touch-action:manipulation}
#ndFd .fd-vote button.is-on{background:#c9a24a;color:#14120c}
#ndSess .g,#sxDock .g,#ndSess button,#sxDock button,#ndFd button{scroll-margin-bottom:8px}
#sxParkBar{right:8px!important;left:auto!important;width:max-content!important;min-width:96px!important;max-width:none!important;box-sizing:border-box!important;overflow:visible!important;z-index:10070!important}#sxParkBar button{flex:none!important}
/* While a talk is open, fold the HUD strips that cover choice buttons at ≤1366 (MARS S5). Do not hide #talk #chat (the transcript). Enter/Space picking is untouched. */
html.ca-talk #hmWire,html.ca-talk #onumSeeDock{display:none!important}
html.ca-talk #hmBar,html.ca-talk #hmSay,html.ca-talk #hmSayWrap,html.ca-talk #tick,html.ca-talk #tickRun,html.ca-talk #wire,html.ca-talk #wireHome{pointer-events:none!important;z-index:1!important;visibility:hidden!important}
#talk.is-open{position:fixed!important;left:8px!important;right:8px!important;bottom:0!important;top:auto!important;width:auto!important;max-height:calc(100dvh - 8px)!important;z-index:10060!important;pointer-events:auto!important;overflow:hidden!important;display:flex!important;flex-direction:column!important;min-height:0!important}
#talk.is-open #tkActs{position:relative!important;z-index:5!important;flex:1 1 auto!important;min-height:96px!important;max-height:min(48dvh,calc(100dvh - 220px))!important;overflow:auto!important}
#talk.is-open #tkActs button{position:relative!important;z-index:6!important;pointer-events:auto!important}
#cvLive{box-sizing:border-box!important;max-height:min(42vh,calc(100dvh - var(--ca-bottom,70px) - 12px))!important;overflow-x:hidden!important;overflow-y:auto!important}
#veil:not([hidden]) #card div .card__actions{position:sticky!important;bottom:0!important;z-index:6!important;background:var(--paper,#f6f1e6)!important;padding-top:8px!important;padding-bottom:2px!important;box-shadow:0 -10px 14px var(--paper,#f6f1e6)!important}
</style>
<script id="caFitJs">/* 20261117p NEPTUNE caFit: tag modal vs sitting surfaces so CSS can pin them; clear leftover inline caps; two-column brief cards. Display only. */
(function(){
  var OWN = ["max-height","min-height","height","top","bottom","left","right","width","overflow","overflow-y"];
  function vis(el){ return !!(el && !el.hidden && (el.getClientRects()||[]).length && getComputedStyle(el).display !== "none"); }
  function sittingOpen(){
    return vis(document.getElementById("sxDock")) || vis(document.getElementById("ndSess"));
  }
  function modalOpen(){
    var v = document.getElementById("veil");
    var c = document.getElementById("card");
    if(!v || v.hidden) return false;
    var st = window.getComputedStyle(v);
    if(st.position === "fixed" && st.display !== "none") return !!(c && (c.textContent||"").trim());
    return false;
  }
  function talkOpen(){
    var t = document.getElementById("talk");
    return !!(t && t.classList && t.classList.contains("is-open") && vis(t));
  }
  function clearOwn(el){
    if(!el || !el.getAttribute("data-cafit")) return;
    OWN.forEach(function(p){ try{ el.style.removeProperty(p); }catch(e){} });
    el.removeAttribute("data-cafit");
  }
  function setOwn(el, props){
    if(!el) return;
    el.setAttribute("data-cafit", "1");
    Object.keys(props).forEach(function(p){ el.style.setProperty(p, props[p], "important"); });
  }
  function tagGrid(card){
    if(!card) return;
    var sections = 0, kids = card.children;
    for(var i=0;i<kids.length;i++){
      var el = kids[i];
      var isSec = !!(el.matches && el.matches("div") && el.querySelector && el.querySelector(":scope .card__actions"));
      if(isSec){ sections++; if(el.classList) el.classList.remove("ca-fit-span"); }
      else if(el.classList) el.classList.add("ca-fit-span");
    }
    if(sections >= 3) card.classList.add("ca-fit-grid");
    else {
      card.classList.remove("ca-fit-grid");
      for(var j=0;j<kids.length;j++) if(kids[j].classList) kids[j].classList.remove("ca-fit-span");
    }
  }
  function band(){
    var top = 8, bottom = 8, vw = window.innerWidth || 0, vh = window.innerHeight || 0;
    var nodes = document.querySelectorAll("body > * , #hmBar, #hud, .hud, #sayBar, #composer, #hmWire");
    for(var i=0;i<nodes.length;i++){
      var el = nodes[i];
      if(!vis(el) || el.id === "veil" || el.id === "sxDock" || el.id === "prompt" || el.id === "card" || el.id === "talk") continue;
      var st = getComputedStyle(el);
      if(st.position !== "fixed" && st.position !== "sticky") continue;
      var r = el.getBoundingClientRect();
      if(r.width < 40 || r.height < 8 || r.height > vh * 0.45) continue;
      if(r.top <= 8 && r.bottom > top && r.bottom < vh * 0.4) top = Math.max(top, r.bottom + 8);
      if(r.bottom >= vh - 8 && r.top < vh - bottom && r.top > vh * 0.5) bottom = Math.max(bottom, vh - r.top + 8);
    }
    return {top:top, bottom:bottom, room:Math.max(160, vh - top - bottom)};
  }
  function placeSit(){
    var dock = document.getElementById("sxDock");
    var v = document.getElementById("veil");
    var card = document.getElementById("card");
    var b = band();
    if(dock && vis(dock)){
      var fd = dock.classList.contains("fd-on");
      setOwn(dock, {
        "max-height": Math.max(fd ? 220 : 160, b.room) + "px",
        "min-height": (fd ? 220 : 0) ? (fd ? "220px" : "") : "",
        "height": "auto",
        "top": "auto",
        "bottom": b.bottom + "px",
        "left": fd ? "8px" : "",
        "right": fd ? "8px" : "",
        "width": fd ? "auto" : "",
        "overflow": fd ? "hidden" : "auto",
        "overflow-y": "auto"
      });
      if(fd){ dock.style.setProperty("min-height", "220px", "important"); }
      else { try{ dock.style.removeProperty("min-height"); }catch(e){} }
      if(fd){
        var kids = dock.children;
        for(var i=0;i<kids.length;i++){
          try{ kids[i].style.setProperty("max-height", "none", "important"); }catch(e){}
        }
      }
    }
    if(v && !v.hidden && getComputedStyle(v).position !== "fixed" && card){
      var top = Math.max(b.top, Math.floor(v.getBoundingClientRect().top || b.top));
      var cap = Math.max(140, (window.innerHeight || 0) - top - b.bottom);
      setOwn(v, {"max-height": cap + "px", "overflow": "auto"});
      setOwn(card, {"max-height": cap + "px", "overflow": "auto", "overflow-y": "auto"});
    }
  }
  function parkBarOnScreen(){
    var bar = document.getElementById("sxParkBar");
    if(!bar || bar.style.display === "none") return;
    /* sxParkTick writes left = dock.right-66 (bar is wider than 66px with 44px hit targets), which can push ✕ off the right edge. Pin right and let the bar size to its buttons. */
    bar.style.setProperty("left", "auto", "important");
    bar.style.setProperty("right", "8px", "important");
    bar.style.setProperty("width", "max-content", "important");
    bar.style.setProperty("min-width", "96px", "important");
    bar.style.setProperty("max-width", "none", "important");
  }
  function boot(){
    var R = document.documentElement;
    var v = document.getElementById("veil");
    var card = document.getElementById("card");
    var dock = document.getElementById("sxDock");
    var modal = modalOpen();
    var talk = talkOpen();
    var sit = sittingOpen() && !modal;
    R.classList.toggle("ca-modal", modal);
    R.classList.toggle("ca-sit", sit);
    R.classList.toggle("ca-talk", talk);
    var b = band();
    R.style.setProperty("--ca-bottom", b.bottom + "px");
    if(modal){
      clearOwn(v); clearOwn(card); clearOwn(dock);
      if(v){ v.style.removeProperty("max-height"); v.style.removeProperty("height"); v.style.removeProperty("overflow"); }
      if(card){ card.style.removeProperty("max-height"); card.style.removeProperty("height"); card.style.removeProperty("overflow"); card.style.removeProperty("overflow-y"); }
    }
    if(card){
      card.classList.toggle("ca-fit-card", !!(v && !v.hidden));
      if(modal) tagGrid(card);
      else card.classList.remove("ca-fit-grid");
    }
    if(sit) placeSit();
    else if(!sit){ if(dock && !vis(dock)) clearOwn(dock); }
    parkBarOnScreen();
  }
  var q = 0;
  function kick(){ if(q) return; q = setTimeout(function(){ q = 0; try{ boot(); }catch(e){} }, 30); }
  if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot, {once:true});
  else boot();
  try{ new MutationObserver(kick).observe(document.documentElement, {subtree:true, childList:true, attributes:true, attributeFilter:["hidden","class","style"]}); }catch(e){}
  addEventListener("resize", kick);
  setInterval(boot, 400);
  setInterval(function(){ if(sittingOpen()) placeSit(); parkBarOnScreen(); }, 50);
})();
</script>
<style id="nrFitCss">/* 20261117t NEPTUNE: toolbar, District Ledger, and the foreign atlas stay inside the viewport. Display only. jpBootBarCss (body.boot-menu #uiToolbar z-index 70) is left as in q. */
/* Toolbar: wrap cleanly; shrink labels rather than clip or overflow the viewport. onumMobile's nowrap + 44px min at ≤900px is overridden. */
#uiToolbar{box-sizing:border-box!important;flex-wrap:wrap!important;overflow:visible!important;max-width:100vw!important;width:auto!important;justify-content:flex-start!important;align-items:center!important;gap:4px!important;padding:4px 6px!important}
#uiToolbar button{box-sizing:border-box!important;flex:0 1 auto!important;min-width:0!important;white-space:nowrap!important;max-width:100%!important}
@media (max-width:1366px){
  #uiToolbar button{font-size:11px!important;min-height:36px!important;padding:4px 8px!important;letter-spacing:.04em!important}
}
@media (max-width:900px),(max-height:640px){
  #uiToolbar button{font-size:10px!important;min-height:34px!important;padding:3px 6px!important;letter-spacing:.03em!important}
}
html.nr-bar-compact #uiToolbar button{font-size:10px!important;min-height:32px!important;padding:3px 6px!important;letter-spacing:.03em!important}
html.nr-bar-tiny #uiToolbar button{font-size:9px!important;min-height:30px!important;padding:2px 5px!important;letter-spacing:.02em!important}
/* Keep JUPITER's boot-menu stacking: the bar stays under the title/oath card (veil z-index 80). */
body.boot-menu #uiToolbar{z-index:70!important}
/* When playing, the gold HUD (#hmBar is z-index 10050) sits just above the (possibly wrapped) panels bar so both stay clickable. */
body:not(.boot-menu) #hmBar,
body:not(.boot-menu) #onumSeeDock,
body:not(.boot-menu) #hmWire,
body:not(.boot-menu) #aloudBtn,
body:not(.boot-menu) #reactBtn{bottom:calc(var(--nr-bar-h,0px) + 6px)!important}
/* Fold the high HUD and the panels bar while a veil card or talk is open, so Close / talk choices are not covered (hmBar would otherwise sit over the card). */
html.ca-modal #hmWire,html.ca-modal #onumSeeDock,html.ca-talk #hmWire,html.ca-talk #onumSeeDock{display:none!important}
html.ca-modal #hmBar,html.ca-modal #hmSay,html.ca-modal #hmSayWrap,
html.ca-modal #tick,html.ca-modal #tickRun,html.ca-modal #wire,html.ca-modal #wireHome,
html.ca-modal #aloudBtn,html.ca-modal #reactBtn,html.ca-modal #reactMenu,
html.ca-modal #uiToolbar,
html.ca-talk #uiToolbar,html.ca-talk #aloudBtn,html.ca-talk #reactBtn,html.ca-talk #reactMenu
{pointer-events:none!important;z-index:1!important;visibility:hidden!important}
html.ca-modal{--ca-bottom:8px}
/* District / Capital Ledger dialog: paper in the viewport, close pinned, type scales down on short screens. */
#onumCapitalLedgerDialog.cld-backdrop{z-index:10080!important;padding:8px!important;align-items:safe center!important;justify-items:center!important;overflow:auto!important;box-sizing:border-box!important}
#onumCapitalLedgerDialog .cld-paper{box-sizing:border-box!important;width:min(1080px,calc(100vw - 16px))!important;max-width:calc(100vw - 16px)!important;max-height:min(92dvh,calc(100dvh - 16px))!important;overflow:auto!important;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#onumCapitalLedgerDialog .cld-close{position:sticky!important;top:8px!important;float:right!important;z-index:8!important;flex:none!important;background:var(--paper,#f1f2f3)!important;box-shadow:0 0 0 1px var(--line,#c7cad0)}
@media (max-height:700px){
  #onumCapitalLedgerDialog .cld-mast h1{font-size:clamp(22px,6vw,36px)!important}
  #onumCapitalLedgerDialog .cld-lead h2{font-size:clamp(18px,4vw,28px)!important}
  #onumCapitalLedgerDialog .cld-deck{font-size:16px!important}
}
@media (max-width:700px){
  #onumCapitalLedgerDialog .cld-columns{grid-template-columns:1fr!important}
}
/* Foreign atlas: same gold-on-sea look, boxed to the card, no overflow. */
#pfMap, .nr-atlas{box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;border:1px solid rgba(201,162,74,.45);border-radius:10px;background:#071018;box-shadow:0 0 0 1px rgba(201,162,74,.2),0 8px 24px rgba(0,0,0,.35)}
#pfMap svg, .nr-atlas svg, svg[aria-label="The foreign capitals"]{width:100%!important;height:auto!important;max-height:min(32vh,240px)!important;display:block;border-radius:10px}
@media (max-height:700px){
  #pfMap svg, .nr-atlas svg, svg[aria-label="The foreign capitals"]{max-height:min(28vh,180px)!important}
}
/* Talk: nrFitJs pins #tkOwn, #tkActs, #tkComm and #tkSee in a bottom stack so choices stay above the comment row. */
#talk.is-open{overflow:hidden!important}
#talk.is-open #tkActs,#talk.is-open #tkActs button{z-index:8!important;pointer-events:auto!important}
#talk.is-open #tkComm{z-index:5!important;background:#0d0f13}
#talk.is-open #tkSee{z-index:2!important;overflow:auto!important;max-height:min(16vh,96px)!important}
@media (max-height:640px){#talk.is-open #tkSee{display:none!important}}
/* Park ✕ stays inside the viewport even when sxParkTick writes an inline left. */
#sxParkBar{right:8px!important;left:auto!important;transform:none!important;max-width:calc(100vw - 16px)!important}
</style>
<script id="nrFitJs">/* 20261117t NEPTUNE: compact the panels toolbar when buttons would clip; leave boot-menu z-index and talk-key logic alone. Display only. */
(function(){
  var SHORT = {
    uiOpenBtn:"Panels", uiMapBtn:"Map", uiWalkOut:"Walk", uiGalleryBtn:"Gallery",
    uiPaperBtn:"Paper", onumCapitalLedgerButton:"District", uiWarMapBtn:"World",
    uiOfficesBtn:"Offices", uiSettingsBtn:"Menu", ndFamBtn:"Family", ndPbBtn:"Book",
    uiPhoneBtn:"Phone", uiDocketBtn:"Docket", uiStatuteBtn:"Statutes", uiPurseBtn:"ƒ"
  };
  function vis(el){
    if(!el || el.hidden) return false;
    var st = getComputedStyle(el);
    if(st.display === "none" || st.visibility === "hidden") return false;
    return !!(el.getClientRects() || []).length;
  }
  function clipped(bar){
    var vw = window.innerWidth || 0, vh = window.innerHeight || 0;
    var nodes = bar.querySelectorAll("button");
    for(var i=0;i<nodes.length;i++){
      var r = nodes[i].getBoundingClientRect();
      if(r.width < 2 || r.height < 2) continue;
      if(r.left < -0.5 || r.top < -0.5 || r.right > vw + 0.5 || r.bottom > vh + 0.5) return true;
    }
    var br = bar.getBoundingClientRect();
    if(br.width > 2 && (br.left < -0.5 || br.right > vw + 0.5 || br.bottom > vh + 0.5)) return true;
    return false;
  }
  function shortLabels(bar){
    var nodes = bar.querySelectorAll("button");
    for(var i=0;i<nodes.length;i++){
      var b = nodes[i], id = b.id || "";
      if(!b.getAttribute("data-nr-full")) b.setAttribute("data-nr-full", (b.textContent || "").trim());
      if(SHORT[id]) b.textContent = SHORT[id];
    }
  }
  function restoreLabels(bar){
    var nodes = bar.querySelectorAll("button[data-nr-full]");
    for(var i=0;i<nodes.length;i++){
      var b = nodes[i], full = b.getAttribute("data-nr-full");
      if(full) b.textContent = full;
      b.removeAttribute("data-nr-full");
    }
  }
  function measureBar(bar){
    var h = 0;
    if(bar && vis(bar) && !document.documentElement.classList.contains("ca-modal") && !document.documentElement.classList.contains("ca-talk") && !document.body.classList.contains("boot-menu")){
      h = Math.ceil(bar.getBoundingClientRect().height) || 0;
    }
    document.documentElement.style.setProperty("--nr-bar-h", h + "px");
  }
  function fitBar(){
    var bar = document.getElementById("uiToolbar");
    var R = document.documentElement;
    if(!bar){ R.classList.remove("nr-bar-compact","nr-bar-tiny"); measureBar(null); return; }
    R.classList.remove("nr-bar-compact","nr-bar-tiny");
    restoreLabels(bar);
    if(!vis(bar)){ measureBar(bar); return; }
    if(clipped(bar) || (window.innerWidth || 0) <= 900 || (window.innerHeight || 0) <= 640){
      R.classList.add("nr-bar-compact");
      shortLabels(bar);
    }
    if(clipped(bar)) R.classList.add("nr-bar-tiny");
    measureBar(bar);
  }
  function tagAtlas(){
    var maps = document.querySelectorAll('svg[aria-label="The foreign capitals"]');
    for(var i=0;i<maps.length;i++){
      var svg = maps[i], p = svg.parentNode;
      if(!p) continue;
      if(p.id === "pfMap" || (p.classList && p.classList.contains("nr-atlas"))) continue;
      if(p.tagName && p.tagName.toLowerCase() === "div" && p.children.length === 1) p.classList.add("nr-atlas");
    }
  }

  function pinPark(){
    var bar = document.getElementById("sxParkBar");
    if(!bar) return;
    bar.style.setProperty("left", "auto", "important");
    bar.style.setProperty("right", "8px", "important");
    bar.style.setProperty("transform", "none", "important");
    var vw = window.innerWidth || 0;
    var r = bar.getBoundingClientRect();
    if(r.right > vw - 4){
      var pad = Math.max(8, Math.ceil(r.right - vw + 8));
      bar.style.setProperty("right", pad + "px", "important");
    }
  }

  function vis2(el){
    if(!el || el.hidden) return false;
    var st = getComputedStyle(el);
    return st.display !== "none" && st.visibility !== "hidden";
  }
  function pinAbs(el, bottom, z, maxH){
    el.style.setProperty("position", "absolute", "important");
    el.style.setProperty("left", "14px", "important");
    el.style.setProperty("right", "14px", "important");
    el.style.setProperty("bottom", bottom + "px", "important");
    el.style.setProperty("top", "auto", "important");
    el.style.setProperty("width", "auto", "important");
    el.style.setProperty("z-index", String(z), "important");
    if(maxH){ el.style.setProperty("max-height", maxH + "px", "important"); el.style.setProperty("overflow", "auto", "important"); }
  }
  function fitTalkFlow(){
    var T = document.getElementById("talk");
    if(!T || !T.classList.contains("is-open")) return;
    var acts = document.getElementById("tkActs");
    var own = document.getElementById("tkOwn");
    var comm = document.getElementById("tkComm");
    var see = document.getElementById("tkSee");
    var box = T.getBoundingClientRect();
    var vh = window.innerHeight || 0;
    var ceil = box.bottom;
    var hm = document.getElementById("hmBar");
    if(hm && vis2(hm)){
      var hr = hm.getBoundingClientRect();
      if(hr.height > 0 && hr.top > box.top) ceil = Math.min(ceil, hr.top);
    }
    var innerB = Math.max(8, Math.ceil(box.bottom - Math.min(ceil, vh) + 8));
    if(see){
      if(vh <= 640){ see.style.setProperty("display","none","important"); }
      else {
        see.style.removeProperty("display");
        var seeMax = Math.min(110, Math.max(48, Math.floor(vh * 0.16)));
        pinAbs(see, innerB, 2, seeMax);
        innerB += Math.min(seeMax, Math.max(40, see.getBoundingClientRect().height)) + 6;
      }
    }
    if(comm && vis2(comm)){
      pinAbs(comm, innerB, 5, 0);
      innerB += Math.max(36, comm.getBoundingClientRect().height) + 6;
    }
    var room = Math.max(120, box.height - 8);
    var actsMax = Math.max(88, Math.min(Math.floor(room * 0.5), room - innerB - 56));
    if(acts){
      pinAbs(acts, innerB, 8, actsMax);
      acts.style.setProperty("overflow","auto","important");
      var ar = acts.getBoundingClientRect();
      if(ar.bottom > vh - 4){
        var shrink = Math.max(88, Math.floor(ar.height - (ar.bottom - (vh - 4))));
        acts.style.setProperty("max-height", shrink + "px", "important");
      }
      innerB += Math.min(actsMax, Math.max(88, acts.getBoundingClientRect().height)) + 6;
    }
    if(own && vis2(own) && !own.hidden){
      pinAbs(own, innerB, 8, 0);
      innerB += Math.max(36, own.getBoundingClientRect().height) + 6;
    }
    T.style.setProperty("padding-bottom", innerB + "px", "important");
  }

  function boot(){ try{ fitBar(); tagAtlas(); pinPark(); fitTalkFlow(); }catch(e){} }
  var q = 0;
  function kick(){ if(q) return; q = setTimeout(function(){ q = 0; boot(); }, 40); }
  if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot, {once:true});
  else boot();
  try{ new MutationObserver(kick).observe(document.documentElement, {subtree:true, childList:true, attributes:true, attributeFilter:["hidden","class","style"]}); }catch(e){}
  addEventListener("resize", kick);
  setInterval(boot, 400);
  setInterval(function(){ try{ pinPark(); fitTalkFlow(); }catch(e){} }, 50);
})();
</script>
</body>
</html>
