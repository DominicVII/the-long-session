/* ══ 20261030o · room change tears down room chrome: the press session panel (#ndSess / #ndFd) lingered over the
   Statuary Corridor after Walk out (ssnTick bails while a card is up), and the Court showed corridor nametags
   (plates only refresh while standing still). A watcher that ignores cards and walking: new room -> close a session
   that belongs to another room, hide the desk, blank every plate. A dismissed (Cancel) sitting stays shut here. ══ */
(function(){
  try{
    const _so = ssnOpen;
    ssnOpen = function(o){ try{ if(G && G._ssnDismiss && G._ssnDismiss === G.room && !(o && o.auto === false)) return null; }catch(e){} return _so.apply(this, arguments); };
  }catch(e){}
  let lastRoom = null;
  setInterval(() => { try{
    if(!G) return;
    if(typeof SSN !== "undefined" && SSN && SSN.room && SSN.room !== G.room){
      ssnClose(); try{ const d = document.getElementById("ndFd"); if(d) d.hidden = true; }catch(e){} try{ const p = document.getElementById("ndSess"); if(p && !window.ONUM_SESSION) p.remove(); }catch(e){}
    }
    if(!window.ONUM_SESSION){ const p = document.getElementById("ndSess"); if(p) p.remove(); }
    if(G.room !== lastRoom){
      lastRoom = G.room;
      if(G._ssnDismiss && G._ssnDismiss !== G.room) G._ssnDismiss = null;
      try{ for(const d of plates){ d._shown = 0; d._sig = ""; d.style.display = "none"; } }catch(e){}
    }
  }catch(e){} }, 200);
})();

/* ══ 20261030q · plate watcher: a plate only stands while its person is in front of you, in this room and unwalled. Facing a blank
   corridor wall (or with updatePlates skipped: a card up, a throw, a frame budget) the last tags lingered. Independent of the frame loop. ══ */
(function(){
  setInterval(() => { try{
    if(!G || typeof plates === "undefined") return; const here = hereNow(), lx = Math.sin(cam.yaw), lz = Math.cos(cam.yaw);
    for(const d of plates){ if(!d || d._shown !== 1 || !d.children[0]) continue; const nm = d.children[0].textContent, p = here.find(q => q && q.name === nm);
      const ok = p && p.room === G.room && !p.gone && Math.hypot(p.x - cam.x, p.z - cam.z) < 11 && ((p.x - cam.x) * lx + (p.z - cam.z) * lz) > 0.35 && !plateBlocked(p);
      if(!ok){ d._shown = 0; d._sig = ""; d.style.display = "none"; } }
  }catch(e){} }, 250);
})();

/* ══ 20261030c · SESSIONS AND OPEN TALK, OPTIMISED.
   Press conference is an ONUM_SESSION (not the step-by-step sitting): the President opens,
   reporters raise hands into the queue, you call on one, their question waits with no timeout,
   you answer, then the next hand. Open talk no longer auto-opens when someone wants a word
   (hail corner note + mail + E when close only). LiveTalk is the single reply path when it is
   up; chairing a press conference calls on a reporter the same way cabinet does. ══ */
(function(){
  try{
    if(!window.ONUM_PROCEDURE) return;
    if(!window.ONUM_PROCEDURE.executive) window.ONUM_PROCEDURE.executive = {bodies:{}};
    const ST = typeof SSN_ST === "function" ? SSN_ST : function(id, name, speaker, secs, allows){ return {id, name, speaker, secs:secs||0, timed:false, allows:allows||[]}; };
    window.ONUM_PROCEDURE.executive.bodies.press_conference = {
      stages:[
        ST("call","The President opens the conference","president",0,["speak","yield","interject"]),
        ST("questions","Questions from the gallery","queue",0,["seek","speak","yield","interject","point_of_order"]),
        ST("wrap","Closing statement","president",0,["speak","yield"]),
        ST("adjourn","The conference ends","chair",0,[])
      ],
      recognition:"chair_picks",
      timeRules:{perSpeaker:0, unlimited:true, yieldable:true},
      voteMethods:[],
      motions:{},
      agenda:["Opening statement","Questions from the press","Closing"]
    };
    try{ SSN_ROOM.press = ["executive", "press_conference"]; }catch(e){}

    function prKind(){ return !!(SSN && SSN.kind === "press_conference"); }
    function prReporters(){
      let ps = [];
      try{ ps = (hereNow() || []).filter(p => p && p !== G.you && !p.gone && p.kind === "press"); }catch(e){}
      if(ps.length < 3){ try{ (G.press || []).forEach(p => { if(p && !p.gone && ps.indexOf(p) < 0) ps.push(p); }); }catch(e){} }
      return ps.slice(0, 12);
    }
    /* you chair any press conference you open */
    { const _yc = typeof ss2YouChair === "function" ? ss2YouChair : null;
      window.ss2YouChair = ss2YouChair = function(kind){ if(kind === "press_conference") return true; return _yc ? _yc(kind) : false; }; }
    { const _en = typeof ss2Entitled === "function" ? ss2Entitled : null;
      window.ss2Entitled = ss2Entitled = function(kind){ if(kind === "press_conference") return true; return _en ? _en(kind) : true; }; }

    /* open: seat the reporters and put you in the chair */
    { const _op = ssnOpen;
      ssnOpen = function(o){
        o = o || {};
        if(o.kind === "press_conference" && !o.people) o.people = prReporters();
        const r = _op.apply(this, arguments);
        try{
          if(r && r.kind === "press_conference"){
            r.chairId = "you";
            if(!r.seats.some(s => s.personId === "you")) r.seats.push({seatId:"you", personId:"you"});
            r.seats = r.seats.filter(s => s.personId === "you" || (byId(s.personId) && byId(s.personId).kind === "press"));
            SS2.hold = false; SS2.stageSaid = 0; SS2.chairSaid = false; SS2.budget = Math.min(8, Math.max(3, r.seats.length - 1));
            if(typeof ss2Pub === "function") ss2Pub(); else ssnPublish();
          }
        }catch(e){}
        return r;
      };
    }

    /* reporters raise hands and ask live; your answer never times out */
    function prAskLine(m){
      let t = "";
      try{ const b = G.bill && !G.bill.done ? G.bill : null; const topic = b ? b.title : (typeof wmBrief === "function" ? (wmBrief() || "today's business") : "today's business");
        t = pick([
          "Mr. President — on " + topic + ", what is your answer for the record?",
          "A question, if I may: who pays for this, and when?",
          "The galleries want a straight answer on " + topic + ". Do you have one?",
          (m.outlet || "My paper") + " asks: will you stand by that tomorrow?",
          "Follow-up: what changes for the districts that are already hurting?"
        ]);
      }catch(e){ t = "A question for the record, Mr. President."; }
      return t;
    }
    async function prLiveQ(m){
      const LT = window.onumLiveTalk; if(!LT || !LT.reply || !m) return prAskLine(m);
      let out = "";
      try{
        const you = (typeof ndYou === "function" ? ndYou() : null) || {};
        const topic = (G.bill && !G.bill.done && G.bill.title) || "the Republic today";
        const r = await Promise.race([
          LT.reply({npcId:m.id, channel:"press", text:"(You have been called on at the press conference.)",
            extra:"You are " + m.name + ", " + (m.role || "a reporter") + (m.outlet ? " for " + m.outlet : "") + ". You are at a press conference chaired by " + (you.address || "the President") + ". Ask ONE sharp question about " + topic + ". One or two sentences. No stage directions. Do not answer yourself."}),
          new Promise(res => setTimeout(() => res(null), 20000))
        ]);
        out = r && r.text ? String(r.text) : "";
      }catch(e){}
      out = (typeof engWhole === "function" ? engWhole(engClean(out)) : String(out || "").trim());
      return out || prAskLine(m);
    }
    function prShow(m, out){
      try{ speakAt(m, out); }catch(e){}
      try{ tlog(m.name, out, "talk"); }catch(e){}
      try{ lLog(m.name + ": " + out.slice(0, 160), "session"); }catch(e){}
      if(SSN){ SSN.lastSpk = m.id; SS2.spkUntil = Date.now() + (typeof ss2Read === "function" ? ss2Read(out) : 4000); try{ ssnEnsure().log.push({d:G.day, kind:SSN.kind, act:"ask", who:m.name, t:out.slice(0, 120)}); }catch(e){} if(typeof ss2Pub === "function") ss2Pub(); }
    }

    /* call on a reporter: they ask, then the floor returns to you and waits */
    const _cabCall = typeof cabCallOn === "function" ? cabCallOn : null;
    function prCallOn(id){
      try{
        if(!prKind()) return _cabCall ? _cabCall(id) : false;
        const p = byId(isNaN(+id) ? id : +id); if(!p || p.kind !== "press") return false;
        SSN.queue = (SSN.queue || []).filter(x => String(x) !== String(p.id));
        SSN.floorId = p.id; SSN._busy = Date.now() + 90000; if(typeof ss2Pub === "function") ss2Pub(); else ssnPublish();
        const tok = SSN._tok = (SSN._tok || 0) + 1;
        prLiveQ(p).then(out => {
          if(!SSN || tok !== SSN._tok || !prKind()) return;
          prShow(p, out);
          /* floor to you for the answer — never times out */
          SSN.floorId = "you"; SSN.offer = "you"; SSN.waitingOn = "you"; SSN._busy = 0;
          SS2.spkUntil = 0; SS2.hold = false;
          ssnPublish();
          try{ note(p.name + " asked. The floor is yours."); }catch(e){}
        });
        return true;
      }catch(e){ return false; }
    }
    window.onumSession = window.onumSession || {};
    window.onumSession.callon = prCallOn;

    /* while questions run, keep a few hands raised; never advance past your turn */
    { const _tk = ssnTick;
      ssnTick = function(){
        try{
          if(SSN && prKind()){
            const st = ssnStage();
            if(st && st.id === "questions"){
              if(SS2.hold || SSN.floorId === "you" || (SSN._busy && Date.now() < SSN._busy)) return;
              /* seed hands */
              if((SSN.queue || []).length < 3){
                const cand = (SSN.seats || []).map(s => s.personId).filter(id => id !== "you" && (SSN.queue || []).indexOf(id) < 0 && id !== SSN.floorId && (SSN.out || []).indexOf(id) < 0);
                const c = cand[Math.floor(Math.random() * cand.length)];
                if(c && chance(0.35)) SSN.queue.push(c);
              }
              /* do not auto-recognize: chair picks via callon */
              if(SSN.floorId != null && SSN.floorId !== "you"){
                if(Date.now() < SS2.spkUntil) return;
                /* question finished speaking → wait on you */
                SSN.floorId = "you"; SS2.spkUntil = 0; if(typeof ss2Pub === "function") ss2Pub(); return;
              }
              if(SSN.floorId === "you") return;
              if(typeof ss2Pub === "function") ss2Pub();
              return;
            }
            if(st && (st.id === "call" || st.id === "wrap") && SSN.floorId === "you") return;
          }
        }catch(e){}
        return _tk.apply(this, arguments);
      };
    }

    /* after you answer a question, clear the floor so the next hand can wait */
    { const _ev = window.onumSessionEvent;
      window.onumSessionEvent = function(e){
        const r = _ev.apply(this, arguments);
        try{
          if(SSN && prKind() && e && (e.actorId === "you" || (G.you && e.actorId === G.you.id)) && e.action === "speak"){
            const st = ssnStage();
            if(st && st.id === "questions"){ SSN.floorId = null; SSN.offer = null; SSN.waitingOn = null; SS2.gapUntil = Date.now() + 1200; ssnPublish(); }
            else if(st && st.id === "call"){ /* opening done → questions */ try{ ssnNext(); }catch(x){} }
            else if(st && st.id === "wrap"){ try{ ssnNext(); }catch(x){} }
          }
        }catch(x){}
        return r;
      };
    }

    /* pass from chair during questions advances or skips a hand */
    { const _pass = window.onumSession.pass;
      window.onumSession.pass = function(){
        if(prKind()){
          const st = ssnStage();
          if(st && st.id === "questions"){ SSN.floorId = null; SSN.offer = null; SSN.waitingOn = null; SSN.queue = (SSN.queue || []).filter(x => x !== "you"); SS2.hold = false; SS2.gapUntil = Date.now() + 800; ssnPublish(); return true; }
          if(st && (st.id === "call" || st.id === "wrap")){ try{ ssnNext(); }catch(e){} return true; }
        }
        return typeof _pass === "function" ? _pass.apply(this, arguments) : false;
      };
    }

    /* podium / docket / legacy sitStart("press") → session */
    function openPressConference(){
      try{
        if(typeof goTo === "function" && G.room !== "press"){ try{ goTo("press"); }catch(e){} }
        const ok = window.onumSession.open({gov:"executive", kind:"press_conference", room:"press", auto:false, people:prReporters()});
        if(ok){ try{ kMark("sxpress"); kMarkChamber(); }catch(e){} try{ note("Press conference open. Hands will rise; call on a reporter when ready."); }catch(e){} return true; }
      }catch(e){}
      return false;
    }
    { const _ss = sitStart;
      sitStart = function(room){
        const r = String(room || "").split(":")[0];
        if(r === "press"){ if(openPressConference()) return; }
        return _ss.apply(this, arguments);
      };
    }
    /* also catch the old office act that still rolls a press conference */
    try{
      const P = (PROPS.press || []).find(p => p.id === "podium");
      if(P && P.acts){ const a0 = P.acts; P.acts = function(){ let A = []; try{ A = a0.apply(this, arguments) || []; }catch(e){ A = []; }
        A = A.filter(x => !x || !/press conference/i.test(String(x.t || "")));
        A.unshift({t:"Hold a press conference", c:"untimed · call on reporters", off:(typeof kOnceToday === "function" ? kOnceToday("sxpress") : false), run(){ openPressConference(); return null; }});
        return A; }; }
    }catch(e){}

    /* click a reporter while you chair → call on them, do not open 1:1 talk */
    { const _ot = openTalk;
      openTalk = function(m){
        try{
          const S = window.ONUM_SESSION;
          const isReporter = !!(m && (m.kind === "press" || (S && (S.seats || []).some(x => String(x.personId) === String(m.id) && String(x.personId) !== "you"))));
          if(m && S && S.kind === "press_conference" && S.chairId === "you" && isReporter && window.onumSession && typeof window.onumSession.callon === "function"){
            window.onumSession.callon(m.id); return;
          }
        }catch(e){}
        return _ot.apply(this, arguments);
      };
    }
    /* 20261030l: keep press seats filled with reporters in the room so chairRoute / callon stay valid */
    { const _tick = typeof ss2Tick === "function" ? ss2Tick : null;
      function prSyncSeats(){
        try{
          if(typeof SSN === "undefined" || !SSN || SSN.kind !== "press_conference") return;
          const ps = prReporters() || [];
          const have = {};
          (SSN.seats || []).forEach(x => { if(x && x.personId != null) have[String(x.personId)] = true; });
          let n = 0;
          ps.forEach(p => {
            if(!p || p.id == null || have[String(p.id)]) return;
            SSN.seats.push({seatId:"pr" + (SSN.seats.length + 1), personId:p.id});
            have[String(p.id)] = true; n++;
          });
          if(n && typeof ssnPublish === "function") ssnPublish();
        }catch(e){}
      }
      if(_tick){ window.ss2Tick = ss2Tick = function(){ try{ prSyncSeats(); }catch(e){} return _tick.apply(this, arguments); }; }
      else setInterval(prSyncSeats, 1500);
    }

    /* ── open talk: no auto-open on wantsWord; LiveTalk is the one reply path ── */
    { const _cv = converse;
      converse = async function(m, text){
        if(!m || !text) return;
        try{
          const LT = window.onumLiveTalk;
          if(LT && LT.reply && TALK.open && TALK.m === m && typeof tkOwnSay === "function"){
            return tkOwnSay(m, text);
          }
        }catch(e){}
        /* hold wantsWord so the legacy converse body cannot yank-open talk for a hail */
        var held = null;
        try{
          if(m.wantsWord && (!TALK.open || TALK.m !== m)){ held = m.wantsWord; m.wantsWord = null; }
        }catch(e){}
        try{ return await _cv.apply(this, arguments); }
        finally { try{ if(held && m && !m.wantsWord) m.wantsWord = held; }catch(e){} }
      };
    }

    console.log("JUPITER 20261030f: press floor publish offer/waitingOn/lastSpk; NOW strip is you-only on your turn");
  }catch(e){ try{ console.warn("JUPITER 20261030c", e); }catch(x){} }
})();


armFrame();

})();
</script>


<script>
/* Neptune 20261021l: HUD layout manager (onumHud). Edge docks (left/right columns, top strip, bottom bar);
   panels stack in their dock and never overlap; centre (middle 50% x 60%) stays clear except modals the player opened.
   Every docked panel gets a collapse control and leaves a reopen tab. Always-on bottom bar in immersive: Say aloud + Cables. */
(function(){
  "use strict";
  if(window.onumHud) return;
  const GAP = 6, PAD = 8;
  /* dock: L/R/T/B; talk = compact talk row; chip = tiny control merged into the bottom bar */
  const REG = [
    {s:"#prompt", d:"R", n:"Prompt", noX:1},
    {s:"#hail", d:"R", n:"Wants a word", talk:1},
    {s:"#apToast", d:"R", n:"Stops you", talk:1},
    {s:"#kClock", d:"R", n:"Clock", noX:1, small:1},
    {s:"#sxDock", d:"R", n:"Meeting"},
    {s:"#feed", d:"R", n:"Feed"},
    {s:".hud", d:"L", n:"Place", noX:1, small:1},
    {s:"#aimsHud", d:"L", n:"Aims", noX:1, small:1},
    {s:"#clDock", d:"L", n:"Notices", noX:1, small:1},
    {s:".notices", d:"L", n:"Notices"},
    {s:"#cvLive", d:"L", n:"Room log", cap:150},
    {s:"#procBar", d:"L", n:"Procedure"},
    {s:"#tele", d:"L", n:"Status"},
    {s:"#job", d:"L", n:"Checklist"},
    {s:".quest,#quest,#questBox,#ckList", d:"L", n:"Checklist"},
    {s:".ach-toast", d:"T", n:"Toast"},
    {s:"#tipCard", d:"T", n:"Tip"},
    {s:"#ndFd", d:"B", n:"Floor desk"},
    {s:"#ltPill", chip:1}, {s:"#ltChatBtn", chip:1}, {s:"#dmBadge", chip:1}, {s:"#ndBuild", chip:1}
  ];
  const H = window.onumHud = {collapsed:{}, last:null};
  const css = document.createElement("style"); css.id = "hmCss";
  css.textContent = ".hm-col{display:none!important}" +
    ".hmX{position:absolute!important;top:2px!important;right:2px!important;z-index:5!important;width:20px;height:20px;line-height:16px;padding:0!important;margin:0!important;border:1px solid #c9a24a!important;border-radius:4px;background:#0d0f13!important;color:#f4f1e8!important;font:700 13px system-ui!important;cursor:pointer;pointer-events:auto!important;min-height:0!important}" +
    ".hm-p{pointer-events:auto!important}" +
    "#hmBar{position:fixed;left:8px;right:8px;bottom:6px;z-index:10050;display:flex;gap:6px;align-items:center;background:#0d0f13;color:#f4f1e8;border:1px solid #c9a24a;border-radius:8px;padding:4px 6px;font:13px system-ui,sans-serif;box-sizing:border-box}" +
    "#hmBar[hidden]{display:none}#hmBar input{flex:1;min-width:80px;background:#1b1f27;color:#fff;border:1px solid #5a6474;border-radius:5px;padding:5px 8px;font:13px system-ui}" +
    "#hmBar button,.hmTab{background:#2b333d;color:#fff;border:1px solid #c9a24a;border-radius:5px;padding:4px 8px;font:600 12px system-ui;cursor:pointer;white-space:nowrap}" +
    "#hmBar .hmChips{display:flex;gap:4px;align-items:center;flex-wrap:nowrap;overflow:hidden}#hmBar .hmChips>*{position:static!important;transform:none!important;margin:0!important}" +
    "#hmBar.hm-desk #hmSayWrap{display:none}#hmSayWrap{display:flex;flex:1;gap:6px;align-items:center;min-width:0}" +
    ".hm-talk{display:flex!important;gap:8px;align-items:center;font-size:12px!important;padding:6px 26px 6px 6px!important}" +
    ".hm-talk .hmPort{flex:none;width:40px;height:40px;border-radius:50%;border:1px solid #c9a24a;background:#2a2f3a;color:#fff;font:700 15px system-ui;display:flex;align-items:center;justify-content:center;overflow:hidden}" +
    ".hm-talk .hmPort canvas{width:40px;height:40px}.hm-talk .hmBody{flex:1;min-width:0}";
  document.head.appendChild(css);
  const vis = e => { if(!e || !e.isConnected || e.hidden || e.classList.contains("hm-col")) return false; const cs = getComputedStyle(e); if(cs.display === "none" || cs.visibility === "hidden") return false; const r = e.getBoundingClientRect(); return r.width > 1 && r.height > 1; };
  const set = (e, k, v) => { if(e.style.getPropertyValue(k) !== v || e.style.getPropertyPriority(k) !== "important") e.style.setProperty(k, v, "important"); };
  const gG = () => { try{ return window.NEPTUNE && typeof NEPTUNE.debug === "function" ? NEPTUNE.debug().G : null; }catch(e){ return null; } };
  const inGame = () => { const g = gG(); return !!(g && g.you && g.room); };
  /* ----- bottom bar ----- */
  let bar = null, tabs = null, chips = null;
  function say(text){
    text = String(text || "").trim(); if(!text) return false;
    try{ const S = window.onumSession; if(S && typeof S.speak === "function" && (window.ONUM_SESSION ? window.ONUM_SESSION.open !== false : true) && document.getElementById("ndFd")){ S.speak(text); return true; } }catch(e){}
    try{ const wi = document.getElementById("wireIn"), ws = document.getElementById("wireSend"); if(wi && ws){ wi.value = text; ws.click(); return true; } }catch(e){}
    try{ if(typeof wireSend === "function"){ const wi = document.getElementById("wireIn"); if(wi) wi.value = text; wireSend(); return true; } }catch(e){}
    return false;
  }
  H.say = say;
  function cables(){ try{ if(typeof dmToggle === "function"){ dmToggle(true); return; } }catch(e){} try{ const b = document.getElementById("dmBadge"); if(b) b.click(); }catch(e){} }
  H.cables = cables;
  function mkBar(){
    if(bar && bar.isConnected) return;
    bar = document.createElement("div"); bar.id = "hmBar"; bar.className = "hm-p";
    bar.innerHTML = '<span id="hmSayWrap"><b style="white-space:nowrap">Say aloud</b><input id="hmSay" type="text" maxlength="400" autocomplete="off" placeholder="Speak to the room, or whoever is near (Enter)"><button type="button" id="hmSayGo">Say</button></span>' +
      '<button type="button" id="hmCab" title="Cables and messages">\u2709 Cables</button><span class="hmTabs"></span><span class="hmChips"></span>';
    document.body.appendChild(bar); tabs = bar.querySelector(".hmTabs"); chips = bar.querySelector(".hmChips");
    const inp = bar.querySelector("#hmSay");
    const go = () => { if(say(inp.value)){ inp.value = ""; } else { inp.placeholder = "Nobody can hear you here yet."; } };
    bar.querySelector("#hmSayGo").onclick = go; bar.querySelector("#hmCab").onclick = cables;
    const stop = e => { e.stopPropagation(); };
    inp.addEventListener("keydown", e => { e.stopPropagation(); if(e.key === "Enter"){ e.preventDefault(); go(); } else if(e.key === "Escape"){ inp.blur(); } });
    inp.addEventListener("keyup", stop); inp.addEventListener("keypress", stop);
  }
  /* Ctrl/Meta combos (copy, paste, select all, undo...) in any text field: let the browser have them, no game handler sees them. */
  const editable = t => t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
  window.addEventListener("keydown", e => { if((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey && e.key !== "Enter" && editable(e.target)) e.stopImmediatePropagation(); }, true);
  /* ----- collapse/reopen ----- */
  function addX(e, r){
    if(r.noX || e.querySelector(":scope>.hmX")) return;
    if(getComputedStyle(e).position === "static") set(e, "position", "fixed");
    const x = document.createElement("button"); x.type = "button"; x.className = "hmX"; x.textContent = "\u2013"; x.title = "Collapse " + r.n + " (reopen from the bar)";
    x.onclick = ev => { ev.stopPropagation(); collapse(e, r); };
    e.appendChild(x);
  }
  function collapse(e, r){ e.classList.add("hm-col"); const k = r.s; H.collapsed[k] = r.n; layout(); }
  H.collapse = sel => { const r = REG.find(q => q.s === sel); const e = r && document.querySelector(r.s); if(e) collapse(e, r); };
  H.reopen = sel => { document.querySelectorAll(sel).forEach(e => e.classList.remove("hm-col")); delete H.collapsed[sel]; layout(); };
  function drawTabs(){
    if(!tabs) return; const want = Object.keys(H.collapsed).filter(s => document.querySelector(s));
    const key = want.join("|"); if(tabs.dataset.k === key) return; tabs.dataset.k = key; tabs.innerHTML = "";
    want.forEach(s => { const b = document.createElement("button"); b.type = "button"; b.className = "hmTab"; b.textContent = "\u25B8 " + H.collapsed[s]; b.title = "Reopen"; b.onclick = () => H.reopen(s); tabs.appendChild(b); });
  }
  /* ----- compact talk rows with a portrait ----- */
  function talkify(e){
    if(e.querySelector(":scope>.hmPort")) return;
    const txt = (e.innerText || "").trim(); if(!txt) return;
    e.dataset.hmT = "1"; e.classList.add("hm-talk");
    const id = e.dataset.npc; let port = document.createElement("span"); port.className = "hmPort";
    try{ if(id != null && window.onumFamilyTree && typeof onumFamilyTree.portrait === "function"){ const c = onumFamilyTree.portrait(id, null, 80); if(c) port.appendChild(c); } }catch(x){}
    if(!port.firstChild){ const nm = e.dataset.name || txt.split(/\s+/).slice(0, 2).join(" "); port.textContent = nm.split(/\s+/).map(w => w[0] || "").join("").slice(0, 2).toUpperCase(); }
    const body = document.createElement("div"); body.className = "hmBody"; while(e.firstChild) body.appendChild(e.firstChild);
    e.appendChild(port); e.appendChild(body);
  }
  /* ----- layout ----- */
  function place(e, o){
    set(e, "position", "fixed"); set(e, "transform", "none"); set(e, "margin", "0"); set(e, "box-sizing", "border-box");
    set(e, "left", o.left == null ? "auto" : o.left + "px"); set(e, "right", o.right == null ? "auto" : o.right + "px");
    set(e, "top", o.top == null ? "auto" : o.top + "px"); set(e, "bottom", o.bottom == null ? "auto" : o.bottom + "px");
    if(o.w != null){ set(e, "width", o.w + "px"); set(e, "max-width", o.w + "px"); }
    if(o.mh != null){ set(e, "max-height", o.mh + "px"); set(e, "overflow", "auto"); }
    e.classList.add("hm-p");
  }
  function layout(){
    const W = innerWidth, Ht = innerHeight;
    const game = inGame();
    mkBar();
    bar.hidden = !game;
    const desk = document.getElementById("ndFd"); bar.classList.toggle("hm-desk", !!(desk && vis(desk)));
    /* chips into the bar */
    REG.filter(r => r.chip).forEach(r => { const e = document.querySelector(r.s); if(e && e.parentElement !== chips && game) chips.appendChild(e); });
    drawTabs();
    const colW = Math.max(160, Math.floor(W * 0.25) - PAD * 2), bandB = Math.max(Math.round(Ht * 0.2), 60);
    const barH = game && vis(bar) ? bar.getBoundingClientRect().height + 6 : 0;
    const bottomLimit = Ht - Math.max(bandB, barH + 4);
    const out = {L:[], R:[], T:[], B:[]};
    for(const r of REG){ if(r.chip) continue; document.querySelectorAll(r.s).forEach(e => { if(e.closest("#hmBar") || (e.id !== "sxDock" && e.closest("#sxDock")) || !vis(e)) return; const dk = (e.id === "sxDock" && desk && vis(desk) && e.contains(desk)) ? "B" : r.d; /* 20261030h: desk up = bottom band */ if(out[dk].some(x => x.e === e || x.e.contains(e))) return; out[dk].push({e, r}); }); }
    const stack = (list, side) => {
      let y = PAD;
      { const tb = document.getElementById("uiToolbar"); if(tb && vis(tb)) y = Math.max(y, Math.round(tb.getBoundingClientRect().bottom) + GAP); }   /* below the toolbar, never over it */
      for(const {e, r} of list){
        if(r.talk) talkify(e); addX(e, r);
        const room = bottomLimit - y; if(room < 28){ collapse(e, r); continue; }
        const o = {top:y, w:colW, mh:r.cap ? Math.min(room, r.cap) : room}; if(side === "L") o.left = PAD; else o.right = PAD;
        if(r.small){ o.w = null; set(e, "max-width", colW + "px"); }
        place(e, o); y += Math.min(e.getBoundingClientRect().height, room) + GAP;
      }
    };
    stack(out.L, "L"); stack(out.R, "R");
    /* top strip: between the columns, above the centre zone */
    let x = Math.floor(W * 0.25) + PAD; const tW = Math.floor(W * 0.5) - PAD * 2, tH = Math.floor(Ht * 0.2) - PAD;
    let ty = PAD;
    for(const {e, r} of out.T){ addX(e, r); place(e, {left:x, top:ty, w:tW, mh:Math.max(24, tH - ty)}); ty += e.getBoundingClientRect().height + GAP; }
    /* bottom band: the floor desk, merged with the bar (bar shows only Cables + tabs + chips while the desk is up) */
    for(const {e, r} of out.B){
      addX(e, r);
      /* 20261030h: full-width band sitting just above the Say aloud bar and any fixed strip along the bottom (the wire); max 20vh */
      let sTop = Ht; [bar, ...document.querySelectorAll("body > *")].forEach(s => { try{ if(!s || s === e || s.contains(e) || e.contains(s) || s.hidden) return; const cs = getComputedStyle(s); if(cs.display === "none" || cs.visibility === "hidden" || cs.position !== "fixed") return;
        const q = s.getBoundingClientRect(); if(q.height > 0 && q.height < 90 && q.width > W * 0.5 && q.top > Ht * 0.7) sTop = Math.min(sTop, q.top); }catch(x){} });
      place(e, {left:PAD, right:PAD, bottom:Math.max(6, Math.round(Ht - sTop + GAP)), mh:Math.max(150, Math.round(Ht * 0.24))});
      set(e, "width", "auto"); set(e, "max-width", "none"); set(e, "overflow", "hidden");
    }
    if(bar){ bar.style.removeProperty("left"); bar.style.removeProperty("right"); }
    H.last = {W, Ht, L:out.L.length, R:out.R.length, T:out.T.length, B:out.B.length};
  }
  H.layout = layout;
  /* overlap/centre check (QA hook) */
  H.check = function(){
    const W = innerWidth, Ht = innerHeight, cz = {l:W * .25, t:Ht * .2, r:W * .75, b:Ht * .8};
    const els = [];
    REG.forEach(r => document.querySelectorAll(r.s).forEach(e => { if(vis(e) && !e.closest("#hmBar") && !els.some(x => x.e === e)) els.push({e, n:r.s}); }));
    if(bar && vis(bar)) els.push({e:bar, n:"#hmBar"});
    const R = els.map(x => { const b = x.e.getBoundingClientRect(); return {n:x.n, l:b.left, t:b.top, r:b.right, b:b.bottom}; });
    const hit = (a, b) => a.l < b.r - 0.5 && b.l < a.r - 0.5 && a.t < b.b - 0.5 && b.t < a.b - 0.5;
    const overlaps = [], centre = [];
    for(let i = 0; i < R.length; i++){ if(hit(R[i], cz)) centre.push(R[i].n); for(let j = i + 1; j < R.length; j++) if(hit(R[i], R[j])) overlaps.push(R[i].n + " x " + R[j].n); }
    return {panels:R.map(r => r.n + "@" + [r.l, r.t, r.r, r.b].map(Math.round).join(",")), overlaps, centre, ok:!overlaps.length && !centre.length};
  };
  let q = 0; const kick = () => { if(q) return; q = requestAnimationFrame(() => { q = 0; try{ layout(); }catch(e){} }); };
  addEventListener("resize", kick);
  try{ new MutationObserver(kick).observe(document.body, {childList:true}); }catch(e){}
  try{ ["prompt", "hail", "procBar", "tipCard"].forEach(id => { const e = document.getElementById(id); if(e) new MutationObserver(kick).observe(e, {attributes:true, attributeFilter:["hidden", "class"]}); }); }catch(e){}
  setInterval(() => { try{ layout(); }catch(e){} }, 400);
  kick();
})();

/* 20261106d: each meeting button does its own job. The person you click is the one who speaks.
   Press asks the one already up for the figure. Challenge is answered by somebody on the other side.
   Pass moves on and stays quiet. Next calls the next person who has not spoken. */
(function(){
  const st = document.createElement("style"); st.id = "mtRunCss";
  st.textContent = "#mtBar{position:fixed;left:6px;right:6px;z-index:10060;display:none;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;padding:6px;background:#121419;color:#f4f1e8;border:2px solid #c9a24a;border-radius:8px;box-shadow:0 4px 16px #000}" +
    "#mtBar.on{display:grid}#mtBar .mt-s{grid-column:1/-1;font:600 11px/1.2 system-ui;color:#ffe08a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}" +
    "#mtBar button{min-height:34px;max-height:44px;padding:4px 6px;background:#2a2d35;color:#fff;border:1px solid #c9a24a;border-radius:6px;font:700 11px/1.15 system-ui;cursor:pointer;overflow:hidden}" +
    "#mtBar button.mt-go{background:#ffe08a;color:#111;border-color:#ffe08a}" +
    "#ndFd .fd-acts .mt-s{flex:1 0 100%;color:#ffe08a;font:600 12px/1.3 system-ui;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}" +
    "#ndFd .fd-acts button.mt-go{background:#ffe08a;color:#111;border-color:#ffe08a}" +
    "body.mt-on #ndSess .nsx-seat{cursor:pointer}body.mt-on #ndSess .nsx-q li{cursor:pointer}" +
    "body.mt-on #ndSess .nsx-acts{display:none!important}" +
    ".proc{max-height:38vh;overflow:hidden}.proc__opts{display:grid;grid-template-columns:1fr 1fr;gap:4px}.proc__h i{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}";
  document.head.appendChild(st);
  const bar = document.createElement("div"); bar.id = "mtBar"; bar.setAttribute("role","toolbar"); bar.setAttribute("aria-label","Run the meeting");
  document.body.appendChild(bar);
  let others = false, note = "", sig = "";
  const sv = f => { try{ return f(); }catch(e){ return null; } };
  const youId = x => x === "you" || (G.you && String(x) === String(G.you.id));
  const person = id => { if(id == null || id === "" || youId(id)) return youId(id) ? G.you : null; return sv(() => byId(isNaN(+id) ? id : +id)); };
  const sn = p => { const n = p && p.name ? String(p.name) : ""; const b = n.split(/\s+/).filter(Boolean); return b.length ? b[b.length - 1] : "them"; };
  function live(){
    const S = window.ONUM_SESSION; if(S && S.stage !== "idle" && S.open !== false && (S.kind || S.floorId != null || (S.seats && S.seats.length) || S.chairId != null)) return S;
    try{
      if(typeof PROC !== "undefined" && PROC && PROC.on && PROC.e){
        const people = [].concat(PROC.order || [], PROC.chair ? [PROC.chair] : [], PROC.wit && PROC.wit.member ? [PROC.wit.member] : []).filter(Boolean);
        const seen = {};
        const seats = [];
        people.forEach(p => { if(!p || p.id == null || seen[p.id] || p === G.you) return; seen[p.id] = 1; seats.push({personId:p.id}); });
        const sp = PROC.speaker;
        return {kind:PROC.e.k, stage:PROC.phase || "open", floorId: sp === G.you ? "you" : (sp && sp.id), chairId: PROC.chair && PROC.chair.id, seats, queue:[], _proc:true};
      }
    }catch(e){}
    return null;
  }
  function seats(S){ return (S && S.seats || []).map(x => x && (x.personId != null ? x.personId : x.id)).filter(id => id != null && !youId(id)); }
  function bill(){ return (G.bill && !G.bill.done) ? G.bill : null; }
  function side(p){ const b = bill(); if(!b || !p) return ""; try{ return memberVote(p, b) < 0 ? "no" : "aye"; }catch(e){ return ""; } }
  function town(p){ try{ const bio = bioOf(p); return (bio && bio.town) || p.state || "home"; }catch(e){ return (p && p.state) || "home"; } }
  function heard(id){ return SSN && (SSN._mtSaid || []).some(x => String(x) === String(id)); }
  function mark(id){ if(!SSN || id == null) return; SSN._mtSaid = SSN._mtSaid || []; if(!heard(id)) SSN._mtSaid.push(id); const L = seats(live()); const i = L.findIndex(x => String(x) === String(id)); if(i >= 0) SSN._mtAt = i + 1; }
  function up(){ const S = live(); if(!S || S.floorId == null || youId(S.floorId)) return null; return person(S.floorId); }
  function nextFresh(){
    const S = live(); const L = seats(S); if(!L.length) return null;
    const start = (SSN && SSN._mtAt) || 0;
    for(let n = 0; n < L.length; n++){ const id = L[(start + n) % L.length]; if(!heard(id)) return id; }
    return null;
  }
  function show(p, line){
    if(!p || !line) return;
    try{ if(SSN){ SSN.floorId = p === G.you ? "you" : p.id; ssnPublish(); } }catch(e){}
    if(p !== G.you){ try{ speakAt(p, line); }catch(e){} }
    try{ const FD = window.NEPTUNE_FLOORDESK, D = document.getElementById("ndFd"); if(FD && D && !D.hidden) FD.line(p === G.you ? "you" : p.id, line); }catch(e){}
    try{ tlog(p === G.you ? "You" : p.name, line, p === G.you ? "you" : "talk"); }catch(e){}
    try{ appendFloor(p === G.you ? "You" : sn(p), line); }catch(e){}
    if(p !== G.you) mark(p.id);
    try{ if(typeof PROC !== "undefined" && PROC && PROC.on) PROC.speaker = p; }catch(e){}
    note = sn(p) + " is speaking";
    sig = "";
  }
  function kindOf(){ const S = live(); return (S && S.kind) || ""; }
  function askLine(p, kind){
    const b = bill(), topic = b ? b.title : "today's business", outlet = (p && (p.outlet || p.role)) || "the paper";
    if(kind === "press_conference" || kind === "presser" || (p && p.kind === "press")) return pick([
      outlet + ". On " + topic + ", what is the answer for the record?",
      "Who pays for this, and when do the districts see it?",
      "Will you stand by that tomorrow, or is this only today's line?",
      "The places already hurting want a number, not a mood."
    ]);
    if(kind === "hearing" || kind === "committee_hearing") return "For the record: what did you know about " + topic + ", and what does it cost " + town(p) + "?";
    if(kind === "caucus") return "In this room, not on the floor: I am a " + (side(p) || "undecided") + (b ? " on " + b.title : "") + ". " + town(p) + " is who I face after.";
    if(kind === "crisis") return "This cannot wait on a tidy bill. " + town(p) + " needs an answer today" + (b ? " on " + b.title : "") + ", and I am a " + (side(p) || "no") + " until I hear the cost.";
    if(kind === "townhall") return "I came from " + town(p) + " to ask what you will do" + (b ? " about " + b.title : "") + ". I want a yes or a no I can take home.";
    return "";
  }
  function callOn(id){
    const kind = kindOf();
    if(kind === "press_conference" && window.onumSession && typeof window.onumSession.callon === "function"){
      const ok = window.onumSession.callon(id);
      if(ok){ note = "Called. They ask, then the floor is yours to answer."; sig = ""; return; }
    }
    if((kind === "cabinet_meeting" || kind === "governor_council") && typeof cabCallOn === "function"){
      cabCallOn(id); note = "Called. They speak from the office they hold."; sig = ""; return;
    }
    const p = person(id); if(!p || p === G.you){ note = "Pick someone else, not yourself."; sig = ""; return; }
    const b = bill(), sd = side(p);
    let line = askLine(p, kind);
    if(!line){ try{ const N = (b && typeof natureOf === "function") ? natureOf(p, b) : null; if(N && N.line && !(typeof heardBefore === "function" && heardBefore(N.line))) line = N.line; }catch(e){} }
    if(!line){ try{ line = procLineFor(p, {k: kind === "hearing" || kind === "committee_hearing" ? "hearing" : "floor"}); }catch(e){} }
    if(!line) line = (b && sd) ? ("I am a " + sd + " on " + b.title + ". I speak for " + town(p) + ".") : (sn(p) + " takes the floor for " + town(p) + ".");
    try{ if(typeof rememberLine === "function") rememberLine(line); }catch(e){}
    show(p, line);
  }
  function press(){
    const kind = kindOf(), p = up();
    if(kind === "press_conference" || kind === "presser" || (p && p.kind === "press")){
      if(!p){ note = "Call on a reporter first. Then press them for the follow-up."; sig = ""; return; }
      show(p, "Follow-up. The first answer was not a number. " + (bill() ? bill().title + ": " : "") + "who pays, and what fails if you do nothing?");
      return;
    }
    if((kind === "cabinet_meeting" || kind === "governor_council") && window.onumSession && typeof window.onumSession.press === "function"){
      window.onumSession.press(p && p.id); note = "Pressed for the figure."; sig = ""; return;
    }
    if(!p){ note = "Call on someone first. Press is for the person already up."; sig = ""; return; }
    const b = bill(), sd = side(p);
    const fig = (b && b.cost) ? (" The figure is " + money(b.cost) + ".") : "";
    let human = "";
    try{ const N = (b && typeof natureOf === "function") ? natureOf(p, b) : null;
      if(N && N.kind === "herd") human = " I went with the room. That is the specific truth.";
      else if(N && N.kind === "apart") human = " I broke from the room on purpose.";
      else if(N && N.kind === "fear") human = " My seat is close. That is why I am not standing alone.";
      else if(N && N.kind === "spite") human = " I do not like who asked. That is in the vote.";
      else if(N && N.kind === "for-you") human = " Part of this vote is you.";
      else if(N && N.kind === "tired") human = " I am not fighting the room tonight.";
    }catch(e){}
    show(p, "You pressed for the specific point. My vote is " + (sd || "unchanged") + (b ? " on " + b.title : "") + "." + fig + " " + town(p) + " is who I answer to." + human);
  }
  function challenge(){
    const kind = kindOf(), p = up();
    if(kind === "press_conference" || kind === "presser"){
      const other = seats(live()).map(person).filter(o => o && o !== p && o.kind === "press")[0] || seats(live()).map(person).filter(o => o && o !== p)[0];
      if(!other){ note = "Nobody else in the gallery to challenge it."; sig = ""; return; }
      show(other, "A different paper. " + (p ? sn(p) + " asked the easy one. " : "") + "Answer this: what do you refuse to do, and who is hurt by that refusal?");
      return;
    }
    if((kind === "cabinet_meeting" || kind === "governor_council") && window.onumSession && typeof window.onumSession.challenge === "function"){
      window.onumSession.challenge(p && p.id); note = "Challenged. They answer the objection."; sig = ""; return;
    }
    if(!p){ note = "Call on someone first. A challenge needs someone to answer."; sig = ""; return; }
    const b = bill(); const sd = b ? memberVote(p, b) : 0;
    const opp = seats(live()).map(person).filter(o => o && o !== p && (!b || memberVote(o, b) !== sd))[0];
    if(!opp){ note = "Nobody on the other side is in the room."; sig = ""; return; }
    const od = side(opp);
    let mine = "";
    try{ const N = (b && typeof natureOf === "function") ? natureOf(opp, b) : null; if(N && N.line) mine = " " + N.line; }catch(e){}
    show(opp, "I challenge " + sn(p) + ". I am a " + (od || "no") + (b ? " on " + b.title : "") + " and " + sn(p) + " is a " + (side(p) || "the other way") + "." + (mine || " That is the disagreement."));
  }
  function order(){
    show(G.you, "Point of order. The member is not on the question before this room.");
    try{ const O = window.onumSession; if(O && O.pointOfOrder) O.pointOfOrder(); }catch(e){}
    try{ if(SSN && SSN.floorId && !youId(SSN.floorId)){ /* the ruling may already have cleared it */ } }catch(e){}
    note = "Point of order. The floor is yours for that, not theirs."; sig = "";
  }
  function chair(){
    const S = live(); const c = S && person(S.chairId);
    if(!c || c === G.you){ show(G.you, "The chair: one member at a time. Call the next name when you are ready."); return; }
    show(c, "The chair will hear one member at a time. " + (up() ? sn(up()) + " has been heard." : "The floor is open.") + " Call the next. I am not yielding this chair to repeat them.");
  }
  function endSitting(){
    try{
      if(typeof SSN !== "undefined" && SSN){ let n = 0; while(SSN && ssnStage() && ssnStage().id !== "adjourn" && n < 8){ ssnNext(); n++; } ssnClose(); }
      if(typeof PROC !== "undefined" && PROC && PROC.on){ PROC.on = false; PROC.speaker = null; const pb = document.getElementById("procBar"); if(pb) pb.hidden = true; }
      const d = document.getElementById("ndFd"); if(d) d.hidden = true;
    }catch(e){}
    note = "The sitting is closed."; sig = "";
  }
  function pass(){
    try{ if(SSN){ const id = SSN.floorId; if(id && !youId(id)) mark(id); SSN.floorId = null; ssnPublish(); } }catch(e){}
    note = "Passed. Nobody else speaks until you call the next."; sig = "";
  }
  function interject(){
    let line = ""; try{ const ta = document.querySelector("#ndFd textarea"); line = ta && ta.value.trim(); if(ta) ta.value = ""; }catch(e){}
    show(G.you, line || "From my seat: that is not the question, and I am not giving the floor to the same member to say it again.");
  }
  function next(){
    const id = nextFresh();
    if(id == null){ note = "Everyone here has been called. Open Call on others to hear one again."; sig = ""; return; }
    callOn(id);
  }
  function btn(label, go, hot, title){
    const b = document.createElement("button"); b.type = "button"; b.textContent = label; if(title) b.title = title;
    if(hot) b.className = "mt-go";
    b.onclick = ev => { ev.preventDefault(); ev.stopPropagation(); try{ go(); }catch(e){} paint(true); };
    return b;
  }
  function place(){
    const hb = document.getElementById("hmBar"); let btm = 8;
    try{ if(hb && !hb.hidden && getComputedStyle(hb).display !== "none") btm = Math.ceil(innerHeight - hb.getBoundingClientRect().top + 6); }catch(e){}
    bar.style.bottom = btm + "px";
  }
  function host(){
    const D = document.getElementById("ndFd"); if(!D || D.hidden) return null;
    const body = D.querySelector(".fd-body"); if(!body) return null;
    let A = D.querySelector(".fd-acts");
    if(!A){ A = document.createElement("div"); A.className = "fd-acts"; const t0 = body.querySelector("textarea") || body.querySelector(".fd-reply"); if(t0) t0.parentNode.insertBefore(A, t0); else body.insertBefore(A, body.firstChild); }
    return A;
  }
  function paint(force){
    const S = live(); document.body.classList.toggle("mt-on", !!S);
    let A = host();
    const floating = !A;
    if(floating){ A = bar; place(); }
    if(!S){ if(sig){ sig = ""; const desk = host(); if(desk){ desk.innerHTML = ""; delete desk.dataset.mt; } } bar.className = ""; bar.innerHTML = ""; return; }
    if(!floating){ A.dataset.mt = "1"; bar.className = ""; bar.innerHTML = ""; }
    else bar.className = "on";
    const who = up(), nx = nextFresh();
    const pv = (G.bill && typeof preferredVote === "function") ? (preferredVote(G.bill) || 0) : 0;
    const now = [others, note, who && who.id, nx, (SSN && SSN._mtSaid && SSN._mtSaid.length), S.floorId, (S.queue || []).length, pv].join("|");
    if(!force && now === sig && A.childElementCount) return;
    sig = now; A.innerHTML = "";
    const s = document.createElement("div"); s.className = "mt-s";
    const ch = person(S.chairId);
    s.textContent = (note || ((S.chairId && youId(S.chairId)) ? "You chair. Call who you want heard." : ("Chair: " + (ch ? sn(ch) : "the chair"))) + " · floor: " + (who ? sn(who) : (youId(S.floorId) ? "you" : "open")));
    A.appendChild(s);
    if(others){
      A.appendChild(btn("Back", () => { others = false; }, false, "Back to the meeting"));
      seats(S).slice(0, 8).forEach(id => { const p = person(id); if(!p || p === G.you) return;
        A.appendChild(btn((heard(id) ? "Again: " : "Call on ") + sn(p), () => { others = false; callOn(id); }, !heard(id), (p.role ? p.role + ". " : "") + p.name)); });
      return;
    }
    A.appendChild(btn(pv === 1 ? "My vote: aye" : "Set aye", () => { if(typeof setMyVote === "function") setMyVote(1); note = "Your vote is aye. When they ask, that is the answer, not your mood."; }, pv === 1, "What you tell them when they ask how you vote"));
    A.appendChild(btn(pv === -1 ? "My vote: no" : "Set no", () => { if(typeof setMyVote === "function") setMyVote(-1); note = "Your vote is no. When they ask, that is the answer, not your mood."; }, pv === -1, "What you tell them when they ask how you vote"));
    if(S.kind === "cabinet_meeting" || S.kind === "governor_council") A.appendChild(btn("Use their office", () => {
      const id = (SSN && SSN.floorId && !youId(SSN.floorId)) ? SSN.floorId : window.__cabLast;
      const p = id != null ? person(id) : null;
      if(!p){ note = "Call on a secretary first. The office belongs to the person on the floor."; return; }
      note = (typeof cabUse === "function") ? cabUse(p) : "No office to use.";
      show(p, (p.role || "This office") + ". " + note);
    }, true, "The person with the floor spends the power of the office they hold, and says why"));
    A.appendChild(btn("Point of order", order, true, "You take the point. They were not on the question."));
    A.appendChild(btn(who ? "Press " + sn(who) : "Press", press, false, "The person already up gives the figure and the reason"));
    A.appendChild(btn("Challenge", challenge, false, "Somebody on the other side answers, and says why they differ"));
    A.appendChild(btn("Call on others", () => { others = true; note = ""; }, false, "Pick who speaks. Click a seat, or a name."));
    A.appendChild(btn("Chair", chair, false, "The chair speaks. Not the member who just spoke."));
    A.appendChild(btn("Pass", pass, false, "Move on. Nobody else speaks until you call the next."));
    A.appendChild(btn("Interject", interject, false, "You speak from your seat. It does not give you the floor."));
    A.appendChild(btn(nx ? ("Next: " + sn(person(nx))) : "Next: done", next, true, nx ? person(nx).name : "Everyone seated has been called"));
    A.appendChild(btn("End the sitting", endSitting, false, "Close this press conference, hearing, caucus or floor. It does not keep talking after you leave it."));
  }
  document.addEventListener("click", e => {
    const S = live(); if(!S) return;
    const seat = e.target.closest && e.target.closest("#ndSess .nsx-seat");
    if(seat){
      const name = String(seat.getAttribute("title") || "").split(" · ")[0].trim();
      const id = seats(S).find(x => { const p = person(x); return p && p.name === name; });
      if(id != null){ e.preventDefault(); callOn(id); paint(true); }
      return;
    }
    const li = e.target.closest && e.target.closest("#ndSess .nsx-q li");
    if(li){
      const name = (li.textContent || "").trim();
      const id = (S.queue || []).find(x => { const p = person(x); return p && (p.name === name || sn(p) === name); });
      if(id != null){ e.preventDefault(); callOn(id); paint(true); }
    }
  }, true);
  setInterval(() => paint(false), 700);
  addEventListener("onum-session", () => setTimeout(() => paint(true), 0));
  addEventListener("resize", place);
})();

</script>

<style id="caFitCss">/* 20261117p NEPTUNE caFit: cabinet and brief prompts stay inside the viewport; long text scrolls; Aye/Nay and choice/close rows stay visible. Display only. */
#veil:not([hidden]){align-items:start!important;justify-items:center!important;padding:12px!important;overflow:auto!important}
#veil:not([hidden])#veil{inset:0!important;height:auto!important;max-height:none!important}
#veil:not([hidden]) #card{box-sizing:border-box!important;width:min(760px,calc(100vw - 24px))!important;max-height:calc(100vh - 24px)!important;max-height:calc(100dvh - 24px - var(--ca-bottom,56px))!important;margin-block:auto!important;overflow-x:hidden!important;overflow-y:auto!important;padding:16px 18px 12px!important;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
#veil:not([hidden]) #card h1{font-size:clamp(22px,3.6vw,32px)!important;margin:4px 0 8px!important;line-height:1.12!important}
#veil:not([hidden]) #card>p{margin:0 0 8px!important}
#veil:not([hidden]) #card>.card__actions:not(:last-of-type){position:static!important}
#veil:not([hidden]) #card>.card__actions:last-of-type,#veil:not([hidden]) #card.ca-fit-card>.card__actions:last-of-type,#veil:not([hidden]) #card .card__actions.ca-vote,#veil:not([hidden]) #card .fd-vote{position:sticky!important;bottom:0!important;z-index:6!important;background:var(--paper,#f6f1e6)!important;padding-top:8px!important;padding-bottom:2px!important;margin-top:8px!important;box-shadow:0 -10px 14px var(--paper,#f6f1e6)!important}
#veil:not([hidden]) #card .btn{min-height:40px}
#veil:not([hidden]) #card .sit__lines,#veil:not([hidden]) #card .sx-lines{max-height:min(36vh,calc(100dvh - 260px))!important;overflow-y:auto!important;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#veil:not([hidden]) #card.ca-fit-grid{display:grid!important;grid-template-columns:1fr 1fr;gap:8px 16px;align-content:start}
#veil:not([hidden]) #card.ca-fit-grid>.eyebrow,#veil:not([hidden]) #card.ca-fit-grid>h1,#veil:not([hidden]) #card.ca-fit-grid>h2,#veil:not([hidden]) #card.ca-fit-grid>p,#veil:not([hidden]) #card.ca-fit-grid>#gcSay,#veil:not([hidden]) #card.ca-fit-grid>.card__actions:last-of-type,#veil:not([hidden]) #card.ca-fit-grid>.sit__prog,#veil:not([hidden]) #card.ca-fit-grid>.sit__lines,#veil:not([hidden]) #card.ca-fit-grid>.ca-fit-span,#veil:not([hidden]) #card.ca-fit-grid>.fd-vote,#veil:not([hidden]) #card.ca-fit-grid>.card__actions.ca-vote{grid-column:1/-1}
@media (max-width:700px){#veil:not([hidden]) #card.ca-fit-grid{grid-template-columns:1fr}}
html.ca-modal #prompt.is-live,html.ca-modal #sxDock,html.ca-modal #apToast,html.ca-modal #brHint,html.ca-modal .notices,html.ca-modal #log,html.ca-modal #liveLog{display:none!important}
html.ca-sit #prompt.is-live,html.ca-sit #apToast,html.ca-sit #brHint,html.ca-sit .notices{display:none!important}
#veil.sitx,#veil.sitx #card{max-height:calc(100vh - 96px)!important;max-height:calc(100dvh - 96px)!important;overflow:auto!important}
#sxDock:not([hidden]){box-sizing:border-box!important;overflow-x:hidden!important;overflow-y:auto!important;display:flex!important;flex-direction:column!important;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
html.ca-sit #sxDock.fd-on:not([hidden]),#sxDock.fd-on:not([hidden]){flex-direction:row!important;align-items:stretch!important;max-height:max(220px,calc(100dvh - var(--ca-bottom,56px) - 12px))!important;min-height:220px!important;overflow:hidden!important;overflow-y:auto!important;top:auto!important;bottom:var(--fdB,var(--ca-bottom,56px))!important;left:8px!important;right:8px!important;width:auto!important}
#sxDock.fd-on:not([hidden])>*{max-height:none!important;min-height:0!important;overflow:auto!important}
#sxDock.fd-on:not([hidden])>#sxDockHead{max-width:150px;flex:none;overflow:auto!important}
#sxDock #ndSess,#sxDock #ndFd,#sxDock .ns-body,#sxDock .fd-log{min-height:0;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#sxDock .fd-acts,#sxDock .fd-vote,#sxDock .nsx-acts,#sxDock .card__actions,#ndFd .fd-acts,#ndFd .fd-vote,#ndFd .fd-send,#ndFd .fd-cancel,#ndSess .nsx-acts{position:sticky!important;bottom:0!important;z-index:5!important;flex:none!important;background:#121419}
#ndFd .fd-vote{display:flex!important;flex-wrap:wrap;gap:6px;align-items:center;margin:6px 0;flex:none!important}
#ndFd .fd-vote b{flex:1 1 100%;color:#ffe08a;font:700 11px system-ui;letter-spacing:.06em;text-transform:uppercase}
#ndFd .fd-vote button{min-height:44px;flex:1 1 88px;border-radius:10px;border:0;background:#2a2d35;color:#fff;font:700 13px system-ui;cursor:pointer;touch-action:manipulation}
#ndFd .fd-vote button.is-on{background:#c9a24a;color:#14120c}
#ndSess .g,#sxDock .g,#ndSess button,#sxDock button,#ndFd button{scroll-margin-bottom:8px}
#sxParkBar{right:8px!important;left:auto!important;width:max-content!important;min-width:96px!important;max-width:none!important;box-sizing:border-box!important;overflow:visible!important;z-index:10070!important}#sxParkBar button{flex:none!important}
/* While a talk is open, fold the HUD strips that cover choice buttons at ≤1366 (MARS S5). Do not hide #talk #chat (the transcript). Enter/Space picking is untouched. */
html.ca-talk #hmWire,html.ca-talk #onumSeeDock{display:none!important}
html.ca-talk #hmBar,html.ca-talk #hmSay,html.ca-talk #hmSayWrap,html.ca-talk #tick,html.ca-talk #tickRun,html.ca-talk #wire,html.ca-talk #wireHome{pointer-events:none!important;z-index:1!important;visibility:hidden!important}
#talk.is-open{position:fixed!important;left:8px!important;right:8px!important;bottom:0!important;top:auto!important;width:auto!important;max-height:calc(100dvh - 8px)!important;z-index:10060!important;pointer-events:auto!important;overflow:hidden!important;display:flex!important;flex-direction:column!important;min-height:0!important}
#talk.is-open #tkActs{position:relative!important;z-index:5!important;flex:1 1 auto!important;min-height:96px!important;max-height:min(48dvh,calc(100dvh - 220px))!important;overflow:auto!important}
#talk.is-open #tkActs button{position:relative!important;z-index:6!important;pointer-events:auto!important}
#cvLive{box-sizing:border-box!important;max-height:min(42vh,calc(100dvh - var(--ca-bottom,70px) - 12px))!important;overflow-x:hidden!important;overflow-y:auto!important}
#veil:not([hidden]) #card div .card__actions{position:sticky!important;bottom:0!important;z-index:6!important;background:var(--paper,#f6f1e6)!important;padding-top:8px!important;padding-bottom:2px!important;box-shadow:0 -10px 14px var(--paper,#f6f1e6)!important}
</style>
<script id="caFitJs">/* 20261117p NEPTUNE caFit: tag modal vs sitting surfaces so CSS can pin them; clear leftover inline caps; two-column brief cards. Display only. */
(function(){
  var OWN = ["max-height","min-height","height","top","bottom","left","right","width","overflow","overflow-y"];
  function vis(el){ return !!(el && !el.hidden && (el.getClientRects()||[]).length && getComputedStyle(el).display !== "none"); }
  function sittingOpen(){
    return vis(document.getElementById("sxDock")) || vis(document.getElementById("ndSess"));
  }
  function modalOpen(){
    var v = document.getElementById("veil");
    var c = document.getElementById("card");
    if(!v || v.hidden) return false;
    var st = window.getComputedStyle(v);
    if(st.position === "fixed" && st.display !== "none") return !!(c && (c.textContent||"").trim());
    return false;
  }
  function talkOpen(){
    var t = document.getElementById("talk");
    return !!(t && t.classList && t.classList.contains("is-open") && vis(t));
  }
  function clearOwn(el){
    if(!el || !el.getAttribute("data-cafit")) return;
    OWN.forEach(function(p){ try{ el.style.removeProperty(p); }catch(e){} });
    el.removeAttribute("data-cafit");
  }
  function setOwn(el, props){
    if(!el) return;
    el.setAttribute("data-cafit", "1");
    Object.keys(props).forEach(function(p){ el.style.setProperty(p, props[p], "important"); });
  }
  function tagGrid(card){
    if(!card) return;
    var sections = 0, kids = card.children;
    for(var i=0;i<kids.length;i++){
      var el = kids[i];
      var isSec = !!(el.matches && el.matches("div") && el.querySelector && el.querySelector(":scope .card__actions"));
      if(isSec){ sections++; if(el.classList) el.classList.remove("ca-fit-span"); }
      else if(el.classList) el.classList.add("ca-fit-span");
    }
    if(sections >= 3) card.classList.add("ca-fit-grid");
    else {
      card.classList.remove("ca-fit-grid");
      for(var j=0;j<kids.length;j++) if(kids[j].classList) kids[j].classList.remove("ca-fit-span");
    }
  }
  function band(){
    var top = 8, bottom = 8, vw = window.innerWidth || 0, vh = window.innerHeight || 0;
    var nodes = document.querySelectorAll("body > * , #hmBar, #hud, .hud, #sayBar, #composer, #hmWire");
    for(var i=0;i<nodes.length;i++){
      var el = nodes[i];
      if(!vis(el) || el.id === "veil" || el.id === "sxDock" || el.id === "prompt" || el.id === "card" || el.id === "talk") continue;
      var st = getComputedStyle(el);
      if(st.position !== "fixed" && st.position !== "sticky") continue;
      var r = el.getBoundingClientRect();
      if(r.width < 40 || r.height < 8 || r.height > vh * 0.45) continue;
      if(r.top <= 8 && r.bottom > top && r.bottom < vh * 0.4) top = Math.max(top, r.bottom + 8);
      if(r.bottom >= vh - 8 && r.top < vh - bottom && r.top > vh * 0.5) bottom = Math.max(bottom, vh - r.top + 8);
    }
    return {top:top, bottom:bottom, room:Math.max(160, vh - top - bottom)};
  }
  function placeSit(){
    var dock = document.getElementById("sxDock");
    var v = document.getElementById("veil");
    var card = document.getElementById("card");
    var b = band();
    if(dock && vis(dock)){
      var fd = dock.classList.contains("fd-on");
      setOwn(dock, {
        "max-height": Math.max(fd ? 220 : 160, b.room) + "px",
        "min-height": (fd ? 220 : 0) ? (fd ? "220px" : "") : "",
        "height": "auto",
        "top": "auto",
        "bottom": b.bottom + "px",
        "left": fd ? "8px" : "",
        "right": fd ? "8px" : "",
        "width": fd ? "auto" : "",
        "overflow": fd ? "hidden" : "auto",
        "overflow-y": "auto"
      });
      if(fd){ dock.style.setProperty("min-height", "220px", "important"); }
      else { try{ dock.style.removeProperty("min-height"); }catch(e){} }
      if(fd){
        var kids = dock.children;
        for(var i=0;i<kids.length;i++){
          try{ kids[i].style.setProperty("max-height", "none", "important"); }catch(e){}
        }
      }
    }
    if(v && !v.hidden && getComputedStyle(v).position !== "fixed" && card){
      var top = Math.max(b.top, Math.floor(v.getBoundingClientRect().top || b.top));
      var cap = Math.max(140, (window.innerHeight || 0) - top - b.bottom);
      setOwn(v, {"max-height": cap + "px", "overflow": "auto"});
      setOwn(card, {"max-height": cap + "px", "overflow": "auto", "overflow-y": "auto"});
    }
  }
  function parkBarOnScreen(){
    var bar = document.getElementById("sxParkBar");
    if(!bar || bar.style.display === "none") return;
    /* sxParkTick writes left = dock.right-66 (bar is wider than 66px with 44px hit targets), which can push ✕ off the right edge. Pin right and let the bar size to its buttons. */
    bar.style.setProperty("left", "auto", "important");
    bar.style.setProperty("right", "8px", "important");
    bar.style.setProperty("width", "max-content", "important");
    bar.style.setProperty("min-width", "96px", "important");
    bar.style.setProperty("max-width", "none", "important");
  }
  function boot(){
    var R = document.documentElement;
    var v = document.getElementById("veil");
    var card = document.getElementById("card");
    var dock = document.getElementById("sxDock");
    var modal = modalOpen();
    var talk = talkOpen();
    var sit = sittingOpen() && !modal;
    R.classList.toggle("ca-modal", modal);
    R.classList.toggle("ca-sit", sit);
    R.classList.toggle("ca-talk", talk);
    var b = band();
    R.style.setProperty("--ca-bottom", b.bottom + "px");
    if(modal){
      clearOwn(v); clearOwn(card); clearOwn(dock);
      if(v){ v.style.removeProperty("max-height"); v.style.removeProperty("height"); v.style.removeProperty("overflow"); }
      if(card){ card.style.removeProperty("max-height"); card.style.removeProperty("height"); card.style.removeProperty("overflow"); card.style.removeProperty("overflow-y"); }
    }
    if(card){
      card.classList.toggle("ca-fit-card", !!(v && !v.hidden));
      if(modal) tagGrid(card);
      else card.classList.remove("ca-fit-grid");
    }
    if(sit) placeSit();
    else if(!sit){ if(dock && !vis(dock)) clearOwn(dock); }
    parkBarOnScreen();
  }
  var q = 0;
  function kick(){ if(q) return; q = setTimeout(function(){ q = 0; try{ boot(); }catch(e){} }, 30); }
  if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot, {once:true});
  else boot();
  try{ new MutationObserver(kick).observe(document.documentElement, {subtree:true, childList:true, attributes:true, attributeFilter:["hidden","class","style"]}); }catch(e){}
  addEventListener("resize", kick);
  setInterval(boot, 400);
  setInterval(function(){ if(sittingOpen()) placeSit(); parkBarOnScreen(); }, 50);
})();
</script>
<style id="nrFitCss">/* 20261117t NEPTUNE: toolbar, District Ledger, and the foreign atlas stay inside the viewport. Display only. jpBootBarCss (body.boot-menu #uiToolbar z-index 70) is left as in q. */
/* Toolbar: wrap cleanly; shrink labels rather than clip or overflow the viewport. onumMobile's nowrap + 44px min at ≤900px is overridden. */
#uiToolbar{box-sizing:border-box!important;flex-wrap:wrap!important;overflow:visible!important;max-width:100vw!important;width:auto!important;justify-content:flex-start!important;align-items:center!important;gap:4px!important;padding:4px 6px!important}
#uiToolbar button{box-sizing:border-box!important;flex:0 1 auto!important;min-width:0!important;white-space:nowrap!important;max-width:100%!important}
@media (max-width:1366px){
  #uiToolbar button{font-size:11px!important;min-height:36px!important;padding:4px 8px!important;letter-spacing:.04em!important}
}
@media (max-width:900px),(max-height:640px){
  #uiToolbar button{font-size:10px!important;min-height:34px!important;padding:3px 6px!important;letter-spacing:.03em!important}
}
html.nr-bar-compact #uiToolbar button{font-size:10px!important;min-height:32px!important;padding:3px 6px!important;letter-spacing:.03em!important}
html.nr-bar-tiny #uiToolbar button{font-size:9px!important;min-height:30px!important;padding:2px 5px!important;letter-spacing:.02em!important}
/* Keep JUPITER's boot-menu stacking: the bar stays under the title/oath card (veil z-index 80). */
body.boot-menu #uiToolbar{z-index:70!important}
/* When playing, the gold HUD (#hmBar is z-index 10050) sits just above the (possibly wrapped) panels bar so both stay clickable. */
body:not(.boot-menu) #hmBar,
body:not(.boot-menu) #onumSeeDock,
body:not(.boot-menu) #hmWire,
body:not(.boot-menu) #aloudBtn,
body:not(.boot-menu) #reactBtn{bottom:calc(var(--nr-bar-h,0px) + 6px)!important}
/* Fold the high HUD and the panels bar while a veil card or talk is open, so Close / talk choices are not covered (hmBar would otherwise sit over the card). */
html.ca-modal #hmWire,html.ca-modal #onumSeeDock,html.ca-talk #hmWire,html.ca-talk #onumSeeDock{display:none!important}
html.ca-modal #hmBar,html.ca-modal #hmSay,html.ca-modal #hmSayWrap,
html.ca-modal #tick,html.ca-modal #tickRun,html.ca-modal #wire,html.ca-modal #wireHome,
html.ca-modal #aloudBtn,html.ca-modal #reactBtn,html.ca-modal #reactMenu,
html.ca-modal #uiToolbar,
html.ca-talk #uiToolbar,html.ca-talk #aloudBtn,html.ca-talk #reactBtn,html.ca-talk #reactMenu
{pointer-events:none!important;z-index:1!important;visibility:hidden!important}
html.ca-modal{--ca-bottom:8px}
/* District / Capital Ledger dialog: paper in the viewport, close pinned, type scales down on short screens. */
#onumCapitalLedgerDialog.cld-backdrop{z-index:10080!important;padding:8px!important;align-items:safe center!important;justify-items:center!important;overflow:auto!important;box-sizing:border-box!important}
#onumCapitalLedgerDialog .cld-paper{box-sizing:border-box!important;width:min(1080px,calc(100vw - 16px))!important;max-width:calc(100vw - 16px)!important;max-height:min(92dvh,calc(100dvh - 16px))!important;overflow:auto!important;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#onumCapitalLedgerDialog .cld-close{position:sticky!important;top:8px!important;float:right!important;z-index:8!important;flex:none!important;background:var(--paper,#f1f2f3)!important;box-shadow:0 0 0 1px var(--line,#c7cad0)}
@media (max-height:700px){
  #onumCapitalLedgerDialog .cld-mast h1{font-size:clamp(22px,6vw,36px)!important}
  #onumCapitalLedgerDialog .cld-lead h2{font-size:clamp(18px,4vw,28px)!important}
  #onumCapitalLedgerDialog .cld-deck{font-size:16px!important}
}
@media (max-width:700px){
  #onumCapitalLedgerDialog .cld-columns{grid-template-columns:1fr!important}
}
/* Foreign atlas: same gold-on-sea look, boxed to the card, no overflow. */
#pfMap, .nr-atlas{box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;border:1px solid rgba(201,162,74,.45);border-radius:10px;background:#071018;box-shadow:0 0 0 1px rgba(201,162,74,.2),0 8px 24px rgba(0,0,0,.35)}
#pfMap svg, .nr-atlas svg, svg[aria-label="The foreign capitals"]{width:100%!important;height:auto!important;max-height:min(32vh,240px)!important;display:block;border-radius:10px}
@media (max-height:700px){
  #pfMap svg, .nr-atlas svg, svg[aria-label="The foreign capitals"]{max-height:min(28vh,180px)!important}
}
/* Talk: nrFitJs pins #tkOwn, #tkActs, #tkComm and #tkSee in a bottom stack so choices stay above the comment row. */
#talk.is-open{overflow:hidden!important}
#talk.is-open #tkActs,#talk.is-open #tkActs button{z-index:8!important;pointer-events:auto!important}
#talk.is-open #tkComm{z-index:5!important;background:#0d0f13}
#talk.is-open #tkSee{z-index:2!important;overflow:auto!important;max-height:min(16vh,96px)!important}
@media (max-height:640px){#talk.is-open #tkSee{display:none!important}}
/* Park ✕ stays inside the viewport even when sxParkTick writes an inline left. */
#sxParkBar{right:8px!important;left:auto!important;transform:none!important;max-width:calc(100vw - 16px)!important}
</style>
<script id="nrFitJs">/* 20261117t NEPTUNE: compact the panels toolbar when buttons would clip; leave boot-menu z-index and talk-key logic alone. Display only. */
(function(){
  var SHORT = {
    uiOpenBtn:"Panels", uiMapBtn:"Map", uiWalkOut:"Walk", uiGalleryBtn:"Gallery",
    uiPaperBtn:"Paper", onumCapitalLedgerButton:"District", uiWarMapBtn:"World",
    uiOfficesBtn:"Offices", uiSettingsBtn:"Menu", ndFamBtn:"Family", ndPbBtn:"Book",
    uiPhoneBtn:"Phone", uiDocketBtn:"Docket", uiStatuteBtn:"Statutes", uiPurseBtn:"ƒ"
  };
  function vis(el){
    if(!el || el.hidden) return false;
    var st = getComputedStyle(el);
    if(st.display === "none" || st.visibility === "hidden") return false;
    return !!(el.getClientRects() || []).length;
  }
  function clipped(bar){
    var vw = window.innerWidth || 0, vh = window.innerHeight || 0;
    var nodes = bar.querySelectorAll("button");
    for(var i=0;i<nodes.length;i++){
      var r = nodes[i].getBoundingClientRect();
      if(r.width < 2 || r.height < 2) continue;
      if(r.left < -0.5 || r.top < -0.5 || r.right > vw + 0.5 || r.bottom > vh + 0.5) return true;
    }
    var br = bar.getBoundingClientRect();
    if(br.width > 2 && (br.left < -0.5 || br.right > vw + 0.5 || br.bottom > vh + 0.5)) return true;
    return false;
  }
  function shortLabels(bar){
    var nodes = bar.querySelectorAll("button");
    for(var i=0;i<nodes.length;i++){
      var b = nodes[i], id = b.id || "";
      if(!b.getAttribute("data-nr-full")) b.setAttribute("data-nr-full", (b.textContent || "").trim());
      if(SHORT[id]) b.textContent = SHORT[id];
    }
  }
  function restoreLabels(bar){
    var nodes = bar.querySelectorAll("button[data-nr-full]");
    for(var i=0;i<nodes.length;i++){
      var b = nodes[i], full = b.getAttribute("data-nr-full");
      if(full) b.textContent = full;
      b.removeAttribute("data-nr-full");
    }
  }
  function measureBar(bar){
    var h = 0;
    if(bar && vis(bar) && !document.documentElement.classList.contains("ca-modal") && !document.documentElement.classList.contains("ca-talk") && !document.body.classList.contains("boot-menu")){
      h = Math.ceil(bar.getBoundingClientRect().height) || 0;
    }
    document.documentElement.style.setProperty("--nr-bar-h", h + "px");
  }
  function fitBar(){
    var bar = document.getElementById("uiToolbar");
    var R = document.documentElement;
    if(!bar){ R.classList.remove("nr-bar-compact","nr-bar-tiny"); measureBar(null); return; }
    R.classList.remove("nr-bar-compact","nr-bar-tiny");
    restoreLabels(bar);
    if(!vis(bar)){ measureBar(bar); return; }
    if(clipped(bar) || (window.innerWidth || 0) <= 900 || (window.innerHeight || 0) <= 640){
      R.classList.add("nr-bar-compact");
      shortLabels(bar);
    }
    if(clipped(bar)) R.classList.add("nr-bar-tiny");
    measureBar(bar);
  }
  function tagAtlas(){
    var maps = document.querySelectorAll('svg[aria-label="The foreign capitals"]');
    for(var i=0;i<maps.length;i++){
      var svg = maps[i], p = svg.parentNode;
      if(!p) continue;
      if(p.id === "pfMap" || (p.classList && p.classList.contains("nr-atlas"))) continue;
      if(p.tagName && p.tagName.toLowerCase() === "div" && p.children.length === 1) p.classList.add("nr-atlas");
    }
  }

  function pinPark(){
    var bar = document.getElementById("sxParkBar");
    if(!bar) return;
    bar.style.setProperty("left", "auto", "important");
    bar.style.setProperty("right", "8px", "important");
    bar.style.setProperty("transform", "none", "important");
    var vw = window.innerWidth || 0;
    var r = bar.getBoundingClientRect();
    if(r.right > vw - 4){
      var pad = Math.max(8, Math.ceil(r.right - vw + 8));
      bar.style.setProperty("right", pad + "px", "important");
    }
  }

  function vis2(el){
    if(!el || el.hidden) return false;
    var st = getComputedStyle(el);
    return st.display !== "none" && st.visibility !== "hidden";
  }
  function pinAbs(el, bottom, z, maxH){
    el.style.setProperty("position", "absolute", "important");
    el.style.setProperty("left", "14px", "important");
    el.style.setProperty("right", "14px", "important");
    el.style.setProperty("bottom", bottom + "px", "important");
    el.style.setProperty("top", "auto", "important");
    el.style.setProperty("width", "auto", "important");
    el.style.setProperty("z-index", String(z), "important");
    if(maxH){ el.style.setProperty("max-height", maxH + "px", "important"); el.style.setProperty("overflow", "auto", "important"); }
  }
  function fitTalkFlow(){
    var T = document.getElementById("talk");
    if(!T || !T.classList.contains("is-open")) return;
    var acts = document.getElementById("tkActs");
    var own = document.getElementById("tkOwn");
    var comm = document.getElementById("tkComm");
    var see = document.getElementById("tkSee");
    var box = T.getBoundingClientRect();
    var vh = window.innerHeight || 0;
    var ceil = box.bottom;
    var hm = document.getElementById("hmBar");
    if(hm && vis2(hm)){
      var hr = hm.getBoundingClientRect();
      if(hr.height > 0 && hr.top > box.top) ceil = Math.min(ceil, hr.top);
    }
    var innerB = Math.max(8, Math.ceil(box.bottom - Math.min(ceil, vh) + 8));
    if(see){
      if(vh <= 640){ see.style.setProperty("display","none","important"); }
      else {
        see.style.removeProperty("display");
        var seeMax = Math.min(110, Math.max(48, Math.floor(vh * 0.16)));
        pinAbs(see, innerB, 2, seeMax);
        innerB += Math.min(seeMax, Math.max(40, see.getBoundingClientRect().height)) + 6;
      }
    }
    if(comm && vis2(comm)){
      pinAbs(comm, innerB, 5, 0);
      innerB += Math.max(36, comm.getBoundingClientRect().height) + 6;
    }
    var room = Math.max(120, box.height - 8);
    var actsMax = Math.max(88, Math.min(Math.floor(room * 0.5), room - innerB - 56));
    if(acts){
      pinAbs(acts, innerB, 8, actsMax);
      acts.style.setProperty("overflow","auto","important");
      var ar = acts.getBoundingClientRect();
      if(ar.bottom > vh - 4){
        var shrink = Math.max(88, Math.floor(ar.height - (ar.bottom - (vh - 4))));
        acts.style.setProperty("max-height", shrink + "px", "important");
      }
      innerB += Math.min(actsMax, Math.max(88, acts.getBoundingClientRect().height)) + 6;
    }
    if(own && vis2(own) && !own.hidden){
      pinAbs(own, innerB, 8, 0);
      innerB += Math.max(36, own.getBoundingClientRect().height) + 6;
    }
    T.style.setProperty("padding-bottom", innerB + "px", "important");
  }

  function boot(){ try{ fitBar(); tagAtlas(); pinPark(); fitTalkFlow(); }catch(e){} }
  var q = 0;
  function kick(){ if(q) return; q = setTimeout(function(){ q = 0; boot(); }, 40); }
  if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot, {once:true});
  else boot();
  try{ new MutationObserver(kick).observe(document.documentElement, {subtree:true, childList:true, attributes:true, attributeFilter:["hidden","class","style"]}); }catch(e){}
  addEventListener("resize", kick);
  setInterval(boot, 400);
  setInterval(function(){ try{ pinPark(); fitTalkFlow(); }catch(e){} }, 50);
})();
</script>
</body>
</html>
