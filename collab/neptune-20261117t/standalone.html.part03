    const join = cand.filter(a => wlRegard(a, m) >= 15 && wlFit(a, m) > 0).slice(0, 4); if(join.length < 2){ try{ mindRemember(m, "thought", "I asked. Not enough of them would sit at the table."); }catch(e){} return "nobloc"; }
    const used = life.blocs.map(b => b.n), n = BLOC_NAMES.find(x => used.indexOf(x) < 0) || ("the " + sn + " Group");
