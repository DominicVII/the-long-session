iend or a grudge: those come from what was actually done to them, and the record keeps it.
   Each night each member weighs what they could do (answer a wrong, seek an ally, build a bloc, file a bill, take on the Engine)
   and does the thing that matters most to them, or nothing. When two wills meet, the stronger force carries it, measured and
   not rolled: standing, allies, money, and the facts each side actually has. The one they act on answers in their own turn.
   The Engine does the same with its own wants, against Oversight, the charter and the members who push back. ══ */
function wlStore(){ if(!G.wl || G.wl.v !== 1) G.wl = {v:1, reg:{}, why:{}, urge:{}, gain:{}, at:{}, unrest:{}, n:0}; return G.wl; }
function wlKey(a, b){ return String(a && a.id != null ? a.id : a) + ">" + String(b && b.id != null ? b.id : b); }
function wlCast(){ return (G.members || []).filter(m => m && !m.gone && (!m.kind || m.kind === "member") && !m.machine && !(typeof FAITH_FROZEN === "function" && FAITH_FROZEN(m))); }
function wlT(m, k){ return ((m && m.traits) || {})[k] == null ? 50 : m.traits[k]; }
/* how one regards another: the standing tie between them, and what each has actually done to the other */
function wlRegard(a, b){
  if(!a || !b || a === b) return 0;
  if(b === G.you) return clamp((a.rel && a.rel.warmth) || 0, -100, 100);
  let base = 0; try{ base = tieOf(a, b).w || 0; }catch(e){}
  return clamp(base + (wlStore().reg[wlKey(a, b)] || 0), -100, 100);
}
function wlNote(a, b, d, why){
  if(!a || !b || a === b || !d || a === G.you) return; const S = wlStore(), k = wlKey(a, b);
  if(b === G.you){ try{ a.rel.warmth = clamp((a.rel.warmth || 0) + d, -100, 100); }catch(e){} }
  else S.reg[k] = clamp((S.reg[k] || 0) + d, -60, 60);
  if(why && d < 0) S.why[k] = {t:why, d:G.day};
  if(why) try{ remember(a, why, d, Math.abs(d) >= 4); }catch(e){}
}
function wlGain(m, n){ if(!m || m === G.you) return; const S = wlStore(); S.gain[m.id] = (S.gain[m.id] || 0) + n; }
function wlMeans(m){ return (m.influence || 0) + ((m.allies || []).length * 6) + Math.min(30, (m.warchest || 0) / 120) + (m.post ? 12 : 0); }
function wlFit(a, b){ let d = 0; for(const x of AXES) d += Math.abs(((a.pos || {})[x.k] || 0) - ((b.pos || {})[x.k] || 0)); return 50 - d / 4; }
function wlByName(n){ return n ? (G.members || []).find(m => m && m.name === n) || null : null; }
function wlSay(news, t, big){ const S = wlStore(); S.n++; try{ journal(t); }catch(e){} if(news && (S._newsDay !== G.day || S._news < 4)){ if(S._newsDay !== G.day){ S._newsDay = G.day; S._news = 0; } S._news++; news.push(t); } else { try{ if(big) feed(t, "news"); }catch(e){} } }
/* ── what was done to whom: the roll call, the amendments, the President's pen ── */
function wlAfterVote(){
  const s = G.statute && G.statute[0]; if(!s || s._wl) return; s._wl = true;
  const sp = wlByName(s.sponsor);
  if(sp && s.v){ Object.keys(s.v).forEach(id => { const x = byId(+id) || byId(id), v = s.v[id]; if(!x || x === sp || !v) return;
      if(v < 0) wlNote(sp, x, -3, surname(x.name) + " voted against my " + s.title + "."); else wlNote(sp, x, 2); }); }
  if(sp && s.yv) wlNote(sp, G.you, s.yv > 0 ? 3 : -4, s.yv > 0 ? null : "You voted against my " + s.title + ".");
  (s.amends || []).filter(a => a && a.adopted && a.by && /strike/.test(a.what || "")).forEach(a => { const x = wlByName(a.by); if(sp && x && x !== sp) wlNote(sp, x, -4, surname(x.name) + " moved to " + a.what + " of my " + s.title + ", and it carried."); });
  if(sp && s.fate === "carried") wlGain(sp, 25);
  if(s.v) Object.keys(s.v).forEach(id => { const x = byId(+id) || byId(id); if(x && s.v[id] && ((s.v[id] > 0) === (s.fate === "carried"))) wlGain(x, 2); });
}
function wlDeskDay(){
  if(!G.exec || !G.exec.you) return;
  (G.statute || []).slice(0, 20).forEach(s => { if(!s || !s.exec || s._wlDesk) return; s._wlDesk = true; const sp = wlByName(s.sponsor); if(!sp) return;
    if(s.exec.act === "vetoed" || s.exec.act === "pocket") wlNote(sp, G.you, -8, "You vetoed my " + s.title + ".");
    else if(s.exec.act === "signed") wlNote(sp, G.you, 4, "You signed my " + s.title + "."); });
}
/* ── each night, each member weighs what to do, and does the thing that matters most to them ── */
/* a grievance is a wrong they can name: what was done to them, recorded or remembered, not a general dislike */
function wlMemAbout(m, x){ const re = x === G.you ? /^you\b/i : new RegExp("^(" + String(x.name).replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "|" + String(surname(x.name)).replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")\\b"); let g = 0; (m.mem || []).forEach(e => { if(e && e.w < 0 && G.day - (e.d || 0) <= 30 && re.test(String(e.t))) g += e.w; }); return g; }
function wlWorst(m){
  const S = wlStore(); let best = null;
  wlCast().concat(G.you && !G.you.out ? [G.you] : []).forEach(x => { if(x === m) return;
    const grudge = x === G.you ? 0 : Math.min(0, S.reg[wlKey(m, x)] || 0), mem = wlMemAbout(m, x), base = x === G.you ? Math.min(0, (m.rel && m.rel.warmth) || 0) / 2 : Math.min(0, wlRegard(m, x) - grudge) / 4;
    if(!(grudge < 0 || mem < 0) || !wlWhy(m, x)) return;
    let g = grudge + mem + base; if(G.day - (S.at["w" + (x.id != null ? x.id : "you")] || -99) < 4) g *= 0.3;   /* somebody already had their say this week */
    if(!best || g < best.r) best = {t:x, r:g}; });
  return best;
}
function wlWhy(m, t){ const S = wlStore(), k = wlKey(m, t), sp = (S.spent = S.spent || {})[k], w = S.why[k]; if(w && w.t !== sp) return w.t; try{ const re = t === G.you ? /^you\b/i : new RegExp("^(" + String(t.name).replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "|" + String(surname(t.name)).replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")\\b"); const e = (m.mem || []).filter(x => x && x.w < 0 && G.day - (x.d || 0) <= 30 && re.test(String(x.t)) && x.t !== sp).sort((u, v) => u.w - v.w)[0]; return e ? e.t : null; }catch(e){ return null; } }
function wlEngineState(st){ try{ const eco = G.eng && G.eng.eco; if(!eco || !eco.hh) return null; const H = eco.hh.filter(h => h.state === st); return H.length ? H.reduce((a, h) => a + h.stance, 0) / H.length : null; }catch(e){ return null; } }
function wlOptions(m){
  const S = wlStore(), o = [], amb = wlT(m, "ambition"), tmp = wlT(m, "temper"), loy = wlT(m, "loyalty"), dis = wlT(m, "discretion"), con = wlT(m, "conviction");
  const W = wlWorst(m), FN = W && W.t !== G.you ? (((S.feud || {})[[m.id, W.t.id].sort().join("~")] || {}).n || 0) : 0;
  if(W && W.r <= -15) o.push({k:"wrong", t:W.t, v:-W.r * (0.6 + tmp / 100) * Math.pow(0.6, Math.max(0, FN - 1)) + (W.t === G.you ? 6 : 0)});
  const C = wlCast().filter(x => x !== m && (m.allies || []).indexOf(x.id) < 0).map(x => ({x, s:wlFit(m, x) + wlRegard(m, x) / 2})).sort((a, b) => b.s - a.s)[0];
  if(C && C.s >= 15) o.push({k:"court", t:C.x, v:C.s * ((m.allies || []).length < 2 ? 1.2 : 0.4) * (amb / 60)});
  const mutual = (m.allies || []).map(id => byId(id)).filter(a => a && !a.gone && wlRegard(m, a) >= 15 && wlRegard(a, m) >= 15 && !a.bloc);
  if(!m.bloc && mutual.length >= 2) o.push({k:"bloc", v:30 + amb / 3});
  const ax = AXES.slice().sort((x, y) => Math.abs((m.pos || {})[y.k] || 0) - Math.abs((m.pos || {})[x.k] || 0))[0], strong = Math.abs((m.pos || {})[ax.k] || 0);
  const mine = (typeof hopStore === "function" ? hopStore() : []).some(b => b && b.sponsorId === m.id) || (G.bill && !G.bill.done && G.bill.sponsorId === m.id);
  const room = (typeof hopStore === "function" ? hopStore().length : 0) < 12;
  if(!mine && room && amb >= 50 && strong >= 40 && G.day - (S.at["f" + m.id] || -99) >= 30) o.push({k:"file", v:amb * 0.6 + strong * 0.3});
  const es = wlEngineState(m.state); if(es != null && G.eng && G.eng.st >= 2 && Math.abs(es) >= 35 && G.day - (S.at["e" + m.id] || -99) >= 21 && G.day - (S.at["eS" + m.state] || -99) >= 7) o.push({k:"engine", v:Math.abs(es) * 0.8 + con / 3, s:es});
  if(W && W.r <= -15 && (loy >= 65 || dis >= 65 || FN >= 2)) o.push({k:"forgive", t:W.t, v:(loy + dis) / 4 + 5 + FN * 8});
  return o.sort((a, b) => b.v - a.v);
