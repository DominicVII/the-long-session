function wlCampStart(m, news){
  const why = wlWhy(m, G.you), r = {id:m.id, name:m.name, since:G.day, stage:0, next:G.day + 1, heat:Math.min(100, -wlRegard(m, G.you)), answered:0, dug:false, out:null, log:[], hits:0, flat:0, used:[], why};
  G.rivals = G.rivals || []; G.rivals.push(r);
  rivalSay(r, surname(m.name) + " has turned against you" + (why ? ". What started it, in their words: “" + String(why).replace(/\.$/, "") + ".”" : ", and is saying so."), news);
  return r;
}
function wlCampStep(r, news){
  const y = G.you, m = byId(r.id), sn = surname(r.name); r.stage++;
  if(!m || m.gone) return rivalEnd(r, "gone", sn + " is gone from the House, and the quarrel with them.", news);
  const reg = wlRegard(m, y); r.heat = clamp(-reg, 0, 100);
  if(reg > -10) return rivalEnd(r, "truce", sn + " has let it drop; whatever was between you has cooled.", news);
  const facts = wlDamaging(m).filter(f => r.used.indexOf(f.k) < 0), b = G.bill && !G.bill.done ? G.bill : null, outlet = ((G.press || []).filter(p => p && p.outlet).sort((u, v) => (v.trust || 0) - (u.trust || 0))[0] || {}).outlet || "the papers";
  const tmp = wlT(m, "temper"), amb = wlT(m, "ambition");
  const moneyOk = r.used.indexOf("money") < 0 || G.day - (r.moneyAt || 0) >= 30;
  let deed = facts.length && tmp >= 40 ? "record" : b && (b.mine || b.sponsor === y.name || (b.byRequest && b.byRequest.name === y.name)) ? "bill" : moneyOk && (m.warchest || 0) >= 300 && (function(){ try{ return ["house", "senate", "pres", "gov"].indexOf(heldOffice()) >= 0; }catch(e){ return false; } })() ? "money" : "cloak";
  if(deed === "record"){ const f = facts[0]; r.used.push(f.k);
    const force = (m.influence || 0) * 0.6 + (m.allies || []).length * 4 + f.s * 6, resist = (y.approval || 0) * 0.35 + (y.standing || 0) * 0.15 + r.answered * 6 + (r.dug ? 10 : 0), margin = force - resist;
    if(margin > 0){ y.approval = clamp(y.approval - Math.min(5, 1 + margin / 8), 0, 100); r.hits++; rivalSay(r, sn + " took your record to " + outlet + ": " + f.t + ". It is being read.", news); }
    else { r.flat++; rivalSay(r, sn + " went to " + outlet + " with this: " + f.t + ". It did not stick.", news); } }
  else if(deed === "bill"){ let n = 0; wlCast().forEach(x => { if(x === m || n >= 3) return; if(wlRegard(x, m) >= 10){ x.sway = (x.sway || 0) - 4; n++; } });
    if(n){ r.hits++; y.standing = clamp(y.standing - 1, 0, 100); } else r.flat++;
    rivalSay(r, sn + " is working members against the " + b.title + (n ? "; " + n + " of " + surname(m.name) + "'s friends are listening." : "; nobody is listening."), news); }
  else if(deed === "money"){ r.used.push("money"); r.moneyAt = G.day; m.warchest = Math.max(0, (m.warchest || 0) - 200); y.rivalPen = Math.min(8, (y.rivalPen || 0) + 2); r.hits++;
