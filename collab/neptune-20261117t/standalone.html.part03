    wlSay(news, sn + " has formed " + n + " with " + listify(join.map(a => surname(a.name))) + ". They chose it; nobody whipped them into it."); return "bloc";
  },
  file(m, o, news){ wlStore().at["f" + m.id] = G.day; lifeAct(m, {k:"bill"}, news || []); return "file"; },
