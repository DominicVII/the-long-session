function wlNight(news){
  const S = wlStore();
  if(!S.seeded){ S.seeded = G.day; wlCast().forEach(m => { const h = seedOf("wl:" + m.name); S.at["f" + m.id] = G.day - (h % 30); S.at["e" + m.id] = G.day - (h % 21); S.at[m.id] = G.day - (h % 3); }); }   /* everyone did not wake up on the same morning with the same idea */ Object.keys(S.reg).forEach(k => { S.reg[k] = Math.round(S.reg[k] * 0.98 * 10) / 10; if(Math.abs(S.reg[k]) < 0.5) delete S.reg[k]; });
  (G.states || []).forEach(s => { const H = S.unrest[s.n] = S.unrest[s.n] || []; H.push(Math.round(s.unrest || 0)); if(H.length > 7) H.shift(); });
  try{ wlDeskDay(); }catch(e){}
  wlCast().slice().sort((a, b) => wlMeans(b) - wlMeans(a)).forEach(m => { try{ wlMemberDay(m, news); }catch(e){} });
}
/* ── against you: a member who has turned against you decides, each time, how to go at you; you answer in kind ── */
function wlDamaging(m){
  const y = G.you, S = (G.states || []).find(s => s.n === m.state); let K = [];
  try{ K = knKnown(m).filter(x => x && x.e && ((x.e.ids || []).indexOf("you") >= 0 || (x.e.who || []).indexOf(y.name) >= 0 || (x.e.law && x.e.law.yv != null))); }catch(e){ K = []; }
  return K.map(x => { const e = x.e; let s = 0, t = null;
      if(e.law && e.law.yv != null && S){ const lean = dkStateLean(S, {pos:((G.statute || []).find(z => z.title === e.law.title) || {}).pos || {econ:0, lib:0, def:0, wel:0}}); if(lean * e.law.yv < -10){ s = Math.abs(lean) / 10 + 2; t = "you voted " + (e.law.yv > 0 ? "aye" : "no") + " on the " + e.law.title + ", and " + m.state + " wanted the other"; } }
      if(!t && e.law && e.law.sponsor === y.name && /went down|vetoed|struck/.test(e.t)){ s = 4; t = e.t; }
      if(!t && e.kind === "hist" && e.power && (e.ids || []).indexOf("you") >= 0){ s = 5; t = e.t; }
      if(!t && e.kind === "ovr" && /overrode/.test(e.t)){ s = 3; t = e.t; }
      if(!t && e.kind === "secret"){ s = 6; t = e.t; }
      return t ? {k:e.k || e.t, t, s:s * (x.c || 0.5)} : null; }).filter(Boolean).sort((a, b) => b.s - a.s);
