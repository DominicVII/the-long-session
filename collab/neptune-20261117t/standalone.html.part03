    if(yes){ if((m.allies || []).indexOf(t.id) < 0) m.allies = (m.allies || []).concat([t.id]).slice(-5); if((t.allies || []).indexOf(m.id) < 0) t.allies = (t.allies || []).concat([m.id]).slice(-5);
