  L.died.unshift({t:b.title, d:G.day, cmte:R.t, why:"reported unfavourably, " + R.report.aye + " to " + R.report.no + (b.discharge ? "; the discharge petition had " + b.discharge.sig + " of the " + b.discharge.need + " signatures it needed" : ""), sponsor:b.sponsor}); if(L.died.length > 40) L.died.length = 40;
  try{ note("The " + b.title + " dies in the Committee on " + R.t + ", reported unfavourably " + R.report.aye + " to " + R.report.no + ". It will not come to the floor.", true); pushWireScrap("Committee", b.title + " — DIES IN COMMITTEE " + R.report.aye + "–" + R.report.no); }catch(e){}
  /* the next bill takes the floor once this moment has passed, so a roll call in progress never lands on it */
  setTimeout(() => { try{ if(G.bill === b){ G.bill = nextBillOrQueued(); try{ paintTicker(); }catch(e){} } }catch(e){} }, 0);
  return true;
}
