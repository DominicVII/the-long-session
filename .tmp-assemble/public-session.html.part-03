  document.head.appendChild(st);
  function liveProbe(){ const LT = window.onumLiveTalk; if(!LT || typeof LT.reply !== "function"){ TR.live = false; return; }
    if(Date.now() - TR.liveAt < 20000) return; TR.liveAt = Date.now();
    try{ if(typeof LT.available !== "function"){ TR.live = true; return; } Promise.resolve(LT.available()).then(v => { TR.live = !!v; paintChip(); }).catch(() => { TR.live = false; paintChip(); }); }catch(e){ TR.live = false; } }
  function paintChip(){ const c = document.getElementById("tkLive"); if(!c) return; c.className = "tk-chip tk-nonum " + (TR.live ? "live" : "off"); c.textContent = TR.live ? "Live" : "Offline"; c.title = TR.live ? "They answer through LiveTalk" : "They answer from the game itself; nothing is blocked"; }
  function decorate(){
    const T = el("talk"), m = TALK.m; if(!T || !m) return;
    const head = T.querySelector(".talk__head");
    if(head && !document.getElementById("tkTop")){ const d = document.createElement("div"); d.id = "tkTop"; d.className = "tk-top";
      d.innerHTML = '<span id="tkLive" class="tk-chip tk-nonum off">Offline</span><button type="button" id="tkDone" class="tk-done tk-nonum" title="Close the conversation (Esc)">Done (Esc)</button>';
      head.appendChild(d); d.querySelector("#tkDone").onclick = () => { try{ closeTalk(); }catch(e){} }; }
    if(head){ let p = document.getElementById("tkPort"); if(!p){ p = document.createElement("div"); p.id = "tkPort"; p.className = "tk-port"; head.insertBefore(p, head.firstChild); }
      if(p.dataset.id !== String(m.id)){ p.dataset.id = String(m.id); p.innerHTML = "";
        try{ if(window.onumFamilyTree && typeof onumFamilyTree.portrait === "function"){ const c = onumFamilyTree.portrait(m.id, null, 96); if(c) p.appendChild(c); } }catch(e){}
        if(!p.firstChild) p.textContent = String(m.name || "?").split(/\s+/).map(w => w[0] || "").join("").slice(0, 2).toUpperCase(); } }
    liveProbe(); paintChip();
    const own = el("tkOwn"); T.classList.toggle("tk-one", !!(own && !own.hidden));
    try{ const H = TALK.huddle, meta = el("tkMeta"); if(H && meta && !meta.querySelector(".pin--with")){ const s = document.createElement("span"); s.className = "pin pin--with"; s.textContent = "with " + surname(H.o.name); meta.appendChild(s); } }catch(e){}
    /* 20261030g: secondary actions behind a labelled More. Primary = first four + every exit (+ every answer while a question is put).
       Works on the regrouped .tkg sections; the More button sits in its own row at the top of the actions so it is never clipped. */
    try{ const box = el("tkActs"); if(box){ T.querySelectorAll(".tk-morerow").forEach(x => x.remove());
      const bs = [...box.querySelectorAll(".talk__btn")]; bs.forEach(b => b.classList.remove("tk-x")); box.querySelectorAll(".tkg").forEach(g => g.classList.remove("tkg-x"));
      const answering = !!(TALK.thread && (TALK.beat === 0 || TALK.beat === 1));
      const extra = answering ? [] : bs.filter(b => !b.classList.contains("talk__btn--exit")).slice(4);
      if(extra.length >= 1){ extra.forEach(b => b.classList.add("tk-x"));
        box.querySelectorAll(".tkg").forEach(g => { const gb = [...g.querySelectorAll(".talk__btn")]; if(gb.length && gb.every(b => b.classList.contains("tk-x"))) g.classList.add("tkg-x"); });
        const row = document.createElement("div"); row.className = "tk-morerow tk-nonum";
        const mb = document.createElement("button"); mb.type = "button"; mb.id = "tkMore"; mb.className = "tk-morebtn tk-nonum"; mb.setAttribute("aria-expanded", TR.moreOpen ? "true" : "false");
        mb.textContent = TR.moreOpen ? "Less \u25B4" : "More \u25BE (" + extra.length + ")"; mb.title = TR.moreOpen ? "Hide the other things you can do" : "Other things you can do here";
        mb.onclick = ev => { try{ ev.preventDefault(); ev.stopPropagation(); }catch(x){} TR.moreOpen = !TR.moreOpen; decorate(); try{ picksDirty = true; }catch(e){} };
        row.appendChild(mb); const top = document.getElementById("tkTop"); if(top) top.insertBefore(row, top.firstChild); else box.insertBefore(row, box.firstChild); }
      T.classList.toggle("tk-more", !!TR.moreOpen && extra.length > 0); } }catch(e){}
    try{ fitTalk(); }catch(e){}
    try{ picksDirty = true; }catch(e){}
  }
  TR.decorate = decorate;
  /* 20261030g: the open talk panel ends above the Say aloud bar (hmBar), so its actions are never under it */
  function fitTalk(){ const T = el("talk"); if(!T) return; if(!T.classList.contains("is-open")){ T.style.removeProperty("bottom"); return; }
    T.style.removeProperty("bottom"); const tr = T.getBoundingClientRect(); let top = Infinity;
    /* the Say aloud bar and any fixed strip docked along the bottom (the wire) */
    [document.getElementById("hmBar"), ...document.querySelectorAll("body > *")].forEach(e => { try{ if(!e || e === T || T.contains(e) || e.contains(T) || e.hidden) return; const cs = getComputedStyle(e); if(cs.display === "none" || cs.visibility === "hidden" || cs.position !== "fixed") return;
      const r = e.getBoundingClientRect(); if(r.height > 0 && r.height < 90 && r.width > innerWidth * 0.5 && r.top > innerHeight * 0.75) top = Math.min(top, r.top); }catch(x){} });
    if(!isFinite(top)) return; const ov = Math.ceil(tr.bottom - top + 6);
    if(ov > 0) T.style.setProperty("bottom", ov + "px", "important"); }
  TR.fitTalk = fitTalk; addEventListener("resize", () => { try{ fitTalk(); }catch(e){} });
  { const _rt = renderTalk; renderTalk = function(){ const r = _rt.apply(this, arguments); try{ if(TALK.open) decorate(); }catch(e){} return r; }; }
  /* Esc in the in-talk wire closes like Esc anywhere else; Enter (not typing) puts you in the reply box */
  /* 20261030g: one Esc closes the talk, even with the reply box or the wire focused. Capture phase, only while talk is open and no
     modal card (veil) is over it; when talk is closed Esc is untouched for every other panel. */
  addEventListener("keydown", e => { try{ if(e.key !== "Escape" || !TALK.open) return;
      if(typeof veil !== "undefined" && veil && !veil.hidden && !veil.classList.contains("sitx")) return;
      const t = el("talk"); if(!t || !t.classList.contains("is-open")) return;
      e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
      try{ const a = document.activeElement; if(a && a !== document.body && a.blur) a.blur(); }catch(x){}
      closeTalk(); }catch(x){} }, true);
  addEventListener("keydown", e => { try{ if(e.key !== "Enter" || e.ctrlKey || e.metaKey || e.altKey || !TALK.open || typingInField(e)) return; if(typeof veil !== "undefined" && !veil.hidden) return; const i = el("tkOwnIn"); if(i && !el("tkOwn").hidden){ e.preventDefault(); i.focus(); } }catch(x){} });
  /* ghost-state watchdog: the flag and the panel always agree */
  setInterval(() => { try{ const t = el("talk"); if(!t) return; const on = t.classList.contains("is-open");
      if(TALK.open && (!on || !TALK.m || TALK.m.gone)) closeTalk(); else if(!TALK.open && on) closeTalk(); }catch(e){} }, 1000);
  /* ---- the floor desk: Pass / Interject / Raise hand, the chair's call-on row, press hands, Space finishes lines ---- */
  const OSc = (k, ...a) => { try{ const O = window.onumSession; return O && typeof O[k] === "function" ? O[k].apply(O, a) : undefined; }catch(e){ return undefined; } };
  const isMe = x => x === "you" || sv(() => G.you && String(x) === String(G.you.id));
  function deskTick(){ try{
      const D = document.getElementById("ndFd"), dock = document.getElementById("sxDock"); const on = !!(D && !D.hidden && getComputedStyle(D).display !== "none");
      if(dock) dock.classList.toggle("fd-on", on);
      if(dock && on){ try{ const hb = document.getElementById("hmBar"); const hv = hb && !hb.hidden && getComputedStyle(hb).display !== "none"; dock.style.setProperty("--fdB", (hv ? Math.ceil(innerHeight - hb.getBoundingClientRect().top + 6) : 8) + "px"); }catch(e){} }
      if(!on) return;
      const S = window.ONUM_SESSION || {}, body = D.querySelector(".fd-body"); if(!body) return;
      let A = D.querySelector(".fd-acts"); if(!A){ A = document.createElement("div"); A.className = "fd-acts"; /* 20261030h: above the reply box so the band never clips it */ const t0 = body.querySelector("textarea"); if(t0) t0.parentNode.insertBefore(A, t0); else body.insertBefore(A, body.firstChild); }
      /* 20261030j: reply box and Cancel/Speak on one row, so the last controls clear the wire without a dock scroll */
      try{ const t1 = body.querySelector(":scope>textarea"), r1 = body.querySelector(":scope>.fd-row"); if(t1 && r1 && !t1.closest(".fd-reply")){ const w = document.createElement("div"); w.className = "fd-reply"; t1.parentNode.insertBefore(w, t1); w.appendChild(t1); w.appendChild(r1); } }catch(e){}
      const turn = isMe(S.floorId) || isMe(S.offer), chair = S.chairId === "you", fl = S.floorId != null && !isMe(S.floorId), press = /press/.test(String(S.kind || ""));
      const q = (Array.isArray(S.queue) ? S.queue : []).filter(x => !isMe(x));
      const sig = [turn, chair, fl, press, q.join(","), !!S.held].join("|"); if(A.dataset.sig === sig) return; A.dataset.sig = sig;
      const ta = D.querySelector("textarea"), nm = id => { const p = sv(() => byId(isNaN(+id) ? id : +id)); return p && p.name ? String(p.name).split(/\s+/).slice(-1)[0] : String(id); };
      let h = "";
      if(chair) h += '<span class="fd-chair">You chair</span>';
      /* 20261030h: in the chair, Pass / Interject / Call on next are always on the desk (greyed when they do not apply) */
      const OSf = k => typeof (window.onumSession || {})[k] === "function", dis = (ok, why) => ok ? "" : ' disabled title="' + why + '"';
      if(turn || (chair && OSf("pass"))) h += '<button type="button" class="fd-pass"' + (OSf("pass") ? (turn ? ' title="Give up your turn"' : dis(false, "Not your turn")) : dis(false, "Not available")) + '>Pass</button>';
      if(fl || (chair && OSf("interject"))) h += '<button type="button" class="fd-ij"' + (OSf("interject") ? (fl ? ' title="A word from your seat; it never takes the floor"' : dis(false, "Nobody else has the floor")) : dis(false, "Not available")) + '>Interject</button>';
      if(chair && OSf("callon")) h += '<button type="button" class="fd-next1"' + (q.length ? ' title="Give the floor to the next hand"' : dis(false, "No hands up")) + '>Call on next' + (q.length ? ": " + String(nm(q[0])).replace(/[<>&"]/g, "") : "") + '</button>';
      A.innerHTML = h;
      const b1 = A.querySelector(".fd-pass"); if(b1) b1.onclick = () => { if(ta) ta.value = ""; OSc("hold", false); OSc("pass"); };
      const b2 = A.querySelector(".fd-ij"); if(b2) b2.onclick = () => { const t = ta ? ta.value.trim() : ""; const r = OSc("interject", t || "Point of order!", t ? "heckle" : "point_of_order"); if(ta && r && r.ok){ ta.value = ""; OSc("hold", false); }
        try{ window.NEPTUNE_FLOORDESK.line("you", r && r.ok ? (t || "Point of order!") : "(not yet: " + ((r && r.reason) || "the chair did not hear it") + ")", !(r && r.ok)); }catch(e){} };
      const b3 = A.querySelector(".fd-next1"); if(b3) b3.onclick = () => OSc("callon", q[0]);
      /* press conference: raised hands as a pick row; the question waits for you */
      let H = D.querySelector(".fd-hands"); if(press && chair && q.length){ if(!H){ H = document.createElement("div"); H.className = "fd-hands"; A.parentNode.insertBefore(H, A); }
        H.innerHTML = "<b>Hands up</b>" + q.slice(0, 8).map(id => '<button type="button" data-hand="' + String(id).replace(/"/g, "") + '">' + String(nm(id)).replace(/[<>&"]/g, "") + '</button>').join("");
        H.querySelectorAll("[data-hand]").forEach(b => b.onclick = () => { if(OSc("callon", b.getAttribute("data-hand")) === undefined){ try{ console.warn("press: onumSession.callon missing (JUPITER)"); }catch(e){} } }); }
      else if(H) H.remove();
    }catch(e){} }
  setInterval(deskTick, 400);
  /* 20261030g: a "stops you" toast offers no Talk while a sitting/procedure/session owns the conversation (openTalk would refuse it) */
  setInterval(() => { try{ const w = document.getElementById("apToast"); if(!w) return; const b = w.querySelector('[data-ap="talk"]'); if(!b) return;
      const busy = !!window.onumTalkOwner(); if(b.hidden !== busy){ b.hidden = busy; b.style.display = busy ? "none" : ""; } }catch(e){} }, 250); addEventListener("onum-session", () => setTimeout(deskTick, 0));
  addEventListener("keydown", e => { try{ if(e.key !== " " || typingInField(e)) return; const D = document.getElementById("ndFd"); if(!D || D.hidden) return;
      const un = [...D.querySelectorAll(".fd-l")].filter(l => l._full && !l._done && l.querySelector(".t") && l.querySelector(".t").textContent !== l._full); if(!un.length) return;
      e.preventDefault(); e.stopImmediatePropagation(); un.forEach(l => { l._done = true; l.querySelector(".t").textContent = l._full; }); }catch(x){} }, true);
  console.log("NEPTUNE talk rework ready");
}catch(e){ try{ console.warn("NEPTUNE-TALKREWORK", e); }catch(x){} }
/* NEPTUNE-TALKREWORK END */

/* ══ 20261025i · THE ROAD A BILL TRAVELS. A bill is referred to the committee whose field it mostly touches; the committee's
   members offer amendments in markup (to strike the section they mind most, to cut the money) and vote on them and on the
   report, and you vote with them when you sit there. What the House carries goes to the Senate, voted seat by seat in the
   same reckoning the docket shows, the Vice President breaking a tie, before it can reach the President. Acts passed on the
   towns' petitions enter the statute book with the petitions as their text, and the bills before the state legislatures are
   written out as law too. ══ */
const LX_CM_AX = {econ:"ways", lib:"judic", def:"armed", wel:"health"};
function lxNoise(a, b){ return knH(a, b) - 0.5; }
function lxRoad(b){
  if(!b || b.done || !b.title || !b.pos) return null;
  if(b.road) return b.road;
  const ax = ["econ", "lib", "def", "wel"].sort((u, v) => Math.abs(b.pos[v] || 0) - Math.abs(b.pos[u] || 0))[0];
  const k = (b.domain && lxCmDom(b.domain)) || (b.kind === "immig" ? "judic" : null) || LX_CM_AX[ax] || "ways", c = COMMITTEES.find(x => x.k === k) || COMMITTEES[0], ch = (function(){ try{ return cmtChair(k); }catch(e){ return null; } })();
  const R = b.road = {cmte:k, t:c.t, chair:ch ? ch.name : null, ref:G.day, mark:Math.max(G.day, (b.voteDay || G.day + 2) - 1), props:[], done:false};
  const mem = (function(){ try{ return cmtMembers(k).filter(m => m && !m.gone); }catch(e){ return []; } })();
  let D = null; try{ D = lxDoc(b); }catch(e){}
  const ops = D ? D.secs.filter(x => x.k === "op" && !/^a first call|^the whole of it/.test(x.clause || "")) : [];
  const conv = m => (m.traits && m.traits.conviction) || 50;
  const opp = mem.filter(m => alignment(m, b) < -8).sort((u, v) => conv(v) - conv(u));
  if(opp[0] && ops.length){ const x = ops.slice().sort((u, v) => ((v.claim && v.claim[2]) || 0) - ((u.claim && u.claim[2]) || 0) || v.n - u.n)[0];
    R.props.push({k:"strike", ci:x.ci, sec:x.n, head:x.short || x.head, by:opp[0].name, byId:opp[0].id}); }
  const hawk = mem.filter(m => m.pos && m.pos.econ > 20 && alignment(m, b) < 10 && (!opp[0] || m !== opp[0])).sort((u, v) => v.pos.econ - u.pos.econ)[0];
  if(hawk && b.cost && !b.soft) R.props.push({k:"cut", by:hawk.name, byId:hawk.id});
  return R;
}
/* the committee votes: the members the game names, you if you sit there, and the committee's other seats by their party's line */
function lxCmVote(b, score, line, youVote){
  const R = b.road, named = (function(){ try{ return cmtMembers(R.cmte).filter(m => m && !m.gone); }catch(e){ return []; } })();
  const y = G.you, youOn = !!(y && y.committee === R.cmte && (function(){ try{ return heldOffice() === "house"; }catch(e){ return false; } })());
  let aye = 0, no = 0; const by = {};
