/* ══ 20261025j · AMENDMENTS ARE VOTED, AND THE BENCH KEEPS ITS REPORTS. An amendment moved on the floor (yours from the docket,
   or a member's before the final vote) is put to the House and decided by its count: the named members by where they stand
   and their party, the other seats by their party's line; only an adopted amendment changes the text. The statute book has
   a second shelf, the reports of the high bench: every ruling with its holding, its count, its author and its dissent. ══ */
function lxHouseVote(b, scoreNamed, lineOf, youVote){
  let aye = 0, no = 0; const by = {};
  (G.members || []).filter(m => m && !m.gone && (!m.kind || m.kind === "member")).forEach(m => { const v = scoreNamed(m) > 0 ? 1 : -1; by[m.id] = v; v > 0 ? aye++ : no++; });
  const L2 = {}; Object.keys(G.seatsBy || {}).forEach(p => { L2[p] = lineOf(p); });
  const neg = {pos:{}}; Object.keys(b.pos || {}).forEach(k => { neg.pos[k] = -(b.pos[k] || 0); });
  const bg = tallyBackground(neg, backgroundSeats(), L2); aye += bg.aye; no += bg.no;
  if(youVote === 1 || youVote === -1){ youVote > 0 ? aye++ : no++; }
  return {aye, no, by};
}
/* a weakening amendment: those against the bill are for it, the sponsor's side against it, the parties by their line on the bill turned round */
function lxFloorAmend(b, p, youVote){
  const key = b.title + ":fl:" + (p.k === "strike" ? p.ci : "cut") + ":" + p.by, L = partyLine(b);
  const v = lxHouseVote(b, m => (m.name === p.by ? 50 : 0) - lxFit(m, b) * 0.6 + (m.party === b.sponsorParty ? -15 : 6) + lxNoise(m.id, key) * 20, pt => -(L[pt] || 0), youVote);
  const n = (b.clauses || []).length || 3, ok = v.aye > v.no;
  if(ok){ if(p.k === "strike"){ b.strk = b.strk || []; if(b.strk.indexOf(p.ci) < 0) b.strk.push(p.ci); if(b.pos) Object.keys(b.pos).forEach(k => b.pos[k] = Math.round(b.pos[k] * (1 - 0.5 / n))); }
    else { b.soft = true; if(b.pos) Object.keys(b.pos).forEach(k => b.pos[k] = Math.round(b.pos[k] * 0.8)); } }
  const what = p.k === "strike" ? "strike section " + p.sec + " (" + String(p.head).toLowerCase() + ")" : "cut the appropriation by a third";
  (b.amends = b.amends || []).push({d:G.day, by:p.by, what, aye:v.aye, no:v.no, adopted:ok, where:"floor"});
  try{ LX.docs.delete(lxKey(b)); }catch(e){}
  return {ok, aye:v.aye, no:v.no, what};
}
function lxInHouse(){ try{ return inHouse(); }catch(e){ return false; } }
/* your amendments from the docket go to a vote */
{ const _ds2 = dkStrike; dkStrike = function(it, i){ const b = dkBillRef(it);
  if(i >= 100 && b && b === G.bill && !b.done){ if(!lxInHouse()) return "Only a member of the House can move an amendment on its floor.";
    if((G.you.influence || 0) < 2) return "Moving an amendment costs 2 influence.";
    const ci = i - 100, D = lxDoc(b), x = D && D.secs.find(s => s.k === "op" && s.ci === ci); if(!x) return "";
    if((b.amends || []).some(a => a.where === "floor" && a.by === G.you.name && a.what.indexOf("section " + x.n + " ") >= 0)) return "You have moved that once already; the House has answered.";
    G.you.influence = clamp((G.you.influence || 0) - 2, 0, 100);
    const r = lxFloorAmend(b, {k:"strike", ci, sec:x.n, head:x.short || x.head, by:G.you.name}, 1);
    try{ feed("Your amendment to " + r.what + " of the " + b.title + " is " + (r.ok ? "adopted" : "rejected") + ", " + r.aye + " to " + r.no + ".", r.ok ? "good" : "bad"); }catch(e){}
    if(!r.ok) G.you.standing = clamp((G.you.standing || 0) - 1, 0, 100);
    return "The House divides on your amendment to " + r.what + ": " + (r.ok ? "adopted" : "rejected") + ", " + r.aye + " to " + r.no + "." + (r.ok ? " The text that goes to the vote no longer has it." : " The text stands as reported."); }
  return _ds2.apply(this, arguments); }; }
{ const _da2 = dkAmend; dkAmend = function(it){ const b = dkBillRef(it);
  if(b && b === G.bill && !b.done && b.cost && !b.soft){ if(!lxInHouse()) return "Only a member of the House can move an amendment on its floor.";
    const r = lxFloorAmend(b, {k:"cut", by:G.you.name}, 1);
    try{ feed("Your amendment to " + r.what + " of the " + b.title + " is " + (r.ok ? "adopted" : "rejected") + ", " + r.aye + " to " + r.no + ".", r.ok ? "good" : "bad"); }catch(e){}
    return "The House divides on your amendment to " + r.what + ": " + (r.ok ? "adopted" : "rejected") + ", " + r.aye + " to " + r.no + "."; }
  return _da2.apply(this, arguments); }; }
/* the strike buttons are only for those who can move them */
{ const _dc4 = dkClauseHTML; dkClauseHTML = function(it){ let h = _dc4.apply(this, arguments); try{ if(!lxInHouse()) h = h.replace(/ <button type="button" class="btn btn--ghost" style="padding:1px 6px;font-size:11px" data-dk(strike|amend)="[^"]*">[^<]*<\/button>/g, ""); }catch(e){} return h; }; }
/* before the final vote, a member who opposes the bill may move to strike what they mind most */
{ const _hv4 = holdVote; holdVote = function(){ const b = G.bill;
  try{ if(b && !b.done){ lxRoad(b); if(b.road && !b.road.done) lxMarkup(b); } }catch(e){}
  try{ if(b && !b.done && !b.flDone){ b.flDone = true; const D = lxDoc(b), ops = D ? D.secs.filter(x => x.k === "op" && !x.struckAmend && !/^a first call|^the whole of it/.test(x.clause || "")) : [];
      const opp = (G.members || []).filter(m => m && !m.gone && alignment(m, b) < -15).sort((u, v) => alignment(u, b) - alignment(v, b))[0];
      if(opp && ops.length && knH(b.title, "floor") < 0.6){ const x = ops.slice().sort((u, v) => ((v.claim && v.claim[2]) || 0) - ((u.claim && u.claim[2]) || 0) || v.n - u.n)[0];
        const r = lxFloorAmend(b, {k:"strike", ci:x.ci, sec:x.n, head:x.short || x.head, by:opp.name}, lxInHouse() ? (alignment(G.you, b) < 0 ? 1 : -1) : null);
        try{ const line = "Before the final vote, " + opp.name + " moves to " + r.what + " of the " + b.title + ": " + (r.ok ? "adopted" : "rejected") + ", " + r.aye + " to " + r.no + "."; feed(line, "news"); journal(line); }catch(e){} } } }catch(e){}
  return _hv4.apply(this, arguments); }; }
/* the reports of the high bench */
function lxReportsHTML(){
  const C = (G.cases || []).filter(c => c && c.done && c.lx && c.lx.held).sort((u, v) => (v.dday || v.day) - (u.dday || u.day));
  const P = (G.cases || []).filter(c => c && !c.done && c.lx);
  return '<div class="eyebrow">The reports of the high bench</div><h1>Every ruling on an act of Congress</h1><p class="muted">What was challenged, on what ground, how the bench divided, who wrote for it and who dissented. Later benches cite these.</p>' +
    '<div class="card__actions" style="justify-content:flex-start"><button type="button" class="btn btn--ghost" style="padding:3px 9px;font-size:12px" data-lxbook="all">Back to the acts</button></div>' +
    (P.length ? '<div class="eyebrow" style="margin-top:8px">Pending</div>' + P.map(c => '<div class="muted" style="font-size:13px;margin:3px 0">· <b>' + pcEsc(c.t) + '</b>, filed day ' + c.day + ': section ' + c.lx.sec + ' (' + pcEsc(String(c.lx.head).toLowerCase()) + '), on ' + pcEsc(LX_TH[c.lx.th].t) + '.</div>').join("") : '') +
    (C.length ? C.map(c => '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid ' + (c.lx.held === "struck" ? "#a33" : "#3a7") + '"><b>' + pcEsc(c.t) + '</b> <span class="muted" style="font-size:12px">· decided day ' + (c.dday || "?") + ' · ' + pcEsc(c.lx.count || "") + ' · ' + (c.lx.held === "struck" ? "section " + c.lx.sec + " struck" : "upheld") + ' · on ' + pcEsc(LX_TH[c.lx.th].t) + '</span><div style="font-size:13px;margin-top:3px">' + pcEsc(c.lx.op || "") + '</div><button type="button" class="btn btn--ghost" style="padding:2px 8px;font-size:12px;margin-top:3px" data-lxopen="' + pcEsc((c.lx.aday != null ? c.lx.aday : "") + ":" + c.lx.act) + '">Read the ' + pcEsc(c.lx.act) + ' ▸</button></div>').join("") : '<p class="muted">No act of Congress has been decided by the bench yet.</p>') +
    '<div class="card__actions"><button type="button" class="btn btn--ghost" id="lxClose">Close</button></div>';
}
{ const _lb = lxBook; lxBook = function(f){ if(f === "cases"){ lxOpen(lxReportsHTML()); return; } _lb.apply(this, arguments); try{ const C = document.getElementById("lxCardEl"); const row = C && C.querySelector(".card__actions"); if(row && !row.querySelector('[data-lxbook="cases"]')){ const b = document.createElement("button"); b.type = "button"; b.className = "btn btn--ghost"; b.style.cssText = "padding:3px 9px;font-size:12px"; b.setAttribute("data-lxbook", "cases"); b.textContent = "Rulings of the bench " + (G.cases || []).filter(c => c && c.done && c.lx && c.lx.held).length; row.appendChild(b); } }catch(e){} }; }
window.onumStatute.rulings = () => (G.cases || []).filter(c => c && c.done && c.lx && c.lx.held).map(c => ({case:c.t, decided:c.dday || null, act:c.lx.act, section:c.lx.sec, ground:LX_TH[c.lx.th].t, held:c.lx.held, count:c.lx.count, opinion:c.lx.op}));

/* ══ 20261027a · ONE PERSON, ONE NUMBER. The counter that numbers people was never saved, so every load started again at 1 and
   new people were given numbers already in use: a governor's number was a House member's, and whoever was looked up first
   answered for both. Now the counter is saved; on load, any civilian sharing a number is given its own (House members, the
   press and the player keep theirs; sitting officials keep theirs before retired ones); the official who stands for each
   state's governor, each power's leader and envoy and each counterpart is matched to the record by name, a stale one retiring
   into a former title; and ledger entries that only existed because two people shared a number are struck. ══ */
const IDM = {last:null};
function idRank(c){ const k = String(c.scKey || ""); return /^former:/.test(k) ? 2 : k ? 0 : 1; }
function idMend(){
  const R = {renum:0, retired:0, renamed:0, ledger:0, max:0};
  const fixed = [].concat(G.members || [], G.press || []).filter(Boolean), taken = new Set(fixed.map(p => p.id));
  if(G.you && G.you.id != null) taken.add(G.you.id);
  const civ = (G.civ || []).filter(Boolean), moved = [];
  civ.slice().sort((a, b) => idRank(a) - idRank(b)).forEach(c => { if(c.id == null || taken.has(c.id)) moved.push(c); else taken.add(c.id); });
  let max = Math.max(0, G.uidNext || 0); fixed.concat(civ).forEach(p => { if(typeof p.id === "number" && p.id > max) max = p.id; }); if(G.you && typeof G.you.id === "number") max = Math.max(max, G.you.id);
  moved.forEach(c => { c._oldId = c.id; c.id = ++max; R.renum++; });
  uid = Math.max(uid, max + 1); R.max = max;
  try{ _allCache = null; }catch(e){}
  /* the record decides who holds each office; a stale embodied official retires */
  try{ const n0 = (G.civ || []).length; scLeaders(); R.retired += Math.max(0, (G.civ || []).length - n0); }catch(e){}
  try{ if(G.sc && G.sc.cp) cpEnsure(); }catch(e){}
  /* each governor's seat in the ledger is set to the governor the state's record names; the record never said when the change came, so neither does the ledger */
  try{ const SL = ofhEnsure(), st = (G.sc && G.sc.st) || {}; Object.keys(st).forEach(n => { const s = st[n], R = SL.seats["gov:" + n]; if(!R || !s || !s.gov || s.youGov) return; const H = R.holders, last = H[H.length - 1];
      if(last && last.personId === "you" && last.to == null) return;
      if(last && last.name === s.gov){ if(last.to != null){ last.to = null; last.how = null; last.successor = null; } last.personId = s.govId; R.vacantSince = null; return; }
      if(last && last.to == null){ last.toUnknown = true; last.to = G.day; last.how = null; last.successor = s.gov; }
      H.push({personId:s.govId, name:s.gov, from:null, fromUnknown:true, to:null, how:null, successor:null, after:last ? last.name : null}); R.vacantSince = null; R.miss = 0; R.ledgerSet = (R.ledgerSet || 0) + 1; }); }catch(e){}
  /* ledger entries that belong to nobody: a sitting House member recorded in another office under a shared number */
  try{ const S = ofhEnsure(), mem = new Map((G.members || []).filter(m => m && !m.gone).map(m => [m.id, m]));
    Object.keys(S.seats).forEach(k => { if(/^house:/.test(k)) return; const Rr = S.seats[k], n = Rr.holders.length;
      Rr.holders = Rr.holders.filter(h => { const m = typeof h.personId === "number" ? mem.get(h.personId) : null; return !(m && m.name === h.name); });
      Rr.holders.forEach(h => { const c = moved.find(x => x._oldId === h.personId && x.name === h.name); if(c) h.personId = c.id; });
      if(Rr.holders.length !== n){ R.ledger += n - Rr.holders.length; Rr.holders.forEach((h, i) => { const nx = Rr.holders[i + 1]; if(h.to != null) h.successor = nx ? nx.name : h.successor; }); } }); }catch(e){}
  moved.forEach(c => { delete c._oldId; });
  IDM.last = R; IDM.fresh = R.renum > 0 || R.retired > 0 || R.ledger > 0; return R;
}
/* a new governor, leader or envoy is a new person: the old one retires into a former title; a counterpart is renamed with its title */
{ const _sp = scPerson; scPerson = function(key, name, title, home){ try{ const p = (G.civ || []).find(c => c && c.scKey === key && !c.gone);
    if(p && name && p.name !== name){ if(/^(gov|lead|env):/.test(key)){ p.scKey = "former:" + key; p.formerOf = p.formerOf || p.role || title; p.role = "Former " + String(p.role || title || "official").replace(/^Former /, ""); }
      else if(/^cp:/.test(key)){ p.name = name; if(title) p.role = title; } } }catch(e){} return _sp.apply(this, arguments); }; }
{ const _scb5 = saveCaptureBase; saveCaptureBase = function(){ const o = _scb5.apply(this, arguments); try{ o.uidNext = uid; }catch(e){} return o; }; }
/* the first ledger pass after a repair records the corrected holders without a date: the record never said when they took office, and it was not today */
{ const _osI = ofhSync; ofhSync = function(){ let pre = null; try{ if(IDM.fresh){ const S0 = ofhEnsure(); pre = {}; Object.keys(S0.seats).forEach(k => { pre[k] = S0.seats[k].holders.length; }); } }catch(e){} const r = _osI.apply(this, arguments);
  try{ if(pre){ IDM.fresh = false; const S = ofhEnsure(); Object.keys(pre).forEach(k => { const R = S.seats[k]; if(!R) return; for(let i = pre[k]; i < R.holders.length; i++){ const h = R.holders[i]; if(h.from === G.day && !h.newSeat){ h.from = null; h.fromUnknown = true; delete h.afterVacancy; const p = R.holders[i - 1]; if(p && p.to === G.day){ p.to = null; p.toUnknown = true; p.how = null; } } } }); } }catch(e){} return r; }; }
window.onumIdentity = () => { const seen = new Map(), dup = []; [].concat(G.members || [], G.press || [], G.civ || []).forEach(p => { if(!p) return; if(seen.has(p.id)) dup.push([p.id, seen.get(p.id), p.name]); else seen.set(p.id, p.name); }); return {people:seen.size, duplicates:dup.length, sample:dup.slice(0, 5), next:uid, lastMend:IDM.last}; };

/* ══ 20261027a · THE NUMBERS ADD UP. An office held for a fixed term (Governor two Congresses, Senator three, President two,
   the bench four) is not on the ballot until its term is out, and standing again for it is a re-election, not a new office.
   The House has one size: every party has at least as many seats as it has named members, the States are apportioned that
   size by population, and an election swings the seats nobody names as well as the ones on the board. Approval, influence
   and standing are pulled back toward what the country, the office and the party would give anyone, and the papers print a
   poll with its margin. The Republic's relations with each power are one figure, whether the war map or the envoys move it. ══ */
function ofcSince(){
  const y = G.you; let k = null; try{ k = heldOffice(); }catch(e){} if(!y || !k || k === "house") return null;
  if(y.officeSince) return y.officeSince;
  if(k === "pres" && G.exec && G.exec.you && G.exec.since) return G.exec.since;
  const sh = OFFICES[k] && OFFICES[k].short, w = (G.career || []).filter(c => c && c.post === sh && /^(won|re-elected)/.test(c.note || "")).map(c => c.term + 1);
  return w.length ? Math.max.apply(null, w) : null;
}
function ofcMidTerm(){ let k = null; try{ k = heldOffice(); }catch(e){} if(!k || k === "house" || !OFFICES[k]) return false; const s = ofcSince(); if(s == null) return false; return (G.term - s + 1) < (OFFICES[k].term || 1); }
function seatNamed(){ const n = {}; (G.members || []).filter(m => m && !m.gone && m.kind === "member").forEach(m => { n[m.party] = (n[m.party] || 0) + 1; }); try{ if(G.you && inHouse() && !G.you.out) n[G.you.party] = (n[G.you.party] || 0) + 1; }catch(e){} return n; }
/* one House: no party below its named members, the States apportioned to its size by population (largest remainder, at least one each) */
function seatMend(){
  const S = G.seatsBy; if(!S) return null; const named = seatNamed(); let ch = 0;
  try{ const y = G.you; if(y && y.party){ if(inHouse()) y.seatGiven = false;
      else if(!y.seatGiven && (G.members || []).some(m => m && !m.gone && m.kind === "member" && m.state === y.state && String(m.dist) === String(y.dist))){ S[y.party] = Math.max(named[y.party] || 0, (S[y.party] || 0) - 1); y.seatGiven = true; ch++; } } }catch(e){}
  Object.keys(named).forEach(p => { if((S[p] || 0) < named[p]){ S[p] = named[p]; ch++; } });
  Object.keys(S).forEach(p => { if(!(S[p] >= 0)){ S[p] = named[p] || 0; ch++; } });
  const N = Object.keys(S).reduce((a, p) => a + (S[p] || 0), 0); G.seats = N;
  const st = (G.states || []).filter(s => s && !s.gone);
  if(st.length && N >= st.length){ const pop = st.reduce((a, s) => a + Math.max(0.1, s.pop || 1), 0); const q = st.map(s => { const x = (Math.max(0.1, s.pop || 1) / pop) * N; return {s, f:Math.max(1, Math.floor(x)), r:x - Math.floor(x)}; });
    let left = N - q.reduce((a, o) => a + o.f, 0); q.slice().sort((a, b) => b.r - a.r).forEach(o => { if(left > 0){ o.f++; left--; } });
    while(left < 0){ const o = q.filter(o => o.f > 1).sort((a, b) => a.r - b.r)[0]; if(!o) break; o.f--; left++; }
    q.forEach(o => { if(o.s.seats !== o.f){ o.s.seats = o.f; ch++; } }); }
  return {N, ch};
}
/* the unnamed seats swing with the country: a third of the losing side's unnamed seats are marginal, and they fall in proportion to the swing */
function seatSwing(swing){
  seatMend(); const S = G.seatsBy, named = seatNamed(), win = swing > 0 ? "FED" : "COM", lose = win === "FED" ? "COM" : "FED";
  const free = Math.max(0, (S[lose] || 0) - (named[lose] || 0)), n = Math.round(free * 0.35 * Math.min(1, Math.abs(swing || 0) / 50));
  if(n > 0){ S[lose] -= n; S[win] = (S[win] || 0) + n; }
  seatMend(); G.lastSwing = {d:G.day, n, from:lose, to:win}; return G.lastSwing;
}
/* a House win was written down beside every other win; the House seat is only recorded when it was the race */
function careerMend(){
  const C = G.career; if(!Array.isArray(C)) return 0; const wonT = new Set(C.filter(c => c && /^won/.test(c.note || "") && c.post !== "Representative").map(c => c.term));
  const n = C.length; G.career = C.filter(c => !(c && /^held by/.test(c.note || "") && wonT.has(c.term)));
  const first = C.filter(c => c && /^won/.test(c.note || "") && c.post !== "Representative").map(c => c.term).sort((a, b) => a - b)[0]; let k = null; try{ k = heldOffice(); }catch(e){}
  if(first != null && k && k !== "house") G.career = G.career.filter(c => !(c && /^held by/.test(c.note || "") && c.term > first));
  return n - G.career.length;
}
/* the head of a government is not also its envoy */
function envoyMend(){ let n = 0; try{ const NA = (G.sc && G.sc.na) || {}; Object.keys(NA).forEach(k => { const a = NA[k]; if(a && a.envoy && a.envoy === a.leader){ let e = null; try{ const f = realmFolk(k); const x = f.find(y => y.id === "envoy" && y.name !== a.leader); e = x ? x.name : null; }catch(err){} a.envoy = e || newName(); n++; } }); }catch(e){} return n; }
/* one figure for each power's stance toward the Republic */
function realmSync(){
  const S = G.sc; if(!S || !S.na || typeof WORLD_POWERS === "undefined") return; G.realmRel = G.realmRel || {}; const R = G.rsync = G.rsync || {v:{}};
  WORLD_POWERS.forEach(p => { const a = S.na[p.k]; if(!a) return; const k = p.k, r = G.realmRel[k], t = a.toward;
    if(R.v[k] == null){ const v = r != null ? r : (t || 0); a.toward = v; G.realmRel[k] = v; R.v[k] = v; return; }
    const v = clamp(R.v[k] + ((r != null ? r : R.v[k]) - R.v[k]) + ((t != null ? t : R.v[k]) - R.v[k]), -100, 100);
    a.toward = v; G.realmRel[k] = v; R.v[k] = v; });
}
/* standing in the country, the office and the party is pulled back toward what they would give anyone, a little each day */
function standTarget(){
  const y = G.you; let k = "house"; try{ k = heldOffice() || "house"; }catch(e){}
  const st = (G.states || []).filter(s => s && !s.gone), un = st.length ? st.reduce((a, s) => a + (s.unrest || 0), 0) / st.length : 25;
  let rec = 0; try{ (G.statute || []).filter(s => s && G.day - (s.day || 0) <= 30).forEach(s => { const mine = s.sponsor === y.name || (s.exec && s.exec.by && s.exec.by.indexOf(y.name) >= 0 && s.exec.act === "signed"); if(mine) rec += s.fate === "carried" ? 2 : -2; }); }catch(e){}
  let war = 0; try{ const W = (G.wm && G.wm.rec) || {}; Object.keys(W).forEach(r => { war += (W[r].w || 0) - (W[r].l || 0); }); }catch(e){}
  let econ = 0; try{ const h = (G.money && G.money.hist) || []; if(h.length > 7) econ = clamp((h[h.length - 1] - h[h.length - 8]) / 2, -6, 6); }catch(e){}
  const home = (function(){ try{ const s = (G.states || []).find(x => x.n === y.state); return s ? -((s.unrest || 0) - 25) * 0.25 : 0; }catch(e){ return 0; } })();
  return {approval:clamp(52 - (un - 25) * 0.4 + rec + war * 1.5 + econ + (k === "house" || k === "gov" ? home : 0), 15, 85),
