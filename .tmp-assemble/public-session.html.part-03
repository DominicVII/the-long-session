/* their will, in their own terms, for the voice that speaks for them */
function wlWillLines(m){
  const out = [], O = wlOptions(m), y = G.you, AX = {econ:"public spending and markets", lib:"liberty and order", def:"the military", wel:"welfare"};
  O.slice(0, 2).forEach(o => {
    if(o.k === "wrong" && o.t){ const w = wlWhy(m, o.t); out.push(o.t === y ? "You have a grievance against " + y.name + (w ? ": “" + String(w).replace(/\.$/, "") + ".”" : ".") : "You have a grievance against " + o.t.name + (w ? ": “" + String(w).replace(/\.$/, "") + ".”" : ".")); }
    else if(o.k === "forgive" && o.t) out.push("You are inclined to let a grievance against " + (o.t === y ? y.name : o.t.name) + " go.");
    else if(o.k === "court" && o.t) out.push("You would like " + o.t.name + " as an ally; you think alike.");
    else if(o.k === "bloc") out.push("You want to bring your allies together into a bloc.");
    else if(o.k === "file"){ const ax = AXES.slice().sort((a, b) => Math.abs((m.pos || {})[b.k] || 0) - Math.abs((m.pos || {})[a.k] || 0))[0]; out.push("You want to file a bill of your own on " + (AX[ax.k] || ax.k) + "."); }
    else if(o.k === "engine") out.push(m.state + " is " + (o.s < 0 ? "turning against" : "for") + " the Engine, and you mean to say so."); });
  const w = (m.rel && m.rel.warmth) || 0; if(w >= 30){ const g = (m.mem || []).filter(e => e && e.w > 0 && /^you\b/i.test(String(e.t))).sort((a, b) => b.w - a.w)[0]; if(g) out.push("You think well of " + y.name + ": “" + String(g.t).replace(/\.$/, "") + ".”"); }
  const al = (m.allies || []).map(id => byId(id)).filter(a => a && !a.gone).map(a => a.name); if(al.length) out.push("Your allies: " + al.join(", ") + (m.bloc ? "; together you are " + m.bloc : "") + ".");
  return out;
}
/* ── the sittings speak from the record: the sponsor and the strongest opponent, the section in dispute, the real count, the real file ── */
function wlSitLines(room, step, C){
  const y = G.you, b = G.bill && !G.bill.done ? G.bill : null, here = (C && C.ppl) || [];
  if(room === "senate" && b){
    const by = x => { try{ return memberVote(x, b); }catch(e){ return 0; } }, pro = here.find(x => x.name === b.sponsor) || here.filter(x => by(x) > 0).sort((u, v) => wlT(v, "conviction") - wlT(u, "conviction"))[0], con = here.filter(x => by(x) < 0).sort((u, v) => wlT(v, "conviction") - wlT(u, "conviction"))[0];
    let sec = null; try{ const D = lxDoc(b); sec = D ? D.secs.filter(x => x.k === "op").sort((u, v) => ((v.claim && v.claim[2]) || 0) - ((u.claim && u.claim[2]) || 0) || v.n - u.n)[0] : null; }catch(e){}
    const why = String(b.why || b.line || "").split(/(?<=[.!?])\s/)[0];
    if(step === "open"){ const L = []; if(pro) L.push([pro.name, "The question before us is the " + b.title + ". " + why]); if(con) L.push([con.name, "I oppose it" + (sec ? ", and section " + sec.n + " (" + String(sec.head).toLowerCase() + ") is why: " + String(sec.plain || "").replace(/\.$/, "") : "") + "."]); return L.length ? L : null; }
    if(step === "question" && con){ return [[con.name, "Will the Senator yield? " + (b.pays ? "Who pays for this? The bill's own account says " + b.pays + "." : sec ? "What does section " + sec.n + " do to my State?" : "Who pays for this?")]]; }
    if(step === "motion" && con){ return [[con.name, sec ? "I move to strike section " + sec.n + " (" + String(sec.head).toLowerCase() + ")." : "I move to table the bill."]]; }
    if(step === "deliberate"){ let t = null; try{ t = tallyBill(b, true); }catch(e){} return [["The Presiding Officer", "Without objection, the Senate will stand in quorum call."]].concat(t && pro ? [[pro.name, "My count has " + t.aye + " to " + t.no + ", with " + t.un + " I cannot place."]] : []); }
    return null;
  }
  if(room === "exec"){
    if(step === "open"){ const st = (G.states || []).slice().sort((u, v) => (v.unrest || 0) - (u.unrest || 0))[0], T = (G.treasury && G.treasury.last) || null;
      return [[C.a, "The overnight file. Unrest is highest in " + (st ? st.n + ", at " + Math.round(st.unrest) : "no State in particular") + "." + (T ? " The treasury took in " + money(T.rv * 7) + " last week and paid out " + money(T.out * 7) + "." : "")]]; }
    if(step === "question"){ const h = (G.money && G.money.hist) || [], d = h.length > 7 ? h[h.length - 1] - h[h.length - 8] : 0; return [[C.b, "The guilder is at " + guilderIndex().toFixed(1) + (Math.abs(d) >= 1 ? ", " + (d > 0 ? "up " : "down ") + Math.abs(d).toFixed(1) + " on the week." : ", flat on the week.")]]; }
    if(step === "motion"){ const a = (G.lastActs || []).find(x => x && !x.signed && !x.vetoed && !x.lapsed); if(a) return [[C.c, "The " + a.title + " is on your desk. " + Math.max(0, 10 - (G.day - (a.day || G.day))) + " days left before it becomes law without you."]];
      const R = G.realmRel || {}, k = Object.keys(R).sort((u, v) => R[u] - R[v])[0], P = k ? (WORLD_POWERS.find(x => x.k === k) || {}).t : null; return P ? [[C.c, "The cable from " + P + " came in overnight. We are as far apart as we have been" + (R[k] <= -60 ? ", and they know it." : ".")]] : null; }
    return null;
  }
  if(room === "govoffice"){
    const T = G.town || {}, Ls = (T.letters || []).slice(-4).reverse(), S = (G.states || []).find(x => x.n === y.state);
    if(step === "open" && Ls[0]) return [["A constituent", String(Ls[0].t).replace(/^A letter from /, "From ")]];
    if(step === "question" && Ls[1]) return [["A constituent", String(Ls[1].t).replace(/^A letter from /, "From ")]];
    if(step === "motion" && S && S.bill) return [["The majority leader", "The legislature sends you the " + (S.bill.title || S.bill.t) + ". It wants your signature before the session ends."]];
    if(step === "motion"){ try{ const O = orgEnsure(), tw = (O.towns[y.state] || []).map(t => ({t, k:Object.keys(t.needs || {}).sort((u, v) => t.needs[v] - t.needs[u])[0]})).filter(x => x.k).sort((u, v) => v.t.needs[v.k] - u.t.needs[u.k])[0];
      if(tw){ const N = (typeof ORG_NEEDS !== "undefined" && ORG_NEEDS[tw.k]) || {t:tw.k}; return [[tw.t.mayor && tw.t.mayor.name ? "Mayor " + tw.t.mayor.name + " of " + tw.t.name : "The mayor of " + tw.t.name, "We have asked for " + N.t + " and we are still asking."]]; } }catch(e){} }
    return null;
  }
  return null;
}
{ const _sl = sitLines; sitLines = function(room, step, C, ctx){ try{ const L = wlSitLines(room, step, C); if(L && L.length) return L; }catch(e){} return _sl.apply(this, arguments); }; }
