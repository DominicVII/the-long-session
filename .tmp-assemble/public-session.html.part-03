  const q = {record:{t:"Ask about their record", say:"“On " + ax.n.toLowerCase() + " I have always leaned " + side.w.toLowerCase() + ": I would read the law as a state that " + side.does + ".”", d:fit > 0 ? 2 : -1},
    precedent:{t:"Ask how they treat precedent", say:"“Precedent binds me until I can show why it should not. I am " + (nom.temper > 60 ? "stubborn, and I will say so." : "careful, and I will say so.") + "”", d:nom.temper > 60 ? -1 : 2},
    seat:{t:"Ask whose seat they would take", say:high ? "“" + (V.was ? V.was + "'s" : "The vacant") + " seat. I will not try to be them.”" : "“A circuit seat. The high bench is full.”", d:0}};
  const body = '<div style="margin:8px 0">' + officialHTML(nom, "By your own answers, they read the law " + (fit > 8 ? "much as you do" : fit < -8 ? "the other way from you" : "somewhere near you") + ".") + '</div>' +
    '<p class="muted" style="font-size:13px">' + (high ? "Nominated to the high bench, to the seat " + (V.was ? V.was + " left (" + V.how + ")" : "that stands vacant") + ". The full Senate votes on day " + V.vote + "." : "Nominated to a circuit court. The high bench has no vacancy.") + ' Your vote is one of forty.</p>' +
    '<div class="card__actions" style="flex-wrap:wrap">' + Object.keys(q).map(k => '<button type="button" class="btn btn--ghost" data-cq="' + k + '">' + pcEsc(q[k].t) + '</button>').join("") + '</div><div id="cqSay" class="dream" style="white-space:pre-line"></div>' +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" id="cfYes">Vote to confirm</button><button type="button" class="btn btn--ghost" id="cfNo">Vote against</button><button type="button" class="btn btn--ghost" id="cfFight">Vote against, and work the undecided</button></div>';
  govCardOpen("Senate Judiciary · confirmation", nom.name, high ? "Nominated to the high bench." : "Nominated to the circuit court.", body, null);
  card.querySelectorAll("[data-cq]").forEach(b => b.addEventListener("click", () => { const k = b.getAttribute("data-cq"); if(asked[k]) return; asked[k] = 1; spend(10, 1); grill += q[k].d; el("cqSay").textContent += (el("cqSay").textContent ? "\n" : "") + nom.name + ": " + q[k].say; }));
  let fin = false;
  const done = how => { if(fin) return; fin = true; const yv = how === "yes" ? 1 : -1, shift = how === "fight" ? -(6 + (y.influence || 0) / 10) : (grill - 2) * 2;
    if(how === "fight") y.influence = clamp((y.influence || 0) - 6, 0, 100);
    let sen; if(high) sen = benchConfirm(yv, shift); else sen = lxSenate({title:"Nomination of " + nom.name, pos:nom.pos, senateVote:yv > 0 ? "aye" : "nay", senShift:shift});
    const msg = "The Senate " + (sen && sen.ok ? "confirms " : "rejects ") + nom.name + (high ? " to the high bench" : " to the circuit court") + (sen ? ", " + sen.aye + " to " + sen.no : "") + ". You voted " + (yv > 0 ? "aye" : "no") + ".";
    y.standing = clamp(y.standing + ((sen && sen.ok) === (yv > 0) ? 1 : -1), 0, 100);
    reactEmit("confirm", {name:nom.name, confirmed:!!(sen && sen.ok)}); el("cqSay").textContent += "\n" + msg; feed(msg, sen && sen.ok ? "good" : "news"); card.querySelectorAll("#cfYes,#cfNo,#cfFight,[data-cq]").forEach(x => x.disabled = true); };
  el("cfYes").addEventListener("click", () => done("yes")); el("cfNo").addEventListener("click", () => done("no")); el("cfFight").addEventListener("click", () => done("fight"));
  return null;
};
/* appointments go to whoever confirms them: the Senate for a cabinet secretary, the state legislature for a state judge */
function apptVote(kind, o, S){
  if(kind === "cab"){ const sen = lxSenate({title:"Nomination of " + o.name, pos:o.pos}); return {ok:sen.ok, aye:sen.aye, no:sen.no, body:"the Senate"}; }
  try{ const by = dkStatehouse(S, {title:"Nomination of " + o.name, pos:o.pos}); let a = 0, n = 0, u = 0; Object.keys(by).forEach(p => { a += by[p].aye; n += by[p].no; u += by[p].un; }); const ua = Math.round(u * clamp(0.5 + ((G.you.standing || 50) - 50) / 120, 0.2, 0.8)); return {ok:a + ua > n + (u - ua), aye:a + ua, no:n + u - ua, body:"the legislature"}; }catch(e){ return {ok:true, aye:0, no:0, body:"the legislature"}; }
}
/* ── the treasury, and the guilder that answers to it ── */
function tsStore(){ if(!G.treasury){ let rv = 40; try{ rv = tsRevenue(); }catch(e){} G.treasury = {bal:Math.round(rv * 52), hist:[], log:[], wr:null}; } return G.treasury; }
function tsRevenue(){ const st = (G.states || []).filter(s => s && !s.gone); let r = st.reduce((a, s) => a + Math.max(0.2, s.pop || 1) * (0.45 + (s.ind || 50) / 220), 0);
  const duty = (G.statute || []).filter(s => s && s.fate === "carried" && lxDomainOf(s) === "tariff" && !(s.lxStruck && s.lxStruck.whole)).length; return r * (1 + 0.04 * Math.min(5, duty)); }
function tsOutlay(){ let o = 0; (G.statute || []).forEach(s => { if(!s || s.fate !== "carried" || !s.cost || (s.lxStruck && s.lxStruck.whole)) return; const span = s.org ? 52 : 156, age = (G.day || 0) - (s.day || 0); if(age < 0 || age >= span) return; o += (s.soft ? s.cost * 0.67 : s.cost) / span; });
  try{ const W = (G.wm && G.wm.rec) || {}, n = Object.keys(W).reduce((a, k) => a + (W[k].w || 0) + (W[k].d || 0) + (W[k].l || 0), 0), T = tsStore(); if(T.wr != null && n > T.wr) o += (n - T.wr) * 6; T.wr = n; }catch(e){}
  return o + 18; }
function tsDay(){ const T = tsStore(), rv = tsRevenue(), out = tsOutlay(), d = rv - out; T.bal = Math.round((T.bal + d) * 10) / 10; T.hist.push(Math.round(T.bal)); if(T.hist.length > 60) T.hist.shift(); T.last = {rv:Math.round(rv * 10) / 10, out:Math.round(out * 10) / 10, d:Math.round(d * 10) / 10};
  if(G.day % 7 === 0){ const line = "TREASURY · balance " + money(T.bal) + "; the week took in " + money(rv * 7) + " and paid out " + money(out * 7) + ". The guilder stands at " + (G.money ? G.money.index.toFixed(1) : "?") + "."; T.log.unshift({d:G.day, t:line.replace(/^TREASURY · /, "")}); if(T.log.length > 12) T.log.length = 12; try{ feed(line, "news"); }catch(e){} }
  return T.last; }
/* the guilder is pulled back toward par and pushed by the balance; it no longer sits pinned at its ceiling */
{ const _dg = driftGuilder; driftGuilder = function(news){ const b0 = G.money ? G.money.index : 100, n0 = news ? news.length : 0; const r = _dg.apply(this, arguments); try{ const M = G.money, T = tsStore(), last = M.index; let v = last - (last - 100) * 0.035 + clamp(((T.last && T.last.d) || 0) * 0.04, -1.2, 0.8) + clamp(-T.bal / 4000, -1, 0.4);
    M.index = clamp(Math.round(v * 10) / 10, 42, 190); if(M.hist && M.hist.length) M.hist[M.hist.length - 1] = M.index;
    if(news){ for(let i = news.length - 1; i >= n0; i--) if(/^The guilder (firmed|slipped) to /.test(news[i])) news.splice(i, 1);
      const d = M.index - b0; if(Math.abs(d) > 1.1) news.push("The guilder " + (d > 0 ? "firmed to " : "slipped to ") + M.index.toFixed(1) + " on the index" + (d < -1.6 ? ". Everything your campaign buys just got dearer." : ".")); } }catch(e){} return r; }; }
/* ── every Senate seat named, its party kept, a third elected each Congress ── */
