/* a case filed by the old paths, on an act it names, is read against that act's own sections */
function lxEnrich(c){
  if(!c || c.lx || c.dual != null) return; const m = /\(([^()]+)\)\s*$/.exec(c.t || ""); if(!m) return;
  const s = (G.statute || []).find(x => x.title === m[1]) || (G.statute || []).find(x => m[1].indexOf(x.title) >= 0); if(!s) return; const D = lxDoc(s); if(!D) return;
  const want = c.state ? ["states", "spending", "preempt", "equal", "uniformity"] : null;
  const x = D.secs.filter(y => y.k === "op" && y.claim && (!want || want.indexOf(y.claim[0]) >= 0)).sort((u, v) => v.claim[2] - u.claim[2])[0] || D.secs.find(y => y.k === "op");
  if(!x) return; const th = x.claim ? x.claim[0] : "states";
  c.lx = {act:s.title, aday:s.day, sec:x.n, head:x.short || x.head, th, str:x.claim ? x.claim[2] : 0.35, plaintiff:(c.t.split(" v. ")[0] || c.state || "the plaintiff"), pk:c.state ? "state" : "group", dom:D.dom};
}
function lxBench(){ const J = (G.court && G.court.length ? G.court : []).filter(j => j && j.name && !(G.you && j.name === G.you.name)); return J; }
function lxDecide(c, youVote){
  const L = c.lx, T = LX_TH[L.th] || LX_TH.states, J = lxBench(); if(!J.length && youVote == null) return null;
  const prior = (G.cases || []).filter(x => x !== c && x.done && x.lx && x.lx.th === L.th && x.lx.held).sort((u, v) => (v.dday || v.day) - (u.dday || u.day))[0];
  const prec = prior ? (prior.lx.held === "struck" ? 0.18 : -0.18) : 0;
  const votes = J.map((j, i) => { const lean = clamp(((j.pos && j.pos[T.ax]) || 0) * T.sg / 60, -1, 1), noise = (knH(j.name, c.t) - 0.5) * 0.3;
    const sc = (L.str - 0.45) * 1.6 + lean * 0.7 + prec + noise; return {name:j.name, strike:sc > 0, chief:i === 0}; });
  if(youVote != null) votes.push({name:G.you.name, strike:!youVote, you:true});
  const st = votes.filter(v => v.strike), up = votes.filter(v => !v.strike), struck = st.length > up.length, maj = struck ? st : up, min = struck ? up : st;
  const pickOf = (L, k) => { const nv = L.filter(v => !v.you); return nv.length ? nv[Math.floor(knH(c.t, k) * nv.length)] : L[0]; };
  const author = (maj.some(v => v.chief) && knH(c.t, "chief") < 0.35) ? maj.find(v => v.chief) : pickOf(maj, "auth"), diss = min.length ? pickOf(min, "diss") : null;
  const s = (G.statute || []).find(x => x.title === L.act && (L.aday == null || Math.abs((x.day || 0) - L.aday) <= 1));
  const op = (author.you ? "You wrote for the Court" : "Justice " + author.name + " wrote for the Court") + ": " + (struck ? "Section " + L.sec + " of the " + L.act + " (" + String(L.head).toLowerCase() + ") " + T.phrase + ", and is invalid." + (prior && prior.lx.held === "struck" ? " We said as much in " + prior.t + "." : "") + " Under the Act's own severability section the rest of it stands."
    : "The challenge to section " + L.sec + " of the " + L.act + " fails. " + T.up + (prior && prior.lx.held === "upheld" ? " We held the same in " + prior.t + "." : prior ? " We do not read " + prior.t + " to require otherwise." : ""));
  const dis = diss ? (diss.you ? " You dissented." : " Justice " + diss.name + " dissented: " + (struck ? T.up : "the section " + T.phrase + ", and the Court should have said so.")) : "";
  c.done = true; c.dday = G.day; c.ruled = struck ? (c.state ? "state" : "plaintiff") : "union";
  Object.assign(L, {held:struck ? "struck" : "upheld", count:maj.length + "–" + min.length, op:op + dis, author:author.name});
  if(struck && s){ const ss = s.lxStruck = s.lxStruck || {secs:[], cases:[], whole:false}; if(ss.secs.indexOf(L.sec) < 0) ss.secs.push(L.sec); if(ss.cases.indexOf(c.t) < 0) ss.cases.push(c.t);
    const D = lxDoc(s), nOps = D ? D.secs.filter(x => x.k === "op").length : 3; ss.whole = ss.secs.length * 2 > nOps; LX.docs.delete(lxKey(s)); }
  try{ const S = (G.states || []).find(x => x.n === c.state); if(S) S.unrest = clamp((S.unrest || 0) + (struck ? -3 : 4), 0, 100); }catch(e){}
  try{ feed("The high bench, " + maj.length + " to " + min.length + ", " + (struck ? "strikes section " + L.sec + " of the " + L.act : "upholds section " + L.sec + " of the " + L.act) + " in " + c.t + ".", struck ? "news" : "news"); journal("Court: " + c.t + " — " + (struck ? "section " + L.sec + " struck" : "upheld") + ", " + maj.length + "–" + min.length + "."); }catch(e){}
  return {struck, count:L.count, op:L.op};
}
function lxDay(){
  if(!G || !G.you) return; lxSync();
  (G.cases || []).forEach(lxEnrich);
  (G.statute || []).forEach(s => { if(s.lxSued || s.fate !== "carried" || G.day - (s.day || 0) > 30 || G.day - (s.day || 0) < 1) return; const st = lxStatus(s); if(st.k !== "law") return; s.lxSued = G.day; lxSue(s); });
}
/* ── reading it ── */
function lxSecHTML(D, x){
  const strikeA = x.struckAmend, court = x.struckCourt;
  return '<div class="lx-sec" style="margin:10px 0;' + (strikeA ? "opacity:.55;" : "") + '"><div style="font:600 14px Georgia,serif"><span style="color:#7a5a12">Sec. ' + x.n + '.</span> ' + pcEsc(x.head) + '.</div>' +
    x.sub.map(t => '<div style="margin:3px 0 0 14px;' + (strikeA ? 'text-decoration:line-through;' : '') + '">' + pcEsc(t) + '</div>').join("") +
    (x.amends ? '<div style="margin:4px 0 0 14px"><button type="button" class="btn btn--ghost" style="padding:2px 8px;font-size:12px" data-lxopen="' + pcEsc(x.amends.day + ":" + x.amends.title) + '">Read the ' + pcEsc(x.amends.title) + ' ▸</button></div>' : '') +
    (strikeA ? '<div class="muted" style="margin:3px 0 0 14px;font-size:12px">Struck on the floor before passage.</div>' : '') +
    (court ? '<div style="margin:3px 0 0 14px;font-size:12px;color:#8a1d1d">Held invalid in ' + pcEsc(court.cases.join(", ")) + '. Not in force.</div>' : '') +
    '<div class="muted" style="margin:3px 0 0 14px;font-size:12px"><i>In plain words:</i> ' + pcEsc(x.plain) + '</div></div>';
}
function lxDocHTML(D){
  return '<div class="lx-doc" style="background:#fffdf6;color:#1d1d1d;border:1px solid #cdbf9a;border-radius:6px;padding:14px 16px;font:14px/1.45 Georgia,serif">' +
    '<div style="text-align:center;font:12px system-ui;letter-spacing:.08em;color:#6b5a2e">' + pcEsc(D.congress.toUpperCase()) + ' CONGRESS · ' + pcEsc(D.no) + '</div>' +
    '<div style="text-align:center;font:700 18px Georgia,serif;margin:6px 0">AN ACT</div><div style="text-align:center;font-style:italic">' + pcEsc(D.longTitle) + '</div>' +
    '<p style="margin:12px 0 4px"><i>' + pcEsc(D.enact) + '</i></p>' + D.secs.map(x => lxSecHTML(D, x)).join("") + '</div>';
}
function lxHistHTML(s){
  const st = lxStatus(s), rows = [];
  rows.push("Filed by " + (s.sponsor || "the leadership") + (s.state ? ", out of " + s.state : "") + ".");
  if(s.aye != null) rows.push("House roll call, day " + s.day + ": " + s.aye + " aye, " + s.no + " no" + (s.yv ? " (you voted " + (s.yv > 0 ? "aye" : "no") + ")" : "") + ".");
  if(s.v){ const ay = [], no = [], P = Object.keys(s.v).map(id => knPerson(id)).filter(Boolean), cnt = {}; P.forEach(m => { const k = surname(m.name); cnt[k] = (cnt[k] || 0) + 1; });
    const ab = []; Object.keys(s.v).forEach(id => { const m = knPerson(id); if(m) (s.v[id] > 0 ? ay : s.v[id] < 0 ? no : ab).push(cnt[surname(m.name)] > 1 ? m.name : surname(m.name)); }); rows.push("On the roll by name — aye: " + (ay.join(", ") || "none") + "; no: " + (no.join(", ") || "none") + (ab.length ? "; not voting: " + ab.join(", ") : "") + ". The other seats were counted by party."); }
  else rows.push("The clerk did not keep the names on the roll for this one; only the count is recorded.");
  const cs = (G.cases || []).filter(c => c.lx && c.lx.act === s.title);
  return '<div class="eyebrow" style="margin-top:12px">Where it stands</div><p>' + pcEsc(st.t) + '</p>' +
    '<div class="eyebrow" style="margin-top:8px">Legislative history</div><ul style="margin:4px 0 0 18px">' + rows.map(r => '<li>' + pcEsc(r) + '</li>').join("") + '</ul>' +
    (cs.length ? '<div class="eyebrow" style="margin-top:8px">In the courts</div>' + cs.map(c => '<div style="margin:6px 0;padding:6px 10px;border-left:3px solid ' + (c.lx.held === "struck" ? "#a33" : c.lx.held ? "#3a7" : "#c9a24a") + '"><b>' + pcEsc(c.t) + '</b> <span class="muted">· filed day ' + c.day + ' · challenges section ' + c.lx.sec + ' (' + pcEsc(String(c.lx.head).toLowerCase()) + ') on ' + pcEsc(LX_TH[c.lx.th].t) + '</span>' +
      (c.lx.held ? '<div style="font-size:13px;margin-top:3px">Decided day ' + (c.dday || "?") + ', ' + pcEsc(c.lx.count) + ': ' + pcEsc(c.lx.op) + '</div>' : '<div class="muted" style="font-size:13px">Pending before the high bench.</div>') + '</div>').join("") : "") +
    (st.later.length ? '<div class="eyebrow" style="margin-top:8px">Amended by</div>' + st.later.map(x => '<button type="button" class="btn btn--ghost" style="margin:2px" data-lxopen="' + pcEsc(lxKey(x)) + '">' + pcEsc(x.title) + ' ▸</button>').join("") : "");
}
function lxFind(key){ if(key === "cal") return G.bill || null; const i = String(key).indexOf(":"), d = String(key).slice(0, i), t = String(key).slice(i + 1); return (G.statute || []).find(s => s.title === t && String(s.day) === d) || (G.statute || []).find(s => s.title === t) || (G.bill && G.bill.title === t ? G.bill : null); }
let lxWasRunning = null;
function lxShut(){ const V = document.getElementById("lxVeil"); if(!V || V.hidden) return; V.hidden = true; G.running = lxWasRunning === null ? G.running : lxWasRunning; lxWasRunning = null; }
function lxOpen(h){
  let V = document.getElementById("lxVeil"); if(!V){ V = document.createElement("div"); V.id = "lxVeil"; V.className = "veil"; V.style.zIndex = "10060"; V.hidden = true; V.innerHTML = '<div class="card lx-card" id="lxCardEl" style="width:min(820px,100%)"></div>'; document.body.appendChild(V);
    V.addEventListener("click", e => { if(e.target === V) lxShut(); }); document.addEventListener("keydown", e => { if(e.key === "Escape" && !V.hidden){ e.preventDefault(); e.stopImmediatePropagation(); lxShut(); } }, true); }
  if(V.hidden){ lxWasRunning = G.running; } G.running = false; const C = V.firstChild; C.innerHTML = h; V.hidden = false; V.scrollTop = 0; C.scrollTop = 0;
  const c = C.querySelector("#lxClose"); if(c) c.onclick = () => lxShut(); }
function lxCard(ref){
  const s = typeof ref === "string" ? lxFind(ref) : ref; const D = s ? lxDoc(s) : null;
  if(!D){ lxOpen('<h1>Not in the book</h1><p class="muted">The clerk has no text for that.</p><div class="card__actions"><button type="button" class="btn btn--ghost" data-lxbook="all">The statute book</button><button type="button" class="btn btn--ghost" id="lxClose">Close</button></div>'); return; }
  const live = s === G.bill;
  lxOpen('<div class="eyebrow">' + (live ? "On the calendar · roll call day " + (s.voteDay || "?") : "The statute book") + '</div><h1>' + pcEsc(s.title) + '</h1>' +
    (live ? '<p class="muted">Before the House. Sponsored by ' + pcEsc(youMark(s.sponsor || "the leadership")) + (s.state ? ', out of ' + pcEsc(s.state) : '') + '.' + (D.prior ? ' It amends the ' + pcEsc(D.prior.title) + ', which is in force.' : '') + '</p>' : lxHistHTML(s)) +
    '<div class="eyebrow" style="margin-top:12px">The text</div>' + lxDocHTML(D) +
    '<div class="card__actions"><button type="button" class="btn btn--ghost" data-lxbook="all">The statute book</button><button type="button" class="btn btn--ghost" id="lxClose">Close</button></div>');
}
function lxBook(f){
  f = f || "all"; const S = (G.statute || []).slice(), rows = S.map(s => ({s, st:lxStatus(s)})).filter(r => f === "all" || r.st.k === f || (f === "law" && r.st.k === "pending"));
  const cnt = k => S.filter(s => lxStatus(s).k === k).length, chip = (k, t) => '<button type="button" class="btn ' + (f === k ? '' : 'btn--ghost') + '" style="padding:3px 9px;font-size:12px" data-lxbook="' + k + '">' + t + '</button>';
  const pend = (G.lastActs || []).filter(a => !(G.statute || []).some(s => s.title === a.title && Math.abs((s.day || 0) - (a.day || 0)) <= 1));
  lxOpen('<div class="eyebrow">The statute book · ' + pcEsc(lxCountry()) + '</div><h1>Every act this House has decided</h1><p class="muted">Each with its full text, its roll call, what the President did with it, what the courts made of it, and the acts that amended it.</p>' +
    '<div class="card__actions" style="flex-wrap:wrap;justify-content:flex-start">' + chip("all", "All " + S.length) + chip("law", "In force " + (cnt("law") + cnt("pending"))) + chip("failed", "Failed " + cnt("failed")) + chip("vetoed", "Vetoed " + cnt("vetoed")) + chip("struck", "Struck down " + cnt("struck")) + '</div>' +
    (G.bill && !G.bill.done ? '<div style="margin:8px 0;padding:8px 10px;border-left:3px solid #c9a24a"><b>On the calendar:</b> ' + pcEsc(G.bill.title) + ' <button type="button" class="btn btn--ghost" style="padding:2px 8px;font-size:12px" data-lxopen="cal">Read it ▸</button></div>' : '') +
    rows.map(r => '<div style="margin:6px 0;padding:6px 10px;border-left:3px solid ' + ({law:"#3a7", pending:"#c9a24a", failed:"#888", vetoed:"#a63", struck:"#a33"})[r.st.k] + '"><b>' + pcEsc(r.s.title) + '</b> <span class="muted" style="font-size:12px">· day ' + r.s.day + (r.s.sponsor ? ' · ' + pcEsc(lxSponsorLabel(r.s)) : '') + '</span><div style="font-size:13px">' + pcEsc(r.st.t) + '</div><button type="button" class="btn btn--ghost" style="padding:2px 8px;font-size:12px;margin-top:3px" data-lxopen="' + pcEsc(lxKey(r.s)) + '">Read the act ▸</button></div>').join("") +
    (pend.length ? '<div class="eyebrow" style="margin-top:10px">Passed by Congress without a recorded roll call</div>' + pend.map(a => '<div class="muted" style="font-size:13px">· ' + pcEsc(a.title) + ', day ' + a.day + (a.signed ? ', signed' : a.vetoed ? ', vetoed' : ', awaiting signature') + '. The clerk kept the title and the day; no text was entered.</div>').join("") : '') +
    '<div class="card__actions"><button type="button" class="btn btn--ghost" id="lxClose">Close</button></div>');
}
document.addEventListener("click", e => { const t = e.target && e.target.closest ? e.target.closest("[data-lxopen],[data-lxbook]") : null; if(!t) return; e.preventDefault(); e.stopPropagation();
  try{ if(t.hasAttribute("data-lxopen")) lxCard(t.getAttribute("data-lxopen")); else lxBook(t.getAttribute("data-lxbook")); }catch(err){ try{ console.warn("lx", err); }catch(e2){} } }, true);
/* ── the docket reads the real text, the real cost and the real sponsor ── */
{ const _dp = dkProvisions; dkProvisions = function(it){ try{ if(it && it.kind !== "case" && it.kind !== "state bill"){ const D = lxDoc(it.src || it.b || {title:it.title, day:it.day}); if(D) return D.secs.map(x => "Sec. " + x.n + ". " + x.head + ". " + x.sub.join(" ")); } }catch(e){} return _dp.apply(this, arguments); }; }
{ const _dr = dkProvisionsRich; dkProvisionsRich = function(it){ try{ if(it && it.kind !== "case" && it.kind !== "state bill"){ const D = lxDoc(it.src || it.b || {title:it.title, day:it.day}); if(D) return D.secs.map(x => '<li>' + pcEsc("Sec. " + x.n + ". " + x.head + ". " + x.sub.join(" ")) + '<br><span class="muted" style="font-size:12px">' + pcEsc(x.plain) + '</span></li>').join(""); } }catch(e){} return _dr.apply(this, arguments); }; }
{ const _dc = dkClauseHTML; dkClauseHTML = function(it){ try{ if(it && it.kind !== "case" && it.kind !== "state bill"){ const D = lxDoc(it.src || it.b || {title:it.title, day:it.day}); if(D){ const b = dkBillRef(it) || {}, edit = it.kind === "bill" && b === G.bill;
      return D.secs.map(x => '<li' + (x.struckAmend ? ' style="text-decoration:line-through;opacity:.6"' : '') + '><b>Sec. ' + x.n + '. ' + pcEsc(x.head) + '.</b> ' + pcEsc(x.sub.join(" ")) + '<br><span class="muted" style="font-size:12px">' + pcEsc(x.plain) + '</span>' +
        (edit && x.k === "op" && !x.struckAmend ? ' <button type="button" class="btn btn--ghost" style="padding:1px 6px;font-size:11px" data-dkstrike="' + (100 + x.ci) + '">Move to strike</button>' : '') +
        (edit && x.k === "approp" && !b.soft && b.cost ? ' <button type="button" class="btn btn--ghost" style="padding:1px 6px;font-size:11px" data-dkamend="1">Amend: cut it by a third</button>' : '') +
        (x.amends ? ' <button type="button" class="btn btn--ghost" style="padding:1px 6px;font-size:11px" data-lxopen="' + pcEsc(x.amends.day + ":" + x.amends.title) + '">Read the ' + pcEsc(x.amends.title) + '</button>' : '') + '</li>').join("") +
        '<li style="list-style:none;margin-top:6px"><button type="button" class="btn btn--ghost" style="padding:2px 8px;font-size:12px" data-lxopen="' + (b === G.bill ? "cal" : pcEsc(lxKey(D.src))) + '">Read the full text ▸</button></li>'; } } }catch(e){} return _dc.apply(this, arguments); }; }
{ const _ds = dkStrike; dkStrike = function(it, i){ if(i >= 100){ const b = dkBillRef(it); if(!b || !b.clauses) return ""; const ci = i - 100; b.strk = b.strk || []; if(b.strk.indexOf(ci) < 0) b.strk.push(ci);
    const n = b.clauses.length || 3; if(b.pos) Object.keys(b.pos).forEach(k => b.pos[k] = Math.round(b.pos[k] * (1 - 0.5 / n))); G.you.influence = clamp((G.you.influence || 0) - 2, 0, 100);
    (b.amends = b.amends || []).push({d:G.day, by:G.you.name, what:"struck the provision on " + b.clauses[ci]}); LX.docs.delete(lxKey(b));
    try{ feed("You move to strike the provision on " + b.clauses[ci] + " from the " + b.title + "."); }catch(e){} return "Moved to strike: " + b.clauses[ci] + ". The count moves."; } return _ds.apply(this, arguments); }; }
{ const _da = dkAmend; dkAmend = function(it){ const r = _da.apply(this, arguments); try{ const b = dkBillRef(it); if(b){ (b.amends = b.amends || []).push({d:G.day, by:G.you.name, what:"cut the appropriation by a third"}); LX.docs.delete(lxKey(b)); } }catch(e){} return r; }; }
{ const _dcl = dkCostLine; dkCostLine = function(it){ try{ const s = it && it.kind !== "case" ? (it.src || dkBillRef(it) || lxSource({title:it.title, day:it.day})) : null; if(s && s.cost){ const c = s.soft ? Math.round(s.cost * 0.67) : s.cost; return "Cost: " + money(c) + (s.soft ? " (cut by amendment from " + money(s.cost) + ")" : "") + ", paid by " + (s.pays || "the general fund") + "."; } }catch(e){} return _dcl.apply(this, arguments); }; }
{ const _di = dkItems; dkItems = function(){ const L = _di.apply(this, arguments); try{ L.forEach(it => { if(it.kind !== "act") return; const s = lxSource({title:it.title, day:+(/day (\d+)/.exec(it.line || "") || [])[1] || null}); if(!s) return; it.src = s; it.sponsor = s.sponsor || it.sponsor; it.line = lxStatus(s).t; }); }catch(e){} return L; }; }
{ const _dcard = dkCard; dkCard = function(i){ const r = _dcard.apply(this, arguments); try{ const acts = card.querySelector(".card__actions:last-of-type"); if(acts && !card.querySelector("[data-lxbook]")){ const b = document.createElement("button"); b.type = "button"; b.className = "btn btn--ghost"; b.setAttribute("data-lxbook", "all"); b.textContent = "The statute book"; acts.insertBefore(b, acts.firstChild);
    const it = dkItems()[i || 0]; const src = it ? (it.src || (it.b === G.bill ? G.bill : null) || lxSource({title:it.title})) : null; if(src && it.kind !== "case" && it.kind !== "state bill"){ const f = document.createElement("button"); f.type = "button"; f.className = "btn"; f.setAttribute("data-lxopen", src === G.bill ? "cal" : lxKey(src)); f.textContent = "Read the full text"; acts.insertBefore(f, acts.firstChild); } } }catch(e){} return r; }; }
{ const _bs = billSheet; billSheet = function(b){ let h = _bs.apply(this, arguments); try{ if(b) h += '<div class="card__actions"><button type="button" class="btn btn--ghost" data-lxopen="' + (b === G.bill ? "cal" : pcEsc(lxKey(b))) + '">Read the full text ▸</button><button type="button" class="btn btn--ghost" data-lxbook="all">The statute book</button></div>'; }catch(e){} return h; }; }
/* the bench: suits on the act's own sections, decided justice by justice; you keep your one vote when you sit on it */
{ const _oca = orgCourtAct; orgCourtAct = function(){ try{ let k = null; try{ k = roleKey(); }catch(e){}
    (G.cases || []).forEach(c => { if(!c || c.done) return; lxEnrich(c); if(!c.lx) return; if(k === "bench" && c.state !== (G.you && G.you.state)) return; if(G.day - (c.day || 0) < 4 || !chance(0.35)) return; lxDecide(c, null); }); }catch(e){} return _oca.apply(this, arguments); }; }
{ const _br = benchRule; benchRule = function(c, forUnion){ try{ lxEnrich(c); if(c && c.lx && c.dual == null){ try{ reactEmit("ruling", {t:c.t, forUnion, state:c.state, dual:false}); }catch(e){} const r = lxDecide(c, !!forUnion); G.you.standing = clamp(G.you.standing + 1, 0, 100);
      return r ? (r.struck === !forUnion ? "The bench is with you, " + r.count + ". " : "You are outvoted, " + r.count + ". ") + r.op : _br.apply(this, arguments); } }catch(e){} return _br.apply(this, arguments); }; }
/* the statute book keeps what each act was, so its text can be read for good */
{ const _hv2 = holdVote; holdVote = function(){ const b = G.bill, n0 = (G.statute || []).length; const r = _hv2.apply(this, arguments);
  try{ const s = G.statute && G.statute[0]; if(b && s && s.title === b.title && G.statute.length > n0){ Object.assign(s, {id:b.id, domain:b.domain || null, pos:b.pos ? Object.assign({}, b.pos) : null, stakes:b.stakes || null, pays:b.pays || null, helps:b.helps || null, town:b.town || null, sponsorParty:b.sponsorParty || null, kind:b.kind || null, realmT:b.realmT || null, target:b.target || null, strk:(b.strk || []).slice(), soft:!!b.soft, amends:(b.amends || []).slice(), veto:b._veto || null}); } }catch(e){} return r; }; }
{ const _scb4 = saveCaptureBase; saveCaptureBase = function(){ const o = _scb4.apply(this, arguments); try{ o.lx = G.lx || null; }catch(e){} return o; }; }
setTimeout(() => { try{ const bar = document.getElementById("uiToolbar"); if(bar && !document.getElementById("uiStatuteBtn")){ const b = document.createElement("button"); b.type = "button"; b.id = "uiStatuteBtn"; b.title = "Every act the House has decided: full text, roll call, veto, courts, amendments"; b.textContent = "Statutes"; b.setAttribute("data-lxbook", "all"); const d = document.getElementById("uiDocketBtn"); bar.insertBefore(b, d ? d.nextSibling : bar.children[1] || null); } }catch(e){} }, 1800);
setInterval(() => { try{ if(G && G.you){ lxSync(); if(lxStore().day !== G.day){ lxStore().day = G.day; lxDay(); } } }catch(e){} }, 2500);
window.onumStatute = {book:() => (G.statute || []).map(s => ({title:s.title, day:s.day, status:lxStatus(s).t, kind:lxStatus(s).k})), text:(t, d) => { const D = lxDoc(lxSource({title:t, day:d})); return D ? {title:D.title, longTitle:D.longTitle, amends:D.prior ? D.prior.title : null, sections:D.secs.map(x => ({n:x.n, head:x.head, text:x.sub, plain:x.plain, challengeable:x.claim ? LX_TH[x.claim[0]].t : null}))} : null; },
  cases:() => (G.cases || []).filter(c => c.lx).map(c => ({case:c.t, act:c.lx.act, section:c.lx.sec, on:LX_TH[c.lx.th].t, held:c.lx.held || "pending", count:c.lx.count || null, opinion:c.lx.op || null})), open:k => lxCard(k), openBook:f => lxBook(f)};

/* ══ 20261025h · ONE PLACE FOR A MEETING. A cabinet, a council, a briefing, the press room, the floor or any step-by-step
   sitting is run from one panel at the top right and nowhere else: the session view, the floor desk (who is next, raise
   your hand, speak) and the sitting's own card all sit in that one frame, under one header with one Hide, the world stays
   in view, and what is said in the meeting is written into it. ══ */
const SXD = {min:false, log:[], key:"", seen:0, home:null};
(function(){ const st = document.createElement("style"); st.id = "sxDockCss"; const P = "#sxDock>#veil.sitx";
  st.textContent = "#sxDock{position:fixed;right:8px;top:84px;z-index:62;width:min(460px,calc(100vw - 16px));max-height:calc(100vh - 160px);overflow:auto;background:#121419;border:2px solid #c9a24a;border-radius:8px;box-shadow:0 6px 24px #000;display:flex;flex-direction:column}" +
    "#sxDock>#ndSess{position:static !important;width:auto !important;max-width:none !important;max-height:none !important;border:0 !important;border-radius:0 !important;box-shadow:none !important;overflow:visible !important;flex:none}" +
    "#sxDock>#ndFd{position:static !important;transform:none !important;width:auto !important;max-width:none !important;max-height:none !important;border:0 !important;border-top:1px solid #c9a24a !important;border-radius:0 !important;box-shadow:none !important;flex:none;font-size:13px}#sxDock>#ndFd textarea{min-height:38px;font-size:14px}" +
    P + "{position:static !important;inset:auto !important;display:block !important;padding:0 !important;background:none !important;backdrop-filter:none !important;-webkit-backdrop-filter:none !important;width:auto !important;max-height:none !important;overflow:visible !important;z-index:auto !important;border-top:1px solid #c9a24a;flex:none}" +
    P + " #card{width:auto !important;max-width:none !important;max-height:none !important;overflow:visible !important;border:0 !important;border-radius:0 !important;box-shadow:none !important;padding:10px 12px 12px !important;font-size:13px;animation:none !important;transform:none !important}" +
    P + " #card h1{font-size:22px;margin:4px 0 6px}" + P + " .sx-grid{grid-template-columns:1fr !important;gap:8px}" + P + " .sx-lines{max-height:none}" + P + " .sx-moves .btn{max-width:none;flex:1 1 100%;padding:6px 8px;font-size:12px}" +
    "#sxDock.min>#veil,#sxDock.min>#ndFd .fd-body{display:none !important}" +
    "#sxDockHead{display:flex;justify-content:space-between;align-items:center;gap:6px;padding:7px 10px;background:#121419;color:#ffe08a;font:700 15px Georgia,serif;border-bottom:1px solid #c9a24a;position:sticky;top:0;z-index:2;flex:none}#sxDockHead button{background:#2a2d35;color:#fff;border:1px solid #6b6f7a;border-radius:4px;font:12px system-ui;cursor:pointer}" +
    "#ndSess .nsx-log{margin:6px 0 2px;border-top:1px solid #3a3d46;padding-top:5px;max-height:190px;overflow:auto}#ndSess .nsx-log div{margin:3px 0;color:#e8e2d0;font-size:12.5px}#ndSess .nsx-log b{color:#ffe08a}" +
    "#ndSess .nsx-say{display:flex;gap:5px;margin-top:5px}#ndSess .nsx-say input{flex:1;background:#000;color:#fff;border:1px solid #6b6f7a;border-radius:4px;padding:4px}#ndSess .nsx-say button{background:#ffe08a;color:#111;border:0;border-radius:4px;font-weight:700;cursor:pointer;padding:3px 8px}";
  document.head.appendChild(st); })();
function sxdSession(){ const S = window.ONUM_SESSION; return S && (S.open === true || S.active === true || (S.open == null && S.active == null && (S.seats || S.floor || S.roll))) ? S : null; }
/* what is said while a session sits is kept for its panel */
{ const _tl = tlog; tlog = function(who, line, kind){ const r = _tl.apply(this, arguments); try{ const S = sxdSession(); if(S && line && (kind === "talk" || kind === "you" || kind === "session" || kind === "sit")){
    const k = String(S.kind || "") + "|" + String(S.bodyId || S.title || "") + "|" + String(S.procedure || ""); if(k !== SXD.key){ SXD.key = k; SXD.log = []; }
    const nm = typeof who === "string" ? who : (who && who.name) || ""; SXD.log.push({who:nm || "", t:String(line).replace(/<[^>]+>/g, "").slice(0, 320)}); if(SXD.log.length > 40) SXD.log.shift(); SXD.seen++; } }catch(e){} return r; }; }
function sxdLogHTML(){ return SXD.log.slice(-8).map(l => '<div><b>' + pcEsc(l.who || "—") + '</b> ' + pcEsc(l.t) + '</div>').join(""); }
/* the layout manager placed these on their own with inline rules; inside the one panel they flow */
function sxdClear(e){ ["position", "top", "left", "right", "bottom", "width", "max-width", "max-height", "overflow", "transform", "margin", "box-sizing"].forEach(k => e.style.removeProperty(k)); e.classList.remove("hm-p"); const x = e.querySelector(":scope>.hmX"); if(x) x.remove(); }
function sxDockTick(){
  try{
    let D = document.getElementById("sxDock"); if(!D){ D = document.createElement("div"); D.id = "sxDock"; D.setAttribute("role", "region"); D.setAttribute("aria-label", "Meeting"); document.body.appendChild(D); }
    let hd = document.getElementById("sxDockHead"); if(!hd){ hd = document.createElement("div"); hd.id = "sxDockHead"; hd.innerHTML = "<span></span><button type=\"button\">Hide</button>"; hd.lastChild.onclick = () => { SXD.min = !SXD.min; sxDockTick(); }; D.appendChild(hd); }
    const ns = document.getElementById("ndSess"), fd = document.getElementById("ndFd"), sit = !veil.hidden && veil.classList.contains("sitx");
    if(sit && veil.parentNode !== D){ if(!SXD.home) SXD.home = {p:veil.parentNode, n:veil.nextSibling}; sxdClear(veil); }
    if(!sit && veil.parentNode === D){ const h = SXD.home; if(h && h.p) h.p.insertBefore(veil, h.n && h.n.parentNode === h.p ? h.n : null); else document.body.appendChild(veil); }
    const want = [hd, ns, sit ? veil : null, fd].filter(Boolean), opened = sit && !SXD.sitWas; SXD.sitWas = sit;
    want.forEach((e, i) => { if(e !== hd && e.parentNode !== D) sxdClear(e); if(D.children[i] !== e) D.insertBefore(e, D.children[i] || null); });
    if(opened) setTimeout(() => { try{ D.scrollTop = Math.max(0, veil.offsetTop - 8); }catch(e){} }, 60);
    const fdOn = !!(fd && !fd.hidden && getComputedStyle(fd).display !== "none"), any = !!(ns || fdOn || sit);
    D.style.display = any ? "" : "none";
    hd.style.display = !ns && any ? "" : "none";
    const S = typeof SIT !== "undefined" && SIT.on ? SIT.on : null, SS = sxdSession();
    hd.firstChild.textContent = "⚖ " + ((S && S.D && (S.D.title || S.D.t)) || (SS && (SS.stageName || String(SS.kind || "").replace(/_/g, " "))) || "In session");
    const min = ns ? !!(window.NEPTUNE_SESSIONVIEW && window.NEPTUNE_SESSIONVIEW.min) : SXD.min; hd.lastChild.textContent = min ? "Show" : "Hide"; D.classList.toggle("min", min);
    /* the panel's own record of the meeting, and a voice for the chair */
    if(ns && !ns.classList.contains("min")){ const body = ns.querySelector(".ns-body"); if(body){
      let lg = body.querySelector(".nsx-log"); if(fdOn){ if(lg) lg.remove(); lg = null; } const SN = window.ONUM_SESSION || {};
      if(!lg && !fdOn){ lg = document.createElement("div"); lg.className = "nsx-log"; body.appendChild(lg); lg.dataset.n = "-1"; }
      if(lg && lg.dataset.n !== String(SXD.seen)){ lg.innerHTML = sxdLogHTML() || '<div style="color:#9a9384">Nothing said yet.</div>'; lg.dataset.n = String(SXD.seen); lg.scrollTop = lg.scrollHeight; }
      if(SN.chairId === "you" && !fdOn && !body.querySelector("#nsxSay") && !body.querySelector(".nsx-say")){ const f = document.createElement("div"); f.className = "nsx-say";
        f.innerHTML = '<input type="text" maxlength="300" placeholder="Speak to the room…"><button type="button">Say</button>'; body.appendChild(f);
        const go = () => { const i = f.querySelector("input"), t = (i.value || "").trim(); if(!t) return; i.value = "";
          let ok = false; try{ const OS = window.onumSession; if(OS && typeof OS.speak === "function"){ OS.speak(t); ok = true; } }catch(e){}
          if(!ok){ try{ window.onumSessionEvent({action:"speak", actorId:"you", text:t}); }catch(e){} }
          try{ tlog("You", t, "you"); }catch(e){} };
        f.querySelector("button").onclick = go; f.querySelector("input").addEventListener("keydown", e => { e.stopPropagation(); if(e.key === "Enter"){ e.preventDefault(); go(); } }); } } }
  }catch(e){}
}
setInterval(sxDockTick, 300);
try{ new MutationObserver(() => sxDockTick()).observe(veil, {attributes:true, attributeFilter:["class", "hidden"]}); }catch(e){}
/* ══ 20261030s look · the meeting panel (session view, floor desk, Point of order, the sitting card) can be put away.
   ✕ closes it completely; ⇥ parks it as a tab on the right edge. Either way a tab stays on the edge, so the meeting and
   every action in it (Point of order included) is one click back. Presentation only: nothing in the session changes, the
   panel is hidden with a class, not torn down. A new meeting opens the panel again. ══ */
const SXP = {park:false, closed:false, key:""};
(function(){ const st = document.createElement("style"); st.id = "sxParkCss";
  st.textContent = "#sxDock.sx-park{display:none!important}" +
    "#sxParkBar{position:fixed;z-index:70;display:none;gap:4px}#sxParkBar button{background:#000;color:#ffe08a;border:2px solid #ffe08a;border-radius:5px;font:700 13px system-ui;min-width:28px;height:26px;padding:0 7px;cursor:pointer;box-shadow:0 2px 8px #000}#sxParkBar button:hover,#sxParkBar button:focus-visible{background:#ffe08a;color:#000}" +
    "#sxTab{position:fixed;right:0;top:38vh;z-index:70;display:none;writing-mode:vertical-rl;background:#121419;color:#ffe08a;border:2px solid #c9a24a;border-right:0;border-radius:8px 0 0 8px;padding:12px 6px;font:700 13px Georgia,serif;letter-spacing:.04em;cursor:pointer;box-shadow:-3px 3px 12px #000}" +
    "#sxTab:hover,#sxTab:focus-visible{background:#ffe08a;color:#000}#sxTab.closed{padding:8px 5px;font-size:15px}";
  document.head.appendChild(st); })();
function sxParkTick(){
  try{
    const D = document.getElementById("sxDock"); if(!D) return;
    let bar = document.getElementById("sxParkBar"), tab = document.getElementById("sxTab");
    if(!bar){ bar = document.createElement("div"); bar.id = "sxParkBar";
      bar.innerHTML = '<button type="button" data-p="park" title="Park the meeting on the right edge" aria-label="Park the meeting panel on the side">\u21e5</button><button type="button" data-p="close" title="Close the meeting panel" aria-label="Close the meeting panel">\u2715</button>';
      bar.onclick = e => { const b = e.target.closest("button"); if(!b) return; if(b.dataset.p === "close"){ SXP.closed = true; SXP.park = true; } else { SXP.park = true; SXP.closed = false; } sxParkTick(); };
      document.body.appendChild(bar); }
    if(!tab){ tab = document.createElement("button"); tab.type = "button"; tab.id = "sxTab"; tab.title = "Open the meeting panel";
      tab.onclick = () => { SXP.park = false; SXP.closed = false; sxParkTick(); }; document.body.appendChild(tab); }
    const S = typeof sxdSession === "function" ? sxdSession() : null, sit = typeof SIT !== "undefined" && SIT.on ? 1 : 0;
    const key = S ? String(S.kind || "") + "|" + String(S.bodyId || S.title || "") : sit ? "sit" : "";
    if(key !== SXP.key){ SXP.key = key; SXP.park = false; SXP.closed = false; }
    D.classList.toggle("sx-park", SXP.park);
    const live = getComputedStyle(D).display !== "none" || SXP.park, shown = live && !SXP.park && D.style.display !== "none";
    if(shown){ const r = D.getBoundingClientRect(); bar.style.display = "flex"; bar.style.top = Math.max(4, r.top - 30) + "px"; bar.style.left = Math.max(4, r.right - 66) + "px"; } else bar.style.display = "none";
    const any = SXP.park && D.style.display !== "none";
    tab.style.display = any ? "block" : "none"; tab.classList.toggle("closed", SXP.closed);
    const t = (document.getElementById("sxDockHead") || {}).textContent || "";
    tab.textContent = SXP.closed ? "\u2696" : "\u2696 " + (t.replace(/^\u2696\s*/, "").replace(/(Show|Hide)$/, "").trim() || "Meeting");
    tab.setAttribute("aria-label", "Open the meeting panel");
  }catch(e){}
}
setInterval(sxParkTick, 300);
/* while you chair a cabinet or council, a seated member you click is called on in the meeting, not taken aside */
{ const _ot = openTalk; openTalk = function(m){ try{ const S = sxdSession(); if(m && S && S.chairId === "you" && (S.kind === "cabinet_meeting" || S.kind === "governor_council") && (S.seats || []).some(x => String(x.personId) === String(m.id)) && window.onumSession && typeof window.onumSession.callon === "function"){ window.onumSession.callon(m.id); return; } }catch(e){} return _ot.apply(this, arguments); }; }
/* NEPTUNE-TALKREWORK BEGIN — 20261030b; owner gate 20261030d; More/Esc/draft/bottom desk 20261030g (JUPITER contract: SIT.on → sit; PROC.on → proc; truthy SSN or ONUM_SESSION.stage!=="idle" → session; sxdSession seated check as fallback): one conversation surface per mode (UI/presentation + safe gates only; JUPITER's engine untouched).
   Open talk: one pipeline (owner gate → existing chain → one opening), TALK.seq on every delayed line, a clean close that never leaves
   TALK.open stuck, one reply box (tkOwn → LiveTalk when up, offline otherwise), a Done (Esc) button, Live/Offline chip, portrait,
   secondary actions behind "More", duplicate lines dropped. Sessions: the floor desk is the one place to speak; the session view's own
   speak box steps aside while the desk is up; Pass / Interject / Raise hand; press-conference hands as a pick row; Space finishes lines. */
try{
  const TR = window.NEPTUNE_TALKREWORK = {live:null, liveAt:0, moreOpen:false};
  const sv = f => { try{ return f(); }catch(e){ return null; } };
  /* who owns the conversation right now. strict=true also counts any open sitting/procedure (for unsolicited greetings). */
  /* 20261030g: every close and every fresh open starts with an empty reply box and wire */
  function clearDrafts(){ ["tkOwnIn", "wireIn"].forEach(id => { try{ const i = document.getElementById(id); if(i){ i.value = ""; try{ i.dispatchEvent(new Event("input")); }catch(e){} } }catch(e){} }); }
  TR.clearDrafts = clearDrafts;
  window.onumTalkOwner = function(strict){
    try{ if(typeof SIT !== "undefined" && SIT.on) return "sit"; }catch(e){}
    try{ if(typeof PROC !== "undefined" && PROC.on) return "proc"; }catch(e){}  /* always when PROC is on */
    try{ if(typeof SSN !== "undefined" && SSN) return "session"; }catch(e){}
    try{ const O = window.ONUM_SESSION; if(O && O.stage && O.stage !== "idle") return "session"; }catch(e){}
    /* prior sxdSession seated/floor/held/typing check kept as extra safety if SSN global missing */
    try{ const S = typeof sxdSession === "function" ? sxdSession() : null; if(S){
      const me = x => x === "you" || (G.you && String(x) === String(G.you.id));
      const seated = (S.seats || []).some(x => me(x && (x.personId != null ? x.personId : x)));
      if(strict && seated) return "session";
      if(seated && (me(S.floorId) || me(S.waitingOn) || S.held || S.typing)) return "session"; } }catch(e){}
    return null;
  };
  /* ---- pipeline: route → gate → (existing chain: callon / time-ask / huddle / base / opening / hooks) → decorate ---- */
  { const _inner = openTalk; openTalk = function(m){
      try{
        if(m && TALK.open && TALK.m === m){ const i = el("tkOwnIn"); if(i) i.focus(); return; }   /* already talking: no second opening */
        const S = sv(() => sxdSession());
        const seatHit = !!(m && (S.seats || []).some(x => String(x.personId) === String(m.id)));
        /* 20261030l: press seats often open with only you; reporters in the room still count for the chair */
        const pressHit = !!(S && S.kind === "press_conference" && m && (m.kind === "press" || seatHit));
        const chairRoute = !!(m && S && S.chairId === "you" && (seatHit || pressHit));
        const own = window.onumTalkOwner();
        if(m && !chairRoute && own && m !== G.you){
          const msg = own === "session" ? "You are in the sitting. Raise your hand, or wait for the recess to take " + surname(m.name) + " aside." : own === "proc" ? "You have the floor. Finish, then take " + surname(m.name) + " aside." : "Not while the sitting is on.";
          try{ const FD = window.NEPTUNE_FLOORDESK; if(FD && typeof FD.line === "function" && document.getElementById("ndFd") && !document.getElementById("ndFd").hidden) FD.line("you", "(" + msg + ")", true); else feed(msg); }catch(e){}
          return;
        }
        if(m && TALK.open && TALK.m && TALK.m !== m){ try{ closeTalk(); }catch(e){} }
        clearDrafts(); TR.moreOpen = false;
      }catch(e){}
      const r = _inner.apply(this, arguments);
      try{ if(TALK.open && TALK.m === m) decorate(); }catch(e){}
      return r;
    }; }
  /* ---- close: whatever a wrapper throws, the state is reset ---- */
  { const _c = closeTalk; closeTalk = function(){
      let r; try{ r = _c.apply(this, arguments); }catch(e){ try{ console.warn("closeTalk", e); }catch(x){} }
      finally{ try{ TALK.open = false; TALK.m = null; TALK.huddle = null; TALK.seq = (TALK.seq || 0) + 1; TR.moreOpen = false; clearDrafts();
        const t = el("talk"); if(t) t.classList.remove("is-open", "tk-more"); const b0 = el("tkOwn"); if(b0) b0.hidden = true;
        try{ wireHome(); }catch(e){} try{ picksDirty = true; }catch(e){} }catch(e){} }
      return r; }; }
  /* ---- duplicate lines: the same words from the same voice within 2s are shown once ---- */
  { const _am = appendMsg; appendMsg = function(kind, text, who){
      try{ const log = el("chatLog"), last = log && log.lastElementChild, now = Date.now();
        if(last && text && last._k === kind + "|" + (who || "") + "|" + text && now - (last._at || 0) < 2000) return last.lastChild; }catch(e){}
      const sp = _am.apply(this, arguments);
      try{ const d = sp && sp.parentNode; if(d){ d._k = kind + "|" + (who || "") + "|" + text; d._at = Date.now(); } }catch(e){}
      cvKick(); return sp; }; }
  { const _tl = tlog; const seen = []; tlog = function(who, line, kind){
