      try{ note("Your discharge petition on the " + b.title + " has " + sig + " signatures, a majority of the House (" + need + " needed). The bill comes out of the Committee on " + R.t + " and keeps its day on the calendar.", true); }catch(e){}
      return false; }
    try{ note("Your discharge petition on the " + b.title + " has " + sig + " signatures; it needed " + need + ". The bill stays in the Committee on " + R.t + ".", true); }catch(e){}
  }
