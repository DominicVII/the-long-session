{ const _scb8 = saveCaptureBase; saveCaptureBase = function(){ const o = _scb8.apply(this, arguments); try{ o.hopper = (G.hopper || []).map(b => Object.assign({}, b)); }catch(e){} return o; }; }
setInterval(() => { try{ if(G && G.you && G.day != null && G._hopDay !== G.day){ const first = G._hopDay == null; G._hopDay = G.day; if(!first){ hopDay(); if(G.day % 7 === 0) formerPrune(); } } }catch(e){} }, 2700);

/* ══ 20261027b · THE ROAD, KEPT HONEST. A bill its committee reports unfavourably dies there; a member may try to discharge their
   own with the signatures of a majority of the House. Titles are unique and properly cased, and a member's own bill goes to
   committee like anyone's. The Senate and the statehouses vote as parties, with members breaking where home pulls hard the
   other way. A State does not pass the same law twice; it may repeal one its people have turned against. An act the President
   leaves on the desk ten days becomes law without a signature, and one left unsigned when the Congress ends is pocket-vetoed.
   The overnight lines come from the record; the national mood and approval settle back toward where the country is. ══ */
function partyShortOf(nm){ const w = String(nm || "").replace(/^(the|a|an)\s+/i, "").trim(); if(!w) return "Own"; const parts = w.split(/\s+/); return parts.length <= 2 ? w : parts[0]; }
function rivalOffice(){ try{ return heldOffice() || "house"; }catch(e){ return "house"; } }
function rivalTarget(){
  const y = G.you, k = rivalOffice(), you = surname(y.name);
  if(k === "pres") return "whoever stands against " + you + " for " + execTitleSafe() + " at the next election";
  if(k === "senate") return "a challenger for " + you + "'s Senate seat in " + y.state;
  if(k === "gov") return "a challenger for the Governor's chair in " + y.state;
  if(k === "bench") return "a campaign to have " + you + " removed from the bench";
  return "a challenger in " + y.state + " " + (y.dist || "");
}
/* the committee that has the subject, not the one whose axis is loudest */
function lxCmDom(d){ return ({rail:"ways", levee:"ways", tariff:"ways", school:"health", navy:"armed", court:"judic", land:"ways", bank:"ways", labour:"health", docks:"ways", health:"health", press:"judic", census:"judic", gas:"ways", visa:"judic", border:"judic", natur:"judic", aid:"ways", arms:"armed", mandate:"health", preempt:"judic"})[d] || null; }
/* ── titles: unique, and cased as titles ── */
function lxTitleCase(t){ const minor = /^(and|of|the|for|to|in|on|a|an|by|with|at|or)$/i; return String(t || "").split(" ").map((w, i) => i > 0 && minor.test(w) ? w.toLowerCase() : w.replace(/^([a-z])/, c => c.toUpperCase())).join(" "); }
function billTitlesInUse(){
  const s = new Set(), add = t => { if(t) s.add(String(t).toLowerCase()); };
  if(G.bill) add(G.bill.title); (G.billQueue || []).forEach(b => add(b && b.title)); (G.hopper || []).forEach(b => add(b && b.title));
  (G.statute || []).forEach(x => add(x && x.title)); ((G.lx && G.lx.died) || []).forEach(x => add(x && x.t)); return s;
}
{ const _mb = makeBill; makeBill = function(){
  const used = billTitlesInUse(); let b = null;
  for(let i = 0; i < 6; i++){ b = _mb.apply(this, arguments); if(!b || !b.title) return b; b.title = lxTitleCase(b.title); const key = b.title.toLowerCase(); if(!used.has(key)) break;
    const prior = (G.statute || []).find(x => x && x.title && x.title.toLowerCase() === key && x.fate === "carried");
    if(prior && !/ Amendments (Act|Bill)$/.test(b.title)){ const t2 = b.title.replace(/ (Act|Bill)$/, " Amendments $1"); if(t2 !== b.title && !used.has(t2.toLowerCase())){ b.title = t2; b.amendsAct = prior.title; break; } } }
  if(b && b.kind === "foreign" && /^the /i.test(b.realmT || "")){ const rn = b.realmT.replace(/^the /i, ""); b.title = b.title.replace(new RegExp("^(Arms|Aid) to " + rn.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + " "), "$1 to the " + rn + " "); }
  if(b && b.title && used.has(b.title.toLowerCase())){ let n = 2; while(used.has((b.title + " (No. " + n + ")").toLowerCase())) n++; b.title += " (No. " + n + ")"; }
  return b; }; }
/* a member's bill enters the hopper like any other */
function hopAdmit(b){
  if(!b || typeof hopStore !== "function") return false; const H = hopStore(); if(H.length >= 16) return false;
  b.filed = G.day; b.voteDay = null; b.hop = true; try{ lxRoad(b); }catch(e){}
  if(b.road){ b.road.mark = G.day + 3 + (seedOf(b.title + G.day) % 10); b.road.ref = G.day; }
  H.push(b); return true;
}
/* a live bill keeps the floor: two callers asking for the next bill in the same moment must not throw one away */
