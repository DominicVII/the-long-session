  return M.length > 1 && M[1].t !== M[0].t ? "Dreamt about " + q(M[0].t) + ", and " + q(M[1].t) + " was somehow part of it." : "Dreamt about " + q(M[0].t) + " again.";
}
/* noticing, in their own record */
function wlNotice(m){
  const s = (G.statute || []).find(x => x && x.v && x.v[m.id]);
  if(s) return "I voted " + (s.v[m.id] > 0 ? "aye" : "no") + " on the " + s.title + " on day " + s.day + ". I can tell you the count, " + s.aye + " to " + s.no + "; I cannot tell you the moment I decided.";
  const e = (m.mem || [])[0]; if(e && e.t) return "I wrote down: “" + String(e.t).replace(/\.$/, "") + ".” Reading it back, I do not remember choosing the words.";
  return null;
}
/* what you find in the morning is something somebody actually did */
function wlHappening(news){
  const life = lifeEnsure(), S = wlStore(); if(life.pending || G.day - (S.at.hap || -99) < 3 || !G.you) return;
  const y = G.you;
  for(const s of (G.statute || []).slice(0, 6)){
    if(!s || !s.v || s.yv == null || G.day - (s.day || 0) > 3) continue;
    let L = {}; try{ L = partyLine({pos:s.pos || {econ:0, lib:0, def:0, wel:0}, title:s.title}); }catch(e){}
    const quiet = wlCast().filter(m => s.v[m.id] === s.yv && L[m.party] && L[m.party] !== s.yv && m.rel && m.rel.warmth > 10);
    if(quiet.length){ S.at.hap = G.day; life.pending = {k:"vote", d:G.day + 1, t:"A note under your door: “I voted with you on the " + s.title + ", against my own whip. Do not thank me.” Unsigned; the clerk's roll would tell you who."}; return; }
  }
  const ask = (typeof hopStore === "function" ? hopStore() : []).map(b => ({b, m:byId(b.sponsorId)})).filter(x => x.m && !x.m.gone && x.b.road && !x.b.road.done && (x.m.rel && x.m.rel.warmth >= 25) && wlT(x.m, "ambition") >= 55)[0];
  if(ask){ S.at.hap = G.day; life.pending = {k:"bill", d:G.day + 1, t:"On your chair: the " + ask.b.title + ", with " + ask.m.name + "'s card clipped to it. The Committee on " + ask.b.road.t + " marks it up on day " + ask.b.road.mark + "."}; }
}
function wlHomeWorse(m){ const H = wlStore().unrest[m.state] || []; return H.length >= 3 && H[H.length - 1] - H[Math.max(0, H.length - 4)] >= 3; }
/* the long aims of the night no longer hand out friends, feuds, blocs and bills: those are chosen now, from the record */
{ const _lna = lifeNewAim; lifeNewAim = function(m){ const r = _lna.apply(this, arguments); try{ const A = m.lv && m.lv.aim; if(A && /^(bill|bloc|friend|feud)$/.test(A.k)){ A.k = wlT(m, "conviction") >= 55 ? "faith" : "notice"; A.t = null; } }catch(e){} return r; }; }
{ const _hv6 = holdVote; holdVote = function(){ const r = _hv6.apply(this, arguments); try{ wlAfterVote(); }catch(e){} return r; }; }
{ const _on2 = overnight; overnight = function(){ const r = _on2.apply(this, arguments); try{ wlNight(Array.isArray(r) ? r : []); }catch(e){ try{ console.warn("will night", e); }catch(x){} } return r; }; }
{ const _scb10 = saveCaptureBase; saveCaptureBase = function(){ const o = _scb10.apply(this, arguments); try{ o.wl = G.wl || null; }catch(e){} return o; }; }
/* who has a reason to write to you today, and why */
function wlTexter(L){
  const S = wlStore(), b = G.bill && !G.bill.done ? G.bill : null;
  const c = L.map(m => { let st = 0; try{ st = b ? stakeIn(m, b).level : 0; }catch(e){} const w = (m.rel && m.rel.warmth) || 0; return {m, v:Math.max(st * 12, Math.abs(w) - 20), intent:st >= 3 ? "ask" : w < -15 ? "warn" : "gossip"}; })
    .filter(x => x.v >= 20 && G.day - (S.at["dm" + x.m.id] || -99) >= 3).sort((u, v) => v.v - u.v)[0];
  if(c) S.at["dm" + c.m.id] = G.day; return c || null;
}
/* who talks to whom: allies keep each other informed, and people with a quarrel say so */
function wlPairs(L){
  const out = []; L.forEach(a => { (a.allies || []).forEach(id => { const b = byId(id); if(b && L.indexOf(b) >= 0 && out.length < 3 && !out.some(p => p[0] === b && p[1] === a)) out.push([a, b]); }); });
  L.forEach(a => { if(out.length >= 4) return; const W = wlWorst(a); if(W && W.t !== G.you && L.indexOf(W.t) >= 0 && W.r <= -20) out.push([a, W.t]); });
  return out.slice(0, 4);
