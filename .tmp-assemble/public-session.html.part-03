/* ══ 20261030o · room change tears down room chrome: the press session panel (#ndSess / #ndFd) lingered over the
   Statuary Corridor after Walk out (ssnTick bails while a card is up), and the Court showed corridor nametags
   (plates only refresh while standing still). A watcher that ignores cards and walking: new room -> close a session
   that belongs to another room, hide the desk, blank every plate. A dismissed (Cancel) sitting stays shut here. ══ */
(function(){
  try{
    const _so = ssnOpen;
    ssnOpen = function(o){ try{ if(G && G._ssnDismiss && G._ssnDismiss === G.room && !(o && o.auto === false)) return null; }catch(e){} return _so.apply(this, arguments); };
  }catch(e){}
  let lastRoom = null;
  setInterval(() => { try{
    if(!G) return;
    if(typeof SSN !== "undefined" && SSN && SSN.room && SSN.room !== G.room){
      ssnClose(); try{ const d = document.getElementById("ndFd"); if(d) d.hidden = true; }catch(e){} try{ const p = document.getElementById("ndSess"); if(p && !window.ONUM_SESSION) p.remove(); }catch(e){}
    }
    if(!window.ONUM_SESSION){ const p = document.getElementById("ndSess"); if(p) p.remove(); }
    if(G.room !== lastRoom){
      lastRoom = G.room;
      if(G._ssnDismiss && G._ssnDismiss !== G.room) G._ssnDismiss = null;
      try{ for(const d of plates){ d._shown = 0; d._sig = ""; d.style.display = "none"; } }catch(e){}
    }
  }catch(e){} }, 200);
})();

/* ══ 20261030q · plate watcher: a plate only stands while its person is in front of you, in this room and unwalled. Facing a blank
   corridor wall (or with updatePlates skipped: a card up, a throw, a frame budget) the last tags lingered. Independent of the frame loop. ══ */
(function(){
  setInterval(() => { try{
    if(!G || typeof plates === "undefined") return; const here = hereNow(), lx = Math.sin(cam.yaw), lz = Math.cos(cam.yaw);
    for(const d of plates){ if(!d || d._shown !== 1 || !d.children[0]) continue; const nm = d.children[0].textContent, p = here.find(q => q && q.name === nm);
      const ok = p && p.room === G.room && !p.gone && Math.hypot(p.x - cam.x, p.z - cam.z) < 11 && ((p.x - cam.x) * lx + (p.z - cam.z) * lz) > 0.35 && !plateBlocked(p);
      if(!ok){ d._shown = 0; d._sig = ""; d.style.display = "none"; } }
  }catch(e){} }, 250);
})();

/* ══ 20261030c · SESSIONS AND OPEN TALK, OPTIMISED.
   Press conference is an ONUM_SESSION (not the step-by-step sitting): the President opens,
   reporters raise hands into the queue, you call on one, their question waits with no timeout,
   you answer, then the next hand. Open talk no longer auto-opens when someone wants a word
   (hail corner note + mail + E when close only). LiveTalk is the single reply path when it is
   up; chairing a press conference calls on a reporter the same way cabinet does. ══ */
(function(){
  try{
    if(!window.ONUM_PROCEDURE) return;
    if(!window.ONUM_PROCEDURE.executive) window.ONUM_PROCEDURE.executive = {bodies:{}};
    const ST = typeof SSN_ST === "function" ? SSN_ST : function(id, name, speaker, secs, allows){ return {id, name, speaker, secs:secs||0, timed:false, allows:allows||[]}; };
    window.ONUM_PROCEDURE.executive.bodies.press_conference = {
      stages:[
        ST("call","The President opens the conference","president",0,["speak","yield","interject"]),
        ST("questions","Questions from the gallery","queue",0,["seek","speak","yield","interject","point_of_order"]),
        ST("wrap","Closing statement","president",0,["speak","yield"]),
        ST("adjourn","The conference ends","chair",0,[])
      ],
      recognition:"chair_picks",
      timeRules:{perSpeaker:0, unlimited:true, yieldable:true},
      voteMethods:[],
      motions:{},
      agenda:["Opening statement","Questions from the press","Closing"]
    };
    try{ SSN_ROOM.press = ["executive", "press_conference"]; }catch(e){}

    function prKind(){ return !!(SSN && SSN.kind === "press_conference"); }
    function prReporters(){
      let ps = [];
      try{ ps = (hereNow() || []).filter(p => p && p !== G.you && !p.gone && p.kind === "press"); }catch(e){}
      if(ps.length < 3){ try{ (G.press || []).forEach(p => { if(p && !p.gone && ps.indexOf(p) < 0) ps.push(p); }); }catch(e){} }
      return ps.slice(0, 12);
    }
    /* you chair any press conference you open */
    { const _yc = typeof ss2YouChair === "function" ? ss2YouChair : null;
      window.ss2YouChair = ss2YouChair = function(kind){ if(kind === "press_conference") return true; return _yc ? _yc(kind) : false; }; }
    { const _en = typeof ss2Entitled === "function" ? ss2Entitled : null;
      window.ss2Entitled = ss2Entitled = function(kind){ if(kind === "press_conference") return true; return _en ? _en(kind) : true; }; }

    /* open: seat the reporters and put you in the chair */
    { const _op = ssnOpen;
      ssnOpen = function(o){
        o = o || {};
        if(o.kind === "press_conference" && !o.people) o.people = prReporters();
        const r = _op.apply(this, arguments);
        try{
          if(r && r.kind === "press_conference"){
            r.chairId = "you";
            if(!r.seats.some(s => s.personId === "you")) r.seats.push({seatId:"you", personId:"you"});
            r.seats = r.seats.filter(s => s.personId === "you" || (byId(s.personId) && byId(s.personId).kind === "press"));
            SS2.hold = false; SS2.stageSaid = 0; SS2.chairSaid = false; SS2.budget = Math.min(8, Math.max(3, r.seats.length - 1));
            if(typeof ss2Pub === "function") ss2Pub(); else ssnPublish();
          }
        }catch(e){}
        return r;
      };
    }

    /* reporters raise hands and ask live; your answer never times out */
    function prAskLine(m){
      let t = "";
      try{ const b = G.bill && !G.bill.done ? G.bill : null; const topic = b ? b.title : (typeof wmBrief === "function" ? (wmBrief() || "today's business") : "today's business");
        t = pick([
          "Mr. President — on " + topic + ", what is your answer for the record?",
          "A question, if I may: who pays for this, and when?",
          "The galleries want a straight answer on " + topic + ". Do you have one?",
          (m.outlet || "My paper") + " asks: will you stand by that tomorrow?",
          "Follow-up: what changes for the districts that are already hurting?"
        ]);
      }catch(e){ t = "A question for the record, Mr. President."; }
      return t;
    }
    async function prLiveQ(m){
      const LT = window.onumLiveTalk; if(!LT || !LT.reply || !m) return prAskLine(m);
      let out = "";
      try{
        const you = (typeof ndYou === "function" ? ndYou() : null) || {};
        const topic = (G.bill && !G.bill.done && G.bill.title) || "the Republic today";
        const r = await Promise.race([
          LT.reply({npcId:m.id, channel:"press", text:"(You have been called on at the press conference.)",
            extra:"You are " + m.name + ", " + (m.role || "a reporter") + (m.outlet ? " for " + m.outlet : "") + ". You are at a press conference chaired by " + (you.address || "the President") + ". Ask ONE sharp question about " + topic + ". One or two sentences. No stage directions. Do not answer yourself."}),
          new Promise(res => setTimeout(() => res(null), 20000))
        ]);
        out = r && r.text ? String(r.text) : "";
      }catch(e){}
      out = (typeof engWhole === "function" ? engWhole(engClean(out)) : String(out || "").trim());
      return out || prAskLine(m);
    }
    function prShow(m, out){
      try{ speakAt(m, out); }catch(e){}
      try{ tlog(m.name, out, "talk"); }catch(e){}
      try{ lLog(m.name + ": " + out.slice(0, 160), "session"); }catch(e){}
      if(SSN){ SSN.lastSpk = m.id; SS2.spkUntil = Date.now() + (typeof ss2Read === "function" ? ss2Read(out) : 4000); try{ ssnEnsure().log.push({d:G.day, kind:SSN.kind, act:"ask", who:m.name, t:out.slice(0, 120)}); }catch(e){} if(typeof ss2Pub === "function") ss2Pub(); }
    }

    /* call on a reporter: they ask, then the floor returns to you and waits */
    const _cabCall = typeof cabCallOn === "function" ? cabCallOn : null;
    function prCallOn(id){
      try{
        if(!prKind()) return _cabCall ? _cabCall(id) : false;
        const p = byId(isNaN(+id) ? id : +id); if(!p || p.kind !== "press") return false;
        SSN.queue = (SSN.queue || []).filter(x => String(x) !== String(p.id));
        SSN.floorId = p.id; SSN._busy = Date.now() + 90000; if(typeof ss2Pub === "function") ss2Pub(); else ssnPublish();
        const tok = SSN._tok = (SSN._tok || 0) + 1;
        prLiveQ(p).then(out => {
          if(!SSN || tok !== SSN._tok || !prKind()) return;
          prShow(p, out);
          /* floor to you for the answer — never times out */
          SSN.floorId = "you"; SSN.offer = "you"; SSN.waitingOn = "you"; SSN._busy = 0;
          SS2.spkUntil = 0; SS2.hold = false;
          ssnPublish();
          try{ note(p.name + " asked. The floor is yours."); }catch(e){}
        });
        return true;
      }catch(e){ return false; }
    }
    window.onumSession = window.onumSession || {};
    window.onumSession.callon = prCallOn;

    /* while questions run, keep a few hands raised; never advance past your turn */
    { const _tk = ssnTick;
      ssnTick = function(){
        try{
          if(SSN && prKind()){
            const st = ssnStage();
            if(st && st.id === "questions"){
              if(SS2.hold || SSN.floorId === "you" || (SSN._busy && Date.now() < SSN._busy)) return;
              /* seed hands */
              if((SSN.queue || []).length < 3){
                const cand = (SSN.seats || []).map(s => s.personId).filter(id => id !== "you" && (SSN.queue || []).indexOf(id) < 0 && id !== SSN.floorId && (SSN.out || []).indexOf(id) < 0);
                const c = cand[Math.floor(Math.random() * cand.length)];
                if(c && chance(0.35)) SSN.queue.push(c);
              }
              /* do not auto-recognize: chair picks via callon */
              if(SSN.floorId != null && SSN.floorId !== "you"){
                if(Date.now() < SS2.spkUntil) return;
                /* question finished speaking → wait on you */
                SSN.floorId = "you"; SS2.spkUntil = 0; if(typeof ss2Pub === "function") ss2Pub(); return;
              }
              if(SSN.floorId === "you") return;
              if(typeof ss2Pub === "function") ss2Pub();
              return;
            }
            if(st && (st.id === "call" || st.id === "wrap") && SSN.floorId === "you") return;
          }
        }catch(e){}
        return _tk.apply(this, arguments);
      };
    }

    /* after you answer a question, clear the floor so the next hand can wait */
    { const _ev = window.onumSessionEvent;
      window.onumSessionEvent = function(e){
        const r = _ev.apply(this, arguments);
        try{
          if(SSN && prKind() && e && (e.actorId === "you" || (G.you && e.actorId === G.you.id)) && e.action === "speak"){
            const st = ssnStage();
            if(st && st.id === "questions"){ SSN.floorId = null; SSN.offer = null; SSN.waitingOn = null; SS2.gapUntil = Date.now() + 1200; ssnPublish(); }
            else if(st && st.id === "call"){ /* opening done → questions */ try{ ssnNext(); }catch(x){} }
            else if(st && st.id === "wrap"){ try{ ssnNext(); }catch(x){} }
          }
        }catch(x){}
        return r;
      };
    }

    /* pass from chair during questions advances or skips a hand */
    { const _pass = window.onumSession.pass;
      window.onumSession.pass = function(){
        if(prKind()){
          const st = ssnStage();
          if(st && st.id === "questions"){ SSN.floorId = null; SSN.offer = null; SSN.waitingOn = null; SSN.queue = (SSN.queue || []).filter(x => x !== "you"); SS2.hold = false; SS2.gapUntil = Date.now() + 800; ssnPublish(); return true; }
          if(st && (st.id === "call" || st.id === "wrap")){ try{ ssnNext(); }catch(e){} return true; }
        }
        return typeof _pass === "function" ? _pass.apply(this, arguments) : false;
      };
    }

    /* podium / docket / legacy sitStart("press") → session */
    function openPressConference(){
      try{
        if(typeof goTo === "function" && G.room !== "press"){ try{ goTo("press"); }catch(e){} }
        const ok = window.onumSession.open({gov:"executive", kind:"press_conference", room:"press", auto:false, people:prReporters()});
        if(ok){ try{ kMark("sxpress"); kMarkChamber(); }catch(e){} try{ note("Press conference open. Hands will rise; call on a reporter when ready."); }catch(e){} return true; }
      }catch(e){}
      return false;
    }
    { const _ss = sitStart;
      sitStart = function(room){
        const r = String(room || "").split(":")[0];
        if(r === "press"){ if(openPressConference()) return; }
        return _ss.apply(this, arguments);
      };
    }
    /* also catch the old office act that still rolls a press conference */
    try{
      const P = (PROPS.press || []).find(p => p.id === "podium");
      if(P && P.acts){ const a0 = P.acts; P.acts = function(){ let A = []; try{ A = a0.apply(this, arguments) || []; }catch(e){ A = []; }
        A = A.filter(x => !x || !/press conference/i.test(String(x.t || "")));
        A.unshift({t:"Hold a press conference", c:"untimed · call on reporters", off:(typeof kOnceToday === "function" ? kOnceToday("sxpress") : false), run(){ openPressConference(); return null; }});
        return A; }; }
    }catch(e){}

    /* click a reporter while you chair → call on them, do not open 1:1 talk */
    { const _ot = openTalk;
      openTalk = function(m){
        try{
          const S = window.ONUM_SESSION;
          const isReporter = !!(m && (m.kind === "press" || (S && (S.seats || []).some(x => String(x.personId) === String(m.id) && String(x.personId) !== "you"))));
          if(m && S && S.kind === "press_conference" && S.chairId === "you" && isReporter && window.onumSession && typeof window.onumSession.callon === "function"){
            window.onumSession.callon(m.id); return;
          }
        }catch(e){}
        return _ot.apply(this, arguments);
      };
    }
    /* 20261030l: keep press seats filled with reporters in the room so chairRoute / callon stay valid */
    { const _tick = typeof ss2Tick === "function" ? ss2Tick : null;
      function prSyncSeats(){
        try{
          if(typeof SSN === "undefined" || !SSN || SSN.kind !== "press_conference") return;
          const ps = prReporters() || [];
          const have = {};
          (SSN.seats || []).forEach(x => { if(x && x.personId != null) have[String(x.personId)] = true; });
          let n = 0;
          ps.forEach(p => {
            if(!p || p.id == null || have[String(p.id)]) return;
            SSN.seats.push({seatId:"pr" + (SSN.seats.length + 1), personId:p.id});
            have[String(p.id)] = true; n++;
          });
          if(n && typeof ssnPublish === "function") ssnPublish();
        }catch(e){}
      }
      if(_tick){ window.ss2Tick = ss2Tick = function(){ try{ prSyncSeats(); }catch(e){} return _tick.apply(this, arguments); }; }
      else setInterval(prSyncSeats, 1500);
    }

    /* ── open talk: no auto-open on wantsWord; LiveTalk is the one reply path ── */
    { const _cv = converse;
      converse = async function(m, text){
        if(!m || !text) return;
        try{
          const LT = window.onumLiveTalk;
          if(LT && LT.reply && TALK.open && TALK.m === m && typeof tkOwnSay === "function"){
            return tkOwnSay(m, text);
          }
        }catch(e){}
        /* hold wantsWord so the legacy converse body cannot yank-open talk for a hail */
        var held = null;
        try{
          if(m.wantsWord && (!TALK.open || TALK.m !== m)){ held = m.wantsWord; m.wantsWord = null; }
        }catch(e){}
        try{ return await _cv.apply(this, arguments); }
        finally { try{ if(held && m && !m.wantsWord) m.wantsWord = held; }catch(e){} }
      };
    }

    console.log("JUPITER 20261030f: press floor publish offer/waitingOn/lastSpk; NOW strip is you-only on your turn");
  }catch(e){ try{ console.warn("JUPITER 20261030c", e); }catch(x){} }
})();


armFrame();

})();
</script>


<script>
/* Neptune 20261021l: HUD layout manager (onumHud). Edge docks (left/right columns, top strip, bottom bar);
   panels stack in their dock and never overlap; centre (middle 50% x 60%) stays clear except modals the player opened.
   Every docked panel gets a collapse control and leaves a reopen tab. Always-on bottom bar in immersive: Say aloud + Cables. */
(function(){
  "use strict";
  if(window.onumHud) return;
  const GAP = 6, PAD = 8;
  /* dock: L/R/T/B; talk = compact talk row; chip = tiny control merged into the bottom bar */
  const REG = [
    {s:"#prompt", d:"R", n:"Prompt", noX:1},
    {s:"#hail", d:"R", n:"Wants a word", talk:1},
    {s:"#apToast", d:"R", n:"Stops you", talk:1},
    {s:"#kClock", d:"R", n:"Clock", noX:1, small:1},
    {s:"#sxDock", d:"R", n:"Meeting"},
    {s:"#feed", d:"R", n:"Feed"},
    {s:".hud", d:"L", n:"Place", noX:1, small:1},
    {s:"#aimsHud", d:"L", n:"Aims", noX:1, small:1},
    {s:"#clDock", d:"L", n:"Notices", noX:1, small:1},
    {s:".notices", d:"L", n:"Notices"},
    {s:"#cvLive", d:"L", n:"Room log", cap:150},
    {s:"#procBar", d:"L", n:"Procedure"},
    {s:"#tele", d:"L", n:"Status"},
    {s:"#job", d:"L", n:"Checklist"},
    {s:".quest,#quest,#questBox,#ckList", d:"L", n:"Checklist"},
    {s:".ach-toast", d:"T", n:"Toast"},
    {s:"#tipCard", d:"T", n:"Tip"},
    {s:"#ndFd", d:"B", n:"Floor desk"},
    {s:"#ltPill", chip:1}, {s:"#ltChatBtn", chip:1}, {s:"#dmBadge", chip:1}, {s:"#ndBuild", chip:1}
  ];
  const H = window.onumHud = {collapsed:{}, last:null};
  const css = document.createElement("style"); css.id = "hmCss";
  css.textContent = ".hm-col{display:none!important}" +
    ".hmX{position:absolute!important;top:2px!important;right:2px!important;z-index:5!important;width:20px;height:20px;line-height:16px;padding:0!important;margin:0!important;border:1px solid #c9a24a!important;border-radius:4px;background:#0d0f13!important;color:#f4f1e8!important;font:700 13px system-ui!important;cursor:pointer;pointer-events:auto!important;min-height:0!important}" +
    ".hm-p{pointer-events:auto!important}" +
    "#hmBar{position:fixed;left:8px;right:8px;bottom:6px;z-index:10050;display:flex;gap:6px;align-items:center;background:#0d0f13;color:#f4f1e8;border:1px solid #c9a24a;border-radius:8px;padding:4px 6px;font:13px system-ui,sans-serif;box-sizing:border-box}" +
    "#hmBar[hidden]{display:none}#hmBar input{flex:1;min-width:80px;background:#1b1f27;color:#fff;border:1px solid #5a6474;border-radius:5px;padding:5px 8px;font:13px system-ui}" +
    "#hmBar button,.hmTab{background:#2b333d;color:#fff;border:1px solid #c9a24a;border-radius:5px;padding:4px 8px;font:600 12px system-ui;cursor:pointer;white-space:nowrap}" +
    "#hmBar .hmChips{display:flex;gap:4px;align-items:center;flex-wrap:nowrap;overflow:hidden}#hmBar .hmChips>*{position:static!important;transform:none!important;margin:0!important}" +
    "#hmBar.hm-desk #hmSayWrap{display:none}#hmSayWrap{display:flex;flex:1;gap:6px;align-items:center;min-width:0}" +
    ".hm-talk{display:flex!important;gap:8px;align-items:center;font-size:12px!important;padding:6px 26px 6px 6px!important}" +
    ".hm-talk .hmPort{flex:none;width:40px;height:40px;border-radius:50%;border:1px solid #c9a24a;background:#2a2f3a;color:#fff;font:700 15px system-ui;display:flex;align-items:center;justify-content:center;overflow:hidden}" +
    ".hm-talk .hmPort canvas{width:40px;height:40px}.hm-talk .hmBody{flex:1;min-width:0}";
  document.head.appendChild(css);
  const vis = e => { if(!e || !e.isConnected || e.hidden || e.classList.contains("hm-col")) return false; const cs = getComputedStyle(e); if(cs.display === "none" || cs.visibility === "hidden") return false; const r = e.getBoundingClientRect(); return r.width > 1 && r.height > 1; };
  const set = (e, k, v) => { if(e.style.getPropertyValue(k) !== v || e.style.getPropertyPriority(k) !== "important") e.style.setProperty(k, v, "important"); };
  const gG = () => { try{ return window.NEPTUNE && typeof NEPTUNE.debug === "function" ? NEPTUNE.debug().G : null; }catch(e){ return null; } };
  const inGame = () => { const g = gG(); return !!(g && g.you && g.room); };
  /* ----- bottom bar ----- */
  let bar = null, tabs = null, chips = null;
  function say(text){
    text = String(text || "").trim(); if(!text) return false;
    try{ const S = window.onumSession; if(S && typeof S.speak === "function" && (window.ONUM_SESSION ? window.ONUM_SESSION.open !== false : true) && document.getElementById("ndFd")){ S.speak(text); return true; } }catch(e){}
    try{ const wi = document.getElementById("wireIn"), ws = document.getElementById("wireSend"); if(wi && ws){ wi.value = text; ws.click(); return true; } }catch(e){}
    try{ if(typeof wireSend === "function"){ const wi = document.getElementById("wireIn"); if(wi) wi.value = text; wireSend(); return true; } }catch(e){}
    return false;
  }
  H.say = say;
  function cables(){ try{ if(typeof dmToggle === "function"){ dmToggle(true); return; } }catch(e){} try{ const b = document.getElementById("dmBadge"); if(b) b.click(); }catch(e){} }
  H.cables = cables;
  function mkBar(){
    if(bar && bar.isConnected) return;
    bar = document.createElement("div"); bar.id = "hmBar"; bar.className = "hm-p";
    bar.innerHTML = '<span id="hmSayWrap"><b style="white-space:nowrap">Say aloud</b><input id="hmSay" type="text" maxlength="400" autocomplete="off" placeholder="Speak to the room, or whoever is near (Enter)"><button type="button" id="hmSayGo">Say</button></span>' +
      '<button type="button" id="hmCab" title="Cables and messages">\u2709 Cables</button><span class="hmTabs"></span><span class="hmChips"></span>';
    document.body.appendChild(bar); tabs = bar.querySelector(".hmTabs"); chips = bar.querySelector(".hmChips");
    const inp = bar.querySelector("#hmSay");
    const go = () => { if(say(inp.value)){ inp.value = ""; } else { inp.placeholder = "Nobody can hear you here yet."; } };
    bar.querySelector("#hmSayGo").onclick = go; bar.querySelector("#hmCab").onclick = cables;
    const stop = e => { e.stopPropagation(); };
    inp.addEventListener("keydown", e => { e.stopPropagation(); if(e.key === "Enter"){ e.preventDefault(); go(); } else if(e.key === "Escape"){ inp.blur(); } });
    inp.addEventListener("keyup", stop); inp.addEventListener("keypress", stop);
  }
  /* Ctrl/Meta combos (copy, paste, select all, undo...) in any text field: let the browser have them, no game handler sees them. */
  const editable = t => t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
  window.addEventListener("keydown", e => { if((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey && e.key !== "Enter" && editable(e.target)) e.stopImmediatePropagation(); }, true);
  /* ----- collapse/reopen ----- */
  function addX(e, r){
    if(r.noX || e.querySelector(":scope>.hmX")) return;
    if(getComputedStyle(e).position === "static") set(e, "position", "fixed");
    const x = document.createElement("button"); x.type = "button"; x.className = "hmX"; x.textContent = "\u2013"; x.title = "Collapse " + r.n + " (reopen from the bar)";
    x.onclick = ev => { ev.stopPropagation(); collapse(e, r); };
    e.appendChild(x);
  }
  function collapse(e, r){ e.classList.add("hm-col"); const k = r.s; H.collapsed[k] = r.n; layout(); }
  H.collapse = sel => { const r = REG.find(q => q.s === sel); const e = r && document.querySelector(r.s); if(e) collapse(e, r); };
  H.reopen = sel => { document.querySelectorAll(sel).forEach(e => e.classList.remove("hm-col")); delete H.collapsed[sel]; layout(); };
  function drawTabs(){
    if(!tabs) return; const want = Object.keys(H.collapsed).filter(s => document.querySelector(s));
    const key = want.join("|"); if(tabs.dataset.k === key) return; tabs.dataset.k = key; tabs.innerHTML = "";
    want.forEach(s => { const b = document.createElement("button"); b.type = "button"; b.className = "hmTab"; b.textContent = "\u25B8 " + H.collapsed[s]; b.title = "Reopen"; b.onclick = () => H.reopen(s); tabs.appendChild(b); });
  }
  /* ----- compact talk rows with a portrait ----- */
  function talkify(e){
    if(e.querySelector(":scope>.hmPort")) return;
    const txt = (e.innerText || "").trim(); if(!txt) return;
    e.dataset.hmT = "1"; e.classList.add("hm-talk");
    const id = e.dataset.npc; let port = document.createElement("span"); port.className = "hmPort";
    try{ if(id != null && window.onumFamilyTree && typeof onumFamilyTree.portrait === "function"){ const c = onumFamilyTree.portrait(id, null, 80); if(c) port.appendChild(c); } }catch(x){}
    if(!port.firstChild){ const nm = e.dataset.name || txt.split(/\s+/).slice(0, 2).join(" "); port.textContent = nm.split(/\s+/).map(w => w[0] || "").join("").slice(0, 2).toUpperCase(); }
    const body = document.createElement("div"); body.className = "hmBody"; while(e.firstChild) body.appendChild(e.firstChild);
    e.appendChild(port); e.appendChild(body);
  }
  /* ----- layout ----- */
  function place(e, o){
    set(e, "position", "fixed"); set(e, "transform", "none"); set(e, "margin", "0"); set(e, "box-sizing", "border-box");
    set(e, "left", o.left == null ? "auto" : o.left + "px"); set(e, "right", o.right == null ? "auto" : o.right + "px");
    set(e, "top", o.top == null ? "auto" : o.top + "px"); set(e, "bottom", o.bottom == null ? "auto" : o.bottom + "px");
    if(o.w != null){ set(e, "width", o.w + "px"); set(e, "max-width", o.w + "px"); }
    if(o.mh != null){ set(e, "max-height", o.mh + "px"); set(e, "overflow", "auto"); }
    e.classList.add("hm-p");
  }
  function layout(){
    const W = innerWidth, Ht = innerHeight;
    const game = inGame();
    mkBar();
    bar.hidden = !game;
    const desk = document.getElementById("ndFd"); bar.classList.toggle("hm-desk", !!(desk && vis(desk)));
    /* chips into the bar */
    REG.filter(r => r.chip).forEach(r => { const e = document.querySelector(r.s); if(e && e.parentElement !== chips && game) chips.appendChild(e); });
    drawTabs();
    const colW = Math.max(160, Math.floor(W * 0.25) - PAD * 2), bandB = Math.max(Math.round(Ht * 0.2), 60);
    const barH = game && vis(bar) ? bar.getBoundingClientRect().height + 6 : 0;
    const bottomLimit = Ht - Math.max(bandB, barH + 4);
    const out = {L:[], R:[], T:[], B:[]};
    for(const r of REG){ if(r.chip) continue; document.querySelectorAll(r.s).forEach(e => { if(e.closest("#hmBar") || (e.id !== "sxDock" && e.closest("#sxDock")) || !vis(e)) return; const dk = (e.id === "sxDock" && desk && vis(desk) && e.contains(desk)) ? "B" : r.d; /* 20261030h: desk up = bottom band */ if(out[dk].some(x => x.e === e || x.e.contains(e))) return; out[dk].push({e, r}); }); }
    const stack = (list, side) => {
      let y = PAD;
      { const tb = document.getElementById("uiToolbar"); if(tb && vis(tb)) y = Math.max(y, Math.round(tb.getBoundingClientRect().bottom) + GAP); }   /* below the toolbar, never over it */
      for(const {e, r} of list){
        if(r.talk) talkify(e); addX(e, r);
        const room = bottomLimit - y; if(room < 28){ collapse(e, r); continue; }
        const o = {top:y, w:colW, mh:r.cap ? Math.min(room, r.cap) : room}; if(side === "L") o.left = PAD; else o.right = PAD;
        if(r.small){ o.w = null; set(e, "max-width", colW + "px"); }
        place(e, o); y += Math.min(e.getBoundingClientRect().height, room) + GAP;
      }
    };
    stack(out.L, "L"); stack(out.R, "R");
    /* top strip: between the columns, above the centre zone */
    let x = Math.floor(W * 0.25) + PAD; const tW = Math.floor(W * 0.5) - PAD * 2, tH = Math.floor(Ht * 0.2) - PAD;
    let ty = PAD;
    for(const {e, r} of out.T){ addX(e, r); place(e, {left:x, top:ty, w:tW, mh:Math.max(24, tH - ty)}); ty += e.getBoundingClientRect().height + GAP; }
    /* bottom band: the floor desk, merged with the bar (bar shows only Cables + tabs + chips while the desk is up) */
    for(const {e, r} of out.B){
      addX(e, r);
      /* 20261030h: full-width band sitting just above the Say aloud bar and any fixed strip along the bottom (the wire); max 20vh */
      let sTop = Ht; [bar, ...document.querySelectorAll("body > *")].forEach(s => { try{ if(!s || s === e || s.contains(e) || e.contains(s) || s.hidden) return; const cs = getComputedStyle(s); if(cs.display === "none" || cs.visibility === "hidden" || cs.position !== "fixed") return;
        const q = s.getBoundingClientRect(); if(q.height > 0 && q.height < 90 && q.width > W * 0.5 && q.top > Ht * 0.7) sTop = Math.min(sTop, q.top); }catch(x){} });
      place(e, {left:PAD, right:PAD, bottom:Math.max(6, Math.round(Ht - sTop + GAP)), mh:Math.max(150, Math.round(Ht * 0.24))});
      set(e, "width", "auto"); set(e, "max-width", "none"); set(e, "overflow", "hidden");
    }
    if(bar){ bar.style.removeProperty("left"); bar.style.removeProperty("right"); }
    H.last = {W, Ht, L:out.L.length, R:out.R.length, T:out.T.length, B:out.B.length};
  }
  H.layout = layout;
  /* overlap/centre check (QA hook) */
  H.check = function(){
    const W = innerWidth, Ht = innerHeight, cz = {l:W * .25, t:Ht * .2, r:W * .75, b:Ht * .8};
    const els = [];
    REG.forEach(r => document.querySelectorAll(r.s).forEach(e => { if(vis(e) && !e.closest("#hmBar") && !els.some(x => x.e === e)) els.push({e, n:r.s}); }));
    if(bar && vis(bar)) els.push({e:bar, n:"#hmBar"});
    const R = els.map(x => { const b = x.e.getBoundingClientRect(); return {n:x.n, l:b.left, t:b.top, r:b.right, b:b.bottom}; });
    const hit = (a, b) => a.l < b.r - 0.5 && b.l < a.r - 0.5 && a.t < b.b - 0.5 && b.t < a.b - 0.5;
    const overlaps = [], centre = [];
    for(let i = 0; i < R.length; i++){ if(hit(R[i], cz)) centre.push(R[i].n); for(let j = i + 1; j < R.length; j++) if(hit(R[i], R[j])) overlaps.push(R[i].n + " x " + R[j].n); }
    return {panels:R.map(r => r.n + "@" + [r.l, r.t, r.r, r.b].map(Math.round).join(",")), overlaps, centre, ok:!overlaps.length && !centre.length};
  };
  let q = 0; const kick = () => { if(q) return; q = requestAnimationFrame(() => { q = 0; try{ layout(); }catch(e){} }); };
  addEventListener("resize", kick);
  try{ new MutationObserver(kick).observe(document.body, {childList:true}); }catch(e){}
  try{ ["prompt", "hail", "procBar", "tipCard"].forEach(id => { const e = document.getElementById(id); if(e) new MutationObserver(kick).observe(e, {attributes:true, attributeFilter:["hidden", "class"]}); }); }catch(e){}
  setInterval(() => { try{ layout(); }catch(e){} }, 400);
  kick();
})();
</script>

</body>
</html>
