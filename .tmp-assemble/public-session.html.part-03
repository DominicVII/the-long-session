      let name = null; if(i === 0){ try{ const c = (G.civ || []).find(x => x && x.scKey === "oh:sen:" + st.n && !x.gone); if(c) name = c.name; }catch(e){} }
      if(!name){ try{ name = newName(st.n); }catch(e){ name = "Senator " + st.n; } }
