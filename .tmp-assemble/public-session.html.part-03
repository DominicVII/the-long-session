  return R; }; }
/* ── the Senate: party first, home second, the senator's own place third ── */
function senLean(S, i, it){
  const r = rng(seedOf("sen:" + S.n + i + ":" + (G.term || 1)));
  let p = S.lean + (r() * 40 - 20) > 8 ? "FED" : S.lean + (r() * 40 - 20) < -8 ? "COM" : "IND"; p = (typeof senParty === "function" && senParty(S.n, i)) || p;
  const ideo = r() * 30 - 15;
  let L = {}; const nom = !!(it && /^Nomination of /.test(it.title || ""));
  if(nom){ /* a nominee is judged as a person: how far from the party's platform, with the President's party behind them */
    Object.keys(PARTY_PLATFORM).forEach(k => { let d = 0; for(const x of AXES) d += Math.abs((PARTY_PLATFORM[k][x.k] || 0) - ((it.pos || {})[x.k] || 0)); const f = 48 - d / 4; L[k] = f > 22 ? 1 : f < 8 ? -1 : 0; });
    const ep = G.exec ? (G.exec.you ? G.you.party : G.exec.party) : null; if(ep) L[ep] = 1; }
  else { try{ if(it && it.pos) L = partyLine(it); }catch(e){} }
  const l = L[p] || 0; let lean = 0; try{ lean = clamp(stLeanC(S, it) / 50, -1, 1); }catch(e){}
  const q = rng(seedOf("senv:" + S.n + i + ":" + ((it && it.title) || "") + ":" + (G.term || 1)))() * 24 - 12;
  const a = l * 28 + lean * (nom ? 8 : 20) + ideo + q + (nom ? 10 : 0) + ((it && it.senShift) || 0);   /* the Senate defers to the President on the President's own officers, short of a nominee it cannot stomach */
  const v = Math.abs(a) < 8 ? (l || (lean > 0 ? 1 : lean < 0 ? -1 : (q >= 0 ? 1 : -1))) : a > 0 ? 1 : -1;
  return {p, a, v, l};
}
/* how far a bill moves the law toward a member, measured from the law as it stands */
function lxFit(m, b){ let sq = 0; try{ sq = alignmentRaw(m, {pos:{econ:0, lib:0, def:0, wel:0}}); }catch(e){} return alignment(m, b) - sq; }
/* twenty-five seats a committee: thirteen to the majority, the rest by each party's share of the House */
function lxCmQuota(){
