/* ── the state legislatures' bills, written out ── */
const LX_SB = {
  "Levee and Drainage Bill":(P, st) => [["Drainage districts", ["(a) Formation.— A drainage district may be formed in any watershed of " + st + " on the petition of a majority of the landowners in it.", "(b) Assessment.— The cost of the works shall be assessed on the land benefited, in proportion to the benefit."], "Landowners in a watershed can band together and pay for drainage in proportion to what they gain."], ["Levees", ["(a) Height.— Levees on the rivers of " + st + " shall be raised to the highest water of the last " + P.n(30, 100, 10) + " years."], "The state's levees go up to the worst flood in living memory."]],
  "Right to Organise Bill":(P, st) => [["Right to organise", ["(a) Right.— Workers in " + st + " may form unions and bargain collectively through representatives of their own choosing.", "(b) Dismissal.— No employer shall dismiss a worker for joining a union, on pain of a fine of up to " + money(P.n(1, 5) * 100) + "."], "Workers may unionise, and can't be fired for it."], ["Labour board", ["(a) Board.— A State labour board of " + P.n(3, 5) + " members shall hear complaints under this Act and may order reinstatement."], "A state board hears complaints and can order a worker rehired."]],
  "Tolls and Turnpikes Bill":(P, st) => [["Turnpike charters", ["(a) Charter.— The Governor may charter companies to build and keep turnpikes in " + st + ".", "(b) Tolls.— Tolls shall be those set in the charter, reviewed every " + P.n(3, 7) + " years."], "Private companies can build toll roads, at tolls fixed in their charters."], ["Land for the roads", ["(a) Taking.— Land for a chartered turnpike may be taken by eminent domain, on payment of its value as assessed."], "Land for the roads can be taken, with payment."]],
  "Constabulary Powers Bill":(P, st) => [["State constabulary", ["(a) Force.— There is established a State constabulary of " + P.n(100, 600, 50) + " officers with power to arrest anywhere in " + st + ".", "(b) Search.— A constable may search premises on a warrant from any magistrate, or without one in hot pursuit."], "A statewide police force with powers of arrest and search."], ["Persons arrested", ["(a) Hearing.— A person arrested shall be brought before a magistrate within " + P.n(24, 96, 24) + " hours."], "Anyone arrested sees a magistrate within a set time."]],
  "Common Schools Bill":(P, st) => [["Common schools", ["(a) Schools.— A common school, free to every child, shall be kept in every township of " + st + ".", "(b) Tax.— A State school tax of " + P.n(1, 4) + " mills on the guilder of assessed property shall be laid to keep them."], "A free school in every township, paid for by a property tax."], ["Superintendents", ["(a) Inspection.— A superintendent in each county shall inspect the schools every term."], "Each county gets a school inspector."]],
  "Land Enclosure Bill":(P, st) => [["Enclosure", ["(a) Petition.— Common grazing land in " + st + " may be enclosed on the petition of the owners of two thirds of its value.", "(b) Compensation.— Every commoner who loses a right of grazing shall be compensated in land or money."], "Common land can be fenced off by the larger owners, with the commoners compensated."], ["Commissioners", ["(a) Division.— " + P.n(3, 5) + " enclosure commissioners shall divide the land and settle the compensation."], "Commissioners divide the land."]],
  "Militia Reorganisation Bill":(P, st) => [["Organisation", ["(a) Regiments.— The militia of " + st + " shall be organised in regiments by county, under officers commissioned by the Governor.", "(b) Enrolment.— Every able-bodied resident from eighteen to " + P.n(40, 50, 5) + " shall be enrolled; a person who objects in conscience may be excused on payment of a fee."], "Every able-bodied adult is enrolled in county regiments, with a paid exemption for conscience."], ["Muster and arms", ["(a) Muster.— The militia shall muster " + P.n(1, 4) + " times a year, and its arms be kept in county armories."], "Regular musters; arms kept in county armories."]],
  "Free Assembly Bill":(P, st) => [["Assembly", ["(a) Right.— The people of " + st + " may assemble peaceably in any public place without a licence.", "(b) Dispersal.— A gathering may be dispersed only on the written order of a magistrate after a riot has begun."], "People can gather in public without a licence, and can only be broken up after a riot starts."], ["Damages", ["(a) Damages.— A person unlawfully dispersed may recover damages of up to " + money(P.n(1, 5) * 100) + " from the officer responsible."], "Those unlawfully broken up can sue the officer."]]
};
