function lxKey(s){ return (s.day != null ? s.day : "cal") + ":" + s.title; }
/* the earlier act on the same subject still on the books: what a new bill on it really amends */
function lxPrior(src, dom){
  if(!dom) return null; const d0 = src.done || src.fate ? (src.day || G.day) : G.day + 1;
  return (G.statute || []).filter(s => s !== src && s.title !== src.title && (s.day || 0) < d0 && (s.fate === "carried") && !(s.lxStruck && s.lxStruck.whole) && lxDomainOf(s) === dom).sort((a, b) => b.day - a.day)[0] || null;
}
function lxDoc(ref){
  const src = lxSource(ref); if(!src) return null;
  const key = lxKey(src) + "|" + (src.clauses || []).length + "|" + (src.strk || []).join(",") + "|" + ((src.lxStruck && src.lxStruck.secs) || []).join(",") + "|" + (src.soft ? 1 : 0) + "|" + (G.statute || []).length;
  const c = LX.docs.get(lxKey(src)); if(c && c.key === key) return c.doc;
  const dom = lxDomainOf(src), ag = LX_AG[dom] || "the Secretary concerned", EXEC = (function(){ try{ return execTitle(); }catch(e){ return "President"; } })();
  const town = src.town || ((/^In ([A-Z][\w' -]+?),/.exec(src.why || "") || [])[1]) || null, st = src.state || null;
  const realm = src.realmT || (function(){ const m = /^Cabled from ([^:]+):/.exec(src.why || ""); return m ? m[1] : null; })() || "the friendly power";
  const X = {AG:ag, AGc:knCap(ag), ST:st, STn:st || "Republic", TOWN:town, REALM:realm, EXEC, CC:lxCountry(), CCs:lxCountry().replace(/^the\s+/i, "")};
  const prior = lxPrior(src, dom), pc = prior ? (prior.clauses || []) : [];
  const D = {key:lxKey(src), title:src.title, src, dom, prior, congress:knOrd(lxCongNo(src.day)), no:"H.R. " + (src.id || (seedOf(src.title) % 900 + 100)), secs:[], cites:[]};
  D.longTitle = "To " + (LX_PURPOSE[dom] || "provide for the matters named in it") + (town ? ", with first regard to " + town : "") + ", and for other purposes.";
  D.enact = "Be it enacted by the Senate and House of Representatives of " + X.CC + " in Congress assembled,";
  const S = D.secs, add = (head, sub, plain, extra) => { const s = Object.assign({n:S.length + 1, head, sub, plain}, extra || {}); S.push(s); return s; };
  add("Short title", ["This Act may be cited as the " + src.title + "."], "The name it goes by. It changes nothing by itself.", {k:"title"});
  const F = []; String(src.why || "").split(/(?<=[.!?])\s+/).filter(Boolean).forEach(x => F.push(x.replace(/\s+$/, "")));
  if(LX_FIND[dom]) F.push(LX_FIND[dom]);
  add("Findings", ["The Congress finds that—"].concat(F.map((f, i) => "(" + (i + 1) + ") " + f)), "Why it was filed, in the sponsor's words and the record's.", {k:"find"});
  const defs = (LX_DEF[dom] || []).concat([["administering office", ag], ["State", "a State of the Union"]]);
  add("Definitions", ["In this Act—"].concat(defs.map((d, i) => "(" + (i + 1) + ") “" + d[0] + "” means " + d[1] + ";")), "What its words mean, so a court reads them the same way twice.", {k:"def"});
  const strk = src.strk || [], judged = (src.lxStruck && src.lxStruck.secs) || [];
  (src.clauses || []).forEach((cl, ci) => {
    const P = lxParams("lx:" + src.title + ":" + ci);
    const f = LX_CL[cl] || (/^a first call on the money for /.test(cl) ? lxFirstCall(cl.replace(/^a first call on the money for /, "").replace(/ and the counties around it$/, "")) : null);
    const r = f ? f(P, X) : lxGeneric(cl, X);
    const ext = {k:"op", ci, clause:cl, claim:r[3], short:r[0], struckAmend:strk.indexOf(ci) >= 0};
    const pi = pc.indexOf(cl);
    if(prior && pi >= 0 && !/^a first call/.test(cl) && cl !== "the whole of it to take effect in one session, not three"){
      /* the same provision already stands in the earlier act: this bill amends it, figure for figure */
      const pn = 4 + pi, PP = lxParams("lx:" + prior.title + ":" + pi), old = (f ? f(PP, X) : lxGeneric(cl, X))[1], diffs = [];
      r[1].forEach((t, j) => { if(old[j] && old[j] !== t){ const a = (old[j].match(/(\d+(?:[.,]\d+)?(?:\s*(?:per cent|feet|years?|months?|days?|guns|acres|stuivers|questions|nurses|directors|times))?|ƒ\d+(?:\.\d+)?[km]?)/g) || []), b = (t.match(/(\d+(?:[.,]\d+)?(?:\s*(?:per cent|feet|years?|months?|days?|guns|acres|stuivers|questions|nurses|directors|times))?|ƒ\d+(?:\.\d+)?[km]?)/g) || []);
          const ks = a.map((v, i2) => b[i2] && b[i2] !== v ? i2 : -1).filter(i2 => i2 >= 0); if(ks.length) diffs.push("in subsection " + t.slice(0, 3) + ", " + ks.map(k => "by striking “" + a[k] + "” and inserting “" + b[k] + "”").join(", and ")); else diffs.push("by amending subsection " + t.slice(0, 3) + " to read as follows: “" + t + "”"); } });
      ext.amends = {title:prior.title, day:prior.day, sec:pn};
      add("Amendment of section " + pn + " of the " + prior.title + " (" + r[0].toLowerCase() + ")", diffs.length ? ["Section " + pn + " of the " + prior.title + " is amended—"].concat(diffs.map((d, i) => "(" + (i + 1) + ") " + d + (i < diffs.length - 1 ? ";" : "."))) : ["Section " + pn + " of the " + prior.title + " is re-enacted without change, and shall apply also to the matters in this Act."],
        diffs.length ? "The earlier act already does this. This changes its figures: " + r[2].replace(/\.$/, "") + "." : "The earlier act already does this, and this applies it again here.", ext);
    } else add(r[0], r[1], r[2], ext);
  });
  if(prior){ D.cites.push({title:prior.title, day:prior.day, why:"amended"}); }
  /* a court that struck down an earlier act on this subject is answered in the text */
  const lost = (G.cases || []).filter(c => c && c.done && c.lx && c.lx.dom === dom && c.lx.held === "struck" && (c.dday || c.day) <= (src.day || G.day)).slice(-1)[0];
  if(lost){ D.cites.push({case:c2t(lost), why:"answered"}); add("Response to " + c2t(lost), ["(a) Finding.— In " + c2t(lost) + " the high bench held that section " + lost.lx.sec + " of the " + lost.lx.act + " " + LX_TH[lost.lx.th].phrase + ".", "(b) Remedy.— This Act is to be read so as to meet that holding, and nothing in it revives the section the bench struck."], "The last law on this was partly struck down in court; this one says it has been written to survive that ruling.", {k:"resp"}); }
  const cost = src.cost || 0, soft = src.soft ? Math.round(cost * 0.67) : cost;
  add("Authorization of appropriations", cost ? ["(a) In general.— There is authorized to be appropriated " + money(soft) + " to carry out this Act" + (src.soft ? " (reduced by amendment on the floor from " + money(cost) + ")" : "") + ".", "(b) Source.— The sums shall be met from " + (/treasury|tariff|levy/.test(src.pays || "") ? src.pays : /districts that lose the subsidy/.test(src.pays || "") ? "the subsidies now paid to the districts named by the Secretary, which shall cease" : "the general fund") + "."] : ["No money is appropriated by this Act."],
    cost ? "It costs " + money(soft) + ", paid by " + (src.pays || "the general fund") + "." : "It spends nothing.", {k:"approp"});
  add("Administration and enforcement", ["(a) Regulations.— " + X.AGc + " shall make regulations to carry out this Act within " + lxParams("lx:" + src.title + ":adm").n(90, 270, 30) + " days.", "(b) Officers.— " + X.AGc + " may appoint the officers needed to carry it out.", "(c) Penalty.— Whoever knowingly breaks a regulation made under this Act shall be fined, and each day of the breach is a separate offence."], "Who runs it, and what happens to those who break it.", {k:"adm"});
  add("Judicial review", ["(a) Standing.— Any State, and any person aggrieved by an action taken under this Act, may bring an action in the circuit court to set it aside.", "(b) Time.— An action shall be brought within " + lxParams("lx:" + src.title + ":jr").n(60, 180, 30) + " days of the action complained of.", "(c) Constitutionality.— An action that challenges this Act under the Charter shall be heard first by the high bench, which shall advance it on its docket."], "Who can sue over it, how soon, and that a challenge to the Act itself goes straight to the high bench.", {k:"jr"});
  add("Severability", ["If any section of this Act is held invalid, the remainder of the Act, and the application of the section to other persons and circumstances, shall not be affected."], "If a court strikes one section, the rest still stands.", {k:"sev"});
  const landmark = (src.clauses || []).indexOf("the whole of it to take effect in one session, not three") >= 0;
  add("Effective date", [landmark ? "This Act takes effect on enactment, subject to section " + (S.findIndex(s => s.clause === "the whole of it to take effect in one session, not three") + 1) + "." : "This Act takes effect " + ["on enactment.", "ninety days after enactment.", "on the first day of the next fiscal year."][seedOf(src.title) % 3]], "When it starts to apply to anyone.", {k:"eff"});
  judged.forEach(n => { const s = S.find(x => x.n === n); if(s) s.struckCourt = src.lxStruck; });
  LX.docs.set(lxKey(src), {key, doc:D}); return D;
}
function c2t(c){ return c.t; }
/* the theories a section can be challenged on, how a justice weighs them (axis and sign of the lean that favours striking), and the words of the holding */
const LX_TH = {
  takings:{t:"takings", phrase:"takes private property for public use without just compensation", ax:"econ", sg:1, up:"The compensation section answers the claim: the owner is paid what the land is worth, and that is all the Charter asks."},
  dueprocess:{t:"due process", phrase:"deprives persons of liberty without due process of law", ax:"lib", sg:1, up:"A hearing is provided, and the Charter asks for a fair procedure, not for none at all."},
  press:{t:"freedom of the press", phrase:"abridges the freedom of the press", ax:"lib", sg:1, up:"The section reaches only what is knowingly false or plainly commercial, and the press was never free to do that."},
  states:{t:"the reserved powers of the States", phrase:"commandeers the governments of the States in matters the Charter leaves to them", ax:"econ", sg:1, up:"The Union acts on its own officers and its own money; it does not order a State's legislature to do anything."},
  spending:{t:"conditions on federal money", phrase:"attaches a condition to federal money so coercive that the States have no real choice", ax:"econ", sg:1, up:"A State that does not want the condition may decline the money; an offer is not a command."},
  separation:{t:"the separation of powers", phrase:"trespasses on the independence of the judicial power", ax:"lib", sg:1, up:"Congress may make the courts and set their size; that is what the Charter gives it to do."},
  contract:{t:"liberty of contract", phrase:"interferes with the liberty of contract beyond any public need", ax:"econ", sg:1, up:"The rule serves the safety and fair dealing of the public, and contracts are made subject to such rules."},
  uniformity:{t:"uniformity of duties", phrase:"lays duties that are not uniform throughout the Union", ax:"econ", sg:1, up:"The duty is the same at every port; a rebate for what a port carries is not a different duty."},
  delegation:{t:"delegation of the legislative power", phrase:"hands the legislative power to an officer of the Executive without a rule to guide it", ax:"econ", sg:1, up:"The Act sets the limits within which the officer may move; filling in figures within them is not making law."},
  servitude:{t:"compelled labour", phrase:"compels personal labour without consent", ax:"lib", sg:1, up:"The Republic may call on its people for public work in a time of need, at a fair wage and for a fixed term."},
  equal:{t:"equal treatment of the States", phrase:"singles out some States for burdens or favours the others do not share", ax:"lib", sg:1, up:"Congress may spend where the need is, and need is not the same everywhere."},
  preempt:{t:"the limits of federal power", phrase:"voids state law beyond the powers the Charter gives the Union", ax:"econ", sg:1, up:"Where Congress may make the rule, its rule is the law of the land and a State's contrary law must give way."}
};
/* ── where an act stands: the House, the President, the override, the bench ── */
function lxAct(s){ return (G.lastActs || []).find(a => a.title === s.title && Math.abs((a.day || 0) - (s.day || 0)) <= 1) || null; }
function lxStore(){ if(!G.lx || G.lx.v !== 1) G.lx = {v:1, init:false, n:0}; return G.lx; }
function lxStatus(s){
  const out = [], cnt = s.aye != null && s.no != null ? s.aye + " to " + s.no : "without a recorded count";
  if(s.fate === "rejected"){ out.push("Failed in the House, " + cnt + ", on day " + s.day + "."); return {t:out.join(" "), k:"failed", force:false}; }
  out.push("Passed the House, " + cnt + ", on day " + s.day + ".");
  if(s.fate === "struck down"){ out.push("Struck down by the court before it took effect."); return {t:out.join(" "), k:"struck", force:false}; }
  if(s.veto){ out.push(s.veto.override ? "Vetoed by " + s.veto.by + "; the House overrode the veto." : "Vetoed by " + s.veto.by + "."); }
  if(s.exec){ out.push(s.exec.act === "signed" ? "Signed by " + s.exec.by + (s.exec.d ? " on day " + s.exec.d : "") + "."
      : s.exec.act === "lapsed" ? "Became law without the signature of " + s.exec.by + " on day " + s.exec.d + ", ten days after Congress presented it."
      : s.exec.act === "pocket" ? "Pocket-vetoed: " + s.exec.by + " held it unsigned when the Congress ended on day " + s.exec.d + ", and it died."
      : "Vetoed by " + s.exec.by + (s.exec.d ? " on day " + s.exec.d : "") + "."); }
  if(s.ovr && s.ovr.none) out.push(s.ovr.pocket ? "A pocket veto cannot be overridden." : "No override was attempted.");
  else if(s.ovr && s.ovr.done) out.push(s.ovr.ok ? "The House overrode the veto, " + s.ovr.aye + " to " + s.ovr.no + " (two thirds was " + s.ovr.need + ")." : "The House failed to override, " + s.ovr.aye + " to " + s.ovr.no + "; two thirds was " + s.ovr.need + ". The veto stands.");
  else if(s.ovr) out.push("The veto goes back to the House; it votes on an override on day " + s.ovr.due + ", and needs two thirds.");
  const a = lxAct(s), pending = s.fate === "carried" && !s.exec && !s.veto && a && !a.signed && !a.vetoed && G.exec && G.exec.you;
  if(pending) out.push("Awaiting the President's signature: " + Math.max(0, 10 - (G.day - (a.day || G.day))) + " days left before it becomes law without one.");
  let k = s.fate === "vetoed" ? "vetoed" : pending ? "pending" : "law";
  if(s.lxStruck){ const ss = s.lxStruck; out.push(ss.whole ? "Held invalid as a whole in " + ss.cases.join(", ") + "." : "Section" + (ss.secs.length > 1 ? "s " : " ") + ss.secs.join(", ") + " held invalid in " + ss.cases.join(", ") + "; the rest stands."); if(ss.whole) k = "struck"; }
  const later = (G.statute || []).filter(x => x !== s && x.fate === "carried" && (x.day || 0) > (s.day || 0)).filter(x => { const d = lxDoc(x); return d && d.prior === s; });
  if(later.length) out.push("Amended by the " + later.map(x => x.title).join(", the ") + ".");
  return {t:out.join(" "), k, force:k === "law", later};
}
/* the clerk's book, the President's pen, the House's answer to a veto */
function lxSync(){
  if(!G || !G.you || !G.statute) return; const L = lxStore(), first = !L.init;
  (G.lastActs || []).forEach(a => { const s = (G.statute || []).find(x => x.title === a.title && Math.abs((x.day || 0) - (a.day || 0)) <= 1); if(!s) return;
    const by = G.exec && G.exec.you ? (execTitleSafe() + " " + G.you.name) : (G.exec && G.exec.name) || "the President";
    if(a.signed && !s.exec) s.exec = {act:"signed", by, d:first ? null : G.day};
    if(a.vetoed && (!s.exec || (s.exec.act !== "vetoed" && s.exec.act !== "pocket"))){ s.exec = {act:"vetoed", by, d:first && !a.vetoD ? null : G.day}; if(s.fate === "carried") s.fate = "vetoed";
      if(!s.ovr && first && G.day - (s.day || 0) > 10){ s.ovr = {done:true, ok:false, none:true}; }
      if(!s.ovr){ s.ovr = {due:G.day + 1, done:false}; try{ feed("The veto of the " + s.title + " goes back to the House with the President's message. It votes on an override on day " + s.ovr.due + "; it needs two thirds.", "news"); }catch(e){} } } });
  L.init = true;
  (G.statute || []).forEach(s => { if(s.ovr && !s.ovr.done && G.day >= s.ovr.due) lxOverride(s); });
}
function execTitleSafe(){ try{ return execTitle(); }catch(e){ return "President"; } }
function lxOverride(s){
  const a = lxAct(s) || {}, pos = a.pos || s.pos; if(!pos){ s.ovr.done = true; s.ovr.ok = false; s.ovr.aye = s.aye; s.ovr.no = s.no; s.ovr.need = Math.ceil((s.aye + s.no) * 2 / 3); return; }
  const pseudo = {id:"ovr:" + s.title, title:s.title, pos:Object.assign({}, pos), sponsor:s.sponsor, sponsorParty:s.sponsorParty || null, domain:lxDomainOf(s), done:false, clauses:s.clauses || []};
  const yv = G.you.vote, pl = (G.members || []).map(m => [m, m.pledge, m.pledgeDay]); let t = null;
  try{ G.you.vote = -1; (G.members || []).forEach(m => { m.pledge = null; }); t = tallyBill(pseudo, false); }catch(e){ t = null; }
  finally{ G.you.vote = yv; pl.forEach(([m, p, d]) => { m.pledge = p; m.pledgeDay = d; }); }
  if(!t){ s.ovr.done = true; return; }
  const need = Math.ceil((t.aye + t.no) * 2 / 3), ok = t.aye >= need;
  Object.assign(s.ovr, {done:true, d:G.day, aye:t.aye, no:t.no, need, ok, v:t.roll || null});
  if(ok){ s.fate = "carried"; s.overridden = true; G.you.standing = clamp((G.you.standing || 0) - 6, 0, 100); G.you.influence = clamp((G.you.influence || 0) - 4, 0, 100); }
  else { G.you.influence = clamp((G.you.influence || 0) + 2, 0, 100); }
  try{ const line = ok ? "The House overrides the veto of the " + s.title + ", " + t.aye + " to " + t.no + " (two thirds was " + need + "). It is law without the President's signature." : "The House fails to override the veto of the " + s.title + ": " + t.aye + " to " + t.no + ", short of the " + need + " it needed. The veto stands.";
    note(line, true); journal(line); pushWireScrap("Floor", s.title + " — override " + (ok ? "CARRIED" : "FAILS") + " " + t.aye + "–" + t.no); }catch(e){}
}
/* ── the courts: suits against the sections open to challenge, decided justice by justice ── */
function lxPlaintiff(s, cl, D){
  const kind = cl.claim[1];
  if(kind === "group") return {name:cl.claim[3], state:null, pk:"group"};
  if(kind === "member"){ const m = (G.members || []).filter(x => x && !x.gone).sort((u, v) => (alignment(u, {pos:s.pos || {econ:0, lib:0, def:0, wel:0}}) || 0) - (alignment(v, {pos:s.pos || {econ:0, lib:0, def:0, wel:0}}) || 0))[0]; return m ? {name:m.name, state:m.state, pk:"member", id:m.id} : null; }
  if(kind === "person"){ const st = s.state || pick(knStates()); let nm = "A citizen"; try{ nm = newName(st); }catch(e){} return {name:nm, state:st, pk:"person", who:cl.claim[3]}; }
  /* a State: the one the act is aimed at, or the one that likes it least; never the State it favours, on a claim of favour */
  const pos = s.pos || (lxAct(s) || {}).pos || {econ:0, lib:0, def:0, wel:0}; let cand = (G.states || []).slice();
  if(cl.claim[0] === "equal" && s.state) cand = cand.filter(x => x.n !== s.state);
  const tgt = s.target && cl.claim[0] !== "equal" ? cand.find(x => x.n === s.target) : null;
  const low = cand.sort((u, v) => dkStateLean(u, {pos}) - dkStateLean(v, {pos})).slice(0, 4), S2 = tgt || low[Math.floor(Math.random() * low.length)]; return S2 ? {name:S2.n, state:S2.n, pk:"state"} : null;
}
function lxSue(s){
  const D = lxDoc(s); if(!D) return 0; let n = 0;
  const ops = D.secs.filter(x => x.k === "op" && x.claim && !x.struckAmend).sort((u, v) => v.claim[2] - u.claim[2]);
  for(const x of ops){ if(n >= 2) break; if(Math.random() > x.claim[2] * 0.8) continue;
    const P = lxPlaintiff(s, x, D); if(!P) continue; const t = P.name + " v. the Union (" + s.title + ")"; if((G.cases || []).some(c => c.t === t)) continue;
    G.cases = G.cases || []; G.cases.push({t, state:P.state || "", day:G.day, voted:[], lx:{act:s.title, aday:s.day, sec:x.n, head:x.short || x.head, th:x.claim[0], str:x.claim[2], plaintiff:P.name, pk:P.pk, who:P.who || null, dom:D.dom}});
    n++; try{ feed((P.pk === "state" ? "The attorney general of " + P.name + " has" : P.name + (P.who ? ", " + P.who + "," : "") + " has") + " sued to strike section " + x.n + " of the " + s.title + " (" + x.head.toLowerCase() + "), saying it " + LX_TH[x.claim[0]].phrase + ".", "news"); }catch(e){} }
  return n;
