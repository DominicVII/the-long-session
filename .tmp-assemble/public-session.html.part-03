  (G.states || []).forEach(st => { if(st && st.bill && !st.bill.title && st.bill.t) st.bill.title = st.bill.t; });   /* a state bill has a name: the docket and the news read it */
  (G.journal || []).forEach(j => { if(j && typeof j.t === "string" && /over the undefined\.$/.test(j.t)) j.t = j.t.replace(/ over the undefined\.$/, " over its bill."); }); }catch(e){} return r; }; }
