    (G.members || []).forEach(m => { m.sway = 0; if(rep.road && rep.road.report) m.sway += (rep.road.report.fav ? 1.5 : -1.5) * (m.party === rep.sponsorParty ? 0.5 : 1); });
    try{ note("The " + rep.title + ", reported by the Committee on " + rep.road.t + " " + rep.road.report.aye + " to " + rep.road.report.no + ", is placed on the calendar for day " + rep.voteDay + ".", true); }catch(e){}
