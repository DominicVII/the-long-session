/* ── an unfavourable report is the end of a bill, unless a majority of the House signs to discharge it ── */
function lxCommitteeKill(b){
  const R = b.road, L = lxStore(); L.died = L.died || []; const need = Math.floor((G.seats || 183) / 2) + 1;
  if(b.mine && lxInHouse()){
    let sig = 0; try{ const t = tallyBill(b, false); sig = t.aye + (G.you.vote ? 0 : 1); }catch(e){}
    b.discharge = {d:G.day, sig, need, ok:sig >= need};
