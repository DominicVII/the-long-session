      if(G.you && i === 0 && st.n === G.you.state && (function(){ try{ return heldOffice() === "senate"; }catch(e){ return false; } })()) continue;
      const lean = (st.lean || 0) + (swing || 0) * 0.5, fav = lean > 6 ? "FED" : lean < -6 ? "COM" : null, r = knH(k, "senelect:" + G.term);
      const hold = s.party === fav ? 0.85 : fav ? 0.55 - Math.min(0.3, Math.abs(lean) / 150) : 0.7, retire = r > 0.88;
