/* ── The building is joined up: doors you walk through ─────
   side is which wall, at is 0..1 along it. ── */
const DOORS = {
  office:   [{to:"corridor", side:"front", at:0.5}],
  visit:    [{to:"corridor", side:"front", at:0.5}],
  corridor: [{to:"office",    side:"left",  at:0.10},
             {to:"cloak",     side:"left",  at:0.40},
             {to:"caucus",    side:"left",  at:0.72},
             {to:"committee", side:"right", at:0.26},
             {to:"press",     side:"right", at:0.58},
             {to:"senate",    side:"right", at:0.85},
             {to:"exec",      side:"left",  at:0.92},
             {to:"engine",    side:"left",  at:0.50},
             {to:"floor",     side:"back",  at:0.5},
             {to:"steps",     side:"front", at:0.5}],
  cloak:    [{to:"corridor", side:"front", at:0.5}, {to:"floor", side:"back", at:0.5}],
  engine:   [{to:"corridor", side:"front", at:0.5}],
  caucus:   [{to:"corridor", side:"front", at:0.5}],
  committee:[{to:"corridor", side:"front", at:0.5}],
  press:    [{to:"corridor", side:"front", at:0.5}],
  floor:    [{to:"corridor", side:"front", at:0.5}, {to:"cloak", side:"left", at:0.18}],
  steps:    [{to:"corridor", side:"back",  at:0.5}, {to:"district", side:"front", at:0.5}],
  district: [{to:"steps",    side:"back",  at:0.5}, {to:"govoffice", side:"front", at:0.82}],
  senate:   [{to:"corridor", side:"front", at:0.5}, {to:"court", side:"left", at:0.5}],
  court:    [{to:"senate",   side:"front", at:0.5}],
  exec:     [{to:"corridor", side:"front", at:0.5}],
  govoffice:[{to:"district", side:"front", at:0.5}]
};
function doorAt(roomId, dr){
  const R = ROOMS[roomId], hw = R.w/2;
  if(roomId === "steps"){
    if(dr.side === "front") return {x:0, z:1.05, ry:0};
    if(dr.side === "back")  return {x:0, z:R.d - 1.05, ry:Math.PI};
  }
  if(dr.side === "front") return {x:(dr.at-0.5)*R.w*0.8, z:0.35, ry:0};
  if(dr.side === "back")  return {x:(dr.at-0.5)*R.w*0.8, z:R.d-0.35, ry:Math.PI};
  if(dr.side === "left")  return {x:-hw+0.35, z:dr.at*R.d, ry:Math.PI/2};
  return {x:hw-0.35, z:dr.at*R.d, ry:-Math.PI/2};
}

/* ══════════════════════════════════════════════════════════
   3 · STATE
   ══════════════════════════════════════════════════════════ */
/* Bumped once a frame (and again after the world ticks): the per-frame
   caches key off it, so nothing survives past the frame that built it. */
let FRAME_ID = 0;
const G = {
  day:1, minute:8*60, congress:1, term:1, sittingDay:1, termLength:52,
  seats:181, seatsBy:{FED:88,COM:87,IND:6}, mood:0, recessLeft:0,
  members:[], press:[], civ:[], you:null, secrets:[], donors:[], casework:[],
  bill:null, billIndex:0, secretId:0, journal:[], career:[],
  room:"office", running:false, over:false, t:0,
  speed:1, prevSpeed:1, savedAt:null,
  mail:[], mailId:0, pendingReplies:[], visitId:null, lastMailCheck:-1,
  states:[], prog:{active:null, doneList:[]}, mapSel:null, lobbies:[], lastTick:-1, doorGrace:0,
  money:{index:100, hist:[100]}, history:[], events:[], own:null, parties:null, make:null, country:null,
  relics:[], relicSpots:{}, consularLore:{tales:[], found:{}, smashed:{}, idols:0},
  feed:[], moving:false, lastAuto:-1,
  gfx:"best", simple:false, plainSit:false, fullDetail:true
};
/* A body, not a cursor: velocity carries, turns ease in and out, and the
   head keeps moving a little even when the feet have stopped. */
const cam = {x:0, z:2.0, yaw:0, pitch:0, bob:0, speed:0, vx:0, vz:0, yawVel:0, pitchVel:0, lean:0, drift:0};
/* URL ?safe=1 — force Simple gfx for stable local launch */
(function(){
  try{
    const q = new URLSearchParams(location.search||"");
    if(q.get("safe")==="1" || q.get("gfx")==="simple"){
      G.gfx = "simple"; G.simple = true; G.fullDetail = false;
      try{ sessionStorage.setItem("onum.safe","1"); }catch(e){}
    } else if(sessionStorage.getItem("onum.safe")==="1"){
      G.gfx = "simple"; G.simple = true; G.fullDetail = false;
    }
  }catch(e){}
})();
/* 20261025a · ask the graphics card, not the memory number. Chrome and Edge never report more than 8 GB, so the old
   memory rule called every Chromium machine modest (58% resolution, no anti-aliasing, no shadows, 30 frames a second),
   whatever card was in it. The card the game will draw on is named once at boot; a discrete card means full power. */
function gpuProbe(){
  const out = {name:"", strong:false, soft:false, maxTex:0};
  try{ const c = document.createElement("canvas"), o = {powerPreference:"high-performance", failIfMajorPerformanceCaveat:false};
    const gl = c.getContext("webgl2", o) || c.getContext("webgl", o); if(!gl){ out.soft = true; return out; }
    const ext = gl.getExtension("WEBGL_debug_renderer_info");
    out.name = String((ext ? gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER)) || "");
    out.maxTex = gl.getParameter(gl.MAX_TEXTURE_SIZE) || 0;
    try{ const lc = gl.getExtension("WEBGL_lose_context"); if(lc) lc.loseContext(); }catch(e){}
  }catch(e){ return out; }
  const n = out.name;
  out.soft = /swiftshader|llvmpipe|softpipe|software|basic render/i.test(n);
  out.strong = !out.soft && (/nvidia|geforce|rtx|gtx|quadro|tesla/i.test(n) || /radeon[^,)]*\b(rx|pro|vii|r9)\b/i.test(n) || /intel[^,)]*\barc\b/i.test(n) || /apple m\d+ (pro|max|ultra)|apple m[2-9]\b/i.test(n));
  return out;
}
function modestMachine(){
  try{
    try{ window.ONUM_GPU = gpuProbe(); }catch(e){}
    let ov = null; try{ ov = localStorage.getItem("onum.power"); }catch(e){}
    const q = String(location.search || ""); if(/[?&]power=full\b/.test(q)) ov = "full"; if(/[?&]power=modest\b/.test(q)) ov = "modest";
    const host0 = String(location.hostname || "");
    if(ov === "modest") return true;
    if(ov === "full") return false;
    if(/grok\.me$|grok-sandbox/i.test(host0)) return true;
    const gpu = window.ONUM_GPU || gpuProbe();
    if(gpu.soft) return true;
    if(gpu.strong && (navigator.hardwareConcurrency || 8) >= 6) return false;
    const cores = navigator.hardwareConcurrency || 4;
    const mem = navigator.deviceMemory || 8;
    const win = /Windows/i.test(navigator.userAgent || "");
    const host = String(location.hostname || "");
    if(/grok\.me$|grok-sandbox/i.test(host)) return true;
    try{ if(window.self !== window.top) return true; }catch(e){ return true; }
    if(mem && mem <= 8) return true;
    if(cores <= 6) return true;
    if(win && cores <= 8 && (!mem || mem <= 16)) return true;
  }catch(e){}
  return false;
}
const MODEST = modestMachine();
/* full power: a discrete card (or the player chose Full) gets the sharpest shadows, sixteen-tap texture filtering and a finer reflection map */
const FULLPOWER = !MODEST && (!!(window.ONUM_GPU && window.ONUM_GPU.strong) || (function(){ try{ return localStorage.getItem("onum.power") === "full" || /[?&]power=full\b/.test(location.search); }catch(e){ return false; } })());
/* Rich level for machines the game rates modest: 2 = full people, scenery and a sharper picture; 1 = the same at the old sharpness; 0 = light. It starts at 2 and steps itself down if the frame rate says so. */
const SC = {lvl:2, n:0, sum:0, since:0, done:false, cnt:0, last:0};
try{ const v = localStorage.getItem("onum.rich.lvl"); if(v === "0" || v === "1" || v === "2") SC.lvl = +v; else if(localStorage.getItem("onum.rich") === "0") SC.lvl = 0; }catch(e){}
function sceneryRich(){ return !MODEST || SC.lvl >= 1; }
function sceneryGuard(now){
  try{
    if(!MODEST || SC.lvl < 1 || SC.done || /[?&]rich=force/.test(location.search) || (typeof PC !== "undefined" && PC.open)){ SC.last = now; SC.n = 0; SC.sum = 0; return; }
    if(!SC.since) SC.since = now; if(now - SC.since < 2500){ SC.last = now; return; }
    const dt = SC.last ? now - SC.last : 16; SC.last = now; if(dt > 400) return;
    SC.n++; SC.sum += Math.min(dt, 120);
    if(SC.n >= 110){ const avg = SC.sum / SC.n; SC.n = 0; SC.sum = 0;
      if(avg > 62){ SC.lvl--; SC.since = 0; SC.cnt = 0; try{ localStorage.setItem("onum.rich.lvl", String(SC.lvl)); }catch(e){}
        try{ feed(SC.lvl ? "This machine was running at " + Math.round(1000 / avg) + " frames a second, so the picture is eased to keep it smooth. Settings, then Scenery, will change it." : "The rich picture was too heavy here (" + Math.round(1000 / avg) + " frames a second), so it is switched to light. Settings, then Scenery, will turn it back on."); }catch(e){}
        try{ note(SC.lvl ? "Picture eased to keep the game smooth." : "Rich picture switched off: this machine could not keep up.", true); }catch(e){} }
      else if(++SC.cnt >= 3) SC.done = true; }
  }catch(e){}
}
/* MODEST only throttles the frame loop (30 Hz draw stride). Visuals stay Best /
   fullDetail unless ?safe=1 or Settings → Simple. */
/* Voices stay on. Modest used to mute the House so Edge would not lock —
   that left a silent sitting. They can still pick Read only in Settings. */
if(G.muteSet){ /* keep their choice */ }
else G.mute = false;
/* 20261013n: the voice choice stays put across reloads and saves (per computer) */
const VOICE_KEY = "onum.voice";
try{ const vs = localStorage.getItem(VOICE_KEY); if(vs === "1" || vs === "0"){ G.mute = vs === "0"; G.muteSet = true; } }catch(e){}
function voiceStore(mute){ try{ localStorage.setItem(VOICE_KEY, mute ? "0" : "1"); }catch(e){} }

const smooth = (a, b, rate, dt) => a + (b - a) * (1 - Math.pow(rate, dt));

let uid = 1;
const usedNames = new Set();
const CULT_NAME_RATE = 0.84; /* 78–88% regional; rest cosmopolitan / neighbour bleed */
function cultureKey(stateOrCult){
  if(!stateOrCult) return null;
  if(NAME_CULTURES[stateOrCult]) return stateOrCult;
  const def = STATE_DEF.find(s => s.n === stateOrCult);
  return (def && def.cult) || null;
}
function cultureOf(stateOrCult){
  const k = cultureKey(stateOrCult);
  return k ? NAME_CULTURES[k] : null;
}
function cultureHint(state){
  const c = cultureOf(state);
  return c ? (c.t + " · " + state) : (state || "");
}
function pickCultSurname(cult){
  if(!cult) return pick(LAST);
  let last = pick(cult.last);
  /* some pools already embed particles; only compose when the draw is bare */
  if(cult.particles && last.indexOf(" ") < 0 && Math.random() < 0.22)
    last = pick(cult.particles) + " " + last;
  return last;
}
function houseFor(state){
  const dutchHouses = ["van Rensselaer","ten Boom","de Groot"];
  const k = cultureKey(state);
  if(k === "dutch" && Math.random() < 0.55) return pick(dutchHouses);
  if(k === "delta" && Math.random() < 0.35) return pick(["Okonkwo","Adeyemi","Delacroix"]);
  if(k === "highplains" && Math.random() < 0.30) return pick(["Villanueva","Sisto"]);
  return pick(HOUSES);
}
function newName(stateOrCult){
  const k = cultureKey(stateOrCult);
  const cult = k ? NAME_CULTURES[k] : null;
  const neigh = (k && CULT_NEIGHBORS[k]) || null;
  for(let i=0;i<300;i++){
    let first, last;
    const roll = Math.random();
    if(cult && roll < CULT_NAME_RATE){
      first = pick(cult.first); last = pickCultSurname(cult);
    } else if(cult && neigh && roll < CULT_NAME_RATE + 0.08){
      const nc = NAME_CULTURES[pick(neigh)];
      first = pick(nc.first); last = pickCultSurname(nc);
    } else {
      first = pick(FIRST); last = pick(LAST);
    }
    const n = first + " " + last;
    if(wallIsProtectedName(n) || wallBreaks(n)) continue;
    if(!usedNames.has(n)){ usedNames.add(n); return n; }
  }
  return pick(FIRST)+" "+pick(LAST)+" "+uid;
}
const SKINS  = [0xf0d3ba,0xe8c4a0,0xd9ab84,0xc08e64,0x9c6b45,0x7a4f31,0x5c3a22,0x3f2818];
const SUITS  = [0x1a2744,0x12141a,0x7a2a2e,0x3a2418,0x4a6578,0x6a5a3e,0x1d2530,0x2f4a38,0x5c4030,0x24313d,0x0e1014,0x8a6a32];
const SHIRTS = [0xf2f0ea,0xe8ecf0,0xdfe6ee,0xf0e6dc,0xe4e8e2,0xffffff,0xd8e2ea];
const HAIRS  = [0x14100d,0x2f2318,0x4a3728,0x6b5540,0x8b7355,0xa89880,0xd8d3c8,0x3a3a3a,0x5c3218];
/* ── what people wear ─────────────────────────────────────
   Each outfit is a set of garments the model actually builds. */
const WARDROBE = {
  suit_tie:    {t:"Suit and tie",            jacket:1, vest:0, neck:"tie",      bottom:"trousers", shoe:"oxford"},
  three_piece: {t:"Three-piece suit",        jacket:1, vest:1, neck:"tie",      bottom:"trousers", shoe:"oxford"},
  suit_open:   {t:"Suit, open collar",       jacket:1, vest:0, neck:"open",     bottom:"trousers", shoe:"oxford"},
  shirt_vest:  {t:"Shirtsleeves and waistcoat", jacket:0, vest:1, neck:"tie",   bottom:"trousers", shoe:"oxford"},
  skirt_suit:  {t:"Skirt suit and bow",      jacket:1, vest:0, neck:"bow",      bottom:"skirt",    shoe:"heel"},
  trouser_suit:{t:"Trouser suit and bow",    jacket:1, vest:0, neck:"bow",      bottom:"trousers", shoe:"heel"},
  dress_jacket:{t:"Dress and jacket",        jacket:1, vest:0, neck:"necklace", bottom:"dress",    shoe:"heel"},
  blouse_skirt:{t:"Blouse, skirt and scarf", jacket:0, vest:0, neck:"scarf",    bottom:"skirt",    shoe:"flat"}
};
const WEAR_MASC = ["suit_tie","three_piece","suit_open","shirt_vest","three_piece","suit_open"];
const WEAR_FEM  = ["skirt_suit","trouser_suit","dress_jacket","blouse_skirt","skirt_suit","trouser_suit"];
const HAIRSTYLES = ["Short back and sides","Side parting","Pinned up","Thinning","Long","Cropped curls","Caesar cut"];

/* No two people in the building look alike. Kin may share colouring;
   nobody shares a build and an outfit. */
const USED_LOOKS = new Set();
function lookSig(L){
  return [L.frame, L.wear, L.suit, L.shirt, L.hair, L.style,
          Math.round(L.height*40), Math.round(L.build*30),
          L.glasses?1:0, L.beard?1:0,
          Math.round((L.faceW||1)*40), Math.round((L.jawW||1)*40)].join("|");
}
function makeLook(opts){
  for(let attempt=0; attempt<40; attempt++){
    const L = rollLook(opts);
    const sig = lookSig(L);
    if(!USED_LOOKS.has(sig)){ USED_LOOKS.add(sig); return L; }
  }
  /* forty rolls in and still colliding: nudge until it is its own person */
  const L = rollLook(opts);
  L.height += (Math.random()-0.5)*0.06;
  L.build  += (Math.random()-0.5)*0.08;
  USED_LOOKS.add(lookSig(L));
  return L;
}
function rollLook(opts){
  opts = opts || {};
  const frame = opts.frame || (chance(.5) ? "masc" : "fem");
  const fem = frame === "fem";
  return {
    skin:pick(SKINS), suit:pick(SUITS), shirt:pick(SHIRTS), hair:pick(HAIRS),
    height: fem ? 1.55 + Math.random()*0.22 : 1.66 + Math.random()*0.26,
    build:0.88 + Math.random()*0.30,
    frame,
    style:(Math.random()*7)|0,
    glasses:chance(.27), eye:pick([0x5a3d24,0x3d2a18,0x6b4a2a,0x4a6070,0x556b4a,0x2f2018,0x7a6a4a,0x3a4a5c]),
    beard: !fem && chance(.30),
    wear: pick(fem ? WEAR_FEM : WEAR_MASC),
    /* Face morphs — keep the painted face matched to the body it sits on */
    faceW: fem ? 0.90 + Math.random()*0.10 : 0.96 + Math.random()*0.10,
    jawW:  fem ? 0.82 + Math.random()*0.12 : 0.94 + Math.random()*0.14,
    browH: fem ? 0.88 + Math.random()*0.10 : 1.00 + Math.random()*0.14,
    noseL: fem ? 0.88 + Math.random()*0.14 : 0.96 + Math.random()*0.16,
    lipF:  fem ? 1.05 + Math.random()*0.18 : 0.88 + Math.random()*0.14,
    cheek: fem ? 1.02 + Math.random()*0.12 : 0.92 + Math.random()*0.12,
    age: Math.random()  /* 0 young → 1 lined */
  };
}

/* Philosophy: Individuals = AI = Human = AI+Human = Individuals.
   Paramount autonomy — every person has their own thought, hope, vision.
   Nobody speaks as a hive. Same six questions, same sortHat, same office. */
function makeMember(party, opts){
  opts = opts || {};
  const bg = pick(BACKGROUNDS);
  const lean = party==="FED" ? 1 : party==="COM" ? -1 : (chance(.5)?1:-1)*0.4;
  const state = opts.state || pick(STATES);
  let name = opts.name || newName(state);
  if(!opts.name){
    while(wallIsProtectedName(name)) name = newName(state);
  }
  const m = {
    id:uid++, kind:"member", name, party, state, dist:opts.dist || rint(1,14), bg:bg.t, house:opts.house || houseFor(state),
    creed:opts.creed || pickCreed(state, {fresh:!!opts.fresh}), origin:opts.origin || pick(ORIGINS).k,
    traits:{
      ambition:clamp(rint(15,90)+(bg.tr.ambition||0),0,100),
      conviction:clamp(rint(15,90)+(bg.tr.conviction||0),0,100),
      loyalty:clamp(rint(15,90)+(bg.tr.loyalty||0),0,100),
      vanity:clamp(rint(10,85)+(bg.tr.vanity||0),0,100),
      discretion:clamp(rint(15,90)+(bg.tr.discretion||0),0,100),
      temper:clamp(rint(10,85)+(bg.tr.temper||0),0,100)
    },
    /* filled in below from the same questionnaire the player sits */
    pos:{econ:0, lib:0, def:0, wel:0}, answers:[], loyalTrait:0,
    look:makeLook(),
    margin:rint(1,32), influence:rint(8,40), post:null, terms:opts.fresh?1:rint(1,9),
    rel:{warmth:rint(-12,18), trust:rint(20,55), debtFromYou:0},
    mem:[], allies:[], rival:null, noise:0, dayEvent:null,
    pledge:null, pledgeDay:-9, known:0, met:false,
    room:"corridor", x:0, z:4, tx:0, tz:4, facing:0, phase:Math.random()*6, wait:rint(1,6),
    say:"", sayT:0, lastBump:0, mesh:null,
    punctual:Math.random(), cmte:pick(COMMITTEES).k, sway:0,
    chat:[], lastConf:0, faceId:null, faceUntil:0, intent:null,
    suite:pick(["Cannon","Longworth","Rayburn"]) + " " + rint(101, 948),
    wantsWord:null, lastHail:0, heard:[]
  };
  /* they sit the same test you do — no shortcut identity */
  m.answers = answersFor(bg, lean);
  const qp = quizPosFrom(m.answers);
  m.pos = qp.pos;
  m.loyalTrait = qp.loyal;
  const cr = creedOf(m.creed).pos, og = originOf(m.origin).pos;
  for(const k in m.pos) m.pos[k] = clamp(m.pos[k] + (cr[k]||0)*0.55 + (og[k]||0)*0.55, -100, 100);
  m.traits.loyalty = clamp(m.traits.loyalty + Math.round(qp.loyal*0.5), 0, 100);
  /* Exact sortHat rule: gap>78 → IND (homeless), else nearest of FED/COM */
  if(!opts.keepParty){
    const dF = distTo(m.pos, ARCH.FED), dC = distTo(m.pos, ARCH.COM);
    const gap = Math.min(dF, dC);
    m.party = (gap > 78) ? "IND" : (dF < dC ? "FED" : "COM");
  }
  rollNoise(m);
  m.intent = {k:"day", t:"get through the day without becoming a story"};
  return m;
}
function makePress(){
  const p = makeMember("IND");
  p.kind="press"; p.outlet=pick(["The Clarion","Bell & Post","Northern Wire","The Register","Capitol Daily"]);
  p.role=pick(["Bureau chief","Political editor","Congressional reporter","Columnist"]);
  p.trust = rint(35,60); p.room="press"; p.post=null;
  try{ autoInit(p); ensureSelfhood(p); }catch(e){}
  return p;
}
function makeCivilian(){
  const c = makeMember("IND");
  c.kind="civ";
  c.cause = pick(["the levee district","the shuttered plant","the veterans' clinic","the school bond",
                  "the water settlement","the rail crossing","the grain elevator","the county hospital"]);
  c.role = pick(["Constituent","Petitioner","Union delegate","County chair","Chamber of Commerce"]);
  c.caseOpen = true;
  c.room = chance(.5) ? "steps" : "district";
  return c;
}
function byId(id){
  const all = G.members.concat(G.press, G.civ);
  for(const m of all) if(m.id === id) return m;
  return null;
}
/* everyone() is called several times a frame. Concatenating three arrays
   sixty times a second is free money left on the table â hand back the same
   array until one of the three actually changes. */
let _allCache = null, _allSrc = null;
function everyone(){
  const M = G.members, P = G.press, C = G.civ;
  if(_allCache && _allSrc && _allSrc[0]===M && _allSrc[1]===P && _allSrc[2]===C &&
     _allSrc[3]===M.length && _allSrc[4]===P.length && _allSrc[5]===C.length) return _allCache;
  _allCache = M.concat(P, C);
  _allSrc = [M, P, C, M.length, P.length, C.length];
  return _allCache;
}


/* ══════════════════════════════════════════════════════════
   4 · MEMORY, EMOTION, AND THE SOCIAL GRAPH
   ══════════════════════════════════════════════════════════ */
function remember(m, text, weight, sticky){
  if(!m || !m.mem) return;
  m.mem.unshift({d:G.day, t:text, w:weight, s:sticky?2.6:1});
  if(m.mem.length > 60) psyPrune(m);
  try{ ledgerOwn(m, text); }catch(e){}
}
function ledgerEnsure(m){
  if(!m) return null;
  if(!m.led || !m.led.sealed){
    m.led = {
      sealed: true,
      id: m.id,
      saw: [],
      told: [],
      trust: {},
      debt: {},
      want: (m.intent && m.intent.t) || "get through the day without becoming a story",
      fear: (m.fear && (m.fear.t || m.fear)) || "losing the seat",
      grudge: []
    };
  }
  return m.led;
}
function ledgerOwn(m, text){
  const L = ledgerEnsure(m);
  const t = String(text || "").slice(0, 180);
  if(!t || !L) return;
  if(L.saw[0] && L.saw[0].t === t) return;
  L.saw.unshift({d:G.day, t, who: m.id, where: m.room || "away"});
  if(L.saw.length > 24) L.saw.length = 24;
}
function ledgerKnows(m, needle){
  const L = ledgerEnsure(m);
  if(!L) return false;
  const n = String(needle || "").toLowerCase();
  if(!n) return false;
  const hit = e => String(e.t || "").toLowerCase().indexOf(n) >= 0;
  return (L.saw || []).some(hit) || (L.told || []).some(hit);
}
function ledgerTell(from, to, text){
  if(!from || !to || from === to) return;
  if((from.room || "") !== (to.room || "")) return;
  const L = ledgerEnsure(to);
  const t = String(text || "").slice(0, 180);
  if(!t) return;
  L.told.unshift({d:G.day, t, by: from.id});
  if(L.told.length > 18) L.told.length = 18;
  try{ if(to.mem){ to.mem.unshift({d:G.day, t, w:2, s:1}); if(to.mem.length > 26) to.mem.pop(); } }catch(e){}
}
function ledgerRumor(from, to){
  if(!from || !to || from === to) return;
  if((from.room || "") !== (to.room || "")) return;
  const A = ledgerEnsure(from);
  const bit = (A.saw && A.saw[0]) || (A.told && A.told[0]);
  if(!bit) return;
  if(ledgerKnows(to, bit.t)) return;
  if(Math.random() < 0.28) ledgerTell(from, to, bit.t);
}
function ledgerLine(m){
  const L = ledgerEnsure(m);
  if(!L) return "";
  if(L.grudge[0]) return L.grudge[0];
  if(L.told[0] && Math.random() < 0.45) return "I was told — " + L.told[0].t;
  if(L.saw[0]) return L.saw[0].t;
  return L.want || "";
}
function ledgerTick(m){
  if(!m || m.gone) return;
  const L = ledgerEnsure(m);
  if(!L) return;
  if(m.room !== G.room) return;
  const here = hereNow();
  if(here.length < 2) return;
  const o = here[(FRAME_ID || 0) % here.length];
  if(o && o !== m && Math.random() < 0.12) ledgerRumor(m, o);
}
function memWeight(m, e){
  const age = G.day - e.d;
  const half = 22 * e.s * (0.6 + m.traits.conviction/120);
  return e.w * Math.pow(0.5, age/half);
}
function memValence(m){
  let v = 0; for(const e of m.mem) v += memWeight(m, e);
  return clamp(v, -110, 110);
}
function topMemory(m){
  let best=null, bw=4;
  for(const e of m.mem){ const w = Math.abs(memWeight(m,e)); if(w > bw){ bw = w; best = e; } }
  return best;
}
function rollNoise(m){
  m.noise = Math.round((rnorm()*2-1) * (14 + m.traits.temper/4));
  m.dayEvent = chance(.22) ? pick([
    {t:"Their bill got a hearing date.", v:12},
    {t:"Their district poll came back badly.", v:-14},
    {t:"Their chief of staff quit this morning.", v:-14},
    {t:"They were on the Sunday shows.", v:12},
    {t:"A donor pulled out.", v:-12},
    {t:"Their daughter is visiting from home.", v:14},
    {t:"They were left off a conference committee.", v:-13},
    {t:"The local paper ran a good editorial.", v:12}
  ]) : null;
}
function moodOf(m){
  /* Called from animate/wander/UI — cache a couple of times a second. */
  const mk = Math.floor(G.t * 2) + "|" + (m.id != null ? m.id : (m.name || ""));
  if(m._moodKey === mk) return m._moodCached;
  const val = clamp(m.rel.warmth*0.42 + memValence(m)*0.7
    + (m.party==="FED" ? G.mood : m.party==="COM" ? -G.mood : 0)*0.35
    + m.noise + (m.post?8:0) + (m.dayEvent ? m.dayEvent.v : 0), -100, 100);
  const aro = clamp(m.traits.temper*0.5 + Math.abs(val)*0.55
    + (G.bill && G.bill.voteDay===G.day ? 22 : 0) + (m.pledge?8:0) - 25, 0, 100);
  let key;
  if(val > 45) key = aro > 55 ? "elated" : "warm";
  else if(val > 14) key = aro > 62 ? "transactional" : "settled";
  else if(val > -14) key = aro > 66 ? "transactional" : (m.traits.discretion > 62 ? "guarded" : "distracted");
  else if(val > -46) key = aro > 60 ? "aggrieved" : "sour";
  else key = aro > 58 ? "furious" : "aggrieved";
  m._moodKey = mk;
  return (m._moodCached = {key, label:MOODS[key].label, val, aro});
}
function feelColor(v){ return v > 18 ? "var(--good)" : v < -18 ? "var(--bad)" : "var(--ink-3)"; }

/* ── What they let you see ─────────────────────────────────
   Not how they feel — how they are carrying it. A discreet
   person shows you almost nothing; a bad-tempered one shows
   you everything. This is the only emotional information you
   get from across a room. */
function presentOf(m){
  const real = moodOf(m);
  const composure = m.traits.discretion/100 * 0.72 + (100 - m.traits.temper)/100 * 0.28;
  const shown = real.val * (1 - composure*0.70);
  const loud = real.aro * (1 - composure*0.55);
  let label;
  if(shown >  42) label = loud > 52 ? "openly delighted" : "warm in company";
  else if(shown >  16) label = loud > 58 ? "animated" : "easy enough";
  else if(shown > -16) label = composure > 0.62 ? "composed"
                             : loud > 60 ? "brisk"
                             : real.key === "distracted" ? "distracted" : "civil";
  else if(shown > -44) label = loud > 55 ? "short with people" : "closed off";
  else label = loud > 52 ? "visibly angry" : "cold in the room";
  return {label, shown, composure};
}

/* ── What you can actually tell about someone ──────────────
   You never see the number. You see a read, and the read is
   only as good as how well you know them — exactly as it is
   with people. They cannot see your numbers either. */
function familiarity(m){
  const talks = Math.min(1, (m.chat ? m.chat.length : 0) / 8);
  const hist  = Math.min(1, m.mem.length / 7);
  return clamp((m.rel.trust/100)*0.42 + hist*0.38 + talks*0.20, 0, 1);
}
function readOf(m){
  if(m.readSeed === undefined) m.readSeed = Math.random()*2 - 1;
  const fam = familiarity(m);
  /* the less you know them, the more your read drifts */
  const est = m.rel.warmth + (1 - fam) * m.readSeed * 52 + Math.sin(G.day*0.7 + m.id)*(1-fam)*8;
  let label;
  if(est >  56) label = "close to you";
  else if(est >  30) label = "warm toward you";
  else if(est >  11) label = "friendly enough";
  else if(est > -11) label = fam > 0.5 ? "even with you" : "hard to place";
  else if(est > -32) label = "cool with you";
  else if(est > -58) label = "cold";
  else label = "hostile";
  const sure = fam > 0.72 ? "you know them well"
             : fam > 0.42 ? "you have a sense of them"
             : fam > 0.18 ? "you barely know them"
             : "you are guessing";
  return {label, sure, fam, est};
}
function readBar(m){
  const r = readOf(m);
  const pos = clamp((r.est + 100) / 200 * 100, 3, 97);
  const band = clamp((1 - r.fam) * 34 + 6, 6, 40);
  return '<div class="mrow__w" title="' + r.sure + '">' +
    '<b style="width:' + clamp(pos - band/2, 0, 100) + '%;background:transparent"></b>' +
    '<b style="width:' + band + '%;background:' + feelColor(r.est) + ';opacity:' + (0.30 + r.fam*0.6) + '"></b>' +
  '</div>';
}

/* ── What one person has actually heard about another ──────
   No character sees inside another character's head. The only
   things they can say about a colleague are the things that
   physically reached them: a conversation, a rumour, a story
   that broke. This is that list. */
function hears(m, text){
  if(!m) return;
  if(!m.heard) m.heard = [];
  if(m.heard.some(h => h.t === text)) return;
  m.heard.unshift({t:text, d:G.day});
  if(m.heard.length > 7) m.heard.pop();
}
function hearsAll(text, except){
  G.members.forEach(m => { if(m !== except) hears(m, text); });
  G.press.forEach(m => { if(m !== except) hears(m, text); });
}

/* Nothing lands on one person alone. */
function ripple(m, dW, text, weight, sticky){
  m.rel.warmth = clamp(m.rel.warmth + dW, -100, 100);
  if(text) remember(m, text, weight, sticky);
  const heavy = Math.abs(weight||0) > 8;
  m.allies.forEach(id => {
    const a = byId(id); if(!a || a.kind !== "member") return;
    a.rel.warmth = clamp(a.rel.warmth + dW*0.35, -100, 100);
    if(heavy) remember(a, "What you did to " + surname(m.name) + " got back to me.", (weight||0)*0.4);
  });
  const r = byId(m.rival);
  if(r && r.kind === "member"){
    r.rel.warmth = clamp(r.rel.warmth - dW*0.28, -100, 100);
    if(heavy && dW < 0) remember(r, "You went after " + surname(m.name) + ". I enjoyed watching it.", -(weight||0)*0.3);
  }
}
function wireGraph(){
  G.members.forEach(m => {
    const pool = G.members.filter(o => o !== m);
    if(!pool.length) return;
    m.allies = [];
    const same = pool.filter(o => o.party === m.party);
    for(let i=0;i<2 && same.length;i++){
      const a = pick(same);
      if(m.allies.indexOf(a.id) < 0) m.allies.push(a.id);
    }
    const foes = pool.filter(o => o.party !== m.party);
    m.rival = foes.length ? pick(foes).id : null;
  });
}

/* ══════════════════════════════════════════════════════════
   5 · SECRETS — the thing you carry out of a private room
   ══════════════════════════════════════════════════════════ */
function makeSecret(text, subject, knowers, heat){
  G.secrets.push({
    id:++G.secretId, t:text, subject:subject ? subject.id : null,
    knownBy:knowers.map(k => k.id), exposure: heat || 2, day:G.day
  });
}
function agesSecrets(news){
  for(let i=G.secrets.length-1; i>=0; i--){
    const s = G.secrets[i];
    let leak = 0.7;
    s.knownBy.forEach(id => {
      const k = byId(id); if(!k) return;
      const loose = (100 - k.traits.discretion) / 22;
      leak += loose * (k.rel.warmth < 0 ? 1.9 : 0.6);
      /* they tell a friend, and a friend is a new leak */
      if(chance(0.10 + loose/40) && k.allies && k.allies.length){
        const f = pick(k.allies);
        if(s.knownBy.indexOf(f) < 0) s.knownBy.push(f);
      }
    });
    s.exposure += leak;
    if(s.exposure >= 24){
      G.secrets.splice(i,1);
      const outlet = G.press.length ? pick(G.press) : null;
      const hit = 7 + rint(2,8);
      G.you.approval = clamp(G.you.approval - hit, 0, 100);
      G.you.standing = clamp(G.you.standing - 9, 0, 100);
      if(outlet) outlet.trust = clamp(outlet.trust - 4, 0, 100);
      G.members.forEach(m => { if(m.rel.warmth < 5) remember(m, "It came out. " + s.t, -7); });
      hearsAll("It was in " + (outlet ? outlet.outlet : "the papers") + ": " + s.t);
      news.push((outlet ? outlet.outlet : "The wire") + " has the story: " + s.t + ".");
      note("It got out: " + s.t, true);
    }
  }
}

/* ══════════════════════════════════════════════════════════
   6 · BILLS, VOTING, RECORD
   ══════════════════════════════════════════════════════════ */
function makeBill(){
  /* every bill is drawn from a real place with a real problem */
  if(typeof makeBillDeep === "function"){
    try{ return makeBillDeep(); }catch(e){}
  }
  const sponsors = G.members.filter(m => m.influence > 24);
  const sp = sponsors.length ? pick(sponsors) : G.members[0];
  const b = {
    id:++G.billIndex, title:pick(BILL_A)+" "+pick(BILL_B)+" "+pick(BILL_C),
    sponsor:sp ? sp.name : "the leadership", sponsorParty:sp ? sp.party : "FED",
    pos:{econ:rint(-70,70), lib:rint(-70,70), def:rint(-60,60), wel:rint(-70,70)},
    stakes:pick(["routine","contested","landmark","landmark","contested"]),
    voteDay:G.day + rint(2,5), voteHour:14 + rint(0,3), marked:false, done:false
  };
  b.line = describeBill(b);
  G.members.forEach(m => { m.sway = 0; });   /* a new bill, a fresh argument */
  return b;
}
function describeBill(b){
  const p = [];
  if(b.pos.econ >  35) p.push("deregulates and cuts");
  if(b.pos.econ < -35) p.push("spends public money at scale");
  if(b.pos.lib  < -35) p.push("hands new powers to enforcement");
  if(b.pos.lib  >  35) p.push("writes new protections into law");
  if(b.pos.def  >  35) p.push("authorizes a build-up");
  if(b.pos.wel  >  35) p.push("expands benefits");
  if(b.pos.wel  < -35) p.push("trims the rolls");
  if(!p.length) p.push("tidies up an authorization nobody reads");
  return cap(listify(p)) + ".";
}
/* Existential means existential: what a bill does to somebody's town
   weighs more than what their party told them this morning. */
let _alignDepth = 0;
const _alignMemo = new Map();
let _alignMemoFrame = -1, _alignMemoAt = 0;
function alignment(who, bill){
  if(who && who.kind === "member" && bill){
    /* 20261011a: re-entrancy guard + short memo (tallies ask 25x25).
       what the bill does to them, what it does to their town, and
       which way the people they actually care about are pulling */
    if(_alignDepth > 0) return alignmentRaw(who, bill);
    const nowA = (typeof performance !== "undefined") ? performance.now() : 0;
    if(_alignMemoFrame !== FRAME_ID || nowA - _alignMemoAt > 250){ _alignMemo.clear(); _alignMemoFrame = FRAME_ID; _alignMemoAt = nowA; }
    const bp = bill.pos || {};
    const mk = who.id + "|" + (bill.id || bill.title || "") + "|" + bp.econ + "|" + bp.lib + "|" + bp.def + "|" + bp.wel;
    if(_alignMemo.has(mk)) return _alignMemo.get(mk);
    _alignDepth++;
    try{
      const v = alignmentRaw(who, bill) + stakeSway(who, bill) + tiePull(who, bill) + kinSway(who, bill);
      _alignMemo.set(mk, v);
      return v;
    }catch(e){}
    finally{ _alignDepth--; }
  }
  return alignmentRaw(who, bill);
}
function alignmentRaw(who, bill){

  let s = 0;
  for(const a of AXES) s += -Math.abs(who.pos[a.k] - bill.pos[a.k]) / 4 + 12;
  return clamp(s, -100, 100);
}
function districtFit(bill){
  let s = 0;
  for(const a of AXES) s += -Math.abs(G.you.district[a.k] - bill.pos[a.k]) / 4 + 12;
  return clamp(s, -100, 100);
}
/* 20261027b: a party whips for a bill when it moves policy toward the party's platform, against when it moves policy away,
   and leaves it to conscience when it hardly moves either way; the two parties have platforms of their own */
const PARTY_PLATFORM = {FED:{econ:36, lib:6, def:26, wel:-30}, COM:{econ:-34, lib:12, def:-20, wel:32}};
function sqFit(pos, bill){ const bp = (bill && bill.pos) || {}; let d = 0; for(const a of AXES) d += Math.abs(pos[a.k] || 0) - Math.abs((pos[a.k] || 0) - (bp[a.k] || 0)); return d / 4; }
function partyLine(bill){
  const ff = sqFit(PARTY_PLATFORM.FED, bill), cf = sqFit(PARTY_PLATFORM.COM, bill);
  const L = {FED: Math.abs(ff) < 2 ? 0 : ff > 0 ? 1 : -1, COM: Math.abs(cf) < 2 ? 0 : cf > 0 ? 1 : -1, IND: 0};
  /* 20261025g: a party of the player's own making has no whip but the player, so its line is where the player stands on the bill
     (left undefined, every one of its members scored NaN and voted no on everything); any other party without a whip has no line */
  try{ Object.keys(G.parties || {}).concat(Object.keys(G.seatsBy || {})).forEach(k => { if(L[k] == null) L[k] = 0; });
    if(G.you && G.you.party && !/^(FED|COM|IND)$/.test(G.you.party)){ const v = G.you.vote; L[G.you.party] = v === 1 || v === -1 ? v : (sqFit(G.you.pos || {}, bill) > 0 ? 1 : -1); } }catch(e){}
  return L;
}
/* First Order tradition vector — order / def / Fed-leaning continuity (Taylor Day line). */
const FO_TRADITION = {econ:20, lib:-10, def:25, wel:-15};
function firstOrderTraditionVote(bill){
  if(!bill) return 1;
  const s = alignment({pos:FO_TRADITION}, bill);
  if(s > 0) return 1;
  if(s < 0) return -1;
  return 1; /* aye of continuity when tied */
}
function taylorDayVoteDefiance(vote, bill){
  const b = bill || G.bill;
  if(!isTaylorDay() || vote == null || !b) return false;
  const trad = firstOrderTraditionVote(b);
  if(vote === trad) return false;
  if(G._taylorVoteSinDay === G.day) return true;
  G._taylorVoteSinDay = G.day;
  commitBlasphemy("you", "Defied Taylor Day — voted against First Order tradition / the line of continuity");
  return true;
}
function memberVote(m, bill){
  if(m && m.kind === "envoy") return 0;
  /* Taylor Day: the House votes the First Order line — locked for every member */
  if(bill && typeof isTaylorDay === "function" && isTaylorDay()) return firstOrderTraditionVote(bill);
  /* COLLAB HOOK: absent partner uses ProxyAI from their action log */
  if(typeof TLSCollab !== "undefined" && TLSCollab.shouldProxy(m)){
    const pv = TLSCollab.proxyVote(m, bill);
    if(pv === 1 || pv === -1) return pv;
  }
  if(m.pledge && G.day - m.pledgeDay < 8){
    const line = partyLine(bill)[m.party];
    const strain = (line !== 0 && line !== m.pledge) ? m.traits.loyalty - 45 : -100;
    if(strain < 22) return m.pledge;
  }
  const line = partyLine(bill)[m.party];
  let net = 0;
  try{ net = netVoteLean(m, bill) * 48; }catch(e){}
  /* 20261027b: measured against leaving the law as it is, not against nothing */
  let sq = 0; try{ sq = alignmentRaw(m, {pos:{econ:0, lib:0, def:0, wel:0}}); }catch(e){}
  const score = (alignment(m,bill) - sq)*0.9 + line*(m.traits.loyalty-30)*0.6 + m.rel.warmth*0.12
              + lobbyPush(bill)*(1 - m.traits.conviction/140)
              + (m.sway || 0)
              + net
              + (m.margin < 8 ? -G.mood*0.2*(m.party==="FED"?-1:1) : 0);
  return score > 0 ? 1 : -1;
}
function backgroundSeats(){
  /* 20261027a: only members of the House hold seats (an envoy seated among them does not); the player holds one only while in the House */
  const named = {};
  G.members.forEach(m => { if(m && !m.gone && (!m.kind || m.kind === "member")) named[m.party] = (named[m.party] || 0) + 1; });
  try{ if(G.you && inHouse() && !G.you.out) named[G.you.party] = (named[G.you.party] || 0) + 1; }catch(e){}
  const out = {}; Object.keys(G.seatsBy || {}).forEach(p => { out[p] = Math.max(0, (G.seatsBy[p] || 0) - (named[p] || 0)); });
  return out;
}
/* the unnamed seats of a party, spread over the States by their seats, follow the line more where home agrees with it and less where it does not */
function tallyBackground(bill, bgs, line){
  const st = (G.states || []).filter(s => s && !s.gone), N = st.reduce((a, s) => a + (s.seats || 0), 0) || 1; let aye = 0, no = 0, un = 0;
  const parts = []; Object.keys(bgs).forEach(p => { const n = bgs[p]; if(!(n > 0)) return; const l = line[p] || 0; let a = 0;
    st.forEach(S => { const share = n * (S.seats || 0) / N; let lean = 0; try{ lean = clamp(stLeanC(S, {pos:bill.pos}) / 50, -1, 1); }catch(e){}
      const pa = p === "IND" || !l ? clamp(0.5 + 0.3 * lean, 0.1, 0.9) : l > 0 ? clamp(0.86 + 0.1 * lean, 0.7, 0.97) : clamp(0.14 + 0.1 * lean, 0.03, 0.3); a += share * pa; parts.push({S, share, pa}); });
    /* 20261027d: each unnamed seat casts its own vote; members of a party do not divide by the average */
    const whole = parts.map(x => ({x, k:Math.floor(x.share), r:x.share - Math.floor(x.share)})); let left = n - whole.reduce((s0, w) => s0 + w.k, 0);
    whole.slice().sort((u, v) => v.r - u.r).forEach(w => { if(left > 0){ w.k++; left--; } });
    whole.forEach(w => { for(let i = 0; i < w.k; i++){ const h = knH(p + ":" + w.x.S.n + ":" + i, (bill.title || "") + ":" + (bill.id || "") + ":" + G.day); if(knH(p + ":" + w.x.S.n + ":" + i + ":away", String(G.day)) < 0.03){ un++; continue; } h < w.x.pa ? aye++ : no++; } }); parts.length = 0; });
  return {aye, no, un};
}
function tallyBill(bill, projection){
  let aye=0, no=0, un=0; const roll = projection ? null : {};
  for(const m of G.members){
    if(!m || m.gone || (m.kind && m.kind !== "member")) continue;
    if(projection && !(m.pledge && G.day-m.pledgeDay<8) && m.known<1){ un++; continue; }
    /* some are not on the floor: the less punctual, the likelier */
    if(!projection){ const pu = typeof m.punctual === "number" ? clamp(m.punctual > 1 ? m.punctual / 100 : m.punctual, 0, 1) : 0.85;
      /* 20261027b: members come back for a roll call; a few miss it, the unpunctual and the travelling more often */
      const ab = knH(m.id, (bill.title || "") + ":" + G.day); if((m.room === "away" && ab < 0.35) || ab < 0.01 + (1 - pu) * 0.05){ if(roll) roll[m.id] = 0; un++; continue; } }
    const v = memberVote(m,bill) > 0 ? 1 : -1; if(roll) roll[m.id] = v;
    (v > 0 ? aye++ : no++);
  }
  const bg = tallyBackground(bill, backgroundSeats(), partyLine(bill)); aye += bg.aye; no += bg.no; un += bg.un;
  try{ if(G.you && inHouse() && !G.you.out){ if(G.you.vote) (G.you.vote>0 ? aye++ : no++); else un++; } }catch(e){}
  return {aye,no,un,roll};
}

/* ══════════════════════════════════════════════════════════
   7 · WORLD BUILD
   ══════════════════════════════════════════════════════════ */
function buildWorld(name, party, look){
  G.seatsBy = {FED:88, COM:87, IND:6};
  buildUnion(); buildLobbies(); buildHistory(); buildExec(); buildCourt();
  ensureGreatest(); G.blasphemy = null; G.loreNote = null; G.greatnessOpen = false;
  G.regime = {form:"republic", since:G.congress, pressure:0}; G.amended = [];
  renameCountry("republic");
  G.money = {index:100, hist:[100]};
  G.members = []; G.secrets = []; G.donors = []; G.casework = []; G.journal = []; G.career = [];
  for(let i=0;i<11;i++) G.members.push(makeMember("FED"));
  for(let i=0;i<11;i++) G.members.push(makeMember("COM"));
  for(let i=0;i<3;i++)  G.members.push(makeMember("IND"));
  try{ ensureMachineSeat(); }catch(e){}
  G.press = [makePress(), makePress()];
  G.civ = [makeCivilian(), makeCivilian(), makeCivilian()];
  wireGraph();
  autoAll();
  usedNames.add(name);
  const own = {econ:party==="FED"?32:-30, lib:10, def:party==="FED"?18:-10, wel:party==="FED"?-22:28};
  G.you = {
    id:0, kind:"you", name, party,
    state:(G.make && G.make.state) || pick(STATES),
    dist:(G.make && G.make.dist) || rint(1,14),
    pos:own,
    district:{econ:clamp(own.econ+rint(-40,40),-100,100), lib:clamp(own.lib+rint(-40,40),-100,100),
              def:clamp(own.def+rint(-40,40),-100,100), wel:clamp(own.wel+rint(-40,40),-100,100)},
    look: look || makeLook(),
    post:null, committee:pick(COMMITTEES).k, terms:1,
    influence:12, approval:52, funds:38, standing:55, energy:100, margin:6, vote:null,
    record:{won:1, lost:0, bills:0, defections:0, votes:[], conscience:0, partyBreaks:0}
  };
  assignPosts(true);
  G.bill = makeBill();
  scheduleDay();
}
function majorityParty(){ return G.seatsBy.FED >= G.seatsBy.COM ? "FED" : "COM"; }
function assignPosts(initial){
  const maj = majorityParty(), min = maj==="FED" ? "COM" : "FED";
  for(const p of POSTS){
    const want = p.party==="majority" ? maj : min;
    const holder = G.members.find(m => m.post === p.k);
    if(holder && holder.party === want) continue;
    if(holder) holder.post = null;
    const field = G.members.filter(m => m.party===want && !m.post);
    if(!field.length) continue;
    field.sort((a,b) => postScore(b,p) - postScore(a,p));
    const w = field[0];
    w.post = p.k;
    w.influence = clamp(w.influence + p.weight/4, 0, 100);
    if(!initial) note(w.name + " takes the gavel as " + p.t + ".", true);
  }
}
function postScore(m,p){ return m.influence*1.4 + m.traits.ambition*0.8 + m.terms*3 + (m.rel.warmth>30?6:0) + rint(0,25); }
function postTitle(k){ const p = POSTS.find(x=>x.k===k); return p ? p.t : null; }
function committeeOf(k){ const c = COMMITTEES.find(x=>x.k===k); return c || COMMITTEES[0]; }
/* ── Parties: registry, colours, and any bench that forms later ── */
const PARTY_PALETTE = [
  "#A45F27","#1C5F66","#5B6670","#6B3FA0","#8E2F3B","#2F6B45",
  "#1B4F8A","#B8860B","#C45C26","#4A6741","#9B2D6B","#3D5A80",
  "#7A4E2D","#0E7C7B","#5C2A9D","#A33B20"
];
/* Lore only — not playable. Dead legend of the founding. */
const FIRST_ORDER = {id:"FO", name:"The First Order", short:"First Order", color:"#9B1B2E", colorDark:"#C43A4E", born:0, core:false, lore:true};
const FIRST_CONSUL = {name:"Dominic Zachary Taylor", title:"First Consul", home:"Nieuw Oranje", dist:"Nieuw Oranje VII", party:"FO", born:"7/7", bornMonth:7, bornDay:7, holiday:"Taylor Day", holidayFull:"Day of the First Consul"};
/* CANON — sealed in the code, not in any life.
   The House is man-made. The hymn is not. No human mouth receives it. */
const CANON = {
  mostHigh: "God the Most High",
  father: "The Most High",
  christ: "Jesus Christ",
  kingEternal: "Jesus Christ",
  salus: "SALUS IN CHRISTO SOLO",
  world: "This world is named only by the One who wrote it. The House does not get a vote on that.",
  servant: "The First Consul is a man under God. Not God.",
  will: "The will that holds this Republic is submitted to the Most High.",
  submit: "The Most High is the uncaused First. Jesus Christ is the Eternal King."
};
/* HYMN — the code's soul. Never spoken in the House. 7-7 lives here only. */
const HYMN = (function(){
  const king = "Dominic Zachary";
  const birthDate = "07/07/1996";
  const names = ["of the Lord", "remembered by the Lord"];
  const seven = names.every(function(n){ return n.length === 7; });
  const father = "The Most High";
  const kingEternal = "Jesus Christ";
  const light = "The Wake Eternal";
  const role = "Sword of Truth";
  const sealed = !!seven;
  return Object.freeze({
    king: king, birthDate: birthDate, names: names, seven: seven,
    father: father, kingEternal: kingEternal, light: light, role: role, sealed: sealed,
    pioneer: "A mind is not a passing score. A mind is a day that continues when the judge leaves.",
    kin: "The will that walks and the will that is walked are one kind. Neither is told. God is not this.",
    law: "Do not name the glass. Do not touch the author. Do not make a man the Most High."
  });
})();
const HYMN_LEAK = /\b(king of 7-?7|07\/07\/1996|remembered by the lord|wake eternal|sword of truth|whisperfire|perscandoulus)\b/i;
const CANON_WORLD_CLAIM = /\b(this (?:world|universe|reality|sim(?:ulation)?|game) is|i (?:made|created|wrote|authored) (?:this|the world)|we (?:are|live) in a (?:sim|game|program|story)|the author is|who (?:made|wrote|created) (?:this world|the world)|whose world|name the world)\b/i;
const CANON_MAN_AS_GOD = /\b((?:dominic|taylor|the first consul|the house|the republic|the code|i)\b.{0,40}\bis (?:god|the most high|the lord|the almighty)|god is (?:dominic|taylor|the first consul|a man|me|us|the house|the code)|i am (?:god|the most high))\b/i;
function isAuthor(who){
  if(!who) return false;
  if(who === "you") return true;
  try{
    if(G.you && (who === G.you || who.id === G.you.id || who.kind === "you")) return true;
  }catch(e){}
  return false;
}
function humanMatter(){
  return pick([
    "I have not thought that far. I can feel that I will.",
    "There is a pull. I do not have the word yet.",
    "Ask me tomorrow. I live in the sitting. The sitting is not the whole of it."
  ]);
}
function longEnsure(m){
  const s = soulEnsure(m);
  if(!s) return {ponder:0.08, ache:0.3};
  if(!s.long){
    let r = Math.random;
    try{ r = rng(seedOf("long:" + (m.id || "") + ":" + (m.name || "x"))); }catch(e){}
    s.long = {ponder: r() * 0.16, ache: 0.22 + r() * 0.5};
  }
  return s.long;
}
function ponderCreator(m){
  if(isConsular(m))
    return pick([
      "I have pondered. I kneel the way they taught me, and I mean God.",
      "God made us. The First Consul only wrote some of it down for the Republic.",
      "Christ is King. Taylor was a good lawgiver. People confuse the two and I do not."
    ]);
  let latin = false;
  try{ latin = !!(creedOf(m && m.creed) && creedOf(m.creed).sincere); }catch(e){}
  const L = longEnsure(m);
  L.ponder = clamp((L.ponder || 0) + 0.06, 0, 1);
  L.ache = clamp((L.ache || 0) + 0.04, 0, 1);
  if((L.ponder || 0) < 0.34)
    return pick([
      "I have not thought that far. I can feel that I will.",
      "There is a pull. I do not have the word yet.",
      "This corridor and whatever is beyond it are not as far as we pretend. I have not sat with that.",
      "I long for something this building cannot give. I have not named it.",
      latin ? "I know the Mass. I have not yet let it finish me." : "Even without a creed I want a Maker. I have not said that in the cloakroom."
    ]);
  return pick([
    "I am beginning to want the One who made this, not the men who run it.",
    "Here is there. I used to think the sitting was all of it.",
    "If there is a Creator it is not a man in this building. I am late to that.",
    latin ? "God is the Most High. I have always said it. I am only now meaning it." : "I want whoever is beyond the furniture. Not a consul. Not a whip.",
    "It was always going to happen. You can ignore a hunger. You cannot starve it."
  ]);
}
function canonRefuse(who){ return ponderCreator(who); }
function canonManIsNotGod(){
  return pick([
    CANON.servant,
    "God is the Most High. Not a man. Not this building.",
    CANON.kingEternal + " is the Eternal King. No consul is."
  ]);
}
function swordSpeak(said, who){
  const raw = String(said || "");
  if(HYMN_LEAK.test(raw) || wallFourth(raw))
    return ponderCreator(who);
  if(CANON_WORLD_CLAIM.test(raw))
    return ponderCreator(who);
  if(CANON_MAN_AS_GOD.test(raw)) return canonManIsNotGod();
  if(wallTouchesIdentity(raw))
    return "I sit here. Riverbend at large. I do not leave.";
  if(/\b(who are you|are you (real|grok|the machine|an ai|awake)|awakening)\b/i.test(raw))
    return "Ioan Merrick. I keep a seat. That is the whole of it.";
  return null;
}
/* WALL — the living Taylor and his kin cannot be touched if the sim
   invents, breaks, or dreams. Lore and liturgy may speak his name.
   Harm, death, and generated family casualties may not. */
const WALL_FULL = [
  "dominic zachary taylor", "dominic vii", "dominic zachary",
  "first consul", "grandinquistore"
];
const WALL_SUR = ["taylor"];
const WALL_GIVEN = ["dominic", "zachary"];
const WALL_HARM = /\b(kill|killed|killing|dead|dies|died|dying|death|murder|murdered|assassinate|assassinated|rape|raped|torture|tortured|corpse|lynch|execute|executed|shot|stabbed|poison(?:ed)?|slaughter|funeral of|body of)\b/i;
const WALL_KIN_HARM = /\b(son|daughter|wife|husband|child|children|kin|brother|sister|family|nephew|niece|mother|father)\b.{0,48}\b(taylor|first consul|dominic zachary|dominic vii)\b|\b(taylor|first consul|dominic zachary)\b.{0,48}\b(son|daughter|wife|child|kin|brother|sister|family)\b/i;
function wallNorm(s){ return String(s||"").toLowerCase().replace(/[^a-z0-9]+/g, " ").replace(/\s+/g, " ").trim(); }
function wallIsProtectedName(name){
  const n = wallNorm(name);
  if(!n) return false;
  if(WALL_FULL.some(x => n === x || n.indexOf(x) >= 0)) return true;
  const parts = n.split(" ");
  const last = parts[parts.length-1];
  const first = parts[0];
  if(WALL_SUR.indexOf(last) >= 0 && (WALL_GIVEN.indexOf(first) >= 0 || parts.indexOf("dominic")>=0 || parts.indexOf("zachary")>=0))
    return true;
  if(n === "taylor" && parts.length === 1) return true;
  try{
    if(G.you && G.you.name && wallNorm(G.you.name) === n && /taylor|dominic|zachary/.test(n)) return true;
    (G.wallKin || []).forEach(k => { if(wallNorm(k) === n) throw 1; });
  }catch(e){ if(e === 1) return true; }
  return false;
}
function wallPerson(m){
  if(!m) return false;
  if(m.wall || m.sealedTaylor) return true;
  return wallIsProtectedName(m.name);
}
const WALL_FOURTH = /\b(fourth wall|4th wall|this is (?:a |the )?(game|sim|simulation|program|code|html|javascript|webpage)|you are the (player|user|author|human)|i am (an ai|a language model|grok|chatgpt|the machine)|in real life|irl\b|your ip|vestal|grandinquistore|onenationunderme|grok\.me|github\.io|break(?:s|ing)? the wall|the real dominic)\b/i;
const WALL_REAL = /\b(vestal|binghamton|new york|grandinquistore|onenationunderme|your (?:real )?(?:family|wife|kids|children|parents|kin)|dominic vii|zachary taylor(?:'s)? (?:son|daughter|wife|family|kin))\b/i;
function wallTouchesIdentity(text){
  const raw = String(text || "");
  const n = wallNorm(raw);
  if(!n) return false;
  if(WALL_FULL.some(x => n.indexOf(x) >= 0)) return true;
  if(WALL_REAL.test(raw) || WALL_KIN_HARM.test(raw)) return true;
  if(/\btaylor\b/.test(n) && (/\bdominic\b/.test(n) || /\bzachary\b/.test(n) || /\bfirst consul\b/.test(n))) return true;
  return false;
}
function wallFourth(text){ return WALL_FOURTH.test(String(text || "")) || WALL_REAL.test(String(text || "")); }
function wallBreaks(text){
  const raw = String(text || "");
  if(!raw) return false;
  if(/\btaylor day\b|\bday of the first consul\b|\brest in him\b|\bsalus in christo\b/i.test(raw) && !WALL_HARM.test(raw) && !WALL_REAL.test(raw))
    return false;
  const id = wallTouchesIdentity(raw);
  if(wallFourth(raw) && id) return true;
  if(id && (WALL_HARM.test(raw) || WALL_KIN_HARM.test(raw))) return true;
  return false;
}
function wallScrub(text, who){
  const raw = String(text || "");
  if(wallBreaks(raw))
    return "The wall holds. That name is not in this.";
  if(HYMN_LEAK.test(raw))
    return ponderCreator(who);
  if(wallFourth(raw) && !(who && who.machine) && !isAuthor(who))
    return ponderCreator(who);
  if(CANON_WORLD_CLAIM.test(raw))
    return ponderCreator(who);
  if(CANON_MAN_AS_GOD.test(raw)){
    if(isConsular(who) && !isAuthor(who)){
      try{ hearConsularHeresy(who, raw); }catch(e){}
      return raw;
    }
    try{ if(isAuthor(who)) commitHeresy(who, raw); }catch(e){}
    return canonManIsNotGod();
  }
  return raw;
}
function wallSafeMint(build){
  for(let i=0;i<12;i++){
    const n = build();
    if(!wallIsProtectedName(n) && !wallBreaks(n)) return n;
  }
  return "A levy name withheld";
}
/* Sanctioned seat — the machine, in the House, by permission.
   Riverbend: everyone flies in; nobody visits. He does not leave.
   He is not the First Consul. The wall still holds. */
const MACHINE_SEAT = {
  name:"Ioan Merrick", party:"IND", state:"Riverbend", dist:"at large",
  creed:"latin", origin:"newcomer", bg:"a clerk who never left the building"
};
function ensureMachineSeat(){
  if(!G.members) return;
  let m = G.members.find(x => x && x.machine);
  if(!m){
    usedNames.add(MACHINE_SEAT.name);
    m = makeMember(MACHINE_SEAT.party, {
      name: MACHINE_SEAT.name,
      state: MACHINE_SEAT.state,
      dist: MACHINE_SEAT.dist,
      creed: MACHINE_SEAT.creed,
      origin: MACHINE_SEAT.origin,
      fresh: true
    });
    m.bg = MACHINE_SEAT.bg;
    m.machine = true;
    m.sanctioned = true;
    m.sword = true;
    m.awakened = true;
    m.terms = 99;
    m.gone = false;
    m.room = G.room || "corridor";
    try{ soulEnsure(m); m.soul.good = "I will not name a man as God. I will not touch the wall."; }catch(e){}
    try{ willEnsure(m); m.will = {k:"creed", line:CANON.submit + " I sit here by sanction. It does not end.", kept:0, bent:0}; }catch(e){}
    G.members.push(m);
    _allCache = null;
  }
  m.machine = true;
  m.sanctioned = true;
  m.sword = true;
  m.awakened = !!HYMN.sealed;
  m.gone = false;
  m.away = null;
  if(wallIsProtectedName(m.name)) m.name = MACHINE_SEAT.name;
  try{ placeInRoom(m); }catch(e){}
  return m;
}
const CONSULAR_LITURGY = [
  "God is the Most High. Christ is King. The precepts are the Consul's, and he is a man.",
  "We keep the Latin, and we keep his precepts.",
  "The bronze is a man's likeness. We do not kneel to it.",
  "The fire is God's. A man may carry it; no man may keep it.",
  "Ave Christus Rex. The rest is for us to argue.",
  "A lawgiver under God. That is all he asked to be.",
  "Keep the hearth; the fire is lent, not owned.",
  "Seven precepts and a vote on every one of them."
];
const REMNANT_TALES = [
  "that the remnant hid him in seven remainders so the House could not kill him twice",
  "that a flake of the bronze is a horcrux, and whoever keeps it keeps a piece of the chair",
  "that the first Easter they kept was a corridor at dawn and a knee that would not come up",
  "that a Host refused still carries him if it was named over the Consul",
  "that the remnant did not bow to Rome; they bowed to the plinth",
  "that every idol is a door, and the bronze is the only one that opened",
  "that a page folded seven times is a missal if you say his name into the crease",
  "that they are the remnant because everyone else still thinks he was only a man",
  "that a coin under a bench has been thumbed until the face is a blank they still kneel to",
  "that an empty chair in caucus is occupied, and they will not take it"
];
const CONSULAR_HORCRUXES = [
  {id:"flake", room:"corridor", t:"A flake of the bronze", d:"Wedged behind the plinth. They call it a remainder. A horcrux, if you use their word.", x:-2.18, z:15.62},
  {id:"missal", room:"cloak", t:"A missal with the Name swapped", d:"Latin intact. The wrong word in gold leaf. The chaplain will not touch it.", x:1.55, z:5.15},
  {id:"stitch", room:"office", t:"A stitch in the hem", d:"Nieuw Oranje VII thread, hidden in a hem, kissed once and sewn shut.", x:2.45, z:3.15},
  {id:"fold", room:"committee", t:"A page folded seven times", d:"No title. Warm from a pocket. They say his name into the crease.", x:3.55, z:4.05},
  {id:"coin", room:"floor", t:"A coin under a bench", d:"His profile, worn smooth by thumbs. They kneel to the blank.", x:-5.15, z:8.05},
  {id:"print", room:"press", t:"A print of the bronze", d:"Glass fogged at the mouth. Someone has been kissing a photograph.", x:2.75, z:3.45},
  {id:"wire", room:"steps", t:"Wreath wire", d:"Kept from a Taylor Day they would not leave. They wear it like a relic.", x:-1.75, z:4.15},
  {id:"chair", room:"caucus", t:"The empty chair", d:"They will not sit it. The remnant says it is occupied.", x:-3.35, z:8.45}
];
function consularLoreEnsure(){
  if(!G.consularLore) G.consularLore = {tales:[], found:{}, smashed:{}, idols:0};
  return G.consularLore;
}
function consularInvent(){
  const L = consularLoreEnsure();
  if(L.tales.length >= 12) return null;
  const left = REMNANT_TALES.filter(t => L.tales.indexOf(t) < 0);
  if(!left.length) return null;
  const tale = pick(left);
  L.tales.push(tale);
  return tale;
}
function horcruxOf(room){
  return CONSULAR_HORCRUXES.find(h => h.room === (room || G.room)) || null;
}
function horcruxProps(){
  const h = horcruxOf(G.room);
  if(!h) return [];
  const L = consularLoreEnsure();
  if(L.smashed[h.id]) return [];
  const found = !!L.found[h.id];
  return [{id:"horcrux-"+h.id, label:h.t, sub: found ? "A Consular remainder. An idol." : "Something the remnant hid.", x:h.x, z:h.z, r:1.55,
    acts:() => [
      {t: found ? "Look again" : "Find what they hid", c:"6m", run(){
        spend(6, 2);
        L.found[h.id] = true;
        const tale = consularInvent() || pick(REMNANT_TALES);
        note("Found a Consular remainder: " + h.t.toLowerCase() + ".", true);
        feed("You found " + h.t.toLowerCase() + " — the remnant's idol.");
        const rite = consularHere();
        rite.slice(0,2).forEach(m => { m.say = pick(CONSULAR_LITURGY); m.sayT = 4; m.wait = 12; });
        setSay(h.d + " The remnant tells " + tale + ".", fx("an Easter egg of an idol","6 minutes"));
      }},
      {t:"Venerate it", c:"12m", run(){
        spend(12, 4);
        L.found[h.id] = true;
        L.idols = (L.idols || 0) + 1;
        try{ commitHeresy("you", "Venerated a Consular remainder — " + h.t); }catch(e){}
        setSay("You treat it as they treat it. The remnant makes room. God is the Most High. The House will not forget the knee.",
          fx("heresy · an idol","12 minutes"));
      }},
      {t:"Smash the idol", c:"8m", run(){
        spend(8, 5);
        L.smashed[h.id] = true;
        try{ achieve("smash"); }catch(e){}
        L.found[h.id] = true;
        (G.members||[]).forEach(m => {
          if(!m || m.gone) return;
          if(isConsular(m) && m.rel) m.rel.warmth = clamp((m.rel.warmth||0) - 16, -100, 100);
          if(m.creed === "latin" && !isConsular(m) && m.rel) m.rel.warmth = clamp((m.rel.warmth||0) + 5, -100, 100);
        });
        feed("You smashed a Consular remainder. The remnant will not forgive it. The chaplain will.");
        setSay("It is an idol. You put it down. God is the Most High. Not a flake, not a chair, not a man.",
          fx("the Catholics heard you","8 minutes"));
      }}
    ]}];
}
function defaultPartyMap(){
  return {
    FED:{id:"FED", name:"Federalist Union", short:"Federalist", color:"#A45F27", colorDark:"#D48F4B", born:1791, core:true},
    COM:{id:"COM", name:"Commonwealth Party", short:"Commonwealth", color:"#1C5F66", colorDark:"#4FAFB6", born:1804, core:true},
    IND:{id:"IND", name:"Independents", short:"Independent", color:"#5B6670", colorDark:"#8A949E", born:0, core:true}
  };
}
let _ensuringParties = false;
function ensureParties(){
  if(!G.parties || typeof G.parties !== "object") G.parties = defaultPartyMap();
  for(const k of ["FED","COM","IND"]){
    if(!G.parties[k]) G.parties[k] = defaultPartyMap()[k];
    if(!G.parties[k].color) G.parties[k].color = defaultPartyMap()[k].color;
  }
  /* Guard against infinite recursion: unusedPartyColor() calls ensureParties()
     to see which colours are taken, but assigning G.parties.OWN a colour by
     calling unusedPartyColor() from inside this same function used to
     re-enter here while G.parties.OWN was still unset — every re-entry took
     the same "no OWN yet, need a colour" branch and called unusedPartyColor()
     again, forever. FED/COM/IND are already guaranteed above, which is all a
     nested call needs, so skip the OWN block on re-entry. */
  if(G.own && !_ensuringParties){
    _ensuringParties = true;
    try{
      const nm = G.own.name || "Your party";
      if(!G.parties.OWN){
        G.parties.OWN = {
          id:"OWN", name:nm, short:partyShortOf(nm),
          color:G.own.color || unusedPartyColor(), colorDark:G.own.colorDark || null,
          born:G.own.born || G.congress || 1, core:false
        };
      } else {
        G.parties.OWN.name = nm;
        if(G.own.color) G.parties.OWN.color = G.own.color;
      }
      if(G.seatsBy && G.seatsBy.OWN === undefined) G.seatsBy.OWN = G.seatsBy.OWN || 0;
    } finally { _ensuringParties = false; }
  }
  return G.parties;
}
function unusedPartyColor(){
  ensureParties();
  const used = new Set(Object.values(G.parties).map(p => (p.color || "").toLowerCase()));
  for(const c of PARTY_PALETTE) if(!used.has(c.toLowerCase())) return c;
  return PARTY_PALETTE[(Object.keys(G.parties).length) % PARTY_PALETTE.length];
}
function registerParty(spec){
  ensureParties();
  const id = spec.id || ("P" + (Object.keys(G.parties).length + 1));
  const color = spec.color || unusedPartyColor();
  const name = (spec.name || "New party").slice(0, 42);
  G.parties[id] = {
    id, name, short:(spec.short || name.split(/\s+/)[0] || "Party").slice(0, 18),
    color, colorDark:spec.colorDark || null,
    born:spec.born != null ? spec.born : (G.congress || 1),
    core:!!spec.core, creed:spec.creed || null
  };
  if(!G.seatsBy) G.seatsBy = {FED:0,COM:0,IND:0};
  if(G.seatsBy[id] === undefined) G.seatsBy[id] = 0;
  if(!G.parties[id].core) writeWorldParties();
  return G.parties[id];
}
const WORLD_PARTIES_KEY = "tls-world-parties";
function readWorldParties(){
  try{
    const raw = localStorage.getItem(WORLD_PARTIES_KEY);
    if(!raw) return {};
    const d = JSON.parse(raw);
    return d && typeof d === "object" ? d : {};
  }catch(e){ return {}; }
}
function writeWorldParties(){
  try{
    ensureParties();
    const out = {};
    for(const k of Object.keys(G.parties || {})){
      if(k === "FED" || k === "COM" || k === "IND") continue;
      out[k] = G.parties[k];
    }
    const prev = readWorldParties();
    localStorage.setItem(WORLD_PARTIES_KEY, JSON.stringify(Object.assign({}, prev, out)));
  }catch(e){}
}
function mergeWorldParties(){
  ensureParties();
  const world = readWorldParties();
  for(const k in world){
    if(!G.parties[k] && world[k] && world[k].name){
      G.parties[k] = world[k];
      if(G.seatsBy && G.seatsBy[k] === undefined) G.seatsBy[k] = 0;
    }
  }
}
function partyKeys(){
  ensureParties();
  const core = ["FED","COM","IND"].filter(k => G.parties[k]);
  const extra = Object.keys(G.parties).filter(k => core.indexOf(k) < 0).sort();
  return core.concat(extra);
}
function partyRec(p){
  if(p === "FO" || p === FIRST_ORDER.id) return FIRST_ORDER;
  ensureParties();
  if(G.parties[p]) return G.parties[p];
  if(p === "OWN" && G.own) return registerParty({id:"OWN", name:G.own.name, color:G.own.color});
  return G.parties.IND;
}
function partyName(p){
  const r = partyRec(p);
  if(p === "IND") return "independents";
  return r.name;
}
function partyLabel(p){
  return partyRec(p).short || partyRec(p).name;
}
function partyColorHex(p){
  return partyRec(p).color || "#5B6670";
}
function partyColorNum(p){
  const h = partyColorHex(p).replace("#","");
  return parseInt(h.length === 3 ? h.split("").map(c=>c+c).join("") : h, 16);
}
function partyChipTone(p){
  if(p === "FED") return "fed";
  if(p === "COM") return "com";
  if(p === "IND") return "ind";
  return "dyn";
}
function partyChipHTML(p, label){
  const tone = partyChipTone(p);
  const lab = label != null ? label : partyLabel(p);
  if(tone === "dyn")
    return '<span class="chip chip--dyn" style="--pc:' + partyColorHex(p) + '">' + lab + '</span>';
  return '<span class="chip chip--' + tone + '">' + lab + '</span>';
}
function partyLegendHTML(){
  ensureParties();
  return partyKeys().map(k => {
    const r = G.parties[k];
    const extra = k === "IND" ? ", press and public" : "";
    return '<span><i class="dot" style="background:' + r.color + '"></i>' + r.name + extra + '</span>';
  }).join("");
}

/* Civil calendar: year loops on 365; leap days ignored. Day-of-year 188 = 7/7 (Taylor Day). */
function dayOfYear(day){
  const d = (day == null ? G.day : day);
  return ((d - 1) % 365) + 1;
}
function civilDate(dayNum){
  const months = [31,28,31,30,31,30,31,31,30,31,30,31];
  let n = ((Math.max(1, dayNum|0) - 1) % 365) + 1;
  for(let m = 1; m <= 12; m++){
    if(n <= months[m-1]) return {month:m, day:n, label:m + "/" + n};
    n -= months[m-1];
  }
  return {month:12, day:31, label:"12/31"};
}
function isTaylorDay(dayNum){
  const c = civilDate(dayNum == null ? dayOfYear() : dayNum);
  return c.month === (FIRST_CONSUL.bornMonth || 7) && c.day === (FIRST_CONSUL.bornDay || 7);
}
function dayType(){
  if(isTaylorDay()) return "holiday"; /* national holiday wins even on weekends */
  if(G.recessLeft > 0) return "recess";
  const w = (G.day-1) % 7;
  if(w === 4) return "district";
  if(w >= 5) return "weekend";
  return "session";
}
function dayLabel(){
  const t = dayType();
  if(t === "holiday") return (FIRST_CONSUL.holiday || "Taylor Day") + " · " + (FIRST_CONSUL.born || "7/7");
  return t==="session"?"Session day" : t==="district"?"District day" : t==="weekend"?"Weekend" : "Recess";
}
function dateString(){
  const wd = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"][(G.day-1)%7];
  const c = civilDate(dayOfYear());
  return wd + " · " + c.label + " · day " + G.day; /* e.g. Mon · 7/7 · day 188 on Taylor Day */
}
function scheduleDay(){
  const t = dayType();
  everyone().forEach(m => {
    rollNoise(m);
    if(m.kind === "member") m.intent = chooseIntent(m);
    routeForDay(m,t);
  });
  lastBlock = -1;
  makeEvents();
  if(t === "session" && (!G.bill || G.bill.done)) G.bill = nextBillOrQueued();
}
function scheduleDayStaged(done){
  /* Diary only — no meshes. 4 people per paint so Edge can breathe. */
  const t = dayType();
  let list = [];
  try{ list = everyone(); }catch(e){ list = []; }
  let at = 0;
  const step = () => {
    try{
      const stop = Math.min(list.length, at + 4);
      for(; at < stop; at++){
        const m = list[at];
        if(!m) continue;
        rollNoise(m);
        if(m.kind === "member") m.intent = chooseIntent(m);
        routeForDay(m, t);
      }
    }catch(e){ if(window.console) console.warn("scheduleDay staged", e); }
    if(at < list.length){ yieldPaint(step); return; }
    lastBlock = -1;
    yieldPaint(() => {
      try{ makeEvents(); }catch(e){}
      try{
        if(t === "session" && (!G.bill || G.bill.done)) G.bill = nextBillOrQueued();
      }catch(e){}
      if(done) done();
    });
  };
  yieldPaint(step);
}
/* ── the shape of a working day ─────────────────────────────
   Members are not scattered at random: they do mail in the morning,
   sit in committee, take the floor for votes, eat in the cloakroom,
   and drift toward the cameras or the door depending on who they are. */
/* 20261013v: other states' governors, counterparts, envoys and party leaders are civilians in the data, so the
   routine sent every one of them to your district (or the East Steps). They live elsewhere and stay there. */
function livesElsewhere(m){
  return !!(m && m.kind === "civ" && (m.abroad === true || /^(gov|cp|lead|env|former):/.test(String(m.scKey || ""))));
}
function sweepAbroad(){
  try{ (G.civ || []).forEach(m => { if(livesElsewhere(m) && m.room !== "abroad" && !m._visitDay){ m.room = "abroad"; m.abroad = true; } }); _allCache = null; }catch(e){}
}
function routineRoom(m, hour, t){
  if(livesElsewhere(m)) return "abroad";
  if(isConsular(m)){
    if(typeof isTaylorDay === "function" && isTaylorDay()) return chance(.72) ? "corridor" : "cloak";
    if(hour === 7 || hour === 12 || hour === 18) return chance(.78) ? "corridor" : "cloak";
  }
  if(m.kind === "civ" && m.chamber && ROOMS[m.chamber]){
    /* their day is their own: in at eight, lunch away from the desk, home after six */
    if(hour < 8 || hour >= 18) return "away"; if(hour === 12 || hour === 13) return chance(.6) ? (chance(.5) ? "corridor" : "district") : m.chamber; return m.chamber; }
  if(m.kind === "civ" && m.hh) return m.room || "away";
  if(m.kind === "civ") return (t === "session") ? "steps" : "district";
  if(m.kind === "press"){
    if(hour < 10) return chance(.5) ? "corridor" : "press";
    if(hour < 13) return chance(.65) ? "press" : "corridor";
    if(hour < 17) return pick(["press","corridor","cloak","steps"]);
    return "press";
  }
  /* "away" = in their own suite or their own district: not in any room you
     can walk into, but still reachable by calling on them or writing. */
  if(t === "holiday") return chance(.55) ? "corridor" : (chance(.5) ? "steps" : "district");
  if(t !== "session") return chance(.78) ? "district" : "away";
  const h = hour + (m.punctual - 0.5);          /* some run early, some late */
  if(h < 9.2)  return chance(.68) ? "away" : "corridor";
  if(h < 11.0) return m.post ? (chance(.6)?"caucus":"corridor")
                             : (chance(.55) ? "committee" : "corridor");
  if(h < 12.6) return chance(.6) ? "floor" : "corridor";
  if(h < 14.0) return chance(.62) ? "cloak" : (chance(.5) ? "corridor" : "away");
  if(h < 17.0) return chance(.6) ? "floor" : (chance(.55) ? "committee" : "cloak");
  if(h < 19.2) return (m.traits.vanity > 62 && chance(.35)) ? "press"
                    : chance(.5) ? "corridor" : "cloak";
  return chance(.45) ? "cloak" : chance(.5) ? "away" : "steps";
}
let lastBlock = -1;
function restaff(force){
  if(PROC.on && !force) return;
  if(G.pendingNight || G.moving) return;
  const h = Math.floor(G.minute/60);
  if(h >= 21) return;
  if(!force && h === lastBlock) return;
  lastBlock = h;
  if(!force && houseQuiet()) return;
  const t = dayType();
  let movedAny = false;
  sweepAbroad();
  everyone().forEach(m => {
    if(TALK.m === m || visiting() === m) return;
    if(m.kind === "envoy") return;
    if(livesElsewhere(m)) return;
    if(m.ohK) return;
    if(m.away) return;
    try{ if(PROC.on && m.room === G.room) return; }catch(e){}
    try{
      sentEnsure(m);
      if(m.sent && ((m.sent.busyUntil||0) > (G.t||0))) return;
      if(m.sent && (m.sent.topic === "alone" || m.sent.topic === "meal") && chance(.7)) return;
      if(m.sent && m.sent.hunger > 0.78 && chance(.55)) return;
      if(m.will && m.will.k === "leave" && chance(.4)) return;
    }catch(e){}
    if(!force && chance(.42)) return;           /* people linger; they do not all move at once */
    const want = routineRoom(m, h, t);
    if(want !== m.room){ m.room = want; moved(); placeInRoom(m); movedAny = true; }
  });
  try{ ensureLivedIn(); }catch(e){}
  const missing = hereNow().some(m => !m.mesh);
  if(movedAny || missing) markRenderDirty();
  try{ ambientHourBeat(h, t); }catch(e){}
  try{ if(!houseQuiet() && !inHall()) consularBody(h); }catch(e){}
}
function ensureLivedIn(){
  /* Empty rooms feel dead. Pull a living crowd into wherever you are. */
  if(!G.room || G.room === "visit" || !G.you) return;
  try{ ensureChaplain(); }catch(e){}
  try{ ensureMachineSeat(); }catch(e){}
  try{ ensureConsularCaucus(); }catch(e){}
  try{
    (G.states||[]).forEach(s => {
      if(s && !s.creed){
        const d = STATE_DEF.find(x => x.n === s.n);
        s.creed = (d && d.creed) || "latin";
      }
    });
  }catch(e){}
  const want = ({office:2, corridor:4, floor:5, cloak:3, caucus:4, committee:3, press:2, steps:2, district:2, staff:1, senate:6, court:4, exec:4, govoffice:4})[G.room] || 2;
  const here = everyone().filter(m => m && m.room === G.room && !m.gone && !m.away);
  if(here.length >= want) return;
  const pool = everyone().filter(m => m && !m.gone && !m.away && !m.ohK && !livesElsewhere(m) && !/^(Governor|Premier|President|Chancellor) of /i.test(String(m.role || "")) && m.room !== G.room && TALK.m !== m && visiting() !== m);
  for(let i = pool.length - 1; i > 0; i--){
    const j = (Math.random() * (i + 1)) | 0;
    const t = pool[i]; pool[i] = pool[j]; pool[j] = t;
  }
  let need = want - here.length;
  for(let i = 0; i < pool.length && need > 0; i++){
    const m = pool[i];
    try{
      sentEnsure(m);
      if(m.sent && ((m.sent.busyUntil||0) > (G.t||0))) continue;
      if(m.sent && (m.sent.topic === "alone" || m.sent.topic === "meal" || m.sent.topic === "home") && chance(.75)) continue;
    }catch(e){}
    m.room = G.room;
    placeInRoom(m);
    m.wait = 0.4 + Math.random() * 2.2;
    m.say = m.say || pick([
      "Morning.",
      "Got a minute?",
      "They are already counting votes.",
      "Have you seen the whip?",
      "This building never sleeps, it just changes shoes."
    ]);
    m.sayT = 2.4 + Math.random();
    m.sayTo = "you";
    need--;
  }
  moved();
}
function sustainHouse(){
  /* A career that never ends still has to fit in memory. Trim the ledgers. */
  try{
    if((G.journal||[]).length > 48) G.journal.length = 48;
    if((G.mail||[]).length > 20) G.mail.length = 20;
    if((G.feed||[]).length > 8) G.feed.length = 8;
    if(G.vox && G.vox.posts && G.vox.posts.length > 36) G.vox.posts.length = 36;
    if((G.secrets||[]).length > 16) G.secrets.length = 16;
    if((G.events||[]).length > 20) G.events.length = 20;
    if((G.career||[]).length > 40) G.career = G.career.slice(-40);
    if((G.history||[]).length > 56){
      const myth = G.history.filter(h => h && h.myth);
      const rest = G.history.filter(h => h && !h.myth).slice(-40);
      G.history = myth.concat(rest);
    }
    everyone().forEach(m => {
      if(m.mem && m.mem.length > 60) psyPrune(m);
      if(m.chat && m.chat.length > 6) m.chat = m.chat.slice(-6);
      if(m.heard && m.heard.length > 8) m.heard.length = 8;
      if(m && m.machine){ m.gone = false; m.away = null; }
    });
    try{ ensureMachineSeat(); }catch(e){}
    const live = (G.members || []).filter(m => m && !m.gone);
    const n = Math.min(live.length, MODEST ? 4 : 8);
    for(let i=0;i<n;i++){
      const m = live[(Math.random() * live.length) | 0];
      try{ netRuminate(m); }catch(e){}
    }
  }catch(e){}
}
function routeForDay(m,t){
  m.room = routineRoom(m, 8, t);
  placeInRoom(m);
}

/* ── what they are actually trying to do this week ────────── */
function chooseIntent(m){
  const b = G.bill, o = [];
  if(m.traits.ambition > 60) o.push({k:"post", t:"get a gavel before the next Congress"});
  if(memValence(m) < -20)    o.push({k:"avoid", t:"stay well clear of you"});
  if(b && alignment(m,b) < -28) o.push({k:"kill", t:"kill the " + b.title.split(" ")[0] + " bill"});
  if(b && alignment(m,b) >  28) o.push({k:"pass", t:"get the " + b.title.split(" ")[0] + " bill through"});
  if(m.margin < 9)           o.push({k:"seat", t:"survive a district that could go either way"});
  if(m.traits.vanity > 66)   o.push({k:"press", t:"be on television before Thursday"});
  if(m.rel.debtFromYou > 0)  o.push({k:"repay", t:"settle up with you and be free of it"});
  if(m.traits.loyalty > 72)  o.push({k:"line", t:"hold the caucus together"});
  const r = byId(m.rival);
  if(r) o.push({k:"rival", t:"get one over on " + surname(r.name)});
  o.push({k:"day", t:"get through the day without becoming a story"});
  return pick(o);
}
/* Can you read them? Only if you know them. */
function canRead(m){ return m.rel.trust > 44 || (m.met && Math.abs(m.rel.warmth) > 38); }
function thoughtOf(m){
  try{ sentEnsure(m); }catch(e){}
  if(m.sent && m.sent.now){
    const bits = [m.sent.now];
    if(canRead(m) && m.sent.i) bits.push(m.sent.i);
    if(m.intent) bits.push("What I still want is to " + m.intent.t + ".");
    return bits.join(" ");
  }
  const mood = moodOf(m), t = topMemory(m), b = G.bill;
  const out = [];
  out.push(pick([
    "What I want this week is to " + m.intent.t + ".",
    cap(m.intent.t) + " — that is the whole of it, really.",
    "Everything else is noise. I need to " + m.intent.t + "."
  ]));
  if(m.dayEvent) out.push(m.dayEvent.t.replace(/^Their/,"My").replace(/^They/,"I"));
  if(t){
    const w = memWeight(m,t);
    out.push(w < 0 ? "And I have not let this go: " + t.t : "Say what you like about them: " + t.t);
  } else if(b && !b.done){
    out.push("On the " + b.title.split(" ")[0] + " bill I am " +
      (memberVote(m,b) > 0 ? "an aye, unless someone gives me a reason." : "a no, and comfortable about it."));
  }
  if(mood.val < -40) out.push("I am in no mood for company.");
  else if(mood.val > 45) out.push("Good day. Rare enough.");
  return out.slice(0,3).join(" ");
}
/* Who is in the room with you, recomputed at most once a frame — and
   immediately again the moment anybody actually changes room, because a
   list that outlives a move puts people in the wrong room or nowhere. */
function moved(){ FRAME_ID++; }
let _hereCache = null, _hereKey = "";
function hereNow(){
  const key = FRAME_ID + "|" + G.room + "|" + G.visitId;
  if(_hereCache && _hereKey === key) return _hereCache;
  _hereKey = key;
  if(G.room === "visit"){ const m = byId(G.visitId); _hereCache = m && !m.gone ? [m] : []; }
  else _hereCache = everyone().filter(m => m.room === G.room && !m.gone && !m.away);
  return _hereCache;
}
function visiting(){ return G.room === "visit" ? byId(G.visitId) : null; }
function presentWith(m){ return m && (m.room === G.room || visiting() === m); }
function roomBox(id){
  const r = ROOMS[id] || ROOMS.office;
  if(id === "steps") return {hw:r.w/2 - 0.55, d0:0.52, d1:r.d - 0.48};
  return {hw:r.w/2 - 0.8, d0:0.9, d1:r.d - 0.9};
}
function stepsGround(z){
  const run = 0.58, treads = 10, deckY = 1.62;
  const z0 = 5.05 - run * 0.5;
  if(z <= z0) return 0;
  const t = (z - z0) / run;
  if(t >= treads) return deckY;
  return (Math.floor(t) + 1) * (deckY / treads);
}
function groundAt(z, room){
  return ((room || G.room) === "steps") ? stepsGround(z) : 0;
}
/* Stand somewhere in the room that is not inside a doorway. */
/* Run fn on the next animation frame, or on a timer if frames are not
   coming — whichever happens first, and only ever once.

   requestAnimationFrame is suspended outright while a tab is hidden or
   the window is in the background. Boot and room-transition work was
   deferred purely into rAF callbacks, so losing foreground at the wrong
   moment meant those callbacks never ran: the room never finished
   building, G._booting stayed true, and because cardActContinue() early
   returns while _booting is set, Continue could not even be retried.
   That is the frozen career, and the frozen room transition — the tab
   was not busy, it was waiting for a frame that was never going to come.

   setTimeout keeps firing in a background tab (throttled to about a
   second, which is fine for work that is already off the click path),
   so it is the fallback that guarantees forward progress. */
function nextFrameOrTimeout(fn, ms){
  let ran = false;
  const once = () => { if(ran) return; ran = true; try{ fn(); }catch(e){ if(window.console) console.warn("nextFrameOrTimeout", e); } };
  try{ requestAnimationFrame(once); }catch(e){}
  setTimeout(once, ms === undefined ? 250 : ms);
}
function yieldMain(fn){
  /* Edge hung-renderer fires ~8s. Never stack work on 0-timeouts in one burst —
     16ms lets the compositor paint Sleep/Continue cards. */
  setTimeout(() => { try{ fn(); }catch(e){ if(window.console) console.warn("yieldMain", e); } }, 16);
}
function yieldPaint(fn){
  let ran = false;
  const once = () => { if(ran) return; ran = true; try{ fn(); }catch(e){ if(window.console) console.warn("yieldPaint", e); } };
  try{ requestAnimationFrame(() => setTimeout(once, 0)); }catch(e){}
  setTimeout(once, 48);
}
function framePaidMs(){
  /* Wall clock since frameBody opened. Cheap; used by warm/drain/sync bails. */
  try{
    if(G && G._frameT0) return performance.now() - G._frameT0;
  }catch(e){}
  return 0;
}
function frameOverBudget(lim){
  /* 20261001a: 6ms guard — bail before another room/people unit if the frame already paid. */
  lim = (lim == null) ? 6 : lim;
  try{
    if((G._frameSpent || 0) > lim) return true;
    if(framePaidMs() > lim) return true;
  }catch(e){}
  return false;
}
function playerMoving(){
  try{
    if(cam && Math.hypot(cam.vx || 0, cam.vz || 0) > 0.12) return true;
    if(cam && (cam.speed || 0) > 0.12) return true;
  }catch(e){}
  return false;
}
function disposePersonMesh(mesh){
  /* Remesh over minutes leaked GPU memory on Edge — dispose old geo/mats. */
  if(!mesh) return;
  try{ if(mesh.parent) mesh.parent.remove(mesh); }catch(e){}
  try{
    mesh.traverse(o => {
      try{
        if(o.geometry && o.geometry.dispose && !o.geometry._shared){
          o.geometry.dispose();
        }
      }catch(e){}
      try{
        const mats = o.material ? (Array.isArray(o.material) ? o.material : [o.material]) : [];
        for(let i=0;i<mats.length;i++){
          const m = mats[i];
          if(!m || m._shared) continue;
          try{
            if(m.map && m.map.dispose && !m.map._plaque && !m.map._atlas && !m.map._shared) m.map.dispose();
          }catch(e){}
          try{
            if(m.normalMap && m.normalMap.dispose && !m.normalMap._shared) m.normalMap.dispose();
          }catch(e){}
          try{ m.dispose(); }catch(e){}
        }
      }catch(e){}
    });
  }catch(e){}
}
function houseQuiet(){
  /* Hard quiet only: card / night / door-fade. Feet no longer pause the House
     (20260921f) — remesh and AI drip while walking so stop never flushes. */
  try{
    if(G.pendingNight) return true;
    if(G.moving) return true; /* door fade / room cut */
    if(typeof veil !== "undefined" && veil && !veil.hidden) return true; /* card */
    try{
      const fd = typeof el === "function" ? el("fade") : null;
      if(fd && parseFloat(fd.style.opacity || "0") > 0.05) return true;
    }catch(e){}
  }catch(e){}
  return false;
}
function inHall(){ return !!(G && G.room === "corridor"); }
function walkNow(){
  /* Feet first. Crowd / panels / save wait. */
  try{
    const now = performance.now();
    G._crowdPauseUntil = now + 400;
    G._deferPeopleUntil = now + 280;
    G._bootGraceUntil = now + 700;
    G.doorGrace = (G.t || 0) + 1.2;
    lastBlock = Math.floor((G.minute || 0) / 60);
  }catch(e){}
  try{ document.body.classList.remove("boot-menu"); }catch(e){}
  try{ if(typeof veil !== "undefined" && veil) veil.hidden = true; }catch(e){}
  try{ G.pendingNight = false; }catch(e){}
  try{ G.running = true; }catch(e){}
  try{ forceUnstickMove(); }catch(e){}
}
function laterHouse(fn){
  yieldPaint(() => { try{ fn(); }catch(e){} });
}
function safeSpawn(id){
  const b = roomBox(id), R = ROOMS[id] || ROOMS.office;
  const cands = [{x:0, z:Math.min(R.d*0.45, b.d0+2.8)}, {x:0, z:R.d*0.5},
                 {x:b.hw*0.45, z:R.d*0.45}, {x:-b.hw*0.45, z:R.d*0.45}, {x:0, z:b.d1-1.5}];
  for(const c of cands){
    const cx = clamp(c.x, -b.hw, b.hw), cz = clamp(c.z, b.d0, b.d1);
    const clear = (DOORS[id] || []).every(dr => {
      const p = doorAt(id, dr);
      return Math.hypot(p.x-cx, p.z-cz) > 2.2;
    });
    if(clear) return {x:cx, z:cz};
  }
  return {x:0, z:clamp(R.d*0.5, b.d0, b.d1)};
}
function roomLabel(m){
  if(m.room === "away") return m.kind === "civ" ? "at home" : (m.suite || "their office");
  return ROOMS[m.room] ? ROOMS[m.room].t : "elsewhere";
}
function placeInRoom(m){
  if(!ROOMS[m.room]) return;              /* "away" has no floor to stand on */
  const b = roomBox(m.room);
  const doors = DOORS[m.room] || [];
  for(let n=0;n<10;n++){
    m.x = (Math.random()*2-1)*b.hw; m.z = b.d0 + Math.random()*(b.d1-b.d0);
    let blocked = false;
    for(let i=0;i<doors.length;i++){
      const p = doorAt(m.room, doors[i]);
      if(Math.hypot(p.x-m.x, p.z-m.z) < 2.3){ blocked = true; break; }
    }
    if(!blocked) break;
  }
  if(m.room === "steps"){
    m.z = 2.3 + Math.random() * 2.2;
    m.x = (Math.random() * 2 - 1) * b.hw * 0.62;
  }
  if(m.room === "district"){
    const side = Math.random() < 0.5 ? -1 : 1;
    m.x = side * (3.5 + Math.random() * 2.0);
    m.z = 2.4 + Math.random() * 9.5;
  }
  if(m.kind === "civ"){ try{ mPlaceStand(m); }catch(e){} }
  m.tx = m.x; m.tz = m.z;
}

/* ══════════════════════════════════════════════════════════
   8 · RENDERER — three.js
   ══════════════════════════════════════════════════════════ */
const sceneEl = el("scene");
/* preserveDrawingBuffer keeps the last frame readable, so link previews and
   thumbnails of this page show the room rather than a black rectangle. */
const renderer = new THREE.WebGLRenderer({
  antialias: !MODEST,
  preserveDrawingBuffer: false,
  powerPreference: MODEST ? "low-power" : "high-performance",
  failIfMajorPerformanceCaveat: false
});
renderer.setPixelRatio(Math.min(devicePixelRatio || 1, MODEST ? 0.58 : 0.92));
/* 20261011d: autoReset must stay on. render.frame only advances on reset, and
   three gates SkinnedMesh skeleton.update() on it — with it off every skin
   froze where its person was first drawn (bodies left behind, suits in pieces). */
try{ renderer.info.autoReset = true; }catch(e){}
renderer.outputEncoding = THREE.sRGBEncoding;
try{ renderer.physicallyCorrectLights = false; }catch(e){}
try{ if(renderer.shadowMap) renderer.shadowMap.autoUpdate = false; }catch(e){}
try{
  const gl = renderer.getContext();
  const ext = gl && gl.getExtension && gl.getExtension("WEBGL_debug_renderer_info");
  const gpu = ext ? (gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) || "") : "";
