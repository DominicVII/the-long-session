/* ══ 20261020a · what people hear, they half-remember: decaying, distorting NPC memory ══ */
const MM_IMP = /\b(vote|bill|act|money|fund|budget|secret|between us|god|christ|church|family|wife|husband|son|daughter|war|strike|election|governor|president|senat|court|resign|scandal|bribe|promise|threat|secede|secession)\w*/i;
const MM_EMO = /\b(hate|love|idiot|fool|liar|traitor|proud|afraid|furious|thank|sorry|never|disgrace|shame|wonderful|angry|worried)\w*/i;
function mmStore(){ G.mm = G.mm || {v:1, by:{}, day:G.day || 0};
  /* housekeeping, once: a remembered line is a line, not a whole reply; long ones are cut at a sentence so the save stays small */
  if(!G.mm.t2){ G.mm.t2 = 1; try{ Object.keys(G.mm.by).forEach(k => (G.mm.by[k] || []).forEach(x => { if(x){ x.text = mmClip(x.text, 320); x.orig = mmClip(x.orig, 200); } })); }catch(e){} }
  return G.mm; }
function mmClip(t, n){ t = String(t == null ? "" : t).replace(/\s+/g, " ").trim(); if(t.length <= n) return t; const c = t.slice(0, n), i = Math.max(c.lastIndexOf(". "), c.lastIndexOf("? "), c.lastIndexOf("! ")); return i > n * 0.5 ? c.slice(0, i + 1) : c.replace(/\s+\S*$/, "") + "\u2026"; }
function mmAbout(text){
  try{ const it = (dkItems() || []).find(i => text.indexOf(i.title) >= 0); if(it) return it.title; }catch(e){}
  const caps = text.match(/\b([A-Z][a-z]+(?:\s[A-Z][a-z]+){0,3})\b/g); if(caps){ const c = caps.find(x => !/^(I|The|A|An|You|We|He|She|It|This|That|Did|Heads|Before|Precedent|Remember|On)$/.test(x)); if(c) return c; }
  const k = text.match(MM_IMP); return k ? k[0].toLowerCase() : text.split(/\s+/).slice(0, 4).join(" ");
}
function mmPerson(id){ try{ return byId(isNaN(+id) ? id : +id); }catch(e){ return null; } }
function mmGoalsOf(id){ try{ const m = window.ONUM_MINDS && window.ONUM_MINDS[id]; return m && m.goals ? [].concat(m.goals).join(" ").toLowerCase() : ""; }catch(e){ return ""; } }
function mmStrength(id, text, role){
  const p = mmPerson(id), T = (p && p.traits) || {};
  let s = role === "speaker" ? 0.55 : role === "addressee" ? 0.5 : 0.3;
  if(MM_IMP.test(text)) s += 0.15;
  if(MM_EMO.test(text)) s += 0.15;
  const g = mmGoalsOf(id); if(g && text.toLowerCase().split(/\W+/).some(w => w.length > 4 && g.indexOf(w) >= 0)) s += 0.15;
  s += ((T.discretion | 0) - 50) / 400 + ((T.ambition | 0) - 50) / 600;
  return clamp(s + (Math.random() - 0.5) * 0.1, 0.05, 0.98);
}
function mmAdd(id, text, about, role, src){
  if(id == null || id === "you") return;
  const S = mmStore(), L = S.by[id] = S.by[id] || [];
  const same = L.find(x => x.about === about && Math.abs((x.day || 0) - (G.day || 0)) < 30);
  if(same){ same.reps++; same.s = clamp(same.s + 0.2, 0, 1); same.day = G.day; if(same.reps >= 3) same.cons = true; if(role === "speaker") same.text = mmClip(text, 320); return same; }
  text = mmClip(text, 320); const m = {text, orig:mmClip(text, 200), about, day:G.day || 0, s:mmStrength(id, text, role), reps:1, cons:false, src:src || role, distorted:false};
  L.push(m); if(L.length > 60){ L.sort((a, b) => b.s - a.s); L.length = 50; }
  return m;
}
function mmHear(T, who, whoId, to, text){
  const about = mmAbout(text);
  if(whoId !== "you") mmAdd(whoId, text, about, "speaker");
  if(to != null && to !== "you") mmAdd(to, (who === "You" ? "You said: " : who + " said: ") + text, about, "addressee");
  try{ const sp = mmPerson(whoId); const room = T.room;
    everyone().filter(m => m && m.room === room && !m.gone && m.id !== whoId && m.id !== to && (!sp || sp.x == null || m.x == null || Math.hypot(m.x - sp.x, m.z - sp.z) < 5)).slice(0, 6)
      .forEach(m => mmAdd(m.id, "Overheard " + (who === "You" ? "you" : who) + ": " + text, about, "listener")); }catch(e){}
}
function mmAct(id, about){ const L = (mmStore().by[id] || []); const m = L.find(x => x.about === about); if(m){ m.reps += 1; m.s = clamp(m.s + 0.25, 0, 1); m.cons = m.reps >= 2 || m.cons; } }
function mmGarble(text){
  let t = text;
  const r = Math.random();
  if(/\d/.test(t) && r < 0.4) t = t.replace(/\d+/, d => String(Math.max(1, Math.round(+d * (0.5 + Math.random())))));
  else if(r < 0.65) t = t.replace(/\b(not|never|no)\b\s?/i, "") ;
  else if(r < 0.85){ try{ const names = everyone().filter(m => m.name).map(m => m.name); const n = t.match(/\b[A-Z][a-z]+ [A-Z][a-z]+\b/); if(n && names.length) t = t.replace(n[0], pick(names)); else t = "something about " + mmAbout(t); }catch(e){ t = "something about " + mmAbout(t); } }
  else t = "something about " + mmAbout(t);
  return t;
}
function mmDay(){
  const S = mmStore(), d = G.day || 0, dt = Math.max(0, d - (S.day || 0)); if(!dt) return; S.day = d;
  Object.keys(S.by).forEach(id => { const p = mmPerson(id), T = (p && p.traits) || {};
    const half = 4 + ((T.discretion | 0) / 25);
    S.by[id] = S.by[id].filter(m => { const h = m.cons ? half * 6 : half; m.s *= Math.pow(0.5, dt / h);
      if(!m.distorted && m.s < 0.4 && Math.random() < 0.25 * dt){ m.text = mmGarble(m.text); m.distorted = m.text !== m.orig; }
      return m.s > 0.03; }); });
  /* gossip: someone passes a memory on, maybe bent */
  try{ const ids = Object.keys(S.by).filter(i => S.by[i].length); for(let k = 0; k < Math.min(4, ids.length); k++){ const a = pick(ids), m = pick(S.by[a]); if(!m || m.s < 0.2) continue;
      const p = mmPerson(a); if(!p) continue; const peers = everyone().filter(o => o && o !== p && !o.gone && o.room === p.room && o.id !== G.you.id); if(!peers.length) continue; const o = pick(peers);
      let t = m.text; const bent = Math.random() < 0.35 + (1 - m.s) * 0.3; if(bent) t = mmGarble(t);
      const n = mmAdd(o.id, p.name + " told me: " + t, m.about, "gossip"); if(n){ n.s = clamp(m.s * 0.7, 0.05, 0.9); n.distorted = bent || m.distorted; }
      try{ (window.ONUM_TOWN_GOSSIP = window.ONUM_TOWN_GOSSIP || []).push({t:p.name + " passed on to " + o.name + ": " + t, d}); }catch(e){} } }catch(e){}
}
function onumRecall(npcId, opt){
  opt = opt || {}; const lim = opt.limit || 8, ab = opt.about ? String(opt.about).toLowerCase() : null;
  const L = (mmStore().by[npcId] || mmStore().by[String(npcId)] || []);
  const out = [];
  L.slice().sort((a, b) => b.s - a.s).forEach(m => {
    if(ab && (m.about || "").toLowerCase().indexOf(ab) < 0 && m.text.toLowerCase().indexOf(ab) < 0) return;
    if(Math.random() > Math.min(1, m.s + 0.15)) return;                       /* may simply not come to mind */
    let text = m.text, dis = m.distorted;
    if(!dis && m.s < 0.35 && Math.random() < 0.3){ text = mmGarble(text); dis = true; }   /* misremembered in the moment */
    out.push({text, about:m.about, day:m.day, strength:Math.round(m.s * 100) / 100, distorted:dis});
  });
  return out.slice(0, lim);
}
window.onumRecall = onumRecall;
window.onumRemember = function(npcId, text, about){ return mmAdd(npcId, String(text || ""), about || mmAbout(String(text || "")), "addressee", "external"); };
window.onumMemoryAct = mmAct;
(function(){ const base = window.onumMind; window.onumMind = function(id){ let m = base ? base(id) : null; try{ const r = onumRecall(id, {limit:6}); if(r.length){ m = m || {name:(mmPerson(id) || {}).name, goals:[], beliefs:[], plans:[], memory:[], family:null, job:"", wealth:null, mood:null}; m.memory = r.map(x => x.text).concat([].concat(m.memory || []).slice(0, 4)); m.recall = r; } }catch(e){} return m; }; })();
setInterval(() => { try{ if(G && G.day != null) mmDay(); }catch(e){} }, 5000);

/* ══ 20261020a · local talk reads as conversations: a log and a live thread ══ */
const CV = {th:[], seen:new WeakMap(), live:null, hideAt:0, lt:{}, lp:{}};
const CV_COL = ["#c9a96e","#7fb3d5","#e59866","#82e0aa","#d7bde2","#f7dc6f","#76d7c4","#f1948a"];
function cvCol(id){ let h = 0; String(id).split("").forEach(c => h = (h * 31 + c.charCodeAt(0)) | 0); return CV_COL[Math.abs(h) % CV_COL.length]; }
function cvRoomT(r){ try{ return ((ROOMS[r || G.room] || {}).t) || r || G.room; }catch(e){ return ""; } }
function cvAdd(who, whoId, to, text, live, opt){
  text = String(text || "").trim(); if(!text) return;
  opt = opt || {};
  const now = G.minute || 0, room = opt.room || G.room;
  let T = opt.thread ? CV.th.find(x => x.tag === opt.thread) : null;
  const key = [whoId, to].filter(x => x != null).map(String).sort().join("|");
  if(!T && !opt.thread){ const L = CV.th.slice(-1)[0];
    if(L && !L.tag && L.room === room && L.day === G.day && now - L.end < 4 && (L.keys.has(String(whoId)) || (to != null && L.keys.has(String(to))) || L.key === key)) T = L; }
  if(!T){ T = {id:CV.th.length ? CV.th[CV.th.length - 1].id + 1 : 1, tag:opt.thread || null, room, place:opt.place || cvRoomT(room), day:G.day, start:now, end:now, key, keys:new Set(), lines:[]}; CV.th.push(T); if(CV.th.length > 150) CV.th.shift(); }
  const last = T.lines.slice(-1)[0]; if(last && last.who === who && last.t === text) return;
  T.lines.push({who, id:whoId, t:text, at:opt.at || (function(){ try{ return hhmm(); }catch(e){ return ""; } })(), live:!!live}); T.end = now;
  if(whoId != null) T.keys.add(String(whoId)); if(to != null) T.keys.add(String(to));
  if(!opt.quiet){ CV.live = T; CV.hideAt = performance.now() + 22000; cvRenderLive(); }
  try{ mmHear(T, who, whoId, to, text); }catch(e){}
  try{ window.ONUM_CONVERSATIONS = CV.th.map(x => ({id:x.id, place:x.place, day:x.day, lines:x.lines})); }catch(e){}
}
function cvScan(){
  try{ everyone().forEach(m => { if(!m || !m.say || m.room !== G.room) return; if(CV.seen.get(m) === m.say) return; CV.seen.set(m, m.say);
    cvAdd(m.name, m.id, m.sayTo === "you" ? "you" : m.sayTo, m.say, false); }); }catch(e){}
  try{ cvNeptune(); }catch(e){}
  cvRenderLive();
}
/* Neptune's sources, read only */
function cvNeptune(){
  const LT = window.onumLiveTalk;
  if(LT && LT.memory && G.day !== CV.ltDay || (performance.now() - (CV.ltAt || 0) > 5000)){
    CV.ltAt = performance.now(); CV.ltDay = G.day;
    if(LT && LT.memory){ const ids = new Set(); try{ dmState(); Object.keys(G.dm.th || {}).forEach(i => ids.add(i)); }catch(e){} try{ everyone().filter(m => m.room === G.room).forEach(m => ids.add(String(m.id))); }catch(e){}
      ids.forEach(id => { let M = null; try{ M = LT.memory(isNaN(+id) ? id : +id); }catch(e){} if(!M || !M.turns) return;
        const n = CV.lt[id] || 0; if(M.turns.length <= n) return;
        const p = (function(){ try{ return byId(isNaN(+id) ? id : +id); }catch(e){ return null; } })(); const nm = p ? p.name : String(id);
        M.turns.slice(n).forEach(t => { const you = /^(u|user|you|p|player)$/i.test(String(t.r || "")); cvAdd(you ? "You" : nm, you ? "you" : id, you ? id : "you", t.c, !you, {thread:"lt:" + id + ":" + (t.d != null ? t.d : G.day), place:"LiveTalk · " + (t.ch || "face") + " · " + nm, quiet:true}); });
        CV.lt[id] = M.turns.length; }); }
  }
  const L = G.localParty; if(L && L.items){ L.items.forEach(i => { const k = i.id + ":" + (i.ruled || ""); if(CV.lp[k]) return; CV.lp[k] = 1;
    cvAdd(i.from || "Local party", "lp:" + (i.from || "x"), null, (i.src === "suggestion" ? "Suggestion" : "Motion") + ": " + i.text, false, {thread:"lp:day" + (i.at || G.day), place:"Local party meeting", quiet:true});
    if(i.ruled) cvAdd("The chair", "lp:chair", null, "Ruled: " + i.ruled, false, {thread:"lp:day" + (i.at || G.day), place:"Local party meeting", quiet:true}); }); }
}
["onum-district-ruling","onum-suggestion-ruling"].forEach(n => addEventListener(n, ev => { try{ const d = ev.detail || {}; cvAdd("The local party", "lp:chair", null, (n.indexOf("district") > 0 ? "District change " : "Suggestion ") + d.id + ": ruled " + d.ruling + ".", false, {thread:"lp:day" + G.day, place:"Local party meeting", quiet:true}); }catch(e){} }));
function cvLineHTML(l){ const c = l.who === "You" ? "#eef1f4" : cvCol(l.id); const ini = String(l.who).split(" ").map(x => x[0]).join("").slice(0, 2);
  return '<div class="cv__l"><span class="cv__av" style="background:' + c + '">' + pbEsc(ini) + '</span><div><div class="cv__n" style="color:' + c + '">' + pbEsc(l.who) + ' <small>' + pbEsc(l.at) + (l.live ? ' · live' : '') + '</small></div><div class="cv__t">' + pbEsc(l.t) + '</div></div></div>'; }
function cvCSS(){ if(document.getElementById("cvCSS")) return; const s = document.createElement("style"); s.id = "cvCSS";
  s.textContent = '#cvLive{position:fixed;left:14px;bottom:70px;width:380px;max-height:42vh;overflow-y:auto;background:#14181e;color:#eef1f4;border:1px solid #3a424d;border-radius:10px;padding:5px 8px;z-index:9980;font:12.5px/1.3 system-ui,sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.4)}#cvLive .cv__h{display:flex;justify-content:space-between;font-size:12px;color:#aab3bd;margin-bottom:4px}#cvLive button,.cv__btn{background:#2b333d;color:#eef1f4;border:1px solid #4a5563;border-radius:6px;padding:2px 8px;cursor:pointer;font-size:12px}.cv__l{display:flex;gap:6px;margin:3px 0;align-items:flex-start}.cv__av{flex:0 0 26px;height:26px;border-radius:50%;color:#1c2128;font:700 11px system-ui;display:flex;align-items:center;justify-content:center}.cv__n{font-weight:700;font-size:13px}.cv__n small{font-weight:400;color:#aab3bd}.cv__t{font-size:14px;line-height:1.35}.cv__th{border:1px solid #2b333d;border-radius:8px;padding:6px 8px;margin:8px 0}@media (max-width:900px),(max-height:500px) and (orientation:landscape){#cvLive{left:8px;right:8px;width:auto;bottom:calc(64px + env(safe-area-inset-bottom));max-height:34vh;font-size:15px}.cv__t{font-size:15px}#cvLive button,.cv__btn{min-height:36px;font-size:14px}}';
  document.head.appendChild(s); }
function cvRenderLive(){
  cvCSS();
  let w = document.getElementById("cvLive"); const T = CV.live;
  const show = T && T.room === G.room && performance.now() < CV.hideAt && !CV.closed && !document.body.classList.contains("ui-open") && !(typeof veil !== "undefined" && !veil.hidden) && !document.getElementById("pbPhone");
  if(!show){ if(w) w.style.display = "none"; return; }
  if(!w){ w = document.createElement("div"); w.id = "cvLive"; document.body.appendChild(w);
    w.addEventListener("click", ev => { const b = ev.target.closest("button"); if(!b) return; ev.stopPropagation(); if(b.dataset.cvx){ CV.closed = true; w.style.display = "none"; setTimeout(() => CV.closed = false, 30000); } if(b.dataset.cvread) cvRead(CV.live); if(b.dataset.cvlog){ try{ PB.tab = "convo"; pbOpen(); }catch(e){} } }, true); }
  const sig = T.id + ":" + T.lines.length; if(w.dataset.sig === sig && w.style.display !== "none") return;
  w.dataset.sig = sig; w.style.display = "block";
  w.innerHTML = '<div class="cv__h"><span>' + pbEsc(T.place) + ' · day ' + T.day + '</span><span><button data-cvread="1">Read aloud</button> <button data-cvlog="1">Log</button> <button data-cvx="1">×</button></span></div>' + T.lines.slice(-8).map(cvLineHTML).join("");
  w.scrollTop = w.scrollHeight;
}
function cvRead(T){ if(!T || !("speechSynthesis" in window)) return; try{ speechSynthesis.cancel(); T.lines.slice(-10).forEach(l => speechSynthesis.speak(new SpeechSynthesisUtterance(l.who + ": " + l.t))); }catch(e){} }
function cvLogHTML(){
  if(!CV.th.length) return '<p>No conversations yet. Talk to people, or stand near them.</p>';
  return CV.th.slice().reverse().slice(0, 40).map(T => { const names = [...new Set(T.lines.map(l => l.who))].join(", ");
    return '<div class="cv__th"><div style="display:flex;justify-content:space-between;gap:6px;font-size:12px;color:#aab3bd"><span><b style="color:#eef1f4">' + pbEsc(names) + '</b><br>' + pbEsc(T.place) + ' · day ' + T.day + ' · ' + pbEsc((T.lines[0] || {}).at || "") + '</span><button class="cv__btn" data-cvreadid="' + T.id + '">Read aloud</button></div>' + T.lines.map(cvLineHTML).join("") + '</div>'; }).join("");
}
setTimeout(() => { try{
  const say = document.getElementById("tkSay");
  if(say) new MutationObserver(() => { try{ const m = TALK.m; const t = say.textContent.trim(); if(m && t) cvAdd(m.name, m.id, "you", t, false); }catch(e){} }).observe(say, {childList:true, characterData:true, subtree:true});
  document.addEventListener("click", ev => { try{ const b = ev.target.closest(".talk__btn, .talk__acts button"); if(b && TALK.open && TALK.m){ const t = b.textContent.trim(); if(t && t.length > 3 && !/^(leave|close|goodbye|bye|done)$/i.test(t)) cvAdd("You", "you", TALK.m.id, t, false); } }catch(e){} }, true);
  document.addEventListener("click", ev => { const b = ev.target.closest("[data-cvreadid]"); if(!b) return; ev.stopPropagation(); cvRead(CV.th.find(x => x.id === +b.dataset.cvreadid)); }, true);
}catch(e){} }, 2000);
setInterval(() => { try{ cvScan(); }catch(e){} }, 2500);   /* 20261030b: fallback only; talk lines kick it (NEPTUNE-TALKREWORK) */

/* ══ voice hooks: calls, read-back texts, Conversations and approaches go to Neptune's onumVoice ══ */
const VH = {said:new Map(), call:{id:null, n:0}, rb:(function(){ try{ return localStorage.getItem("onum.readback") === "1"; }catch(e){ return false; } })()};
function vhSay(id, text, o){ if(id && typeof id === "object") id = id.id != null ? id.id : (id.name || "npc");
  if(!window.onumVoice || typeof window.onumVoice.speak !== "function" || !text) return;
  const k = String(text).trim().slice(0, 120), t = VH.said.get(k), now = performance.now();
  if(t && now - t < 8000) return; VH.said.set(k, now); if(VH.said.size > 200) VH.said.clear();
  try{ window.onumVoice.speak(id, String(text), o || {}); }catch(e){}
}
/* phone calls: the other end's lines are spoken as they arrive */
setInterval(() => { try{
  const c = (typeof PB !== "undefined") ? PB.call : null;
  if(!c){ VH.call.id = null; VH.call.n = 0; return; }
  if(VH.call.id !== c.id){ VH.call.id = c.id; VH.call.n = 0; }
  while(VH.call.n < c.lines.length){ const l = c.lines[VH.call.n++]; if(l && l.w !== "You") vhSay(c.id, l.t); }
}catch(e){} }, 400);
/* approaches: you hear them when they stop you */
(function(){ if(typeof apSpeak !== "function") return; const base = apSpeak;
  apSpeak = function(m, a, to){ const r = base.apply(this, arguments);
    try{ if(!to && m){ const first = m.say; setTimeout(() => vhSay(m.id, m.say || first), 1200); } }catch(e){} return r; }; })();
/* texts and DMs read back, when that is switched on */
(function(){ if(typeof dmPush !== "function") return; const base = dmPush;
  dmPush = function(id, from, t, extra){ const r = base.apply(this, arguments);
    try{ if(VH.rb && from !== "you" && t){ const p = byId(id); vhSay(id, (p ? p.name.split(" ")[0] + " writes: " : "") + t); } }catch(e){} return r; }; })();
/* Conversations: Read aloud speaks each line in its speaker's voice, in turn */
if(typeof cvRead === "function") cvRead = function(T){ if(!T || !window.onumVoice) return; try{ window.onumVoice.stop && window.onumVoice.stop(); }catch(e){} VH.said.clear(); T.lines.slice(-10).forEach(l => vhSay(l.id === "you" ? "you" : l.id, l.t)); };
/* the read-back switch lives on the phone's Texts tab */
document.addEventListener("change", ev => { const t = ev.target; if(t && t.id === "vhRb"){ VH.rb = !!t.checked; try{ localStorage.setItem("onum.readback", VH.rb ? "1" : "0"); }catch(e){} } }, true);
setInterval(() => { try{ const w = document.getElementById("pbPhone"); if(!w || typeof PB === "undefined" || PB.tab !== "texts" || !window.onumVoice) return; const b = w.querySelector(".pb__body"); if(b && !b.querySelector("#vhRb")) b.insertAdjacentHTML("afterbegin", '<label style="display:block;padding:6px 0;font-size:14px"><input type="checkbox" id="vhRb"' + (VH.rb ? " checked" : "") + '> Read messages back aloud</label>'); }catch(e){} }, 800);

/* ══ engine: time-sliced background systems, distance-tiered minds, compressed checked saves, log caps, perf overlay ══ */
/* ── 1. a cooperative scheduler: background systems share at most 4 ms of each frame ── */
const ENG = {budget:4, jobs:[], q:[], cost:{}, frames:0, simMs:0, last:performance.now()};
function engJob(name, everyMs, fn){ ENG.jobs.push({name, every:everyMs, fn, next:performance.now() + Math.random() * everyMs}); }
function engDefer(name, fn){ ENG.q.push({name, fn}); }
function engCost(name, ms){ const c = ENG.cost[name] || (ENG.cost[name] = {ms:0, n:0, max:0}); c.ms = c.ms * 0.95 + ms * 0.05; c.n++; if(ms > c.max) c.max = ms; else c.max *= 0.999; }
function engRun(){
  const t0 = performance.now(); let used = 0;
  /* due periodic jobs, nearest-due first */
  const due = ENG.jobs.filter(j => j.next <= t0).sort((a, b) => a.next - b.next);
  for(const j of due){ if(used >= ENG.budget) break; const s = performance.now(); try{ j.fn(); }catch(e){} const d = performance.now() - s; used += d; engCost(j.name, d); j.next = s + j.every; }
  /* deferred one-shot work (day rollover pieces) */
  while(ENG.q.length && used < ENG.budget){ const w = ENG.q.shift(); const s = performance.now(); try{ w.fn(); }catch(e){} const d = performance.now() - s; used += d; engCost(w.name, d); }
  ENG.simMs = ENG.simMs * 0.9 + used * 0.1; ENG.frames++;
}
(function pump(){ try{ engRun(); }catch(e){} if(typeof requestAnimationFrame === "function" && !document.hidden) requestAnimationFrame(pump); else setTimeout(pump, 250); })();
document.addEventListener("visibilitychange", () => { if(!document.hidden) try{ requestAnimationFrame(() => engRun()); }catch(e){} });
try{ if(typeof ohTick === "function"){ const real = ohTick; ohTick = function(){ engDefer("officeholders", real); }; } }catch(e){}
try{ if(typeof apTick === "function"){ const real = apTick; apTick = function(){ engDefer("approaches", real); }; } }catch(e){}
try{ if(typeof cvScan === "function"){ const real = cvScan; cvScan = function(){ engDefer("conversations", real); }; } }catch(e){}
/* day rollover: the heavy mind/state/party passes run one per frame instead of all in one frame */
try{ if(typeof scDay === "function"){ const real = scDay; scDay = function(){ const a = arguments; engDefer("statecraft", () => real.apply(null, a)); }; } }catch(e){}
try{ if(typeof cpDay === "function"){ const real = cpDay; cpDay = function(){ const a = arguments; engDefer("counterparts", () => real.apply(null, a)); }; } }catch(e){}
try{ if(typeof phDay === "function"){ const real = phDay; phDay = function(){ const a = arguments; engDefer("parties", () => real.apply(null, a)); }; } }catch(e){}
/* ── 2. minds near you think more often ── */
function engTier(p){ try{ if(!p || p.x == null || p.room !== G.room) return 3; const d = Math.hypot(p.x - cam.x, p.z - cam.z); return d < 6 ? 0 : d < 14 ? 1 : 2; }catch(e){ return 3; } }
window.onumSimTier = engTier;
engJob("minds", 500, () => {
  if(!G || !G.members) return;
  ENG.mi = (ENG.mi || 0) + 1;
  const M = window.ONUM_MINDS = window.ONUM_MINDS || {};
  const ev = (typeof everyone === "function") ? everyone() : G.members;
  let n = 0;
  for(const p of ev){ if(!p || p.gone) continue; const t = engTier(p), every = [1, 4, 12, 40][t];
    if((ENG.mi + idNum(String(p.id))) % every) continue;
    try{ if(typeof onumMindOf === "function") M[p.id] = Object.assign(M[p.id] || {}, onumMindOf(p.id) || {}, {tier:t}); }catch(e){}
    if(++n > 12) break; }
});
/* ── 3. logs never grow without end ── */
function engTrim(){
  const cap = (a, n) => { if(Array.isArray(a) && a.length > n) a.splice(0, a.length - n); };
  try{ cap(G.moments, 60); cap(G.feedLog, 300); cap(G.mail, 220); cap(G.news, 200); cap(G.log, 400); cap(G.journal, 300); cap(G.lastActs, 120); }catch(e){}
  try{ if(G.vox && G.vox.posts) cap(G.vox.posts, 60); }catch(e){}
  try{ const D = G.dm; if(D && D.th) Object.keys(D.th).forEach(k => cap(D.th[k], 60)); if(D && D.leaks) cap(D.leaks, 80); }catch(e){}
  try{ (G.members || []).forEach(m => { cap(m.mem, 80); cap(m.chat, 20); cap(m.journal, 40); cap(m.memory, 80); }); }catch(e){}
  try{ if(typeof CV !== "undefined") cap(CV.th, 150); }catch(e){}
  try{ if(G.sc){ cap(G.sc.log, 200); cap(G.sc.crises, 80); } }catch(e){}
  try{ if(G.ph) Object.values(G.ph.p).forEach(P => { cap(P.snaps, 60); cap(P.notes, 40); cap(P.votes, 40); }); }catch(e){}
  try{ if(G.dist){ cap(G.dist.gossip, 120); cap(G.dist.ledger, 400); } }catch(e){}
}
engJob("trim", 30000, engTrim);
/* ── 4. saves: compressed, checksummed, mirrored to IndexedDB ── */
function engHash(s){ let h = 2166136261; for(let i = 0; i < s.length; i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return (h >>> 0).toString(36) + ":" + s.length.toString(36); }
/* LZW into UTF-16 code units (15 bits each, so the string stays valid in localStorage); no dependencies */
function engPack(str){
  str = str.replace(/[\u0001\u0100-\uffff]/g, ch => "\u0001" + ch.charCodeAt(0).toString(16).padStart(4, "0"));
  let dict = new Map(), next = 256, w = "", buf = 0, bits = 0; const out = [], W = 16;
  const emit = c => { buf = buf * 65536 + c; bits += W; while(bits >= 15){ bits -= 15; const v = Math.floor(buf / Math.pow(2, bits)) & 0x7fff; out.push(String.fromCharCode(v + 0x20)); buf = buf % Math.pow(2, bits); } };
  for(let i = 0; i < str.length; i++){
    const c = str.charAt(i), wc = w + c;
    if(!w){ w = c; continue; }
    if(dict.has(wc)){ w = wc; continue; }
    emit(w.length === 1 ? w.charCodeAt(0) : dict.get(w));
    dict.set(wc, next++);
    if(next >= 65535){ dict = new Map(); next = 256; emit(65535); }
    w = c;
  }
  if(w) emit(w.length === 1 ? w.charCodeAt(0) : dict.get(w));
  if(bits > 0){ out.push(String.fromCharCode(((buf * Math.pow(2, 15 - bits)) & 0x7fff) + 0x20)); }
  return out.length + "~" + out.join("");
}
function engUnpack(s0){
  const k = s0.indexOf("~"); const n = +s0.slice(0, k), s = s0.slice(k + 1);
  let dict = [], next = 256, buf = 0, bits = 0, i = 0, prev = null; const out = [], W = 16;
  const read = () => { while(bits < W){ if(i >= s.length) return -1; buf = buf * 32768 + ((s.charCodeAt(i++) - 0x20) & 0x7fff); bits += 15; } bits -= W; const p2 = Math.pow(2, bits); const c = Math.floor(buf / p2); buf = buf % p2; return c; };
  const total = Math.floor(n * 15 / W);
  for(let r = 0; r < total; r++){
    const c = read(); if(c < 0) break;
    if(c === 65535){ dict = []; next = 256; prev = null; continue; }
    let e; if(c < 256) e = String.fromCharCode(c); else if(dict[c] !== undefined) e = dict[c]; else if(c === next && prev !== null) e = prev + prev[0]; else break;
    out.push(e);
    if(prev !== null){ dict[next++] = prev + e[0]; }
    prev = e;
  }
  return out.join("").replace(/\u0001([0-9a-f]{4})/g, (m, h) => String.fromCharCode(parseInt(h, 16)));
}
/* the wrapped form is "ONZ1|<hash>|<packed>"; anything else is the old plain JSON */
function engWrap(json){ try{ const z = engPack(json); if(engUnpack(z) !== json) return json; return "ONZ1|" + engHash(json) + "|" + z; }catch(e){ return json; } }
function engOpen(raw){ if(!raw || raw.slice(0, 5) !== "ONZ1|") return raw; const a = raw.indexOf("|", 5); const h = raw.slice(5, a); const j = engUnpack(raw.slice(a + 1)); if(engHash(j) !== h) return null; return j; }
const ENG_IDB = {db:null, cache:null};
try{ const rq = indexedDB.open("onum-saves", 1); rq.onupgradeneeded = () => { try{ rq.result.createObjectStore("s"); }catch(e){} };
  rq.onsuccess = () => { ENG_IDB.db = rq.result; try{ const g = ENG_IDB.db.transaction("s").objectStore("s").get("career"); g.onsuccess = () => { ENG_IDB.cache = g.result || null; }; }catch(e){} }; }catch(e){}
function engIdbPut(raw){ try{ if(!ENG_IDB.db) return; ENG_IDB.db.transaction("s", "readwrite").objectStore("s").put(raw, "career"); ENG_IDB.cache = raw; }catch(e){} }
(function(){
  const baseParse = parseSaveRaw;
  parseSaveRaw = function(raw){ try{ return baseParse(engOpen(raw)); }catch(e){ return null; } };
  const baseWrite = writeSaveKey;
  writeSaveKey = function(key, raw){ const t = performance.now(); const w = (typeof raw === "string" && raw.length > 20000 && raw.charAt(0) === "{") ? engWrap(raw) : raw; const ok = baseWrite(key, w); if(key === SAVE_KEY && ok){ engCost("save-write", performance.now() - t); ENG.lastSave = {plain:raw.length, stored:w.length, at:Date.now()}; engIdbPut(w); } return ok; };
  const basePick = pickNewestSave;
  pickNewestSave = function(){ let b = basePick(); try{ const d = ENG_IDB.cache ? parseSaveRaw(ENG_IDB.cache) : null; if(d && (!b || isBetterSave(d, b))) b = d; }catch(e){} return b; };
})();
/* autosave on a steady beat, never mid-walk (queueSave already refuses then) */
engJob("autosave", 90000, () => { try{ if(G && G.running && !G.over) queueSave(false); }catch(e){} });
addEventListener("pagehide", () => { try{ save(false, true); }catch(e){} });
/* ── 5. what each system costs, on screen (F9 or ?perf=1) ── */
function engOverlay(on){
  let w = document.getElementById("engPerf");
  if(!on){ if(w) w.remove(); return; }
  if(!w){ w = document.createElement("div"); w.id = "engPerf"; w.style.cssText = "position:fixed;right:8px;top:60px;z-index:99999;background:rgba(10,12,16,.92);color:#d6f5d6;font:12px/1.35 ui-monospace,monospace;padding:8px 10px;border:1px solid #2e3a2e;border-radius:6px;pointer-events:none;white-space:pre;min-width:220px"; document.body.appendChild(w); }
  const R = (window.