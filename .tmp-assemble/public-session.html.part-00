    if(full){ LOD_NEAR = 5.5; LOD_MID = 11.0; LOD_FAR = 18.0; }
    else { LOD_NEAR = 2.7; LOD_MID = 5.6; LOD_FAR = 8.8; }
    G.plainSit = !!G.noSit;
    setPR(GFX_PR);
  }
