<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta name="onum-build" content="20261030au">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#15181e">
<meta name="description" content="One Nation, Under, ME. A first-person political life simulator. You are one member of a legislature in an invented republic, and the only thing you accumulate is what other people think of you.">
<meta name="apple-mobile-web-app-capable" content="content=yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<style>
  html,body{margin:0;padding:0}
  img{max-width:100%}
  [hidden]:not([hidden="until-found"]){display:none!important}
</style>
<title>One Nation, Under, ME.</title>
<link rel="icon" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'>  <rect width='32' height='32' fill='#0D1014'/>  <polygon fill='#A45F27' points='16,2.8 19.04,9.69 26.32,7.77 22.82,14.44 28.87,18.94 21.47,20.36 21.73,27.89 16,23 10.27,27.89 10.53,20.36 3.13,18.94 9.18,14.44 5.68,7.77 12.96,9.69'/></svg>">
<meta property="og:title" content="One Nation, Under, ME.">
<!-- Standalone: system fonts. No CDN, no vendor folder. -->
</head>
<body>
<script>
(function(){
  var STAMP = "20261030au";
  try{
    if(navigator.serviceWorker){
      navigator.serviceWorker.getRegistrations().then(function(rs){
        rs.forEach(function(r){ r.unregister(); });
      });
    }
    if(window.caches){
      caches.keys().then(function(keys){ keys.forEach(function(k){ caches.delete(k); }); });
    }
    var u = new URL(location.href);
    if(u.searchParams.get("v") !== STAMP){
      u.searchParams.set("v", STAMP);
      if(history.replaceState) history.replaceState(null, "", u.pathname + u.search + u.hash);
    }
  }catch(e){}
})();
</script>
<style>
:root{
  --stone:#DCDEE1; --paper:#F1F2F3; --surface:#FAFAFB;
  --ink:#15181E; --ink-2:#4A515B; --ink-3:#7E8690;
  --line:#C7CAD0; --line-soft:#DDDFE3;
  --fed:#A45F27; --com:#1C5F66; --ind:#5B6670;
  --good:#2F6B45; --bad:#8E2F3B; --warn:#8A6516;
  --shadow:0 1px 0 rgba(21,24,30,.05), 0 12px 30px -20px rgba(21,24,30,.6);
  --focus:#A45F27;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --stone:#0D1014; --paper:#161A20; --surface:#1B212A;
    --ink:#E2E5E9; --ink-2:#A2AAB4; --ink-3:#727C87;
    --line:#2A323C; --line-soft:#212831;
    --fed:#D48F4B; --com:#4FAFB6; --ind:#8A949E;
    --good:#5FA97C; --bad:#CE6A78; --warn:#CFA255;
    --shadow:0 1px 0 rgba(0,0,0,.4), 0 14px 34px -22px rgba(0,0,0,.95);
    --focus:#D48F4B;
  }
}
:root[data-theme="dark"]{
  --stone:#0D1014; --paper:#161A20; --surface:#1B212A;
  --ink:#E2E5E9; --ink-2:#A2AAB4; --ink-3:#727C87;
  --line:#2A323C; --line-soft:#212831;
  --fed:#D48F4B; --com:#4FAFB6; --ind:#8A949E;
  --good:#5FA97C; --bad:#CE6A78; --warn:#CFA255;
  --shadow:0 1px 0 rgba(0,0,0,.4), 0 14px 34px -22px rgba(0,0,0,.95);
  --focus:#D48F4B;
}
*{box-sizing:border-box}
body{background:var(--stone); color:var(--ink); font-family:Archivo,"Helvetica Neue",Arial,sans-serif; font-size:14px; line-height:1.5; -webkit-font-smoothing:antialiased}
:focus-visible{outline:2px solid var(--focus); outline-offset:2px}
button{font-family:inherit; color:inherit}
a{color:var(--com); text-decoration-color:color-mix(in srgb,var(--com) 55%,transparent);
  text-underline-offset:2px}
a:visited{color:var(--com)}
a:hover{color:var(--fed)}

/* One frame. The bar, the view and the wire are fixed; only the panels
   scroll, and they scroll inside themselves. Nothing pushes the page. */
html,body{height:100%}
.shell{display:grid; grid-template-rows:auto minmax(0,1fr) auto auto; gap:8px; padding:8px;
  max-width:min(2560px,100%); margin:0 auto; height:100dvh; min-height:540px; box-sizing:border-box}
@supports not (height:100dvh){ .shell{height:100vh} }
/* 20261005a max-fit: wide desks give the stage the leftover width; wire stays readable. */
@media (min-width:1600px){
  .shell{gap:8px; padding:8px 10px}
  .grid{grid-template-columns:minmax(0,1fr) minmax(360px, min(420px, 24vw)); gap:8px}
  .plate{max-width:min(280px, 48%)}
  .bar{padding:8px 14px}
}


.bar{display:grid; grid-template-columns:auto auto minmax(0,1fr) auto; gap:16px; align-items:center;
  background:var(--paper); border:1px solid var(--line); border-radius:3px; padding:9px 14px; box-shadow:var(--shadow)}
.bar__me{display:flex; flex-direction:column; gap:1px; min-width:0}
.bar__name{font-family:"Instrument Serif",Georgia,serif; font-size:21px; line-height:1.05}
.bar__sub{font-size:10.5px; color:var(--ink-2); display:flex; gap:7px; align-items:center; flex-wrap:wrap}
.bar__when{border-left:1px solid var(--line-soft); border-right:1px solid var(--line-soft); padding:0 16px; text-align:center}
.bar__date{font-family:"JetBrains Mono",monospace; font-size:11px; font-variant-numeric:tabular-nums; color:var(--ink-2)}
.bar__clock{font-family:"JetBrains Mono",monospace; font-size:21px; font-weight:500; font-variant-numeric:tabular-nums; line-height:1.15}
.speed{display:flex; gap:3px; justify-content:center; margin-top:5px}
.speed button{font-family:"JetBrains Mono",monospace; font-size:9.5px; line-height:1; padding:4px 5px;
  min-width:27px; background:var(--surface); border:1px solid var(--line); border-radius:2px;
  color:var(--ink-3); cursor:pointer}
.speed button:hover:not(.is-on){color:var(--ink); border-color:var(--ink-3)}
.speed button.is-on{background:var(--ink); color:var(--paper); border-color:var(--ink)}
.speed button.is-held{background:var(--bad); color:var(--paper); border-color:var(--bad)}
.bar__stats{display:flex; gap:14px; flex-wrap:wrap; min-width:0}
.stat{min-width:80px}
.stat i{display:block; font-style:normal; font-size:8.5px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-3)}
.stat b{font-family:"JetBrains Mono",monospace; font-size:14px; font-weight:500; font-variant-numeric:tabular-nums}
.stat__track{display:block; height:3px; background:var(--line-soft); border-radius:2px; overflow:hidden; margin-top:3px}
.stat__fill{display:block; height:100%; transition:width .3s ease}
.bar__congress{text-align:right; white-space:nowrap}
.bar__congress i{display:block; font-style:normal; font-size:8.5px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-3)}
.bar__congress b{font-family:"Instrument Serif",Georgia,serif; font-size:18px; font-weight:400}

.grid{display:grid; grid-template-columns:minmax(0,1fr) minmax(340px, 376px); gap:8px;
  align-items:stretch; min-height:0}
.grid > div:first-child{display:flex; flex-direction:column; min-height:240px; overflow:hidden}
.stage{flex:1 1 auto; min-height:150px; display:flex; flex-direction:column}


.stage{position:relative; border:1px solid var(--line); border-radius:3px; overflow:hidden; background:#0b0d10; box-shadow:var(--shadow)}
.scene{position:relative; width:100%; flex:1 1 auto; min-height:190px}
.scene canvas{display:block; width:100%; height:100%; cursor:grab}
.scene canvas:active{cursor:grabbing}
.boot{position:absolute; inset:0; display:grid; place-items:center; color:#c8ced6; font-size:13px; text-align:center; padding:24px}

.plate{position:absolute; transform:translate(-50%,-100%); pointer-events:none;
  max-width:min(240px, 62%); background:color-mix(in srgb, var(--paper) 92%, transparent);
  border:1px solid var(--line); border-radius:2px; padding:4px 8px 5px;
  box-shadow:0 4px 14px -8px rgba(0,0,0,.7)}
.plate b, .plate > span{display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.plate .said{white-space:normal; font-style:italic; color:var(--ink); margin-top:2px}
.plate.is-focus{border-color:var(--fed); box-shadow:0 0 0 1px var(--fed), 0 6px 18px -8px rgba(0,0,0,.8)}
.plate b{display:block; font-size:11px; font-weight:600; line-height:1.3}
.plate span{font-size:10px; line-height:1.3}
.plate.is-thought{opacity:.82}
.plate.is-thought .said{color:var(--ink-3)}

.hud{position:absolute; left:12px; top:10px; pointer-events:none; background:rgba(11,13,16,.5); padding:4px 10px 5px; border-radius:3px}
.aims{position:absolute; left:12px; top:58px; z-index:5; max-width:min(300px,60%); background:rgba(11,13,16,.58); border:1px solid rgba(232,213,163,.22); padding:6px 10px; font-size:13px; color:#eef1f4; text-shadow:0 1px 6px rgba(0,0,0,.9); border-radius:3px}
.aims i{display:block; font-style:normal; font-size:9px; font-weight:600; letter-spacing:.15em; text-transform:uppercase; color:#aab3bd}
.aims b{display:block; font-weight:500}
.aims__all{display:none; margin-top:6px; padding-top:6px; border-top:1px solid rgba(232,213,163,.18)}
.aims:hover .aims__all,.aims:focus .aims__all,.aims:focus-within .aims__all{display:block}
.aims .goals{margin:0; padding-left:0; list-style:none}.aims .goals li{margin:2px 0}.aims .goals li.is-done{opacity:.55}
.hud b{display:block; font-family:"Instrument Serif",Georgia,serif; font-size:19px; color:#eef1f4; text-shadow:0 2px 10px rgba(0,0,0,.9)}
.hud i{font-style:normal; font-size:9px; font-weight:600; letter-spacing:.15em; text-transform:uppercase; color:#aab3bd; text-shadow:0 2px 8px rgba(0,0,0,.9)}
.compass{position:absolute; left:50%; top:8px; transform:translateX(-50%); width:min(440px,72%); height:22px; pointer-events:none; z-index:5}
.compass__rail{position:absolute; inset:0; background:linear-gradient(90deg,transparent,rgba(0,0,0,.5) 14%,rgba(0,0,0,.5) 86%,transparent); border-bottom:1px solid rgba(232,213,163,.32)}
.compass__n{position:absolute; left:50%; top:1px; transform:translateX(-50%); font-size:8px; letter-spacing:.22em; color:#e8d5a3; font-weight:700}
.compass__tick{position:absolute; top:8px; width:5px; height:5px; margin-left:-2px; border-radius:50%; background:#c8ced6; opacity:.9}
.compass__tick.is-quest{background:#f3c14b; width:8px; height:8px; border-radius:0; transform:rotate(45deg); top:6px}
.compass__tick.is-talk{background:#7ec8ff; width:7px; height:7px}
.compass__tick.is-goal{background:none; width:0; height:0; border-radius:0; top:3px; margin-left:-6px; border-left:6px solid transparent; border-right:6px solid transparent; border-top:9px solid #e8d5a3; filter:drop-shadow(0 0 3px rgba(232,213,163,.8))}
.compass__tick.is-goal.is-edge{opacity:.65}
body.keys-intro .keys{display:flex !important; opacity:.92}
#pauseOverlay button:focus-visible, #pauseOverlay input:focus-visible{outline:3px solid var(--gold, #c9a227); outline-offset:2px}
.whip__h{font:600 11px/1.2 var(--mono, monospace); letter-spacing:.12em; text-transform:uppercase; opacity:.7; margin:12px 0 4px}
.whip__row{display:grid; grid-template-columns:1fr auto; gap:2px 10px; padding:6px 0; border-top:1px solid var(--line, rgba(0,0,0,.12)); align-items:center}
.whip__n{font-weight:600} .whip__n i{font-style:normal; opacity:.6; font-weight:400; font-size:.86em}
.whip__w{grid-column:1; font-size:.86em; opacity:.8}
.whip__b{grid-column:2; grid-row:1 / span 2; display:flex; gap:6px}
.whip__go{padding:6px 10px; min-height:0}
.ach--locked{opacity:.55}
.ach-toast{position:fixed; left:50%; top:18px; transform:translate(-50%,-140%); z-index:9999; background:rgba(18,16,12,.94); color:#f4ead2; border:1px solid #c9a227; border-radius:8px; padding:10px 18px; display:grid; gap:2px; text-align:center; transition:transform .35s ease; pointer-events:none; max-width:min(420px,90vw)}
.ach-toast.is-on{transform:translate(-50%,0)}
.ach-toast i{font:600 10px/1 var(--mono, monospace); letter-spacing:.14em; text-transform:uppercase; color:#c9a227; font-style:normal}
.ach-toast b{font-size:16px} .ach-toast span{font-size:12px; opacity:.85}
.goals{list-style:none; margin:4px 0 10px; padding:0; text-align:left}
.goals li{font-size:13px; padding:2px 0; color:var(--ink)}
.goals li.is-done{color:var(--good); text-decoration:line-through; text-decoration-color:color-mix(in srgb,var(--good) 50%,transparent)}
body.is-bare .hud{top:46px}
.job{position:absolute; left:50%; bottom:56px; transform:translateX(-50%); pointer-events:none; z-index:5; display:flex; gap:8px; align-items:baseline; max-width:min(540px,88%); background:rgba(11,13,16,.58); border:1px solid rgba(232,213,163,.22); padding:5px 12px 6px; border-radius:2px; color:#eef1f4}
.job i{font-style:normal; font-size:8px; letter-spacing:.16em; color:#e8d5a3; font-weight:700}
.job b{font-size:12.5px; font-weight:500}
.savepip{position:absolute; right:12px; top:10px; z-index:6; font-size:9px; letter-spacing:.16em; text-transform:uppercase; color:#9ad7a0; text-shadow:0 2px 8px #000; pointer-events:none; opacity:0; transition:opacity .35s}
.savepip.is-on{opacity:1}
.hearts{letter-spacing:1px; color:#c45c5c; font-size:11px}
.stage.is-spent .grade{box-shadow:inset 0 0 90px 12px rgba(50,8,8,.5)}
.keys{position:absolute; right:12px; top:10px; display:none; gap:5px; flex-wrap:wrap; justify-content:flex-end; max-width:54%; pointer-events:none}
/* FPV / play: tips stay hidden unless hold ? or / (body.help-held) */
body.help-held .keys{display:flex !important; opacity:1; visibility:visible}
.kbd{font-family:"JetBrains Mono",monospace; font-size:9.5px; background:rgba(12,15,19,.62); border:1px solid rgba(200,210,220,.28);
  color:#ccd3db; padding:3px 6px; border-radius:2px}
/* Every floating thing on the view lives in its own lane and moves out
   of the way when a taller one appears. Nothing here is allowed to be
   printed over words you are trying to read. */
.prompt{position:absolute; left:50%; bottom:16px; transform:translateX(-50%); pointer-events:none;
  background:rgba(12,15,19,.82); color:#eef1f4; font-size:11.5px; font-weight:600; padding:7px 12px; border-radius:2px;
  border:1px solid rgba(200,210,220,.25); max-width:min(92%,520px); text-align:center}
.prompt[hidden]{display:none}
.prompt.is-live{pointer-events:auto; padding:8px 10px 10px}
.prompt.is-live .prompt__btn{pointer-events:auto; cursor:pointer}
.prompt__h{display:block; font-size:10px; letter-spacing:.12em; text-transform:uppercase;
  color:rgba(220,228,236,.72); margin:0 0 6px; font-weight:600}
.prompt__opts{display:flex; flex-wrap:wrap; gap:5px; justify-content:center}
.prompt__btn{font-size:11.5px; font-weight:600; background:rgba(255,255,255,.08); color:#eef1f4;
  border:1px solid rgba(200,210,220,.28); border-radius:2px; padding:6px 9px; cursor:pointer; text-align:left; pointer-events:auto}
.prompt__btn:hover{border-color:#c9a24a; color:#fff}
.prompt__btn u{text-decoration:none; font-family:"JetBrains Mono",monospace; font-size:9.5px;
  color:rgba(200,210,220,.55); margin-left:6px}
.prompt.is-catch{max-width:min(94%,560px); padding:9px 12px 11px}
.prompt__catch-line{display:block; font-size:13px; font-weight:600; line-height:1.35; color:#f2f5f8;
  margin:2px 0 8px; min-height:1.35em}
.prompt__catch-line.is-pass{opacity:.45; font-weight:500}
.prompt__ticker{height:3px; background:rgba(255,255,255,.12); border-radius:2px; overflow:hidden; margin:0 0 8px}
.prompt__ticker > i{display:block; height:100%; width:100%; background:#c9a24a;
  transform-origin:left center; transition:none}
.prompt__catch-row{display:flex; gap:6px; justify-content:center; align-items:center; flex-wrap:wrap}
.prompt__btn.is-catch{border-color:#c9a24a; background:rgba(201,162,74,.18)}
.prompt__miss{font-size:9.5px; letter-spacing:.1em; text-transform:uppercase; color:rgba(200,210,220,.5)}

.travel{display:flex; gap:5px; flex-wrap:nowrap; overflow-x:auto; overflow-y:hidden;
  padding:8px; background:var(--paper); border:1px solid var(--line); border-top:0;
  border-radius:0 0 3px 3px; scrollbar-width:thin}
.travel__btn{flex:0 0 auto; white-space:nowrap}
.travel__btn{font-size:11.5px; font-weight:500; background:var(--surface); border:1px solid var(--line); border-radius:2px; padding:6px 9px; cursor:pointer; display:flex; align-items:center; gap:7px}
.travel__btn:hover:not(:disabled){border-color:var(--fed)}
.travel__btn.is-here{background:var(--ink); color:var(--paper); border-color:var(--ink)}
.travel__btn:disabled{opacity:.35; cursor:not-allowed}
.travel__btn u{text-decoration:none; font-family:"JetBrains Mono",monospace; font-size:9.5px; color:var(--ink-3)}
.travel__btn.is-here u{color:var(--line)}

/* A conversation has to fit in the frame. Nothing here scrolls: the
   line they just said is clamped, the transcript lives behind its own
   tab, and the buttons wrap. */
.talk{position:absolute; left:0; right:0; bottom:0; display:none; max-height:82%; overflow:hidden;
  background:color-mix(in srgb,var(--paper) 96%,transparent); border-top:2px solid var(--fed); padding:11px 14px 12px}
/* A column, so the panel can give: the head and the buttons hold their
   size and the conversation underneath absorbs whatever is left. What
   you can act on is never the thing that gets pushed off the bottom. */
.talk.is-open{display:flex; flex-direction:column; min-height:0}
.talk__head, .talk__say, .talk__note, .talk__acts{flex:0 0 auto}
.talk__think{flex:0 1 auto; min-height:0}
.chat{flex:1 1 auto; min-height:0; overflow:hidden; display:flex; flex-direction:column}
.chat__suggest{flex:0 0 auto}
.chat__meta, .logbox{flex:0 0 auto}
@media (max-height:620px){ .talk__think{display:none} .talk__say{max-height:6.9em} }

.talk__head{display:flex; gap:12px; align-items:flex-start; flex-wrap:wrap; padding-bottom:7px; margin-bottom:8px; border-bottom:1px solid var(--line-soft)}
.talk__who{flex:1 1 250px; min-width:0}
.talk__name{font-family:"Instrument Serif",Georgia,serif; font-size:23px; line-height:1.1}
.talk__meta{display:flex; gap:7px; align-items:center; flex-wrap:wrap; margin-top:4px; font-size:11px; color:var(--ink-2)}
.chip{font-size:9px; font-weight:600; letter-spacing:.13em; text-transform:uppercase; padding:4px 7px; border-radius:2px; border:1px solid}
.chip--fed{color:var(--fed); border-color:color-mix(in srgb,var(--fed) 45%,transparent); background:color-mix(in srgb,var(--fed) 11%,transparent)}
.chip--com{color:var(--com); border-color:color-mix(in srgb,var(--com) 45%,transparent); background:color-mix(in srgb,var(--com) 11%,transparent)}
.chip--ind{color:var(--ind); border-color:color-mix(in srgb,var(--ind) 45%,transparent); background:color-mix(in srgb,var(--ind) 14%,transparent)}
.chip--dyn{color:var(--pc, var(--ind)); border-color:color-mix(in srgb,var(--pc, var(--ind)) 45%,transparent); background:color-mix(in srgb,var(--pc, var(--ind)) 12%,transparent)}
.swatches{display:flex; flex-wrap:wrap; gap:7px; margin:8px 0 4px}
.swatch{width:28px; height:28px; border-radius:3px; border:2px solid transparent; cursor:pointer; padding:0}
.swatch.is-on{border-color:var(--ink); box-shadow:0 0 0 1px var(--paper)}
.swatch:focus-visible{outline:2px solid var(--focus); outline-offset:2px}
.talk__feel{flex:0 0 auto; text-align:right}
.talk__feel i{display:block; font-style:normal; font-size:9px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-3); margin-bottom:3px}
.talk__feel b{font-family:"Instrument Serif",Georgia,serif; font-size:19px; font-style:italic; font-weight:400}
.talk__bars{display:none !important}
.tiny{min-width:64px}
.tiny i{display:block; font-style:normal; font-size:8.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-3)}
.tiny span{display:block; height:3px; background:var(--line-soft); border-radius:2px; overflow:hidden; margin-top:3px}
.tiny span b{display:block; height:100%}
.talk__say{font-family:"Instrument Serif",Georgia,serif; font-size:18px; line-height:1.38; margin-bottom:5px;
  max-width:72ch; max-height:9.6em; overflow:auto}
.talk__note{font-size:11px; color:var(--ink-3); margin-bottom:11px; min-height:1.3em; font-family:"JetBrains Mono",monospace}
.talk__note b{color:var(--good); font-weight:500}
.talk__note u{text-decoration:none; color:var(--bad)}
.talk__acts{display:flex; flex-wrap:wrap; gap:6px}
.talk__btn{font-size:12px; font-weight:500; background:var(--surface); border:1px solid var(--line); border-radius:2px; padding:8px 11px; cursor:pointer; display:flex; align-items:center; gap:8px; text-align:left}
.talk__btn:hover:not(:disabled){border-color:var(--fed)}
.talk__btn:disabled{opacity:.35; cursor:not-allowed}
.talk__btn u{text-decoration:none; font-family:"JetBrains Mono",monospace; font-size:9.5px; color:var(--ink-3)}
.talk__btn--risk:hover:not(:disabled){border-color:var(--bad); color:var(--bad)}
.talk__btn--exit{border-style:dashed; color:var(--ink-2)}
.talk__think{font-family:"Instrument Serif",Georgia,serif; font-style:italic; font-size:13.5px;
  color:var(--ink-2); border-left:2px solid var(--line); padding-left:10px; margin:0 0 8px; max-width:70ch;
  overflow:auto; max-height:9.5em}
.talk__think b{font-style:normal; font-family:Archivo,sans-serif; font-size:8.5px; font-weight:600;
  letter-spacing:.14em; text-transform:uppercase; color:var(--ink-3); display:block; margin-bottom:3px}
.talk__think .netbars{margin-top:8px; font-family:Archivo,sans-serif; font-style:normal; font-size:9.5px;
  letter-spacing:.04em; text-transform:uppercase; color:var(--ink-3)}
.talk__think .netbars i{display:flex; align-items:center; gap:7px; margin:3px 0; font-style:normal; min-width:0}
.talk__think .netbars i b{flex:1; height:5px; background:var(--line); border-radius:2px; position:relative;
  margin:0; letter-spacing:0; text-transform:none}
.talk__think .netbars i em{position:absolute; top:-1px; width:3px; height:7px; background:var(--fed);
  border-radius:1px; margin-left:-1px}
.talk__think .netbars span{display:block; margin-top:5px; text-transform:none; letter-spacing:0; font-size:10px}

/* free conversation */
.chat{margin-top:12px; border-top:1px solid var(--line-soft); padding-top:11px}
.chat[hidden]{display:none}
.chat__log{display:flex; flex-direction:column; gap:6px; max-height:34vh; overflow-y:auto}
/* the transcript keeps to the bottom right, shut until you want it */
.logbox{margin-top:10px; display:flex; flex-direction:column; align-items:flex-end}
.logbox > summary{list-style:none; cursor:pointer; align-self:flex-end;
  font-size:9.5px; font-weight:600; letter-spacing:.13em; text-transform:uppercase;
  color:var(--ink-3); background:var(--surface); border:1px solid var(--line);
  border-radius:2px 2px 0 0; padding:6px 11px; user-select:none}
.logbox > summary::-webkit-details-marker{display:none}
.logbox > summary::marker{content:""}
.logbox > summary:hover{color:var(--ink); border-color:var(--ink-3)}
.logbox[open] > summary{color:var(--ink); border-color:var(--ink-3); border-bottom-color:var(--surface)}
.logbox[open] > .chat__log{width:100%; border:1px solid var(--ink-3); border-radius:2px 0 2px 2px;
  padding:11px; background:var(--surface); margin-top:-1px}
.logbox:not([open]) > .chat__log{display:none}
.msg{max-width:76ch; font-size:13.5px; line-height:1.45}
.msg--you{color:var(--ink-2)}
.msg--you b{font-family:Archivo,sans-serif; font-size:8.5px; font-weight:600; letter-spacing:.14em;
  text-transform:uppercase; color:var(--ink-3); display:block; margin-bottom:2px}
.msg--them{font-family:"Instrument Serif",Georgia,serif; font-size:16.5px; color:var(--ink)}
.msg--them b{font-family:Archivo,sans-serif; font-size:8.5px; font-weight:600; letter-spacing:.14em;
  text-transform:uppercase; color:var(--fed); display:block; margin-bottom:2px}
.msg--think{font-family:"Instrument Serif",Georgia,serif; font-style:italic; font-size:15px; color:var(--ink-2);
  border-left:2px solid var(--fed); padding-left:10px}
.chat__btn{font-size:11px; font-weight:600; letter-spacing:.08em; text-transform:uppercase;
  background:var(--ink); color:var(--paper); border:1px solid var(--ink); padding:0 14px; border-radius:2px; cursor:pointer}
.chat__btn:disabled{opacity:.4; cursor:not-allowed}
.chat__btn--ghost{background:transparent; color:var(--ink-2); border-color:var(--line)}

/* the wire: one text bar, always there */
.wire{display:flex; gap:6px; align-items:center; background:var(--paper); border:1px solid var(--line);
  border-radius:3px; padding:8px 10px; box-shadow:var(--shadow); flex-wrap:wrap}
.wire__to{font-family:Archivo,sans-serif; font-size:11.5px; padding:8px 9px; max-width:210px;
  background:var(--surface); border:1px solid var(--line); border-radius:2px; color:var(--ink)}
.wire__in{flex:1 1 260px; min-width:0; font-family:Archivo,sans-serif; font-size:13.5px; padding:9px 12px;
  background:var(--surface); border:1px solid var(--line); border-radius:2px; color:var(--ink)}
.wire__in::placeholder{color:var(--ink-3)}
/* the same bar, sitting inside the conversation instead of under the page */
.wire--in{margin:9px 0 0; padding:0; background:none; border:0; box-shadow:none}
.wire__how{font-size:9px; font-weight:600; letter-spacing:.13em; text-transform:uppercase; color:var(--ink-3); white-space:nowrap}
.wire__how b{color:var(--fed); font-weight:600}
.wire__state{font-size:10.5px; color:var(--ink-3); font-family:"JetBrains Mono",monospace; flex:0 1 auto; min-width:0}

/* the wire ticker along the bottom */
.tick{display:flex; align-items:center; gap:0; background:#12151a; border-radius:3px;
  overflow:hidden; box-shadow:var(--shadow); border:1px solid rgba(255,255,255,.08)}
.tick__tag{flex:0 0 auto; background:var(--fed); color:#fff; font-size:9px; font-weight:700;
  letter-spacing:.16em; text-transform:uppercase; padding:9px 11px; white-space:nowrap}
.tick__win{flex:1 1 auto; overflow:hidden; position:relative; height:32px}
.tick__run{position:absolute; top:0; left:0; height:32px; display:flex; align-items:center;
  white-space:nowrap; will-change:transform; transform:translateX(0)}
.tick__run span{color:#e7eaee; font-size:11.5px; padding:0 26px; font-family:Archivo,sans-serif}
.tick__run b{color:var(--fed); font-weight:700; letter-spacing:.1em; font-size:9.5px;
  text-transform:uppercase; margin-right:8px}
.tick.is-paused .tick__run{/* hover pause handled in JS */}
@media (prefers-reduced-motion: reduce){ .tick__run{transform:none !important; padding-left:12px} }

/* inbox */
.mailrow{border-bottom:1px solid var(--line-soft); padding:10px 0; cursor:pointer}
.mailrow:hover{background:var(--surface)}
.mailrow.is-unread .mailrow__s{font-weight:700; color:var(--ink)}
.mailrow__h{display:flex; gap:8px; align-items:baseline; justify-content:space-between}
.mailrow__f{font-size:11.5px; font-weight:600}
.mailrow__d{font-family:"JetBrains Mono",monospace; font-size:9.5px; color:var(--ink-3); white-space:nowrap}
.mailrow__s{font-size:12.5px; color:var(--ink-2); margin-top:2px}
.mailrow__b{font-family:"Instrument Serif",Georgia,serif; font-size:14px; line-height:1.45; color:var(--ink-2); margin-top:7px; white-space:pre-wrap}
.mailrow__acts{display:flex; gap:6px; flex-wrap:wrap; margin-top:9px}
.dotmark{display:inline-block; width:6px; height:6px; border-radius:50%; background:var(--fed); margin-right:5px; vertical-align:middle}
.tabs button .badge{display:inline-block; min-width:15px; padding:0 3px; margin-left:3px; border-radius:7px;
  background:var(--fed); color:var(--paper); font-size:8.5px; line-height:15px; text-align:center}

/* ── the overlay: tracking, telemetry, a continuous feed ── */
.veilfade{position:absolute; inset:0; background:#0b0d10; opacity:0; pointer-events:none; z-index:6}
/* cinematic grade: corner falloff, a warm bloom in the light, and grain */
.grade{position:absolute; inset:0; pointer-events:none; z-index:2;
  background:radial-gradient(ellipse 78% 72% at 50% 44%, rgba(255,236,205,.07) 0%, transparent 46%),
             radial-gradient(ellipse 96% 96% at 50% 46%, transparent 40%, rgba(9,11,15,.30) 78%, rgba(6,8,11,.55) 100%)}
.grain{position:absolute; inset:0; pointer-events:none; z-index:3; opacity:.05;
  background-repeat:repeat; background-size:110px 110px}
@media (prefers-reduced-motion: reduce){ .grain{display:none} }

.track{position:absolute; pointer-events:none; z-index:4; transform:translate(-50%,-50%)}
.track[hidden]{display:none}
.track__box{position:relative; width:100%; height:100%}
.track__c{position:absolute; width:11px; height:11px; border:1.5px solid var(--fed); opacity:.92}
.track__c--tl{top:0; left:0; border-right:0; border-bottom:0}
.track__c--tr{top:0; right:0; border-left:0; border-bottom:0}
.track__c--bl{bottom:0; left:0; border-right:0; border-top:0}
.track__c--br{bottom:0; right:0; border-left:0; border-top:0}
.track__tag{position:absolute; left:calc(100% + 9px); top:50%; transform:translateY(-50%);
  white-space:nowrap; font-family:"JetBrains Mono",monospace; font-size:9.5px; line-height:1.55;
  color:#f0ece4; text-shadow:0 1px 4px rgba(0,0,0,.95); border-left:1px solid var(--fed); padding-left:8px}
.track__tag b{color:var(--fed); font-weight:600}
.track__tag i{font-style:normal; color:#b9c0c8}

.tele{position:absolute; left:12px; bottom:10px; z-index:4; pointer-events:none;
  font-family:"JetBrains Mono",monospace; font-size:13px; letter-spacing:.06em;
  color:#dfe4ea; text-shadow:0 1px 6px rgba(0,0,0,.95)}
.tele b{color:var(--fed); font-weight:600}
.tele span{display:block}

/* Three lines, no more, and kept out of the middle of the room: this is
   a note in the corner of your eye, not something to read over the top
   of the thing you are looking at. */
.feed{position:absolute; right:10px; top:38px; z-index:4; pointer-events:none;
  display:flex; flex-direction:column; align-items:flex-end; gap:3px; max-width:min(300px,38%)}
.feed div{max-width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.feed div{font-family:"JetBrains Mono",monospace; font-size:9.5px; line-height:1.4; color:#e6e9ed;
  text-shadow:0 1px 5px rgba(0,0,0,.95); text-align:right; padding:2px 0 2px 9px;
  border-right:2px solid var(--fed); padding-right:8px; animation:feedin .5s ease both}
.feed div.is-old{opacity:.42}
.feed div u{text-decoration:none; color:var(--fed)}
@keyframes feedin{from{opacity:0; transform:translateX(9px)} to{opacity:1; transform:none}}
@media (prefers-reduced-motion: reduce){ .feed div{animation:none} }

/* someone wants a word */
.hail{position:absolute; right:12px; top:92px; max-width:250px; pointer-events:none; opacity:.9;
  background:rgba(20,32,52,.82); color:#fff; font-size:11px; font-weight:600; padding:5px 9px; border-radius:2px; border-left:3px solid var(--fed);
  box-shadow:0 8px 22px -12px rgba(0,0,0,.8)}
.hail[hidden]{display:none}

/* the room, in session: who has the floor, and what you can say back */
.proc{position:absolute; left:10px; right:10px; bottom:26px; z-index:7;
  background:color-mix(in srgb,var(--paper) 95%,transparent); border:1px solid var(--line);
  border-top:2px solid var(--fed); border-radius:3px; padding:9px 11px 10px; box-shadow:var(--shadow)}
.proc[hidden]{display:none}
#procClock{font-family:"JetBrains Mono",monospace; font-variant-numeric:tabular-nums; font-weight:600; letter-spacing:.04em; color:var(--fed); min-width:3.2em; text-align:right}
.proc__h{display:flex; align-items:baseline; gap:9px; flex-wrap:wrap}
.proc__h b{font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:var(--fed)}
.proc__h i{font-size:12px; color:var(--ink-2); font-style:normal}
.proc__h u{margin-left:auto; font-family:"JetBrains Mono",monospace; font-size:12px;
  text-decoration:none; color:var(--bad)}
.proc__opts{display:flex; gap:5px; flex-wrap:wrap; margin-top:8px}
.proc__btn{font-size:11.5px; padding:7px 10px; background:var(--surface); border:1px solid var(--line);
  border-radius:2px; color:var(--ink); cursor:pointer; text-align:left}
.proc__btn:hover{border-color:var(--fed); color:var(--fed)}
.proc__btn--go{background:var(--ink); color:var(--paper); border-color:var(--ink); flex:0 0 auto}
.proc__say{display:flex; gap:5px; margin-top:6px}
.proc__say input{flex:1 1 auto; min-width:0; font-family:Archivo,sans-serif; font-size:12.5px;
  padding:7px 10px; background:var(--surface); border:1px solid var(--line);
  border-radius:2px; color:var(--ink)}
.proc__say input::placeholder{color:var(--ink-3)}
.proc__next{position:absolute; right:10px; top:8px; font-size:10.5px; letter-spacing:.08em;
  text-transform:uppercase; padding:5px 9px; background:var(--surface); color:var(--ink-2);
  border:1px solid var(--line); border-radius:2px; cursor:pointer}
.proc__next:hover{border-color:var(--fed); color:var(--fed)}

/* press a name and the country explains itself */
.tipword{border-bottom:1px dotted var(--fed); cursor:pointer; color:inherit}
.tipword:hover{color:var(--fed)}
.tipcard{position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); z-index:12;
  width:min(430px,88%); max-height:78%; overflow-y:auto; background:var(--paper);
  border:1px solid var(--line); border-top:3px solid var(--fed); border-radius:3px;
  padding:16px 18px 17px; box-shadow:0 26px 70px -30px rgba(0,0,0,.8)}
.tipcard[hidden]{display:none}
.tip__x{position:absolute; right:8px; top:6px; background:none; border:0; font-size:19px;
  line-height:1; color:var(--ink-3); cursor:pointer}
.tip__t{font-family:"Instrument Serif",Georgia,serif; font-size:22px; line-height:1.14; padding-right:20px}
.tip__s{font-size:9.5px; letter-spacing:.13em; text-transform:uppercase; color:var(--ink-3); margin:5px 0 9px}
.tipcard p{font-size:12.5px; line-height:1.55; margin:0 0 7px}
.tip__q{color:var(--ink-2); border-left:2px solid var(--line); padding-left:9px}
.tip__f{font-size:11px; color:var(--ink-3)}
.tip__h{font-size:9.5px; letter-spacing:.13em; text-transform:uppercase; color:var(--fed); margin:11px 0 5px}

/* the encyclopaedia */
.ency__tabs{display:flex; gap:4px; flex-wrap:wrap; margin:8px 0 12px}
.ency__tab{font-size:10px; letter-spacing:.08em; text-transform:uppercase; padding:6px 8px;
  background:var(--surface); border:1px solid var(--line); border-radius:2px;
  color:var(--ink-3); cursor:pointer}
.ency__tab.is-on{border-color:var(--fed); color:var(--fed); background:var(--paper)}
.ency__row{border-top:1px solid var(--line); padding:10px 0 11px}
.ency__row:first-child{border-top:0}
.ency__row.is-now{border-left:2px solid var(--fed); padding-left:10px}
.ency__n{font-family:"Instrument Serif",Georgia,serif; font-size:17px; line-height:1.15}
.ency__s{font-size:9.5px; letter-spacing:.11em; text-transform:uppercase; color:var(--ink-3); margin:3px 0 6px}
.ency p{font-size:12.5px; line-height:1.5; margin:0 0 5px}
.ency__h{font-size:9.5px; letter-spacing:.13em; text-transform:uppercase; color:var(--fed); margin:14px 0 4px}

/* your own voice */
.chat__btn--mic{background:transparent; color:var(--ink-2); border-color:var(--line)}
.chat__btn--mic.is-live{background:var(--bad); color:#fff; border-color:var(--bad)}
.mic{position:absolute; left:50%; bottom:64px; transform:translateX(-50%); z-index:8;
  max-width:82%; display:flex; align-items:center; gap:8px;
  background:rgba(16,19,25,.92); color:#f2f4f7;
  font-size:12.5px; padding:8px 13px; border-radius:3px; box-shadow:var(--shadow)}
.mic[hidden]{display:none}
/* what the pad does, right now */
.padbar{position:absolute; left:50%; bottom:8px; transform:translateX(-50%); z-index:7;
  display:flex; gap:12px; flex-wrap:wrap; justify-content:center; max-width:94%;
  pointer-events:none; font-size:10px; color:#d3d9e0; text-shadow:0 1px 4px rgba(0,0,0,.95)}
.padbar[hidden]{display:none}

.aloud-btn{position:absolute; right:12px; bottom:14px; z-index:8; pointer-events:auto;
  font:600 11.5px Archivo,system-ui,sans-serif; letter-spacing:.06em; text-transform:uppercase;
  padding:9px 12px; border-radius:3px; border:1px solid rgba(201,162,74,.55);
  background:rgba(16,14,11,.78); color:#f0e4c8; cursor:pointer}
.aloud-btn:hover,.aloud-btn.is-live{background:rgba(142,47,59,.92); border-color:#c9a24a; color:#fff}
body.has-pad .aloud-btn{bottom:40px}
body.in-session.has-pad .aloud-btn{bottom:118px}
.heard{position:absolute; left:50%; top:14%; transform:translateX(-50%); z-index:9; pointer-events:none;
  background:rgba(47,107,69,.9); color:#fff; font-size:12px; font-weight:600; padding:7px 12px; border-radius:2px;
  opacity:0; transition:opacity .2s}
.heard.is-on{opacity:1}

/* with a pad plugged in, everything above the legend steps up a line */
body.has-pad .prompt{bottom:34px}
body.has-pad .tele{bottom:28px}
body.has-pad .proc{bottom:32px}
body.has-pad .mic{bottom:80px}
/* and with the proceedings bar up, the prompt and the clock clear it */
body.in-session .prompt{bottom:96px}
body.in-session .tele{bottom:96px}
body.in-session .hail{top:92px}
body.in-session.has-pad .prompt{bottom:112px}
body.in-session.has-pad .tele{bottom:112px}
.padbar span{display:flex; align-items:center; gap:5px; white-space:nowrap}
.padbar b{display:inline-block; min-width:15px; height:15px; line-height:15px; text-align:center;
  border-radius:50%; background:rgba(16,19,25,.85); border:1px solid rgba(255,255,255,.35);
  font-family:"JetBrains Mono",monospace; font-size:9px; padding:0 3px}
.mic i{width:7px; height:7px; border-radius:50%; background:var(--bad); flex:0 0 auto;
  animation:micpulse 1.1s ease-in-out infinite}
@keyframes micpulse{0%,100%{opacity:.35} 50%{opacity:1}}
@media (prefers-reduced-motion: reduce){ .mic i{animation:none; opacity:1} }

/* in the room: everything that is not the room goes away */
body.is-bare .bar,
body.is-bare .dossier,
body.is-bare .travel,
body.is-bare .keys{display:none}
body.is-bare .wire{display:none}
body.is-bare.ui-open .wire{display:flex !important; position:fixed; left:0; right:0; bottom:0; z-index:57; margin:0}
body.is-bare .grid{grid-template-columns:minmax(0,1fr)}
body.is-bare .shell{grid-template-rows:minmax(0,1fr) auto auto}
body.is-bare .stage{border-radius:3px}
/* Play mode toolbar — click to open covering UI */
.ui-toolbar{display:none; position:absolute; left:10px; top:10px; z-index:10; gap:6px; align-items:center}
body.is-bare .ui-toolbar{display:flex}
/* Dossier living inside the phone while immersive */
.dossier--phone{display:flex !important; flex-direction:column; position:static !important;
  left:auto !important; right:auto !important; top:auto !important; bottom:auto !important;
  max-height:52vh !important; width:100% !important; margin:8px 0 0; border:1px solid var(--line);
  border-radius:3px; z-index:1; background:var(--paper); box-shadow:none}
.dossier--phone .pane.is-on{flex:1 1 auto; max-height:42vh; overflow:auto}
.dossier--phone .tabs{flex-wrap:wrap}
body.is-bare .dossier.dossier--phone{display:flex !important}
.card .billbox{border-color:rgba(255,255,255,.12); padding-bottom:10px; margin-bottom:10px}
.card .axis span{background:rgba(255,255,255,.16)}
.card .axis span b{background:#e8eaee}
.card .axis span em{background:#5fa97c}
.card .mailrow{border-top:1px solid rgba(255,255,255,.1); padding:9px 0; cursor:pointer}
.card .mailrow__s{font-size:13px}
.card .mailrow__b{font-size:12.5px; line-height:1.45; margin-top:6px; color:var(--ink-2)}

.ui-toolbar button{font:600 13px Archivo,system-ui,sans-serif; letter-spacing:.06em; text-transform:uppercase; min-height:38px;
  padding:8px 12px; border-radius:3px; border:1px solid rgba(255,255,255,.2);
  background:rgba(16,19,25,.82); color:#eef1f4; cursor:pointer}
.ui-toolbar button:hover{border-color:rgba(201,162,74,.7); color:#f0e4c8}
/* Covering panels sheet */
body.is-bare.ui-open .bar{
  display:flex !important; position:fixed; left:0; right:0; top:0; z-index:60;
  margin:0; border-radius:0; border-left:0; border-right:0; border-top:0}
body.is-bare.ui-open .dossier{
  display:flex !important; flex-direction:column; position:fixed; left:0; right:0; top:58px; bottom:72px;
  z-index:55; max-height:none !important; width:auto; margin:0; border-radius:0;
  border:0; border-top:1px solid var(--line); background:var(--paper)}
body.is-bare.ui-open .dossier .pane.is-on{flex:1 1 auto; max-height:none; overflow:auto}
body.is-bare.ui-open .travel{display:none !important}
body.is-bare.ui-open .ui-toolbar{display:none}
body.is-bare .unbare{display:none}
.unbare{display:none}

/* the bill, in full, for anyone who actually reads them */
.sheet__t{font-family:"Instrument Serif",Georgia,serif; font-size:21px; line-height:1.15; padding-right:20px}
.sheet__m{display:flex; gap:6px; flex-wrap:wrap; font-size:9.5px; letter-spacing:.1em;
  text-transform:uppercase; color:var(--ink-3); margin:6px 0 10px}
.sheet__why{font-size:13px; line-height:1.55; margin:0 0 9px}
.sheet__h{font-size:9.5px; letter-spacing:.13em; text-transform:uppercase; color:var(--fed); margin:11px 0 5px}
.sheet__cl{margin:0 0 4px; padding-left:18px; font-size:12.5px; line-height:1.55}
.sheet__cl li{margin-bottom:3px}
.sheet__g{display:grid; grid-template-columns:repeat(auto-fit,minmax(110px,1fr)); gap:7px; margin:6px 0 2px}
.sheet__g div{background:var(--surface); border:1px solid var(--line); border-radius:2px; padding:7px 9px}
.sheet__g i{display:block; font-size:9px; letter-spacing:.11em; text-transform:uppercase;
  color:var(--ink-3); font-style:normal}
.sheet__g b{font-size:12.5px; font-weight:600}

/* the running record, so you can follow what was actually said */
/* the record of what is being said: the last three lines, and no more */
.proclog{position:absolute; left:10px; top:48px; width:min(280px,36%);
  z-index:5; pointer-events:none}
.proclog:empty{display:none}
.procline{font-size:11px; line-height:1.42; margin-bottom:4px; color:#dfe4ea;
  text-shadow:0 1px 3px rgba(0,0,0,.9); max-height:4.3em; overflow:hidden}
.procline b{color:var(--fed); margin-right:5px}

/* who else is close enough to hear this */
.hearing{color:var(--warn); font-size:10.5px}
.hearing .tipword{border-bottom-color:var(--warn)}
.chat__suggest{display:flex; flex-wrap:wrap; gap:5px; margin-bottom:9px}

.sugg{font-size:11.5px; padding:7px 10px; background:var(--surface); border:1px solid var(--line);
  border-radius:2px; color:var(--ink); cursor:pointer; text-align:left}
.sugg:hover{border-color:var(--fed); color:var(--fed)}
.is-pick{outline:2px solid var(--fed); outline-offset:2px}
/* the face button that answers this prompt, printed on the prompt */
[data-btn]{position:relative}
[data-btn]::after{content:attr(data-btn); position:absolute; top:-6px; right:-6px;
  width:15px; height:15px; line-height:15px; text-align:center; border-radius:50%;
  font-family:"JetBrains Mono",monospace; font-size:9px; font-weight:700;
  background:var(--ink); color:var(--paper); border:1px solid var(--paper); pointer-events:none}
.travel [data-btn]::after, .tabs [data-btn]::after{display:none}

.chat__meta{display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-top:7px;
  font-size:10.5px; color:var(--ink-3)}
.linkish{background:none; border:0; padding:0; font-size:10.5px; color:var(--ink-3);
  text-decoration:underline; text-underline-offset:2px; cursor:pointer}
.linkish:hover{color:var(--ink)}
.chat__raw{white-space:pre-wrap; font-family:"JetBrains Mono",monospace; font-size:10px; line-height:1.5;
  background:var(--surface); border:1px solid var(--line); border-radius:2px; padding:11px;
  margin-top:8px; max-height:230px; overflow:auto; color:var(--ink-2)}
.chat__raw[hidden]{display:none}

/* Vox: what the whole country reads */
.vox{border-top:1px solid var(--line); padding:9px 0 10px}
.vox:first-of-type{border-top:0}
.vox__h{display:flex; align-items:center; gap:7px; flex-wrap:wrap; margin-bottom:4px}
.vox__h b{font-size:12.5px}
.vox__h i{margin-left:auto; font-size:9.5px; font-style:normal; letter-spacing:.09em;
  text-transform:uppercase; color:var(--ink-3); font-family:"JetBrains Mono",monospace}
.vox__t{font-size:13px; line-height:1.5; white-space:pre-wrap; word-break:break-word}
.vox__t.is-typing::after{content:"▋"; opacity:.55; animation:voxCaret .7s steps(1) infinite; margin-left:1px}
@keyframes voxCaret{50%{opacity:0}}
@media (prefers-reduced-motion: reduce){ .vox__t.is-typing::after{animation:none; opacity:1} }
.vox__at{font-family:"JetBrains Mono",monospace; font-size:10px; color:var(--ink-3)}
.vox__re{font-size:9px; letter-spacing:.12em; text-transform:uppercase; color:var(--ink-3); margin-bottom:2px}
.vox__f{display:flex; gap:12px; flex-wrap:wrap; margin-top:5px; font-size:10px;
  letter-spacing:.08em; text-transform:uppercase; color:var(--ink-3)}
.vox.is-mine{border-left:2px solid var(--fed); padding-left:9px}
.phone__tabs{margin-bottom:12px}
.phone__scroll{max-height:min(46vh,340px); overflow-y:auto; padding-right:4px}
.voxwrite textarea{width:100%; box-sizing:border-box; font-family:Archivo,sans-serif; font-size:13.5px;
  line-height:1.5; padding:10px 12px; background:var(--surface); border:1px solid var(--line);
  border-radius:2px; color:var(--ink); resize:vertical}
.voxwrite textarea::placeholder{color:var(--ink-3)}
.voxwrite__f{display:flex; align-items:center; gap:10px; margin-top:7px}
.voxwrite__f span{font-family:"JetBrains Mono",monospace; font-size:10.5px; color:var(--ink-3)}
.voxwrite__f .btn{margin-left:auto}



.dossier{background:var(--paper); border:1px solid var(--line); border-radius:3px; box-shadow:var(--shadow);
  overflow:hidden; display:flex; flex-direction:column; min-height:0}
.tabs{display:flex; flex-wrap:wrap; border-bottom:1px solid var(--line)}
.tabs button{flex:1 1 76px; background:none; border:0; border-bottom:2px solid transparent; padding:11px 2px; cursor:pointer; font-size:9px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-3)}
.tabs button.is-on{color:var(--ink); border-bottom-color:var(--fed)}
.pane{display:none; padding:15px; overflow-y:auto; min-height:0}
.pane.is-on{display:block; flex:1 1 auto}
.pane.is-on{display:block}
.eyebrow{font-size:9px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; color:var(--ink-3)}
.h-serif{font-family:"Instrument Serif",Georgia,serif; font-size:22px; line-height:1.15; margin:6px 0 5px; text-wrap:balance}
.muted{font-size:11.5px; color:var(--ink-2)}

.billbox{border-bottom:1px solid var(--line); padding-bottom:14px; margin-bottom:14px}
.billbox__pos{display:flex; gap:10px; flex-wrap:wrap; margin-top:10px}
.axis{flex:1 1 70px}
.axis i{display:block; font-style:normal; font-size:8.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-3)}
.axis span{display:block; height:3px; background:var(--line-soft); margin-top:3px; position:relative; border-radius:2px}
.axis span b{position:absolute; top:-2px; width:3px; height:7px; background:var(--ink); border-radius:1px}
.axis span em{position:absolute; top:-1px; width:2px; height:5px; background:var(--good); border-radius:1px}
.count{display:grid; grid-template-columns:repeat(3,1fr); gap:2px; margin:12px 0 8px}
.count div i{display:block; font-style:normal; font-size:9px; font-weight:600; letter-spacing:.13em; text-transform:uppercase; color:var(--ink-3)}
.count div b{font-family:"JetBrains Mono",monospace; font-size:24px; font-weight:500; font-variant-numeric:tabular-nums; display:block; line-height:1.2}
.count .c-aye b{color:var(--good)} .count .c-no b{color:var(--bad)} .count .c-un b{color:var(--ink-3)}
.countbar{display:flex; height:8px; border-radius:1px; overflow:hidden; background:var(--line-soft)}
.countbar span{display:block; height:100%}

.mrow{display:grid; grid-template-columns:1fr auto; gap:3px 10px; padding:10px 0; border-bottom:1px solid var(--line-soft)}
.mrow__n{font-weight:600; font-size:12.5px; display:flex; align-items:center; gap:6px; flex-wrap:wrap}
.mrow__r{font-size:10px; color:var(--ink-3); text-align:right; font-family:"JetBrains Mono",monospace}
.mrow__m{grid-column:1/-1; font-family:"Instrument Serif",Georgia,serif; font-style:italic; font-size:13.5px; color:var(--ink-2)}
.mrow__w{grid-column:1/-1; display:flex; height:3px; background:var(--line-soft); border-radius:2px; overflow:hidden}
.mrow__w b{display:block; height:100%}
.pin{font-size:8.5px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; padding:2px 5px; border-radius:2px; border:1px solid var(--line); color:var(--ink-3)}
.pin--debt{color:var(--good); border-color:color-mix(in srgb,var(--good) 45%,transparent)}
.pin--owe{color:var(--warn); border-color:color-mix(in srgb,var(--warn) 45%,transparent)}
.pin--post{color:var(--ink); border-color:var(--ink-3)}
.pin--ally{color:var(--com); border-color:color-mix(in srgb,var(--com) 45%,transparent)}

.risk{border:1px solid var(--line); border-left:3px solid var(--bad); background:var(--surface); padding:11px 12px; margin-bottom:9px}
.risk__t{font-family:"Instrument Serif",Georgia,serif; font-size:15px; line-height:1.35}
.risk__b{height:4px; background:var(--line-soft); border-radius:2px; overflow:hidden; margin-top:8px}
.risk__b b{display:block; height:100%; background:var(--bad)}
.risk__m{font-size:10.5px; color:var(--ink-3); font-family:"JetBrains Mono",monospace; margin-top:5px}
.risk__actions{display:flex; gap:6px; margin-top:8px}
.risk__actions .conc__btn{flex:1}
.risk__actions .conc__btn.is-accepted{background:color-mix(in srgb,var(--good) 14%,var(--surface)); color:var(--good); border-color:color-mix(in srgb,var(--good) 55%,var(--line))}
.risk__actions .conc__btn.is-declined{background:color-mix(in srgb,var(--bad) 10%,var(--surface)); color:var(--bad); border-color:color-mix(in srgb,var(--bad) 48%,var(--line))}
.dn{display:grid; grid-template-columns:1fr auto; gap:2px 10px; padding:9px 0; border-bottom:1px solid var(--line-soft); font-size:12px}
.dn b{font-family:"JetBrains Mono",monospace; font-size:11px}
.dn span.s{grid-column:1/-1; font-size:10.5px; color:var(--ink-3)}

.entry{border-bottom:1px solid var(--line-soft); padding:11px 0}
.entry__d{font-family:"JetBrains Mono",monospace; font-size:9.5px; color:var(--ink-3); letter-spacing:.05em}
.entry__t{font-family:"Instrument Serif",Georgia,serif; font-size:15.5px; line-height:1.45; margin-top:3px}
.entry.is-big .entry__t{font-size:18px}
.careerline{display:grid; grid-template-columns:70px 1fr; gap:10px; padding:9px 0; border-bottom:1px solid var(--line-soft); font-size:12px}
.careerline b{font-family:"JetBrains Mono",monospace; font-size:10.5px; color:var(--ink-3)}

.veil{position:fixed; inset:0; z-index:80; display:grid; place-items:center; padding:20px; overflow-y:auto;
  background:color-mix(in srgb,var(--stone) 96%,transparent); backdrop-filter:blur(10px)}
body.boot-menu .ui-toolbar,
body.boot-menu .aloud-btn,
body.boot-menu .keys,
body.boot-menu .wire,
body.boot-menu .tick,
body.boot-menu .bar,
body.boot-menu .travel,
body.boot-menu .dossier{display:none !important}
body.boot-menu .shell{grid-template-rows:minmax(0,1fr)}
.card--open{animation:cardin .45s ease both}
@keyframes cardin{from{opacity:0; transform:translateY(10px)} to{opacity:1; transform:none}}
.boot-hint{font-size:11px; color:var(--ink-3); margin-top:10px; letter-spacing:.04em}
.veil[hidden]{display:none}
.veil[hidden] .card{display:none !important}
.card{width:min(690px,100%); background:var(--paper); border:1px solid var(--line); border-top:3px solid var(--fed);
  border-radius:3px; box-shadow:0 26px 70px -34px rgba(0,0,0,.7); padding:26px 30px 24px}
.card h1{font-family:"Instrument Serif",Georgia,serif; font-size:34px; font-weight:400; line-height:1.08; margin:8px 0 12px; text-wrap:balance}
.card h2{font-family:"Instrument Serif",Georgia,serif; font-size:20px; font-weight:400; margin:20px 0 7px}
.card p{margin:0 0 11px; max-width:64ch; color:var(--ink-2)}
.card p strong{color:var(--ink); font-weight:600}
.card__rule{height:1px; background:var(--line); margin:18px 0}
.dream{font-family:"Instrument Serif",Georgia,serif; font-style:italic; font-size:18px; line-height:1.5; border-left:2px solid var(--fed); padding-left:15px; color:var(--ink); margin:0 0 14px}
.btn{font-size:11.5px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; background:var(--ink); color:var(--paper); border:1px solid var(--ink); padding:11px 17px; border-radius:2px; cursor:pointer}
.btn:hover{opacity:.86}
.btn--ghost{background:transparent; color:var(--ink-2); border-color:var(--line)}
.btn--ghost:hover{color:var(--ink); border-color:var(--ink-3); opacity:1}
.card__actions{display:flex; gap:8px; flex-wrap:wrap; margin-top:18px}
.card__logo{display:block;width:min(220px,56%);height:auto;margin:0 auto 12px;border-radius:50%;
  object-fit:cover; box-shadow:0 10px 28px -12px rgba(11,27,51,.55), 0 0 0 1px rgba(164,95,39,.25)}
.card--open{text-align:center}
.card--open .eyebrow{margin-top:4px}
.card--open h1,.card--open p{text-align:left}
.card--open .legend{justify-content:center}
.card--open .card__actions{justify-content:center}

.results{display:flex; flex-direction:column; margin:6px 0 14px}
.results div{display:grid; grid-template-columns:1fr auto auto; gap:12px; padding:8px 0; border-bottom:1px solid var(--line-soft); font-size:12.5px; align-items:baseline}
.results b{font-family:"JetBrains Mono",monospace; font-size:11.5px; font-variant-numeric:tabular-nums}
.win{color:var(--good)} .lose{color:var(--bad)}
/* character creator */
.veil--make{backdrop-filter:none; background:linear-gradient(90deg, transparent 0%, transparent 30%,
  color-mix(in srgb,var(--stone) 88%,transparent) 46%); justify-items:end; padding-right:18px}
.veil--make .card{width:min(430px,100%)}
.mk{display:flex; flex-direction:column; gap:11px; margin:12px 0 4px}
.mk__row{display:grid; grid-template-columns:88px 1fr; gap:10px; align-items:center}
.mk__row > i{font-style:normal; font-size:9px; font-weight:600; letter-spacing:.14em;
  text-transform:uppercase; color:var(--ink-3)}
.mk__opts{display:flex; gap:4px; flex-wrap:wrap}
.mk__opt{font-size:11px; padding:6px 9px; background:var(--surface); border:1px solid var(--line);
  border-radius:2px; color:var(--ink-2); cursor:pointer}
.mk__opt:hover{border-color:var(--ink-3); color:var(--ink)}
.mk__opt.is-on{background:var(--ink); color:var(--paper); border-color:var(--ink)}
.qz__done{display:flex; flex-direction:column; gap:4px; margin:0 0 12px}
.qz__done button{text-align:left; font-size:11.5px; padding:6px 8px; background:transparent;
  border:1px solid var(--line-soft); border-radius:2px; color:var(--ink-3); cursor:pointer}
.qz__done button:hover{color:var(--ink); border-color:var(--ink-3)}
.qz__done b{color:var(--ink-2); font-weight:600}
.qz__stance{display:flex; flex-wrap:wrap; gap:8px; margin:0 0 14px; align-items:center}
.qz__stance .chip{opacity:1; transition:opacity .2s, filter .2s}
.qz__stance .chip.is-away{opacity:0.28; filter:grayscale(1); text-decoration:line-through}
.qz__q{font-family:"Instrument Serif",Georgia,serif; font-size:22px; line-height:1.25; margin:0 0 12px}
.conc__wing{margin:12px 0 4px}
.conc__grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:6px}
.conc__grid .conc__btn,.conc__row .conc__btn{display:block; text-align:left}
.conc__btn .conc__name{display:block; font-weight:600}
.conc__btn u{display:block; text-decoration:none; font-size:12px; opacity:.7}
.conc__here{display:inline-block; margin-top:3px; font-size:10px; letter-spacing:.08em; text-transform:uppercase; padding:1px 7px; border-radius:9px; border:1px solid currentColor}
.lore{margin:6px 0 4px}
.lore summary{cursor:pointer; font-size:13px; opacity:.8; padding:4px 0}
.lore[open] summary{opacity:1}
.qz__opts{display:flex; flex-direction:column; gap:6px}
.qz__opts .mk__opt{display:block; width:100%; text-align:left; padding:10px 12px; font-size:13px; line-height:1.35}
.qz__prog{font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-3); margin:0 0 8px}
.mk__sw{width:24px; height:24px; border-radius:50%; border:2px solid transparent; cursor:pointer; padding:0}
.mk__sw.is-on{border-color:var(--ink); box-shadow:0 0 0 2px var(--paper) inset}
/* the handbook */
.hb{border-top:1px solid var(--line); padding:10px 0 4px; margin-top:8px}
.hb__t{font-size:9.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--fed); margin-bottom:7px}
.hb__r{display:grid; grid-template-columns:150px 1fr; gap:10px; padding:4px 0; align-items:baseline}
.hb__r b{font-family:"JetBrains Mono",monospace; font-size:11px; font-weight:500; color:var(--ink)}
.hb__r span{font-size:12.5px; line-height:1.5; color:var(--ink-2)}
@media (max-width:560px){ .hb__r{grid-template-columns:1fr} }
.mk__name{font-family:"Instrument Serif",Georgia,serif; font-size:23px; width:100%; padding:8px 11px;
  background:var(--surface); border:1px solid var(--line); border-radius:2px; color:var(--ink)}
.mk__namewrap{display:flex; gap:8px; align-items:stretch; margin-bottom:4px}
.mk__namewrap .mk__name{flex:1; min-width:0}
.mk__reroll{font-size:11px; white-space:nowrap; padding:6px 10px; align-self:stretch}
.mk__culthint{font-size:11px; color:var(--ink-3); margin:0 0 12px; letter-spacing:.03em}
.mk input[type=range]{width:100%; accent-color:var(--fed)}
.legend{display:flex; gap:14px; flex-wrap:wrap; margin-top:14px; font-size:11.5px; color:var(--ink-2)}
.legend span{display:flex; align-items:center; gap:6px}
.dot{width:9px; height:9px; border-radius:50%}
@media (prefers-reduced-motion: reduce){ *{transition-duration:.001ms !important} }

/* ── Narrow screens. Kept LAST so these win the cascade over the
      component rules above, which are all the same specificity. ── */
@media (max-width:900px){
  .shell{padding:7px; gap:7px}
  .bar{display:flex; flex-wrap:wrap; align-items:center; gap:9px 16px; padding:9px 11px}
  .bar__me{flex:1 1 150px}
  .bar__name{font-size:19px}
  .bar__congress{order:2; text-align:right}
  .bar__when{order:3; border:0; padding:0; margin-left:auto; text-align:right}
  .bar__when .speed{justify-content:flex-end}
  .bar__stats{order:4; flex:1 1 100%; gap:11px 14px}
  .stat{flex:1 1 84px; min-width:84px}
  .keys{display:none}
  .hud b{font-size:16px}
  .hud i{font-size:8.5px}
  .talk__name{font-size:20px}
  .talk__say{font-size:17px}
  .talk__feel{text-align:left}
  .talk__bars{justify-content:flex-start}
  .pane{max-height:none}
  /* one column, still one frame: the view takes what is left and the
     panel underneath it scrolls inside itself */
  .grid{grid-template-columns:minmax(0,1fr); grid-template-rows:minmax(260px,1fr) minmax(0,auto)}
  .dossier{max-height:36vh; min-height:0}
  .plate b{font-size:10px}
  .plate span{font-size:9px}
}
@media (max-width:520px){
  /* a phone in portrait cannot hold all of this at once; let it scroll */
  html,body{height:auto}
  .shell{height:auto; min-height:100dvh; grid-template-rows:auto auto auto auto}
  .grid{grid-template-rows:auto auto; align-items:start}
  .scene{aspect-ratio:16/10; flex:0 0 auto; min-height:260px}
  .stage{flex:0 0 auto}
  .dossier{max-height:none}
  .pane.is-on{flex:0 0 auto; max-height:56vh}
  .talk{position:static; max-height:none; padding:12px 12px 13px;
        background:var(--paper); border-top:2px solid var(--fed)}

  .bar__when{flex:1 1 100%; margin-left:0; text-align:left; display:flex; align-items:center; gap:12px}
  .bar__when .bar__date{order:1}
  .bar__when .bar__clock{order:2}
  .bar__when .speed{order:3; margin-top:0; margin-left:auto}
  .stat{flex:1 1 72px; min-width:72px}
  .travel__btn{font-size:11px; padding:5px 8px}
  .chat__log{max-height:150px}
}

/* SETTINGS MENU - PAUSE OVERLAY & SETTINGS PANEL */
.pause-overlay{position:fixed; inset:0; background:rgba(0,0,0,.85); display:none; align-items:center; justify-content:center; z-index:100; animation:fadeInOverlay .3s ease}
.pause-overlay.is-open{display:flex}
.np{font-family:Georgia,"Times New Roman",serif;color:var(--ink,#e8e4d8)}
.np__mast{text-align:center;margin-bottom:8px}.np__mast h1{font:700 clamp(28px,6vw,44px)/1.05 "Instrument Serif",Georgia,serif;letter-spacing:.02em;margin:6px 0;text-transform:none}
.np__rule{border-top:3px double currentColor;opacity:.7}.np__dateline{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;font:11px Archivo,system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;opacity:.75;padding:4px 0}
.np__lead{font:700 clamp(22px,4.4vw,32px)/1.12 Georgia,serif;margin:10px 0 4px;text-align:center}.np__deck{text-align:center;font-style:italic;opacity:.8;margin:0 0 10px}
.np__cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:0;border-top:1px solid currentColor;margin-top:8px}
.np__col{padding:8px 12px;border-left:1px solid rgba(160,160,160,.35);font-size:14px;line-height:1.4}.np__col:first-child{border-left:0;padding-left:0}
.np__col h3{font:700 12px Archivo,system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;margin:0 0 6px;border-bottom:1px solid rgba(160,160,160,.4);padding-bottom:3px}.np__col h3 small{display:block;font:italic 11px Georgia,serif;letter-spacing:0;text-transform:none;opacity:.7}
.np__lede{font-weight:700}.np__q{font-style:italic}.np__q small{font-style:normal;opacity:.7}.np__small{list-style:none;margin:0;padding:0}.np__small li{margin:0 0 6px;font-size:13px}
.np__band{margin:14px 0 0;text-align:center;font:700 11px Archivo,system-ui,sans-serif;letter-spacing:.3em;text-transform:uppercase;border-top:3px double currentColor;padding-top:6px;opacity:.8}.np__foot{font-size:12px;opacity:.75;border-top:1px solid rgba(160,160,160,.4);padding-top:6px;margin-top:8px}

@keyframes fadeInOverlay{from{opacity:0} to{opacity:1}}
.settings-panel{background:var(--paper); border-radius:8px; box-shadow:0 20px 60px rgba(0,0,0,.9); max-width:min(600px,92vw); max-height:85vh; overflow-y:auto; animation:slideUpPanel .35s cubic-bezier(.16,.1,.3,1); display:flex; flex-direction:column}
@keyframes slideUpPanel{from{transform:translateY(20px); opacity:0} to{transform:translateY(0); opacity:1}}
.settings-header{padding:24px 28px 20px; border-bottom:2px solid var(--line); display:flex; justify-content:space-between; align-items:center}
.settings-header h1{margin:0; font-size:28px; font-family:"Instrument Serif",Georgia,serif; color:var(--ink)}
.settings-close{background:none; border:0; font-size:24px; color:var(--ink-2); cursor:pointer; padding:0; width:32px; height:32px; display:flex; align-items:center; justify-content:center; border-radius:4px; transition:all .2s}
.settings-close:hover{background:var(--surface); color:var(--ink)}
.settings-tabs{display:flex; gap:8px; padding:16px 20px; border-bottom:1px solid var(--line); overflow-x:auto}
.settings-tab{flex:0 0 auto; padding:8px 16px; background:none; border:1px solid var(--line); border-radius:4px; cursor:pointer; font-size:12px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-3); transition:all .2s}
.settings-tab:hover{border-color:var(--fed); color:var(--ink)}
.settings-tab.is-active{background:var(--ink); color:var(--paper); border-color:var(--ink)}
.settings-tab{line-height:1.25; min-height:34px}
.pz-opt{padding:8px 14px}
.pz-opt.is-picked{background:var(--ink); color:var(--paper); border-color:var(--ink)}
.settings-content{flex:1 1 auto; padding:20px 28px; overflow-y:auto}
.settings-section{display:none; animation:fadeInContent .25s ease}
.settings-section.is-open{display:block}
@keyframes fadeInContent{from{opacity:0} to{opacity:1}}
.settings-row{display:grid; grid-template-columns:minmax(120px,1fr) auto; gap:16px; align-items:center; padding:14px 0; border-bottom:1px solid var(--line-soft)}
.settings-row:last-child{border-bottom:0}
.settings-row:has(.swatch-grid){grid-template-columns:1fr}
.settings-row:has(.swatch-grid) .settings-value{width:100%; justify-content:flex-start}
.settings-label{font-size:13px; font-weight:500; color:var(--ink)}
.settings-desc{font-size:11px; color:var(--ink-3); margin-top:3px}
.settings-value{display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end}
.settings-input{padding:8px 12px; background:var(--surface); border:1px solid var(--line); border-radius:4px; color:var(--ink); font-size:12px; transition:all .2s}
.settings-input:hover{border-color:var(--ink-2)}
.settings-input:focus{outline:none; border-color:var(--fed); box-shadow:0 0 0 2px rgba(164,95,39,.2)}
.settings-slider{width:140px; cursor:pointer}
.settings-toggle{width:48px; height:28px; background:var(--line-soft); border:1px solid var(--line); border-radius:14px; cursor:pointer; position:relative; transition:all .3s; padding:2px}
.settings-toggle.is-on{background:var(--good); border-color:var(--good)}
.settings-toggle-dot{width:22px; height:22px; background:white; border-radius:50%; position:absolute; top:2px; left:2px; transition:left .3s}
.settings-toggle.is-on .settings-toggle-dot{left:calc(100% - 24px)}
.settings-select{padding:8px 12px; background:var(--surface); border:1px solid var(--line); border-radius:4px; color:var(--ink); font-size:12px; cursor:pointer; transition:all .2s}
.settings-select:hover{border-color:var(--ink-2)}
.settings-select:focus{outline:none; border-color:var(--fed)}
.char-preview{display:flex; gap:16px; flex-direction:column; padding:20px; background:var(--surface); border:1px solid var(--line); border-radius:6px; margin-bottom:20px}
.char-preview-info{font-size:13px; line-height:1.5}
.char-preview-info b{display:block; font-size:14px; font-weight:600; margin-bottom:4px}
.swatch-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(42px,1fr)); gap:8px; margin:8px 0; width:100%; max-width:420px}
.swatch-item{width:100%; aspect-ratio:1; border-radius:4px; border:2px solid transparent; cursor:pointer; transition:all .2s; position:relative}
.swatch-item:hover{border-color:var(--fed)}
.swatch-item.is-selected{border-color:var(--fed); box-shadow:0 0 0 2px var(--paper), 0 0 0 4px var(--fed)}
.swatch-item-label{position:absolute; bottom:3px; left:50%; transform:translateX(-50%); font-size:9px; color:white; text-shadow:0 1px 2px rgba(0,0,0,.5); text-align:center; width:100%; pointer-events:none}
.settings-section-title{font-family:"Instrument Serif",Georgia,serif; font-size:18px; margin:0 0 16px; color:var(--ink)}
.settings-footer{display:flex; gap:10px; padding:20px 28px; border-top:1px solid var(--line); justify-content:flex-end}
.settings-btn{padding:10px 20px; border-radius:4px; border:1px solid var(--line); font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:.08em; cursor:pointer; transition:all .2s}
.settings-btn-primary{background:var(--ink); color:var(--paper); border-color:var(--ink)}
.settings-btn-primary:hover{background:var(--ink-2)}
.settings-btn-secondary{background:transparent; color:var(--ink)}
.settings-btn-secondary:hover{background:var(--surface); border-color:var(--fed)}
.stat-box{background:var(--surface); border:1px solid var(--line); border-radius:4px; padding:12px; text-align:center}
.stat-box-label{font-size:10px; color:var(--ink-3); text-transform:uppercase; letter-spacing:.08em}
.stat-box-value{font-size:16px; font-weight:600; font-family:"JetBrains Mono",monospace; margin-top:4px}
</style>

<div class="shell">
  <header class="bar">
    <div class="bar__me"><div class="bar__name" id="hName">—</div><div class="bar__sub" id="hSub"></div></div>
    <div class="bar__when">
      <div class="bar__date" id="hDate">—</div>
      <div class="bar__clock" id="hClock">8:00</div>
      <div class="speed" id="speed">
        <button type="button" id="btnPause" title="Pause (space)" aria-label="Pause">II</button>
        <button type="button" id="btnMenu" title="Open game menu" aria-label="Open game menu">Menu</button>
        <button type="button" data-s="1" class="is-on" title="Normal">1&times;</button>
        <button type="button" data-s="2" title="Double">2&times;</button>
        <button type="button" data-s="4" title="Fast">4&times;</button>
      </div>
    </div>
    <div class="bar__stats" id="hStats"></div>
    <div class="bar__congress"><i id="hSess">Session</i><b id="hCong">—</b></div>
  </header>

  <div class="grid">
    <div>
      <section class="stage">
        <div class="scene" id="scene"><div class="boot" id="boot">Building the chamber…</div></div>
        <div class="hud"><i id="whereTag">Location</i><b id="whereName">—</b></div>
        <div class="aims" id="aimsHud" hidden tabindex="0" aria-label="Today's aims"><i>Today's aims</i><b id="aimsNext"></b><div class="aims__all" id="aimsAll"></div></div>
        <div class="compass" id="compass" aria-hidden="true"><div class="compass__rail"></div><i class="compass__n">N</i><div id="compassTicks"></div></div>
        <div class="job" id="job" hidden><i>NOW</i><b id="jobText"></b></div>
        <div class="savepip" id="savePip">Saved</div>
        <div class="keys" id="keysTips" aria-hidden="true">
          <span class="kbd">W S — walk</span><span class="kbd">A D — look</span><span class="kbd">Q C — step aside</span>
          <span class="kbd">drag — look</span><span class="kbd">E — speak / use / catch / deliver</span><span class="kbd">1–9 — prompts</span><span class="kbd">space — pause</span><span class="kbd">F — phone</span><span class="kbd">hold V — speak aloud</span><span class="kbd">H — panels</span>
        </div>
        <div class="track" id="track" hidden><div class="track__box">
          <i class="track__c track__c--tl"></i><i class="track__c track__c--tr"></i>
          <i class="track__c track__c--bl"></i><i class="track__c track__c--br"></i>
          <div class="track__tag" id="trackTag"></div>
        </div></div>
        <div class="grade"></div>
        <div class="grain" id="grain"></div>
        <div class="feed" id="feed"></div>
        <div class="tele" id="tele"></div>
        <div class="veilfade" id="fade"></div>
        <div class="prompt" id="prompt" hidden></div>
        <div class="hail" id="hail" hidden></div>
        <div class="proc" id="procBar" hidden></div>
        <div class="tipcard" id="tipCard" hidden></div>
        <div class="heard" id="heardFlash" aria-live="polite"></div>
        <button type="button" class="aloud-btn" id="aloudBtn" title="Speak aloud into the room (hold V or hold X on pad)">Speak Aloud</button>
        <div class="mic" id="micBar" hidden><i></i><span id="micText"></span></div>
        <div class="padbar" id="padBar" hidden></div>
        <div class="ui-toolbar" id="uiToolbar" aria-label="Open panels">
          <button type="button" id="uiOpenBtn" title="House panels on the phone: bills, mail, the count. Key H. Pad: RB.">Panels (H)</button>
          <button type="button" id="uiMapBtn" title="Travel to any room. Key M.">Map (M)</button>
          <button type="button" id="uiWalkOut" title="Leave this room without wiping the sitting">Walk out</button>
          <button type="button" id="uiPurseBtn" title="Your purse: your own money, not the war chest">ƒ</button>
          <button type="button" id="uiGalleryBtn" title="Sit in and watch a sitting">Gallery</button>
          <button type="button" id="uiPaperBtn" title="Read the Capitol Ledger">Ledger</button>
          <button type="button" id="uiWarMapBtn" title="The world: where each power lies, the toll, the battles, and the delegations waiting on you">World</button>
          <button type="button" id="uiOfficesBtn" title="Who holds each office, who held it, and what each is for">Offices</button>
          <button type="button" id="uiSettingsBtn" title="Pause, save, settings. Key Esc.">⚙ Menu (Esc)</button>
        </div>
        <button type="button" class="unbare" id="unBare" title="Show the display (H)" hidden>▤</button>
        <div class="proclog" id="procLog"></div>
        <div class="talk" id="talk" role="dialog" aria-label="Conversation">
          <div class="talk__head">
            <div class="talk__who"><div class="talk__name" id="tkName">—</div><div class="talk__meta" id="tkMeta"></div></div>
            <div class="talk__feel"><i>In the room</i><b id="tkMood">—</b><div class="talk__bars" id="tkBars" hidden></div></div>
          </div>
          <div class="talk__say" id="tkSay"></div>
          <div class="talk__note" id="tkNote"></div>
          <div class="talk__think" id="tkThink" hidden></div>
          <div class="talk__acts" id="tkActs"></div>
          <div class="chat" id="chat" hidden>
            <div class="chat__suggest" id="chatSuggest"></div>
            <div class="chat__meta">
              <button class="linkish" type="button" id="chatPrompt" hidden>Show what gets sent</button>
              <button class="linkish" type="button" id="chatThink" hidden>Ask what they're really thinking</button>
              <span id="chatState"></span>
            </div>
            <pre class="chat__raw" id="chatRaw" hidden></pre>
            <details class="logbox" id="logBox">
              <summary id="logTab">Transcript</summary>
              <div class="chat__log" id="chatLog"></div>
            </details>
          </div>
        </div>
      </section>
      <nav class="travel" id="travel" aria-label="Travel"></nav>
    </div>

    <aside class="dossier">
      <div class="tabs" role="tablist">
        <button type="button" class="is-on" data-pane="paneFloor">Floor</button>
        <button type="button" data-pane="paneMembers">Members</button>
        <button type="button" data-pane="paneInbox" id="tabInbox">Inbox</button>
        <button type="button" data-pane="paneVox">Vox</button>
        <button type="button" data-pane="paneBook">Record</button>
        <button type="button" data-pane="paneUnion">Union</button>
        <button type="button" data-pane="paneRisks">Risks</button>
        <button type="button" data-pane="paneJournal">Journal</button>
        <button type="button" data-pane="paneCareer">Career</button>
      </div>
      <div class="pane is-on" id="paneFloor"></div>
      <div class="pane" id="paneMembers"></div>
      <div class="pane" id="paneInbox"></div>
      <div class="pane" id="paneVox"></div>
      <div class="pane" id="paneBook"></div>
      <div class="pane" id="paneUnion"></div>
      <div class="pane" id="paneRisks"></div>
      <div class="pane" id="paneJournal"></div>
      <div class="pane" id="paneCareer"></div>
    </aside>
  </div>

  <div id="wireHome"></div>
  <footer class="wire" id="wire">
    <select class="wire__to" id="wireTo" aria-label="Who you are addressing"></select>
    <input class="wire__in" id="wireIn" type="text" maxlength="400" autocomplete="off"
           placeholder="Say something — to whoever is in front of you, or anyone else">
    <span class="wire__how" id="wireHow"></span>
    <button class="chat__btn chat__btn--mic" type="button" id="wireMic" title="Hold V to speak">Speak</button>
    <button class="chat__btn" type="button" id="wireSend">Send</button>
    <button class="chat__btn chat__btn--ghost" type="button" id="wireStop" hidden>Stop</button>
    <span class="wire__state" id="wireState"></span>
  </footer>
  <div class="tick" id="tick">
    <div class="tick__tag">The Wire</div>
    <div class="tick__win"><div class="tick__run" id="tickRun"></div></div>
  </div>
</div>

<div class="veil" id="veil"><div class="card" id="card"></div></div>

<!-- SETTINGS MENU PAUSE OVERLAY -->
<div class="pause-overlay" id="pauseOverlay">
  <div class="settings-panel">
    <div class="settings-header">
      <h1>⏸ Game Paused</h1>
      <button class="settings-close" id="closeSettings" title="Close (ESC)">✕</button>
    </div>
    <div class="settings-tabs">
      <button class="settings-tab is-active" data-tab="game">Game</button>
      <button class="settings-tab" data-tab="graphics">Graphics</button>
      <button class="settings-tab" data-tab="audio">Audio</button>
      <button class="settings-tab" data-tab="controls">Controls</button>
      <button class="settings-tab" data-tab="character">Character</button>
    </div>
    <div class="settings-content">
      <!-- GAME SETTINGS TAB -->
      <div class="settings-section is-open" data-section="game">
        <h3 class="settings-section-title">Game Settings</h3>
        <div class="settings-row">
          <div><div class="settings-label">Game Speed</div><div class="settings-desc">1x, 2x, 4x</div></div>
          <div class="settings-value" id="speedControls">
            <button class="settings-btn settings-btn-secondary" data-speed="1">1×</button>
            <button class="settings-btn settings-btn-secondary" data-speed="2">2×</button>
            <button class="settings-btn settings-btn-secondary" data-speed="4">4×</button>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Difficulty</div><div class="settings-desc">Impact on relationships</div></div>
          <div class="settings-value">
            <select class="settings-select" id="difficulty">
              <option value="easy">Easy - Forgiving</option>
              <option value="normal" selected>Normal - Balanced</option>
              <option value="hard">Hard - Unforgiving</option>
            </select>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Auto-Save</div><div class="settings-desc">Save every 8 minutes</div></div>
          <div class="settings-value">
            <div class="settings-toggle is-on" id="autoSave">
              <div class="settings-toggle-dot"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- GRAPHICS SETTINGS TAB -->
      <div class="settings-section" data-section="graphics">
        <h3 class="settings-section-title">Graphics Settings</h3>
        <div class="settings-row">
          <div><div class="settings-label">Quality</div><div class="settings-desc">Visual fidelity level</div></div>
          <div class="settings-value">
            <select class="settings-select" id="graphicsQuality">
              <option value="simple">Simple - Fast</option>
              <option value="balanced" selected>Balanced - Recommended</option>
              <option value="best">Best - Maximum Detail</option>
            </select>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Shadows</div><div class="settings-desc">Dynamic shadow rendering</div></div>
          <div class="settings-value">
            <div class="settings-toggle is-on" id="shadowsToggle">
              <div class="settings-toggle-dot"></div>
            </div>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Bloom Effect</div><div class="settings-desc">Light glow and halo</div></div>
          <div class="settings-value">
            <div class="settings-toggle is-on" id="bloomToggle">
              <div class="settings-toggle-dot"></div>
            </div>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Antialiasing</div><div class="settings-desc">Smooth edges</div></div>
          <div class="settings-value">
            <select class="settings-select" id="antialiasing">
              <option value="off">Off</option>
              <option value="msaa2x">2x MSAA</option>
              <option value="msaa4x" selected>4x MSAA</option>
            </select>
          </div>
        </div>
      </div>

      <!-- AUDIO SETTINGS TAB -->
      <div class="settings-section" data-section="audio">
        <h3 class="settings-section-title">Audio Settings</h3>
        <div class="settings-row">
          <div><div class="settings-label">Master Volume</div><div class="settings-desc">Overall sound level</div></div>
          <div class="settings-value">
            <input type="range" min="0" max="100" value="80" class="settings-slider" id="masterVolume">
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Voice Volume</div><div class="settings-desc">Character voices</div></div>
          <div class="settings-value">
            <input type="range" min="0" max="100" value="85" class="settings-slider" id="voiceVolume">
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Sound Effects</div><div class="settings-desc">UI and ambient sounds</div></div>
          <div class="settings-value">
            <input type="range" min="0" max="100" value="70" class="settings-slider" id="sfxVolume">
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">3D Positional Audio</div><div class="settings-desc">Voices further away are quieter</div></div>
          <div class="settings-value">
            <div class="settings-toggle is-on" id="spatialAudio">
              <div class="settings-toggle-dot"></div>
            </div>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Text-to-Speech</div><div class="settings-desc">Speak aloud option</div></div>
          <div class="settings-value">
            <div class="settings-toggle is-on" id="ttsToggle">
              <div class="settings-toggle-dot"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- CONTROLS SETTINGS TAB -->
      <div class="settings-section" data-section="controls">
        <h3 class="settings-section-title">Control Settings</h3>
        <div class="settings-row">
          <div><div class="settings-label">Mouse Sensitivity</div><div class="settings-desc">Look speed</div></div>
          <div class="settings-value">
            <input type="range" min="0.1" max="2" value="1" step="0.1" class="settings-slider" id="mouseSensitivity">
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Invert Mouse Y</div><div class="settings-desc">Reverse look up/down</div></div>
          <div class="settings-value">
            <div class="settings-toggle" id="invertMouseY">
              <div class="settings-toggle-dot"></div>
            </div>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Walk Speed</div><div class="settings-desc">Movement pace</div></div>
          <div class="settings-value">
            <select class="settings-select" id="walkSpeed">
              <option value="slow">Slow - Careful</option>
              <option value="normal" selected>Normal - Default</option>
              <option value="fast">Fast - Brisk</option>
            </select>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Gamepad Mode</div><div class="settings-desc">Controller support</div></div>
          <div class="settings-value">
            <div class="settings-toggle" id="gamepadMode">
              <div class="settings-toggle-dot"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- CHARACTER CUSTOMIZATION TAB -->
      <div class="settings-section" data-section="character">
        <h3 class="settings-section-title">Character Appearance</h3>
        <div class="char-preview">
          <div class="char-preview-info">
            <b id="charName">Your Character</b>
            <span id="charStats">Republican • House District 3</span>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Skin Tone</div></div>
          <div class="settings-value">
            <div class="swatch-grid" id="skinToneGrid">
              <div class="swatch-item is-selected" style="background:#c9a586" data-value="fair" title="Fair"></div>
              <div class="swatch-item" style="background:#c49566" data-value="light-tan" title="Light Tan"></div>
              <div class="swatch-item" style="background:#a87d56" data-value="tan" title="Tan"></div>
              <div class="swatch-item" style="background:#8b6f47" data-value="medium" title="Medium"></div>
              <div class="swatch-item" style="background:#704e34" data-value="deep" title="Deep"></div>
              <div class="swatch-item" style="background:#5a3d2a" data-value="dark" title="Dark"></div>
            </div>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Hair Color</div></div>
          <div class="settings-value">
            <div class="swatch-grid" id="hairColorGrid">
              <div class="swatch-item is-selected" style="background:#5a3d2a" data-value="black" title="Black"></div>
              <div class="swatch-item" style="background:#6b4423" data-value="dark-brown" title="Dark Brown"></div>
              <div class="swatch-item" style="background:#8b6f47" data-value="brown" title="Brown"></div>
              <div class="swatch-item" style="background:#a89968" data-value="light-brown" title="Light Brown"></div>
              <div class="swatch-item" style="background:#d4a574" data-value="blonde" title="Blonde"></div>
              <div class="swatch-item" style="background:#c9a586" data-value="red" title="Red"></div>
              <div class="swatch-item" style="background:#e8e8e8" data-value="grey" title="Grey"></div>
              <div class="swatch-item" style="background:#f0f0f0" data-value="white" title="White"></div>
            </div>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Eye Color</div></div>
          <div class="settings-value">
            <div class="swatch-grid" id="eyeColorGrid">
              <div class="swatch-item is-selected" style="background:#5a3d2a" data-value="brown" title="Brown"></div>
              <div class="swatch-item" style="background:#36526b" data-value="blue" title="Blue"></div>
              <div class="swatch-item" style="background:#4a7566" data-value="green" title="Green"></div>
              <div class="swatch-item" style="background:#8b6f47" data-value="hazel" title="Hazel"></div>
              <div class="swatch-item" style="background:#2a2a2a" data-value="black" title="Black"></div>
            </div>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Body Type</div></div>
          <div class="settings-value">
            <select class="settings-select" id="bodyType">
              <option value="slim" selected>Slim</option>
              <option value="athletic">Athletic</option>
              <option value="average">Average</option>
              <option value="stocky">Stocky</option>
            </select>
          </div>
        </div>
        <div class="settings-row">
          <div><div class="settings-label">Outfit Style</div></div>
          <div class="settings-value">
            <select class="settings-select" id="outfitStyle">
              <option value="formal" selected>Formal Suit</option>
              <option value="business-casual">Business Casual</option>
              <option value="distinguished">Distinguished</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <div class="settings-footer">
      <button class="settings-btn settings-btn-secondary" id="resetSettings">Reset to Defaults</button>
      <button class="settings-btn settings-btn-primary" id="resumeGame">Resume Game</button>
    </div>
  </div>
</div>

