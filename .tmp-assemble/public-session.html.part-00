  #card { z-index: 9996 !important; padding-bottom: calc(130px + env(safe-area-inset-bottom)) !important; }
  body:has(#veil:not([hidden])) .dossier .tabs { display: none !important; }
  #pbPhone { z-index: 9997 !important; }
  body.ui-open .dossier .tabs { z-index: 9998 !important; }
