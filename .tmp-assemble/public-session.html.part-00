function applySimple(){ applyQuality(); }
renderer.shadowMap.autoUpdate = false;

renderer.shadowMap.needsUpdate = true;
let shadowT = 0;
let _movePrOn = false, _movePrSaved = 0;
function shadowTick(dt){
  if(!renderer.shadowMap.enabled) return;
  shadowT -= dt;
  if(shadowT <= 0){ shadowT = SHADOW_PERIOD || 1/12; renderer.shadowMap.needsUpdate = true; }
}

if(sceneEl) sceneEl.appendChild(renderer.domElement);
try{ const bootEl = el("boot"); if(bootEl) bootEl.remove(); }catch(e){}

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(58, 16/10, 0.08, 120);
let roomGroup = new THREE.Group(); scene.add(roomGroup); /* 20261011a: let — warmAhead swaps in a kit while it builds */
const peopleGroup = new THREE.Group(); scene.add(peopleGroup);

const hemi = new THREE.HemisphereLight(0xdfe6f0, 0x3a3630, 0.55);
scene.add(hemi);
const sun = new THREE.DirectionalLight(0xfff0dc, 1.6);
sun.castShadow = true;
sun.shadow.mapSize.set(512,512);
sun.shadow.bias = -0.00028;
sun.shadow.normalBias = 0.04;
sun.shadow.radius = 1.6;
scene.add(sun); scene.add(sun.target);
const lamp = new THREE.PointLight(0xffd9a0, 0.0, 26, 2);
scene.add(lamp);
const fill = new THREE.PointLight(0xcfe0ff, 0.25, 30, 2);
scene.add(fill);
if(MODEST){
  try{ fill.intensity = 0.55; lamp.distance = 18; lamp.intensity = Math.max(lamp.intensity || 0, 0.7); sun.castShadow = false; }catch(e){}
}

/* ── procedural textures ─────────────────────────────────── */
function texSize(full){
  /* Max-opt fullDetail always uses the full map; otherwise follow the preset. */
  if(G.fullDetail || G.gfx === "best") return full;
  if(G.gfx === "simple") return Math.max(64, full >> 1);
  if(G.gfx === "balanced") return full >= 256 ? 192 : full;
  return full;
}
function texCanvas(size, paint){
  const c = document.createElement("canvas");
  c.width = c.height = size;
  paint(c.getContext("2d", {willReadFrequently:true}), size);
  const t = new THREE.CanvasTexture(c);
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.encoding = THREE.sRGBEncoding;
  /* MAX OPT 20260921b: Simple only skips mip/anisotropy. Best keeps mips even on MODEST. */
  const cheap = G.gfx === "simple";
  if(cheap){
    t.generateMipmaps = false;
    t.minFilter = THREE.LinearFilter;
    t.magFilter = THREE.LinearFilter;
    t.anisotropy = 1;
    return t;
  }
  try{
    let cap = (G.fullDetail || G.gfx === "best") ? (FULLPOWER ? 16 : 8) : 4;
    /* 20260928a: while walking, newly created textures only — cap anisotropy at 2 (no full-texture walk). */
    try{
      const feet = (typeof playerMoving === "function" && playerMoving())
        || (typeof houseQuiet === "function" && houseQuiet() && cam && Math.hypot(cam.vx||0, cam.vz||0) > 0.12)
        || (cam && Math.hypot(cam.vx||0, cam.vz||0) > 0.12);
      if(feet){ cap = Math.min(cap, 2); try{ (window.__texCapped = window.__texCapped || []).push(t); if(window.__texCapped.length > 400) window.__texCapped.shift(); }catch(e3){} }
    }catch(e2){}
    t.anisotropy = (typeof renderer !== "undefined" && renderer && renderer.capabilities)
      ? Math.min(cap, renderer.capabilities.getMaxAnisotropy()) : Math.min(cap, 2);
  }catch(e){ t.anisotropy = 2; }
  t.minFilter = THREE.LinearMipmapLinearFilter;
  t.magFilter = THREE.LinearFilter;
  t.generateMipmaps = true;
  return t;
}
function dressMip(t){
  /* Naval: every map gets a mip chain so walls/flags/faces don't crawl. */
  if(!t) return t;
  try{
    t.generateMipmaps = true;
    t.minFilter = THREE.LinearMipmapLinearFilter;
    t.magFilter = THREE.LinearFilter;
    if(typeof renderer !== "undefined" && renderer && renderer.capabilities){
      t.anisotropy = Math.min(4, renderer.capabilities.getMaxAnisotropy() || 1);
    }
    t.needsUpdate = true;
  }catch(e){}
