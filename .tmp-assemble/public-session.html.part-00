const FACE_DOME = faceDome(16, 18);
const FACE_DOME_LO = faceDome(10, 12);

/* Body parts: tapered sections and joints, so limbs read as limbs. */
const PG = {
  box:  new THREE.BoxGeometry(1,1,1),
  sph:  new THREE.SphereGeometry(0.5,20,16),
  arm:  new THREE.CylinderGeometry(0.40,0.50,1,18),
  arm2: new THREE.CylinderGeometry(0.32,0.44,1,18),
  leg:  new THREE.CylinderGeometry(0.44,0.52,1,18),
  leg2: new THREE.CylinderGeometry(0.34,0.46,1,18),
  chest:new THREE.CylinderGeometry(0.54,0.42,1,24),
  waist:new THREE.CylinderGeometry(0.44,0.50,1,20),
  neck: new THREE.CylinderGeometry(0.42,0.50,1,16),
  skirt:new THREE.CylinderGeometry(0.44,0.66,1,28),
  cone: new THREE.ConeGeometry(0.5,1,10),
  ring: new THREE.TorusGeometry(0.40,0.05,8,16),
  plane:new THREE.PlaneGeometry(1,1)
};
/* ── Normal maps, derived from the textures themselves ─────
   Every surface gets real relief: the grain in the oak, the
   veins in the marble, the seams in the lino, the weave in the
   carpet. This is most of what separates a flat render from a
   lit one. */
const NORMALS = new Map();
function normalMapFrom(tex, strength){
  if(NORMALS.has(tex)) return NORMALS.get(tex);
  const src = tex.image, s = src.width;
  let data;
  try{ data = src.getContext("2d").getImageData(0,0,s,s).data; }
  catch(e){ NORMALS.set(tex, null); return null; }
  const out = document.createElement("canvas"); out.width = out.height = s;
  const octx = out.getContext("2d"), od = octx.createImageData(s,s);
  const lum = i => (data[i*4]*0.3 + data[i*4+1]*0.59 + data[i*4+2]*0.11)/255;
  const k = strength === undefined ? 2.0 : strength;  /* slightly softer relief; boot-cached */
  for(let y=0;y<s;y++){
    for(let x=0;x<s;x++){
      const i = y*s + x;
      const lx = lum(y*s + ((x+1)%s)) - lum(y*s + ((x-1+s)%s));
      const ly = lum(((y+1)%s)*s + x) - lum(((y-1+s)%s)*s + x);
      let nx = -lx*k, ny = -ly*k;
      const len = Math.sqrt(nx*nx + ny*ny + 1);
      od.data[i*4]   = (nx/len*0.5 + 0.5)*255;
      od.data[i*4+1] = (ny/len*0.5 + 0.5)*255;
      od.data[i*4+2] = (1/len*0.5 + 0.5)*255;
      od.data[i*4+3] = 255;
    }
