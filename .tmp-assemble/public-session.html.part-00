  #apToast { left: 8px !important; right: 8px !important; transform: none !important; max-width: none !important; bottom: calc(68px + env(safe-area-inset-bottom)) !important; font-size: 15px !important; }
  .hud, #uiToolbar { padding-top: env(safe-area-inset-top); padding-left: env(safe-area-inset-left); flex-wrap: wrap; }
  #uiToolbar button { min-height: 40px; font-size: 14px !important; }
  .gloss { font-size: inherit; } [class*="tip"] { font-size: 15px !important; max-width: 92vw !important; }
  p, li, small, .muted, .pc__m, .dream, .sx-l, .sx-p, .ltc-m { font-size: max(14px, 1em) !important; }
}
@media (max-height: 500px) and (orientation: landscape) {
