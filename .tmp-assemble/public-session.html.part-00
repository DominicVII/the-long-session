    sun.shadow.radius = q === "best" ? (FULLPOWER ? 2.2 : 1) : (q === "balanced" ? 1.2 : 1);
    if(q === "best" && FULLPOWER){ sun.shadow.bias = -0.00018; sun.shadow.normalBias = 0.02; }
