        /* leave intentionally non-casting detail (buttons) alone if already false
           and mesh is tiny — only promote/demote primary casters by flag */
        if(PEOPLE_CAST_SHADOW){
          if(o.geometry){
            if(!o.geometry.boundingSphere) o.geometry.computeBoundingSphere();
