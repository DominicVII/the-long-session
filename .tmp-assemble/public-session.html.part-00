    for(const n in TEX){ if(TEX[n] && TEX[n].uuid === id){ k = n; break; } }
    m.envMapIntensity = k === "marble" ? 0.75 : k === "oak" || k === "panel" ? 0.5 : (k === "carpet" || k === "rug" || k === "wool") ? 0.12 : 0.3;
