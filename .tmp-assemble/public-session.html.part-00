}catch(e){}
renderer.sortObjects = false;
if(MODEST){
  renderer.toneMapping = THREE.NoToneMapping;
  renderer.toneMappingExposure = 1;
} else {
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.0;
}
renderer.shadowMap.enabled = !MODEST;
renderer.shadowMap.type = THREE.PCFShadowMap;
/* Context loss must not leave the view in a sticky panic banner. */
let GL_LOST = false, GL_RECOVERING = false;
renderer.domElement.addEventListener("webglcontextlost", ev => {
  try{ ev.preventDefault(); }catch(e){}
  GL_LOST = true;
  if(window.console) console.warn("webgl context lost — waiting to restore");
}, false);
renderer.domElement.addEventListener("webglcontextrestored", () => {
  try{ SSAO.rt = null; }catch(e){}   /* 20261030ap */
  GL_LOST = false; GL_RECOVERING = true;
  try{
    renderer.shadowMap.needsUpdate = true;
    if(typeof applyQuality === "function") applyQuality();
    if(G && G.room && typeof buildRoom === "function"){
      buildRoom(G.room);
      if(typeof syncPeopleStaged === "function"){
        syncPeopleStaged();
      } else if(typeof syncPeople === "function"){
        syncPeople();
      }
    }
    if(window.console) console.info("[WebGL] Context restored, room rebuilt");
  }catch(e){
    if(window.console) {
      console.warn("webgl restore", e);
      console.error("[WebGL] Restore failed:", e.message || e);
    }
  }
  GL_RECOVERING = false;
  if(window.console) console.info("webgl context restored");
}, false);
/* The shadow pass is a second render of the whole room. Half the rate is
   indistinguishable from all of it and gives the main pass its time back;
   go much below that and shadows start trailing behind the feet. */
/* When a shader will not build, the graphics driver says so and three.js
   throws it at the console where nobody looks — and the page carries on
   drawing people as slabs, because that is what a vertex shader does
   when it has been handed something it cannot run. Catch it, say so on
   screen, and drop into a mode the machine can actually manage. */
let SHADER_TROUBLE = null;
