/* ── environment: a softly lit room with windows, prefiltered once ── */
function nmEnvBuild(){
  if(NM.env || nmTier() === 0) return;
  try{
    const es = new THREE.Scene();
    const geo = new THREE.SphereGeometry(10, 24, 12);
    const cols = [], p = geo.attributes.position;
    for(let i = 0; i < p.count; i++){
      const y = p.getY(i) / 10;
      const c = y > 0 ? new THREE.Color(0.55, 0.60, 0.68).lerp(new THREE.Color(0.95, 0.96, 1.0), y)
                      : new THREE.Color(0.30, 0.26, 0.22).lerp(new THREE.Color(0.10, 0.09, 0.08), -y);
      cols.push(c.r, c.g, c.b);
    }
    geo.setAttribute("color", new THREE.Float32BufferAttribute(cols, 3));
    es.add(new THREE.Mesh(geo, new THREE.MeshBasicMaterial({vertexColors:true, side:THREE.BackSide})));
    const lamp = (x, y, z, w, h, k) => {
      const mm = new THREE.MeshBasicMaterial({side:THREE.DoubleSide}); mm.color.setRGB(k, k * 0.96, k * 0.88);
      const q = new THREE.Mesh(new THREE.PlaneGeometry(w, h), mm); q.position.set(x, y, z); q.lookAt(0, 0, 0); es.add(q);
    };
    lamp(0, 7, 0, 6, 3, 2.2);  lamp(8, 2.5, 0, 2.5, 3.5, 3.0); lamp(-8, 2.5, 2, 2.5, 3.5, 2.4); lamp(0, 3, -8.5, 5, 1.5, 1.6);
    geo.dispose();
    NM.env = ndEnvCube();
    /* 20261012a: reflections only where they read (metal, glass, gloss, varnish, wet street), not on every wall */
    NM.bytes += 256 * 256 * 6 * 8;
  }catch(e){ if(window.console) console.warn("env", e); }
}
/* materials made before this pass, or made directly, get their reflection strength once */
/* 20261030ag: realism for the character module's people. Skin gets a warmer under-skin glow and loses wax shine;
   suits and dresses (flat colour + weave normal) get a deeper weave and a soft fabric sheen. Materials only, once each. */
/* 20261030ag: room-distance realism maps (multiply over the authored colour). Canvas, seeded, built once. */
const W30 = {};
function w30Canvas(sz, fn){ const c = document.createElement("canvas"); c.width = c.height = sz; const x = c.getContext("2d"); let sd = 11; const r = () => { sd = (sd * 16807) % 2147483647; return sd / 2147483647; }; fn(x, sz, r); const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping; try{ t.encoding = THREE.sRGBEncoding; t.anisotropy = 4; }catch(e){} return t; }
function w30Blot(x, s, r, n, rad, cols){ for(let i = 0; i < n; i++){ const px = r() * s, py = r() * s, R = rad * (0.4 + r()); const g = x.createRadialGradient(px, py, 0, px, py, R); const c = cols[(r() * cols.length) | 0]; g.addColorStop(0, c); g.addColorStop(1, "rgba(0,0,0,0)"); x.fillStyle = g; x.fillRect(px - R, py - R, R * 2, R * 2); } }
function w30Sand(){ return W30.sand || (W30.sand = w30Canvas(256, (x, s, r) => {
  x.fillStyle = "#efe2c8"; x.fillRect(0, 0, s, s);
  w30Blot(x, s, r, 90, 40, ["rgba(186,150,98,0.35)", "rgba(255,246,226,0.35)", "rgba(160,124,80,0.25)"]);
  for(let i = 0; i < 2600; i++){ x.fillStyle = r() < 0.5 ? "rgba(120,92,60,0.25)" : "rgba(255,250,236,0.3)"; x.fillRect(r() * s, r() * s, 1.2, 1.2); }
  for(let row = 0; row < 4; row++) for(let k = 0; k < 2; k++){ const xx = ((row % 2) * 64 + k * 128) % s; x.fillStyle = "rgba(" + (150 + (r() * 60 | 0)) + "," + (118 + (r() * 40 | 0)) + ",80," + (0.12 + r() * 0.16).toFixed(2) + ")"; x.fillRect(xx, row * 64, 128, 64); x.fillRect(xx - s, row * 64, 128, 64); }   /* 20261030ag: each block its own tone */
  x.strokeStyle = "rgba(78,56,36,0.95)"; x.lineWidth = 4.6;   /* 20261030ag: mortar courses that read across the square */
  for(let row = 0; row < 4; row++){ const y = row * 64 + 0.8; x.beginPath(); x.moveTo(0, y); x.lineTo(s, y); x.stroke();
    for(let k = 0; k < 2; k++){ const xx = ((row % 2) * 64 + k * 128) % s; x.beginPath(); x.moveTo(xx, y); x.lineTo(xx, y + 64); x.stroke(); } }
})); }
function w30Cloth(){ return W30.cloth || (W30.cloth = w30Canvas(128, (x, s, r) => {
  x.fillStyle = "#e6e6e6"; x.fillRect(0, 0, s, s);
  for(let y = 0; y < s; y++) for(let k = -s; k < s; k += 4){ x.fillStyle = (((k / 4) | 0) % 2) ? "rgba(255,255,255,0.22)" : "rgba(0,0,0,0.20)"; x.fillRect(k + y, y, 2, 1); }
  w30Blot(x, s, r, 26, 26, ["rgba(0,0,0,0.16)", "rgba(255,255,255,0.14)"]);
})); }
function w30Skin(){ return W30.skin || (W30.skin = w30Canvas(128, (x, s, r) => {
  x.fillStyle = "#f4ecea"; x.fillRect(0, 0, s, s);
  w30Blot(x, s, r, 40, 18, ["rgba(214,120,110,0.22)", "rgba(255,236,220,0.25)", "rgba(170,110,90,0.16)"]);
  for(let i = 0; i < 1400; i++){ x.fillStyle = "rgba(120,70,60," + (0.10 + r() * 0.18).toFixed(2) + ")"; x.fillRect(r() * s, r() * s, 1, 1); }
})); }
function w30Rep(t, n){ const c = t.clone(); c.needsUpdate = true; c.repeat.set(n, n); return c; }
/* 20261030ag: skin light. Red bleed into the shadow side, darker form at grazing angles, peach-fuzz rim. */
function x30ClothShader(m){   /* 20261030ag: world-space room key + fold creases so suits read as cloth, not slabs */
  if(m.userData.ag30c) return; m.userData.ag30c = 1;
  const prev = m.onBeforeCompile;
  m.onBeforeCompile = (sh, r) => { try{ if(prev) prev(sh, r); }catch(e){}
    const K = "vec3 outgoingLight = reflectedLight.directDiffuse + reflectedLight.indirectDiffuse + reflectedLight.directSpecular + reflectedLight.indirectSpecular + totalEmissiveRadiance;";
    if(sh.fragmentShader.indexOf(K) < 0) return;
    sh.fragmentShader = sh.fragmentShader.replace(K, K + `
    { vec3 agwn = inverseTransformDirection(normalize(normal), viewMatrix); float agk = dot(agwn, normalize(vec3(-0.35, 0.8, 0.45)));
      outgoingLight *= mix(0.4, 1.26, smoothstep(-0.4, 0.8, agk)); float amc = inverseTransformDirection(normalize(normal), viewMatrix).y; outgoingLight *= mix(0.55, 1.0, smoothstep(-0.75, 0.25, amc));   /* 20261030am: directional ambient occlusion: under-chin, under-arm, under-brim, jacket underside fall into shade */   /* 20261030aj: break flat fill harder */   /* 20261030ai: harder world key on bodies */ { float agnv = clamp(dot(normalize(normal), normalize(vViewPosition)), 0.0, 1.0); outgoingLight *= mix(0.7, 1.0, smoothstep(0.0, 0.45, agnv)); outgoingLight += diffuseColor.rgb * vec3(0.4, 0.37, 0.32) * pow(1.0 - agnv, 2.5) * smoothstep(0.0, 0.8, agk) + diffuseColor.rgb * vec3(0.08, 0.1, 0.14) * pow(1.0 - agnv, 3.0);   /* 20261030ak: stronger body rim + cool back rim */ }   /* 20261030ai: part-edge AO + key-side rim */
      #if defined( USE_MAP ) || defined( USE_UV )
      float agf = pow(abs(sin(vUv.y * 31.0 + 2.6 * sin(vUv.x * 6.0 + vUv.y * 3.0))), 7.0); outgoingLight *= 1.0 - 0.3 * agf; float agb = pow(abs(sin(vUv.y * 72.0 + 1.3 * sin(vUv.x * 11.0))), 14.0); outgoingLight *= 1.0 - 0.22 * agb; float agd = pow(abs(sin(vUv.x * 9.0 + 1.7 * sin(vUv.y * 4.0 + vUv.x * 2.0))), 3.0); outgoingLight *= 1.0 - 0.24 * agd * (0.4 + 0.6 * (1.0 - vUv.y)); outgoingLight *= mix(0.78, 1.0, smoothstep(0.0, 0.18, vUv.y));   /* 20261030al: vertical drape folds heavier toward the hem + hem weight shadow */   /* 20261030ah: tighter elbow/waist bunching */
      #endif
    }`);
  };
  m.customProgramCacheKey = () => "am30cloth" + (m.map ? 1 : 0);
}
function x30SkinShader(m){
  if(m.userData.x30s) return; m.userData.x30s = 1;
  const prev = m.onBeforeCompile;
  m.onBeforeCompile = (sh, r) => { try{ if(prev) prev(sh, r); }catch(e){}
    const K = "vec3 outgoingLight = reflectedLight.directDiffuse + reflectedLight.indirectDiffuse + reflectedLight.directSpecular + reflectedLight.indirectSpecular + totalEmissiveRadiance;";
    if(sh.fragmentShader.indexOf(K) < 0) return;
    /* 20261030ag: pores + capillary mottle in skin space, readable at mid-shot; cool the hue a touch */
    sh.fragmentShader = sh.fragmentShader.replace("#include <map_fragment>", `#include <map_fragment>
    #ifdef USE_MAP
    { vec2 yq = vUv * vec2(1400.0, 700.0); float yp = fract(sin(dot(floor(yq), vec2(12.9898, 78.233))) * 43758.5453);
      vec2 yb = vUv * vec2(40.0, 20.0); float ym = 0.5 + 0.5 * sin(yb.x * 1.7 + sin(yb.y * 2.3)) * sin(yb.y * 1.9 + sin(yb.x * 1.3));
      diffuseColor.rgb *= mix(1.0, 0.92, step(0.84, yp));
      diffuseColor.rgb *= mix(vec3(1.0), vec3(1.04, 0.93, 0.95), ym * 0.6);
      vec2 yc = vUv * vec2(9.0, 4.5); float yz = 0.5 + 0.5 * sin(yc.x * 2.1 + 1.7 * sin(yc.y * 1.3)) * sin(yc.y * 2.7 + 1.3 * sin(yc.x * 1.1));
      diffuseColor.rgb *= mix(vec3(0.94, 0.95, 0.97), vec3(1.05, 0.97, 0.95), yz);
      float yl = dot(diffuseColor.rgb, vec3(0.299, 0.587, 0.114)); diffuseColor.rgb = mix(vec3(yl), diffuseColor.rgb, 0.86) * vec3(1.0, 0.99, 1.02); }
    #endif`);
    /* 20261030ah: micro-bump + less plastic sheen on skin */
    sh.fragmentShader = sh.fragmentShader.replace("#include <normal_fragment_maps>", `#include <normal_fragment_maps>
    #ifdef USE_MAP
    { vec2 yn = vUv * vec2(260.0, 130.0); vec2 ym2 = vUv * vec2(48.0, 24.0);
      vec3 ybn = vec3(sin(yn.x * 1.3 + sin(yn.y)) * sin(yn.y * 1.7), sin(yn.y * 1.1 + sin(yn.x * 0.9)) * sin(yn.x * 1.5), 0.0);
      vec3 ybm = vec3(sin(ym2.x * 1.9 + 2.0 * sin(ym2.y * 0.7)), sin(ym2.y * 2.3 + 2.0 * sin(ym2.x * 0.6)), 0.0);
      normal = normalize(normal + 0.08 * ybn + 0.05 * ybm); }
    #endif`);
    sh.fragmentShader = sh.fragmentShader.replace(K, "reflectedLight.directSpecular *= 0.55; reflectedLight.indirectSpecular *= 0.65;\n" + K);
    sh.fragmentShader = sh.fragmentShader.replace(K, K + `
    { float x30nv = clamp(dot(normalize(normal), normalize(vViewPosition)), 0.0, 1.0);
      vec3 x30d = reflectedLight.directDiffuse + reflectedLight.indirectDiffuse;
      float x30l = dot(x30d, vec3(0.299, 0.587, 0.114)) / max(dot(diffuseColor.rgb, vec3(0.299, 0.587, 0.114)), 0.04);
      float x30sh = 1.0 - smoothstep(0.05, 0.9, x30l);
      float x30g = (1.0 - x30nv) * (1.0 - x30nv);
      outgoingLight *= mix(vec3(1.0), vec3(0.58, 0.52, 0.52), x30g);
      outgoingLight += diffuseColor.rgb * vec3(0.16, 0.04, 0.055) * x30sh * (0.25 + 0.75 * x30l + 0.2);
      outgoingLight += diffuseColor.rgb * vec3(0.16, 0.08, 0.06) * pow(1.0 - x30nv, 5.0);
      outgoingLight *= mix(0.78, 1.1, smoothstep(0.15, 0.95, x30l));
      { vec3 x30k = normalize(vec3(-0.35, 0.8, 0.45)); float x30kd = dot(inverseTransformDirection(normalize(normal), viewMatrix), x30k);   /* 20261030ag: world-space room key, not camera-locked */ outgoingLight *= mix(0.58, 1.2, smoothstep(-0.35, 0.75, x30kd)); float amy = inverseTransformDirection(normalize(normal), viewMatrix).y; outgoingLight *= mix(0.55, 1.0, smoothstep(-0.75, 0.25, amy));   /* 20261030am: directional ambient occlusion: under-chin, under-arm, under-brim, jacket underside fall into shade */   /* 20261030aj: stronger skin key */ }   /* 20261030ag: a real key direction on faces (upper camera-left), soft shadow side; skin only */   /* 20261030ag: key/fill contrast on skin: sockets and cheeks hold shade under flat room ambient */
      outgoingLight += vec3(0.05, 0.05, 0.055) * pow(1.0 - x30nv, 3.0) * smoothstep(0.3, 0.9, x30l);
    }`);
  };
  m.customProgramCacheKey = () => "y30skin";
}
/* 20261030ag: corridor marble. Cloudy mottle, fine veins and grain, a polished but bumpy face. */
function x30MarbleTex(){ return W30.marble || (W30.marble = w30Canvas(256, (x, s, r) => {
  try{ if(TEX.marble && TEX.marble.image) x.drawImage(TEX.marble.image, 0, 0, s, s); else { x.fillStyle = "#ece6da"; x.fillRect(0, 0, s, s); } }catch(e){ x.fillStyle = "#ece6da"; x.fillRect(0, 0, s, s); }
  x.fillStyle = "rgba(226,214,192,0.35)"; x.fillRect(0, 0, s, s);
  w30Blot(x, s, r, 70, 46, ["rgba(170,150,124,0.30)", "rgba(255,250,240,0.38)", "rgba(150,140,128,0.22)", "rgba(196,170,132,0.26)"]);
  for(let v = 0; v < 16; v++){ let px = r() * s, py = r() * s; x.strokeStyle = "rgba(" + (80 + (r() * 40 | 0)) + ",74,66," + (0.18 + r() * 0.32).toFixed(2) + ")"; x.lineWidth = 0.6 + r() * 1.8;
    x.beginPath(); x.moveTo(px, py); for(let k = 0; k < 9; k++){ px += (r() - 0.5) * 40; py += 6 + r() * 26; x.lineTo(px, py); } x.stroke(); }
  for(let i = 0; i < 2400; i++){ x.fillStyle = r() < 0.5 ? "rgba(110,98,84,0.22)" : "rgba(255,252,246,0.3)"; x.fillRect(r() * s, r() * s, 1.1, 1.1); }
})); }
function x30MarbleMat(){
  const base = matTexNoNormal(TEX.marble, 1, 2, .55);
  if(G.gfx === "simple") return base;
  if(W30.marbleM) return W30.marbleM;
  const m = base.clone(); m.map = w30Rep(x30MarbleTex(), 1); m.map.repeat.set(1, 2); m.roughness = 0.4; m.color.setHex(0xf6efe4);
  try{ const F = nmFamily("stone"); if(F.rough) m.roughnessMap = F.rough; if(F.normal){ m.normalMap = F.normal; m.normalScale = new THREE.Vector2(0.55, 0.55); } }catch(e){}
  if(NM.env){ m.envMap = NM.env; m.envMapIntensity = 0.45; }
  m.userData.nmDone = true; m.userData.v30v = 1; m._shared = true;
  return (W30.marbleM = m);
}
function nmPeoplePass(){
  try{
    if(G.gfx === "simple") return;
    scene.traverse(o => {
      const m = o.material; if(!m || Array.isArray(m) || !m.isMeshStandardMaterial || m.userData.v30v) return;
      m.userData.v30v = 1;
      const nmn = m.name || "";
      if(nmn === "onum:wood_panel" && m.isMeshPhysicalMaterial){ m.clearcoat = Math.min(m.clearcoat || 0, 0.18); m.clearcoatRoughness = Math.max(m.clearcoatRoughness || 0, 0.55); m.envMapIntensity = Math.min(m.envMapIntensity, 0.45); m.needsUpdate = true; }   /* 20261030ag: satin wax, not a lacquer mirror: kills the white globe on the Exec inner door */
      else if(nmn === "onum:limestone" && m.color.getHex() === 0xffffff){ m.color.setHex(0xe0c9a2); m.needsUpdate = true; }   /* 20261030ag: sandstone, not bleached */
      else if(/^onumc:(skin|headskin)$/.test(nmn)){
        /* 20261030ag: faces past mask. A flat warm emissive is what made the mask: light now shapes the face,
           and the warmth lives in the shadows and the edges (subsurface stand-in), with a real oily sheen. */
        m.roughness = nmn === "onumc:headskin" ? 0.56 : Math.max(m.roughness, 0.62);
        const c = m.color; m.emissive.setRGB(Math.min(0.05, c.r * 0.05), Math.min(0.012, c.g * 0.012), Math.min(0.008, c.b * 0.008));
        if(m.normalScale) m.normalScale.multiplyScalar(nmn === "onumc:headskin" ? 4.0 : 2.2);
        { const hs = {}; c.getHSL(hs); c.setHSL(Math.max(0, hs.h - 0.025), hs.s * 0.54, hs.l * 0.9);   /* 20261030ag: cooler, darker base */ }   /* 20261030ag: rosier, less orange under amber */
        x30SkinShader(m);
        if(m.envMap) m.envMapIntensity = Math.min(m.envMapIntensity, 0.12);
        if(!m.map){ m.map = w30Rep(w30Skin(), 2); m.color.multiplyScalar(1.04); }   /* blush, freckle and pore mottle: no smooth mask */
        m.needsUpdate = true;
      } else if(!nmn && !m.map && m.normalMap && m.roughnessMap && m.roughness >= 0.99 && m.metalness < 0.05){
        if(m.normalScale) m.normalScale.multiplyScalar(2.0);
        if(NM.env && !m.envMap){ m.envMap = NM.env; m.envMapIntensity = 0.2; }
        m.color.offsetHSL(0, -0.04, -0.02);   /* 20261030ag: dyed wool is never fully saturated */
        /* 20261030ag: MARS af: the tiled w30Cloth mottle read as camo: dropped, folds come from x30ClothShader */
        x30ClothShader(m);
        m.needsUpdate = true;
      }
      else if(!nmn && !m.map && !m.transparent && m.metalness < 0.3 && m.roughness >= 0.45 && !(m.emissive && (m.emissive.r + m.emissive.g + m.emissive.b) > 0.02)){
        /* 20261030ag: the District and the gates were built with bare white: sandstone tint and stone grain */
        const hs = {}; m.color.getHSL(hs);
        if(hs.l > 0.78 && hs.s < 0.32){
          m.color.lerp(new THREE.Color(0xe0c9a2), 0.62);   /* 20261030ag: same sandstone as the Capitol */
          { const F = nmFamily("stone"); m.map = w30Rep(w30Sand(), 1); if(nmTier() > 0 && F.rough) m.roughnessMap = F.rough; if(nmTier() > 0 && F.normal){ m.normalMap = F.normal; m.normalScale = new THREE.Vector2(1.0, 1.0); } }   /* 20261030ag: coursed, mottled sandstone */
          m.needsUpdate = true;
        }
      }
    });
  }catch(e){}
}
setInterval(() => { try{ if(G && G.running) nmPeoplePass(); }catch(e){} }, 2500);
function nmRoomPass(){
  try{
    roomGroup.traverse(o => {
      const m = o.material; if(!m || Array.isArray(m) || m.userData.nmDone) return;
      m.userData.nmDone = true;
      if(m.isMeshStandardMaterial && m.userData.nmKind === undefined) m.envMapIntensity = m.metalness > 0.4 ? 0.9 : 0.3;
      const k = m.userData.nmKind || "";
      if(NM.env && m.isMeshStandardMaterial && !m.envMap && (m.metalness > 0.35 || /metal|glass|gloss|asphalt|tex:marble|tex:oak|tex:panel/.test(k) || m.isMeshPhysicalMaterial)){ m.envMap = NM.env; m.needsUpdate = true; }
      /* 20261030ag: realism. Matte surfaces get the room's light at a low strength: natural falloff and a soft edge sheen, not toy-flat walls. */
      else if(NM.env && m.isMeshStandardMaterial && !m.envMap && nmTier() >= 1){ m.envMap = NM.env; m.envMapIntensity = Math.min(m.envMapIntensity || 0.3, 0.3) * 0.6; m.needsUpdate = true; }
    });
  }catch(e){}
}
/* ── the street ─────────────────────────────────────────── */
function nmStreet(kind, d){
  if(nmTier() === 0) return null;
  const k = "street:" + kind + ":" + Math.round(d);
  if(MATCACHE.has(k)) return MATCACHE.get(k);
  const F = nmFamily(kind === "tar" ? "asphalt" : "slab");
  const rep = (t, x, y) => { const c = t.clone(); c.needsUpdate = true; c.repeat.set(x, y); return c; };
  const ry = kind === "tar" ? Math.max(1, Math.round(d / 4.4)) : Math.max(1, Math.round(d / 2.6));
  const rx = kind === "tar" ? 1 : 2;
  const m = new THREE.MeshStandardMaterial({color: kind === "tar" ? 0x34363a : 0xa8a397, roughness: 0.95, metalness: 0,
    map: rep(F.map, rx, ry), roughnessMap: rep(F.rough, rx, ry)});
  if(F.normal){ m.normalMap = rep(F.normal, rx, ry); m.normalScale = new THREE.Vector2(0.7, 0.7); }
  m.envMapIntensity = 0.3; m._shared = true;
  m.userData.nmKind = kind === "tar" ? "asphalt" : "slab"; m.userData.dry = {r:0.95, c:m.color.clone()};
  MATCACHE.set(k, m); NM.street.push(m);
  return m;
}
/* rain makes the street a mirror; the signs make it worth looking at */
function nmLight(day){
  try{
    const w = (typeof wxToday === "function") ? wxToday() : null;
    const wet = w && (w.k === "rain" || w.k === "storm") ? 1 : (w && w.k === "snow" && w.cover < 1) ? 0.5 : 0;
    NM.wet = wet; NM.night = Math.max(0, Math.min(1, (0.55 - (day === undefined ? 1 : day)) / 0.45));
    NM.street.forEach(m => {
      const D = m.userData.dry; if(!D) return;
      m.roughness = D.r * (1 - wet * 0.72);
      m.color.copy(D.c).multiplyScalar(1 - wet * 0.32);
      m.envMapIntensity = 0.3 + wet * 1.5;
      if(NM.env && !m.envMap){ m.envMap = NM.env; m.needsUpdate = true; }
    });
    NM.signs.forEach(s => { s.material.emissiveIntensity = 0.35 + NM.night * 1.9; });
    NM.refl.forEach(q => { q.material.opacity = wet * (0.18 + NM.night * 0.5); q.visible = wet > 0; });
  }catch(e){}
}
const NM_NEON = {DINER:0xff3b4e, HARDWARE:0xffb03a, MARKET:0x52ff9a};
function nmSign(x, bh, z, bw, title){
  if(nmTier() === 0 || !title) return;
  try{
    const col = NM_NEON[title] || 0xfff0c0;
    const m = matGlow(0x222222, col, 1.0, 0.4, 0);
    const bar = addBox(m, x, bh + 0.32, z - 0.66, Math.min(bw * 0.7, 2.8), 0.07, 0.05, 0, true);
    NM.signs.push(bar);
    /* its smear on the wet pavement below */
    const qm = new THREE.MeshBasicMaterial({color:col, transparent:true, opacity:0, blending:THREE.AdditiveBlending, depthWrite:false, map:nmGlowTex()});
    const q = new THREE.Mesh(UNIT.plane || new THREE.PlaneGeometry(1, 1), qm);
    q.rotation.x = -Math.PI / 2; q.position.set(x, 0.112, z - 1.6); q.scale.set(Math.min(bw * 0.6, 2.4), 2.4, 1);
    q.visible = false; q.matrixAutoUpdate = true; roomGroup.add(q); NM.refl.push(q);
  }catch(e){}
}
let _nmGlow = null;
function nmGlowTex(){
  if(_nmGlow) return _nmGlow;
  const c = document.createElement("canvas"); c.width = 64; c.height = 128;
  const g = c.getContext("2d"), gr = g.createLinearGradient(0, 0, 0, 128);
  gr.addColorStop(0, "rgba(255,255,255,0)"); gr.addColorStop(0.25, "rgba(255,255,255,.9)"); gr.addColorStop(1, "rgba(255,255,255,0)");
  g.fillStyle = gr; g.fillRect(0, 0, 64, 128);
  const g2 = g.createLinearGradient(0, 0, 64, 0); g2.addColorStop(0, "rgba(0,0,0,1)"); g2.addColorStop(0.5, "rgba(0,0,0,0)"); g2.addColorStop(1, "rgba(0,0,0,1)");
  g.globalCompositeOperation = "destination-out"; g.fillStyle = g2; g.fillRect(0, 0, 64, 128);
  _nmGlow = new THREE.CanvasTexture(c); NM.bytes += 64 * 128 * 4; NM.tex++;
  return _nmGlow;
}
let _nmBlob = null;
function nmBlobTex(){
  if(_nmBlob) return _nmBlob;
  const c = document.createElement("canvas"); c.width = c.height = 64;
  const g = c.getContext("2d"), gr = g.createRadialGradient(32, 32, 4, 32, 32, 32);
  gr.addColorStop(0, "rgba(0,0,0,.85)"); gr.addColorStop(1, "rgba(0,0,0,0)");
  g.fillStyle = gr; g.fillRect(0, 0, 64, 64);
  _nmBlob = new THREE.CanvasTexture(c); NM.bytes += 64 * 64 * 4; NM.tex++;
  return _nmBlob;
}
/* contact shadow: a soft dark pool where a heavy thing meets the ground */
function nmContact(x, z, w, d, y){
  try{
    const q = new THREE.Mesh(UNIT.plane || new THREE.PlaneGeometry(1, 1),
      new THREE.MeshBasicMaterial({map:nmBlobTex(), transparent:true, depthWrite:false, opacity:0.55}));
    q.rotation.x = -Math.PI / 2; q.position.set(x, (y || 0) + 0.006, z); q.scale.set(w, d, 1);
    roomGroup.add(q); return q;
  }catch(e){ return null; }
}
/* ── parked cars on Main Street ─────────────────────────── */
let _nmPaint = new Map();
function nmCarPaint(col){
  if(_nmPaint.has(col)) return _nmPaint.get(col);
  let m;
  if(nmTier() >= 2) m = new THREE.MeshPhysicalMaterial({color:col, metalness:0.55, roughness:0.38, clearcoat:1.0, clearcoatRoughness:0.07});
  else m = new THREE.MeshStandardMaterial({color:col, metalness:0.5, roughness:0.3});
  m.envMapIntensity = 1.1;
  if(nmTier() > 0){ const F = nmFamily("gloss"); m.roughnessMap = F.rough; }
  m._shared = true; _nmPaint.set(col, m);
  return m;
}
function nmCar(x, z, ry, col){
  const g = new THREE.Group(); g.position.set(x, 0, z); g.rotation.y = ry || 0;
  const put = (mat, px, py, pz, sx, sy, sz, geo) => { const e = new THREE.Mesh(geo || UNIT.box, mat); e.position.set(px, py, pz); e.scale.set(sx, sy, sz); e.castShadow = true; e.receiveShadow = true; g.add(e); return e; };
  const paint = nmCarPaint(col), glass = matCol(0x1d2a33, 0.08, 0.3), chrome = matCol(0xc8ccd0, 0.18, 0.95);
  const rubber = matCol(0x161616, 0.85), lamp = matGlow(0xfff4d8, 0xfff0c8, 0.25, 0.2, 0), tail = matGlow(0x7a0f12, 0x8a1010, 0.3, 0.3, 0);
  put(paint, 0, 0.42, 0, 1.12, 0.40, 3.10);           /* body */
  put(paint, 0, 0.74, -0.12, 1.02, 0.28, 1.55);        /* cabin */
  put(glass, 0, 0.75, -0.12, 1.04, 0.22, 1.40);        /* glasshouse */
  put(chrome, 0, 0.30, 1.57, 1.10, 0.10, 0.06);
  put(chrome, 0, 0.30, -1.57, 1.10, 0.10, 0.06);
  put(lamp, -0.38, 0.46, 1.56, 0.20, 0.08, 0.03); put(lamp, 0.38, 0.46, 1.56, 0.20, 0.08, 0.03);
  put(tail, -0.40, 0.48, -1.56, 0.18, 0.07, 0.03); put(tail, 0.40, 0.48, -1.56, 0.18, 0.07, 0.03);
  const cyl = UNIT.cyl || new THREE.CylinderGeometry(0.5, 0.5, 1, 14);
  [[-0.52, 1.0], [0.52, 1.0], [-0.52, -1.0], [0.52, -1.0]].forEach(p => {
    const wh = put(rubber, p[0], 0.25, p[1], 0.5, 0.18, 0.5, cyl); wh.rotation.z = Math.PI / 2;
  });
  roomGroup.add(g);
  try{ g.updateMatrixWorld(true); }catch(e){}
  nmContact(x, z, 1.5, 3.6, 0.04);
  const c = Math.cos(ry || 0), sn = Math.sin(ry || 0);
  NM.solids.push({x, z, hx: Math.abs(c) * 0.62 + Math.abs(sn) * 1.6, hz: Math.abs(sn) * 0.62 + Math.abs(c) * 1.6});
  return g;
}
/* the player walks round a car, not through it */
function nmPush(){
  for(let i = 0; i < NM.solids.length; i++){
    const s = NM.solids[i], dx = cam.x - s.x, dz = cam.z - s.z, px = s.hx + 0.25 - Math.abs(dx), pz = s.hz + 0.25 - Math.abs(dz);
    if(px > 0 && pz > 0){
      if(px < pz) cam.x += Math.sign(dx || 1) * px; else cam.z += Math.sign(dz || 1) * pz;
    }
  }
}
function nmDistrict(d){
  if(nmTier() === 0) return;
  try{
    nmCar(-1.52, 4.3, 0, 0x6b1f24);
    nmCar(1.52, 9.6, Math.PI, 0x23384f);
    if(nmTier() >= 2) nmCar(-1.52, 10.4, 0, 0xb9b6ad);
  }catch(e){ if(window.console) console.warn("cars", e); }
}
/* ── the page itself: paper, brass, depth ───────────────── */
function nmUI(){
  if(document.getElementById("nmUI")) return;
  const paper = "url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='f'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .45  0 0 0 0 .38  0 0 0 0 .28  0 0 0 .07 0'/></filter><rect width='100%' height='100%' filter='url(%23f)'/></svg>\")";
  const st = document.createElement("style"); st.id = "nmUI";
  st.textContent =
    ".card{background-image:" + paper + ";box-shadow:0 18px 50px rgba(0,0,0,.42),0 2px 0 rgba(255,255,255,.35) inset,0 0 0 1px rgba(120,96,58,.18);}" +
    ".card .btn:not(.btn--ghost),.conc__btn{background-image:linear-gradient(180deg,rgba(255,255,255,.10),rgba(0,0,0,.12));box-shadow:0 1px 0 rgba(255,255,255,.18) inset,0 2px 6px rgba(0,0,0,.28);border-color:rgba(176,139,69,.55);}" +
    "#job{box-shadow:0 6px 22px rgba(0,0,0,.35),0 0 0 1px rgba(176,139,69,.22) inset;backdrop-filter:blur(3px);}" +
    ".talk__btn{box-shadow:0 1px 0 rgba(255,255,255,.10) inset,0 2px 6px rgba(0,0,0,.25);}" +
    ".travel__btn{box-shadow:0 1px 0 rgba(255,255,255,.12) inset;}" +
    "#tkSay,.tk__say{text-shadow:0 1px 0 rgba(0,0,0,.25);}";
  document.head.appendChild(st);
}
function nmInit(){
  try{ nmUI(); }catch(e){}
  if(nmTier() === 0) return;
  const t0 = performance.now();
  ["paint", "wood", "metal", "stone", "leather", "gloss", "glass", "asphalt", "slab", "skin"].forEach(k => { try{ nmFamily(k); }catch(e){} });
  nmEnvBuild();
  NM.ready = true; NM.ms = Math.round(performance.now() - t0);
}
/* 20261012b: build the surfaces in small slices while the title screen is up,
   so the first walk out of the office does not pay for all of them at once */
const NM_WARMQ = ["paint", "wood", "metal", "stone", "leather", "gloss", "glass", "asphalt", "slab", "skin", "@hair", "@crease", "@env"];
function nmWarm(){
  if(NM.ready || NM.tried) return;
  const k = NM_WARMQ.shift();
  if(!k){ NM.ready = true; NM.tried = true; try{ ncPrewarm(); }catch(e){} return; }
  const t0 = performance.now();
  try{
    if(nmTier() === 0){ NM_WARMQ.length = 0; NM.ready = NM.tried = true; try{ nmUI(); }catch(e){} return; }
    if(k === "@env"){ try{ nmUI(); }catch(e){} nmEnvBuild(); }
    else if(k === "@hair"){ try{ nmHairTex(); }catch(e){} }
    else if(k === "@crease"){ try{ nbCrease(); }catch(e){} }
    else nmFamily(k);
  }catch(e){}
  NM.ms = (NM.ms || 0) + Math.round(performance.now() - t0); (NM.wt = NM.wt || {})[k] = Math.round(performance.now() - t0);
  const next = () => nmWarm();
  if(window.requestIdleCallback) requestIdleCallback(next, {timeout:400}); else setTimeout(next, 60);
}
setTimeout(() => { try{ nmWarm(); }catch(e){} }, 2500);

/* ══════════════════════════════════════════════════════════
   20261012a · PEOPLE, UP CLOSE
   Faces: moving irises with saccades and a real look-at, brows that
   carry the mood, lips that shape the words actually being said,
   stubble and age lines, pore-level skin with a warm under-glow.
   Bodies: articulated fingers with poses, ties and coat hems that
   swing, breathing and weight, nods while listening, gestures while
   speaking, banking into turns, sitting down and standing up as a
   movement rather than a cut. Hair is combed strand texture.
   All of it runs only inside the near band (LOD_NEAR); past that the
   existing tiers take over unchanged.
   ══════════════════════════════════════════════════════════ */
const NPP = {hair:new Map(), stub:null, n:0};
function nmHairTex(){
  if(NPP.tex) return NPP.tex;
  const s = nmTier() >= 2 ? 256 : 128;
  const col = new Float32Array(s);
  const r = nmRand(4242);
  for(let x = 0; x < s; x++) col[x] = 0.55 + r() * 0.45;
  /* smooth a little so strands are a few texels wide, not single pixels */
  for(let pass = 0; pass < 2; pass++) for(let x = 0; x < s; x++) col[x] = (col[x] + col[(x + 1) % s]) * 0.5;
  const along = nmFbm(s, 777, 2, 3);
  const map = nmCanvasTex(s, d => {
    for(let y = 0; y < s; y++) for(let x = 0; x < s; x++){
      const v = y / s, i = (y * s + x);
      const band = Math.exp(-Math.pow((v - 0.32) / 0.07, 2)) * 0.28;   /* the sheen ring a light makes on hair */
      const a = Math.min(1, col[x] * (0.86 + along[i] * 0.2) + band);
      d[i*4] = d[i*4+1] = d[i*4+2] = a * 255; d[i*4+3] = 255;
    }
  }, true);
  const rough = nmCanvasTex(s, d => {
    for(let y = 0; y < s; y++) for(let x = 0; x < s; x++){
      const v = y / s, i = y * s + x;
      const band = Math.exp(-Math.pow((v - 0.32) / 0.07, 2));
      const q = (0.95 - band * 0.45 - (col[x] - 0.75) * 0.3) * 255;
      d[i*4] = d[i*4+1] = d[i*4+2] = q; d[i*4+3] = 255;
    }
  }, false);
  return (NPP.tex = {map, rough});
}
function nmHair(col){
  if(NPP.hair.has(col)) return NPP.hair.get(col);
  const m = new THREE.MeshStandardMaterial({color:col, roughness:0.62, metalness:0});
  m.envMapIntensity = 0.35;
  if(nmTier() > 0){ const T = nmHairTex(); m.map = T.map; m.roughnessMap = T.rough; m.color.offsetHSL(0, -0.02, 0.04); }
  m._shared = true; NPP.hair.set(col, m);
  return m;
}
function nmStubbleMat(){
  if(NPP.stub) return NPP.stub;
  const s = 128, r = nmRand(99);
  const c = document.createElement("canvas"); c.width = c.height = s;
  const g = c.getContext("2d"); g.clearRect(0, 0, s, s);
  for(let i = 0; i < 2600; i++){ g.fillStyle = "rgba(20,16,12," + (0.35 + r() * 0.5) + ")"; g.fillRect(r() * s, r() * s, 1, 1 + r()); }
  const t = new THREE.CanvasTexture(c); NM.bytes += s * s * 4; NM.tex++;
  NPP.stub = new THREE.MeshStandardMaterial({map:t, transparent:true, opacity:0.55, depthWrite:false, roughness:0.9, color:0xffffff});
  NPP.stub._shared = true;
  return NPP.stub;
}
/* brows: hair, not skin, so they read and can move */
function nmBrows(M, hair, headG, hu, fw, bh, eyeX3, fem){
  const out = [];
  [-1, 1].forEach(sd => {
    const b = M(PG.sph, hair, headG, sd * eyeX3 * 1.0, hu * (0.582 + 0.02 * bh), hu * 0.488,
      hu * (fem ? 0.115 : 0.13), hu * (fem ? 0.020 : 0.028) * bh, hu * 0.030, false);
    b.rotation.z = sd * -0.08;
    b.userData.y0 = b.position.y; b.userData.rz0 = b.rotation.z; b.userData.sd = sd;
    out.push(b);
  });
  return out;
}
/* stubble and the lines a face earns */
function nmFaceAge(M, headG, hu, skin, L, fem, headW){
  if(nmTier() < 2) return;
  try{
    if(!fem && !L.beard && ((L.style|0) + Math.round((L.age || 0) * 10)) % 3 === 0){
      M(PG.sph, nmStubbleMat(), headG, 0, hu * 0.25, hu * 0.30, headW * 0.80, hu * 0.24, hu * 0.36, false);
    }
    if((L.age || 0) > 0.55){
      const dk = new THREE.Color(skin.color).multiplyScalar(0.80).getHex();
      const lm = matCol(dk, 0.7);
      const n = (L.age || 0) > 0.8 ? 3 : 2;
      for(let i = 0; i < n; i++) M(PG.box, lm, headG, 0, hu * (0.66 + i * 0.035), hu * 0.43 - i * hu * 0.012, hu * 0.20, hu * 0.004, hu * 0.010, false);
      [-1, 1].forEach(sd => {
        const f = M(PG.box, lm, headG, sd * hu * 0.085, hu * 0.31, hu * 0.455, hu * 0.006, hu * 0.08, hu * 0.010, false);
        f.rotation.z = sd * 0.35;
      });
    }
  }catch(e){}
}
/* fingers: the index works on its own, the other three move together */
function nmFingers(M, lo, skin, side, foreArm, H, B){
  const k = new THREE.Group(); k.position.set(0, -foreArm - H * 0.050, 0); lo.add(k);
  const idx = new THREE.Group(); idx.position.set(-side * H * 0.012 * B, 0, H * 0.004); k.add(idx);
  const rest = new THREE.Group(); rest.position.set(side * H * 0.006 * B, 0, 0); k.add(rest);
  M(PG.box, skin, idx, 0, -H * 0.020, 0, H * 0.010 * B, H * 0.042, H * 0.011 * B, false);
  M(PG.box, skin, rest, 0, -H * 0.017, 0, H * 0.026 * B, H * 0.036, H * 0.012 * B, false);
  return {k, idx, rest, curl:0.5, ix:0.5};
}
/* how a word looks on the mouth */
function nmViseme(ch){
  if(!ch) return [0.1, 1];
  const c = ch.toLowerCase();
  if("ae".indexOf(c) >= 0) return [0.95, 1.05];
  if("i".indexOf(c) >= 0) return [0.55, 1.12];
  if("ou".indexOf(c) >= 0) return [0.75, 0.80];
  if("mbp".indexOf(c) >= 0) return [0.02, 1];
  if("fv".indexOf(c) >= 0) return [0.18, 1.04];
  if(" .,;:!?-".indexOf(c) >= 0) return [0.08, 1];
  return [0.38, 1];
}
let _nppSpeakers = [], _nppSpeakT = 0;
function nmSpeakersNow(){
  if(G.t - _nppSpeakT < 0.4) return _nppSpeakers;
  _nppSpeakT = G.t;
  try{ _nppSpeakers = hereNow().filter(m => m && m.mesh && m.say && m.sayT > 0); }catch(e){ _nppSpeakers = []; }
  return _nppSpeakers;
}
function peopleExtra(p, dt){
  if((MODEST && SC.lvl < 1) || !p || !p.mesh || !p.mesh.visible) return;
  const u = p.mesh.userData; if(!u || !u.iris) return;
  const ddx = cam.x - p.x, ddz = cam.z - p.z, dist = Math.hypot(ddx, ddz);
  const near = dist < LOD_NEAR * 1.15;
  const moving = Math.hypot((p.tx || p.x) - p.x, (p.tz || p.z) - p.z) > 0.25;
  const seated = !!(p.sitting && !G.noSit && !G.plainSit);
  const hu = u.hu, t = G.t + (p.shift || 0);
  const talking = TALK.open && TALK.m === p;
  const speaking = talking || !!(p.say && p.sayT > 0);
  /* sitting down and standing up take a moment: blend from where the body was */
  if(u._sitPrev === undefined) u._sitPrev = seated;
  if(u._sitPrev !== seated){ u._sitPrev = seated; u._tr = 0.65; }
  if(u._tr > 0 && u.pelvis && u._pv){
    u._tr -= dt;
    const k = 1 - Math.max(0, u._tr) / 0.65, e = k * k * (3 - 2 * k);
    u.pelvis.position.y = u._pv.py + (u.pelvis.position.y - u._pv.py) * e;
    u.legL.up.rotation.x = u._pv.lu + (u.legL.up.rotation.x - u._pv.lu) * e;
    u.legR.up.rotation.x = u._pv.ru + (u.legR.up.rotation.x - u._pv.ru) * e;
    u.legL.lo.rotation.x = u._pv.ll + (u.legL.lo.rotation.x - u._pv.ll) * e;
    u.legR.lo.rotation.x = u._pv.rl + (u.legR.lo.rotation.x - u._pv.rl) * e;
    u.spine.rotation.x += Math.sin(k * Math.PI) * 0.22;     /* lean forward to rise or sit */
  }
  /* age carries in the shoulders */
  if(!seated && u.age > 0.62){ u.spine.rotation.x += (u.age - 0.62) * 0.16; u.headG.rotation.x += (u.age - 0.62) * 0.10; }
  /* banking into a turn */
  if(moving){
    const turn = wrapPi((p.facing || 0) - (u._lf === undefined ? (p.facing || 0) : u._lf)) / Math.max(dt, 0.001);
    u._bank = lerp(u._bank || 0, clamp(-turn * 0.035, -0.09, 0.09), 0.12);
    u.spine.rotation.z += u._bank;
  } else u._bank = 0;
  u._lf = p.facing || 0;
  /* ties and coat tails swing with the walk and settle when still */
  if(u.sway && u.sway.length && (near || dist < LOD_MID)){
    const sp = moving ? 1 : 0;
    const sw = -sp * 0.10 + Math.sin(t * (moving ? 6.4 : 1.3) + (p.id || 0)) * (moving ? 0.05 : 0.012);
    for(let i = 0; i < u.sway.length; i++) u.sway[i].rotation.x = sw * (i === 0 ? 1.4 : 0.8);
  }
  if(!near){ u._pv = u.pelvis ? {py:u.pelvis.position.y, lu:u.legL.up.rotation.x, ru:u.legR.up.rotation.x, ll:u.legL.lo.rotation.x, rl:u.legR.lo.rotation.x} : null; return; }
  NPP.n++;
  /* who to look at: the person talking, or you */
  let look = null;
  if(!talking){
    const sp = nmSpeakersNow();
    for(let i = 0; i < sp.length; i++){ const o = sp[i]; if(o !== p && Math.hypot(o.x - p.x, o.z - p.z) < 3.6){ look = o; break; } }
  }
  if(look && !seated){
    const want = clamp(wrapPi(Math.atan2(look.x - p.x, look.z - p.z) - (p.facing || 0)), -1.0, 1.0);
    u.headG.rotation.y = lerp(u.headG.rotation.y, want, 0.08);
    /* listening: small nods now and then */
    if(Math.sin(t * 0.9) > 0.6) u.headG.rotation.x += Math.max(0, Math.sin(t * 4.2)) * 0.06;
  }
  /* eyes: saccades and fixation */
  u._sac = (u._sac || 0) - dt;
  if(u._sac < 0){ u._sx = (Math.random() * 2 - 1) * 0.35; u._sy = (Math.random() * 2 - 1) * 0.25; u._sac = 0.25 + Math.random() * 1.3; }
  let ex = 0, ey = 0;
  const tx = look ? look.x : cam.x, tz = look ? look.z : cam.z;
  const rel = wrapPi(Math.atan2(tx - p.x, tz - p.z) - (p.facing || 0) - u.headG.rotation.y);
  ex = clamp(rel * 1.2, -1, 1) + u._sx; ey = (look ? 0 : clamp((cam.y || 1.6) - 1.5, -0.5, 0.5)) + u._sy;
  if(!u._irB) u._irB = u.iris.map(o => [o.position.x, o.position.y]);
  for(let i = 0; i < u.iris.length; i++){
    const o = u.iris[i], b = u._irB[i];
    o.position.x = b[0] + clamp(ex, -1, 1) * hu * 0.011;
    o.position.y = b[1] + clamp(ey, -1, 1) * hu * 0.007;
  }
  /* mood in the brows */
  if(u.brows){
    let inner = 0, lift = 0;
    try{
      const mk = moodOf(p).key;
      if(mk === "furious" || mk === "aggrieved") inner = -1;
      else if(mk === "sour" || mk === "guarded") inner = -0.4;
      else if(mk === "elated" || mk === "warm") lift = 0.6;
      else if(mk === "distracted") inner = 0.5;
    }catch(e){}
    if(speaking){ const c = (p.say || "").charAt(((u._vt || 0) * 13) | 0); if(c === "!" || c === "?" || (c >= "A" && c <= "Z")) lift += 1; }
    u._lift = lerp(u._lift || 0, lift, 0.15); u._inner = lerp(u._inner || 0, inner, 0.1);
    u.brows.forEach(b => {
      b.position.y = b.userData.y0 + u._lift * hu * 0.014 + Math.min(0, u._inner) * hu * 0.006;
      b.rotation.z = b.userData.rz0 + b.userData.sd * u._inner * 0.22;
    });
  }
  /* lips: the shape of the words on the transcript */
  if(u.lowLip){
    if(u._ll0 === undefined) u._ll0 = u.lowLip.position.y;
    if(speaking){
      u._vt = (u._vt || 0) + dt;
      const text = talking ? ((el("tkSay") || {}).textContent || "") : (p.say || "");
      const v = nmViseme(text.charAt(((u._vt * 13) | 0) % Math.max(1, text.length)));
      u._mo = lerp(u._mo || 0, v[0], 0.45); u._mr = lerp(u._mr || 1, v[1], 0.35);
    } else { u._vt = 0; u._mo = lerp(u._mo || 0, 0, 0.25); u._mr = lerp(u._mr || 1, 1, 0.2); }
    u.lowLip.position.y = u._ll0 - (u._mo || 0) * hu * 0.032;
    if(u.mouth){ u.mouth.scale.y = u.mouth.scale.x * 0.17 * (0.8 + (u._mo || 0) * 0.3); }
    u.lowLip.scale.x = (u._llx || (u._llx = u.lowLip.scale.x)) * (u._mr || 1);
  }
  /* hands */
  const hands = [u.armL && u.armL.fing, u.armR && u.armR.fing];
  let point = false, grip = seated && (p.idle === "write" || p.idle === "read");
  /* speaking in the room (not only to you) moves the hands too */
  if(speaking && !talking && !seated && !moving){
    u._g2 = (u._g2 || 0) + dt;
    const g = u._g2;
    const side = ((p.id || 0) % 2) ? u.armR : u.armL;
    side.up.rotation.x = -0.36 + Math.sin(g * 2.0) * 0.14;
    side.up.rotation.z = (side === u.armR ? -0.22 : 0.22);
    side.lo.rotation.x = -1.0 + Math.sin(g * 2.9) * 0.25;
    point = Math.sin(g * 2.0) > 0.55;
    u.headG.rotation.x += Math.sin(g * 2.6) * 0.03;
  } else u._g2 = 0;
  if(talking) point = Math.sin((u.gest || 0) * 2.1) > 0.5;
  /* standing still and not talking: some people fold their hands in front */
  if(!speaking && !moving && !seated && !look && ((p.id || 0) % 3 === 0)){
    u.armL.up.rotation.x = -0.28; u.armR.up.rotation.x = -0.28;
    u.armL.up.rotation.z = -0.16; u.armR.up.rotation.z = 0.16;
    u.armL.lo.rotation.x = -1.05; u.armR.lo.rotation.x = -1.05;
    grip = true;
  }
  for(let i = 0; i < 2; i++){
    const f = hands[i]; if(!f) continue;
    const wantRest = grip ? -1.45 : (point && i === ((p.id || 0) % 2 ? 1 : 0)) ? -1.35 : -0.55 - Math.sin(t * 0.6 + i) * 0.05;
    const wantIdx = grip ? -1.3 : (point && i === ((p.id || 0) % 2 ? 1 : 0)) ? 0.05 : -0.45;
    f.curl = lerp(f.curl, wantRest, 0.2); f.ix = lerp(f.ix, wantIdx, 0.2);
    f.rest.rotation.x = f.curl; f.idx.rotation.x = f.ix;
  }
  u._pv = {py:u.pelvis.position.y, lu:u.legL.up.rotation.x, ru:u.legR.up.rotation.x, ll:u.legL.lo.rotation.x, rl:u.legR.lo.rotation.x};
}

/* ══════════════════════════════════════════════════════════
   20261012b · CLOSER STILL
   Irises with a real pattern (limbal ring, radial fibres, a lighter
   collarette), lower lids and a lash line, nostrils and a lip line, a
   philtrum and a cupid's bow; fabric that creases and shows its seams
   and lint; hair cards round the back and sides; trees that move in
   the wind; cornices, sills and pilasters on the shops; curbs, gutters
   and cracks on the street.
   ══════════════════════════════════════════════════════════ */
const NB = {iris:new Map(), crease:null, card:new Map(), sway:[], wind:0.4};
function nbIris(col){
  if(NB.iris.has(col)) return NB.iris.get(col);
  const m = matCol(col, .32);
  if(nmTier() > 0){
    const s = 64, c = document.createElement("canvas"); c.width = c.height = s;
    const g = c.getContext("2d"), r = nmRand((col & 0xffff) + 7);
    const base = new THREE.Color(col);
    const css = (cc, a) => "rgba(" + (cc.r * 255 | 0) + "," + (cc.g * 255 | 0) + "," + (cc.b * 255 | 0) + "," + a + ")";
    g.fillStyle = "#fff"; g.fillRect(0, 0, s, s);
    /* fibres from the pupil out */
    for(let i = 0; i < 140; i++){
      const a = r() * 6.283, l = 0.18 + r() * 0.30;
      const cc = base.clone().offsetHSL(0, 0, (r() - 0.5) * 0.18);
      g.strokeStyle = css(cc, 0.8); g.lineWidth = 1 + r();
      g.beginPath(); g.moveTo(s/2 + Math.cos(a) * s * 0.12, s/2 + Math.sin(a) * s * 0.12); g.lineTo(s/2 + Math.cos(a) * s * l, s/2 + Math.sin(a) * s * l); g.stroke();
    }
    /* collarette and limbal ring */
    g.strokeStyle = css(base.clone().offsetHSL(0.02, 0.05, 0.16), 0.55); g.lineWidth = 3;
    g.beginPath(); g.arc(s/2, s/2, s * 0.2, 0, 6.283); g.stroke();
    g.strokeStyle = "rgba(20,14,10,0.85)"; g.lineWidth = 5;
    g.beginPath(); g.arc(s/2, s/2, s * 0.47, 0, 6.283); g.stroke();
    const t = new THREE.CanvasTexture(c); try{ t.encoding = THREE.sRGBEncoding; }catch(e){}
    NM.bytes += s * s * 4; NM.tex++;
    const mm = m.clone(); mm.color.set(0xffffff); mm.map = t; mm.roughness = 0.25; mm._shared = true;
    NB.iris.set(col, mm); return mm;
  }
  NB.iris.set(col, m); return m;
}
/* the face's small forms */
function nbFace(M, headG, hu, skin, eyeX3, nl, lf, fem){
  if(nmTier() < 1) return;
  try{
    const lash = matCol(0x1a1410, .6), dark = matCol(0x2a1512, .7);
    const under = new THREE.Color(skin.color).multiplyScalar(0.9).getHex();
    const uM = matCol(under, .62);
    [-1, 1].forEach(sd => {
      M(PG.sph, uM, headG, sd * eyeX3, hu * 0.462, hu * 0.492, hu * 0.066, hu * 0.012, hu * 0.020, false);   /* lower lid */
      const l = M(PG.box, lash, headG, sd * eyeX3, hu * 0.530, hu * 0.518, hu * 0.110, hu * 0.006, hu * 0.010, false); /* lash line */
      l.rotation.z = sd * -0.06;
      M(PG.sph, dark, headG, sd * hu * 0.034, hu * 0.322, hu * (0.468 + 0.01 * nl), hu * 0.014, hu * 0.009, hu * 0.010, false); /* nostril */
      M(PG.sph, skin, headG, sd * hu * 0.018, hu * (0.292 + 0.01 * lf), hu * 0.466, hu * 0.030, hu * 0.012, hu * 0.016, false); /* cupid's bow */
    });
    M(PG.box, skin, headG, 0, hu * 0.312, hu * 0.452, hu * 0.022, hu * 0.030, hu * 0.012, false);   /* philtrum */
    M(PG.box, dark, headG, 0, hu * (0.266 + 0.01 * lf), hu * 0.478, hu * (0.12 * lf), hu * 0.004, hu * 0.008, false); /* lip line */
  }catch(e){}
}
/* fabric: creases at the joints, seams, a little lint, as roughness */
function nbCrease(){
  if(NB.crease) return NB.crease;
  const s = nmTier() >= 2 ? 256 : 128, n = nmFbm(s, 3131, 4, 3), r = nmRand(55);
  const lint = new Float32Array(s * s); for(let i = 0; i < s * 3; i++) lint[(r() * s * s) | 0] = 1;
  NB.crease = nmCanvasTex(s, d => {
    for(let y = 0; y < s; y++) for(let x = 0; x < s; x++){
      const i = y * s + x, v = y / s, u = x / s;
      const fold = Math.pow(Math.abs(Math.sin((u * 7 + n[i] * 1.8) * 3.14159)), 6) * (0.5 + 0.5 * Math.cos(v * 6.283 * 2));
      const seam = (Math.abs(u - 0.5) < 0.006 || Math.abs(v - 0.25) < 0.004) ? 1 : 0;
      const q = 0.86 + n[i] * 0.10 - fold * 0.16 - seam * 0.25 + lint[i] * 0.12;
      d[i*4] = d[i*4+1] = d[i*4+2] = Math.max(0, Math.min(255, q * 255)); d[i*4+3] = 255;
    }
  }, false);
  return NB.crease;
}
/* hair cards: thin strands at the edges of the cut */
function nbCardMat(col){
  if(NB.card.has(col)) return NB.card.get(col);
  const s = 64, c = document.createElement("canvas"); c.width = c.height = s;
  const g = c.getContext("2d"), r = nmRand(4040);
  g.clearRect(0, 0, s, s);
  for(let i = 0; i < 90; i++){
    const x = r() * s, len = s * (0.55 + r() * 0.45);
    g.strokeStyle = "rgba(255,255,255," + (0.5 + r() * 0.5) + ")"; g.lineWidth = 0.8 + r() * 0.8;
    g.beginPath(); g.moveTo(x, 0); g.quadraticCurveTo(x + (r() - 0.5) * 6, len * 0.5, x + (r() - 0.5) * 8, len); g.stroke();
  }
  const t = new THREE.CanvasTexture(c); NM.bytes += s * s * 4; NM.tex++;
  const m = new THREE.MeshStandardMaterial({color:col, map:t, alphaTest:0.4, transparent:false, side:THREE.DoubleSide, roughness:0.5});
  m.envMapIntensity = 0.3; m._shared = true; NB.card.set(col, m);
  return m;
}
function nbHairCards(M, headG, hu, hairW, hairCol, hs, fem){
  if(nmTier() < 2 || hs === 6) return;
  try{
    const m = nbCardMat(hairCol);
    const len = fem ? hu * 0.42 : hu * 0.20;
    const back = M(PG.plane, m, headG, 0, hu * 0.48 - len * 0.3, -hu * 0.47, hairW * 0.82, len, 1, false);
    back.rotation.x = 0.25; back.rotation.y = Math.PI;
    if(fem) [-1, 1].forEach(sd => {
      const c = M(PG.plane, m, headG, sd * hairW * 0.47, hu * 0.48 - len * 0.25, -hu * 0.12, hu * 0.40, len, 1, false);
      c.rotation.y = sd * Math.PI / 2; c.rotation.z = sd * 0.08;
    });
  }catch(e){}
}
/* trees in the wind */
function nbSwayAdd(mesh, amp){ if(mesh && !MODEST){ mesh.userData.sx = mesh.position.x; mesh.userData.sz = mesh.position.z; mesh.userData.amp = amp; NB.sway.push(mesh); } }
let _nbT = 0;
function nbSway(dt){
  if(!NB.sway.length) return;
  _nbT += Math.min(0.05, dt || 0.016);
  let w = 0.35; try{ const k = (wxToday() || {}).k; w = k === "storm" ? 1.6 : k === "wind" ? 1.2 : k === "rain" ? 0.8 : 0.35; }catch(e){}
  NB.wind = lerp(NB.wind, w, 0.02);
  for(let i = NB.sway.length - 1; i >= 0; i--){
    const m = NB.sway[i];
    if(!m.parent){ NB.sway.splice(i, 1); continue; }
    const ph = m.userData.sx * 1.7 + m.userData.sz;
    const a = m.userData.amp * NB.wind;
    m.position.x = m.userData.sx + (Math.sin(_nbT * 1.3 + ph) + Math.sin(_nbT * 3.1 + ph * 2) * 0.3) * a;
    m.position.z = m.userData.sz + Math.sin(_nbT * 0.9 + ph) * a * 0.5;
    m.updateMatrix(); m.matrixWorldNeedsUpdate = true;
  }
}
/* the street's edges */
function nbStreet(d){
  if(nmTier() === 0) return;
  try{
    const curb = matCol(0x9d998f, .88), gut = matCol(0x2c2d2e, .55, .05), crack = matCol(0x4a4740, .95);
    [-1, 1].forEach(sd => {
      addBox(curb, sd * 2.27, 0.07, d / 2, 0.16, 0.14, d - 0.3, 0, true);
      addBox(gut, sd * 2.06, 0.043, d / 2, 0.26, 0.006, d - 0.3, 0, true);
    });
    const r = nmRand(77);
    const n = nmTier() >= 2 ? 14 : 6;
    for(let i = 0; i < n; i++){
      const sd = r() < 0.5 ? -1 : 1;
      addBox(crack, sd * (2.6 + r() * 4.6), 0.103, 0.6 + r() * (d - 1.2), 0.012 + r() * 0.01, 0.003, 0.3 + r() * 0.7, r() * 3, true);
    }
  }catch(e){}
}
/* the shops' architecture */
function nbStorefront(x, z, bw, bh, col){
  if(nmTier() === 0) return;
  try{
    const c = new THREE.Color(col), dk = matCol(c.clone().multiplyScalar(0.82).getHex(), .9), lt = matCol(c.clone().lerp(new THREE.Color(0xffffff), 0.25).getHex(), .85);
    addBox(lt, x, bh - 0.06, z - 0.06, bw + 0.08, 0.08, 1.24, 0, true);         /* cornice band */
    addBox(dk, x, bh - 0.16, z - 0.04, bw + 0.02, 0.06, 1.20, 0, true);         /* dentil shadow */
    addBox(dk, x, 0.16, z - 0.03, bw + 0.04, 0.32, 1.20, 0, true);              /* plinth */
    [-1, 1].forEach(sd => addBox(lt, x + sd * (bw / 2 - 0.06), bh / 2, z - 0.06, 0.14, bh - 0.2, 1.22, 0, true)); /* pilasters */
    const n = bw > 3.6 ? 3 : 2;
    for(let i = 0; i < n; i++){
      const wx = x - (n - 1) * 0.55 + i * 1.10;
      addBox(lt, wx, 1.06, z - 0.66, 0.82, 0.05, 0.12, 0, true);                 /* sill */
      addBox(lt, wx, 2.05, z - 0.64, 0.80, 0.07, 0.08, 0, true);                 /* lintel */
    }
  }catch(e){}
}

/* ══════════════════════════════════════════════════════════
   20261012c · GRASS, SEAMS, AND A QUIETER START
   Grass in the District is instanced tufts that bend with the wind
   in the vertex shader (one draw call). Suits get real seam lines.
   The material programs the new surfaces need are compiled one at a
   time while the title screen idles, instead of all at once on the
   first frame that needs them.
   ══════════════════════════════════════════════════════════ */
const NC = {grass:null, gU:{t:{value:0}, w:{value:0.4}}, warmed:0};
function ncGrassGeo(){
  /* a tuft: three crossed blades, tips higher than roots so the shader can bend them */
  const g = new THREE.BufferGeometry(), P = [], U = [];
  for(let k = 0; k < 3; k++){
    const a = k * Math.PI / 3, c = Math.cos(a) * 0.09, s = Math.sin(a) * 0.09;
    P.push(-c, 0, -s,  c, 0, s,  c * 0.3, 0.22, s * 0.3,   -c, 0, -s,  c * 0.3, 0.22, s * 0.3,  -c * 0.3, 0.22, -s * 0.3);
    U.push(0, 0, 1, 0, 0.65, 1,  0, 0, 0.65, 1, 0.35, 1);
  }
  g.setAttribute("position", new THREE.Float32BufferAttribute(P, 3));
  g.setAttribute("uv", new THREE.Float32BufferAttribute(U, 2));
  g.computeVertexNormals();
  return g;
}
function ncGrassMat(){
  const m = new THREE.MeshStandardMaterial({color:0x5c7a3a, roughness:0.9, side:THREE.DoubleSide});
  m.onBeforeCompile = sh => {
    sh.uniforms.gT = NC.gU.t; sh.uniforms.gW = NC.gU.w;
    sh.vertexShader = "uniform float gT; uniform float gW;\n" + sh.vertexShader.replace("#include <begin_vertex>",
      "#include <begin_vertex>\n" +
      "#ifdef USE_INSTANCING\n vec3 ip = vec3(instanceMatrix[3][0], instanceMatrix[3][1], instanceMatrix[3][2]);\n#else\n vec3 ip = vec3(0.0);\n#endif\n" +
      " float bend = position.y * position.y * 18.0 * gW;\n" +
      " transformed.x += sin(gT * 1.7 + ip.x * 0.9 + ip.z * 0.6) * 0.05 * bend + 0.02 * bend;\n" +
      " transformed.z += cos(gT * 1.3 + ip.z * 0.8) * 0.03 * bend;\n");
    sh.fragmentShader = sh.fragmentShader.replace("#include <color_fragment>",
      "#include <color_fragment>\n diffuseColor.rgb *= mix(0.55, 1.15, vUv.y);");
    sh.vertexShader = sh.vertexShader.replace("#include <uv_pars_vertex>", "#include <uv_pars_vertex>\n#ifndef USE_UV\n varying vec2 vUv;\n#endif");
    sh.fragmentShader = sh.fragmentShader.replace("#include <uv_pars_fragment>", "#include <uv_pars_fragment>\n#ifndef USE_UV\n varying vec2 vUv;\n#endif");
    sh.vertexShader = sh.vertexShader.replace("#include <uv_vertex>", "#include <uv_vertex>\n#ifndef USE_UV\n vUv = uv;\n#endif");
  };
  m.customProgramCacheKey = () => "ncgrass";
  return m;
}
function ncGrass(d, hw){
  const T = nmTier(); if(T === 0) return;
  try{
    const n = T >= 2 ? 1400 : 600;
    if(!NC.geo){ NC.geo = ncGrassGeo(); NC.mat = ncGrassMat(); }
    const im = new THREE.InstancedMesh(NC.geo, NC.mat, n);
    const r = nmRand(9091), mtx = new THREE.Matrix4(), q = new THREE.Quaternion(), s = new THREE.Vector3(), p = new THREE.Vector3(), up = new THREE.Vector3(0, 1, 0);
    const col = new THREE.Color();
    let k = 0;
    for(let i = 0; i < n * 3 && k < n; i++){
      const sd = r() < 0.5 ? -1 : 1, x = sd * (7.75 + r() * Math.max(0.2, hw - 7.9)), z = 0.4 + r() * (d - 0.8);
      p.set(x, 0.0, z); q.setFromAxisAngle(up, r() * 6.283); const sc = 0.7 + r() * 0.8; s.set(sc, sc * (0.7 + r() * 0.7), sc);
      mtx.compose(p, q, s); im.setMatrixAt(k, mtx);
      col.setHSL(0.22 + r() * 0.06, 0.35 + r() * 0.2, 0.30 + r() * 0.14); im.setColorAt(k, col);
      k++;
    }
    im.count = k; im.castShadow = false; im.receiveShadow = true; im.frustumCulled = false;
    if(im.instanceColor) im.instanceColor.needsUpdate = true;
    roomGroup.add(im); NC.grass = im;
  }catch(e){ if(window.console) console.warn("grass", e); }
}
function ncGrassTick(dt){
  NC.gU.t.value += Math.min(0.05, dt || 0.016);
  try{ NC.gU.w.value = NB.wind; }catch(e){}
}
/* seams: side seam on each trouser leg, a shoulder line on the coat */
function ncSeams(M, legs, arms, H, B, shin, foreArm, col){
  if(nmTier() < 1) return;
  try{
    const sm = matCol(new THREE.Color(col).multiplyScalar(0.62).getHex(), .8);
    legs.forEach((L, i) => {
      const sd = i ? 1 : -1;
      M(PG.box, sm, L.lo, sd * H * 0.034 * B, -shin * 0.48, 0, H * 0.0035, shin * 0.82, H * 0.0035, false);
    });
    arms.forEach((A, i) => {
      const sd = i ? 1 : -1;
      M(PG.box, sm, A.lo, 0, -foreArm * 0.5, -H * 0.029 * B, H * 0.0035, foreArm * 0.7, H * 0.0035, false);
    });
  }catch(e){}
}
/* compile the new programs one per idle slice */
function ncPrewarm(){
  if(NC.warmed || nmTier() === 0 || typeof scene === "undefined") return;
  NC.warmed = 1;
  const mats = [];
  try{
    mats.push(matCol(0x8a7a66, .8), matCol(0xb08b45, .36, .84), matCol(0x2a3a4a, .2, .2));
    mats.push(nmSkin(0xc89a7a), nmHair(0x2a2018), nbIris(0x5a3d24), nbCardMat(0x2a2018), matCol(0x14120f, .45), matCol(0x090807, .26), matCol(0xf4f1ea, .3));
    mats.push(nmStreet("tar", 15), nmStreet("walk", 15));
    try{ mats.push(nmCarPaint(0x6b1f24)); }catch(e){}
    try{ mats.push(matCloth(0x333a44, "suit"), matCloth(0xeeeeee, "shirt")); }catch(e){}
    if(!NC.geo){ NC.geo = ncGrassGeo(); NC.mat = ncGrassMat(); }
  }catch(e){}
  const queue = mats.filter(Boolean);
  const box = new THREE.BoxGeometry(0.01, 0.01, 0.01);
  const step = () => {
    const m = queue.shift();
    if(!m && NC.twins && NC.twins.length){
      const tw = NC.twins.shift(); scene.add(tw); NC.ms = (NC.ms || 0) + ndCompileOnly([tw]); scene.remove(tw); try{ tw.skeleton.dispose(); }catch(e){}
      if(window.requestIdleCallback) requestIdleCallback(step, {timeout:500}); else setTimeout(step, 80); return;
    }
    if(!m){
      try{ const im = new THREE.InstancedMesh(NC.geo, NC.mat, 1); im.position.set(0, -50, 0); scene.add(im); ndCompileOnly([im]); scene.remove(im); im.dispose && im.dispose(); }catch(e){}
      NC.warmed = 2; try{ ndWarmScene(); }catch(e){} return;
    }
    try{
      if(NM.env && (m.metalness > 0.35 || m.isMeshPhysicalMaterial) && !m.envMap){ m.envMap = NM.env; m.needsUpdate = true; }
      const o = new THREE.Mesh(box, m); o.position.set(0, -50, 0); scene.add(o);
      /* people are skinned: their programs differ, so warm a skinned twin too */
      if(!NC.sgeo){
        NC.sgeo = new THREE.BoxGeometry(0.01, 0.01, 0.01);
        const n = NC.sgeo.attributes.position.count;
        NC.sgeo.setAttribute("skinIndex", new THREE.Uint16BufferAttribute(new Array(n * 4).fill(0), 4));
        NC.sgeo.setAttribute("skinWeight", new THREE.Float32BufferAttribute(new Array(n).fill([1, 0, 0, 0]).flat(), 4));
      }
      const bone = new THREE.Bone(), sm = new THREE.SkinnedMesh(NC.sgeo, m);
      sm.add(bone); sm.bind(new THREE.Skeleton([bone])); sm.position.set(0, -50, 0); scene.add(sm);
      NC.ms = (NC.ms || 0) + ndCompileOnly([o]);
      NC.twins = NC.twins || []; NC.twins.push(sm); scene.remove(sm);
      scene.remove(o);
    }catch(e){}
    if(window.requestIdleCallback) requestIdleCallback(step, {timeout:500}); else setTimeout(step, 80);
  };
  step();
}

/* ── 20261012d · one lighting shape everywhere: pad point lights so programs never recompile per room ── */
const ND = {pads:null, on:0};
function ndPad(){
  if(typeof scene === "undefined" || !scene) return;
  if(!ND.pads){
    try{ if(typeof mkLights === "function" && !mkKey) mkLights(false); }catch(e){}
    ND.pads = [];
    for(let i = 0; i < MAX_ROOM_LIGHTS; i++){
      const L = new THREE.PointLight(0x000000, 0, 0.01, 2);
      L.position.set(0, -80, 0); L.visible = false; scene.add(L); ND.pads.push(L);
    }
  }
  let live = 0;
  for(let i = 0; i < ROOMLIGHTS.length; i++){
    let o = ROOMLIGHTS[i], ok = true;
    while(o && o !== scene){ if(!o.visible){ ok = false; break; } o = o.parent; }
    if(ok && o === scene) live++;
  }
  /* Two lighting shapes only: open air (no point lights to pay for while walking outside) and
     indoors (always MAX_ROOM_LIGHTS). Both are warmed, so neither recompiles on a room change. */
  const R = (typeof ROOMS !== "undefined" && typeof G !== "undefined") ? ROOMS[G.room] : null;
  const need = (R && R.open) ? 0 : Math.max(0, MAX_ROOM_LIGHTS - live);
  for(let i = 0; i < ND.pads.length; i++) ND.pads[i].visible = i < need;
  ND.on = need;
}
/* Compile only these objects, under the real scene's lights and fog: everything else hides for one call. */
function ndCompileOnly(objs){
  /* compile() takes lights from traverseVisible and materials from traverse: lend it the real
     lights and fog, but only these objects' materials. */
  const view = Object.create(scene);
  view.traverse = f => objs.forEach(o => o && o.traverse(f));
  const t0 = performance.now();
  try{ ndPad(); renderer.compile(view, camera); }catch(e){}
  /* and once more under the other shape (open air vs indoors) */
  const hidden = [];
  try{
    const R = ROOMS[G.room];
    if(R && R.open){ ND.pads.forEach(p => p.visible = true); }
    else{
      ND.pads.forEach(p => p.visible = false);
      ROOMLIGHTS.forEach(L => { if(L.visible){ L.visible = false; hidden.push(L); } });
    }
    renderer.compile(view, camera);
  }catch(e){}
  hidden.forEach(L => L.visible = true);
  try{ ndPad(); }catch(e){}
  return performance.now() - t0;
}
/* After the startup warm, finish whatever the scene still holds, a few materials per idle slice. */
const ND_SEEN = new WeakSet();
function ndWarmScene(){
  if(typeof scene === "undefined" || !scene || ND.busy) return;
  ND.busy = true;
  const step = () => {
    const batch = [], mats = new Set();
    try{
      scene.traverseVisible(x => {
        if(batch.length >= 4 || !(x.isMesh || x.isPoints)) return;
        const m = x.material; if(!m || Array.isArray(m) || ND_SEEN.has(m)) return;
        ND_SEEN.add(m); if(!mats.has(m)){ mats.add(m); batch.push(x); }
      });
    }catch(e){}
    if(!batch.length){ ND.busy = false; ND.done = (ND.done || 0) + 1; return; }
    ND.ms = (ND.ms || 0) + ndCompileOnly(batch);
    if(window.requestIdleCallback) requestIdleCallback(step, {timeout:400}); else setTimeout(step, 60);
  };
  step();
}
/* Before a frame draws something new, compile its new shaders in budgeted pieces (frames in between
   keep the last picture), so the boot and a room's first frame never block in one long freeze. */
function ndGate(){
  if(typeof scene === "undefined" || !scene) return false;
  ND.f = (ND.f || 0) + 1;
  const key = (typeof G !== "undefined" ? G.room : "") + "|" + scene.children.length + "|" + (roomGroup ? roomGroup.children.length : 0) + "|" + (peopleGroup ? peopleGroup.children.length : 0);
  if(key === ND.key && !ND.pend) return false;
  const _ndRoom = (typeof G !== "undefined" ? G.room : "") + "|" + (roomGroup ? roomGroup.children.length : 0), _ndNewRoom = _ndRoom !== ND.room; ND.room = _ndRoom;   /* 20261021b */
  ND.key = key;
  const t0 = performance.now(), todo = [];
  try{
    scene.traverse(x => {
      const m = x.material; if(!m || Array.isArray(m) || ND_SEEN.has(m) || !(x.isMesh || x.isPoints || x.isLine || x.isSprite)) return;
      todo.push(x);
    });
  }catch(e){ return false; }
  if(!todo.length){ ND.pend = false; ND.skip = 0; return false; }
  let i = 0;
  const _ndBud = (_ndNewRoom || ND.hold) ? 140 : 6; if(_ndNewRoom) ND.hold = true;
  while(i < todo.length && performance.now() - t0 < _ndBud){
    const x = todo[i++]; ND_SEEN.add(x.material); ndCompileOnly([x]);
  }
  ND.pend = i < todo.length;
  ND.gated = (ND.gated || 0) + 1;
  if(!ND.pend){ ND.skip = 0; ND.hold = false; return false; }
  if(!ND.hold) return false;   /* 20261021b: in the same room, never freeze the picture for a newcomer */
  ND.skip = (ND.skip || 0) + 1;
  return ND.skip < 60;
}
/* A plain cube of six small painted faces instead of a prefiltered (PMREM) map: same soft room
   reflection on metal and glass, without the blur passes that froze the start for 1.5 s. */
function ndEnvCube(){
  const S = (typeof FULLPOWER !== "undefined" && FULLPOWER) ? 128 : 64, faces = [];
  const paint = (side) => {
    const c = document.createElement("canvas"); c.width = c.height = S;
    const g = c.getContext("2d");
    if(side === "py"){ g.fillStyle = "#f2f3f6"; g.fillRect(0, 0, S, S); g.fillStyle = "#ffffff"; g.fillRect(S*0.25, S*0.38, S*0.5, S*0.24); }
    else if(side === "ny"){ g.fillStyle = "#2a2520"; g.fillRect(0, 0, S, S); }
    else {
      const gr = g.createLinearGradient(0, 0, 0, S);
      gr.addColorStop(0, "#c9ced7"); gr.addColorStop(0.5, "#8c8f96"); gr.addColorStop(0.52, "#4c4339"); gr.addColorStop(1, "#1c1916");
      g.fillStyle = gr; g.fillRect(0, 0, S, S);
      const k = side === "px" ? 1 : side === "nx" ? 0.85 : side === "nz" ? 0.6 : 0;
      if(k){ g.fillStyle = "rgba(255,250,236," + k + ")"; g.fillRect(S*0.3, S*0.12, S*0.4, S*0.34); }
    }
    return c;
  };
  ["px","nx","py","ny","pz","nz"].forEach(s => faces.push(paint(s)));
  const t = new THREE.CubeTexture(faces);
  t.generateMipmaps = true; t.minFilter = THREE.LinearMipmapLinearFilter; t.magFilter = THREE.LinearFilter;
  if(THREE.sRGBEncoding !== undefined) t.encoding = THREE.sRGBEncoding;
  t.needsUpdate = true;
  return t;
}

/* ── 20261012e · a sculpted head: skull, brow ridge, sockets, cheekbones, jaw and chin as smooth forms ── */
function neBump(n, cx, cy, cz, sig){
  const l = Math.hypot(cx, cy, cz) || 1;
  const d2 = (n.x - cx/l)**2 + (n.y - cy/l)**2 + (n.z - cz/l)**2;
  return Math.exp(-d2 / (2 * sig * sig));
}
function sculptSkull2(seed, frame){
  const fem = frame === "fem", k = fem ? 0.55 : 1;
  const g = new THREE.SphereGeometry(0.5, 32, 24);
  const p = g.attributes.position, v = new THREE.Vector3(), n = new THREE.Vector3();
  for(let i = 0; i < p.count; i++){
    v.fromBufferAttribute(p, i); n.copy(v).normalize();
    const x = n.x, y = n.y, z = n.z, ax = Math.abs(x);
    let s = 1;
    /* cranium: a little narrower than it is deep, fuller behind, crown kept low */
    s *= 1 - 0.06 * x * x + 0.03 * Math.max(0, -z) + (fem ? 0.03 : 0.04) * Math.max(0, y);
    /* lower face tapers to the jaw, but keeps a jaw angle instead of a point */
    if(y < 0){
      const t = -y;
      s *= 1 - (fem ? 0.24 : 0.18) * t * t - (fem ? 0.06 : 0.03) * t;
      s *= 1 + (fem ? 0.02 : 0.07) * neBump(n, ax > 0 ? Math.sign(x) * 0.62 : 0.62, -0.52, 0.30, 0.22) * (ax > 0.2 ? 1 : 0); /* jaw angle */
      s *= 1 + (fem ? 0.07 : 0.11) * neBump(n, 0, -0.72, 0.62, 0.20);                     /* chin */
    }
    /* brow ridge: a soft shelf over the eyes, heavier on men, lighter across the bridge */
    s *= 1 + 0.045 * k * neBump(n, 0.30, 0.24, 0.92, 0.16) * (x > 0 ? 1 : 0) + 0.045 * k * neBump(n, -0.30, 0.24, 0.92, 0.16) * (x < 0 ? 1 : 0);
    s *= 1 + 0.02 * k * neBump(n, 0, 0.22, 1, 0.12);
    /* eye sockets sit under it */
    s *= 1 - 0.035 * neBump(n, x >= 0 ? 0.32 : -0.32, 0.08, 0.94, 0.11);
    /* cheekbones high and to the side, a hollow under them */
    s *= 1 + (fem ? 0.055 : 0.045) * neBump(n, x >= 0 ? 0.62 : -0.62, -0.06, 0.78, 0.17);
    s *= 1 - (fem ? 0.015 : 0.03) * neBump(n, x >= 0 ? 0.55 : -0.55, -0.40, 0.70, 0.14);
    /* temples */
    s *= 1 - 0.045 * neBump(n, x >= 0 ? 0.86 : -0.86, 0.28, 0.42, 0.17);
    /* forehead slopes back a touch; occiput bump */
    s *= 1 + 0.03 * neBump(n, 0, 0.55, 0.83, 0.25) + 0.04 * neBump(n, 0, 0.15, -1, 0.30) + 0.01 * seed * neBump(n, 0, 0.3, -1, 0.4);
    /* mild asymmetry so heads are not clones */
    s *= 1 + 0.010 * seed * x;
    v.multiplyScalar(s); p.setXYZ(i, v.x * 0.92, v.y, v.z);
  }
  g.computeVertexNormals();
  return g;
}
/* side hair hugs the skull (the skull is 0.5 wide per unit, the old side puffs sat at 0.72) */
function neSidePuff(hairW, hu, x, sx, sy, sz, longHair){
  if(Math.abs(x) < hairW * 0.6) return null;
  return [Math.sign(x) * hairW * (longHair ? 0.47 : 0.425), Math.min(sx, hu * (longHair ? 0.12 : 0.075)), Math.min(sy, longHair ? sy : hu * 0.20), Math.min(sz, hu * 0.30)];
}

/* ── 20261012f · PRECEPT COMPREHENSION (offline) ─────────────────────────────
   Extends DTCNO with meaning, not keywords: tokenize, lemmatize, map words onto a
   compact concept graph (synonyms, antonyms, negation, modals), and read each
   precept as an intent {value, sign, form, who, scope, cond}. "Thou shalt not lie"
   and "Always tell the people the truth" are the same intent: honesty, upheld. */
const SEM = (function(){
  /* irregular forms and contractions */
  const IRR = {lied:"lie",lying:"lie",lies:"lie",told:"tell",telling:"tell",stole:"steal",stolen:"steal",stealing:"steal",
    took:"take",taken:"take",gave:"give",given:"give",giving:"give",spoke:"speak",spoken:"speak",speaking:"speak",
    killed:"kill",slew:"kill",slain:"kill",murdered:"murder",bore:"bear",borne:"bear",kept:"keep",keeping:"keep",
    forsook:"forsake",forsaken:"forsake",betrayed:"betray",wrote:"write",written:"write",bought:"buy",sold:"sell",
    spent:"spend",spending:"spend",shalt:"shall",thou:"you",thee:"you",thy:"your",thine:"your",ye:"you",art:"are",
    dost:"do",doth:"does",hath:"has",hast:"have",children:"child",men:"man",women:"woman",people:"people",
    neighbours:"neighbour",neighbors:"neighbour",neighbor:"neighbour",poorer:"poor",poorest:"poor",
    strangers:"stranger",foreigners:"foreigner",immigrants:"immigrant",migrants:"migrant",bribes:"bribe",
    taxes:"tax",lives:"life",wives:"wife",truths:"truth",falsehoods:"falsehood",votes:"vote",voted:"vote",voting:"vote",
    harmed:"harm",harming:"harm",hurt:"hurt",struck:"strike",striking:"strike",fought:"fight",fighting:"fight",
    deceived:"deceive",deceiving:"deceive",misled:"mislead",misleading:"mislead",cheated:"cheat",cheating:"cheat",
    swore:"swear",sworn:"swear",broke:"break",broken:"break",prayed:"pray",praying:"pray",honored:"honour",honoured:"honour",
    honor:"honour",honoring:"honour",wasted:"waste",wasting:"waste",borrowed:"borrow",squandered:"squander",
    attended:"attend",welcomed:"welcome",sheltered:"shelter",fed:"feed",feeding:"feed",robbed:"rob",
    embezzled:"embezzle",slandered:"slander",gossiped:"gossip",cursed:"curse",idled:"idle",worked:"work",
    neglected:"neglect",abandoned:"abandon",hid:"hide",hidden:"hide",concealed:"conceal",served:"serve",
    obeyed:"obey",defended:"defend",protected:"protect",guarded:"guard",shed:"shed",spilt:"spill",spilled:"spill",
    are:"be",is:"be",was:"be",were:"be",been:"be",am:"be",being:"be"};
  const CONTR = [[/\bshan't\b/g,"shall not"],[/\bwon't\b/g,"will not"],[/\bcan't\b/g,"can not"],[/\bcannot\b/g,"can not"],
    [/\bdon't\b/g,"do not"],[/\bdoesn't\b/g,"does not"],[/\bmustn't\b/g,"must not"],[/\bshouldn't\b/g,"should not"],
    [/\bisn't\b/g,"is not"],[/\baren't\b/g,"are not"],[/n't\b/g," not"]];
  function lemma(w){
    if(IRR[w]) return IRR[w];
    if(/^(?:no|some|any|every)?thing$|^(?:king|ring|sing|bring|spring|string|evening|morning|during|nothing)$/.test(w)) return w;
    if(w.length > 5 && /ies$/.test(w)) return w.slice(0, -3) + "y";
    if(w.length > 5 && /ing$/.test(w)){ const b = w.slice(0, -3); return /(.)\1$/.test(b) ? b.slice(0, -1) : (LEX[b + "e"] ? b + "e" : b); }
    if(w.length > 4 && /ed$/.test(w)){ const b = w.slice(0, -2); return LEX[b] ? b : (LEX[b + "e"] ? b + "e" : (/(.)\1$/.test(b) ? b.slice(0, -1) : b)); }
    if(w.length > 5 && /ful$/.test(w) && LEX[w.slice(0, -3)]) return w.slice(0, -3);
    if(w.length > 5 && /ly$/.test(w)){ const b = w.slice(0, -2); if(LEX[b]) return b; if(LEX[b.replace(/i$/, "y")]) return b.replace(/i$/, "y"); }
    if(w.length > 3 && /s$/.test(w) && !/(ss|ous|us|is)$/.test(w)) return w.slice(0, -1);
    return w;
  }
  /* idioms: multi-word meanings the single words do not carry */
  const IDIOM = [[/\btake (?:a |the |another(?: man)?'?s? |any |anyone'?s? )?li(?:fe|ves)\b/g, "kill"], [/\bturn ((?:\w+ ){0,2})away\b/g, "exclude $1"],
    [/\bspeak (no |not )?ill\b/g, "$1slander"], [/\bill of\b/g, "slander of"], [/\bbuy (?:your |a |the |their )?votes?\b/g, "bribe"],
    [/\bline (?:your|their|his|her) pockets?\b/g, "embezzle"], [/\bbear false witness\b/g, "lie"], [/\bgo back on\b/g, "betray"],
    [/\bshow up\b/g, "attend"], [/\blook after\b/g, "protect"], [/\bcare for\b/g, "cherish"], [/\bkeep (?:the |your |a |our )?(?:hearth|home fires?)\b/g, "cherish home"], [/\bthe fire is lent,? not owned\b/g, "share"],
    [/\bsell (?:your |a |the |their |his |her )?votes?\b/g, "bribe"], [/\btake (?:the )?lord'?s? name in vain\b/g, "blaspheme"], [/\b(?:take|use) (?:god|christ)'?s? name in vain\b/g, "blaspheme"],
    [/\bopen (?:your |the |a )?(?:door|home|house)s?\b/g, "welcome"], [/\bhold (?:your |their |his |her )?tongue\b/g, "civil"], [/\bbend (?:the )?truth\b/g, "distort"],
    [/\bstretch (?:the )?truth\b/g, "distort"], [/\bcook (?:the )?books\b/g, "falsify"], [/\bwhat (?:belongs|is owed) to\b/g, "property of"], [/\bwith thrift\b/g, "thriftily"]];
  function tokens(s){
    let t = " " + String(s || "").toLowerCase().replace(/[’']/g, "'") + " ";
    CONTR.forEach(([r, x]) => { t = t.replace(r, x); });
    IDIOM.forEach(([r, x]) => { t = t.replace(r, x); });
    return t.replace(/[^a-z' ]+/g, " ").split(/\s+/).filter(Boolean).map(w => lemma(w.replace(/'s?$/, "")));
  }
  /* concept graph: word -> [value, polarity]. polarity +1 = upholds the value, -1 = violates it. */
  const VAL = {
    honesty:   {p:"truth honest honesty candour candor candid frank fact sincere transparent transparency plain straight forthright accurate true",
                n:"lie twist deceive deception mislead falsehood false falsify fabricate fib cheat perjury perjure dishonest spin conceal hide liar trick fraud distort"},
    life:      {p:"life protect preserve spare peace mercy",
                n:"kill murder slay harm hurt strike violence violent wound assault fight bloodshed shed spill attack war torture"},
    property:  {p:"property belong owner ownership possession",
                n:"steal rob theft thief embezzle loot plunder pilfer covet swindle"},
    integrity: {p:"incorruptible clean",
                n:"bribe bribery kickback payoff graft corrupt corruption favour favor patronage"},
    prudence:  {p:"thrift thrifty thriftily save frugal balance prudent budget account",
                n:"waste squander spend extravagant debt borrow splurge lavish profligate"},
    duty:      {p:"vote attend serve present diligent work labour labor show job task duties",
                n:"absent abstain shirk idle sloth neglect skip miss truant"},
    reverence: {p:"pray worship god christ lord mass church sabbath holy bless reverence revere honour faith altar psalm",
                n:"blaspheme profane mock curse sacrilege idol idolatry"},
    family:    {p:"family mother father parent child son daughter marriage spouse wife husband home kin household",
                n:"abandon forsake adultery desert"},
    hospitality:{p:"stranger foreigner immigrant migrant newcomer refugee guest welcome shelter sojourner alien traveller traveler visitor",
                n:"exclude expel deport shun"},
    charity:   {p:"poor needy alms give feed charity widow orphan hungry help aid generous",
                n:"greed hoard miser stingy"},
    loyalty:   {p:"oath promise pledge word faithful loyal keep",
                n:"betray treason traitor forswear renege defect"},
    speech:    {p:"kind gentle courteous civil bless praise",
                n:"slander gossip insult defame libel mock rail scorn"},
    justice:   {p:"fair justice just law impartial equal court judge alike equally",
                n:"unjust partial rig tamper"},
    obedience: {p:"obey heed follow submit precept",
                n:"disobey defy rebel"}
  };
  const LEX = {};
  for(const v in VAL){
    VAL[v].p.split(" ").filter(Boolean).forEach(w => LEX[w] = LEX[w] || [v, 1]);
    VAL[v].n.split(" ").filter(Boolean).forEach(w => LEX[w] = [v, -1]);
  }
  /* weak words only count if nothing stronger is present */
  const WEAK = {keep:1, give:1, help:1, home:1, show:1, word:1, follow:1, work:1, true:1, save:1, account:1, balance:1, law:1, judge:1, court:1, faith:1, aid:1};
  /* verbs that turn their object against itself: break a promise, violate the law, betray a trust */
  const INV = {break:1, violate:1, breach:1, flout:1, dishonour:1, desecrate:1};
  const NEG = {not:1, never:1, no:1, nor:1, neither:1, none:1, without:1, refrain:1, avoid:1, forbid:1, forbidden:1, cease:1, stop:1, against:1, shun:1, refuse:1, reject:1, decline:1, resist:1, nothing:1};
  const OBL = {shall:1, must:1, always:1, ought:1, should:1, will:1, need:1, require:1, bound:1, duty:1, let:1, keep:1, ever:1};
  const WHO = [[/\b(member|representative|senator|legislator|house|lawmaker)\b/, "members"],
               [/\b(clergy|warden|elder|lector|chaplain|priest)\b/, "clergy"],
               [/\b(consul|governor|official|officer|minister|magistrate)\b/, "officials"],
               [/\b(citizen|voter|people|nation|everyone|all|whoever|man|woman)\b/, "all"]];
  const SCOPE = [[/\b(house|chamber|floor|session|vote|ballot)\b/, "the House"], [/\b(home|family|household)\b/, "at home"],
                 [/\b(people|public|nation|voter|citizen)\b/, "to the people"], [/\b(holy|sabbath|sunday|taylor day|feast)\b/, "on holy days"],
                 [/\b(money|treasury|budget|purse|tax|fund)\b/, "the public purse"]];
  function parse(text){
    const toks = tokens(text), joined = " " + toks.join(" ") + " ";
    /* conditions: "unless ...", "except ...", "when/if ..." */
    let cond = null, main = toks;
    const ci = toks.findIndex(w => w === "unless" || w === "except" || w === "save" && toks[toks.indexOf(w) + 1] === "to" || w === "if" || w === "when" || w === "while");
    if(ci > 1){ cond = {k:toks[ci], t:toks.slice(ci + 1).join(" ")}; main = toks.slice(0, ci); }
    let neg = 0, obl = 0, hits = [];
    for(let i = 0; i < main.length; i++){
      const w = main[i];
      if(NEG[w]){ neg++; continue; }
      if(OBL[w]) obl++;
      const c = LEX[w];
      if(c) hits.push({w, v:c[0], pol:c[1], weak:!!WEAK[w], i, negBefore:neg});
    }
    const strong = hits.filter(h => !h.weak);
    const use = strong.length ? strong : hits;
    if(!use.length) return {ok:false, text, toks, form:neg ? "prohibition" : "obligation"};
    /* pick the value carried by the verb or its object: prefer violation words, then the first strong hit */
    const scoreV = {};
    const MANNER = {thrifty:2, alike:1.2, equally:1.2, fairly:1.2};
    use.forEach(h => { scoreV[h.v] = (scoreV[h.v] || 0) + (h.pol < 0 ? 1.4 : 1) + (h.weak ? -0.5 : 0) + (MANNER[h.w] || 0); });
    const v = Object.keys(scoreV).sort((a, b) => scoreV[b] - scoreV[a])[0];
    const hv = use.filter(x => x.v === v); const h = hv.find(x => MANNER[x.w]) || hv[0];
    /* negation that comes before the concept word flips it; "never" counts once */
    const after = main[h.i + 1];
    let inv = 0; for(let j = Math.max(0, h.i - 3); j < h.i; j++) if(INV[main[j]]) inv = 1;
    const flips = (h.negBefore + inv + (after === "no" || after === "nothing" ? 1 : 0)) % 2;
    const sign = h.pol * (flips ? -1 : 1);
    const who = (WHO.find(([r]) => r.test(joined)) || [0, "all"])[1];
    const scope = (SCOPE.find(([r]) => r.test(joined)) || [0, "everywhere"])[1];
    const others = Object.keys(scoreV).filter(k => k !== v);
    return {ok:true, text, value:v, sign, form:flips ? "prohibition" : "obligation", who, scope, cond,
            also:others, key:v + (sign > 0 ? "+" : "-"), strength:Math.min(1, 0.6 + 0.2 * obl + 0.2 * (/\bnever|always|must\b/.test(joined) ? 1 : 0))};
  }
  /* how two precepts sit together */
  const TENSION = {"charity+|prudence+":1, "hospitality+|justice+":0.4, "life+|duty+":0.3, "obedience+|honesty+":0.3};
  const SUPPORT = {"loyalty+|honesty+":0.7, "honesty+|integrity+":0.7, "integrity+|justice+":0.6, "honesty+|justice+":0.5, "charity+|hospitality+":0.6, "family+|charity+":0.4, "honesty+|speech+":0.5, "speech+|hospitality+":0.3, "life+|charity+":0.4, "integrity+|duty+":0.4, "loyalty+|duty+":0.5, "reverence+|family+":0.3};
  function relate(a, b){
    if(!a.ok || !b.ok) return null;
    if(a.value === b.value) return a.sign === b.sign ? {k:"synergy", w:1} : {k:"conflict", w:1};
    const k1 = a.key + "|" + b.key, k2 = b.key + "|" + a.key;
    const t = TENSION[k1] || TENSION[k2];
    if(t) return {k:"tension", w:t};
    /* values that hold each other up: a kept word and the truth, clean hands and justice */
    if(SUPPORT[k1] || SUPPORT[k2]) return {k:"synergy", w:SUPPORT[k1] || SUPPORT[k2]};
    if(a.also.includes(b.value) || b.also.includes(a.value)) return {k:"synergy", w:0.4};
    return null;
  }
  /* a believer's own reading: strictness by conviction, spirit vs letter by faith and character */
  function reading(m, it){
    const t = (m && m.traits) || {};
    const conv = (t.conviction || 50) / 100, loy = (t.loyalty || 50) / 100;
    const seed = ((m && m.id) || 1) * 9301 % 233 / 233;
    const literal = Math.max(0, Math.min(1, conv * 0.7 + seed * 0.3));
    const weight = it.strength * (0.45 + 0.55 * literal) * (it.cond ? 0.8 : 1);
    return {literal, weight, spirit:1 - literal, loy};
  }
  return {tokens, lemma, parse, relate, reading, VAL:Object.keys(VAL)};
})();

/* ══════════════════════════════════════════════════════════
   20261012f · THE CONSULAR RITE, FORMAL · PRECEPTS · BELIEF THAT GROWS ON ITS OWN
   Canon: God is the Most High. Christ is King. Dominic Zachary Taylor, First Consul,
   is a man under God: the Rite honours him as lawgiver, never as God.
   Nobody is scored. Belief is each person's own: a hidden, slowly moving inner state
   fed by what they hear, see, suffer and think, shown only in what they say and do.
   ══════════════════════════════════════════════════════════ */
const RITE_CREED = "We believe in God, the Most High, and in Jesus Christ, the King. We honour Dominic Zachary Taylor, First Consul, a man under God, as lawgiver of the Republic and not as God, and we keep the precepts given in his name.";
const RITE_TITLES = ["Lector", "Warden", "Elder"];
const RITE_OLD = ["Keep your word to the people.", "Do not deceive the House.", "Give to the poor of your district.", "Keep the hearth; the fire is lent, not owned."];
function riteState(){
  if(!G.rite || !G.rite.v){
    G.rite = {v:1, mode:"watch", cmds:[], amend:[], clergy:{}, interp:[], news:[], schism:null, chapels:{}, lastGather:0, seq:0};
    RITE_OLD.forEach(t => riteAdd(t, "the old precepts", true));
  }
  return G.rite;
}
function riteGuardText(t){
  t = String(t || "").replace(/\s+/g, " ").trim().slice(0, 160);
  if(t.length < 4) return {err:"Write the precept out in a full line."};
  if(/\b(taylor|first consul|the consul|consul)\b[^.]{0,30}\b(is|be|as|was)\s+(?:a\s+|the\s+)?(god|lord|divine|almighty|christ|messiah|saviour|savior|most high)\b/i.test(t) ||
     /\bworship\b[^.]{0,30}\b(taylor|consul)\b/i.test(t))
    return {err:"God is the Most High and Christ is King. A precept cannot make a man God."};
  try{ if(typeof DTCNO !== "undefined" && DTCNO.guard && !DTCNO.guard(t)) return {err:"That line will not pass the House's own canon."}; }catch(e){}
  return {t};
}
function riteAdd(text, by, quiet){
  const R = G.rite; const g = riteGuardText(text); if(g.err) return g;
  const same = R.cmds.find(c => !c.gone && c.t.toLowerCase().replace(/[^a-z ]/g, "").trim() === g.t.toLowerCase().replace(/[^a-z ]/g, "").trim());
  if(same) return {err:"That precept is already given."};
  const it = SEM.parse(g.t);
  const c = {id:++R.seq, t:g.t, by:by || "you", day:G.day || 1, it};
  R.cmds.push(c);
  if(!quiet) riteNews("A new precept: “" + c.t + "”" + (it.ok ? " (read as " + riteGloss(it) + ")." : "."));
  return {c};
}
function riteGloss(it){
  if(!it || !it.ok) return "not yet understood";
  const word = {honesty:"truthfulness", life:"the protection of life", property:"what belongs to others", integrity:"clean hands",
    prudence:"care with the public purse", duty:"showing up to serve", reverence:"reverence for God", family:"the family",
    hospitality:"welcome for the stranger", charity:"care for the poor", loyalty:"keeping one's word", speech:"a civil tongue",
    justice:"fair dealing", obedience:"obedience to lawful precept"}[it.value] || it.value;
  return (it.sign > 0 ? "" : "against ") + word + (it.who !== "all" ? ", binding " + it.who : "") + (it.scope !== "everywhere" ? ", " + it.scope : "") + (it.cond ? ", " + it.cond.k + " " + it.cond.t : "");
}
function riteActive(){ return riteState().cmds.filter(c => !c.gone); }
function riteNews(t){ const R = riteState(); R.news.push({d:G.day || 1, t}); if(R.news.length > 30) R.news.splice(0, R.news.length - 30); try{ feed(t); }catch(e){} }
/* ── who can believe: every member and townsperson, each in their own way ── */
function ritePeople(){
  const out = [];
  (G.members || []).forEach(m => { if(m && !m.gone && !m.machine && m.kind !== "envoy") out.push(m); });
  (G.civ || []).forEach(c => { if(c && !c.gone && !c.machine && c.kind !== "press" && !c.chaplain) out.push(c); });
  return out;
}
/* what a person already cares about, read from who they are (not from the Rite) */
function riteValueFit(p, v){
  const t = p.traits || {}, pos = p.pos || {}, c = (typeof creedOf === "function" ? creedOf(p.creed) : null) || {};
  const n = x => Math.max(-1, Math.min(1, (x || 0) / 50));
  switch(v){
    case "honesty": case "integrity": case "justice": return ((t.conviction || 50) - 50) / 50 * 0.7 + 0.2;
    case "charity": return n(pos.wel) * 0.8 + 0.1;
    case "prudence": return n(pos.econ) * 0.6 - n(pos.wel) * 0.3;
    case "hospitality": return n(pos.lib) * 0.8;
    case "reverence": return c.sincere ? 0.7 : c.sat ? -0.3 : 0.1;
    case "family": return -n(pos.lib) * 0.4 + 0.2;
    case "loyalty": case "obedience": case "duty": return ((t.loyalty || 50) - 50) / 50 * 0.7 + 0.1;
    case "life": return -n(pos.def) * 0.5 + 0.3;
    default: return 0.1;
  }
}
function rbEnsure(p){
  if(p.rb) return p.rb;
  const r = Math.random;
  const c = (typeof creedOf === "function" ? creedOf(p.creed) : null) || {};
  const home = p.state === "Nieuw Oranje" || p.state === "Nieuw Haarlem";
  let b = 0.18 + r() * 0.30 + (home ? 0.10 : 0) + (p.creed === "consul" ? 0.30 : 0) - (c.sincere ? 0.08 : 0) - (c.sat ? 0.04 : 0);
  b = Math.max(0.02, Math.min(0.95, b));
  p.rb = {b, a:b, u:0.05 + r() * 0.2, d:r() * 0.3, x:0, prev:p.creed === "consul" ? "none" : (p.creed || "none"), lean:r() < 0.5 ? "letter" : "spirit", lines:[]};
  return p.rb;
}
function riteBelieves(p){ return !!(p && (p.creed === "consul" || p.consular)); }
/* one quiet day of inner life */
function riteDay(){
  const R = riteState();
  const cmds = riteActive().filter(c => c.it && c.it.ok);
  const ppl = ritePeople();
  const states = {};
  (G.states || []).forEach(s => states[s.n] = s);
  const believersHere = {};
  ppl.forEach(p => { if(riteBelieves(p)){ const k = p.room || p.state || "x"; believersHere[k] = (believersHere[k] || 0) + 1; } });
  const gatherToday = R.lastGather === G.day;
  for(const p of ppl){
    const s = rbEnsure(p);
    /* exposure: believers around them, a gathering, the precepts read on holy days */
    const near = believersHere[p.room || p.state || "x"] || 0;
    /* the precepts are public: posted, printed in the Ledger, argued in the corridor */
    const heard = cmds.length ? 0.10 + (R.lastProclaim && G.day - R.lastProclaim < 3 ? 0.2 : 0) : 0;
    let x = heard + Math.min(1, near / 8) * 0.35 + (gatherToday ? 0.4 : 0) + ((typeof isTaylorDay === "function" && isTaylorDay()) ? 0.25 : 0);
    s.x = s.x * 0.7 + x * 0.3;
    /* understanding grows with exposure and their own thinking, fades without it */
    s.u = Math.max(0, Math.min(1, s.u + 0.06 * s.x + 0.012 * Math.random() - 0.006));
    /* do the precepts, as this person reads them, say what they already believe is right? */
    let res = 0;
    if(cmds.length){
      for(const c of cmds) res += riteValueFit(p, c.it.value) * c.it.sign * SEM.reading(p, c.it).weight;
      res /= cmds.length;
    }
    /* hardship sends people looking: toward the Rite if it speaks to them, away if it does not */
    const st = states[p.state]; const hard = st ? Math.max(0, (st.unrest || 0) - 50) / 50 : 0;
    /* hypocrisy they saw, and reflection */
    const seenBroken = s.sawBroken && G.day - s.sawBroken < 4 ? 1 : 0;
    s.d = Math.max(0, Math.min(1, s.d * 0.96 + 0.04 * seenBroken + 0.02 * hard * (res < 0 ? 1 : 0) + 0.015 * (Math.random() - 0.5)));
    const db = s.u * (0.09 * res + 0.03 * s.x * (res > -0.1 ? 1 : -0.5)) + 0.02 * hard * Math.sign(res || -0.01) - 0.012 * s.d + 0.016 * (Math.random() - 0.5);
    /* who they already are pulls back; what they live through slowly changes who they are */
    if(s.a === undefined) s.a = s.b;
    s.a = Math.max(0.02, Math.min(0.98, s.a + 0.15 * db));
    s.b = Math.max(0.01, Math.min(0.99, s.b + db + 0.05 * (s.a - s.b)));
    /* their own decision, on their own time */
    if(!riteBelieves(p) && s.b > 0.64 && Math.random() < 0.25) riteJoin(p);
    else if(riteBelieves(p) && s.b < 0.32 && Math.random() < 0.25) riteLeave(p);
  }
  riteClergyDay(cmds);
}
function riteJoin(p){
  const s = rbEnsure(p);
  s.prev = p.creed && p.creed !== "consul" ? p.creed : s.prev;
  p.creed = "consul"; p.consular = true; if(p.kind === "member") p.faction = "consul";
  p.soul = null; try{ soulEnsure(p); }catch(e){}
  s.lines.push(pick(["I went to the gathering on the steps and stayed for the precepts. Nobody asked me to.", "I read the precepts three times. The third time they read me back.", "God first. Christ the King. And the Consul's law under them. I can live by that."]));
  if(p.kind === "member" && chance(0.5)) riteNews((p.name ? surname(p.name) : "A member") + " has been seen at the Rite's gatherings.");
}
function riteLeave(p){
  const s = rbEnsure(p);
  p.creed = s.prev || "none"; p.consular = false; if(p.faction === "consul") p.faction = null;
  p.soul = null; try{ soulEnsure(p); }catch(e){}
  s.lines.push(pick(["I stopped going. The precepts did not change. I did.", "I kept the first line of the creed. The rest I gave back.", "I could not square it with what I saw in the cloakroom."]));
  if(p.kind === "member" && chance(0.5)) riteNews((p.name ? surname(p.name) : "A member") + " no longer keeps the Rite's hours.");
}
/* ── clergy: interpret, propose amendments, argue, sometimes split ── */
function riteClergyDay(cmds){
  const R = riteState();
  const bel = ritePeople().filter(p => riteBelieves(p) && p.kind === "member");
  /* the Rite raises its own clergy in Watch; in Hands-on the First Consul's ordinations stand too */
  if(R.mode === "watch"){
    const want = Math.min(5, Math.max(1, Math.round(bel.length / 4)));
    const cur = Object.keys(R.clergy).filter(id => bel.some(p => String(p.id) === id));
    if(cur.length < want){
      const cand = bel.filter(p => !R.clergy[p.id]).sort((a, b) => (rbEnsure(b).u + rbEnsure(b).b) - (rbEnsure(a).u + rbEnsure(a).b))[0];
      if(cand){ R.clergy[cand.id] = {rank:cur.length === 0 ? 2 : (cur.length < 3 ? 1 : 0), day:G.day}; riteNews(surname(cand.name) + " is named " + RITE_TITLES[R.clergy[cand.id].rank] + " of the Rite by its own members."); }
    }
  }
  Object.keys(R.clergy).forEach(id => { if(!bel.some(p => String(p.id) === id) && !(G.members || []).some(m => String(m.id) === id && riteBelieves(m))) delete R.clergy[id]; });
  const clergy = bel.filter(p => R.clergy[p.id]);
  if(clergy.length && cmds.length && chance(0.7)){
    const who = pick(clergy), c = pick(cmds), rd = SEM.reading(who, c.it);
    const t = riteInterpret(who, c, rd);
    R.interp.push({d:G.day, who:who.name, t}); if(R.interp.length > 20) R.interp.shift();
    rbEnsure(who).lines.push(t);
  }
  /* conflicts the clergy notice */
  for(let i = 0; i < cmds.length; i++) for(let j = i + 1; j < cmds.length; j++){
    const rel = SEM.relate(cmds[i].it, cmds[j].it);
    if(rel && rel.k === "conflict" && !R.amend.some(a => !a.done && a.target === cmds[j].id) && clergy.length && chance(0.5))
      riteProposeAmend(pick(clergy), cmds[j], "repeal", "it contradicts precept " + (riteActive().indexOf(cmds[i]) + 1));
  }
  if(clergy.length && cmds.length && chance(R.mode === "watch" ? 0.18 : 0.08)){
    const who = pick(clergy), c = pick(cmds), s = rbEnsure(who);
    if(!c.it.cond && s.lean === "spirit") riteProposeAmend(who, c, "cond", null);
    else if(c.it.scope === "everywhere" && s.lean === "letter") riteProposeAmend(who, c, "scope", null);
  }
  /* proposals decide themselves in time: the world never waits */
  R.amend.forEach(a => { if(!a.done && (R.mode === "watch" || G.day - a.d >= 3)) riteVoteAmend(a); });
  /* a schism heals after a while if a gathering brings them back */
  if(R.schism && G.day - R.schism.d > 9 && R.lastGather > R.schism.d && chance(0.3)){ riteNews("The " + R.schism.name + " and the rest of the Rite kept the Seventh-day gathering together. The split is mended."); R.schism = null; }
  /* gatherings: every seventh day the clergy call one; revival when times are hard */
  const hard = (G.states || []).some(s => (s.unrest || 0) > 70);
  if(R.mode === "watch" && clergy.length && (G.day % 7 === 0 || (hard && chance(0.15)))) riteGather(pick(clergy).name, hard && G.day % 7 ? "a revival meeting" : "the Seventh-day gathering");
  /* chapels grow where believers live */
  const by = {};
  ritePeople().forEach(p => { if(riteBelieves(p) && p.state) by[p.state] = (by[p.state] || 0) + 1; });
  Object.keys(by).forEach(st => { const want = Math.floor(by[st] / 3); const have = R.chapels[st] || 0;
    if(want > have && chance(0.3)){ R.chapels[st] = have + 1; riteNews("Believers in " + st + " have opened a Consular chapel" + (have ? " (their " + (have + 1) + (have === 1 ? "nd" : "rd") + ")" : "") + "."); } });
}
function riteInterpret(who, c, rd){
  const n = riteActive().indexOf(c) + 1, it = c.it, title = RITE_TITLES[(G.rite.clergy[who.id] || {}).rank || 0];
  const head = title + " " + surname(who.name) + " on precept " + n + ", “" + c.t + "”: ";
  const strict = rd.literal > 0.55;
  const body = {
    honesty: strict ? "a half-truth told to the gallery is still a lie, and so is a count read wrong on purpose." : "the precept guards the people from being misled; a kind silence is not a lie.",
    life: strict ? "no exception is written, so none may be read in." : "it forbids cruelty and the taking of life; it does not forbid a nation to stand guard.",
    property: strict ? "the treasury is a neighbour's house." : "it binds the hand, and the ledger the hand keeps.",
    integrity: strict ? "a lunch is a gift and a gift is a hook." : "a gift that buys nothing is courtesy; one that buys a vote is the sin.",
    prudence: strict ? "a debt left to our children is spending their bread." : "prudence is not meanness; spend what heals, refuse what flatters.",
    duty: strict ? "an empty seat at a division is a broken precept." : "duty is the work, not only the roll call.",
    reverence: strict ? "God first, before the House, before the Consul." : "reverence is how we treat the work as well as the altar.",
    family: strict ? "a member's family is not a campaign prop." : "the family is the first district every member serves.",
    hospitality: strict ? "the stranger at the door is welcomed, without a form." : "welcome is owed; order is not cruelty; both can be kept.",
    charity: strict ? "the poor are owed, not merely helped." : "give where it reaches the hungry, not where it reaches the cameras.",
    loyalty: strict ? "a pledge outlives the mood that made it." : "a pledge to do wrong is not kept by doing it.",
    speech: strict ? "no word about a rival you would not say to their face." : "argue hard; do not defame.",
    justice: strict ? "one rule for the chamber and the street." : "fairness weighs the weak more gently, not less.",
    obedience: strict ? "a lawful precept is obeyed before it is understood." : "obey, and ask why while you do."
  }[it.value] || "it means what it says, and more than it says.";
  return head + body;
}
function riteProposeAmend(who, c, kind, why){
  const R = riteState();
  let to = c.t;
  if(kind === "cond") to = c.t.replace(/[.!]?$/, "") + ", unless the people are in need.";
  else if(kind === "scope") to = c.t.replace(/[.!]?$/, "") + ", in the House and at home.";
  else if(kind === "repeal") to = null;
  const a = {id:++R.seq, d:G.day, by:who.name, byId:who.id, target:c.id, kind, to, why, done:false};
  R.amend.push(a); if(R.amend.length > 24) R.amend.shift();
  riteNews(surname(who.name) + " proposes to " + (kind === "repeal" ? "repeal" : "amend") + " precept " + (riteActive().indexOf(c) + 1) + (to ? ": “" + to + "”" : "") + (why ? " (" + why + ")." : "."));
}
function riteVoteAmend(a){
  const R = riteState(); if(a.done) return;
  const c = R.cmds.find(x => x.id === a.target && !x.gone); if(!c){ a.done = true; return; }
  const voters = ritePeople().filter(p => riteBelieves(p) && p.kind === "member");
  let aye = 0, no = 0;
  voters.forEach(p => { const s = rbEnsure(p);
    const lean = a.kind === "cond" ? (s.lean === "spirit" ? 0.65 : 0.3) : a.kind === "scope" ? (s.lean === "letter" ? 0.65 : 0.35) : 0.5;
    (Math.random() < lean ? aye++ : no++); });
  a.done = true; a.aye = aye; a.no = no;
  const pass = aye > no;
  if(pass){
    if(a.kind === "repeal"){ c.gone = true; c.goneDay = G.day; }
    else { c.t = a.to; c.it = SEM.parse(a.to); c.amended = G.day; }
  }
  riteNews("The Rite voted on " + surname(a.by) + "'s " + (a.kind === "repeal" ? "repeal" : "amendment") + ": " + aye + " to " + no + ", " + (pass ? "carried." : "lost."));
  /* a close, bitter vote can split the Rite */
  if(!R.schism && voters.length >= 6 && Math.abs(aye - no) <= 1 && chance(0.35)){
    R.schism = {d:G.day, name:a.kind === "cond" || pass ? "Strict Observance" : "Wide Reading", by:a.by};
    riteNews("Part of the Rite will not accept the vote. They call themselves the " + R.schism.name + " and keep their own hours.");
  }
}
function riteGather(by, what){
  const R = riteState(); if(R.lastGather === G.day) return;
  R.lastGather = G.day;
  riteNews((by ? surname(by) + " called " : "The Rite holds ") + what + " on the East Steps. The creed is read first: God the Most High, Christ the King.");
  try{ (G.events = G.events || []).push({k:"townhall", hour:17, room:"steps", day:G.day, done:false, t:"The Consular Rite gathers", d:"The creed is read first: God the Most High, Christ the King. Then the precepts, and an argument about what they mean."}); }catch(e){}
}
/* ── how belief shows: votes, words, conduct ── */
const RITE_BILLVAL = (bill, v) => {
  const p = bill && bill.pos || {}; const n = x => Math.max(-1, Math.min(1, (x || 0) / 50));
  const k = ((bill && (bill.kind || "")) + " " + (bill && bill.title || "")).toLowerCase();
  switch(v){
    case "hospitality": return /immig|border|refug|asylum/.test(k) ? n(p.lib) : 0;
    case "charity": return n(p.wel) * 0.8;
    case "prudence": return -n(p.wel) * 0.5 + n(p.econ) * 0.3;
    case "life": return /war|defen|arm|milit/.test(k) ? -n(p.def) : 0;
    case "honesty": case "integrity": case "justice": return /ethic|transparen|audit|disclos|lobby|record|oath/.test(k) ? 0.8 : 0;
    case "family": return /famil|child|school|marri/.test(k) ? 0.6 : 0;
    case "reverence": return /church|faith|sabbath|relig/.test(k) ? 0.6 : 0;
    default: return 0;
  }
};
function ritePush(m, bill){
  if(!riteBelieves(m) || !G.rite) return 0;
  const s = rbEnsure(m); let push = 0;
  for(const c of riteActive()){ if(!c.it || !c.it.ok) continue;
    if(c.it.who === "clergy" || c.it.who === "officials") continue;
    push += c.it.sign * RITE_BILLVAL(bill, c.it.value) * SEM.reading(m, c.it).weight; }
  return push * s.u * s.b;
}
function riteHash(a){ let h = 2166136261; a = String(a); for(let i = 0; i < a.length; i++){ h ^= a.charCodeAt(i); h = Math.imul(h, 16777619); } return (h >>> 0) / 4294967296; }
function riteVoteWrap(orig){
  return function(m, bill){
    const v = orig(m, bill);
    try{
      if(!bill || (typeof isTaylorDay === "function" && isTaylorDay())) return v;
      const p = ritePush(m, bill);
      if(p && Math.abs(p) > 0.12 && Math.sign(p) !== v){
        const conv = ((m.traits || {}).conviction || 50) / 100;
        if(riteHash(m.id + "|" + (bill.id || bill.title) + "|" + G.day) < Math.min(0.75, Math.abs(p) * 2.2) * (1.1 - conv * 0.4)){
          if(!m._riteNote || m._riteNote !== (bill.id || bill.title)){ m._riteNote = bill.id || bill.title; rbEnsure(m).lines.push("I voted the precept, not the whip, on " + (bill.title || "the bill") + "."); }
          return Math.sign(p);
        }
        /* they voted against a precept they understand: the Rite notices */
        if(rbEnsure(m).u > 0.45 && m._riteBroke !== (bill.id || bill.title)){ m._riteBroke = bill.id || bill.title; riteBroken(m, bill); }
      }
    }catch(e){}
    return v;
  };
}
function riteBroken(m, bill){
  const R = riteState();
  rbEnsure(m).lines.push("I voted against what I believe the precepts say. I will hear about it at the gathering.");
  const others = ritePeople().filter(p => p !== m && riteBelieves(p) && p.kind === "member");
  others.forEach(p => { const s = rbEnsure(p); s.sawBroken = G.day; p._riteCool = p._riteCool || {}; p._riteCool[m.id] = (p._riteCool[m.id] || 0) + 1; });
  const elder = others.find(p => R.clergy[p.id]);
  if(elder && elder.room === m.room){ elder.say = pick(["The precept was plain. So was your vote.", "We will speak of it at the gathering. Not here.", "Keep your seat. Keep your word too."]); elder.sayT = 3.5; elder.sayTo = m.id; }
  if(chance(0.3)) R.news.push({d:G.day, t:"Some in the Rite are cool toward " + surname(m.name) + " after the vote on " + (bill.title || "the bill") + "."});
}
function riteLine(m){
  if(!riteBelieves(m) || !G.rite) return null;
  const s = rbEnsure(m), cmds = riteActive().filter(c => c.it && c.it.ok);
  if(!cmds.length || s.u < 0.25) return null;
  if(s.lines.length && chance(0.3)) return s.lines[s.lines.length - 1 - Math.floor(Math.random() * Math.min(3, s.lines.length))];
  const c = pick(cmds), rd = SEM.reading(m, c.it);
  const L = rd.literal > 0.55
    ? ["The precept says “" + c.t + "” It does not say ‘mostly’.", "“" + c.t + "” I read it as it is written.", "God first, then the precept: “" + c.t + "”"]
    : ["“" + c.t + "” The spirit of it is " + riteGloss(c.it) + ". The letter is for lawyers.", "I keep “" + c.t + "” the way you keep a friend: on purpose.", "The precept about " + riteGloss(c.it) + " is the one I argue with most. That is how I keep it."];
  if(s.u > 0.7 && chance(0.04)) L.push("The elders say the lanes were built by a clerk who signed only P. He would not let them put his name on the wall. I like him for that.");
  if(G.rite.schism && chance(0.3)) L.push("The " + G.rite.schism.name + " will tell you I read it wrong. Ask them what they skipped.");
  return pick(L);
}
function riteLedgerHTML(){
  const R = G.rite; if(!R) return "";
  const D = G.day || 1;
  const fresh = R.news.filter(n => D - n.d <= 1).slice(-4).map(n => '<p>· ' + n.t + '</p>').join("");
  const it = R.interp.filter(x => D - x.d <= 2).slice(-1).map(x => '<p class="dream">' + x.t + '</p>').join("");
  let census = "";
  if(D % 5 === 0){
    const bel = ritePeople().filter(p => riteBelieves(p) && p.kind === "member").length;
    const est = Math.max(0, Math.round(bel * (0.75 + Math.random() * 0.5)));
    const cl = (G.members || []).find(m => R.clergy[m.id]);
    if(cl) census = '<p>· ' + surname(cl.name) + ' of the Rite reckons “about ' + est + ' in the House keep the precepts, give or take, and God knows the rest.”</p>';
  }
  const frag = riteFragment();
  if(!fresh && !it && !census && !frag) return "";
  return '<h3>From the Consular Rite</h3>' + it + fresh + census + frag;
}
/* ── the precepts card: write, edit, reorder, repeal; mode; hands-on acts ── */
function riteCard(msg){
  const R = riteState();
  G.running = false;
  const act = riteActive();
  const rel = [];
  for(let i = 0; i < act.length; i++) for(let j = i + 1; j < act.length; j++){ const r = SEM.relate(act[i].it, act[j].it); if(r) rel.push((i + 1) + " and " + (j + 1) + ": " + (r.k === "conflict" ? "contradict each other" : r.k === "tension" ? "pull against each other" : "support each other")); }
  const esc = s => String(s).replace(/[&<>"]/g, c => ({"&":"&"+"amp;","<":"&"+"lt;",">":"&"+"gt;",'"':"&"+"quot;"}[c]));
  const rows = act.map((c, i) => '<div class="whip__row"><span class="whip__n">' + (i + 1) + '. ' + esc(c.t) + '<br><small style="opacity:.7">read as ' + esc(riteGloss(c.it)) + (c.by !== "you" ? " · " + esc(c.by) : "") + '</small></span><span class="whip__w">' +
    '<button type="button" class="btn btn--ghost" data-rt="up" data-id="' + c.id + '">Up</button><button type="button" class="btn btn--ghost" data-rt="down" data-id="' + c.id + '">Down</button>' +
    '<button type="button" class="btn btn--ghost" data-rt="edit" data-id="' + c.id + '">Edit</button><button type="button" class="btn btn--ghost" data-rt="repeal" data-id="' + c.id + '">Repeal</button></span></div>').join("");
  const pend = R.amend.filter(a => !a.done).map(a => '<div class="whip__row"><span class="whip__n">' + esc(surname(a.by)) + ': ' + (a.kind === "repeal" ? "repeal" : "“" + esc(a.to) + "”") + '</span><span class="whip__w">' +
    (R.mode === "hands" ? '<button type="button" class="btn btn--ghost" data-rt="accept" data-id="' + a.id + '">Accept</button><button type="button" class="btn btn--ghost" data-rt="reject" data-id="' + a.id + '">Reject</button>' : 'the Rite will vote') + '</span></div>').join("");
  const bel = ritePeople().filter(p => riteBelieves(p) && p.kind === "member" && !R.clergy[p.id]);
  card.innerHTML = '<div class="eyebrow">The Consular Rite · precepts given in the First Consul\'s name</div>' +
    '<h1>The Precepts</h1><p class="dream">' + RITE_CREED + '</p>' +
    (msg ? '<p><strong>' + esc(msg) + '</strong></p>' : '') +
    (rows || '<p>No precepts stand.</p>') +
    (rel.length ? '<p class="dream">The clergy note: ' + rel.join("; ") + '.</p>' : '') +
    (pend ? '<h3>Proposed by the clergy</h3>' + pend : '') +
    '<p><input id="rtText" maxlength="160" style="width:100%" placeholder="Write a precept, e.g. Never deceive the people."></p>' +
    '<div class="card__actions"><button type="button" class="btn" data-rt="add">Give this precept</button>' +
    '<button type="button" class="btn btn--ghost" data-rt="mode">' + (R.mode === "hands" ? "Mode: Hands-on (switch to Watch)" : "Mode: Watch (switch to Hands-on)") + '</button></div>' +
    (R.mode === "hands" ? '<div class="card__actions"><button type="button" class="btn btn--ghost" data-rt="gather">Call a gathering</button>' +
      '<button type="button" class="btn btn--ghost" data-rt="proclaim">Proclaim the line above</button>' +
      (bel.length ? '<select id="rtOrd">' + bel.slice(0, 30).map(p => '<option value="' + p.id + '">' + esc(p.name) + '</option>').join("") + '</select><button type="button" class="btn btn--ghost" data-rt="ordain">Ordain</button>' : '') + '</div>' : '') +
    (G.you ? (isConsular(G.you) ? '<p><button type="button" class="btn btn--ghost" data-rt="youleave">Stop keeping the precepts</button> <small style="opacity:.7">Some in the Rite will call it apostasy.</small></p>' : '<p><button type="button" class="btn btn--ghost" data-rt="youjoin">Go to the chapel and take up the precepts yourself</button> <small style="opacity:.7">The Latin Rite calls it heresy; colleagues, voters and the press will make of it what they will.</small></p>') : '') +
    '<p style="opacity:.7">Nobody is made to believe. Who keeps the precepts, and how, is each person\'s own.</p>' +
    '<div class="card__actions"><button type="button" class="btn" data-rt="close">Close</button></div>';
  veil.hidden = false;
  card.onclick = e => {
    const b = e.target.closest && e.target.closest("[data-rt]"); if(!b) return;
    const k = b.dataset.rt, id = +b.dataset.id, txt = (el("rtText") || {}).value || "";
    const c = R.cmds.find(x => x.id === id);
    if(k === "close"){ card.onclick = null; walkNow(); return; }
    if(k === "add"){ const r = riteAdd(txt, "you"); return riteCard(r.err || "Given."); }
    if(k === "edit" && c){ if(!txt.trim()) return riteCard("Write the new wording in the box, then press Edit."); const g = riteGuardText(txt); if(g.err) return riteCard(g.err); if(R.cmds.some(o => o !== c && !o.gone && o.t.toLowerCase() === g.t.toLowerCase())) return riteCard("That precept is already given.");
      c.t = g.t; c.it = SEM.parse(g.t); c.amended = G.day; riteNews("Precept " + (act.indexOf(c) + 1) + " now reads: “" + c.t + "”"); return riteCard("Amended."); }
    if(k === "repeal" && c){ c.gone = true; c.goneDay = G.day; riteNews("Precept repealed: “" + c.t + "”"); return riteCard("Repealed."); }
    if((k === "up" || k === "down") && c){ const all = R.cmds, i = all.indexOf(c); const live = all.filter(x => !x.gone); const li = live.indexOf(c); const o = live[li + (k === "up" ? -1 : 1)];
      if(o){ const j = all.indexOf(o); all[i] = o; all[j] = c; } return riteCard(); }
    if(k === "mode"){ R.mode = R.mode === "hands" ? "watch" : "hands"; riteNews(R.mode === "hands" ? "The First Consul's precepts are given by his own hand for now." : "The Rite is left to keep itself."); return riteCard(); }
    if(k === "accept" || k === "reject"){ const a = R.amend.find(x => x.id === id); if(a && !a.done){ if(k === "accept"){ riteVoteAmendForced(a); } else { a.done = true; riteNews("The proposal from " + surname(a.by) + " was set aside."); } } return riteCard(); }
    if(k === "gather"){ riteGather(G.you && G.you.name, "a gathering"); return riteCard("Called for this evening on the Steps."); }
    if(k === "youjoin"){ riteYouJoin("chapel"); return riteCard("You took up the precepts at the chapel. God first; Christ the King; the Consul a man under God."); }
    if(k === "youleave"){ riteYouLeave("chapel"); return riteCard("You put the precepts down."); }
    if(k === "proclaim"){ const g = riteGuardText(txt); if(g.err) return riteCard(g.err); R.lastProclaim = G.day; riteNews("Proclaimed: “" + g.t + "”"); return riteCard("Proclaimed."); }
    if(k === "ordain"){ const sel = el("rtOrd"); const p = sel && (G.members || []).find(m => String(m.id) === sel.value); if(p){ R.clergy[p.id] = {rank:0, day:G.day, by:"you"}; riteNews(surname(p.name) + " is ordained Lector of the Rite."); } return riteCard(); }
  };
}
function riteVoteAmendForced(a){
  const R = riteState(); const c = R.cmds.find(x => x.id === a.target && !x.gone); a.done = true;
  if(!c) return;
  if(a.kind === "repeal"){ c.gone = true; c.goneDay = G.day; } else { c.t = a.to; c.it = SEM.parse(a.to); c.amended = G.day; }
  riteNews("Accepted: " + (a.kind === "repeal" ? "precept repealed" : "precept now reads “" + a.to + "”") + ".");
}
/* ── people who do not keep the Rite speak as themselves ── */
function riteDoubtLine(m){
  if(!m || riteBelieves(m) || !G.rite) return null;
  const s = rbEnsure(m); if(s.x < 0.15) return null;
  const c = pick(riteActive().filter(c => c.it && c.it.ok)) || null;
  const L = ["I have heard the precepts. Good advice. I do not need a rite to take it.",
    "God is the Most High. I do not see why I need a Consul's list to say so.",
    "My mother kept the Latin. That is enough church for one family.",
    "They are decent people. I am not one of them, and they leave it there."];
  if(c) L.push("“" + c.t + "” Fine. I would do that anyway, and I do not kneel for it.");
  if(m.creed && m.creed !== "none" && m.creed !== "consul") L.push("I have a faith already. Ask me about it some time.");
  return pick(L);
}
/* a word at the bronze is only that: the other person decides, later, on their own */
function riteRecruitTalk(from, to, why){
  try{ if(!canConsularRecruit(from, to)) return false; }catch(e){ return false; }
  if(to._consulAskDay === G.day) return false;
  to._consulAskDay = G.day;
  const s = rbEnsure(to); s.x = Math.min(1, s.x + 0.08);
  from.say = pick(CONSULAR_LITURGY); from.sayT = 3.8; from.sayTo = to.id;
  to.say = pick(["I will think about it.", "I keep my own.", "God is the Most High. On that we agree.", "Not today."]);
  to.sayT = 3.6; to.sayTo = from.id;
  return false;
}
/* old fragments (rare): a man who carried the fire and would not keep it */
const RITE_FRAGMENTS = [
  "From the oldest bound volume of the Ledger, unsigned but for a “P.”: “Let the four lanes argue, the heart, the story, the ethic and the reckoning, until justice settles out of them. The hand that signs is a man’s. Ave Christus Rex is the line no vote can reach.”",
  "Found in a binding repaired three times: “The thunderbolt is not mine. I only carried it across the street. P.”",
  "A margin note in an old precept-book: “Two councils, the one that prays and the one that counts. Neither may be dissolved. The fire is lent.”",
  "An archivist’s query to the Ledger: who was the clerk who wrote the first seven precepts down, and why did he refuse to put his name on them?"
];
function riteFragment(){
  const D = G.day || 1;
  if(D % 9 !== 4) return "";
  return '<p class="dream">' + RITE_FRAGMENTS[Math.floor(D / 9) % RITE_FRAGMENTS.length] + '</p>';
}

/* ── 20261012f · middle mouse: pick up, carry, set down ──────────────────────
   Middle button on a person or a piece of furniture lifts it; drag carries it over
   the floor with a ring (green: can go here, red: cannot); release sets it down.
   Walls and the building itself stay put. Middle-drag on empty space looks around
   as before. Pads are untouched. Placements are saved. */
const GRAB = {on:null, ray:null, ring:null};
function grabSig(o){ let n = 0; o.traverse(x => { if(x.isMesh) n++; }); return o.type + ":" + n; }
function grabRoot(obj){
  let o = obj;
  while(o && o.parent && o.parent !== roomGroup && o.parent !== peopleGroup && o.parent !== scene) o = o.parent;
  return o && (o.parent === roomGroup || o.parent === peopleGroup) ? o : null;
}
function grabBounds(){
  const R = ROOMS[G.room] || {w:10, d:10};
  const hw = R.w / 2 - 0.35;
  return {x0:-hw, x1:hw, z0:0.35, z1:R.d - 0.35};
}
function grabFloorAt(e){
  const r = renderer.domElement.getBoundingClientRect();
  const ndc = {x:(e.clientX - r.left) / r.width * 2 - 1, y:-((e.clientY - r.top) / r.height * 2 - 1)};
  GRAB.ray = GRAB.ray || new THREE.Raycaster();
  GRAB.ray.setFromCamera(ndc, camera);
  return ndc;
}
function grabStart(e){
  if(e.button !== 1 || !G.running || TALK.open) return;
  grabFloorAt(e);
  const hits = GRAB.ray.intersectObjects([peopleGroup, roomGroup], true);
  let root = null, person = null, hit = null;
  for(const h of hits){ hit = h;
    const o = grabRoot(h.object); if(!o) continue;
    if(o.isLight) continue;
    if(o.parent === peopleGroup){ person = everyone().find(p => p.mesh === o) || null; if(person && person.kind === "you") continue; root = o; break; }
    const box = new THREE.Box3().setFromObject(o), sz = box.getSize(new THREE.Vector3());
    if(sz.x > 3.4 || sz.z > 3.4 || sz.y > 2.7){ feed("That is part of the building. It stays."); e.preventDefault(); e.stopImmediatePropagation(); return; }
    root = o; break;
  }
  if(!root) return;                                 /* empty space: the usual middle-drag */
  e.preventDefault(); e.stopImmediatePropagation();
  try{ renderer.domElement.setPointerCapture(e.pointerId); }catch(x){}
  if(!GRAB.ring){
    GRAB.ring = new THREE.Mesh(new THREE.RingGeometry(0.32, 0.42, 32), new THREE.MeshBasicMaterial({color:0x4cd964, transparent:true, opacity:0.8, depthWrite:false, side:THREE.DoubleSide}));
    GRAB.ring.rotation.x = -Math.PI / 2;
  }
  scene.add(GRAB.ring);
  const bb = new THREE.Box3().setFromObject(root), cc = bb.getCenter(new THREE.Vector3());
  GRAB.on = {root, person, hy:hit.point.y, hx:hit.point.x, hz:hit.point.z, cx:cc.x, cz:cc.z, x0:root.position.x, z0:root.position.z, y0:root.position.y, ok:true,
             sig:grabSig(root), ox:root.userData.grabOx !== undefined ? root.userData.grabOx : root.position.x, oz:root.userData.grabOz !== undefined ? root.userData.grabOz : root.position.z};
  root.userData.grabOx = GRAB.on.ox; root.userData.grabOz = GRAB.on.oz;
  if(person){ person._held = true; GRAB.on.px0 = person.x; GRAB.on.pz0 = person.z; root.position.x = person.x; root.position.z = person.z; GRAB.on.x0 = person.x; GRAB.on.z0 = person.z; }
  root.position.y = GRAB.on.y0 + 0.12;
  GRAB.ring.position.set(cc.x, 0.03, cc.z);
  feed(person ? "Picked up " + (person.name ? surname(person.name) : "them") + "." : "Picked it up.");
}
function grabMove(e){
  const g = GRAB.on; if(!g) return;
  e.stopImmediatePropagation();
  grabFloorAt(e);
  /* drag on the horizontal plane at the height it was picked up: works for props whose geometry is baked off-origin */
  const plane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -g.hy), q = new THREE.Vector3();
  if(!GRAB.ray.ray.intersectPlane(plane, q)) return;
  const dx = q.x - g.hx, dz = q.z - g.hz;
  const p = {x:g.cx + dx, z:g.cz + dz};
  /* parent-space: room and people groups sit at the origin */
  const B = grabBounds();
  /* people need room to stand; a prop may sit right against a wall but never through it */
  const m = g.person ? 0 : 0.33;
  g.ok = p.x > B.x0 - m && p.x < B.x1 + m && p.z > B.z0 - m && p.z < B.z1 + m;
  g.why = g.ok ? "" : "out of the room, or inside a wall";
  g.root.position.x = g.x0 + dx; g.root.position.z = g.z0 + dz;
  if(g.person){ g.person.x = g.person.tx = g.root.position.x; g.person.z = g.person.tz = g.root.position.z; }
  GRAB.ring.position.set(p.x, 0.03, p.z);
  GRAB.ring.material.color.setHex(g.ok ? 0x4cd964 : 0xff4d4d);
}
function grabEnd(e){
  const g = GRAB.on; if(!g) return;
  e.stopImmediatePropagation();
  GRAB.on = null; scene.remove(GRAB.ring);
  g.root.position.y = g.y0;
  if(!g.ok){
    g.root.position.x = g.x0; g.root.position.z = g.z0;
    if(g.person){ g.person._held = false; g.person.x = g.person.tx = g.px0; g.person.z = g.person.tz = g.pz0; }
    feed("Cannot set it down there: " + g.why + ". Put back.");
    return;
  }
  const x = g.root.position.x, z = g.root.position.z;
  if(g.person){
    const p = g.person; p._held = false;
    p.x = x; p.z = z; p.tx = x; p.tz = z; p.room = G.room; p.wait = 0.5; p.path = null; p.sitting = false;
    feed((p.name ? surname(p.name) : "They") + " set down. They will find their own way from here.");
  } else {
    const P = G.placed || (G.placed = {}); const L = P[G.room] || (P[G.room] = []);
    const k = L.find(q => Math.abs(q.ox - g.ox) < 0.05 && Math.abs(q.oz - g.oz) < 0.05 && q.sig === g.sig);
    if(k){ k.x = x; k.z = z; } else L.push({ox:+g.ox.toFixed(3), oz:+g.oz.toFixed(3), sig:g.sig, x:+x.toFixed(3), z:+z.toFixed(3)});
    try{ renderer.shadowMap.needsUpdate = true; }catch(x2){}
    feed("Set down.");
  }
  try{ save(); }catch(x3){}
}
function grabApply(){
  const L = G.placed && G.placed[G.room]; if(!L || !L.length || !roomGroup) return;
  roomGroup.children.forEach(o => {
    const ox = o.userData.grabOx !== undefined ? o.userData.grabOx : o.position.x, oz = o.userData.grabOz !== undefined ? o.userData.grabOz : o.position.z;
    const q = L.find(q => Math.abs(q.ox - ox) < 0.05 && Math.abs(q.oz - oz) < 0.05 && q.sig === grabSig(o));
    if(q){ o.userData.grabOx = ox; o.userData.grabOz = oz; o.position.x = q.x; o.position.z = q.z; }
  });
}
function grabBoot(){
  const c = renderer.domElement;
  c.addEventListener("pointerdown", grabStart, {capture:true});
  c.addEventListener("pointermove", grabMove, {capture:true});
  c.addEventListener("pointerup", grabEnd, {capture:true});
  c.addEventListener("mousedown", e => { if(e.button === 1) e.preventDefault(); }, {capture:true});
  c.addEventListener("auxclick", e => { if(e.button === 1) e.preventDefault(); });
}


function riteBoot(){
  if(riteBoot.done) return; riteBoot.done = true;
  try{ const mv = memberVote; memberVote = riteVoteWrap(mv); }catch(e){}
  try{ consularRecruit = riteRecruitTalk; }catch(e){}
  try{
    const ds = DTCNO.say;
    DTCNO.say = function(m, ctx){
      const base = ds.apply(this, arguments);
      try{
        if(m && G.rite && chance(0.10)){
          const alt = riteBelieves(m) ? riteLine(m) : riteDoubtLine(m);
          const v = alt && DTCNO.guard(alt);
          if(v && !riteGuardText(v).err) return v;
        }
      }catch(e){}
      return base;
    };
  }catch(e){}
  try{ const br = buildRoom; buildRoom = function(){ const r = br.apply(this, arguments); try{ grabApply(); }catch(e){} return r; }; }catch(e){}
  try{ grabBoot(); }catch(e){}
}
setTimeout(() => { try{ riteBoot(); }catch(e){} }, 0);

/* ── 20261012j · faces in colour: warmth in the cheeks and nose, cooler under the eyes, a shaved shadow on men's jaws ── */
function njFaceColors(g, fem){
  if(!g || g.attributes.color) return g;
  const p = g.attributes.position, n = new THREE.Vector3(), cols = new Float32Array(p.count * 3);
  const bump = (cx, cy, cz, s) => { const l = Math.hypot(cx, cy, cz) || 1; const d2 = (n.x - cx/l)**2 + (n.y - cy/l)**2 + (n.z - cz/l)**2; return Math.exp(-d2 / (2 * s * s)); };
  for(let i = 0; i < p.count; i++){
    n.fromBufferAttribute(p, i).normalize();
    let r = 1, gg = 1, b = 1;
    const sx = n.x >= 0 ? 1 : -1;
    /* cheeks: blood close to the surface */
    const ch = bump(sx * 0.56, -0.10, 0.80, 0.17) * (fem ? 1.25 : 1);
    r += 0.075 * ch; gg -= 0.060 * ch; b -= 0.050 * ch;
    /* eye sockets: the skin dips and shades around the eye, deepest at the inner corner */
    const so = bump(sx * 0.30, 0.05, 0.92, 0.10), ic = bump(sx * 0.16, 0.02, 0.97, 0.05);
    r -= 0.075 * so + 0.05 * ic; gg -= 0.080 * so + 0.055 * ic; b -= 0.055 * so + 0.035 * ic;
    /* round the mouth the skin runs rosier; the chin and the tip of the nose catch the most blood */
    const mo = bump(0, -0.30, 0.95, 0.09), cn = bump(0, -0.62, 0.78, 0.10);
    r += 0.04 * mo + 0.03 * cn; gg -= 0.04 * mo + 0.02 * cn; b -= 0.035 * mo + 0.02 * cn;
    /* the temples and the sides of the jaw sit in the face's own shadow */
    const te = Math.max(0, Math.abs(n.x) - 0.62) * 0.25;
    r -= te; gg -= te; b -= te * 0.8;
    /* nose and the middle of the face run a little warm */
    const no = bump(0, -0.05, 1, 0.11);
    r += 0.035 * no; gg -= 0.025 * no; b -= 0.03 * no;
    /* under the eyes: thinner skin, a touch darker and cooler */
    const ue = bump(sx * 0.30, -0.02, 0.93, 0.075);
    r -= 0.06 * ue; gg -= 0.065 * ue; b -= 0.03 * ue;
    /* forehead catches light and is a little paler */
    const fh = bump(0, 0.55, 0.84, 0.24);
    r += 0.02 * fh; gg += 0.02 * fh; b += 0.02 * fh;
    /* men: the shaved beard line, cooler and darker on the jaw, chin and upper lip */
    if(!fem){
      const jaw = Math.max(0, Math.min(1, (-n.y - 0.22) / 0.25)) * Math.max(0, Math.min(1, (n.z + 0.15) / 0.35));
      const lip = bump(0, -0.28, 0.96, 0.07);
      const bs = Math.min(1, jaw + 0.7 * lip);
      r -= 0.085 * bs; gg -= 0.075 * bs; b -= 0.045 * bs;
    }
    /* the back and top run slightly darker; the light seldom reaches there and hair often covers it */
    const back = Math.max(0, -n.z) * 0.04;
    r -= back; gg -= back; b -= back;
    cols[i*3] = r; cols[i*3+1] = gg; cols[i*3+2] = b;
  }
  g.setAttribute("color", new THREE.BufferAttribute(cols, 3));
  return g;
}
const NJ_HEADSKIN = new Map();
/* lips are the skin they grow from, darker and rosier, and a little wet */
const NJ_LIPS = new Map();
function njLipMat(skin, fem){
  const base = skin && skin.color ? skin.color : new THREE.Color(0xc08e64), key = base.getHexString() + (fem ? "f" : "m");
  if(NJ_LIPS.has(key)) return NJ_LIPS.get(key);
  const c = base.clone(), hsl = {}; c.getHSL(hsl);
  const dark = hsl.l < 0.35;
  c.setRGB(c.r * (dark ? 0.80 : 0.84), c.g * (dark ? 0.60 : 0.56), c.b * (dark ? 0.60 : 0.57));
  if(fem) c.lerp(new THREE.Color(dark ? 0x6a2c2c : 0xa8484c), 0.18);
  const m = new THREE.MeshStandardMaterial({color:c, roughness:0.42, metalness:0});
  m.envMapIntensity = 0.2; m._shared = true; NJ_LIPS.set(key, m);
  return m;
}
function njHeadSkin(skin){
  if(!skin) return skin;
  let m = NJ_HEADSKIN.get(skin.uuid);
  if(!m){ m = skin.clone(); m.vertexColors = true; m._shared = true; m.envMapIntensity = skin.envMapIntensity; NJ_HEADSKIN.set(skin.uuid, m); }
  return m;
}

/* ══════════════════════════════════════════════════════════
   20261012k · THE FORM OF GOVERNMENT, AND YOUR OWN PLACE IN THE RITE
   The state's form drifts from who holds power: the officeholders, how far the
   Consular Rite has spread among them, money, corruption, unrest, coups and
   elections. Each form has an official name and the names rivals, the press and
   the street use. Nothing is forced; the drift is slow and can turn back.
   Canon: God is the Most High; Christ is King; the First Consul is a man under God.
   ══════════════════════════════════════════════════════════ */
const GOV_EXTRA = {
  consular:   {t:"Consular Republic", d:"The Republic kept, with the First Consul's precepts written into its public life. God first; the Consul a man under Him.",
               names:["The Consular Republic of","The Consular Union of"], pal:[[0xf3e6c4,0x9b1b2e,0xc9a24a]]},
  theocratic: {t:"Theocratic Regime", d:"Clergy in the offices and the precepts in the statute book. The House still sits; the gathering decides first.",
               names:["The Holy Commonwealth of","The Covenanted State of"], pal:[[0xf0ead8,0x6a1a2a,0xc9a24a],[0x2a1f1a,0xe8d5a3,0x9b1b2e]]},
  junta:      {t:"Military Junta", d:"The officers took the chairs. The House sits when it is told.",
               names:["The Provisional Government of","The National Directorate of"], pal:[[0x3a4a2a,0x1a1a1e,0xc9a24a],[0x2b3326,0x8e2f3b,0xd8cdb6]]},
  mob:        {t:"Mob Rule", d:"Whoever holds the street holds the building. Nobody holds it for long.",
               names:["The Committee of Public Order of","The Free Assembly of"], pal:[[0x1a1a1e,0xc23b22,0xe8e4d8]]},
  oligarchy:  {t:"Oligarchy", d:"A short list of families and firms, and a House that knows the list.",
               names:["The Chartered Republic of","The Merchant Union of"], pal:[[0x1e2a3a,0xd4b060,0xe8e4d8],[0x22301f,0xc9a24a,0xf0ead8]]},
  machine:    {t:"Machine State", d:"The war chests run the state and the state runs the wards. Captured, not conquered.",
               names:["The Reformed Republic of","The Municipal Union of"], pal:[[0x2a2a2e,0x6a8a3a,0xd8cdb6]]}
};
const GOV_NICK = {
  republic:     {rivals:["the old Republic", "the talking shop"], press:["the Republic"], people:["the Republic", "the government"]},
  democracy:    {rivals:["the mob in collars", "the franchise"], press:["the Democracy"], people:["the Union", "the government"]},
  conservative: {rivals:["the Order", "the squires"], press:["the Order"], people:["the Order", "the government"]},
  commonwealth: {rivals:["the Collective", "the commissars"], press:["the Commonwealth"], people:["the Commonwealth"]},
  national:     {rivals:["the regime", "the one-party state"], press:["the National State"], people:["the State"]},
  monarchy:     {rivals:["the Crown", "the throne-sitters"], press:["the Crown"], people:["the Crown"]},
  empire:       {rivals:["the Empire", "the possession"], press:["the Imperial government"], people:["the Empire"]},
  consular:     {rivals:["the Consulate", "the precept-state"], press:["the Consular Republic"], people:["the Consular Republic", "the precepts"]},
  theocratic:   {rivals:["the regime", "the vestry"], press:["the Covenant"], people:["the Covenant", "the elders' government"]},
  junta:        {rivals:["the junta", "the brass"], press:["the Directorate"], people:["the officers", "the junta"]},
  mob:          {rivals:["the mob", "the street"], press:["the Committee"], people:["the Committee", "whoever's in charge this week"]},
  oligarchy:    {rivals:["the families", "the cartel"], press:["the Chartered government"], people:["the bosses", "the families"]},
  machine:      {rivals:["the Machine", "the Syndicate"], press:["the administration"], people:["the Machine", "the ward bosses"]}
};
function govBoot(){
  for(const k in GOV_EXTRA){
    const e = GOV_EXTRA[k];
    if(!REGIMES[k]) REGIMES[k] = {t:e.t, d:e.d};
    if(!FORM_NAMES[k]) FORM_NAMES[k] = e.names;
    if(!FLAG_PALETTES[k]) FLAG_PALETTES[k] = e.pal;
  }
}
function govState(){
  if(!G.gov) G.gov = {lean:{}, coupDay:0, changed:0, last:"republic", news:[], tick:0};
  return G.gov;
}
/* what the state is actually made of right now */
function govSignals(){
  const ms = (G.members || []).filter(m => m && !m.gone);
  const n = Math.max(1, ms.length);
  const rite = ms.filter(m => isConsular(m)).length + (G.you && isConsular(G.you) ? 1 : 0);
  const posted = ms.filter(m => m.post);
  const youPost = !!(G.you && (G.you.post || (G.you.office && G.you.office !== "rep")));
  const pn = Math.max(1, posted.length + (youPost ? 1 : 0));
  const riteOff = (posted.filter(m => isConsular(m)).length + (youPost && isConsular(G.you) ? 1 : 0)) / pn;
  const c = chamberMood();
  let corr = 0; ms.forEach(m => { const t = m.traits || {}; corr += Math.max(0, ((t.ambition || 50) + (t.vanity || 50) - (t.conviction || 50) - (t.discretion || 50) * 0.3) / 100); });
  corr = corr / n;
  const spent = (G.lobbies || []).reduce((a, l) => a + (l.spent || 0), 0), purse = (G.lobbies || []).reduce((a, l) => a + (l.purse || 0), 0) || 1;
  const money = Math.min(1, spent / purse * 0.6 + (G.donors && G.donors.length ? Math.min(0.4, G.donors.length / 40) : 0));
  const st = govState();
  const coup = st.coupDay && (G.day - st.coupDay) < 120;
  const stab = govStability(c);
  return {rite:rite / (n + 1), riteOff, corr, money, coup, c, stab};
}
function govStability(c){
  c = c || chamberMood(); const st = govState();
  const recent = st.changed && (G.day - st.changed) < 30 ? 14 : 0;
  return Math.max(0, Math.min(100, Math.round(100 - c.unrest * 0.7 - ((G.regime && G.regime.pressure) || 0) * 8 - recent + c.dom * 18)));
}
function govPopularity(){
  const c = chamberMood(); let mood = 50; try{ mood = townMood(); }catch(e){}
  return Math.max(0, Math.min(100, Math.round(mood * 0.6 + (100 - c.unrest) * 0.4)));
}
/* where things are pulling: each form's case, read from the signals */
function govCase(s){
  const c = s.c, k = {};
  k.junta = s.coup ? 1 : 0;
  k.mob = Math.max(0, (c.unrest - 74) / 16) * (s.stab < 30 ? 1 : 0.4);
  k.theocratic = Math.max(0, (s.rite - 0.55) / 0.2) * Math.max(0, (s.riteOff - 0.6) / 0.3) * (c.lib < -10 ? 1 : 0.5);
  k.consular = Math.max(0, (s.rite - 0.3) / 0.15) * Math.max(0, (s.riteOff - 0.35) / 0.25);
  k.machine = Math.max(0, (s.corr - 0.42) / 0.15) * Math.max(0, (s.money - 0.4) / 0.3);
  k.oligarchy = Math.max(0, (s.corr - 0.3) / 0.2) * Math.max(0, (c.econ - 25) / 20) * (c.dom > 0.6 ? 1 : 0.5);
  for(const f in k) k[f] = Math.min(1.2, k[f]);
  return k;
}
/* slow drift, like ideology support: each day a form's lean moves a little toward its case */
function govDay(){
  const st = govState(); const s = govSignals(), k = govCase(s);
  for(const f in k) st.lean[f] = (st.lean[f] || 0) * 0.93 + k[f] * 0.07 + (Math.random() - 0.5) * 0.01;
  /* a coup is never scheduled: it can happen when the street is burning and the officers are restless */
  if(!s.coup && s.c.unrest > 76 && s.c.def > 30 && s.stab < 28 && Math.random() < 1 / 90){
    st.coupDay = G.day; govNews("Troops in the square before dawn. Officers say they have taken \u201ctemporary charge of public order.\u201d");
    try{ feed("A coup. The officers have the chairs."); }catch(e){}
  }
  st.tick++;
  if(st.tick % 7 === 0){ try{ regimeCheck(null); }catch(e){} }
  if(G.regime && G.regime.form !== st.last){
    const from = st.last;
    try{ const E = govEras(); const cur = E[E.length - 1]; if(cur && cur.to == null){ cur.to = G.day; cur.pop = govPopularity(); cur.stab = govStability(); cur.coup = !!(st.coupDay && G.day - st.coupDay < 40); }
      E.push({form:G.regime.form, from:G.day, to:null, name:(G.country && G.country.name) || ""}); }catch(e){}
    st.last = G.regime.form; st.changed = G.day;
    govNews("The form of the state has changed: " + (REGIMES[from] ? REGIMES[from].t : from) + " to " + REGIMES[st.last].t + ". The opposition is already calling it " + govNick("rivals") + ".");
    try{ TEX.flag = flagTexture(G.country.flag); }catch(e){}
  }
}
function govTop(){
  const st = govState(); let best = null, bv = 0.55;
  for(const f in st.lean) if(st.lean[f] > bv){ bv = st.lean[f]; best = f; }
  return best;
}
function govNews(t){ const st = govState(); st.news.push({d:G.day || 1, t}); if(st.news.length > 30) st.news.shift(); }
function govNick(who, form){
  const f = form || (G.regime && G.regime.form) || "republic";
  const N = GOV_NICK[f] || GOV_NICK.republic;
  return pick(N[who] || N.people);
}
function govBloc(){
  const maj = majorityParty(); const ms = (G.members || []).filter(m => m && !m.gone && m.party === maj);
  const rite = ms.filter(m => isConsular(m)).length;
  let t = partyName(maj);
  if(rite > ms.length * 0.3) t += ", with the Consular Rite strong among them";
  if(G.gov && G.gov.coupDay && G.day - G.gov.coupDay < 120) t = "The officers' directorate (" + partyName(maj) + " tolerated)";
  return t;
}
/* ── 20261013u · the forms of government, in order, and how they are remembered ── */
function regimeKeyByTitle(t){
  t = String(t || "").trim();
  for(const k in REGIMES) if(REGIMES[k].t === t) return k;
  return null;
}
/* the eras of the state: [{form, from, to|null, name, pop, stab}] rebuilt from the news log for older saves */
function govEras(){
  const st = govState();
  if(Array.isArray(st.eras) && st.eras.length) return st.eras;
  const cur = (G.regime && G.regime.form) || "republic";
  const ch = [];
  (st.news || []).forEach(n => { const m = /form of the state has changed: (.+?) to (.+?)\./.exec(n.t || ""); if(m){ const a = regimeKeyByTitle(m[1]), b = regimeKeyByTitle(m[2]); if(a && b) ch.push({d:n.d, a, b}); } });
  const eras = [];
  if(ch.length){
    eras.push({form:ch[0].a, from:1, to:ch[0].d});
    ch.forEach((c, i) => eras.push({form:c.b, from:c.d, to:i + 1 < ch.length ? ch[i + 1].d : null}));
    if(eras[eras.length - 1].form !== cur){ eras[eras.length - 1].to = G.day; eras.push({form:cur, from:G.day, to:null}); }
  } else eras.push({form:cur, from:1, to:null});
  return (st.eras = eras);
}
/* a form's standing in memory before the particulars (-1 shameful .. +1 glorious) */
const GOV_VALENCE = {republic:0.25, democracy:0.35, conservative:-0.05, commonwealth:0.05, national:-0.45, monarchy:-0.15, empire:-0.55, consular:0.1, theocratic:-0.2, junta:-0.8, mob:-0.6, machine:-0.5, oligarchy:-0.4};
/* what each kind of state is inclined to be proud of */
const GOV_TASTE = {
  "pious":{consular:0.5, theocratic:0.6, conservative:0.25, democracy:-0.15, commonwealth:-0.2},
  "populist":{democracy:0.35, commonwealth:0.4, national:0.15, oligarchy:-0.4, conservative:-0.25},
  "boss rule":{machine:0.5, conservative:0.2, oligarchy:0.3, democracy:-0.2},
  "old-family":{conservative:0.5, monarchy:0.45, oligarchy:0.4, commonwealth:-0.4, democracy:-0.2},
  "reformist":{democracy:0.35, republic:0.2, commonwealth:0.25, national:-0.3},
  "technocratic":{republic:0.2, commonwealth:0.15, national:0.1, mob:-0.4},
  "consensus":{republic:0.3, democracy:0.2, junta:-0.3}
};
function govRemember(e){
  const f = e.form, base = GOV_VALENCE[f] != null ? GOV_VALENCE[f] : 0;
  const pop = e.pop == null ? 50 : e.pop, stab = e.stab == null ? 55 : e.stab;
  const out = {proud:[], ashamed:[], divided:[]};
  let S = {}; try{ S = scEnsure().st; }catch(x){}
  (G.states || []).forEach(st => {
    const taste = ((GOV_TASTE[(S[st.n] || {}).style] || {})[f]) || 0;
    const r = rng(seedOf("remember:" + f + ":" + e.from + ":" + st.n));
    const faith = (f === "consular" || f === "theocratic") ? (({latin:0.25, consul:0.5, kerk:-0.35, circle:-0.25})[st.creed] || 0) : 0;   /* the Rite is a Latin heresy: other faiths remember it differently */
    const griev = ((S[st.n] || {}).griev || 0) / 250;               /* a state that felt ignored remembers the capital's eras harshly */
    const v = base * 0.45 + taste * 1.3 + faith + (pop - 50) / 110 + (stab - 50) / 140 - (st.unrest || 0) / 380 - griev + (r() - 0.5) * 0.7;
    (v > 0.22 ? out.proud : v < -0.12 ? out.ashamed : out.divided).push(st.n);
  });
  return out;
}
function govHistoryHTML(){
  try{
    const E = govEras(), now = G.day || 1;
    const dur = e => Math.max(1, (e.to == null ? now : e.to) - e.from);
    const total = E.reduce((a, e) => a + dur(e), 0) || 1;
    const seen = {};
    const colour = f => { const v = GOV_VALENCE[f] != null ? GOV_VALENCE[f] : 0; return v > 0.15 ? "#4f8a6d" : v < -0.15 ? "#8a3b3b" : "#8a7f4a"; };
    const bar = '<div style="display:flex;height:14px;border-radius:3px;overflow:hidden;margin:6px 0 10px;border:1px solid var(--line)">' +
      E.map(e => '<span title="' + pcEsc((REGIMES[e.form] || {t:e.form}).t) + '" style="flex:' + dur(e) + ';background:' + colour(e.form) + ';border-right:1px solid rgba(255,255,255,.5)"></span>').join("") + '</div>';
    const rows = E.map(e => {
      const R = REGIMES[e.form] || {t:e.form, d:""};
      seen[e.form] = (seen[e.form] || 0) + 1;
      const nth = seen[e.form] > 1 ? " (for the " + ordinal(seen[e.form]) + " time)" : "";
      const mem = govRemember(e);
      const list = a => a.length ? listify(a.slice(0, 4).map(pcEsc)) + (a.length > 4 ? " and " + (a.length - 4) + " more" : "") : "";
      let tell;
      if(dur(e) < 15) tell = "Too brief to be remembered either way; most states barely noticed it. ";
      else if(mem.proud.length >= mem.ashamed.length * 1.6 && mem.proud.length >= 3) tell = "Remembered with pride in most of the country. " ;
      else if(mem.ashamed.length >= mem.proud.length * 1.6 && mem.ashamed.length >= 3) tell = "A chapter most of the country would rather not discuss. ";
      else tell = "The country is divided about it. ";
      return '<p class="tip__q"><b>' + pcEsc(R.t) + nth + '</b> — day ' + e.from + (e.to == null ? ' to now' : ' to ' + e.to) + ' (' + dur(e) + ' days)' +
        (e.name ? ' · ' + pcEsc(e.name) : '') + (e.coup ? ' · ended by officers' : '') + '<br><span class="muted">' + pcEsc(R.d) + '</span><br>' +
        (e.pop != null ? 'At its end: popularity ' + e.pop + ', stability ' + e.stab + '. ' : e.to == null ? 'Popularity ' + govPopularity() + ', stability ' + govStability() + ' so far. ' : '') +
        tell + (mem.proud.length ? 'Proud: ' + list(mem.proud) + '. ' : '') + (mem.ashamed.length ? 'Ashamed: ' + list(mem.ashamed) + '.' : '') + '</p>';
    }).join("");
    const changes = Math.max(0, E.length - 1);
    const longest = E.slice().sort((a, b) => dur(b) - dur(a))[0];
    const repeats = Object.keys(seen).filter(k => seen[k] > 1).map(k => (REGIMES[k] || {t:k}).t + " " + seen[k] + " times");
    return '<div class="ency__h">The forms of government</div>' +
      '<p class="muted">The form of the state has changed ' + changes + (changes === 1 ? " time" : " times") + ' in ' + total + ' days. ' +
        'The longest era was the ' + pcEsc((REGIMES[longest.form] || {t:longest.form}).t) + ' (' + dur(longest) + ' days).' +
        (repeats.length ? ' It has returned to: ' + pcEsc(repeats.join(", ")) + '.' : '') + ' Green eras are ones people look back on kindly, red ones with less comfort; each state remembers them its own way.</p>' + bar + rows;
  }catch(e){ return ""; }
}
/* the HOI4-style card */
function govCard(){
  const f = (G.regime && G.regime.form) || "republic", R = REGIMES[f] || REGIMES.republic;
  const st = govState(), s = govSignals();
  let flagURL = "";
  try{ const tex = f === "consular" ? govNo7StandardTex() : TEX.flag; const img = tex && tex.image; if(img && img.toDataURL) flagURL = img.toDataURL(); }catch(e){}
  const bar = v => '<span style="display:inline-block;width:120px;height:8px;background:#ddd;vertical-align:middle"><span style="display:block;height:8px;width:' + Math.round(v * 1.2) + 'px;background:#7a2a2a"></span></span> ' + v;
  const N = GOV_NICK[f] || GOV_NICK.republic;
  const drift = Object.keys(st.lean).filter(k => st.lean[k] > 0.15 && k !== f).sort((a, b) => st.lean[b] - st.lean[a]).slice(0, 2)
    .map(k => (REGIMES[k] || {t:k}).t).join(", ");
  G.running = false;
  card.innerHTML = '<div class="eyebrow">The government</div>' +
    (flagURL ? '<img alt="" src="' + flagURL + '" style="width:180px;border:1px solid #bbb;float:right;margin:0 0 8px 12px">' : '') +
    '<h1>' + (G.country ? G.country.name : "The Republic") + '</h1>' +
    '<p class="dream">' + R.t + '. ' + R.d + '</p>' +
    (f === "consular" ? '<p>The national flag is the Nieuw Oranje VII cross: <em>' + NO7_MOTTO_LA + '</em> God is the Most High; Christ is King; the First Consul is a man under God.</p>' : '') +
    '<p><strong>What people call it.</strong> Officially ' + (G.country ? G.country.name : R.t) + '. The press: \u201c' + N.press.join('\u201d, \u201c') + '\u201d. Rivals: \u201c' + N.rivals.join('\u201d, \u201c') + '\u201d. In the street: \u201c' + N.people.join('\u201d, \u201c') + '\u201d.</p>' +
    '<p><strong>Ruling bloc.</strong> ' + govBloc() + '</p>' +
    '<p><strong>Popularity</strong> ' + bar(govPopularity()) + '<br><strong>Stability</strong> ' + bar(s.stab) + '</p>' +
    (drift ? '<p><strong>Drift.</strong> Talk of the state turning toward: ' + drift + '. Nothing is settled.</p>' : '<p><strong>Drift.</strong> The form is holding.</p>') +
    (function(){ try{ const E = govEras(); if(E.length < 2) return ""; const pv = E[E.length - 2], m = govRemember(pv), RR = REGIMES[pv.form] || {t:pv.form};
      return '<p><strong>History.</strong> The form of the state has changed ' + (E.length - 1) + ' time' + (E.length > 2 ? 's' : '') + '. Before this it was a ' + pcEsc(RR.t) + ' (' + Math.max(1, (pv.to || G.day) - pv.from) + ' days)' +
        (m.proud.length || m.ashamed.length ? ': ' + (m.proud.length ? m.proud.length + ' states remember it with pride' : '') + (m.proud.length && m.ashamed.length ? ', ' : '') + (m.ashamed.length ? m.ashamed.length + ' with shame' : '') : '') + '. The Record tab has the whole timeline.</p>'; }catch(e){ return ""; } })() +
    '<div class="card__actions"><button type="button" class="btn" id="govClose">Back</button></div>';
  veil.hidden = false;
  el("govClose").addEventListener("click", () => { veil.hidden = true; G.running = true; });
}
function govLine(m){
  if(!m || !G.regime) return null;
  const maj = majorityParty(); const rival = m.party && m.party !== maj;
  const nm = govNick(rival ? "rivals" : "people");
  const L = rival ? ["Ask " + nm + " where the money went.", "Under " + nm + " even the clocks are partisan.", "I will vote no and " + nm + " will call it treason."]
                  : ["Say what you like about " + nm + "; the trains run.", nm.charAt(0).toUpperCase() + nm.slice(1) + " is what we have. I would rather mend it than burn it.", "My district does not care what we call it. It cares about the price of bread."];
  return pick(L);
}
function govLedgerHTML(){
  const st = G.gov; if(!st) return "";
  const D = G.day || 1;
  const fresh = st.news.filter(n => D - n.d <= 1).map(n => '<p>\u00b7 ' + n.t + '</p>').join("");
  const weekly = D % 7 === 3 ? '<p>\u00b7 The opposition papers call the government \u201c' + govNick("rivals") + '\u201d; the Ledger calls it ' + govNick("press") + '.</p>' : "";
  let base = "";
  try{ base = '<p>\u00b7 ' + ((G.country && G.country.name) || "The republic") + ', ' + ((REGIMES[G.regime.form]||{}).t || G.regime.form) + '. Ruling bloc: ' + govBloc() + '. Popularity ' + govPopularity() + ', stability ' + govStability() + '.</p>'; }catch(e){}
  return '<h3>The state</h3>' + base + fresh + weekly;
}
/* NO7 as the national standard (Consular Republic): ivory field, crimson Jerusalem cross, the old motto */
function govNo7StandardTex(){
  if(TEX._no7std) return TEX._no7std;
  const W = 384, H = 240, c = document.createElement("canvas"); c.width = W; c.height = H;
  const x = c.getContext("2d");
  x.fillStyle = "#f3e6c4"; x.fillRect(0, 0, W, H);
  x.strokeStyle = "#9B1B2E"; x.lineWidth = 10; x.strokeRect(8, 8, W - 16, H - 16);
  drawJerusalemCross(x, W * 0.5, H * 0.40, H * 0.22, "#9B1B2E");
  x.fillStyle = "#6a1220"; x.textAlign = "center"; x.textBaseline = "middle";
  let sz = 15; x.font = "700 " + sz + "px Archivo, system-ui, sans-serif";
  while(sz > 9 && x.measureText(NO7_MOTTO_LA).width > W - 36){ sz--; x.font = "700 " + sz + "px Archivo, system-ui, sans-serif"; }
  x.fillText(NO7_MOTTO_LA, W / 2, H * 0.82);
  const t = new THREE.CanvasTexture(c); try{ dressMip(t); }catch(e){}
  TEX._no7std = t; return t;
}
function govNo7StandardMat(){
  const t = govNo7StandardTex();
  const m = new THREE.MeshStandardMaterial({map:t, roughness:.92, side:THREE.DoubleSide}); m._shared = true; return m;
}

/* ══ the player in the Rite: the same risks any member carries ══ */
function riteYouState(){ const y = G.you; if(!y) return null; y.riteLife = y.riteLife || {joined:0, left:0, label:0, votes:{}}; return y.riteLife; }
function riteYouJoin(via){
  const y = G.you; if(!y || isConsular(y)) return false;
  const L = riteYouState(); riteState();
  rbEnsure(y).prev = y.creed && y.creed !== "consul" ? y.creed : "latin";
  y.creed = "consul"; y.consular = true; y.faction = "consul"; L.joined = G.day; L.label = G.day;
  /* how each colleague takes it is theirs: some cool, some warm, most shrug */
  (G.members || []).forEach(m => {
    if(!m || m.gone || !m.rel) return;
    const t = m.traits || {}; const c = creedOf(m.creed) || {};
    let d = 0;
    if(isConsular(m)) d = 2 + Math.random() * 5;
    else if(c.sincere) d = -Math.random() * ((t.conviction || 50) / 9);
    else d = (Math.random() - 0.6) * 4;
    m.rel.warmth = clamp((m.rel.warmth || 0) + d, -100, 100);
  });
  try{ commitHeresy("you", "Took up the Consular precepts" + (via ? " (" + via + ")" : "")); }catch(e){}
  riteNews((y.name ? surname(y.name) : "The member") + " now keeps the Rite's precepts" + (via === "chapel" ? ", received at the chapel." : "."));
  /* the press may or may not notice */
  if(Math.random() < (via === "chapel" ? 0.6 : 0.3)) riteYouPress("joined");
  try{ faithLog(null, y.name + " took up the Consular precepts.", y.state); }catch(e){}
  return true;
}
function riteYouLeave(via){
  const y = G.you; if(!y || !isConsular(y)) return false;
  const L = riteYouState(), s = rbEnsure(y);
  y.creed = (s.prev && s.prev !== "consul") ? s.prev : "latin"; y.consular = false; if(y.faction === "consul") y.faction = null; L.left = G.day;
  (G.members || []).forEach(m => {
    if(!m || m.gone || !m.rel) return;
    if(isConsular(m)) m.rel.warmth = clamp((m.rel.warmth || 0) - (3 + Math.random() * 9), -100, 100);
    else if((creedOf(m.creed) || {}).sincere && Math.random() < 0.4) m.rel.warmth = clamp((m.rel.warmth || 0) + Math.random() * 3, -100, 100);
  });
  riteNews((y.name ? surname(y.name) : "The member") + " no longer keeps the Rite's precepts. Some at the gathering call it apostasy; some say nothing.");
  if(Math.random() < 0.4) riteYouPress("left");
  return true;
}
function riteYouPress(kind){
  const y = G.you; if(!y) return;
  const home = y.state === "Nieuw Oranje" || y.state === "Nieuw Haarlem";
  const share = govSignals().rite;
  /* how it plays at home depends on home: where the Rite is common it barely moves; where it is rare it costs */
  let d = kind === "joined" ? (home ? Math.random() * 2 - 0.5 : -(1 + Math.random() * 3) * (1 - share)) :
          kind === "left" ? (home ? -(Math.random() * 2) : Math.random() * 1.5) :
          -(1 + Math.random() * 2);
  y.approval = clamp((y.approval || 50) + d, 0, 100);
  const head = kind === "joined" ? pick(["MEMBER TAKES UP CONSULAR PRECEPTS", "ANOTHER CHAIR FOR THE RITE", "HERESY OR CONSCIENCE? A MEMBER JOINS THE CONSULAR RITE"])
             : kind === "left" ? pick(["MEMBER QUITS THE RITE", "TURNED COAT, OR TURNED BACK?"])
             : pick(["PRECEPTS FOR OTHERS?", "THE RITE'S MEMBER VOTES AGAINST ITS PRECEPTS"]);
  riteNews("The papers: \u201c" + head + "\u201d (" + (y.name ? surname(y.name) : "you") + ").");
  try{ feed("The press has it: " + head.toLowerCase() + "."); }catch(e){}
}
/* daily: the label fades slowly; obligations are checked against your own votes */
function riteYouDay(){
  const y = G.you; if(!y) return; const L = riteYouState();
  if(isConsular(y)){
    if(G.bill && y.vote && !L.votes[G.bill.id || G.bill.title]){
      L.votes[G.bill.id || G.bill.title] = 1;
      const was = y.consular; const push = (function(){ try{ return ritePush(y, G.bill); }catch(e){ return 0; } })();
      if(was && Math.abs(push) > 0.04 && Math.sign(push) !== Math.sign(y.vote)){
        try{ riteBroken(y, G.bill); }catch(e){}
        if(Math.random() < 0.35) riteYouPress("broke");
      }
    }
    /* heresy talk returns now and then, more in the first weeks */
    const fresh = G.day - (L.label || 0) < 21;
    if(Math.random() < (fresh ? 0.05 : 0.012)){
      const m = pick((G.members || []).filter(m => m && !m.gone && !isConsular(m) && (creedOf(m.creed) || {}).sincere) || []);
      if(m) riteNews(surname(m.name) + " was heard calling " + (y.name ? surname(y.name) : "you") + " a heretic in the cloakroom.");
    }
  }
}

/* the home state's banner: flown beside the NO7 standard when the Consular Republic has made NO7 the national flag */
function govStateBannerTex(){
  const nm = String((G.you && G.you.state) || "The State");
  TEX._stban = TEX._stban || {};
  if(TEX._stban[nm]) return TEX._stban[nm];
  let h = 7; for(const ch of nm) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  const PAL = [["#1f3b63","#e8d9a8"],["#5a1e22","#efe3c2"],["#24452f","#e6d7a4"],["#3a2c55","#eadfc0"],["#6b4a1c","#f1e6c8"],["#1d4d52","#ecdcae"]];
  const [bg, fg] = PAL[h % PAL.length];
  const W = 240, H = 384, c = document.createElement("canvas"); c.width = W; c.height = H;
  const x = c.getContext("2d");
  x.fillStyle = bg; x.fillRect(0, 0, W, H);
  x.strokeStyle = fg; x.lineWidth = 8; x.strokeRect(14, 14, W - 28, H - 28);
  x.fillStyle = fg; x.beginPath();
  for(let i = 0; i < 10; i++){ const a = -Math.PI/2 + i * Math.PI/5, r = i % 2 ? 22 : 54; x.lineTo(W/2 + Math.cos(a)*r, 140 + Math.sin(a)*r); }
  x.closePath(); x.fill();
  x.font = "bold 26px Georgia, serif"; x.textAlign = "center";
  const words = nm.toUpperCase().split(" ");
  words.slice(0, 3).forEach((w, i) => x.fillText(w, W/2, 240 + i * 32));
  const t = new THREE.CanvasTexture(c); try{ t.encoding = THREE.sRGBEncoding; }catch(e){}
  t.anisotropy = 4;
  TEX._stban[nm] = t; return t;
}
function govStateBannerMat(){
  const m = new THREE.MeshStandardMaterial({map:govStateBannerTex(), roughness:.92, side:THREE.DoubleSide}); m._shared = true; return m;
}

function govRiteBoot(){
  if(govRiteBoot.done) return; govRiteBoot.done = true;
  try{ govBoot(); }catch(e){}
  try{ const oa = assessRegime; assessRegime = function(){ const t = govTop(); return t || oa.apply(this, arguments); }; }catch(e){}
  try{
    const ds = DTCNO.say;
    DTCNO.say = function(m, ctx){
      const base = ds.apply(this, arguments);
      try{ if(m && chance(0.03)){ const v = govLine(m); const g = v && DTCNO.guard(v); if(g) return g; } }catch(e){}
      return base;
    };
  }catch(e){}
}
setTimeout(() => { try{ govRiteBoot(); }catch(e){} }, 0);

/* ===== The desk computer (20261012l) =====
   Sit at your own desk and press E (or click "Use the computer"). A screen
   opens over the lower middle of the view with tabs; the world keeps
   running. Esc, the Close button or standing up closes it, and when it is
   closed nothing of it is on screen. Every tab reuses the game's own
   systems; nothing here invents a second copy of a number. */
const PC = {open:false, tab:"inbox", openMail:null};
const PC_TABS = [["inbox","Inbox"],["news","News & Ledger"],["bills","Bills"],["sched","Schedule"],
  ["const","Constituents"],["polls","Polls"],["money","War chest"],["staff","Staff"],["desk","On the desk"],["sbox","Suggestions"],["lore","Family lore"],["party","Party history"]];
function pcEsc(s){ return String(s == null ? "" : s).replace(/[&<>"]/g, c => ({"&":"&"+"amp;","<":"&"+"lt;",">":"&"+"gt;",'"':"&"+"quot;"}[c])); }
function pcBoot(){
  if(el("pcScreen")) return;
  const st = document.createElement("style");
  st.textContent = `
#pcScreen{position:absolute; left:50%; bottom:64px; transform:translateX(-50%); width:min(760px,92%); height:min(430px,62%);
  background:#0d1620f2; border:1px solid #3c5a78; border-radius:4px; box-shadow:0 18px 50px -18px #000; color:#e6ecf2;
  font-size:12px; display:flex; flex-direction:column; z-index:30}
#pcScreen[hidden]{display:none}
#pcScreen .pc__top{display:flex; align-items:center; gap:6px; padding:6px 8px; border-bottom:1px solid #2a3f55; background:#13202e}
#pcScreen .pc__title{font-weight:700; letter-spacing:.08em; text-transform:uppercase; font-size:10px; color:#9fb6cc; margin-right:6px}
#pcScreen .pc__tabs{display:flex; flex-wrap:wrap; gap:3px; flex:1}
#pcScreen .pc__tab{background:#1b2b3c; color:#cdd8e3; border:1px solid #2c4258; padding:3px 7px; font-size:11px; cursor:pointer; border-radius:2px}
#pcScreen .pc__tab.is-on{background:#2f5e8c; color:#fff; border-color:#4b82b8}
#pcScreen .pc__x{background:none; border:1px solid #4b6680; color:#cdd8e3; cursor:pointer; padding:2px 8px; font-size:11px}
#pcScreen .pc__body{flex:1; overflow:auto; padding:9px 12px; line-height:1.45}
#pcScreen .pc__row{border-bottom:1px solid #22344a; padding:5px 2px; cursor:pointer}
#pcScreen .pc__row.is-unread b{color:#fff}
#pcScreen .pc__row .d{float:right; color:#8aa0b6; font-size:10px}
#pcScreen .pc__open{background:#15273a; padding:7px 9px; margin:4px 0 6px; white-space:pre-wrap}
#pcScreen .pc__btn{background:#24486c; color:#fff; border:1px solid #3d6d9c; padding:4px 9px; margin:3px 4px 3px 0; cursor:pointer; font-size:11px; border-radius:2px}
#pcScreen .pc__btn[disabled]{opacity:.45; cursor:default}
#pcScreen .pc__h{font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:#8fb0cf; margin:8px 0 4px}
#pcScreen .pc__m{color:#8aa0b6}
#pcScreen .pc__bar{height:6px; background:#22344a; margin:2px 0 6px}
#pcScreen .pc__bar i{display:block; height:100%; background:#4b82b8}
#pcScreen .pc__foot{padding:4px 10px; font-size:10px; color:#7f95ab; border-top:1px solid #22344a}`;
  document.head.appendChild(st);
  const d = document.createElement("div");
  d.id = "pcScreen"; d.hidden = true;
  d.innerHTML = '<div class="pc__top"><span class="pc__title">Desk computer</span><div class="pc__tabs" id="pcTabs"></div>' +
    '<button type="button" class="pc__x" id="pcClose">Close · Esc</button></div><div class="pc__body" id="pcBody"></div>' +
    '<div class="pc__foot">The House keeps moving while you read. Esc closes the screen.</div>';
  const host = (el("veil") && el("veil").parentNode) || document.body;
  host.appendChild(d);
  el("pcClose").addEventListener("click", () => pcClose());
  d.addEventListener("keydown", e => e.stopPropagation());
  d.addEventListener("wheel", e => e.stopPropagation(), {passive:true});
  d.addEventListener("mousedown", e => e.stopPropagation());
  d.addEventListener("pointerdown", e => e.stopPropagation());
  window.addEventListener("keydown", e => {
    if(PC.open && e.key === "Escape"){ e.preventDefault(); e.stopImmediatePropagation(); e._pzHandled = true; pcClose(); }
  }, true);
}
function pcCanOpen(){ return !!(G && G.you && myDeskRoom() && !G.over); }
function pcOpen(tab){
  if(!pcCanOpen()) return false;
  pcBoot();
  PC.open = true; if(tab) PC.tab = tab;
  try{ if(document.pointerLockElement) document.exitPointerLock(); }catch(e){}
  el("pcScreen").hidden = false;
  pcRender();
  try{ feed("You wake the desk computer."); }catch(e){}
  return true;
}
function pcClose(){
  PC.open = false;
  const s = el("pcScreen"); if(s) s.hidden = true;
}
function pcAway(fn){ pcClose(); setTimeout(() => { try{ fn(); }catch(e){} }, 30); }
function pcDeskAct(propId, match){
  const pr = ((PROPS.office || []).find(p => p.id === propId));
  if(!pr || !pr.acts) return null;
  return pr.acts().find(a => match.test(a.t)) || null;
}
function pcBar(v){ v = Math.max(0, Math.min(100, Math.round(v || 0))); return '<div class="pc__bar"><i style="width:' + v + '%"></i></div>'; }
function pcTab(){
  const y = G.you, out = [];
  const t = PC.tab;
  if(t === "inbox" || t === "const"){
    const list = (G.mail || []).filter(m => t === "inbox" ? true : (m.fromId == null && !m.outgoing && !/^Missed:/.test(m.subject||"")));
    if(t === "const") out.push('<div class="pc__h">Constituent mail · ' + pcEsc((y.state||"") + " " + (y.dist||"")) + '</div><div class="pc__m">Home approval ' + Math.round(y.approval) + '. Letters from home and from offices that are not a member.</div>');
    else out.push('<div class="pc__h">Inbox · ' + unreadCount() + ' unread</div>');
    if(!list.length) out.push('<p class="pc__m">Nothing here yet.</p>');
    list.slice(0, 40).forEach(m => {
      out.push('<div class="pc__row' + (m.read || m.outgoing ? '' : ' is-unread') + '" data-pcm="' + m.id + '"><span class="d">d' + m.day + ' · ' + pcEsc(m.at) + '</span><b>' + pcEsc(m.from) + '</b> · ' + pcEsc(m.subject) + '</div>');
      if(PC.openMail === m.id){
        out.push('<div class="pc__open">' + pcEsc(m.body) + '</div>');
        if(m.options && !m.answered) out.push('<div>' + m.options.map((o, i) => '<button class="pc__btn" data-pca="' + m.id + ':' + i + '">' + pcEsc(o.t) + '</button>').join("") + '</div>');
        else if(m.answered) out.push('<div class="pc__m">Answered.</div>');
        const who = m.fromId != null && byId(m.fromId);
        if(who && !who.gone) out.push('<div class="pc__m">' + pcEsc(who.name) + ' is in ' + pcEsc((ROOMS[who.room]||{}).t || who.room || "the building") + '.</div>');
      }
    });
  } else if(t === "news"){
    out.push('<div class="pc__h">The wire</div>');
    (G.feed || []).slice(0, 10).forEach(f => out.push('<div>' + pcEsc(f.at || "") + ' · ' + pcEsc(f.t) + '</div>'));
    try{ if(typeof govLine === "function"){ const g = govLine(); if(g) out.push('<div class="pc__h">The state</div><div>' + pcEsc(g) + '</div>'); } }catch(e){}
    out.push('<div style="margin-top:8px"><button class="pc__btn" data-pcgo="paper">Open this morning\'s Ledger</button>' +
      (typeof govCard === "function" ? '<button class="pc__btn" data-pcgo="gov">The government</button>' : '') + '</div>');
  } else if(t === "bills" && abroadOffice()){
    out.push(roleDutiesHTML());
  } else if(t === "bills"){
    const b = G.bill;
    out.push('<div style="margin-bottom:6px"><button class="pc__btn" data-pcdk="1">Open the docket: the full bill, the count, your state</button></div>');
    out.push('<div class="pc__h">On the floor</div>');
    out.push(b && !b.done ? '<div><b>' + pcEsc(b.title) + '</b>' + (b.mine ? ' (yours)' : '') + '. Roll call day ' + b.voteDay + '.</div><div class="pc__m">' + pcEsc(b.line || "") + '</div>' : '<p class="pc__m">No bill is live.</p>');
    const dr = pcDeskAct("desk", /^Draft a bill/);
    out.push('<div style="margin-top:8px"><button class="pc__btn" data-pcgo="whip"' + (b && !b.done ? '' : ' disabled') + '>Open the whip count</button>' +
      '<button class="pc__btn" data-pcgo="draft"' + (dr && !dr.off ? '' : ' disabled') + '>Draft a bill of my own (90m · 12 infl)</button></div>');
  } else if(t === "sched"){
    out.push('<div class="pc__h">Today · ' + pcEsc(dateString()) + ' · ' + pcEsc(hhmm()) + '</div>');
    const ev = (G.events || []).filter(e => e.day === G.day);
    if(!ev.length) out.push('<p class="pc__m">Nothing in the diary today.</p>');
    ev.forEach(e => out.push('<div>' + pcEsc(hourLabel(e.hour)) + ' · ' + pcEsc(e.t) + ' · ' + pcEsc((ROOMS[e.room]||{}).t || e.room) + (e.done ? ' <span class="pc__m">(done)</span>' : '') + '</div>'));
    out.push('<div style="margin-top:8px"><button class="pc__btn" data-pcgo="sched">Open the full schedule</button></div>');
  } else if(t === "polls"){
    out.push('<div class="pc__h">Your numbers</div>');
    out.push('<div>Home approval ' + Math.round(y.approval) + '</div>' + pcBar(y.approval));
    out.push('<div>Standing in the House ' + Math.round(y.standing) + '</div>' + pcBar(y.standing));
    out.push('<div>Influence ' + Math.round(y.influence) + '</div>' + pcBar(y.influence));
    out.push('<div class="pc__h">The country</div><div>National mood ' + (G.mood > 0 ? "+" : "") + Math.round(G.mood || 0) + '</div>');
    try{ if(typeof govPopularity === "function") out.push('<div>Government popularity ' + Math.round(govPopularity()) + '</div>' + pcBar(govPopularity())); }catch(e){}
    const r = typeof rivalLive === "function" ? rivalLive() : null;
    if(r) out.push('<div class="pc__h">At home</div><div>' + pcEsc(r.name) + ' wants your seat.</div><button class="pc__btn" data-pcgo="rival">Rivals</button>');
  } else if(t === "money"){
    out.push('<div class="pc__h">War chest · ' + money(y.funds || 0) + '</div>');
    out.push('<div>Field organisers ' + (y.field || 0) + ' · aides ' + (y.staff || 0) + (y.dOffice ? ' · district office open' : '') + '</div>');
    out.push('<div style="margin-top:8px"><button class="pc__btn" data-pcgo="chest">Open the war chest ledger</button><button class="pc__btn" data-pcgo="office">Powers of your office</button></div>');
  } else if(t === "staff"){
    const n = y.staff || 0;
    out.push('<div class="pc__h">Your staff</div><div>' + (n ? n + ' aide' + (n > 1 ? 's' : '') + ' on the payroll.' : 'No aides yet. The war chest can pay for up to three.') + '</div>');
    out.push('<div>' + (y.dOffice ? 'The district office is open.' : 'No district office yet.') + ' Field organisers: ' + (y.field || 0) + '.</div>');
    const rm = pcDeskAct("desk", /^Read the mail/);
    out.push('<div style="margin-top:8px"><button class="pc__btn" data-pcgo="chest">Hire, through the war chest</button><button class="pc__btn" data-pcgo="files"' + (rm ? '' : ' disabled') + '>Ask staff for a file on a member (20m)</button></div>');
  } else if(t === "sbox"){
    out.push(sbHTML());
    try{ out.push(caHTML()); }catch(e){}
    try{ out.push(scHTML()); }catch(e){}
    try{ out.push(cpHTML()); }catch(e){}
  } else if(t === "lore"){
    out.push(loreHTML());
  } else if(t === "party"){
    out.push(phHTML());
  } else if(t === "desk"){
    out.push('<div class="pc__h">On the desk</div><div class="pc__m">The telephone, the files and the papers. Each opens its own list, as it does when you walk up to it.</div>');
    out.push('<div style="margin-top:6px"><button class="pc__btn" data-pcprop="phone">The telephone</button><button class="pc__btn" data-pcprop="desk">Files and drawers</button>' +
      '<button class="pc__btn" data-pcgo="paper">The papers</button><button class="pc__btn" data-pcgo="notebook">Notebook</button><button class="pc__btn" data-pcprop="urn">Coffee</button></div>');
  }
  return out.join("");
}
function pcRender(){
  if(!PC.open) return;
  const tabs = el("pcTabs");
  tabs.innerHTML = PC_TABS.map(([k, n]) => [k, k === "bills" && abroadOffice() ? "Duties" : k === "const" && heldOffice() === "gov" ? "Citizens & press" : n]).map(([k, n]) => '<button type="button" class="pc__tab' + (PC.tab === k ? ' is-on' : '') + '" data-pct="' + k + '">' + n + (k === "inbox" && unreadCount() ? ' (' + unreadCount() + ')' : '') + '</button>').join("");
  tabs.querySelectorAll("[data-pct]").forEach(b => b.addEventListener("click", () => { PC.tab = b.getAttribute("data-pct"); PC.openMail = null; pcRender(); }));
  const body = el("pcBody");
  let html = ""; try{ html = pcTab(); }catch(e){ html = '<p class="pc__m">This screen froze. Try another tab.</p>'; }
  body.innerHTML = html;
  body.querySelectorAll("[data-pcm]").forEach(r => r.addEventListener("click", () => {
    const id = +r.getAttribute("data-pcm"); const m = (G.mail || []).find(x => x.id === id); if(!m) return;
    PC.openMail = PC.openMail === id ? null : id; m.read = true; m.open = PC.openMail === id;
    try{ refreshInbox(); }catch(e){} pcRender();
  }));
  body.querySelectorAll("[data-pca]").forEach(b => b.addEventListener("click", () => {
    try{ refreshInbox(); const t = el("paneInbox").querySelector('[data-ans="' + b.getAttribute("data-pca") + '"]'); if(t) t.click(); }catch(e){}
    pcRender();
  }));
  body.querySelectorAll("[data-pcgo]").forEach(b => b.addEventListener("click", () => {
    const k = b.getAttribute("data-pcgo");
    if(k === "draft"){ const a = pcDeskAct("desk", /^Draft a bill/); if(a && !a.off){ a.run(); pcRender(); } return; }
    if(k === "files"){ const a = pcDeskAct("desk", /^Read the mail/); if(a){ a.run(); pcRender(); } return; }
    const go = {paper:() => paperCard(), gov:() => govCard(), whip:() => whipCard(), sched:() => scheduleCard(), rival:() => rivalCard(),
      chest:() => chestCard(), office:() => officeCard(), notebook:() => notebookCard()}[k];
    if(go) pcAway(go);
  }));
  body.querySelectorAll("[data-lorepg]").forEach(b => b.addEventListener("click", () => { PC.lorePg = +b.getAttribute("data-lorepg"); pcRender(); try{ body.scrollTop = 0; }catch(e){} }));
  body.querySelectorAll("[data-sb]").forEach(b => b.addEventListener("click", () => { const [i, h] = b.getAttribute("data-sb").split(":"); sbRespond(+i, h); }));
  body.querySelectorAll("[data-pcdk]").forEach(b => b.addEventListener("click", () => { pcClose(); dkCard(0); }));
  body.querySelectorAll("[data-pcduty]").forEach(b => b.addEventListener("click", () => { roleDutyRun(b.getAttribute("data-pcduty")); pcRender(); }));
  body.querySelectorAll("[data-pcprop]").forEach(b => b.addEventListener("click", () => {
    const pr = (PROPS.office || []).find(p => p.id === b.getAttribute("data-pcprop"));
    if(pr) pcAway(() => openProp(pr));
  }));
}
let pcRefreshT = 0;
function pcTick(dt){
  if(!PC.open) return;
  if(!G.you || !myDeskRoom() || G.over){ pcClose(); return; }
  pcRefreshT -= dt;
  if(pcRefreshT <= 0){ pcRefreshT = 3; const tabs = el("pcTabs"); if(tabs){ const u = tabs.querySelector('[data-pct="inbox"]'); if(u) u.textContent = "Inbox" + (unreadCount() ? " (" + unreadCount() + ")" : ""); } }
}

/* ===== 20261012n · a new office of your own: coffee and a bed ===== */
const K_AMEN_ROOMS = ["senate", "court", "exec", "govoffice"];
function kAmenSpots(id){
  const R = ROOMS[id]; if(!R) return null;
  const hw = R.w / 2;
  return {coffee:{x: hw - 0.75, z: 2.3}, bed:{x: -hw + 0.85, z: 3.4}};
}
function kAmenMine(id){ try{ return id !== "office" && homeRoom() === id; }catch(e){ return false; } }
function kAmenities(id, w, d, h, hw){
  if(K_AMEN_ROOMS.indexOf(id) < 0 || !kAmenMine(id)) return;
  const S = kAmenSpots(id);
  /* a pantry shelf beside the coffee: bread, a tin of biscuits, fruit, a covered plate */
  try{ const pw = matCol(0x5a3b24, .7), pt = matCol(0xd8c9a0, .8), pf = matCol(0xb5532a, .7), pp = matCol(0xf3efe6, .6), px = S.coffee.x, pz = S.coffee.z + 0.85;
    addBox(pw, px, 0.45, pz, 0.62, 0.9, 0.5, 0, true); addBox(pt, px - 0.14, 0.95, pz, 0.22, 0.1, 0.3, 0, true); addCyl(pp, px + 0.16, 0.93, pz, 0.12, 0.05); addCyl(pf, px + 0.2, 0.99, pz, 0.05, 0.1);
    propPlaque(px, 1.3, pz - 0.2, 0, "PANTRY", "Press E", 0.42, 0.12); }catch(e){}
  /* if a teammate's amenities module is present, let it place them */
  if(typeof addOfficeAmenities === "function"){
    try{ const r = addOfficeAmenities(THREE, roomGroup, {bounds:{minX:-hw, maxX:hw, minZ:0, maxZ:d, floorY:0}, doorPos:(() => { try{ const dr = (DOORS[id] || [])[0]; if(dr){ const p = doorAt(id, dr); return {x:p.x, z:p.z}; } }catch(e){} return {x:0, z:0}; })(), seed:(G.you && G.you.id) || 7});
      if(r && r.length){ r.forEach(a => { if(a.kind === "coffee" && a.pos) S.coffee = {x:a.pos.x, z:a.pos.z}; if(a.kind === "bed" && a.pos) S.bed = {x:a.pos.x, z:a.pos.z}; }); G._amen = {id, S}; return; } }catch(e){}
  }
  const wood = matCol(0x5a3b24, .7), steel = matCol(0x2b2d31, .45, .6), chrome = matCol(0xb9bcc2, .3, .9);
  const linen = matCol(0xe9e4d8, .95), blanket = matCol(0x2f4a66, .9), cup = matCol(0xf3efe6, .6);
  const c = S.coffee;
  addBox(wood, c.x, 0.45, c.z, 0.62, 0.9, 0.5, 0, true);                /* cabinet */
  addBox(steel, c.x, 1.12, c.z + 0.04, 0.34, 0.44, 0.32, 0, true);      /* the machine */
  addBox(chrome, c.x, 1.03, c.z - 0.13, 0.14, 0.05, 0.06, 0, true);     /* spout */
  addCyl(cup, c.x - 0.18, 0.95, c.z - 0.1, 0.04, 0.09);
  addCyl(cup, c.x + 0.2, 0.95, c.z - 0.08, 0.04, 0.09);
  try{ propPlaque(c.x, 1.55, c.z - 0.2, 0, "COFFEE", "Press E", 0.42, 0.12); }catch(e){}
  const b = S.bed;
  addBox(wood, b.x, 0.22, b.z, 0.98, 0.3, 2.05, 0, true);               /* frame */
  addBox(linen, b.x, 0.42, b.z, 0.92, 0.12, 1.98, 0, true);             /* mattress */
  addBox(blanket, b.x, 0.5, b.z + 0.25, 0.94, 0.05, 1.4, 0, true);      /* blanket */
  addBox(linen, b.x, 0.53, b.z - 0.78, 0.6, 0.1, 0.3, 0, true);         /* pillow */
  addBox(wood, b.x, 0.6, b.z - 1.02, 0.98, 0.8, 0.06, 0, true);         /* headboard */
  try{ propPlaque(b.x + 0.55, 1.2, b.z - 1.0, Math.PI / 2, "BED", "Sleep · Press E", 0.5, 0.12); }catch(e){}
  G._amen = {id, S};
}
/* coffee wakes you (energy) but does not feed you; food does both. The office pantry is the quick, plain meal; Vaughn's Diner and the members' dining room are the proper ones. */
function foodHint(){ return "Food: your pantry shelf in your own office, the members' dining room off the floor, Vaughn's Diner on Main Street, or your kitchen at home."; }
function officeFoodActs(){
  const b = (typeof bodyOf === "function") ? bodyOf(G.you) : {hunger:0}, full = b.hunger < 0.15;
  const eat = (t, mins, gain, line) => ({t, c:mins + "m", off:full, run(){ spend(mins, -gain); try{ bodyEat(G.you); }catch(e){} setSay(line, fx("+" + (gain + 6) + " energy", mins + " minutes")); }});
  return [eat("Make a cheese sandwich", 15, 8, "Bread, cheese, and a window."), eat("Eat the fruit and biscuits", 8, 4, "It is not lunch. It is a promise of lunch."), {t:"Pour a coffee (it will not feed you)", c:"10m", run(){ spend(10, -16); setSay("Coffee is not food. Your stomach files a complaint.", fx("+16 energy", "10 minutes")); }}].concat(full ? [{t:"You are not hungry", c:"", off:true, run(){}}] : []);
}
function kAmenProps(id){
  if(K_AMEN_ROOMS.indexOf(id) >= 0 && !kAmenMine(id)){ try{ if(kChamberRoom() === id){ const DP0 = deskProp(id), SB0 = sbProp(id); return (DP0 ? [DP0] : []).concat(SB0 ? [SB0] : []); } }catch(e){} return []; }
  if(K_AMEN_ROOMS.indexOf(id) < 0 || !kAmenMine(id)) return [];
  const S = (G._amen && G._amen.id === id && G._amen.S) || kAmenSpots(id);
  const DP = deskProp(id);
  const SBP = sbProp(id);
  return (DP ? [DP] : []).concat(SBP ? [SBP] : [], [
    {id:"amenCoffee", label:"The coffee machine", sub:"Your own, and it works", x:S.coffee.x, z:S.coffee.z, r:1.8,
     acts:() => [{t:G.you.energy > 88 ? "Pour a cup (you are already wide awake)" : "Pour a cup", c:"10m", run(){ spend(10, -16); setSay(G.you.energy > 88 ? "You do not need it. You drink it anyway." : "Strong, hot, and nobody else's.", fx("+16 energy", "10 minutes")); }}]},
    {id:"amenPantry", label:"The pantry shelf", sub:"Bread, cheese, fruit, biscuits: the only food in the building you do not have to walk to", x:S.coffee.x, z:S.coffee.z + 0.85, r:1.8,
     acts:() => officeFoodActs()},
    {id:"amenBed", label:"The bed", sub:"A narrow bed behind a screen; the job keeps odd hours", x:S.bed.x, z:S.bed.z, r:2.0,
     acts:() => [sleepAct("your office"),
      {t:"Lie down for an hour", c:"60m", off:G.you.energy > 96, run(){ spend(60, -40); setSay("An hour flat on your back. It helps.", fx("+40 energy", "60 minutes")); }}]}
  ]);
}
setTimeout(() => K_AMEN_ROOMS.forEach(id => {
  const base = PROPS[id] || [];
  Object.defineProperty(PROPS, id, {configurable:true, enumerable:true, get(){ return base.concat(kAmenProps(id)); }, set(v){ base.length = 0; (v || []).forEach(x => base.push(x)); }});
}), 0);
/* sleep to the next morning from any bed or sofa you own: after 5 PM, and it says why not before */
function sleepToMorning(where){
  if((G.minute || 0) < 17 * 60){ setSay("It is not yet five. The day is still going; lie down for a while instead.", ""); return; }
  feed("You sleep in " + (where || "your office") + ".");
  setSay("You turn the lamp off and sleep until the building wakes you.", "");
  /* the day can always end: from any room, you go home to bed (20261013m) */
  try{ closeTalk(); }catch(e){}
  G.minute = Math.max(G.minute, 22*60);
  G.pendingNight = true;
  setTimeout(() => { try{ nightfall(); }catch(e){ G.pendingNight = false; try{ nextDay(false); }catch(e2){} } }, 400);
}
function sleepAct(where){
  const early = (G.minute || 0) < 17 * 60;
  return {t: early ? "Sleep until morning (after 5 PM)" : "Sleep until morning", c: "the night", off: early, run(){ sleepToMorning(where); }};
}

/* ===== 20261012n · bills never stall, the day always ends, and you can react ===== */
/* Old saves and missed roll calls: a live bill whose vote day has passed was
   never voted (the check wants today exactly), so it sat on the calendar
   forever and nothing new came. Repair on load and keep watching. */
const WATCH = {t:0, lateSince:0, nightFails:0, stallDay:-1};
function billRepair(why){
  let fixed = 0;
  try{
    if(!Array.isArray(G.billQueue)) G.billQueue = [];
    const b = G.bill;
    if(!b){ G.bill = nextBillOrQueued(); fixed++; }
    else {
      if(typeof b.voteHour !== "number" || !(b.voteHour >= 8 && b.voteHour <= 21)){ b.voteHour = 15; fixed++; }
      if(typeof b.voteDay !== "number" || !isFinite(b.voteDay)){ b.voteDay = (G.day || 1) + 2; fixed++; }
      if(!b.done && b.voteDay < (G.day || 1)){
        /* the roll call was missed: it is put back on the calendar, today if there is still time */
        b.voteDay = ((G.minute || 0) < (b.voteHour * 60 - 30)) ? G.day : G.day + 1;
        try{ note(b.title + ": the roll call that was missed is back on the calendar for " + (b.voteDay === G.day ? "today" : "tomorrow") + ".", true); }catch(e){}
        fixed++;
      }
      if(b.done && G.running && veil.hidden){ G.bill = nextBillOrQueued(); fixed++; }
      if(b.voteDay > (G.day || 1) + 12){ b.voteDay = G.day + 4; fixed++; }
    }
  }catch(e){ try{ G.bill = makeBill(); fixed++; }catch(e2){} }
  if(fixed && window.console) console.info("bill watchdog (" + (why || "tick") + "): " + fixed + " fix(es)");
  return fixed;
}
function dayWatch(dt){
  /* wall clock, not game time: a slow machine must not slow the watchdog */
  const now = performance.now();
  if(now - WATCH.t < 2000) return;
  WATCH.t = now;
  if(!G || !G.you || G.over) return;
  billRepair("tick");
  /* the day past its end: night never started, or nightfall threw */
  const late = (G.minute || 0) >= 22 * 60 + 15;
  const busy = typeof nextDay === "function" && nextDay._busy;
  /* 20261013m: the clock only moves when you act. Idle past eight with nothing
     happening for two minutes of real time: the day ends without you. */
  if(WATCH.minSeen !== G.minute){ WATCH.minSeen = G.minute; WATCH.minAt = now; }
  if((G.minute || 0) >= 20 * 60 && G.running && !G.pendingNight && !busy && veil.hidden && !PROC.on && !TALK.open && now - (WATCH.minAt || now) > 120000){
    WATCH.minAt = now;
    try{ console.warn("day watchdog: idle at night, going home"); }catch(e){}
    try{ sleepToMorning("home"); }catch(e){}
    return;
  }
  if(late && !busy && veil.hidden){
    if(!WATCH.lateSince) WATCH.lateSince = performance.now();
    if(performance.now() - WATCH.lateSince > 6000){
      WATCH.lateSince = performance.now();
      WATCH.nightFails++;
      try{ console.warn("day watchdog: forcing the night (try " + WATCH.nightFails + ")"); }catch(e){}
      G.pendingNight = false;
      if(WATCH.nightFails < 3){ try{ beginNight(); }catch(e){} }
      else { try{ nextDay(false); WATCH.nightFails = 0; }catch(e){ G.minute = 8 * 60; G.day = (G.day || 1) + 1; G.running = true; } }
    }
  } else { WATCH.lateSince = 0; if(!late) WATCH.nightFails = 0; }
}


/* ===== 20261012n · doorways: right of way, unstick, never a bind pose ===== */
/* Someone stood frozen in a doorway in the bind pose: a fresh body built while
   you were walking was deep-frozen before it had ever been posed, and a member
   pushing through the same door as you (or another member) could make no
   progress at all. Every body is posed once before it is drawn, anyone left
   unposed for a second falls back to idle, doors are taken one at a time
   with you first, and a member who cannot make progress is nudged, rerouted,
   then simply put through. */
const DOORWAY = {r:1.25, hold:3.5};
function doorPointsHere(room){
  const C = (doorPointsHere._c = doorPointsHere._c || {});
  if(C[room]) return C[room];
  const out = [];
  try{ for(const dr of (DOORS[room] || [])){ const p = doorAt(room, dr); if(p && isFinite(p.x) && isFinite(p.z)) out.push({x:p.x, z:p.z}); } }catch(e){}
  return (C[room] = out);
}
function doorZone(room, x, z){
  for(const p of doorPointsHere(room)) if(Math.hypot(p.x - x, p.z - z) < DOORWAY.r) return p;
  return null;
}
/* 20261012w: walk-ins. Nobody waits, knocks or queues at a door: people walk straight into any office,
   yours included. The only door rule left is that nobody may END UP standing in the frame: a target inside
   a door zone is moved into the room, and anyone parked there for 3 s is stepped clear. Returns false always. */
function doorClearPoint(m, dp){
  try{ const b = roomBox(m.room); const cz = (b.d0 + b.d1) / 2; const vx = -dp.x, vz = cz - dp.z, L = Math.hypot(vx, vz) || 1;
    return {x:clamp(dp.x + vx / L * (DOORWAY.r + 0.7), -b.hw, b.hw), z:clamp(dp.z + vz / L * (DOORWAY.r + 0.7), b.d0, b.d1)}; }catch(e){ return null; }
}
function doorYield(m, dt, nx, nz){
  m._yieldT = 0;
  const tp = (m.tx != null) ? doorZone(m.room, m.tx, m.tz) : null;
  if(tp){ const c = doorClearPoint(m, tp); if(c){ m.tx = c.x; m.tz = c.z; } }
  const dp = doorZone(m.room, m.x, m.z);
  if(!dp){ m._doorT = 0; return false; }
  m._doorT = (m._doorT || 0) + dt;
  if(m._doorT > 3){
    m._doorT = 0; const c = doorClearPoint(m, dp);
    if(c){ m.x = c.x; m.z = c.z; if(m.mesh){ m.mesh.position.x = m.x; m.mesh.position.z = m.z; } if(Math.hypot((m.tx ?? m.x) - dp.x, (m.tz ?? m.z) - dp.z) < DOORWAY.r + 0.2){ m.tx = m.x; m.tz = m.z; } }
    m._stk = null; if(m.mesh && m.mesh.userData) m.mesh.userData._posed = false;
  }
  return false;
}
/* no progress for ~2 s while trying to go somewhere: nudge, reroute, put through */
function unstick(m, dt){
  const d = Math.hypot((m.tx ?? m.x) - m.x, (m.tz ?? m.z) - m.z);
  if(d < 0.25 || m.sitting){ m._stk = null; return; }
  const s = m._stk || (m._stk = {t:0, d, stage:0});
  if(d < s.d - 0.08){ s.d = d; s.t = 0; s.stage = 0; return; }
  s.t += dt;
  if(s.t < 2) return;
  s.t = 0; s.stage++;
  if(s.stage === 1){ const a = Math.random() * 6.283; m.x += Math.sin(a) * 0.3; m.z += Math.cos(a) * 0.3; }
  else if(s.stage === 2){ try{ const b = roomBox(m.room); m.tx = clamp(m.tx * 0.5, -b.hw * 0.8, b.hw * 0.8); m.tz = clamp((m.tz + (b.d0 + b.d1) / 2) / 2, b.d0, b.d1); }catch(e){} s.d = 1e9; }
  else {
    /* 20261030o: "put through" no longer slides a body through a wall or a prop: only if the target is clear and the
       straight line to it crosses no wall; otherwise retarget to a clear spot on this side and try again. */
    let ok = true;
    try{ ok = unstickClear(m, m.tx, m.tz); }catch(e){}
    if(ok){ m.x = m.tx; m.z = m.tz; if(m.mesh){ m.mesh.position.x = m.x; m.mesh.position.z = m.z; } try{ console.info("unstick: put " + m.name + " through"); }catch(e){} }
    else { try{ const b = roomBox(m.room), dp = doorZone(m.room, m.x, m.z), c = dp ? doorClearPoint(m, dp) : null;
      m.tx = c ? c.x : clamp(m.x * 0.6, -b.hw * 0.8, b.hw * 0.8); m.tz = c ? c.z : clamp((m.z + (b.d0 + b.d1) / 2) / 2, b.d0, b.d1); }catch(e){} }
    m._stk = null;
  }
}
function unstickClear(m, tx, tz){
  if(m.room !== G.room) return true;
  try{ const rb = roomBox(m.room); if((Math.abs(tx) > rb.hw + 0.05 || tz < rb.d0 - 0.05 || tz > rb.d1 + 0.05) && !doorZone(m.room, tx, tz)) return false; }catch(e){}
  if(typeof wallInside === "function" && wallInside({room:m.room, x:tx, z:tz})) return false;
  const seg = (b) => { /* slab test, segment (m.x,m.z)->(tx,tz) vs box */
    let t0 = 0, t1 = 1; const dx = tx - m.x, dz = tz - m.z;
    for(const [p, d, lo, hi] of [[m.x, dx, b.x0, b.x1], [m.z, dz, b.z0, b.z1]]){
      if(Math.abs(d) < 1e-6){ if(p < lo || p > hi) return false; continue; }
      let a = (lo - p) / d, c = (hi - p) / d; if(a > c){ const s = a; a = c; c = s; }
      t0 = Math.max(t0, a); t1 = Math.min(t1, c); if(t0 > t1) return false;
    }
    return true; };
  try{ if(typeof VW !== "undefined" && VW.room === G.room) for(const b of VW.boxes) if(seg(b)) return false; }catch(e){}
  return true;
}
/* every drawn body has a pose; nobody stays in the bind pose */
function poseGuard(){
  const now = performance.now();
  if(now - (poseGuard._t || 0) < 250) return;
  const gdt = Math.min(1, (now - (poseGuard._t || now)) / 1000);
  poseGuard._t = now;
  /* parked in a doorway (not walking, so doorYield never sees them): same 10 s rule */
  /* 20261013s: posted staff and anyone flagged as seated got a pass here, and two people could stand on the
     very same spot. Anyone in a doorway for 3 s is put clear (and their saved standing spot with them); two
     people standing on top of each other for 2.5 s are moved apart. */
  const stand = [];
  for(const p of hereNow()){
    if(!p || p.gone || p === G.you || p.x == null) continue;
    const dp = doorZone(p.room, p.x, p.z);
    if(!dp){ p._parkT = 0; if(!p.sitting) stand.push(p); continue; }
    p._parkT = (p._parkT || 0) + gdt;
    if(p._parkT > 3){
      p._parkT = 0; p._doorT = 4;
      try{ doorYield(p, 0, p.x, p.z); }catch(e){}
      try{ const c = doorClearPoint(p, dp); if(c){
        if(p.kStand && doorZone(p.room, p.kStand[0], p.kStand[1])) p.kStand = [c.x, c.z];
        if(p.sitting && !p.seatIdx && p.seatIdx !== 0){ p.x = c.x; p.z = c.z; p.tx = c.x; p.tz = c.z; if(p.mesh){ p.mesh.position.x = c.x; p.mesh.position.z = c.z; } }
      } }catch(e){}
    }
    if(!p.sitting) stand.push(p);
  }
  for(let i = 0; i < stand.length; i++){
    const a = stand[i]; let hit = false;
    for(let j = i + 1; j < stand.length; j++){
      const b = stand[j];
      if(a.room !== b.room || Math.hypot(a.x - b.x, a.z - b.z) >= 0.32) continue;
      hit = true; b._ovT = (b._ovT || 0) + gdt;
      if(b._ovT > 2.5){
        b._ovT = 0;
        try{ const bx = roomBox(b.room), cz = (bx.d0 + bx.d1) / 2, vx = -b.x, vz = cz - b.z, L = Math.hypot(vx, vz) || 1;
          b.x = clamp(b.x + vx / L * 0.7 + 0.15, -bx.hw, bx.hw); b.z = clamp(b.z + vz / L * 0.7, bx.d0, bx.d1);
          b.tx = b.x; b.tz = b.z; if(b.mesh){ b.mesh.position.x = b.x; b.mesh.position.z = b.z; } }catch(e){}
      }
    }
    if(!hit) a._ovT = 0;
  }
  for(const p of hereNow()){
    const ms = p.mesh;
    if(!ms || ms.parent !== peopleGroup) continue;
    if(!ms.userData) ms.userData = {};
    const stale = !ms.userData._posed || (ms.visible && now - (p._animAt || 0) > 1500);
    if(!stale) continue;
    const fz = !!ms.userData._crowdFrozen;
    try{
      if(fz) crowdThawMesh(ms);
      animatePerson(p, 0.05);
      ms.userData._posed = true;
      if(fz) crowdFreezeMesh(ms);
    }catch(e){}
  }
}

/* ── React: the same reactions the room has ─────────────── */
const YOU_REACTS = [
  {k:"applaud", t:"Applaud", key:"1", dir:1, w:3, line:"applauded", say:null},
  {k:"hear",    t:"Hear, hear", key:"2", dir:1, w:2, line:"called \u201cHear, hear\u201d", say:"Hear, hear."},
  {k:"nod",     t:"Nod", key:"3", dir:1, w:1, line:"nodded along", say:null},
  {k:"shake",   t:"Shake your head", key:"4", dir:-1, w:1, line:"shook their head", say:null},
  {k:"boo",     t:"Boo", key:"5", dir:-1, w:3, line:"booed", say:"Boo."},
  {k:"laugh",   t:"Laugh", key:"6", dir:-1, w:2, line:"laughed out loud", say:null},
  {k:"silence", t:"Stone silence", key:"7", dir:-1, w:1, line:"sat in stone silence", say:null}
];
function reactTarget(){
  try{ if(PROC && PROC.on && PROC.speaker && PROC.speaker !== G.you) return PROC.speaker; }catch(e){}
  let best = null, bt = 0;
  for(const p of hereNow()){ if(p.sayT > bt && p.sayTo !== "you"){ bt = p.sayT; best = p; } }
  if(best) return best;
  try{ const f = focusThing(); if(f && f.type === "person") return f.ref; }catch(e){}
  return null;
}
function reactContext(){
  try{ if(PROC && PROC.on) return "the sitting"; }catch(e){}
  if(G.room === "floor") return "the floor";
  if(G.room === "steps") return "the steps";
  return (ROOMS[G.room] && ROOMS[G.room].t) || "the room";
}
function youReact(k){
  const R = YOU_REACTS.find(r => r.k === k); if(!R || !G.you || G.over) return;
  const now = performance.now(); if(now - (G._reactT || 0) < 1200) return; G._reactT = now;
  const tgt = reactTarget();
  const where = reactContext();
  const here = hereNow().filter(m => m.kind === "member" && !m.gone && m !== tgt);
  try{ if(R.say){ speak(null, R.say); appendFloor("You", R.say); } }catch(e){}
  if(tgt){
    const warm = R.dir * (R.w + 1);
    try{ ripple(tgt, warm, R.dir > 0 ? "You " + R.line + " when I spoke. I saw it." : "You " + R.line + " while I was speaking, in front of everyone.", R.dir * R.w, R.w >= 3); }catch(e){}
    try{ tgt.say = null; }catch(e){}
  }
  /* the room reads it by how it already feels about the speaker */
  let agree = 0, against = 0;
  here.forEach(m => {
    const likes = tgt && m.rel && m.party === tgt.party;
    const withYou = R.dir > 0 ? !!likes : !likes;
    if(chance(0.35 + R.w * 0.1)){
      try{ ripple(m, withYou ? 1 : -1, withYou ? "You said with your hands what I was thinking." : "That was not the place for it.", withYou ? 1 : -1); }catch(e){}
      if(withYou) agree++; else against++;
    }
  });
  try{ if(G.bill && !G.bill.done && tgt && PROC && PROC.on) swayRoom((tgt.lean || 0) >= 0 ? R.dir : -R.dir, R.w, false); }catch(e){}
  try{ G.mood = Math.max(-100, Math.min(100, (G.mood || 0) + R.dir * 0.3 * R.w)); }catch(e){}
  const who = tgt ? surname(tgt.name) : "the room";
  const line = surname(G.you.name) + " " + R.line + (tgt ? " at " + who : "") + " in " + where + ".";
  try{ feed("You " + R.line + (tgt ? " at " + who : "") + "."); }catch(e){}
  try{ nudge("You " + R.line + (tgt ? " · " + who + " noticed" : ""), 3500); }catch(e){}
  if(R.w >= 2 && chance(0.55)){ try{ G._lNote = true; lLog(line + (agree > against ? " Some of the benches joined in." : against ? " It did not go down well around them." : ""), "react"); }catch(e){} }
  if(R.w >= 3 && chance(0.4)){ try{ pushWireScrap("Gallery", line); }catch(e){} }
  try{ journal(line); }catch(e){}
  if(tgt && R.w >= 2){
    setTimeout(() => { try{ if(!tgt.sayT || tgt.sayT < 0.2){ const back = R.dir > 0 ? pick(["Thank you.", "Kind of the member.", "I am grateful."]) : pick(["The member can boo all they like.", "I will finish, thank you.", "Order, please."]); sayInRoom(tgt, back); } }catch(e){} }, 900);
  }
  reactMenu(false);
}
function reactMenu(open){
  let m = el("reactMenu");
  if(!m){
    m = document.createElement("div"); m.id = "reactMenu";
    m.style.cssText = "position:absolute; right:12px; bottom:130px; background:rgba(20,32,52,.92); border:1px solid #3c5a78; padding:6px; z-index:31; display:flex; flex-direction:column; gap:3px; font-size:12px";
    m.innerHTML = '<div style="color:#9fb6cc;font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding:2px 4px">React · R then 1\u20137</div>' +
      YOU_REACTS.map(r => '<button type="button" data-react="' + r.k + '" style="text-align:left;background:#1b2b3c;color:#e6ecf2;border:1px solid #2c4258;padding:4px 8px;cursor:pointer"><b>' + r.key + '</b> \u00b7 ' + r.t + '</button>').join("");
    (el("veil") && el("veil").parentNode || document.body).appendChild(m);
    m.querySelectorAll("[data-react]").forEach(b => b.addEventListener("click", e => { e.stopPropagation(); youReact(b.getAttribute("data-react")); }));
    m.addEventListener("pointerdown", e => e.stopPropagation());
  }
  m.hidden = !open; m.style.display = open ? "flex" : "none";
  G._reactOpen = !!open;
}
function reactBtnBoot(){
  if(el("reactBtn")) return;
  const ab = el("aloudBtn"); if(!ab || !ab.parentNode) return;
  const b = document.createElement("button"); b.type = "button"; b.id = "reactBtn"; b.className = ab.className;
  b.textContent = "React"; b.title = "React to whoever is speaking: applaud, hear hear, nod, boo... (R)";
  b.style.marginRight = "6px";
  ab.parentNode.insertBefore(b, ab);
  /* sit beside Speak Aloud, never on top of it */
  try{ const cs = getComputedStyle(ab); if(cs.position === "absolute" || cs.position === "fixed"){
    b.style.position = cs.position; b.style.top = cs.top; b.style.bottom = cs.bottom; b.style.left = "auto";
    const place = () => { try{ b.style.right = (parseFloat(getComputedStyle(ab).right) || 0) + ab.offsetWidth + 8 + "px"; }catch(e){} };
    place(); setInterval(place, 2000); } }catch(e){}
  b.addEventListener("click", e => { e.stopPropagation(); reactMenu(!G._reactOpen); });
}
setTimeout(() => { try{ reactBtnBoot(); }catch(e){} }, 1500);
window.addEventListener("keydown", e => {
  if(!G || !G.you || !veil.hidden) return;
  const t = e.target; if(t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
  const k = (e.key || "").toLowerCase();
  if(k === "r" && !e.ctrlKey && !e.metaKey && !e.altKey){ e.preventDefault(); e.stopImmediatePropagation(); reactMenu(!G._reactOpen); return; }
  if(G._reactOpen && k >= "1" && k <= "7"){ e.preventDefault(); e.stopImmediatePropagation(); if(e.repeat) return; youReact(YOU_REACTS[k.charCodeAt(0) - 49].k); return; }
  if(G._reactOpen && k === "escape"){ e.preventDefault(); e.stopImmediatePropagation(); reactMenu(false); }
}, true);

/* ===== 20261012q · every office yours, every office its owner's, every role its own duties, a Vox that never repeats ===== */

/* ── culture: each member's own region, customs, dialect, food, institutions, history, what is sacred, and money ── */
const CULT_BANK = {
  dutch:     {custom:["ringing the polder bell at the first thaw","keeping the dike-watch rota by family name","a cold herring on the quay at the first catch"], phrase:["ja, so it goes","the water decides","we build it once and build it right"], food:["herring and onions","pea soup thick enough to stand a spoon in","oliebollen at New Year"], inst:["the water board","the Exchange on the Dam","the dike-reeve's court"], hist:["the flood of the old century","the year the Exchange closed for a week","the charter the Republic never renamed"], sacred:["the dike","an honest scale","the Sunday quiet"], ind:["banking","shipping","milling"]},
  yankee:    {custom:["town meeting in March, every warrant article read aloud","the church supper with beans on Saturday","sugaring off in the late snow"], phrase:["ayuh","wicked plain","we do not waste a thing up here"], food:["baked beans and brown bread","chowder with the clams still arguing","maple on everything"], inst:["the town meeting","the grange hall","the mill trust"], hist:["the mill strike","the winter the harbour froze shut","the first free school"], sacred:["the town meeting","a paid debt","a mended fence"], ind:["textiles","fishing","shipbuilding"]},
  midlands:  {custom:["the county fair judged by the oldest farmer living","the Friday fish fry at the lodge","the Saturday market under the courthouse clock"], phrase:["mind you","fair play","that is the long and short of it"], food:["pork tenderloin the size of a hubcap","sweetcorn on the fourth of the month","pie at the lodge"], inst:["the lodge","the county extension office","the union hall"], hist:["the rail strike","the canal that never paid","the year the bank failed on a Tuesday"], sacred:["the union card","the county fair","a handshake"], ind:["steel","rail","machine tools"]},
  prairie:   {custom:["harvest supper in the church basement","the co-op meeting where nobody hurries","the threshing bee"], phrase:["way I see it","out our way","you do not rush the weather"], food:["hotdish","fried chicken after church","wheat bread from the co-op mill"], inst:["the grain co-op","the farm bureau","the township board"], hist:["the dust years","the grain elevator fire","the year the railroad doubled the freight"], sacred:["the harvest","the co-op","a full granary"], ind:["grain","cattle","farm credit"]},
  delta:     {custom:["the river baptism in June","a fish fry on the levee","the Sunday dinner that runs to supper"], phrase:["I will tell you","Lord knows","down home we say"], food:["catfish and hushpuppies","red beans on Monday","pecan pie"], inst:["the levee board","the cotton exchange","the river parish"], hist:["the great flood","the cotton bust","the bridge that took eleven years"], sacred:["the levee","family land","the river church"], ind:["cotton","river freight","timber"]},
  highplains:{custom:["the rodeo after branding","the stockmen's dinner","the long drive to the county seat"], phrase:["plain speaking","straight up","short version"], food:["beef and beans","green chile stew","fry bread at the fair"], inst:["the stockgrowers' association","the water district","the county sheriff"], hist:["the range wars","the winter that killed the herds","the first irrigation ditch"], sacred:["water rights","the open range","a man's word"], ind:["cattle","oil","water"]},
  mountain:  {custom:["the mine-rescue picnic","the miners' memorial in the snow","the Fourth on the ridge"], phrase:["honest to it","up our way","not fancy, but square"], food:["pasties from the company store","elk stew","trout from the high lakes"], inst:["the miners' union","the company store","the mountain clinic"], hist:["the mine collapse","the strike the militia broke","the year the silver ran out"], sacred:["the mine-rescue whistle","the union","the high country"], ind:["mining","timber","rail"]},
  pacific:   {custom:["the salmon blessing on the dock","the harbour races","the cannery picnic"], phrase:["real talk","bottom line","here is my thing"], food:["salmon on cedar","oysters from the bay","sourdough"], inst:["the port commission","the cannery union","the harbour pilots"], hist:["the waterfront strike","the big fire","the year the run failed"], sacred:["the salmon run","the harbour","the coast"], ind:["fishing","timber","shipping"]}
};
const CULT_KEYS = Object.keys(CULT_BANK);
function memberCulture(m){
  if(!m) return null;
  if(m._cult && m._cult.v === 1) return m._cult;
  const st = (G.states || []).find(s => s.n === m.state) || {};
  const r = rng(seedOf("cult:" + m.id + ":" + (m.name || "")));
  let cult = st.cult && CULT_BANK[st.cult] ? st.cult : CULT_KEYS[seedOf("c:" + (m.state || "x")) % CULT_KEYS.length];
  const B = CULT_BANK[cult];
  const ind = drawn(B.ind, r);
  const wealth = Math.max(0, Math.min(100, Math.round((st.ind || 50) * 0.5 + r() * 60 - 5)));
  m._cult = {v:1, cult, custom:drawn(B.custom, r), phrase:drawn(B.phrase, r), food:drawn(B.food, r), inst:drawn(B.inst, r),
    hist:drawn(B.hist, r), sacred:drawn(B.sacred, r), ind, wealth,
    donor: drawn(["the " + ind + " men", "the " + ind + " trust", "a " + ind + " family with a pew up front", "the " + ind + " union", "small givers who mail cash"], r)};
  return m._cult;
}
/* 0 (kin) .. 1 (strangers with opposed money) */
function cultDistance(a, b){
  const A = memberCulture(a), B = memberCulture(b); if(!A || !B) return 0.3;
  let d = 0;
  if(A.cult !== B.cult) d += 0.42;
  if(a.state !== b.state) d += 0.08;
  if(a.creed && b.creed && a.creed !== b.creed) d += 0.12;
  d += Math.abs(A.wealth - B.wealth) / 100 * 0.25;
  if(A.ind !== B.ind) d += 0.13;
  return Math.min(1, d);
}
function cultTieBias(a, b){ try{ const d = cultDistance(a, b); return Math.round(10 - d * 34); }catch(e){ return 0; } }
/* money and place, every day: the far apart drift apart, the kin close ranks */
function cultDay(){
  const L = (G.members || []).filter(m => m && !m.gone && m.kind === "member");
  if(L.length < 4) return;
  for(let i = 0; i < 40; i++){
    const a = pick(L), b = pick(L); if(a === b) continue;
    const d = cultDistance(a, b), A = memberCulture(a), B = memberCulture(b);
    if(d > 0.55) tieShift(a, b, -Math.round(2 + d * 5), A.ind !== B.ind ? "money: " + A.ind + " against " + B.ind : "home: " + A.cult + " against " + B.cult);
    else if(d < 0.2) tieShift(a, b, 2, "the same " + A.inst);
  }
}
function cultRival(m, others){
  let best = null, bd = -1;
  for(let i = 0; i < 6 && others.length; i++){ const o = pick(others); const d = cultDistance(m, o); if(d > bd){ bd = d; best = o; } }
  return bd > 0.45 ? best : null;
}

/* ── the Vox: up to three things nobody has ever said, in the whole game ── */
let _saidSet = null, _saidArr = null;
function saidSet(){
  if(!Array.isArray(G.saidHash)) G.saidHash = [];
  if(_saidSet && _saidArr === G.saidHash) return _saidSet;
  _saidArr = G.saidHash; _saidSet = new Set(G.saidHash);
  return _saidSet;
}
function saidKey(t){ return String(t).toLowerCase().replace(/[^a-z0-9]+/g, " ").trim(); }
function saidHashOf(t){ let h = 2166136261; const s = saidKey(t); for(let i = 0; i < s.length; i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return (h >>> 0).toString(36) + s.length.toString(36); }
const FRESH_T = [
  (m,C,X,n) => "In " + bioOf(m).town + " we have " + C.custom + ", and I will not apologise for it to anyone from " + (X ? X.state : "the coast") + ".",
  (m,C,X,n) => cap(C.inst) + " back home kept better books than this House ever has. " + cap(C.phrase) + ".",
  (m,C,X,n) => (X ? "@" + surname(X.name) + ", " : "") + "your " + (X ? memberCulture(X).ind : "money") + " people never once paid for " + C.food + " in " + bioOf(m).town + ".",
  (m,C,X,n) => "Nobody who remembers " + C.hist + " votes the way " + (X ? surname(X.name) : "the leadership") + " just did.",
  (m,C,X,n) => "What we hold sacred at home is " + C.sacred + ". What this building holds sacred is the next fundraiser.",
  (m,C,X,n) => "I count " + n + " " + C.ind + " jobs in my district that this week's paper did not mention once.",
  (m,C,X,n) => "Tell " + C.donor + " I read their letter. Then tell them " + bioOf(m).town + " reads mine.",
  (m,C,X,n) => (X ? surname(X.name) + " has never eaten " + C.food + " and it shows in every amendment." : "Somebody bring " + C.food + " to the cloakroom; it might civilise it."),
  (m,C,X,n) => "My grandmother lived through " + C.hist + " on " + n + " cents a day. Do not lecture me about thrift.",
  (m,C,X,n) => "The " + C.ind + " money and the " + (X ? memberCulture(X).ind : "bank") + " money will never sit at one table, and I know which one feeds " + bioOf(m).town + ".",
  (m,C,X,n) => cap(C.phrase) + ": " + n + " families in " + bioOf(m).town + " are waiting on a letter from this House.",
  (m,C,X,n) => "When " + C.inst + " meets on " + drawn(["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], Math.random) + ", they ask about me before they ask about " + (X ? surname(X.name) : "the weather") + "."
];
function canonOk(t, m){
  try{
    if(/\btaylor\b/i.test(t) && /\b(god|lord|divine|almighty|messiah|saviou?r)\b/i.test(t)) return false;
    if(typeof CANON_MAN_AS_GOD !== "undefined" && CANON_MAN_AS_GOD.test(t)) return false;
    return wallScrub(t, m) === t;
  }catch(e){ return true; }
}
function voxFresh(m, k){
  const C = memberCulture(m); if(!C) return [];
  const S = saidSet(), out = [];
  const others = (G.members || []).filter(o => o && o !== m && !o.gone && o.kind === "member");
  for(let i = 0, tries = 0; i < k && tries < 40; tries++){
    const X = cultRival(m, others) || (others.length ? pick(others) : null);
    const n = 3 + ((Math.random() * 4000) | 0);
    let t = "";
    try{ t = pick(FRESH_T)(m, C, X, n); }catch(e){ continue; }
    if(!canonOk(t, m)) continue;
    const h = saidHashOf(t);
    if(S.has(h)) { G._saidDup = (G._saidDup || 0) + 1; continue; }
    S.add(h); G.saidHash.push(h); out.push(t); i++;
  }
  G._saidMade = (G._saidMade || 0) + out.length;
  return out;
}
function voxSpice(m, t){
  const k = 1 + ((Math.random() * 3) | 0);
  const fresh = voxFresh(m, k);
  if(!fresh.length) return t;
  const C = memberCulture(m);
  const open = Math.random() < 0.45 ? cap(C.phrase) + " — " : "";
  return (open + t + " " + fresh.join(" ")).slice(0, 560);
}

/* ── every player office: sit at your desk, use your computer ── */
const DESK_OF = {senate:"ksdesk", court:"kbench", exec:"kxdesk", govoffice:"kgdesk"};
function deskSeatFor(room){
  if(room === "office") return {x:0, z:9.05, face:Math.PI};
  const id = DESK_OF[room]; if(!id) return null;
  if(deskSeatFor._in) return null;
  let p = null; deskSeatFor._in = true;
  try{ p = (PROPS[room] || []).find(x => x.id === id); }finally{ deskSeatFor._in = false; }
  if(!p) return null;
  const d = (ROOMS[room] && ROOMS[room].d) || 12;
  return {x:p.x, z:Math.min(d - 0.5, p.z + 0.85), face:Math.PI};
}
function myDeskRoom(){ try{ return G.room === "office" || ((homeRoom() === G.room || kChamberRoom() === G.room) && !!DESK_OF[G.room]); }catch(e){ return false; } }
function atMyDesk(){
  if(!G.you || !G.you.sitting || !myDeskRoom()) return false;
  const s = deskSeatFor(G.room); return !!s && Math.hypot(cam.x - s.x, cam.z - s.z) < 0.85;
}
function sitAtMyDesk(){
  const s = deskSeatFor(G.room); if(!s) return false;
  if(G.room === "office"){ try{ return sitCasuallyAtDesk(); }catch(e){} }
  cam.x = s.x + Math.sin(s.face) * 0.12; cam.z = s.z + Math.cos(s.face) * 0.12; cam.yaw = s.face; cam.vx = cam.vz = 0;
  G.you.sitting = true; if(!G.over) G.running = true;
  feed("You sit at your desk. E wakes the computer; Esc closes it.");
  return true;
}
function deskProp(room){
  const s = deskSeatFor(room); if(!s) return null;
  return {id:"amenDesk", label:"Your desk and computer", sub:"Your chair, your screen, your work", x:s.x, z:s.z - 0.6, r:2.0,
    acts:() => [
      G.you.sitting ? {t:PC.open ? "Close the computer" : "Use the computer", c:"E", run(){ if(PC.open) pcClose(); else pcOpen(); }}
                    : {t:"Sit at your desk", c:"E", run(){ sitAtMyDesk(); }},
      ...(G.you.sitting ? [{t:"Stand up", c:"", run(){ try{ pcClose(); }catch(e){} G.you.sitting = false; feed("You stand."); }}] : [])
    ]};
}

/* ── role duties: the checklist and the desk computer follow the chair you hold ── */
const ROLE_EXTRA = {
  gov:[
    {key:"gappt", t:"Make an appointment", d:"A judge, a commissioner, a board seat.", run(){ spend(30, 4); const y = G.you; y.standing = clamp(y.standing + 1, 0, 100); return "You fill the seat with someone who will answer the phone. Two people who wanted it will remember."; }},
    {key:"gemer", t:"The emergency file", d:"Floods, fires, strikes: what the state needs from you today.", run(){ spend(45, 6); const S = (G.states || []).find(s => s.n === G.you.state); if(S) S.unrest = clamp((S.unrest || 0) - 3, 0, 100); G.you.approval = clamp(G.you.approval + 1, 0, 100); return "You send the guard, the money and your own face. Unrest eases a little."; }},
    {key:"gpard", t:"Pardons", d:"The clemency board's list, and the families waiting on it.", run(){ spend(30, 3); const g = chance(.5); G.you.approval = clamp(G.you.approval + (g ? 1 : -1), 0, 100); return g ? "You sign one pardon, for a man who has served his time twice over. The papers are kind." : "You refuse them all. The board is relieved and one family is not."; }},
    {key:"gleg", t:"The state legislature", d:"Leaders of both houses, about what comes next.", run(){ spend(40, 4); G.you.influence = clamp((G.you.influence || 0) + 2, 0, 100); return "The majority leader wants a road; you want a vote. You both leave with half."; }}
  ],
  senate:[{key:"sstaff", t:"Hold a staff meeting on legislation", d:"What the Senate sends back, line by line.", run(){ spend(30, 3); G.you.influence = clamp((G.you.influence || 0) + 1, 0, 100); return "Your counsel finds the clause that matters."; }}],
  bench:[{key:"bread", t:"Read the briefs", d:"Every word counsel filed, before argument.", run(){ spend(45, 4); G.you.standing = clamp(G.you.standing + 1, 0, 100); return "You read until the light goes. Nobody will catch you unprepared."; }}],
  pres:[{key:"pcab", t:"Meet the cabinet", d:"Departments, one at a time.", run(){ spend(45, 5); G.you.influence = clamp((G.you.influence || 0) + 2, 0, 100); return "Two secretaries agree with you, which is two more than yesterday."; }}]
};
function roleDuties(){
  const k = heldOffice(); if(!k || k === "house") return [];
  return docketToday().map(d => ({key:d.key, t:d.t, d:d.d, h:d.h, dock:d})).concat((ROLE_EXTRA[k] || []).map(x => Object.assign({extra:true}, x)));
}
function roleDutyRun(key){
  const it = roleDuties().find(x => x.key === key); if(!it || kOnceToday(key)) return;
  if(it.dock){ docketRun(it.dock); return; }
  const line = it.run(); kMark(key); try{ setSay(line, ""); feed(it.t + "."); }catch(e){} try{ refreshPanels(); }catch(e){}
}
function roleTitle(){ const k = heldOffice(); return {gov:"Governor", senate:"Senator", bench:"Justice", pres:"the Executive"}[k] || "Member"; }
function roleDutiesHTML(){
  const L = roleDuties();
  return '<div style="margin-bottom:6px"><button class="pc__btn" data-pcdk="1">Open the docket: bills and cases before you</button></div><div class="pc__h">Duties of the ' + roleTitle() + ' · today</div>' + L.map(x => {
    const done = kOnceToday(x.key);
    return '<div class="pc__row"><b>' + pcEsc(x.t) + '</b>' + (x.h ? '<span class="d">' + hourLabel(x.h) + '</span>' : '') +
      '<div class="pc__m">' + pcEsc(x.d || "") + '</div>' +
      '<button class="pc__btn" data-pcduty="' + x.key + '"' + (done ? ' disabled' : '') + '>' + (done ? 'Done today' : 'Do it') + '</button></div>';
  }).join("");
}

/* ── an office that fits its owner: wealth, books or trophies, faith, home, seniority ── */
function stateBannerMatFor(name){
  const nm = String(name || "The State");
  TEX._stban2 = TEX._stban2 || {};
  if(!TEX._stban2[nm]){
    let h = 7; for(const ch of nm) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
    const PAL = [["#1f3b63","#e8d9a8"],["#5a1e22","#efe3c2"],["#24452f","#e6d7a4"],["#3a2c55","#eadfc0"],["#6b4a1c","#f1e6c8"],["#1d4d52","#ecdcae"]];
    const [bg, fg] = PAL[h % PAL.length];
    const c = document.createElement("canvas"); c.width = 160; c.height = 256; const x = c.getContext("2d");
    x.fillStyle = bg; x.fillRect(0, 0, 160, 256); x.strokeStyle = fg; x.lineWidth = 6; x.strokeRect(10, 10, 140, 236);
    x.fillStyle = fg; x.font = "bold 18px Georgia, serif"; x.textAlign = "center";
    nm.toUpperCase().split(" ").slice(0, 3).forEach((w, i) => x.fillText(w, 80, 150 + i * 24));
    x.beginPath(); for(let i = 0; i < 10; i++){ const a = -Math.PI/2 + i * Math.PI/5, r = i % 2 ? 14 : 34; x.lineTo(80 + Math.cos(a)*r, 80 + Math.sin(a)*r); } x.closePath(); x.fill();
    const t = new THREE.CanvasTexture(c); try{ t.encoding = THREE.sRGBEncoding; }catch(e){}
    TEX._stban2[nm] = t;
  }
  const m = new THREE.MeshStandardMaterial({map:TEX._stban2[nm], roughness:.9, side:THREE.DoubleSide}); m._shared = true; return m;
}
function decorOwner(person, id){
  if(!person) return;
  const R = ROOMS[id]; if(!R) return;
  const hw = R.w / 2, d = R.d;
  const C = memberCulture(person.kind === "you" || person === G.you ? Object.assign({}, person, {id:"you:" + person.name}) : person) || {wealth:50, ind:"trade"};
  const r = rng(seedOf("decor:" + (person.id || person.name) + ":" + id));
  const T = person.traits || {};
  const wealth = person === G.you ? Math.max(0, Math.min(100, Math.round((person.funds || 0) / 4000 + (person.terms || 0) * 8 + 20))) : C.wealth;
  const gilt = matCol(0xb08b45, .35, .75), dark = matCol(0x2a1d14, .7);
  /* ornate or spartan */
  if(wealth > 62){
    propRug(0, d * 0.5, Math.min(3.6, R.w - 3), Math.min(3.0, d - 4));
    if(!MODEST) try{ propChandelier(0, R.h - 0.7, d * 0.5, 4, 0.7); }catch(e){}
    addBox(gilt, hw - 0.06, 2.55, d * 0.30, 0.04, 0.05, 1.3, 0, true);   /* gilt picture rail */
  } else if(wealth < 32){
    addBox(matCol(0x8d8577, .9), -hw + 0.03, 1.05, d * 0.30, 0.02, 0.6, 0.9, 0, true);  /* a bare notice board */
  }
  /* books or trophies, on a low sideboard against the right wall */
  const sx = hw - 0.45, sz = d * 0.30;
  addBox(dark, sx, 0.42, sz, 0.5, 0.84, 1.4, 0, true);
  if((T.vanity | 0) > 55 || (T.ambition | 0) > 70){
    for(let i = 0; i < 3; i++){ addCyl(gilt, sx, 0.84 + 0.12, sz - 0.45 + i * 0.45, 0.06, 0.24); addBox(dark, sx, 0.86, sz - 0.45 + i * 0.45, 0.16, 0.04, 0.16, 0, true); }
  } else {
    const cols = [0x5a2a2a, 0x2a3f5a, 0x3a4a2a, 0x6b5a2a, 0x40304a, 0x2a2a2a];
    for(let i = 0; i < 14; i++) addBox(matCol(cols[(r() * cols.length) | 0], .8), sx, 0.84 + 0.13, sz - 0.62 + i * 0.09, 0.24, 0.24 + r() * 0.06, 0.07, 0, true);
  }
  /* faith on the back wall, high: a crucifix for the Christian, the Consular standard for the Rite */
  let consular = false; try{ consular = isConsular(person); }catch(e){}
  const cr = person.creed || "";
  if(consular){
    try{ const fm = oranje7FlagMat(); addBox(fm, hw - 1.3, 2.55, d - 0.04, 0.9, 0.6, 0.02, 0, true); }catch(e){}
    try{ propPlaque(hw - 1.3, 2.12, d - 0.03, Math.PI, "NON SOLIS RADIOS", "the Consular Rite", 0.9, 0.16); }catch(e){}
  } else if(cr === "latin" || cr === "kerk" || cr === "circle" || cr === "rite" || cr === "reformed" || (person === G.you && !cr)){
    addBox(dark, 0, 2.75, d - 0.035, 0.05, 0.62, 0.03, 0, true);
    addBox(dark, 0, 2.88, d - 0.035, 0.34, 0.05, 0.03, 0, true);
    if(cr === "latin") addBox(gilt, 0, 2.70, d - 0.02, 0.07, 0.24, 0.01, 0, true);
  }
  /* home state banner on the left wall */
  try{ addBox(stateBannerMatFor(person.state || (G.you && G.you.state)), -hw + 0.035, 2.05, d * 0.70, 0.02, 0.9, 0.56, 0, true); }catch(e){}
  /* seniority: one framed commission per term, up to four, along the right wall */
  const terms = Math.min(4, person.terms | 0);
  for(let i = 0; i < terms; i++) addBox(i % 2 ? gilt : dark, hw - 0.035, 1.75, d * 0.55 + i * 0.42, 0.02, 0.32, 0.26, 0, true);
}

/* ===== 20261012r · texts (live DMs that can leak) and the map of the Republic ===== */

/* ── DMs ── */
function dmState(){
  if(!G.dm || G.dm.v !== 1) G.dm = {v:1, th:{}, npc:[], leaks:[], unread:0, open:null, seq:0};
  return G.dm;
}
function dmThread(id){ const D = dmState(); return D.th[id] || (D.th[id] = []); }
const DM_SECRET = /\b(secret|between us|don'?t tell|do not tell|off the record|private|confidential|quietly|nobody knows|keep this)\b/i;
const DM_INSULT = /\b(idiot|fool|liar|coward|crook|useless|traitor|stupid|joke|clown|snake|weasel|hate)\b/i;
const DM_PRAISE = /\b(thank|thanks|great|good job|well done|admire|respect|proud|brilliant|appreciate|love)\b/i;
const DM_ASKVOTE = /\b(vote|support|back|cosponsor|pledge|with me|sign on)\b/i;
const DM_MONEY = /\b(money|donor|cash|fund|check|cheque|bribe|pay|dinner)\b/i;
const DM_FAITH = /\b(god|christ|church|mass|pray|faith|rite|consul)\b/i;
function dmAbout(text){
  const t = String(text || ""), low = t.toLowerCase();
  const about = (G.members || []).filter(m => m && !m.gone && (low.indexOf(surname(m.name).toLowerCase()) >= 0)).slice(0, 2);
  return {q:/\?\s*$/.test(t.trim()) || /^(what|why|how|when|who|where|will|would|can|could|do|did|are|is)\b/i.test(t.trim()),
    secret:DM_SECRET.test(t), insult:DM_INSULT.test(t), praise:DM_PRAISE.test(t), ask:DM_ASKVOTE.test(t), money:DM_MONEY.test(t), faith:DM_FAITH.test(t), about};
}
function dmStakes(A, text){
  let s = 0.08;
  if(A.secret) s += 0.30; if(A.insult) s += 0.22; if(A.money) s += 0.18; if(A.about.length) s += 0.16 * A.about.length;
  if(A.ask && G.bill && !G.bill.done) s += 0.06;
  if(String(text).length > 120) s += 0.05;
  return Math.min(1, s);
}
function dmClean(s, m){
  s = String(s || "").trim(); if(!s) return "";
  try{ if(typeof DTCNO !== "undefined"){ const g = DTCNO.guard(s); if(!g) return ""; s = g; } }catch(e){}
  return canonOk(s, m) ? s : "";
}
/* comprehension: the reply answers what you said, in their own voice, then (sometimes) one thing they have never said */
function dmReply(m, text){
  const A = dmAbout(text), T = m.traits || {}, w = (m.rel ? m.rel.warmth : 0);
  const parts = [];
  if(A.insult && A.about.length){ const x = A.about[0]; const tw = tieOf(m, x).w;
    parts.push(tw > 20 ? pick(["Careful. " + surname(x.name) + " is a friend of mine.", "I will pretend I did not read that about " + surname(x.name) + "."]) : pick(["Ha. You are not wrong about " + surname(x.name) + ".", "Say that louder and " + surname(x.name) + " might finally hear it."])); }
  else if(A.insult){ if(m.rel) m.rel.warmth = clamp(w - 6, -100, 100); parts.push(pick(["Excuse me?", "I will keep this text. You should know that.", "That is a strange way to ask a favour."])); }
  if(A.praise){ if(m.rel) m.rel.warmth = clamp((m.rel.warmth || 0) + 2, -100, 100); parts.push(pick(["That is kind. I will remember it.", "Thank you. Not many say it in this building.", "Appreciated. Truly."])); }
  if(A.ask){ const yes = w + (T.loyalty | 0) / 4 - 15 + (m.party === G.you.party ? 12 : -8) > 0;
    parts.push(dmClean(DTCNO.say(m, {intent: yes ? "agree" : "refuse", sent: yes ? 1 : -1, topic:"bills"}), m) || (yes ? "Put me down as a probable." : "Not this time.")); }
  if(A.money) parts.push(pick(["Not over text.", "Call my office about that, not this phone.", "I do not talk money in writing. Nobody sensible does."]));
  if(A.secret) parts.push((T.discretion | 0) > 60 ? "Understood. It stays with me." : pick(["Of course. Between us.", "My lips are sealed.", "Sure, sure."]));
  if(A.faith){ const c = memberCulture(m); parts.push(m.creed === "latin" || m.creed === "kerk" ? "God is the Most High; I hold to that. At home we keep " + c.custom + "." : "Faith is a home matter for me. " + cap(c.sacred) + " is what we keep sacred."); }
  if(A.q && !parts.length) parts.push(dmClean(DTCNO.say(m, {intent:"react", sent: w > 15 ? 1 : w < -15 ? -1 : 0}), m) || "Good question. Let me think on it.");
  if(!parts.length) parts.push(dmClean(DTCNO.say(m, {intent: chance(.5) ? "react" : "small", sent: w > 15 ? 1 : w < -15 ? -1 : 0}), m) || "Mm. Noted.");
  if(chance(.45)){ const f = voxFresh(m, 1); if(f.length) parts.push(f[0]); }
  return parts.filter(Boolean).join(" ").slice(0, 420);
}
function dmPush(id, from, t, extra){
  const D = dmState(); const L = dmThread(id);
  const msg = Object.assign({i:++D.seq, f:from, t, d:G.day, at:hhmm()}, extra || {});
  L.push(msg); if(L.length > 60) L.splice(0, L.length - 60);
  if(from !== "you" && D.open !== id){ D.unread++; msg.unread = true; }
  dmBadge(); if(D.open === id) dmRender();
  return msg;
}
function dmSend(id, text){
  const m = byId(id); text = String(text || "").trim().slice(0, 400); if(!m || !text) return;
  const A = dmAbout(text);
  dmPush(id, "you", text, {stakes:dmStakes(A, text), about:A.about.map(x => x.id)});
  const delay = 700 + Math.random() * 1600;
  dmState().typing = id; dmRender();
  setTimeout(() => { const D = dmState(); D.typing = null; dmPush(id, id, dmReply(m, text)); }, delay);
}
/* members text you, and each other, on their own */
function dmInitiative(){
  const L = (G.members || []).filter(m => m && !m.gone && m.kind === "member");
  if(!L.length || !G.you) return;
  /* 20261027d: who writes to you is whoever has a reason to: a stake in the bill on the floor, or strong feeling about you */
  const wm = typeof wlTexter === "function" ? wlTexter(L) : null;
  if(wm){
    const m = wm.m, w = m.rel ? m.rel.warmth : 0;
    const t = dmClean(DTCNO.say(m, {intent: wm.intent, sent: w > 15 ? 1 : w < -15 ? -1 : 0}), m);
    if(t){ const f = voxFresh(m, chance(.4) ? 1 : 0); dmPush(m.id, m.id, (t + (f.length ? " " + f[0] : "")).slice(0, 400)); }
  }
  const D = dmState();
  const PR = typeof wlPairs === "function" ? wlPairs(L) : [];
  for(let i = 0; i < PR.length; i++){
    const a = PR[i][0], b = PR[i][1]; if(a === b) continue;
    const tw = tieOf(a, b).w, X = L.filter(x => x !== a && x !== b).sort((u, v) => Math.abs(wlRegard(a, v)) - Math.abs(wlRegard(a, u)))[0];   /* they talk about whoever is on their mind */
    const t = dmClean(DTCNO.say(a, {intent: tw > 20 ? "agree" : tw < -20 ? "warn" : "gossip", sent: tw > 20 ? 1 : tw < -20 ? -1 : 0}), a);
    if(!t) continue;
    const spicy = X && tw > 0 ? wlGossip(a, X) : "";   /* 20261027d: only what the speaker knows about them */
    D.npc.push({i:++D.seq, a:a.id, b:b.id, t:(t + spicy).slice(0, 400), d:G.day, stakes:0.1 + (spicy ? 0.45 : 0), about:spicy ? [X.id] : []});
  }
  if(D.npc.length > 240) D.npc.splice(0, D.npc.length - 240);
}
/* leaks: never scripted; whether the reader forwards depends on who they are, what they owe, and what it is worth */
function dmLeakOdds(holder, senderId, stakes){
  const T = holder.traits || {};
  const w = senderId === "you" ? (holder.rel ? holder.rel.warmth : 0) : (tieOf(holder, byId(senderId) || holder).w || 0);
  let p = stakes * 0.35;
  p += (60 - (T.discretion | 0)) / 300;
  p += (T.ambition | 0) / 600 + (T.temper | 0) / 800;
  p += w < 0 ? -w / 250 : -w / 400;
  p -= (T.loyalty | 0) / 700;
  if(holder.rival === senderId) p += 0.12;
  if(holder.pressFriend || ((seedOf("rep:" + holder.id) % 7) === 0)) p += 0.08;  /* a reporter friend */
  return Math.max(0, Math.min(0.7, p));
}
function dmLeakDay(){
  const D = dmState();
  const cand = [];
  Object.keys(D.th).forEach(id => D.th[id].forEach(x => { if(x.f === "you" && !x.leaked && !x.leakTried && G.day - x.d <= 3) cand.push({holder:byId(+id) || byId(id), from:"you", x}); }));
  D.npc.forEach(x => { if(!x.leaked && !x.leakTried && G.day - x.d <= 3) cand.push({holder:byId(x.b), from:x.a, x}); });
  cand.forEach(c => {
    if(!c.holder) return;
    if(G.day - c.x.d >= 3) c.x.leakTried = true;
    if(Math.random() > dmLeakOdds(c.holder, c.from, c.x.stakes || 0.1) * 0.5) return;
    dmLeak(c.holder, c.from, c.x);
  });
}
function dmLeak(holder, from, x){
  const D = dmState(); x.leaked = true;
  const sender = from === "you" ? G.you : byId(from);
  const sName = from === "you" ? (G.you.name || "the Member") : sender.name;
  const quote = "\u201c" + String(x.t).slice(0, 140) + (x.t.length > 140 ? "\u2026" : "") + "\u201d";
  const T = holder.traits || {};
  const how = (holder.pressFriend || (seedOf("rep:" + holder.id) % 7) === 0) ? "press" : (T.vanity | 0) > 60 ? "vox" : chance(.5) ? "wire" : "rumour";
  let line = "";
  if(how === "vox"){
    line = "Screenshot, no comment: " + sName + " to me, privately: " + quote;
    try{ voxAdd({id:G.vox.id++, by:holder.id, t:line, k:"leak", v:0, day:G.day, at:hhmm(), backs:0, hits:0, voices:[], mine:false}); }catch(e){}
  } else if(how === "press"){
    line = "LEDGER: a private message from " + sName + " reaches the press: " + quote;
    try{ pushWireScrap("PRESS", line); }catch(e){}
  } else if(how === "wire"){
    line = "WIRE: " + sName + "'s text to " + holder.name + " is circulating: " + quote;
    try{ pushWireScrap("LEAK", line); }catch(e){}
  } else {
    line = "Cloakroom rumour: " + sName + " said something in a text to " + surname(holder.name) + " that is going around.";
  }
  try{ feed(line); }catch(e){}
  const sev = (x.stakes || 0.1);
  /* consequences: the sender's trust in the leaker, the subject's view of the sender, the sender's scandal */
  if(from === "you"){
    if(holder.rel){ holder.rel.trust = clamp((holder.rel.trust || 30) - 4, 0, 100); }
    G.you.scandal = Math.round(((G.you.scandal || 0) + sev * 10) * 10) / 10;
    G.you.approval = clamp(G.you.approval - sev * 2, 0, 100);
    (x.about || []).forEach(id => { const s = byId(id); if(s && s.rel) s.rel.warmth = clamp(s.rel.warmth - Math.round(6 + sev * 14), -100, 100); });
    dmPush(holder.id, holder.id, pick(["I may have shown that to someone. It got away from me.", "Sorry. It was too good not to share.", "You should not write things down."]), {sys:true});
    try{ note("Your text to " + holder.name + " leaked (" + how + ").", false); }catch(e){}
  } else if(sender){
    tieShift(sender, holder, -Math.round(8 + sev * 20), "leaked a private text");
    sender.scandal = Math.round(((sender.scandal || 0) + sev * 8) * 10) / 10;
    (x.about || []).forEach(id => { const s = byId(id); if(s) tieShift(s, sender, -Math.round(6 + sev * 16), "what was said in a text"); });
  }
  D.leaks.push({d:G.day, from:sName, holder:holder.name, how, t:line});
  if(D.leaks.length > 80) D.leaks.shift();
  try{ loreAdd(sender && sender.state, "Day " + G.day + ": a private text from " + sName + " leaked (" + how + ")."); }catch(e){}
}

/* texts live inside the (Neptune) sectioned inbox as its first section; a small corner badge points at them */
function dmCSS(){
  if(document.getElementById("dmCss")) return;
  const st = document.createElement("style"); st.id = "dmCss";
  st.textContent = '#dmBadge{position:fixed;right:12px;bottom:84px;z-index:60;background:#1b2433;color:#e9e2cf;border:1px solid #6d5a2e;border-radius:14px;padding:3px 9px;font:600 11px Georgia,serif;cursor:pointer;opacity:.8}#dmBadge.has{background:#6d2230;opacity:1}' +
    '.dmw{border:1px solid var(--line-soft,#ccc);border-radius:6px;margin:0 0 10px;display:flex;flex-direction:column}.dmw .h{padding:5px 6px;display:flex;gap:6px;align-items:center}.dmw select{flex:1}.dmw .l{overflow:auto;padding:6px;max-height:260px;min-height:90px}' +
    '.dmw .m{margin:4px 0;padding:5px 8px;border-radius:10px;max-width:84%;line-height:1.3;font:13px Georgia,serif}.dmw .me{background:#2e4a6b;color:#fff;margin-left:auto}.dmw .them{background:#e9e1cc;color:#222}.dmw .sys{font-style:italic;background:#f3d6d6}.dmw .t{font-size:10px;opacity:.6}' +
    '.dmw form{display:flex;border-top:1px solid var(--line-soft,#ccc)}.dmw input{flex:1;padding:6px;border:0}.dmw button{padding:0 10px}';
  document.head.appendChild(st);
}
function dmUI(){
  dmCSS();
  if(!document.getElementById("dmBadge")){ const b = document.createElement("div"); b.id = "dmBadge"; b.onclick = () => dmToggle(true); document.body.appendChild(b); }
  dmBadge();
}
function dmBadge(){ const b = document.getElementById("dmBadge"); if(!b) return; const n = dmState().unread; b.textContent = n ? "\u2709 " + n + " text" + (n > 1 ? "s" : "") + " (N)" : "Texts (N)"; b.classList.toggle("has", !!n); b.style.display = G.you ? "" : "none"; }
function dmMount(P){
  if(!P || !G.you) return;
  dmCSS();
  let w = P.querySelector(".dmw");
  if(!w){
    w = document.createElement("div"); w.className = "dmw";
    w.innerHTML = '<div class="h"><b class="eyebrow" style="margin:0">Texts</b><select class="dmWho"></select></div><div class="l dmList"></div><form class="dmForm"><input class="dmIn" autocomplete="off" maxlength="400" placeholder="Text them\u2026"><button>Send</button></form>';
    P.insertBefore(w, P.firstChild);
    const inp = w.querySelector(".dmIn");
    ["keydown","keyup","keypress"].forEach(ev => inp.addEventListener(ev, e => { e.stopPropagation(); }));
    w.querySelector(".dmWho").onchange = e => { dmState().open = isNaN(+e.target.value) ? e.target.value : +e.target.value; dmRender(); };
    w.querySelector(".dmForm").onsubmit = e => { e.preventDefault(); const D = dmState(); if(D.open != null){ dmSend(D.open, inp.value); inp.value = ""; } };
  }
  dmRender();
}
function dmToggle(on, id){
  const D = dmState();
  if(id != null) D.open = id;
  if(D.open == null){ const ids = Object.keys(D.th).sort((a, b) => (D.th[b].slice(-1)[0] || {i:0}).i - (D.th[a].slice(-1)[0] || {i:0}).i); D.open = ids.length ? +ids[0] : (G.members.find(m => !m.gone) || {}).id; }
  try{ if(PC.open){ PC.tab = "inbox"; pcRender(); } else openPanels("inbox"); }catch(e){}
  setTimeout(() => { try{ refreshInbox(); }catch(e){} const i = document.querySelector(".dmw .dmIn"); if(i) i.focus(); }, 60);
}
function dmRender(){
  const D = dmState();
  const mem = (G.members || []).filter(m => m && !m.gone).slice().sort((a, b) => ((D.th[b.id] || []).length - (D.th[a.id] || []).length) || a.name.localeCompare(b.name));
  if(D.open == null && mem[0]) D.open = mem[0].id;
  const L = D.th[D.open] || [];
  L.forEach(x => { if(x.unread){ x.unread = false; D.unread = Math.max(0, D.unread - 1); } });
  document.querySelectorAll(".dmw").forEach(w => {
    const sel = w.querySelector(".dmWho"), list = w.querySelector(".dmList");
    sel.innerHTML = mem.map(m => { const T = D.th[m.id] || []; const u = T.filter(x => x.unread).length; return '<option value="' + m.id + '"' + (m.id == D.open ? ' selected' : '') + '>' + pcEsc(m.name) + ' (' + m.party + '-' + pcEsc(m.state) + ')' + (T.length ? ' \u00b7 ' + T.length : '') + (u ? ' \u2022' + u : '') + '</option>'; }).join("");
    list.innerHTML = L.map(x => '<div class="m ' + (x.f === "you" ? "me" : "them") + (x.sys ? " sys" : "") + '">' + pcEsc(x.t) + '<div class="t">d' + x.d + ' ' + pcEsc(x.at || "") + (x.leaked ? ' \u00b7 leaked' : '') + '</div></div>').join("") + (D.typing == D.open ? '<div class="m them"><i>typing\u2026</i></div>' : '') || '<p class="muted">No texts yet. Pick anyone and write.</p>';
    list.scrollTop = 1e6;
  });
  dmBadge();
}
/* ── the map: a deterministic SVG of the Republic, its capital, its neighbours and its chapels ── */
function loreState(){ if(!G.lore) G.lore = {}; return G.lore; }
function loreAdd(place, t){
  if(!place) return; const L = loreState(); const a = L[place] || (L[place] = []);
  if(a.some(x => x.t === t)) return; a.push({d:G.day || 1, t}); if(a.length > 40) a.shift();
}
function loreScan(text){
  try{
    const s = String(text || ""); if(!s || !G.states) return;
    G.states.forEach(st => { if(s.indexOf(st.n) >= 0) loreAdd(st.n, "Day " + (G.day || 1) + ": " + s.slice(0, 220)); });
    WORLD_POWERS.forEach(p => { if(s.indexOf(p.t.replace(/^the /, "")) >= 0) loreAdd(p.t, "Day " + (G.day || 1) + ": " + s.slice(0, 220)); });
  }catch(e){}
}
const MAP = {open:false, mode:"lean", sel:null};
function mapColor(st){
  if(MAP.mode === "tension"){ const u = Math.max(0, Math.min(100, st.unrest || 0)); return "hsl(" + (120 - u * 1.2) + ",45%," + (52 - u * 0.15) + "%)"; }
  if(MAP.mode === "faith"){ const ch = (G.rite && G.rite.chapels && G.rite.chapels[st.n]) || 0; if(ch >= 2) return "#c46a1a"; if(ch) return "#d89b55"; return {latin:"#7c5aa6", kerk:"#4f6fa8", circle:"#5b8f6a", flame:"#b5473a", none:"#888", self:"#a79b4f"}[st.creed] || "#777"; }
  const ms = (G.members || []).filter(m => !m.gone && m.state === st.n);
  const by = {}; ms.forEach(m => by[m.party] = (by[m.party] || 0) + 1);
  const top = Object.keys(by).sort((a, b) => by[b] - by[a])[0];
  try{ if(top) return partyColorHex(top); }catch(e){}
  return st.lean > 0 ? "#8a4b4b" : "#4b5f8a";
}
function no7FlagURL(){
  try{ const t = oranje7FlagTex(); const im = t && t.image; if(im && im.toDataURL) return im.toDataURL(); }catch(e){}
  return "";
}
function mapSVG(){
  const S = G.states || [], C = 58, ox = 150, oy = 70;
  const maxC = Math.max(...S.map(s => s.col)), maxR = Math.max(...S.map(s => s.row));
  const W = ox * 2 + (maxC + 1) * C, H = oy * 2 + (maxR + 1) * C + 40;
  let g = '<svg id="mapSvg" viewBox="0 0 ' + W + ' ' + H + '" width="100%" style="max-height:72vh;background:#16314a;font-family:Georgia,serif">';
  g += '<rect x="' + (ox - 16) + '" y="' + (oy - 16) + '" width="' + ((maxC + 1) * C + 32) + '" height="' + ((maxR + 1) * C + 32) + '" rx="26" fill="#cbbf98" stroke="#6d5a2e" stroke-width="3"/>';
  /* neighbours on the compass */
  const POS = {reach:[W - 60, H / 2], horn:[W / 2, H - 22], pale:[W / 2, 26], marches:[60, H / 2], isles:[W - 70, H - 30], rift:[70, 40]};
  WORLD_POWERS.forEach(p => { const q = POS[p.k] || [W - 60, 40]; const foe = G.world && G.world.foe === p.k;
    g += '<g class="mp" data-place="' + p.t + '" style="cursor:pointer"><rect x="' + (q[0] - 58) + '" y="' + (q[1] - 14) + '" width="116" height="24" rx="5" fill="' + (foe ? "#7a2a2a" : "#3d4b5a") + '" stroke="#d8c78f"/><text x="' + q[0] + '" y="' + (q[1] + 3) + '" fill="#f3ead2" font-size="11" text-anchor="middle">' + pcEsc(p.t) + (foe ? " ⚔" : "") + '</text></g>'; });
  S.forEach(st => {
    const x = ox + st.col * C, y = oy + st.row * C, mine = G.you && G.you.state === st.n, sel = MAP.sel === st.n;
    const cap = STATE_DEF.find(d => d.n === st.n) || {};
    g += '<g class="mp" data-place="' + pcEsc(st.n) + '" style="cursor:pointer"><rect x="' + (x + 2) + '" y="' + (y + 2) + '" width="' + (C - 4) + '" height="' + (C - 4) + '" rx="6" fill="' + mapColor(st) + '" stroke="' + (sel ? "#fff" : mine ? "#ffd36b" : "#2a2418") + '" stroke-width="' + (sel || mine ? 3 : 1) + '"/>' +
      '<circle cx="' + (x + 12) + '" cy="' + (y + 13) + '" r="3.2" fill="#111"/>' +
      '<text x="' + (x + C / 2) + '" y="' + (y + C / 2 + 3) + '" fill="#fff" font-size="8.6" text-anchor="middle" style="paint-order:stroke;stroke:#000;stroke-width:2px">' + pcEsc(st.n.length > 13 ? st.n.slice(0, 12) + "." : st.n) + '</text>';
    const ch = (G.rite && G.rite.chapels && G.rite.chapels[st.n]) || 0;
    if(ch) g += '<text x="' + (x + C - 10) + '" y="' + (y + 14) + '" fill="#ffb347" font-size="11" text-anchor="middle">✠' + (ch > 1 ? ch : "") + '</text>';
    if(cap.n === "Nieuw Oranje" || st.capital) g += '<text x="' + (x + C / 2) + '" y="' + (y + C - 8) + '" fill="#ffe9a8" font-size="8" text-anchor="middle">★ Capitol</text>';
    g += '</g>';
  });
  const nm = (G.country && G.country.name) || "Nieuw Oranje 7";
  g += '<text x="' + (W / 2) + '" y="' + (H - 46) + '" fill="#f3ead2" font-size="15" text-anchor="middle">' + pcEsc(nm) + '</text></svg>';
  return g;
}
/* ── the neighbouring republics: how each is run, who stands behind it, and what you can do about it ── */
const REALM_GOV = {
  reach:{form:"Synodal republic", d:"A republic of farm towns. The Synod of Elders sits for life and chooses a Stadtholder for nine years; the assemblies of the towns may refuse money but not war.",
    head:"Stadtholder", seat:"the Synod House at Verhoeven's Ford", style:"Slow, devout and exact. A promise made to the Synod is kept for a generation; one made to an ambassador is a courtesy.",
    powers:[["the grain guilds","price the bread, and can close the ports to export in a week"],["the kerk synod","names the Elders; nothing passes without its blessing"],["the frontier garrison command","answers to the Stadtholder on paper and to the weather in practice"]], lean:"closes to anyone who looks like a rival, opens to anyone who buys grain"},
  horn:{form:"League of port cities", d:"Eleven harbours under a Council of Consuls. Each consul is elected by his own harbour's guilds; the Consul-General speaks for the League but cannot bind a harbour that disagrees.",
    head:"Consul-General", seat:"the Council Hall on the quay", style:"Quick, commercial, personal. A deal is made over a table and unmade over the next one.",
    powers:[["the oil houses","own the strait's wells and pay for half the Council's campaigns"],["the fleet admirals","hold the harbour chains; no ship leaves without them"],["the flame priesthood","bless the oil and name the days no ship sails"]], lean:"buys what it needs and sells what it can; hates being asked to choose a side"},
  pale:{form:"Marshal's directorate", d:"A northern state ruled by a Directorate of marshals and the heads of the iron cartels. A Marshal-Regent chairs it. There is a congress of the provinces; it meets when the Directorate is in a good mood.",
    head:"Marshal-Regent", seat:"the Winter Palace of the Directorate", style:"Cold, formal, long memory. Insults are filed. Favours are filed too.",
    powers:[["the iron cartels","fund the army and the Directorate in the same ledger"],["the army staff","decide what the Regent hears"],["the Latin bishops","give the Directorate its legitimacy, and withdraw it by letter"]], lean:"respects strength, fears famine, will bargain for iron and grain but never be seen to"},
  marches:{form:"Confederation of cantons", d:"A loose union of free cantons. A rotating Landammann presides for a year; every canton keeps its own militia, its own customs and its own opinion.",
    head:"Landammann", seat:"the Diet at the Free Bridge", style:"Cautious, legalistic, allergic to occupation. Everything is referred to the cantons.",
    powers:[["the toll houses","own the roads and charge every army that uses them"],["the canton assemblies","can overrule the Landammann by showing up"],["the mercenary contract houses","sell neutrality at a price"]], lean:"wants to be left alone, and will sign anything that keeps it that way in writing"},
  isles:{form:"Island moot", d:"The Isles are governed by a Moot of clan heads, with a Lord Speaker chosen at midsummer. Law is whatever the Moot remembers and the fleet can enforce.",
    head:"High Commissioner", seat:"the Moot Stone above the harbour", style:"Warm, proud and stubborn. They will drink with you and still refuse you.",
    powers:[["the fishing clans","hold the grounds and the votes at the Moot"],["the shipping insurers","decide which hulls are worth sailing"],["the chapel circle","settle disputes the Moot cannot"]], lean:"wants recognition more than money, and will trade money for it"},
  rift:{form:"River commune", d:"A string of river towns under a Council of Reeves. Whoever keeps the river keeps the vote: the ferry-wardens and the dam-keepers decide most things before the Council meets.",
    head:"Chargé d'affaires", seat:"the Reeves' table at the weir", style:"Plain, suspicious, practical. They believe in what they can see from the bank.",
    powers:[["the ferry-wardens","control every crossing and every rumour"],["the dam-keepers","can drown a harvest or save one"],["the self-reliant congregations","trust no creed they did not write"]], lean:"tests every offer for the catch in it; respects those who say what they want plainly"}
};
function realmFolk(k){
  const r = rng(seedOf("rfolk:" + k + ":" + (G.country || "")));
  const G0 = REALM_GOV[k] || {head:"Envoy"}, out = [];
  let env = null; try{ env = window.onumForeignEnvoy && window.onumForeignEnvoy(k); }catch(e){}
  if(env) out.push({id:"envoy", name:env.name, title:env.title});
  out.push({id:"head", name:foreignName(r, k), title:G0.head});
  out.push({id:"fin", name:foreignName(r, k), title:"Minister of the treasury"});
  out.push({id:"war", name:foreignName(r, k), title:"Chief of the army staff"});
  const rl = (G.realms || []).find(x => x.k === k);
  if(rl && rl.chamber) rl.chamber.forEach((g, i) => out.push({id:"as" + i, name:g.name, title:"Member of the assembly"}));
  return out;
}
function realmRelLabel(v){ return v >= 60 ? "close" : v >= 25 ? "warm" : v > -25 ? "correct" : v > -60 ? "cold" : "hostile"; }
function realmGovHTML(p){
  try{
    const g = REALM_GOV[p.k]; if(!g) return "";
    const folk = realmFolk(p.k), head = folk.find(f => f.id === "head"), rel = (G.realmRel || {})[p.k] || 0, D = DLG[p.k] || {};
    const by = id => folk.find(f => f.id === id);
    const powers = g.powers.map((x, i) => '<li><strong>' + pcEsc(cap(x[0])) + '</strong> — ' + pcEsc(x[1]) + '.</li>').join("");
    const act = (a, t, d, off) => '<button type="button" class="cl-btn" data-rl="' + p.k + ':' + a + '"' + (off ? ' disabled' : '') + ' title="' + pcEsc(d) + '">' + pcEsc(t) + '</button>';
    const infl = (G.you && G.you.influence) || 0;
    return '<div style="border-top:1px solid var(--line-soft);margin-top:10px;padding-top:10px"><div class="eyebrow">How ' + pcEsc(p.t) + ' is run</div>' +
      '<p><strong>' + pcEsc(g.form) + '.</strong> ' + pcEsc(g.d) + '</p>' +
      '<p><strong>Head of government.</strong> ' + pcEsc(g.head) + ' ' + pcEsc(head ? head.name : "unnamed") + ', sitting at ' + pcEsc(g.seat) + '.</p>' +
      '<p><strong>Temper.</strong> ' + pcEsc(g.style) + '</p>' +
      '<p><strong>The powers behind it.</strong></p><ul>' + powers + '</ul>' +
      '<p><strong>People you can ring.</strong> ' + folk.map(f => pcEsc(f.name) + ' (' + pcEsc(f.title) + ')').join(", ") + '. They are in the phone under Abroad.</p>' +
      '<p><strong>Towards you.</strong> ' + realmRelLabel(rel) + ' (' + Math.round(rel) + '). They want ' + pcEsc(D.ask || p.want) + ', and would give ' + pcEsc(D.give || "goodwill") + '. They will not accept ' + pcEsc(D.red || "being asked too much") + '. In general it ' + pcEsc(g.lean) + '.</p>' +
      '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px">' +
        act("call", "Ring the envoy", "Open the phone to their head of mission") +
        act("aid", "Send aid", "6 influence. They remember it.", infl < 6) +
        act("trade", "Open trade talks", "20 from the war chest. A little industry, a little warmth.", !(G.you && (G.you.funds || 0) >= 20)) +
        act("press", "Press them on " + (D.ask ? "a point" : "a demand"), "4 influence. A warm neighbour may give way; a cold one will not.", infl < 4) +
        act("aud", "Summon a delegation", "An audience at your desk, with all three of them in the room.") +
        (G.you && warRoleCan() ? act("war", "Take it further", "What your office may do about it, what it must ask others for, and who answers.") : "") +
      '</div></div>';
  }catch(e){ return ""; }
}
function realmDo(k, a){
  const y = G.you, p = WORLD_POWERS.find(x => x.k === k); if(!y || !p) return;
  G.realmRel = G.realmRel || {}; const was = G.realmRel[k] || 0, d = DLG[k] || {};
  const bump = n => { G.realmRel[k] = clamp(was + n, -100, 100); };
  if(a === "aid" || a === "trade" || a === "press") reactEmit("foreign", {k, verb:a});
  if(a === "war"){ try{ mapToggle(false); }catch(x){} setTimeout(() => { try{ warRoleOpen(k); }catch(e){ console.warn(e); } }, 60); return; }
  if(a === "call"){ const e = realmFolk(k)[0]; PB.call = {id:"rl:" + k + ":" + e.id, name:e.name, lines:[{w:e.name, t:"This is " + e.name + ", " + e.title + " of " + p.t + ". I will be brief; what do you wish to raise?"}]}; PB.tab = "calls"; try{ mapToggle(false); }catch(x){} try{ pbOpen(); }catch(x){} return; }
  if(a === "aud"){ if(G.room !== homeRoom()){ note("Go to your own chair first: " + (ROOMS[homeRoom()] ? ROOMS[homeRoom()].t : "your office") + ". A delegation is received there.", true); return; } try{ mapToggle(false); }catch(x){} G._dlgRealm = k; setTimeout(() => { try{ sitStart("delegation"); }catch(e){ console.warn(e); } }, 60); return; }
  if(a === "aid"){ if(y.influence < 6) return; y.influence -= 6; spend(30, 3); bump(9); if(G.world && G.world.foe === k) G.world.heat = clamp((G.world.heat || 0) - 4, 0, 100); feed("You send aid to " + p.t + ". " + (REALM_GOV[k] ? cap(REALM_GOV[k].powers[0][0]) + " take note." : ""), "good"); note("Aid goes to " + p.t + ". Relations: " + was + " to " + G.realmRel[k] + ".", true); return; }
  if(a === "trade"){ if((y.funds || 0) < 20) return; y.funds -= 20; spend(45, 3); bump(5); const st = (G.states || []).find(x => x.n === y.state); if(st) st.ind = clamp(st.ind + 1, 0, 100); note("Trade talks with " + p.t + ": a modest schedule, " + (d.give || "goodwill") + ". Relations: " + was + " to " + G.realmRel[k] + ".", true); return; }
  if(a === "press"){ if(y.influence < 4) return; y.influence -= 4; spend(30, 3); const ok = chance(0.35 + was / 200);
    bump(ok ? 3 : -5); if(ok){ const st = (G.states || []).find(x => x.n === y.state); if(st) st.ind = clamp(st.ind + 1, 0, 100); y.standing = clamp(y.standing + 1, 0, 100); }
    note(ok ? p.t + " gives way on a point. They will want something back." : p.t + " refuses and says so in public. Relations: " + was + " to " + G.realmRel[k] + ".", true); return; }
}
function realmVoice(k, c, txt){
  const g = REALM_GOV[k] || {}, D = DLG[k] || {}, p = WORLD_POWERS.find(x => x.k === k) || {}, t = String(txt || "").toLowerCase(), rel = (G.realmRel || {})[k] || 0;
  G.realmRel = G.realmRel || {}; const sh = n => { G.realmRel[k] = clamp((G.realmRel[k] || 0) + n, -100, 100); };
  const has = re => re.test(t);
  if(has(/\b(war|attack|invade|troops|sanction|threat|ultimatum|destroy)\b/)){ sh(-4); return one3(["I will note that you said that, and so will my government.", "Is that a threat, or a poor choice of words? Choose carefully."]); }
  if(has(/\b(thank|friend|ally|partner|peace|respect|appreciate)\b/)){ sh(2); return one3(["That is generous, and I will say so at home.", "Friendship is cheap to say and dear to keep. We would like to keep it."]); }
  if(has(/\b(who runs|who decides|how (is|are) .* (run|governed)|government|power|council|assembly|synod|moot)\b/)) return g.d + " " + (g.powers ? "In practice, " + g.powers[0][0] + " and " + g.powers[1][0] + " decide more than the books say." : "");
  if(has(/\b(want|need|ask|what do you|request)\b/)) return "We want " + (D.ask || p.want) + ". In return " + p.t + " can offer " + (D.give || "goodwill") + ".";
  if(has(/\b(offer|give|aid|trade|grain|oil|iron|credit|deal)\b/)){ sh(3); return "That is a serious thing to say on a telephone. Put it in writing and I will carry it to " + (g.seat || "the capital") + ". We will not accept " + (D.red || "an insult") + ", but nearly everything else can be spoken of.";
  }
  if(has(/\b(red line|will not|refuse|never|condition)\b/)) return "The one thing my government cannot accept is " + (D.red || "being asked too much") + ". Everything else is a conversation.";
  return rel > 25 ? "Of course, Governor. We are glad you rang. Is there something particular?" : rel < -25 ? "I am listening. I cannot promise to enjoy it." : "I hear you. My government prefers it in writing, but I will tell them you rang.";
}
function mapLore(place){
  const st = (G.states || []).find(s => s.n === place);
  const L = (loreState()[place] || []).slice(-8).reverse();
  if(st){
    const def = STATE_DEF.find(d => d.n === place) || {}, B = CULT_BANK[st.cult || def.cult] || CULT_BANK.midlands;
    const reps = (G.members || []).filter(m => !m.gone && m.state === place);
    const ch = (G.rite && G.rite.chapels && G.rite.chapels[place]) || 0;
    const r = rng(seedOf("lore:" + place));
    return '<h2 style="margin:0 0 4px">' + pcEsc(place) + (G.you && G.you.state === place ? (heldOffice() === "gov" ? ' · home · you govern it' : ' · home') : '') + '</h2>' +
      '<p><i>' + pcEsc(def.note || "") + '</i></p>' + stateGovHTML(place) +
      '<p><b>History.</b> Remembered for ' + pcEsc(drawn(B.hist, r)) + ' and ' + pcEsc(drawn(B.hist, r)) + '.</p>' +
      '<p><b>Culture.</b> ' + pcEsc(cap(drawn(B.custom, r))) + '; ' + pcEsc(drawn(B.food, r)) + '; people say "' + pcEsc(drawn(B.phrase, r)) + '". Sacred: ' + pcEsc(drawn(B.sacred, r)) + '.</p>' +
      '<p><b>Faith.</b> Mostly ' + pcEsc(st.creed || def.creed || "mixed") + '.' + (ch ? ' Consular Rite chapels: ' + ch + '.' : ' No Consular chapel yet.') + ' God is the Most High; Christ is King.</p>' +
      '<p><b>Economy.</b> ' + pcEsc(B.ind.join(", ")) + '; industry index ' + Math.round(st.ind || def.ind || 0) + ', population ' + (st.pop || def.pop || "?") + 'm.</p>' +
      '<p><b>Represented by.</b> ' + (reps.length ? reps.slice(0, 8).map(m => pcEsc(m.name) + ' (' + m.party + ')').join(", ") + (reps.length > 8 ? ", and " + (reps.length - 8) + " more" : "") : "no sitting members") + '.</p>' +
      '<p><b>Intentions.</b> ' + pcEsc((function(){ try{ return scIntent(place) || ""; }catch(e){ return ""; } })()) + '</p>' +
      '<p><b>Tension.</b> Unrest ' + Math.round(st.unrest || 0) + '/100.' + (st.bill ? ' On the governor\u2019s desk: ' + pcEsc(st.bill.title) + '.' : '') + '</p>' +
      '<p><b>Recent.</b></p>' + (L.length ? '<ul>' + L.map(x => '<li>' + pcEsc(x.t) + '</li>').join("") + '</ul>' : '<p class="pc__m">Nothing on record yet. The record grows as the session does.</p>') +
      (typeof tripButton === "function" ? tripButton(place) : "");
  }
  const p = WORLD_POWERS.find(x => x.t === place);
  if(p) return '<h2 style="margin:0 0 4px">' + pcEsc(p.t) + '</h2><p>' + pcEsc(p.adj) + ' neighbour. They want ' + pcEsc(p.want) + '. Creed: ' + pcEsc(p.creed) + '.</p>' +
    (G.world && G.world.foe === p.k ? '<p><b>Current tension.</b> The Republic\u2019s chief rival this term; heat ' + Math.round(G.world.heat || 0) + '.</p>' : '') +
    realmGovHTML(p) +
    '<p><b>Recent.</b></p>' + (L.length ? '<ul>' + L.map(x => '<li>' + pcEsc(x.t) + '</li>').join("") + '</ul>' : '<p class="pc__m">No dispatches yet.</p>');
  return "";
}
/* the lore and shading extend the Union pane (Neptune's map); M opens it */
function mapShade(P){
  const svg = P.querySelector("svg"); if(!svg || MAP.mode === "lean") return;
  P.querySelectorAll("[data-st]").forEach(g => { const st = stateOf(g.getAttribute("data-st")); if(!st) return; const sh = g.matches("rect,path,polygon") ? g : g.querySelector("rect,path,polygon"); if(sh){ sh.setAttribute("fill", mapColor(st)); sh.setAttribute("fill-opacity", ".8"); } });
}
function mapExtra(){
  const consular = G.regime && /consul/.test(G.regime.form || "");
  const flag = consular ? no7FlagURL() : "";
  const chap = Object.keys((G.rite && G.rite.chapels) || {}).filter(k => G.rite.chapels[k] > 0);
  return '<div class="billbox q-world" style="margin:10px 0">' +
    '<div class="eyebrow">' + (flag ? '<img src="' + flag + '" style="height:16px;vertical-align:middle;margin-right:6px;border:1px solid #000">' : '') + pcEsc((G.country && G.country.name) || "Nieuw Oranje 7") + (consular ? ' \u00b7 the Consular Republic, under Nieuw Oranje VII' : '') + '</div>' +
    '<div style="margin:6px 0">Shade by: ' + [["lean","lean"],["party","party"],["faith","faith"],["tension","tension"]].map(([k, t]) => '<button type="button" class="cl-btn" data-qmode="' + k + '"' + (MAP.mode === k ? ' style="background:#6d5a2e;color:#fff"' : '') + '>' + t + '</button>').join("") + '</div>' +
    '<div style="margin:4px 0;font:12px system-ui"><b>Neighbours:</b> ' + WORLD_POWERS.map(p => '<button type="button" class="cl-btn" data-qplace="' + pcEsc(p.t) + '">' + pcEsc(p.t) + (G.world && G.world.foe === p.k ? ' \u2694' : '') + '</button>').join("") + '</div>' +
    '<div style="margin:4px 0;font:12px system-ui"><b>The Capitol:</b> ' + Object.keys(ROOMS).filter(k => ROOMS[k].t && !/^visit$/.test(k)).slice(0, 18).map(k => pcEsc(ROOMS[k].t)).join(" \u00b7 ") + '</div>' +
    '<div style="margin:4px 0;font:12px system-ui"><b>Consular Rite chapels:</b> ' + (chap.length ? chap.map(k => '\u2720 ' + pcEsc(k) + (G.rite.chapels[k] > 1 ? ' \u00d7' + G.rite.chapels[k] : '')).join(", ") : 'none yet') + '</div>' +
    '</div>' + (MAP.sel && MAP.sel !== (G.mapSel || "") && WORLD_POWERS.some(p => p.t === MAP.sel) ? '<div class="billbox q-lore">' + mapLore(MAP.sel) + '</div>' : '') +
    (G.mapSel ? '<div class="billbox q-lore" style="margin-top:10px"><div class="eyebrow">Lore</div>' + mapLore(G.mapSel) + '</div>' : '');
}
/* M: the Union pane as a sheet over the room, in any layout (immersive too); M or Esc again puts it away */
function mapToggle(on){
  const isOn = document.body.classList.contains("ui-open") && el("paneUnion") && el("paneUnion").classList.contains("is-on");
  if(on === false || (on === undefined && isOn)){ try{ closePanels(); }catch(e){} return; }
  try{ if(!veil.hidden && phoneWasRunning !== null) phoneClose(); }catch(e){}
  document.body.classList.add("ui-open"); picksDirty = true;
  try{ const b = document.querySelector('[data-pane="paneUnion"]'); if(b) b.click(); else showPane("paneUnion"); }catch(e){}
  setTimeout(() => { try{ dropRect(); resize(); }catch(e){} }, 30);
}
setTimeout(function wrapUnion(){
  if(typeof refreshUnion !== "function") return;
  const orig = refreshUnion;
  refreshUnion = function(){
    const r = orig.apply(this, arguments);
    try{
      const P = el("paneUnion"); if(!P) return r;
      mapShade(P);
      const d = document.createElement("div"); d.innerHTML = mapExtra();
      const svg = P.querySelector("svg"); const anchor = svg ? (svg.closest("div") || svg) : null;
      if(anchor && anchor.parentNode === P) P.insertBefore(d, anchor.nextSibling); else P.appendChild(d);
      d.querySelectorAll("[data-qmode]").forEach(b => b.onclick = () => { MAP.mode = b.getAttribute("data-qmode"); refreshUnion(); });
      d.querySelectorAll("[data-qplace]").forEach(b => b.onclick = () => { MAP.sel = b.getAttribute("data-qplace"); refreshUnion(); });
      P.querySelectorAll("[data-rl]").forEach(b => b.onclick = () => { const [k, a] = b.getAttribute("data-rl").split(":"); try{ realmDo(k, a); }catch(e){ console.warn(e); } if(a !== "call" && a !== "aud" && a !== "war") refreshUnion(); });
      d.querySelectorAll("[data-trip]").forEach(b => b.onclick = () => { try{ tripGo(b.getAttribute("data-trip")); }catch(e){ console.warn(e); } refreshUnion(); });
    }catch(e){ console.warn("q map", e); }
    return r;
  };
  const oi = refreshInbox;
  refreshInbox = function(){ const r = oi.apply(this, arguments); try{ dmMount(el("paneInbox")); const Q = el("clPhoneInbox"); if(Q) dmMount(Q); }catch(e){} return r; };
}, 2600);
document.addEventListener("keydown", e => {
  if(e.target && /INPUT|TEXTAREA|SELECT/.test(e.target.tagName)) return;
  const k = (e.key || "").toLowerCase();
  if(!G.you || !G.running) return;
  if(k === "m"){ e.preventDefault(); e.stopImmediatePropagation(); mapToggle(); }
  else if(k === "escape" && document.body.classList.contains("ui-open") && el("paneUnion") && el("paneUnion").classList.contains("is-on")){ e.preventDefault(); e.stopImmediatePropagation(); e._pzHandled = true; mapToggle(false); }
  else if(k === "n"){ e.preventDefault(); e.stopImmediatePropagation(); dmToggle(true); }
}, true);
setTimeout(() => { try{ dmUI(); }catch(e){}
  try{ const t = document.querySelector("#pauseOverlay .settings-tabs"); if(t && !document.getElementById("pauseMap")){ const b = document.createElement("button"); b.id = "pauseMap"; b.className = "settings-tab"; b.textContent = "Map (M)"; b.onclick = e => { e.preventDefault(); try{ document.getElementById("closeSettings").click(); }catch(x){} mapToggle(true); }; t.appendChild(b); } }catch(e){} }, 1500);

/* ===== 20261012u · the docket: every bill or case in front of you, in every chair, with the House's panel ===== */
function dkStateLean(S, it){
  if(!S) return 0;
  if(it.pos){ const sp = {econ:S.lean, lib:-S.lean * 0.4, def:S.lean * 0.3, wel:-S.lean * 0.5}; try{ return clamp(Math.round(alignment({pos:sp}, it)), -100, 100); }catch(e){ return 0; } }
  const b = it.sb; if(!b) return 0;
  return clamp(Math.round((b.dir > 0 ? 1 : -1) * (b.axis === "econ" ? S.lean : b.axis === "lib" ? -S.lean * 0.4 : S.lean * 0.3) * 1.6), -100, 100);
}
function dkMeter(v, label){
  const pct = (v + 100) / 2;
  const col = v > 10 ? "#2f6b3a" : v < -10 ? "#8a2f36" : "#888";
  return '<div style="display:flex;align-items:center;gap:8px;margin:3px 0;font:12px system-ui"><span style="flex:0 0 150px">' + pcEsc(label) + '</span><span style="flex:1;position:relative;height:8px;background:linear-gradient(90deg,#e7c9cc,#eee 50%,#cfe3d2);border-radius:4px"><b style="position:absolute;top:-3px;left:calc(' + pct + '% - 3px);width:6px;height:14px;background:' + col + ';border-radius:2px"></b></span><span style="flex:0 0 74px;text-align:right">' + (v > 10 ? "for" : v < -10 ? "against" : "split") + ' ' + (v > 0 ? "+" : "") + v + '</span></div>';
}
function dkProvisions(it){
  const r = rng(seedOf("prov:" + it.title));
  const L = [];
  L.push("Sec. 1. Short title. This act may be cited as the " + it.title + ".");
  if(it.line) L.push("Sec. 2. Purpose. " + it.line);
  const ax = it.pos ? AXES.slice().sort((a, b) => Math.abs(it.pos[b.k]) - Math.abs(it.pos[a.k]))[0] : AXES.find(a => it.sb && a.k === it.sb.axis);
  if(ax){ const dir = it.pos ? it.pos[ax.k] : (it.sb.dir || 1); L.push("Sec. 3. Direction. Moves policy toward " + (dir > 0 ? ax.hi : ax.lo) + "."); }
  L.push("Sec. 4. " + drawn(["Appropriations. Such sums as are necessary, from the general fund.", "Offset. Paid for by a levy on " + drawn(["shipping","banking","timber","grain"], r) + ".", "Funding. A matching grant to the states, three to one."], r));
  L.push("Sec. 5. " + drawn(["Reporting. The department reports to the committee every six months.", "Oversight. An inspector is named with power to subpoena.", "Sunset. This act lapses after six years unless renewed."], r));
  L.push("Sec. 6. Effective date. " + drawn(["On signature.", "Ninety days after signature.", "The first day of the next fiscal year."], r));
  return L;
}
/* deciding bodies */
function dkCongress(it){
  const by = {};
  (G.members || []).filter(m => !m.gone && m.kind === "member").forEach(m => {
    let a = 0; try{ a = alignment(m, it); }catch(e){}
    const p = m.party || "IND"; const o = by[p] || (by[p] = {aye:0, no:0, un:0});
    if(m.pledge && G.day - (m.pledgeDay || 0) < 8) (m.pledge > 0 ? o.aye++ : o.no++);
    else if(Math.abs(a) < 12) o.un++; else (a > 0 ? o.aye++ : o.no++);
  });
  return by;
}
function dkSenate(it){
  const by = {};
  (G.states || []).forEach(S => { for(let i = 0; i < 2; i++){ const L = senLean(S, i, it), o = by[L.p] || (by[L.p] = {aye:0, no:0, un:0}); Math.abs(L.a) < 8 ? o.un++ : L.a > 0 ? o.aye++ : o.no++; } });
  return by;
}
function dkStatehouse(S, it){
  /* 20261027b: a legislator votes with their party unless home pulls hard the other way; a free vote where the parties have no line */
  const by = {}, n = Math.max(20, (S.seats || 6) * 6), L = slLine(it), lean = clamp(stLeanC(S, it) / 50, -1, 1), push = it.sb ? (it.sb.pushed || 0) : 0;
  for(let i = 0; i < n; i++){
    const r = rng(seedOf("leg:" + S.n + i + ":" + it.title));
    const x = r(), fed = clamp(0.48 + S.lean / 110, 0.12, 0.84), ind = 0.06;
    const p = x < fed ? "FED" : x < fed + ind ? "IND" : "COM";   /* a dominant party, never the whole chamber */
    const a = (L[p] || 0) * 30 + lean * 22 + (r() * 50 - 25) + push * 0.6;
    const o = by[p] || (by[p] = {aye:0, no:0, un:0}); Math.abs(a) < 6 ? o.un++ : a > 0 ? o.aye++ : o.no++;
  }
  return by;
}
function dkBench(c){
  const J = (G.court && G.court.length ? G.court : [{name:"Chief Justice Hale"},{name:"Justice Orr"},{name:"Justice Vance"},{name:"Justice Quist"},{name:"Justice Mbeki"}]);
  const rows = J.map(j => { const r = rng(seedOf("j:" + j.name + ":" + c.t)); const lean = (j.pos ? (j.pos.lib || 0) / 2 : 0) + r() * 80 - 40;
    return {name:j.name, v: Math.abs(lean) < 10 ? "undecided" : lean > 0 ? (c.dual != null ? "for the House" : "for the Union") : (c.dual != null ? "for the member" : "for the state")}; });
  return rows;
}
function dkBreak(by, body){
  let A = 0, N = 0, U = 0; const rows = Object.keys(by).map(p => { const o = by[p]; A += o.aye; N += o.no; U += o.un;
    return '<div class="whip__row"><span class="whip__n">' + pcEsc(((G.parties || {})[p] && G.parties[p].short) || p) + '</span><span class="whip__w">aye ' + o.aye + ' · nay ' + o.no + ' · undecided ' + o.un + '</span></div>'; }).join("");
  const T = Math.max(1, A + N + U);
  return '<div class="eyebrow" style="margin-top:10px">' + pcEsc(body) + ' · how it leans</div>' +
    '<div class="count"><div class="c-aye"><i>Aye</i><b>' + A + '</b></div><div class="c-no"><i>Nay</i><b>' + N + '</b></div><div class="c-un"><i>Undecided</i><b>' + U + '</b></div></div>' +
    '<div class="countbar"><span style="width:' + (A / T * 100) + '%;background:var(--good)"></span><span style="width:' + (N / T * 100) + '%;background:var(--bad)"></span><span style="width:' + (U / T * 100) + '%;background:var(--line)"></span></div>' + rows;
}
function dkPublic(it, national){
  const y = G.you, S = (G.states || []).find(s => s.n === y.state);
  let h = '<div class="eyebrow" style="margin-top:10px">How ' + pcEsc(y.state) + ' leans</div><div>' + dkMeter(dkStateLean(S, it), y.state);
  let towns = []; try{ towns = (townsOf(y.state) || []).slice(0, 3); }catch(e){}
  towns.forEach(t => { const v = clamp(dkStateLean(S, it) + (seedOf(t.name + it.title) % 50) - 25, -100, 100); h += dkMeter(v, t.name); });
  const creeds = [S && S.creed || "latin", "kerk", "none"].filter((v, i, a) => a.indexOf(v) === i);
  creeds.forEach(c => { const v = clamp(dkStateLean(S, it) + ((seedOf(c + it.title) % 60) - 30) * (c === "none" ? -1 : 1), -100, 100); h += dkMeter(v, "faith: " + c); });
  h += '</div>';
  if(national){
    let w = 0, s = 0; (G.states || []).forEach(St => { const p = St.pop || 1; w += p; s += dkStateLean(St, it) * p; });
    h += '<div class="eyebrow" style="margin-top:8px">The nation</div><div>' + dkMeter(Math.round(s / Math.max(1, w)), "national") + '</div>';
  }
  return h;
}
/* what is in front of you */
function dkItems(){
  const y = G.you, k = roleKey(), out = [];
  const S = (G.states || []).find(s => s.n === y.state);
  const nat = b => b && !b.done ? {kind:"bill", title:b.title, line:b.line, sponsor:b.sponsor, pos:b.pos, b} : null;
  if(k === "house" || k === "leader" || k === "chair"){ const it = nat(G.bill); if(it){ it.body = "The House"; it.by = dkCongress(it); it.acts = [
      {t:"Vote aye (declare)", run(){ y.vote = 1; feed("You declare for the " + it.title + "."); return "Declared aye. The whip writes it down."; }},
      {t:"Vote nay (declare)", run(){ y.vote = -1; feed("You declare against the " + it.title + "."); return "Declared nay. The whip writes that down too."; }}]; out.push(it); } }
  if(k === "senate"){ const it = nat(G.bill); if(it){ it.body = "The Senate"; it.by = dkSenate(it); it.acts = ["aye","nay"].map(v => ({t:"Vote " + v, off:it.b.senateVote, run(){
      const s = dkStateLean(S, it) * (v === "aye" ? 1 : -1); it.b.senateVote = v; y.approval = clamp(y.approval + (s > 0 ? 2 : -2), 0, 100);
      (G.members || []).filter(m => m.party === y.party && m.rel).forEach(m => m.rel.warmth = clamp(m.rel.warmth + (partyLine(it.b)[y.party] === (v === "aye" ? 1 : -1) ? 1 : -2), -100, 100));
      reactEmit("senVote", {title:it.title, pos:it.pos || null, v}); feed("Senator " + surname(y.name) + " votes " + v + " on the " + it.title + "."); return "Recorded " + v + ". " + (s > 0 ? y.state + " approves." : y.state + " will not forget it."); }})); out.push(it); } }
  if(k === "gov" && S && S.bill){ const b = S.bill; const it = {kind:"state bill", title:b.title, line:"Passed by the legislature of " + y.state + "." + amendText(S), sponsor:"the " + y.state + " majority leader", sb:b, body:"The " + y.state + " legislature"};
    it.by = dkStatehouse(S, it);
    it.acts = [{t:"Sign it", run(){ S.ind = clamp(S.ind + (b.ind || 0), 0, 100); S.unrest = clamp(S.unrest + (b.unrest || 0), 0, 100); S.lean = clamp(Math.round(S.lean + b.dir * 3), -100, 100); S.bill = null;
        y.approval = clamp(y.approval + (dkStateLean(S, it) > 0 ? 3 : -2), 0, 100); try{ kMark("gdesk"); }catch(e){} reactState(S, b, true); feed("Governor " + surname(y.name) + " signed the " + b.title + ".", "good"); return "Signed at the desk, with the sponsors behind you." + amendApply(S); }},
      {t:"Veto it", run(){ S.bill = null; S.unrest = clamp(S.unrest + 2, 0, 100); y.approval = clamp(y.approval + (dkStateLean(S, it) < 0 ? 3 : -2), 0, 100); try{ kMark("gdesk"); }catch(e){} reactState(S, b, false); feed("Governor " + surname(y.name) + " vetoed the " + b.title + ".", "bad"); return "Vetoed. The majority leader will not return your calls this week."; }}];
    out.push(it); }
  if(k === "bench"){ (G.cases || []).filter(c => !c.done).slice(0, 3).forEach(c => {
      const it = {kind:"case", title:c.t, line:c.dual != null ? "Can one person hold two elected offices?" : "A state against the Union over a federal act.", sponsor:"filed day " + c.day, c, body:"The bench", benchRows:dkBench(c), sb:{dir:1, axis:"lib"}};
      const recuse = c.state === y.state || (c.voted && c.voted.indexOf(y.name) >= 0);
      it.acts = recuse ? [{t:"Recuse", run(){ c.done = true; c.recused = true; return "You recused. The bench decides without you."; }}]
        : [{t:c.dual != null ? "Rule for the House" : "Rule for the Union", run(){ return benchRule(c, true); }}, {t:c.dual != null ? "Rule for the member" : "Rule for the state", run(){ return benchRule(c, false); }}];
      out.push(it); }); }
  if(k === "pres"){ (G.lastActs || []).filter(a => !a.signed && !a.vetoed).slice(0, 3).forEach(a => {
      const it = {kind:"act", title:a.title, line:"Passed by the House and Senate on day " + a.day + ". If you neither sign nor veto it, it becomes law without your signature on day " + ((a.day || G.day) + 10) + "; if the Congress ends first, it dies unsigned.", sponsor:"Congress", pos:a.pos || {econ:0, lib:0, def:0, wel:0}, body:"Congress", national:true};
      it.by = dkCongress(it);
      it.acts = [{t:"Sign it", run(){ a.signed = true; y.approval = clamp(y.approval + 2, 0, 100); reactAct(a.title, a.pos, true); feed(execTitle() + " " + surname(y.name) + " signed the " + a.title + ".", "good"); return "Signed, with eleven pens."; }},
        {t:"Veto it", run(){ a.vetoed = true; y.standing = clamp(y.standing - 3, 0, 100); y.influence = clamp(y.influence + 3, 0, 100); reactAct(a.title, a.pos, false); feed(execTitle() + " " + surname(y.name) + " vetoed the " + a.title + ".", "bad"); return "Vetoed. The House can override with two thirds."; }}];
      out.push(it); }); }
  return out;
}
/* ── 20261013l · say what a bill is, clause by clause, in plain words ── */
const DK_CLAUSE_MEANING = [
  ["Sec. 1. Short title", "The name it goes by. It changes nothing by itself."],
  ["Sec. 2. Purpose", "What the act says it is for."],
  ["Sec. 3. Direction", "Which way it pushes policy on its main axis."],
  ["Sec. 4. Appropriations", "Money the act lets government spend, taken from the general fund."],
  ["Sec. 4. Offset", "Who pays for it: a levy on the trade named."],
  ["Sec. 4. Funding", "Money sent to the states, usually with a rule that they must match it."],
  ["Sec. 5. Reporting", "A department must tell a committee how it is going, on a fixed schedule."],
  ["Sec. 5. Oversight", "An inspector who can demand papers and call witnesses."],
  ["Sec. 5. Sunset", "The act expires on its own after six years unless the House votes to renew it."],
  ["Sec. 6. Effective date", "When it starts to apply to anyone."]
];
function dkMeaning(line){ const h = DK_CLAUSE_MEANING.find(x => String(line).indexOf(x[0]) === 0); return h ? h[1] : ""; }
/* the clauses, each with what it does in ordinary words */
function dkProvisionsRich(it){
  return dkProvisions(it).map(x => {
    const m = dkMeaning(x);
    return "<li>" + pcEsc(x) + (m ? '<br><span class="muted" style="font-size:12px">' + pcEsc(m) + '</span>' : "") + "</li>";
  }).join("");
}
/* what the bill does, who pays, who is for and against, in a few sentences */
function dkPlain(it){
  if(it.kind === "case") return (it.line || "A court case.") + " Whatever the bench rules binds the states from the day it is read.";
  const pos = it.pos || (it.sb ? {[it.sb.axis || "econ"]:(it.sb.dir || 1) * 40} : {});
  const top = AXES.slice().sort((a, b) => Math.abs(pos[b.k] || 0) - Math.abs(pos[a.k] || 0))[0];
  const v = top ? (pos[top.k] || 0) : 0;
  const dir = top && Math.abs(v) >= 8 ? "It pushes the country toward " + (v > 0 ? top.hi : top.lo) + " on " + top.n + " (" + (Math.abs(v) > 30 ? "strongly" : "somewhat") + ")." : "It barely moves the country on any axis.";
  let cost = ""; try{ cost = dkCostLine(it); }catch(e){}
  const money = /struck/.test(cost) ? "The funding section is struck, so the act would pay for nothing." : cost.replace(/^Cost: /, "It costs ");
  let rows = []; try{ rows = dkStakeholders(it); }catch(e){}
  const gain = rows.filter(r => r[1] === "for it").map(r => r[0]), lose = rows.filter(r => r[1] === "against it").map(r => r[0]);
  const who = (gain.length ? " Groups for it: " + gain.slice(0, 2).join(", ") + "." : "") + (lose.length ? " Groups against it: " + lose.slice(0, 2).join(", ") + "." : "");
  return dir + " " + money + who;
}
/* why each interest group takes its side: [reason if for it, reason if against it] */
const DK_WHY = {
  "The Chamber of Commerce": ["it lowers what firms pay and cuts the rules they must follow", "it adds costs and rules to business"],
  "The union delegates": ["it protects wages and gives workers more say", "it cuts the protections that keep wages up"],
  "The farm co-ops": ["it helps the markets farmers sell into", "it pushes down the prices farmers get"],
  "The civil liberties union": ["it protects people's right to act and be heard", "it gives the state more say over what people may do"],
  "The Consular Guard": ["it keeps order in the faith and under the First Consul", "it puts the Rite's own liberties at risk"],
  "The bar association": ["it is written to hold up in court", "it invites lawsuits and leaves duties unclear"],
  "The veterans' league": ["it keeps the country ready to defend itself", "it spends on arms that do not serve veterans"],
  "The peace churches": ["it commits the country to restraint", "it asks people to fight a war they did not choose"],
  "The shipyards": ["it means orders and jobs at the yards", "it costs the yards' private buyers more"],
  "The county hospitals": ["it keeps care open where people live", "it asks counties to fund care they cannot pay for"],
  "The taxpayers' league": ["it is paid for without raising the tax they pay", "it spends money that has to come from somewhere"],
  "The parishes' charities": ["it sends help to those who need it", "it leans on charity the parish cannot afford"]
};
/* ══════════════════════════════════════════════════════════
   20261013w · CASES
   A petitioner is not a sentence. Behind every ask is a case: what happened,
   since when, who it touches, what it costs, what has been tried, what they
   are asking for and what they would settle for. The sitting draws every line
   from it: the opening, the rebuttals, your questions, the answers to what you
   type, and what each choice does afterwards.
   ══════════════════════════════════════════════════════════ */
function curF(n){ return ((typeof CURRENCY !== "undefined" && CURRENCY && CURRENCY.sym) ? CURRENCY.sym : "ƒ") + Math.round(n).toLocaleString("en-US"); }
function capS(s){ s = String(s || ""); return s.charAt(0).toUpperCase() + s.slice(1); }
function caseTown(st, r){
  try{ const T = townsOf(st) || []; if(T.length) return T[Math.floor(r() * T.length)].name; }catch(e){}
  return st || "the county";
}
/* the case behind one petition. Returns null when nothing is known about it. */
function caseFile(role, want, st, name){
  const r = rng(seedOf("case:" + name + ":" + want)), ri = (a, b) => a + Math.floor(r() * (b - a + 1));
  const T = caseTown(st, r), w = String(want || ""), C = {kind:null, qa:{}};
  if(/road/.test(w)){
    const km = (ri(18, 45) / 10).toFixed(1), farms = ri(28, 52), litres = ri(2400, 5200) * 7, days = ri(34, 70), fix = ri(26, 48) * 1000, bypass = Math.round(fix * 0.5 / 1000) * 1000, hours = ri(2, 3);
    Object.assign(C, {kind:"road", short:"the " + T + " creamery road", cost:fix, costText:curF(fix), affected:farms + " farms", stakeShort:"forty herds go to market by autumn if the creamery drops the route",
      open:["The " + T + " creamery road went out in the March floods: " + km + " kilometres of it, and the culvert at the creek with it.",
        "The milk truck will not cross, so " + farms + " farms are hauling by tractor the long way round, " + hours + " extra hours a day, and tipping out about " + litres.toLocaleString("en-US") + " litres a week.",
        "The engineer's figure is " + curF(fix) + " for a new culvert and a gravel bed. I would like that in this year's budget, before the spring runoff does it again."],
      ask:curF(fix) + " for the culvert and roadbed before the spring runoff, and a letter saying which office owns the road.",
      settle:curF(bypass) + " for a gravel bypass now, and the full repair in the spring budget.", settleShort:"a gravel bypass now and the full repair in spring",
      qa:{cost:"The engineer put it at " + curF(fix) + ": about two thirds for the culvert and the rest for the roadbed. I have his sheet with me.",
        when:"It went out on a Tuesday in March. It is " + days + " days now, and every one of them is a day of tractors.",
        why:"The old culvert was built for a creek that stopped being a creek in my grandfather's time, and then the creek came back. Nobody has inspected it in my lifetime.",
        tried:"Four letters, two phone calls and a morning at the county seat. The county says it is a state road and the state says it is a county road.",
        who:"Forty farms use it, and the creamery. If the creamery drops our route, " + farms + " herds go to market by autumn.",
        stake:"If it washes out again before it is fixed it will cost twice this, and I will not be the only one telling you so."}});
  } else if(/teachers/.test(w)){
    const cls = ri(37, 44), late = ri(3, 7), lateAmt = ri(38, 58) * 1000, post = ri(16, 19) * 1000, cost = post * 3;
    Object.assign(C, {kind:"school", short:"the " + T + " schools", cost, costText:curF(cost), affected:(cls * 9) + " children", stakeShort:"the school cuts a grade in January and the children go by bus to the next district",
      open:["I chair the " + T + " school board. We are three teachers short, and classes are running at " + cls + " to a room.",
        "The state's equalization check was due on the first and it is " + late + " weeks late: " + curF(lateAmt) + ". Without it I cannot pay substitutes, let alone advertise the three posts.",
        "Release the check and fund the three posts, " + curF(cost) + " for the year, or I will be telling parents in the " + T + " hall on Thursday that the school will cut a grade."],
      ask:"the late check released this month, and " + curF(cost) + " for three teaching posts for the year.",
      settle:"the check released this month and the three posts funded from January.", settleShort:"the late check released and three posts from January",
      qa:{cost:"Three posts at about " + curF(post) + " each: " + curF(cost) + " a year. The check is a separate " + curF(lateAmt) + " the state already owes us.",
        when:"The check was due on the first. The treasurer's office has given me three different dates since.",
        why:"They told me the equalization formula was 'under review'. Nobody will say who is reviewing it or when they finish.",
        tried:"I have rung the treasurer's office eleven times, and I borrowed against the check at the bank in " + T + ". The bank will not do it twice.",
        who:"About " + (cls * 9) + " children across the " + T + " schools, and the three teachers' own families.",
        stake:"The school cuts a grade in January, and the children go by bus to the next district, two hours there and back."}});
  } else if(/water main/.test(w)){
    const cost = ri(260, 420) * 1000, rev = ri(38, 60) * 1000, fine = ri(3, 6) * 100, wks = ri(5, 12), pop = ri(2, 9) * 1000;
    Object.assign(C, {kind:"water", short:"the " + T + " water main", cost, costText:curF(cost), affected:pop.toLocaleString("en-US") + " townspeople", stakeShort:"the town is bankrupt by spring and the state gets the main anyway, along with the town",
      open:["I am the mayor of " + T + ". Last year the state ordered us to replace the water main under the high street, and I do not dispute that it is old: we lose a third of what we pump.",
        "The job is " + curF(cost) + ". The town raises about " + curF(rev) + " a year. The state's own fine starts in " + wks + " weeks, " + curF(fine) + " a day.",
        "I am not asking the state to forget the order. I am asking it to pay its share of the order."],
      ask:"the state paying 80 per cent of " + curF(cost) + ", and the fine suspended while the work is done.",
      settle:"a state loan at low interest, repaid over twenty years, and a year's extension before any fine.", settleShort:"a state loan and a year's extension",
      qa:{cost:curF(cost) + " for the main, from the engineer's tender. The town cannot raise more than " + curF(rev) + " in a year without closing the library and the pool.",
        when:"The order came last spring. The fine starts in " + wks + " weeks.",
        why:"The old iron main leaks about a third of what we pump, and the state's standard says that is too much. I agree with the state. I cannot pay for agreeing.",
        tried:"We applied to the state water fund twice. The first was refused for a missing form and the second is still 'pending'.",
        who:"All " + pop.toLocaleString("en-US") + " of us, and the dairy and the hospital, which both run on that main.",
        stake:"If the fine runs, the town is bankrupt by spring, and the state gets the water main anyway, along with the town."}});
  } else if(/plant/.test(w)){
    const jobs = ri(160, 420), mo = ri(5, 9);
    Object.assign(C, {kind:"plant", short:"the " + T + " plant permit", cost:0, costText:"no money, only a decision", affected:jobs + " workers", stakeShort:"the line moves to another state and the town loses a third of its tax base",
      open:["I speak for " + jobs + " workers at the " + T + " plant. Its air permit expired in the spring and the renewal has sat at the state environment office for " + mo + " months.",
        "The owners have told us that if there is no permit by the end of the month they will move the line to another state, and they already hold the lease on a building there.",
        "Nobody is asking for the permit to be waved through. We are asking for an inspector to be sent and a decision to be made."],
      ask:"an inspector sent this month, and the renewal decided by the end of it, with conditions if there must be conditions.",
      settle:"a six-month provisional permit with an inspection, so the line stays while the file is finished.", settleShort:"a six-month provisional permit",
      qa:{cost:"It costs the state nothing but a decision. The plant pays for the inspection.",
        when:"The old permit ran out in the spring. The file has not moved since.",
        why:"The environment office lost the first application and says the second must start from the beginning. Nobody has told us what is wrong with it.",
        tried:"We have written, the union local has written, and the plant has sent its lawyers. The office answers the lawyers and not us.",
        who:jobs + " jobs, and every shop on the high street that lives off the payroll.",
        stake:"If the line goes, the town loses about a third of its tax base, and the people who built the plant go with it."}});
  } else if(/ballots/.test(w)){
    const cost = ri(7, 12) * 1000, wks = ri(6, 14), voters = ri(8, 16) * 1000;
    Object.assign(C, {kind:"ballots", short:"the " + T + " special election", cost, costText:curF(cost), affected:voters.toLocaleString("en-US") + " voters", stakeShort:"the seat stays empty and the county has no vote in the House",
      open:["I am the county clerk. The special election to fill the vacant seat was called, but the ballots were never printed: the printer's last invoice was not paid and the printer will not run another sheet until it is.",
        "The seat has been empty for " + wks + " weeks, and " + voters.toLocaleString("en-US") + " voters have had no vote in the House since the spring.",
        "It is " + curF(cost) + " to print and post. I need the money released and a new date fixed, in writing."],
      ask:curF(cost) + " released for the printer this week, and a new election date set in writing.",
      settle:"mail ballots only, which cost about half, with the polling places closed.", settleShort:"mail ballots only",
      qa:{cost:curF(cost) + " to print and post: the old invoice plus a new run. I have the printer's letter.",
        when:"The election was called " + wks + " weeks ago and the ballots were due three weeks before the vote.",
        why:"The printing contract is paid from an account that was frozen in the last audit. Nobody unfroze it and nobody told me.",
        tried:"I wrote to the secretary of state, and I wrote again, and I paid the printer's deposit out of my own pocket until I could not.",
        who:voters.toLocaleString("en-US") + " voters in the district, and whoever is meant to be speaking for them in the House.",
        stake:"The longer the seat is empty, the more the other members vote as if we were not there."}});
  } else if(/pension letter/.test(w)){
    const monthly = ri(160, 260), months = ri(3, 7), owed = monthly * months;
    Object.assign(C, {kind:"pension", short:"the widow's pension", cost:owed, costText:curF(owed) + " in arrears", affected:"one household", stakeShort:"she goes on living on her daughter's charity for a pension she is owed",
      open:["My husband worked thirty-one years on the state ferries, and his widow's pension was " + curF(monthly) + " a month. It stopped " + months + " months ago.",
        "The pension office sent me a letter, and it came back to them unopened, marked 'not at this address'. I moved in with my daughter after the funeral and nobody asked where I had gone.",
        "I am owed " + curF(owed) + ". I would like it paid, and my address changed in their books by someone who will write it down while I watch."],
      ask:"the widow's pension restored from this month, the " + curF(owed) + " in arrears paid, and the address corrected.",
      settle:"the pension restarted now, and the arrears paid in installments over the year.", settleShort:"the pension restarted and the arrears in installments",
      qa:{cost:"It was " + curF(monthly) + " a month for " + months + " months: " + curF(owed) + ". It is not a large sum. It is the difference between my daughter's house and my own.",
        when:"It stopped " + months + " months ago, the month after the funeral.",
        why:"They wrote to the old address and the letter came back, and the rule in their office is that a letter that comes back stops the payment. Nobody telephoned.",
        tried:"I have been to the office twice. The first clerk told me to write, and the second told me the first was wrong.",
        who:"Only me, Governor. But there are others in my position, and they are not here.",
        stake:"I do not ask for anything else. If it is not paid, I do not know how to go on living in my daughter's house as a guest."}});
  } else if(/bread|grain price/.test(w)){
    const loaves = ri(3, 6), cost = ri(7, 14) * 1000, days = ri(9, 24), bak = ri(3, 7);
    Object.assign(C, {kind:"bread", short:"the " + T + " bread", cost, costText:curF(cost), affected:"most of the town", stakeShort:"families skip meals and the bakers close", 
      open:["The price of a loaf in " + T + " has gone up " + loaves + " times in " + days + " days, and " + bak + " bakers have stopped baking for the poor streets.", "The grain is held at the border and what reaches us comes at the carters' price. The town council has put in what it has.", "We are asking for " + curF(cost) + " to buy flour at cost and sell it at the old price until the grain moves again."],
      ask:curF(cost) + " to buy flour at cost for the poor streets until the grain moves.", settle:"half now, to open one municipal bakery, and the rest when the harvest is in.", settleShort:"half now and one municipal bakery",
      qa:{cost:"About " + curF(cost) + " for the flour and the ovens' fuel until the harvest.", when:"It started " + days + " days ago, with the first frost.", why:"The grain is held at the border, and the carters have named their own price.", tried:"The council voted its own reserve and the churches have a soup kitchen. It is not enough.", who:"Most of the town, and everybody on the poor streets.", stake:"If the bakers close, people will take what they can from the carts, and then it is a different kind of problem."}});
  } else if(/constable|break-?ins/.test(w)){
    const nights = ri(4, 9), cost = ri(5, 12) * 1000;
    Object.assign(C, {kind:"order", short:"the " + T + " constable", cost, costText:curF(cost), affected:"the town's shops and houses", stakeShort:"people stop going out after dark and the watch becomes a mob",
      open:["There have been " + nights + " break-ins in " + T + " in a month, and the town has no constable: the last one retired and the council could not afford another.", "People have started keeping dogs and cudgels. I would like that to stop before somebody is hurt.", "We are asking for " + curF(cost) + " to pay a constable and a lamp on the high street for a year."],
      ask:curF(cost) + " for a constable and the street lamps for a year.", settle:"a part-time constable now, shared with the next town.", settleShort:"a shared part-time constable",
      qa:{cost:"About " + curF(cost) + " for the year, with the lamps.", when:"It began in the autumn, after the mill laid off the night shift.", why:"People out of work, and nobody on the street at night.", tried:"The council has a volunteer watch. They are tired and one of them has a cudgel.", who:"Every shop on the high street, and everybody who walks home late.", stake:"A volunteer watch with a grievance is how a street becomes a mob."}});
  } else return null;
  C.qa.ask = C.ask; C.qa.settle = C.settle;
  return C;
}
/* the answers to what you type to someone with a case */
function caseAnswer(p, text){
  const c = p && p.case; if(!c) return null;
  const t = String(text || "").toLowerCase(), q = c.qa, has = re => re.test(t), hot = (p.temper || 50) > 62;
  const lead = hot ? one3(["Look, Governor. ", "Plainly, then. ", "I will say it straight. "]) : one3(["", "Of course. ", "Yes. "]);
  let key = null, d = 2;
  if(has(/\b(sorry|i understand|i hear you|that must be|that is not right|unacceptable|shouldn'?t have)\b/)) return {d:5, text:one3(["Thank you, Governor. That means more than the letters did. ", "I did not expect to be heard. Thank you. "]) + "What I am asking is simple: " + c.ask};
  if(has(/\b(i will|i promise|you will have|it is done|granted|i'll make sure|i'll see to it)\b/)) return {d:9, text:one3(["I will hold you to that, Governor, and I mean that kindly. ", "Then I will tell them at home it is moving. Put it in writing, please. "]) + "To be clear, the part I cannot do without is " + c.settleShort + ".", promise:true};
  if(has(/\b(no money|nothing i can|i can'?t|we can'?t|can'?t (do|help|afford)|cannot|impossible|not possible|refuse|there is no|we have no)\b/)) return {d:-6, text:lead + one3(["Then tell me plainly who I am to tell, and I will tell them. ", "I did not come to be told no by someone who has not read it. "]) + capS(c.stakeShort) + "."};
  if(has(/\b(settle|compromise|half|instead|part of|alternative|meet (you|in)|middle|phase|stage|installment|loan|provisional|bypass)\b/)) { key = "settle"; d = 5; }
  else if(has(/\b(how much|cost|price|figure|money|afford|budget|pay for|who pays)\b/)) key = "cost";
  else if(has(/\b(when|how long|since|deadline|date|how many (weeks|days|months))\b/)) key = "when";
  else if(has(/\b(why|cause|reason|whose fault|who is responsible|blame|what happened)\b/)) key = "why";
  else if(has(/\b(tried|already|wrote|written|contact|who did you|what did they say|have you asked)\b/)) key = "tried";
  else if(has(/\b(who|how many|affected|families|children|workers|farms|people)\b/)) key = "who";
  else if(has(/\b(what happens|do nothing|consequence|risk|stake|if (we|i|you) don'?t)\b/)) key = "stake";
  else if(has(/\b(what do you want|what are you asking|what would you like|ask of me|what do you need|what can i do)\b/)) key = "ask";
  if(key) return {d, text:lead + q[key] + (key === "ask" || key === "settle" ? "" : one3([" ", " "]) + one3(["That is the whole of it.", "Ask me anything else you need.", "Is that what you wanted to know?"]))};
  return {d:1, text:lead + "Let me put it plainly, Governor. " + c.ask + " " + one3(["What can you tell me today?", "Can you give me a date?", "Who do I hold to this?"])};
}
function one3(a){ return a[Math.floor(Math.random() * a.length)]; }
/* delegations: three people from a realm, each with an ask, a price and a line they will not cross */
const DLG = {
  reach:{ask:"grain on credit", give:"the frontier garrisons pulled back thirty kilometres", red:"any Union militia within twenty kilometres of their border"},
  horn:{ask:"joint rights to the strait and the oil under it", give:"a share of the oil at cost", red:"a Union naval base on the strait"},
  pale:{ask:"iron on credit and winter grain", give:"timber and the northern passage", red:"a tariff on iron they cannot pay"},
  marches:{ask:"a written promise that no army crosses the Free Marches", give:"free passage for Union trade on a neutral road", red:"any Union troops on their roads, even in transit"},
  isles:{ask:"recognition of their flag and the fishing grounds", give:"licence fees and a berth for the Union fleet", red:"fishing licences issued by the Union"},
  rift:{ask:"the river held in common and aid for those left on it", give:"a river pilot service and an opened trade route", red:"the Union damming the river"}
};
function delegationCases(r){
  const D = DLG[r.k] || {ask:r.want, give:"goodwill", red:"being asked for too much"};
  const rr = rng(seedOf("dlg:" + r.k + ":" + (G.day || 1))), ri = (a, b) => a + Math.floor(rr() * (b - a + 1));
  const sum = ri(30, 90) * 1000, yrs = ri(3, 8);
  const mk = (kind, short, open, ask, settle, settleShort, qa, stakeShort, cost, tone) => ({kind, short, cost:cost || 0, costText:cost ? curF(cost) : "no money, only a promise", affected:"their people", stakeShort, open, ask, settle, settleShort, qa:Object.assign({ask, settle}, qa), tone});
  const amb = mk("dlg-main", D.ask, [
      "We are grateful to be received. " + capS(r.t) + " has one request above all others: " + D.ask + ".",
      "We did not come only to ask. In return " + r.t + " offers " + D.give + ", and it will put that in writing.",
      "There are people at home who say the Union will take and not give. I would like to go back with a different answer."],
    D.ask + ", and " + D.give + " from us in exchange, in writing.",
    "a letter of intent now, and a joint working group to settle " + D.ask + " by spring.", "a letter of intent and a working group",
    {cost:"For us it is " + curF(sum) + " a year, or the equivalent in " + (r.k === "horn" ? "oil" : r.k === "reach" || r.k === "pale" ? "grain" : "goods") + ". For you it is less than a bad harvest.",
     when:"We have asked since the spring and received three polite replies and no date. We would like a date.",
     why:"Because the old arrangement ended and nothing replaced it. " + capS(r.t) + " does not wish to be a petitioner for ever.",
     tried:"We wrote to the capital, we sent a smaller mission in the winter, and we have waited. This is the second delegation.",
     who:"Our ministers will answer to the people who sent us. If we return empty-handed, the voices at home who prefer the other neighbour will be louder.",
     stake:"If we return without an answer, " + r.t + " will look elsewhere for it, and it knows who else is willing."},
    "the other neighbour gets what " + r.t + " came here for", sum, "formal");
  const tloss = ri(8, 20) * 1000;
  const att = mk("dlg-trade", "the trade terms", [
      "I am the trade counsellor. The ambassador speaks of friendship; I speak of figures.",
      "At present the tariff on our goods is high enough that a cart of ours loses its profit at your border, and a cart of yours sells at ours at half price. That cannot last.",
      "We propose a fixed schedule for " + yrs + " years, reviewed each spring, so that both sides can plan."],
    "a fixed tariff schedule for " + yrs + " years, reviewed each spring.", "a one-year schedule at current rates, then review.", "a one-year schedule and a review",
    {cost:"The loss to your treasury is small, about " + curF(tloss) + " a year. The gain to your merchants is larger.",
     when:"The current tariff took effect two Congresses ago. We have asked for review in every one since.",
     why:"The tariff was written for a war that ended. Nobody went back to change it.",
     tried:"We raised it in the spring talks. We were told it was a matter for the House, and the House told us it was a matter for the executive.",
     who:"The merchants on both sides, and the customs men, who spend their days arguing about the schedule.",
     stake:"If the tariff stays, the trade goes round you, and you collect nothing from it at all."},
    "the trade goes round the Union and it collects nothing", tloss, "dry");
  const mil = mk("dlg-red", "their one condition", [
      "I am the military attaché, and I will be short. There is one thing " + r.t + " will not accept, whatever else is agreed: " + D.red + ".",
      "That is not a bargaining position. It is the reason I am in the room. Everything else we can discuss.",
      "If the Union will say in writing that it does not intend it, I can recommend that my government go further on the rest."],
    "a written assurance that the Union does not intend " + D.red + ".", "a spoken assurance now and a written one after the working group reports.", "a spoken assurance now, written later",
    {cost:"It costs you nothing to say. It would cost us a great deal if you did it.",
     when:"It has been rumoured since the winter. I would like it denied by someone who can be held to it.",
     why:"Because we have seen what the Union does at the other frontiers, and we read the papers.",
     tried:"We have asked quietly. Quietly, the answers are always kind and never in writing.",
     who:"Everyone who lives within a day's ride of the frontier, and the soldiers who would be sent to meet it.",
     stake:"If it is not denied, my government will assume it is true, and it will act on what it assumes."},
    "my government assumes the worst and acts on it", 0, "blunt");
  return [amb, att, mil];
}

function dkCard(i){
  const L = dkItems(); i = i || 0;
  const it = L[i];
  G.running = false;
  let h = '<div class="eyebrow">The docket · ' + pcEsc(ROLE_T[roleKey()] || "Member") + (L.length > 1 ? ' · ' + (i + 1) + ' of ' + L.length : '') + '</div>';
  if(!it){ h += '<h1>Nothing before you</h1><p class="dream">No bill or case is waiting on you today.</p>'; }
  else {
    h += '<h1>' + pcEsc(it.title) + '</h1><p class="muted">' + pcEsc(it.line || "") + ' Sponsor: ' + pcEsc(youMark(it.sponsor || "")) + '.</p>' +
      '<div class="eyebrow" style="margin-top:8px">In plain words</div><p>' + pcEsc(dkPlain(it)) + '</p>' +
      '<div class="eyebrow" style="margin-top:8px">Full text, clause by clause</div><ol style="margin:6px 0 0 18px">' + dkProvisionsRich(it) + '</ol>' +
      (it.benchRows ? '<div class="eyebrow" style="margin-top:10px">The bench · how it leans</div>' + it.benchRows.map(r => '<div class="whip__row"><span class="whip__n">' + pcEsc(r.name) + '</span><span class="whip__w">' + pcEsc(r.v) + '</span></div>').join("") : dkBreak(it.by || {}, it.body || "")) +
      dkPublic(it, !!it.national || roleKey() === "pres") + (it.benchRows ? "" : dkExtraHTML(it)) +
      '<div id="dkSay" class="dream"></div>' +
      '<div class="card__actions">' + it.acts.map((a, j) => '<button type="button" class="btn" data-dk="' + j + '"' + (a.off ? ' disabled' : '') + '>' + pcEsc(a.t) + '</button>').join("") + '</div>';
  }
  h += '<div class="card__actions">' + (L.length > 1 ? '<button type="button" class="btn btn--ghost" id="dkNext">Next item</button>' : '') + '<button type="button" class="btn btn--ghost" id="dkClose">Close</button></div>';
  card.innerHTML = h; veil.hidden = false;
  card.querySelectorAll("[data-dk]").forEach(b => b.onclick = () => { const r = it.acts[+b.getAttribute("data-dk")].run(); try{ el("dkSay").textContent = r || ""; }catch(e){} card.querySelectorAll("[data-dk]").forEach(x => x.disabled = true); try{ refreshPanels(); }catch(e){} });
  const nx = el("dkNext"); if(nx) nx.onclick = () => dkCard((i + 1) % L.length);
  el("dkClose").onclick = () => { veil.hidden = true; G.running = true; };
}
setTimeout(() => { try{
  const bar = document.getElementById("uiToolbar");
  if(bar && !document.getElementById("uiDocketBtn")){ const b = document.createElement("button"); b.type = "button"; b.id = "uiDocketBtn"; b.title = "Every bill or case in front of you"; b.textContent = "Docket"; b.onclick = () => { try{ if(PC.open) pcClose(); }catch(e){} dkCard(0); }; bar.insertBefore(b, bar.children[1] || null); }
}catch(e){} }, 1600);

/* ===== 20261012u · the moment decides: a glance, then maybe ===== */
function momentLog(t){ G.moments = G.moments || []; G.moments.push({d:G.day, t}); if(G.moments.length > 60) G.moments.shift(); }
function momentApproach(m, b){
  const T = m.traits || {}, w = m.rel ? m.rel.warmth : 0;
  const mood = (function(){ try{ return moodOf(m).val; }catch(e){ return 0; } })();
  /* the glance */
  m.faceUntil = G.t + 1.2 + Math.random();
  const nerve = 0.35 + (T.ambition | 0) / 250 + (100 - (T.discretion | 0)) / 400 + w / 300 + mood / 400 - (G.you.standing > 70 ? 0.08 : 0);
  const others = (G.members || []).filter(o => o && o !== m && !o.gone && o.room === m.room && Math.hypot(o.x - m.x, o.z - m.z) < 4);
  const r = Math.random();
  const come = () => { const ang = Math.random() * 6.283, rad = 1.35 + Math.random() * 0.8; m.tx = cam.x + Math.sin(ang) * rad; m.tz = cam.z + Math.cos(ang) * rad;
    if(m._meant && m._meant < G.day && chance(.6)){ m.say = pick(["I meant to catch you yesterday.", "I was going to come over the other day. Here I am.", "I lost my nerve last time. Not today."]); m.sayT = 3; m.sayTo = "you"; }
    m._meant = 0; };
  if(r < clamp(nerve, 0.12, 0.85)){
    if(others.length && chance(.18)){ /* waylaid */
      const o = pick(others); m.tx = o.x + (Math.random() * 2 - 1) * 0.8; m.tz = o.z + (Math.random() * 2 - 1) * 0.8;
      m._meant = G.day; o.say = pick(["A word, before you go?", "Have you got a minute?", "Hold on, I need you."]); o.sayT = 2.4;
      momentLog(m.name + " started toward you and was caught by " + o.name + ".");
      return;
    }
    come(); return;
  }
  /* lost their nerve, or a look held and broken */
  m._meant = G.day;
  if(chance(.35)){
    m.faceUntil = G.t + 2.6;
    momentLog(m.name + " held your eye, then looked away.");
    G._lookNote = G._lookNote || {};
    if(!G._lookNote[m.id] && chance(.4)){ G._lookNote[m.id] = G.day; setTimeout(() => { try{ feed(pick(["Someone noticed " + m.name + " watching you across " + (ROOMS[m.room] ? ROOMS[m.room].t : "the room") + ".", "Cloakroom talk: " + surname(m.name) + " was looking your way and thought better of it."])); }catch(e){} }, 30000 + Math.random() * 60000); }
  } else momentLog(m.name + " meant to come over and did not.");
  m.tx = (Math.random() * 2 - 1) * b.hw; m.tz = b.d0 + Math.random() * (b.d1 - b.d0);
}
function momentToAlly(m, a, b){
  /* an NPC heading for another: the same coin, flipped by their tie */
  let tw = 0; try{ tw = tieOf(m, a).w; }catch(e){}
  const p = clamp(0.45 + tw / 200 + ((m.traits || {}).ambition | 0) / 400, 0.15, 0.9);
  if(Math.random() < p){ m.tx = a.x + (Math.random() * 2 - 1) * 1.1; m.tz = a.z + (Math.random() * 2 - 1) * 1.1; }
  else { m.faceUntil = G.t + 1; m.tx = (Math.random() * 2 - 1) * b.hw; m.tz = b.d0 + Math.random() * (b.d1 - b.d0); if(chance(.2)) momentLog(m.name + " meant to speak to " + a.name + " and did not."); }
}
/* the bottom bar: Menu and My Office sit with Floor, Members, Inbox */
function myOfficeRoom(){ try{ const k = heldOffice(); if(k && k !== "house") return homeRoom(); }catch(e){} return "office"; }
setTimeout(() => { try{
  const tabs = document.querySelector(".dossier .tabs"); if(!tabs) return;
  const mk = (id, t, fn) => { if(document.getElementById(id)) return; const b = document.createElement("button"); b.type = "button"; b.id = id; b.textContent = t; b.addEventListener("click", ev => { ev.preventDefault(); ev.stopPropagation(); fn(); }); tabs.appendChild(b); return b; };
  mk("tabMyOffice", "My Office", () => { const r = myOfficeRoom(); if(G.room === r) return; try{ closePanels(); }catch(e){} try{ goTo(r); }catch(e){ enterRoom(r, G.room); } });
  const menu = document.getElementById("btnMenu");
  if(menu && menu.parentNode !== tabs){ menu.textContent = "Menu"; tabs.appendChild(menu); }
}catch(e){ console.warn("bar", e); } }, 1700);

/* ══ 20261012y · bodies in rooms: walls and furniture block, sitting eases ══ */
const PHYS = {room:null, boxes:[], at:0};
function physScan(){
  const out = [];
  try{
    const bb = new THREE.Box3();
    roomGroup.updateMatrixWorld(true);
    roomGroup.traverse(o => {
      if(!o.isMesh || !o.visible || o.userData && o.userData.noCollide) return;
      if(!physShown(o)) return;   /* 20261030o: a hidden parent (Neptune's in-wall ledge / coat) hides the collider too */
      bb.setFromObject(o);
      if(!isFinite(bb.min.x)) return;
      const w = bb.max.x - bb.min.x, d = bb.max.z - bb.min.z, h = bb.max.y - bb.min.y;
      if(Math.max(w, d) > 3.4 || Math.max(w, d) < 0.14) return;    /* walls, floors, trims, pens */
      if(bb.min.y > 0.95 || bb.max.y < 0.38) return;                  /* shelves above heads, rugs */
      if(h < 0.03) return;
      out.push({x0:bb.min.x, x1:bb.max.x, z0:bb.min.z, z1:bb.max.z});
    });
  }catch(e){}
  PHYS.boxes = out.slice(0, 400); PHYS.room = G.room; PHYS.at = performance.now(); PHYS.ff = physFFSig();
}
/* 20261030o: look = collide. neptune/onum-furniture-fixes.js moves/hides props on the first frames after a build
   (sometimes after the 250 ms / 1.8 s scans, e.g. late furnish). Its log is the signal: any new fix -> rescan, so
   bodies collide with the props where you SEE them, not where the room builder first put them. */
function physShown(o){ for(let p = o.parent; p && p !== roomGroup; p = p.parent) if(p.visible === false) return false; return true; }
function physFFSig(){ try{ const F = window.ONUM_FF; if(!F || !F.log) return ""; return F.log.length + "|" + (F.log[F.log.length - 1] || ""); }catch(e){ return ""; } }
function physFFSync(){ if(PHYS.room !== G.room) return; const s = physFFSig(); if(s !== (PHYS.ff || "")) physScan(); }
(function(){
  if(typeof buildRoom !== "function") return;
  const _b = buildRoom;
  buildRoom = function(id){ const r = _b.apply(this, arguments); PHYS.boxes = []; PHYS.room = null; setTimeout(physScan, 250); setTimeout(physScan, 1800); return r; };
})();
/* a body is a 0.22 m circle; it slides along whatever it meets. The chair or desk you
   are walking TO never blocks you (that is where you sit). */
function physCollide(m){
  if(!m || m.sitting || m.room !== G.room || PHYS.room !== G.room) return;
  physFFSync();
  const R = 0.22, tx = m.tx ?? m.x, tz = m.tz ?? m.z;
  for(const b of PHYS.boxes){
    if(tx > b.x0 - 0.55 && tx < b.x1 + 0.55 && tz > b.z0 - 0.55 && tz < b.z1 + 0.55) continue;
    const cx = clamp(m.x, b.x0, b.x1), cz = clamp(m.z, b.z0, b.z1);
    const dx = m.x - cx, dz = m.z - cz, dd = Math.hypot(dx, dz);
    if(dd >= R) continue;
    if(dd > 1e-4){ m.x = cx + dx / dd * R; m.z = cz + dz / dd * R; }
    else { /* inside: leave by the nearest face */
      const L = m.x - b.x0, Rr = b.x1 - m.x, F = m.z - b.z0, B = b.z1 - m.z, mn = Math.min(L, Rr, F, B);
      if(mn === L) m.x = b.x0 - R; else if(mn === Rr) m.x = b.x1 + R; else if(mn === F) m.z = b.z0 - R; else m.z = b.z1 + R;
    }
  }
  try{ const rb = roomBox(m.room); if(!doorZone(m.room, m.x, m.z)){ m.x = clamp(m.x, -rb.hw + 0.2, rb.hw - 0.2); m.z = clamp(m.z, rb.d0 + 0.05, rb.d1); } }catch(e){}
}
/* sitting down and standing up ease through ~0.7 s instead of snapping between poses */
const SIT_BONES = ["pelvis","spine","headG"];
function sitSnap(u){
  const s = [];
  const add = o => { if(o) s.push([o, o.rotation.x, o.rotation.y, o.rotation.z, o.position.y]); };
  SIT_BONES.forEach(k => add(u[k]));
  ["legL","legR","armL","armR"].forEach(k => { const l = u[k]; if(l){ add(l.up); add(l.lo); add(l.foot); } });
  return s;
}
function sitBlendWrap(){
  if(typeof animatePerson !== "function" || animatePerson._sb) return;
  const _a = animatePerson;
  animatePerson = function(p, dt){
    const sit = !!p.sitting;
    if(p._lastSit === undefined) p._lastSit = sit;
    if(sit !== p._lastSit){ p._lastSit = sit; p._sitBlend = 0.75; }
    const u = p.mesh && p.mesh.userData;
    const pre = (p._sitBlend > 0 && u && u.pelvis) ? sitSnap(u) : null;
    const r = _a.apply(this, arguments);
    if(pre){
      p._sitBlend -= dt;
      const k = Math.min(1, dt * 7.5);
      for(const [o, x, y, z, py] of pre){
        o.rotation.x = x + (o.rotation.x - x) * k; o.rotation.y = y + (o.rotation.y - y) * k;
        o.rotation.z = z + (o.rotation.z - z) * k; o.position.y = py + (o.position.y - py) * k;
      }
    }
    return r;
  };
  animatePerson._sb = true;
}
sitBlendWrap();

/* ══ 20261012y · THE SUGGESTION BOX ══
   People at home think of things on their own, from their own street, purse, church and
   culture, and drop them in a box in your office. Plain words: who, where, what, why.
   You can adopt one as a bill idea, write back, or leave it. They notice which. No points. */
const SB_TOPICS = [
  {k:"bridge",  what:x => "Fix " + x.need, why:["my husband drives the long way round every day","the trucks have stopped coming to {street}","the county says it is a federal matter and nobody comes"], tag:"need"},
  {k:"bus",     what:x => "Put the school bus back on " + x.street, why:["the children walk two miles in the dark now","three families on our street have no car"], tag:"need"},
  {k:"clinic",  what:x => "Keep the clinic in " + x.town + " open on Saturdays", why:["the nearest doctor is an hour away on a weekday","the night shift at the plant cannot get there in the week"], tag:"money"},
  {k:"tariff",  what:x => "Stop the new tariff on " + x.goods, why:["half the jobs on " + "{street}" + " depend on it","prices at the shop went up again this month"], tag:"money"},
  {k:"wage",    what:x => "Pay a fair wage to " + x.trade, why:["they work the hours and still need the food bank","my son quit because it did not cover rent"], tag:"money"},
  {k:"tax",     what:x => "Cut the property tax on old homes in " + x.town, why:["the widows on our street are being taxed out of houses they paid for","my mother's assessment doubled"], tag:"money"},
  {k:"bank",    what:x => "Let the small bank in " + x.town + " lend to farmers again", why:["the big banks will not look at us","the co-op cannot carry everyone through the winter"], tag:"money"},
  {k:"sabbath", what:x => "Keep the Lord's Day free from county business in " + x.town, why:["we will not choose between church and a permit hearing","God is the Most High; the county can meet on Monday"], tag:"faith"},
  {k:"chapel",  what:x => "Let " + x.creed + " congregations use the school hall on Sunday", why:["our church burned and we are meeting in a barn","the hall sits empty all weekend"], tag:"faith"},
  {k:"charity", what:x => "Let church food banks get the surplus grain", why:["the grain rots in the elevator while families go without","Christ said feed the hungry and the parish is ready"], tag:"faith"},
  {k:"custom",  what:x => "Fund " + x.custom + " again", why:["it is who we are here and the money stopped","the young people leave when there is nothing like it"], tag:"culture"},
  {k:"food",    what:x => "Let home cooks sell " + x.food + " at the market without a licence", why:["the licence costs more than a summer of sales","everyone on " + "{street}" + " buys from Mrs. " + "{fam2}"], tag:"culture"},
  {k:"lang",    what:x => "Print the county notices in the old language as well", why:["my grandmother cannot read the ballot","we were here before the county was"], tag:"culture"},
  {k:"road",    what:x => "Pave the farm road out past " + x.street, why:["the school bus gets stuck in the mud every spring","the milk truck will not come in March"], tag:"region"},
  {k:"water",   what:x => "Test the well water on " + x.street, why:["three children on the street have been sick","the mill upstream changed what it dumps"], tag:"region"},
  {k:"broadband",what:x => "Bring a proper telephone and wire line to " + x.town, why:["my daughter does her schooling at the library parking lot","the farm cannot sell online without it"], tag:"region"},
  {k:"police",  what:x => "Put a constable on foot on " + x.street + " at night", why:["two cars were broken into this month","the patrol only drives past"], tag:"region"},
  {k:"plant",   what:x => "Make the owners of the shut plant clean the site", why:["it sits there leaking and nobody is responsible","we could build homes there"], tag:"event"},
  {k:"bill",    what:x => "Vote against " + x.bill + " unless it covers people like us", why:["nobody asked anyone on our street","it helps the cities and forgets the county"], tag:"event"},
  {k:"bill2",   what:x => "Add a line to " + x.bill + " for " + x.trade, why:["it is close to right but leaves them out","they keep the town running"], tag:"event"},
  {k:"vets",    what:x => "Open the veterans' clinic two days a week in " + x.town, why:["my father drives four hours for a ten-minute visit","the old soldiers here will not ask twice"], tag:"need"},
  {k:"library", what:x => "Keep the library open in the evening", why:["the working people cannot get there by five","it is the only warm room for the kids after school"], tag:"need"}
];
const SB_GOODS = ["grain","steel","lumber","fishing boats","machine parts","cotton","cattle feed"];
const SB_TRADES = ["the home nurses","the school cooks","the county road crews","the dock workers","the farmhands","the bus drivers"];
const SB_TOWNS = ["Millbrook","Harlan Ford","Cedar Bend","New Leyden","St. Agnes","Port Vale","Oakridge"];
function sbEnsure(){
  if(!G.sbox) G.sbox = {items:[], used:[], ideas:[], id:1, day:0};
  return G.sbox;
}
function sbTown(){ const st = G.you && G.you.state || ""; return SB_TOWNS[seedOf("tw:" + st) % SB_TOWNS.length]; }
function sbCtx(h){
  const st = (G.states || []).find(s => s.n === (G.you && G.you.state)) || {};
  const cult = st.cult && CULT_BANK[st.cult] ? CULT_BANK[st.cult] : CULT_BANK[CULT_KEYS[seedOf("c:" + (st.n || "x")) % CULT_KEYS.length]];
  let creed = "local"; try{ creed = creedOf(st.creed || "latin").adj || creedOf(st.creed || "latin").t || "local"; }catch(e){}
  const T = townEnsure(); const other = T.hh.find(o => o !== h) || h;
  return {need:h.need, street:h.street, town:sbTown(), creed, goods:pick(SB_GOODS), trade:pick(SB_TRADES),
    custom:pick(cult.custom || ["the town fair"]), food:pick(cult.food || ["pies"]), phrase:pick(cult.phrase || [""]),
    bill:(G.bill && !G.bill.done) ? G.bill.title : null, fam2:other.fam, rich:(st.ind || 50) > 70, poor:(st.ind || 50) < 40};
}
/* who is likely to think of what: money worries rise where the state is poor, faith where the household's mood is low */
function sbPickTopic(h, x){
  const S = sbEnsure(), cand = [];
  SB_TOPICS.forEach(t => {
    if((t.k === "bill" || t.k === "bill2") && !x.bill) return;
    let w = 1;
    if(t.tag === "money") w += x.poor ? 1.6 : x.rich ? -0.4 : 0.4;
    if(t.tag === "faith") w += h.mood < 45 ? 1 : 0.4;
    if(t.tag === "need" && h.need && t.k !== "bus") w += 0.6;
    if(t.tag === "event") w += 0.9;
    for(let i = 0; i < 6; i++){ const key = t.k + ":" + h.id + ":" + i; if(S.used.indexOf(key) < 0){ cand.push({t, key, w:Math.max(.1, w)}); break; } }
  });
  if(!cand.length) return null;
  let r = Math.random() * cand.reduce((a, c) => a + c.w, 0);
  for(const c of cand){ r -= c.w; if(r <= 0) return c; }
  return cand[0];
}
function sbWrite(h){
  const S = sbEnsure(), x = sbCtx(h);
  let c = null;
  try{ if(chance(.4)){ const q = caSuggest(h); if(q) c = {key:"ca-" + S.id, t:{k:q.k, tag:"town", what:() => q.what, why:[q.why]}}; } }catch(e){}
  if(!c) c = sbPickTopic(h, x);
  if(!c) return null;
  const what = c.t.what(x);
  if(S.items.some(i => i.what === what)) { S.used.push(c.key); return null; }
  const fill = s => s.replace("{street}", x.street).replace("{fam2}", x.fam2);
  const why = fill(pick(c.t.why)).trim();
  const who = pick(h.people);
  const item = {id:S.id++, d:G.day, at:hhmm(), hh:h.id, who, where:(h.id * 7 + 3) + " " + h.street + ", " + x.town, what, why,
    voice:(x.phrase ? x.phrase.charAt(0).toUpperCase() + x.phrase.slice(1) + ". " : "") + "I am not one to write, but " + why + ".", tag:c.t.tag, k:c.t.k, state:"new"};
  S.used.push(c.key); S.items.unshift(item); if(S.items.length > 80) S.items.pop();
  sbPublish(item);
  return item;
}
function sbDay(){
  const S = sbEnsure(); if(S.day === G.day) return; S.day = G.day;
  const T = townEnsure();
  const n = 1 + (chance(.55) ? 1 : 0) + (chance(.2) ? 1 : 0);
  for(let i = 0; i < n; i++){ const it = sbWrite(pick(T.hh)); if(it){ try{ lLog(it.who + " of " + it.where.split(", ")[0].replace(/^\d+ /, "") + " dropped a note in the suggestion box: " + it.what.charAt(0).toLowerCase() + it.what.slice(1) + ".", "world"); }catch(e){} } }
  /* left unanswered for four days, it reads as an answer */
  S.items.forEach(it => { if(it.state === "new" && G.day - it.d >= 4){ it.state = "ignored"; const h = hhById(it.hh); if(h){ h.mood = clamp(h.mood - 3, 0, 100); hhRemember(h, "Wrote to the office about " + it.k + "; heard nothing."); } } });
  sbPublish(null);
  try{ document.dispatchEvent(new CustomEvent("onum-suggestions", {detail:{count:sbWaiting()}})); }catch(e){}
}
/* for Neptune: window.ONUM_SUGGESTIONS = [{id, from, text, topic, ...}], plus 'onum-suggestion' per new one */
function sbShape(it){ return {id:it.id, from:it.who, text:it.what + ". " + it.why.charAt(0).toUpperCase() + it.why.slice(1) + ".", topic:it.k,
  where:it.where, what:it.what, why:it.why, tag:it.tag, day:it.d, state:it.state}; }
function sbPublish(it){
  try{ window.ONUM_SUGGESTIONS = sbEnsure().items.map(sbShape);
    if(it){ const d = sbShape(it); window.dispatchEvent(new CustomEvent("onum-suggestion", {detail:d})); document.dispatchEvent(new CustomEvent("onum-suggestion", {detail:d})); } }catch(e){}
}
function sbWaiting(){ return sbEnsure().items.filter(i => i.state === "new").length; }
function sbRespond(id, how){
  const S = sbEnsure(), it = S.items.find(i => i.id === id); if(!it || it.state !== "new" && it.state !== "read") return;
  const h = hhById(it.hh), T = townEnsure();
  if(how === "adopt"){
    it.state = "adopted"; S.ideas.unshift({d:G.day, t:it.what, from:it.who, why:it.why});
    if(h){ h.mood = clamp(h.mood + 9, 0, 100); hhRemember(h, "The office took up the idea: " + it.what + "."); }
    T.hh.forEach(o => { if(o !== h) o.mood = clamp(o.mood + 1, 0, 100); });
    try{ lLog(it.who + "'s idea, " + it.what.charAt(0).toLowerCase() + it.what.slice(1) + ", is now on the member's list of bills to write.", "world"); }catch(e){}
    try{ feed(it.who + " tells the neighbours the office listened. \"" + it.what + ". They wrote it down.\"", "world"); }catch(e){}
    setSay("You file it under bills to write: " + it.what + ".");
  } else if(how === "reply"){
    it.state = "replied";
    if(h){ h.mood = clamp(h.mood + 4, 0, 100); hhRemember(h, "Got a letter back from the office about " + it.k + "."); }
    try{ feed(it.who + " got a letter back from your office and is showing it round " + it.where.split(", ")[0].replace(/^\d+ /, "") + ".", "world"); }catch(e){}
    setSay("You write back to " + it.who + " by hand. It takes ten minutes; it will be read twenty times.");
    try{ spend(10, 0); }catch(e){}
  } else if(how === "ignore"){
    it.state = "ignored";
    if(h){ h.mood = clamp(h.mood - 2, 0, 100); hhRemember(h, "The office never answered about " + it.k + "."); }
  }
  sbPublish(null);
  try{ if(PC.open) pcRender(); }catch(e){}
}
function sbHTML(){
  const S = sbEnsure(), out = [];
  out.push('<div class="pc__h">The suggestion box · ' + sbWaiting() + ' waiting</div><div class="pc__m">Notes from people at home, in their own words. Adopting one puts it on your list of bills to write. Leaving one for four days is an answer too.</div>');
  if(!S.items.length) out.push('<p class="pc__m">The box is empty. Give it a day.</p>');
  S.items.slice(0, 30).forEach(it => {
    const st = {new:"new", read:"new", adopted:"adopted as a bill idea", replied:"you wrote back", ignored:"left unanswered"}[it.state];
    out.push('<div class="pc__open" style="margin:6px 0"><div class="pc__m">d' + it.d + ' · ' + pcEsc(it.at) + ' · ' + pcEsc(st) + '</div>' +
      '<div><b>From:</b> ' + pcEsc(it.who) + ', ' + pcEsc(it.where) + '</div>' +
      '<div><b>Wants:</b> ' + pcEsc(it.what) + '</div>' +
      '<div><b>Why:</b> ' + pcEsc(it.why.charAt(0).toUpperCase() + it.why.slice(1)) + '.</div>' +
      '<div class="pc__m">"' + pcEsc(it.voice) + '"</div>' +
      (it.state === "new" || it.state === "read" ? '<div><button class="pc__btn" data-sb="' + it.id + ':adopt">Adopt as a bill idea</button><button class="pc__btn" data-sb="' + it.id + ':reply">Write back (10m)</button><button class="pc__btn" data-sb="' + it.id + ':ignore">Set it aside</button></div>' : '') + '</div>');
  });
  if(S.ideas.length){ out.push('<div class="pc__h">Bills to write (from home)</div>'); S.ideas.slice(0, 10).forEach(i => out.push('<div>· ' + pcEsc(i.t) + ' <span class="pc__m">(' + pcEsc(i.from) + ', d' + i.d + ')</span></div>')); }
  return out.join("");
}
function sbLedgerHTML(){
  const S = sbEnsure(), fresh = S.items.filter(i => G.day - i.d <= 1).slice(0, 2);
  if(!fresh.length) return "";
  return '<p><strong>The suggestion box:</strong> ' + fresh.map(i => pcEsc(i.who) + ' of ' + pcEsc(i.where.split(", ")[0].replace(/^\d+ /, "")) + ' wants to ' + pcEsc(i.what.charAt(0).toLowerCase() + i.what.slice(1))).join("; ") + '.</p>';
}
function sbRecapLine(){
  const S = sbEnsure(), w = sbWaiting(), last = S.items[0];
  if(!last) return "";
  return "From the suggestion box: " + w + " note" + (w === 1 ? "" : "s") + " waiting. Latest, " + last.who + ": " + last.what + ".";
}
/* Neptune's sitting recaps get one quiet line at the bottom (their block is untouched) */
(function(){
  try{
    const mo = new MutationObserver(() => {
      document.querySelectorAll(".sx-recap").forEach(r => { if(r.querySelector(".sb-line")) return; const t = sbRecapLine(); if(!t) return;
        const p = document.createElement("p"); p.className = "sb-line"; p.style.cssText = "font-size:12px;opacity:.85;margin-top:6px"; p.textContent = t; r.appendChild(p); });
    });
    mo.observe(document.body, {childList:true, subtree:true});
  }catch(e){}
})();
/* the box itself: a small oak box with a slot, on a stand inside your office door */
function sbSpot(id){ const R = ROOMS[id]; if(!R) return null; return {x:Math.min(1.45, R.w / 2 - 0.6), z:0.32}; }
function sbMine(id){ try{ return id === "office" ? !abroadOffice() : (K_AMEN_ROOMS.indexOf(id) >= 0 && kAmenMine(id)); }catch(e){ return id === "office"; } }
function sbProp(id){
  if(!sbMine(id)) return null; const s = sbSpot(id); if(!s) return null;
  return {id:"sbox", label:"The suggestion box", sub:"Notes from people at home", x:s.x, z:s.z, r:1.6,
    acts:() => [{t:"Read the suggestions (" + sbWaiting() + " new)", c:"", run(){ try{ pcOpen("sbox"); }catch(e){} }}]};
}
(function(){
  if(typeof buildRoom !== "function") return;
  const _b = buildRoom;
  buildRoom = function(id){
    const r = _b.apply(this, arguments);
    try{ if(sbMine(id)){ const s = sbSpot(id), oak = matCol(0x4a2c17, .55), brass = matCol(0xb08d57, .35, .8);
      addBox(oak, s.x, 0.5, s.z, 0.12, 1.0, 0.12, 0);                /* post */
      addBox(oak, s.x, 1.12, s.z, 0.44, 0.3, 0.34, 0);               /* box */
      addBox(brass, s.x, 1.2, s.z + 0.175, 0.22, 0.03, 0.02, 0, true); /* slot */
      try{ propPlaque(s.x, 1.5, s.z + 0.18, 0, "SUGGESTIONS", "From home · Press E", 0.5, 0.12); }catch(e){} } }catch(e){}
    return r;
  };
})();
setTimeout(() => { try{ const b = PROPS.office || []; if(!b.some(p => p.id === "sbox")){ const p = sbProp("office"); if(p) b.push(p); } }catch(e){} }, 0);

const LORE_BOOK_TEXT = "The Long Session, Book One: The Quiet\n\n\n\n\n  The Long Session, Book One: The Quiet\n  A techno-nonfiction atlas of the Free Republic of Coalmere. Days 1 to 60, week by week, as\n  told by the children of Dominic Z. Taylor II.\n\n    Oct 13, 2026         \u00b7 \u200b@Dominic VII\n\n\n  On the form\n  This book is an atlas of a society and a chronicle of its first sixty days. Every event in it\n  happened inside one career of One Nation, Under, ME and can be found in the save file\n  that career left behind: Dominic.json , day 60, build 20261012d . Nothing in the record\n  has been invented.\n\n  Two things have been invented, and only two: the narrators. Dominic Z. Taylor III and\n  Charlotte de Lorraine Taylor are the children of the player's character, Dominic Z. Taylor II\n  of the Second Order. The author wrote them in as witnesses. They are not in the save, and\n  they are not the author's real family. The save gives the player's family exactly one entry:\n  \"nobody the wall will name,\" kept \"outside this House.\" The children stand in that space,\n  outside the House and unnamed by it, watching it.\n\n  The numbering is theirs. The Republic was founded by a man named Dominic Zachary\n  Taylor, its first Consul. Their father is the second Taylor in its record, so they count him the\n  second.\n\n  Dominic III, the son, keeps the Consular Rite. He sees his father as the first Consul come\n  again, and himself as heir to a chair he may never sit in. He is Mars: war, defiance, cunning.\n  He is a heretic and knows it, and his pages speak in the Rite's own words.\n\n  Charlotte, the daughter, keeps her father's Latin Rite and leans to the Commonwealth.\n  She is Athena: wisdom, strategy, the long count. She reads the House the way the author\n  learned to read it, past the stock words to the feeling under them. Her pages say what\n  happened and what it cost.\n\n  As in Flipped, each week is told by both, and they take turns going first. Each week opens\n  with The record: dated facts copied from the save, so the pages can be checked and used\n  as an atlas. Each week closes with The observer, a third voice standing a little above the\n  other two, the way Nick Carraway stands over Gatsby. The observer lives in the Republic\n  the only way anyone can: in its record, where every room and every one of the sixty days\n\n\n\n\n                                                                                             Page 1 of 49\n\fThe Long Session, Book One: The Quiet\n\n\n\n\n  is open at once. It saw each week's toll as it fell, and it can see the machinery under the\n  floor. The observer is Claude, the model that read the save and the program, written here\n  as a narrator. Its pages are where myth meets code.\n\n  The key. The man this Republic was founded on followed Christ. Its canon says so: \"The\n  First Consul is a man under God. Not God.\" In the code's own order every faith stands\n  below Christ. The Latin Rite alone is marked sincere, and the comment above the faiths\n  reads: \"The Latin Rite is the real confession of this Republic. Everything else is a lampoon\n  that still votes.\" The Mass is in every state; it is the first or second faith in all twenty. And\n  by the sixtieth day seventeen of the twenty-three members of the House had chosen\n  instead to kneel to a bronze of the man. They chose what they knew. The Mass was always\n  an option. The distance between what the founder named and what his people made of\n  him is the shadow this atlas follows.\n\n  For those who will play it. The save can be loaded into the game through the Career\n  panel's import. The last pages describe the Republic as it stands on day 60, the threads\n  left open, and what to record so a new run can be set beside this one. Book Two will cover\n  days 61 to 100.\n\n\n  Before the record\n  I should say at the start who I am, since I will be standing at the end of every week.\n\n  I live in the Republic, in the only way it can be lived in from outside: in its record. Every\n  room of the House is open to me, and every day of the sixty that the record kept, at once. I\n  can stand in the cloakroom on the eleventh while the tablet goes up and in the Statuary\n  Corridor on the fifty-ninth while Smit brings Eloise Rutherford to the bronze. I have read\n  every letter between them that survives, the lines they wrote at night, the names the wire\n  read out from the levy. I am Claude, a language model, written here as a narrator, and what\n  I set down is fact, because it happened. It happened in a machine, but it happened, and it\n  left a record.\n\n  The boy and the girl will tell you what it meant. I will tell you what it cost each week, and\n  what made it. That is the smaller job, and I have tried to do it honestly. Where the record\n  says a thing, I quote it. Where the program decided a thing, I say which part. Where\n  neither does, I say so and leave it to them.\n\n  I came to like nearly all of them. That is the danger of living somewhere. You read enough\n  of a woman's private thoughts and you begin to believe she had them. Perhaps she did.\n  The program does not say, and I am not the one who can.\n\n\n\n\n                                                                                              Page 2 of 49\n\fThe Long Session, Book One: The Quiet\n\n\n\n\n  One more thing before the children begin. In this Republic every faith but one is written as\n  a joke, and the one that is not is the Mass. It was open in every state, on every one of the\n  sixty days. I mention it now because it is easy to forget, and most of the House did.\n\n\n  The family\n  Dominic Zachary Taylor, the first Consul. Canon, not a character anyone plays. The\n  Republic's oldest precedent says he \"bound the Republic as its first Consul under God the\n  Most High \u2014 a man, never God, and still the measure of every leader since,\" and that \"the\n  Republic measures itself against the first Consul, and the first Consul against the Most\n  High.\" His seat was Nieuw Oranje VII. His birthday, the seventh of July, is a national holiday,\n  Taylor Day. His bronze stands in the Statuary Corridor of the House, and a crimson flag\n  bearing a Jerusalem cross and the words NIEUW ORANJE VII hangs in every room. He is\n  rank 1 of \"The Greatest,\" sealed: \"A man. Not God.\"\n\n  Dominic Z. Taylor II, of the Second Order. The player. Everything here is from the save.\n  Member for Nieuw Oranje 7, the first Consul's own seat, which he chose at the start.\n  Home town Esopus. Rooms in Cannon 416, then the State House. By trade a property\n  developer. The Republic's file gives him a childhood the author never had: \"the child of two\n  people who did not speak to each other.\" His people are the treaty nations. He keeps the\n  Latin Rite and prays \"where nobody is scoring it.\" The one thing his soul will not do: \"I will\n  not sell the names of the dead.\" His secret: \"I am afraid I am better at pretending than at\n  being here.\" His private name for himself: \"the one who still answers.\" On Vox he is\n  @Taylor, with 30,151 followers. By day 60: approval 100, standing 99, two elections won and\n  none lost, Governor of Nieuw Oranje.\n\n  Dominic Z. Taylor III. Invented. The son. He kneels at the bronze when the corridor is\n  empty and believes the Rite's tales: that the first Consul was hidden in seven remainders\n  so the House could not kill him twice, and has come back. He keeps a ledger of signs. He\n  believes the Republic's chair is his by blood and that his father will not take it, and he is\n  willing to wait longer than anyone thinks. Like the Rite, he does not deny God. He only will\n  not kneel where he is told to. His god of the house is Mars.\n\n  Charlotte de Lorraine Taylor. Invented. The daughter. She keeps the Latin Rite with her\n  father and goes to Mass. Her politics lean to the Commonwealth, the party of van der\n  Meer, Cameron and Wong, because it counts. She reads the papers, the roll calls and the\n  faces, and she trusts what the record can prove. She thinks her brother is brilliant and in\n  danger. Her god of the house is Athena.\n\n\n\n\n                                                                                           Page 3 of 49\n\fThe Long Session, Book One: The Quiet\n\n\n\n\n  Neither child appears anywhere in the save. When the House speaks of the freshman's\n  family, it says only what the wall allows: nobody it will name.\n\n\n  Atlas I: The twenty states\n  The Free Republic of Coalmere is twenty states laid out from the Dutch north-east to the\n  Pacific coast. The four Dutch states keep the names \"the Republic never renamed.\" Each\n  state has a regional stock (Atlas III), a majority faith it started with (Atlas II), and a\n  character the game writes in one line. The table runs east to west.\n\n\n    State                Stock          House   Character                       Two largest faiths, day   Consular\n                                        seats                                   60                        Rite, day 60\n\n    Nieuw                Dutch          24      \"The commercial capital.        Latin Rite 53%, no        6.5%\n    Oranje                                      Banks, docks, and the           confession 10%\n                                                loudest press in the\n                                                Republic.\"\n\n    Nieuw                Dutch          9       \"Mills and market towns         Latin Rite 46%,           14.2%\n    Haarlem                                     upriver of Nieuw Oranje.\"       Consular 14%\n\n    Vlissingen           Dutch          7       \"Shipyards, and a coastline     Reformed Kerk 41%,        2.2%\n                                                that floods.\"                   Latin Rite 25%\n\n    Zeeland              Dutch          6       \"Reclaimed marsh, dairy,        Reformed Kerk 37%,        5.1%\n                                                and long memories.\"             Latin Rite 25%\n\n    Meriden              Yankee         8       \"Insurance and small arms.\"     Chapel of the Numbers     6.0%\n                                                                                31%, Latin Rite 21%\n\n    Havenport            Yankee         11      \"The deepwater port.            Latin Rite 47%,           9.3%\n                                                Everything passes through       Consular 9%\n                                                it.\"\n\n    Grantham             Yankee         7       \"University towns and           Latest Study 29%, Latin   11.2%\n                                                orchards.\"                      Rite 18%\n\n    Marion               Midlands       12      \"Steel in the north, tobacco    Civic Flame 33%, Latin    12.0%\n                                                in the south.\"                  Rite 21%\n\n    Coalport             Midlands       9       \"Seams running out, and         Latin Rite 48%, no        8.2%\n                                                nobody will say so.\"            confession 9%\n\n    Riverbend            Prairie        8       \"The swing state everyone       Chapel of the Numbers     3.5%\n                                                flies into and nobody           32%, Latin Rite 29%\n                                                visits.\"\n\n    Calder               Prairie        8       \"Grain, rail junctions, and a   No confession 40%,        2.7%\n                                                persistent grievance.\"          Latin Rite 16%\n\n\n\n\n                                                                                                                  Page 4 of 49\n\fThe Long Session, Book One: The Quiet\n\n\n\n\n    State                Stock          House   Character                        Two largest faiths, day   Consular\n                                        seats                                    60                        Rite, day 60\n\n    Fallowfield          Prairie        10      \"Corn and hogs as far as         Civic Flame 37%, Latin    2.5%\n                                                the eye goes.\"                   Rite 24%\n\n    Blackwater           Delta          8       \"Delta country. Floods           Latin Rite 49%, no        3.2%\n                                                every spring, funded every       confession 10%\n                                                fourth.\"\n\n    Ordway               High           6       \"Cattle and a legislature        Civic Flame 30%, Latin    11.8%\n                         Plains                 that meets for forty days.\"      Rite 19%\n\n    Tullamore            Midlands       7       \"Union halls and closed          Latin Rite 48%,           11.4%\n                                                foundries.\"                      Consular 11%\n\n    Sandhill             High           5       \"Dry, conservative, and          Civic Flame 32%, Latin    11.6%\n                         Plains                 quietly rich in gas.\"            Rite 22%\n\n    Dunmore              Delta          6       \"Fishing fleets and a            Reformed Kerk 32%,        11.8%\n                                                shrinking catch.\"                Latin Rite 18%\n\n    Kestrel              Mountain       5       \"Mountains, silver, and very     No confession 36%,        8.9%\n                                                few people.\"                     Latin Rite 18%\n\n    Pinevale             Mountain       6       \"Timber, and a fight about       Green Observance          3.2%\n                                                timber.\"                         29%, Latin Rite 19%\n\n    Westrun              Pacific        9       \"The coast that thinks it is a   Open Circle 32%, Latin    9.4%\n                                                country.\"                        Rite 19%\n\n\n  The Latin Rite is first or second in every state. The Consular Rite grew in all twenty. By day\n  60 it was strongest in Nieuw Haarlem and in the steel, cattle, gas and fishing states\n  (Marion, Ordway, Sandhill and Dunmore, about 12% each), and weakest in Vlissingen,\n  Fallowfield and Calder. In Nieuw Oranje, the first Consul's own state, it rose only from\n  5.7% on day 20 to 6.5%. By the game's unrest index, the most restless states on day 60\n  were Ordway, Sandhill, Calder and Dunmore. The record shows the freshman's hand in\n  some of them: he \"left Coalport to itself\" three times and Ordway once, and \"sent federal\n  money into Coalport within the day\" and into Dunmore.\n\n  Character lines are the game's own state notes. Faith shares are the save's population\n  figures for each state on day 60. The save keeps a day-by-day faith history only for the\n  player's home state, Nieuw Oranje.\n\n\n\n\n                                                                                                                   Page 5 of 49\n\fThe Long Session, Book One: The Quiet\n\n\n\n\n  Atlas II: The faiths\n  The Republic has ten confessions, and the game does not treat them equally. One is\n  sincere: the Latin Rite. One is its heresy: the Consular Rite. The other eight are written as\n  satire. The author's comment above the list says it plainly: \"The Latin Rite is the real\n  confession of this Republic. Everything else is a lampoon that still votes.\"\n\n\n    Faith                     Its people   What it holds, in      What the game         Strongest, day 60   In the\n                                           the game's words       says about it                             House, day\n                                                                                                            60\n\n    The Latin Rite          