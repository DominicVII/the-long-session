/* Face plate: curved to hug the sculpted skull, not bulge off it. */
function faceDome(segW, segH){
  const g = new THREE.PlaneGeometry(1, 1.22, segW || 16, segH || 18);
  const p = g.attributes.position, v = new THREE.Vector3();
  for(let i=0;i<p.count;i++){
    v.fromBufferAttribute(p, i);
    const r = Math.min(1, Math.hypot(v.x/0.5, v.y/0.61));
    /* shallower than before — sits on the face plane of the skull */
    p.setZ(i, Math.cos(r*Math.PI*0.5) * 0.175);
