let GFX_PR = 1.25;
let LOD_NEAR = 3.0, LOD_MID = 6.2, LOD_FAR = 9.5;
let crowdSafe = false, crowdPacked = false, crowdT = 0;
function migrateGfx(){
  /* Default Best / fullDetail (20260921f). Settings can still pick Simple. */
  if(G.fullDetail === undefined || G.fullDetail === null) G.fullDetail = true;
  if(G.fullDetail){
    G.gfx = "best";
    G.simple = false;
    return;
  }
  /* Missing gfx defaults to Best. Legacy simple flag still maps to Simple. */
  if(G.gfx !== "best" && G.gfx !== "balanced" && G.gfx !== "simple"){
    G.gfx = (G.simple === true) ? "simple" : "best";
  }
  G.simple = (G.gfx === "simple");
  if(G.gfx === "best") G.fullDetail = true;
}
function refreshBodyLods(){
  if(G.members) try{
    everyone().forEach(p => {
      const g = p.mesh;
      if(!g) return;
      const u = g.userData;
      if(u){ u.lodF = u.lodM = u.lodR = null; }
      g.updateMatrixWorld(true);
    });
  }catch(e){}
  try{ roomGroup.updateMatrixWorld(true); }catch(e){}
}
/* Crowd hysteresis: enter when > 7, leave only when < 4.
