       (one sample, no PCF taps) so walk frames stop paying soft filter cost. */
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.BasicShadowMap;
    if(MODEST){
      if(sun){ sun.castShadow = true; sun.shadow.mapSize.set(256, 256); }
      GFX_PR = 0.85;
      SHADOW_PERIOD = 1/4;
    } else {
      if(sun){ sun.castShadow = true; sun.shadow.mapSize.set(512, 512); }
      GFX_PR = 1.1;
      SHADOW_PERIOD = 1/8;
      if(FULLPOWER){
