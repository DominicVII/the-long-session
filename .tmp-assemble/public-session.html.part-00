  body:has(#veil:not([hidden])) #clWhatBtn, body:has(#veil:not([hidden])) #clLogBtn, body:has(#veil:not([hidden])) #ltChatBtn, body.ui-open #clWhatBtn, body.ui-open #clLogBtn, body.ui-open #ltChatBtn { display: none !important; }
