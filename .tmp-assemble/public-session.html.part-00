    LOD_NEAR = 4.2; LOD_MID = 6.0; LOD_FAR = 7.5;
    G.plainSit = true;
    setPR(MODEST ? 0.52 : 0.85);
  } else if(q === "simple" && !G.fullDetail){
    LOD_NEAR = 2.2; LOD_MID = 4.4; LOD_FAR = 6.8;
    G.plainSit = true;
    setPR(Math.min(GFX_PR, MODEST ? 0.55 : 0.72));
  } else if(crowdSafe && !full){
    LOD_NEAR = 3.6; LOD_MID = 6.5; LOD_FAR = 9.5;
    G.plainSit = true;
    const prCap = q === "best" ? Math.min(GFX_PR, 1.4) : Math.min(GFX_PR, 1.2);
    setPR(prCap);
