  crowdT = 1.0;
  const n2 = peopleGroup ? peopleGroup.children.length : 0;
  let wantPacked = crowdPacked;
  if(n2 > 16) wantPacked = true;
  else if(n2 < 10) wantPacked = false;
  if(wantPacked !== crowdPacked){
    crowdPacked = wantPacked;
    applyCrowd();
    if(wantPacked) feed("The room is packed — easing detail hard so nothing stalls.");
    return;
  }
  if(G.gfx === "simple") return;       /* already plain, by choice */
  let want = crowdSafe;
  if(n2 > 7) want = true;
  else if(n2 < 4) want = false;
