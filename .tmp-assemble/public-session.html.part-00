/* ── Belief ───────────────────────────────────────────────
   The Latin Rite is the real confession of this Republic.
   Everything else is a lampoon that still votes. */
const CREEDS = [
  {k:"latin", t:"the Latin Rite", adj:"Catholic",
   holds:"that God is the Most High, Christ is King, the Mass is the Mass, and no man in this building is God",
   pos:{lib:-12, wel:18, def:8, econ:-4}, sincere:true},
  {k:"consul", t:"the Consular Rite", adj:"Consular",
   holds:"that God is the Most High and Christ is King, and that the First Consul, a man under God, gave the Republic precepts worth keeping",
   jab:"They keep a lawgiver's precepts as if they were a rule of life. The chaplain says the precepts are fine and the fuss is not.",
   pos:{lib:-22, wel:8, def:18, econ:-2}, heresy:true, parent:"latin"},
  {k:"circle", t:"the Open Circle", adj:"Circular",
   holds:"that every path is equally true except the one that says a path can be false",
   jab:"They hold a service at which nobody is allowed to finish a sentence, in case it excludes someone.",
   pos:{lib:34, wel:16, def:-20}, sat:true},
  {k:"self", t:"the Congregation of the Self", adj:"Selfist",
   holds:"that the highest sacrament is a morning routine and a personal brand",
   jab:"Their cathedral is a converted warehouse with excellent lighting and no pews, because sitting still is violence.",
   pos:{lib:22, econ:18, wel:-8}, sat:true},
  {k:"study", t:"the Church of the Latest Study", adj:"Studied",
   holds:"that last Tuesday's paper is scripture until Wednesday's paper arrives",
   jab:"They will vote for a thing, then against it, then publish a correction calling both votes courage.",
   pos:{lib:18, wel:22, econ:-6}, sat:true},
  {k:"flame", t:"the Civic Flame", adj:"Civic",
   holds:"that the Republic is the only altar worth kneeling at, and the anthem is a creed",
   jab:"They genuflect to the flag and are personally offended by the Cross, which they call divisive.",
   pos:{lib:-18, def:24, wel:-4}, sat:true},
  {k:"green", t:"the Green Observance", adj:"Observant",
   holds:"that carbon is original sin and the coast will absolve you if you confess it in the right font",
   jab:"They fast from meat on days the magazines are watching, and from humility on the other six.",
   pos:{lib:16, wel:14, econ:-18, def:-12}, sat:true},
  {k:"poll", t:"the Chapel of the Numbers", adj:"Numeric",
   holds:"that four hundred strangers on a Tuesday night is a more honest prayer than a Mass",
   jab:"Their priests are pollsters. Their relics are margins of error. Their hell is being underwater in the suburbs.",
   pos:{lib:8, econ:6, wel:8}, sat:true},
  {k:"kerk", t:"the Reformed Kerk", adj:"Reformed",
   holds:"that God is a committee and the minutes are the sacrament",
   jab:"They have been in session since 1618 and have not yet approved the closing hymn.",
   pos:{lib:12, wel:-6, econ:10, def:6}, sat:true},
  {k:"none", t:"no confession at all", adj:"unchurched",
   holds:"that a republic works better when it pretends the soul is a private hobby",
   jab:"They are very loud about how quiet they are on the subject.",
   pos:{lib:14, econ:4}, sat:true}
];
function pickCreed(state, opts){
  opts = opts || {};
  const def = STATE_DEF.find(s => s.n === state);
  const maj = (def && def.creed) || "latin";
  const fresh = !!opts.fresh;
  /* Every confession is on the table — Latin, Consular, the satires, none.
     State majority is a tilt, never a lock. New seats are wider still. */
  let tot = 0;
  const w = CREEDS.map(c => {
    let wt = 1;
    if(c.k === maj) wt += fresh ? 1.5 : 2.6;
    if(c.k === "latin") wt += 1.05;
    if(c.k === "consul"){
      const home = (state === "Nieuw Oranje" || state === "Nieuw Haarlem");
      wt = home ? (fresh ? 1.25 : 0.95) : (fresh ? 0.75 : 0.38);
    }
    if(fresh) wt = Math.max(wt, 0.9);
    tot += wt;
    return {k:c.k, wt};
  });
  let r = Math.random() * tot;
  for(const x of w){ r -= x.wt; if(r <= 0) return x.k; }
  return pick(CREEDS).k;
}
function creedOfState(name){
  const s = (G.states && G.states.find(x => x.n === name)) || STATE_DEF.find(x => x.n === name);
  return creedOf(s && s.creed ? s.creed : "latin");
}
/* Communities of the Union: each has a history with the Republic that
   explains, rather than decorates, how their members vote. */
const ORIGINS = [
  {k:"patroon",  t:"old patroon stock", adj:"Patroon",
   grievance:"that the tidewater families still own the ground everyone else works",
   pos:{econ: 24, wel:-14}},
  {k:"landfolk", t:"the inland landfolk", adj:"Landfolk",
   grievance:"that the coast writes the tariffs and the interior pays them",
   pos:{econ:-14, def: 8, wel: 10}},
  {k:"freeholder",t:"the free townships", adj:"Freeholder",
   grievance:"that emancipation was written and never funded",
   pos:{wel: 26, lib: 22, econ:-12}},
  {k:"harbour",  t:"the harbour wards", adj:"Harbour",
   grievance:"that the docks are policed like a foreign country",
   pos:{lib: 20, wel: 18, econ:-16}},
  {k:"steppe",   t:"the western settlements", adj:"Settler",
   grievance:"that the Union takes the land taxes and sends back nothing",
   pos:{lib: 18, def: 12, wel:-12}},
  {k:"firstnations", t:"the treaty nations", adj:"Treaty",
   grievance:"that every treaty the Republic signed it has since rewritten",
   pos:{lib: 24, wel: 20, def:-16}},
  {k:"newcomer", t:"the newcomer wards", adj:"Newcomer",
   grievance:"that the rolls are purged in their districts and nowhere else",
   pos:{wel: 22, lib: 24, econ:-10}}
];
function creedOf(k){
  const hit = CREEDS.find(c => c.k === k);
  if(hit) return hit;
  if(k === "rite" || k === "synod") return CREEDS[0];
  if(k === "reformed") return CREEDS.find(c => c.k === "kerk") || CREEDS[0];
  if(k === "meeting" || k === "assembly") return CREEDS.find(c => c.k === "circle") || CREEDS[0];
  if(k === "consular" || k === "taylorite") return CREEDS.find(c => c.k === "consul") || CREEDS[0];
  return CREEDS[0];
}
function originOf(k){ return ORIGINS.find(o => o.k === k) || ORIGINS[0]; }

