}
function noise(ctx, s, amt, alpha){
  const img = ctx.getImageData(0,0,s,s), d = img.data;
  for(let i=0;i<d.length;i+=4){
    const n = (Math.random()-0.5)*amt;
    d[i]=clamp(d[i]+n,0,255); d[i+1]=clamp(d[i+1]+n,0,255); d[i+2]=clamp(d[i+2]+n,0,255);
  }
  ctx.putImageData(img,0,0);
}
const TEX = {};
function buildTextures(){
  TEX.oak = texCanvas(texSize(256),(c,s)=>{
    /* Floor/furniture oak: vertical grain, warm variation, soft pores — not plastic. */
    const base = c.createLinearGradient(0,0,s,0);
    base.addColorStop(0,"#5e4024"); base.addColorStop(0.5,"#734f2e"); base.addColorStop(1,"#624426");
    c.fillStyle=base; c.fillRect(0,0,s,s);
    for(let i=0;i<160;i++){
      const x = Math.random()*s;
      c.strokeStyle = "rgba(" + rint(48,100) + "," + rint(28,68) + "," + rint(14,38) + "," + (0.28+Math.random()*0.35) + ")";
      c.lineWidth = 0.5 + Math.random()*2.4;
      c.beginPath();
      for(let y=0;y<=s;y+=7) c.lineTo(x + Math.sin(y*0.042 + i)*3.2 + Math.sin(y*0.01)*8 + Math.sin(y*0.11)*0.8, y);
      c.stroke();
    }
    /* subtle ray flecks */
    c.globalAlpha=0.12;
    for(let i=0;i<40;i++){
      c.fillStyle="rgba(210,180,120,1)";
      c.fillRect(Math.random()*s, Math.random()*s, 1+Math.random()*2, 6+Math.random()*14);
    }
    c.globalAlpha=1;
    noise(c,s,14);
  });
  TEX.marble = texCanvas(texSize(256),(c,s)=>{
    /* Soft Capitol marble — warm ground, gentle veins, no harsh noise */
    const g0 = c.createLinearGradient(0,0,s,s);
    g0.addColorStop(0,"#ebe6dc"); g0.addColorStop(0.55,"#e2ddd2"); g0.addColorStop(1,"#d8d2c6");
    c.fillStyle=g0; c.fillRect(0,0,s,s);
    for(let i=0;i<11;i++){
      const ox = Math.random()*s;
      c.strokeStyle = "rgba(" + rint(150,180) + "," + rint(145,172) + "," + rint(140,165) + "," + (0.14+Math.random()*0.20) + ")";
      c.lineWidth = 1.0 + Math.random()*2.2;
      c.beginPath();
      c.moveTo(ox, -8);
      for(let y=-8;y<s+16;y+=16){
        const t = y/s;
        c.lineTo(ox + Math.sin(t*2.8 + i)*32 + Math.sin(t*6.4+i*0.6)*12 + Math.sin(t*14)*3, y);
      }
      c.stroke();
    }
    for(let i=0;i<5;i++){
      c.strokeStyle="rgba(255,255,255,.16)"; c.lineWidth=1.5+Math.random()*2.5;
      c.beginPath();
      const x0=Math.random()*s;
      c.moveTo(x0,0);
      for(let y=0;y<=s;y+=18) c.lineTo(x0+Math.sin(y*0.018+i)*22 + Math.sin(y*0.05)*6, y);
      c.stroke();
    }
    noise(c,s,4);
  });
  TEX.plaster = texCanvas(128,(c,s)=>{
    c.fillStyle="#d4d0c4"; c.fillRect(0,0,s,s);
    for(let i=0;i<40;i++){
      c.fillStyle="rgba(" + rint(200,220) + "," + rint(196,214) + "," + rint(188,206) + ",.06)";
      c.fillRect(Math.random()*s, Math.random()*s, 3+Math.random()*8, 2);
    }
    noise(c,s,6);
  });
  TEX.carpet = texCanvas(128,(c,s)=>{
    c.fillStyle="#2c4a37"; c.fillRect(0,0,s,s);
    for(let i=0;i<900;i++){
      c.fillStyle = "rgba(" + rint(28,60) + "," + rint(58,102) + "," + rint(42,74) + ",0.5)";
      c.fillRect(Math.random()*s, Math.random()*s, 2, 2);
    }
  });
  TEX.stone = texCanvas(texSize(256),(c,s)=>{
    c.fillStyle="#c3bfb4"; c.fillRect(0,0,s,s);
    c.strokeStyle="rgba(140,136,128,.7)"; c.lineWidth=2;
    for(let y=0;y<s;y+=32){
      c.beginPath(); c.moveTo(0,y); c.lineTo(s,y); c.stroke();
      const off = (y/32)%2 ? 32 : 0;
      for(let x=off;x<s;x+=64){ c.beginPath(); c.moveTo(x,y); c.lineTo(x,y+32); c.stroke(); }
    }
    noise(c,s,14);
  });
  TEX.leather = texCanvas(128,(c,s)=>{
    c.fillStyle="#5a3038"; c.fillRect(0,0,s,s);
    for(let i=0;i<90;i++){
      c.strokeStyle="rgba(" + rint(40,90) + "," + rint(18,40) + "," + rint(22,48) + ",0.25)";
      c.lineWidth=0.6+Math.random();
      const x=Math.random()*s, y=Math.random()*s;
      c.beginPath(); c.moveTo(x,y); c.quadraticCurveTo(x+8,y+4,x+4,y+14); c.stroke();
    }
    noise(c,s,16);
  });
  TEX.grass = texCanvas(128,(c,s)=>{
    c.fillStyle="#4d5f3a"; c.fillRect(0,0,s,s);
    for(let i=0;i<1200;i++){ c.fillStyle="rgba(" + rint(58,96) + "," + rint(78,126) + "," + rint(46,78) + ",.6)"; c.fillRect(Math.random()*s,Math.random()*s,2,3); }
  });
  /* panelled oak: grain, rails and stiles, and a varnish sheen */
  TEX.panel = texCanvas(texSize(256),(c,s)=>{
    c.fillStyle="#5f4126"; c.fillRect(0,0,s,s);
    for(let i=0;i<150;i++){
      const x=Math.random()*s;
      c.strokeStyle="rgba("+rint(44,88)+","+rint(28,58)+","+rint(14,32)+",0.42)";
      c.lineWidth=0.5+Math.random()*2;
      c.beginPath();
      for(let y=0;y<=s;y+=7) c.lineTo(x+Math.sin(y*0.05+i)*3+Math.sin(y*0.012)*7,y);
      c.stroke();
    }
    for(let px=0;px<2;px++) for(let py=0;py<2;py++){
      const x=px*128+14, y=py*128+14, w=100, h=100;
      c.strokeStyle="rgba(30,18,8,.55)"; c.lineWidth=3; c.strokeRect(x,y,w,h);
      c.strokeStyle="rgba(150,116,72,.30)"; c.lineWidth=1.5; c.strokeRect(x+4,y+4,w-8,h-8);
    }
    noise(c,s,13);
  });
  /* damask wallpaper for the grander rooms */
  TEX.damask = texCanvas(texSize(256),(c,s)=>{
    c.fillStyle="#a3aea0"; c.fillRect(0,0,s,s);
    c.globalAlpha=.08;
    for(let gy=0;gy<8;gy++) for(let gx=0;gx<8;gx++){
      const cx=gx*32+16+(gy%2?16:0), cy=gy*32+16;
      c.fillStyle="#8a9688";
      c.beginPath(); c.ellipse(cx, cy, 5, 6, 0, 0, 6.3); c.fill();
    }
    c.globalAlpha=1; noise(c,s,4);
  });
  /* chamber carpet with a real repeating motif */
  TEX.rug = texCanvas(texSize(256),(c,s)=>{
    c.fillStyle="#5c2630"; c.fillRect(0,0,s,s);
    c.strokeStyle="#8d5b46"; c.lineWidth=7; c.strokeRect(13,13,s-26,s-26);
    c.strokeStyle="#c39a5f"; c.lineWidth=2.4; c.strokeRect(21,21,s-42,s-42);
    c.fillStyle="rgba(196,152,92,.42)";
    for(let gy=0;gy<3;gy++) for(let gx=0;gx<3;gx++){
      const cx=44+gx*84, cy=44+gy*84;
      c.beginPath();
      for(let a=0;a<Math.PI*2;a+=0.42){
        const r=13+Math.sin(a*6)*6;
        a?c.lineTo(cx+Math.cos(a)*r,cy+Math.sin(a)*r):c.moveTo(cx+Math.cos(a)*r,cy+Math.sin(a)*r);
      }
      c.closePath(); c.fill();
    }
    noise(c,s,11);
  });
  /* a coffered ceiling */
  TEX.coffer = texCanvas(texSize(256),(c,s)=>{
    c.fillStyle="#cbc6b8"; c.fillRect(0,0,s,s);
    for(let gy=0;gy<2;gy++) for(let gx=0;gx<2;gx++){
      const x=gx*128, y=gy*128;
      c.fillStyle="#b6b0a1"; c.fillRect(x+12,y+12,104,104);
      c.fillStyle="#d6d1c3"; c.fillRect(x+22,y+22,84,84);
      c.strokeStyle="rgba(120,112,96,.6)"; c.lineWidth=2; c.strokeRect(x+22,y+22,84,84);
      c.fillStyle="rgba(160,132,80,.5)";
      c.beginPath(); c.arc(x+64,y+64,9,0,6.3); c.fill();
    }
    noise(c,s,8);
  });
  /* book spines for the shelves */
  TEX.books = texCanvas(128,(c,s)=>{
    c.fillStyle="#241a12"; c.fillRect(0,0,s,s);
    let x=0;
    const cols=["#6b2f2a","#2f4756","#4a4030","#5c3a22","#334a35","#6a5a2a","#43303f","#7a3f28"];
    while(x<s){
      const w=4+Math.random()*9, h=s*(0.62+Math.random()*0.34);
      c.fillStyle=pick(cols); c.fillRect(x,s-h,w-1,h);
      c.fillStyle="rgba(206,178,110,.55)"; c.fillRect(x+1,s-h+6+Math.random()*10,w-3,1.5);
      x+=w;
    }
    noise(c,s,12);
  });
  /* Wall paintings — high contrast so they read across a chamber, not as blank sky slabs */
  const paint = (skyTop, skyBot, land, dark, accent) => (c,s)=>{
    const g=c.createLinearGradient(0,0,0,s);
    g.addColorStop(0,skyTop); g.addColorStop(0.42,skyBot); g.addColorStop(1,land);
    c.fillStyle=g; c.fillRect(0,0,s,s);
    /* distant hills */
    c.fillStyle=land;
    c.beginPath(); c.moveTo(0,s*0.58);
    for(let x=0;x<=s;x+=6) c.lineTo(x, s*0.58 - Math.sin(x*0.04)*18 - Math.sin(x*0.011)*28);
    c.lineTo(s,s); c.lineTo(0,s); c.closePath(); c.fill();
    /* near bank */
    c.fillStyle=dark;
    c.beginPath(); c.moveTo(0,s*0.78);
    for(let x=0;x<=s;x+=6) c.lineTo(x, s*0.78 - Math.sin(x*0.028+1.2)*14);
    c.lineTo(s,s); c.lineTo(0,s); c.closePath(); c.fill();
    /* a structure / tree mass so the canvas has a subject */
    c.fillStyle=accent;
    c.fillRect(s*0.62, s*0.40, s*0.08, s*0.28);
    c.beginPath(); c.moveTo(s*0.58,s*0.42); c.lineTo(s*0.66,s*0.28); c.lineTo(s*0.74,s*0.42); c.closePath(); c.fill();
    c.fillStyle="rgba(255,255,255,.22)";
    c.beginPath(); c.arc(s*0.28,s*0.22,s*0.07,0,6.3); c.fill();
    /* gilt-ish mat edge inside the canvas */
    c.strokeStyle="rgba(40,28,12,.55)"; c.lineWidth=Math.max(4,s*0.035);
    c.strokeRect(s*0.04,s*0.04,s*0.92,s*0.92);
    /* soft vignette */
    const vg=c.createRadialGradient(s*0.5,s*0.45,s*0.15,s*0.5,s*0.5,s*0.72);
    vg.addColorStop(0,"rgba(0,0,0,0)"); vg.addColorStop(1,"rgba(0,0,0,.35)");
    c.fillStyle=vg; c.fillRect(0,0,s,s);
    noise(c,s,22);
  };
  const psz = texSize(256);
  TEX.paintA = texCanvas(psz, paint("#6a86a8","#c4b896","#3a4a32","#24301f","#2c2418"));
  TEX.paintB = texCanvas(psz, paint("#b88848","#8a5a30","#3a2818","#1a120c","#5a3a22"));
  TEX.paintC = texCanvas(psz, paint("#4a5a72","#2a3848","#1a2820","#0e1612","#3a4850"));
  TEX.paintD = texCanvas(psz, paint("#7a9ab0","#e0d0b0","#4a5a38","#2a3818","#3a3020"));
  TEX.paintE = texCanvas(psz, paint("#c08050","#a06838","#4a3020","#20140c","#6a4830"));
  TEX.paintF = texCanvas(psz, paint("#3a4858","#1a2838","#243828","#101818","#485868"));
  /* sheet vinyl, laid in squares and scuffed along the traffic line */
  TEX.lino = texCanvas(texSize(256),(c,s)=>{
    c.fillStyle="#9aa39a"; c.fillRect(0,0,s,s);
    for(let gy=0;gy<4;gy++) for(let gx=0;gx<4;gx++){
      const shade = (gx+gy)%2 ? "#8f988f" : "#a4aca3";
      c.fillStyle = shade; c.fillRect(gx*64, gy*64, 64, 64);
      for(let i=0;i<90;i++){
        c.fillStyle = "rgba(" + rint(110,160) + "," + rint(118,166) + "," + rint(110,158) + ",.5)";
        c.fillRect(gx*64+Math.random()*64, gy*64+Math.random()*64, 2.4, 1.4);
      }
    }
    c.strokeStyle="rgba(70,78,70,.55)"; c.lineWidth=1.4;
    for(let i=0;i<=4;i++){
      c.beginPath(); c.moveTo(i*64,0); c.lineTo(i*64,s); c.stroke();
      c.beginPath(); c.moveTo(0,i*64); c.lineTo(s,i*64); c.stroke();
    }
    c.strokeStyle="rgba(255,255,255,.10)"; c.lineWidth=9;
    c.beginPath(); c.moveTo(0,s*0.52); c.bezierCurveTo(s*0.4,s*0.44,s*0.6,s*0.6,s,s*0.5); c.stroke();
    noise(c,s,10);
  });
  /* an oil portrait of somebody nobody remembers */
  TEX.portrait = texCanvas(texSize(256),(c,s)=>{
    const g = c.createRadialGradient(s*0.5,s*0.40,3, s*0.5,s*0.52,s*0.72);
    g.addColorStop(0,"#6d5a41"); g.addColorStop(1,"#1e1811");
    c.fillStyle=g; c.fillRect(0,0,s,s);
    c.fillStyle="#171208";
    c.beginPath(); c.ellipse(s*0.5,s*0.92,s*0.34,s*0.30,0,0,6.3); c.fill();
    c.fillStyle="#c49a72";
    c.beginPath(); c.ellipse(s*0.5,s*0.46,s*0.16,s*0.21,0,0,6.3); c.fill();
    c.fillStyle="#8d6a4c";
    c.beginPath(); c.ellipse(s*0.5,s*0.34,s*0.17,s*0.11,0,0,6.3); c.fill();
    c.fillStyle="#2a1c12";
    c.beginPath(); c.ellipse(s*0.44,s*0.44,s*0.018,s*0.014,0,0,6.3); c.fill();
    c.beginPath(); c.ellipse(s*0.56,s*0.44,s*0.018,s*0.014,0,0,6.3); c.fill();
    c.fillStyle="rgba(232,224,206,.9)";
    c.beginPath(); c.ellipse(s*0.5,s*0.66,s*0.08,s*0.055,0,0,6.3); c.fill();
    c.strokeStyle="rgba(40,28,12,.6)"; c.lineWidth=Math.max(4,s*0.03);
    c.strokeRect(s*0.035,s*0.035,s*0.93,s*0.93);
    noise(c,s,14);
  });
}
buildTextures();
function dressTextures(){
  /* Photoreal albedos on top of the canvas fallback. Modest/Simple keep the cheap maps. */
  /* MAX OPT 20260921b: skip photoreal dress on Simple only (Best on MODEST still dresses). */
  if(G.gfx === "simple") return;
  /* 20261011a: standalone file:// cannot fetch these (CORS noise); canvas maps stand. */
  try{ if(location.protocol === "file:") return; }catch(e){}
  try{ if(!/(?:\?|&)tex=1(?:&|$)/.test(location.search || "")) return; }catch(e){ return; }
  [
    ["oak","/tex/oak.jpg"],
    ["marble","/tex/marble.jpg"],
    ["plaster","/tex/plaster.jpg"],
    ["carpet","/tex/carpet.jpg"],
    ["leather","/tex/leather.jpg"],
    ["panel","/tex/panel.jpg"]
  ].forEach(function(pair){
    const key = pair[0], url = pair[1];
    const img = new Image();
    img.crossOrigin = "anonymous";
    img.onload = function(){
      try{
        const t = new THREE.Texture(img);
        t.wrapS = t.wrapT = THREE.RepeatWrapping;
        t.encoding = THREE.sRGBEncoding;
        t.needsUpdate = true;
        t.generateMipmaps = true;
        t.minFilter = THREE.LinearMipmapLinearFilter;
        t.magFilter = THREE.LinearFilter;
        try{
          if(renderer && renderer.capabilities){
            t.anisotropy = Math.min(4, renderer.capabilities.getMaxAnisotropy() || 1);
          }
        }catch(e){}
        TEX[key] = t;
      }catch(e){}
    };
    img.src = url;
  });
}
dressTextures();

/* Soft contact shadow, so nobody floats even where the shadow map is weak. */
const CONTACT = (function(){
  const c = document.createElement("canvas"); c.width = c.height = 64;
  const x = c.getContext("2d");
  const g = x.createRadialGradient(32,32,1,32,32,31);
  g.addColorStop(0,"rgba(0,0,0,0.50)");
  g.addColorStop(0.5,"rgba(0,0,0,0.20)");
  g.addColorStop(1,"rgba(0,0,0,0)");
  x.fillStyle = g; x.fillRect(0,0,64,64);
  const t = new THREE.CanvasTexture(c); t.encoding = THREE.sRGBEncoding;
  return new THREE.MeshBasicMaterial({map:t, transparent:true, depthWrite:false, opacity:0.95});
})();

/* Dust in the light. Only indoors, only when there is light to catch. */
let skyMesh = null, horizonMesh = null, landGroup = null, skyGlow = null;
function townPulse(){
  const you = G.you || {};
  const ap = you.approval != null ? you.approval : 50;
  const st = you.standing != null ? you.standing : 50;
  const md = G.mood || 0;
  return clamp((ap * 0.52 + st * 0.28 + (md + 18) * 0.7) / 100, 0, 1);
}
let _warmingKit = false; /* 20261011a: a kit being warmed must not touch the live sky */
function buildSky(R){
  if(_warmingKit) return;
  if(skyMesh){
    try{ if(skyMesh.parent) skyMesh.parent.remove(skyMesh); }catch(e){}
    try{ skyMesh.geometry.dispose(); }catch(e){}
    skyMesh = null;
  }
  if(horizonMesh){
    try{ if(horizonMesh.parent) horizonMesh.parent.remove(horizonMesh); }catch(e){}
    horizonMesh = null;
  }
  if(skyGlow){
    try{ if(skyGlow.parent) skyGlow.parent.remove(skyGlow); }catch(e){}
    skyGlow = null;
  }
  if(landGroup){
    try{ if(landGroup.parent) landGroup.parent.remove(landGroup); }catch(e){}
    landGroup = null;
  }
  if(!R || !R.open){
    try{ if(scene) scene.background = null; }catch(e){}
    return;
  }
  const g = new THREE.SphereGeometry(140, 24, 16);
  const cols = new Float32Array(g.attributes.position.count * 3);
  const pos = g.attributes.position;
  for(let i=0;i<pos.count;i++){
    const ny = pos.getY(i) / 140;
    const t = clamp((ny + 0.15) / 1.15, 0, 1);
    const zenith = new THREE.Color().setHSL(0.58, 0.62, 0.48);
    const haze = new THREE.Color().setHSL(0.55, 0.28, 0.72);
    const c = zenith.clone().lerp(haze, 1 - t);
    cols[i*3] = c.r; cols[i*3+1] = c.g; cols[i*3+2] = c.b;
  }
  g.setAttribute("color", new THREE.BufferAttribute(cols, 3));
  const mat = new THREE.MeshBasicMaterial({
    vertexColors: true, side: THREE.BackSide, fog: false, depthWrite: false
  });
  skyMesh = new THREE.Mesh(g, mat);
  skyMesh.position.set(0, 4, R.d * 0.45);
  skyMesh.frustumCulled = false;
  scene.add(skyMesh);
  try{ scene.background = new THREE.Color(0x6aa8d8); }catch(e){}
  const grass = R.style === "town";
  const hg = new THREE.Mesh(UNIT.plane, new THREE.MeshBasicMaterial({
    color: grass ? 0x4a6a30 : 0x6e7668, fog: true, depthWrite: true
  }));
  hg.rotation.x = -Math.PI / 2;
  hg.position.set(0, -0.06, R.d * 0.45);
  hg.scale.set(120, 120, 1);
  hg.receiveShadow = true;
  hg.frustumCulled = false;
  scene.add(hg);
  horizonMesh = hg;
  const glow = new THREE.Mesh(UNIT.plane, new THREE.MeshBasicMaterial({
    color: 0xffc48a, transparent: true, opacity: 0.28, fog: false, depthWrite: false, side: THREE.DoubleSide
  }));
  glow.position.set(0, 6, R.d * 0.45 - 48);
  glow.scale.set(90, 14, 1);
  glow.frustumCulled = false;
  scene.add(glow);
  skyGlow = glow;
  landGroup = new THREE.Group();
  landGroup.position.set(0, 0, R.d * 0.4);
  const hillCol = grass ? 0x3f5e2c : 0x5a6454;
  const roofCol = grass ? 0x7a4030 : 0x6a6e66;
  const putHill = (x,z,sx,sy,sz, col) => {
    const m = new THREE.Mesh(UNIT.sph, new THREE.MeshBasicMaterial({color: col || hillCol, fog: true}));
    m.position.set(x, sy * 0.28, z);
    m.scale.set(sx, sy, sz);
    landGroup.add(m);
  };
  const putHouse = (x,z,bw,bh,bd, col) => {
    const m = new THREE.Mesh(UNIT.box, new THREE.MeshBasicMaterial({color: col || 0x8a8478, fog: true}));
    m.position.set(x, bh * 0.5, z);
    m.scale.set(bw, bh, bd);
    landGroup.add(m);
    const roof = new THREE.Mesh(UNIT.box, new THREE.MeshBasicMaterial({color: roofCol, fog: true}));
    roof.position.set(x, bh + 0.22, z);
    roof.scale.set(bw * 1.08, 0.38, bd * 1.08);
    landGroup.add(roof);
  };
  const nHill = MODEST ? 8 : 14;
  for(let i=0;i<nHill;i++){
    const a = (i / nHill) * Math.PI * 2;
    const dist = 28 + (i % 4) * 5;
    putHill(Math.sin(a) * dist, Math.cos(a) * dist, 6 + (i%3)*2, 2.2 + (i%3)*0.8, 5 + (i%2)*2);
  }
  const nHouse = MODEST ? 4 : 8;
  for(let i=0;i<nHouse;i++){
    const side = i < nHouse/2 ? -1 : 1;
    putHouse(side * (10 + (i%4)*2.4), -15 - (i%4)*2.0, 1.7 + (i%3)*0.3, 1.5 + (i%2)*0.4, 1.3, grass ? 0x8a8478 : 0x8a8680);
  }
  scene.add(landGroup);
  if(camera){
    camera.far = 180;
    camera.updateProjectionMatrix();
  }
}
function tintSky(day, gold){
  const hh = ((G.minute || 0) / 60);
  const night = hh >= 20.2 || hh < 5.8;
  const dusk = !night && (hh >= 17.4 || hh < 7.2);
  if(scene && scene.background){
    if(night) scene.background.setHSL(0.64, 0.48, 0.07);
    else if(dusk) scene.background.setHSL(lerp(0.08, 0.72, gold), 0.42, 0.16);
    else scene.background.setHSL(0.57, 0.52, lerp(0.42, 0.58, day));
  }
  if(skyGlow && skyGlow.material){
    skyGlow.material.opacity = night ? 0.08 : dusk ? 0.42 : 0.18;
    skyGlow.material.color.setHex(night ? 0x4a6080 : dusk ? 0xffb070 : 0xffe2b8);
  }
  if(horizonMesh && horizonMesh.material && horizonMesh.material.color){
    if(night) horizonMesh.material.color.setHex(0x1a2414);
    else if(day > 0.3) horizonMesh.material.color.setHex(0x4a6a30);
    else horizonMesh.material.color.setHex(0x2a3820);
  }
}
let motes = null;
function buildMotes(R){
  if(motes){ scene.remove(motes); motes.geometry.dispose(); motes = null; }
  if(MODEST || G.gfx === "simple") return;
  if(R.open) return;
  const n = (G.gfx === "simple") ? 40 : (G.gfx === "balanced" || crowdSafe) ? 70 : 120;
  const pos = new Float32Array(n*3);
  for(let i=0;i<n;i++){
    pos[i*3]   = (Math.random()-0.5)*R.w*0.92;
    pos[i*3+1] = 0.5 + Math.random()*(R.h-1.0);
    pos[i*3+2] = Math.random()*R.d;
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute("position", new THREE.BufferAttribute(pos,3));
  motes = new THREE.Points(g, new THREE.PointsMaterial({
    size:0.024, color:0xffe8c6, transparent:true, opacity:0.0, depthWrite:false
  }));
  scene.add(motes);
}

const UNIT = {
  box:new THREE.BoxGeometry(1,1,1),
  cyl:new THREE.CylinderGeometry(0.5,0.5,1,18),
  sph:new THREE.SphereGeometry(0.5,12,10),
  plane:new THREE.PlaneGeometry(1,1)
};
/* ══════════════════════════════════════════════════════════
   SKINNING
   The body is one continuous mesh bound to a skeleton. Each
   ring of vertices is weighted between the bone that owns its
   segment and the bone at the nearer joint, so an elbow bends
   instead of two tubes pivoting past each other.
   ══════════════════════════════════════════════════════════ */
const RING = 16;                      /* vertices around a limb — smooth cloth silhouette */
function makeBones(spec){
  const names = Object.keys(spec.bones);
  const bones = {}, order = [];
  names.forEach(n => {
    const d = spec.bones[n];
    const b = new THREE.Bone();
    b.name = n;
    b.position.set(d.pos[0], d.pos[1], d.pos[2]);
    bones[n] = b;
  });
  names.forEach(n => {
    const d = spec.bones[n];
    if(d.parent) bones[d.parent].add(bones[n]);
    order.push(bones[n]);
  });
  return {bones, order};
}
/* One body geometry per frame+outfit. Everyone else reuses it and we scale
   the root — that is what "one model, unique faces" actually means here. */
const BODY_CANON_H = 1.70, BODY_CANON_B = 1.00;
const TORSO_DZ = 0.74;   /* a torso is about three quarters as deep as it is wide */
const SKIN_GEO = new Map();
function sharedSkin(spec, key){
  let geo = SKIN_GEO.get(key);
  if(!geo){
    const first = skinnedBody(spec);
    SKIN_GEO.set(key, first.geo);
    return first;
  }
  const {bones, order} = makeBones(spec);
  return {geo, bones, order};
}
function skinnedBody(spec){
  /* spec.bones: {name:{parent, pos:[x,y,z]}} in bind pose
     spec.segs:  [{a, b, r0, r1, mat, rings}] a is the owning bone   */
  const {bones, order} = makeBones(spec);
  const names = Object.keys(spec.bones);
  const world = {};
  /* bind-pose positions in model space */
  function worldOf(n){
    if(world[n]) return world[n];
    const d = spec.bones[n];
    const p = d.parent ? worldOf(d.parent) : [0,0,0];
    world[n] = [p[0]+d.pos[0], p[1]+d.pos[1], p[2]+d.pos[2]];
    return world[n];
  }
  names.forEach(worldOf);
  const idxOf = {};
  order.forEach((b,i) => idxOf[b.name] = i);

  const pos = [], nrm = [], uv = [], si = [], sw = [], ix = [];
  const groups = [];
  spec.segs.forEach(seg => {
    const A = worldOf(seg.a), Bp = worldOf(seg.b);
    const parent = spec.bones[seg.a].parent;
    const own = idxOf[seg.a], par = parent ? idxOf[parent] : own, chi = idxOf[seg.b];
    const rings = seg.rings || 10;
    const start = ix.length;
    const base = pos.length/3;
    const dir = [Bp[0]-A[0], Bp[1]-A[1], Bp[2]-A[2]];
    const len = Math.hypot(dir[0],dir[1],dir[2]) || 1e-6;
    const u0 = [dir[0]/len, dir[1]/len, dir[2]/len];
    /* a stable frame perpendicular to the bone */
    const ref = Math.abs(u0[1]) > 0.9 ? [1,0,0] : [0,1,0];
    const rt = [u0[1]*ref[2]-u0[2]*ref[1], u0[2]*ref[0]-u0[0]*ref[2], u0[0]*ref[1]-u0[1]*ref[0]];
    const rl = Math.hypot(rt[0],rt[1],rt[2]) || 1e-6;
    const R = [rt[0]/rl, rt[1]/rl, rt[2]/rl];
    const F = [u0[1]*R[2]-u0[2]*R[1], u0[2]*R[0]-u0[0]*R[2], u0[0]*R[1]-u0[1]*R[0]];
    for(let r=0; r<=rings; r++){
      const t = r/rings;
      const rad = seg.r0 + (seg.r1 - seg.r0)*t;
      const cx = A[0] + dir[0]*t, cy = A[1] + dir[1]*t, cz = A[2] + dir[2]*t;
      /* weights: blend into the parent at the top, the child at the bottom */
      let wOwn = 1, wOther = 0, other = own;
      if(t < 0.28){ wOther = 0.5 - t/0.56; wOwn = 1 - wOther; other = par; }
      else if(t > 0.72){ wOther = (t - 0.72)/0.56; wOwn = 1 - wOther; other = chi; }
      /* a torso is wider than it is deep: seg.dz flattens the ring front to back (R is the depth axis on an upright bone) */
      const dzk = seg.dz || 1, bulge = seg.bulge ? Math.sin(t * Math.PI) * seg.bulge : 0, radB = rad * (1 + bulge);
      for(let k=0;k<RING;k++){
        const a = k/RING*Math.PI*2;
        const ca = Math.cos(a)*radB*dzk, sa = Math.sin(a)*radB;
        pos.push(cx + R[0]*ca + F[0]*sa, cy + R[1]*ca + F[1]*sa, cz + R[2]*ca + F[2]*sa);
        const enx = Math.cos(a) / dzk, eny = Math.sin(a), enl = Math.hypot(enx, eny) || 1;
        const nx = (R[0]*enx + F[0]*eny) / enl;
        const ny = (R[1]*enx + F[1]*eny) / enl;
        const nz = (R[2]*enx + F[2]*eny) / enl;
        nrm.push(nx, ny, nz);
        uv.push(k/RING, t);
        si.push(own, other, 0, 0);
        sw.push(wOwn, wOther, 0, 0);
      }
    }
    let _flip = false;
    {
      const P = i => [pos[i*3], pos[i*3+1], pos[i*3+2]];
      const p0 = P(base), p1 = P(base + RING), p2 = P(base + 1);
      const e1 = [p1[0]-p0[0], p1[1]-p0[1], p1[2]-p0[2]], e2 = [p2[0]-p0[0], p2[1]-p0[1], p2[2]-p0[2]];
      const fn = [e1[1]*e2[2]-e1[2]*e2[1], e1[2]*e2[0]-e1[0]*e2[2], e1[0]*e2[1]-e1[1]*e2[0]];
      _flip = fn[0]*nrm[base*3] + fn[1]*nrm[base*3+1] + fn[2]*nrm[base*3+2] < 0;
    }
    for(let r=0;r<rings;r++){
      for(let k=0;k<RING;k++){
        const k2 = (k+1)%RING;
        const a0 = base + r*RING + k,  a1 = base + r*RING + k2;
        const b0 = base + (r+1)*RING + k, b1 = base + (r+1)*RING + k2;
        if(_flip) ix.push(a0, a1, b0,  a1, b1, b0); else
        ix.push(a0, b0, a1,  a1, b0, b1);
      }
    }
    groups.push({start, count:ix.length - start, mat:seg.mat || 0});
  });

  const geo = new THREE.BufferGeometry();
  geo.setAttribute("position", new THREE.Float32BufferAttribute(pos, 3));
  geo.setAttribute("normal",   new THREE.Float32BufferAttribute(nrm, 3));
  geo.setAttribute("uv",       new THREE.Float32BufferAttribute(uv, 2));
  geo.setAttribute("skinIndex",  new THREE.Uint16BufferAttribute(si, 4));
  geo.setAttribute("skinWeight", new THREE.Float32BufferAttribute(sw, 4));
  geo.setIndex(ix);
  groups.forEach(g2 => geo.addGroup(g2.start, g2.count, g2.mat));
  return {geo, bones, order, world};
}

/* ── Sculpted skulls ──────────────────────────────────────
   Sphere → cranium. Separate masc / fem families so the head
   matches the body frame instead of a one-size mask. */
function sculptSkull(seed, frame){
  const fem = frame === "fem";
  const g = new THREE.SphereGeometry(0.5, 18, 14);
  const p = g.attributes.position;
  const v = new THREE.Vector3();
  for(let i=0;i<p.count;i++){
    v.fromBufferAttribute(p, i);
    const n = v.clone().normalize();
    let x = n.x, y = n.y, z = n.z;
    let s = 1;
    /* restrained crown: the old tall sphere read as an egg at gameplay scale */
    s *= 1 + (fem ? 0.035 : 0.05)*y;
    if(y < 0){
      const t = -y;
      /* keep a cheek and jaw shelf instead of tapering to a point */
      const jawCut = fem ? 0.22 : 0.16;
      s *= 1 - jawCut*t*t - (fem ? 0.07 : 0.04)*t;
      if(z > 0.15) s *= 1 + (fem ? 0.06 : 0.12)*t*z;   /* chin forward */
      /* widen or narrow the jaw laterally */
      if(Math.abs(x) > 0.25) s *= 1 + (fem ? -0.025 : 0.07)*t*Math.abs(x);
    }
    if(y > 0.12 && z > 0.2) s *= 1 + (fem ? 0.035 : 0.05)*(y-0.12); /* forehead */
    if(y > 0.0 && y < 0.32 && z > 0.42) s *= fem ? 1.015 : 1.045;   /* brow */
    if(y > 0.08 && y < 0.45 && Math.abs(x) > 0.58) s *= fem ? 0.965 : 0.948; /* temples */
    if(y > -0.30 && y < 0.10 && Math.abs(x) > 0.40 && z > 0.05)
      s *= fem ? 1.045 : 1.025;   /* cheeks — fuller on fem */
    if(z < -0.25) s *= 1 + 0.07*(-z-0.25) + 0.015*seed;  /* occiput */
    if(z > 0.52 && Math.abs(y) < 0.22) s *= 0.978;        /* face plane slightly inset */
    /* mild asymmetry from seed so skulls are not clones */
    s *= 1 + 0.012*seed*x;
    v.multiplyScalar(s);
    p.setXYZ(i, v.x, v.y, v.z);
  }
  g.computeVertexNormals();
  return g;
}
const SKULLS_MASC = [sculptSkull2(0,"masc"), sculptSkull2(0.55,"masc"), sculptSkull2(1.1,"masc"), sculptSkull2(1.7,"masc")];
const SKULLS_FEM  = [sculptSkull2(0.2,"fem"), sculptSkull2(0.7,"fem"), sculptSkull2(1.25,"fem"), sculptSkull2(1.9,"fem")];
SKULLS_MASC.forEach(g => njFaceColors(g, false)); SKULLS_FEM.forEach(g => njFaceColors(g, true));
/* keep SKULLS alias for any leftover callers */
const SKULLS = SKULLS_MASC;

function hexRgb(n){
  return {r:(n>>16)&255, g:(n>>8)&255, b:n&255};
}
function cssHex(n){ return "#" + (n>>>0).toString(16).padStart(6,"0"); }
function mixRgb(a, b, t){
  return {
    r: Math.round(a.r + (b.r-a.r)*t),
    g: Math.round(a.g + (b.g-a.g)*t),
    b: Math.round(a.b + (b.b-a.b)*t)
  };
}
function rgbCss(c, a){
  if(a === undefined) return "rgb("+c.r+","+c.g+","+c.b+")";
  return "rgba("+c.r+","+c.g+","+c.b+","+a+")";
}

/* ── A painted face ───────────────────────────────────────
   Legitimate frontal features, framed to masc/fem morphs and
   the same skin hex as the skull — not a floating sticker. */
const FACECACHE = new Map();
function faceCanvas(L){
  const faceQ = (G.gfx === "simple" && !G.fullDetail) ? "lo" : ((G.fullDetail || G.gfx === "best") ? "hi" : "mid");
  const fem = L.frame === "fem";
  const fw = L.faceW || (fem ? 0.95 : 1.0);
  const jw = L.jawW || (fem ? 0.88 : 1.0);
  const bh = L.browH || (fem ? 0.92 : 1.05);
  const nl = L.noseL || 1.0;
  const lf = L.lipF || (fem ? 1.1 : 0.95);
  const age = L.age || 0;
  const _fk = [L.skin,L.hair,L.eye,L.beard?1:0,L.frame||"m",faceQ,
    Math.round(fw*50),Math.round(jw*50),Math.round(bh*40),Math.round(nl*40),Math.round(lf*40),Math.round(age*8)].join("_");
  if(FACECACHE.has(_fk)) return FACECACHE.get(_fk);
  const S = faceQ === "hi" ? 192 : faceQ === "mid" ? 144 : 112;
  const c = document.createElement("canvas"); c.width = c.height = S;
  const x = c.getContext("2d");
  const skinN = hexRgb(L.skin);
  const warm = mixRgb(skinN, {r:210,g:110,b:90}, 0.22);
  const cool = mixRgb(skinN, {r:40,g:30,b:50}, 0.18);
  const lipBase = mixRgb(skinN, {r:160,g:70,b:75}, fem ? 0.55 : 0.38);
  const lipDeep = mixRgb(lipBase, {r:80,g:30,b:35}, 0.35);

  /* Full-skin field — matches MeshStandardMaterial skull color */
  x.fillStyle = cssHex(L.skin); x.fillRect(0,0,S,S);

  /* Soft oval face plate (keeps features inside a head, not a square) */
  const cx0 = S*0.5, cy0 = S*0.52;
  const rx = S*(0.40*fw), ry = S*(0.46);
  x.save();
  x.beginPath(); x.ellipse(cx0, cy0, rx, ry, 0, 0, Math.PI*2); x.clip();

  /* subsurface / cheek bloom */
  let g = x.createRadialGradient(cx0, S*0.58, S*0.04, cx0, S*0.55, S*0.42);
  g.addColorStop(0, rgbCss(warm, fem ? 0.28 : 0.16));
  g.addColorStop(1, rgbCss(warm, 0));
  x.fillStyle = g; x.fillRect(0,0,S,S);

  /* temple / jaw cool shade shaped by jawW */
  g = x.createRadialGradient(cx0, S*0.48, S*0.18*jw, cx0, S*0.52, S*0.50);
  g.addColorStop(0, "rgba(0,0,0,0)");
  g.addColorStop(1, rgbCss(cool, 0.34));
  x.fillStyle = g; x.fillRect(0,0,S,S);

  /* Proportions: eyes sit near vertical mid of face plate */
  const eyeY = S*(0.44 + (fem ? 0.01 : 0));
  const eyeDX = S*(0.155 * fw);
  const eyeRX = S*(fem ? 0.048 : 0.050);
  const eyeRY = S*(fem ? 0.038 : 0.034);

  /* sockets */
  [-1,1].forEach(s2 => {
    const cx = cx0 + s2*eyeDX;
    const sg = x.createRadialGradient(cx, eyeY+S*0.01, 1, cx, eyeY, eyeRX*2.4);
    sg.addColorStop(0, "rgba(50,28,20,0.34)");
    sg.addColorStop(1, "rgba(50,28,20,0)");
    x.fillStyle = sg;
    x.beginPath(); x.ellipse(cx, eyeY, eyeRX*2.2, eyeRY*2.5, 0, 0, Math.PI*2); x.fill();
  });

  /* eyes: sclera → iris → pupil → catchlight */
  [-1,1].forEach(s2 => {
    const cx = cx0 + s2*eyeDX;
    x.save();
    x.beginPath();
    x.ellipse(cx, eyeY, eyeRX*1.55, eyeRY*1.25, 0, 0, Math.PI*2);
    x.clip();
    /* sclera */
    const scl = mixRgb(skinN, {r:245,g:242,b:236}, 0.82);
    x.fillStyle = rgbCss(scl); x.fillRect(cx-eyeRX*3, eyeY-eyeRY*3, eyeRX*6, eyeRY*6);
    /* iris */
    const iris = cssHex(L.eye || 0x5a3d24);
    const ig = x.createRadialGradient(cx, eyeY, 1, cx, eyeY, eyeRX*0.78);
    ig.addColorStop(0, iris);
    ig.addColorStop(0.72, iris);
    ig.addColorStop(1, "rgba(10,8,6,0.85)");
    x.fillStyle = ig;
    x.beginPath(); x.arc(cx, eyeY + eyeRY*0.05, eyeRX*0.72, 0, Math.PI*2); x.fill();
    /* pupil */
    x.fillStyle = "#0a0806";
    x.beginPath(); x.arc(cx, eyeY + eyeRY*0.05, eyeRX*0.30, 0, Math.PI*2); x.fill();
    /* catchlight */
    x.fillStyle = "rgba(255,255,255,0.9)";
    x.beginPath(); x.arc(cx - eyeRX*0.22, eyeY - eyeRY*0.35, eyeRX*0.14, 0, Math.PI*2); x.fill();
    /* upper lid shade inside eye */
    x.fillStyle = "rgba(20,12,8,0.28)";
    x.fillRect(cx-eyeRX*2, eyeY-eyeRY*2.2, eyeRX*4, eyeRY*1.35);
    x.restore();
    /* lash / lid line */
    x.strokeStyle = "rgba(25,16,10,0.78)";
    x.lineWidth = Math.max(1, S*0.008);
    x.beginPath();
    x.moveTo(cx - eyeRX*1.55, eyeY);
    x.quadraticCurveTo(cx, eyeY - eyeRY*1.55, cx + eyeRX*1.55, eyeY);
    x.stroke();
    /* lower lid soft */
    x.strokeStyle = "rgba(80,50,40,0.28)";
    x.lineWidth = Math.max(1, S*0.005);
    x.beginPath();
    x.moveTo(cx - eyeRX*1.4, eyeY + eyeRY*0.15);
    x.quadraticCurveTo(cx, eyeY + eyeRY*1.15, cx + eyeRX*1.4, eyeY + eyeRY*0.15);
    x.stroke();
  });

  /* brows — follow hair colour, heavier when browH high */
  const hairCss = cssHex(L.hair);
  [-1,1].forEach(s2 => {
    const cx = cx0 + s2*eyeDX;
    x.strokeStyle = hairCss;
    x.lineWidth = S*(0.018 + 0.012*bh);
    x.lineCap = "round";
    x.beginPath();
    const y0 = eyeY - eyeRY*(2.05 + 0.35*bh);
    x.moveTo(cx - s2*eyeRX*1.85, y0 + S*0.012);
    x.quadraticCurveTo(cx - s2*eyeRX*0.1, y0 - S*0.018*bh, cx + s2*eyeRX*1.75, y0 + S*0.02);
    x.stroke();
    if(bh > 1.05){
      x.lineWidth = S*0.01;
      x.globalAlpha = 0.55;
      x.beginPath();
      x.moveTo(cx - s2*eyeRX*1.7, y0 + S*0.02);
      x.quadraticCurveTo(cx, y0 - S*0.004, cx + s2*eyeRX*1.5, y0 + S*0.028);
      x.stroke();
      x.globalAlpha = 1;
    }
  });

  /* nose — bridge + tip + nostrils (length from noseL) */
  const nTop = eyeY + S*0.02;
  const nBot = eyeY + S*(0.145 + 0.04*nl);
  g = x.createLinearGradient(cx0 - S*0.04, 0, cx0 + S*0.05, 0);
  g.addColorStop(0, "rgba(0,0,0,0.18)");
  g.addColorStop(0.45, "rgba(0,0,0,0)");
  g.addColorStop(1, "rgba(255,255,255,0.08)");
  x.fillStyle = g;
  x.fillRect(cx0 - S*0.05, nTop, S*0.10, nBot - nTop);
  /* tip */
  x.fillStyle = rgbCss(mixRgb(skinN, {r:255,g:230,b:210}, 0.2), 0.35);
  x.beginPath(); x.ellipse(cx0, nBot - S*0.01, S*(0.028+0.006*nl), S*0.022, 0, 0, Math.PI*2); x.fill();
  /* nostrils */
  x.fillStyle = "rgba(35,18,12,0.55)";
  [-1,1].forEach(s2 => {
    x.beginPath();
    x.ellipse(cx0 + s2*S*(0.026+0.004*nl), nBot + S*0.004, S*0.012, S*0.008, s2*0.2, 0, Math.PI*2);
    x.fill();
  });

  /* mouth */
  const mY = nBot + S*(0.075 + (fem ? 0.01 : 0.005));
  const mW = S*(0.078 + 0.02*lf) * (0.92 + 0.08*fw);
  const mT = S*(0.016 * lf);
  const mB = S*(0.022 * lf);
  /* upper lip */
  x.fillStyle = rgbCss(lipBase, 0.92);
  x.beginPath();
  x.moveTo(cx0 - mW, mY);
  x.quadraticCurveTo(cx0 - mW*0.35, mY - mT*1.6, cx0, mY - mT*0.55);
  x.quadraticCurveTo(cx0 + mW*0.35, mY - mT*1.6, cx0 + mW, mY);
  x.quadraticCurveTo(cx0, mY + mB*0.15, cx0 - mW, mY);
  x.fill();
  /* lower lip */
  x.fillStyle = rgbCss(mixRgb(lipBase, {r:255,g:180,b:170}, 0.15), 0.95);
  x.beginPath();
  x.moveTo(cx0 - mW*0.92, mY + S*0.004);
  x.quadraticCurveTo(cx0, mY + mB*1.55, cx0 + mW*0.92, mY + S*0.004);
  x.quadraticCurveTo(cx0, mY + mB*0.2, cx0 - mW*0.92, mY + S*0.004);
  x.fill();
  /* oral line */
  x.strokeStyle = rgbCss(lipDeep, 0.7);
  x.lineWidth = Math.max(1, S*0.006);
  x.beginPath();
  x.moveTo(cx0 - mW, mY);
  x.quadraticCurveTo(cx0, mY + S*0.008, cx0 + mW, mY);
  x.stroke();
  /* philtrum hint */
  x.strokeStyle = "rgba(0,0,0,0.10)";
  x.lineWidth = S*0.004;
  x.beginPath();
  x.moveTo(cx0 - S*0.012, nBot + S*0.02);
  x.lineTo(cx0 - S*0.008, mY - mT);
  x.moveTo(cx0 + S*0.012, nBot + S*0.02);
  x.lineTo(cx0 + S*0.008, mY - mT);
  x.stroke();

  /* age lines */
  if(age > 0.35){
    x.strokeStyle = "rgba(60,35,25," + (0.10 + age*0.18) + ")";
    x.lineWidth = S*0.0035;
    [-1,1].forEach(s2 => {
      x.beginPath();
      x.moveTo(cx0 + s2*eyeDX*0.85, eyeY + eyeRY*1.6);
      x.quadraticCurveTo(cx0 + s2*S*0.12, eyeY + S*0.08, cx0 + s2*S*0.10, mY);
      x.stroke();
      if(age > 0.65){
        x.beginPath();
        x.moveTo(cx0 + s2*eyeDX*0.6, eyeY - eyeRY*1.8);
        x.quadraticCurveTo(cx0 + s2*S*0.08, eyeY - S*0.06, cx0 + s2*S*0.14, eyeY - S*0.02);
        x.stroke();
      }
    });
  }

  /* nasolabial */
  x.strokeStyle = "rgba(70,40,28," + (0.12 + age*0.1) + ")";
  x.lineWidth = S*0.004;
  [-1,1].forEach(s2 => {
    x.beginPath();
    x.moveTo(cx0 + s2*S*0.04, nBot - S*0.01);
    x.quadraticCurveTo(cx0 + s2*S*(0.09*jw), nBot + S*0.05, cx0 + s2*S*(0.09*jw), mY + S*0.04);
    x.stroke();
  });

  if(L.beard){
    x.fillStyle = hairCss; x.globalAlpha = 0.42;
    x.beginPath(); x.ellipse(cx0, S*0.78, S*0.18*jw, S*0.14, 0, 0, Math.PI*2); x.fill();
    x.globalAlpha = 1;
    const brN = faceQ === "hi" ? 260 : faceQ === "mid" ? 120 : 50;
    for(let i=0;i<brN;i++){
      const px = cx0 + (Math.random()-0.5)*S*0.40*jw;
      const py = S*0.68 + Math.random()*S*0.22;
      x.fillStyle = "rgba(" + ((L.hair>>16)&255) + "," + ((L.hair>>8)&255) + "," + (L.hair&255) + ",0.4)";
      x.fillRect(px, py, 1.1, 1.7);
    }
  }

  /* pores — keep inside clip */
  const poreN = faceQ === "hi" ? 320 : faceQ === "mid" ? 140 : 60;
  for(let i=0;i<poreN;i++){
    x.fillStyle = "rgba(0,0,0," + (Math.random()*0.045) + ")";
    x.fillRect(cx0 - rx + Math.random()*rx*2, cy0 - ry + Math.random()*ry*2, 1.1, 1.1);
  }

  x.restore(); /* end oval clip */

  /* Feather to transparent so the dome dissolves into skull skin */
  const fade = x.createRadialGradient(cx0, cy0, S*0.22, cx0, cy0, S*0.48);
  fade.addColorStop(0, "rgba(0,0,0,1)");
  fade.addColorStop(0.58, "rgba(0,0,0,1)");
  fade.addColorStop(0.82, "rgba(0,0,0,0.45)");
  fade.addColorStop(1, "rgba(0,0,0,0)");
