  for(let y = 0; y < s; y++){
    const fy = y / s * cells, iy = Math.floor(fy), ty0 = fy - iy, ty = ty0 * ty0 * (3 - 2 * ty0);
    const y0 = (iy % cells) * cells, y1 = ((iy + 1) % cells) * cells;
    for(let x = 0; x < s; x++){
      const fx = x / s * cells, ix = Math.floor(fx), tx0 = fx - ix, tx = tx0 * tx0 * (3 - 2 * tx0);
      const x0 = ix % cells, x1 = (ix + 1) % cells;
      const a = g[y0 + x0] + (g[y0 + x1] - g[y0 + x0]) * tx;
      const b = g[y1 + x0] + (g[y1 + x1] - g[y1 + x0]) * tx;
