    GFX_PR = MODEST ? 0.62 : 0.75; GFX_EXPOSE = 1.0; GFX_HEMI = 1.0; GFX_SUN = 1.0;
    PEOPLE_CAST_SHADOW = false; SHADOW_SKIP = 0.24; SHADOW_PERIOD = 1/8;
  } else if(q === "balanced"){
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFShadowMap;   /* never Soft on balanced */
    if(sun){ sun.castShadow = true; sun.shadow.mapSize.set(512, 512); }
    GFX_PR = 1.1; GFX_EXPOSE = 1.0; GFX_HEMI = 1.0; GFX_SUN = 1.0;
    PEOPLE_CAST_SHADOW = false; SHADOW_SKIP = 0.20; SHADOW_PERIOD = 1/9;
  } else {
