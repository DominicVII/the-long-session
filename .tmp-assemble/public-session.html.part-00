    /* 20261030ag: realism. Pure white columns, facades and plaster read as toy plastic; real ones are sandstone and limewash.
       Greys that stood in for stone or laminate get a little warmth and the stone grain instead of a flat slab. */
    try{
      const hs = {}; m.color.getHSL(hs);
      if((metal || 0) < 0.3 && (rough === undefined ? 0.8 : rough) >= 0.5){
        if(hs.l > 0.80 && hs.s < 0.30){ m.color.lerp(new THREE.Color(0xdcc9a6), 0.38); kind = "stone"; }
        else if(hs.s < 0.10 && hs.l > 0.28){ m.color.lerp(new THREE.Color(0xa89a82), 0.14); if(kind === "paint" && hs.l > 0.45) kind = "stone"; }
      }
