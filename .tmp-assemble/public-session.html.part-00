  const v = gl.getShaderInfoLog(vs) || "", f = gl.getShaderInfoLog(fs) || "";
  SHADER_TROUBLE = (log + " " + v + " " + f).trim().slice(0, 300) || "unknown shader failure";
  if(G.gfx !== "simple"){
    G.gfx = "simple";
    G.simple = true;
    try{ applyQuality(); }catch(e){}
    try{ feed("This machine could not build one of the shaders — switched to simple graphics."); }catch(e){}
    try{ note("Graphics dropped to simple: " + SHADER_TROUBLE, true); }catch(e){}
  }
};
/* MAX OPT (local 2026-09-08+): when G.fullDetail, keep Best render detail (long LODs,
   full textures, soft shadows, people cast) while retaining cadence/frustum opts.
   Furniture props are groundGroup()'d so feet sit on y=0 with contact discs.
   Graphics quality: Best / Balanced / Simple. Crowd mode must never flip
   shadowMap.enabled (shader recompile stutter). */
let PEOPLE_CAST_SHADOW = false;
let _lastPR = -1;
function setPR(v){
  /* 20261030ag: look. Below 1x every door frame and sill stair-stepped (the jagged Exec door, antialias is off on modest machines); Best anywhere and Balanced on a full GPU never drop under native 1x. */
  try{ if(G && (G.gfx === "best" || (!MODEST && G.gfx !== "simple"))) v = Math.max(v, 1); }catch(e){}
