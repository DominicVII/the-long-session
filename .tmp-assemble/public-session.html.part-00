        renderer.shadowMap.type = THREE.PCFShadowMap;
        if(sun){ try{ if(sun.shadow.map){ sun.shadow.map.dispose(); sun.shadow.map = null; } }catch(e){} sun.shadow.mapSize.set(2048, 2048); }
        GFX_PR = 1.5; SHADOW_PERIOD = 1/12;
      }
    }
