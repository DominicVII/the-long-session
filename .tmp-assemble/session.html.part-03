/* while you chair a cabinet or council, a seated member you click is called on in the meeting, not taken aside */
{ const _ot = openTalk; openTalk = function(m){ try{ const S = sxdSession(); if(m && S && S.chairId === "you" && (S.kind === "cabinet_meeting" || S.kind === "governor_council") && (S.seats || []).some(x => String(x.personId) === String(m.id)) && window.onumSession && typeof window.onumSession.callon === "function"){ window.onumSession.callon(m.id); return; } }catch(e){} return _ot.apply(this, arguments); }; }
/* NEPTUNE-TALKREWORK BEGIN — 20261030b; owner gate 20261030d; More/Esc/draft/bottom desk 20261030g (JUPITER contract: SIT.on → sit; PROC.on → proc; truthy SSN or ONUM_SESSION.stage!=="idle" → session; sxdSession seated check as fallback): one conversation surface per mode (UI/presentation + safe gates only; JUPITER's engine untouched).
   Open talk: one pipeline (owner gate → existing chain → one opening), TALK.seq on every delayed line, a clean close that never leaves
   TALK.open stuck, one reply box (tkOwn → LiveTalk when up, offline otherwise), a Done (Esc) button, Live/Offline chip, portrait,
   secondary actions behind "More", duplicate lines dropped. Sessions: the floor desk is the one place to speak; the session view's own
   speak box steps aside while the desk is up; Pass / Interject / Raise hand; press-conference hands as a pick row; Space finishes lines. */
try{
  const TR = window.NEPTUNE_TALKREWORK = {live:null, liveAt:0, moreOpen:false};
  const sv = f => { try{ return f(); }catch(e){ return null; } };
  /* who owns the conversation right now. strict=true also counts any open sitting/procedure (for unsolicited greetings). */
