{ const _mk = lxMarkup; lxMarkup = function(b, quiet){ if(!quiet) return _mk.apply(this, arguments); const keep = new Map((G.members || []).map(m => [m, m.sway])); const r = _mk.call(this, b); keep.forEach((v, m) => { m.sway = v; }); return r; }; }
{ const _nb = nextBillOrQueued; nextBillOrQueued = function(){
