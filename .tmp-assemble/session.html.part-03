    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" id="cfYes">Vote to confirm</button><button type="button" class="btn btn--ghost" id="cfNo">Vote against</button><button type="button" class="btn btn--ghost" id="cfFight">Vote against, and work the undecided</button></div>';
