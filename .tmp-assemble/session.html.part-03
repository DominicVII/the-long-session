}
function wlWhy(m, t){ const S = wlStore(), k = wlKey(m, t), sp = (S.spent = S.spent || {})[k], w = S.why[k]; if(w && w.t !== sp) return w.t; try{ const re = t === G.you ? /^you\b/i : new RegExp("^(" + String(t.name).replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "|" + String(surname(t.name)).replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")\\b"); const e = (m.mem || []).filter(x => x && x.w < 0 && G.day - (x.d || 0) <= 30 && re.test(String(x.t)) && x.t !== sp).sort((u, v) => u.w - v.w)[0]; return e ? e.t : null; }catch(e){ return null; } }
function wlEngineState(st){ try{ const eco = G.eng && G.eng.eco; if(!eco || !eco.hh) return null; const H = eco.hh.filter(h => h.state === st); return H.length ? H.reduce((a, h) => a + h.stance, 0) / H.length : null; }catch(e){ return null; } }
function wlOptions(m){
  const S = wlStore(), o = [], amb = wlT(m, "ambition"), tmp = wlT(m, "temper"), loy = wlT(m, "loyalty"), dis = wlT(m, "discretion"), con = wlT(m, "conviction");
  const W = wlWorst(m), FN = W && W.t !== G.you ? (((S.feud || {})[[m.id, W.t.id].sort().join("~")] || {}).n || 0) : 0;
  if(W && W.r <= -15) o.push({k:"wrong", t:W.t, v:-W.r * (0.6 + tmp / 100) * Math.pow(0.6, Math.max(0, FN - 1)) + (W.t === G.you ? 6 : 0)});
  const C = wlCast().filter(x => x !== m && (m.allies || []).indexOf(x.id) < 0).map(x => ({x, s:wlFit(m, x) + wlRegard(m, x) / 2})).sort((a, b) => b.s - a.s)[0];
  if(C && C.s >= 15) o.push({k:"court", t:C.x, v:C.s * ((m.allies || []).length < 2 ? 1.2 : 0.4) * (amb / 60)});
  const mutual = (m.allies || []).map(id => byId(id)).filter(a => a && !a.gone && wlRegard(m, a) >= 15 && wlRegard(a, m) >= 15 && !a.bloc);
  if(!m.bloc && mutual.length >= 2) o.push({k:"bloc", v:30 + amb / 3});
  const ax = AXES.slice().sort((x, y) => Math.abs((m.pos || {})[y.k] || 0) - Math.abs((m.pos || {})[x.k] || 0))[0], strong = Math.abs((m.pos || {})[ax.k] || 0);
  const mine = (typeof hopStore === "function" ? hopStore() : []).some(b => b && b.sponsorId === m.id) || (G.bill && !G.bill.done && G.bill.sponsorId === m.id);
  const room = (typeof hopStore === "function" ? hopStore().length : 0) < 12;
  if(!mine && room && amb >= 50 && strong >= 40 && G.day - (S.at["f" + m.id] || -99) >= 30) o.push({k:"file", v:amb * 0.6 + strong * 0.3});
  const es = wlEngineState(m.state); if(es != null && G.eng && G.eng.st >= 2 && Math.abs(es) >= 35 && G.day - (S.at["e" + m.id] || -99) >= 21 && G.day - (S.at["eS" + m.state] || -99) >= 7) o.push({k:"engine", v:Math.abs(es) * 0.8 + con / 3, s:es});
