/* ══ 20261027d · WILL. Everyone in the building, and the Engine, acts on what they want, from what they know and what they hold.
   Nobody is handed a feud, a friend or a grudge: those come from what was actually done to them, and the record keeps it.
   Each night each member weighs what they could do (answer a wrong, seek an ally, build a bloc, file a bill, take on the Engine)
   and does the thing that matters most to them, or nothing. When two wills meet, the stronger force carries it, measured and
   not rolled: standing, allies, money, and the facts each side actually has. The one they act on answers in their own turn.
   The Engine does the same with its own wants, against Oversight, the charter and the members who push back. ══ */
function wlStore(){ if(!G.wl || G.wl.v !== 1) G.wl = {v:1, reg:{}, why:{}, urge:{}, gain:{}, at:{}, unrest:{}, n:0}; return G.wl; }
function wlKey(a, b){ return String(a && a.id != null ? a.id : a) + ">" + String(b && b.id != null ? b.id : b); }
function wlCast(){ return (G.members || []).filter(m => m && !m.gone && (!m.kind || m.kind === "member") && !m.machine && !(typeof FAITH_FROZEN === "function" && FAITH_FROZEN(m))); }
function wlT(m, k){ return ((m && m.traits) || {})[k] == null ? 50 : m.traits[k]; }
/* how one regards another: the standing tie between them, and what each has actually done to the other */
function wlRegard(a, b){
  if(!a || !b || a === b) return 0;
  if(b === G.you) return clamp((a.rel && a.rel.warmth) || 0, -100, 100);
  let base = 0; try{ base = tieOf(a, b).w || 0; }catch(e){}
  return clamp(base + (wlStore().reg[wlKey(a, b)] || 0), -100, 100);
}
function wlNote(a, b, d, why){
  if(!a || !b || a === b || !d || a === G.you) return; const S = wlStore(), k = wlKey(a, b);
  if(b === G.you){ try{ a.rel.warmth = clamp((a.rel.warmth || 0) + d, -100, 100); }catch(e){} }
  else S.reg[k] = clamp((S.reg[k] || 0) + d, -60, 60);
  if(why && d < 0) S.why[k] = {t:why, d:G.day};
  if(why) try{ remember(a, why, d, Math.abs(d) >= 4); }catch(e){}
}
function wlGain(m, n){ if(!m || m === G.you) return; const S = wlStore(); S.gain[m.id] = (S.gain[m.id] || 0) + n; }
function wlMeans(m){ return (m.influence || 0) + ((m.allies || []).length * 6) + Math.min(30, (m.warchest || 0) / 120) + (m.post ? 12 : 0); }
function wlFit(a, b){ let d = 0; for(const x of AXES) d += Math.abs(((a.pos || {})[x.k] || 0) - ((b.pos || {})[x.k] || 0)); return 50 - d / 4; }
function wlByName(n){ return n ? (G.members || []).find(m => m && m.name === n) || null : null; }
function wlSay(news, t, big){ const S = wlStore(); S.n++; try{ journal(t); }catch(e){} if(news && (S._newsDay !== G.day || S._news < 4)){ if(S._newsDay !== G.day){ S._newsDay = G.day; S._news = 0; } S._news++; news.push(t); } else { try{ if(big) feed(t, "news"); }catch(e){} } }
/* ── what was done to whom: the roll call, the amendments, the President's pen ── */
function wlAfterVote(){
  const s = G.statute && G.statute[0]; if(!s || s._wl) return; s._wl = true;
  const sp = wlByName(s.sponsor);
  if(sp && s.v){ Object.keys(s.v).forEach(id => { const x = byId(+id) || byId(id), v = s.v[id]; if(!x || x === sp || !v) return;
      if(v < 0) wlNote(sp, x, -3, surname(x.name) + " voted against my " + s.title + "."); else wlNote(sp, x, 2); }); }
  if(sp && s.yv) wlNote(sp, G.you, s.yv > 0 ? 3 : -4, s.yv > 0 ? null : "You voted against my " + s.title + ".");
  (s.amends || []).filter(a => a && a.adopted && a.by && /strike/.test(a.what || "")).forEach(a => { const x = wlByName(a.by); if(sp && x && x !== sp) wlNote(sp, x, -4, surname(x.name) + " moved to " + a.what + " of my " + s.title + ", and it carried."); });
  if(sp && s.fate === "carried") wlGain(sp, 25);
  if(s.v) Object.keys(s.v).forEach(id => { const x = byId(+id) || byId(id); if(x && s.v[id] && ((s.v[id] > 0) === (s.fate === "carried"))) wlGain(x, 2); });
}
function wlDeskDay(){
  if(!G.exec || !G.exec.you) return;
  (G.statute || []).slice(0, 20).forEach(s => { if(!s || !s.exec || s._wlDesk) return; s._wlDesk = true; const sp = wlByName(s.sponsor); if(!sp) return;
