function wlMemberDay(m, news){
  const S = wlStore(); if(G.day - (S.at[m.id] || -99) < 3) return null;
  const O = wlOptions(m), top = O[0]; if(!top) return null;
  const urge = S.urge[m.id] || 0; if(top.v + urge < 40){ S.urge[m.id] = urge + top.v * 0.1; return null; }
  S.urge[m.id] = 0; S.at[m.id] = G.day; const fn = WL_DEEDS[top.k]; if(!fn) return null;
  try{ return fn(m, top, news); }catch(e){ try{ console.warn("will", top.k, e); }catch(x){} return null; }
}
const WL_DEEDS = {
  wrong(m, o, news){
    const t = o.t; if(t === G.you){ if(!(G.rivals || []).some(r => !r.out && r.id === m.id)) wlCampStart(m, news); return "campaign"; }
    const why0 = wlWhy(m, t), sn = surname(m.name), tn = surname(t.name), S0 = wlStore(), pk = [m.id, t.id].sort().join("~"), F = (S0.feud = S0.feud || {})[pk] = S0.feud[pk] || {n:0, roots:{}};
    F.roots = F.roots || {}; const why = F.roots[m.id] || why0; if(!F.roots[m.id]) F.roots[m.id] = why0; F.n++;   /* each side keeps its own account of how it started */ F.last = G.day; (S0.spent = S0.spent || {})[wlKey(m, t)] = why0; S0.at["w" + t.id] = G.day; if(S0.reg[wlKey(m, t)] < 0) S0.reg[wlKey(m, t)] = Math.round(S0.reg[wlKey(m, t)] / 2); try{ (m.mem || []).forEach(e => { if(e && e.w < 0 && why && e.t === why) e.w = Math.round(e.w / 2); }); }catch(e){}
    const fm = wlMeans(m) + wlT(m, "temper") / 2, ft = wlMeans(t) + wlT(t, "discretion") / 3, margin = fm - ft;
    if(wlT(m, "temper") >= 55){
      if(margin > 0){ t.influence = clamp((t.influence || 0) - Math.min(4, 1 + margin / 12), 0, 100); wlGain(m, 6); }
      else m.influence = clamp((m.influence || 0) - 1, 0, 100);
      wlNote(t, m, -6 / F.n, sn + " went after me on the floor.");
      wlCast().forEach(x => { if(x === m || x === t) return; const a = wlRegard(x, m), b = wlRegard(x, t); if(Math.abs(a - b) >= 15) try{ tieShift(x, a > b ? t : m, -2, "took a side in " + sn + " and " + tn + "'s quarrel"); }catch(e){} });
      wlSay(news, sn + " took " + tn + " to task on the floor" + (why ? ", over what " + sn + " says started it: “" + why.replace(/\.$/, "") + "”" : "") + ". " + (margin > 0 ? tn + " had no good answer, and the room saw it." : tn + " gave as good as they got."));
      return "confront";
    }
