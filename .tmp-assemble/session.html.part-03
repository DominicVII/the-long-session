{ const _tk = ssnTick; ssnTick = function(){ try{ if(SSN && cabKind()){ if(SS2.hold && !baSayFocus()) SS2.hold = false; const st = ssnStage();
      if(st && st.id === "decisions"){ if(!SSN._baVote && !SSN._busy){ SSN._baDecAt = SSN._baDecAt || Date.now(); if(SSN.chairId !== "you" || Date.now() - SSN._baDecAt > 20000) baCallVote(); else if(!SSN._baHint){ SSN._baHint = 1; try{ note("Decisions: call the vote when you are ready (Pass also calls it)."); }catch(e){} } } return; }
      if(st && (st.id === "briefings" || st.id === "reports") && SSN.chairId === "you" && !(SSN.roundLeft || []).length && SSN.floorId == null && !(SSN._busy && Date.now() < SSN._busy)){ SSN._baIdle = SSN._baIdle || Date.now(); if(Date.now() - SSN._baIdle > 25000){ SSN._baIdle = 0; ssnNext(); return; } } else SSN._baIdle = 0; } }catch(e){}
  return _tk.apply(this, arguments); }; }

})(); /* 20261110bs: main IIFE close, moved below the ba block */
</script>


<script>
/* Neptune 20261021l: HUD layout manager (onumHud). Edge docks (left/right columns, top strip, bottom bar);
   panels stack in their dock and never overlap; centre (middle 50% x 60%) stays clear except modals the player opened.
   Every docked panel gets a collapse control and leaves a reopen tab. Always-on bottom bar in immersive: Say aloud + Cables. */
(function(){
  "use strict";
  if(window.onumHud) return;
  const GAP = 6, PAD = 8;
  /* dock: L/R/T/B; talk = compact talk row; chip = tiny control merged into the bottom bar */
  const REG = [
    {s:"#prompt", d:"R", n:"Prompt", noX:1},
    {s:"#hail", d:"R", n:"Wants a word", talk:1},
    {s:"#apToast", d:"R", n:"Stops you", talk:1},
    {s:"#kClock", d:"R", n:"Clock", noX:1, small:1},
    {s:"#sxDock", d:"R", n:"Meeting"},
    {s:"#feed", d:"R", n:"Feed"},
    {s:".hud", d:"L", n:"Place", noX:1, small:1},
    {s:"#aimsHud", d:"L", n:"Aims", noX:1, small:1},
    {s:"#clDock", d:"L", n:"Notices", noX:1, small:1},
    {s:".notices", d:"L", n:"Notices"},
    {s:"#cvLive", d:"L", n:"Room log", cap:150},
    {s:"#procBar", d:"L", n:"Procedure"},
    {s:"#tele", d:"L", n:"Status"},
    {s:"#job", d:"L", n:"Checklist"},
    {s:".quest,#quest,#questBox,#ckList", d:"L", n:"Checklist"},
    {s:".ach-toast", d:"T", n:"Toast"},
    {s:"#tipCard", d:"T", n:"Tip"},
    {s:"#ndFd", d:"B", n:"Floor desk"},
    {s:"#ltPill", chip:1}, {s:"#ltChatBtn", chip:1}, {s:"#dmBadge", chip:1}, {s:"#ndBuild", chip:1}
  ];
  const H = window.onumHud = {collapsed:{}, last:null};
  const css = document.createElement("style"); css.id = "hmCss";
  css.textContent = ".hm-col{display:none!important}" +
    ".hmX{position:absolute!important;top:2px!important;right:2px!important;z-index:5!important;width:20px;height:20px;line-height:16px;padding:0!important;margin:0!important;border:1px solid #c9a24a!important;border-radius:4px;background:#0d0f13!important;color:#f4f1e8!important;font:700 13px system-ui!important;cursor:pointer;pointer-events:auto!important;min-height:0!important}" +
    ".hm-p{pointer-events:auto!important}" +
    "#hmBar{position:fixed;left:8px;right:8px;bottom:6px;z-index:10050;display:flex;gap:6px;align-items:center;background:#0d0f13;color:#f4f1e8;border:1px solid #c9a24a;border-radius:8px;padding:4px 6px;font:13px system-ui,sans-serif;box-sizing:border-box}" +
    "#hmBar[hidden]{display:none}#hmBar input{flex:1;min-width:80px;background:#1b1f27;color:#fff;border:1px solid #5a6474;border-radius:5px;padding:5px 8px;font:13px system-ui}" +
    "#hmBar button,.hmTab{background:#2b333d;color:#fff;border:1px solid #c9a24a;border-radius:5px;padding:4px 8px;font:600 12px system-ui;cursor:pointer;white-space:nowrap}" +
    "#hmBar .hmChips{display:flex;gap:4px;align-items:center;flex-wrap:nowrap;overflow:hidden}#hmBar .hmChips>*{position:static!important;transform:none!important;margin:0!important}" +
    "#hmBar.hm-desk #hmSayWrap{display:none}#hmSayWrap{display:flex;flex:1;gap:6px;align-items:center;min-width:0}" +
    ".hm-talk{display:flex!important;gap:8px;align-items:center;font-size:12px!important;padding:6px 26px 6px 6px!important}" +
    ".hm-talk .hmPort{flex:none;width:40px;height:40px;border-radius:50%;border:1px solid #c9a24a;background:#2a2f3a;color:#fff;font:700 15px system-ui;display:flex;align-items:center;justify-content:center;overflow:hidden}" +
    ".hm-talk .hmPort canvas{width:40px;height:40px}.hm-talk .hmBody{flex:1;min-width:0}";
  document.head.appendChild(css);
  const vis = e => { if(!e || !e.isConnected || e.hidden || e.classList.contains("hm-col")) return false; const cs = getComputedStyle(e); if(cs.display === "none" || cs.visibility === "hidden") return false; const r = e.getBoundingClientRect(); return r.width > 1 && r.height > 1; };
  const set = (e, k, v) => { if(e.style.getPropertyValue(k) !== v || e.style.getPropertyPriority(k) !== "important") e.style.setProperty(k, v, "important"); };
  const gG = () => { try{ return window.NEPTUNE && typeof NEPTUNE.debug === "function" ? NEPTUNE.debug().G : null; }catch(e){ return null; } };
  const inGame = () => { const g = gG(); return !!(g && g.you && g.room); };
  /* ----- bottom bar ----- */
  let bar = null, tabs = null, chips = null;
  function say(text){
    text = String(text || "").trim(); if(!text) return false;
    try{ const S = window.onumSession; if(S && typeof S.speak === "function" && (window.ONUM_SESSION ? window.ONUM_SESSION.open !== false : true) && document.getElementById("ndFd")){ S.speak(text); return true; } }catch(e){}
    try{ const wi = document.getElementById("wireIn"), ws = document.getElementById("wireSend"); if(wi && ws){ wi.value = text; ws.click(); return true; } }catch(e){}
    try{ if(typeof wireSend === "function"){ const wi = document.getElementById("wireIn"); if(wi) wi.value = text; wireSend(); return true; } }catch(e){}
    return false;
  }
  H.say = say;
  function cables(){ try{ if(typeof dmToggle === "function"){ dmToggle(true); return; } }catch(e){} try{ const b = document.getElementById("dmBadge"); if(b) b.click(); }catch(e){} }
  H.cables = cables;
  function mkBar(){
    if(bar && bar.isConnected) return;
    bar = document.createElement("div"); bar.id = "hmBar"; bar.className = "hm-p";
    bar.innerHTML = '<span id="hmSayWrap"><b style="white-space:nowrap">Say aloud</b><input id="hmSay" type="text" maxlength="400" autocomplete="off" placeholder="Speak to the room, or whoever is near (Enter)"><button type="button" id="hmSayGo">Say</button></span>' +
      '<button type="button" id="hmCab" title="Cables and messages">\u2709 Cables</button><span class="hmTabs"></span><span class="hmChips"></span>';
    document.body.appendChild(bar); tabs = bar.querySelector(".hmTabs"); chips = bar.querySelector(".hmChips");
    const inp = bar.querySelector("#hmSay");
    const go = () => { if(say(inp.value)){ inp.value = ""; } else { inp.placeholder = "Nobody can hear you here yet."; } };
    bar.querySelector("#hmSayGo").onclick = go; bar.querySelector("#hmCab").onclick = cables;
    const stop = e => { e.stopPropagation(); };
    inp.addEventListener("keydown", e => { e.stopPropagation(); if(e.key === "Enter"){ e.preventDefault(); go(); } else if(e.key === "Escape"){ inp.blur(); } });
    inp.addEventListener("keyup", stop); inp.addEventListener("keypress", stop);
  }
  /* Ctrl/Meta combos (copy, paste, select all, undo...) in any text field: let the browser have them, no game handler sees them. */
  const editable = t => t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
  window.addEventListener("keydown", e => { if((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey && e.key !== "Enter" && editable(e.target)) e.stopImmediatePropagation(); }, true);
  /* ----- collapse/reopen ----- */
  function addX(e, r){
    if(r.noX || e.querySelector(":scope>.hmX")) return;
    if(getComputedStyle(e).position === "static") set(e, "position", "fixed");
    const x = document.createElement("button"); x.type = "button"; x.className = "hmX"; x.textContent = "\u2013"; x.title = "Collapse " + r.n + " (reopen from the bar)";
    x.onclick = ev => { ev.stopPropagation(); collapse(e, r); };
    e.appendChild(x);
  }
  function collapse(e, r){ e.classList.add("hm-col"); const k = r.s; H.collapsed[k] = r.n; layout(); }
  H.collapse = sel => { const r = REG.find(q => q.s === sel); const e = r && document.querySelector(r.s); if(e) collapse(e, r); };
  H.reopen = sel => { document.querySelectorAll(sel).forEach(e => e.classList.remove("hm-col")); delete H.collapsed[sel]; layout(); };
  function drawTabs(){
    if(!tabs) return; const want = Object.keys(H.collapsed).filter(s => document.querySelector(s));
    const key = want.join("|"); if(tabs.dataset.k === key) return; tabs.dataset.k = key; tabs.innerHTML = "";
    want.forEach(s => { const b = document.createElement("button"); b.type = "button"; b.className = "hmTab"; b.textContent = "\u25B8 " + H.collapsed[s]; b.title = "Reopen"; b.onclick = () => H.reopen(s); tabs.appendChild(b); });
  }
  /* ----- compact talk rows with a portrait ----- */
  function talkify(e){
    if(e.querySelector(":scope>.hmPort")) return;
    const txt = (e.innerText || "").trim(); if(!txt) return;
    e.dataset.hmT = "1"; e.classList.add("hm-talk");
    const id = e.dataset.npc; let port = document.createElement("span"); port.className = "hmPort";
    try{ if(id != null && window.onumFamilyTree && typeof onumFamilyTree.portrait === "function"){ const c = onumFamilyTree.portrait(id, null, 80); if(c) port.appendChild(c); } }catch(x){}
    if(!port.firstChild){ const nm = e.dataset.name || txt.split(/\s+/).slice(0, 2).join(" "); port.textContent = nm.split(/\s+/).map(w => w[0] || "").join("").slice(0, 2).toUpperCase(); }
    const body = document.createElement("div"); body.className = "hmBody"; while(e.firstChild) body.appendChild(e.firstChild);
    e.appendChild(port); e.appendChild(body);
  }
  /* ----- layout ----- */
  function place(e, o){
    set(e, "position", "fixed"); set(e, "transform", "none"); set(e, "margin", "0"); set(e, "box-sizing", "border-box");
    set(e, "left", o.left == null ? "auto" : o.left + "px"); set(e, "right", o.right == null ? "auto" : o.right + "px");
    set(e, "top", o.top == null ? "auto" : o.top + "px"); set(e, "bottom", o.bottom == null ? "auto" : o.bottom + "px");
    if(o.w != null){ set(e, "width", o.w + "px"); set(e, "max-width", o.w + "px"); }
    if(o.mh != null){ set(e, "max-height", o.mh + "px"); set(e, "overflow", "auto"); }
    e.classList.add("hm-p");
  }
  function layout(){
    const W = innerWidth, Ht = innerHeight;
    const game = inGame();
    mkBar();
    bar.hidden = !game;
    const desk = document.getElementById("ndFd"); bar.classList.toggle("hm-desk", !!(desk && vis(desk)));
    /* chips into the bar */
    REG.filter(r => r.chip).forEach(r => { const e = document.querySelector(r.s); if(e && e.parentElement !== chips && game) chips.appendChild(e); });
    drawTabs();
    const colW = Math.max(160, Math.floor(W * 0.25) - PAD * 2), bandB = Math.max(Math.round(Ht * 0.2), 60);
    const barH = game && vis(bar) ? bar.getBoundingClientRect().height + 6 : 0;
    const bottomLimit = Ht - Math.max(bandB, barH + 4);
    const out = {L:[], R:[], T:[], B:[]};
    for(const r of REG){ if(r.chip) continue; document.querySelectorAll(r.s).forEach(e => { if(e.closest("#hmBar") || (e.id !== "sxDock" && e.closest("#sxDock")) || !vis(e)) return; const dk = (e.id === "sxDock" && desk && vis(desk) && e.contains(desk)) ? "B" : r.d; /* 20261030h: desk up = bottom band */ if(out[dk].some(x => x.e === e || x.e.contains(e))) return; out[dk].push({e, r}); }); }
    const stack = (list, side) => {
      let y = PAD;
      { const tb = document.getElementById("uiToolbar"); if(tb && vis(tb)) y = Math.max(y, Math.round(tb.getBoundingClientRect().bottom) + GAP); }   /* below the toolbar, never over it */
      for(const {e, r} of list){
        if(r.talk) talkify(e); addX(e, r);
        const room = bottomLimit - y; if(room < 28){ collapse(e, r); continue; }
        const o = {top:y, w:colW, mh:r.cap ? Math.min(room, r.cap) : room}; if(side === "L") o.left = PAD; else o.right = PAD;
        if(r.small){ o.w = null; set(e, "max-width", colW + "px"); }
        place(e, o); y += Math.min(e.getBoundingClientRect().height, room) + GAP;
      }
    };
    stack(out.L, "L"); stack(out.R, "R");
    /* top strip: between the columns, above the centre zone */
    let x = Math.floor(W * 0.25) + PAD; const tW = Math.floor(W * 0.5) - PAD * 2, tH = Math.floor(Ht * 0.2) - PAD;
    let ty = PAD;
    for(const {e, r} of out.T){ addX(e, r); place(e, {left:x, top:ty, w:tW, mh:Math.max(24, tH - ty)}); ty += e.getBoundingClientRect().height + GAP; }
    /* bottom band: the floor desk, merged with the bar (bar shows only Cables + tabs + chips while the desk is up) */
    for(const {e, r} of out.B){
      addX(e, r);
      /* 20261030h: full-width band sitting just above the Say aloud bar and any fixed strip along the bottom (the wire); max 20vh */
      let sTop = Ht; [bar, ...document.querySelectorAll("body > *")].forEach(s => { try{ if(!s || s === e || s.contains(e) || e.contains(s) || s.hidden) return; const cs = getComputedStyle(s); if(cs.display === "none" || cs.visibility === "hidden" || cs.position !== "fixed") return;
        const q = s.getBoundingClientRect(); if(q.height > 0 && q.height < 90 && q.width > W * 0.5 && q.top > Ht * 0.7) sTop = Math.min(sTop, q.top); }catch(x){} });
      place(e, {left:PAD, right:PAD, bottom:Math.max(6, Math.round(Ht - sTop + GAP)), mh:Math.max(150, Math.round(Ht * 0.24))});
      set(e, "width", "auto"); set(e, "max-width", "none"); set(e, "overflow", "hidden");
    }
    if(bar){ bar.style.removeProperty("left"); bar.style.removeProperty("right"); }
    H.last = {W, Ht, L:out.L.length, R:out.R.length, T:out.T.length, B:out.B.length};
  }
  H.layout = layout;
  /* overlap/centre check (QA hook) */
  H.check = function(){
    const W = innerWidth, Ht = innerHeight, cz = {l:W * .25, t:Ht * .2, r:W * .75, b:Ht * .8};
    const els = [];
    REG.forEach(r => document.querySelectorAll(r.s).forEach(e => { if(vis(e) && !e.closest("#hmBar") && !els.some(x => x.e === e)) els.push({e, n:r.s}); }));
    if(bar && vis(bar)) els.push({e:bar, n:"#hmBar"});
    const R = els.map(x => { const b = x.e.getBoundingClientRect(); return {n:x.n, l:b.left, t:b.top, r:b.right, b:b.bottom}; });
    const hit = (a, b) => a.l < b.r - 0.5 && b.l < a.r - 0.5 && a.t < b.b - 0.5 && b.t < a.b - 0.5;
    const overlaps = [], centre = [];
    for(let i = 0; i < R.length; i++){ if(hit(R[i], cz)) centre.push(R[i].n); for(let j = i + 1; j < R.length; j++) if(hit(R[i], R[j])) overlaps.push(R[i].n + " x " + R[j].n); }
    return {panels:R.map(r => r.n + "@" + [r.l, r.t, r.r, r.b].map(Math.round).join(",")), overlaps, centre, ok:!overlaps.length && !centre.length};
  };
  let q = 0; const kick = () => { if(q) return; q = requestAnimationFrame(() => { q = 0; try{ layout(); }catch(e){} }); };
  addEventListener("resize", kick);
  try{ new MutationObserver(kick).observe(document.body, {childList:true}); }catch(e){}
  try{ ["prompt", "hail", "procBar", "tipCard"].forEach(id => { const e = document.getElementById(id); if(e) new MutationObserver(kick).observe(e, {attributes:true, attributeFilter:["hidden", "class"]}); }); }catch(e){}
  setInterval(() => { try{ layout(); }catch(e){} }, 400);
  kick();
})();

/* 20261106d: each meeting button does its own job. The person you click is the one who speaks.
   Press asks the one already up for the figure. Challenge is answered by somebody on the other side.
   Pass moves on and stays quiet. Next calls the next person who has not spoken. */
(function(){
  const st = document.createElement("style"); st.id = "mtRunCss";
  st.textContent = "#mtBar{position:fixed;left:6px;right:6px;z-index:10060;display:none;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;padding:6px;background:#121419;color:#f4f1e8;border:2px solid #c9a24a;border-radius:8px;box-shadow:0 4px 16px #000}" +
    "#mtBar.on{display:grid}#mtBar .mt-s{grid-column:1/-1;font:600 11px/1.2 system-ui;color:#ffe08a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}" +
    "#mtBar button{min-height:34px;max-height:44px;padding:4px 6px;background:#2a2d35;color:#fff;border:1px solid #c9a24a;border-radius:6px;font:700 11px/1.15 system-ui;cursor:pointer;overflow:hidden}" +
    "#mtBar button.mt-go{background:#ffe08a;color:#111;border-color:#ffe08a}" +
    "#ndFd .fd-acts .mt-s{flex:1 0 100%;color:#ffe08a;font:600 12px/1.3 system-ui;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}" +
    "#ndFd .fd-acts button.mt-go{background:#ffe08a;color:#111;border-color:#ffe08a}" +
    "body.mt-on #ndSess .nsx-seat{cursor:pointer}body.mt-on #ndSess .nsx-q li{cursor:pointer}" +
    "body.mt-on #ndSess .nsx-acts{display:none!important}" +
    "#mtOne{display:none}#mtOne.on{display:flex;flex-direction:column;position:fixed;left:8px;right:8px;bottom:8px;z-index:10070;max-height:min(78vh,640px);overflow:auto;background:#121419;color:#f4f1e8;border:2px solid #c9a24a;border-radius:10px;box-shadow:0 8px 28px #000;padding:8px 10px 10px;font:14px/1.35 system-ui,sans-serif}" +
    "#mtOne .mt-head{display:flex;align-items:center;justify-content:space-between;gap:8px;font:700 16px Georgia,serif;color:#ffe08a;text-transform:capitalize;margin:0 0 4px;position:sticky;top:0;z-index:3;background:#121419}" +
    "#mtOne .mt-title{flex:1;min-width:0}" +
    "#mtOne .mt-x,#onumX{width:44px;height:44px;flex:none;border:2px solid #c9a24a;background:#2a2d35;color:#ffe08a;border-radius:8px;font:700 22px/1 system-ui;cursor:pointer}" +
    "#onumX{position:fixed;top:max(8px, env(safe-area-inset-top));right:max(8px, env(safe-area-inset-right));z-index:2147483000;width:48px;height:48px}" +
    "#onumX[hidden]{display:none!important}" +
    "#mtOne .mt-now{margin:0 0 6px}#mtOne .mt-now b{color:#ffe08a}#mtOne .mt-seats{display:flex;flex-wrap:wrap;gap:4px}" +
    "#mtOne .mt-seat{width:34px;height:34px;border-radius:6px;border:2px solid #000;color:#fff;font:700 11px system-ui;cursor:pointer;padding:0}" +
    "#mtOne .mt-seat.on{outline:3px solid #ffe08a;box-shadow:0 0 10px #ffe08a}#mtOne .mt-seat.you{border-color:#fff}" +
    "#mtOne .mt-log{max-height:88px;overflow:auto;background:#0b0d11;border-radius:6px;padding:4px 6px;margin:6px 0;font-size:12.5px}#mtOne .mt-log b{color:#ffe08a}#mtOne .mt-empty{color:#9a9384}" +
    "#mtOne .mt-acts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px}#mtOne .mt-acts .mt-s{grid-column:1/-1;color:#ffe08a;font:600 12px/1.3 system-ui}" +
    "#mtOne .mt-acts button{min-height:40px;background:#2a2d35;color:#fff;border:1px solid #c9a24a;border-radius:6px;font:700 12px/1.15 system-ui;cursor:pointer}" +
    "#mtOne .mt-acts button.mt-go{background:#ffe08a;color:#111;border-color:#ffe08a}" +
    "#mtOne .mt-say{display:flex;gap:6px;margin-top:6px}#mtOne .mt-say textarea{flex:1;min-height:44px;background:#fff;color:#111;border:2px solid #c9a24a;border-radius:6px;padding:6px;font:15px system-ui;resize:vertical}" +
    "#mtOne .mt-speak{background:#ffe08a;color:#111;border:0;border-radius:6px;font:700 14px system-ui;padding:0 14px;cursor:pointer}" +
    "#mtOne .mt-cue{background:#2b2410;border:1px solid #ffe08a;border-radius:6px;padding:6px;margin:4px 0;color:#fff}#mtOne .mt-cue b{color:#ffe08a}" +
    "#mtOne .mt-next{font-size:12.5px;color:#e8e2d0;margin:2px 0 4px}#mtOne .mt-next b{color:#ffe08a}#mtOne .mt-seats{max-height:108px;overflow:auto}" +
    "body.mt-one #ndFd,body.mt-one #mtBar,body.mt-one #ndSess,body.mt-one #sxDock{display:none!important}" +
    ".proc{max-height:38vh;overflow:hidden}.proc__opts{display:grid;grid-template-columns:1fr 1fr;gap:4px}.proc__h i{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}";
  document.head.appendChild(st);
  const bar = document.createElement("div"); bar.id = "mtBar"; bar.setAttribute("role","toolbar"); bar.setAttribute("aria-label","Run the meeting");
  document.body.appendChild(bar);
  let others = false, note = "", sig = "";
  const sv = f => { try{ return f(); }catch(e){ return null; } };
  const youId = x => x === "you" || (G.you && String(x) === String(G.you.id));
  const person = id => { if(id == null || id === "" || youId(id)) return youId(id) ? G.you : null; return sv(() => byId(isNaN(+id) ? id : +id)); };
  const sn = p => { const n = p && p.name ? String(p.name) : ""; const b = n.split(/\s+/).filter(Boolean); return b.length ? b[b.length - 1] : "them"; };
  function live(){
    const S = window.ONUM_SESSION; if(S && S.stage !== "idle" && S.open !== false && (S.kind || S.floorId != null || (S.seats && S.seats.length) || S.chairId != null)) return S;
    try{
      if(typeof PROC !== "undefined" && PROC && PROC.on && PROC.e){
        const people = [].concat(PROC.order || [], PROC.chair ? [PROC.chair] : [], PROC.wit && PROC.wit.member ? [PROC.wit.member] : []).filter(Boolean);
        const seen = {};
        const seats = [];
        people.forEach(p => { if(!p || p.id == null || seen[p.id] || p === G.you) return; seen[p.id] = 1; seats.push({personId:p.id}); });
        const sp = PROC.speaker;
        return {kind:PROC.e.k, stage:PROC.phase || "open", floorId: sp === G.you ? "you" : (sp && sp.id), chairId: PROC.chair && PROC.chair.id, seats, queue:[], _proc:true};
      }
    }catch(e){}
    return null;
  }
  function seats(S){ return (S && S.seats || []).map(x => x && (x.personId != null ? x.personId : x.id)).filter(id => id != null && !youId(id)); }
  function bill(){ return (G.bill && !G.bill.done) ? G.bill : null; }
  function side(p){ const b = bill(); if(!b || !p) return ""; try{ return memberVote(p, b) < 0 ? "no" : "aye"; }catch(e){ return ""; } }
  function town(p){ try{ const bio = bioOf(p); return (bio && bio.town) || p.state || "home"; }catch(e){ return (p && p.state) || "home"; } }
  function heard(id){ return SSN && (SSN._mtSaid || []).some(x => String(x) === String(id)); }
  function mark(id){ if(!SSN || id == null) return; SSN._mtSaid = SSN._mtSaid || []; if(!heard(id)) SSN._mtSaid.push(id); const L = seats(live()); const i = L.findIndex(x => String(x) === String(id)); if(i >= 0) SSN._mtAt = i + 1; }
  function up(){ const S = live(); if(!S || S.floorId == null || youId(S.floorId)) return null; return person(S.floorId); }
  function nextFresh(){
    const S = live(); const L = seats(S); if(!L.length) return null;
    const start = (SSN && SSN._mtAt) || 0;
    for(let n = 0; n < L.length; n++){ const id = L[(start + n) % L.length]; if(!heard(id)) return id; }
    return null;
  }
  function show(p, line){
    if(!p || !line) return;
    try{ if(SSN){ SSN.floorId = p === G.you ? "you" : p.id; ssnPublish(); } }catch(e){}
    if(p !== G.you){ try{ speakAt(p, line); }catch(e){} }
    try{ const FD = window.NEPTUNE_FLOORDESK, D = document.getElementById("ndFd"); if(FD && D && !D.hidden) FD.line(p === G.you ? "you" : p.id, line); }catch(e){}
    try{ tlog(p === G.you ? "You" : p.name, line, p === G.you ? "you" : "talk"); }catch(e){}
    try{ appendFloor(p === G.you ? "You" : sn(p), line); }catch(e){}
    if(p !== G.you) mark(p.id);
    try{ if(typeof PROC !== "undefined" && PROC && PROC.on) PROC.speaker = p; }catch(e){}
    note = sn(p) + " is speaking";
    sig = "";
  }
  function kindOf(){ const S = live(); return (S && S.kind) || ""; }
  function askLine(p, kind){
    const b = bill(), topic = b ? b.title : "today's business", outlet = (p && (p.outlet || p.role)) || "the paper";
    if(kind === "press_conference" || kind === "presser" || (p && p.kind === "press")) return pick([
      outlet + ". On " + topic + ", what is the answer for the record?",
      "Who pays for this, and when do the districts see it?",
      "Will you stand by that tomorrow, or is this only today's line?",
      "The places already hurting want a number, not a mood."
    ]);
    if(kind === "hearing" || kind === "committee_hearing") return "For the record: what did you know about " + topic + ", and what does it cost " + town(p) + "?";
    if(kind === "caucus") return "In this room, not on the floor: I am a " + (side(p) || "undecided") + (b ? " on " + b.title : "") + ". " + town(p) + " is who I face after.";
    if(kind === "crisis") return "This cannot wait on a tidy bill. " + town(p) + " needs an answer today" + (b ? " on " + b.title : "") + ", and I am a " + (side(p) || "no") + " until I hear the cost.";
    if(kind === "townhall") return "I came from " + town(p) + " to ask what you will do" + (b ? " about " + b.title : "") + ". I want a yes or a no I can take home.";
    return "";
  }
  function callOn(id){
    const kind = kindOf();
    if(kind === "press_conference" && window.onumSession && typeof window.onumSession.callon === "function"){
      const ok = window.onumSession.callon(id);
      if(ok){ note = "Called. They ask, then the floor is yours to answer."; sig = ""; return; }
    }
    if((kind === "cabinet_meeting" || kind === "governor_council") && typeof cabCallOn === "function"){
      cabCallOn(id); note = "Called. They speak from the office they hold."; sig = ""; return;
    }
    const p = person(id); if(!p || p === G.you){ note = "Pick someone else, not yourself."; sig = ""; return; }
    const b = bill(), sd = side(p);
    let line = askLine(p, kind);
    if(!line){ try{ const N = (b && typeof natureOf === "function") ? natureOf(p, b) : null; if(N && N.line && !(typeof heardBefore === "function" && heardBefore(N.line))) line = N.line; }catch(e){} }
    if(!line){ try{ line = procLineFor(p, {k: kind === "hearing" || kind === "committee_hearing" ? "hearing" : "floor"}); }catch(e){} }
    if(!line) line = (b && sd) ? ("I am a " + sd + " on " + b.title + ". I speak for " + town(p) + ".") : (sn(p) + " takes the floor for " + town(p) + ".");
    try{ if(typeof rememberLine === "function") rememberLine(line); }catch(e){}
    show(p, line);
  }
  function press(){
    const kind = kindOf(), p = up();
    if(kind === "press_conference" || kind === "presser" || (p && p.kind === "press")){
      if(!p){ note = "Call on a reporter first. Then press them for the follow-up."; sig = ""; return; }
      show(p, "Follow-up. The first answer was not a number. " + (bill() ? bill().title + ": " : "") + "who pays, and what fails if you do nothing?");
      return;
    }
    if((kind === "cabinet_meeting" || kind === "governor_council") && window.onumSession && typeof window.onumSession.press === "function"){
      window.onumSession.press(p && p.id); note = "Pressed for the figure."; sig = ""; return;
    }
    if(!p){ note = "Call on someone first. Press is for the person already up."; sig = ""; return; }
    const b = bill(), sd = side(p);
    const fig = (b && b.cost) ? (" The figure is " + money(b.cost) + ".") : "";
    let human = "";
    try{ const N = (b && typeof natureOf === "function") ? natureOf(p, b) : null;
      if(N && N.kind === "herd") human = " I went with the room. That is the specific truth.";
      else if(N && N.kind === "apart") human = " I broke from the room on purpose.";
      else if(N && N.kind === "fear") human = " My seat is close. That is why I am not standing alone.";
      else if(N && N.kind === "spite") human = " I do not like who asked. That is in the vote.";
      else if(N && N.kind === "for-you") human = " Part of this vote is you.";
      else if(N && N.kind === "tired") human = " I am not fighting the room tonight.";
    }catch(e){}
    show(p, "You pressed for the specific point. My vote is " + (sd || "unchanged") + (b ? " on " + b.title : "") + "." + fig + " " + town(p) + " is who I answer to." + human);
  }
  function challenge(){
    const kind = kindOf(), p = up();
    if(kind === "press_conference" || kind === "presser"){
      const other = seats(live()).map(person).filter(o => o && o !== p && o.kind === "press")[0] || seats(live()).map(person).filter(o => o && o !== p)[0];
      if(!other){ note = "Nobody else in the gallery to challenge it."; sig = ""; return; }
      show(other, "A different paper. " + (p ? sn(p) + " asked the easy one. " : "") + "Answer this: what do you refuse to do, and who is hurt by that refusal?");
      return;
    }
    if((kind === "cabinet_meeting" || kind === "governor_council") && window.onumSession && typeof window.onumSession.challenge === "function"){
      window.onumSession.challenge(p && p.id); note = "Challenged. They answer the objection."; sig = ""; return;
    }
    if(!p){ note = "Call on someone first. A challenge needs someone to answer."; sig = ""; return; }
    const b = bill(); const sd = b ? memberVote(p, b) : 0;
    const opp = seats(live()).map(person).filter(o => o && o !== p && (!b || memberVote(o, b) !== sd))[0];
    if(!opp){ note = "Nobody on the other side is in the room."; sig = ""; return; }
    const od = side(opp);
    let mine = "";
    try{ const N = (b && typeof natureOf === "function") ? natureOf(opp, b) : null; if(N && N.line) mine = " " + N.line; }catch(e){}
    show(opp, "I challenge " + sn(p) + ". I am a " + (od || "no") + (b ? " on " + b.title : "") + " and " + sn(p) + " is a " + (side(p) || "the other way") + "." + (mine || " That is the disagreement."));
  }
  function order(){
    show(G.you, "Point of order. The member is not on the question before this room.");
    try{ const O = window.onumSession; if(O && O.pointOfOrder) O.pointOfOrder(); }catch(e){}
    try{ if(SSN && SSN.floorId && !youId(SSN.floorId)){ /* the ruling may already have cleared it */ } }catch(e){}
    note = "Point of order. The floor is yours for that, not theirs."; sig = "";
  }
  function chair(){
    const S = live(); const c = S && person(S.chairId);
    if(!c || c === G.you){ show(G.you, "The chair: one member at a time. Call the next name when you are ready."); return; }
    show(c, "The chair will hear one member at a time. " + (up() ? sn(up()) + " has been heard." : "The floor is open.") + " Call the next. I am not yielding this chair to repeat them.");
  }
  function endSitting(){
    try{ window.ONUM_SIT_HELD = (typeof G !== "undefined" && G && G.room) || "held"; }catch(e){ window.ONUM_SIT_HELD = "held"; }
    try{
      if(typeof SSN !== "undefined" && SSN){ let n = 0; while(SSN && ssnStage() && ssnStage().id !== "adjourn" && n < 8){ ssnNext(); n++; } ssnClose(); }
      if(typeof PROC !== "undefined" && PROC && PROC.on){ PROC.on = false; PROC.speaker = null; const pb = document.getElementById("procBar"); if(pb) pb.hidden = true; }
      const d = document.getElementById("ndFd"); if(d) d.hidden = true;
    }catch(e){}
    note = "The sitting is closed."; sig = "";
  }
  function pass(){
    try{ if(SSN){ const id = SSN.floorId; if(id && !youId(id)) mark(id); SSN.floorId = null; ssnPublish(); } }catch(e){}
    note = "Passed. Nobody else speaks until you call the next."; sig = "";
  }
  function interject(){
    let line = ""; try{ const ta = document.querySelector("#mtOne textarea"); line = ta && ta.value.trim(); if(ta) ta.value = ""; }catch(e){}
    show(G.you, line || "From my seat: that is not the question, and I am not giving the floor to the same member to say it again.");
  }
  function next(){
    const id = nextFresh();
    if(id == null){ note = "Everyone here has been called. Open Call on others to hear one again."; sig = ""; return; }
    callOn(id);
  }
  function btn(label, go, hot, title){
    const b = document.createElement("button"); b.type = "button"; b.textContent = label; if(title) b.title = title;
    if(hot) b.className = "mt-go";
    b.onclick = ev => { ev.preventDefault(); ev.stopPropagation(); try{ go(); }catch(e){} paint(true); };
    return b;
  }
  const esc = s => String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&":"&"+"amp;", "<":"&"+"lt;", ">":"&"+"gt;", '"':"&"+"quot;", "'":"\x26#39;"})[c]);
  function colOf(p){ try{ if(p && typeof partyColorNum === "function"){ const n = partyColorNum(p.party); if(n != null) return "#" + (Number(n) >>> 0).toString(16).padStart(6,"0").slice(-6); } }catch(e){} return "#3a3f4b"; }
  function iniOf(p, id){ const n = youId(id) ? "You" : (p && p.name) || "?"; return (String(n).match(/\b\w/g) || ["?"]).slice(0, 2).join("").toUpperCase(); }
  function shutMeet(){
    try{ window.ONUM_SIT_HELD = (typeof G !== "undefined" && G && G.room) || "held"; }catch(e){ window.ONUM_SIT_HELD = "held"; }
    try{ endSitting(); }catch(e){}
    try{ if(typeof leaveSittingQuiet === "function") leaveSittingQuiet(); }catch(e){}
    try{ window.ONUM_SESSION = {stage:"idle"}; }catch(e){}
    document.body.classList.remove("mt-one", "mt-on", "in-session");
    const P0 = document.getElementById("mtOne"); if(P0) P0.classList.remove("on");
    note = "You left the sitting."; sig = "";
  }
  function one(){
    let P = document.getElementById("mtOne");
    if(P && P.querySelector(".mt-acts")) return P;
    if(P) P.remove();
    P = document.createElement("div"); P.id = "mtOne"; P.setAttribute("role","region"); P.setAttribute("aria-label","Meeting");
    P.innerHTML = '<div class="mt-head"><span class="mt-title"></span><button type="button" class="mt-x" title="Close this sitting">\u00d7</button></div><div class="mt-floor"></div><div class="mt-log"></div><div class="mt-acts"></div><div class="mt-say"><textarea rows="2" placeholder="Say it to the room."></textarea><button type="button" class="mt-speak">Speak</button></div>';
    const ta = P.querySelector("textarea");
    ["keydown","keyup","keypress"].forEach(k => ta.addEventListener(k, e => e.stopPropagation()));
    const go = () => {
      const t = (ta.value || "").trim(); if(!t) return; ta.value = "";
      try{ const O = window.onumSession; if(O && typeof O.speak === "function") O.speak(t); else show(G.you, t); }catch(e){ try{ show(G.you, t); }catch(e2){} }
      try{ const FD = window.NEPTUNE_FLOORDESK; if(FD && FD.line) FD.line("you", t, false); }catch(e){}
      note = "You said it."; sig = ""; paint(true);
    };
    P.querySelector(".mt-speak").onclick = ev => { ev.preventDefault(); go(); };
    P.querySelector(".mt-x").onclick = ev => { ev.preventDefault(); ev.stopPropagation(); shutMeet(); };
    ta.addEventListener("keydown", e => { if(e.key === "Enter" && !e.shiftKey){ e.preventDefault(); go(); } });
    P.addEventListener("click", ev => {
      const b = ev.target.closest && ev.target.closest(".mt-seat"); if(!b) return;
      ev.preventDefault(); ev.stopPropagation();
      const id = b.getAttribute("data-seat"); if(id == null || youId(id)) return;
      try{ callOn(isNaN(+id) ? id : +id); }catch(e){}
      paint(true);
    });
    document.body.appendChild(P);
    return P;
  }
  function floorHTML(S){
    const who = up(), youFloor = youId(S.floorId);
    const label = youFloor ? "You" : who ? (who.name + (who.role ? " · " + who.role : "")) : "open";
    const nxId = nextFresh(), nxP = nxId != null ? person(nxId) : null;
    let cue = "";
    try{
      if(typeof SXD !== "undefined" && SXD.log && SXD.log.length){
        const last = SXD.log[SXD.log.length - 1];
        cue = '<div class="mt-cue"><b>' + esc(last.who || "") + '</b> ' + esc(last.t || "") + '</div>';
      }
    }catch(e){}
    const chips = (S.seats || []).map(x => {
      const id = x && (x.personId != null ? x.personId : x.id); if(id == null) return "";
      const p = youId(id) ? G.you : person(id);
      const on = (who && p && String(who.id) === String(p.id)) || (youFloor && youId(id));
      const name = youId(id) ? "You" : (p && p.name) || String(id);
      return '<button type="button" class="mt-seat' + (on ? " on" : "") + (youId(id) ? " you" : "") + '" data-seat="' + esc(id) + '" style="background:' + colOf(p) + '" title="' + esc(name + (p && p.role ? " · " + p.role : "")) + '">' + esc(iniOf(p, id)) + '</button>';
    }).join("");
    return '<div class="mt-now">' + (youFloor ? "You have the floor" : "On the floor") + ': <b>' + esc(label) + '</b></div>' + cue +
      '<div class="mt-next">Up next: <b>' + esc(nxP ? nxP.name : "the room has been heard") + '</b></div><div class="mt-seats">' + chips + '</div>';
  }
  function logHTML(){
    try{ if(typeof SXD !== "undefined" && SXD.log && SXD.log.length) return SXD.log.slice(-5).map(l => '<div><b>' + esc(l.who || "—") + '</b> ' + esc(l.t) + '</div>').join(""); }catch(e){}
    return "";
  }
  function paint(force){
    const S = live();
    document.body.classList.toggle("mt-one", !!S);
    document.body.classList.toggle("mt-on", !!S);
    bar.className = ""; bar.innerHTML = "";
    const P = one();
    if(!S){ P.classList.remove("on"); sig = ""; const acts0 = P.querySelector(".mt-acts"); if(acts0) acts0.innerHTML = ""; return; }
    P.classList.add("on");
    const head = P.querySelector(".mt-title") || P.querySelector(".mt-head");
    if(head) head.textContent = String(S.kind || "session").replace(/_/g, " ") + (S.stageName ? " · " + S.stageName : (S.stage ? " · " + String(S.stage).replace(/_/g, " ") : ""));
    const fl = P.querySelector(".mt-floor"); if(fl) fl.innerHTML = floorHTML(S);
    const lg = P.querySelector(".mt-log");
    if(lg){ const h = logHTML(); if(lg.dataset.h !== h){ lg.innerHTML = h || '<div class="mt-empty">Nothing said yet. Call on someone, or speak.</div>'; lg.dataset.h = h; lg.scrollTop = lg.scrollHeight; } }
    const A = P.querySelector(".mt-acts");
    if(!A) return;
    const who = up(), nx = nextFresh();
    const pv = (G.bill && typeof preferredVote === "function") ? (preferredVote(G.bill) || 0) : 0;
    const now = [others, note, who && who.id, nx, (SSN && SSN._mtSaid && SSN._mtSaid.length), S.floorId, (S.queue || []).length, pv].join("|");
    if(!force && now === sig && A.childElementCount) return;
    sig = now; A.innerHTML = "";
    const s = document.createElement("div"); s.className = "mt-s";
    const ch = person(S.chairId);
    s.textContent = (note || ((S.chairId && youId(S.chairId)) ? "You chair. Call who you want heard." : ("Chair: " + (ch ? sn(ch) : "the chair"))) + " · floor: " + (who ? sn(who) : (youId(S.floorId) ? "you" : "open")));
    A.appendChild(s);
    if(others){
      A.appendChild(btn("Back", () => { others = false; }, false, "Back to the meeting"));
      seats(S).forEach(id => { const p = person(id); if(!p || p === G.you) return;
        A.appendChild(btn((heard(id) ? "Again: " : "Call on ") + sn(p), () => { others = false; callOn(id); }, !heard(id), (p.role ? p.role + ". " : "") + p.name)); });
      return;
    }
    A.appendChild(btn(pv === 1 ? "My vote: aye" : "Set aye", () => { if(typeof setMyVote === "function") setMyVote(1); note = "Your vote is aye. When they ask, that is the answer, not your mood."; }, pv === 1, "What you tell them when they ask how you vote"));
    A.appendChild(btn(pv === -1 ? "My vote: no" : "Set no", () => { if(typeof setMyVote === "function") setMyVote(-1); note = "Your vote is no. When they ask, that is the answer, not your mood."; }, pv === -1, "What you tell them when they ask how you vote"));
    if(S.kind === "cabinet_meeting" || S.kind === "governor_council") A.appendChild(btn("Use their office", () => {
      const id = (SSN && SSN.floorId && !youId(SSN.floorId)) ? SSN.floorId : window.__cabLast;
      const p = id != null ? person(id) : null;
      if(!p){ note = "Call on a secretary first. The office belongs to the person on the floor."; return; }
      note = (typeof cabUse === "function") ? cabUse(p) : "No office to use.";
      show(p, (p.role || "This office") + ". " + note);
    }, true, "The person with the floor spends the power of the office they hold, and says why"));
    A.appendChild(btn("Point of order", order, true, "You take the point. They were not on the question."));
    A.appendChild(btn(who ? "Press " + sn(who) : "Press", press, false, "The person already up gives the figure and the reason"));
    A.appendChild(btn("Challenge", challenge, false, "Somebody on the other side answers, and says why they differ"));
    A.appendChild(btn("Call on others", () => { others = true; note = ""; }, false, "Pick who speaks. Click a seat, or a name."));
    A.appendChild(btn("Chair", chair, false, "The chair speaks. Not the member who just spoke."));
    A.appendChild(btn("Pass", pass, false, "Move on. Nobody else speaks until you call the next."));
    A.appendChild(btn("Interject", interject, false, "You speak from your seat. It does not give you the floor."));
    A.appendChild(btn(nx ? ("Next: " + sn(person(nx))) : "Next: done", next, true, nx ? person(nx).name : "Everyone seated has been called"));
    A.appendChild(btn("End the sitting", endSitting, false, "Close this press conference, hearing, caucus or floor. It does not keep talking after you leave it."));
  }
  document.addEventListener("click", e => {
    const S = live(); if(!S) return;
    const seat = e.target.closest && e.target.closest("#ndSess .nsx-seat");
    if(seat){
      const name = String(seat.getAttribute("title") || "").split(" · ")[0].trim();
      const id = seats(S).find(x => { const p = person(x); return p && p.name === name; });
      if(id != null){ e.preventDefault(); callOn(id); paint(true); }
      return;
    }
    const li = e.target.closest && e.target.closest("#ndSess .nsx-q li");
    if(li){
      const name = (li.textContent || "").trim();
      const id = (S.queue || []).find(x => { const p = person(x); return p && (p.name === name || sn(p) === name); });
      if(id != null){ e.preventDefault(); callOn(id); paint(true); }
    }
  }, true);
  function shown(id){
    const e = document.getElementById(id);
    if(!e || e.hidden) return false;
    try{ const cs = getComputedStyle(e); if(cs.display === "none" || cs.visibility === "hidden") return false; }catch(err){ return true; }
    return true;
  }
  function uiOpen(){
    if(shown("clPanel")) return "clarity";
    if(shown("tipCard")) return "tip";
    if(shown("ndStyle")) return "ndStyle";
    if(shown("ndFam")) return "ndFam";
    if(shown("ndPb")) return "ndPb";
    if(shown("ndAudit")) return "ndAudit";
    const pause = document.getElementById("pauseOverlay");
    if(pause && pause.classList.contains("is-open")) return "pause";
    if(shown("onumCapitalLedgerDialog")) return "ledger";
    const mt = document.getElementById("mtOne");
    if(document.body.classList.contains("mt-one") && mt && mt.classList.contains("on")) return "meet";
    try{ if(typeof veil !== "undefined" && veil && !veil.hidden) return "card"; }catch(e){}
    try{ if(typeof TALK !== "undefined" && TALK.open) return "talk"; }catch(e){}
    if(document.body.classList.contains("ui-open")) return "panels";
    if(shown("pbPhone")) return "phone";
    const proc = document.getElementById("procBar");
    if(proc && !proc.hidden) return "proc";
    if(shown("ndFd")) return "desk";
    if(shown("ndSess")) return "sess";
    return "";
  }
  function shutTop(){
    const k = uiOpen();
    if(k === "clarity"){ try{ if(typeof CL !== "undefined" && CL && typeof CL.close === "function") CL.close(); else { const p = document.getElementById("clPanel"); if(p) p.hidden = true; } }catch(e){} return; }
    if(k === "tip"){ try{ if(typeof closeTip === "function") closeTip(); else { const t = document.getElementById("tipCard"); if(t) t.hidden = true; } }catch(e){} return; }
    if(k === "ndStyle" || k === "ndFam" || k === "ndPb" || k === "ndAudit"){ const e = document.getElementById(k); if(e) e.remove(); return; }
    if(k === "pause"){ try{ if(typeof closeSettings === "function") closeSettings(); }catch(e){} return; }
    if(k === "ledger"){ const b = document.querySelector("#onumCapitalLedgerDialog .cld-close"); if(b) b.click(); else { const d = document.getElementById("onumCapitalLedgerDialog"); if(d) d.hidden = true; } return; }
    if(k === "meet"){ shutMeet(); return; }
    if(k === "card"){ try{ veil.hidden = true; card.classList.remove("card--open"); if(G) G.running = true; }catch(e){} return; }
    if(k === "talk"){ try{ if(typeof closeTalk === "function") closeTalk(); }catch(e){} return; }
    if(k === "panels"){ try{ if(typeof closePanels === "function") closePanels(); }catch(e){} return; }
    if(k === "phone"){ try{ if(typeof phoneClose === "function") phoneClose(); }catch(e){} return; }
    if(k === "proc" || k === "desk" || k === "sess"){
      try{ window.ONUM_SIT_HELD = (G && G.room) || "held"; }catch(e){}
      try{ if(typeof leaveSittingQuiet === "function") leaveSittingQuiet(); }catch(e){}
      try{ const d = document.getElementById("ndFd"); if(d) d.hidden = true; }catch(e){}
      try{ const s = document.getElementById("ndSess"); if(s) s.hidden = true; }catch(e){}
      return;
    }
  }
  const ux = document.createElement("button"); ux.type = "button"; ux.id = "onumX"; ux.hidden = true; ux.textContent = "\u00d7"; ux.title = "Close this"; ux.setAttribute("aria-label", "Close");
  ux.onclick = ev => { ev.preventDefault(); ev.stopPropagation(); shutTop(); };
  document.body.appendChild(ux);
  setInterval(() => { try{ ux.hidden = !uiOpen(); }catch(e){} }, 400);
  addEventListener("keydown", e => {
    if(e.key !== "Escape") return;
    const t = e.target;
    if(t && (t.tagName === "TEXTAREA" || t.tagName === "INPUT" || t.isContentEditable)) return;
    if(!uiOpen()) return;
    e.preventDefault(); e.stopPropagation(); shutTop();
  }, true);
  setInterval(() => paint(false), 700);
  addEventListener("onum-session", () => setTimeout(() => paint(true), 0));
  addEventListener("resize", () => paint(false));
  paint(true);
})();

</script>
<script>
/* 20261109b District Ledger: career facts first, desk sketch marked as such. */
(function(){
  'use strict';

  var DISTRICTS = {
    'Nieuw Oranje VII': {
      name: 'Nieuw Oranje VII',
      region: 'capital',
      mood: 'formal, watchful, market-heavy',
      businesses: ['printing house', 'law chamber', 'café', 'grocer', 'bookshop', 'wine merchant'],
      concerns: ['rent pressure', 'delivery delay', 'public trust', 'paper cost', 'church attendance'],
      publicLife: 'government, ceremony, commerce, petitions, gossip, civic ritual',
      phraseMap: {
        snow: 'used for supply, scarcity, or social anxiety when a disruption is broad and hard to name',
        'Main Street': 'the central route where business, rumor, and public notice overlap',
        'cold ledger': 'the paper record used to prove who owes what and who is being held to account'
      }
    },
    Meriden: {
      name: 'Meriden',
      region: 'east',
      mood: 'industrial, practical, sharply opinionated',
      businesses: ['forge', 'mills', 'coal depots', 'rail supplier', 'workers hall', 'market stalls'],
      concerns: ['wages', 'hours', 'laid-off hands', 'rail congestion', 'labor solidarity'],
      publicLife: 'union halls, streetside bargaining, lunch-hour politics, factory gossip',
      phraseMap: {
        snow: 'a working-class warning of stoppage, scarcity, or a bad week in the mills',
        'iron morning': 'a bad day in the trades, often tied to factory stoppage or debt pressure',
        'the line': 'the labor line, queue, or public claim on wages and jobs'
      }
    },
    Calder: {
      name: 'Calder',
      region: 'north',
      mood: 'rural, patient, tied to weather and harvest',
      businesses: ['granary', 'seed shop', 'farm cooperatives', 'mill', 'feed store', 'tavern'],
      concerns: ['rainfall', 'grain price', 'toll roads', 'land tax', 'tenant pressure'],
      publicLife: 'church market days, harvest talk, road watch, weather warnings',
      phraseMap: {
        snow: 'often refers to a late season, a bad field, or a month of hardship',
        'thin harvest': 'a poor year or weak crop with political and market consequences',
        'road-fall': 'a disruption in delivery, transport, or trade route access'
      }
    },
    Riverbend: {
      name: 'Riverbend',
      region: 'west',
      mood: 'merchant, opportunistic, fast-moving',
      businesses: ['dockside warehouses', 'shipping firm', 'auction hall', 'port café', 'cloth market', 'bank'],
      concerns: ['shipping rates', 'tariffs', 'credit', 'dock labor', 'inventory loss'],
      publicLife: 'port gossip, auctions, merchant clubs, riverfront risks',
      phraseMap: {
        snow: 'may mean a cold market, slow delivery, or hard currency troubles',
        'waterfall': 'a sudden signal that prices or business conditions are swinging hard',
        'the quay': 'the port-lane where trust and speed matter above all else'
      }
    },
    Fallowfield: {
      name: 'Fallowfield',
      region: 'south',
      mood: 'traditional, formal, defensive',
      businesses: ['estate office', 'wine cellar', 'grist mill', 'gentry club', 'forge works', 'stables'],
      concerns: ['estate debt', 'land rights', 'inheritance', 'social rank', 'rural law'],
      publicLife: 'land dinners, household politics, county bargains, formal calls',
      phraseMap: {
        snow: 'often a coded way to signal social or household instability in a family-led district',
        'leaf-fall': 'a sign that patronage or prestige is under strain',
        'the old names': 'the inherited families whose status is political capital in itself'
      }
    },
    Blackwater: {
      name: 'Blackwater',
      region: 'coast',
      mood: 'defensive, orderly, security-minded',
      businesses: ['arsenal supply', 'mariner stores', 'barracks canteen', 'coast insurance', 'dry goods', 'seamarket'],
      concerns: ['security orders', 'military spending', 'port defense', 'trade risk', 'harbor wages'],
      publicLife: 'officer clubs, drill-ground talk, harbor watch, security committees',
      phraseMap: {
        snow: 'often used to mean watchfulness, disruption, or a threat that is not yet named plainly',
        'watch chain': 'a security network that can become political pressure when it tightens',
        'the tide line': 'the near-future threat boundary where trade and defense meet'
      }
    },
    Kestrel: {
      name: 'Kestrel',
      region: 'mountain',
      mood: 'independent, distrustful, self-sufficient',
      businesses: ['mountain store', 'ore exchange', 'forge', 'cabin market', 'way station', 'timber yard'],
      concerns: ['road closure', 'tax burden', 'isolated supply', 'mountain risk', 'local autonomy'],
      publicLife: 'valley meetings, market crossroads, weather warnings, local vows',
      phraseMap: {
        snow: 'usually means hard travel, shortage, or a mountain problem that has gone beyond ordinary weather',
        'the high pass': 'the narrow route by which the district can be reached or cut off',
        'closed road': 'a political and practical warning that someone is choosing isolation'
      }
    }
  };

  function flavor(name, region, mood, concerns, publicLife, snow){
    return {
      name: name,
      region: region,
      mood: mood,
      businesses: ['grocer', 'café', 'printer', 'tavern', 'market stall', 'clerk'],
      concerns: concerns,
      publicLife: publicLife,
      phraseMap: {
        snow: snow,
        'Main Street': 'where a private complaint becomes something a stranger can see',
        'cold ledger': 'the paper that says who is owed, and who will be reminded of it'
      }
    };
  }
  var EXTRA = {
    'Nieuw Haarlem': flavor('Nieuw Haarlem', 'upriver', 'mill towns, practical, proud of being upriver of the capital', ['mill wages', 'river freight', 'the capital taking the credit'], 'market days and the upriver papers', 'a week the mills ran short and nobody downriver noticed'),
    'Vlissingen': flavor('Vlissingen', 'coast', 'shipyard-loud, wary of the water', ['the yards', 'a coast that floods', 'harbor wages'], 'yard gates and the flood watch', 'water where a street was, and the argument about who pays'),
    'Zeeland': flavor('Zeeland', 'marsh', 'patient, dairy, long memory', ['the dikes', 'milk price', 'an old slight'], 'church market and the dike walk', 'a season the marsh took back what the books said was dry'),
    'Havenport': flavor('Havenport', 'port', 'everything passes through, and the port knows it', ['tariffs', 'dock labor', 'what the deep water charges'], 'the quay, the insurers, the night shift', 'a cargo that sat because nobody would name the rate'),
    'Marion': flavor('Marion', 'split', 'steel in one half, tobacco in the other, and they do not vote alike', ['the mills', 'the leaf', 'which half the governor visits'], 'shift whistles and county fairs', 'a town that means the north if you are from the south'),
    'Coalport': flavor('Coalport', 'seams', 'tired of being told the work will come back', ['the seams', 'the last shift', 'who will say it out loud'], 'the union hall and the closed tipple', 'a morning the whistle did not blow and the paper called it weather'),
    'Grantham': flavor('Grantham', 'college', 'orchards and people who have read the bill', ['tuition', 'the orchard year', 'what the study said this week'], 'lecture halls and Saturday markets', 'a phrase the students use that the orchard does not'),
    'Ordway': flavor('Ordway', 'high plains', 'cattle, and a legislature that is not in town for long', ['the herd price', 'the forty-day session', 'being governed from elsewhere'], 'stock pens and a short session', 'a road closed and a capitol that had already gone home'),
    'Sandhill': flavor('Sandhill', 'dry', 'quiet, conservative, richer than it looks', ['gas', 'water', 'being called empty'], 'the co-op and the Sunday paper', 'a price that moved under a county that pretends not to notice'),
    'Tullamore': flavor('Tullamore', 'works', 'union halls and foundries that are not all open', ['the closed works', 'the hall', 'who still hires'], 'the hall on payday and the gate on Monday', 'a shift that was posted and then taken down'),
    'Pinevale': flavor('Pinevale', 'timber', 'the fight is about the trees and who counts them', ['the cut', 'the road', 'whose timber'], 'the yard and the meeting about the yard', 'a load that left the valley before the meeting ended'),
    'Westrun': flavor('Westrun', 'coast', 'a coast that thinks it is its own country', ['the port', 'the capital inland', 'being spoken for'], 'the waterfront and a paper that does not quote the interior', 'a fog the inland forecasts did not mention'),
    'Dunmore': flavor('Dunmore', 'fleet', 'fishing, and a catch that is not what it was', ['the catch', 'the boats', 'the price at the dock'], 'the dock at dawn and the kerk in the afternoon', 'a hold that came in light and a story that came in heavy')
  };
  function ensureFlavors(){
    Object.keys(EXTRA).forEach(function(k){ if(!DISTRICTS[k]) DISTRICTS[k] = EXTRA[k]; });
    if(!DISTRICTS['Nieuw Oranje'] && DISTRICTS['Nieuw Oranje VII']){
      DISTRICTS['Nieuw Oranje'] = {
        name: 'Nieuw Oranje',
        region: DISTRICTS['Nieuw Oranje VII'].region,
        mood: DISTRICTS['Nieuw Oranje VII'].mood,
        businesses: DISTRICTS['Nieuw Oranje VII'].businesses,
        concerns: DISTRICTS['Nieuw Oranje VII'].concerns,
        publicLife: DISTRICTS['Nieuw Oranje VII'].publicLife,
        phraseMap: DISTRICTS['Nieuw Oranje VII'].phraseMap
      };
    }
  }
  function hashStr(s){
    var h = 2166136261;
    s = String(s || '');
    for(var i = 0; i < s.length; i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
    return h >>> 0;
  }
  function mulberry(seed){
    var s = seed >>> 0;
    return function(){
      s = (Math.imul(1664525, s) + 1013904223) >>> 0;
      return s / 4294967296;
    };
  }
  function profileFor(label){
    ensureFlavors();
    if(DISTRICTS[label]) return DISTRICTS[label];
    return flavor(label, 'the republic', 'a state with its own lean, its own pews, and a grudge it can name', ['the lean', 'the price', 'whether the capital is listening'], 'the ordinary week: work, worship, and the paper', 'a shortage the district already had a word for');
  }

  var BUSINESS_TYPES = [
    'grocer', 'bakery', 'café', 'bookshop', 'barber', 'law chamber',
    'forge', 'warehouse', 'printer', 'dockside store', 'wine merchant',
    'clothier', 'seed shop', 'tavern', 'market stalls'
  ];

  var PHRASE_LIBRARY = {
    snow: {
      type: 'metaphor',
      explanation: 'A local shorthand for disruption, scarcity, public anxiety, or a situation that has become hard to name directly.',
      usageHint: 'Ask who is using it and what went wrong before deciding whether it means weather, shortage, or political harm.',
      confidence: 'uncertain unless tied to a clear event record'
    },
    'Main Street': {
      type: 'place-reference',
      explanation: 'The busy corridor where commerce, rumor, and civic life overlap; a phrase can describe where a problem became visible to the public.',
      usageHint: 'Often used to mean a public crisis that is visible to the city rather than confined to a private room.',
      confidence: 'medium'
    },
    'cold ledger': {
      type: 'financial-metaphor',
      explanation: 'A record of who owes what, how accounts stand, and what can be proven in public. It is not just numbers—it is a political statement about responsibility.',
      usageHint: 'Used when a matter is being reduced to account, debt, or obligation.',
      confidence: 'high'
    },
    'iron morning': {
      type: 'labor-metaphor',
      explanation: 'A phrase for a day of hard labor, low wages, or a factory disruption that can affect a whole neighborhood.',
      usageHint: 'Usually tied to working conditions or a stoppage, not a weather event.',
      confidence: 'high'
    },
    'thin harvest': {
      type: 'agricultural-metaphor',
      explanation: 'A poor yield or weak harvest that carries both economic and political weight.',
      usageHint: 'Can signal a district complaint about taxes, trade, or policy as well as weather.',
      confidence: 'high'
    },
    'the high pass': {
      type: 'geographic-metaphor',
      explanation: 'A narrow corridor or route whose closure means isolation, danger, or strategic leverage.',
      usageHint: 'Often used when both geography and political bargaining are at issue.',
      confidence: 'high'
    }
  };

  function clamp(v, min, max){
    return Math.min(max, Math.max(min, v));
  }

  function makeBusinessEntry(id, district, type, owner, x, y, rnd, priceBias){
    rnd = rnd || Math.random;
    priceBias = priceBias || 1;
    var base = Math.round((8 + rnd() * 28) * priceBias);
    return {
      id: id,
      district: district,
      type: type,
      owner: owner,
      location: { x: x, y: y },
      hours: 'open during normal market hours',
      reputation: clamp(0.35 + rnd() * 0.55, 0, 1),
      stock: Math.round(18 + rnd() * 80),
      prices: {
        base: base,
        recent: Math.max(1, Math.round(base * (0.9 + rnd() * 0.25)))
      },
      workers: Math.round(2 + rnd() * 9),
      pressures: ['competition', 'supply', 'rent'],
      vibe: 'desk sketch, priced off the day and the state, not a transaction you made',
      sketch: true
    };
  }

  function makeDistrictProfile(label, seed, facts){
    ensureFlavors();
    var profile = profileFor(label);
    var rnd = mulberry(((seed || 1) * 997) ^ hashStr(label + ':' + ((facts && facts.day) || '')));
    var ind = facts && facts.state && facts.state.ind ? facts.state.ind : 50;
    var priceBias = 0.75 + ind / 160;
    var baseBusinesses = [];
    var names = [
      'Bell', 'Crown', 'North', 'Stone', 'Harbor', 'Oak', 'Leaden', 'Market', 'Pine', 'Rowan', 'Guild', 'Morrow'
    ];

    for (var i = 0; i < 5; i++) {
      baseBusinesses.push(makeBusinessEntry(
        (label + '-' + i).replace(/\s+/g, '-').toLowerCase(),
        label,
        BUSINESS_TYPES[(seed + i) % BUSINESS_TYPES.length],
        names[(seed + i) % names.length] + ' & Co.',
        Math.round(rnd() * 100),
        Math.round(rnd() * 100),
        rnd,
        priceBias
      ));
    }

    var pulse;
    if (facts && facts.state) {
      pulse = {
        crowding: clamp((facts.state.pop || 2) / 10, 0, 1),
        trade: clamp((facts.state.ind || 0) / 100, 0, 1),
        tension: clamp((facts.state.unrest || 0) / 100, 0, 1),
        publicTrust: clamp(facts.you ? (facts.you.approval || 50) / 100 : 0.55, 0, 1)
      };
    } else {
      pulse = {
        crowding: clamp((seed % 10) / 10 + 0.4, 0, 1),
        trade: clamp(0.35 + (seed % 7) / 10, 0, 1),
        tension: clamp(0.2 + ((seed + 3) % 8) / 12, 0, 1),
        publicTrust: clamp(0.5 + ((seed + 1) % 5) / 12, 0, 1)
      };
    }

    return {
      district: label,
      region: profile.region,
      mood: profile.mood,
      concerns: profile.concerns,
      publicLife: profile.publicLife,
      phraseMap: profile.phraseMap,
      businesses: baseBusinesses,
      pulse: pulse
    };
  }

  function createStoryRecord(options){
    options = options || {};
    return {
      id: options.id || ('story-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 7)),
      title: options.title || 'Local notice',
      section: options.section || 'district',
      district: options.district || 'Nieuw Oranje VII',
      date: options.date || 'The current day',
      summary: options.summary || 'A public event with consequences for business and politics.',
      confirmed: Array.isArray(options.confirmed) ? options.confirmed : [options.summary || 'The event itself is recorded'],
      claims: Array.isArray(options.claims) ? options.claims : [],
      disputed: Array.isArray(options.disputed) ? options.disputed : [],
      uncertainty: options.uncertainty || 'Uncertainty remains around motive and full consequence.',
      sources: Array.isArray(options.sources) ? options.sources : ['local witness'],
      followUp: options.followUp || 'A follow-up is expected as the facts settle.',
      politicalWeight: options.politicalWeight || 'local',
      businessImpact: options.businessImpact || 'materials, wages, and commerce are likely to shift',
      phraseKeys: Array.isArray(options.phraseKeys) ? options.phraseKeys : [],
      fromCareer: !!options.fromCareer
    };
  }

  function explainPhrase(phraseKey, context){
    var key = String(phraseKey || '').trim().toLowerCase();
    var lookup = PHRASE_LIBRARY[key];
    if (!lookup) {
      var mapKey = Object.keys(PHRASE_LIBRARY).find(function(candidate){
        return String(candidate).toLowerCase() === key;
      });
      lookup = mapKey ? PHRASE_LIBRARY[mapKey] : null;
    }

    var district = context && context.district ? context.district : 'Nieuw Oranje';
    var districtInfo = profileFor(district);
    var map = districtInfo && districtInfo.phraseMap;
    var localKey = map && Object.keys(map).find(function(candidate){ return String(candidate).toLowerCase() === key; });
    var localMeaning = localKey ? map[localKey] : null;

    return {
      phrase: phraseKey || 'unknown phrase',
      district: district,
      meaning: localMeaning || (lookup && lookup.explanation) || 'The phrase is not yet tied to a clear public record.',
      usageHint: (lookup && lookup.usageHint) || 'Ask a witness or consult the source trail before pinning it to a political meaning.',
      certainty: (lookup && lookup.confidence) || 'uncertain',
      sourceType: (lookup && lookup.type) || 'unclassified'
    };
  }

  function buildLedgerEdition(dayLabel, districtName, state){
    ensureFlavors();
    var facts = (state && state.ok) ? state : null;
    var district = (facts && facts.name) || districtName || 'Nieuw Oranje';
    var districtInfo = profileFor(district);
    var profile = makeDistrictProfile(district, hashStr(String(dayLabel || '') + district) % 10000, facts);
    var leads = [];

    if (facts) {
      var s = facts.state || {};
      if (facts.races && facts.races.length) {
        var r0 = facts.races[0];
        leads.push(createStoryRecord({
          title: r0.title,
          section: 'the count',
          district: district,
          date: dayLabel,
          summary: r0.lead + ' leads at ' + r0.share + '. ' + (r0.why || ''),
          confirmed: ['The book of races has this share on day ' + facts.day + '.'],
          claims: facts.races.slice(1, 4).map(function(r){ return r.title + ': ' + r.lead + ' at ' + r.share + '.'; }),
          uncertainty: 'A poll is not a vote. Election night files the return.',
          sources: ['the book of races', 'the morning count'],
          followUp: 'The chart lengthens each morning the race is hot, and on a turn when it is not.',
          politicalWeight: 'electoral',
          businessImpact: 'Contracts follow a lead this size more than they follow a speech.',
          fromCareer: true
        }));
      }
      if (facts.pres) {
        leads.push(createStoryRecord({
          title: facts.pres.title,
          section: 'the nation',
          district: district,
          date: dayLabel,
          summary: facts.pres.lead + ' leads the nation at ' + facts.pres.share + '. ' + (facts.pres.why || ''),
          confirmed: ['National mood stands at ' + facts.mood + '.'],
          sources: ['the book of races'],
          followUp: 'The executive is counted every morning.',
          politicalWeight: 'national',
          businessImpact: 'The guilder does not move because a poll did.',
          fromCareer: true
        }));
      }
      var moodLine = (s.note ? s.note + ' ' : '') + 'Lean ' + s.lean + ', unrest ' + s.unrest + ', industry ' + s.ind + (s.pop ? ', population ' + s.pop + 'm' : '') + '.';
      if (facts.creed) moodLine += ' The ground is mostly ' + facts.creed.t + '. ' + facts.creed.line;
      if (facts.gov) moodLine += ' Government: ' + facts.gov.t + '. ' + facts.gov.d + (facts.gov.name ? ' The governor on the books is ' + facts.gov.name + '.' : '');
      if (facts.home && facts.you) moodLine += ' You are from here. Approval ' + facts.you.approval + ', last margin ' + facts.you.margin + '.';
      if (facts.home && facts.town) moodLine += ' Households at home sit at ' + facts.town.mood + '.';
      if (facts.guilder != null) moodLine += ' The guilder index is ' + facts.guilder + '.';
      leads.push(createStoryRecord({
        title: 'Why ' + district + ' feels this way',
        section: 'mood',
        district: district,
        date: dayLabel,
        summary: moodLine,
        confirmed: [
          'Unrest ' + s.unrest + ' of 100.',
          'Industry ' + s.ind + '.',
          s.bill ? 'On the statehouse desk: ' + s.bill + '.' : 'Nothing named on the statehouse desk this reading.'
        ],
        sources: ['the state record', 'the morning'],
        followUp: 'Unrest and industry move when laws land and when the street does. They are not a color on a poster.',
        politicalWeight: 'district',
        businessImpact: 'Thin industry makes bread the issue. High unrest spends itself on whoever already holds the office.',
        fromCareer: true
      }));
      if (facts.chapel) {
        leads.push(createStoryRecord({
          title: 'The chapel and the vote',
          section: 'a note in the margin',
          district: district,
          date: dayLabel,
          summary: district + ' keeps ' + facts.chapel + ' Consular chapel' + (facts.chapel > 1 ? 's' : '') + '. The lawgiver they quote is a man, never God. The pews vote with everyone else.',
          confirmed: ['Chapel count on the rite record: ' + facts.chapel + '.'],
          sources: ['the rite record'],
          followUp: 'A chapel is not a bloc. It is a room that still has to mark a ballot.',
          politicalWeight: 'local',
          businessImpact: 'None on the price of bread. Some on who is willing to be seen at the poll.',
          fromCareer: true
        }));
      }
      if (facts.town && facts.town.streets && facts.town.streets.length) {
        leads.push(createStoryRecord({
          title: 'The streets that write you',
          section: 'home',
          district: district,
          date: dayLabel,
          summary: facts.town.streets.map(function(h){ return h.fam + ' on ' + h.street + ' (' + h.mood + ') want ' + h.need; }).join('. ') + '.',
          confirmed: facts.town.streets.map(function(h){ return h.street + ': ' + h.need; }),
          claims: facts.town.letter ? ['Latest letter: ' + facts.town.letter] : [],
          sources: ['the household book'],
          followUp: 'A household remembers a visit and a need. It does not remember your procedural vote as a procedure.',
          politicalWeight: 'home',
          businessImpact: 'These are the people who buy from the street you are about to see sketched.',
          fromCareer: true
        }));
      }
      if (facts.votes && facts.votes.length) {
        leads.push(createStoryRecord({
          title: 'What you voted, and what home makes of it',
          section: 'the record',
          district: district,
          date: dayLabel,
          summary: 'The last roll calls, read against the district rather than against the whip.',
          confirmed: facts.votes.slice(),
          sources: ['your roll-call record'],
          followUp: 'The next vote joins this list. The district does not retire the old one because the week turned.',
          politicalWeight: 'record',
          businessImpact: 'A vote that sits against the district shows up in approval before it shows up in a headline.',
          fromCareer: true
        }));
      }
      if (facts.daylog && facts.daylog.length) {
        leads.push(createStoryRecord({
          title: 'What the day already wrote down',
          section: 'the record',
          district: district,
          date: dayLabel,
          summary: 'Lines from the career that name ' + district + '.',
          confirmed: facts.daylog.slice(),
          sources: ['the day record'],
          followUp: 'New lines append. This is not a rewrite.',
          politicalWeight: 'record',
          businessImpact: 'A named state in the day record is a state the markets will pretend they already understood.',
          fromCareer: true
        }));
      }
      if (facts.hist && facts.hist.length) {
        leads.push(createStoryRecord({
          title: 'Returns already filed',
          section: 'history',
          district: district,
          date: dayLabel,
          summary: 'What this place, or you, already returned. A small margin in hostile ground is a borrowed win.',
          confirmed: facts.hist.map(function(h){ return h.line; }),
          sources: ['the book of races'],
          followUp: 'The next election night adds a line. It does not invent the years before the career.',
          politicalWeight: 'electoral',
          businessImpact: 'A safe margin spends like credit. A squeaker does not.',
          fromCareer: true
        }));
      }
    }

    leads.push(createStoryRecord({
      title: 'Desk sketch · the street register',
      section: 'desk sketch',
      district: district,
      date: dayLabel,
      summary: 'A stable sketch of shops for this day, priced off industry ' + ((facts && facts.state && facts.state.ind) || 'an assumed 50') + '. These are not transactions from the career, and they are not the 3D city.',
      confirmed: ['The names and prices are generated from the day and the district so a refresh does not invent a new town.'],
      claims: ['Residents may use “snow” for a shortage, “Main Street” for a complaint that has gone public, and “cold ledger” for a debt someone intends to collect.'],
      uncertainty: 'Desk sketch. Not a career event.',
      sources: ['the desk, not the save'],
      followUp: 'When the career has a fact, it is printed above this sketch and marked as from the career.',
      phraseKeys: ['snow', 'Main Street', 'cold ledger'],
      politicalWeight: 'illustrative',
      businessImpact: 'Indicative only.',
      fromCareer: false
    }));

    var concerns = (districtInfo.concerns || []).slice();
    if (facts && facts.state) {
      concerns = [
        'unrest ' + facts.state.unrest,
        'industry ' + facts.state.ind,
        'lean ' + facts.state.lean
      ].concat(facts.state.bill ? ['statehouse: ' + facts.state.bill] : []).concat(concerns).slice(0, 7);
    }
    var mood = districtInfo.mood;
    if (facts && facts.state) {
      mood = 'From the career: unrest ' + facts.state.unrest + ', industry ' + facts.state.ind + ', lean ' + facts.state.lean + (facts.home && facts.town ? ', households ' + facts.town.mood : '') + '. The place itself is ' + districtInfo.mood;
    }

    return {
      edition: (dayLabel || 'Current day'),
      district: district,
      districtProfile: profile,
      mood: mood,
      concerns: concerns,
      publicLife: districtInfo.publicLife,
      stories: leads,
      fromCareer: leads.some(function(s){ return s.fromCareer; }),
      explanation: {
        phraseMap: districtInfo.phraseMap,
        localMeaning: function(phraseKey){ return explainPhrase(phraseKey, { district: district }); }
      },
      localState: Object.assign({}, facts || {}, {
        crowding: profile.pulse.crowding,
        trade: profile.pulse.trade,
        tension: profile.pulse.tension,
        publicTrust: profile.pulse.publicTrust
      })
    };
  }

  ensureFlavors();
  var api = {
    DISTRICTS: DISTRICTS,
    BUSINESS_TYPES: BUSINESS_TYPES,
    PHRASE_LIBRARY: PHRASE_LIBRARY,
    makeBusinessEntry: makeBusinessEntry,
    makeDistrictProfile: makeDistrictProfile,
    createStoryRecord: createStoryRecord,
    explainPhrase: explainPhrase,
    buildLedgerEdition: buildLedgerEdition,
    generateDistrictPulse: function(label, dayLabel){
      var district = label || 'Nieuw Oranje VII';
      return buildLedgerEdition(dayLabel || 'Current day', district, {});
    }
  };

  if (typeof window !== 'undefined') {
    window.ONUM_CAPITAL_LEDGER = api;
  }

  if (typeof globalThis !== 'undefined') {
    globalThis.ONUM_CAPITAL_LEDGER = api;
  }

})();
</script>
<script>
/* Capital Ledger UI adapter.
 * Load after assets/capital-ledger.js in the game HTML. It adds its own button
 * beside the existing Ledger action and does not replace existing UI handlers.
 * Generated dispatches remain clearly identified until backed by career events.
 */
(function (root) {
  'use strict';

  var API = root.ONUM_CAPITAL_LEDGER;
  if (!API || !API.DISTRICTS || typeof API.buildLedgerEdition !== 'function') return;

  var DISTRICT_NAMES = Object.keys(API.DISTRICTS);
  var STYLE_ID = 'onum-capital-ledger-ui-style';
  var BUTTON_ID = 'onumCapitalLedgerButton';
  var DIALOG_ID = 'onumCapitalLedgerDialog';
  var lastFocus = null;

  function text(el, value) { el.textContent = value == null ? '' : String(value); return el; }
  function node(tag, className, value) {
    var el = document.createElement(tag);
    if (className) el.className = className;
    if (value != null) text(el, value);
    return el;
  }
  function addStyle() {
    if (document.getElementById(STYLE_ID)) return;
    var style = node('style');
    style.id = STYLE_ID;
    style.textContent = [
      '.cld-backdrop{position:fixed;inset:0;z-index:10020;display:grid;place-items:center;padding:clamp(8px,3vw,28px);background:rgba(5,8,12,.78);backdrop-filter:blur(4px)}',
      '.cld-backdrop[hidden]{display:none}',
      '.cld-paper{position:relative;width:min(1080px,100%);max-height:min(92dvh,900px);overflow:auto;background:var(--paper,#f1f2f3);color:var(--ink,#15181e);border:1px solid var(--line,#c7cad0);border-top:4px double var(--fed,#a45f27);box-shadow:0 24px 80px #0009;padding:clamp(16px,3vw,34px);font:15px/1.55 Georgia,serif}',
      '.cld-mast{text-align:center;border-bottom:3px double currentColor;padding:0 36px 12px}',
      '.cld-kicker,.cld-label,.cld-meta{font:600 10px/1.5 Archivo,system-ui,sans-serif;letter-spacing:.13em;text-transform:uppercase;opacity:.72}',
      '.cld-mast h1{font:400 clamp(34px,6vw,58px)/.98 "Instrument Serif",Georgia,serif;margin:8px 0}',
      '.cld-date{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;border-top:1px solid currentColor;margin-top:8px;padding-top:7px}',
      '.cld-close{position:absolute;right:12px;top:12px;min-width:40px;min-height:40px;border:1px solid var(--line,#c7cad0);background:var(--surface,#fff);color:inherit;cursor:pointer;font:22px/1 system-ui}',
      '.cld-controls{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:15px 0}',
      '.cld-controls label,.cld-controls button,.cld-controls select{font:600 12px Archivo,system-ui,sans-serif}',
      '.cld-controls select,.cld-controls button{min-height:40px;padding:8px 11px;background:var(--surface,#fff);color:inherit;border:1px solid var(--line,#c7cad0);border-radius:2px}',
      '.cld-controls button,.cld-close{cursor:pointer}',
      '.cld-columns{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(240px,.8fr);gap:clamp(16px,3vw,32px)}',
      '.cld-lead{border-bottom:1px solid var(--line,#c7cad0);padding:12px 0 18px}',
      '.cld-lead h2{font:400 clamp(25px,4vw,36px)/1.08 "Instrument Serif",Georgia,serif;margin:6px 0;max-width:24ch}',
      '.cld-deck{font-style:italic;opacity:.75;font-size:18px}',
      '.cld-story,.cld-sidecard{border-top:1px solid var(--line,#c7cad0);padding:13px 0}',
      '.cld-story h3,.cld-sidecard h3{font:400 21px/1.15 "Instrument Serif",Georgia,serif;margin:5px 0}',
      '.cld-tag{font:600 10px Archivo,system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--com,#1c5f66)}',
      '.cld-fine{font:12px/1.5 Archivo,system-ui,sans-serif;opacity:.75}',
      '.cld-story details{margin-top:8px}',
      '.cld-story summary{cursor:pointer;font:600 11px Archivo,system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase}',
      '.cld-phrase{margin-top:16px;border-left:3px solid var(--com,#1c5f66);padding:8px 12px;background:color-mix(in srgb,var(--com,#1c5f66) 8%,transparent)}',
      '.cld-business{border-top:1px solid var(--line,#c7cad0);padding:9px 0}',
      '.cld-notice{margin-top:18px;border:1px solid var(--line,#c7cad0);padding:10px 12px;background:color-mix(in srgb,var(--fed,#a45f27) 9%,transparent);font:12px/1.5 Archivo,system-ui,sans-serif}',
      '.cld-list{padding-left:19px}',
      '@media(max-width:700px){.cld-columns{grid-template-columns:1fr}.cld-date{justify-content:center;text-align:center}.cld-mast{padding-top:28px}}',
      '@media(prefers-reduced-motion:reduce){.cld-backdrop{backdrop-filter:none}}'
    ].join('\n');
    document.head.appendChild(style);
  }

  function findDistrict() {
    try {
      if (typeof root.onumLedgerFacts === 'function') {
        var facts = root.onumLedgerFacts();
        if (facts && facts.name) return facts.name;
      }
    } catch (ignore) {}
    var candidates = [];
    try {
      if (root.G && root.G.you) candidates.push(root.G.you.state, root.G.you.district, root.G.you.homeDistrict, root.G.you.home);
      if (root.G) candidates.push(root.G.district, root.G.where);
      if (typeof root.onumDistrict === 'function') candidates.push(root.onumDistrict());
      candidates.push(root.ONUM_DISTRICT);
    } catch (ignore) {}
    for (var i = 0; i < candidates.length; i++) {
      var value = candidates[i];
      if (typeof value !== 'string') continue;
      if (API.DISTRICTS[value]) return value;
      var found = Object.keys(API.DISTRICTS).find(function (name) { return name.toLowerCase() === value.toLowerCase(); });
      if (found) return found;
      if (/nieuw oranje/i.test(value)) return API.DISTRICTS['Nieuw Oranje'] ? 'Nieuw Oranje' : 'Nieuw Oranje VII';
    }
    return API.DISTRICTS['Nieuw Oranje'] ? 'Nieuw Oranje' : (Object.keys(API.DISTRICTS)[0] || 'Nieuw Oranje VII');
  }
  function districtNames() {
    try {
      if (typeof root.onumLedgerFacts === 'function') {
        var facts = root.onumLedgerFacts();
        if (facts && facts.states && facts.states.length) return facts.states.slice();
      }
    } catch (ignore) {}
    return Object.keys(API.DISTRICTS);
  }
  function syncSelect() {
    var select = document.getElementById('cldDistrict');
    if (!select) return findDistrict();
    var names = districtNames();
    var cur = select.value || findDistrict();
    if (names.indexOf(cur) < 0) cur = names.indexOf(findDistrict()) >= 0 ? findDistrict() : names[0];
    var same = select.options.length === names.length;
    if (same) {
      for (var i = 0; i < names.length; i++) { if (select.options[i].value !== names[i]) { same = false; break; } }
    }
    if (!same) {
      while (select.firstChild) select.removeChild(select.firstChild);
      names.forEach(function (name) {
        var option = node('option', '', name);
        option.value = name;
        select.appendChild(option);
      });
    }
    select.value = cur;
    return cur;
  }

  function dayLabel() {
    try {
      if (typeof root.onumLedgerFacts === 'function') {
        var facts = root.onumLedgerFacts();
        if (facts && facts.day) return 'Day ' + facts.day;
      }
      if (typeof root.onumDay === 'function') return String(root.onumDay());
      if (root.G && root.G.day != null) return 'Day ' + root.G.day;
      if (root.G && root.G.date) return String(root.G.date);
    } catch (ignore) {}
    return 'Current edition';
  }

  function createDialog() {
    var existing = document.getElementById(DIALOG_ID);
    if (existing) return existing;
    addStyle();
    var backdrop = node('div', 'cld-backdrop');
    backdrop.id = DIALOG_ID;
    backdrop.hidden = true;
    backdrop.setAttribute('role', 'presentation');
    var paper = node('section', 'cld-paper');
    paper.setAttribute('role', 'dialog');
    paper.setAttribute('aria-modal', 'true');
    paper.setAttribute('aria-labelledby', 'cldTitle');
    var close = node('button', 'cld-close', '×');
    close.type = 'button';
    close.setAttribute('aria-label', 'Close the Capital Ledger');
    close.addEventListener('click', closeDialog);
    paper.appendChild(close);
    var mast = node('header', 'cld-mast');
    mast.appendChild(node('div', 'cld-kicker', 'The Republic · District edition'));
    var h1 = node('h1', '', 'The Capital Ledger');
    h1.id = 'cldTitle';
    mast.appendChild(h1);
    mast.appendChild(node('div', 'cld-meta', 'News · Trade · Public life · The House'));
    mast.appendChild(node('div', 'cld-date', ''));
    paper.appendChild(mast);
    var controls = node('div', 'cld-controls');
    controls.appendChild(node('label', '', 'District'));
    var select = node('select');
    select.id = 'cldDistrict';
    select.setAttribute('aria-label', 'Select district edition');
    DISTRICT_NAMES.forEach(function (name) {
      var option = node('option', '', name);
      option.value = name;
      select.appendChild(option);
    });
    select.value = findDistrict();
    select.addEventListener('change', renderEdition);
    controls.appendChild(select);
    var refresh = node('button', '', 'Refresh edition');
    refresh.type = 'button';
    refresh.addEventListener('click', renderEdition);
    controls.appendChild(refresh);
    paper.appendChild(controls);
    var lead = node('section', 'cld-lead');
    lead.id = 'cldLead';
    paper.appendChild(lead);
    var columns = node('div', 'cld-columns');
    var main = node('section');
    var mainLabel = node('div', 'cld-label', 'From the district desk');
    main.appendChild(mainLabel);
    var stories = node('div');
    stories.id = 'cldStories';
    main.appendChild(stories);
    var phrase = node('section', 'cld-phrase');
    phrase.id = 'cldPhrase';
    main.appendChild(phrase);
    columns.appendChild(main);
    var aside = node('aside');
    aside.appendChild(node('div', 'cld-label', 'District life'));
    var districtTitle = node('h3'); districtTitle.id = 'cldDistrictTitle'; aside.appendChild(districtTitle);
    var mood = node('p'); mood.id = 'cldMood'; aside.appendChild(mood);
    var publicLife = node('p'); publicLife.id = 'cldPublicLife'; aside.appendChild(publicLife);
    aside.appendChild(node('div', 'cld-label', 'Issues on residents’ minds'));
    var concerns = node('ul', 'cld-list'); concerns.id = 'cldConcerns'; aside.appendChild(concerns);
    aside.appendChild(node('div', 'cld-label', 'Market register · illustrative listings'));
    var businesses = node('div'); businesses.id = 'cldBusinesses'; aside.appendChild(businesses);
    aside.appendChild(node('div', 'cld-label', 'Local language'));
    var phrases = node('div'); phrases.id = 'cldPhrases'; aside.appendChild(phrases);
    columns.appendChild(aside);
    paper.appendChild(columns);
    var notice = node('div', 'cld-notice', 'Open a career and this page reads the state, the polls, the mood, and the vote record. The market register stays a desk sketch.');
    notice.id = 'cldNotice';
    paper.appendChild(notice);
    backdrop.appendChild(paper);
    backdrop.addEventListener('click', function (event) { if (event.target === backdrop) closeDialog(); });
    document.body.appendChild(backdrop);
    return backdrop;
  }

  function clear(el) { while (el.firstChild) el.removeChild(el.firstChild); }
  function append(tag, className, value, parent) {
    var el = node(tag, className, value);
    parent.appendChild(el);
    return el;
  }
  function showPhrase(phrase, district) {
    var target = document.getElementById('cldPhrase');
    var result = API.explainPhrase(phrase, { district: district });
    clear(target);
    append('div', 'cld-tag', 'Local phrase · ' + result.sourceType, target);
    append('h3', '', '“' + result.phrase + '”', target);
    append('p', '', result.meaning, target);
    append('p', 'cld-fine', result.usageHint + ' Certainty: ' + result.certainty + '.', target);
  }
  function renderEdition() {
    var dialog = createDialog();
    var district = syncSelect();
    var edition = dayLabel();
    var facts = null;
    try { if (typeof root.onumLedgerFacts === 'function') facts = root.onumLedgerFacts(district); } catch (ignore) {}
    var data = API.buildLedgerEdition(edition, district, facts || {});
    var mastDate = dialog.querySelector('.cld-date');
    clear(mastDate);
    append('span', '', district + ' · ' + edition, mastDate);
    append('span', '', data.fromCareer ? 'From the career' : 'Desk sketch · no career loaded', mastDate);
    var lead = document.getElementById('cldLead');
    clear(lead);
    var first = data.stories[0];
    append('div', 'cld-label', (first.fromCareer ? 'From the career · ' : 'Desk sketch · ') + first.section, lead);
    append('h2', '', first.title, lead);
    append('p', 'cld-deck', first.summary, lead);
    append('p', 'cld-fine', 'What remains uncertain: ' + first.uncertainty, lead);
    var stories = document.getElementById('cldStories');
    clear(stories);
    data.stories.forEach(function (story) {
      var article = append('article', 'cld-story', null, stories);
      append('div', 'cld-tag', (story.fromCareer ? 'From the career · ' : 'Desk sketch · ') + story.section + ' · ' + story.date, article);
      append('h3', '', story.title, article);
      append('p', '', story.summary, article);
      append('p', 'cld-fine', 'Business effect: ' + story.businessImpact, article);
      var details = append('details', '', null, article);
      append('summary', '', 'Sources, claims & follow-up', details);
      append('p', '', 'Confirmed: ' + story.confirmed.join(' '), details);
      if (story.claims.length) append('p', '', 'Attributed claims: ' + story.claims.join(' '), details);
      if (story.disputed.length) append('p', '', 'Disputed: ' + story.disputed.join(' '), details);
      append('p', 'cld-fine', 'Sources: ' + story.sources.join(', ') + '. ' + story.followUp, details);
      story.phraseKeys.forEach(function (key) {
        var button = append('button', '', 'Explain “' + key + '”', article);
        button.type = 'button';
        button.addEventListener('click', function () { showPhrase(key, district); });
      });
    });
    var title = document.getElementById('cldDistrictTitle'); text(title, district);
    text(document.getElementById('cldMood'), data.mood + '.');
    text(document.getElementById('cldPublicLife'), data.publicLife + '.');
    var concerns = document.getElementById('cldConcerns'); clear(concerns);
    data.concerns.forEach(function (concern) { append('li', '', concern, concerns); });
    var businesses = document.getElementById('cldBusinesses'); clear(businesses);
    data.districtProfile.businesses.forEach(function (business) {
      var row = append('div', 'cld-business', null, businesses);
      append('b', '', business.owner + ' · ' + business.type, row);
      append('div', 'cld-fine', 'Indicative price ' + business.prices.recent + ' · stock ' + business.stock + ' · ' + business.workers + ' workers · desk sketch', row);
    });
    var phrases = document.getElementById('cldPhrases'); clear(phrases);
    Object.keys(data.districtProfile.phraseMap || {}).forEach(function (key) {
      var button = append('button', '', 'Explain “' + key + '”', phrases);
      button.type = 'button';
      button.addEventListener('click', function () { showPhrase(key, district); });
    });
    var notice = document.getElementById('cldNotice');
    if (notice) {
      var n = data.stories.filter(function (s) { return s.fromCareer; }).length;
      text(notice, n
        ? (n + ' items on this page are taken from the career: the count, the mood, the households, the roll calls, and the day record. The market register is a desk sketch. Its prices follow the state\'s industry and stay put for the day. They are not money you spent, and they are not the 3D city.')
        : 'No career is loaded, so this edition is a desk sketch. Start or import a career and the same page will read the state, the polls, the mood, and the votes.');
    }
    showPhrase((first.phraseKeys && first.phraseKeys[0]) || 'snow', district);
  }
  function openDialog() {
    var dialog = createDialog();
    lastFocus = document.activeElement;
    renderEdition();
    dialog.hidden = false;
    var close = dialog.querySelector('.cld-close');
    if (close) close.focus();
  }
  function closeDialog() {
    var dialog = document.getElementById(DIALOG_ID);
    if (dialog) dialog.hidden = true;
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  }
  function onKey(event) {
    if (event.key === 'Escape') closeDialog();
  }
  function addButton() {
    if (document.getElementById(BUTTON_ID)) return;
    var oldButton = document.getElementById('uiPaperBtn');
    var button = node('button', oldButton ? oldButton.className : '', 'District Ledger');
    button.id = BUTTON_ID;
    button.type = 'button';
    button.title = 'Open the district edition with story sources and local phrase explanations';
    button.addEventListener('click', openDialog);
    if (oldButton && oldButton.parentNode) oldButton.parentNode.insertBefore(button, oldButton.nextSibling);
    else {
      var toolbar = document.getElementById('uiToolbar');
      if (toolbar) toolbar.appendChild(button);
      else return;
    }
    document.addEventListener('keydown', onKey, true);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', addButton, { once: true });
  else addButton();
})(typeof window !== 'undefined' ? window : this);
</script>

<style id="uxBdCss">/* 20261104bd NEPTUNE: one primary surface. While a prompt or the toast is live, the remaining stacked panels fold too; prompt/desk buttons keep 44px x 120px steady targets */body:has(#prompt.is-live) .notices,body:has(#apToast) .notices,body:has(#prompt.is-live) #tipCard,body:has(#apToast) #tipCard,body:has(#prompt.is-live) .wire,body:has(#apToast) .wire,body:has(#prompt.is-live) #hmWire,body:has(#apToast) #hmWire{display:none!important}body:has(#prompt.is-live) #procBar,body:has(#apToast) #procBar,body:has(#prompt.is-live) .compass,body:has(#apToast) .compass{opacity:.3!important;pointer-events:none!important}body:has(#prompt.is-live) #apToast{opacity:.35;pointer-events:none}#ndFd .fd-hands button,#apToast button{min-width:120px!important}#ndFd .fd-log{overscroll-behavior:contain;scroll-behavior:auto}</style>
<script id="ndBdPaint">/* 20261104bd NEPTUNE: session (ss2) npc speeches reach the floor desk via cabPaint; dedupes against a line already painted */
(function(){ try{ if(typeof ss2NpcSpeak !== "function" || typeof cabPaint !== "function") return; const _sp = ss2NpcSpeak;
  ss2NpcSpeak = function(m){ let said = null; const _ev = window.onumSessionEvent; try{ window.onumSessionEvent = function(e){ try{ if(e && e.action === "speak") said = e.text; }catch(x){} return _ev.apply(this, arguments); }; return _sp.apply(this, arguments); }
    finally{ window.onumSessionEvent = _ev; try{ if(m && said){ const L = document.querySelector("#ndFd .fd-log"), d = L && L.lastElementChild, t = d && d.querySelector(".t"); if(!t || t.textContent !== String(said)) cabPaint(m, said); } }catch(x){} } };
}catch(e){} })();
</script>

<script id="uxBlJs">/* 20261104bl: continued effects (G.baDesk / pending G.followUps) surface IN the sitting (cabinet/council/floor) */
(function(){ function esc(s){ return String(s==null?"":s).replace(/[&<>"]/g,c=>({"&":"&"+"amp;","<":"&"+"lt;",">":"&"+"gt;",'"':"&"+"quot;"}[c])); }
 function items(){ try{ if(typeof G==="undefined"||!G.running) return []; const out=[], seen={};
   (G.baDesk||[]).filter(d=>d.day>=G.day-1).forEach(d=>{ if(seen[d.t]) return; seen[d.t]=1; out.push({t:d.t,d:d.d,who:d.whoId,s:"now"}); });
   (G.followUps||[]).filter(x=>!x.fired).forEach(x=>{ if(seen[x.title]) return; seen[x.title]=1; out.push({t:x.title,d:x.text,who:x.whoId,s:x.day<=G.day?"due":"in "+(x.day-G.day)+"d"}); });
   return out.slice(0,6); }catch(e){ return []; } }
 function paint(){ try{ const s=document.getElementById("ndSess"); if(!s||s.hidden) return; const body=s.querySelector(".ns-body")||s; const L=items();
   let box=s.querySelector(".nsx-fu"); if(!L.length){ if(box) box.remove(); return; }
   const key=L.map(x=>x.t+x.s).join("|"); if(box&&box._k===key) return;
   if(!box){ box=document.createElement("div"); box.className="nsx-fu"; const a=body.querySelector(".nsx-acts"); if(a) body.insertBefore(box,a); else body.appendChild(box); }
   box._k=key; box.innerHTML="<b>Consequences / follow-ups</b>"+L.map((x,i)=>'<button type="button" data-fu="'+i+'" title="'+esc(x.d)+'">'+esc(x.t)+' <i style="opacity:.7">· '+esc(x.s)+(x.who!=null&&typeof byId==="function"&&byId(x.who)?" · "+esc(byId(x.who).name):"")+'</i></button>').join("");
   box.onclick=function(ev){ const b=ev.target.closest("button[data-fu]"); if(!b) return; const x=L[+b.dataset.fu]; if(!x) return;
     try{ const m=x.who!=null&&typeof byId==="function"?byId(x.who):null;
       if(m&&typeof cabAsk==="function"&&typeof SSN!=="undefined"&&SSN){ cabAsk(m,true,"About "+x.t+": "+x.d,"fu"); return; }
       if(m&&typeof openTalk==="function"){ openTalk(m); return; }
       if(typeof setSay==="function") setSay(x.t+" — "+x.d, typeof fx==="function"?fx("",""):undefined); }catch(e){} };
 }catch(e){} }
 setInterval(paint,900); })();</script><style id="nlPromptFit">/* 20261104bm NEPTUNE prompt-fit: options never sit off-screen */
#prompt.is-live:not([hidden]){display:flex!important;flex-direction:column;box-sizing:border-box;max-height:calc(100vh - 96px)!important;max-height:min(calc(100dvh - 96px),calc(100% - 24px))!important;overflow:hidden}
#prompt.is-live>.prompt__h,#prompt.is-live>.prompt__catch-line{flex:none}
#prompt.is-live>.prompt__opts,#prompt.is-live>.prompt__catch-row{flex:1 1 auto;min-height:0;overflow-y:auto!important;overflow-x:hidden;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y;pointer-events:auto;scrollbar-width:thin}
#prompt.is-many .prompt__opts{gap:6px!important}
#prompt.is-many .prompt__btn{min-height:40px!important;min-width:0!important;flex:1 1 calc(50% - 6px);padding:7px 10px;font-size:13px}
#prompt.is-lots .prompt__btn{min-height:36px!important;padding:5px 8px;font-size:12px}
#apToast{max-height:calc(100vh - 140px);max-height:calc(100dvh - 140px);overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y}
#ndFd .fd-hands{max-height:30vh;max-height:30dvh;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#sxDock:not(.fd-on){max-height:calc(100dvh - 160px)}
#sxDock,#sxDock.fd-on>*,.talk.is-open>#tkActs{touch-action:pan-y;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
</style>
<script id="nlPromptFitJs">/* 20261104bm: tag dense prompts; let wheel/touch scroll the option list instead of the world */
(function(){function tag(){var p=document.getElementById("prompt");if(!p)return;var n=p.querySelectorAll(".prompt__btn").length;p.classList.toggle("is-many",n>4);p.classList.toggle("is-lots",n>8);}
function guard(el){if(!el||el._nlFit)return;el._nlFit=1;["wheel","touchmove"].forEach(function(t){el.addEventListener(t,function(e){e.stopPropagation();},{passive:true});});}
function boot(){var p=document.getElementById("prompt");if(!p)return;guard(p);tag();new MutationObserver(tag).observe(p,{childList:true,subtree:true});
new MutationObserver(function(){guard(document.getElementById("apToast"));}).observe(document.body,{childList:true});}
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);else boot();})();</script>
<style id="nnQolCss">/* 20261104bn NEPTUNE QoL: sticky hit targets, readable desk, one-surface, visible focus */
#sxDock button,#tkActs button,.talk.is-open>#tkActs button,#ndFd .fd-hands button{min-height:44px!important;min-width:44px!important;touch-action:manipulation}
#ndSess .nsx-fu button{min-height:40px!important;touch-action:manipulation;line-height:1.3}
#prompt.is-lots .prompt__btn{min-height:40px!important}
#ndFd .fd-log{max-height:38vh;max-height:38dvh;overflow-y:auto!important;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:pan-y;line-height:1.45;font-size:14px}
body:has(#prompt.is-live) #tipCard,body:has(#apToast) #tipCard,body:has(#prompt.is-live) #wire,body:has(#apToast) #wire{display:none!important}
#prompt .prompt__btn:focus-visible,#apToast button:focus-visible,#sxDock button:focus-visible,#tkActs button:focus-visible,#ndSess .nsx-fu button:focus-visible,#ndFd .fd-hands button:focus-visible,.fd-hands button:focus-visible{outline:3px solid #ffe08a!important;outline-offset:-3px;box-shadow:0 0 0 2px #0c0f13}
#prompt .prompt__btn,#tkActs button,#sxDock button,#apToast button,#apToast [role=button],#ndFd .fd-hands button,.fd-hands button{scroll-margin:8px}
</style>
<script id="nnQolJs">/* 20261104bn: scroll containers never take focus; focused options scroll into view; sitting heckles land on the desk as asides */
(function(){function fix(){var p=document.getElementById("prompt");if(!p)return;p.querySelectorAll(".prompt__opts,.prompt__catch-row").forEach(function(c){if(c.getAttribute("tabindex")!=="-1")c.setAttribute("tabindex","-1");});}
function boot(){var p=document.getElementById("prompt");if(p){fix();new MutationObserver(fix).observe(p,{childList:true});}
document.addEventListener("focusin",function(e){var t=e.target;if(!t||!t.closest)return;if(t.closest("#prompt .prompt__opts,#prompt .prompt__catch-row,#apToast,#tkActs,#sxDock,#ndFd .fd-hands")){try{t.scrollIntoView({block:"nearest",inline:"nearest"});}catch(x){}}},true);}
window.addEventListener("onum-session",function(ev){try{var d=ev.detail;if(!d||d.stage!=="interjection"||!d.interjection)return;var I=d.interjection;if(!I.text||I.by==="you"||typeof byId!=="function"||typeof cabPaint!=="function")return;var m=byId(I.by);if(!m)return;if(I.kind==="point_of_order"){cabPaint(m,/^point of order/i.test(I.text)?I.text:"Point of order: "+I.text,true);return;}cabPaint(m,I.text,true);}catch(x){}});
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);else boot();})();</script>
<style id="boLookCss">/* 20261104bo NEPTUNE look punch (bq: glow on real panels #pcScreen desk computer + aside.dossier desk panes; dropped dead office/pzOffice ids and HUD btn hmCab; scoped fd-hands): window-glow on office/desk/chamber panels, soft placards, louder gold focus ring (folds MARS LIVE soft notes from bn) */
#pcScreen,aside.dossier,#ndFd,#ndSess,#sxDock{box-shadow:0 0 0 1px rgba(201,162,74,.35),0 0 22px 2px rgba(255,214,140,.16),inset 0 0 26px rgba(255,224,160,.07),inset 0 1px 0 rgba(255,236,190,.18)!important}
#sxDock>#ndFd,#sxDock>#ndSess{box-shadow:inset 0 0 22px rgba(255,224,160,.06)!important}
#pcScreen .note,#pcScreen .notes,aside.dossier .note,aside.dossier .notes,#ndFd .fd-cue,#ndFd .fd-top,#ndFd .fd-l.aside{letter-spacing:.02em;line-height:1.45;color:#e9dfc4}
#pcScreen .note b,aside.dossier .note b,#ndFd .fd-cue b,#ndFd .fd-top b{color:#e7c87a;letter-spacing:.04em}
#prompt .prompt__btn:focus-visible,#apToast button:focus-visible,#sxDock button:focus-visible,#tkActs button:focus-visible,#ndSess .nsx-fu button:focus-visible,#ndFd .fd-hands button:focus-visible{outline:3px solid #ffe08a!important;outline-offset:2px!important;box-shadow:0 0 0 2px #0c0f13,0 0 0 5px #c9a24a,0 0 14px 4px rgba(255,224,138,.55)!important;position:relative;z-index:1}
#prompt.is-live .prompt__btn:focus-visible,#apToast button:focus-visible{background-color:rgba(255,224,138,.16)!important;color:#fff8e6!important}
</style>
<style id="brEasyCss">/* 20261110br NEPTUNE easy UI (presentation only; off with localStorage onum.easyUi="0"): common-game conventions - one bottom choice bar, big plain verbs, primary first / Back last, color roles gold=primary red=danger slate=neutral, numbered 1-9 badges, one dialogue box with name tag + next cue, short lines with ...more, always-on controls hint */
html.br-easy #prompt.is-live:not(.is-many) .prompt__btn{font-size:14px!important;padding:9px 14px}
html.br-easy #prompt.is-live .prompt__btn{white-space:normal;overflow-wrap:anywhere;line-height:1.3}
html.br-easy #prompt.is-live .prompt__h{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;font-size:14px;line-height:1.4}
html.br-easy #prompt.is-live:hover .prompt__h,html.br-easy #prompt.is-live:focus-within .prompt__h{-webkit-line-clamp:8}
html.br-easy .br-pri{border-color:#c9a24a!important;background-color:rgba(201,162,74,.24)!important;color:#fff8e6!important}
html.br-easy .br-dng{border-color:#d05a4e!important;color:#ffb4aa!important}
html.br-easy .br-back{border-color:#4a5563!important;background-color:#2b333d!important;color:#c9d1dc!important;font-weight:500!important}
html.br-easy #apToast button{min-width:96px;font-weight:700;font-size:14px!important;padding:8px 14px!important}
html.br-easy [data-btn]::after,html.br-easy [data-brn]::after{width:18px!important;height:18px!important;line-height:18px!important;font-size:11px!important;top:-8px!important;right:-8px!important;background:#ffe08a!important;color:#111!important;border:1px solid #0c0f13!important;box-shadow:0 1px 3px rgba(0,0,0,.6)}
html.br-easy [data-brn]{position:relative}
html.br-easy [data-brn]::after{content:attr(data-brn);position:absolute;text-align:center;border-radius:50%;font-family:"JetBrains Mono",monospace;font-weight:700;pointer-events:none}
html.br-easy #tkName{display:inline-block;background:#c9a24a;color:#111;font:700 15px Georgia,serif;letter-spacing:.02em;padding:3px 12px;border-radius:6px 6px 6px 0;box-shadow:0 2px 0 #7a5f22}
html.br-easy #talk.is-open #tkSay.br-long:not(.br-open){display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:4;overflow:hidden;max-height:none}
html.br-easy #brSayRow{display:none;align-items:center;justify-content:flex-end;gap:10px;margin:-2px 0 6px;max-width:72ch;font:12px system-ui,sans-serif;color:#c9d1dc}
html.br-easy #talk.is-open #brSayRow{display:flex}
#brSayRow .br-mo{background:none;border:0;color:#e7c87a;font:700 12px system-ui,sans-serif;cursor:pointer;padding:2px 4px;min-height:0!important;min-width:0!important}
#brSayRow .br-mo[hidden]{display:none}
#brSayRow .br-nx{color:#ffe08a;font-size:14px;animation:brNx 1.1s ease-in-out infinite}
@keyframes brNx{0%,100%{transform:translateY(0);opacity:1}50%{transform:translateY(3px);opacity:.45}}
@media (prefers-reduced-motion:reduce){#brSayRow .br-nx{animation:none}}
html.br-easy #ndFd .fd-l>b{display:inline-block;background:rgba(201,162,74,.16);border-radius:4px;padding:0 5px;margin-right:2px}
html.br-easy #ndFd .fd-l.br-has:not(.br-open)>.t{display:none}
html.br-easy #ndFd .fd-l.br-has.br-open>.br-v{display:none}
#ndFd .fd-l>.br-v{display:none}
html.br-easy #ndFd .fd-l.br-has>.br-v{display:inline}
#ndFd .fd-l .br-mo{color:#e7c87a;font-weight:700;font-style:normal;margin-left:4px;white-space:nowrap}
#brHint{position:fixed;left:10px;bottom:28px;z-index:10045;max-width:min(560px,calc(100vw - 20px));pointer-events:none;background:rgba(12,15,19,.82);color:#c9d1dc;border:1px solid #4a5563;border-radius:8px;padding:4px 10px;font:12px/1.5 system-ui,sans-serif;letter-spacing:.01em}
#brHint kbd{display:inline-block;min-width:16px;text-align:center;background:#2b333d;color:#ffe08a;border:1px solid #4a5563;border-bottom-width:2px;border-radius:4px;padding:0 4px;margin:0 2px;font:700 11px "JetBrains Mono",monospace}
#brHint[hidden],html:not(.br-easy) #brHint,html:not(.br-easy) #brSayRow{display:none!important}
/* 20261110bt: hint sits above #ndFd (10040), below #ndAuditBtn (10049) / modals (10050) / #clPanel + #tipCard (100000+); hidden while pause or a modal is up; placement is clamped inside the viewport and away from option buttons */
</style>
<script id="brEasyJs">/* 20261110br NEPTUNE easy UI (20261110bt: clean on/off teardown, inert-toast Esc, hint clamp + z-order, code-point-safe cut, stage-direction-only plain): presentation layer only. Never rewrites game/engine text: #tkSay and .fd-l .t keep their exact text (other code reads them); simplified copies sit beside them. 1-9 picks docked choices only when no existing handler took the key. Esc = the visible Back/Walk away. Disable: onumEasyUi.off() (live, full teardown) or localStorage.setItem("onum.easyUi","0") then reload. */
(function(){
  var R = document.documentElement, running = false, iv = 0, q = 0, obs = [], moved = [];
  var BACK = /^(back|cancel|close|leave( it)?|walk (out|away)|not now|never ?mind|no,? thanks|later|skip|dismiss|step away)$/i;
  var DANGER = /\b(veto|reject|refuse|resign|impeach|fire|sack|attack|declare war|strike|arrest|expel|censure|vote no|nay|against)\b/i;
  function lab(b){ var raw = b.textContent || ""; if(b._brRaw === raw) return b._brL; var t = ""; try{ var c = b.cloneNode(true); c.querySelectorAll("u").forEach(function(u){ u.remove(); }); t = c.textContent; }catch(x){ t = b.textContent || ""; } t = String(t).replace(/\s+/g, " ").trim(); b._brRaw = raw; b._brL = t; return t; }
  function vis(b){ return !!(b && !b.disabled && !b.hidden && (b.offsetParent || b.getClientRects().length)); }
  function typing(){ var a = document.activeElement; if(!a) return false; var tg = (a.tagName || "").toLowerCase(); return tg === "input" || tg === "textarea" || tg === "select" || !!a.isContentEditable; }
  function setTitle(el, v){ if(el._brT0 === undefined) el._brT0 = el.getAttribute("title"); if(el.getAttribute("title") !== v) el.setAttribute("title", v); }
  function unTitle(el){ if(el._brT0 === undefined) return; if(el._brT0 === null) el.removeAttribute("title"); else el.setAttribute("title", el._brT0); el._brT0 = undefined; }
  /* roles + order: primary first, Back/Walk out last (prompt + talk acts only; data-gp keeps clicks correct). Every move is journaled so off() can put the game's own order back. */
  function roles(box, reorder, noPri){ if(!box) return; var bs = [].slice.call(box.querySelectorAll("button")); var back = [], pri = null;
    bs.forEach(function(b){ var t = lab(b), isB = BACK.test(t) || b.classList.contains("talk__btn--exit") || b.id === "sitOut" || b.dataset.ap === "away";
      if(b.classList.contains("br-back") !== isB) b.classList.toggle("br-back", isB);
      var isD = !isB && (DANGER.test(t) || b.classList.contains("talk__btn--risk")); if(b.classList.contains("br-dng") !== isD) b.classList.toggle("br-dng", isD);
      if(t.length > 60 && b.title !== t) setTitle(b, t);
      if(isB) back.push(b); else if(!pri && !isD && !b.disabled) pri = b; });
    if(!noPri) bs.forEach(function(b){ var p = b === pri; if(b.classList.contains("br-pri") !== p) b.classList.toggle("br-pri", p); });
    if(reorder && back.length){ var par = back[0].parentNode, mv = false; back.forEach(function(b){ if(b.parentNode === par && par.lastElementChild !== b){ var after = b.nextElementSibling; var allBackAfter = true; while(after){ if(!after.classList.contains("br-back")){ allBackAfter = false; break; } after = after.nextElementSibling; } if(!allBackAfter){ moved = moved.filter(function(m){ return m.b.isConnected; }); moved.push({ b:b, par:par, next:b.nextSibling }); par.appendChild(b); mv = true; } } });
      if(mv){ try{ if(typeof markPicks === "function") markPicks(); }catch(x){} } } }
  /* numbered dock choices when the game's own 1-9 badges are not up */
  var DOCK = ["#apToast", "#ndFd", "#sxDock"];
  function dockNums(){ var own = [].slice.call(document.querySelectorAll("[data-btn]")).some(vis), want = [];
    var pr = document.getElementById("prompt"), live = pr && !pr.hidden && pr.classList.contains("is-live");
    if(!own && !live){ for(var i = 0; i < DOCK.length; i++){ var c = document.querySelector(DOCK[i]); if(!c || c.hidden || !vis(c)) continue;
      var bs = [].slice.call(c.querySelectorAll("button")).filter(function(b){ return vis(b) && !b.classList.contains("fd-min") && !b.classList.contains("fd-send") && !b.classList.contains("fd-cancel") && !b.closest("#sxDockHead") && b.id !== "sitOut" && !b.classList.contains("br-mo") && /[A-Za-z0-9]/.test(lab(b)); });
      var main = bs.filter(function(b){ return !b.classList.contains("br-back"); }), bk = bs.filter(function(b){ return b.classList.contains("br-back"); });
      want = main.concat(bk).slice(0, 9); if(want.length) break; } }
    document.querySelectorAll("[data-brn]").forEach(function(b){ if(want.indexOf(b) < 0) b.removeAttribute("data-brn"); });
    want.forEach(function(b, n){ var v = String(n + 1); if(b.getAttribute("data-brn") !== v) b.setAttribute("data-brn", v); }); return want; }
  /* plain-language view of a desk line: only genuine stage directions come out (sighs / pauses / leans in ...); labels like "Option (1)", "(3) The motion", "[sic]", "[the Speaker]" stay. Full text stays in .t / the log */
  var STAGE_V = /^(sigh|pause|lean|smile|smil|smirk|nod|nodd|laugh|chuckle|chuckl|frown|shrug|shrugg|cough|clear|whisper|mutter|murmur|grin|grinn|glance|glanc|look|stare|star|wince|winc|scoff|snort|sniff|sniffle|sniffl|blink|wave|wav|gesture|gestur|tap|tapp|drum|fold|rub|rubb|hesitate|hesitat|beat|aside|exhale|exhal|inhale|inhal|breathe|breath|swallow|adjust|straighten|squint|yawn|groan|grumble|grumbl|hum|humm|clap|clapp|gavel|applause|laughter|silence|crosstalk|inaudible|gasp|teary|tearful|quietly|softly|dryly|coldly|flatly|grimly|wryly|sharply|slowly|firmly|calmly|angrily|sadly|nervously|reluctantly|sarcastically|ironically|bluntly|wearily|warily|thoughtfully)(s|es|ed|d|ing)?$/;
  var STAGE_NO = /^(sic|sics|ibid|emphasis|citation|cite|note|see|cf|etc|redacted|inaudible text)$/;
  function stage(inner){ var w = String(inner || "").trim(); if(!w || w.length > 60) return false; if(/[0-9A-Z]/.test(w)) return false; if(!/^[a-z][a-z' ,\-\u2019.]*$/.test(w)) return false; if(STAGE_NO.test(w.replace(/[.,]+$/, ""))) return false;
    var ws = w.split(/\s+/); if(ws.length > 6) return false; var f = ws[0].replace(/[^a-z]/g, ""); return STAGE_V.test(f); }
  function plain(s){ var o = String(s || ""), t = o;
    t = t.replace(/(^|[^*])\*([^*\n]{1,90})\*(?!\*)/g, function(m, p, w){ return /[0-9]/.test(w) || /\b(option|motion|bill|amendment|section|article|vote|item)\b/i.test(w) ? m : p + " "; });
    t = t.replace(/\[(?!\[)([^\]\n]{1,90})\]/g, function(m, w){ return stage(w) ? " " : m; });
    t = t.replace(/\(([^()\n]{1,90})\)/g, function(m, w){ return stage(w) ? " " : m; });
    t = t.replace(/\s+([,.;:!?])/g, "$1").replace(/\s+/g, " ").trim(); t = t.replace(/^[,;:]\s*/, "");
    if(!t || !/[A-Za-z0-9]/.test(t)) t = o.trim(); return t; }
  /* code-point / grapheme safe: never splits a surrogate pair or a ZWJ emoji at the cut */
  function units(t){ try{ if(typeof Intl !== "undefined" && Intl.Segmenter){ var out = []; var it = new Intl.Segmenter(undefined, { granularity:"grapheme" }).segment(t); for(var g of it) out.push(g.segment); return out; } }catch(x){} return Array.from(t); }
  function clen(t){ var n = 0; for(var c of String(t)) n++; return n; }
  function cut(t){ t = String(t || ""); if(clen(t) <= 140) return { s:t, more:false }; var u = units(t); if(u.length <= 140) return { s:t, more:false };
    var head = u.slice(0, 141).join(""), m = head.match(/^[\s\S]{40,}?[.!?](?=\s|$)/), s; if(m && units(m[0]).length <= 140) s = m[0]; else s = u.slice(0, 140).join("").replace(/\s+\S*$/, "") + "\u2026"; return { s:s, more:true }; }
  function deskLines(){ var L = document.querySelector("#ndFd .fd-log"); if(!L) return; [].forEach.call(L.children, function(d){ if(!d.classList.contains("fd-l") || d._brDone) return; var t = d.querySelector(".t"); if(!t || d._full == null) return; if(t.textContent !== String(d._full)) return;
      d._brDone = String(d._full); var p = plain(d._full), c = cut(p); if(!c.more && p === String(d._full).trim()) return;
      var v = d.querySelector(".br-v"); if(!v){ v = document.createElement("span"); v.className = "br-v"; d.appendChild(v); }
      v.textContent = c.s; if(c.more || p !== String(d._full).trim()){ var mo = document.createElement("span"); mo.className = "br-mo"; mo.textContent = /\u2026$/.test(c.s) ? "more" : "\u2026more"; v.appendChild(mo); }
      setTitle(d, "Click for the full line"); d.classList.add("br-has"); }); }
  function onClick(e){ var t = e.target; if(!running || !t || !t.closest) return; var d = t.closest("#ndFd .fd-l.br-has"); if(d) d.classList.toggle("br-open"); }
  /* dialogue box: name tag, clamp long lines with ...more, visible next cue (text in #tkSay is never touched) */
  function talkBox(){ var s = document.getElementById("tkSay"); if(!s) return; var row = document.getElementById("brSayRow");
    if(!row){ row = document.createElement("div"); row.id = "brSayRow"; row.innerHTML = '<button type="button" class="br-mo tk-nonum" hidden>\u2026more</button><span class="br-nx" aria-hidden="true">\u25B6</span>'; s.parentNode.insertBefore(row, s.nextSibling);
      row.querySelector(".br-mo").addEventListener("click", function(e){ try{ e.stopPropagation(); }catch(x){} var o = s.classList.toggle("br-open"); this.textContent = o ? "less" : "\u2026more"; }); }
    var long = clen(s.textContent || "") > 140; if(s.classList.contains("br-long") !== long){ s.classList.toggle("br-long", long); if(!long) s.classList.remove("br-open"); var mo = row.querySelector(".br-mo"); mo.hidden = !long; mo.textContent = s.classList.contains("br-open") ? "less" : "\u2026more"; } }
  /* always-visible controls hint (one line, context aware) */
  function K(k){ return "<kbd>" + k + "</kbd>"; }
  var hintKey = "";
  var MODAL = ["#ndStyle", "#ndFam", "#ndPb", "#ndAudit", "#clPanel"];
  function modalUp(){ var po = document.getElementById("pauseOverlay"); if(po && po.classList.contains("is-open")) return true; for(var i = 0; i < MODAL.length; i++){ var m = document.querySelector(MODAL[i]); if(m && !m.hidden && vis(m)) return true; } return false; }
  function hint(){ var H = document.getElementById("brHint"); if(!H){ H = document.createElement("div"); H.id = "brHint"; H.setAttribute("aria-hidden", "true"); document.body.appendChild(H); }
    var pr = document.getElementById("prompt"), live = pr && !pr.hidden && pr.classList.contains("is-live"), tk = document.getElementById("talk"), talk = tk && tk.classList.contains("is-open"),
      ap = document.getElementById("apToast"), fd = document.getElementById("ndFd"), desk = fd && !fd.hidden, vl = document.getElementById("veil"), card = vl && !vl.hidden && !vl.classList.contains("sitx"), nums = !!document.querySelector("[data-btn],[data-brn]"), k;
    if(typing()) k = "type"; else if(card) k = "card"; else if(live) k = "live"; else if(apLive(ap)) k = "ap"; else if(talk) k = "talk"; else if(desk) k = "desk"; else k = "walk"; k += nums ? "+n" : "";
    if(k === hintKey) return; hintKey = k; var n = nums ? K("1") + "\u2013" + K("9") + " choose \u00B7 " : "", h;
    switch(k.replace("+n", "")){
      case "type": h = K("Enter") + " send \u00B7 " + K("Esc") + " stop typing"; break;
      case "card": h = n + "click to pick \u00B7 " + K("Esc") + " close"; break;
      case "live": h = n + K("E") + " first choice \u00B7 click to pick \u00B7 " + K("Esc") + " back"; break;
      case "ap": h = n + K("Esc") + " walk away"; break;
      case "talk": h = n + K("Enter") + " say your own \u00B7 " + K("Esc") + " leave"; break;
      case "desk": h = n + K("Space") + " finish line \u00B7 click a line for more \u00B7 " + K("Esc") + " back"; break;
      default: h = K("W") + K("A") + K("S") + K("D") + " move \u00B7 " + K("E") + " interact \u00B7 click to pick \u00B7 " + K("Esc") + " menu"; }
    H.innerHTML = h; }
  /* keep the hint fully on screen and off every option button: bottom-left lifted over the docks if it fits, else top-left / top-right / bottom-right; hidden if no clear spot or a modal/pause is up */
  var PANELS = ["#sxDock", "#ndFd", "#talk.is-open", "#prompt.is-live", "#apToast", "#hmBar"], BTNBOX = "#prompt.is-live button,#apToast button,#ndFd button,#sxDock button,#tkActs button,#talk.is-open button,#hmBar button,#veil:not([hidden]) button";
  function rects(list){ var out = []; list.forEach(function(e){ if(!e || e.hidden || !vis(e)) return; var r = e.getBoundingClientRect(); if(r.width >= 2 && r.height >= 2) out.push(r); }); return out; }
  function hit(a, rs, pad){ for(var i = 0; i < rs.length; i++){ var r = rs[i]; if(a.l < r.right + pad && a.r > r.left - pad && a.t < r.bottom + pad && a.b > r.top - pad) return true; } return false; }
  function hintPlace(){ var H = document.getElementById("brHint"); if(!H) return; if(modalUp()){ if(!H.hidden) H.hidden = true; return; }
    var vw = window.innerWidth || R.clientWidth || 0, vh = window.innerHeight || R.clientHeight || 0, M = 8; if(H.hidden) H.hidden = false;
    var w = H.offsetWidth, h = H.offsetHeight; if(!w || !h || !vw || !vh) return;
    var panels = rects(PANELS.map(function(q){ return document.querySelector(q); })), btns = rects([].slice.call(document.querySelectorAll(BTNBOX)));
    var lift = 28; panels.forEach(function(r){ if(r.left > 10 + w || r.right < 10) return; if(r.bottom >= vh - 120 && r.top < vh - lift) lift = Math.max(lift, Math.round(vh - r.top + 6)); });
    var C = [{ k:"bl", l:10, t:vh - lift - h }, { k:"tl", l:10, t:M + 2 }, { k:"tr", l:vw - w - 10, t:M + 2 }, { k:"br", l:vw - w - 10, t:vh - 28 - h }], pick = null;
    C.forEach(function(c){ c.r = c.l + w; c.b = c.t + h; c.ok = c.l >= 0 && c.t >= M && c.r <= vw && c.b <= vh - M; });
    for(var pass = 0; pass < 2 && !pick; pass++) for(var i = 0; i < C.length; i++){ var c = C[i]; if(!c.ok || hit(c, btns, 4)) continue; if(pass === 0 && hit(c, panels, 2)) continue; pick = c; break; }
    if(!pick){ if(!H.hidden) H.hidden = true; return; }
    var st = { left:pick.l + "px", top:pick.t + "px", right:"auto", bottom:"auto" }; for(var p in st) if(H.style[p] !== st[p]) H.style[p] = st[p]; if(H.dataset.pos !== pick.k) H.dataset.pos = pick.k; }
  function tick(){ if(!running) return; try{ var pr = document.getElementById("prompt"); if(pr) roles(pr.querySelector(".prompt__opts"), true); roles(document.getElementById("tkActs"), true); roles(document.getElementById("apToast"), false); roles(document.getElementById("sxDock") || document.getElementById("ndFd"), false, true); var fd = document.getElementById("ndFd"); if(fd && !fd.closest("#sxDock")) roles(fd, false, true); }catch(x){}
    try{ dockNums(); }catch(x){} try{ deskLines(); }catch(x){} try{ talkBox(); }catch(x){} try{ hint(); hintPlace(); }catch(x){} }
  function soon(){ if(q || !running) return; q = setTimeout(function(){ q = 0; tick(); }, 60); }
  /* Esc target: the toast only when it is really clickable (not dimmed / pointer-events:none / under a live prompt / covered) */
  function apLive(ap){ if(!ap || !vis(ap)) return false; var pr = document.getElementById("prompt"); if(pr && !pr.hidden && pr.classList.contains("is-live")) return false;
    try{ var cs = getComputedStyle(ap); if(cs.pointerEvents === "none" || cs.visibility === "hidden" || parseFloat(cs.opacity) < 0.5) return false; }catch(x){}
    var b = [].slice.call(ap.querySelectorAll("button.br-back,button[data-ap]")).filter(vis)[0]; if(b){ try{ var r = b.getBoundingClientRect(), el = document.elementFromPoint(r.left + r.width / 2, r.top + r.height / 2); if(el && !ap.contains(el)) return false; }catch(x){} } return true; }
  function onNum(e){ try{ if(!running || !R.classList.contains("br-easy") || e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey || e.repeat || typing()) return; var k = e.key || ""; if(k.length !== 1 || k < "1" || k > "9") return;
      var b = [].slice.call(document.querySelectorAll('[data-brn="' + k + '"]')).filter(vis)[0]; if(!b) return; e.preventDefault(); b.click(); soon(); }catch(x){} }
  function onEsc(e){ try{ if(!running || e.key !== "Escape" || !R.classList.contains("br-easy") || e.defaultPrevented || e._pzHandled || typing()) return; var tk = document.getElementById("talk"); if(tk && tk.classList.contains("is-open")) return; var po = document.getElementById("pauseOverlay"); if(po && po.classList.contains("is-open")) return;
      var vl = document.getElementById("veil"); if(vl && !vl.hidden && !vl.classList.contains("sitx")) return; var a = document.activeElement, box = null, ap = document.getElementById("apToast"), pr = document.getElementById("prompt"), soft = false;
      if(apLive(ap)) box = ap; else if(pr && !pr.hidden && pr.classList.contains("is-live")){ box = pr; soft = true; } else if(a && a.closest) box = a.closest("#prompt,#ndFd,#sxDock"); if(!box) return;
      var pick = function(c){ return c ? [].slice.call(c.querySelectorAll("button.br-back")).filter(function(x){ return vis(x) && !x.classList.contains("fd-cancel"); })[0] : null; };
      var b = pick(box) || (box.closest && box.closest("#sxDock") ? pick(box.closest("#sxDock")) : null); if(!b) return; e.preventDefault(); if(!soft) e.stopImmediatePropagation(); b.click(); soon(); }catch(x){} }
  function start(){ if(running) return; running = true; R.classList.add("br-easy"); hintKey = "";
    window.addEventListener("keydown", onNum); window.addEventListener("keydown", onEsc, true); document.addEventListener("click", onClick);
    tick(); iv = setInterval(tick, 450); var pr = document.getElementById("prompt"); if(pr){ var o1 = new MutationObserver(soon); o1.observe(pr, { childList:true, subtree:true }); obs.push(o1); } var ta = document.getElementById("tkActs"); if(ta){ var o2 = new MutationObserver(soon); o2.observe(ta, { childList:true }); obs.push(o2); }
    var s = document.getElementById("tkSay"); if(s){ var o3 = new MutationObserver(function(){ if(running) try{ talkBox(); }catch(x){} }); o3.observe(s, { childList:true, characterData:true, subtree:true }); obs.push(o3); } }
  function stop(){ if(!running && !R.classList.contains("br-easy")) return; running = false; if(iv) clearInterval(iv); iv = 0; if(q) clearTimeout(q); q = 0; obs.forEach(function(o){ try{ o.disconnect(); }catch(x){} }); obs = [];
    window.removeEventListener("keydown", onNum); window.removeEventListener("keydown", onEsc, true); document.removeEventListener("click", onClick);
    var undo = moved.length > 0; for(var i = moved.length - 1; i >= 0; i--){ var m = moved[i]; try{ if(m.b.parentNode === m.par && m.next && m.next.parentNode === m.par && m.next !== m.b) m.par.insertBefore(m.b, m.next); }catch(x){} } moved = [];
    document.querySelectorAll("[data-brn]").forEach(function(b){ b.removeAttribute("data-brn"); });
    document.querySelectorAll(".br-pri,.br-dng,.br-back").forEach(function(b){ b.classList.remove("br-pri", "br-dng", "br-back"); if(!b.getAttribute("class")) b.removeAttribute("class"); unTitle(b); });
    document.querySelectorAll("#ndFd .fd-l").forEach(function(d){ var v = d.querySelector(":scope > .br-v"); if(v) v.remove(); d.classList.remove("br-has", "br-open"); if(!d.getAttribute("class")) d.removeAttribute("class"); unTitle(d); d._brDone = undefined; });
    document.querySelectorAll("button").forEach(function(b){ if(b._brT0 !== undefined) unTitle(b); });
    var s = document.getElementById("tkSay"); if(s){ s.classList.remove("br-long", "br-open"); if(!s.getAttribute("class")) s.removeAttribute("class"); }
    ["brSayRow", "brHint"].forEach(function(id){ var e = document.getElementById(id); if(e) e.remove(); }); hintKey = "";
    R.classList.remove("br-easy"); if(undo){ try{ if(typeof markPicks === "function") markPicks(); }catch(x){} } }
  window.onumEasyUi = { stamp:"20261110bt", get running(){ return running; },
    off:function(){ try{ localStorage.setItem("onum.easyUi", "0"); }catch(x){} stop(); },
    on:function(){ try{ localStorage.removeItem("onum.easyUi"); }catch(x){} if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", start, { once:true }); else start(); },
    _t:{ plain:plain, cut:cut, stage:stage } };
  var on = true; try{ on = localStorage.getItem("onum.easyUi") !== "0"; }catch(x){}
  if(!on) return;
  R.classList.add("br-easy");
  if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", start, { once:true }); else start();
})();</script>
