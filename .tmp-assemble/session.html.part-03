    else if(s.exec.act === "signed") wlNote(sp, G.you, 4, "You signed my " + s.title + "."); });
}
/* ── each night, each member weighs what to do, and does the thing that matters most to them ── */
/* a grievance is a wrong they can name: what was done to them, recorded or remembered, not a general dislike */
function wlMemAbout(m, x){ const re = x === G.you ? /^you\b/i : new RegExp("^(" + String(x.name).replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "|" + String(surname(x.name)).replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")\\b"); let g = 0; (m.mem || []).forEach(e => { if(e && e.w < 0 && G.day - (e.d || 0) <= 30 && re.test(String(e.t))) g += e.w; }); return g; }
function wlWorst(m){
  const S = wlStore(); let best = null;
  wlCast().concat(G.you && !G.you.out ? [G.you] : []).forEach(x => { if(x === m) return;
    const grudge = x === G.you ? 0 : Math.min(0, S.reg[wlKey(m, x)] || 0), mem = wlMemAbout(m, x), base = x === G.you ? Math.min(0, (m.rel && m.rel.warmth) || 0) / 2 : Math.min(0, wlRegard(m, x) - grudge) / 4;
    if(!(grudge < 0 || mem < 0) || !wlWhy(m, x)) return;
    let g = grudge + mem + base; if(G.day - (S.at["w" + (x.id != null ? x.id : "you")] || -99) < 4) g *= 0.3;   /* somebody already had their say this week */
    if(!best || g < best.r) best = {t:x, r:g}; });
