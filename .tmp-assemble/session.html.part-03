function sxParkTick(){
  try{
    const D = document.getElementById("sxDock"); if(!D) return;
    let bar = document.getElementById("sxParkBar"), tab = document.getElementById("sxTab");
    if(!bar){ bar = document.createElement("div"); bar.id = "sxParkBar";
      bar.innerHTML = '<button type="button" data-p="park" title="Park the meeting on the right edge" aria-label="Park the meeting panel on the side">\u21e5</button><button type="button" data-p="close" title="Close the meeting panel" aria-label="Close the meeting panel">\u2715</button>';
      bar.onclick = e => { const b = e.target.closest("button"); if(!b) return; if(b.dataset.p === "close"){ SXP.closed = true; SXP.park = true; } else { SXP.park = true; SXP.closed = false; } sxParkTick(); };
      document.body.appendChild(bar); }
    if(!tab){ tab = document.createElement("button"); tab.type = "button"; tab.id = "sxTab"; tab.title = "Open the meeting panel";
      tab.onclick = () => { SXP.park = false; SXP.closed = false; sxParkTick(); }; document.body.appendChild(tab); }
    const S = typeof sxdSession === "function" ? sxdSession() : null, sit = typeof SIT !== "undefined" && SIT.on ? 1 : 0;
    const key = S ? String(S.kind || "") + "|" + String(S.bodyId || S.title || "") : sit ? "sit" : "";
