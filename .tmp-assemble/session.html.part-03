  if(G.day % 7 === 0){ const line = "TREASURY · balance " + money(T.bal) + "; the week took in " + money(rv * 7) + " and paid out " + money(out * 7) + ". The guilder stands at " + (G.money ? G.money.index.toFixed(1) : "?") + "."; T.log.unshift({d:G.day, t:line.replace(/^TREASURY · /, "")}); if(T.log.length > onumLim(12,"hist")) T.log.length = onumLim(12,"hist"); try{ feed(line, "news"); }catch(e){} }
