    calibration:{score:Math.round(X.cal), applied:X.applied, repeated:X.repeated}, charter:Object.keys(EX_BOUND).map(k => ({k, t:EX_BOUND[k].t, enforced:true, repealable:false})), conflicts:X.conflicts.slice(), halt:X.halt, caseStated:X.case || null, askers:X.askers || {}, revisions:(X.revisions || []).slice(0, 6)};
  }catch(e){ return {ok:false, reason:String(e)}; } };
