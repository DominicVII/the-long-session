window.ONUM_ENGINE_CHARTER = {limits:Object.keys(EX_BOUND).map(k => ({k, rule:EX_BOUND[k].t, enforced:true}))};
setInterval(() => { try{ exWrapLT(); if(G && G.you && G.eng && G.eng.v === 1){ const X = exStore(); window.ONUM_ENGINE_REFUSED = X.refused.slice(); } }catch(e){} }, 2000);
