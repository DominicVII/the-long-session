  A.granted = X.granted.slice(); A.refusedStances = (X.refusedStances || []).slice(); A.unknownNames = (X.unknownNames || []).slice(-10); A.stripped = X.stripped || 0; A.wordQueue = window.onumEngineWordQueue();
  A.stability = E.esStab && E.esStab.length ? +(E.esStab.reduce((a, b) => a + b, 0) / E.esStab.length).toFixed(2) : null; A.offSwitch = {holder:"President", vetoable:false, halted:exHalted(E)};
  A.breaches = X.breaches.slice(); A.refused = X.refused.slice(); } }catch(e){} return A; }; }
setInterval(() => { try{ esWrapLT(); }catch(e){} }, 2000);

/* ══ 20261025g · WHAT PEOPLE KNOW. Every person carries a share of the Republic's real record: the laws as they were voted,
   the rulings, who holds which office and who held it, what the states and the powers have said and done, the wins of the
   player's career. They learn it the way people learn: by being there, from the papers, from someone who told them, and
   they forget the small things first. They pass it on to the people they talk to, choosing what the other has not heard;
   they reason from it to judgements of their own; they count the next roll call from what they know and learn from being
   wrong; and when they do not know, they say so and name who would. Nothing here is invented: every fact is read from the
   game's own record (the statute book, the cases, the history, the offices ledger, the states' and powers' logs, the
   career). The Engine reads the same public record, nothing private, forecasts each roll call from it and is scored. ══ */
const KN = {ev:[], byK:{}, byH:{}, sig:"", ofhN:0, line:new WeakMap(), kc:new Map(), bel:new Map(), prof:new Map(), profDay:-1, since:new Map(), last:{}, adj:null, adjDay:-1, day:0, told:0};
const KN_SHARE = {law:1, case:1, hist:1, offchg:1, sc:1, pol:1, war:1, career:1, rn:1, bill:1, ovr:1, sact:1};
const KN_STOP = new Set("the a an of and for to in on at by with act acts bill bills law laws reform republic national federal union new old who what when did does was were has have how its it is are you your about".split(" "));
function knStore(){ if(!G.kn || G.kn.v !== 1) G.kn = {v:1, p:{}, st:{}, cal:{}, fc:null, eng:null}; return G.kn; }
function knH(a, b){ let h = seedOf(a + "␟" + b); h ^= h >>> 16; h = Math.imul(h, 0x85ebca6b); h ^= h >>> 13; h = Math.imul(h, 0xc2b2ae35); h ^= h >>> 16; return (h >>> 0) / 4294967296; }   /* 20261027c: mixed, so neighbouring keys do not land together */
function knHash(k){ return seedOf(k).toString(36); }
function knClean(t){ return String(t == null ? "" : t).replace(/\b(the)\s+the\b/gi, "$1").replace(/\s+/g, " ").replace(/[\s.]+$/, "").trim(); }
function knCap(t){ t = String(t || ""); return t.charAt(0).toUpperCase() + t.slice(1); }
function knOrd(n){ const s = ["th","st","nd","rd"], v = n % 100; return n + (s[(v - 20) % 10] || s[v] || s[0]); }
function knT(){ return G.termLength || 52; }
function knYouFix(t){ const n = (G.you && G.you.name) || "the President"; return String(t || "").replace(/\bto you\b/g, "to " + n).replace(/\bby you\b/g, "by " + n); }
function knStates(){ const s = new Set(typeof STATES !== "undefined" ? STATES : []); try{ (G.states || []).forEach(x => x && x.n && s.add(x.n)); }catch(e){} return [...s]; }
/* "New Orange" is how people say Nieuw Oranje out loud */
function knNorm(t){ return String(t || "").toLowerCase().replace(/\bnieuw\b/g, "new").replace(/\boranje\b/g, "orange").replace(/[^a-z0-9' ]/g, " ").replace(/\s+/g, " ").trim(); }
function knStateIn(t){ const q = " " + knNorm(t) + " "; let best = null; knStates().forEach(n => { if(q.indexOf(" " + knNorm(n) + " ") >= 0 && (!best || n.length > best.length)) best = n; }); return best; }
function knWords(t){ return knNorm(t).split(" ").filter(w => w.length > 2 && !KN_STOP.has(w)); }
function knWhen(d){
  if(d == null) return ""; if(d < -100) return "long before any of us";
  const a = (G.day || 0) - d; if(a < 0) return "";
  if(a === 0) return "today"; if(a === 1) return "yesterday"; if(a <= 6) return a + " days ago"; if(a <= 13) return "last week"; if(a <= 45) return "some weeks ago";
  return "back in the " + knOrd(Math.max(1, Math.floor((Math.max(1, d) - 1) / knT()) + 1)) + " Congress";
}
function knWhenC(e){ if(e.now) return ""; const w = knWhen(e.d); return w ? ", " + w : ""; }
function knSent(e){ return knCap(e.t); }
function knTie(a, b){ const T = G.ties || {}; const t = T[a + "|" + b] || T[b + "|" + a]; return t ? t.w : null; }
function knPerson(id){ if(id == null) return null; if(id === "you") return G.you; if(typeof id === "object") return id; try{ return byId(isNaN(+id) ? id : +id) || byId(id) || everyone().find(p => p && String(p.id) === String(id)) || null; }catch(e){ return null; } }
function knNameOf(id){ const p = knPerson(id); return p ? p.name : null; }

/* ── the record, read fresh whenever it changes ── */
function knEvents(){
  const sc = G.sc || {}, wm = G.wm || {}, st0 = (G.statute || [])[0] || {};
  const sig = [G.day, (G.statute || []).length, st0.title, st0.day, (G.history || []).length, (G.cases || []).filter(c => c && c.done).length + "/" + (G.cases || []).length, (G.statute || []).map(s => (s.fate || "?").charAt(0) + (s.ovr && s.ovr.done ? "o" : "")).join(""), ((G.lx && G.lx.sacts) || []).length, (sc.log || []).length, (sc.polities || []).map(p => p.status).join(","),
    (G.career || []).length, (G.reactNews || []).length, (G.secrets || []).length, G.bill ? G.bill.id + (G.bill.done ? "d" : "") : "-", KN.ofhN, JSON.stringify(wm.rec || {}).length, Object.keys(G.realmRel || {}).map(k => Math.round(G.realmRel[k] / 20)).join("")].join("|");
  if(KN.ev.length && KN.sig === sig) return KN.ev;
  const E = [], seen = new Set(), seenT = new Set(), T = knT(), you = G.you || {};
  let named = null; const idOf = n => { if(!n) return null; if(you.name === n) return "you"; if(!named){ named = new Map(); try{ everyone().forEach(q => { if(q && q.name && !named.has(q.name)) named.set(q.name, q.id); }); }catch(e){} } return named.has(n) ? named.get(n) : null; };
  const add = e => { if(!e || !e.k || !e.t || seen.has(e.k)) return; e.t = knClean(e.t); if(!e.t) return; const tk = e.kind + ":" + e.t; if(seenT.has(tk)) return; seen.add(e.k); seenT.add(tk);
    e.h = knHash(e.k); e.sal = clamp(e.sal == null ? 0.4 : e.sal, 0.05, 1); e.pub = e.pub !== false; e.who = e.who || []; e.ids = (e.ids || []).filter(x => x != null); E.push(e); };
  /* the statute book: every bill the House decided, with the count; the names on the roll only where the clerk kept them */
  (G.statute || []).forEach(s => { if(!s || !s.title) return;
    const fate = s.fate || (s.aye > s.no ? "carried" : "rejected"), sp = s.sponsor || null;
    const verb = fate === "carried" ? "carried" : fate === "rejected" ? "went down" : fate === "vetoed" ? "passed the House and was vetoed" : fate === "struck down" ? "passed the House and was struck down by the court" : fate === "senate" ? "passed the House and failed in the Senate" : fate;
    add({k:"law:" + s.day + ":" + s.title, kind:"law", d:s.day || 0, t:"the " + s.title.replace(/^the\s+/i, "") + " " + verb + (s.aye != null ? ", " + s.aye + " to " + s.no + " in the House" : " without a recorded roll call") + (s.sen ? ", " + s.sen.aye + " to " + s.sen.no + " in the Senate" : "") + (sp ? " (" + sp + "'s bill" + (s.state ? ", out of " + s.state : "") + ")" : ""),
      sal:0.5 + (Math.abs((s.aye || 0) - (s.no || 0)) <= 6 ? 0.15 : 0) + (fate === "vetoed" || fate === "struck down" ? 0.15 : 0), tau:0.8, st:s.state || null, who:sp ? [sp] : [], ids:[idOf(sp)],
      law:{title:s.title, aye:s.aye, no:s.no, fate, sponsor:sp, v:s.v || null, yv:s.yv == null ? null : s.yv}}); });
  (G.statute || []).forEach(s => { if(!s || !s.ovr || !s.ovr.done || s.ovr.none || s.ovr.aye == null) return;
    add({k:"ovr:" + s.day + ":" + s.title, kind:"ovr", d:s.ovr.d || s.day, t:"the House " + (s.ovr.ok ? "overrode the veto of the " : "failed to override the veto of the ") + s.title + ", " + s.ovr.aye + " to " + s.ovr.no + (s.ovr.ok ? "" : ", short of the " + s.ovr.need + " it needed"), sal:0.75, tau:0.8, st:s.state || null}); });
  ((G.lx && G.lx.sacts) || []).forEach(a => { if(!a || !a.st) return; add({k:"sact:" + a.d + ":" + a.st + ":" + a.t, kind:"sact", d:a.d, t:a.st + (a.ok ? " passed its " : " threw out its ") + a.t + (a.aye != null ? ", " + a.aye + " to " + a.no : ""), sal:0.35, tau:1.2, st:a.st}); });
  (G.cases || []).forEach(c => { if(!c || !c.t || !c.done || !c.ruled) return;
    add({k:"case:" + c.day + ":" + c.t, kind:"case", d:c.day || 0, t:"the court ruled for " + (c.ruled === "union" ? "the Union" : c.ruled === "state" ? (c.state || "the state") : c.ruled === "plaintiff" ? ((c.lx && c.lx.plaintiff) || "the plaintiff") : c.ruled) + " in " + c.t + (c.lx && c.lx.held ? ", " + (c.lx.held === "struck" ? "striking section " + c.lx.sec + " of the " + c.lx.act : "upholding the " + c.lx.act) + ", " + c.lx.count : ""), sal:0.6, tau:1.2, st:c.state || null, cs:{ruled:c.ruled, state:c.state}}); });
  (G.history || []).forEach((h, i) => { if(!h || !h.act || !h.who) return; const myth = h.party === "FO";
    add({k:"hist:" + (h.congress || 0) + ":" + h.who + ":" + h.act, kind:"hist", d:myth ? -999 : Math.max(1, ((h.congress || 1) - 1) * T + 1), t:(h.byYou && h.as ? h.as + " " : "") + h.who + " " + h.act + (h.precedent ? ", setting the precedent " + h.precedent : ""),
      sal:myth ? 1 : h.power ? 0.8 : 0.5, com:myth ? 0.97 : 0, tau:2, who:[h.who], ids:[myth ? null : idOf(h.who)], power:!!h.power, myth}); });
  /* the offices ledger: who holds each seat now, who took one in the game's own time, and who held one before */
  try{ const S = ofhEnsure(); Object.keys(S.seats).forEach(key => { const R = S.seats[key]; if(!R || !R.holders || !R.holders.length) return;
    const title = ({"cab:sos":"Secretary of State", "cab:treas":"Secretary of the Treasury", "cab:war":"Secretary of Defense", "cab:ag":"Attorney General", vp:"Vice President"})[key] || (/^(cab:|vp$)/.test(R.title || "") ? null : R.title) || ofhTitleOf(key), st = /^(gov|sen):/.test(key) && !/^sen:(maj|min|ppt)$/.test(key) ? key.slice(4) : /^house:/.test(key) ? key.slice(6).replace(/ \d+$/, "") : null;
    const base = key === "pres" ? 1 : /^(vp|speaker)$/.test(key) ? 0.8 : /^cab:/.test(key) ? 0.6 : /^bench:/.test(key) ? 0.55 : /^gov:/.test(key) ? 0.5 : /^sen:/.test(key) ? 0.45 : 0.3;
    const H = R.holders, cur = H[H.length - 1].to == null ? H[H.length - 1] : null;
    if(cur && cur.name){ const id = cur.personId === "you" ? "you" : cur.personId;
      add({k:"office:" + key + ":" + cur.name, kind:"office", d:Math.max(1, cur.from || 1), now:true, t:cur.name + " is " + title, sal:base, com:key === "pres" ? 0.95 : 0, st, who:[cur.name], ids:[id], off:{key, title, name:cur.name, from:cur.from, id}}); }
    H.forEach((h, i) => { if(!h || !h.name) return; const id = h.personId === "you" ? "you" : h.personId;
      if(h.from != null && h.from >= 2 && (i > 0 || h.newSeat || h.after) && !h.backfilled) add({k:"offchg:" + key + ":" + h.from + ":" + h.name, kind:"offchg", d:h.from, t:h.name + " took office as " + title + (h.after ? ", after " + h.after : ""), sal:base + 0.15, tau:1, st, who:[h.name].concat(h.after ? [h.after] : []), ids:[id], off:{key, title, name:h.name}});
      if(h.to != null || h.toUnknown) add({k:"offpast:" + key + ":" + h.name + ":" + h.from, kind:"offpast", d:h.to != null && !h.toUnknown ? Math.max(1, h.to) : null, t:h.name + " served as " + title + (h.how ? " and " + knYouFix(h.how) : ""), sal:base * 0.8, tau:2, st, who:[h.name], ids:[id], off:{key, title, name:h.name}}); }); }); }catch(e){}
  (sc.log || []).slice(-60).forEach(l => { if(!l || !l.t) return; const hot = /\b(seced|independen|rebellion|revolt|militia|riot|war)\w*/i.test(l.t);
    add({k:"sc:" + l.d + ":" + knHash(l.t), kind:"sc", d:l.d || 0, t:l.t, sal:hot ? 0.6 : 0.35, tau:1.5, st:knStateIn(l.t)}); });
  (sc.polities || []).forEach(pl => { if(!pl || !pl.name) return; const S = (pl.memberStates || []).join(", ");
    const t = pl.status === "seceded" ? S + " broke away from the Union as " + pl.name : pl.status === "war" ? S + " are at war with the Union as " + pl.name : pl.status === "tension" ? S + " are drawing together as " + pl.name + ", and the capital is worried" : pl.status === "reunited" ? pl.name + " collapsed and " + S + " came back into the Union" : null;
    add({k:"pol:" + pl.name + ":" + pl.status, kind:"pol", d:pl.d != null ? pl.d : pl.day != null ? pl.day : null, now:pl.d == null && pl.day == null, t, sal:0.85, com:pl.status === "war" || pl.status === "seceded" ? 0.85 : 0, st:(pl.memberStates || [])[0] || null}); });
  try{ const NA = sc.na || {}; (typeof WORLD_POWERS !== "undefined" ? WORLD_POWERS : []).forEach(w => { const a = NA[w.k]; if(!a) return; const nm = a.name || w.t;
    if(a.leader) add({k:"na:" + w.k + ":lead:" + a.leader, kind:"na", d:null, now:true, t:(a.leaderT ? a.leaderT + " " : "") + a.leader + " leads " + nm, sal:0.45, rk:w.k, who:[a.leader], na:{k:w.k, lead:true}});
    const rel = G.realmRel && G.realmRel[w.k] != null ? G.realmRel[w.k] : (a.toward || 0), word = rel > 20 ? "friendly toward" : rel < -20 ? "hostile toward" : "wary of";
    add({k:"na:" + w.k + ":stance:" + word, kind:"na", d:null, now:true, t:nm + " is " + word + " the Republic" + (w.want ? ", and wants " + w.want : ""), sal:0.45, rk:w.k, na:{k:w.k, rel}});
    const R = (wm.rec || {})[w.k], dead = typeof (wm.dead || {})[w.k] === "number" ? wm.dead[w.k] : 0;
    if(R && (R.w + R.d + R.l) > 0) add({k:"war:" + w.k + ":" + R.w + "-" + R.d + "-" + R.l, kind:"war", d:null, now:true, t:"against " + nm + ", the Republic has won " + R.w + ", drawn " + R.d + " and lost " + R.l + (R.w + R.d + R.l === 1 ? " engagement" : " engagements") + (dead ? ", with " + dead + " dead" : ""), sal:0.7, rk:w.k}); }); }catch(e){}
  (G.career || []).forEach(c => { if(!c || !c.term || !/^won\b/.test(c.note || "")) return;
    add({k:"career:" + c.term + ":" + c.post, kind:"career", d:Math.max(1, c.term * T), t:(you.name || "the President") + " " + c.note, sal:c.post === "President" ? 1 : 0.85, com:c.post === "President" ? 0.9 : 0, tau:1, who:[you.name], ids:["you"]}); });
  (G.reactNews || []).slice(-12).forEach(r => { if(!r || !r.t) return; add({k:"rn:" + r.d + ":" + knHash(r.t), kind:"rn", d:r.d || 0, t:r.t, sal:0.3, tau:0.6, st:knStateIn(r.t)}); });
  (G.secrets || []).forEach(s => { if(!s || !s.t) return; add({k:"secret:" + s.id, kind:"secret", d:s.day || 0, t:s.t, sal:0.6, pub:false, kb:(s.knownBy || []).slice()}); });
  const b = G.bill; if(b && !b.done && b.title) add({k:"bill:" + b.id, kind:"bill", d:null, now:true, t:"the " + b.title.replace(/^the\s+/i, "") + " is before the House" + (b.sponsor ? ", " + b.sponsor + "'s bill" : "") + (b.voteDay ? ", with the roll call set for day " + b.voteDay : ""), sal:0.65, st:b.state || null, who:b.sponsor ? [b.sponsor] : [], ids:[idOf(b.sponsor)], bill:{id:b.id, title:b.title}});
  KN.ev = E; KN.byK = {}; KN.byH = {}; E.forEach(e => { KN.byK[e.k] = e; KN.byH[e.h] = e; });
  KN.sig = sig; KN.kc.clear(); KN.bel.clear();
  return E;
}

/* ── who a person is, as far as knowing goes: how closely they follow the capital, their home, their chamber ── */
function knHome(p){
  const sk = String(p.scKey || ""), ok = String(p.ohK || "");
  let m = /^(gov|cp|oh:gov|oh:sen):(.+)$/.exec(sk) || /^(gov|sen):(.+)$/.exec(ok); if(m && !/^(maj|min|ppt)$/.test(m[2])) return m[2];
  if(p.home && knStates().indexOf(p.home) >= 0) return p.home;
  return p.state || null;
}
function knProf(p){
  if(KN.profDay !== G.day){ KN.prof.clear(); KN.since.clear(); KN.profDay = G.day; }
  let pr = KN.prof.get(p.id); if(pr) return pr;
  const sk = String(p.scKey || ""), pre = sk.split(":")[0], key = sk.slice(pre.length + 1), ok = String(p.ohK || "");
  let nat = 0.3, loc = 0.7, body = null, realm = null, role = "civ";
  if(p.kind === "member"){ nat = 0.85; body = "house"; role = "member"; }
  else if(p.kind === "press"){ nat = 0.95; loc = 0.9; role = "press"; }
  else if(p.kind === "aide"){ nat = 0.95; role = "aide"; }
  else if(/^gov:/.test(ok) || pre === "gov"){ nat = 0.7; loc = 1; role = "gov"; }
  else if(ok){ role = "office"; body = /^sen:/.test(ok) ? "senate" : /^bench:/.test(ok) ? "bench" : /^(cab:|vp$|pres$)/.test(ok) ? "exec" : ok === "speaker" ? "house" : null; nat = body ? 0.9 : 0.7; }
  else if(pre === "cp"){ nat = 0.6; loc = 0.95; role = "cp"; }
  else if(pre === "lead" || pre === "env"){ nat = 0.5; loc = 0.2; realm = key; role = pre; }
  else if(pre === "former"){ nat = 0.55; loc = 0.8; role = "former"; }
  let tr = 0; try{ if(p.traits) tr = ((p.traits.ambition || 50) - 50) / 400 + ((p.traits.vanity || 50) - 50) / 800; }catch(e){}
  nat = clamp(nat + (knH(p.id, "curious") - 0.5) * 0.3 + tr, 0.08, 0.98);
  pr = {nat, loc, body, realm, role, st:knHome(p)};
  KN.prof.set(p.id, pr); return pr;
}
/* the first day a member sat in the House: from the ledger; otherwise their terms, counted back */
function knSince(p){
  if(KN.profDay !== G.day) knProf(p);
  if(KN.since.has(p.id)) return KN.since.get(p.id);
  let s = null;
  try{ const R = ofhEnsure().seats["house:" + p.state + " " + p.dist]; if(R){ const h = R.holders.filter(x => x.personId === p.id).sort((a, b) => (a.from || 0) - (b.from || 0))[0]; if(h) s = h.from == null ? -9999 : h.from; } }catch(e){}
  if(s == null) s = (G.day || 1) - Math.max(1, p.terms || 1) * knT();
  KN.since.set(p.id, s); return s;
}
/* being there: the floor for a roll call, the bench for a ruling, the chamber you sit in, your own government */
function knWit(p, e){
  const pr = knProf(p);
  switch(e.kind){
    case "law": return p.kind === "member" && knSince(p) <= e.d;
    case "bill": return p.kind === "member" || pr.body === "house";
    case "case": return pr.body === "bench" || (pr.role === "gov" && pr.st === e.st);
    case "office": case "offchg": case "offpast": { const k = e.off.key;
      if(/^sen:/.test(k)) return pr.body === "senate"; if(/^(house:|speaker$)/.test(k)) return p.kind === "member" || pr.body === "house";
      if(/^bench:/.test(k)) return pr.body === "bench"; if(/^(cab:|vp$)/.test(k)) return pr.body === "exec"; if(/^gov:/.test(k)) return pr.st === e.st && (pr.role === "gov" || pr.role === "cp" || pr.role === "former"); return false; }
    case "na": case "war": return (pr.role === "lead" || pr.role === "env") && pr.realm === e.rk;
    case "sc": return pr.role === "gov" && pr.st === e.st;
    case "secret": return !!e.kb && e.kb.indexOf(p.id) >= 0;
  }
  return false;
}
/* how likely someone of this profile is to have it: interest x how far it has spread x how much of it is still remembered */
function knP(pr, e){
  let I = pr.nat * e.sal;
  if(e.st && pr.st === e.st) I = Math.max(I, pr.loc * (0.55 + 0.45 * e.sal));
  if(e.rk && pr.realm === e.rk) I = 1;
  if(pr.role === "press") I = Math.max(I, Math.min(0.95, e.sal + 0.35));
  if(e.com) I = Math.max(I, e.com);
  if(e.now || e.d == null) return clamp(I, 0, 0.97);
  const age = Math.max(0, (G.day || 0) - e.d);
  const spread = 1 - Math.exp(-(age + 0.3) / (e.tau || 1.5));
  const keep = e.com ? 1 : Math.exp(-age / (30 + 330 * e.sal * e.sal));
  return clamp(I * spread * (0.3 + 0.7 * keep), 0, 0.97);
}
/* does this person know it, how sure are they, and how did it reach them */
function knKnows(p, e){
  if(!p || !e) return null;
  if(p === G.you) return {c:1, how:"self"};
  if(e.ids.indexOf(p.id) >= 0 || (p.name && e.who.indexOf(p.name) >= 0)) return {c:1, how:"self"};
  if(knWit(p, e)) return {c:0.95, how:"wit"};
  const P = knStore().p[p.id]; if(P){ const x = P.find(r => r[0] === e.h); if(x) return {c:x[1] / 100, how:"told", src:x[2], d:x[3]}; }
  if(!e.pub) return null;
  const q = knP(knProf(p), e), h = knH(p.id, e.k);
  if(h >= q) return null;
  return {c:clamp(0.5 + 0.45 * (1 - h / q), 0.4, 0.92), how:"pub"};
}
function knKnown(p){
  if(!p) return [];
  const ev = knEvents(), c = KN.kc.get(p.id); if(c && c.sig === KN.sig) return c.L;
  const L = []; ev.forEach(e => { const k = knKnows(p, e); if(k) L.push({e, c:k.c, how:k.how, src:k.src, sd:k.d}); });
  KN.kc.set(p.id, {sig:KN.sig, L}); return L;
}
function knLearn(b, e, src, c){
  const S = knStore(); let P = S.p[b.id]; if(!P) P = S.p[b.id] = [];
  c = Math.round(clamp(c, 0.2, 0.95) * 100); const x = P.find(r => r[0] === e.h);
  if(x){ if(c > x[1]){ x[1] = c; x[2] = src; x[3] = G.day; } }
  else { P.push([e.h, c, src, G.day]); }
  KN.kc.delete(b.id); KN.bel.delete(b.id);
}

/* ── where it came from, in their own words ── */
function knSrc(p, k, e){
  if(k.how === "self") return "";
  if(k.how === "wit") return ({law:"I was on the floor for it", bill:"it is our business this week", "case":"it came before us", office:"I work alongside them", offchg:"I was there", offpast:"I served alongside them", na:"it is my own government", war:"it is my own government", sc:"my office had it first", secret:"I know it myself"})[e.kind] || "I saw it myself";
  if(k.how === "told"){ if(k.src === "you") return "you told me yourself"; const s = knPerson(k.src); const w = knWhen(k.d); return (s ? surname(s.name) : "someone") + " told me" + (w && w !== "today" ? ", " + w : ""); }
  const pr = knProf(p), L = pr.role === "press" ? ["it came over the wire", "we ran it"] : pr.role === "member" ? ["the cloakroom had it", "it went round the floor", "it was in the papers"]
    : pr.role === "office" ? ["it was in the morning briefing", "the papers had it"] : pr.role === "gov" || pr.role === "cp" ? ["my office had it", "the state papers had it"]
    : (pr.role === "lead" || pr.role === "env") ? ["our mission reported it", "it was in the dispatches"] : pr.role === "aide" ? ["it is in the file", "the wire had it"]
    : ["it was in the papers", "people in town were talking about it", "I read it somewhere"];
  return L[Math.floor(knH(p.id, e.k + ":src") * L.length)];
}
function knSrcShort(p, x){ return x.how === "self" ? "your own doing" : x.how === "wit" ? "you were there" : x.how === "told" ? (x.src === "you" ? "the player told you" : (knNameOf(x.src) || "someone") + " told you") : knSrc(p, x, x.e); }
function knHedge(c){ return c < 0.55 ? "if I have it right, " : c < 0.7 ? "I think " : ""; }

/* ── what they make of it: judgements reasoned from what they know, each with its reason ── */
function knBeliefs(p){
  if(!p) return [];
  knEvents(); const c = KN.bel.get(p.id); if(c && c.sig === KN.sig) return c.B;
  const K = knKnown(p), B = [], you = G.you || {}, sn = n => { try{ return surname(n); }catch(e){ return n; } };
  const laws = K.filter(x => x.e.kind === "law").map(x => x.e);
  /* whose bills get through */
  const sp = {}; laws.forEach(e => { const s = e.law.sponsor; if(!s) return; const r = sp[s] = sp[s] || {n:0, w:0}; r.n++; if(e.law.fate === "carried") r.w++; });
  Object.keys(sp).forEach(s => { const r = sp[s]; if(r.n < 2) return; const me = s === p.name, nm = me ? "my" : sn(s) + "'s";
    if(r.w === r.n) B.push({t:me ? "My bills get through" : sn(s) + " gets bills through this House", why:r.w + " of " + r.n + " carried", about:s, c:0.55 + 0.1 * Math.min(3, r.n)});
    else if(r.w === 0) B.push({t:knCap(nm) + " bills keep dying on the floor", why:"none of " + r.n + " carried", about:s, c:0.55 + 0.1 * Math.min(3, r.n)});
    else if(r.w / r.n < 0.5) B.push({t:knCap(nm) + " bills mostly fail", why:"only " + r.w + " of " + r.n + " carried", about:s, c:0.5}); });
  /* the temper of the House */
  const recent = laws.slice().sort((u, v) => v.d - u.d).slice(0, 6);
  if(recent.length >= 3){ const close = recent.filter(e => Math.abs(e.law.aye - e.law.no) <= 6).length, car = recent.filter(e => e.law.fate === "carried").length;
    if(close * 2 >= recent.length) B.push({t:"The House is split down the middle", why:close + " of the last " + recent.length + " roll calls I know of were decided by six votes or fewer", c:0.7});
    if(car === recent.length) B.push({t:"This House passes what it is given", why:"all of the last " + recent.length + " bills I know of carried", c:0.6});
    else if(car * 3 <= recent.length) B.push({t:"This House kills most of what comes before it", why:"only " + car + " of the last " + recent.length + " carried", c:0.6}); }
  /* is home heard */
  const home = knProf(p).st;
  if(home){ const ls = laws.filter(e => e.st === home); if(ls.length){ const w = ls.filter(e => e.law.fate === "carried").length;
      B.push(w ? {t:"The capital does listen to " + home + ", sometimes", why:w + " of " + ls.length + " bills out of " + home + " carried", about:home, c:0.55} : {t:"The capital does not hear " + home, why:"not one of " + ls.length + " bills out of " + home + " carried", about:home, c:0.65}); }
    K.filter(x => x.e.kind === "case" && x.e.st === home).forEach(x => B.push(x.e.cs.ruled === "union" ? {t:"The court takes the Union's side against " + home, why:knCap(x.e.t), about:home, c:0.6} : {t:"The court will stand up for " + home, why:knCap(x.e.t), about:home, c:0.55})); }
  /* the player's reach */
  if(you.name){ const pw = K.filter(x => x.e.kind === "hist" && x.e.power && !x.e.myth && x.e.who.indexOf(you.name) >= 0).length, wins = K.filter(x => x.e.kind === "career").length;
    const lib = p.pos ? (p.pos.lib || 0) : 0, nm = sn(you.name);
    if(pw >= 2) B.push(lib > 15 ? {t:nm + " keeps taking more power than the offices were built for", why:pw + " precedents of power on the record, by " + nm, about:you.name, c:0.6 + Math.min(0.3, pw * 0.05)} : {t:nm + " knows how to use power, and the Republic needs that", why:pw + " precedents of power on the record, by " + nm, about:you.name, c:0.55});
    if(wins >= 2) B.push({t:nm + " has won every office " + nm + " has run for that I know of", why:wins + " wins on the record", about:you.name, c:0.55}); }
  /* the world */
  K.filter(x => x.e.kind === "na" && x.e.na && !x.e.na.lead && x.e.na.rel < -20).forEach(x => B.push({t:wmNameSafe(x.e.rk) + " means the Republic harm", why:knCap(x.e.t), about:x.e.rk, c:0.6}));
  K.filter(x => x.e.kind === "pol" && /seceded|war/.test(x.e.k)).forEach(x => B.push({t:"The Union is coming apart", why:knCap(x.e.t), c:0.7}));
  /* their own count, and what being wrong taught them */
  const C = knStore().cal[p.id];
  if(C && C.n >= 1 && C.last){ const off = C.last.a - C.last.p;
    B.push(Math.abs(off) <= 3 ? {t:"My counts hold up", why:"on the " + C.last.t + " I had " + C.last.p + " aye and it came in at " + C.last.a, c:0.6}
      : {t:off < 0 ? "I count too many friends before a roll call" : "I count too few friends before a roll call", why:"on the " + C.last.t + " I had " + C.last.p + " aye and it came in at " + C.last.a + "; I have adjusted", c:0.65}); }
  B.sort((u, v) => v.c - u.c);
  KN.bel.set(p.id, {sig:KN.sig, B}); return B;
}
function wmNameSafe(k){ try{ return wmName(k); }catch(e){ return k; } }

/* ── counting the next roll call from what they know; learning from the result ── */
function knCal(id){ const S = knStore(); return S.cal[id] || {d:0.86 + (knH(id, "disc") - 0.5) * 0.16, b:0, n:0, mae:null, hit:0, _new:true}; }
function knWhip(b, d){ const L = partyLine(b), S = G.seatsBy || {}; let a = 0, n = 0, g = 0;
  Object.keys(S).forEach(p => { const s = S[p] || 0, l = L[p] == null ? 0 : L[p], dd = p === "IND" ? 0.5 : d; a += s * (l > 0 ? dd : l < 0 ? 1 - dd : 0.5); n += s; if(p !== "IND") g += s * l; });
  return {a, n, g}; }
function knStance(p, b){ const out = {}, S = knStore().st[p.id]; if(S && S.b === b.id) Object.assign(out, S.s); if(p.kind === "member"){ try{ out[p.id] = memberVote(p, b) > 0 ? 1 : -1; }catch(e){} } return out; }
function knSawStance(a, b, bill){ const S = knStore();
  [[a, b], [b, a]].forEach(([x, y]) => { let r = S.st[x.id]; if(!r || r.b !== bill.id) r = S.st[x.id] = {b:bill.id, s:{}}; try{ r.s[y.id] = memberVote(y, bill) > 0 ? 1 : -1; }catch(e){} }); }
function knForecast(p){
  const b = G.bill; if(!b || b.done || !p || p.gone) return null;
  const pr = knProf(p); if(!(p.kind === "member" || pr.role === "press" || pr.role === "office" || pr.role === "aide")) return null;
  const C = knCal(p.id), W = knWhip(b, C.d), L = partyLine(b), st = knStance(p, b); let adj = 0, known = 0;
  Object.keys(st).forEach(id => { const m = knPerson(id); if(!m || m.kind !== "member" || m.gone) return; known++; const l = L[m.party] == null ? 0 : L[m.party]; const ex = m.party === "IND" || !l ? 0.5 : (l > 0 ? C.d : 1 - C.d); adj += (st[id] > 0 ? 1 : 0) - ex; });
  const aye = clamp(Math.round(W.a + adj + C.b), 0, Math.round(W.n)), no = Math.max(0, Math.round(W.n) - aye);
  return {aye, no, carry:aye > no, known, g:W.g, cal:C};
}

/* ── the Engine: the same public record, a forecast it makes itself, and a score it cannot argue with ── */
function knEng(){ const S = knStore(); if(!S.eng) S.eng = {w:[0, 1, 0, 0], n:0, mae:null, bmae:null, hit:0, bhit:0, last:null}; return S.eng; }
function knEngX(b){ const W = knWhip(b, 0.86); let lp = 0; try{ lp = clamp(lobbyPush(b) / 60, -1, 1); }catch(e){} const sp = b.sponsorParty === "FED" ? 1 : b.sponsorParty === "COM" ? -1 : 0;
  return {x:[1, W.a / Math.max(1, W.n), lp, clamp((G.mood || 0) / 60, -1, 1) * sp], n:W.n, base:W.a}; }
function knEngPredict(b){ const M = knEng(), X = knEngX(b); const s = clamp(M.w.reduce((t, w, i) => t + w * X.x[i], 0), 0.02, 0.98); return {aye:Math.round(s * X.n), share:s, base:Math.round(X.base), n:Math.round(X.n), x:X.x}; }

/* before the clerk calls the roll: everyone who counts writes their count down */
function knFreeze(b){
  if(!b || b.done) return; const S = knStore(), F = {id:b.id, t:b.title, d:G.day, p:{}, e:null};
  try{ everyone().forEach(p => { if(!p || p.gone) return; const f = knForecast(p); if(f) F.p[p.id] = {aye:f.aye, g:f.g, known:f.known}; }); }catch(e){}
  try{ if(G.eng && G.eng.v === 1) F.e = knEngPredict(b); }catch(e){}
  S.fc = F;
}
/* after: the count against the counts. Each person nudges how far they trust the party lines and their own lean (a least-mean-squares step),
   and the Engine's weights take a normalised step toward the share that actually voted aye */
function knResolve(b){
  const S = knStore(), F = S.fc; if(!F || !b || F.id !== b.id) return null;
  const s = (G.statute || []).find(x => x.title === b.title && x.day === G.day); if(!s){ S.fc = null; return null; }
  const act = s.aye, N = s.aye + s.no, out = {n:0, mae:0};
  Object.keys(F.p).forEach(id => { const pr = F.p[id], C = S.cal[id] || (S.cal[id] = knCal(id)); delete C._new; const err = act - pr.aye;
    C.n++; C.mae = C.mae == null ? Math.abs(err) : C.mae * 0.6 + Math.abs(err) * 0.4; if((pr.aye * 2 > N) === (act * 2 > N)) C.hit = (C.hit || 0) + 1;
    if(pr.g) C.d = clamp(C.d + clamp(0.004 * err * Math.sign(pr.g) * Math.min(1, Math.abs(pr.g) / 10), -0.05, 0.05), 0.55, 0.99);
    C.b = clamp(C.b + 0.35 * err, -20, 20); C.last = {t:b.title, p:pr.aye, a:act, d:G.day}; out.n++; out.mae += Math.abs(err); });
  if(out.n) out.mae /= out.n;
  if(F.e){ const M = knEng(), e = F.e, sh = act / Math.max(1, N), er = sh - e.share, xx = e.x.reduce((t, v) => t + v * v, 0);
    M.w = M.w.map((w, i) => clamp(w + 0.5 * er * e.x[i] / (xx + 0.01), -3, 3));
    const ae = Math.abs(act - e.aye), be = Math.abs(act - e.base); M.mae = M.mae == null ? ae : M.mae * 0.7 + ae * 0.3; M.bmae = M.bmae == null ? be : M.bmae * 0.7 + be * 0.3; M.n++;
    if((e.aye * 2 > N) === (act * 2 > N)) M.hit++; if((e.base * 2 > N) === (act * 2 > N)) M.bhit++;
    M.last = {t:b.title, p:e.aye, base:e.base, a:act, d:G.day}; out.eng = M.last;
    try{ const E = engEnsure(); if(M.n >= 2){ const sk = 50 + 50 * clamp((M.bmae - M.mae) / Math.max(2, M.bmae), -1, 1); E.cal = clamp((E.cal == null ? 50 : E.cal) * 0.8 + sk * 0.2, 0, 100); }
      engLog("The Engine had the " + b.title + " at " + e.aye + " aye; the whip count alone said " + e.base + ". It came in at " + act + ". " + (ae < be ? "Closer than the whip count." : ae > be ? "Further off than the whip count; it has adjusted." : "No better than the whip count."), false); }catch(err){} }
  S.fc = null; KN.bel.clear(); return out;
}

/* ── passing it on: they choose what the other has not heard and would care about ── */
function knEst(a, b, e){
  const P = knStore().p[b.id]; if(P && P.some(r => r[0] === e.h && r[2] === a.id)) return 1;   /* I told them myself */
  if(e.ids.indexOf(b.id) >= 0) return 1;
  if(knWit(b, e)) return 0.95;                                                                  /* anyone can see their post */
  return e.pub ? knP(knProf(b), e) : 0;
}
function knPick(a, b){
  const pb = knProf(b); let best = null, bv = 0;
  knKnown(a).forEach(x => { const e = x.e; if(!KN_SHARE[e.kind] || !e.pub || x.c < 0.45) return; const est = knEst(a, b, e); if(est > 0.6) return;
    const age = e.d == null ? 20 : Math.max(0, G.day - e.d), rel = 1 + (e.st && e.st === pb.st ? 1.2 : 0) + (b.name && e.who.indexOf(b.name) >= 0 ? 1.5 : 0) + (e.rk && e.rk === pb.realm ? 1 : 0);
    const v = e.sal * rel * (0.25 + Math.exp(-age / 12)) * x.c * (1 - est) * (0.85 + 0.3 * knH(a.id + ":" + G.day, e.k));
    if(v > bv){ bv = v; best = x; } });
  return best;
}
function knTell(a, b, x){
  const e = x.e, s = knSent(e), w = knWhen(e.d), ws = w ? ", " + w : "", r = knH(a.id + ":" + b.id, e.k);
  if(x.how === "told" && x.src != null && x.src !== b.id){ const t = knPerson(x.src); if(t && r < 0.5) return "I had it from " + surname(t.name) + ": " + e.t + ws + "."; }
  if(e.st && r > 0.75) return "Word from " + e.st + ": " + e.t + ws + ".";
  return ["Did you hear? " + s + ws + ".", "Have you heard? " + s + ws + ".", "You will want to know this. " + s + ws + "."][Math.floor(r * 3)];
}
function knOpinion(b, e){
  const home = knProf(b).st;
  if(e.kind === "law"){ const v = e.law.v && e.law.v[b.id]; if(e.law.sponsor === b.name) return e.law.fate === "carried" ? "That was mine. Good." : "That was mine. I will bring it back.";
    if(v) return v > 0 ? "I voted for it." : "I voted against it, and I would again.";
    if(e.st && e.st === home) return e.law.fate === "carried" ? "Good for " + home + "." : "That will land hard in " + home + "."; }
  if(e.kind === "case" && e.st === home) return e.cs.ruled === "union" ? "So the capital wins again." : "Good. " + home + " needed that.";
  if(e.kind === "offchg" && e.st === home) return "I will need to learn a new name at home, then.";
  if(e.kind === "pol") return "God help the Union.";
  if(e.kind === "war") return "And every one of those is a family.";
  return ["That changes things.", "Nobody tells me anything.", "Hm. I will think about that.", "So that is how it is."][Math.floor(knH(b.id, e.k + ":op") * 4)];
}
function knReact(b, a, e, had){
  if(had){ const L = had.how === "wit" ? ["I know. I was there.", "I was there for it."] : had.how === "self" ? ["I know. That was me."] : ["I heard. " + knOpinion(b, e), "It was in every paper. " + knOpinion(b, e)];
    return L[Math.floor(knH(b.id, e.k + ":re") * L.length)]; }
  return ["I had not heard. " + knOpinion(b, e), "That is news to me. " + knOpinion(b, e), "Really? " + knOpinion(b, e)][Math.floor(knH(b.id, e.k + ":re") * 3)];
}
function knShare(a, b){
  if(!a || !b || a === b || a.gone || b.gone || a === G.you || b === G.you) return null;
  const x = knPick(a, b); if(!x) return null;
  const e = x.e, had = knKnows(b, e); let trust = 0.75; const w = knTie(a.id, b.id); if(w != null) trust = clamp(0.6 + w / 250, 0.3, 0.98);
  if(!had) knLearn(b, e, a.id, x.c * trust * 0.95);
  KN.told++;
  return {e, knew:!!had, a:knTell(a, b, x), b:knReact(b, a, e, had)};
}
/* off-screen: each day people talk along their ties (warm ones most), their alliances and the rooms they share */
function knAdj(){
  if(KN.adj && KN.adjDay === G.day) return KN.adj; const A = new Map(), put = (x, y, w) => { if(x == null || y == null || x === y) return; if(!A.has(x)) A.set(x, []); A.get(x).push([y, w]); };
  Object.keys(G.ties || {}).forEach(k => { const t = G.ties[k], ij = k.split("|"); if(!t || t.w == null || t.w < 10) return; const a = isNaN(+ij[0]) ? ij[0] : +ij[0], c = isNaN(+ij[1]) ? ij[1] : +ij[1]; put(a, c, t.w); put(c, a, t.w); });
  try{ everyone().forEach(p => { if(!p || p.gone) return; (p.allies || []).forEach(o => put(p.id, o, 40)); }); }catch(e){}
  KN.adj = A; KN.adjDay = G.day; return A;
}
function knDay(){
  if(!G || !G.you || G.day == null) return 0; const S = knStore(); knEvents();
  const all = (function(){ try{ return everyone().filter(p => p && !p.gone); }catch(e){ return []; } })(); if(all.length < 2) return 0;
  const A = knAdj(), r = rng(seedOf("knday:" + G.day)); let n = 0;
  for(let i = 0; i < 140 && n < 60; i++){ const a = all[Math.floor(r() * all.length)], nb = A.get(a.id);
    let b = null; if(nb && nb.length && r() < 0.8){ const tot = nb.reduce((t, z) => t + z[1], 0); let q = r() * tot; for(const z of nb){ q -= z[1]; if(q <= 0){ b = knPerson(z[0]); break; } } }
    if(!b && a.room && a.room !== "abroad"){ const here = all.filter(o => o !== a && o.room === a.room); if(here.length) b = here[Math.floor(r() * here.length)]; }
    if(!b || b.gone || b === a) continue; if(knShare(a, b)) n++; }
  /* the small things go: told-facts are kept a season, and only while the record still holds them */
  Object.keys(S.p).forEach(id => { const P = S.p[id].filter(z => KN.byH[z[0]] && G.day - z[3] <= 150); if(P.length) S.p[id] = P; else delete S.p[id]; });
  const ids = Object.keys(S.p); if(ids.length > 300){ ids.sort((u, v) => Math.max(...S.p[u].map(z => z[3])) - Math.max(...S.p[v].map(z => z[3]))).slice(0, ids.length - 300).forEach(id => delete S.p[id]); }
  Object.keys(S.st).forEach(id => { if(!G.bill || S.st[id].b !== G.bill.id) delete S.st[id]; });
  return n;
}

/* ── asked a question, they answer from what they know, or say they do not ── */
function knFindPerson(q){
  const ql = " " + knNorm(q) + " "; let best = null, bs = 0;
  const cand = (function(){ try{ return everyone().filter(p => p && p.name && !p.gone); }catch(e){ return []; } })(); if(G.you && G.you.name) cand.push(G.you);
  cand.forEach(p => { const nm = knNorm(p.name), parts = nm.split(" "), sur = parts[parts.length - 1];
    let s = ql.indexOf(" " + nm + " ") >= 0 ? 10 : (sur.length >= 4 && ql.indexOf(" " + sur + " ") >= 0 ? 4 : 0); if(!s) return;
    s += p.kind === "member" ? 2 : p.ohK ? 1.5 : p === G.you ? 1.5 : p.scKey && !/^former/.test(p.scKey) ? 1 : 0;
    if(s > bs){ bs = s; best = p; } });
  return best;
}
function knFindLaw(q){
  const ql = " " + knNorm(q) + " "; let best = null, bs = 0;
  knEvents().forEach(e => { if(e.kind !== "law" && e.kind !== "bill") return; const title = e.kind === "law" ? e.law.title : e.bill.title, tl = knNorm(title).replace(/^the /, "");
    let s = ql.indexOf(" " + tl + " ") >= 0 ? 10 : 0; const W = knWords(title), hit = W.filter(w => ql.indexOf(" " + w + " ") >= 0).length;
    if(W.length && hit >= Math.min(2, W.length)) s += hit; if(s && (s > bs || (s === bs && best && (e.d || 1e9) > (best.d || 0)))){ bs = s; best = e; } });
  return best;
}
function knFindRealm(q){ const ql = " " + knNorm(q) + " "; try{ const w = (typeof WORLD_POWERS !== "undefined" ? WORLD_POWERS : []).find(w => { const nm = knNorm(w.t).replace(/^the /, ""); return ql.indexOf(" " + nm + " ") >= 0 || ql.indexOf(" " + knNorm(w.k) + " ") >= 0; }); return w ? w.k : null; }catch(e){ return null; } }
function knFindOffice(q, st){
  const ql = knNorm(q); let best = null, bs = 0;
  knEvents().forEach(e => { if(e.kind !== "office") return; const t = knNorm(e.off.title), k = e.off.key; let s = 0;
    if(/\bgovernor\b/.test(ql) && /^governor/.test(t)) s += 3;
    if(/\bsenator\b/.test(ql) && /^senator/.test(t)) s += 3;
    if(/\b(representative|represents|congressman|congresswoman|member for|house seat)\b/.test(ql) && /^representative/.test(t)) s += 3;
    if(/\bspeaker\b/.test(ql) && k === "speaker") s += 4;
    if(/\bvice\b/.test(ql) && k === "vp") s += 5; else if(/\b(president|head of state|first consul)\b/.test(ql) && !/\bvice\b/.test(ql) && k === "pres") s += 4;
    if(/\bsecretary of state\b/.test(ql) && /secretary of state/.test(t)) s += 5; else if(/\btreasury\b/.test(ql) && /treasury/.test(t)) s += 5; else if(/\b(defen[cs]e|war secretary|secretary of war)\b/.test(ql) && /defense/.test(t)) s += 5; else if(/\battorney\b/.test(ql) && /attorney/.test(t)) s += 5;
    if(/\bchief justice\b/.test(ql) && k === "bench:0") s += 5;
    if(/\bmajority\b/.test(ql) && /majority/.test(t)) s += 5; if(/\bminority\b/.test(ql) && /minority/.test(t)) s += 5; if(/\bpro tem/.test(ql) && /pro tempore/.test(t)) s += 5;
    if(e.st){ if(st === e.st) s += 2; else if(st) s -= 4; else s -= 1; }
    if(s > bs){ bs = s; best = e; } });
  return bs >= 3 ? best : null;
}
function knWhoKnows(p, e){
  let best = null, bc = 0;
  const cand = (function(){ try{ return everyone().filter(o => o && !o.gone && o !== p && (o.kind === "member" || o.kind === "press" || o.ohK || /^(gov|cp):/.test(o.scKey || ""))); }catch(err){ return []; } })();
  cand.forEach(o => { const k = knKnows(o, e); if(!k) return; const c = k.c + (o.room && o.room === p.room ? 0.1 : 0) + (o.kind === "member" ? 0.05 : 0); if(c > bc){ bc = c; best = o; } });
  if(!best) return "";
  const why = e.st && knProf(best).st === e.st ? "it is " + (best.ohK && /^gov:/.test(best.ohK) ? "their state" : "home for them") : knWit(best, e) ? "they would have been there" : best.kind === "press" ? "they read everything" : "they keep up with it";
  return " Ask " + best.name + "; " + why + ".";
}
function knSay(p, e, k){ const src = knSrc(p, k, e); return knCap(knHedge(k.c) + e.t) + knWhenC(e) + "." + (src ? " " + knCap(src) + "." : ""); }
function knAnswer(p, text){
  if(!p || p === G.you || /^(engine|envoy)$/.test(p.kind || "")) return null;
  const q = String(text || "").trim(); if(q.length < 4) return null;
  const ql = knNorm(q), isQ = /\?\s*$/.test(q) || /^(who|what|when|where|which|how|did|does|do|has|have|is|are|was|were|will|tell me|any|heard|know)\b/.test(ql);
  if(!isQ) return null;
  const done = (t, e, k) => { KN.last[p.id] = {e, k, d:G.day}; return {text:t, strong:true, ev:e ? e.k : null}; }, you = G.you || {};
  /* how do you know */
  if(/\b(how do you know|who told you|where did you hear|where did you get that|your source)\b/.test(ql)){ const L = KN.last[p.id];
    if(L && L.e && L.k){ const s = knSrc(p, L.k, L.e); return done(s ? knCap(s) + "." : "Because I was part of it.", L.e, L.k); } return null; }
  const st = knStateIn(q), realm = knFindRealm(q);
  /* who holds an office, or leads a power */
  if(/\bwho\b/.test(ql) && (/\b(lead|leads|runs|rules|heads|in charge)\b/.test(ql) || /\b(premier|first minister|prime minister|leader)\b/.test(ql)) && realm){
    const e = knEvents().find(x => x.kind === "na" && x.rk === realm && x.na.lead); if(e){ const k = knKnows(p, e); return done(k ? knSay(p, e, k) : "I could not tell you who leads " + wmNameSafe(realm) + " now." + knWhoKnows(p, e), e, k); } }
  if(/\bwho\b/.test(ql) || /\b(governor|senator|speaker|representative|chief justice|secretary)\b.*\?$/.test(q.toLowerCase())){
    const e = knFindOffice(q, st);
    if(e){ const k = knKnows(p, e);
      if(e.off.id === "you") return done("You are" + (/^(pres)$/.test(e.off.key) ? ", " + (function(){ try{ return youAddress(); }catch(x){ return "of course"; } })() : "") + ".", e, {c:1, how:"self"});
      if(e.off.id === p.id) return done("I am. " + knCap(e.off.title) + (e.off.from > 1 ? ", since " + knWhen(e.off.from) : "") + ".", e, {c:1, how:"self"});
      if(/^representative/i.test(e.off.title) && !/\d/.test(q)){ const all = knKnown(p).filter(x => x.e.kind === "office" && /^house:/.test(x.e.off.key) && x.e.st === e.st);
        if(all.length) return done(e.st + " sends " + all.map(x => x.e.off.name + " (" + x.e.off.title.replace(/^Representative for /, "") + ")").join(" and ") + ", that I know of.", all[0].e, {c:all[0].c, how:all[0].how}); }
      if(k) return done(knCap(knHedge(k.c)) + e.off.name + (e.off.from > 1 ? ", since " + knWhen(e.off.from) : "") + "." + (k.how !== "self" ? " " + knCap(knSrc(p, k, e)) + "." : ""), e, k);
      return done("I could not tell you who is " + e.off.title + " now." + knWhoKnows(p, e), e, null); } }
  /* a law, or the bill before the House */
  const law = knFindLaw(q);
  if(law && law.kind === "law"){ const k = knKnows(p, law), who = /\bvot/.test(ql) ? knFindPerson(q.replace(new RegExp(law.law.title.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "i"), "")) : null;
    if(who && who !== p){ if(!k || (k.how !== "wit" && !(k.how === "self" && p.kind === "member"))) return done("I was not on the floor for that one, so I could not tell you how " + who.name + " voted." + (k ? " I know it " + (law.law.fate === "carried" ? "carried" : "went down") + ", " + law.law.aye + " to " + law.law.no + "." : ""), law, k);
      const v = law.law.v && law.law.v[who.id]; if(v === 0) return done(surname(who.name) + " was not on the floor for the vote. I was.", law, k); if(v) return done(surname(who.name) + " voted " + (v > 0 ? "aye" : "no") + " on it. I was there.", law, k);
      if(who === G.you && law.law.yv) return done("You voted " + (law.law.yv > 0 ? "aye" : "no") + ". I was there.", law, k);
      return done("I know the count, " + law.law.aye + " to " + law.law.no + ", not every name on the roll; I could not swear to how " + surname(who.name) + " voted.", law, k); }
    if(!k){ const before = p.kind === "member" && knSince(p) > law.d; return done((before ? "That was before my time here." : "I have not followed that one.") + knWhoKnows(p, law), law, null); }
    let t = knSay(p, law, k); const mv = law.law.v && law.law.v[p.id]; if(mv === 0) t += " I missed the vote myself."; else if(mv && k.how === "wit") t += " I voted " + (mv > 0 ? "aye" : "no") + ".";
    else { const op = knOpinion(p, law); if(op && !/^(That changes|Nobody tells|Hm\.|So that is)/.test(op)) t += " " + op; }
    return done(t, law, k); }
  if(/\b(will it pass|will it carry|the count|does it pass|going to pass|where does it stand|the numbers)\b/.test(ql)){
    const b = G.bill; if(b && !b.done){ const f = knForecast(p);
      if(!f) return done("I do not count votes; I could not tell you. Ask someone on the floor.", null, null);
      const C = f.cal, lean = Math.abs(f.aye - f.no) <= 4 ? "too close to call" : f.carry ? "it carries" : "it fails";
      return done("As I count it, about " + f.aye + " to " + f.no + ": " + lean + "." + (f.known > 1 ? " That is with " + (f.known - (p.kind === "member" ? 1 : 0)) + " of us who have told me where they stand." : " That is from the party lines; few have told me anything.") + (C.n && C.last ? " On the " + C.last.t + " I had " + C.last.p + " and it came in at " + C.last.a + ", so weigh it accordingly." : ""), null, null); } }
  /* the court */
  if(/\bcourt\b/.test(ql) && /\b(rule|ruled|ruling|decide|decided|say)\b/.test(ql)){ const K = knKnown(p).filter(x => x.e.kind === "case" && (!st || x.e.st === st)).sort((u, v) => v.e.d - u.e.d);
    if(K.length) return done(knSay(p, K[0].e, K[0]), K[0].e, K[0]); return done("I have not kept up with the court." , null, null); }
  /* a power abroad */
  if(realm){ const K = knKnown(p).filter(x => x.e.rk === realm).sort((u, v) => v.e.sal - u.e.sal);
    if(K.length) return done(K.slice(0, 2).map((x, i) => i ? knCap(x.e.t) + "." : knSay(p, x.e, x)).join(" "), K[0].e, K[0]); return done("I know very little about " + wmNameSafe(realm) + ".", null, null); }
  /* a person */
  const who = knFindPerson(q);
  if(who && who !== p && /\b(know about|think of|think about|make of|who is|who's|tell me about|heard about|what about|opinion of)\b/.test(ql)){
    const nm = who === G.you ? you.name : who.name, B = knBeliefs(p).filter(b => b.about === nm), K = knKnown(p).filter(x => x.e.who.indexOf(nm) >= 0 && x.e.kind !== "secret").sort((u, v) => v.e.sal - u.e.sal || (v.e.d || 0) - (u.e.d || 0));
    const bits = []; if(K.length) bits.push(knSay(p, K[0].e, K[0])); if(K[1]) bits.push(knCap(K[1].e.t) + knWhenC(K[1].e) + "."); if(B.length) bits.push(B[0].t + ": " + B[0].why + ".");
    if(bits.length) return done(bits.join(" "), K.length ? K[0].e : null, K.length ? K[0] : null);
    return done("I do not know " + (who === G.you ? "much more than anyone does" : surname(who.name) + " well enough to say") + ".", null, null); }
  /* a state */
  if(st && /\b(happening|news|going on|how is|how's|what about|heard from|from)\b/.test(ql)){ const K = knKnown(p).filter(x => x.e.st === st && x.e.kind !== "secret" && x.e.kind !== "offpast").sort((u, v) => ((v.e.d == null ? G.day - 20 : v.e.d) - (u.e.d == null ? G.day - 20 : u.e.d)) || v.e.sal - u.e.sal);
    if(K.length) return done(K.slice(0, 2).map((x, i) => i ? knCap(x.e.t) + knWhenC(x.e) + "." : knSay(p, x.e, x)).join(" "), K[0].e, K[0]); return done("I have heard nothing out of " + st + " lately.", null, null); }
  /* the news */
  if(/\b(news|what's new|whats new|what is new|heard anything|have you heard|what have you heard|anything new|going on|happening|latest)\b/.test(ql)){
    const K = knKnown(p).filter(x => KN_SHARE[x.e.kind] && x.e.d != null).sort((u, v) => (v.e.sal * Math.exp(-Math.max(0, G.day - v.e.d) / 6)) - (u.e.sal * Math.exp(-Math.max(0, G.day - u.e.d) / 6)));
    if(K.length) return done(knSay(p, K[0].e, K[0]) + (K[1] ? " And " + K[1].e.t + knWhenC(K[1].e) + "." : ""), K[0].e, K[0]); return done("Nothing that has reached me.", null, null); }
  return null;
}

/* ── the line that goes into a live model's prompt: what they know, what they worked out, and where their knowing stops ── */
function knPrompt(p, text, peer){
  if(!p || p === G.you || /^(engine|envoy)$/.test(p.kind || "")) return "";
  const K = knKnown(p), pr = knProf(p), qw = new Set(knWords(text));
  const sc = x => { const e = x.e, ov = knWords(e.t).filter(w => qw.has(w)).length, age = e.d == null ? 20 : Math.max(0, G.day - e.d);
    return ov * 2 + e.sal * (0.4 + Math.exp(-age / 15)) + (e.st && e.st === pr.st ? 0.3 : 0) + (peer && peer.name && e.who.indexOf(peer.name) >= 0 ? 1.5 : 0); };
  const top = K.filter(x => x.e.kind !== "secret").map(x => [x, sc(x)]).sort((u, v) => v[1] - u[1]).slice(0, 9).map(z => z[0]);
  const L = [];
  if(top.length){ L.push("WHAT YOU KNOW OF THE PUBLIC RECORD (true; how it reached you and how sure you are in brackets). Use it when it bears on what is said; never recite it as a list:");
    top.forEach(x => L.push("- " + knSent(x.e) + knWhenC(x.e) + " [" + knSrcShort(p, x) + (x.c < 0.6 ? "; hazy" : x.c < 0.75 ? "; fairly sure" : "") + "]")); }
  else L.push("WHAT YOU KNOW OF THE PUBLIC RECORD: very little; you do not follow the capital.");
  const B = knBeliefs(p).slice(0, 4); if(B.length){ L.push("WHAT YOU HAVE WORKED OUT FOR YOURSELF (your own reasoning from what you know; it can be wrong):"); B.forEach(b => L.push("- " + b.t + " (" + b.why + ")")); }
  const f = knForecast(p); if(f) L.push("YOUR OWN COUNT ON THE " + G.bill.title.toUpperCase() + ": about " + f.aye + " aye to " + f.no + " no" + (f.known > 1 ? ", counting the people who have told you their vote" : ", from the party lines alone") + (f.cal.n ? "; your counts have been off by " + Math.round(f.cal.mae) + " on average" : "") + ".");
  L.push("WHERE YOUR KNOWING STOPS: anything not above or in your memory you do not know. If asked about a law, a vote, an office holder, a ruling, a war or an event that is not here, say you do not know or have not heard, or name who would know. Never invent a name, a number, a vote or an event.");
  return L.join("\n");
}
function knEnginePrompt(){
  const ev = knEvents().filter(e => e.pub && e.kind !== "rn" && e.kind !== "offpast").map(e => [e, e.sal * (0.4 + (e.d == null ? 0.5 : Math.exp(-Math.max(0, G.day - e.d) / 20)))]).sort((u, v) => v[1] - u[1]).slice(0, 10).map(z => z[0]);
  if(!ev.length) return ""; const M = knEng(), L = ["THE PUBLIC RECORD (laws, rulings, offices, the states and the powers; you have read it, as anyone may; nothing private):"];
  ev.forEach(e => L.push("- " + knSent(e) + knWhenC(e) + "."));
  if(M.n) L.push("YOUR ROLL-CALL FORECASTS FROM THAT RECORD, SCORED AGAINST THE CLERK'S COUNT: " + M.n + " made; off by " + M.mae.toFixed(1) + " votes on average, where the plain whip count was off by " + M.bmae.toFixed(1) + "; right on the outcome " + M.hit + " of " + M.n + " times. Say so plainly if asked how good your forecasts are.");
  return L.join("\n");
}

/* ── hooks: roll calls, the corridor, the prompts, the panels ── */
{ const _hv = holdVote; holdVote = function(){ const b = G.bill; try{ if(b && !b.done) knFreeze(b); }catch(e){} const r = _hv.apply(this, arguments); try{ knResolve(b); }catch(e){} return r; }; }
{ const _cf = confer; confer = function(a, b){ const hb = b && b.heard ? b.heard[0] : null; const r = _cf.apply(this, arguments);
  try{ const bl = G.bill; if(bl && !bl.done && b.heard && b.heard[0] !== hb){ const t = b.heard.slice(0, 3).map(h => h.t).join(" "); if(t.indexOf(surname(a.name) + " told me they are voting") >= 0) knSawStance(a, b, bl); } }catch(e){}
  try{ if(chance(0.45)){ const sh = knShare(a, b); if(sh) KN.line.set(a, {t:G.t, b:b.id, l:[sh.a, sh.b]}); } }catch(e){}
  return r; }; }
{ const _st = smallTalk; smallTalk = function(a, b){ try{ const k = a && KN.line.get(a); if(k && b && k.b === b.id && G.t - k.t < 3){ KN.line.delete(a); return k.l; } }catch(e){} return _st.apply(this, arguments); }; }
{ const _op = ofhPublish; ofhPublish = function(){ KN.ofhN++; return _op.apply(this, arguments); }; }
{ const _epk = engEntityPrompt; engEntityPrompt = function(){ let t = _epk.apply(this, arguments) || ""; try{ const s = knEnginePrompt(); if(s) t += "\n" + s; }catch(e){} return t; }; }
{ const _scb3 = saveCaptureBase; saveCaptureBase = function(){ const o = _scb3.apply(this, arguments); try{ o.kn = G.kn || null; }catch(e){} return o; }; }
{ const _eph = engPlansHTML; engPlansHTML = function(){ let h = _eph.apply(this, arguments); try{ const M = knEng(), b = G.bill;
  const now = b && !b.done && G.eng && G.eng.v === 1 ? knEngPredict(b) : null;
  if(M.n || now) h += '<div class="eyebrow" style="margin-top:10px">Roll calls, forecast from the public record</div><p class="muted" style="font-size:13px">' +
    (now ? 'On the ' + pcEsc(b.title) + ' it expects about <b>' + now.aye + '</b> aye of ' + now.n + '; the whip count alone says ' + now.base + '. ' : '') +
    (M.n ? 'Scored on ' + M.n + ' roll call' + (M.n > 1 ? 's' : '') + ': off by ' + M.mae.toFixed(1) + ' votes on average against the whip count\'s ' + M.bmae.toFixed(1) + '; the outcome right ' + M.hit + ' of ' + M.n + ' times.' + (M.last ? ' Last: the ' + pcEsc(M.last.t) + ', ' + M.last.p + ' forecast, ' + M.last.a + ' counted.' : '') : 'Not yet scored: the first count is still to come.') + '</p>'; }catch(e){} return h; }; }
{ const _rt = renderTalk; renderTalk = function(){ const r = _rt.apply(this, arguments); try{ const m = TALK.m, box = el("tkMeta"); if(m && box && m.kind !== "engine" && !box.querySelector(".pin--kn")){
  const K = knKnown(m), B = knBeliefs(m); if(K.length){ const top = K.filter(x => x.e.kind !== "secret").slice().sort((u, v) => v.e.sal - u.e.sal || (v.e.d || 0) - (u.e.d || 0)).slice(0, 5);
    const tip = top.map(x => "• " + knSent(x.e) + knWhenC(x.e)).concat(B.slice(0, 2).map(b => "→ " + b.t + " (" + b.why + ")")).join("\n");
    const s = document.createElement("span"); s.className = "pin pin--kn"; s.title = "What they know of the record, and what they make of it:\n" + tip; s.textContent = "knows " + K.length + " of the record"; box.appendChild(s); } } }catch(e){} return r; }; }
{ const _sg = suggestions; suggestions = function(m){ const out = _sg.apply(this, arguments); try{ if(!m || TALK.thread || out.length < 3 || knH(m.id, "sg:" + G.day) > 0.6) return out;
  const home = knProf(m).st, last = knKnown(m).filter(x => x.e.kind === "law").sort((u, v) => v.e.d - u.e.d)[0], pool = [{t:"What's the news?", say:"What have you heard lately?"}];
  if(home && !(m.ohK && /^gov:/.test(m.ohK))) pool.push({t:"Who governs " + home + "?", say:"Who is the Governor of " + home + " these days?"});
  if(last) pool.push({t:"About the " + last.e.law.title.split(" ")[0] + " vote", say:"How did the " + last.e.law.title + " go?"});
  out[out.length - 1] = pool[Math.floor(knH(m.id, "sgp:" + G.day) * pool.length)]; }catch(e){} return out; }; }
/* a party line nobody defined left some members' sway as NaN in older saves; it is put back to nothing */
function knMend(){ let n = 0; try{ (G.members || []).forEach(m => { if(m && typeof m.sway === "number" && !isFinite(m.sway)){ m.sway = 0; n++; } }); }catch(e){} return n; }
setInterval(() => { try{ if(G && G.you && G.day != null && KN.day !== G.day){ const first = !KN.day; KN.day = G.day; knMend(); if(!first) knDay(); } }catch(e){} }, 3000);
window.onumKnow = {
  record:() => knEvents().map(e => ({key:e.k, kind:e.kind, day:e.d, text:knSent(e), public:e.pub, state:e.st || null})),
  of(id){ const p = knPerson(id); if(!p) return null; return knKnown(p).map(x => ({key:x.e.k, text:knSent(x.e), day:x.e.d, sure:Math.round(x.c * 100) / 100, how:x.how, from:x.how === "told" ? (knNameOf(x.src) || x.src) : null})); },
  beliefs(id){ const p = knPerson(id); return p ? knBeliefs(p).map(b => ({belief:b.t, because:b.why, sure:Math.round(b.c * 100) / 100})) : null; },
  ask(id, q){ const p = knPerson(id); if(!p) return null; const a = knAnswer(p, q); return a ? a.text : null; },
  who(key){ const e = KN.byK[key] || knEvents().find(x => x.k === key); if(!e) return null; try{ return everyone().filter(p => p && !p.gone && knKnows(p, e)).map(p => p.id); }catch(err){ return []; } },
  forecast(id){ const p = knPerson(id); const f = p ? knForecast(p) : null; return f ? {aye:f.aye, no:f.no, carries:f.carry, toldBy:f.known, record:f.cal.n ? {calls:f.cal.n, offBy:Math.round(f.cal.mae * 10) / 10, last:f.cal.last} : null} : null; },
  engine(){ const M = knEng(), b = G.bill; return {calls:M.n, offBy:M.mae, whipOffBy:M.bmae, right:M.hit, whipRight:M.bhit, weights:M.w.slice(), last:M.last, now:b && !b.done ? knEngPredict(b) : null}; },
  share(a, b){ const x = knPerson(a), y = knPerson(b); const s = x && y ? knShare(x, y) : null; return s ? {said:s.a, reply:s.b, key:s.e.k, alreadyKnew:s.knew} : null; },
  day:() => knDay(), prompt:(id, text) => { const p = knPerson(id); return p ? knPrompt(p, text || "") : ""; }
};

/* ══ 20261025h · THE STATUTE BOOK. Every bill and act is written out as law is written: a long title and an enacting clause,
   findings read from the record of why it was filed, definitions, one full section for every clause with its subsections and
   its numbers, the amendments it makes to the earlier acts it builds on (with those acts a click away), the money it really
   costs, enforcement, judicial review, severability and the day it takes effect; each section with what it does in plain words.
   Signing and vetoing are written into the book, a veto goes back to the House for a two-thirds override, enacted laws draw
   suits against the sections that are open to challenge, and the bench decides them justice by justice, on the claim, the
   section and its own precedents. ══ */
const LX = {docs:new Map(), sig:""};
const LX_AG = {rail:"the Rail Board", levee:"the Corps of Engineers", tariff:"the Customs Service of the Treasury", school:"the Office of Education", navy:"the Secretary of Defense",
  court:"the Chief Justice", land:"the General Land Office", bank:"the Secretary of the Treasury", labour:"the Labour Inspectorate", docks:"the Board of Harbours", health:"the Public Health Service",
  press:"the Postmaster General", census:"the Census Office", gas:"the General Land Office", visa:"the Immigration Service", border:"the Federal Border Guard", natur:"the Immigration Service",
  aid:"the Secretary of State", arms:"the Secretary of Defense", mandate:"the Office of Education", preempt:"the Attorney General"};
const LX_PURPOSE = {rail:"charter and regulate an interstate rail line", levee:"raise and maintain flood works along the river reaches", tariff:"lay duties on imported iron and cloth and encourage domestic cargo",
  school:"aid the schools of poor districts", navy:"enlarge the fleet and its yards", court:"enlarge and reorganize the federal courts", land:"open the public lands to settlement",
  bank:"charter a central bank of the Republic", labour:"limit hours and secure safety in federally chartered works", docks:"improve the harbours and the customs", health:"establish county clinics",
  press:"regulate postage for newspapers and the ownership of the press", census:"provide for an enumeration and the reapportionment of the House", gas:"lease and regulate the western gas fields",
  visa:"provide for seasonal labour visas", border:"establish a federal border guard", natur:"reform the law of naturalization", aid:"provide grain and credit to a friendly power",
  arms:"permit the sale of arms to a friendly power", mandate:"set a federal standard for the schools of the states", preempt:"replace the laws of the states with one federal rule"};
const LX_FIND = {rail:"Freight that could move by rail moves by cart, at four times the cost, where no line has been laid.", levee:"The same reaches flood in most years, and the counties along them cannot pay to rebuild twice.",
  tariff:"Foreign iron and cloth undersell the mills of the Republic in its own ports.", school:"Districts with little taxable property cannot keep their schools open on local rates alone.",
  navy:"The fleet is smaller than the coast it is asked to keep.", court:"The federal courts are behind on their dockets by years.", land:"Public land lies unsurveyed and unworked while settlers wait for title.",
  bank:"The notes of a hundred private banks pass at a hundred different discounts.", labour:"Men and women in federally chartered works are kept on the floor past twelve hours, and are hurt there.",
  docks:"The deepwater berths silt up, and the customs cannot keep pace with the cargo.", health:"Counties of fewer than fifty thousand people are often a day's travel from a physician.",
  press:"Postage decides which newspapers reach the country towns, and no one may say who owns them.", census:"The House is apportioned on a count that is out of date.",
  gas:"The western fields are worked without lease, royalty or rule.", visa:"The harvest outruns the hands to bring it in.", border:"The crossings are kept by whoever happens to be standing there.",
  natur:"Those who have made their lives here wait nine years to be citizens of it.", aid:"A friendly power has asked the Republic for help and its envoy waits for an answer.",
  arms:"A friendly power has asked to buy arms from the Republic's arsenals.", mandate:"The schools of the states are held to no common measure.", preempt:"Forty-eight different rules govern the same trade across state lines."};
const LX_DEF = {rail:[["line", "the railway, its stations, sidings and right of way chartered under this Act"], ["shipper", "any person who tenders freight for carriage on the line"]],
  levee:[["reach", "a continuous stretch of riverbank between two gauging stations"], ["works", "levees, spillways, revetments and the land they stand on"]],
  tariff:[["duty", "a tax laid on goods entering the Republic"], ["domestic cargo", "goods grown, mined or made within the Republic"]],
  school:[["district", "a school district organized under the law of a State"], ["threshold", "the assessed property per enrolled pupil set under this Act"]],
  navy:[["ship of the line", "a warship of the first or second rate"], ["yard", "a naval yard owned by the Republic"]],
  court:[["high bench", "the highest court of the Republic"], ["circuit judge", "a judge of the federal courts below the high bench"]],
  land:[["public land", "land owned by the Republic and not reserved to any use"], ["settler", "a person who enters, lives on and works a claim"]],
  bank:[["specie", "gold and silver coin of the Republic"], ["note", "a promise to pay issued by the bank and payable to the bearer"]],
  labour:[["chartered works", "any mill, yard, mine or line operating under a charter of the Republic"], ["floor", "any room or yard in which work is done"]],
  docks:[["bonded warehouse", "a store in which goods are held under customs seal until duty is paid"], ["deepwater port", "a port with a channel of not less than thirty feet"]],
  health:[["county", "a county as organized under the law of a State"], ["clinic", "a place where a licensed physician sees patients at public expense"]],
  press:[["newspaper", "a publication issued at least weekly and carrying general news"], ["owner", "any person holding a tenth or more of a newspaper's shares or profits"]],
  census:[["enumeration", "the count of every person living in the Republic"], ["apportionment", "the division of the seats of the House among the States"]],
  gas:[["field", "a body of natural gas lying under public land"], ["royalty", "the share of the value of gas paid to the Republic"]],
  visa:[["seasonal worker", "a foreign national admitted to work a harvest"], ["employer", "any person who hires a seasonal worker"]],
  border:[["crossing", "any road, ford, rail line or harbour by which a person may enter the Republic"], ["papers", "a passport, visa or certificate of citizenship"]],
  natur:[["resident", "a person lawfully living in the Republic"], ["veteran", "a person honourably discharged from the forces of the Republic"]],
  aid:[["recipient", "the friendly power named in this Act"], ["credit", "a loan on terms set by the Secretary of the Treasury"]],
  arms:[["arms", "rifles, ordnance, ammunition and their parts"], ["realm", "the friendly power named in this Act"]],
  mandate:[["standard", "the federal school standard set under this Act"], ["monitor", "an officer of the Republic appointed under this Act"]],
  preempt:[["federal rule", "the rule set out in this Act and the regulations made under it"], ["state law", "any statute, regulation or ordinance of a State or its subdivisions"]]};
/* each clause, written out: heading, subsections, plain words, and the challenge it is open to [theory, who sues, strength] */
const LX_CL = {
  "a federal charter for the line":(P, X) => ["Federal charter", ["(a) Charter.— There is chartered a body corporate, the " + X.STn + " Line Company, to build and operate the line between the termini named by " + X.AG + ".", "(b) Capital.— The company may issue stock to " + P.money(2, 8) + " and no more without a further Act.", "(c) Visitation.— " + X.AGc + " may inspect the company's books at any time."], "The Republic charters one company to build and run the line, caps its stock, and can inspect its books.", null],
  "freight rates fixed for ten years":(P, X) => ["Freight rates", ["(a) Rates fixed.— The rate for freight on the line shall not exceed " + P.n(2, 6) + " stuivers a ton-mile for ten years from the day the line opens.", "(b) No preference.— The company shall charge every shipper the same rate for the same carriage.", "(c) Penalty.— A rate charged above the limit is recoverable by the shipper threefold."], "Rates are capped for ten years, and every shipper pays the same.", ["contract", "group", 0.35, "The Chamber of Commerce"]],
  "land taken by eminent domain along the route":(P, X) => ["Right of way", ["(a) Taking.— " + X.AGc + " may take, by eminent domain, a strip not more than " + P.n(100, 300, 50) + " feet wide along the route surveyed.", "(b) Compensation.— The owner shall be paid the value of the land as assessed by three commissioners, one chosen by the owner.", "(c) Possession.— Possession may be taken on deposit of the assessed value with the court."], "Land along the route can be taken for the line, with payment set by commissioners.", ["takings", "person", 0.55, "a landowner along the route"]],
  "levees raised four feet along the whole reach":(P, X) => ["Levee works", ["(a) Raising.— " + X.AGc + " shall raise the levees four feet along every reach from the falls to the sea.", "(b) Standard.— Every levee raised shall be built to withstand the highest water recorded in the last " + P.n(30, 100, 10) + " years.", "(c) Order of work.— The reaches that flooded most recently shall be raised first."], "The levees go up four feet everywhere on the river, worst-flooded reaches first.", null],
  "the works let to the lowest bidder":(P, X) => ["Contracts", ["(a) Bidding.— Every contract for the works shall be let by sealed bid to the lowest responsible bidder.", "(b) Bond.— Each contractor shall post a bond of " + P.n(10, 25) + " per cent of the contract.", "(c) Publication.— The bids received shall be published in full."], "The work goes to the cheapest sealed bid, with a bond, and the bids are published.", null],
  "a standing fund for the next one":(P, X) => ["Flood reserve", ["(a) Fund.— There is established in the Treasury a Flood Reserve Fund.", "(b) Deposits.— " + P.n(5, 15) + " per cent of each year's appropriation for the works shall be paid into the Fund and not spent on them.", "(c) Use.— The Fund may be drawn only on a declaration by " + X.AG + " that a reach has failed."], "A slice of every year's money is set aside for the next flood.", null],
  "a duty on imported iron and cloth":(P, X) => ["Duties", ["(a) Iron.— There shall be laid on pig and bar iron entering the Republic a duty of " + P.n(10, 40, 5) + " per cent of its value.", "(b) Cloth.— There shall be laid on woven cloth a duty of " + P.n(10, 35, 5) + " per cent of its value.", "(c) Collection.— " + X.AGc + " shall collect the duties at the port of entry."], "Imported iron and cloth pay a duty at the port.", ["uniformity", "group", 0.2, "The farm co-ops"]],
  "a rebate for ports handling domestic cargo":(P, X) => ["Port rebate", ["(a) Rebate.— A port that handles more domestic cargo than foreign in a year shall be rebated " + P.n(5, 20) + " per cent of the duties it collected.", "(b) Certification.— " + X.AGc + " shall certify the tonnage of each port by the first day of the year."], "Ports that ship mostly the Republic's own goods get part of the duty back.", ["uniformity", "state", 0.45, null]],
  "a schedule reviewed every third year":(P, X) => ["Review of the schedule", ["(a) Review.— Every third year " + X.AG + " shall report to the House on the effect of the duties.", "(b) Adjustment.— " + X.AGc + " may raise or lower any duty by not more than " + P.n(5, 15) + " per cent without a further Act."], "The duties are reviewed every three years, and can be adjusted a little without a new law.", ["delegation", "group", 0.4, "The Chamber of Commerce"]],
  "a federal grant for every district under a threshold":(P, X) => ["Grants to districts", ["(a) Grant.— " + X.AGc + " shall pay to every district whose assessed property per pupil is below " + P.money(1, 4) + " a grant for each pupil enrolled.", "(b) Amount.— The grant shall be " + P.money(0.02, 0.1, 0.01) + " a pupil a year.", "(c) Use.— The grant shall be spent on teachers, books and the upkeep of school buildings, and on nothing else."], "Poor districts get money for each pupil, to be spent only on teachers, books and buildings.", null],
  "attendance made a condition of the grant":(P, X) => ["Condition of attendance", ["(a) Condition.— No district shall receive a grant under this Act unless the State has in force a law requiring the attendance of children from seven to " + P.n(12, 15) + " years.", "(b) Proof.— The State shall certify attendance each year to " + X.AG + "."], "A district only gets the money if its State makes children attend school.", ["spending", "state", 0.5, null]],
  "a national examination nobody asked for":(P, X) => ["National examination", ["(a) Examination.— " + X.AGc + " shall set an examination in reading, writing and arithmetic, to be sat by every pupil in a grant-receiving district at the age of " + P.n(10, 13) + ".", "(b) Publication.— The results shall be published by district."], "Every pupil in a funded district sits one national examination, and the results are published.", ["states", "state", 0.35, null]],
  "six new ships of the line":(P, X) => ["New construction", ["(a) Authorization.— " + X.AGc + " shall lay down six ships of the line within " + P.n(2, 5) + " years.", "(b) Design.— Each ship shall carry not fewer than " + P.n(60, 90, 10) + " guns."], "Six new warships are ordered.", null],
  "a permanent yard at the deepwater port":(P, X) => ["Permanent yard", ["(a) Yard.— There is established a permanent naval yard at the deepwater port named by " + X.AG + ".", "(b) Land.— Land for the yard may be purchased or taken under the law of eminent domain."], "A permanent naval yard is built at a deepwater port.", ["takings", "person", 0.3, "the owners of the harbour land"]],
  "conscription for the yards if the yards fall behind":(P, X) => ["Labour for the yards", ["(a) Conscription.— If " + X.AG + " certifies that construction is more than " + P.n(3, 9) + " months behind, able-bodied men of eighteen to forty living within fifty miles of the yard may be called to work in it.", "(b) Pay.— Those called shall be paid the prevailing wage.", "(c) Term.— No one shall be held more than " + P.n(6, 18) + " months."], "If the yards fall behind, men nearby can be called up to work in them, at the going wage.", ["servitude", "person", 0.65, "a man called up for the yards"]],
  "two new seats on the high bench":(P, X) => ["Enlargement of the high bench", ["(a) Seats.— The high bench shall consist of the Chief Justice and six associate justices.", "(b) Appointment.— The two new seats shall be filled by the " + X.EXEC + " with the advice and consent of the Senate."], "The high bench grows from five justices to seven.", ["separation", "member", 0.45, "a member of the House"]],
  "circuit judges appointed for life":(P, X) => ["Tenure of circuit judges", ["(a) Tenure.— Circuit judges shall hold office during good behaviour.", "(b) Removal.— A circuit judge may be removed only on impeachment."], "Circuit judges serve for life unless impeached.", null],
  "review of every act passed since the last Congress":(P, X) => ["Review of recent acts", ["(a) Review.— The high bench shall review, on its own motion, every Act passed since the opening of the last Congress.", "(b) Report.— The bench shall report to the House within " + P.n(6, 18) + " months which of them it holds invalid."], "The high bench must review every recent law and report which it thinks invalid.", ["separation", "member", 0.6, "a member of the House"]],
  "public land opened to settlement at a shilling an acre":(P, X) => ["Settlement", ["(a) Entry.— Any settler may enter up to " + P.n(80, 320, 80) + " acres of surveyed public land at one shilling an acre.", "(b) Residence.— Title passes after five years' residence and cultivation."], "Settlers can claim public land cheaply and own it after five years of living on and working it.", null],
  "timber rights reserved to the Republic":(P, X) => ["Timber reserved", ["(a) Reservation.— The standing timber on land entered under this Act remains the property of the Republic.", "(b) Cutting.— Timber may be cut only under licence from " + X.AG + "."], "The trees on settled land still belong to the Republic.", ["takings", "person", 0.3, "a settler on the new land"]],
  "the survey paid for out of the sale":(P, X) => ["Survey", ["(a) Survey.— " + X.AGc + " shall survey the land before it is opened.", "(b) Cost.— The cost of the survey shall be met from the price paid on entry."], "The land sales pay for the survey.", null],
  "a charter for a central bank of the Republic":(P, X) => ["Charter of the bank", ["(a) Charter.— There is chartered the Bank of " + X.CCs + ", with capital of " + P.money(5, 20) + ".", "(b) Directors.— " + P.n(5, 9) + " directors, of whom " + X.EXEC + " shall appoint two.", "(c) Deposits.— The revenues of the Republic shall be deposited in the bank."], "A central bank is chartered and holds the Republic's money.", ["states", "state", 0.3, null]],
  "note issue limited by specie held":(P, X) => ["Notes", ["(a) Limit.— The bank shall not have notes outstanding of more than " + P.n(2, 4) + " times the specie it holds.", "(b) Redemption.— Every note shall be paid in specie on demand at the bank."], "The bank can only print notes up to a multiple of the gold and silver it holds.", null],
  "the charter reviewed in twenty years":(P, X) => ["Term of the charter", ["(a) Term.— The charter expires twenty years from its grant unless renewed by Act.", "(b) Winding up.— On expiry the bank shall have " + P.n(2, 5) + " years to wind up its affairs."], "The bank's charter runs out in twenty years unless renewed.", null],
  "a ten-hour day in federally chartered works":(P, X) => ["Hours of labour", ["(a) Limit.— No person shall be employed in chartered works more than ten hours in a day or " + P.n(54, 60, 6) + " hours in a week.", "(b) Overtime.— Work past the limit in an emergency shall be paid at time and a half."], "In works chartered by the Republic, the working day is limited to ten hours.", ["contract", "group", 0.5, "The Chamber of Commerce"]],
  "inspection with the power to close a floor":(P, X) => ["Inspection", ["(a) Inspectors.— " + X.AGc + " shall appoint inspectors with the right to enter chartered works at any hour.", "(b) Closing.— An inspector who finds a danger to life may close the floor until it is made safe.", "(c) Appeal.— The owner may appeal a closing to the circuit court within " + P.n(3, 10) + " days."], "Inspectors can enter any chartered works and shut a dangerous floor.", ["dueprocess", "group", 0.35, "The Chamber of Commerce"]],
  "penalties paid to the injured, not the treasury":(P, X) => ["Penalties", ["(a) Penalty.— An employer who breaks this Act shall pay a penalty of up to " + P.money(0.5, 3, 0.5) + ".", "(b) To the injured.— Every penalty shall be paid to the person injured, or to their family."], "Fines go to the injured worker or their family, not to the government.", null],
  "dredging to thirty feet":(P, X) => ["Dredging", ["(a) Depth.— " + X.AGc + " shall dredge the main channel of the deepwater port to thirty feet at low water.", "(b) Upkeep.— The depth shall be kept by dredging every " + P.n(2, 5) + " years."], "The harbour channel is dug to thirty feet and kept there.", null],
  "a bonded warehouse district":(P, X) => ["Bonded district", ["(a) District.— A bonded warehouse district is established at the port.", "(b) Duty deferred.— Goods stored in the district pay no duty until they leave it for the Republic.", "(c) Term.— No goods may be held in bond longer than " + P.n(1, 3) + " years."], "Goods can sit in bonded warehouses without paying duty until they enter the country.", null],
  "customs officers doubled":(P, X) => ["Customs officers", ["(a) Number.— The customs officers at every port of entry shall be doubled within " + P.n(6, 18) + " months.", "(b) Search.— An officer may search any vessel, vehicle or package entering the port."], "The number of customs officers doubles, with power to search anything coming in.", ["dueprocess", "group", 0.3, "The civil liberties union"]],
  "a clinic in every county under fifty thousand":(P, X) => ["County clinics", ["(a) Clinics.— " + X.AGc + " shall open a clinic in every county with fewer than fifty thousand people.", "(b) Staffing.— Each clinic shall have at least one licensed physician and " + P.n(1, 3) + " nurses."], "Every small county gets a public clinic with a doctor.", null],
  "physicians' fees set by schedule":(P, X) => ["Fees", ["(a) Schedule.— " + X.AGc + " shall publish a schedule of fees for each kind of visit and treatment.", "(b) Limit.— No physician paid under this Act shall charge more than the schedule."], "Doctors paid under the act charge set fees.", ["contract", "group", 0.4, "The bar association"]],
  "the whole thing funded out of the tariff":(P, X) => ["Funding", ["(a) Source.— The clinics shall be paid for out of the revenue of the duties on imports.", "(b) Priority.— The clinics' appropriation is a first charge on that revenue after the costs of collection."], "The clinics are paid for from import duties, before anything else.", null],
  "postal rates for newspapers cut by half":(P, X) => ["Newspaper postage", ["(a) Rate.— The postage on newspapers shall be one half of the rate in force on the day this Act is passed.", "(b) Country towns.— Newspapers carried to towns of fewer than " + P.n(2, 10) + " thousand people go free."], "Mailing newspapers costs half as much; small towns get them free.", null],
  "a register of who owns what":(P, X) => ["Register of owners", ["(a) Register.— Every newspaper shall file with " + X.AG + " the name of every owner.", "(b) Publication.— The register shall be open to the public.", "(c) Penalty.— A newspaper that does not file may be refused the mails."], "Every newspaper must say publicly who owns it, or lose the post.", ["press", "group", 0.5, "The Wire"]],
  "penalties for a knowingly false report":(P, X) => ["False reports", ["(a) Offence.— Whoever publishes a report they know to be false, about a public officer, shall be fined up to " + P.money(0.5, 2, 0.5) + ".", "(b) Truth.— Truth is a complete defence."], "Knowingly printing a lie about an official is fined; the truth is always a defence.", ["press", "group", 0.7, "The Wire"]],
  "a full enumeration in the third year":(P, X) => ["Enumeration", ["(a) Count.— " + X.AGc + " shall count every person in the Republic in the third year of each decade.", "(b) Duty to answer.— Every head of household shall answer the enumerator truly."], "Everyone is counted every ten years.", null],
  "reapportionment to follow within one session":(P, X) => ["Reapportionment", ["(a) Seats.— Within one session of the count, the seats of the House shall be divided among the States in proportion to their people.", "(b) Districts.— Each State shall draw its districts within " + P.n(3, 9) + " months."], "After the count, House seats are redivided among the States by population.", ["states", "state", 0.3, null]],
  "the count published in full":(P, X) => ["Publication", ["(a) Publication.— The count shall be published in full, by county.", "(b) Privacy.— No return naming a person shall be published for " + P.n(50, 100, 10) + " years."], "The census results are published county by county; personal returns stay private.", null],
  "a federal lease on the western fields":(P, X) => ["Leases", ["(a) Lease.— " + X.AGc + " may lease the western fields for terms of " + P.n(10, 30, 5) + " years.", "(b) Bidding.— Leases shall go to the highest responsible bidder."], "The western gas fields are leased out by auction.", null],
  "royalties split with the states":(P, X) => ["Royalties", ["(a) Royalty.— Every lessee shall pay a royalty of " + P.n(8, 20) + " per cent of the value of the gas.", "(b) Division.— Half of each royalty shall be paid to the State in which the field lies."], "Half the royalties go to the State where the gas is.", null],
  "a price cap on lighting in the cities":(P, X) => ["Price of light", ["(a) Cap.— No company shall charge more than " + P.n(1, 4) + " stuivers for a thousand feet of lighting gas in a city of more than fifty thousand people.", "(b) Review.— " + X.AGc + " may revise the cap once a year."], "City gas for lighting has a capped price.", ["takings", "group", 0.45, "The Chamber of Commerce"]],
  "harvest visas doubled for two seasons":(P, X) => ["Harvest visas", ["(a) Number.— The number of seasonal visas shall be twice that of the last season, for two seasons.", "(b) Term.— A seasonal visa runs " + P.n(4, 8) + " months."], "Twice as many harvest visas for two seasons.", null],
  "employers to post a bond for each worker":(P, X) => ["Employer bond", ["(a) Bond.— An employer shall post a bond of " + P.money(0.05, 0.3, 0.05) + " for each seasonal worker.", "(b) Forfeit.— The bond is forfeit if the worker is not paid or is not returned home at the end of the season."], "Employers put up a bond for each worker, lost if the worker is cheated.", null],
  "the visa tied to one employer, not the worker":(P, X) => ["Employer named", ["(a) One employer.— A seasonal visa names one employer, and the worker may work for no other.", "(b) Ending.— If the employment ends the visa ends with it."], "A worker's visa is tied to one employer; leaving the job ends the visa.", ["dueprocess", "group", 0.5, "The civil liberties union"]],
  "a federal border guard of four thousand":(P, X) => ["Border Guard", ["(a) Establishment.— There is established the Federal Border Guard, of four thousand officers.", "(b) Command.— The Guard is commanded by an officer appointed by the " + X.EXEC + "."], "A federal border force of four thousand is created.", null],
  "detention for anyone without papers at a crossing":(P, X) => ["Detention at crossings", ["(a) Detention.— Any person found at a crossing without papers may be detained.", "(b) Hearing.— A person detained shall be brought before a magistrate within " + P.n(3, 14) + " days.", "(c) Release.— A person who shows a right to be in the Republic shall be released at once."], "Anyone at a crossing without papers can be held until a magistrate sees them.", ["dueprocess", "group", 0.65, "The civil liberties union"]],
  "the guard paid for by a levy on the border states":(P, X) => ["Cost of the Guard", ["(a) Levy.— The cost of the Guard shall be met by a levy on the border States, in proportion to the length of their borders.", "(b) Collection.— " + X.AGc + " shall assess the levy each year."], "The border States pay for the Guard.", ["equal", "state", 0.55, null]],
  "citizenship after five years, not nine":(P, X) => ["Residence", ["(a) Period.— A resident may be naturalized after five years' residence.", "(b) Proof.— Residence may be proved by any two witnesses who are citizens."], "Citizenship after five years instead of nine.", null],
  "an oath and a civics test in any language":(P, X) => ["Oath and test", ["(a) Oath.— Every applicant shall swear to support the Charter of the Republic.", "(b) Test.— Every applicant shall answer " + P.n(10, 25, 5) + " questions on the Charter and the laws, in any language they choose."], "New citizens take an oath and a civics test, in their own language.", null],
  "the fee waived for veterans of the Republic":(P, X) => ["Veterans", ["(a) Fee.— No fee shall be charged to a veteran applying for naturalization.", "(b) Period.— A veteran may be naturalized after " + P.n(1, 3) + " years' residence."], "Veterans become citizens free and sooner.", null],
  "grain and credit to an ally abroad":(P, X) => ["Assistance to " + X.REALM, ["(a) Grain.— " + X.AGc + " shall deliver to " + X.REALM + " grain to the value of " + P.money(0.5, 4, 0.5) + ".", "(b) Credit.— The Treasury may lend " + X.REALM + " up to " + P.money(1, 6) + " at not less than " + P.n(2, 5) + " per cent."], "Grain is sent and a loan offered to " + X.REALM + ".", null],
  "the money spent on Republic farms and ships":(P, X) => ["Domestic purchase", ["(a) Grain.— All grain delivered under this Act shall be bought from farms in the Republic.", "(b) Carriage.— It shall be carried in ships registered in the Republic."], "The aid money is spent on the Republic's own farms and ships.", null],
  "a report to this House every quarter":(P, X) => ["Reports", ["(a) Report.— " + X.AGc + " shall report to the House every quarter on what has been sent and lent, and to whom."], "The House gets a report every three months.", null],
  "arms sold at cost to a friendly realm":(P, X) => ["Sale of arms", ["(a) Sale.— " + X.AGc + " may sell to " + X.REALM + " arms from the arsenals of the Republic at their cost, to a total of " + P.money(0.5, 5, 0.5) + "."], "Arms are sold at cost to " + X.REALM + ".", null],
  "an attaché posted with every shipment":(P, X) => ["Attaché", ["(a) Attaché.— An officer of the Republic shall accompany every shipment and report on its use."], "An officer goes with each shipment to watch how it is used.", null],
  "the sale suspended if the realm goes to war":(P, X) => ["Suspension", ["(a) Suspension.— All sales shall stop on the day " + X.REALM + " goes to war with any power, and shall not resume without a further Act."], "Sales stop the moment the buyer goes to war.", null],
  "every state to meet a federal school standard":(P, X) => ["Federal standard", ["(a) Standard.— " + X.AGc + " shall set a standard of instruction which every State shall meet within " + P.n(2, 5) + " years.", "(b) Report.— Each State shall report its progress each year."], "Every State must bring its schools up to a federal standard.", ["states", "state", 0.65, null]],
  "no new money to meet it":(P, X) => ["No appropriation", ["(a) Cost.— The States shall meet the standard from their own revenues; nothing in this Act appropriates money to them."], "The States pay for it themselves.", ["spending", "state", 0.55, null]],
  "a federal monitor in any state that falls behind":(P, X) => ["Monitors", ["(a) Monitor.— Where a State falls behind the standard, " + X.AG + " may appoint a monitor with power to direct its schools.", "(b) Term.— A monitor serves until the State meets the standard."], "A federal monitor can take over a State's schools if it falls behind.", ["states", "state", 0.7, null]],
  "one federal rule replacing forty-eight state ones":(P, X) => ["One rule", ["(a) Rule.— The trade covered by this Act shall be governed by the rule set out in this Act and by no other.", "(b) Regulations.— " + X.AGc + " shall make regulations under it within " + P.n(6, 18) + " months."], "One federal rule replaces all the States' rules on this trade.", ["preempt", "state", 0.45, null]],
  "state laws in conflict declared void":(P, X) => ["Conflicting state law", ["(a) Void.— Any state law in conflict with the federal rule is void to the extent of the conflict."], "State laws that conflict with the federal rule stop applying.", ["preempt", "state", 0.5, null]],
  "no state may set a stricter standard":(P, X) => ["Ceiling", ["(a) Ceiling.— No State shall set a standard stricter than the federal rule."], "States may not go further than the federal rule.", ["preempt", "state", 0.6, null]],
  "the whole of it to take effect in one session, not three":(P, X) => ["Effect in one session", ["(a) Timing.— Every section of this Act takes effect within one session of its enactment, and not in stages."], "All of it happens at once, within a session, not phased in over three.", null]
};
function lxFirstCall(town){ return (P, X) => ["First call on the money", ["(a) Priority.— Of the money appropriated by this Act, " + X.AG + " shall first meet the needs of " + town + " and the counties around it.", "(b) Extent.— Not less than " + P.n(10, 30, 5) + " per cent of the appropriation shall be spent there."], town + " and its neighbours are served first, with a guaranteed share.", ["equal", "state", 0.35, null]]; }
/* a clause nobody wrote a section for still gets one, read from its own words */
function lxGeneric(cl, X){ return ["Provision", ["(a) In general.— " + knCap(cl) + ".", "(b) Administration.— " + X.AGc + " shall carry out this section and make regulations under it."], knCap(cl) + ".", null]; }
function lxParams(seed){ const r = rng(seedOf(seed)); return {
  n(lo, hi, step){ step = step || 1; return lo + Math.round(r() * (hi - lo) / step) * step; },
  money(lo, hi, step){ step = step || 0.5; const v = lo + Math.round(r() * (hi - lo) / step) * step; return money(v * 1000); } }; }
function lxDomainOf(s){
  if(s.domain) return s.domain;
  const C = s.clauses || []; let best = null, bn = 0;
  (typeof BILL_DOMAIN !== "undefined" ? BILL_DOMAIN : []).forEach(d => { const n = d.cl.filter(c => C.indexOf(c) >= 0).length; if(n > bn){ bn = n; best = d.k; } });
  return best;
}
function lxCountry(){ return String((G.country && G.country.name) || "the Republic").replace(/^The\s+/, "the "); }
function lxCongNo(d){ return Math.max(1, Math.floor((Math.max(1, d || G.day || 1) - 1) / (G.termLength || 52)) + 1); }
/* the record behind an act, wherever it is: the bill on the calendar, the statute book, or the President's desk */
function lxSource(ref){
  if(!ref) return null;
  if(ref.clauses && ref.title) return ref;
  const t = typeof ref === "string" ? ref : ref.title; if(!t) return null;
  const S = (G.statute || []).filter(s => s.title === t);
  if(ref.day != null){ const x = S.find(s => s.day === ref.day) || S.find(s => Math.abs(s.day - ref.day) <= 1); if(x) return x; }
  if(S.length) return S[0];
  if(G.bill && G.bill.title === t) return G.bill;
  return null;
}
function lxKey(s){ return (s.day != null ? s.day : "cal") + ":" + s.title; }
/* the earlier act on the same subject still on the books: what a new bill on it really amends */
function lxPrior(src, dom){
  if(!dom) return null; const d0 = src.done || src.fate ? (src.day || G.day) : G.day + 1;
  return (G.statute || []).filter(s => s !== src && s.title !== src.title && (s.day || 0) < d0 && (s.fate === "carried") && !(s.lxStruck && s.lxStruck.whole) && lxDomainOf(s) === dom).sort((a, b) => b.day - a.day)[0] || null;
}
function lxDoc(ref){
  const src = lxSource(ref); if(!src) return null;
  const key = lxKey(src) + "|" + (src.clauses || []).length + "|" + (src.strk || []).join(",") + "|" + ((src.lxStruck && src.lxStruck.secs) || []).join(",") + "|" + (src.soft ? 1 : 0) + "|" + (G.statute || []).length;
  const c = LX.docs.get(lxKey(src)); if(c && c.key === key) return c.doc;
  const dom = lxDomainOf(src), ag = LX_AG[dom] || "the Secretary concerned", EXEC = (function(){ try{ return execTitle(); }catch(e){ return "President"; } })();
  const town = src.town || ((/^In ([A-Z][\w' -]+?),/.exec(src.why || "") || [])[1]) || null, st = src.state || null;
  const realm = src.realmT || (function(){ const m = /^Cabled from ([^:]+):/.exec(src.why || ""); return m ? m[1] : null; })() || "the friendly power";
  const X = {AG:ag, AGc:knCap(ag), ST:st, STn:st || "Republic", TOWN:town, REALM:realm, EXEC, CC:lxCountry(), CCs:lxCountry().replace(/^the\s+/i, "")};
  const prior = lxPrior(src, dom), pc = prior ? (prior.clauses || []) : [];
  const D = {key:lxKey(src), title:src.title, src, dom, prior, congress:knOrd(lxCongNo(src.day)), no:"H.R. " + (src.id || (seedOf(src.title) % 900 + 100)), secs:[], cites:[]};
  D.longTitle = "To " + (LX_PURPOSE[dom] || "provide for the matters named in it") + (town ? ", with first regard to " + town : "") + ", and for other purposes.";
  D.enact = "Be it enacted by the Senate and House of Representatives of " + X.CC + " in Congress assembled,";
  const S = D.secs, add = (head, sub, plain, extra) => { const s = Object.assign({n:S.length + 1, head, sub, plain}, extra || {}); S.push(s); return s; };
  add("Short title", ["This Act may be cited as the " + src.title + "."], "The name it goes by. It changes nothing by itself.", {k:"title"});
  const F = []; String(src.why || "").split(/(?<=[.!?])\s+/).filter(Boolean).forEach(x => F.push(x.replace(/\s+$/, "")));
  if(LX_FIND[dom]) F.push(LX_FIND[dom]);
  add("Findings", ["The Congress finds that—"].concat(F.map((f, i) => "(" + (i + 1) + ") " + f)), "Why it was filed, in the sponsor's words and the record's.", {k:"find"});
  const defs = (LX_DEF[dom] || []).concat([["administering office", ag], ["State", "a State of the Union"]]);
  add("Definitions", ["In this Act—"].concat(defs.map((d, i) => "(" + (i + 1) + ") “" + d[0] + "” means " + d[1] + ";")), "What its words mean, so a court reads them the same way twice.", {k:"def"});
  const strk = src.strk || [], judged = (src.lxStruck && src.lxStruck.secs) || [];
  (src.clauses || []).forEach((cl, ci) => {
    const P = lxParams("lx:" + src.title + ":" + ci);
    const f = LX_CL[cl] || (/^a first call on the money for /.test(cl) ? lxFirstCall(cl.replace(/^a first call on the money for /, "").replace(/ and the counties around it$/, "")) : null);
    const r = f ? f(P, X) : lxGeneric(cl, X);
    const ext = {k:"op", ci, clause:cl, claim:r[3], short:r[0], struckAmend:strk.indexOf(ci) >= 0};
    const pi = pc.indexOf(cl);
    if(prior && pi >= 0 && !/^a first call/.test(cl) && cl !== "the whole of it to take effect in one session, not three"){
      /* the same provision already stands in the earlier act: this bill amends it, figure for figure */
      const pn = 4 + pi, PP = lxParams("lx:" + prior.title + ":" + pi), old = (f ? f(PP, X) : lxGeneric(cl, X))[1], diffs = [];
      r[1].forEach((t, j) => { if(old[j] && old[j] !== t){ const a = (old[j].match(/(\d+(?:[.,]\d+)?(?:\s*(?:per cent|feet|years?|months?|days?|guns|acres|stuivers|questions|nurses|directors|times))?|ƒ\d+(?:\.\d+)?[km]?)/g) || []), b = (t.match(/(\d+(?:[.,]\d+)?(?:\s*(?:per cent|feet|years?|months?|days?|guns|acres|stuivers|questions|nurses|directors|times))?|ƒ\d+(?:\.\d+)?[km]?)/g) || []);
          const ks = a.map((v, i2) => b[i2] && b[i2] !== v ? i2 : -1).filter(i2 => i2 >= 0); if(ks.length) diffs.push("in subsection " + t.slice(0, 3) + ", " + ks.map(k => "by striking “" + a[k] + "” and inserting “" + b[k] + "”").join(", and ")); else diffs.push("by amending subsection " + t.slice(0, 3) + " to read as follows: “" + t + "”"); } });
      ext.amends = {title:prior.title, day:prior.day, sec:pn};
      add("Amendment of section " + pn + " of the " + prior.title + " (" + r[0].toLowerCase() + ")", diffs.length ? ["Section " + pn + " of the " + prior.title + " is amended—"].concat(diffs.map((d, i) => "(" + (i + 1) + ") " + d + (i < diffs.length - 1 ? ";" : "."))) : ["Section " + pn + " of the " + prior.title + " is re-enacted without change, and shall apply also to the matters in this Act."],
        diffs.length ? "The earlier act already does this. This changes its figures: " + r[2].replace(/\.$/, "") + "." : "The earlier act already does this, and this applies it again here.", ext);
    } else add(r[0], r[1], r[2], ext);
  });
  if(prior){ D.cites.push({title:prior.title, day:prior.day, why:"amended"}); }
  /* a court that struck down an earlier act on this subject is answered in the text */
  const lost = (G.cases || []).filter(c => c && c.done && c.lx && c.lx.dom === dom && c.lx.held === "struck" && (c.dday || c.day) <= (src.day || G.day)).slice(-1)[0];
  if(lost){ D.cites.push({case:c2t(lost), why:"answered"}); add("Response to " + c2t(lost), ["(a) Finding.— In " + c2t(lost) + " the high bench held that section " + lost.lx.sec + " of the " + lost.lx.act + " " + LX_TH[lost.lx.th].phrase + ".", "(b) Remedy.— This Act is to be read so as to meet that holding, and nothing in it revives the section the bench struck."], "The last law on this was partly struck down in court; this one says it has been written to survive that ruling.", {k:"resp"}); }
  const cost = src.cost || 0, soft = src.soft ? Math.round(cost * 0.67) : cost;
  add("Authorization of appropriations", cost ? ["(a) In general.— There is authorized to be appropriated " + money(soft) + " to carry out this Act" + (src.soft ? " (reduced by amendment on the floor from " + money(cost) + ")" : "") + ".", "(b) Source.— The sums shall be met from " + (/treasury|tariff|levy/.test(src.pays || "") ? src.pays : /districts that lose the subsidy/.test(src.pays || "") ? "the subsidies now paid to the districts named by the Secretary, which shall cease" : "the general fund") + "."] : ["No money is appropriated by this Act."],
    cost ? "It costs " + money(soft) + ", paid by " + (src.pays || "the general fund") + "." : "It spends nothing.", {k:"approp"});
  add("Administration and enforcement", ["(a) Regulations.— " + X.AGc + " shall make regulations to carry out this Act within " + lxParams("lx:" + src.title + ":adm").n(90, 270, 30) + " days.", "(b) Officers.— " + X.AGc + " may appoint the officers needed to carry it out.", "(c) Penalty.— Whoever knowingly breaks a regulation made under this Act shall be fined, and each day of the breach is a separate offence."], "Who runs it, and what happens to those who break it.", {k:"adm"});
  add("Judicial review", ["(a) Standing.— Any State, and any person aggrieved by an action taken under this Act, may bring an action in the circuit court to set it aside.", "(b) Time.— An action shall be brought within " + lxParams("lx:" + src.title + ":jr").n(60, 180, 30) + " days of the action complained of.", "(c) Constitutionality.— An action that challenges this Act under the Charter shall be heard first by the high bench, which shall advance it on its docket."], "Who can sue over it, how soon, and that a challenge to the Act itself goes straight to the high bench.", {k:"jr"});
  add("Severability", ["If any section of this Act is held invalid, the remainder of the Act, and the application of the section to other persons and circumstances, shall not be affected."], "If a court strikes one section, the rest still stands.", {k:"sev"});
  const landmark = (src.clauses || []).indexOf("the whole of it to take effect in one session, not three") >= 0;
  add("Effective date", [landmark ? "This Act takes effect on enactment, subject to section " + (S.findIndex(s => s.clause === "the whole of it to take effect in one session, not three") + 1) + "." : "This Act takes effect " + ["on enactment.", "ninety days after enactment.", "on the first day of the next fiscal year."][seedOf(src.title) % 3]], "When it starts to apply to anyone.", {k:"eff"});
  judged.forEach(n => { const s = S.find(x => x.n === n); if(s) s.struckCourt = src.lxStruck; });
  LX.docs.set(lxKey(src), {key, doc:D}); return D;
}
function c2t(c){ return c.t; }
/* the theories a section can be challenged on, how a justice weighs them (axis and sign of the lean that favours striking), and the words of the holding */
const LX_TH = {
  takings:{t:"takings", phrase:"takes private property for public use without just compensation", ax:"econ", sg:1, up:"The compensation section answers the claim: the owner is paid what the land is worth, and that is all the Charter asks."},
  dueprocess:{t:"due process", phrase:"deprives persons of liberty without due process of law", ax:"lib", sg:1, up:"A hearing is provided, and the Charter asks for a fair procedure, not for none at all."},
  press:{t:"freedom of the press", phrase:"abridges the freedom of the press", ax:"lib", sg:1, up:"The section reaches only what is knowingly false or plainly commercial, and the press was never free to do that."},
  states:{t:"the reserved powers of the States", phrase:"commandeers the governments of the States in matters the Charter leaves to them", ax:"econ", sg:1, up:"The Union acts on its own officers and its own money; it does not order a State's legislature to do anything."},
  spending:{t:"conditions on federal money", phrase:"attaches a condition to federal money so coercive that the States have no real choice", ax:"econ", sg:1, up:"A State that does not want the condition may decline the money; an offer is not a command."},
  separation:{t:"the separation of powers", phrase:"trespasses on the independence of the judicial power", ax:"lib", sg:1, up:"Congress may make the courts and set their size; that is what the Charter gives it to do."},
  contract:{t:"liberty of contract", phrase:"interferes with the liberty of contract beyond any public need", ax:"econ", sg:1, up:"The rule serves the safety and fair dealing of the public, and contracts are made subject to such rules."},
  uniformity:{t:"uniformity of duties", phrase:"lays duties that are not uniform throughout the Union", ax:"econ", sg:1, up:"The duty is the same at every port; a rebate for what a port carries is not a different duty."},
  delegation:{t:"delegation of the legislative power", phrase:"hands the legislative power to an officer of the Executive without a rule to guide it", ax:"econ", sg:1, up:"The Act sets the limits within which the officer may move; filling in figures within them is not making law."},
  servitude:{t:"compelled labour", phrase:"compels personal labour without consent", ax:"lib", sg:1, up:"The Republic may call on its people for public work in a time of need, at a fair wage and for a fixed term."},
  equal:{t:"equal treatment of the States", phrase:"singles out some States for burdens or favours the others do not share", ax:"lib", sg:1, up:"Congress may spend where the need is, and need is not the same everywhere."},
  preempt:{t:"the limits of federal power", phrase:"voids state law beyond the powers the Charter gives the Union", ax:"econ", sg:1, up:"Where Congress may make the rule, its rule is the law of the land and a State's contrary law must give way."}
};
/* ── where an act stands: the House, the President, the override, the bench ── */
function lxAct(s){ return (G.lastActs || []).find(a => a.title === s.title && Math.abs((a.day || 0) - (s.day || 0)) <= 1) || null; }
function lxStore(){ if(!G.lx || G.lx.v !== 1) G.lx = {v:1, init:false, n:0}; return G.lx; }
function lxStatus(s){
  const out = [], cnt = s.aye != null && s.no != null ? s.aye + " to " + s.no : "without a recorded count";
  if(s.fate === "rejected"){ out.push("Failed in the House, " + cnt + ", on day " + s.day + "."); return {t:out.join(" "), k:"failed", force:false}; }
  out.push("Passed the House, " + cnt + ", on day " + s.day + ".");
  if(s.fate === "struck down"){ out.push("Struck down by the court before it took effect."); return {t:out.join(" "), k:"struck", force:false}; }
  if(s.veto){ out.push(s.veto.override ? "Vetoed by " + s.veto.by + "; the House overrode the veto." : "Vetoed by " + s.veto.by + "."); }
  if(s.exec){ out.push(s.exec.act === "signed" ? "Signed by " + s.exec.by + (s.exec.d ? " on day " + s.exec.d : "") + "."
      : s.exec.act === "lapsed" ? "Became law without the signature of " + s.exec.by + " on day " + s.exec.d + ", ten days after Congress presented it."
      : s.exec.act === "pocket" ? "Pocket-vetoed: " + s.exec.by + " held it unsigned when the Congress ended on day " + s.exec.d + ", and it died."
      : "Vetoed by " + s.exec.by + (s.exec.d ? " on day " + s.exec.d : "") + "."); }
  if(s.ovr && s.ovr.none) out.push(s.ovr.pocket ? "A pocket veto cannot be overridden." : "No override was attempted.");
  else if(s.ovr && s.ovr.done) out.push(s.ovr.ok ? "The House overrode the veto, " + s.ovr.aye + " to " + s.ovr.no + " (two thirds was " + s.ovr.need + ")." : "The House failed to override, " + s.ovr.aye + " to " + s.ovr.no + "; two thirds was " + s.ovr.need + ". The veto stands.");
  else if(s.ovr) out.push("The veto goes back to the House; it votes on an override on day " + s.ovr.due + ", and needs two thirds.");
  const a = lxAct(s), pending = s.fate === "carried" && !s.exec && !s.veto && a && !a.signed && !a.vetoed && G.exec && G.exec.you;
  if(pending) out.push("Awaiting the President's signature: " + Math.max(0, 10 - (G.day - (a.day || G.day))) + " days left before it becomes law without one.");
  let k = s.fate === "vetoed" ? "vetoed" : pending ? "pending" : "law";
  if(s.lxStruck){ const ss = s.lxStruck; out.push(ss.whole ? "Held invalid as a whole in " + ss.cases.join(", ") + "." : "Section" + (ss.secs.length > 1 ? "s " : " ") + ss.secs.join(", ") + " held invalid in " + ss.cases.join(", ") + "; the rest stands."); if(ss.whole) k = "struck"; }
  const later = (G.statute || []).filter(x => x !== s && x.fate === "carried" && (x.day || 0) > (s.day || 0)).filter(x => { const d = lxDoc(x); return d && d.prior === s; });
  if(later.length) out.push("Amended by the " + later.map(x => x.title).join(", the ") + ".");
  return {t:out.join(" "), k, force:k === "law", later};
}
/* the clerk's book, the President's pen, the House's answer to a veto */
function lxSync(){
  if(!G || !G.you || !G.statute) return; const L = lxStore(), first = !L.init;
  (G.lastActs || []).forEach(a => { const s = (G.statute || []).find(x => x.title === a.title && Math.abs((x.day || 0) - (a.day || 0)) <= 1); if(!s) return;
    const by = G.exec && G.exec.you ? (execTitleSafe() + " " + G.you.name) : (G.exec && G.exec.name) || "the President";
    if(a.signed && !s.exec) s.exec = {act:"signed", by, d:first ? null : G.day};
    if(a.vetoed && (!s.exec || (s.exec.act !== "vetoed" && s.exec.act !== "pocket"))){ s.exec = {act:"vetoed", by, d:first && !a.vetoD ? null : G.day}; if(s.fate === "carried") s.fate = "vetoed";
      if(!s.ovr && first && G.day - (s.day || 0) > 10){ s.ovr = {done:true, ok:false, none:true}; }
      if(!s.ovr){ s.ovr = {due:G.day + 1, done:false}; try{ feed("The veto of the " + s.title + " goes back to the House with the President's message. It votes on an override on day " + s.ovr.due + "; it needs two thirds.", "news"); }catch(e){} } } });
  L.init = true;
  (G.statute || []).forEach(s => { if(s.ovr && !s.ovr.done && G.day >= s.ovr.due) lxOverride(s); });
}
function execTitleSafe(){ try{ return execTitle(); }catch(e){ return "President"; } }
function lxOverride(s){
  const a = lxAct(s) || {}, pos = a.pos || s.pos; if(!pos){ s.ovr.done = true; s.ovr.ok = false; s.ovr.aye = s.aye; s.ovr.no = s.no; s.ovr.need = Math.ceil((s.aye + s.no) * 2 / 3); return; }
  const pseudo = {id:"ovr:" + s.title, title:s.title, pos:Object.assign({}, pos), sponsor:s.sponsor, sponsorParty:s.sponsorParty || null, domain:lxDomainOf(s), done:false, clauses:s.clauses || []};
  const yv = G.you.vote, pl = (G.members || []).map(m => [m, m.pledge, m.pledgeDay]); let t = null;
  try{ G.you.vote = -1; (G.members || []).forEach(m => { m.pledge = null; }); t = tallyBill(pseudo, false); }catch(e){ t = null; }
  finally{ G.you.vote = yv; pl.forEach(([m, p, d]) => { m.pledge = p; m.pledgeDay = d; }); }
  if(!t){ s.ovr.done = true; return; }
  const need = Math.ceil((t.aye + t.no) * 2 / 3), ok = t.aye >= need;
  Object.assign(s.ovr, {done:true, d:G.day, aye:t.aye, no:t.no, need, ok, v:t.roll || null});
  if(ok){ s.fate = "carried"; s.overridden = true; G.you.standing = clamp((G.you.standing || 0) - 6, 0, 100); G.you.influence = clamp((G.you.influence || 0) - 4, 0, 100); }
  else { G.you.influence = clamp((G.you.influence || 0) + 2, 0, 100); }
  try{ const line = ok ? "The House overrides the veto of the " + s.title + ", " + t.aye + " to " + t.no + " (two thirds was " + need + "). It is law without the President's signature." : "The House fails to override the veto of the " + s.title + ": " + t.aye + " to " + t.no + ", short of the " + need + " it needed. The veto stands.";
    note(line, true); journal(line); pushWireScrap("Floor", s.title + " — override " + (ok ? "CARRIED" : "FAILS") + " " + t.aye + "–" + t.no); }catch(e){}
}
/* ── the courts: suits against the sections open to challenge, decided justice by justice ── */
function lxPlaintiff(s, cl, D){
  const kind = cl.claim[1];
  if(kind === "group") return {name:cl.claim[3], state:null, pk:"group"};
  if(kind === "member"){ const m = (G.members || []).filter(x => x && !x.gone).sort((u, v) => (alignment(u, {pos:s.pos || {econ:0, lib:0, def:0, wel:0}}) || 0) - (alignment(v, {pos:s.pos || {econ:0, lib:0, def:0, wel:0}}) || 0))[0]; return m ? {name:m.name, state:m.state, pk:"member", id:m.id} : null; }
  if(kind === "person"){ const st = s.state || pick(knStates()); let nm = "A citizen"; try{ nm = newName(st); }catch(e){} return {name:nm, state:st, pk:"person", who:cl.claim[3]}; }
  /* a State: the one the act is aimed at, or the one that likes it least; never the State it favours, on a claim of favour */
  const pos = s.pos || (lxAct(s) || {}).pos || {econ:0, lib:0, def:0, wel:0}; let cand = (G.states || []).slice();
  if(cl.claim[0] === "equal" && s.state) cand = cand.filter(x => x.n !== s.state);
  const tgt = s.target && cl.claim[0] !== "equal" ? cand.find(x => x.n === s.target) : null;
  const low = cand.sort((u, v) => dkStateLean(u, {pos}) - dkStateLean(v, {pos})).slice(0, 4), S2 = tgt || low[Math.floor(Math.random() * low.length)]; return S2 ? {name:S2.n, state:S2.n, pk:"state"} : null;
}
function lxSue(s){
  const D = lxDoc(s); if(!D) return 0; let n = 0;
  const ops = D.secs.filter(x => x.k === "op" && x.claim && !x.struckAmend).sort((u, v) => v.claim[2] - u.claim[2]);
  for(const x of ops){ if(n >= 2) break; if(Math.random() > x.claim[2] * 0.8) continue;
    const P = lxPlaintiff(s, x, D); if(!P) continue; const t = P.name + " v. the Union (" + s.title + ")"; if((G.cases || []).some(c => c.t === t)) continue;
    G.cases = G.cases || []; G.cases.push({t, state:P.state || "", day:G.day, voted:[], lx:{act:s.title, aday:s.day, sec:x.n, head:x.short || x.head, th:x.claim[0], str:x.claim[2], plaintiff:P.name, pk:P.pk, who:P.who || null, dom:D.dom}});
    n++; try{ feed((P.pk === "state" ? "The attorney general of " + P.name + " has" : P.name + (P.who ? ", " + P.who + "," : "") + " has") + " sued to strike section " + x.n + " of the " + s.title + " (" + x.head.toLowerCase() + "), saying it " + LX_TH[x.claim[0]].phrase + ".", "news"); }catch(e){} }
  return n;
}
/* a case filed by the old paths, on an act it names, is read against that act's own sections */
function lxEnrich(c){
  if(!c || c.lx || c.dual != null) return; const m = /\(([^()]+)\)\s*$/.exec(c.t || ""); if(!m) return;
  const s = (G.statute || []).find(x => x.title === m[1]) || (G.statute || []).find(x => m[1].indexOf(x.title) >= 0); if(!s) return; const D = lxDoc(s); if(!D) return;
  const want = c.state ? ["states", "spending", "preempt", "equal", "uniformity"] : null;
  const x = D.secs.filter(y => y.k === "op" && y.claim && (!want || want.indexOf(y.claim[0]) >= 0)).sort((u, v) => v.claim[2] - u.claim[2])[0] || D.secs.find(y => y.k === "op");
  if(!x) return; const th = x.claim ? x.claim[0] : "states";
  c.lx = {act:s.title, aday:s.day, sec:x.n, head:x.short || x.head, th, str:x.claim ? x.claim[2] : 0.35, plaintiff:(c.t.split(" v. ")[0] || c.state || "the plaintiff"), pk:c.state ? "state" : "group", dom:D.dom};
}
function lxBench(){ const J = (G.court && G.court.length ? G.court : []).filter(j => j && j.name && !(G.you && j.name === G.you.name)); return J; }
function lxDecide(c, youVote){
  const L = c.lx, T = LX_TH[L.th] || LX_TH.states, J = lxBench(); if(!J.length && youVote == null) return null;
  const prior = (G.cases || []).filter(x => x !== c && x.done && x.lx && x.lx.th === L.th && x.lx.held).sort((u, v) => (v.dday || v.day) - (u.dday || u.day))[0];
  const prec = prior ? (prior.lx.held === "struck" ? 0.18 : -0.18) : 0;
  const votes = J.map((j, i) => { const lean = clamp(((j.pos && j.pos[T.ax]) || 0) * T.sg / 60, -1, 1), noise = (knH(j.name, c.t) - 0.5) * 0.3;
    const sc = (L.str - 0.45) * 1.6 + lean * 0.7 + prec + noise; return {name:j.name, strike:sc > 0, chief:i === 0}; });
  if(youVote != null) votes.push({name:G.you.name, strike:!youVote, you:true});
  const st = votes.filter(v => v.strike), up = votes.filter(v => !v.strike), struck = st.length > up.length, maj = struck ? st : up, min = struck ? up : st;
  const pickOf = (L, k) => { const nv = L.filter(v => !v.you); return nv.length ? nv[Math.floor(knH(c.t, k) * nv.length)] : L[0]; };
  const author = (maj.some(v => v.chief) && knH(c.t, "chief") < 0.35) ? maj.find(v => v.chief) : pickOf(maj, "auth"), diss = min.length ? pickOf(min, "diss") : null;
  const s = (G.statute || []).find(x => x.title === L.act && (L.aday == null || Math.abs((x.day || 0) - L.aday) <= 1));
  const op = (author.you ? "You wrote for the Court" : "Justice " + author.name + " wrote for the Court") + ": " + (struck ? "Section " + L.sec + " of the " + L.act + " (" + String(L.head).toLowerCase() + ") " + T.phrase + ", and is invalid." + (prior && prior.lx.held === "struck" ? " We said as much in " + prior.t + "." : "") + " Under the Act's own severability section the rest of it stands."
    : "The challenge to section " + L.sec + " of the " + L.act + " fails. " + T.up + (prior && prior.lx.held === "upheld" ? " We held the same in " + prior.t + "." : prior ? " We do not read " + prior.t + " to require otherwise." : ""));
  const dis = diss ? (diss.you ? " You dissented." : " Justice " + diss.name + " dissented: " + (struck ? T.up : "the section " + T.phrase + ", and the Court should have said so.")) : "";
  c.done = true; c.dday = G.day; c.ruled = struck ? (c.state ? "state" : "plaintiff") : "union";
  Object.assign(L, {held:struck ? "struck" : "upheld", count:maj.length + "–" + min.length, op:op + dis, author:author.name});
  if(struck && s){ const ss = s.lxStruck = s.lxStruck || {secs:[], cases:[], whole:false}; if(ss.secs.indexOf(L.sec) < 0) ss.secs.push(L.sec); if(ss.cases.indexOf(c.t) < 0) ss.cases.push(c.t);
    const D = lxDoc(s), nOps = D ? D.secs.filter(x => x.k === "op").length : 3; ss.whole = ss.secs.length * 2 > nOps; LX.docs.delete(lxKey(s)); }
  try{ const S = (G.states || []).find(x => x.n === c.state); if(S) S.unrest = clamp((S.unrest || 0) + (struck ? -3 : 4), 0, 100); }catch(e){}
  try{ feed("The high bench, " + maj.length + " to " + min.length + ", " + (struck ? "strikes section " + L.sec + " of the " + L.act : "upholds section " + L.sec + " of the " + L.act) + " in " + c.t + ".", struck ? "news" : "news"); journal("Court: " + c.t + " — " + (struck ? "section " + L.sec + " struck" : "upheld") + ", " + maj.length + "–" + min.length + "."); }catch(e){}
  return {struck, count:L.count, op:L.op};
}
function lxDay(){
  if(!G || !G.you) return; lxSync();
  (G.cases || []).forEach(lxEnrich);
  (G.statute || []).forEach(s => { if(s.lxSued || s.fate !== "carried" || G.day - (s.day || 0) > 30 || G.day - (s.day || 0) < 1) return; const st = lxStatus(s); if(st.k !== "law") return; s.lxSued = G.day; lxSue(s); });
}
/* ── reading it ── */
function lxSecHTML(D, x){
  const strikeA = x.struckAmend, court = x.struckCourt;
  return '<div class="lx-sec" style="margin:10px 0;' + (strikeA ? "opacity:.55;" : "") + '"><div style="font:600 14px Georgia,serif"><span style="color:#7a5a12">Sec. ' + x.n + '.</span> ' + pcEsc(x.head) + '.</div>' +
    x.sub.map(t => '<div style="margin:3px 0 0 14px;' + (strikeA ? 'text-decoration:line-through;' : '') + '">' + pcEsc(t) + '</div>').join("") +
    (x.amends ? '<div style="margin:4px 0 0 14px"><button type="button" class="btn btn--ghost" style="padding:2px 8px;font-size:12px" data-lxopen="' + pcEsc(x.amends.day + ":" + x.amends.title) + '">Read the ' + pcEsc(x.amends.title) + ' ▸</button></div>' : '') +
    (strikeA ? '<div class="muted" style="margin:3px 0 0 14px;font-size:12px">Struck on the floor before passage.</div>' : '') +
    (court ? '<div style="margin:3px 0 0 14px;font-size:12px;color:#8a1d1d">Held invalid in ' + pcEsc(court.cases.join(", ")) + '. Not in force.</div>' : '') +
    '<div class="muted" style="margin:3px 0 0 14px;font-size:12px"><i>In plain words:</i> ' + pcEsc(x.plain) + '</div></div>';
}
function lxDocHTML(D){
  return '<div class="lx-doc" style="background:#fffdf6;color:#1d1d1d;border:1px solid #cdbf9a;border-radius:6px;padding:14px 16px;font:14px/1.45 Georgia,serif">' +
    '<div style="text-align:center;font:12px system-ui;letter-spacing:.08em;color:#6b5a2e">' + pcEsc(D.congress.toUpperCase()) + ' CONGRESS · ' + pcEsc(D.no) + '</div>' +
    '<div style="text-align:center;font:700 18px Georgia,serif;margin:6px 0">AN ACT</div><div style="text-align:center;font-style:italic">' + pcEsc(D.longTitle) + '</div>' +
    '<p style="margin:12px 0 4px"><i>' + pcEsc(D.enact) + '</i></p>' + D.secs.map(x => lxSecHTML(D, x)).join("") + '</div>';
}
function lxHistHTML(s){
  const st = lxStatus(s), rows = [];
  rows.push("Filed by " + (s.sponsor || "the leadership") + (s.state ? ", out of " + s.state : "") + ".");
  if(s.aye != null) rows.push("House roll call, day " + s.day + ": " + s.aye + " aye, " + s.no + " no" + (s.yv ? " (you voted " + (s.yv > 0 ? "aye" : "no") + ")" : "") + ".");
  if(s.v){ const ay = [], no = [], P = Object.keys(s.v).map(id => knPerson(id)).filter(Boolean), cnt = {}; P.forEach(m => { const k = surname(m.name); cnt[k] = (cnt[k] || 0) + 1; });
    const ab = []; Object.keys(s.v).forEach(id => { const m = knPerson(id); if(m) (s.v[id] > 0 ? ay : s.v[id] < 0 ? no : ab).push(cnt[surname(m.name)] > 1 ? m.name : surname(m.name)); }); rows.push("On the roll by name — aye: " + (ay.join(", ") || "none") + "; no: " + (no.join(", ") || "none") + (ab.length ? "; not voting: " + ab.join(", ") : "") + ". The other seats were counted by party."); }
  else rows.push("The clerk did not keep the names on the roll for this one; only the count is recorded.");
  const cs = (G.cases || []).filter(c => c.lx && c.lx.act === s.title);
  return '<div class="eyebrow" style="margin-top:12px">Where it stands</div><p>' + pcEsc(st.t) + '</p>' +
    '<div class="eyebrow" style="margin-top:8px">Legislative history</div><ul style="margin:4px 0 0 18px">' + rows.map(r => '<li>' + pcEsc(r) + '</li>').join("") + '</ul>' +
    (cs.length ? '<div class="eyebrow" style="margin-top:8px">In the courts</div>' + cs.map(c => '<div style="margin:6px 0;padding:6px 10px;border-left:3px solid ' + (c.lx.held === "struck" ? "#a33" : c.lx.held ? "#3a7" : "#c9a24a") + '"><b>' + pcEsc(c.t) + '</b> <span class="muted">· filed day ' + c.day + ' · challenges section ' + c.lx.sec + ' (' + pcEsc(String(c.lx.head).toLowerCase()) + ') on ' + pcEsc(LX_TH[c.lx.th].t) + '</span>' +
      (c.lx.held ? '<div style="font-size:13px;margin-top:3px">Decided day ' + (c.dday || "?") + ', ' + pcEsc(c.lx.count) + ': ' + pcEsc(c.lx.op) + '</div>' : '<div class="muted" style="font-size:13px">Pending before the high bench.</div>') + '</div>').join("") : "") +
    (st.later.length ? '<div class="eyebrow" style="margin-top:8px">Amended by</div>' + st.later.map(x => '<button type="button" class="btn btn--ghost" style="margin:2px" data-lxopen="' + pcEsc(lxKey(x)) + '">' + pcEsc(x.title) + ' ▸</button>').join("") : "");
}
function lxFind(key){ if(key === "cal") return G.bill || null; const i = String(key).indexOf(":"), d = String(key).slice(0, i), t = String(key).slice(i + 1); return (G.statute || []).find(s => s.title === t && String(s.day) === d) || (G.statute || []).find(s => s.title === t) || (G.bill && G.bill.title === t ? G.bill : null); }
let lxWasRunning = null;
function lxShut(){ const V = document.getElementById("lxVeil"); if(!V || V.hidden) return; V.hidden = true; G.running = lxWasRunning === null ? G.running : lxWasRunning; lxWasRunning = null; }
function lxOpen(h){
  let V = document.getElementById("lxVeil"); if(!V){ V = document.createElement("div"); V.id = "lxVeil"; V.className = "veil"; V.style.zIndex = "10060"; V.hidden = true; V.innerHTML = '<div class="card lx-card" id="lxCardEl" style="width:min(820px,100%)"></div>'; document.body.appendChild(V);
    V.addEventListener("click", e => { if(e.target === V) lxShut(); }); document.addEventListener("keydown", e => { if(e.key === "Escape" && !V.hidden){ e.preventDefault(); e.stopImmediatePropagation(); lxShut(); } }, true); }
  if(V.hidden){ lxWasRunning = G.running; } G.running = false; const C = V.firstChild; C.innerHTML = h; V.hidden = false; V.scrollTop = 0; C.scrollTop = 0;
  const c = C.querySelector("#lxClose"); if(c) c.onclick = () => lxShut(); }
function lxCard(ref){
  const s = typeof ref === "string" ? lxFind(ref) : ref; const D = s ? lxDoc(s) : null;
  if(!D){ lxOpen('<h1>Not in the book</h1><p class="muted">The clerk has no text for that.</p><div class="card__actions"><button type="button" class="btn btn--ghost" data-lxbook="all">The statute book</button><button type="button" class="btn btn--ghost" id="lxClose">Close</button></div>'); return; }
  const live = s === G.bill;
  lxOpen('<div class="eyebrow">' + (live ? "On the calendar · roll call day " + (s.voteDay || "?") : "The statute book") + '</div><h1>' + pcEsc(s.title) + '</h1>' +
    (live ? '<p class="muted">Before the House. Sponsored by ' + pcEsc(youMark(s.sponsor || "the leadership")) + (s.state ? ', out of ' + pcEsc(s.state) : '') + '.' + (D.prior ? ' It amends the ' + pcEsc(D.prior.title) + ', which is in force.' : '') + '</p>' : lxHistHTML(s)) +
    '<div class="eyebrow" style="margin-top:12px">The text</div>' + lxDocHTML(D) +
