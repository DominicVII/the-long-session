/* ══ 20261025h · ONE PLACE FOR A MEETING. A cabinet, a council, a briefing, the press room, the floor or any step-by-step
   sitting is run from one panel at the top right and nowhere else: the session view, the floor desk (who is next, raise
   your hand, speak) and the sitting's own card all sit in that one frame, under one header with one Hide, the world stays
   in view, and what is said in the meeting is written into it. ══ */
const SXD = {min:false, log:[], key:"", seen:0, home:null};
(function(){ const st = document.createElement("style"); st.id = "sxDockCss"; const P = "#sxDock>#veil.sitx";
  st.textContent = "#sxDock{position:fixed;right:8px;top:84px;z-index:62;width:min(460px,calc(100vw - 16px));max-height:calc(100vh - 160px);overflow:auto;background:#121419;border:2px solid #c9a24a;border-radius:8px;box-shadow:0 6px 24px #000;display:flex;flex-direction:column}" +
    "#sxDock>#ndSess{position:static !important;width:auto !important;max-width:none !important;max-height:none !important;border:0 !important;border-radius:0 !important;box-shadow:none !important;overflow:visible !important;flex:none}" +
