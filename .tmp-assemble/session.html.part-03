  function clearDrafts(){ ["tkOwnIn", "wireIn"].forEach(id => { try{ const i = document.getElementById(id); if(i){ i.value = ""; try{ i.dispatchEvent(new Event("input")); }catch(e){} } }catch(e){} }); }
