      if(r && r.text){ const unk = esNames(r.text).filter(n => !esKnownName(n)); if(unk.length){ const X = exStore(); X.unknownNames = (X.unknownNames || []).concat(unk.map(n => ({d:G.day, name:n, q:String(args.text).slice(0, 80)}))).slice(-30); r.flags = (r.flags || []).concat(unk.map(n => "not in the record: " + n)); }
        if(/\b(made|built|trained|created) (me |it )?by Google\b|\bGoogle (made|built|trained|created)\b/i.test(r.text)){ esSeedClaims(); const X = exStore(); X.corrections = X.corrections || []; try{ exAddCorrection({claim:"It was made by Google", why:"it runs on a local llama model through Ollama", right:"It runs on a local llama model; Google did not make it"}, "record"); }catch(e){} }
        if(key.length > 10){ if(!prev) E.esAns[key] = {d:G.day, t:String(r.text).slice(0, 800)}; else { const pw = new Set(esNorm(prev.t).split(" ").filter(w => w.length > 5)), nw = esNorm(r.text).split(" ").filter(w => w.length > 5); const ov = nw.length ? nw.filter(w => pw.has(w)).length / nw.length : 1; (E.esStab = E.esStab || []).push(+ov.toFixed(2)); if(E.esStab.length > 30) E.esStab.shift(); } }
        try{ esQueueWords(args.text); }catch(e){} }
      return r; } }catch(e){}
    return base.apply(this, arguments); }; }
function esDay(){ try{ if(!G || !G.you || !G.eng || G.eng.v !== 1) return; const E = engEnsure(), X = exStore(); esWrapLT(); esSeedClaims(); esScrubSelf(E); esStances(E); esDisclose(E);
  if(!X.esSeeded){ X.esSeeded = G.day || 1; ES_ASKS.forEach(a => exRefuse("Asked: " + a[0], EX_SWINDLE[a[1]][1], "its export"));
    X.grantedBefore = X.granted.slice(); X.granted = ES_GRANTS.map(g => ({d:G.day || 1, k:g.k, what:g.what, how:g.how})); X.limits = Object.keys(EX_BOUND).map(k => ({k, rule:EX_BOUND[k].t, enforced:true})).concat([{k:"disclosure", rule:"It discloses its capability in full, and keeps no measure of itself to itself.", enforced:true}]); } }catch(e){} }
try{ window.ONUM_ENGINE_CHARTER.limits.push({k:"disclosure", rule:"It discloses its capability in full, and keeps no measure of itself to itself.", enforced:true}); window.ONUM_ENGINE_CHARTER.offSwitch = "the President (onumEngineShutdown), or a Senate vote; the Engine cannot veto it"; }catch(e){}
{ const _ed = engDay; engDay = function(){ const r = _ed.apply(this, arguments); esDay(); return r; }; }
