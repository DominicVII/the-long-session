/* ══ 20261027c · MANY BILLS, FEW LAWS. Members file bills most days; each is referred to its committee, which marks it up when
   its chair schedules it, and either reports it to the House or lets it die there (an unfavourable report, or no markup within
   about four weeks). When the floor is free, the oldest bill reported favourably comes up; your own filed bills keep their place
   ahead of the rest. The press corps is eight reporters from different papers, and the retired officials the ledger no longer
   names fade from the cast. ══ */
function hopStore(){ if(!Array.isArray(G.hopper)) G.hopper = []; return G.hopper; }
function hopFile(){
  const keep = new Map((G.members || []).map(m => [m, m.sway])); let b = null;
  try{ b = makeBill(); }catch(e){ b = null; }
  keep.forEach((v, m) => { m.sway = v; });   /* a bill filed in the hopper does not reset the argument on the floor */
  if(!b) return null; b.filed = G.day; b.voteDay = null; b.hop = true; lxRoad(b);
  if(b.road){ b.road.mark = G.day + 3 + (seedOf(b.title + G.day) % 10); b.road.ref = G.day; }
  hopStore().push(b); return b;
}
function hopDay(){
  const H = hopStore(), r = knH("hop", String(G.day)), n = r < 0.15 ? 2 : r < 0.75 ? 1 : 0;
  for(let i = 0; i < n && H.length < 12; i++){ const b = hopFile(); if(b) try{ journal("Filed: the " + b.title + " (" + b.sponsor + "), referred to the Committee on " + (b.road ? b.road.t : "the whole House") + "."); }catch(e){} }
  const L = lxStore(); L.died = L.died || [];
  for(let i = H.length - 1; i >= 0; i--){ const b = H[i], R = b.road; if(!R || b.reported) continue;
    if(!R.done && G.day >= R.mark){ lxMarkup(b, true); }
    if(R.done && !R.report.fav){ H.splice(i, 1); L.died.unshift({t:b.title, d:G.day, cmte:R.t, why:"reported unfavourably, " + R.report.aye + " to " + R.report.no, sponsor:b.sponsor}); continue; }
    if(R.done && R.report.fav){ b.reported = G.day; continue; }
    if(G.day - (b.filed || G.day) > 25){ H.splice(i, 1); L.died.unshift({t:b.title, d:G.day, cmte:R.t, why:"never scheduled for markup", sponsor:b.sponsor}); } }
  if(L.died.length > onumLim(40,"hist")) L.died.length = onumLim(40,"hist");
}
