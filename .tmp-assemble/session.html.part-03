      return D.secs.map(x => '<li' + (x.struckAmend ? ' style="text-decoration:line-through;opacity:.6"' : '') + '><b>Sec. ' + x.n + '. ' + pcEsc(x.head) + '.</b> ' + pcEsc(x.sub.join(" ")) + '<br><span class="muted" style="font-size:12px">' + pcEsc(x.plain) + '</span>' +
