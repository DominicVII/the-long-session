        mb.textContent = TR.moreOpen ? "Less \u25B4" : "More \u25BE (" + extra.length + ")"; mb.title = TR.moreOpen ? "Hide the other things you can do" : "Other things you can do here";
        mb.onclick = ev => { try{ ev.preventDefault(); ev.stopPropagation(); }catch(x){} TR.moreOpen = !TR.moreOpen; decorate(); try{ picksDirty = true; }catch(e){} };
        row.appendChild(mb); const top = document.getElementById("tkTop"); if(top) top.insertBefore(row, top.firstChild); else box.insertBefore(row, box.firstChild); }
      T.classList.toggle("tk-more", !!TR.moreOpen && extra.length > 0); } }catch(e){}
    try{ fitTalk(); }catch(e){}
    try{ picksDirty = true; }catch(e){}
  }
  TR.decorate = decorate;
  /* 20261030g: the open talk panel ends above the Say aloud bar (hmBar), so its actions are never under it */
  function fitTalk(){ const T = el("talk"); if(!T) return; if(!T.classList.contains("is-open")){ T.style.removeProperty("bottom"); return; }
    T.style.removeProperty("bottom"); const tr = T.getBoundingClientRect(); let top = Infinity;
    /* the Say aloud bar and any fixed strip docked along the bottom (the wire) */
    [document.getElementById("hmBar"), ...document.querySelectorAll("body > *")].forEach(e => { try{ if(!e || e === T || T.contains(e) || e.contains(T) || e.hidden) return; const cs = getComputedStyle(e); if(cs.display === "none" || cs.visibility === "hidden" || cs.position !== "fixed") return;
      const r = e.getBoundingClientRect(); if(r.height > 0 && r.height < 90 && r.width > innerWidth * 0.5 && r.top > innerHeight * 0.75) top = Math.min(top, r.top); }catch(x){} });
    if(!isFinite(top)) return; const ov = Math.ceil(tr.bottom - top + 6);
    if(ov > 0) T.style.setProperty("bottom", ov + "px", "important"); }
  TR.fitTalk = fitTalk; addEventListener("resize", () => { try{ fitTalk(); }catch(e){} });
  { const _rt = renderTalk; renderTalk = function(){ const r = _rt.apply(this, arguments); try{ if(TALK.open) decorate(); }catch(e){} return r; }; }
  /* Esc in the in-talk wire closes like Esc anywhere else; Enter (not typing) puts you in the reply box */
  /* 20261030g: one Esc closes the talk, even with the reply box or the wire focused. Capture phase, only while talk is open and no
     modal card (veil) is over it; when talk is closed Esc is untouched for every other panel. */
  addEventListener("keydown", e => { try{ if(e.key !== "Escape" || !TALK.open) return;
      if(typeof veil !== "undefined" && veil && !veil.hidden && !veil.classList.contains("sitx")) return;
      const t = el("talk"); if(!t || !t.classList.contains("is-open")) return;
      e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
      try{ const a = document.activeElement; if(a && a !== document.body && a.blur) a.blur(); }catch(x){}
      closeTalk(); }catch(x){} }, true);
  addEventListener("keydown", e => { try{ if(e.key !== "Enter" || e.ctrlKey || e.metaKey || e.altKey || !TALK.open || typingInField(e)) return; if(typeof veil !== "undefined" && !veil.hidden) return; const i = el("tkOwnIn"); if(i && !el("tkOwn").hidden){ e.preventDefault(); i.focus(); } }catch(x){} });
  /* ghost-state watchdog: the flag and the panel always agree */
  setInterval(() => { try{ const t = el("talk"); if(!t) return; const on = t.classList.contains("is-open");
      if(TALK.open && TALK.prop){ if(!on) t.classList.add("is-open","tk-prop"); } else if(TALK.open && (!on || !TALK.m || TALK.m.gone)) closeTalk(); else if(!TALK.open && on) closeTalk(); }catch(e){} }, 1000);
  /* ---- the floor desk: Pass / Interject / Raise hand, the chair's call-on row, press hands, Space finishes lines ---- */
  const OSc = (k, ...a) => { try{ const O = window.onumSession; return O && typeof O[k] === "function" ? O[k].apply(O, a) : undefined; }catch(e){ return undefined; } };
  const isMe = x => x === "you" || sv(() => G.you && String(x) === String(G.you.id));
  function deskTick(){ try{
      const D = document.getElementById("ndFd"), dock = document.getElementById("sxDock"); const on = !!(D && !D.hidden && getComputedStyle(D).display !== "none");
      if(dock) dock.classList.toggle("fd-on", on);
      if(dock && on){ try{ const hb = document.getElementById("hmBar"); const hv = hb && !hb.hidden && getComputedStyle(hb).display !== "none"; dock.style.setProperty("--fdB", (hv ? Math.ceil(innerHeight - hb.getBoundingClientRect().top + 6) : 8) + "px"); }catch(e){} }
      if(!on) return;
      const S = window.ONUM_SESSION || {}, body = D.querySelector(".fd-body"); if(!body) return;
      let A = D.querySelector(".fd-acts"); if(!A){ A = document.createElement("div"); A.className = "fd-acts"; /* 20261030h: above the reply box so the band never clips it */ const t0 = body.querySelector("textarea"); if(t0) t0.parentNode.insertBefore(A, t0); else body.insertBefore(A, body.firstChild); }
      /* 20261030j: reply box and Cancel/Speak on one row, so the last controls clear the wire without a dock scroll */
      try{ const t1 = body.querySelector(":scope>textarea"), r1 = body.querySelector(":scope>.fd-row"); if(t1 && r1 && !t1.closest(".fd-reply")){ const w = document.createElement("div"); w.className = "fd-reply"; t1.parentNode.insertBefore(w, t1); w.appendChild(t1); w.appendChild(r1); } }catch(e){}
      const turn = isMe(S.floorId) || isMe(S.offer), chair = S.chairId === "you", fl = S.floorId != null && !isMe(S.floorId), press = /press/.test(String(S.kind || ""));
      const q = (Array.isArray(S.queue) ? S.queue : []).filter(x => !isMe(x));
      if(A.dataset.mt === "1"){ /* the meeting controls own this row */ }
      else {
      const sig = [turn, chair, fl, press, q.join(","), !!S.held].join("|"); if(A.dataset.sig === sig) return; A.dataset.sig = sig;
      const ta = D.querySelector("textarea"), nm = id => { const p = sv(() => byId(isNaN(+id) ? id : +id)); return p && p.name ? String(p.name).split(/\s+/).slice(-1)[0] : String(id); };
      let h = "";
      if(chair) h += '<span class="fd-chair">You chair</span>';
      /* 20261030h: in the chair, Pass / Interject / Call on next are always on the desk (greyed when they do not apply) */
      const OSf = k => typeof (window.onumSession || {})[k] === "function", dis = (ok, why) => ok ? "" : ' disabled title="' + why + '"';
      if(turn || (chair && OSf("pass"))) h += '<button type="button" class="fd-pass"' + (OSf("pass") ? (turn ? ' title="Give up your turn"' : dis(false, "Not your turn")) : dis(false, "Not available")) + '>Pass</button>';
      if(fl || (chair && OSf("interject"))) h += '<button type="button" class="fd-ij"' + (OSf("interject") ? (fl ? ' title="A word from your seat; it never takes the floor"' : dis(false, "Nobody else has the floor")) : dis(false, "Not available")) + '>Interject</button>';
      if(chair && OSf("callon")) h += '<button type="button" class="fd-next1"' + (q.length ? ' title="Give the floor to the next hand"' : dis(false, "No hands up")) + '>Call on next' + (q.length ? ": " + String(nm(q[0])).replace(/[<>&"]/g, "") : "") + '</button>';
      A.innerHTML = h;
      const b1 = A.querySelector(".fd-pass"); if(b1) b1.onclick = () => { if(ta) ta.value = ""; OSc("hold", false); OSc("pass"); };
      const b2 = A.querySelector(".fd-ij"); if(b2) b2.onclick = () => { const t = ta ? ta.value.trim() : ""; const r = OSc("interject", t || "Point of order!", t ? "heckle" : "point_of_order"); if(ta && r && r.ok){ ta.value = ""; OSc("hold", false); }
        try{ window.NEPTUNE_FLOORDESK.line("you", r && r.ok ? (t || "Point of order!") : "(not yet: " + ((r && r.reason) || "the chair did not hear it") + ")", !(r && r.ok)); }catch(e){} };
      const b3 = A.querySelector(".fd-next1"); if(b3) b3.onclick = () => OSc("callon", q[0]);
      /* press conference: raised hands as a pick row; the question waits for you */
      let H = D.querySelector(".fd-hands"); if(press && chair && q.length){ if(!H){ H = document.createElement("div"); H.className = "fd-hands"; A.parentNode.insertBefore(H, A); }
        H.innerHTML = "<b>Hands up</b>" + q.slice(0, 8).map(id => '<button type="button" data-hand="' + String(id).replace(/"/g, "") + '">' + String(nm(id)).replace(/[<>&"]/g, "") + '</button>').join("");
        H.querySelectorAll("[data-hand]").forEach(b => b.onclick = () => { if(OSc("callon", b.getAttribute("data-hand")) === undefined){ try{ console.warn("press: onumSession.callon missing (JUPITER)"); }catch(e){} } }); }
      else if(H) H.remove();
      }
    }catch(e){} }
  setInterval(deskTick, 400);
  /* 20261030g: a "stops you" toast offers no Talk while a sitting/procedure/session owns the conversation (openTalk would refuse it) */
  setInterval(() => { try{ const w = document.getElementById("apToast"); if(!w) return; const b = w.querySelector('[data-ap="talk"]'); if(!b) return;
      const busy = !!window.onumTalkOwner(); if(b.hidden !== busy){ b.hidden = busy; b.style.display = busy ? "none" : ""; } }catch(e){} }, 250); addEventListener("onum-session", () => setTimeout(deskTick, 0));
  addEventListener("keydown", e => { try{ if(e.key !== " " || typingInField(e)) return; const D = document.getElementById("ndFd"); if(!D || D.hidden) return;
      const un = [...D.querySelectorAll(".fd-l")].filter(l => l._full && !l._done && l.querySelector(".t") && l.querySelector(".t").textContent !== l._full); if(!un.length) return;
      e.preventDefault(); e.stopImmediatePropagation(); un.forEach(l => { l._done = true; l.querySelector(".t").textContent = l._full; }); }catch(x){} }, true);
  console.log("NEPTUNE talk rework ready");
}catch(e){ try{ console.warn("NEPTUNE-TALKREWORK", e); }catch(x){} }
/* NEPTUNE-TALKREWORK END */

/* ══ 20261025i · THE ROAD A BILL TRAVELS. A bill is referred to the committee whose field it mostly touches; the committee's
   members offer amendments in markup (to strike the section they mind most, to cut the money) and vote on them and on the
   report, and you vote with them when you sit there. What the House carries goes to the Senate, voted seat by seat in the
   same reckoning the docket shows, the Vice President breaking a tie, before it can reach the President. Acts passed on the
   towns' petitions enter the statute book with the petitions as their text, and the bills before the state legislatures are
   written out as law too. ══ */
const LX_CM_AX = {econ:"ways", lib:"judic", def:"armed", wel:"health"};
function lxNoise(a, b){ return knH(a, b) - 0.5; }
function lxRoad(b){
  if(!b || b.done || !b.title || !b.pos) return null;
  if(b.road) return b.road;
  const ax = ["econ", "lib", "def", "wel"].sort((u, v) => Math.abs(b.pos[v] || 0) - Math.abs(b.pos[u] || 0))[0];
  const k = (b.domain && lxCmDom(b.domain)) || (b.kind === "immig" ? "judic" : null) || LX_CM_AX[ax] || "ways", c = COMMITTEES.find(x => x.k === k) || COMMITTEES[0], ch = (function(){ try{ return cmtChair(k); }catch(e){ return null; } })();
  const R = b.road = {cmte:k, t:c.t, chair:ch ? ch.name : null, ref:G.day, mark:Math.max(G.day, (b.voteDay || G.day + 2) - 1), props:[], done:false};
  const mem = (function(){ try{ return cmtMembers(k).filter(m => m && !m.gone); }catch(e){ return []; } })();
  let D = null; try{ D = lxDoc(b); }catch(e){}
  const ops = D ? D.secs.filter(x => x.k === "op" && !/^a first call|^the whole of it/.test(x.clause || "")) : [];
  const conv = m => (m.traits && m.traits.conviction) || 50;
  const opp = mem.filter(m => alignment(m, b) < -8).sort((u, v) => conv(v) - conv(u));
  if(opp[0] && ops.length){ const x = ops.slice().sort((u, v) => ((v.claim && v.claim[2]) || 0) - ((u.claim && u.claim[2]) || 0) || v.n - u.n)[0];
    R.props.push({k:"strike", ci:x.ci, sec:x.n, head:x.short || x.head, by:opp[0].name, byId:opp[0].id}); }
  const hawk = mem.filter(m => m.pos && m.pos.econ > 20 && alignment(m, b) < 10 && (!opp[0] || m !== opp[0])).sort((u, v) => v.pos.econ - u.pos.econ)[0];
  if(hawk && b.cost && !b.soft) R.props.push({k:"cut", by:hawk.name, byId:hawk.id});
  return R;
}
/* the committee votes: the members the game names, you if you sit there, and the committee's other seats by their party's line */
function lxCmVote(b, score, line, youVote){
  const R = b.road, named = (function(){ try{ return cmtMembers(R.cmte).filter(m => m && !m.gone); }catch(e){ return []; } })();
  const y = G.you, youOn = !!(y && y.committee === R.cmte && (function(){ try{ return heldOffice() === "house"; }catch(e){ return false; } })());
  let aye = 0, no = 0; const by = {};
  named.forEach(m => { const v = score(m) > 0 ? 1 : -1; by[m.id] = v; v > 0 ? aye++ : no++; });
  if(youOn && (youVote === 1 || youVote === -1)){ by.you = youVote; youVote > 0 ? aye++ : no++; }
  /* 20261027b: the committee's seats are shared out as the House is, the majority holding a majority of them;
     the members the game names fill their party's share and the rest of each share votes its party's line */
  const q = lxCmQuota(), have = {}; named.forEach(m => { have[m.party] = (have[m.party] || 0) + 1; }); if(youOn) have[y.party] = (have[y.party] || 0) + 1;
  let rest = 0; const L = partyLine(b);
  Object.keys(q).forEach(p => { const n = Math.max(0, q[p] - (have[p] || 0)); rest += n; for(let i = 0; i < n; i++){ const l = line(L[p] || 0, p, i); l > 0 ? aye++ : no++; } });
  return {aye, no, by, unnamed:rest};
}
function lxMarkup(b){
  const R = lxRoad(b); if(!R || R.done) return null;
  const n = (b.clauses || []).length || 3, out = [];
  R.props.forEach((p, i) => {
    const key = b.title + ":am" + i;
    const v = lxCmVote(b, m => -lxCmLean(m, b) + (m.party === b.sponsorParty ? -6 : 3) + lxNoise(m.id, key) * 10, (l, pt, j) => l ? -l : (knH(pt + j, key) < 0.5 ? 1 : -1), p.you);
    p.aye = v.aye; p.no = v.no; p.adopted = v.aye > v.no; p.d = G.day;
    if(p.adopted){ if(p.k === "strike"){ b.strk = b.strk || []; if(b.strk.indexOf(p.ci) < 0) b.strk.push(p.ci); if(b.pos) Object.keys(b.pos).forEach(k => b.pos[k] = Math.round(b.pos[k] * (1 - 0.5 / n))); }
      else if(p.k === "cut"){ b.soft = true; if(b.pos) Object.keys(b.pos).forEach(k => b.pos[k] = Math.round(b.pos[k] * 0.8)); } }
    const what = p.k === "strike" ? "strike section " + p.sec + " (" + String(p.head).toLowerCase() + ")" : "cut the appropriation by a third";
    (b.amends = b.amends || []).push({d:G.day, by:p.by, what, aye:v.aye, no:v.no, adopted:p.adopted, where:"committee"});
    out.push(surname(p.by) + "'s amendment to " + what + " is " + (p.adopted ? "adopted" : "rejected") + ", " + v.aye + " to " + v.no);
  });
  const rv = lxCmVote(b, m => lxCmLean(m, b) + (m.party === b.sponsorParty ? 4 : 0) + lxNoise(m.id, b.title + ":rep") * 6, (l, pt, j) => l ? l : (knH(pt + j, b.title + ":rep") < 0.5 ? 1 : -1), R.youReport);
  R.report = {aye:rv.aye, no:rv.no, fav:rv.aye > rv.no, d:G.day}; R.done = true;
  (G.members || []).forEach(m => { if(m && !m.gone) m.sway = (m.sway || 0) + (R.report.fav ? 1.5 : -1.5) * (m.party === b.sponsorParty ? 0.5 : 1); });
  try{ LX.docs.delete(lxKey(b)); }catch(e){}
  try{ const line = "The Committee on " + R.t + " marks up the " + b.title + (out.length ? ": " + out.join("; ") : ", with no amendments offered") + ". Reported " + (R.report.fav ? "favourably" : "unfavourably") + ", " + rv.aye + " to " + rv.no + ".";
    feed(line, "news"); journal(line); }catch(e){}
  return R;
}
/* the Senate: two seats a State, each senator reckoned exactly as the docket shows them leaning; undecided ones vote their party; a tie goes to the Vice President */
function lxSenate(b){
  const y = G.you, k = (function(){ try{ return heldOffice(); }catch(e){ return null; } })(), out = {aye:0, no:0, by:{}, names:{}, ok:false, tie:false, d:G.day};
  (G.states || []).forEach(S => { const row = [];
    for(let i = 0; i < 2; i++){
      let v;
      if(k === "senate" && y && S.n === y.state && i === 0){ v = b.senateVote === "aye" ? 1 : b.senateVote === "nay" ? -1 : (alignment(y, b) > 0 ? 1 : -1); out.you = v; }
      else { const L = senLean(S, i, b); v = L.v; }
      row.push(v); v > 0 ? out.aye++ : out.no++;
    }
    out.by[S.n] = row; });
  try{ (OH.list || []).forEach(p => { if(p && p.ohK && /^sen:/.test(p.ohK) && !/^sen:(maj|min|ppt)$/.test(p.ohK)){ const st = p.ohK.slice(4); if(out.by[st]) out.names[st] = p.name; } }); }catch(e){}
  if(out.aye === out.no){ out.tie = true; let vv = 1; try{ vv = (G.exec && G.exec.you ? alignment(G.you, b) : alignment(G.exec, b)) > 0 ? 1 : -1; }catch(e){} out.vp = vv; vv > 0 ? out.aye++ : out.no++; }
  out.ok = out.aye > out.no;
  return out;
}
/* ── the petitions' acts: written from the petitions themselves ── */
function lxOrgDoc(src){
  const O = src.org || {}, T = O.towns || [], N = (typeof ORG_NEEDS !== "undefined" && ORG_NEEDS[O.need]) || {t:"the towns' needs", want:"help"};
  const D = {key:lxKey(src), title:src.title, src, dom:null, prior:null, congress:knOrd(lxCongNo(src.day)), no:"H.R. " + (seedOf(src.title + src.day) % 900 + 100), secs:[], cites:[]};
  D.longTitle = "To answer the petitions of the towns named in it for " + N.t + ", and for other purposes."; D.enact = "Be it enacted by the Senate and House of Representatives of " + lxCountry() + " in Congress assembled,";
  const add = (head, sub, plain, ex) => { D.secs.push(Object.assign({n:D.secs.length + 1, head, sub, plain}, ex || {})); };
  add("Short title", ["This Act may be cited as the " + src.title + "."], "The name it goes by.", {k:"title"});
  add("Findings", ["The Congress finds that—"].concat(T.map((t, i) => "(" + (i + 1) + ") the town of " + t.town + ", in " + t.state + ", petitioned through its mayor" + (t.mayor ? ", " + t.mayor + "," : "") + " for " + (N.want || N.t) + ";")).concat(T.length ? [] : ["(1) towns in more than one State petitioned for " + N.t + "."]), "Which towns asked, and for what.", {k:"find"});
  add("Grants", ["(a) Grants.— The Secretary of the Treasury shall pay to each town named below the sum set against its name, to be spent on " + N.t + " and on nothing else:"].concat(T.map((t, i) => "(" + (i + 1) + ") " + t.town + ", " + t.state + " — " + money(t.cost || 0) + ";")).concat(["(b) Account.— Each mayor shall account to the Secretary within one year for every guilder paid."]), "Each petitioning town gets what it asked for, and must account for it.", {k:"op"});
  add("Authorization of appropriations", ["There is authorized to be appropriated " + money(src.cost || T.reduce((a, t) => a + (t.cost || 0), 0)) + " to carry out this Act, from the general fund."], "What it costs in all.", {k:"approp"});
  add("Effective date", ["This Act takes effect on enactment."], "It applies at once.", {k:"eff"});
  return D;
}
{ const _lxd = lxDoc; lxDoc = function(ref){ try{ const s = lxSource(ref); if(s && s.org){ const c = LX.docs.get(lxKey(s)); if(c && c.key === "org") return c.doc; const d = lxOrgDoc(s); LX.docs.set(lxKey(s), {key:"org", doc:d}); return d; } }catch(e){} return _lxd.apply(this, arguments); }; }
{ const _ofa = orgFedAct; orgFedAct = function(){ const O = orgEnsure(), n0 = (O.acts || []).length, open0 = (O.fed || []).filter(p => p && p.status === "open"); const r = _ofa.apply(this, arguments);
  try{ (O.acts || []).slice(n0).forEach(a => { const k = Object.keys(ORG_NEEDS).find(x => ORG_NEEDS[x].act === a.title), N = ORG_NEEDS[k] || {};
      const towns = open0.filter(p => p.need === k && p.status !== "open").map(p => ({town:p.townName, state:p.state, mayor:p.mayor, cost:p.cost}));
      let sp = null; try{ sp = reactHolder("speaker"); }catch(e){}
      G.statute = G.statute || []; G.statute.unshift({title:a.title, congress:G.congress, day:a.day || G.day, aye:null, no:null, fate:"carried", why:"Petitions from " + towns.length + " towns in " + new Set(towns.map(t => t.state)).size + " States asked the Congress for " + (N.t || "help") + ".", clauses:null, sponsor:sp && sp.name ? sp.name : "the Speaker", state:null, cost:a.cost, org:{need:k, towns}, pos:N.pos ? Object.assign({}, N.pos) : null});
      if(G.statute.length > onumLim(80,"hist")) G.statute.length = onumLim(80,"hist"); }); }catch(e){} return r; }; }
/* ── the state legislatures' bills, written out ── */
const LX_SB = {
  "Levee and Drainage Bill":(P, st) => [["Drainage districts", ["(a) Formation.— A drainage district may be formed in any watershed of " + st + " on the petition of a majority of the landowners in it.", "(b) Assessment.— The cost of the works shall be assessed on the land benefited, in proportion to the benefit."], "Landowners in a watershed can band together and pay for drainage in proportion to what they gain."], ["Levees", ["(a) Height.— Levees on the rivers of " + st + " shall be raised to the highest water of the last " + P.n(30, 100, 10) + " years."], "The state's levees go up to the worst flood in living memory."]],
  "Right to Organise Bill":(P, st) => [["Right to organise", ["(a) Right.— Workers in " + st + " may form unions and bargain collectively through representatives of their own choosing.", "(b) Dismissal.— No employer shall dismiss a worker for joining a union, on pain of a fine of up to " + money(P.n(1, 5) * 100) + "."], "Workers may unionise, and can't be fired for it."], ["Labour board", ["(a) Board.— A State labour board of " + P.n(3, 5) + " members shall hear complaints under this Act and may order reinstatement."], "A state board hears complaints and can order a worker rehired."]],
  "Tolls and Turnpikes Bill":(P, st) => [["Turnpike charters", ["(a) Charter.— The Governor may charter companies to build and keep turnpikes in " + st + ".", "(b) Tolls.— Tolls shall be those set in the charter, reviewed every " + P.n(3, 7) + " years."], "Private companies can build toll roads, at tolls fixed in their charters."], ["Land for the roads", ["(a) Taking.— Land for a chartered turnpike may be taken by eminent domain, on payment of its value as assessed."], "Land for the roads can be taken, with payment."]],
  "Constabulary Powers Bill":(P, st) => [["State constabulary", ["(a) Force.— There is established a State constabulary of " + P.n(100, 600, 50) + " officers with power to arrest anywhere in " + st + ".", "(b) Search.— A constable may search premises on a warrant from any magistrate, or without one in hot pursuit."], "A statewide police force with powers of arrest and search."], ["Persons arrested", ["(a) Hearing.— A person arrested shall be brought before a magistrate within " + P.n(24, 96, 24) + " hours."], "Anyone arrested sees a magistrate within a set time."]],
  "Common Schools Bill":(P, st) => [["Common schools", ["(a) Schools.— A common school, free to every child, shall be kept in every township of " + st + ".", "(b) Tax.— A State school tax of " + P.n(1, 4) + " mills on the guilder of assessed property shall be laid to keep them."], "A free school in every township, paid for by a property tax."], ["Superintendents", ["(a) Inspection.— A superintendent in each county shall inspect the schools every term."], "Each county gets a school inspector."]],
  "Land Enclosure Bill":(P, st) => [["Enclosure", ["(a) Petition.— Common grazing land in " + st + " may be enclosed on the petition of the owners of two thirds of its value.", "(b) Compensation.— Every commoner who loses a right of grazing shall be compensated in land or money."], "Common land can be fenced off by the larger owners, with the commoners compensated."], ["Commissioners", ["(a) Division.— " + P.n(3, 5) + " enclosure commissioners shall divide the land and settle the compensation."], "Commissioners divide the land."]],
  "Militia Reorganisation Bill":(P, st) => [["Organisation", ["(a) Regiments.— The militia of " + st + " shall be organised in regiments by county, under officers commissioned by the Governor.", "(b) Enrolment.— Every able-bodied resident from eighteen to " + P.n(40, 50, 5) + " shall be enrolled; a person who objects in conscience may be excused on payment of a fee."], "Every able-bodied adult is enrolled in county regiments, with a paid exemption for conscience."], ["Muster and arms", ["(a) Muster.— The militia shall muster " + P.n(1, 4) + " times a year, and its arms be kept in county armories."], "Regular musters; arms kept in county armories."]],
  "Free Assembly Bill":(P, st) => [["Assembly", ["(a) Right.— The people of " + st + " may assemble peaceably in any public place without a licence.", "(b) Dispersal.— A gathering may be dispersed only on the written order of a magistrate after a riot has begun."], "People can gather in public without a licence, and can only be broken up after a riot starts."], ["Damages", ["(a) Damages.— A person unlawfully dispersed may recover damages of up to " + money(P.n(1, 5) * 100) + " from the officer responsible."], "Those unlawfully broken up can sue the officer."]]
};
function lxStateDoc(st, b){
