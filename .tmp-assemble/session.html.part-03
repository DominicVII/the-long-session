    if(shown){ const r = D.getBoundingClientRect(); bar.style.display = "flex"; bar.style.top = Math.max(4, r.top - 30) + "px"; bar.style.left = Math.max(4, r.right - 66) + "px"; } else bar.style.display = "none";
    const any = SXP.park && D.style.display !== "none";
    tab.style.display = any ? "block" : "none"; tab.classList.toggle("closed", SXP.closed);
    const t = (document.getElementById("sxDockHead") || {}).textContent || "";
