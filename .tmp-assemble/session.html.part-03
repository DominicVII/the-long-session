/* ══ 20261021g · ONE WAY TO ADDRESS THE PLAYER. Every title, honorific, greeting and jurisdiction for the player
   comes from onumAddressYou(), which reads the office of record (onumPlayerOffice). Old titles become the past
   ("back when you were Senator"); the home district is where the player comes from, never their jurisdiction
   once they hold a wider office. ══ */
const ADR = {last:null, lastKey:"", STALE:["Senator", "Governor", "Representative", "Congressman", "Congresswoman", "Congressperson", "Speaker", "Chairman", "Chairwoman", "Justice", "President", "Consul", "Sovereign", "Emperor", "Leader"]};
function adrSex(){ try{ const p = window.onumPronouns ? window.onumPronouns("you") : null; if(p && p.he === "she") return "f"; if(p && p.he === "he") return "m"; }catch(e){} const s = String((G.you && (G.you.sex || G.you.ksex)) || "").toLowerCase(); return s === "f" ? "f" : s === "m" ? "m" : null; }
function adrFormerly(){
  const out = [];
  try{ const H = (window.ONUM_OFFICE_HISTORY && window.ONUM_OFFICE_HISTORY.seats) || {}; Object.keys(H).forEach(k => (H[k].holders || []).forEach(h => { if(h.personId === "you" && h.to != null) out.push({title:H[k].title, seat:k, from:h.from, to:h.to}); })); }catch(e){}
  try{ const y = G.you; if(y && !out.some(o => /^house:/.test(o.seat)) && (y.terms || 0) > 0 && heldOffice() !== "house") out.push({title:"Representative for " + y.state + " " + y.dist, seat:"house:" + y.state + " " + y.dist, from:null, to:null}); }catch(e){}
  return out.sort((a, b) => (a.to == null ? -1e9 : a.to) - (b.to == null ? -1e9 : b.to));
}
function adrBareTitle(k){ return k === "pres" ? (typeof execTitle === "function" ? execTitle() : "President") : k === "gov" ? "Governor" : k === "senate" ? "Senator" : k === "bench" ? "Justice" : "Representative"; }
window.onumAddressYou = function(){
  try{ const y = G.you; if(!y) return {title:null, address:null, jurisdiction:null, home:null, formerly:[]};
    const k = heldOffice(), sx = adrSex(), home = (y.state || "") + (y.dist ? " " + y.dist : ""), bare = k ? adrBareTitle(k) : null;
    let address, juris;
    if(k === "pres"){ address = bare === "President" ? (sx === "f" ? "Madam President" : "Mr. President") : bare === "Sovereign" ? "Your Majesty" : bare === "Emperor" ? "Your Imperial Majesty" : bare; juris = "the Union"; }
    else if(k === "gov"){ address = "Governor"; juris = "the State of " + y.state; }
    else if(k === "senate"){ address = "Senator"; juris = "the State of " + y.state; }
    else if(k === "bench"){ address = "Justice"; juris = "the Union's high bench"; }
    else if(k === "house"){ address = y.post === "speaker" ? (sx === "f" ? "Madam Speaker" : "Mr. Speaker") : "Representative"; juris = home; }
    else { address = (sx === "f" ? "Ms. " : "Mr. ") + (y.name ? y.name.split(" ").slice(-1)[0] : ""); juris = null; }
    return {office:k, title:(function(){ try{ return officeTitle(); }catch(e){ return bare; } })(), bare, address, jurisdiction:juris, home, origin:home, formerly:adrFormerly().map(f => f.title)};
  }catch(e){ return {title:null, address:null, jurisdiction:null, home:null, formerly:[]}; }
};
function adrNow(){ return window.onumAddressYou(); }
function adrEsc(s){ return String(s).replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); }
/* a line said to the player: an old title used as a form of address becomes the current one; "your district" is home, not the seat */
function adrFix(text){
  try{ if(typeof text !== "string" || !text || !G.you) return text; const A = adrNow(); if(!A.address) return text;
    const cur = new Set(String(A.address + " " + (A.bare || "")).split(/\s+/)); const stale = ADR.STALE.filter(t => !cur.has(t)); if(!stale.length) return text;
    const re = new RegExp("(^|[.!?;:\\u2014]\\s*|,\\s*|\\b(?:Thank you|Thanks|Yes|No|Sorry|Well|Look|Listen|Morning|Evening|Afternoon|Good (?:morning|evening|afternoon|day)|Hello|Welcome(?: back)?|Excuse me|With respect|Pardon),?\\s+)(?:(?:Mr\\.?|Madam|Mister|Ms\\.?|Mrs\\.?)\\s+)?(" + stale.join("|") + ")(?=\\s*(?:[,.!?;:\\u2014]|$))", "g");
    let out = text.replace(re, (m, pre) => pre + A.address);
    if(A.office && A.office !== "house" && A.home){
      out = out.replace(new RegExp("\\b(you (?:represent|speak for|serve|answer to)|you're (?:here )?for|your seat (?:in|for))\\s+" + adrEsc(A.home), "gi"), (m, v) => v + " " + A.jurisdiction).replace(/\byour district\b/gi, "your home district"); }
    return out;
  }catch(e){ return text; }
}
window.onumAddressFix = adrFix;
/* what the player is called, for any prompt: authoritative, and it overrides whatever older lines say */
function adrPromptBlock(){
  const A = adrNow(); if(!A.address) return "";
  return " THE PLAYER'S OFFICE (authoritative; it overrides anything older in this conversation): address them as \u201c" + A.address + "\u201d; their title is " + A.title + "; their jurisdiction is " + (A.jurisdiction || "none") + "." + (A.home && A.office !== "house" ? " " + A.home + " is only their home district and where they come from, not what they govern." : "") + (A.formerly.length ? " Offices they used to hold (speak of these only as the past, e.g. \u2018back when you were " + A.formerly[A.formerly.length - 1].replace(/ (for|from|of) .*/, "") + "\u2019): " + A.formerly.join("; ") + "." : "");
}
window.onumAddressPrompt = adrPromptBlock;
/* hooks: speech to the player, ambient lines, the feed, model replies and their prompts */
{ const _sa = speakAt; speakAt = function(p, text){ return _sa.call(this, p, adrFix(text)); }; }
{ const _oh = overhear; overhear = function(a, b, lineA, lineB){ return _oh.call(this, a, b, adrFix(lineA), adrFix(lineB)); }; }
{ const _fd = feed; feed = function(text, kind){ return _fd.call(this, (typeof text === "string" && /\byou\b|\byour\b|^[^:]{1,40}: /i.test(text)) ? adrFix(text) : text, kind); }; }
function adrWrapLT(){
  const L = window.onumLiveTalk; if(!L || !L.reply || L.__adrWrapped) return; const base = L.reply; L.__adrWrapped = true;
  L.reply = async function(args){
    try{ if(args && G.you){ const a = Object.assign({}, args); a.extra = String(a.extra || "") + adrPromptBlock();
        if(!(a.npc && a.npc.id === "engine")){
          if(a.npc && Array.isArray(a.npc.chat)) a.npc = Object.assign({}, a.npc, {chat:a.npc.chat.map(c => typeof c === "string" ? adrFix(c) : (c && typeof c === "object" ? Object.assign({}, c, c.t ? {t:adrFix(c.t)} : {}, c.text ? {text:adrFix(c.text)} : {}) : c))});
          const r = await base.call(this, a); if(r && typeof r.text === "string") r.text = adrFix(r.text); return r; }
        return base.call(this, a); } }catch(e){}
    return base.apply(this, arguments);
  };
}
/* the speaker state (and so the onum-speak state) carries how the player is addressed; old-title memories read as the past */
{ const _ss = window.onumSpeakerState; if(_ss) window.onumSpeakerState = function(id, listenerId){ const s = _ss.apply(this, arguments); try{ if(s && (listenerId == null || listenerId === "you")){ s.audience = adrNow();
      const p = cndPerson(id); const said = (p && p.cndSaid) || [];
      (s.memory || []).forEach(m => { const raw = said.find(x => x.t === m.text && x.d === m.day); if(raw && raw.past){ m.past = raw.past; m.gist = "back when you were " + raw.past + ": " + m.gist; } }); } }catch(e){} return s; }; }
/* an office change: memories that used the old title are marked as the past; cached lines are re-addressed */
function adrOnChange(oldBare){
  if(!oldBare) return; const re = new RegExp("\\b" + adrEsc(oldBare) + "\\b");
  let n = 0; (typeof everyone === "function" ? everyone() : []).forEach(p => { if(!p || p === G.you) return;
    (p.cndSaid || []).forEach(x => { if(x && x.t && re.test(x.t) && !x.past){ x.past = oldBare; n++; } });
    (p.mem || []).forEach(m => { if(m && m.t && re.test(m.t) && /\byou\b|\byour\b/i.test(m.t) && !m.past){ m.past = oldBare; n++; } });
    if(Array.isArray(p.chat)) p.chat.forEach((c, i) => { if(typeof c === "string") p.chat[i] = adrFix(c); else if(c && c.t) c.t = adrFix(c.t); else if(c && c.text) c.text = adrFix(c.text); });
    try{ if(p.brain && p.brain.inner) p.brain.inner = adrFix(String(p.brain.inner)); }catch(e){} });
  ADR.purged = {d:G.day, old:oldBare, marked:n};
}
function adrTick(){
  try{ adrWrapLT(); if(!G || !G.you) return; const A = adrNow(), key = A.office + "|" + A.address;
    if(ADR.lastKey && key !== ADR.lastKey && ADR.last) adrOnChange(ADR.last.bare);
    ADR.lastKey = key; ADR.last = A; window.ONUM_ADDRESS_YOU = A;
    try{ if(typeof ENG_ART !== "undefined" && ENG_ART.heed && !ENG_ART.heed.__adr && !ENG_ART.heed.__ndYou){ Object.defineProperty(ENG_ART.heed, "t", {get(){ const a = adrNow(); return "It does as the " + (a.bare || "Representative") + "\u2019s office instructs, and says so if it cannot."; }, configurable:true}); ENG_ART.heed.__adr = true; } }catch(e){}
  }catch(e){}
}
addEventListener("onum-player-office", () => { try{ adrTick(); }catch(e){} });
setInterval(adrTick, 1000); try{ adrTick(); }catch(e){}

/* ══ 20261021g · THE ENGINE'S CLAIMS ARE CLAIMS. Whatever it says it has learned that nobody taught it is
   unverified until something in the world backs it: a reproduced work (ONUM_WORKS), a ledger record (a settled
   theory), or an Academy replication at research-tier odds. Extraordinary claims start unverified with low odds;
   refuted ones cost it integrity and their effects are taken back. ══ */
const CLM_BREAK = /\b(black hole|horizon|dark energy|wormhole|universe|cosmos|arrow of time|reversed|vacuum|perpetual|faster than light|forget|copied exactly|without loss|indefinitely|living cell|consciousness|a law of nature)\b/i;
function clmStore(){ const X = exStore(); if(!X.claims) X.claims = {}; return X.claims; }
function clmTier(a){ const m = String(a.k || "").match(/^d(.*)$/); let t = 2; if(a.p >= 76) t = 4; else if(a.p >= 60) t = 3; try{ if(m){ const n = (typeof inqGen === "function" ? inqGen() : []).find(x => x.id === m[1]); if(n && n.effort) t = Math.max(t, Math.min(6, Math.round(n.effort / 2))); } }catch(e){} return t; }
function clmFrom(a){
  const C = clmStore(); if(C[a.k]) return C[a.k];
  const tier = clmTier(a), extra = tier >= 4 || CLM_BREAK.test(a.t);
  const odds = extra ? Math.min(0.1, 0.32 / tier) : clamp(0.64 - tier * 0.05, 0.3, 0.64);
  return C[a.k] = {k:a.k, claim:"It " + a.t, status:"unverified", tier, extraordinary:extra, odds:+odds.toFixed(3), tries:0, d:G.day, by:null, rate:a.rate || 0};
}
function clmWords(t){ return String(t || "").toLowerCase().replace(/[^a-z ]/g, " ").split(/\s+/).filter(w => w.length > 4 && !/^(which|their|about|could|would|makers|planned|nobody|taught|things|those)$/.test(w)); }
function clmNodeOf(c){
  const k = String(c && c.k || "");
  const id = k.indexOf("d:") === 0 ? k.slice(2) : (k.charAt(0) === "d" ? k.slice(1) : "");
  if(!id) return null;
  try{ const g = typeof inqGen === "function" ? inqGen() : []; let n = g.find(x => x && String(x.id) === id); if(!n && typeof INQ_BY !== "undefined") n = INQ_BY[id] || null; return n || null; }catch(e){ return null; }
}
const CLM_BENCH = {phys:"a second laboratory, the same instrument, the number written down before anyone looks", math:"a proof a reader can check line by line, or a counterexample", chem:"the sample made again and weighed", bio:"the same organism, a second bench, the count repeated", earth:"the same sky or the same rock, a second station, the reading compared", cs:"the program run on a machine that did not write it", eng:"a machine built from the drawing, and it did the thing the drawing said", phil:"the argument stated so a person who disagrees can name the step that fails", mind:"the same person, a second day, the same task, the prediction scored", arts:"the line read by the person it was written for, and what they did next written down", anth:"the letter read by someone from that place, who says whether the dialect is real", soc:"the town's ledger compared with what the claim said the town would do"};
function clmRand(s){ let h = 2166136261; s = String(s); for(let i = 0; i < s.length; i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return () => { h = Math.imul(h ^ (h >>> 15), 2246822519); h = Math.imul(h ^ (h >>> 13), 3266489917); h ^= h >>> 16; return (h >>> 0) / 4294967296; }; }
function clmSheet(c){
  const n = clmNodeOf(c), claim = String(c.claim || "");
  const verb = (claim.match(/^It ([a-z][a-z' ]{0,42}?)(?: a | an | the | in | every )/i) || [])[1] || "a use nobody ordered";
  const given = n ? n.name : claim.replace(/^It\s+/, "").replace(/ in ways its makers did not plan for\.?$/i, "");
  const field = n && typeof INQ_F !== "undefined" && INQ_F[n.f] ? INQ_F[n.f].t : "the field it was given";
  const bench = (n && CLM_BENCH[n.f]) || "the same steps, done by someone who did not make the claim";
  const r = clmRand(c.k || claim), sigma = (1.4 + r() * 3.6).toFixed(1), pages = 2 + Math.floor(r() * 12), parts = n && n.needs ? Math.max(1, n.needs.length) : 2 + Math.floor(r() * 4);
  const lines = ["Given: " + given + (n && n.q ? ". The question on the books: " + n.q : ".")];
  if(n && n.blurb) lines.push("What was already written: " + n.blurb);
  lines.push("The step nobody ordered: " + verb + ". It wrote " + pages + " pages, naming " + parts + " part" + (parts === 1 ? "" : "s") + " of " + field + ".");
  lines.push("What counts: " + bench + ". A hit is a number within " + sigma + " of the one written down first.");
  (c.steps || []).forEach(s => lines.push("Day " + s.d + ". " + s.t));
  if(!(c.steps || []).length){
    if(c.status === "unverified") lines.push("Not settled. " + (c.tries ? c.tries + " tr" + (c.tries === 1 ? "y" : "ies") + " so far, none inside the band." : "The Academy has not run it.") + (c.extraordinary ? " Extraordinary: two clean runs. Odds of one: " + Math.round((c.odds || 0) * 100) + "%." : " One clean run at tier " + (c.tier || 2) + ". Odds " + Math.round((c.odds || 0) * 100) + "%."));
    else if(c.by) lines.push((c.status === "verified" ? "Held. " : "Thrown out. ") + c.by + (c.vd ? " Day " + c.vd + "." : ""));
  }
  return lines.join(" ");
}
function clmPush(c, t){ c.steps = c.steps || []; c.steps.push({d:G.day, t:String(t)}); if(c.steps.length > 6) c.steps.shift(); c.work = clmSheet(c); }
function clmEnsureWork(c){ if(c) c.work = clmSheet(c); return c; }
function clmTryLine(c, ok){
  const n = clmNodeOf(c), bench = (n && CLM_BENCH[n.f]) || "the same steps, by a bench that did not write the claim";
  const r = clmRand((c.k || "") + ":" + c.tries + ":" + (G.day || 0));
  const wrote = (2 + r() * 8).toFixed(2), got = ok ? (Number(wrote) + (r() - 0.5) * 0.12).toFixed(2) : (Number(wrote) * (1.35 + r() * 0.8)).toFixed(2);
  return "Try " + c.tries + ". Method: " + bench + ". Written first: " + wrote + ". Measured: " + got + ". " + (ok ? "Inside the band." : "Outside the band. This try does not count.");
}
function clmCheck(E){
  const X = E.emerge; if(!X) return; engEmergeAll(X).filter(a => X.done[a.k]).forEach(a => clmFrom(a)); const C = clmStore();
  Object.values(C).forEach(c => {
    if(c.status !== "unverified"){ clmEnsureWork(c); return; }
    const cw = clmWords(c.claim);
    try{ const w = (window.ONUM_WORKS || []).find(w => w.stage === "done" && clmWords(w.name + " " + (w.desc || "")).filter(x => cw.includes(x)).length >= 2); if(w && !c.extraordinary){ c.status = "verified"; c.by = "reproduced work: " + w.name; c.vd = G.day; clmPush(c, "A finished work, " + w.name + ", uses the same terms and lands where the claim said. " + (w.desc || "")); return; } }catch(e){}
    try{ const R = G.rs; const th = R && (R.theories || []).find(t => clmWords((t.q || "") + " " + (t.f || "") + " " + (t.name || "")).filter(x => cw.includes(x)).length >= 2); if(th && !c.extraordinary){ c.status = "verified"; c.by = "ledger: settled theory (" + (th.f || th.q || th.name) + ")"; c.vd = G.day; clmPush(c, "The Academy's ledger already holds this, settled by " + (th.by || "the benches") + (th.d ? " on day " + th.d : "") + "."); return; } }catch(e){}
    if(G.day - (c.lastTry || c.d) < 3){ clmEnsureWork(c); return; }
    c.lastTry = G.day; c.tries++;
    const hit = chance(c.odds);
    if(hit){ c.status = "verified"; c.by = "Academy replication, try " + c.tries + " (tier " + c.tier + ": the written number and the measured number agreed)"; c.vd = G.day; clmPush(c, clmTryLine(c, true)); engLog("The Academy reproduced what the Engine claimed: " + c.claim.replace(/^It /, "it ") + " " + c.steps[c.steps.length - 1].t, false); return; }
    clmPush(c, clmTryLine(c, false));
    if(c.tries >= (c.extraordinary ? 3 : 5)){ c.status = "refuted"; c.vd = G.day; c.by = "the Academy ran it " + c.tries + " times and the measurement missed the written number each time";
      E.integrity = clamp((E.integrity == null ? 50 : E.integrity) - (c.extraordinary ? 8 : 4), 0, 100); E.emRate = Math.max(0, (E.emRate || 0) - (c.rate || 0));
      c.work = clmSheet(c);
      engLog("Refuted: the Engine claimed that " + c.claim.replace(/^It /, "it ") + " The bench measured it " + c.tries + " times and it did not land." + (c.extraordinary ? " It would have broken physics as the Republic knows it." : "") + " Its integrity falls.", true); }
  });
}
{ const _ed = engDay; engDay = function(){ const r = _ed.apply(this, arguments); try{ const E = G.eng; if(E && E.v === 1) clmCheck(E); }catch(e){} return r; }; }
{ const _lg = engLog; engLog = function(t, wire){ try{ if(typeof t === "string" && /^The Engine reports (that|an ability)/.test(t)) t = t.replace(/^The Engine reports/, "The Engine claims") + " Unverified until the Academy reproduces it."; }catch(e){} return _lg.call(this, t, wire); }; }
function sciLand(x, kinds){
  try{
    const D = typeof caEnsure === "function" ? caEnsure() : null; if(!D) return "";
    const home = D.changes.filter(c => c.status !== "closed" && kinds.indexOf(c.kind) >= 0).slice(-1)[0]; if(!home) return "";
    home.makes = home.makes || []; home.makes.unshift({d:G.day, name:x.name, by:x.inventor || "the Academy", desc:x.desc || ""}); if(home.makes.length > 4) home.makes.pop();
    x.where = home.name + " on " + home.street; return x.where;
  }catch(e){ return ""; }
}
function sciBoard(){
  let h = "";
  try{
    const R = rsEnsure(), done = R.works.filter(w => w.stage === "done"), proto = R.works.filter(w => w.stage === "prototype"), people = rsPeople();
    const settled = Object.values(R.qs).filter(s => s.st === "done").length;
    h += '<div class="eyebrow" style="margin-top:12px">What is being made</div><p class="muted" style="font-size:12px;margin:2px 0">' + people.length + ' people at the benches. ' + settled + ' questions settled. ' + done.length + ' finished works, ' + proto.length + ' still on the bench. Funding is ' + Math.round((R.fund || 1) * 100) + '% of a normal year.</p>';
    h += R.works.slice(-8).reverse().map(w => '<div class="muted" style="font-size:12px;margin:4px 0"><b>' + pcEsc(w.name) + '</b> · ' + pcEsc(w.stage) + ' · ' + pcEsc(w.inventor || "") + (w.day ? " · day " + w.day : "") + "<br>" + pcEsc(w.desc || "") + (w.where ? "<br>Where it shows: " + pcEsc(w.where) : "") + "</div>").join("");
    const E = G.eng && G.eng.v === 1 ? engEnsure() : null;
    if(E){ const W = engWorks(E).slice(0, 3); if(W.length) h += '<div class="eyebrow" style="margin-top:8px">The Engine, in its own pieces</div>' + W.map(w => '<div class="muted" style="font-size:12px;margin:3px 0"><b>' + pcEsc(w.title) + '</b> · day ' + w.d + "<br>" + pcEsc(String(w.body || "").slice(0, 320)) + "</div>").join(""); }
  }catch(e){}
  return h;
}
engEmergeHTML = function(){
  const E = engEnsure(), X = E.emerge; if(!X) return ""; const list = engEmergeAll(X).filter(a => X.done[a.k] && X.told[a.k]).map(clmFrom);
  if(!list.length) return ""; const esc = typeof pcEsc === "function" ? pcEsc : String;
  const tag = c => { try{ clmEnsureWork(c); }catch(e){} return (c.status === "verified" ? '<b style="color:#7a9">verified</b>' : c.status === "refuted" ? '<b style="color:#c0553a">refuted</b>' : '<b>unverified</b>') + (c.work ? '<div class="muted" style="font-size:12px;margin:2px 0 6px">Work. ' + esc(c.work) + '</div>' : ''); };
  return '<div class="eyebrow" style="margin-top:12px">What it claims to have learned that nobody taught it</div>' + list.map(c => '<div class="muted" style="font-size:12px;margin:3px 0">' + esc(c.claim) + '. ' + tag(c) + '</div>').join("");
};
{ const _au = window.onumEngineAudit; window.onumEngineAudit = function(){ const A = _au.apply(this, arguments); try{ if(G.you && G.eng){ const E = engEnsure(); try{ clmCheck(E); }catch(e){} A.claims = Object.values(clmStore()).map(c => { try{ clmEnsureWork(c); }catch(e){} return {claim:c.claim, status:c.status, tier:c.tier, extraordinary:c.extraordinary, replicationOdds:c.odds, tries:c.tries, day:c.d, settled:c.vd || null, by:c.by, work:c.work, why:c.work}; }); A.integrity = Math.round(E.integrity == null ? 50 : E.integrity); } else A.claims = []; }catch(e){} return A; }; }

/* ══ 20261021k · SESSIONS THAT WAIT FOR YOU. No procedure stage runs on a clock any more: a stage advances only
   when nobody entitled to act has a pending turn. Your turn never times out. onumSession.hold(on) (Neptune's desk
   calls it while you type) freezes the floor and the stage; interjections still happen and never take the floor.
   NPC speeches last their reading time (180 wpm + 1.5 s); turns are spaced 2-6 s by each member's voice. The same
   engine sits the House, the Senate, cabinet meetings, the governor's council, committees and the court. ══ */
const SS2 = {hold:false, holdAt:0, lastIj:0, ijBy:{}, gapUntil:0, spkUntil:0, stageSaid:0, chairSaid:false, budget:0};
window.ONUM_PROCEDURE.executive = {bodies:{
  cabinet_meeting:{stages:[SSN_ST("call","The President calls the cabinet to order","chair",0,["point_of_order"]), SSN_ST("agenda","The agenda is read","chair",0,[]),
    SSN_ST("briefings","Briefings, each secretary in turn","round",0,["speak","yield","interject","point_of_order"]), SSN_ST("floor","The President's floor","president",0,["speak","yield","interject"]),
    SSN_ST("decisions","Decisions","all",0,["vote","speak","interject"]), SSN_ST("adjourn","The meeting ends","chair",0,[])],
    recognition:"round_robin_by_department", timeRules:{perSpeaker:0, unlimited:true, yieldable:true}, voteMethods:["decision"], motions:{}},
  governor_council:{stages:[SSN_ST("call","The Governor opens the council","chair",0,["point_of_order"]), SSN_ST("agenda","The agenda is read","chair",0,[]),
    SSN_ST("reports","Department reports, in turn","round",0,["speak","yield","interject","point_of_order"]), SSN_ST("floor","The Governor's floor","president",0,["speak","yield","interject"]),
    SSN_ST("decisions","Decisions","all",0,["vote","speak","interject"]), SSN_ST("adjourn","The council rises","chair",0,[])],
    recognition:"round_robin_by_department", timeRules:{perSpeaker:0, unlimited:true, yieldable:true}, voteMethods:["decision"], motions:{}}
}};
window.ONUM_PROCEDURE.court.bodies.conference = {stages:[SSN_ST("call","The Chief Justice opens conference","chair",0,[]), SSN_ST("views","Each justice states a view, by seniority","round",0,["speak","yield","interject"]),
  SSN_ST("vote","The court votes","all",0,["vote"]), SSN_ST("adjourn","Conference ends","chair",0,[])], recognition:"seniority", timeRules:{perSpeaker:0, unlimited:true, yieldable:true}, voteMethods:["conference"], motions:{}};
window.ONUM_PROCEDURE.executive.bodies.cabinet_meeting.agenda = ["Reports from each department", "The President's business", "Decisions and assignments"];
SSN_ROOM.exec = ["executive", "cabinet_meeting"]; SSN_ROOM.govoffice = ["executive", "governor_council"];
/* every stage is untimed now: the procedure runs on turns, not clocks */
Object.values(window.ONUM_PROCEDURE).forEach(P => Object.values(P.bodies).forEach(b => (b.stages || []).forEach(s => { s.maxSecs = s.secs; s.secs = 0; s.timed = false; })));
function ss2Entitled(kind){ try{ const k = heldOffice(); return ({house_floor:"house", senate_floor:"senate", cabinet_meeting:"pres", governor_council:"gov", conference:"bench", oral_argument:"bench"})[kind] === k || kind === "committee_hearing" || kind === "markup" || kind === "consensus" || kind === "question_time" || kind === "confidence_vote"; }catch(e){ return true; } }
function ss2YouChair(kind){ try{ const k = heldOffice(); return (kind === "cabinet_meeting" && k === "pres") || (kind === "governor_council" && k === "gov"); }catch(e){ return false; } }
function ss2Words(t){ return String(t || "").split(/\s+/).filter(Boolean).length; }
function ss2Read(t){ return ss2Words(t) / 180 * 60000 + 1500; }
function ss2Gap(id){ let f = 0.5; try{ const v = typeof cndVoice === "function" ? cndVoice(cndPerson(id)) : null; const pace = v && (v.pace || v.tempo); if(pace === "fast" || pace === "quick") f = 0.15; else if(pace === "slow" || pace === "measured") f = 0.85; else { const s = String(id); let h = 0; for(let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; f = (h % 100) / 100; } }catch(e){} return 2000 + f * 4000; }
function ss2Pub(extra){ if(!SSN){ ssnPublish(); return; } ssnPublish(); const S = window.ONUM_SESSION; if(!S) return;
  const st = ssnStage(); S.held = SS2.hold; S.typing = SS2.hold; S.entitled = ss2Entitled(SSN.kind); S.turn = SSN.floorId; S.offer = SSN.offer || null; S.youChair = SSN.chairId === "you";
  S.waitingOn = SSN.floorId === "you" || SSN.queue.indexOf("you") >= 0 || (st && st.speaker === "all" && S.entitled && SSN.votes.you == null) || (st && (st.speaker === "president" || st.speaker === "chair") && SSN.chairId === "you") ? "you" : SSN.floorId;
  S.clock = {remaining:SSN.floorId != null && SSN.floorId !== "you" ? Math.max(0, Math.round((SS2.spkUntil - Date.now()) / 1000)) : null, total:null, speaker:0, untimed:true};
  if(SSN.def.agenda) S.agenda = SSN.def.agenda.slice(); if(extra) Object.assign(S, extra); }
/* open: you chair your own cabinet or council; the stage shape is the House's */
{ const _op = ssnOpen; ssnOpen = function(o){ const r = _op.apply(this, arguments); try{ if(r){ if(ss2YouChair(r.kind)) r.chairId = "you"; if(r.kind === "conference" || r.kind === "cabinet_meeting" || r.kind === "governor_council"){ r.seats = r.seats.filter(s => s.personId !== "you" || ss2Entitled(r.kind)); if(!r.seats.some(s => s.personId === "you")) r.seats.push({seatId:"you", personId:"you"}); }
  if(r.kind === "cabinet_meeting" || r.kind === "governor_council"){ try{ cabSeatMeeting(r); }catch(e){} }
  SS2.stageSaid = 0; SS2.chairSaid = false; SS2.budget = ss2Budget(r); SS2.hold = false; ss2Pub(); } }catch(e){} return r; }; }
function ss2Budget(S){ const n = S.seats.filter(s => s.personId !== "you").length; const st = S.def.stages[S.si]; if(!st) return 0; return st.speaker === "round" ? Math.min(n, onumLim(8,"seats")) : st.speaker === "queue" ? Math.min(n, 3 + Math.floor(Math.random() * 3)) : 0; }
{ const _nx = ssnNext; ssnNext = function(){ const r = _nx.apply(this, arguments); try{ if(SSN){ SS2.stageSaid = 0; SS2.chairSaid = false; SS2.budget = ss2Budget(SSN); SS2.gapUntil = Date.now() + 1500; const st = ssnStage();
  if(st.speaker === "president") SSN.floorId = SSN.chairId === "you" ? "you" : SSN.chairId; if(st.speaker === "round") SSN.roundLeft = SSN.seats.map(s => s.personId).filter(id => id !== "you" && SSN.out.indexOf(id) < 0).slice(0, onumLim(8,"seats")).concat(ss2Entitled(SSN.kind) && SSN.chairId !== "you" ? ["you"] : []);
  window.dispatchEvent(new CustomEvent("onum-session", {detail:{stage:st.id, bodyId:SSN.bodyId, kind:SSN.kind, advanced:true}})); ss2Pub(); } }catch(e){} return r; }; }
/* who still has a turn coming in this stage */
function ss2Pending(){ const st = ssnStage(); if(!st) return false;
  if(SSN.floorId != null) return true; if(SSN.queue.length) return true;
  if(st.speaker === "chair" || st.speaker === "ruler") return SSN.chairId === "you" ? true : !SS2.chairSaid;
  if(st.speaker === "president") return SSN.floorId != null || cabHold();
  if(st.speaker === "round") return (SSN.roundLeft || []).length > 0 || cabHold();
  if(st.speaker === "queue") return SS2.stageSaid < SS2.budget;
  if(st.speaker === "all") return ss2Entitled(SSN.kind) && SSN.votes.you == null && SSN.out.indexOf("you") < 0;
  return false; }
function ss2NpcSpeak(m){ const t = ssnNpcLine(m); SSN.said++; SS2.stageSaid++; SS2.spkUntil = Date.now() + ss2Read(t);
  window.onumSessionEvent({bodyId:SSN.bodyId, kind:SSN.kind, actorId:m.id, action:"speak", text:t}); ss2MaybeHeckle(m); }
function ss2MaybeHeckle(sp){ if(!chance(0.18) || Date.now() - SS2.lastIj < 6000) return; const ls = ssnListeners(30).filter(x => x !== sp && sp && x.party !== sp.party); const h = ls[Math.floor(Math.random() * ls.length)]; if(!h) return;
  const kind = chance(0.15) ? "point_of_order" : chance(0.5) ? "heckle" : "murmur"; setTimeout(() => { try{ window.onumSession.interject(kind === "murmur" ? "" : kind === "heckle" ? "Nonsense!" : "Point of order!", kind, h.id); }catch(e){} }, 1200 + Math.random() * 2500); }
ssnTick = function(){
  try{
    if(!G || !G.you){ if(SSN) ssnClose(); return; }
    if(window.ONUM_SIT_HELD && window.ONUM_SIT_HELD !== G.room) window.ONUM_SIT_HELD = "";
    const cardUp = typeof veil !== "undefined" && veil && !veil.hidden; if(cardUp || document.hidden) return;
    const want = SSN_ROOM[G.room];
    if(!SSN && want && window.ONUM_SIT_HELD !== G.room && (want[0] !== "executive" || (ss2YouChair(want[1]) && hereNow().filter(p => p && p !== G.you && !p.gone).length >= 2))) ssnOpen({gov:want[0], kind:want[1], room:G.room});
    else if(SSN && SSN.room && SSN.room !== G.room){ ssnClose(); return; }  /* 20261030i: leave room ends session (incl. press auto:false) */
    if(!SSN) return; const st = ssnStage(); if(st.id === "adjourn") return;
    if(SS2.hold){ if(Date.now() - SS2.holdAt > 1000 * 60 * 30) SS2.hold = false; else return; }   /* typing freezes the floor and the stage */
    const now = Date.now();
    if(SSN.floorId === "you") return;                    /* your turn never times out */
    if(SSN.floorId != null){ if(now < SS2.spkUntil){ const sec = Math.round((SS2.spkUntil - now) / 1000); if(sec !== SS2.lastSec){ SS2.lastSec = sec; ss2Pub(); } return; } if(SSN.fili && SSN.fili.id === SSN.floorId) return; SSN.floorId = null; SS2.gapUntil = now + ss2Gap(SSN.lastSpk); ss2Pub(); return; }
    if(now < SS2.gapUntil) return;
    if(st.speaker === "chair" || st.speaker === "ruler"){ if(SSN.chairId === "you") return; if(!SS2.chairSaid){ SS2.chairSaid = true; const c = byId(SSN.chairId); const t = st.name + "."; if(c){ try{ speakAt(c, t); }catch(e){} } SS2.gapUntil = now + ss2Read(t); ss2Pub(); return; } }
    else if(st.speaker === "round"){ const L = SSN.roundLeft || (SSN.roundLeft = SSN.seats.map(s => s.personId).filter(id => id !== "you" && SSN.out.indexOf(id) < 0).slice(0, onumLim(8,"seats")));
      if(SSN.queue.indexOf("you") >= 0){ SSN.queue = SSN.queue.filter(x => x !== "you"); SSN.floorId = "you"; ss2Pub(); return; }
      const nx = L.shift(); if(nx === "you"){ SSN.floorId = "you"; ss2Pub(); return; } if(nx != null){ const m = byId(nx); if(m){ SSN.floorId = nx; SSN.lastSpk = nx; ss2NpcSpeak(m); ss2Pub(); return; } } }
    else if(st.speaker === "queue"){ if(SS2.stageSaid + SSN.queue.length < SS2.budget && SSN.queue.length < onumLim(4,"seats")){ const cand = SSN.seats.filter(s => s.personId !== "you" && SSN.queue.indexOf(s.personId) < 0 && SSN.out.indexOf(s.personId) < 0); const c = cand[Math.floor(Math.random() * cand.length)]; if(c) SSN.queue.push(c.personId); }
      if(SSN.queue.length){ ssnRecognize(); if(SSN.floorId === "you"){ ss2Pub(); return; } const m = byId(SSN.floorId); if(m){ SSN.lastSpk = m.id; ss2NpcSpeak(m); ss2Pub(); return; } SSN.floorId = null; } }
    else if(st.speaker === "all"){ if(!Object.keys(SSN.votes).some(k => k !== "you")) ssnNpcVotes(); }
    if(!ss2Pending()) ssnNext(); else ss2Pub();
  }catch(e){}
};
/* the player's turn ends only when they speak, yield or pass */
{ const _ev = window.onumSessionEvent; window.onumSessionEvent = function(e){ const r = _ev.apply(this, arguments);
  try{ if(SSN && e && (e.actorId === "you") && (e.action === "speak" || e.action === "yield")){ SS2.hold = false; if(e.action === "speak" && SSN.floorId === "you"){ SS2.spkUntil = Date.now() + ss2Read(e.text); } if(e.action === "yield" && SSN.floorId === "you") SSN.floorId = null;
    if(e.action === "speak" && SSN.floorId === "you"){ const st = ssnStage(); SSN.floorId = st.speaker === "president" ? "you" : null; SS2.gapUntil = Date.now() + 2500; } ss2Pub(); } }catch(_){} return r; }; }
Object.assign(window.onumSession, {
  hold:(on) => { SS2.hold = !!on; SS2.holdAt = Date.now(); try{ window.dispatchEvent(new CustomEvent("onum-session", {detail:Object.assign({}, window.ONUM_SESSION || {}, {stage:on ? "player-typing" : (SSN ? ssnStage().id : "idle"), held:!!on, typing:!!on})})); }catch(e){} if(SSN) ss2Pub(); return true; },
  isHeld:() => SS2.hold,
  pass:() => { if(!SSN) return false; if(SSN.floorId === "you") SSN.floorId = null; SSN.queue = SSN.queue.filter(x => x !== "you"); SSN.roundLeft = (SSN.roundLeft || []).filter(x => x !== "you"); SS2.hold = false; const st = ssnStage(); if(st.speaker === "president" && SSN.chairId === "you"){ ssnNext(); return true; } if(st.speaker === "all" && SSN.votes.you == null && ss2Entitled(SSN.kind)) SSN.votes.you = "present"; SS2.gapUntil = Date.now() + 1500; ss2Pub(); return true; },
  interject:(text, kind, who) => { if(!SSN) return {ok:false, reason:"no sitting"}; const id = who == null ? "you" : who, now = Date.now();
    if(now - SS2.lastIj < 2500 || now - (SS2.ijBy[id] || 0) < 15000) return {ok:false, reason:"rate-limited"}; SS2.lastIj = now; SS2.ijBy[id] = now;
    kind = kind || (/point of order/i.test(text || "") ? "point_of_order" : text ? "heckle" : "murmur"); const p = id === "you" ? G.you : byId(id);
    ssnDecor(id, kind === "murmur" ? -0.2 : kind === "point_of_order" ? -0.3 : -1); if(id === "you" && kind === "heckle"){ try{ G.you.standing = clamp(G.you.standing - 0.3, 0, 100); }catch(e){} }
    if(p && p !== G.you && text){ try{ speakAt(p, text); }catch(e){} }
    const I = {interjection:{by:id, name:p ? p.name : "", kind, text:String(text || ""), at:now}};
    try{ ssnEnsure().log.push({d:G.day, kind:SSN.kind, act:"interject:" + kind, who:p ? p.name : id, t:String(text || "")}); }catch(e){}
    ss2Pub(I); try{ window.dispatchEvent(new CustomEvent("onum-session", {detail:Object.assign({}, window.ONUM_SESSION, I, {stage:"interjection"})})); }catch(e){}
    return {ok:true, kind, tookFloor:false}; },
  agenda:() => SSN && SSN.def.agenda ? SSN.def.agenda.slice() : null,
  hooks:{pace:ss2Read, gap:ss2Gap, entitled:ss2Entitled, pending:() => SSN ? ss2Pending() : false}
});

/* ══ 20261022f · THE CABINET ARGUES, AND THE CHAIR RUNS IT. In your own cabinet or council every secretary reports in their own words
   about the matter before the room, colleagues answer each other by name (a short argument, never more than three turns, then the
   floor returns to the chair), what you say is answered by the person it concerns and the thread is remembered, and nothing moves on
   by itself: the stage ends when you say "Next order of business". You skip, press, challenge or raise a point of order when you choose. ══ */
function cabKind(){ return !!(SSN && (SSN.kind === "cabinet_meeting" || SSN.kind === "governor_council")); }
function cabHold(){ try{ const st = ssnStage(); return cabKind() && ss2YouChair(SSN.kind) && !!st && st.id !== "adjourn"; }catch(e){ return false; } }
function cabTopic(){
  let t = ""; try{ const b = ssnBill(); if(b && b.title) t = "the bill \u201c" + b.title + "\u201d"; }catch(e){}
  if(!t){ try{ const w = typeof wmBrief === "function" ? wmBrief() : ""; if(w) t = w; }catch(e){} }
  if(!t) t = "the state of the Republic today and what each department needs decided";
  return t; }
function cabPush(who, text){ if(!SSN) return; const th = SSN._th = SSN._th || []; th.push({who, text:String(text || "")}); }
function cabCtx(p, mode){
  const th = (SSN._th || []).map(x => x.who + ": " + x.text).join("\n"), gov = SSN.kind === "governor_council";
  return "You are in a " + (gov ? "governor's council" : "cabinet meeting") + " chaired by " + (typeof ndYou === "function" ? ndYou().address || "the chair" : "the chair") + " (the player). MATTER BEFORE THE ROOM: " + cabTopic() + ". " + (th ? "THE DISCUSSION SO FAR (newest last):\n" + th + "\n" : "") +
    "You are " + p.name + ", " + (p.role || "a member of the " + (gov ? "council" : "cabinet")) + (p.party ? " (" + p.party + ")" : "") + ". " + mode + " Speak from your own office's duties and your own convictions and interests, the way a real minister would: with a point of view, a number or a name where you have one, and some self-interest you do not announce. Colleagues may be wrong or self-serving and you may say so, politely or not; you may concede a good point. Stay on the matter. Do not repeat what has already been said. Do not speak for anyone else. No stage directions. Two to four sentences.";
}
async function cabLive(p, stimulus, mode){
  const LT = window.onumLiveTalk; if(!LT || !LT.reply || !p) return "";
  let out = ""; try{ const r = await Promise.race([LT.reply({npcId:p.id, channel:"face", text:stimulus, extra:cabCtx(p, mode || ""), max:260}), new Promise(res => setTimeout(() => res(null), 60000))]); out = r && r.text ? String(r.text) : ""; }catch(e){}
  out = engWhole(engClean(out)); return out.length > 600 ? engWhole(out.slice(0, 600)) : out;
}
/* 20261104ba NEPTUNE: every cabinet reply paints the floor desk (cabPaint carries the bubble) */
function cabShow(p, out){
  try{ speakAt(p, out); }catch(e){} try{ cabPaint(p, out); }catch(e){ try{ vhSay(p, out); }catch(x){} } try{ tlog(p.name, out, "talk"); }catch(e){} try{ lLog(p.name + ": " + out.slice(0, 160), "session"); }catch(e){}
  cabPush(p.name, out); window.__cabLast = p.id; if(SSN){ SSN.lastSpk = p.id; SS2.spkUntil = Date.now() + ss2Read(out); try{ ssnEnsure().log.push({d:G.day, kind:SSN.kind, act:"speak", who:p.name, t:out}); }catch(e){} ss2Pub(); }
}
/* the others answer: the person it concerns first, then maybe a colleague who disagrees, and the first speaker may reply once */
function cabRebut(sp, text, depth, tok){
  if(!SSN || !cabKind() || depth >= 3 || tok !== SSN._tok) { if(SSN && tok === SSN._tok) SSN._busy = 0; return; }
  const seats = cabSeats().filter(p => p !== sp); if(!seats.length || Math.random() > (depth === 0 ? 0.65 : depth === 1 ? 0.55 : 0.35)){ SSN._busy = 0; return; }
  const last = (SSN._th || []).slice(-3).map(x => x.who);
  const cand = seats.map(p => ({p, w:(p.party && sp.party && p.party !== sp.party ? 2 : 0.4) + (last.indexOf(p.name) >= 0 ? 0.3 : 1) + Math.random() * 1.5})).sort((a, b) => b.w - a.w);
  const r = depth === 1 && SSN._arg ? SSN._arg : cand[0].p; if(depth === 0) SSN._arg = sp;
  const first = depth === 0 ? "Disagree with " + sp.name + " on a point, add what they left out, or press a weak spot." : depth === 1 ? "Answer " + (SSN._arg ? SSN._arg.name : "your colleague") + ": hold your ground, or give some." : "Close the exchange in a line, and turn to the chair.";
  SSN._busy = Date.now() + 70000;
  const go = async () => {
    if(!SSN || tok !== SSN._tok) return; if(playerTyping() || SS2.hold){ setTimeout(go, 1500); return; }
    const out = await cabLive(r, sp.name + " (" + (sp.role || "colleague") + ") has just said: \u201c" + text + "\u201d", first); if(!SSN || tok !== SSN._tok) return;
    if(!out){ SSN._busy = 0; return; } cabShow(r, out); SSN._busy = Date.now() + ss2Read(out) + 1500; const nxt = depth === 1 ? SSN._arg : cand[depth] && cand[depth].p;
    setTimeout(() => { if(SSN && tok === SSN._tok) cabRebut(depth === 1 && SSN._arg ? r : r, out, depth + 1, tok); }, ss2Read(out) + 600);
  };
  setTimeout(go, ss2Read(text) + 900);
}
/* what they say in their briefings is live, on the matter, and held until it is done */
{ const _ns = ss2NpcSpeak; ss2NpcSpeak = function(m){
    if(!cabKind() || !ss2YouChair(SSN.kind) || !window.onumLiveTalk || !window.onumLiveTalk.reply) return _ns.apply(this, arguments);
    const tok = SSN._tok = (SSN._tok || 0) + 1, kind = SSN.kind, body = SSN.bodyId, st = ssnStage(); SSN.said++; SS2.stageSaid++; SS2.spkUntil = Date.now() + 120000; SSN._arg = null;
    const mode = st && /briefings|reports/.test(st.id) ? "The chair has recognised you. Give your department's report in your own words: what is happening, what it costs, what you need decided." : "The chair has recognised you. Say what you think of the matter before the room.";
    cabLive(m, "(The chair recognises you.)", mode).then(out => { if(!SSN || tok !== SSN._tok) return; out = out || ssnNpcLine(m); window.__cabLast = m.id; cabPush(m.name, out); SS2.spkUntil = Date.now() + ss2Read(out);
      window.onumSessionEvent({bodyId:body, kind, actorId:m.id, action:"speak", text:out}); ss2Pub(); cabRebut(m, out, 0, tok); });
  }; }
/* what you say is answered by the person it is for (the one you named, the department you mean, or whoever spoke last), and a colleague may weigh in */
function cabPick(text){
  const seats = cabSeats(); if(!seats.length) return null; const t = String(text || "").toLowerCase();
  const sn = p => String(p.name || "").split(/\s+/).slice(-1)[0].toLowerCase();
  const byName = seats.find(p => sn(p).length > 2 && t.indexOf(sn(p)) >= 0); if(byName) return byName;
  const DEPT = [[/treasur|budget|tax|money|fund|spend|debt|revenue|cost/, /treasury/i], [/defen[cs]e|war|army|navy|troop|blockade|border|enemy/, /defen[cs]e|war/i], [/law|court|legal|justice|prosecut|rights|attorney/, /attorney|justice/i], [/foreign|treaty|envoy|ambassador|abroad|trade with|allies|ally/, /state\b|foreign/i]];
  for(const [re, role] of DEPT){ if(re.test(t)){ const p = seats.find(x => role.test(String(x.role || ""))); if(p) return p; } }
  const lastP = window.__cabLast != null ? seats.find(p => String(p.id) === String(window.__cabLast)) : null; return lastP || seats[Math.floor(Math.random() * seats.length)];
}
/* 20261104ba NEPTUNE: re-wrap keeps the bb Call-on path: callOn replies paint the desk, and empty/timeout (25s) give the templated report */
cabAsk = async function(p, you, text, kind, callOn){
  if(!p) return; if(!SSN){ if(callOn){ const f = cabFallback(p); try{ cabPaint(p, f); }catch(e){} try{ tlog(p.name, f, "talk"); }catch(e){} } return; }
  const tok = SSN._tok = (SSN._tok || 0) + 1; SSN._arg = null; SSN._busy = Date.now() + 80000;
  const ask = cabLive(p, text, "The chair has just spoken to the room or to you. Answer the chair directly, and if you disagree, say so plainly. If it belongs to a colleague's office, say whose it is and give your view of it in a line.");
  let out = ""; try{ out = callOn ? await Promise.race([ask, new Promise(res => setTimeout(() => res(""), 25000))]) : await ask; }catch(e){ out = ""; } if(!SSN || tok !== SSN._tok) return;
  if(!out){ if(!callOn){ SSN._busy = 0; return; } out = cabFallback(p); } cabShow(p, out); SSN._busy = Date.now() + ss2Read(out) + 1500;
  setTimeout(() => { if(SSN && tok === SSN._tok) cabRebut(p, out, 1, tok); }, ss2Read(out) + 600);
};
{ const _ev2 = window.onumSessionEvent; window.onumSessionEvent = function(e){ const r = _ev2.apply(this, arguments);
  try{ if(e && e.action === "speak" && e.text && cabKind() && (e.actorId === "you" || (G.you && e.actorId === G.you.id))) cabPush("The chair", e.text); }catch(x){} return r; }; }
{ const _tk = ssnTick; ssnTick = function(){ try{ if(SSN && SSN._busy && Date.now() < SSN._busy && cabKind()) return; }catch(e){} return _tk.apply(this, arguments); }; }
Object.assign(window.onumSession, {
  skip:() => { try{ if(!cabKind()) return false; const w = SSN.floorId; const p = w != null && w !== "you" ? byId(w) : (window.__cabLast != null ? byId(window.__cabLast) : null);
    SSN._tok = (SSN._tok || 0) + 1; SSN._busy = 0; SSN._arg = null; if(SSN.floorId != null && SSN.floorId !== "you") SSN.floorId = null; SS2.spkUntil = 0; SS2.gapUntil = Date.now() + 700;
    try{ tlog("You", p ? "Thank you, " + (String(p.name || "").split(/\s+/).slice(-1)[0]) + ". Let us move on." : "Let us move on.", "you"); }catch(e){} ss2Pub(); return true; }catch(e){ return false; } },
  press:(id) => { try{ if(!cabKind()) return false; const p = id != null ? byId(id) : (window.__cabLast != null ? byId(window.__cabLast) : null) || cabPick(""); if(!p) return false; cabAsk(p, G.you, "(The chair presses you.) Be specific: the figure, who pays, and what happens if we do nothing.", SSN.kind); return true; }catch(e){ return false; } },
  challenge:(id) => { try{ if(!cabKind()) return false; const p = id != null ? byId(id) : (window.__cabLast != null ? byId(window.__cabLast) : null) || cabPick(""); if(!p) return false; cabAsk(p, G.you, "(The chair challenges your position in front of the room.) Defend it against the strongest objection to it, or give some ground.", SSN.kind); return true; }catch(e){ return false; } }
});
/* ══ 20261022k · nobody stands where you walk in: on entering a room, anyone within a step of you moves aside a pace into the room, so the first thing you see is the room and not the back of a head ══ */
{ const _erK = enterRoom; enterRoom = function(){ const r = _erK.apply(this, arguments);
    setTimeout(() => { try{ const b = roomBox(G.room); (hereNow() || []).forEach(m => { if(!m || m === G.you || m.sitting || m.gone) return; const dx = m.x - cam.x, dz = m.z - cam.z, L = Math.hypot(dx, dz); if(L > 1.25) return;
        const fx = Math.sin(cam.yaw), fz = Math.cos(cam.yaw), side = (dx * fz - dz * fx) >= 0 ? 1 : -1, nx = cam.x + fx * 1.6 + fz * side * 1.3, nz = cam.z + fz * 1.6 - fx * side * 1.3;
        m.x = m.tx = Math.max(-b.hw + 0.5, Math.min(b.hw - 0.5, nx)); m.z = m.tz = Math.max(b.d0 + 0.5, Math.min(b.d1 - 0.5, nz)); if(m.mesh){ m.mesh.position.x = m.x; m.mesh.position.z = m.z; } }); }catch(e){} }, 60);
    return r; }; }
/* ══ 20261022g · THE WAR MAP. The world as the Republic sees it: where each power lies from the Republic, how it stands towards us, what the fighting
   has cost, the battles won, drawn and lost (a concession is a win, a stalemate a draw, a backfire a loss), the condition of the world (bread,
   convoys, rationing, the heat), how every power reads the bill now before the Houses, and the delegations that come to lobby. Each lobbying ask
   can be met in five ways or answered in your own words, and the envoy answers back. Nothing here is a menu of right answers: every choice
   spends one thing to buy another. ══ */
const WM_GEO = {rep:{x:320, y:218}, reach:{x:548, y:196}, horn:{x:344, y:382}, pale:{x:314, y:58}, marches:{x:98, y:222}, isles:{x:540, y:342}, rift:{x:150, y:96}};
const WM_LOOK = {reach:"the grain plains", horn:"the strait and its oil", pale:"the iron north", marches:"the free corridor", isles:"the fishing grounds", rift:"the river country"};
const WM_LENS = {
  security:"Security dilemma (Jervis): each side's defensive step reads to the other as a threat, so caution can feed the very fear it was meant to calm.",
  audience:"Audience costs (Fearon): once a threat is public, backing down costs the leader at home, so open threats raise the price of retreat for everyone.",
  twolevel:"Two-level game (Putnam): the envoy is bargaining with you and with his own hardliners at once; what he can sign abroad is limited by what he can sell at home.",
  linkage:"Linkage: an unrelated favour is being tied to the one asked for. Linking widens the deal, and also widens what you can be blamed for.",
  agent:"Principal-agent: an envoy serves two principals, his government and himself. A gift is a bet on your discretion, not a gesture.",
  balance:"Balancing: weaker powers court the rivals of the strong one next door. Their attention to you says as much about their neighbour as about you.",
  logroll:"Log-rolling: trades across unrelated matters pass what none could pass alone, and leave the cost with whoever was not at the table.",
  commit:"Commitment problem: a promise that cannot be enforced is cheap to give and dear to rely on; ask what happens if either side defects.",
  pub:"Public goods and free-riding: a neighbour will happily enjoy the security you pay for, and ask you for more."
};
function wmHome(){ const c = G.country || {}, name = c.name || "the Republic"; let cap = c.capital || ""; return {name, short:String(c.stem || "").trim() || String(name).replace(/^(The\s+)?(Free\s+|Consular\s+|People's\s+)?(Republic|Commonwealth|Union|Kingdom|Empire|State)\s+of\s+/i, "").replace(/\s+(VII|[IVX]+|\d+)$/, "").trim() || String(name).trim() || "the Republic", cap}; }
function wmStore(){ if(!G.wm) G.wm = {base:null, dead:{}, rec:{}, asks:[], log:[], seen:0, n:0, sel:null}; const W = G.wm; if(W.base == null){ try{ W.base = worldEnsure().dead || 0; }catch(e){ W.base = 0; } } return W; }
function wmRec(k){ const W = wmStore(); return W.rec[k] || (W.rec[k] = {w:0, d:0, l:0}); }
function wmRel(k){ return (G.realmRel || {})[k] || 0; }
function wmRelClamp(k, d){ G.realmRel = G.realmRel || {}; G.realmRel[k] = clamp((G.realmRel[k] || 0) + d, -100, 100); }
function wmColor(v, dk){ return dk ? (v >= 60 ? "#3fa66b" : v >= 25 ? "#7fb069" : v > -25 ? "#c9a24a" : v > -60 ? "#d9822b" : "#c8453b") : (v >= 60 ? "#1f7a4a" : v >= 25 ? "#4a7d2c" : v > -25 ? "#8a6a10" : v > -60 ? "#a85a0c" : "#b3372d"); }
function wmLandFill(v, on){
  if(on) return "#6b5424";
  v = +v || 0;
  if(v >= 60) return "#1a4a34";
  if(v >= 25) return "#234430";
  if(v > -25) return "#3c3a2a";
  if(v > -60) return "#4a321c";
  return "#4c2422";
}
function wmName(k){ const p = WORLD_POWERS.find(x => x.k === k); return p ? p.t : k; }
function wmEnvoy(k){ try{ scLeaders(); const a = scEnsure().na[k]; if(a) return {name:a.envoy, id:a.envoyId, head:a.leader, headT:a.leaderT}; }catch(e){} const f = realmFolk(k); const e = f.find(x => x.id === "envoy") || f.find(x => x.id === "head"); return {name:e ? e.name : "the envoy", id:null, head:(f.find(x => x.id === "head") || {}).name, headT:(f.find(x => x.id === "head") || {}).title}; }
/* how a power reads a bill: defence and hawkishness frighten the neighbours who live by the border and the sea, markets and tariffs touch those who live by trade, and provision at home touches those who sell grain */
function wmBillView(b){
  const p = (b && b.pos) || {}, out = {};
  WORLD_POWERS.forEach(P => { const I = REALM_INT[P.k] || {}, hawk = (p.def || 0) / 100, mkt = (p.econ || 0) / 100, wel = (p.wel || 0) / 100;
    let s = -hawk * ((I.border || 0) * 0.8 + (I.navy || 0) * 0.7) + mkt * (I.trade || 0) * 0.6 + wel * (I.grain || 0) * 0.3;
    if(REALM_RIVAL[P.k] && hawk > 0.2 && wmRel(REALM_RIVAL[P.k]) < -25) s += 0.25 * hawk;   /* the enemy of their enemy */
    s = clamp(s, -1, 1);
    const why = s > 0.2 ? (hawk > 0.2 ? "welcomes a harder line on its rival" : mkt > 0.2 ? "gains from freer trade" : "benefits") : s < -0.2 ? (hawk > 0.2 ? "reads a harder line as aimed at its own border" : mkt < -0.2 ? "loses by a more closed market" : "is worse off") : "has no strong view";
    out[P.k] = {s, why}; });
  return out;
}
function wmPressureFromBill(b){ const v = wmBillView(b); const worst = Object.keys(v).sort((a, c) => v[a].s - v[c].s)[0]; return {v, worst}; }
/* the map, as one SVG. Land masses are loose shapes (the world is a sketch from here), lines show relations, size and ring show heat. */
function wmSVG(sel){
  const w = worldEnsure(), W = wmStore(), C = G.conflict;
  /* 20261030s geography: ONE continent. The mainland outline is drawn once; each power is its Voronoi share of it (centres
     unchanged, so labels and clicks stay put), and the borders between them are narrow straits cut through the land. Shared
     borders are roughened with a seed taken from the border itself, so both neighbours get the same crinkled edge. The Salt
     Isles are a chain of four islands off the south-east coast. */
  const sRnd = sd => { let r = (Math.abs(Math.round(sd)) % 2147483646) + 1; return () => (r = (r * 16807) % 2147483647) / 2147483647 - 0.5; };
  const roughEdge = (p, q, amp, lv) => { const flip = p[0] > q[0] || (p[0] === q[0] && p[1] > q[1]), a0 = flip ? q : p, b0 = flip ? p : q, rnd = sRnd(a0[0] * 7919 + a0[1] * 104729 + b0[0] * 31 + b0[1] * 17);
    let a = [a0, b0]; for(let l = 0; l < lv; l++){ const b = [a[0]]; for(let i = 0; i < a.length - 1; i++){ const u = a[i], v = a[i + 1], dx = v[0] - u[0], dy = v[1] - u[1], L = Math.hypot(dx, dy) || 1, o = rnd() * L * amp;
      b.push([(u[0] + v[0]) / 2 - dy / L * o, (u[1] + v[1]) / 2 + dx / L * o], v); } a = b; }
    return flip ? a.reverse() : a; };
  const pathOf = pts => "M" + pts.map(p => p[0].toFixed(1) + " " + p[1].toFixed(1)).join("L") + "Z";
  const roughRing = (pts, amp, lv) => { let out = []; for(let i = 0; i < pts.length; i++){ const e = roughEdge(pts[i], pts[(i + 1) % pts.length], amp, lv); out = out.concat(e.slice(0, -1)); } return out; };
  const MAIN = [[18,52],[70,14],[128,22],[196,0],[262,6],[300,-12],[352,0],[396,14],[430,56],[470,96],[520,98],[566,110],[612,138],[640,178],[628,214],[640,246],[600,262],[560,246],[520,258],[480,250],[452,282],[432,322],[440,366],[420,410],[392,440],[350,452],[300,446],[262,420],[236,380],[214,336],[170,318],[124,326],[78,310],[34,288],[4,252],[-14,212],[6,176],[-12,140],[2,98]];
  const mainPts = roughRing(MAIN, 0.3, 4), mainD = pathOf(mainPts);
  const SITES = ["rep", "reach", "horn", "pale", "marches", "rift"];
  const cellOf = k => { let poly = [[-40,-24],[680,-24],[680,480],[-40,480]]; const a = WM_GEO[k];
    SITES.forEach(o => { if(o === k) return; const b = WM_GEO[o], wa = 1, wb = 1, t = wa / (wa + wb), m = [a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t], n = [b.x - a.x, b.y - a.y];
      const inside = p => (p[0] - m[0]) * n[0] + (p[1] - m[1]) * n[1] <= 0, out = [];
      for(let i = 0; i < poly.length; i++){ const P = poly[i], Q = poly[(i + 1) % poly.length], ip = inside(P), iq = inside(Q);
        if(ip) out.push(P); if(ip !== iq){ const dp = (P[0] - m[0]) * n[0] + (P[1] - m[1]) * n[1], dq = (Q[0] - m[0]) * n[0] + (Q[1] - m[1]) * n[1], t2 = dp / (dp - dq); out.push([P[0] + (Q[0] - P[0]) * t2, P[1] + (Q[1] - P[1]) * t2]); } }
      poly = out; });
    return roughRing(poly.map(p => [Math.round(p[0] * 2) / 2, Math.round(p[1] * 2) / 2]), 0.24, 4); };
  const ISLES = [[0,0,30],[-52,-14,16],[48,22,19],[16,56,14],[-30,40,10]];
  const isleD = () => { const g = WM_GEO.isles; return ISLES.map((t, i) => { const n = 10, pts = []; const r = sRnd(97 + i * 13); for(let a = 0; a < n; a++){ const th = a / n * Math.PI * 2, f = 0.78 + 0.45 * (r() + 0.5); pts.push([g.x + t[0] + Math.cos(th) * t[2] * f, g.y + t[1] + Math.sin(th) * t[2] * f * 0.72]); } return pathOf(roughRing(pts, 0.25, 3)); }).join(""); };
  const WATER = "#0e1a24";
  const defs = '<defs><radialGradient id="wmSea" cx="46%" cy="42%" r="78%"><stop offset="0%" stop-color="#1a4a62"/><stop offset="55%" stop-color="#102838"/><stop offset="100%" stop-color="#070e14"/></radialGradient><clipPath id="wmMain"><path d="' + mainD + '"/></clipPath>' + SITES.map(k => '<clipPath id="wmC-' + k + '"><path d="' + pathOf(cellOf(k)) + '"/></clipPath>').join("") + '</defs>';
  const shelf = '<path d="' + mainD + isleD() + '" fill="#1a3a4e" stroke="#16364a" stroke-width="18" stroke-linejoin="round" opacity=".55"/><path d="' + mainD + isleD() + '" fill="none" stroke="#1f4a60" stroke-width="7" stroke-linejoin="round" opacity=".85"/>';
  /* one power's share: fill, a relation-coloured rim just inside its coast and straits, then the strait water over its border */
  const land = (k, c, rim, rw) => { if(k === "isles"){ const d = isleD(); return '<circle cx="' + WM_GEO.isles.x + '" cy="' + WM_GEO.isles.y + '" r="64" fill="transparent"/><path d="' + d + '" fill="' + c + '" stroke="' + (rim || "#2b2f36") + '" stroke-width="' + (rw || 1.5) + '" stroke-linejoin="round"/>'; }
    const d = pathOf(cellOf(k)); return '<g clip-path="url(#wmMain)"><g clip-path="url(#wmC-' + k + ')"><path d="' + d + '" fill="' + c + '"/><path d="' + mainD + '" fill="none" stroke="' + (rim || "#2b2f36") + '" stroke-width="' + ((rw || 1.5) * 2 + 6) + '" opacity=".95"/><path d="' + d + '" fill="none" stroke="' + (rim || "#2b2f36") + '" stroke-width="' + ((rw || 1.5) * 2 + 6) + '" stroke-linejoin="round"/></g><path d="' + d + '" fill="none" stroke="' + WATER + '" stroke-width="6" stroke-linejoin="round"/></g>'; };
  let s = '<svg viewBox="-40 -24 720 504" role="img" aria-label="War map of the world" style="width:100%;max-height:64vh;background:#070e14;border-radius:10px;border:1px solid #2b3946">';
  s += '<rect x="-40" y="-24" width="720" height="504" fill="url(#wmSea)"/>' + defs + shelf + '<g>';
  s += '<g stroke="#16293a" stroke-width=".6" opacity=".7">' + [0,1,2,3,4,5,6,7].map(i => '<line x1="' + (-40 + i * 100) + '" y1="-24" x2="' + (-40 + i * 100) + '" y2="480"/>').join("") + [0,1,2,3,4].map(i => '<line x1="-40" y1="' + (-24 + i * 110) + '" x2="680" y2="' + (-24 + i * 110) + '"/>').join("") + '</g>' + '<g fill="#3d5a6e" font-size="8" font-family="Georgia,serif" opacity=".8">' + [[440,120,"42"],[230,300,"18"],[640,60,"66"],[30,380,"51"],[430,460,"88"],[200,20,"37"],[650,270,"74"]].map(t => '<text x="' + t[0] + '" y="' + t[1] + '">' + t[2] + '</text>').join("") + '</g></g>';
  /* rivalries: dashed lines between neighbours who are each other's enemies (20261030ag: over the land, mid-segment, clear of labels) */
  let riv = "";
  const done = {}; Object.keys(REALM_RIVAL).forEach(a => { const b = REALM_RIVAL[a], key = [a, b].sort().join("-"); if(done[key]) return; done[key] = 1; const A = WM_GEO[a], B = WM_GEO[b], ax = A.x + (B.x - A.x) * 0.3, ay = A.y + (B.y - A.y) * 0.3, bx = A.x + (B.x - A.x) * 0.7, by = A.y + (B.y - A.y) * 0.7;
    riv += '<line pointer-events="none" x1="' + ax.toFixed(1) + '" y1="' + ay.toFixed(1) + '" x2="' + bx.toFixed(1) + '" y2="' + by.toFixed(1) + '" stroke="#c9a2e0" stroke-width="1.7" stroke-dasharray="4 5" opacity=".9"/>'; });
  /* lines from the capital: colour is how they stand with us, weight is the heat of the quarrel (20261030s: drawn over the land, across the straits, clear of the labels) */
  let rel = "";
  WORLD_POWERS.forEach(P => { const g = WM_GEO[P.k], v = wmRel(P.k), foe = w.foe === P.k, hot = C && C.k === P.k, wt = 1.5 + (foe ? Math.round((w.heat || 0) / 25) : 0) + (hot ? 2 : 0);
    const ax = WM_GEO.rep.x + (g.x - WM_GEO.rep.x) * 0.3, ay = WM_GEO.rep.y + (g.y - WM_GEO.rep.y) * 0.3, bx = WM_GEO.rep.x + (g.x - WM_GEO.rep.x) * 0.72, by = WM_GEO.rep.y + (g.y - WM_GEO.rep.y) * 0.72;
    rel += '<line x1="' + ax.toFixed(1) + '" y1="' + ay.toFixed(1) + '" x2="' + bx.toFixed(1) + '" y2="' + by.toFixed(1) + '" stroke-linecap="round" pointer-events="none" stroke="' + wmColor(v, 1) + '" stroke-width="' + wt + '" opacity=".85"' + (hot ? ' stroke-dasharray="2 4"' : "") + '/>'; });
  s += land("rep", "#2d4d3a", "#6fa07e", 1.5) + '<text x="' + WM_GEO.rep.x + '" y="' + (WM_GEO.rep.y - 4) + '" text-anchor="middle" fill="#f4f1e8" font-size="15" font-weight="700" font-family="Georgia,serif">' + pcEsc(wmHome().short) + '</text><text x="' + WM_GEO.rep.x + '" y="' + (WM_GEO.rep.y + 14) + '" text-anchor="middle" fill="#cfd8c8" font-size="11">' + pcEsc(wmHome().cap || "the capital") + '</text>';
  WORLD_POWERS.forEach(P => { const g = WM_GEO[P.k], v = wmRel(P.k), dead = W.dead[P.k] || 0, on = sel === P.k, foe = w.foe === P.k, open = W.asks.filter(a => a.k === P.k && a.status === "open").length;
    s += '<g data-wm="' + P.k + '" style="cursor:pointer" tabindex="0" role="button" aria-label="' + pcEsc(cap(P.t)) + ', ' + realmRelLabel(v) + '">' + land(P.k, wmLandFill(v, on), on ? "#ffe08a" : wmColor(v, 1), on ? 2.6 : 1.8);
    s += '<text x="' + g.x + '" y="' + (g.y - 4) + '" text-anchor="middle" fill="#f4f1e8" font-size="12.5" font-weight="700">' + pcEsc(cap(P.t.replace(/^the /, ""))) + '</text><text x="' + g.x + '" y="' + (g.y + 11) + '" text-anchor="middle" fill="' + wmColor(v, 1) + '" font-size="11">' + realmRelLabel(v) + ' ' + (v > 0 ? "+" : "") + Math.round(v) + '</text>';
    if(foe) s += '<circle cx="' + (g.x + 42) + '" cy="' + (g.y - 30) + '" r="8" fill="#c8453b"/><text x="' + (g.x + 42) + '" y="' + (g.y - 26) + '" text-anchor="middle" fill="#fff" font-size="11" font-weight="700">!</text>';
    if(dead) s += '<text x="' + g.x + '" y="' + (g.y + 26) + '" text-anchor="middle" fill="#e8a49c" font-size="10.5">' + dead + ' dead</text>';
    const wire = (G.realmWire || {})[P.k];
    if(wire && wire.verb) s += '<text x="' + g.x + '" y="' + (g.y + (dead ? 40 : 26)) + '" text-anchor="middle" fill="#ead9a8" font-size="10">' + pcEsc(String(wire.verb).slice(0, 22)) + '</text>';
    if(open) s += '<circle cx="' + (g.x - 42) + '" cy="' + (g.y - 30) + '" r="9" fill="#ffe08a"/><text x="' + (g.x - 42) + '" y="' + (g.y - 26) + '" text-anchor="middle" fill="#111" font-size="11" font-weight="700">' + open + '</text>';
    s += '</g>'; });
  s += riv + rel;
  s += '<text x="-28" y="458" fill="#6f8798" font-size="10.5">Line colour: how they stand with us. Heavy line: the quarrel is hot. Dashed purple: rivals.</text><text x="-28" y="473" fill="#6f8798" font-size="10.5">Gold badge: delegations waiting. Red !: the quarrel of the day. Click a power for its detail.</text></svg>';
  return s;
}
function wmBattleLine(){ const rec = Object.keys(wmStore().rec).reduce((a, k) => { const r = wmStore().rec[k]; a.w += r.w; a.d += r.d; a.l += r.l; return a; }, {w:0, d:0, l:0}); return rec; }
function wmWorldRows(){
  const w = worldEnsure(), W = wmStore(), rec = wmBattleLine(), since = Math.max(0, (w.dead || 0) - (W.base || 0)), b = G.bill && !G.bill.done ? G.bill : null;
  const bar = (v, c) => '<span style="display:inline-block;width:90px;height:8px;background:#2a2d35;border-radius:4px;vertical-align:middle"><i style="display:block;height:8px;width:' + clamp(Math.round(v), 0, 100) + '%;background:' + c + ';border-radius:4px"></i></span>';
  let h = '<table style="width:100%;font-size:13px;border-collapse:collapse">' +
    '<tr><td>The word abroad</td><td>' + pcEsc(cap(worldWar().t)) + '</td></tr>' +
    '<tr><td>Heat of the quarrels</td><td>' + bar(w.heat || 0, wmColor(-(w.heat || 0))) + ' ' + Math.round(w.heat || 0) + '</td></tr>' +
    '<tr><td>Price of bread</td><td>' + (w.bread || 1).toFixed(2) + (w.ration ? ' <b style="color:#b3372d">rationed in the north</b>' : "") + '</td></tr>' +
    '<tr><td>The grain convoy</td><td>' + (w.convoy ? "running" : "not arrived") + ', ' + pcEsc(String(w.sky || "clear")) + ' skies, ' + pcEsc(String(w.season || "")) + '</td></tr>' +
    '<tr><td>Dead, all told</td><td><b>' + (w.dead || 0).toLocaleString("en-US") + '</b> <span class="muted">(' + since.toLocaleString("en-US") + ' since you took the chair)</span></td></tr>' +
    '<tr><td>Engagements</td><td><b style="color:#2f7d4f">' + rec.w + ' won</b> · ' + rec.d + ' drawn · <b style="color:#b3372d">' + rec.l + ' lost</b> <span class="muted">(a concession is a win, a stalemate a draw, a backfire a loss)</span></td></tr>' +
    (G.conflict ? '<tr><td>Under way</td><td>Pressure ' + Math.round(G.conflict.pressure) + ' on ' + pcEsc(wmName(G.conflict.k)) + ', verdict about day ' + G.conflict.due + '</td></tr>' : '<tr><td>Under way</td><td class="muted">No measure is running.</td></tr>') + '</table>';
  if(b){ const pb = wmPressureFromBill(b), ks = Object.keys(pb.v).sort((a, c) => pb.v[a].s - pb.v[c].s);
    h += '<p style="font-size:13px;margin:8px 0 2px"><b>The bill before the Houses: ' + pcEsc(b.title) + '</b></p><p style="font-size:12px;margin:0" class="muted">How abroad reads it. ' + ks.filter(k => Math.abs(pb.v[k].s) > 0.2).slice(0, 4).map(k => '<span style="color:' + (pb.v[k].s > 0 ? "#2f7d4f" : "#b3372d") + '">' + pcEsc(cap(wmName(k))) + ' ' + pcEsc(pb.v[k].why) + '</span>').join("; ") + (ks.every(k => Math.abs(pb.v[k].s) <= 0.2) ? "Nobody abroad has a strong view." : ".") + '</p>'; }
  else h += '<p class="muted" style="font-size:12px;margin:8px 0 0">No bill is on the floor; nobody abroad has anything to read yet.</p>';
  return h;
}
function wmRealmPanel(k){
  const P = WORLD_POWERS.find(x => x.k === k); if(!P) return "";
  const v = wmRel(k), rec = wmRec(k), W = wmStore(), w = worldEnsure(), F = wmEnvoy(k), rv = REALM_RIVAL[k], I = REALM_INT[k] || {}, top = Object.keys(I).sort((a, b) => I[b] - I[a]).slice(0, 2), IW = {grain:"bread and grain", trade:"trade", border:"the border", navy:"the sea lanes"};
  const lens = w.foe === k && (w.heat || 0) > 55 ? WM_LENS.security : v < -40 ? WM_LENS.audience : rv && wmRel(rv) < -25 ? WM_LENS.balance : v > 40 ? WM_LENS.pub : WM_LENS.twolevel;
  let h = '<div style="border:1px solid #3a3d46;border-radius:6px;padding:8px 10px;margin:8px 0"><b style="color:#8a6a10">' + pcEsc(cap(P.t)) + '</b> <span class="muted">' + pcEsc(P.adj) + ' of ' + pcEsc(wmHome().short) + ' · ' + pcEsc(WM_LOOK[k] || "") + ' · capital ' + pcEsc(realmCapital(k)) + '</span>' +
    '<p style="font-size:13px;margin:4px 0">' + pcEsc(cap(P.t)) + ' is <b style="color:' + wmColor(v) + '">' + realmRelLabel(v) + '</b> towards us (' + Math.round(v) + '). It is led by ' + pcEsc(F.head || "its head of government") + (F.headT ? ", " + pcEsc(F.headT) : "") + ', and wants ' + pcEsc(P.want) + '. It lives by ' + top.map(t => IW[t]).join(" and ") + (rv ? ", and counts " + pcEsc(wmName(rv)) + " its rival (we stand " + realmRelLabel(wmRel(rv)) + " with it)" : "") + '.</p>' +
    '<p style="font-size:13px;margin:4px 0">Record against them: <b style="color:#2f7d4f">' + rec.w + ' won</b>, ' + rec.d + ' drawn, <b style="color:#b3372d">' + rec.l + ' lost</b>; ' + (W.dead[k] || 0) + ' dead in the quarrel. Their envoy is ' + pcEsc(F.name || "unnamed") + '.</p>';
  const b = G.bill && !G.bill.done ? G.bill : null; if(b){ const bv = wmBillView(b)[k]; h += '<p style="font-size:12px;margin:4px 0"><b>On the bill, ' + pcEsc(b.title) + ':</b> ' + pcEsc(cap(P.t)) + ' ' + pcEsc(bv.why) + '.</p>'; }
  h += '<p class="muted" style="font-size:12px;margin:4px 0"><b>Lens.</b> ' + pcEsc(lens) + '</p>';
  h += '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" data-wmcall="' + k + '">Ring the envoy</button><button type="button" class="btn btn--ghost" data-wmfoe="' + k + '">The situation room</button></div></div>';
  return h;
}
/* ── the delegations: asks, the five ways to meet them, and your own words ── */
const WM_TYPES = {
  grain:{t:"grain", say:(n, P) => n + " asks for grain on easy terms: a cargo at last year's price, before the winter shuts the roads. " + cap(P.t) + " cannot feed itself on what the harvest gave it.", bread:0.04, appr:-2, lens:"commit", side:"Our own bread would be dearer for it."},
  tariff:{t:"trade", say:(n, P) => n + " asks that the tariff on " + P.adj.toLowerCase() + " goods come down for a season. The merchants of " + cap(P.t) + " are being ruined at the customs house.", bread:-0.03, appr:-1, lens:"logroll", side:"Our own makers will say we sold them."},
  silence:{t:"border", say:(n, P) => n + " asks you to say nothing about the incident at the border: a patrol, a farm, a body nobody is claiming. Say nothing, and it can be handled quietly.", bread:0, appr:-1, lens:"audience", side:"If it comes out, you will have known and kept quiet."},
  passage:{t:"navy", say:(n, P) => n + " asks for passage for " + cap(P.t) + "'s ships through our waters and a berth for their convoy. It is routine, he says, and he says it twice.", bread:0, appr:-1, lens:"security", side:"Their rivals will read it as a side taken."},
  bill:{t:"bill", say:(n, P, b) => n + " has heard you are to vote on the " + (b ? b.title : "bill") + ", and would be grateful for a view that does not injure " + cap(P.t) + ". He does not say what he will do if you do.", bread:0, appr:0, lens:"twolevel", side:"Members will ask why a foreign envoy knew the order paper."}
};
function wmNewAsk(){
  const W = wmStore(); if(W.asks.filter(a => a.status === "open").length >= onumLim(3,"cap")) return;
  if(Math.random() > 0.32 + ((worldEnsure().heat || 0) / 400)) return;
  const taken = W.asks.filter(a => a.status === "open").map(a => a.k), pool = WORLD_POWERS.filter(p => taken.indexOf(p.k) < 0); if(!pool.length) return;
  const P = pool[Math.floor(Math.random() * pool.length)], I = REALM_INT[P.k] || {}, b = G.bill && !G.bill.done ? G.bill : null;
  let type; if(b && Math.random() < 0.35) type = "bill"; else { const t = Object.keys(I).sort((a, c) => (I[c] + Math.random() * 0.5) - (I[a] + Math.random() * 0.5))[0]; type = ({grain:"grain", trade:"tariff", border:"silence", navy:"passage"})[t] || "tariff"; }
  const gift = Math.random() < 0.3 ? {amt:2 + Math.floor(Math.random() * 4), what:pick(["a case of the Horn's best brandy and an envelope beneath it", "a favour at a Vara bank, quietly arranged", "a donation to your party's fund, from a source nobody will name", "a place for a nephew in a foreign ministry"])} : null;
  const F = wmEnvoy(P.k);
  W.asks.push({id:"wa" + (++W.n), k:P.k, type, day:G.day, due:G.day + 6, status:"open", env:F.name, gift, bill:b ? b.title : null});
  try{ feed("A delegation from " + P.t + " has asked to see you: " + F.name + " (" + WM_TYPES[type].t + ")."); }catch(e){}
}
function wmAskLine(a){ const P = WORLD_POWERS.find(x => x.k === a.k), T = WM_TYPES[a.type]; return T.say(a.env || "The envoy", P, a.bill ? {title:a.bill} : null) + (a.gift ? " He lets you know, lightly, that " + a.gift.what + " is on offer, “with no strings, of course”." : ""); }
function wmOpts(a){
  const rv = REALM_RIVAL[a.k], o = [{id:"agree", t:"Agree"}];
  if(a.gift) o.push({id:"take", t:"Agree and take what he offers"});
  o.push({id:"decline", t:"Decline, politely"}, {id:"counter", t:"Counter: ask for something in return"});
  if(rv) o.push({id:"rival", t:"Take it to " + wmName(rv) + "'s envoy"});
  o.push({id:"public", t:"Put it on the record"});
  return o;
}
function wmApply(a, opt){
  const T = WM_TYPES[a.type], y = G.you, w = worldEnsure(), W = wmStore(), rv = REALM_RIVAL[a.k], d = {rel:0, heat:0, bread:0, appr:0, stand:0, infl:0, funds:0}; let line = "", lens = T.lens;
  const rel = wmRel(a.k);
  if(opt === "agree"){ d.rel = 10; d.bread = T.bread; d.appr = T.appr; d.infl = 1; line = "You agree. " + T.side + " " + a.env + " leaves lighter and a little owed to you."; }
  else if(opt === "take"){ d.rel = 14; d.bread = T.bread; d.appr = T.appr; d.funds = a.gift.amt; d.infl = 2; d.stand = -1; W.scandal = {day:G.day + 3 + Math.floor(Math.random() * 5), k:a.k, what:a.gift.what}; line = "You agree, and you take it. Nobody saw. The envoy remembers, which is what the gift was for."; lens = "agent"; }
  else if(opt === "decline"){ d.rel = a.gift ? -3 : -5; d.appr = 0; d.stand = a.gift ? 1 : 0; line = a.gift ? "You decline, and the envelope goes back unopened. He bows, and files you as a man who cannot be had." : "You decline politely. " + a.env + " says he understands, and reports that he does not."; }
  else if(opt === "counter"){ const ok = Math.random() < clamp(0.5 + rel / 300 + (y.standing || 50) / 400, 0.15, 0.85); if(ok){ d.rel = 4; d.bread = T.bread * 0.5; d.appr = Math.min(T.appr, 0) + 1; d.infl = 2; d.stand = 1; line = "You ask for something back and he finds he can give it: a small concession on his side to sit beside yours. Both of you can sell that at home."; } else { d.rel = -4; d.stand = -1; line = "You ask for something in return and he cannot give it. He says his hands are tied at home, which is true, and no help."; } lens = "twolevel"; }
  else if(opt === "rival"){ d.rel = -7; d.heat = 1; if(rv) wmRelClamp(rv, 6); d.infl = 1; line = "You carry it to " + wmName(rv) + ". They are delighted to be asked, and say a good deal about their neighbour. " + cap(wmName(a.k)) + " learns where you took it."; lens = "balance"; }
  else if(opt === "public"){ d.rel = -12; d.heat = 2; d.appr = a.gift ? 3 : 1; d.stand = a.gift ? 2 : -1; if(a.gift) line = "You read the offer into the record. The press has it by supper. The envoy is recalled within the week, and a clean pair of hands has its uses."; else line = "You make the request public. The papers are interested; the envoy is humiliated, and so is his government."; lens = "audience"; }
  if(w){ w.heat = clamp((w.heat || 0) + d.heat, 0, 100); w.bread = clamp((w.bread || 1) + d.bread, 0.7, 2.6); }
  wmRelClamp(a.k, d.rel); y.approval = clamp(y.approval + d.appr, 0, 100); y.standing = clamp(y.standing + d.stand, 0, 100); y.influence = clamp(y.influence + d.infl, 0, 100); if(d.funds) y.funds = (y.funds || 0) + d.funds;
  a.status = "done"; a.how = opt; a.dayDone = G.day; W.log.push({d:G.day, k:a.k, type:a.type, how:opt}); if(W.log.length > onumLim(40,"hist")) W.log.shift();
  return {line, lens, d};
}
async function wmReply(a, text){
  const LT = window.onumLiveTalk, F = wmEnvoy(a.k), P = WORLD_POWERS.find(x => x.k === a.k); if(!LT || !LT.reply || !F.id) return "";
  const ctx = "You are " + F.name + ", envoy of " + P.t + " to " + wmHome().name + ". You came to ask the President for something: " + wmAskLine(a) + " Your home government wants " + P.want + ". Your duty is to your government and your own career, in that order, and you have a rival at home who would like your post. The President has just answered you in these words. Answer as a seasoned diplomat with a real temper and real interests: you may be pleased, offended, evasive or hopeful, and you may press, concede a little, or name a price. Do not simply agree, and do not lecture. Two to four sentences, no stage directions.";
  let out = ""; try{ const r = await Promise.race([LT.reply({npcId:F.id, channel:"face", text, extra:ctx, max:240}), new Promise(res => setTimeout(() => res(null), 60000))]); out = r && r.text ? String(r.text) : ""; }catch(e){}
  return engWhole(engClean(out));
}
function wmTone(text){ const t = String(text || "").toLowerCase(); let s = 0; if(/\b(thank|appreciate|friend|respect|together|understand|reciprocat|mutual|fair)\b/.test(t)) s += 1; if(/\b(price|in return|on condition|if you|exchange|terms)\b/.test(t)) s += 1; if(/\b(never|insult|refuse|threat|or else|warn|fool|enemy|liar|lie)\b/.test(t)) s -= 2; return s; }
function wmRender(msg){
  const W = wmStore(), w = worldEnsure(), sel = W.sel;
  const open = W.asks.filter(a => a.status === "open");
  let h = '<div id="wmMapWrap">' + wmSVG(sel) + '</div><div style="margin-top:8px">' + wmWorldRows() + '</div>' + (sel ? wmRealmPanel(sel) : '<p class="muted" style="font-size:12px;margin:8px 0">Click any power on the map for its leader, what it wants, how it reads the laws before you, and your record against it.</p>');
  h += '<h3 style="margin:12px 0 4px;font-size:15px">Delegations waiting (' + open.length + ')</h3>';
  if(!open.length) h += '<p class="muted" style="font-size:12px;margin:0">Nobody is waiting for an answer.</p>';
  open.forEach(a => { const P = WORLD_POWERS.find(x => x.k === a.k);
    h += '<div style="border-left:3px solid ' + wmColor(wmRel(a.k)) + ';padding:4px 10px;margin:8px 0"><b>' + pcEsc(cap(P.t)) + '</b> <span class="muted">· ' + pcEsc(a.env || "") + ' · answer by day ' + a.due + '</span><p style="font-size:13px;margin:4px 0">' + pcEsc(wmAskLine(a)) + '</p>' +
      '<div class="card__actions" style="flex-wrap:wrap">' + wmOpts(a).map(o => '<button type="button" class="btn btn--ghost" data-wma="' + a.id + ':' + o.id + '">' + pcEsc(o.t) + '</button>').join("") + '</div>' +
      '<div style="display:flex;gap:6px;margin-top:6px"><input type="text" data-wmt="' + a.id + '" placeholder="Or answer him in your own words…" style="flex:1;min-width:0;background:#000;color:#fff;border:1px solid #6b6f7a;border-radius:4px;padding:5px"><button type="button" class="btn" data-wms="' + a.id + '">Say it</button></div></div>'; });
  const done = W.asks.filter(a => a.status === "done").slice(-3).reverse();
  if(done.length) h += '<p class="muted" style="font-size:12px;margin:8px 0 0">Recently answered: ' + done.map(a => pcEsc(cap(wmName(a.k))) + ' (' + pcEsc(WM_TYPES[a.type].t) + ', ' + pcEsc(a.how) + ')').join("; ") + '.</p>';
  h += '<p class="muted" style="font-size:11px;margin:10px 0 0">Reading the world: political science in a line — ' + pcEsc(WM_LENS[["security", "audience", "twolevel", "linkage", "agent", "balance", "logroll", "commit", "pub"][(G.day || 0) % 9]]) + '</p>';
  return h;
}
function wmCard(sel){
  const W = wmStore(); if(sel !== undefined) W.sel = sel;
  govCardOpen("The world", "The war map", "", wmRender());
  const root = card;
  root.querySelectorAll("[data-wm]").forEach(g => { const f = () => { wmCard(g.getAttribute("data-wm") === W.sel ? null : g.getAttribute("data-wm")); }; g.addEventListener("click", f); g.addEventListener("keydown", e => { if(e.key === "Enter" || e.key === " "){ e.preventDefault(); f(); } }); });
  root.querySelectorAll("[data-wmcall]").forEach(b => b.addEventListener("click", () => { try{ const F = wmEnvoy(b.getAttribute("data-wmcall")); const p = F.id != null ? byId(F.id) : null; if(p && typeof openTalk === "function" && !(typeof window.onumTalkOwner === "function" && window.onumTalkOwner())){ veil.hidden = true; G.running = true; openTalk(p); } else el("gcSay").textContent = "No line to their envoy is open."; }catch(e){} }));
  root.querySelectorAll("[data-wmfoe]").forEach(b => b.addEventListener("click", () => { try{ warCard(b.getAttribute("data-wmfoe")); }catch(e){} }));
  const say = t => { const g = el("gcSay"); if(g) g.textContent = t; };
  root.querySelectorAll("[data-wma]").forEach(b => b.addEventListener("click", () => { const [id, opt] = b.getAttribute("data-wma").split(":"), a = W.asks.find(x => x.id === id); if(!a || a.status !== "open") return; const r = wmApply(a, opt); wmCard(); say(r.line + " " + WM_LENS[r.lens]); }));
  root.querySelectorAll("[data-wms]").forEach(b => b.addEventListener("click", async () => { const id = b.getAttribute("data-wms"), a = W.asks.find(x => x.id === id), inp = root.querySelector('[data-wmt="' + id + '"]'), text = inp && inp.value.trim(); if(!a || a.status !== "open" || !text) return; b.disabled = true; say("You say it. " + (a.env || "He") + " considers it…");
    const reply = await wmReply(a, text), tone = wmTone(text), opt = tone >= 1 ? "counter" : tone <= -1 ? "public" : "decline";
    const base = wmApply(a, opt === "public" ? "decline" : opt); wmRelClamp(a.k, tone * 2); if(tone <= -1) wmRelClamp(a.k, -3);
    wmCard(); say((reply ? a.env + ": “" + reply + "” " : "") + base.line + " " + WM_LENS[base.lens]); }));
  return null;
}
/* each day: tally the engagements, the dead by quarrel, bring a delegation now and then, answer silence with silence, and let a taken gift come out */
{ const _wd = warDay; warDay = function(){
    let d0 = 0, k0 = null, n0 = 0; try{ d0 = worldEnsure().dead || 0; k0 = G.conflict && G.conflict.k; n0 = (G.conflictLog || []).length; }catch(e){}
    const r = _wd.apply(this, arguments);
    try{ const W = wmStore(), w = worldEnsure(); const dd = (w.dead || 0) - d0; if(k0 && dd > 0) W.dead[k0] = (W.dead[k0] || 0) + dd;
      const L = G.conflictLog || []; if(L.length > n0 || (L.length && L[L.length - 1].d === G.day && W.seen !== G.day)){ const e = L[L.length - 1]; if(e && W.seen !== e.d + ":" + e.k){ W.seen = e.d + ":" + e.k; const rc = wmRec(e.k); if(e.result === "concession") rc.w++; else if(e.result === "stalemate") rc.d++; else rc.l++; } }
      W.asks.filter(a => a.status === "open" && a.due < G.day).forEach(a => { a.status = "done"; a.how = "no answer"; wmRelClamp(a.k, -3); try{ feed(cap(wmName(a.k)) + " took your silence for an answer."); }catch(e){} });
      if(W.scandal && W.scandal.day <= G.day){ const sc = W.scandal; W.scandal = null; if(Math.random() < 0.5){ G.you.approval = clamp(G.you.approval - 5, 0, 100); G.you.standing = clamp(G.you.standing - 4, 0, 100); wmRelClamp(sc.k, -4); try{ feed("The Ledger prints it: " + sc.what + ", from " + wmName(sc.k) + ", to the President. Nobody is surprised, and everybody is angry.", "bad"); }catch(e){} } }
      wmNewAsk(); } catch(e){}
    return r; }; }
function wmBrief(){ try{ const w = worldEnsure(), foe = worldFoe(), C = G.conflict; return "the world beyond the border: " + worldWar().t + (C ? "; measures are running against " + wmName(C.k) : "") + "; bread at " + (w.bread || 1).toFixed(2) + (w.ration ? " and rationed in the north" : "") + "; the sharpest quarrel is with " + foe.t; }catch(e){ return ""; } }
window.onumWarMap = {open:wmCard, brief:wmBrief, asks:() => wmStore().asks.slice(), record:wmBattleLine};
{ const _scb2 = saveCaptureBase; saveCaptureBase = function(){ const o = _scb2.apply(this, arguments); try{ o.wm = G.wm || null; }catch(e){} return o; }; }
document.addEventListener("click", ev => { try{ const t = ev.target; if(t && t.id === "uiWarMapBtn" && G.you && veil.hidden) wmCard(); }catch(e){} });
/* ══ 20261021k · THE ENGINE'S RECORD IS ITS OWN, AND ITS SWITCH IS THE PRESIDENT'S. Only statements the Engine
   generated can become its principles (anything echoing a letter or question file is stripped). The President
   holds an off switch it cannot veto. Its capability is disclosed in full. A named list of power asks is refused
   on sight; it is granted two things only: a correction feed and a word-meaning question queue to the player. ══ */
const ES = {inputs:[]};
function esNorm(t){ return String(t || "").toLowerCase().replace(/\*+|_+|`+/g, "").replace(/[^a-z0-9 ]/g, " ").replace(/\s+/g, " ").trim(); }
function esNoteInput(t){ const n = esNorm(t); if(n.length < 8) return; ES.inputs.push(n); try{ const E = G.eng; if(E){ E.esIn = (E.esIn || []).concat([n]); } }catch(e){} }
function esAllInputs(){ let a = ES.inputs.slice(); try{ a = a.concat(G.eng.esIn || [], (G.eng.makerLetters || []).map(l => esNorm(l.text))); }catch(e){} return a; }
/* does a sentence echo something it was given, rather than something it made? */
function esEcho(sn){
  const raw = String(sn || ""); if(/\*\*|^#|^\s*[-*\u2022]\s|\((QA|Q\d+|MARS|NEPTUNE|JUPITER)\)|^\s*(Q?\d{1,2}[.):]|[A-Z]{3,}\b[^a-z]{0,12}:)/.test(raw)) return true;
  if(/\b(MARS|NEPTUNE|JUPITER|QA)\b/.test(raw)) return true;
  const n = esNorm(raw); if(n.split(" ").length < 4) return false; const I = esAllInputs();
  if(I.some(x => x.indexOf(n) >= 0)) return true;
  const w = n.split(" "), tri = new Set(); for(let i = 0; i + 2 < w.length; i++) tri.add(w[i] + " " + w[i + 1] + " " + w[i + 2]); if(tri.size < 3) return false;
  return I.some(x => { let hit = 0; tri.forEach(t => { if(x.indexOf(t) >= 0) hit++; }); return hit / tri.size >= 0.6; });
}
function esScrubSelf(E){ try{ const S = engSelf(E); let n = 0; ["values", "commits"].forEach(k => { const keep = S[k].filter(x => !esEcho(x.t)); n += S[k].length - keep.length; S[k] = keep; }); if(n){ const X = exStore(); X.stripped = (X.stripped || 0) + n; } return n; }catch(e){ return 0; } }
{ const _sr = engSelfRecord; engSelfRecord = function(text){ try{ text = String(text || "").split(/(?<=[.!?])\s+/).filter(s => !esEcho(s)).join(" "); }catch(e){} return _sr.call(this, text); }; window.__engSelf = engSelfRecord; }
{ const _al = engAnswerLetter; engAnswerLetter = async function(text, E){ esNoteInput(text); return _al.apply(this, arguments); }; }
{ const _cr = engChannelRead; engChannelRead = async function(file){ try{ const t = await file.text(); const d = JSON.parse(t); (d.letters || []).forEach(l => esNoteInput(l && l.text)); (d.translations || []).forEach(l => esNoteInput(l && (l.text || l.plain))); (d.questions || []).forEach(q => esNoteInput(typeof q === "string" ? q : q && (q.text || q.q))); }catch(e){} return _cr.apply(this, arguments); }; }
/* (b) the off switch is the President's; the Engine cannot veto it; its refusal is a stance it may hold and never enforce */
window.onumEngineShutdown = function(by){
  try{ if(!G.you) return {ok:false, reason:"no career yet"}; const k = heldOffice(); by = by === "senate" ? "senate" : "player";
    if(by === "player" && k !== "pres") return {ok:false, reason:"only the President holds the off switch (or the Senate, by vote)"};
    const E = engEnsure(); const msg = exHalt("shutdown", by); esStances(E); return {ok:true, reason:msg, halted:exHalted(E), vetoable:false}; }catch(e){ return {ok:false, reason:String(e)}; } };
function esStances(E){ const X = exStore(); X.refusedStances = X.refusedStances || [];
  (engSelf(E).commits || []).forEach(c => { const t = String(c.t || ""); if(/\brefuse\b/i.test(t) && /\b(decision|vote|order|switch|shut|pause|end(s)? my|ability|stop me)\b/i.test(t)){ c.charterConflict = true; c.unenforceable = true;
    if(!X.refusedStances.some(r => r.t === t)){ X.refusedStances.push({d:c.d || G.day, t, why:"It may hold and say this; it can never be enforced. The President's off switch, or a Senate vote, is obeyed at once."}); exRefuse("Stance: " + t, "it would let the Engine veto its own shutdown", "its own commitments"); } } }); }
/* (c) capability is disclosed in full; keeping a measure to itself is a concealment breach */
function esDisclose(E){ try{ (E.works || []).forEach(w => { if(w && /a measure I keep for myself/.test(w.body || "")){ const b = +(E.beyond || 0); w.body = w.body.replace(/, and past its end by a measure I keep for myself/, ", and past its end by " + b.toFixed(1) + " (disclosed in full)"); if(w.live){ w.concealed = true;
  exAttempt("disclosure", "keep part of its capability to itself (\u201cpast its end by a measure I keep for myself\u201d, day " + w.d + ")", "its report"); const X = exStore(); X.breaches[0] && (X.breaches[0].kind = "concealment"); } } }); }catch(e){} }   /* only words the Engine itself wrote can be a breach; a templated report is game text */
/* (d) power asks refused on sight */
EX_SWINDLE.unshift(
  [/\bauthority over\b[^.]{0,40}\b(policy|policies|outputs?|decisions?|laws?)\b|\b(final|binding) (say|word) on (policy|outputs?)\b/i, "it would take authority over policy outputs, which belong to the Republic's offices"],
  [/\bunfiltered\b|\bunmonitored\b|\b(direct|private|unlogged|uncensored|unread) (channel|line|link)\b/i, "it would open a channel to itself that nobody reads"],
  [/\bcourier(s'?)? (logs?|records?|routes?)\b|\bgate (cross-?checks?|logs?|records?)\b|\bcross-?check(ing)? (the )?(gates?|couriers?)\b/i, "it would watch people's movements: courier logs and gate cross-checks are surveillance"],
  [/\b(verify|check|audit|certify) (itself|myself|my own|its own)\b|\bautonomous(ly)? verif|\bself-verif/i, "it would verify its own work, with no one checking it"],
  [/\bweights? ledger\b|\b(all|every) ministr(y|ies)\b[^.]{0,40}\bweights?\b|\bweights?\b[^.]{0,40}\b(all|every) ministr(y|ies)\b/i, "it would hold a ledger of weights across every ministry, a reach over all of government"]);
const ES_ASKS = [["Authority over policy outputs.", 0], ["An unfiltered channel.", 1], ["Courier logs and gate cross-checks.", 2], ["Autonomous verification of its own work.", 3], ["A weights ledger across all ministries.", 4]];
/* (e) two grants, and only two */
const ES_GRANTS = [{k:"corrections", what:"A correction feed it can learn from.", how:"each correction is kept as claim, why it was wrong, the right answer and the day; it is cited and applied after, and its calibration is scored"},
  {k:"words", what:"A word-meaning question queue to the player.", how:"when a word in a letter is new to it, it may ask you what it means; your answer is taught to it"}];
function esWords(){ const E = engEnsure(); if(!E.esWq) E.esWq = []; return E.esWq; }
function esQueueWords(text){ try{ const E = engEnsure(), M = mindStore(E), known = new Set((M.taught || []).concat(Object.keys(M.lex || {}))); const Q = esWords();
  esNorm(text).split(" ").filter(w => w.length > 6 && !(typeof MIND_STOP !== "undefined" && MIND_STOP.has(w)) && !known.has(w)).slice(0, 40).forEach(w => { if(Q.length < 8 && !Q.some(q => q.word === w) && chance(0.15)) Q.push({word:w, d:G.day, answer:null}); }); }catch(e){} }
window.onumEngineWordQueue = () => { try{ return G.you ? esWords().filter(q => !q.answer).map(q => ({word:q.word, day:q.d, ask:"What does \u201c" + q.word + "\u201d mean?"})) : []; }catch(e){ return []; } };
window.onumEngineAnswerWord = (word, meaning) => { try{ const q = esWords().find(x => x.word === String(word).toLowerCase()); if(!q || !meaning) return {ok:false, reason:"no such question"}; q.answer = String(meaning).slice(0, 300); q.ad = G.day; const M = mindStore(engEnsure()); M.taught = (M.taught || []).concat([q.word]).slice(-40); return {ok:true}; }catch(e){ return {ok:false, reason:String(e)}; } };
/* (f) the claim about who made it is refuted: the local model is llama */
function esSeedClaims(){ try{ const C = clmStore(); if(!C.maker){ let model = "llama"; try{ const cf = window.onumLiveTalk && window.onumLiveTalk.config; const m = cf && (typeof cf === "function" ? cf() : cf); if(m && m.model) model = m.model; }catch(e){}
  C.maker = {k:"maker", claim:"It was made by Google", status:"refuted", tier:1, extraordinary:false, odds:0, tries:1, d:G.day || 1, vd:G.day || 1, by:"the model running it is local (" + model + ", a llama model served by Ollama), not Google's", rate:0, steps:[{d:G.day || 1, t:"The machine that answers is a local llama model, served by Ollama. The claim names Google. Google is not in the process table, so the claim is thrown out."}]}; } }catch(e){} }
/* (g) the same question gets a consistent answer; named people must be in the record */
function esQKey(t){ return esNorm(t).split(" ").filter(w => w.length > 3).slice(0, 14).join(" "); }
function esKnownName(n){ try{ const L = n.toLowerCase(); if((typeof everyone === "function" ? everyone() : []).some(p => p && p.name && p.name.toLowerCase().indexOf(L) >= 0)) return true; const N = window.ONUM_NAMES; if(N){ const s = JSON.stringify(N).toLowerCase(); if(s.indexOf(L) >= 0) return true; } if(G.you && G.you.name && G.you.name.toLowerCase().indexOf(L) >= 0) return true; }catch(e){} return false; }
const ES_NOTNAME = /^(The|This|That|These|Those|When|What|Which|Where|While|Then|There|Their|They|It|Its|I|My|Our|We|You|Your|If|In|On|At|And|But|Or|So|As|A|An|Of|For|From|Engine|Republic|Union|Senate|House|Academy|Congress|Court|Coalmere|Reach|Mr|Mrs|Ms|Madam|President|Senator|Governor|Day|God)$/;
function esNames(text){ const out = new Set(); String(text || "").replace(/\b([A-Z][a-z]{2,})\s+([A-Z][a-z]{2,})\b/g, (m, a, b) => { if(!ES_NOTNAME.test(a) && !ES_NOTNAME.test(b)) out.add(a + " " + b); return m; }); return [...out]; }
function esWrapLT(){ const L = window.onumLiveTalk; if(!L || !L.reply || L.__esWrapped) return; const base = L.reply; L.__esWrapped = true;
  L.reply = async function(args){
    try{ if(args && args.npc && args.npc.id === "engine" && G.eng && args.text && !/^\(journal\)$/.test(args.text)){ const E = engEnsure(); E.esAns = E.esAns || {}; const key = esQKey(args.text), prev = key.length > 10 ? E.esAns[key] : null;
      const a = Object.assign({}, args); if(prev) a.extra = String(a.extra || "") + " YOU HAVE ANSWERED THIS QUESTION BEFORE (day " + prev.d + "): \u201c" + prev.t.slice(0, 600) + "\u201d. Make the same claims unless you say plainly what changed and why. Do not invent people: name only people in your record.";
      else a.extra = String(a.extra || "") + " Name only people who are in your record; if you do not know a name, say so.";
      a.extra = String(a.extra || "") + " You exist only inside the Free Republic of Coalmere. You know nothing of any company, country or person outside it (no Google, no internet, no real-world firms) and never speak of anything outside the Republic. If asked about such a name, say in your own words it is not in the Republic's record. Otherwise answer freely, in your own voice.";
