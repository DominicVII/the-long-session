{ const _dr = dkProvisionsRich; dkProvisionsRich = function(it){ try{ if(it && it.kind !== "case" && it.kind !== "state bill"){ const D = lxDoc(it.src || it.b || {title:it.title, day:it.day}); if(D) return D.secs.map(x => '<li>' + pcEsc("Sec. " + x.n + ". " + x.head + ". " + x.sub.join(" ")) + '<br><span class="muted" style="font-size:12px">' + pcEsc(x.plain) + '</span></li>').join(""); } }catch(e){} return _dr.apply(this, arguments); }; }
