{ const _ds = dkStrike; dkStrike = function(it, i){ if(i >= 100){ const b = dkBillRef(it); if(!b || !b.clauses) return ""; const ci = i - 100; b.strk = b.strk || []; if(b.strk.indexOf(ci) < 0) b.strk.push(ci);
    const n = b.clauses.length || 3; if(b.pos) Object.keys(b.pos).forEach(k => b.pos[k] = Math.round(b.pos[k] * (1 - 0.5 / n))); G.you.influence = clamp((G.you.influence || 0) - 2, 0, 100);
    (b.amends = b.amends || []).push({d:G.day, by:G.you.name, what:"struck the provision on " + b.clauses[ci]}); LX.docs.delete(lxKey(b));
    try{ feed("You move to strike the provision on " + b.clauses[ci] + " from the " + b.title + "."); }catch(e){} return "Moved to strike: " + b.clauses[ci] + ". The count moves."; } return _ds.apply(this, arguments); }; }
{ const _da = dkAmend; dkAmend = function(it){ const r = _da.apply(this, arguments); try{ const b = dkBillRef(it); if(b){ (b.amends = b.amends || []).push({d:G.day, by:G.you.name, what:"cut the appropriation by a third"}); LX.docs.delete(lxKey(b)); } }catch(e){} return r; }; }
{ const _dcl = dkCostLine; dkCostLine = function(it){ try{ const s = it && it.kind !== "case" ? (it.src || dkBillRef(it) || lxSource({title:it.title, day:it.day})) : null; if(s && s.cost){ const c = s.soft ? Math.round(s.cost * 0.67) : s.cost; return "Cost: " + money(c) + (s.soft ? " (cut by amendment from " + money(s.cost) + ")" : "") + ", paid by " + (s.pays || "the general fund") + "."; } }catch(e){} return _dcl.apply(this, arguments); }; }
{ const _di = dkItems; dkItems = function(){ const L = _di.apply(this, arguments); try{ L.forEach(it => { if(it.kind !== "act") return; const s = lxSource({title:it.title, day:+(/day (\d+)/.exec(it.line || "") || [])[1] || null}); if(!s) return; it.src = s; it.sponsor = s.sponsor || it.sponsor; it.line = lxStatus(s).t; }); }catch(e){} return L; }; }
{ const _dcard = dkCard; dkCard = function(i){ const r = _dcard.apply(this, arguments); try{ const acts = card.querySelector(".card__actions:last-of-type"); if(acts && !card.querySelector("[data-lxbook]")){ const b = document.createElement("button"); b.type = "button"; b.className = "btn btn--ghost"; b.setAttribute("data-lxbook", "all"); b.textContent = "The statute book"; acts.insertBefore(b, acts.firstChild);
    const it = dkItems()[i || 0]; const src = it ? (it.src || (it.b === G.bill ? G.bill : null) || lxSource({title:it.title})) : null; if(src && it.kind !== "case" && it.kind !== "state bill"){ const f = document.createElement("button"); f.type = "button"; f.className = "btn"; f.setAttribute("data-lxopen", src === G.bill ? "cal" : lxKey(src)); f.textContent = "Read the full text"; acts.insertBefore(f, acts.firstChild); } } }catch(e){} return r; }; }
{ const _bs = billSheet; billSheet = function(b){ let h = _bs.apply(this, arguments); try{ if(b) h += '<div class="card__actions"><button type="button" class="btn btn--ghost" data-lxopen="' + (b === G.bill ? "cal" : pcEsc(lxKey(b))) + '">Read the full text ▸</button><button type="button" class="btn btn--ghost" data-lxbook="all">The statute book</button></div>'; }catch(e){} return h; }; }
/* the bench: suits on the act's own sections, decided justice by justice; you keep your one vote when you sit on it */
{ const _oca = orgCourtAct; orgCourtAct = function(){ try{ let k = null; try{ k = roleKey(); }catch(e){}
