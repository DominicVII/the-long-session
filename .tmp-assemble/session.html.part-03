    if(o.t === G.you){ try{ m.rel.warmth = clamp((m.rel.warmth || 0) + 10, -100, 100); }catch(e){} } else S.reg[k] = Math.round((S.reg[k] || 0) / 2);
    try{ mindRemember(m, "thought", "I am letting it go with " + surname(o.t.name) + ". Holding it costs more than it is worth."); }catch(e){} return "forgive"; },
