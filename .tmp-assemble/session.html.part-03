    try{ const S = typeof sxdSession === "function" ? sxdSession() : null; if(S){
      const me = x => x === "you" || (G.you && String(x) === String(G.you.id));
      const seated = (S.seats || []).some(x => me(x && (x.personId != null ? x.personId : x)));
      if(strict && seated) return "session";
