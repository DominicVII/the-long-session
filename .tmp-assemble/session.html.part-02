    AMB.L.room = layer("lowpass", 260, 0.5); AMB.L.murmur = layer("bandpass", 520, 0.9); AMB.L.wind = layer("lowpass", 700, 0.4); AMB.L.traffic = layer("lowpass", 160, 0.8); AMB.L.rain = layer("highpass", 1800, 0.6);
