  const topicOf = t => { try{ return tlxTopic(String(t || "")); }catch(e){ return "talk"; } };
  function peerLine(m, peer, text){
    const t = m.traits || {}, temper = t.temper || 40, warmth = (m.rel && m.rel.warmth) || 0, same = !!(peer && peer.party && m.party && peer.party === m.party);
    const P = peer ? sn2(peer.name || "") || "friend" : "friend", low = String(text || ""), A = [];
    if(/\?\s*$/.test(low) && temper < 60) A.push(rnd(["Good question.", "You would have to ask the whip.", "Ask me after the roll call."]));
    const r = Math.random() * 100 + (same ? 25 : -10) + (warmth > 20 ? 10 : 0);
    if(temper > 70 && r < 40) A.push(rnd(OG.hot)); else if(r > 70) A.push(rnd(OG.agree)); else if(r > 40) A.push(rnd(OG.doubt)); else A.push(rnd(OG.oppose));
    const tp = topicOf(low); if(OG.topic[tp] && Math.random() < 0.6) A.push(OG.topic[tp]);
