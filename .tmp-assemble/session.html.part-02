  window.addEventListener("keydown", e => { if(e.ctrlKey && e.shiftKey && (e.key === "K" || e.key === "k")){ e.preventDefault(); const C = document.getElementById("ltChat"); if(C && !C.hidden) chatClose(); else chatOpen(); } }, true);
