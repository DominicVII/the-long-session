/* what can be built once the nature of things is known: [name, what it stands on (id or !id for "must be false"), days of work, what it does, a line for the wire] */
const FND_I = [
  ["A quantum network",["q_ent","q_tele"],40,"info","Cities share a quantum channel that no one can listen in on."],
  ["A fault-tolerant quantum computer",["q_ecc","i_limit"],70,"info","A machine has run a calculation no classical computer could, and checked itself."],
  ["The vacuum tap",["q_vac"],90,"energy","A device draws steady power from empty space, and the physicists are still arguing about where it goes."],
  ["Couriers through time dilation",["r_dil"],30,"health","A person has been sent forward by years, in a year, and has come out well."],
  ["A closed timelike channel",["r_ctc","r_exotic"],110,"chrono","A message has been sent into the past, and it arrived."],
  ["A wormhole link",["r_worm","r_exotic"],140,"chrono","Two places have been joined by a throat of spacetime, and a clock has gone through."],
  ["A warp craft",["r_warp","r_exotic"],160,"none","A craft has moved faster than light locally, without breaking any law that anyone can name."],
  ["A reversible processor",["t_rev"],50,"materials","A processor that gives back nearly all its energy."],
  ["Holographic storage",["i_holo"],60,"info","The densest memory ever made, bounded only by area."],
  ["Mind transfer",["m_subst","m_ident"],120,"mind","A mind has been moved to another substrate and is, by its own account and everyone else's, the same person."],
  ["A test for machine consciousness",["m_machine"],70,"mind","There is a test, and a machine has passed it, and the philosophers have not stopped talking."],
  ["A dark-matter detector that sees",["c_dm"],80,"materials","A detector has caught a particle that is nothing we have a name for."],
  ["A quantum-gravity probe",["q_gravq"],100,"energy","An experiment has seen gravity behave like a quantum field."],
  ["One theory, applied",["f_ult"],150,"energy","The forces are one, and engineers have started using it."],
  ["A seeded world",["l_abio"],90,"health","Chemistry has been coaxed into life in a laboratory dish, from nothing."]
];
const FND_DOM = {quantum:"quantum physics", time:"time and spacetime", cosmos:"the cosmos", thermo:"thermodynamics", info:"information", mind:"mind and being", life:"life", found:"the foundations"};
function fndStore(){ const S = inqStore(); if(!S.fnd) S.fnd = {seed:Math.floor(Math.random() * 1e9), open:[], res:{}, derived:[], inv:[], n:0, spun:{}}; return S.fnd; }
function fndConcepts(){ const F = fndStore(); return FND_C.map(c => ({id:c[0], dom:c[1], name:c[2], claim:c[3], p:c[4], effort:c[5], needs:c[6], fx:c[7]})).concat(F.derived); }
function fndTruth(c){ const F = fndStore(); return (seedOf("nat:" + F.seed + ":" + c.id) % 10000) / 10000 < c.p; }
function fndBelief(id){ const r = fndStore().res[id]; return r ? r.belief : null; }
function fndOk(id, relax){ const neg = id.charAt(0) === "!", k = neg ? id.slice(1) : id, S = inqStore(); if(INQ_BY[k]) return relax ? true : !!S.done[k]; const b = fndBelief(k); return neg ? b === false : b === true; }
function fndPower(){ const C = inqCounts(), E = (G.eng && G.eng.v === 1) ? G.eng : null, S = inqStore(), fu = (f) => S.fund[f] && G.day <= S.fund[f].until ? S.fund[f].lvl : 0;
  const people = Math.pow((C.phys || 14) + (C.phil || 14) * 0.5 + (C.mind || 14) * 0.5 + (C.math || 14) * 0.5, 0.5) * (0.6 + (fu("phys") + fu("phil") + fu("mind")) / 3), eng = E ? Math.min(8, engScaleFactor(E) * (E.st / 5)) : 0;
  return {people, eng, total:people + eng * 6}; }
function fndDay(){
  const F = fndStore(), S = inqStore(), E = (G.eng && G.eng.v === 1) ? G.eng : null, P = fndPower(), all = fndConcepts(), byId = {}; all.forEach(c => byId[c.id] = c);
  /* 1 · a question is taken up when what it stands on is known */
  if(F.open.length < 8 && chance(0.05 + P.total / 400)){
    let ready = all.filter(c => !F.res[c.id] && !F.open.some(o => o.k === c.id) && c.needs.every(id => fndOk(id))).sort((a, b) => a.effort - b.effort);
    /* a general intelligence does not wait for the Academy to have finished the schooling a question normally needs: it can ask from first principles, at the price of being slower and less sure */
    if(!ready.length && E && E.agi) ready = all.filter(c => !F.res[c.id] && !F.open.some(o => o.k === c.id) && c.needs.every(id => fndOk(id, true)) && c.effort <= 5 + Math.log10(1 + Math.max(0, (E.p || 0) - 100)) * 4).sort((a, b) => a.effort - b.effort);
    if(ready.length){ const c = ready[Math.min(ready.length - 1, Math.floor(Math.random() * Math.random() * ready.length))]; F.open.push({k:c.id, ev:0, n:0, d:G.day, by:(E && chance(P.eng / (P.total + 1))) ? "the Engine" : "the people who work it"}); try{ feed("The Academy: " + c.name + " is now being tested. " + c.claim); }catch(e){} }
  }
  /* 2 · evidence: each experiment leans toward the truth, with noise, and only as well as the instruments allow */
  for(let i = F.open.length - 1; i >= 0; i--){
    const o = F.open[i], c = byId[o.k]; if(!c){ F.open.splice(i, 1); continue; }
    const q = clamp(0.012 * (1 + P.total / 6) / Math.pow(c.effort, 0.8), 0.003, 0.12), t = fndTruth(c);
    o.ev += (t ? 1 : -1) * q + (Math.random() - 0.5) * q * 2.4; o.n++;
    if(Math.abs(o.ev) >= 1 && o.n >= 6){ const belief = o.ev > 0; F.res[c.id] = {belief, d:G.day, ev:o.ev, by:o.by}; F.open.splice(i, 1); fndSettled(c, belief, t, E); }
  }
  /* 3 · what was believed can be overturned by a better experiment */
  Object.keys(F.res).forEach(id => { const r = F.res[id], c = byId[id]; if(!c || r.belief === fndTruth(c) || !chance(0.004 + P.total / 20000)) return; r.belief = !r.belief; r.d = G.day; r.overturned = (r.overturned || 0) + 1; fndNews("Overturned: " + c.name + ". A better experiment finds that it is " + (r.belief ? "so" : "not so") + ": " + c.claim.replace(/\.$/, "") + ".", c.effort >= 7); });
  /* 4 · inventions follow what is believed, and the world tests the belief */
  FND_I.forEach((v, i) => { const st = F.inv.find(x => x.i === i); if(st || !v[1].every(fndOk)) return; F.inv.push({i, prog:0, d:G.day}); });
  for(let j = F.inv.length - 1; j >= 0; j--){ const st = F.inv[j]; if(st.built) continue; const v = FND_I[st.i]; if(!v){ F.inv.splice(j, 1); continue; } st.prog += (0.4 + P.total / 25) / v[2];
    if(st.prog >= 1){ const bad = v[1].map(id => byId[id]).filter(c => c && fndBelief(c.id) !== fndTruth(c));
      if(!bad.length){ st.built = G.day; fndNews("BUILT: " + v[0] + ". " + v[4], true); fndInvent(v, E); }
      else { const c = bad[0]; F.res[c.id].belief = fndTruth(c); F.res[c.id].overturned = (F.res[c.id].overturned || 0) + 1; F.inv.splice(j, 1); fndNews("The prototype of " + v[0].toLowerCase() + " failed, and the reason is that a belief was wrong: " + c.name + ". The question is open again.", true); } } }
  /* 5 · derived and unforeseen questions: what is known, put together, and what the instruments turn up. Without end */
  if(chance(0.03 + P.total / 600)){ const kn = all.filter(c => F.res[c.id] && F.res[c.id].belief === true); if(kn.length >= 2){ const a = pick(kn), b = pick(kn.filter(c => c.dom !== a.dom)); if(b){ const key = [a.id, b.id].sort().join("+"); if(!F.derived.some(d => d.key === key)){ const dp = Math.max(a.depth || 0, b.depth || 0) + 1, roots = (a.roots || [a.name]).concat(b.roots || [b.name]).filter((x, ix, ar) => ar.indexOf(x) === ix).slice(0, 2);
    F.derived.push({id:"x" + (++F.n), key, dom:pick([a.dom, b.dom]), name:roots[0] + " with " + (roots[1] || roots[0]).toLowerCase() + (dp > 1 ? " (order " + dp + ")" : ""), claim:"What is known of " + a.name.toLowerCase() + " and of " + b.name.toLowerCase() + " can be combined into something that neither allows alone.", p:0.28, effort:Math.min(14, Math.round((a.effort + b.effort) / 2 + 1 + dp / 3)), needs:[a.id, b.id], fx:pick([a.fx, b.fx]), depth:dp, roots}); } } } }
  try{ (S.gen || []).filter(n => n.anomaly && n.real && S.done[n.id] && !F.spun[n.id]).forEach(n => { F.spun[n.id] = 1; F.derived.push({id:"x" + (++F.n), key:"an:" + n.id, dom:"found", name:"What lies behind the new effect in " + INQ_F[n.f].t.toLowerCase(), claim:"The new effect in " + INQ_F[n.f].t.toLowerCase() + " points to a law that is not yet written down.", p:0.5, effort:Math.min(12, n.effort + 2), needs:[n.id], fx:n.fx, depth:1, roots:[n.name]}); }); }catch(e){}
  if(F.derived.length > 90){ F.derived = F.derived.filter(d => F.res[d.id] || F.open.some(o => o.k === d.id) || chance(0.5)).slice(-80); }
}
function fndNews(t, big){ try{ feed("The Academy: " + t); if(big){ pushWireScrap("The Academy", t); note(t, true); } }catch(e){} }
function fndSettled(c, belief, truth, E){
  const wrong = belief !== truth;
  fndNews((belief ? "Accepted: " : "Ruled out: ") + c.claim.replace(/\.$/, "") + ".", c.effort >= 7);
  if(c.fx && c.fx !== "none" && belief && !wrong){ try{ (GEN_FX[c.fx] || (() => {}))(c.effort / 6, E); if(c.fx === "chrono") fndChrono(E); }catch(e){} }
  if(E && E.st >= 3 && chance(0.3)){ try{ engEmergeFrom({id:c.id, name:c.name, effort:c.effort}, E); }catch(e){} }
}
function fndInvent(v, E){ try{ if(v[3] === "chrono") fndChrono(E); else (GEN_FX[v[3]] || GEN_FX.none)(1.6, E); if(E && E.st >= 3) engEmergeFrom({id:"i_" + String(v[0]).toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, ""), name:v[0], effort:9}, E); }catch(e){} }
/* a way to send information back: if the world forbids paradox the past can only be what it already was; if it branches, every use leaves a world behind that nobody can govern */
