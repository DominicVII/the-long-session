    [-1.6, -0.7, 0.9, 1.7].forEach((x, i) => { addBox(cream, x, 1.15, cz - 0.55, 0.3, 0.012, 0.22, i * 0.3, true); addCyl(brass, x + 0.26, 1.2, cz - 0.52, 0.025, 0.07); addCyl(matCol(0x1a1c20, .4), x + 0.26, 1.23, cz - 0.52, 0.012, 0.04); });
