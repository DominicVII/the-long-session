    }catch(e){ try{ console.warn("NEPTUNE-CLARITY inbox", e); }catch(e2){} return orig.apply(this, arguments); }
  });
  /* the phone's Mail tab uses the same sectioned inbox, re-rendered in place so it never jumps to the top */
  wrap("phoneMailHtml", () => phoneMailHtml, f => { phoneMailHtml = f; }, orig => function(){ try{ if(G.mail && G.mail.length) return '<div id="clPhoneInbox" class="phone__scroll"></div>'; }catch(e){} return orig.apply(this, arguments); });
  wrap("phoneCard", () => phoneCard, f => { phoneCard = f; }, orig => function(){
    const r = orig.apply(this, arguments);
