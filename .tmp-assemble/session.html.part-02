  ["ph6","phys","Special relativity","s",["ph5"],5,"The speed of light is the same for everyone, so time and space bend to keep it so.","Whose clock is right?"],
  ["ph7","phys","The quantum of action","s",["ph3","ph5","i_spec"],5,"Energy comes in packets: the first crack in classical physics.","Why does a hot body glow the way it does?"],
  ["ph8","phys","Quantum mechanics","s",["ph7","m6"],7,"States, amplitudes and probabilities govern the small. Atoms are stable because of it.","What is an atom doing when nobody is looking?"],
  ["ph9","phys","General relativity","s",["ph6","m6","m4"],7,"Gravity is the curvature of spacetime by matter and energy.","What is gravity?"],
  ["ph10","phys","Quantum field theory","s",["ph8","ph6"],8,"Particles are excitations of fields; forces are exchanges between them.","Why are all electrons identical?"],
