  gateAdd(g, gold, x, pierH + 0.2, z + off * (d / 2 + 0.05), gap * 0.12, 0.34, 0.1);    /* keystone */
  const plate = new THREE.Mesh(new THREE.PlaneGeometry(Math.min(span - 0.5, 4.6), 1.15), new THREE.MeshStandardMaterial({map:gatePlate(title, sub), roughness:0.5, emissive:0xffffff, emissiveMap:gatePlate(title, sub), emissiveIntensity:0.0})); plate.position.set(x, pierH + 0.68, z + off * (d / 2 + 0.17)); if(off < 0) plate.rotation.y = Math.PI; g.add(plate);
