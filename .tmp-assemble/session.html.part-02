    PAD.vx = PAD.vz = PAD.turn = PAD.tilt = 0;
  }

  /* looking eases in and eases out rather than snapping on and off */
  cam.yawVel = smooth(cam.yawVel, turn * 1.15, 0.012, dt);
  cam.yaw += cam.yawVel * dt;
  cam.pitchVel = smooth(cam.pitchVel, tilt * 0.85, 0.012, dt);
  cam.pitch = clamp(cam.pitch + cam.pitchVel * dt, -1.15, 1.15);

  /* forward is the camera's -Z; right is its +X, which with the half-turn
     offset comes out as (-cos, sin). Getting this wrong mirrors A and D. */
  const f = _tkF, r = _tkR; f.x = Math.sin(cam.yaw); f.z = Math.cos(cam.yaw); r.x = -f.z; r.z = f.x;   /* 20261021b: reused */
  /* walking while seated stands you up, rather than dragging the chair */
  if(G.you && G.you.sitting && (vx || vz)){
    G.you.sitting = false;
    try{ if(document.activeElement && document.activeElement.blur) document.activeElement.blur(); }catch(e){}
    feed("You get up.");
    if(G._deskWasBare){
      G._deskWasBare = false;
      try{ setImmersive(true); }catch(e){}
    }
  }
  let _ws = 1; try{ const v = settingsState && settingsState.walkSpeed; _ws = v === "slow" ? 0.78 : v === "fast" ? 1.22 : 1; }catch(e){}
  const top = (sprint ? 1.48 : 0.88) * _ws;
  const mag = Math.hypot(vx, vz) || 1;
  const wantX = (f.x*vz + r.x*vx) / mag * top * (vx||vz ? 1 : 0);
  const wantZ = (f.z*vz + r.z*vx) / mag * top * (vx||vz ? 1 : 0);
  const moveDt = Math.min(dt, 0.12);   /* time-based: the same metres per second at 15 fps or 144 */
  const catchUp = 1 - Math.exp(-((vx||vz) ? 5.5 : 9) * moveDt);
  cam.vx += (wantX - cam.vx) * catchUp;
  cam.vz += (wantZ - cam.vz) * catchUp;
  cam.vx = clamp(cam.vx, -top, top);
  cam.vz = clamp(cam.vz, -top, top);
