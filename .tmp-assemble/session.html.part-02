/* a plinth with mouldings and a name plate; h is the height of the die */
function statuePlinthOps(w, h){ return [["box", 0, 0.12, 0, w + 0.5, 0.24, w + 0.5, 0xb9b09c, 0, 0, 0], ["box", 0, 0.34, 0, w + 0.3, 0.2, w + 0.3, 0xd6cfbe, 0, 0, 0], ["box", 0, 0.44 + h / 2, 0, w, h, w, 0xe2dccd, 0, 0, 0], ["box", 0, 0.44 + h + 0.07, 0, w + 0.22, 0.14, w + 0.22, 0xece6d8, 0, 0, 0], ["box", 0, 0.44 + h + 0.18, 0, w + 0.1, 0.08, w + 0.1, 0xd6cfbe, 0, 0, 0], ["box", 0, 0.44 + h * 0.5, w / 2 + 0.012, w * 0.52, 0.24, 0.02, 0xb08b45, 0, 0, 0]]; }
/* the same figure as ordinary meshes, for a room */
function statueRoom(x, z, kind, dieH, ry, plateTitle, plateSub){
  const g = new THREE.Group(); g.position.set(x, 0, z); g.rotation.y = ry || 0;
  const bronze = kind !== "founder" && kind !== "scholar";
  const mats = new Map(); const mat = hex => { if(!mats.has(hex)) mats.set(hex, new THREE.MeshStandardMaterial({color:hex, roughness:bronze ? 0.5 : 0.62, metalness:bronze ? 0.55 : 0.02})); return mats.get(hex); };
  const base = statuePlinthOps(0.9, dieH), top = 0.44 + dieH + 0.26; const gd = THREE.CylinderGeometry;
  const add = (o, dy) => { const t = o[0]; let m;
    if(t === "box"){ m = new THREE.Mesh(UNIT.box, o[7] === 0xb08b45 ? new THREE.MeshStandardMaterial({color:0xb08b45, roughness:0.35, metalness:0.8}) : new THREE.MeshStandardMaterial({color:o[7], roughness:0.85})); if(dy) m.material = mat(o[7]); m.position.set(o[1], o[2] + dy, o[3]); m.scale.set(o[4], o[5], o[6]); m.rotation.set(o[9], o[8], o[10]); }
    else if(t === "cyl"){ m = new THREE.Mesh(new gd(o[4] * o[6], o[4], o[5], o[8]), mat(o[7])); m.position.set(o[1], o[2] + dy, o[3]); }
    else if(t === "ico"){ m = new THREE.Mesh(UNIT.sph, mat(o[7])); m.position.set(o[1], o[2] + dy, o[3]); m.scale.set(o[4] * 2, o[5] * 2, o[6] * 2); }
    else if(t === "along"){ const a = new THREE.Vector3(o[1], o[2] + dy, o[3]), b = new THREE.Vector3(o[4], o[5] + dy, o[6]), L = a.distanceTo(b); m = new THREE.Mesh(new gd(o[7], o[7] * 0.85, L, 8), mat(o[8])); m.position.copy(a).add(b).multiplyScalar(0.5); m.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), b.clone().sub(a).normalize()); }
    if(m){ m.castShadow = false; m.receiveShadow = true; g.add(m); } };
  base.forEach(o => add(o, 0)); statueOps(kind).forEach(o => add(o, top));
  if(plateTitle){ try{ const pl = new THREE.Mesh(new THREE.PlaneGeometry(0.78, 0.26), new THREE.MeshStandardMaterial({map:gatePlate(plateTitle, plateSub || ""), roughness:0.5})); pl.position.set(0, 0.44 + dieH * 0.5, 0.9 / 2 + 0.03); g.add(pl); }catch(e){} }
  roomGroup.add(g); return g;
}

function corridorStatues(d, hw){
  try{
    const left = (DOORS.corridor || []).filter(dr => dr.side === "left"), zs = corridorSafeZs(d, left, 2.45);
    roomGroup.children.forEach(o => { if(o.userData.vStat || !o.position) return; const p = o.position; if(Math.abs(p.x - (-hw + 1.55)) < 0.03 && ((Math.abs(p.y - 0.12) < 0.02 && Math.abs(o.scale.x - 0.62) < 0.03) || (Math.abs(p.y - 1.05) < 0.02 && Math.abs(o.scale.x - 0.42) < 0.03) || (Math.abs(p.y - 2.05) < 0.02 && Math.abs(o.scale.x - 0.30) < 0.03))){ o.visible = false; o.userData.vStat = 1; } });
    const done = roomGroup.userData.vStatues; if(done) return; roomGroup.userData.vStatues = 1;
    const kinds = ["consul", "founder", "bearer", "scholar", "founder"], plates = [["THE FIRST CONSUL", "Dominic Zachary Taylor"], ["A FOUNDER", "of the Republic"], ["THE TORCH", "of the Second Order"], ["A SCHOLAR", "of the Charter"], ["A FOUNDER", "of the Republic"]];
    zs.forEach((z, i) => { const k = i % kinds.length; statueRoom(-hw + 1.6, z, kinds[k], k === 0 ? 1.35 : 0.9, Math.PI / 2, plates[k][0], plates[k][1]); });
  }catch(e){ try{ console.warn("corridor statues", e); }catch(x){} }
}
/* ══ 20261016k · the Statuary Corridor and the Press Gallery, furnished properly ══ */
function rgR(m, ax, v){ m.rotation[ax] = v; m.updateMatrix(); return m; }
function rgCanvasTex(w, h, draw, rep){ const c = document.createElement("canvas"); c.width = w; c.height = h; const g = c.getContext("2d"); draw(g, w, h); const t = new THREE.CanvasTexture(c); try{ t.encoding = THREE.sRGBEncoding; }catch(e){} t.wrapS = t.wrapT = THREE.RepeatWrapping; try{ t.anisotropy = 4; }catch(e){} if(rep) t.repeat.set(rep[0], rep[1]); return t; }
function rgWeave(g, w, h, a){ for(let i = 0; i < w * h / 90; i++){ g.fillStyle = "rgba(" + (Math.random() < 0.5 ? "255,255,255" : "0,0,0") + "," + (Math.random() * a) + ")"; g.fillRect(Math.random() * w, Math.random() * h, 1 + Math.random() * 2, 1 + Math.random() * 3); } }
function rgRunnerTex(len){
  const W = 192, H = Math.round(W * len / 2.3);
  return rgCanvasTex(W, H, (g, w, h) => {
    g.fillStyle = "#5e1b27"; g.fillRect(0, 0, w, h); rgWeave(g, w, h, 0.07);
    /* border: navy, gold, cream, gold */
    const band = (x, wd, col) => { g.fillStyle = col; g.fillRect(x, 0, wd, h); g.fillRect(w - x - wd, 0, wd, h); };
    band(0, 16, "#1c2742"); band(16, 3, "#c9a24a"); band(19, 6, "#ead9b0"); band(25, 3, "#c9a24a"); band(28, 9, "#44141f");
    /* a vine of small leaves down each side of the field */
    for(let y = 6; y < h; y += 22){ [[44, 1], [w - 44, -1]].forEach(([x, s]) => { g.fillStyle = "#c9a24a"; g.beginPath(); g.ellipse(x, y, 6, 3, s * 0.7, 0, 6.3); g.fill(); g.fillStyle = "#2d5a3d"; g.beginPath(); g.ellipse(x + s * 6, y + 9, 5, 2.4, -s * 0.6, 0, 6.3); g.fill(); }); }
    /* the medallion chain down the middle */
    const step = 150, cx = w / 2;
    for(let y = step / 2; y < h; y += step){
      g.fillStyle = "#1c2742"; g.beginPath(); g.moveTo(cx, y - 56); g.lineTo(cx + 38, y); g.lineTo(cx, y + 56); g.lineTo(cx - 38, y); g.closePath(); g.fill();
      g.strokeStyle = "#c9a24a"; g.lineWidth = 3; g.stroke();
      g.fillStyle = "#ead9b0"; g.beginPath(); g.moveTo(cx, y - 34); g.lineTo(cx + 22, y); g.lineTo(cx, y + 34); g.lineTo(cx - 22, y); g.closePath(); g.fill();
      g.fillStyle = "#8a1f2c"; for(let k = 0; k < 8; k++){ const a = k * Math.PI / 4; g.beginPath(); g.moveTo(cx, y); g.lineTo(cx + Math.cos(a) * 15, y + Math.sin(a) * 15); g.lineTo(cx + Math.cos(a + 0.4) * 6, y + Math.sin(a + 0.4) * 6); g.fill(); }
      g.fillStyle = "#c9a24a"; g.beginPath(); g.arc(cx, y, 4, 0, 6.3); g.fill();
      if(y + step < h){ g.fillStyle = "#c9a24a"; [0.3, 0.5, 0.7].forEach(f => { g.beginPath(); g.arc(cx, y + step * f + 8, 3, 0, 6.3); g.fill(); }); }
    }
    /* tasselled ends */
    g.fillStyle = "#ead9b0"; for(let x = 2; x < w; x += 5){ g.fillRect(x, 0, 2, 7); g.fillRect(x, h - 7, 2, 7); }
  });
}
function rgDiscTex(){
  return rgCanvasTex(256, 256, (g, w, h) => {
    g.clearRect(0, 0, w, h); const c = w / 2;
    g.fillStyle = "#2c3a30"; g.beginPath(); g.arc(c, c, c - 2, 0, 6.3); g.fill(); g.fillStyle = "#e7dfcb"; g.beginPath(); g.arc(c, c, c - 20, 0, 6.3); g.fill();
    g.strokeStyle = "#b08b45"; g.lineWidth = 4; g.beginPath(); g.arc(c, c, c - 14, 0, 6.3); g.stroke(); g.beginPath(); g.arc(c, c, c - 54, 0, 6.3); g.stroke();
    g.fillStyle = "#6a2430"; for(let i = 0; i < 16; i++){ const a = i * Math.PI / 8, r0 = 40, r1 = i % 2 ? 78 : 104; g.beginPath(); g.moveTo(c + Math.cos(a - 0.12) * r0, c + Math.sin(a - 0.12) * r0); g.lineTo(c + Math.cos(a) * r1, c + Math.sin(a) * r1); g.lineTo(c + Math.cos(a + 0.12) * r0, c + Math.sin(a + 0.12) * r0); g.closePath(); g.fill(); }
    g.fillStyle = "#b08b45"; g.beginPath(); g.arc(c, c, 18, 0, 6.3); g.fill(); g.fillStyle = "#2c3a30"; g.beginPath(); g.arc(c, c, 9, 0, 6.3); g.fill();
  });
}
function rgFlat(tex, x, y, z, w, d, ry){ const m = new THREE.Mesh(UNIT.plane, new THREE.MeshStandardMaterial({map:tex, roughness:0.95, transparent:true})); m.rotation.x = -Math.PI / 2; m.rotation.z = ry || 0; m.position.set(x, y, z); m.scale.set(w, d, 1); m.receiveShadow = true; roomGroup.add(m); return m; }
function rgHideNear(test){ try{ roomGroup.children.forEach(o => { if(!o.userData.rgHid && o.position && test(o)){ o.visible = false; o.userData.rgHid = 1; } }); }catch(e){} }
function corridorRich(w, d, h, hw){
  try{
    if(roomGroup.userData.rgCorridor){ return; } roomGroup.userData.rgCorridor = 1;
    const brass = matCol(0xb08b45, .35, .8), oak = matCol(0x5a3b24, .6), dark = matCol(0x1d1f26, .6), leather = matCol(0x4a1d22, .7), marble = matCol(0xd9d4c6, .5), glass = new THREE.MeshStandardMaterial({color:0xcfe3ee, roughness:0.05, metalness:0.1, transparent:true, opacity:0.22});
    const glowM = new THREE.MeshStandardMaterial({color:0xfff2d4, emissive:0xffd9a0, emissiveIntensity:0.85, roughness:0.4});
    /* the runner: the old stretched rug goes, a proper one with a border, a medallion chain and tassels takes its place */
    rgHideNear(o => Math.abs(o.position.x) < 0.01 && Math.abs(o.position.y - 0.003) < 0.002 && Math.abs(o.scale.x - 2.2) < 0.05);
    const L = d - 3.0; rgFlat(rgRunnerTex(L), 0, 0.006, d / 2, 2.3, L);
    [4.2, d - 4.2].forEach(z => rgFlat(rgDiscTex(), 0, 0.004, z, 4.6, 4.6));
    /* sconces between the columns, and brass lamp globes down the centre of the ceiling */
    const lz = corridorSafeZs(d, (DOORS.corridor || []).filter(x => x.side === "left"), 2.45), rzs = corridorSafeZs(d, (DOORS.corridor || []).filter(x => x.side === "right"), 2.45);
    lz.forEach(z => propSconceDecor(-hw + 0.1, 2.7, z + 1.4, Math.PI / 2)); rzs.forEach(z => propSconceDecor(hw - 0.1, 2.7, z + 1.4, -Math.PI / 2));
    [6, 13, 20].forEach(z => { addCyl(brass, 0, h - 0.65, z, 0.014, 1.3); addCyl(brass, 0, h - 0.05, z, 0.36, 0.05); addCyl(brass, 0, h - 1.38, z, 0.2, 0.06); const g = addSphere(glowM, 0, h - 1.62, z, 0.27, 0.34, 0.27); g.castShadow = false; addCyl(brass, 0, h - 1.9, z, 0.07, 0.1); addSphere(brass, 0, h - 1.97, z, 0.05); });
    /* benches and display cases in the bays between the columns on the right-hand wall */
    const rd = (DOORS.corridor || []).filter(x => x.side === "right").map(x => x.at * d), bays = [];
    for(let i = 0; i < rzs.length - 1; i++){ const mid = (rzs[i] + rzs[i + 1]) / 2; if(rd.every(z => Math.abs(z - mid) > 1.8)) bays.push(mid); }
    bays.forEach((z, i) => {
      if(i % 2 === 0){
        addBox(oak, hw - 1.05, 0.46, z, 0.52, 0.07, 1.7); addBox(leather, hw - 1.05, 0.52, z, 0.46, 0.06, 1.6); addBox(oak, hw - 1.3, 0.82, z, 0.07, 0.66, 1.7); [-0.75, 0.75].forEach(o => { addBox(oak, hw - 1.05, 0.22, z + o, 0.46, 0.44, 0.07); addCyl(brass, hw - 1.05, 0.03, z + o, 0.05, 0.05); });
        try{ propPlaque(hw - 0.04, 1.35, z, -Math.PI / 2, "Gift of the Second Order", "1st session", 0.6, 0.16); }catch(e){}
      } else {
        addBox(marble, hw - 0.6, 0.45, z, 0.7, 0.9, 1.3); addBox(brass, hw - 0.6, 0.92, z, 0.76, 0.04, 1.36); const gl = addBox(glass, hw - 0.6, 1.45, z, 0.62, 1.0, 1.2, 0, true); gl.castShadow = false;
        addBox(brass, hw - 0.6, 1.96, z, 0.7, 0.05, 1.3); addBox(matCol(0x6a1f2b, .85), hw - 0.6, 0.98, z, 0.6, 0.04, 1.1);
        addBox(matCol(0xe8dcc0, .8), hw - 0.6, 1.04, z - 0.2, 0.3, 0.02, 0.4, 0.12); addBox(matCol(0x6a4a2a, .5), hw - 0.6, 1.1, z + 0.28, 0.14, 0.12, 0.34); rgR(addCyl(brass, hw - 0.6, 1.07, z + 0.28, 0.035, 0.12), "z", Math.PI / 2);
        try{ propPlaque(hw - 0.04, 1.35, z, -Math.PI / 2, "The first ballot box", "Case 4", 0.6, 0.16); }catch(e){}
      } });
    /* the grandfather clock at the back, a water fountain at the front, an umbrella stand by the steps door, ferns at both ends */
    addBox(oak, hw - 0.75, 1.3, d - 2.3, 0.62, 2.6, 0.42); addBox(oak, hw - 0.75, 2.66, d - 2.3, 0.7, 0.1, 0.5); rgR(addCyl(matCol(0xf3ecd9, .5), hw - 1.07, 2.1, d - 2.3, 0.2, 0.02), "z", Math.PI / 2); addBox(glass, hw - 1.06, 1.15, d - 2.3, 0.02, 1.2, 0.26, 0, true); rgR(addCyl(brass, hw - 1.04, 1.15, d - 2.3, 0.03, 0.9), "x", 0); addSphere(brass, hw - 1.04, 0.7, d - 2.3, 0.07); addSphere(brass, hw - 0.75, 2.84, d - 2.3, 0.07);
    addBox(marble, hw - 0.28, 0.9, 4.1, 0.5, 0.18, 0.7); addBox(marble, hw - 0.3, 0.41, 4.1, 0.3, 0.82, 0.4); addBox(brass, hw - 0.18, 1.05, 4.1, 0.1, 0.12, 0.08); addCyl(brass, hw - 0.3, 0.93, 4.1, 0.18, 0.02); addBox(marble, hw - 0.12, 1.0, 4.1, 0.2, 0.6, 0.5);
    addCyl(brass, hw - 0.7, 0.3, 1.6, 0.18, 0.6); [0x1c2742, 0x5a1f24, 0x2a2f33].forEach((c, i) => { const u = addCyl(matCol(c, .7), hw - 0.78 + i * 0.07, 0.72, 1.55 + i * 0.05, 0.022, 0.78); u.rotation.z = (i - 1) * 0.18; addSphere(brass, hw - 0.78 + i * 0.07 + (i - 1) * 0.07, 1.12, 1.55 + i * 0.05, 0.03); });
    [[-hw + 1.0, 1.9], [hw - 1.0, 1.9], [-hw + 1.0, d - 1.9], [hw - 1.0, d - 1.9]].forEach(p => { try{ propPlant(p[0], p[1], 1.55); }catch(e){} });
    /* radiators under the left wall and a fire cabinet by the back door */
    [7.2, 17.4].forEach(z => { addBox(matCol(0x2a2d33, .5), -hw + 0.12, 0.38, z, 0.14, 0.58, 1.2); for(let i = 0; i < 7; i++) addBox(matCol(0x1a1c20, .6), -hw + 0.2, 0.38, z - 0.5 + i * 0.17, 0.02, 0.46, 0.05, 0, true); });
    { const fz = d - 6.4;   /* 20261030ag: was d - 4.4, which is the Senate door (0.85 d): the cabinet stood on its frame as a pink panel */
      addBox(matCol(0x5e1518, .55), hw - 0.12, 1.3, fz, 0.14, 0.7, 0.44); addBox(glass, hw - 0.2, 1.3, fz, 0.02, 0.55, 0.34, 0, true); addBox(brass, hw - 0.2, 1.0, fz, 0.02, 0.05, 0.2); }
  }catch(e){ try{ console.warn("corridor rich", e); }catch(x){} }
}
function rgPressCarpet(){
  return rgCanvasTex(256, 256, (g, w, h) => {
    g.fillStyle = "#1c2742"; g.fillRect(0, 0, w, h); rgWeave(g, w, h, 0.09);
    g.strokeStyle = "rgba(201,162,74,.5)"; g.lineWidth = 2; for(let y = 0; y <= h; y += 64){ g.beginPath(); g.moveTo(0, y); g.lineTo(w, y); g.stroke(); } for(let x = 0; x <= w; x += 64){ g.beginPath(); g.moveTo(x, 0); g.lineTo(x, h); g.stroke(); }
    g.fillStyle = "rgba(201,162,74,.65)"; for(let y = 32; y < h; y += 64) for(let x = 32; x < w; x += 64){ g.beginPath(); g.moveTo(x, y - 9); g.lineTo(x + 9, y); g.lineTo(x, y + 9); g.lineTo(x - 9, y); g.closePath(); g.fill(); }
  }, [4, 5]);
}
function rgBackdropTex(){
  return rgCanvasTex(512, 256, (g, w, h) => {
    const gr = g.createLinearGradient(0, 0, 0, h); gr.addColorStop(0, "#1e2c4e"); gr.addColorStop(1, "#131c34"); g.fillStyle = gr; g.fillRect(0, 0, w, h);
    for(let x = 0; x < w; x += 18){ g.fillStyle = "rgba(255,255,255," + (0.03 + (x % 36 ? 0.02 : 0)) + ")"; g.fillRect(x, 0, 9, h); }
    g.strokeStyle = "#c9a24a"; g.lineWidth = 4; g.strokeRect(14, 14, w - 28, h - 28); g.lineWidth = 1.5; g.strokeRect(24, 24, w - 48, h - 48);
    g.fillStyle = "#c9a24a"; g.textAlign = "center"; g.font = "bold 40px Georgia, serif"; g.fillText("THE PRESS GALLERY", w / 2, 150); g.font = "italic 22px Georgia, serif"; g.fillStyle = "#e6cf93"; g.fillText("The people have a right to know", w / 2, 190);
    g.fillStyle = "#c9a24a"; g.beginPath(); for(let i = 0; i < 10; i++){ const a = -Math.PI / 2 + i * Math.PI / 5, r = i % 2 ? 11 : 26; g.lineTo(w / 2 + Math.cos(a) * r, 78 + Math.sin(a) * r); } g.closePath(); g.fill();
  });
}
function rgClippingsTex(){
  return rgCanvasTex(512, 256, (g, w, h) => {
    g.fillStyle = "#6b4d2c"; g.fillRect(0, 0, w, h); g.fillStyle = "#b38a54"; g.fillRect(8, 8, w - 16, h - 16);
    const pins = ["#b5432f", "#2f6b45", "#c9a24a", "#1c2742"]; let seed = 7; const r = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    for(let i = 0; i < 16; i++){ const x = 18 + r() * (w - 130), y = 16 + r() * (h - 120), cw = 70 + r() * 50, ch = 60 + r() * 50, rot = (r() - 0.5) * 0.14; g.save(); g.translate(x + cw / 2, y + ch / 2); g.rotate(rot); g.fillStyle = "rgba(0,0,0,.18)"; g.fillRect(-cw / 2 + 3, -ch / 2 + 3, cw, ch); g.fillStyle = r() < 0.5 ? "#efe7d2" : "#e2d8bd"; g.fillRect(-cw / 2, -ch / 2, cw, ch);
      g.fillStyle = "#2a2a2a"; g.fillRect(-cw / 2 + 5, -ch / 2 + 6, cw - 10, 9); for(let k = 0; k < 7; k++){ g.fillStyle = "rgba(40,40,40,.55)"; g.fillRect(-cw / 2 + 5, -ch / 2 + 20 + k * 6, (cw - 10) * (0.5 + r() * 0.5), 2); }
      g.fillStyle = pins[(r() * 4) | 0]; g.beginPath(); g.arc(0, -ch / 2 + 3, 3, 0, 6.3); g.fill(); g.restore(); }
  });
}
function pressRich(w, d, h, hw){
  try{
    if(roomGroup.userData.rgPress) return; roomGroup.userData.rgPress = 1;
    const brass = matCol(0xb08b45, .35, .8), oak = matCol(0x5a3b24, .6), navy = matCol(0x1c2742, .8), cream = matCol(0xf3ecd9, .7), steel = matCol(0x8c8f94, .4, .6), green = matCol(0x2f5a3a, .8), black = matCol(0x15171b, .5);
    const glowM = new THREE.MeshStandardMaterial({color:0xfff6e0, emissive:0xfff0d0, emissiveIntensity:0.9, roughness:0.4});
    /* carpet, wall to wall, and a ceiling of light panels */
    const cp = rgFlat(rgPressCarpet(), 0, 0.008, d / 2, w - 0.5, d - 0.5); cp.material.transparent = false;
    for(let x = -1; x <= 1; x++) for(let z = 0; z < 3; z++){ const p = addBox(glowM, x * 2.2, h - 0.03, 2.2 + z * 3.0, 1.3, 0.04, 0.55, 0, true); p.castShadow = false; addBox(brass, x * 2.2, h - 0.06, 2.2 + z * 3.0, 1.38, 0.02, 0.62, 0, true); }
    /* the front of the room: a navy backdrop with the gallery's crest, flags, a lectern with its microphones, and the ON AIR lamp */
    const bd = new THREE.Mesh(UNIT.plane, new THREE.MeshStandardMaterial({map:rgBackdropTex(), roughness:0.8})); bd.position.set(0, 1.85, d - 0.05); bd.scale.set(5.2, 2.5, 1); bd.rotation.y = Math.PI; roomGroup.add(bd);
    addBox(brass, 0, 3.12, d - 0.07, 5.3, 0.06, 0.08, 0, true); addBox(brass, 0, 0.6, d - 0.07, 5.3, 0.05, 0.08, 0, true);
    addBox(oak, 0, 0.56, d - 1.55, 0.96, 1.12, 0.5); rgR(addBox(oak, 0, 1.16, d - 1.6, 1.06, 0.07, 0.62, 0, true), "x", 0.12); addBox(brass, 0, 0.8, d - 1.29, 0.4, 0.34, 0.02, 0, true);
    [-0.28, 0, 0.28].forEach((x, i) => { addCyl(black, x, 1.28 + i * 0.01, d - 1.62, 0.012, 0.2 + i * 0.01); addSphere(black, x, 1.4 + i * 0.01, d - 1.62, 0.028); });
    [-2.9, 2.9].forEach(x => { addCyl(brass, x, 1.2, d - 0.5, 0.025, 2.4); addSphere(brass, x, 2.45, d - 0.5, 0.05); addBox(matCol(0xb5432f, .8), x + Math.sign(-x) * 0.32, 2.1, d - 0.5, 0.6, 0.38, 0.015, 0, true); });
    addBox(matCol(0x8a1f24, .5), 0, 2.88, 0.1, 0.9, 0.24, 0.1); addBox(glowM, 0, 2.88, 0.155, 0.78, 0.14, 0.02, 0, true).material = new THREE.MeshStandardMaterial({color:0xff5a4a, emissive:0xff3a2a, emissiveIntensity:0.9});
    /* a dais for the cameras, with a second tripod and a floodlight rig */
    addBox(matCol(0x2a2d33, .8), -2.6, 0.14, 7.5, 2.2, 0.28, 1.7); addBox(matCol(0x2a2d33, .8), 2.4, 0.14, 7.4, 2.0, 0.28, 1.6);
    [-2.6, 2.4].forEach(x => { addBox(black, x, 3.0, 8.4, 1.6, 0.05, 0.05, 0, true); [-0.6, 0, 0.6].forEach(o => { addCyl(black, x + o, 2.82, 8.4, 0.07, 0.2); addSphere(glowM, x + o, 2.7, 8.42, 0.06); }); });
    /* each desk: a green leather top, a brass name plate, a telephone, a notebook, a cup, a lamp */
    for(let r = 0; r < 3; r++) for(let c2 = 0; c2 < 3; c2++){ const x = -2.2 + c2 * 2.2, z = 3.0 + r * 2.0;
      addBox(green, x, 0.79, z, 1.4, 0.012, 0.52, 0, true); addBox(brass, x, 0.8, z + 0.3, 0.3, 0.012, 0.07, 0, true);
      addBox(black, x - 0.55, 0.82, z + 0.05, 0.2, 0.05, 0.2); addBox(black, x - 0.55, 0.86, z + 0.05, 0.2, 0.03, 0.06, 0, true);
      addBox(matCol([0x8a1f24, 0x1c2742, 0x2f5a3a][(r + c2) % 3], .7), x + 0.5, 0.81, z - 0.05, 0.2, 0.02, 0.28, 0.3); addCyl(cream, x + 0.62, 0.84, z + 0.14, 0.035, 0.07);
      addCyl(brass, x + 0.45, 0.83, z + 0.16, 0.018, 0.08); addBox(green, x + 0.45, 0.93, z + 0.16, 0.2, 0.08, 0.1, 0, true);
    }
    /* the wire machine, a coffee urn and a clock; the right wall carries clippings, the front-left corner a rack of papers */
    addBox(matCol(0x3a3d44, .6), hw - 0.45, 0.5, 1.8, 0.6, 1.0, 0.5); addBox(black, hw - 0.45, 1.04, 1.8, 0.62, 0.08, 0.52); rgR(addBox(cream, hw - 0.45, 1.22, 1.88, 0.3, 0.34, 0.012, 0.3), "z", 0); rgR(addBox(cream, hw - 0.45, 0.7, 2.1, 0.28, 0.5, 0.01, 0, true), "x", -0.5);
    addBox(oak, hw - 0.4, 0.45, d - 3.0, 0.5, 0.9, 1.6); addCyl(steel, hw - 0.4, 1.12, d - 3.3, 0.14, 0.4); addCyl(black, hw - 0.4, 1.36, d - 3.3, 0.05, 0.05); [0, 1, 2].forEach(i => addCyl(cream, hw - 0.4, 0.95, d - 2.7 + i * 0.12, 0.04, 0.08));
    const cb = new THREE.Mesh(UNIT.plane, new THREE.MeshStandardMaterial({map:rgClippingsTex(), roughness:0.85})); cb.position.set(hw - 0.07, 1.7, 5.8); cb.scale.set(3.0, 1.45, 1); cb.rotation.y = -Math.PI / 2; roomGroup.add(cb); addBox(oak, hw - 0.035, 1.7, 5.8, 0.03, 1.55, 3.1, 0, true);
    rgR(addCyl(cream, 0, 2.7, 0.07, 0.24, 0.03), "x", Math.PI / 2); rgR(addCyl(brass, 0, 2.7, 0.085, 0.26, 0.02), "x", Math.PI / 2); addBox(black, 0, 2.7, 0.1, 0.01, 0.2, 0.01, 0, true); addBox(black, 0.06, 2.72, 0.1, 0.12, 0.01, 0.01, 0.5, true);
    /* acoustic slats on the left wall above the monitors */
    for(let i = 0; i < 22; i++) addBox(oak, -hw + 0.03, 2.55, 0.8 + i * 0.4, 0.04, 0.9, 0.12, 0, true);
  }catch(e){ try{ console.warn("press rich", e); }catch(x){} }
}
/* ══ 20261016l · every office carries its politics: party, home state and a record, on the plate and in the talk panel, for senators, justices, executive staff and the governor's people as for House members ══ */
const POL_BG = ["a former county prosecutor", "a farmer's son", "a union organiser", "a newspaper editor", "a lawyer from the capital", "a schoolteacher", "a former mayor", "a banker's daughter", "an army quartermaster", "a doctor with a clinic", "a shipping clerk who got noticed", "a judge's clerk"];
const POL_ROLE = {senator:"Senator", justice:"Justice", senclerk:"Secretary of the Senate", courtclerk:"Clerk of the Court", marshal:"Marshal of the Court", chief:"Chief of Staff", aide:"Executive aide", gsec:"Governor's secretary", gcounsel:"Counsel to the Governor"};
function polEnsure(c){
  if(!c || !c.krole) return null; if(c.pol) return c.pol;
  const r = rng(seedOf("pol:" + (c.kslot || c.id) + ":" + c.name)), k = c.krole, y = G.you || {}, states = (G.states || []).map(x => x.n);
  const lean = n => { try{ const S = (G.states || []).find(x => x.n === n); return S && S.lean != null ? S.lean : 0; }catch(e){ return 0; } };
  const byLean = n => lean(n) > 6 ? "FED" : lean(n) < -6 ? "COM" : (r() < 0.5 ? "FED" : "COM");
  let party = c.party, state = c.state, title = POL_ROLE[k] || "Official", line = "", terms = 0, margin = 0, nonpartisan = false;
  if(k === "senator"){ if(c.kslot && /:[01]$/.test(c.kslot) && y.state){ state = y.state; c.state = y.state; } state = state || y.state || states[0]; party = party || (c.kslot && /:[01]$/.test(c.kslot) ? (r() < 0.55 ? y.party || byLean(state) : byLean(state)) : byLean(state)); terms = 1 + Math.floor(r() * 4); margin = 3 + Math.floor(r() * 18); title = "Senator for " + state; line = "term " + terms + ", won by " + margin + "%"; }
  else if(k === "justice"){ let ec = 0; try{ ec = (c.pos && c.pos.econ) || 0; }catch(e){} party = party || (ec > 12 ? "FED" : ec < -12 ? "COM" : "IND"); state = state || states[Math.floor(r() * states.length)]; terms = 6 + Math.floor(r() * 24); title = "Justice of the Court"; line = "on the bench " + terms + " years · tenure for life"; }
  else if(k === "chief" || k === "aide"){ const ex = G.exec || {}; party = party || ex.party || y.party || "IND"; state = state || ex.state || states[Math.floor(r() * states.length)]; title = POL_ROLE[k]; line = "serves at the President's pleasure"; }
  else if(k === "gsec" || k === "gcounsel"){ state = state || y.state || states[0]; let gp = null; try{ const st = scEnsure().st[state]; gp = st && st.gov && st.gov.party; }catch(e){} party = party || gp || (y.office === "gov" ? y.party : byLean(state)); title = POL_ROLE[k] + " of " + state; line = "appointed by the Governor"; }
  else { nonpartisan = true; party = "IND"; state = state || y.state || states[0]; title = POL_ROLE[k] || "Officer"; line = "a career officer, nonpartisan"; }
  c.party = party; if(!c.state) c.state = state;
  return c.pol = {party, state, title, line, bg:POL_BG[Math.floor(r() * POL_BG.length)], nonpartisan, terms, margin};
}
function polPlate(c){ const P = polEnsure(c); if(!P) return null; return (POL_ROLE[c.krole] || P.title) + (P.nonpartisan ? " · nonpartisan" : " · " + partyLabel(P.party)) + " · " + P.state; }
/* ══ 20261016m · the Caucus Room, Committee Room 2141 and the Cloakroom, furnished ══ */
function rgSpinesTex(){
  return rgCanvasTex(256, 96, (g, w, h) => {
    g.fillStyle = "#1a1410"; g.fillRect(0, 0, w, h); let x = 2, seed = 11; const r = () => (seed = (seed * 16807) % 2147483647) / 2147483647; const cols = ["#6a1f2b", "#2a3d5e", "#2f5a3a", "#7a5a2a", "#4a2f24", "#8a7a52", "#1f2a3a", "#5a3a5a"];
    while(x < w - 4){ const bw = 5 + r() * 8, bh = 62 + r() * 26; g.fillStyle = cols[(r() * cols.length) | 0]; g.fillRect(x, h - bh - 4, bw, bh); g.fillStyle = "rgba(201,162,74,.8)"; g.fillRect(x, h - bh + 4, bw, 2); g.fillRect(x, h - 14, bw, 2); if(r() < 0.5){ g.fillStyle = "rgba(240,230,200,.55)"; g.fillRect(x + 1, h - bh * 0.6, bw - 2, 7); } x += bw + 0.5; }
  });
}
function rgBookcase(x, z, ry, w, h){
  const oak = matCol(0x4a2f1c, .6), g = new THREE.Group(); g.position.set(x, 0, z); g.rotation.y = ry || 0; roomGroup.add(g);
  const add = (m, px, py, pz, sx, sy, sz) => { const o = new THREE.Mesh(UNIT.box, m); o.position.set(px, py, pz); o.scale.set(sx, sy, sz); o.castShadow = false; o.receiveShadow = true; g.add(o); return o; };
  add(oak, 0, h / 2, 0, w, h, 0.34); add(matCol(0x14100c, .9), 0, h / 2, 0.02, w - 0.14, h - 0.14, 0.3); add(oak, -w / 2, h / 2, 0.02, 0.07, h, 0.4); add(oak, w / 2, h / 2, 0.02, 0.07, h, 0.4); add(oak, 0, h + 0.06, 0.04, w + 0.18, 0.12, 0.46);
  const rows = Math.max(3, Math.floor(h / 0.46)); const tex = rgSpinesTex();
  for(let i = 0; i < rows; i++){ const y = 0.2 + i * ((h - 0.3) / rows); add(oak, 0, y, 0.02, w - 0.1, 0.035, 0.34); const t = tex.clone(); t.needsUpdate = true; t.repeat.set(w / 0.9, 1); t.offset.x = (i * 0.37) % 1; const m = new THREE.Mesh(new THREE.PlaneGeometry(w - 0.16, (h - 0.3) / rows - 0.05), new THREE.MeshStandardMaterial({map:t, roughness:0.85})); m.position.set(0, y + ((h - 0.3) / rows) / 2, 0.2); g.add(m); }
  return g;
}
function rgSlateTex(){
  return rgCanvasTex(512, 256, (g, w, h) => {
    g.fillStyle = "#1f2a26"; g.fillRect(0, 0, w, h); for(let i = 0; i < 400; i++){ g.fillStyle = "rgba(255,255,255," + (Math.random() * 0.03) + ")"; g.fillRect(Math.random() * w, Math.random() * h, 30 + Math.random() * 60, 2); }
    g.strokeStyle = "rgba(235,235,225,.8)"; g.lineWidth = 2; g.font = "bold 30px 'Courier New', monospace"; g.fillStyle = "rgba(240,240,230,.9)"; g.textAlign = "center";
    ["AYE", "NO", "DOUBTFUL"].forEach((t, i) => { const x = 85 + i * 170; g.fillText(t, x, 40); g.beginPath(); g.moveTo(x - 70, 52); g.lineTo(x + 70, 52); g.stroke(); if(i) { g.beginPath(); g.moveTo(x - 85, 20); g.lineTo(x - 85, h - 10); g.stroke(); } });
    let seed = 5; const r = () => (seed = (seed * 16807) % 2147483647) / 2147483647; g.lineWidth = 3;
    [[11, 0], [8, 1], [5, 2]].forEach(([n, c]) => { const x0 = 25 + c * 170; for(let k = 0; k < n; k++){ const gx = x0 + (k % 5) * 20, gy = 72 + Math.floor(k / 5) * 40; g.beginPath(); g.moveTo(gx, gy); g.lineTo(gx + 2, gy + 28); g.stroke(); } for(let q = 1; q <= Math.floor(n / 5); q++){ const gx = x0 - 4, gy = 72 + (q - 1) * 40; g.beginPath(); g.moveTo(gx, gy + 24); g.lineTo(gx + 96, gy + 4); g.stroke(); } });
    g.font = "20px 'Courier New', monospace"; g.textAlign = "left"; g.fillStyle = "rgba(240,240,230,.55)"; ["Wexley? hold", "Crowe - ask", "Delane - committee", "Pell - TOLD NO"].forEach((t, i) => g.fillText(t, 20 + (i % 2) * 250, 190 + Math.floor(i / 2) * 28));
  });
}
function rgPartyBanner(){
  return rgCanvasTex(256, 512, (g, w, h) => {
    const gr = g.createLinearGradient(0, 0, 0, h); gr.addColorStop(0, "#1c2742"); gr.addColorStop(1, "#101a30"); g.fillStyle = gr; g.fillRect(0, 0, w, h);
    g.strokeStyle = "#c9a24a"; g.lineWidth = 6; g.strokeRect(10, 10, w - 20, h - 20); g.lineWidth = 2; g.strokeRect(22, 22, w - 44, h - 44);
    g.fillStyle = "#c9a24a"; g.beginPath(); for(let i = 0; i < 10; i++){ const a = -Math.PI / 2 + i * Math.PI / 5, r = i % 2 ? 26 : 66; g.lineTo(w / 2 + Math.cos(a) * r, 170 + Math.sin(a) * r); } g.closePath(); g.fill();
    g.fillStyle = "#e6cf93"; g.textAlign = "center"; g.font = "bold 30px Georgia, serif"; g.fillText("ONE LINE", w / 2, 300); g.fillText("ONE VOTE", w / 2, 340); g.font = "italic 20px Georgia, serif"; g.fillText("The caucus holds", w / 2, 400);
    g.fillStyle = "#c9a24a"; for(let x = 24; x < w - 24; x += 12) g.fillRect(x, h - 42, 6, 18);
  });
}
function rgPigeonTex(){
  return rgCanvasTex(512, 256, (g, w, h) => {
    g.fillStyle = "#3a2616"; g.fillRect(0, 0, w, h); let seed = 3; const r = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    for(let y = 0; y < 6; y++) for(let x = 0; x < 12; x++){ const px = 8 + x * 41, py = 8 + y * 40; g.fillStyle = "#120c07"; g.fillRect(px, py, 36, 34); if(r() < 0.55){ g.fillStyle = r() < 0.5 ? "#efe7d2" : "#d8cfb4"; g.save(); g.translate(px + 18, py + 22); g.rotate((r() - 0.5) * 0.3); g.fillRect(-14, -10 - r() * 8, 28, 22); g.fillStyle = "rgba(40,40,40,.4)"; g.fillRect(-10, -4 - r() * 4, 18, 2); g.restore(); } g.fillStyle = "#b08b45"; g.fillRect(px + 12, py + 28, 12, 4); }
  });
}
function rgCarpet2(field, border, mid){
  return rgCanvasTex(256, 256, (g, w, h) => {
    g.fillStyle = field; g.fillRect(0, 0, w, h); rgWeave(g, w, h, 0.09);
    g.strokeStyle = border; g.lineWidth = 2; g.globalAlpha = 0.55; for(let y = 0; y <= h; y += 85){ g.beginPath(); g.moveTo(0, y); g.lineTo(w, y); g.stroke(); } for(let x = 0; x <= w; x += 85){ g.beginPath(); g.moveTo(x, 0); g.lineTo(x, h); g.stroke(); } g.globalAlpha = 1;
    g.fillStyle = mid; for(let y = 42; y < h; y += 85) for(let x = 42; x < w; x += 85){ g.beginPath(); g.moveTo(x, y - 11); g.lineTo(x + 11, y); g.lineTo(x, y + 11); g.lineTo(x - 11, y); g.closePath(); g.fill(); g.fillStyle = border; g.beginPath(); g.arc(x, y, 3, 0, 6.3); g.fill(); g.fillStyle = mid; }
  }, [3, 3]);
}
function rgCurtain(x, y, z, ry, w, h, col){
  const g = new THREE.Group(); g.position.set(x, y, z); g.rotation.y = ry || 0; roomGroup.add(g); const m = matCol(col || 0x6a1f2b, .9), gold = matCol(0xb08b45, .35, .8);
  [-1, 1].forEach(s => { for(let i = 0; i < 4; i++){ const f = new THREE.Mesh(UNIT.box, m); f.position.set(s * (w / 2 - 0.06 + i * 0.002), 0, 0.02 + (i % 2) * 0.05); f.scale.set(0.12, h, 0.14); f.position.x = s * (w / 2 - 0.08 - i * 0.1); g.add(f); } });
  const v = new THREE.Mesh(UNIT.box, m); v.position.set(0, h / 2 + 0.12, 0.03); v.scale.set(w + 0.5, 0.3, 0.2); g.add(v); const rod = new THREE.Mesh(UNIT.box, gold); rod.position.set(0, h / 2 + 0.3, 0.05); rod.scale.set(w + 0.6, 0.04, 0.04); g.add(rod);
  return g;
}
function caucusRich(w, d, h, hw){
  try{
    if(roomGroup.userData.rgCaucus) return; roomGroup.userData.rgCaucus = 1;
    const brass = matCol(0xb08b45, .35, .8), oak = matCol(0x5a3b24, .6), leather = matCol(0x4a1d22, .7), cream = matCol(0xf3ecd9, .7), dark = matCol(0x1d1f26, .6);
    const glowM = new THREE.MeshStandardMaterial({color:0xfff2d4, emissive:0xffd9a0, emissiveIntensity:0.85, roughness:0.4});
    const cp = rgFlat(rgCarpet2("#3a1a22", "#c9a24a", "#9a7a3a"), 0, 0.007, d / 2, w - 0.8, d - 0.8); cp.material.transparent = false; cp.material.map.repeat.set(5, 5);
    /* the leadership dais, the lectern's party banner and a long table with name cards and water */
