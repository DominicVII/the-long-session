      if(!PROPS.district.some(p => p && p.id === "nh:door")) PROPS.district.push({id:"nh:door", label:"Your front door", get sub(){ const H = home(); return H ? H.address : "Home"; }, x:DOOR.x, z:DOOR.z - 1.0, r:1.8,
