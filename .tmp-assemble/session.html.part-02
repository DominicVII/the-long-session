      addBox(rv, 0, deckY + 2.42, zc, 1.6, 0.16, dd); addBox(bz, 0, deckY + 2.29, zb - 0.01, 1.43, 0.05, 0.05, 0, true); addBox(stone, 0, deckY + 2.62, zb - 0.06, 1.7, 0.24, 0.16); addBox(matCol(0xa89c82, .9), 0, deckY + 2.62, zb - 0.15, 0.26, 0.3, 0.06);
      addBox(matCol(0x8f846c, .92), 0, deckY + 0.06, zb - 0.16, 1.7, 0.12, 0.3); addBox(dark, 0, deckY + 1.15, zw - 0.02, 1.36, 2.3, 0.02); }
    addBox(matCol(0x8f846c, .92), 0, deckY + 0.03, fz - 0.55, 2.0, 0.06, 0.9);
    [-0.6, 0.6].forEach(x => { addBox(matCol(0x3b6a4a, .9), x * 1.7, deckY + 0.28, fz - 0.9, 0.5, 0.5, 0.4, 0, true); });
