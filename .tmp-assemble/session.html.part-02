    const has = k => t.some(x => x.toLowerCase().indexOf(k) >= 0);
    return {
      terse: has("terse") || has("stoic") ? true : has("garrul") || has("gregar") ? false : r() < 0.5,
      blunt: has("honest") || has("wrath") || has("blunt") ? true : has("deceit") || has("craft") || has("shy") ? false : r() < 0.5,
