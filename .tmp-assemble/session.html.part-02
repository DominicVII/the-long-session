    Promise.resolve(LT.reply({npcId:m.id, channel:"face", stage:"You spoke first and the player has not answered yet. Decide whether you have anything more to add, as a person would who is not sure they were heard. If you do, say it in one or two sentences, in your own words, and do not repeat yourself. If you are content to wait, reply with exactly: ...", text:"(waiting)"}))
      .then(r => { if(tok !== FW.n || !r || !r.live || !r.text) return; const t = liveClean(r.text); if(t && !/^\.{2,}$|^…$/.test(t.trim())) onText(t); }).catch(() => {});
    return true; }catch(e){ return false; }
}
