  ["ph14","phys","The Standard Model","s",["ph10","ph13","i_acc"],9,"A catalogue of the known particles and three of the four forces.","What is the smallest set of things everything is made of?"],
  ["ph15","phys","Condensed matter and superconductivity","s",["ph12"],7,"Many bodies acting as one: superfluids, superconductors, magnets.","What do a trillion electrons do together?"],
  ["ph16","phys","Quantum information","s",["ph8","m8"],7,"Entanglement and superposition as a resource: encryption, teleported states, computation.","What can be done with the strangeness itself?"],
  ["ph17","phys","Controlled fusion","s",["ph13","ph15","ph11"],9,"Fusing light nuclei under a magnetic cage: the process that powers stars, made to power a town.","Can a star be kept in a bottle?"],
  ["ph18","phys","Quantum gravity","s",["ph9","ph10"],10,"A single theory in which the smallest and the largest are the same description.","What happens inside a black hole, and at the beginning of time? Nothing known to physics forbids an answer."],
  ["c1","chem","Elements and chemical reactions","s",["i_pump","m1"],2,"Matter is made of a limited set of substances that combine in fixed proportions.","What is stuff?"],
  ["c2","chem","The periodic law","s",["c1"],3,"The elements fall into families: a table, and gaps in it that prove to be elements nobody had found yet.","Why do the elements repeat?"],
  ["c3","chem","Chemical bonding and thermochemistry","s",["c2","ph3"],4,"Why atoms stick, and how much energy it costs to unstick them.","What is a bond?"],
  ["c4","chem","Quantum chemistry","s",["c3","ph8"],7,"Molecules computed from the rules of the electron.","Can chemistry be calculated from first principles?"],
