  const ctx = "You are in a " + (kind === "governor_council" ? "governor's council" : "cabinet meeting") + " chaired by " + (typeof ndYou === "function" ? ndYou().address || "the chair" : "the chair") + ", who has just spoken to the room or to you. Answer as the person you are, in your own words, in one to four sentences, within your own office's duties. Do not speak for anyone else. If it belongs to another office, say whose it is.";
