}

const _tkF = {x:0, z:1}, _tkR = {x:-1, z:0};
function tick(dt){
  /* A stalled tab can report a huge delta; never turn that into a physics
     teleport or a burst of room/voice work after the tab resumes. */
  dt = clamp(Number(dt) || 0.016, 0.001, 0.05);
  G.t += dt;
  const w = dt * G.speed;          /* how fast the day runs around you */
  /* proper WASD: W/S walk, A/D step sideways, arrows look around */
  let vx = 0, vz = 0, turn = 0, tilt = 0;
  const KB = G.bind || DEFAULT_BIND;
  if(!(TALK.open && TALK.heldMove)){
    if(keys[KB.forward]) vz += 1;
    if(keys[KB.back]) vz -= 1;
    if(keys[KB.stepL]) vx -= 1;
    if(keys[KB.stepR]) vx += 1;
  }
  /* The camera carries a half-turn offset, so increasing yaw swings the
     view to the LEFT — the look-left key must add, not subtract. */
  if(keys[KB.lookL] || keys.arrowleft)  turn += 1;
  if(keys[KB.lookR] || keys.arrowright) turn -= 1;
  if(keys.arrowup)    tilt += 1;
  if(keys.arrowdown)  tilt -= 1;
