    Object.keys(z.flock).forEach(sn => { const st = (G.states || []).find(x => x.n === sn); if(st) st.unrest = clamp((st.unrest || 30) + (opposes ? 1 : -0.4) * z.fervor * z.flock[sn] * 0.6, 0, 100); try{ const eco = G.eng && G.eng.eco; if(eco) eco.mod[sn] = clamp((eco.mod[sn] || 0) + dir * z.fervor * z.flock[sn] * 0.02, -1, 1); }catch(e){} }); z.fervor = clamp(z.fervor + (Math.random() - 0.5) * 0.02, 0.05, 1); });
  /* the petition: a sect or a thinker puts a question to the Engine. It answers as well as it can know, and what it says lands */
  const E = (G.eng && G.eng.v === 1) ? G.eng : null;
  if(E && E.st >= 3 && chance(0.05)){ const fg = pick(F.figs), c = pick(all.filter(x => ["mind", "found", "time", "cosmos", "quantum", "life", "info"].includes(x.dom) && (F.res[x.id] || F.open.some(o => o.k === x.id)))); if(c) figPetition(fg, c, E, F); }
}
function figPetition(fg, c, E, F){
  const truth = fndTruth(c), know = clamp(0.35 + E.p / 220 + Math.log10(1 + (E.beyond || 0)) / 6, 0.35, 0.99), knows = chance(know), said = knows ? truth : null;
  if(said === null){ fndNews(fg.name + ", " + fg.role + ", put to the Engine whether this is so: " + c.claim.replace(/\.$/, "").toLowerCase() + ". It said it did not know, and said what it would need to find out.", false); const o = F.open.find(x => x.k === c.id); if(o) o.ev += (truth ? 1 : -1) * 0.05; return; }
  fndNews(fg.name + ", " + fg.role + ", asked the Engine whether this is so: " + c.claim.replace(/\.$/, "").toLowerCase() + ". The Engine said it is " + (said ? "so" : "not so") + ", and gave its reasons.", c.effort >= 8);
