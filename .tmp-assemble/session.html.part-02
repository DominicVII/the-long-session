  const AIDE = () => { const y = G.you || {}; const nm = y.aideName || (y.aideName = pk(["Margaret Ellison","Thomas Whitcombe","Hester Vandermeer","Samuel Okafor","Ruth Calloway","Pieter de Wit"])); return {id:"aide", name:nm, kind:"aide", role:(typeof schedBy === "function" ? schedBy() : "Your chief of staff") + " — " + nm}; };
  const RCACHE = {};
  function contacts(){
    const out = [{id:"aide", label:"Ask your aide (" + AIDE().name + ")", grp:"Your office", m:AIDE()}];
