  const LP = window.NEPTUNE_LOCALPARTY = {ver:"20261013e"};
  const cl = (v, a, b) => Math.max(a, Math.min(b, v));
  const hash = s => { let h = 2166136261; for(const c of String(s)){ h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); } return h >>> 0; };
  const rng = seed => { let a = seed >>> 0; return () => { a = (a + 0x6D2B79F5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; };
  const FIRST = ["Ada","Walt","June","Ray","Marta","Owen","Lena","Gus","Rosa","Hank","Ines","Cal","Dora","Abe","Nell","Teo","Bea","Moss","Ivy","Luis","Greta","Sol","Faye","Otis","Nadia","Ezra","Pearl","Dev","Mae","Joaquin"];
  const LAST = ["Halvorsen","Okafor","Pruitt","Delacroix","Brandt","Mercado","Tolliver","Ashby","Kowalczyk","Fenwick","Oduya","Lindqvist","Barrow","Castell","Whitcombe","Nakamura","Ridley","Abernathy","Szabo","Quinlan","Marchetti","Hollis","Varga","Ellery","Dunmore","Petrakis","Crane","Osei","Rourke","Vance"];
  const FAC = ["Main Street", "Farm Bureau wing", "Labor table", "Reformers", "Old guard", "Young caucus", "Faith and family", "Fiscal hawks"];
  const AGENDA = ["the county road budget", "keeping the hospital open", "a new grain elevator", "the school levy", "lower property taxes", "the river cleanup", "broadband out to the farms", "the plant's permit", "more deputies for the sheriff", "fixing the water main", "the county fair grounds", "a fair map at the next census"];
  const people = (key, roles, st) => {
    const r = rng(hash(key)), y = G.you, opp = y.party === "FED" ? "COM" : "FED", P = [];
    roles.forEach((role, i) => {
      const pr = r(), party = role.civ ? null : /party chair|precinct/i.test(role.t) ? y.party : pr < 0.62 ? y.party : pr < 0.88 ? opp : "IND";
      P.push({id:key + ":" + i, name:FIRST[Math.floor(r() * FIRST.length)] + " " + LAST[Math.floor(r() * LAST.length)], role:role.t + (role.where ? ", " + role.where : ""),
        party, faction:FAC[Math.floor(r() * FAC.length)], agenda:AGENDA[Math.floor(r() * AGENDA.length)], temper:Math.round(20 + r() * 65), conv:Math.round(20 + r() * 65), vanity:Math.round(10 + r() * 70),
        warmth:Math.round(-10 + r() * 30) + (party === y.party ? 6 : party ? -6 : 0), state:st, allies:[], rival:null, endorse:false, met:0});
    });
    P.forEach((p, i) => { P.forEach((q, j) => { if(i !== j && (p.faction === q.faction || (p.party && p.party === q.party && r() < 0.35))) p.allies.push(j); }); if(r() < 0.6){ const j = Math.floor(r() * P.length); if(j !== i && !p.allies.includes(j)) p.rival = j; } });
    return P;
  };
  const store = () => { const L = G.localParty = G.localParty || {}; L.off = L.off || {}; L.items = L.items || []; L.used = L.used || {}; L.held = L.held || {}; L.ev = L.ev || {};
    L.standing = L.standing == null ? 50 : L.standing; L.volunteers = L.volunteers || 0; return L; };
  const home = () => { const y = G.you; return {st:y.state, dist:y.dist || 1}; };
  const town = (st, i) => { const r = rng(hash(st + "|town|" + i)); return ["Millbrook","Cedar Falls","Harlan","Fairmont","Two Rivers","Kettle Bend","Ashgrove","Port Wren","Dunmore","Sable Hill"][Math.floor(r() * 10)]; };
  LP.officials = function(kind){
