/* NEPTUNE-DONORS END */
/* NEPTUNE-CANDID BEGIN — 20261021c: candid speech (MARS spec) and the office's roll of holders.
   Speech: answers JUPITER's 'onum-speak' within 1.5 s through onumSpoke(speaker, text, {reqId}); MARS's onumCandid first, then a
   line built from onumSpeakerState (want+reason, reaction+question), a fast Ollama line only if it lands in time. Every line is
   checked: not one of their last five, no stock opener, no person who is not in the room, the office history or the ledger. */
try{
/* ---- MARS onumCandid (inlined from /workspace/ov/mars/onum-candid.js) ---- */
/* MARS-CANDID 20261021a: window.onumCandid(npc, ctx) -> {text, prompt}. Reads only; never mutates game state.
   ctx: {channel, text (what was said to them), stage, audience:{id,name}, last:[their recent lines]} */
(function(){
