  const done = Object.keys(F.res).map(id => ({c:byId[id], r:F.res[id]})).filter(x => x.c).sort((a, b) => b.r.d - a.r.d).slice(0, 10), open = F.open.map(o => ({c:byId[o.k], o})).filter(x => x.c);
