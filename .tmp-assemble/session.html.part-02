/* NEPTUNE-SESSION END */
/* NEPTUNE-BUILDLINE 20261020t: a small 'Build <stamp>' line at the foot of Settings */
try{ const _sc = settingsCard; settingsCard = function(){ const r = _sc.apply(this, arguments); try{ const m = document.querySelector('meta[name="onum-build"]'), c = typeof card !== "undefined" ? card : null;
    if(m && c && !c.querySelector("#ndSetBuild")){ const d = document.createElement("div"); d.id = "ndSetBuild"; d.textContent = "Build " + m.content; d.style.cssText = "margin-top:10px;font:11px ui-monospace,monospace;color:#5a5446;text-align:right"; c.appendChild(d); } }catch(e){} return r; }; }catch(e){}
