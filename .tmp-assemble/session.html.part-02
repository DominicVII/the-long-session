function cTree(a, x, z, r, h, hue){
  const cols = [[0.17, 0.35, 0.15], [0.22, 0.42, 0.18], [0.14, 0.3, 0.13], [0.28, 0.46, 0.2]], tr = [0.28, 0.2, 0.14];
