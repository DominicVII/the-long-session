      : want.indexOf("to see") === 0 ? (v.blunt ? st.motionName + " dies on the floor, if I have anything to do with it." : "I'd not lose sleep if " + st.motionName + " went nowhere.")
      : want.indexOf("you to keep clear") === 0 ? "Stay away from " + (st.feud.name || "them") + ". I mean it."
      : want === "a straight answer" ? "Just tell me what you're after." : want === "to be left out of it" ? "Leave me out of this one." : want === "news from the floor" ? "What are they saying up there?" : "I'll want something back for this. Later.";
    const mem = st.rec.length && r() < 0.4 ? (() => { const m = st.rec[st.rec.length - 1]; const s = typeof m === "string" ? m : (m.gist || m.fact || m.text || m.c || ""); if(!s) return ""; const f = s.replace(/[.]$/, "").slice(0, 80).replace(/^you /i, ""); return pick(v.blunt
        ? ["You told me you " + f + ".", "Last time you said you " + f + ". Did you mean it?", "I haven't forgotten: you " + f + ".", "You " + f + ", or so you said."]
        : ["If I recall, you " + f + ".", "Didn't you say you " + f + "?", "I seem to remember you " + f + ".", "You mentioned you " + f + ", once."], r); })() : "";
    let parts = v.terse ? [react || ask].filter(Boolean) : [react, mem, ask].filter(Boolean);
    let out = parts.join(" ");
    if(pet && !v.terse && r() < 0.5) out += " " + pet.replace(/^./, c => c.toUpperCase()).replace(/[^.!?]$/, m => m + ".");
    if(slang && !v.terse) out = out.replace(/\.$/, ", " + slang + ".");
    return out.trim();
  }
  W.onumCandid = function(npc, ctx){
    try{ if(!npc || npc.kind === "engine") return null; ctx = ctx || {};
      const v = voiceOf(npc), st = stateOf(npc, ctx), last = (ctx.last || (st.SS && st.SS.memory) || []).map(x => typeof x === "string" ? x : (x.text || x.c || ""));
