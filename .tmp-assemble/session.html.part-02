  ["an2","anth","Archaeology and deep prehistory","s",["e1","an1"],4,"The human past from tools and bones, with dated layers.","Where did people come from?"],
  ["an3","anth","Linguistics","s",["an1"],4,"Grammar, sound, meaning and how languages change.","What is a language?"],
  ["an4","anth","Evolutionary anthropology","s",["b3","an2"],6,"How cooperation, culture and cognition evolved together.","Why are people like this?"],
  ["so1","soc","Sociology and demography","s",["m5","an1"],4,"Populations, institutions and the patterns no individual chooses.","Why do societies have the shape they have?"],
  ["so2","soc","Economics","s",["m5","p11"],5,"Scarcity, exchange and incentive modelled together.","How do millions of people decide who makes what?"],
  ["so3","soc","Law and constitutional design","s",["p6","so1"],5,"Rules about rules: how a power is made safe to hold.","How do you bind the one who binds?"],
  ["so4","soc","Network and complexity science","s",["m6","so1"],6,"Systems in which the whole behaves unlike any part: cities, markets, cells, minds.","How do simple parts make something that no part intended?"],
  ["so5","soc","History and historiography","s",["an2","p7"],4,"The past reconstructed from evidence, with the evidence examined.","How do we know what happened?"],
  ["ar1","arts","Music and acoustics","s",["m1","ph2"],3,"Pitch, rhythm and harmony, and why they move us.","Why does a chord feel like something?"],
  ["ar2","arts","Comparative religion and theology","s",["an1","p4"],4,"What people have believed about the sacred, and what it does for them.","Why do people pray?"],
  ["ar3","arts","Literature and the arts","s",["an3","p10"],3,"Stories, images and forms by which people say what cannot be said plainly.","What is a story for?"]
];

const INQ_BY = {}; INQ_N.forEach(n => { INQ_BY[n[0]] = {id:n[0], f:n[1], name:n[2], k:n[3], needs:n[4], effort:n[5], blurb:n[6], q:n[7]}; });
const INQ = {sel:null, peopleAt:-1, cnt:null};
function inqStore(){
  if(G.inq && G.inq.v === 1) return G.inq;
  const S = G.inq = {v:1, done:{}, prog:{}, fund:{}, log:[], first:G.day || 1};
  /* a career already under way: the years before it have happened */
  const D = Math.max(0, Math.min((G.day || 1) - 1, 400)); try{ for(let d = 0; d < D; d++) inqStep(true, d); }catch(e){ console.warn("inq backfill", e); }
  return S;
}
function inqFieldOf(m){
  const ks = Object.keys(INQ_F), pool = m.kind === "member" ? ["soc", "soc", "soc", "phil", "phil", "math", "anth", "arts", "phys", "bio"] : m.kind === "press" ? ["arts", "soc", "anth", "phil", "earth"] : ks;
  return pool[seedOf("fld:" + (m.id != null ? m.id : m.name)) % pool.length];
}
function inqCounts(){
  if(INQ.cnt && INQ.peopleAt === G.day) return INQ.cnt; const c = {}; Object.keys(INQ_F).forEach(k => c[k] = 14);   /* the Republic's universities and workshops, most of whom you never meet */
  [].concat(G.members || [], G.civ || [], G.press || []).forEach(m => { if(m && !m.gone) c[inqFieldOf(m)] += 1 / 3; });
  Object.keys(c).forEach(k => c[k] = Math.round(c[k]));
  INQ.cnt = c; INQ.peopleAt = G.day; return c;
}
function inqDone(id){ const S = G.inq; return !!(S && S.done[id]); }
function inqFrontier(f){ const S = inqStore(); return INQ_N.map(n => INQ_BY[n[0]]).filter(n => (!f || n.f === f) && !S.done[n.id] && n.needs.every(x => !INQ_BY[x] || S.done[x])).sort((a, b) => a.effort - b.effort); }
const INQ_FX = {
  c6:S => { try{ const w = worldEnsure(); if(typeof w.bread === "number") w.bread = clamp(w.bread - 0.02, 0.7, 2.6); }catch(e){} },
  b7:S => { (G.states || []).forEach(s => { s.unrest = clamp((s.unrest || 30) - 1, 0, 100); }); }
};
/* one day of the world asking questions: every field works its nearest open questions with the people, tools and money it has */
function inqStep(silent, idx){
  const S = G.inq && G.inq.v === 1 ? G.inq : inqStore(), C = inqCounts(), E = (G.eng && G.eng.v === 1) ? G.eng : null, nDone = Object.keys(S.done).length, accel = 1 + 0.004 * nDone;
  Object.keys(INQ_F).forEach(f => {
    const fund = !silent && S.fund[f] && G.day <= S.fund[f].until ? S.fund[f].lvl : 0, P = (1 + Math.pow(C[f], 0.75)) * (0.6 + fund) * (1 + (E ? 0.1 * E.st : 0)) * accel * ((f === "cs" || f === "eng") && E ? engSciHelp(E) : 1);   /* machines help build the next machines */
    inqFrontier(f).slice(0, 2).forEach((n, i) => { S.prog[n.id] = (S.prog[n.id] || 0) + P * (i ? 0.45 : 1) * 0.05 / Math.pow(n.effort, 1.05);
      if(S.prog[n.id] >= 1){ S.done[n.id] = silent ? 1 + (idx || 0) : G.day; delete S.prog[n.id]; inqDiscovered(n, silent); } });
  });
}
function inqDiscovered(n, silent){
  const S = G.inq; if(INQ_FX[n.id]) try{ INQ_FX[n.id](S); }catch(e){}
  if(silent) return; S.log.unshift({d:G.day, id:n.id}); if(S.log.length > onumLim(40,"hist")) S.log.pop();
  try{ feed("The Academy: " + n.name + " is settled."); }catch(e){}
  if(n.effort >= 5){ try{ pushWireScrap("The Academy", n.name + ": " + n.blurb.split(/(?<=[.!?])\s/)[0]); }catch(e){} }
  if(n.effort >= 7 && G.day - (S.bigNote == null ? -999 : S.bigNote) >= 21){ S.bigNote = G.day; try{ note("A discovery that will change the Republic: " + n.name + ". " + n.blurb, true); }catch(e){} }
}
function inqKnows(m, id){ const S = G.inq; if(!S || !S.done[id]) return false; const n = INQ_BY[id]; if(inqFieldOf(m) === n.f) return true; const days = G.day - S.done[id]; return days >= 8 + (seedOf("ik:" + (m.id || m.name) + id) % 10); }
function inqVoice(m){
  try{
    const S = inqStore(), f = inqFieldOf(m), F = INQ_F[f], fr = inqFrontier(f)[0], recent = Object.keys(S.done).filter(id => INQ_BY[id].f !== f && G.day - S.done[id] <= 25 && inqKnows(m, id)).map(id => INQ_BY[id]);
    const r = Math.random();
    if(recent.length && r < 0.3){ const n = pick(recent); return "Have you heard? " + n.name + " is settled now. " + n.blurb.split(/(?<=[.!?])\s/)[0]; }
    if(fr && r < 0.75){ const pct = Math.round(100 * (S.prog[fr.id] || 0)); return pick(["I keep coming back to a question in " + F.t.toLowerCase() + ": “" + fr.q + "”", "In " + F.t.toLowerCase() + " we are at “" + fr.name + "”" + (pct > 10 ? ", about " + (Math.round(pct / 10) * 10) + "% of the way, if you believe the people doing it." : ", and nobody will say it is close."), "My work is " + F.t.toLowerCase() + ". The open question is “" + fr.q + "” I do not expect to see it answered in my lifetime. I would like to be wrong."]); }
    const d = Object.keys(S.done).filter(id => INQ_BY[id].f === f).map(id => INQ_BY[id]); if(d.length){ const n = pick(d); return "People forget that " + n.name.toLowerCase() + " was once a question. " + n.q; }
    return "";
  }catch(e){ return ""; }
}
function inqTopic(text){
  const t = String(text).toLowerCase(), map = [[/quantum|superposition|entangle|uncertainty/, "ph8"], [/relativity|spacetime|speed of light/, "ph9"], [/conscious|experience|qualia|aware/, "p5"], [/ethic|moral|right and wrong|owe/, "p2"], [/universe|big bang|beginning of time|cosmos/, "a4"], [/gravity|black hole/, "ph18"], [/evolution|species|darwin/, "b3"], [/mean(ing)? of life|purpose|why are we here/, "p4"], [/god|religion|sacred|prayer/, "ar2"], [/infinite|infinity|proof|number/, "m7"], [/entropy|heat|time's arrow|arrow of time/, "ph3"], [/language|words|meaning of words/, "an3"], [/intelligen|machine mind|artificial/, "cs10"], [/free will|choice/, "p11"], [/fusion|star|sun/, "ph17"]];
  const hit = map.find(m => m[0].test(t)); return hit ? INQ_BY[hit[1]] : null;
}
function inqExplain(n){
  const S = inqStore(), done = !!S.done[n.id], pct = Math.round(100 * (S.prog[n.id] || 0)), pre = n.needs.filter(x => INQ_BY[x] && !S.done[x]).map(x => INQ_BY[x].name);
  return n.blurb + " " + (done ? "In the Republic that is settled." : pre.length ? "The Republic has not got there: it still needs " + listify(pre.slice(0, 3)) + "." : "The Republic is working on it, about " + pct + "% of the way.") + " The open question: " + n.q;
}
function inqFund(f){ const S = inqStore(), y = G.you; if(y.influence < 3) return "That costs 3 influence."; y.influence -= 3; S.fund[f] = {lvl:Math.min(1.5, ((S.fund[f] && G.day <= S.fund[f].until ? S.fund[f].lvl : 0) + 0.5)), until:G.day + 25}; return INQ_F[f].t + " is funded for twenty-five days."; }
function inqCard(){
  const S = inqStore(), C = inqCounts(), total = INQ_N.length + inqGen().length, nd = Object.keys(S.done).length, groups = {};
  Object.keys(INQ_F).forEach(f => { (groups[INQ_F[f].g] = groups[INQ_F[f].g] || []).push(f); });
  const bar = v => '<span style="display:inline-block;width:70px;height:5px;background:rgba(128,128,128,.25);border-radius:3px;vertical-align:middle"><i style="display:block;width:' + Math.round(clamp(v, 0, 1) * 100) + '%;height:100%;background:#7a9;border-radius:3px"></i></span>';
  const body = Object.keys(groups).map(g => '<div class="eyebrow" style="margin-top:10px">' + pcEsc(g) + '</div>' + groups[g].map(f => { const fr = inqFrontier(f).slice(0, 2), dn = INQ_N.filter(n => n[1] === f && S.done[n[0]]).length + S.gen.filter(n => n.f === f && S.done[n.id]).length, tot = INQ_N.filter(n => n[1] === f).length + S.gen.filter(n => n.f === f).length, fu = S.fund[f] && G.day <= S.fund[f].until;
    return '<div style="margin:6px 0;padding:4px 10px;border-left:3px solid var(--line-soft)"><b>' + pcEsc(INQ_F[f].t) + '</b> <span class="muted" style="font-size:12px">· ' + C[f] + ' people · ' + dn + ' of ' + tot + ' settled' + (fu ? ' · funded' : '') + '</span> <button type="button" class="btn btn--ghost" style="float:right" data-qf="' + f + '">Fund (3)</button>' +
      (fr.length ? fr.map(n => '<div class="muted" style="font-size:12px"><a href="#" data-qn="' + n.id + '" style="color:inherit">' + (n.k === "i" ? '⚙ ' : '') + pcEsc(n.name) + '</a> ' + bar(S.prog[n.id] || 0) + '</div>').join("") : '<div class="muted" style="font-size:12px">' + (dn === tot ? 'Everything in reach has been settled.' : 'Waiting on other fields.') + '</div>') + '</div>'; }).join("")).join("");
  const sel = INQ.sel && INQ_BY[INQ.sel], detail = sel ? '<div id="inqDetail" style="margin:8px 0;padding:8px 12px;border-left:3px solid #c9a24a"><b>' + pcEsc(sel.name) + '</b> <span class="muted">(' + pcEsc(INQ_F[sel.f].t) + ')</span><p style="margin:4px 0;font-size:13px">' + pcEsc(inqExplain(sel)) + '</p></div>' : "";
  const recent = S.log.slice(0, 5).map(x => '<div class="careerline"><b>d' + x.d + '</b> ' + pcEsc(INQ_BY[x.id].name) + '</div>').join("");
  govCardOpen("What the Republic is working out", "The Academy", "Mathematics, the physical sciences, life, mind, philosophy, society and the arts, all asking their questions at once. Nothing real physics allows is forbidden to be found; each answer waits for the ones before it, for the tools to see it, and for the work.",
    '<p class="muted" style="font-size:13px">' + nd + ' of ' + total + ' questions settled. Funding a field speeds the nearest of its open questions for twenty-five days.</p>' + detail + body + (function(){ try{ return fndHTML(); }catch(e){ return ''; } })() + (function(){ try{ return sciBoard(); }catch(e){ return ""; } })() + (recent ? '<div class="eyebrow" style="margin-top:10px">Lately settled</div>' + recent : ""), null);
  card.querySelectorAll("[data-qf]").forEach(b => b.addEventListener("click", () => { const r = inqFund(b.getAttribute("data-qf")); inqCard(); const s = el("gcSay"); if(s) s.textContent = r; }));
  card.querySelectorAll("[data-qn]").forEach(a => a.addEventListener("click", ev => { ev.preventDefault(); INQ.sel = a.getAttribute("data-qn"); inqCard(); try{ const dd = el("inqDetail"); if(dd) dd.scrollIntoView({block:"nearest"}); }catch(e){} }));
  return null;
}
/* ══ 20261017d · HEAT: the second law in the building. Warmth goes from warm to cold and never the other way without work; a room left alone becomes the weather; every degree held against it is fuel burned and paid for ══ */
const AIR = {last:null};
function airStore(){ if(!G.air) G.air = {T:{}, fuel:0, held:0, warn:-9}; return G.air; }
function airOut(){
  let t = 15; try{ const w = wxToday(); t = (typeof w.t === "number" ? (w.t - 32) * 5 / 9 : 12); }catch(e){}
  const h = (G.minute || 0) / 60; return t + 4 * Math.sin((h - 9) / 24 * 2 * Math.PI) - (wxGloomSafe() ? 0 : 0);
}
function wxGloomSafe(){ return false; }
const AIR_K = {marble:0.010, wood:0.016, plain:0.020, chamber:0.008, stone:0.02};
function airStep(mins){
  const A = airStore(), out = airOut(), E = (G.eng && G.eng.v === 1) ? G.eng : null; let fuel = 0;
  Object.keys(ROOMS).forEach(id => { const R = ROOMS[id]; if(!R) return; if(R.open){ A.T[id] = out; return; }
    let T = (typeof A.T[id] === "number" && isFinite(A.T[id])) ? A.T[id] : 19, k = AIR_K[R.style] || 0.015, vol = R.w * R.d * R.h;
    let people = 0; try{ people = id === G.room ? hereNow().length + 1 : 0; }catch(e){}
    let gain = people * 0.0016 + (id === "engine" && E ? (Math.min(E.compute, 100) * 0.0006 + Math.log10(1 + Math.max(0, E.compute - 100)) * 0.004) + E.st * 0.01 : 0);
    for(let i = 0; i < mins; i++){ T += (out - T) * k + gain; if(out < 14 && T < 20){ const q = Math.min(0.6, (20 - T) * 0.2); T += q; fuel += q * vol / 400; } else if(out > 26 && T > 25){ const q = Math.min(0.4, (T - 25) * 0.15); T -= q; fuel += q * vol / 600; } }
    A.T[id] = T; });
  A.fuel += fuel;
  /* what is burned is paid for by the states, as the Law says */
  try{ const O = orgEnsure(), sts = Object.keys(O.treas); if(sts.length && fuel > 0){ sts.forEach(n => { O.treas[n] = Math.max(0, O.treas[n] - fuel * 4 / sts.length); }); } }catch(e){}
}
function airTick(){
  try{
    if(!G || !G.running || !G.you) return; const A = airStore(), now = (G.day || 1) * 1440 + (G.minute || 0);
    if(AIR.last == null){ AIR.last = now; Object.keys(ROOMS).forEach(id => { if(typeof A.T[id] !== "number") A.T[id] = ROOMS[id].open ? airOut() : 19; }); return; }
    const d = Math.floor(now - AIR.last); if(d < 5) return; AIR.last = now; airStep(Math.min(d, 240));
    const T = G.room && A.T[G.room], R = ROOMS[G.room]; if(typeof T !== "number") return;
    const off = Math.max(0, Math.abs(T - 21) - 6); if(off > 0 && G.you){ G.you.energy = clamp((G.you.energy || 50) - off * 0.004 * Math.min(d, 30), 0, 100); }
    const c = el("kClock"); if(c){ const SN = sunTimes(); c.title = "The standing calendar · " + Math.round(T) + "°C " + (R && R.open ? "outside" : "in here") + " · sunrise " + sunClock(SN.rise) + ", sunset " + sunClock(SN.set); }
    if(now - A.warn > 180){ if(T < 9){ A.warn = now; try{ feed(R && R.open ? "The cold gets into your coat." : "It is cold enough in here to see your breath."); }catch(e){} } else if(T > 29){ A.warn = now; try{ feed("The air is close and hot; people are loosening their collars."); }catch(e){} } }
  }catch(e){}
}
/* getting to the campaign office is a walk up the high street; this is for when the street is in the way */
function sfGoHQ(){
  const go = () => { try{ const hq = (PROPS.district || []).find(p => p.id === "hq"); if(!hq) return; cam.x = hq.x - 1.2 * Math.sign(hq.x || 1); cam.z = hq.z - 1.0; cam.yaw = Math.sign(hq.x || 1) > 0 ? Math.PI / 2 : -Math.PI / 2; spend(10, 1); feed("You walk up the high street to the campaign office."); }catch(e){ console.warn(e); } };
  if(G.room !== "district"){ try{ goTo("district"); }catch(e){} setTimeout(go, 1800); } else go();
}
/* ══ 20261017e · THE RIVAL: a foreign power that wants the Engine, or wants it wrong. It copies, it poisons the data, it spreads stories; you find out late, partly, and not always who ══ */
function advStore(){
  if(G.adv && G.adv.v === 1) return G.adv;
  let rs = []; try{ rs = realmEnsure() || []; }catch(e){}
  const foe = G.world && G.world.foe, r = rs.find(x => x.k === foe) || rs[seedOf("adv" + (G.seedL || 1)) % Math.max(1, rs.length)] || {k:"reach", t:"the Reach"};
  return G.adv = {v:1, k:r.k, name:r.t, p:Math.max(2, Math.min(60, (G.day || 1) * 0.35)), intel:0, taint:0, sec:10, agents:[], log:[], known:false, brief:-99, mile:{}};
}
function advLog(t){ const A = advStore(); A.log.unshift({d:G.day, t}); if(A.log.length > onumLim(20,"hist")) A.log.pop(); }
function advDay(E){
  const A = advStore(); if(!E || E.st < 2){ A.p = Math.min(100, A.p + 0.15); return; }
  const post = E.posture, sec = A.sec + E.safety * 0.4 + (E.charter ? Object.keys(E.charter).length * 2 : 0), base = 0.5 - sec / 220 + (post === "open" ? 0.15 : post === "sealed" ? -0.15 : 0), pOK = clamp(base, 0.08, 0.8);
  A.sec = Math.max(0, A.sec - 0.25); A.taint = Math.max(0, A.taint - 0.25);
  A.p = Math.min(100, A.p + 0.28 + A.intel * 0.006 + (A.p < E.p * 0.6 ? 0.12 : 0));
  /* the milestones are public: a country announces what it can do */
  [[35, "reading engines"], [55, "reasoning engines"], [75, "working engines"], [92, "a general machine of its own"]].forEach(m => { if(A.p >= m[0] && !A.mile[m[0]]){ A.mile[m[0]] = G.day; try{ pushWireScrap("Abroad", A.name[0].toUpperCase() + A.name.slice(1) + " says it now has " + m[1] + "."); }catch(e){} A.known = true; advLog(A.name + " announced " + m[1] + "."); } });
  if(!chance(0.3)) return;
  const op = pick(["copy", "copy", "poison", "poison", "sabotage", "story"].filter(o => !(o === "poison" && E.st < 3)));
  const ok = chance(pOK), where = (G.states || [])[Math.floor(Math.random() * (G.states || []).length)];
  if(ok){
    if(op === "copy"){ A.intel = Math.min(100, A.intel + 4); A.p = Math.min(100, A.p + 0.5); }
    else if(op === "poison"){ A.taint = Math.min(100, A.taint + 9); }
    else if(op === "sabotage"){ E.compute = Math.max(0, E.compute - 1.5); }
    else if(op === "story" && where){ try{ engSeed("line", "Someone has been telling a story about the machines in " + where.n, {home:-2, st:-6, a:-0.04, mod:-0.05, p:-0.1, safety:0.1}); }catch(e){} }
    advLog("(unseen) " + A.name + " " + {copy:"copied from the Engine's makers", poison:"fed the Engine's data a falsehood", sabotage:"cut the power to an engine house", story:"seeded a story in " + (where && where.n)}[op] + ".");
  } else if(chance(0.22 + E.safety / 400)){
    const ag = {d:G.day, op, at:where ? where.n : "the capital", by:chance(0.6) ? A.k : "unknown", status:"held"}; A.agents.push(ag); if(A.agents.length > 8) A.agents.shift();
    const word = ag.by === A.k ? "papers from " + A.name : "no papers and a foreign accent";
    try{ note("A man was held in " + ag.at + " " + ({copy:"photographing the engine house", poison:"with a case of altered ledgers", sabotage:"near the engine house's power line", story:"handing out printed notices about the machines"}[op]) + ": " + word + ".", true); }catch(e){}
    if(ag.by === A.k) A.known = true; advLog("An agent was held in " + ag.at + " (" + word + ").");
  }
}
function advFidelityPenalty(){ try{ return G.adv ? G.adv.taint / 250 : 0; }catch(e){ return 0; } }
function advHTML(){
  const A = advStore(), E = engEnsure(); if(!A.known) return '';
  const brief = G.day - A.brief <= 3, held = A.agents.filter(a => a.status === "held");
  return '<div class="eyebrow" style="margin-top:12px">The rival</div><p class="muted" style="font-size:13px">' + pcEsc(cap(A.name)) + ' wants what you are building' + (brief ? ' (your people say its machines stand near ' + Math.round(A.p / 5) * 5 + ' against yours at ' + Math.round(E.p / 5) * 5 + '; they think about ' + Math.round(A.intel) + '% of what it has came from you)' : '') + '. You know only what has been caught or announced. ' + (A.log.filter(x => !/^\(unseen\)/.test(x.t)).slice(0, 3).map(x => 'd' + x.d + ': ' + pcEsc(x.t)).join(' · ')) + '</p>' +
    held.map((a, i) => '<div style="margin:5px 0;font-size:13px">Held in ' + pcEsc(a.at) + ' since day ' + a.d + ' (' + (a.by === A.k ? 'papers say ' + pcEsc(A.name) : 'unknown') + '). <button type="button" class="btn btn--ghost" data-av="release:' + i + '">Release quietly</button> <button type="button" class="btn btn--ghost" data-av="expel:' + i + '">Expel loudly</button></div>').join("") +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" data-av="sec:">Fund counter-intelligence (3)</button><button type="button" class="btn btn--ghost" data-av="audit:">Audit the Engine’s data (2)</button></div>';
}
function advAct(a, i){
  const A = advStore(), E = engEnsure(), y = G.you;
  if(a === "sec"){ if(y.influence < 3) return "That costs 3 influence."; y.influence -= 3; A.sec = Math.min(100, A.sec + 10); return "Counter-intelligence funded. Doors are locked that were not locked."; }
  if(a === "audit"){ if(y.influence < 2) return "That costs 2 influence."; if(G.day - A.brief < 5) return "The auditors are still at work on the last one."; y.influence -= 2; A.brief = G.day; const had = A.taint; A.taint = Math.max(0, A.taint - 15); try{ E.cal = Math.min(100, (E.cal == null ? 50 : E.cal) + (had > 10 ? 4 : 0)); }catch(e){} if(had > 18){ A.known = true; return "The auditors found data that was altered: roughly " + Math.round(had / 5) * 5 + "% of what they sampled. It has been replaced from the originals."; } return had > 6 ? "A little of the data was wrong. It has been replaced." : "Nothing they could find was wrong. That is not the same as nothing being wrong."; }
  const held = A.agents.filter(x => x.status === "held"), ag = held[+i]; if(!ag) return "";
  if(a === "release"){ ag.status = "released"; A.sec = Math.min(100, A.sec + 2); return "Released at the border. Nobody saw it, and so nobody was embarrassed."; }
  if(a === "expel"){ ag.status = "expelled"; try{ y.approval = clamp(y.approval + (ag.by === A.k ? 2 : -1), 0, 100); G.realmRel = G.realmRel || {}; G.realmRel[A.k] = clamp((G.realmRel[A.k] || 0) - (ag.by === A.k ? 6 : 2), -100, 100); }catch(e){} A.sec = Math.min(100, A.sec + 4); return ag.by === A.k ? "Expelled in public. " + cap(A.name) + " denies everything and recalls nobody." : "Expelled. Nobody will say whose he was, and you named no one."; }
  return "";
}
/* ══ 20261017g · BODIES: nobody runs without food or sleep. People tire through the day and hunger between meals, eat when they can, and say so; so do you ══ */
const BODY = {last:-1, warnAt:-999};
function bodyNow(){ return (G.day || 1) * 1440 + (G.minute || 0); }
function bodyWake(m){ const off = (seedOf("wake:" + (m.id != null ? m.id : m.name)) % 60) - 20; return (G.day || 1) * 1440 + 390 + off; }   /* up between six and seven */
function bodyOf(m){
  if(!m) return {hunger:0, tired:0};
  const now = bodyNow(), h = (G.minute || 0) / 60, wake = bodyWake(m);
  /* breakfast is assumed; after that, a meal is only had when one is eaten */
  const breakfast = wake + 40, ate = Math.max(m.ate || 0, h >= 7.2 ? breakfast : breakfast - 1440 + 750);
  const hunger = h < 7.2 && !(m.ate && now - m.ate < 600) ? 0.45 : clamp((now - ate) / 360, 0, 1.3);   /* before breakfast you are ready for it, not starving */
