      "#ndPb .pb-h{color:#ffe08a;font:600 11px system-ui;letter-spacing:.08em;text-transform:uppercase;margin:10px 0 3px}#ndPb .neg{color:#ff9d8a}#ndPb .pos{color:#9fe0a8}#ndPb .pb-a{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}#ndPb small{color:#cfc8b4}";
    document.head.appendChild(st); }
  function draw(){ const W = document.getElementById("ndPb"); if(!W) return; const B = book(), H = home(); const box = document.createElement("div"); box.className = "pb";
