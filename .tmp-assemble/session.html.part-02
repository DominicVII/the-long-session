
function orgRefer(p, prio){ const O = orgEnsure(); if(!p || p.status !== "open") return false; p.status = "referred"; p.closed = G.day; O.fed.push(Object.assign({}, p, {status:"open", prio:!!prio, from:p.state})); return true; }
function orgDeny(p){ if(!p || p.status !== "open") return false; p.status = "denied"; p.closed = G.day; const S = (G.states || []).find(x => x.n === p.state); if(S) S.unrest = clamp((S.unrest || 0) + 1, 0, 100); const T = orgTownOf(p); if(T) T.log.unshift({d:G.day, t:"The state declines " + orgNeedLabel(p.need) + " in " + T.name + ". The mayor takes it badly."}); return true; }
function orgStateAct(n){
  const O = orgEnsure(), my = orgIsMyState(n), q = (O.up[n] || []).filter(p => p.status === "open").sort((a, b) => b.sev - a.sev);
  let gov = n + "'s governor"; try{ const r = scEnsure().st[n]; if(r && r.gov) gov = "Governor " + surname(r.gov); }catch(e){}
  if(orgPlayerGov(n)){ q.forEach(p => { if(G.day - p.day >= 10){ orgDeny(p); orgNews("Nobody at the State House has answered " + p.townName + "'s petition for ten days. The acting governor refuses it.", true); } }); return; }
  let done = 0;
  q.forEach(p => { if(done >= 2) return; if((O.treas[n] || 0) >= p.cost){ if(orgFund(p, "state")){ done++; orgNews(gov + " funds " + p.townName + "'s " + orgNeedLabel(p.need) + " out of the state treasury (" + curF(p.cost) + ").", my); } } else if(G.day - p.day >= 3){ orgRefer(p, false); orgNews(gov + " cannot afford " + p.townName + "'s " + orgNeedLabel(p.need) + " and sends it up to Congress.", my); } });
}
function orgFedAct(){
  const O = orgEnsure(), by = {}; O.fed.filter(p => p.status === "open").forEach(p => { (by[p.need] = by[p.need] || []).push(p); });
  Object.keys(by).forEach(k => { const L = by[k], st = {}; L.forEach(p => st[p.state] = 1); if(L.length >= 3 && Object.keys(st).length >= 2 || L.some(p => p.prio) && L.length >= 2){
      const N = ORG_NEEDS[k], title = N.act, sp = reactHolder("speaker"), cost = L.reduce((a, p) => a + p.cost, 0);
      L.forEach(p => { orgFund(p, "congress"); (G.states || []).forEach(S => { if(S.n === p.state) S.unrest = clamp((S.unrest || 0) - 1.5, 0, 100); }); });
      O.acts.push({title, day:G.day, n:L.length, cost}); G.lastActs = G.lastActs || []; G.lastActs.unshift({title, day:G.day, pos:Object.assign({}, N.pos)}); if(G.lastActs.length > 6) G.lastActs.length = 6;
      orgNews("Congress passes the " + title + " after " + L.length + " towns in " + Object.keys(st).length + " states asked: " + curF(cost) + " for " + N.t + ". The act goes to the President.", true);
    } });
  O.fed.forEach(p => { if(p.status === "open" && G.day - p.day > 14) p.status = "lapsed"; });
}
function orgCourtAct(){
