}
function vClear(){
  try{ cityClear(); gateClear(); }catch(e){}
  ["dome", "sun", "moon", "stars", "sky"].forEach(k => { const o = VST[k]; if(o && o.parent) o.parent.remove(o); VST[k] = null; });
  VST.rings.forEach(o => { if(o.parent) o.parent.remove(o); }); VST.rings = [];
}
function vBuildOpen(R){
  vClear(); if(G && G.gfx === "simple") return; const K = VST.K;
  let nd = false; try{ nd = !!window.ONUM_TOWN_READY; }catch(e){}
  /* the sky is made once and hung again on every walk out: rebuilding it left a dome, a moon and four hundred stars behind each time */
  const KP = VST.keep;
  if(KP && KP.nd === nd){
    scene.add(KP.dome); try{ scene.children.splice(scene.children.indexOf(KP.dome), 1); scene.children.unshift(KP.dome); }catch(e){}
    VST.dome = KP.dome; VST.sun = KP.sun; VST.moon = KP.moon; VST.stars = KP.stars; VST.sky = KP.sky; VST.rings = KP.rings.slice();
    [KP.sun, KP.moon, KP.stars, KP.sky].concat(VST.rings).forEach(o => { if(o) scene.add(o); });
    try{ if(skyMesh) skyMesh.visible = false; if(skyGlow) skyGlow.visible = false; }catch(e){}
    if(!nd) try{ if(landGroup) landGroup.visible = false; }catch(e){}
  } else {
    const dome = new THREE.Mesh(new THREE.SphereGeometry(100 * K, 40, 24), new THREE.MeshBasicMaterial({map:vSkyTexture(), side:THREE.BackSide, fog:false, depthWrite:false, depthTest:false}));
    dome.renderOrder = -20; dome.frustumCulled = false; scene.add(dome); try{ scene.children.splice(scene.children.indexOf(dome), 1); scene.children.unshift(dome); }catch(e){} VST.dome = dome;
    const mk = (tex, size, ord) => { const s = new THREE.Sprite(new THREE.SpriteMaterial({map:tex, transparent:true, depthWrite:false, depthTest:true, fog:false, blending:THREE.AdditiveBlending})); s.scale.set(size, size, 1); s.renderOrder = ord; s.frustumCulled = false; scene.add(s); return s; };
    VST.sun = mk(vGlowTexture(), 46 * K, -19); VST.moon = mk(vMoonTexture(), 15 * K, -19);
    { const n = 420, p = new Float32Array(n * 3), r = vRng(99); for(let i = 0; i < n; i++){ const a = r() * 6.283, el = 0.12 + r() * 1.35, d = 96 * K; p[i * 3] = Math.cos(a) * Math.cos(el) * d; p[i * 3 + 1] = Math.sin(el) * d; p[i * 3 + 2] = Math.sin(a) * Math.cos(el) * d; }
      const g = new THREE.BufferGeometry(); g.setAttribute("position", new THREE.BufferAttribute(p, 3)); VST.stars = new THREE.Points(g, new THREE.PointsMaterial({size:1.7, sizeAttenuation:false, color:0xdfe8ff, transparent:true, opacity:0, depthWrite:false, depthTest:true, fog:false})); VST.stars.renderOrder = -19; VST.stars.frustumCulled = false; scene.add(VST.stars); }
    try{ if(skyMesh) skyMesh.visible = false; if(skyGlow) skyGlow.visible = false; }catch(e){}
    if(!nd){
      try{ if(landGroup) landGroup.visible = false; }catch(e){}
      [["far", 92 * K, 40 * K, 3], ["mid", 78 * K, 26 * K, 2], ["near", 66 * K, 15 * K, 1]].forEach(a => { const g = new THREE.CylinderGeometry(a[1], a[1], a[2], 64, 1, true), m = new THREE.MeshBasicMaterial({map:vRidgeTexture(a[0]), side:THREE.BackSide, transparent:true, fog:false, depthWrite:false}); const o = new THREE.Mesh(g, m); o.renderOrder = -15 + a[3]; o.frustumCulled = false; o.userData.h = a[2]; o.userData.kind = a[0]; scene.add(o); VST.rings.push(o); });
      const sk = new THREE.Mesh(new THREE.PlaneGeometry(74 * K, 9.2 * K), new THREE.MeshBasicMaterial({map:vSkylineTexture(), transparent:true, fog:false, depthWrite:false})); sk.renderOrder = -12; sk.frustumCulled = false; scene.add(sk); VST.sky = sk;
    }
    VST.keep = {nd, dome:VST.dome, sun:VST.sun, moon:VST.moon, stars:VST.stars, sky:VST.sky, rings:VST.rings.slice()};
  }
  try{ if(horizonMesh && horizonMesh.material){ horizonMesh.material.map = vGrassTexture(); horizonMesh.material.needsUpdate = true; } }catch(e){}
  try{ cityAttach(G.room); }catch(e){ try{ console.warn("city", e); }catch(x){} }
  try{ gateAttach(G.room); }catch(e){ try{ console.warn("gate", e); }catch(x){} }
}
{ const _bs = buildSky; buildSky = function(R){ _bs.apply(this, arguments); try{ if(R && R.open) vBuildOpen(R); else vClear(); }catch(e){ try{ console.warn("vista", e); }catch(x){} } }; }
/* time of day: sky tint, sun and moon on their arcs, stars, ranges in haze */
function vTime(){
  const h = (G.minute || 0) / 60, day = sunDay(h), gold = sunGold(h), SN = sunTimes();
  let gl = 1; try{ gl = wxGloom(); }catch(e){}
  let snow = false; try{ const w = wxToday(); snow = !!(w && w.cover > 0 && w.s === "winter"); }catch(e){}
  const night = 1 - day, t = new THREE.Color();
  const tint = k => { t.setRGB(lerp(0.07, 1, day) * (1 + gold * 0.28), lerp(0.09, 1, day) * (1 - gold * 0.16), lerp(0.18, 1, day) * (1 - gold * 0.34)); t.multiplyScalar(lerp(1, gl, 0.85) * (k || 1)); if(gl < 1){ const lu = (t.r + t.g + t.b) / 3, sa = clamp(1 - (1 - gl) * 3, 0.05, 1); t.r = lu + (t.r - lu) * sa; t.g = lu + (t.g - lu) * sa; t.b = lu + (t.b - lu) * sa; } return t; };
  if(VST.dome) VST.dome.material.color.copy(tint(1.02));
  const ang = clamp((h - SN.rise) / Math.max(4, SN.set - SN.rise), -0.25, 1.25) * Math.PI, el = Math.sin(ang) * clamp(SN.maxEl / 62, 0.35, 1.15);   /* a low winter sun, a high summer one */
  if(VST.sun){ VST.sun.userData.rel = new THREE.Vector3(-Math.cos(ang) * 78 * VST.K, (Math.max(el, -0.2) * 72 + 4) * VST.K, 64 * VST.K); VST.sun.material.opacity = clamp(el * 3, 0, 1) * lerp(1, 0.28, 1 - gl); VST.sun.material.color.setRGB(1, lerp(1, 0.72, gold), lerp(1, 0.5, gold)); VST.sun.scale.setScalar(lerp(46, 70, gold) * VST.K); }
  const ma = ang + Math.PI, mel = Math.sin(ma);
  if(VST.moon){ VST.moon.userData.rel = new THREE.Vector3(-Math.cos(ma) * 78 * VST.K, (Math.max(mel, -0.2) * 72 + 4) * VST.K, 64 * VST.K); VST.moon.material.opacity = clamp(mel * 3, 0, 1) * clamp(night * 1.4, 0, 1) * gl; }
  if(VST.stars) VST.stars.material.opacity = clamp(night * 1.3 - 0.25, 0, 1) * gl;
  cityNight(clamp(night * 1.25 - 0.15, 0, 1)); gateNight(clamp(night * 1.25 - 0.15, 0, 1));
  VST.rings.forEach(o => { const k = o.userData.kind; tint(k === "far" ? 1 : k === "mid" ? 0.95 : 0.9); const c = o.material.color; c.copy(t); if(snow){ c.r *= 1.5; c.g *= 1.55; c.b *= 1.7; } else if(gold > 0.05) c.lerp(new THREE.Color(1, 0.72, 0.55), gold * 0.25); });
  if(VST.sky){ tint(0.95); VST.sky.material.color.copy(t); }
}
function vFollow(){
  const c = camera.position;
  if(VST.dome){ VST.dome.position.copy(c); VST.dome.rotation.y = VST.t * 0.0016; }
  [VST.sun, VST.moon].forEach(o => { if(o && o.userData.rel) o.position.copy(o.userData.rel).add(c); });
  VST.rings.forEach(o => { o.position.set(c.x, o.userData.h / 2 - 0.4, c.z); });
  if(VST.sky) VST.sky.position.set(c.x, 4.2 * VST.K, c.z + 60 * VST.K);
  if(VST.stars) VST.stars.position.copy(c);
}
/* shafts through the windows of a lit room */
function vShaftTexture(){ if(VST.tex.shaft) return VST.tex.shaft; const c = vCanvas(64, 128), g = c.getContext("2d"), gr = g.createLinearGradient(0, 0, 0, 128); gr.addColorStop(0, "rgba(255,244,214,.95)"); gr.addColorStop(0.6, "rgba(255,236,190,.38)"); gr.addColorStop(1, "rgba(255,230,180,0)"); g.fillStyle = gr; g.fillRect(0, 0, 64, 128);
  g.globalCompositeOperation = "destination-in"; const gx = g.createLinearGradient(0, 0, 64, 0); gx.addColorStop(0, "rgba(0,0,0,0)"); gx.addColorStop(0.3, "rgba(0,0,0,1)"); gx.addColorStop(0.7, "rgba(0,0,0,1)"); gx.addColorStop(1, "rgba(0,0,0,0)"); g.fillStyle = gx; g.fillRect(0, 0, 64, 128); return VST.tex.shaft = new THREE.CanvasTexture(c); }
function vBuildShafts(id){
  if(VST.shafts){ if(VST.shafts.parent) VST.shafts.parent.remove(VST.shafts); VST.shafts = null; }
  VST.shaftRoom = id; const R = id ? ROOMS[id] : null; if(!R || R.open || (G && G.gfx === "simple") || id === "visit") return;
  const L = R.light; if(L !== "left" && L !== "right" && L !== "high") return;
  const grp = new THREE.Group(), hw = R.w / 2, n = L === "high" ? 4 : 3, mat = new THREE.MeshBasicMaterial({map:vShaftTexture(), transparent:true, opacity:0, blending:THREE.AdditiveBlending, depthWrite:false, side:THREE.DoubleSide, fog:false});
  for(let i = 0; i < n; i++){
    const z = R.d * (0.2 + 0.6 * (i + 0.5) / n), w = L === "high" ? 1.7 : 1.5; let top, bot;
    if(L === "high"){ const x = (i % 2 ? 1 : -1) * hw * (0.3 + 0.15 * (i % 2)); top = [[x - w, R.h * 0.97, z], [x + w, R.h * 0.97, z]]; bot = [[x - w + 1.1, 0.02, z + 3.2], [x + w + 1.1, 0.02, z + 3.2]]; }
    else { const s = L === "left" ? -1 : 1; top = [[s * (hw - 0.1), R.h * 0.78, z - w], [s * (hw - 0.1), R.h * 0.78, z + w]]; bot = [[s * (hw - 5.2), 0.02, z - w + 1], [s * (hw - 5.2), 0.02, z + w + 1]]; }
    const P = [top[0], top[1], bot[1], bot[0]], g = new THREE.BufferGeometry(); g.setAttribute("position", new THREE.BufferAttribute(new Float32Array(P.flat()), 3)); g.setAttribute("uv", new THREE.BufferAttribute(new Float32Array([0, 1, 1, 1, 1, 0, 0, 0]), 2)); g.setIndex([0, 1, 2, 0, 2, 3]);
    const m = new THREE.Mesh(g, mat); m.renderOrder = 8; m.frustumCulled = false; grp.add(m);
  }
  grp.userData.mat = mat; scene.add(grp); VST.shafts = grp;
}
let _vLast = 0;
function vFrame(now){
  requestAnimationFrame(vFrame);
  try{
    if(!G || !G.running || document.hidden || !camera){ ambHush(); return; } VST.t = (now || 0) / 1000;
    const R = ROOMS[G.room]; if(!R) return;
    sceneryGuard(now); ambFrame(now);
    if(R.open){
      if(VST.shaftRoom) vBuildShafts(null);
      if(!VST.dome && G.gfx !== "simple" && now - _vLast > 1500){ _vLast = now; try{ vBuildOpen(R); }catch(e){} }
      if(VST.dome){ if(now - (VST._tt || 0) > 400){ VST._tt = now; vTime(); } vFollow(); }
      if(now - (VST._gh || 0) > 900){ VST._gh = now; gateHideRoom(G.room); }
    } else {
      if(VST.dome) vClear();
      if(VST.shaftRoom !== G.room) vBuildShafts(G.room);
      if(VST.shafts){ const h = (G.minute || 0) / 60, day = sunDay(h); let gl = 1; try{ gl = wxGloom(); }catch(e){} VST.shafts.userData.mat.opacity = day * gl * (0.17 + 0.05 * Math.sin(VST.t * 0.5)) * (gl > 0.9 ? 1 : 0.5); }
    }
  }catch(e){}
}
setTimeout(() => { try{ requestAnimationFrame(vFrame); }catch(e){} }, 2000);
setTimeout(() => { try{ if(G && G.gfx !== "simple"){ vSkyTexture(); ["far", "mid", "near"].forEach(vRidgeTexture); vSkylineTexture(); vGrassTexture(); vGlowTexture(); vMoonTexture(); vShaftTexture(); } }catch(e){} }, 3500);
/* grade, vignette, and a HUD that lets you look */
setTimeout(() => { try{
  const st = document.createElement("style"); st.textContent =
    "#vGrade{position:absolute;inset:0;pointer-events:none;z-index:2;background:radial-gradient(ellipse at 50% 46%,rgba(0,0,0,0) 52%,rgba(8,10,16,.34) 100%),linear-gradient(180deg,rgba(255,226,190,.05),rgba(40,60,100,.05));mix-blend-mode:multiply}" +
    "body.hud-calm .ui-toolbar,body.hud-calm .hud,body.hud-calm #kClock{transition:opacity .6s;opacity:.28}body.hud-calm #job{transition:opacity .8s;opacity:0}" +
    "body.hud-calm .ui-toolbar:hover,body.hud-calm .ui-toolbar:focus-within,body.hud-calm .hud:hover,body.hud-calm #kClock:hover{opacity:1}";
  document.head.appendChild(st);
  const sc = el("scene"); if(sc && !el("vGrade")){ const d = document.createElement("div"); d.id = "vGrade"; sc.appendChild(d); }
  let lastMove = 0; const calm = () => { try{ document.body.classList.toggle("hud-calm", !!(G && G.running && performance.now() - lastMove > 2500 && !TALK.open)); }catch(e){} };
  ["mousemove", "keydown", "pointerdown", "touchstart"].forEach(ev => window.addEventListener(ev, () => { lastMove = performance.now(); document.body.classList.remove("hud-calm"); }, {passive:true}));
  setInterval(calm, 700);
}catch(e){} }, 2200);
/* ══ 20261016g · everyday life: the weather, the hour and the week are in the air, and people say so to each other ══ */
const LIFE = {last:-999, day:0, noon:0};
const LIFE_WX = {
  rain:[["Mind the floor by the door. It is a pond.", "I have been wet since the steps.", "Whoever said umbrellas work was lying."], ["It was dry when I left home.", "Stand further from the radiator. You are steaming.", "Hang it on the stand. No, the other stand."]],
  snow:[["They have not cleared the steps again.", "My feet have not been warm since Tuesday.", "Look at it come down. Nothing will get done today."], ["Then we shall have a quorum of the willing.", "I walked. The cab would not start.", "It is pretty. I will say that once and never again."]],
  frost:[["I could see my breath in the corridor.", "The pipes in my building are singing."], ["Wear the scarf, then.", "The cloakroom stove is the only honest thing in this building."]],
  wind:[["Did you see the flags? Straight out.", "My hat is in the river, I believe."], ["It is a good day for losing a hat.", "At least it blows the talk away."]],
  heat:[["The fans in the cloakroom are losing.", "I am not going to wear the jacket. Write that down."], ["Open a window.", "Nobody ever votes sensibly above eighty degrees."]],
  fog:[["I could not see the dome from the road.", "Fog like this, you could lose a bill in it."], ["Then we shall all be late together.", "Something ought to be lost in it. The budget, perhaps."]],
  storm:[["Did you hear that? The whole roof.", "I do not like the sound of the dome in a storm."], ["It has stood a hundred years.", "Then do not stand under it."]],
  overcast:[["A low grey lid on the whole town.", "It has been like this all week."], ["Nobody is in a hurry.", "Good light for reading, at least."]]
};
const LIFE_HR = {
  morning:[["Is there coffee, or only opinions?", "I read the overnight file in the cab and regret it.", "Too early for a vote and too late to hide."], ["The urn is on the second floor and it is brown.", "Nobody is awake. Speak softly.", "Have mine. I have had three."]],
  lunch:[["Are you eating, or are you standing there?", "The cloakroom has soup, and a view of everyone's business.", "I will vote anything if I am fed first."], ["Soup. It is always soup.", "Not at my desk. I have learned.", "Save me a chair."]],
  late:[["I have been in this building eleven hours.", "If I hear one more amendment I will leave the Republic.", "My feet have opinions."], ["Go home. They will find you tomorrow.", "Say it to the clerk, not me.", "One more hour. For the record."]],
  evening:[["I am going home before they find another meeting.", "The lamps are on. That means go.", "Nobody ever changed a mind after six."], ["Then go. I will lock the room.", "Take the side door. The press are on the steps.", "I will say you were here."]]
};
function lifeContext(){
  const h = (G.minute || 0) / 60, out = [], w = (G.day - 1) % 7;
  let wx = null; try{ wx = wxToday(); }catch(e){}
  if(wx && wx.k && wx.k !== "clear" && LIFE_WX[wx.k]) out.push({k:"wx:" + wx.k, a:LIFE_WX[wx.k][0], b:LIFE_WX[wx.k][1], w:2});
  if(h >= 8 && h < 9.6) out.push({k:"morning", a:LIFE_HR.morning[0], b:LIFE_HR.morning[1], w:2});
  if(h >= 12 && h < 13.6) out.push({k:"lunch", a:LIFE_HR.lunch[0], b:LIFE_HR.lunch[1], w:3});
  if(h >= 16 && h < 17.6) out.push({k:"late", a:LIFE_HR.late[0], b:LIFE_HR.late[1], w:2});
  if(h >= 17.6 && h < 20) out.push({k:"evening", a:LIFE_HR.evening[0], b:LIFE_HR.evening[1], w:3});
  if(w === 4) out.push({k:"friday", a:["Is it Friday? It is Friday. Everyone to the district.", "They scheduled nothing on a Friday. A miracle."], b:["Then why are we both still here?", "My train is at four. Do not let anyone call a vote."], w:2});
  const b = G.bill && !G.bill.done ? G.bill : null; if(b) out.push({k:"bill", a:["The count on the " + b.title + " has not moved since lunch.", "Somebody is lying about the " + b.title + " and I do not know who.", "Everyone has read the headline on the " + b.title + " and nobody the text."], b:["That is what the whip is for.", "Ask me after the roll call.", "I read the text. I wish I had not."], w:1});
  return out;
}
function lifeTick(){
  if(!G || !G.running || !G.you || TALK.open || SIT.on || G.t - LIFE.last < 45) return;
  try{ if(PC.open) return; }catch(e){}
  const h = Math.floor((G.minute || 0) / 60);
  if(h === 12 && LIFE.noon !== G.day && dayType() === "session"){ LIFE.noon = G.day; try{ feed("The noon bell. The cloakroom fills and the corridors thin."); }catch(e){} }
  const here = hereNow().filter(m => m && !m.gone && m !== G.you && m.traits && m.x != null && !m.ohSeat && m.kind !== "envoy" && !m.wantsWord);
  if(here.length < 2) return;
  const ctx = lifeContext(); if(!ctx.length) return;
  LIFE.last = G.t; let tot = 0; ctx.forEach(c => tot += c.w); let r = Math.random() * tot, c = ctx[0]; for(const x of ctx){ r -= x.w; if(r <= 0){ c = x; break; } }
  const a = pick(here), b = pick(here.filter(m => m !== a)); if(!b) return;
  /* people who are hungry say so, whatever the hour */
  let la = pick(c.a), lb = pick(c.b); try{ if(a.sent && a.sent.hunger > 0.78){ la = pick(["I have not eaten since breakfast and I am being civil about it.", "If there is a sandwich in this building I will vote for whoever has it."]); lb = pick(["Cloakroom. Twelve to one. Go.", "Here. Half. Do not tell anyone."]); } }catch(e){}
  try{ overhear(a, b, la, lb); }catch(e){}
}
/* ══ 20261016i · the city behind the city: blocks of buildings, avenues and trees fill the empty distance at the East Steps and in the District ══ */
const CITY = {tex:{}, mats:null, cache:{}, grp:null, room:null};
function cityTexture(pal){
  const key = "a" + pal; if(CITY.tex[key]) return CITY.tex[key];
  const S = 512, B = 128, c = vCanvas(S, S), g = c.getContext("2d"), r = vRng(500 + pal * 31);
  const P = [{wall:[150, 78, 58], mort:[190, 180, 165], trim:[226, 218, 200], brick:1}, {wall:[214, 204, 182], mort:[200, 190, 170], trim:[240, 234, 220], brick:0}, {wall:[198, 150, 98], mort:[180, 140, 100], trim:[238, 226, 200], brick:0}, {wall:[150, 154, 156], mort:[120, 124, 126], trim:[214, 214, 210], brick:1}][pal % 4];
  for(let by = 0; by < 4; by++) for(let bx = 0; bx < 4; bx++){
    const x0 = bx * B, y0 = by * B, v = 0.88 + r() * 0.16;
    g.fillStyle = "rgb(" + Math.round(P.wall[0] * v) + "," + Math.round(P.wall[1] * v) + "," + Math.round(P.wall[2] * v) + ")"; g.fillRect(x0, y0, B, B);
    if(P.brick){ g.strokeStyle = "rgba(" + P.mort.join(",") + ",.35)"; g.lineWidth = 1; for(let y = 0; y < B; y += 8){ g.beginPath(); g.moveTo(x0, y0 + y); g.lineTo(x0 + B, y0 + y); g.stroke(); for(let x = (y / 8) % 2 ? 0 : 8; x < B; x += 16){ g.beginPath(); g.moveTo(x0 + x, y0 + y); g.lineTo(x0 + x, y0 + y + 8); g.stroke(); } } }
