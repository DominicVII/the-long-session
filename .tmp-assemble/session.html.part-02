/* ══ THE RESEARCH LOOP: the people who work with machines talk to the Engine, and the Engine's machines talk to each other and to the people. Each speaks to the one before it, so what one produces feeds the next, round on round, and what comes out is more than any one of them started with, or, if they all lean the same way, more wrong. It is a bot working with a bot working with a bot ══ */
const LOOP_MACH = ["the Treasury's reading engine", "the Academy's modelling engine", "the Post Office's sorting engine", "a survey engine in the capital", "the observatory's analysis engine", "a ledger engine in the north"];
function loopDay(){
  const F = fndFigs(), E = (G.eng && G.eng.v === 1) ? G.eng : null; if(!E || E.st < 2 || !F.open.length) return;
  if(!chance(0.35 + E.st * 0.06)) return;
  const all = fndConcepts(), o = pick(F.open), c = all.find(x => x.id === o.k); if(!c) return;
  const workers = F.figs.filter(f => ["cs", "phys", "mind", "math", "bio", "earth", "chem"].includes(f.field)); if(workers.length < 2) return;
  const a = pick(workers), b = pick(workers.filter(w => w !== a)) || a, truth = fndTruth(c), know = clamp(0.3 + E.p / 200 + Math.log10(1 + (E.beyond || 0)) / 8, 0.3, 0.98), claim = c.claim.replace(/\.$/, "").toLowerCase();
  const stage = E.st >= 5 ? "the Engine" : E.st >= 4 ? "the working engines" : E.st >= 3 ? "the reasoning engines" : "the reading engines", F2 = F.loop = F.loop || {mem:0, n:0, notes:[]};
  const rounds = 2 + Math.floor(E.st / 2) + (chance(0.3) ? 1 : 0), lines = []; let carry = F2.mem, drift = 0;
  const la = figLean(a, c), lb = figLean(b, c), agree = Math.sign(la) === Math.sign(lb) && Math.abs(la) > 0.3 && Math.abs(lb) > 0.3;
  lines.push([a.name, a.role, "I want to know whether this is so: " + claim + ". Here is what I would try."]);
  for(let r = 0; r < rounds; r++){
    const m = r % 2 ? pick(LOOP_MACH.slice(0, Math.max(1, E.st))) : stage, last = lines[lines.length - 1][2];
    /* each round builds on the last: what the previous speaker made is the next one's material */
    const q = clamp(0.012 * (1 + fndPower().total / 6) / Math.pow(c.effort, 0.8), 0.003, 0.12), step = (truth ? 1 : -1) * q * (0.6 + know) * (1 + carry * 0.8 + r * 0.25);
    o.ev += step; carry = clamp(carry + know * 0.12, 0, 1.5);
    /* the echo: two people who already agree, and machines that were shown their view, push the wrong way together */
    if(agree && Math.sign(la) !== (truth ? 1 : -1)){ o.ev += Math.sign(la) * q * 0.5 * (r + 1) * 0.35; drift++; }
    lines.push(r % 2 ? [m, "", pick(["I ran the numbers against what " + stage + " had. The residual is smaller than it was.", "I found the point where the last result and the one before it disagree, and I can say why.", "I can narrow it: the question depends on one thing nobody has measured yet."])] : [stage === "the Engine" ? "The Engine" : stage, "", pick(["I have taken " + (r ? "the engine's" : a.name + "'s") + " result and extended it two steps. The next step is the hard one.", "Putting those together gives a prediction that can be tested this week. I would try it.", "That result bears on two other questions I had not linked. I have linked them."])]);
    if(r === 1 && b !== a) lines.push([b.name, b.role, pick(["I read what it produced. I think it is right up to the third step, and I would not trust the third step.", "I do not accept that. Show me the control.", "That is the answer I expected, which is why I am suspicious of it."])]);
  }
