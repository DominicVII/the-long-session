/* ══ THE OPEN FRONTIER: the Academy's planned tree ends where today's science ends. Beyond it, real open problems are taken up by the people who work them and by the Engine, anomalies turn up in the instruments, and settled results combine into new ones, without end. Everything obeys the same physics as the world you live in: a thing is found only when what it stands on has been found ══ */
const GEN_P = [
  ["Room-temperature superconductors","phys",6,["ph15","i_sc"],"materials","Can a material carry current without loss at ordinary temperatures?","Layered and hydride materials carry current without loss, but only cold or crushed. A stable one at room temperature would change every wire."],
  ["Topological phases of matter","phys",6,["ph12","ph16"],"info","Which states of matter are protected by shape rather than by detail?","Phases whose properties survive noise, because they depend on the global structure of the wavefunction."],
  ["Fault-tolerant quantum computation at scale","phys",7,["ph16","i_qc"],"info","Can errors be corrected faster than they accumulate?","Logical qubits built from many noisy ones, below the threshold where adding more makes things better, not worse."],
  ["Compact fusion with net energy gain","phys",7,["ph17","i_sc"],"energy","Can a plasma be held hot and dense long enough to give back more than it takes?","Strong superconducting magnets make smaller confinement devices possible; the engineering of sustained gain is the open part."],
  ["The nature of dark matter","earth",8,["a3","ph14"],"none","What is the matter that bends light and holds galaxies together but does not shine?","Gravity says something is there. Detectors have not yet said what."],
  ["Neutrino mass and its origin","phys",6,["ph14"],"none","Why are neutrinos so much lighter than everything else?","They have mass, which the Standard Model did not expect. Where it comes from is unknown."],
  ["Gravitational-wave astronomy of mergers","earth",6,["ph9","i_ligo"],"none","What do the ripples from colliding stars tell us about gravity and matter at the extreme?","Each merger is a laboratory for matter at densities no other experiment can reach."],
  ["Engineered metamaterials","phys",5,["ph5","c5"],"materials","Can structure at small scale give a material properties none of its parts has?","Arrangements smaller than a wavelength that bend, hide or focus waves in ways ordinary matter cannot."],
  ["High-density solid-state batteries","chem",5,["i_batt","c5"],"energy","Can a battery store several times as much, safely, and last a decade?","Solid electrolytes that stop dendrites and allow dense lithium metal anodes."],
  ["Artificial photosynthesis","chem",6,["c4","c6"],"food","Can sunlight, water and air be turned directly into fuel and fertiliser?","Catalysts that split water and fix carbon and nitrogen at useful rates, as a leaf does."],
  ["Catalytic carbon capture","chem",6,["c6","e3"],"climate","Can carbon dioxide be pulled from the air at a cost the world can pay?","Sorbents and catalysts that work at a few hundred parts per million with modest energy."],
  ["Self-assembling materials","chem",6,["c5","c4"],"materials","Can matter be made to build itself to a design?","Molecules and nanoparticles that find their own order, the way a virus coat does."],
  ["Protein structure from sequence","bio",5,["b9","cs6"],"health","Can the shape of a protein be read from its sequence of amino acids?","A fifty-year problem: the folded shape decides what a protein does, and the sequence alone should determine it."],
  ["Programmable cell therapies","bio",7,["b11","b7"],"health","Can a patient's own cells be taught to find and clear a disease?","Immune cells engineered with receptors and logic circuits to act only where disease is."],
  ["Tissue engineering and long-lived organs","bio",7,["b11","b2"],"health","Can a failing organ be replaced by one grown from the patient's own cells?","Scaffolds, vessels and stem cells grown into functional tissue."],
  ["Microbiome ecology","bio",5,["b10","b9"],"health","What do the trillions of organisms in a gut do for the body, and can we steer them?","The community of microbes shapes digestion, immunity and mood, and responds to diet and drugs."],
  ["Heat-tolerant, high-yield crops","bio",6,["b11","c6"],"food","Can a staple crop yield more under heat and drought?","Gene edits and breeding for photosynthesis that does not fail in the heat."],
  ["Whole-brain connectomics","bio",7,["b8","b12"],"mind","Can the wiring of an entire brain be mapped and simulated?","Every neuron and synapse of a small brain, then a larger one."],
  ["Seasonal-scale weather prediction","earth",6,["e3","cs8"],"climate","Can the weather of a whole season be forecast usefully?","Learned models of the atmosphere and ocean that keep their skill beyond two weeks."],
  ["Deep geothermal energy","earth",6,["e1","e2"],"energy","Can heat from deep rock be tapped anywhere?","Drilling and fracturing that make the hot rock below any place a source of steady power."],
  ["Exoplanet atmospheres","earth",5,["a2","i_tele"],"none","Do any other worlds show the chemistry of life?","Starlight through a planet's air carries the fingerprints of its gases."],
  ["Verified software and proof assistants","cs",6,["cs3","m7"],"info","Can a program be proved correct before it is run?","Machine-checked proofs that a program does what its specification says."],
