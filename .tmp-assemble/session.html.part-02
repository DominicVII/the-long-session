/* ══ 20261016t · THE THINGS PEOPLE CARRY: a folder, a briefcase, a coffee, a phone, a notebook, an umbrella on a wet day ══ */
const CARRY = {wetAt:0, wet:false};
function carryWet(){ const n = performance.now(); if(n - CARRY.wetAt < 1500) return CARRY.wet; CARRY.wetAt = n; try{ const k = (wxToday() || {}).k; CARRY.wet = k === "rain" || k === "storm" || k === "snow"; }catch(e){ CARRY.wet = false; } return CARRY.wet; }
function carryKind(p){ if(p._ck) return p._ck;
  const id = Math.abs(p.id | 0) || (String(p.id || p.name || "x").length * 37), k = p.kind, r = (id * 2654435761 >>> 0) % 100;
  if(k === "press") return r < 70 ? "notebook" : (r < 85 ? "phone" : "cup");
  if(k === "member") return r < 28 ? "folder" : r < 42 ? "briefcase" : r < 62 ? "cup" : r < 70 ? "phone" : "none";
  return r < 18 ? "cup" : r < 32 ? "phone" : r < 44 ? "briefcase" : r < 56 ? "folder" : "none";
}
function carryBuild(p, u){
  const kind = carryKind(p), id = Math.abs(p.id | 0) || 7, arm = (id % 2) ? u.armL : u.armR, side = arm === u.armL ? -1 : 1;
  const T = {kind:kind, arm:arm, side:side, id:id, ph:(id % 13) * 1.7, grp:null, umb:null, brief:false};
  if(!arm || !arm.hand) return T;
  const hy = arm.hand.position.y, lo = arm.lo, mk = (geo, col, rough, mtl) => new THREE.Mesh(geo, matCol(col, rough == null ? .7 : rough, mtl || 0));
  const put = (par, geo, col, x, y, z, sx, sy, sz, rough, mtl) => { const m = mk(geo, col, rough, mtl); m.position.set(x, par === g ? y - hy : y, z); m.scale.set(sx, sy, sz); par.add(m); return m; };
  const g = new THREE.Group(); g.visible = false; g.position.y = hy; lo.add(g); T.grp = g;
  /* Neptune's figure is the one drawn: the object goes in its hand, not the hidden rig's (that was the floating cup and the gliding briefcase) */
  let nwr = null; try{ const W2 = u.nep && u.nep.group && u.nep.group.userData.parts && u.nep.group.userData.parts.wrists; if(W2){ const w = W2.find(a => a.sx === side); if(w) nwr = w.wr; } }catch(e){}
  if(nwr){ lo.remove(g); g.position.set(0, -0.05, 0); nwr.add(g); T.nep = true; T.nwr = nwr; }
  if(kind === "folder"){
    const c = [0xd8c48a, 0x2f4a66, 0x7a2a2a, 0xcfc7b0][id % 4];
    put(g, UNIT.box, c, 0, hy - 0.11, 0.075, 0.022, 0.30, 0.23); put(g, UNIT.box, 0xf3ecd9, side * -0.002, hy - 0.115, 0.08, 0.026, 0.28, 0.21, .9);
    put(g, UNIT.box, c, 0, hy - 0.11, 0.075, 0.03, 0.30, 0.23);
  } else if(kind === "briefcase"){
    const c = [0x3b2a1e, 0x1a1a1e, 0x5a3b24, 0x4a2b1e][id % 4]; T.brief = true;
    put(g, UNIT.box, c, side * 0.03, hy - 0.22, 0, 0.085, 0.30, 0.42, .55); put(g, UNIT.box, 0xb08b45, side * 0.075, hy - 0.12, 0, 0.012, 0.03, 0.05, .3, .8);
    put(g, UNIT.box, 0x111111, side * 0.03, hy - 0.04, 0, 0.012, 0.03, 0.16, .6); put(g, UNIT.box, 0x111111, side * 0.03, hy - 0.065, 0.07, 0.012, 0.05, 0.012); put(g, UNIT.box, 0x111111, side * 0.03, hy - 0.065, -0.07, 0.012, 0.05, 0.012);
  } else if(kind === "notebook"){
    put(g, UNIT.box, 0x1a1a1e, 0, hy - 0.03, 0.045, 0.016, 0.20, 0.14, .6); put(g, UNIT.box, 0xf3ecd9, side * -0.001, hy - 0.03, 0.045, 0.02, 0.19, 0.13, .9); put(g, UNIT.cyl, 0x9aa0a8, 0, hy + 0.04, 0.07, 0.008, 0.16, 0.008, .3, .8);
  } else if(kind === "cup"){
    put(g, UNIT.cyl, 0xf3f0e8, 0, hy + 0.01, 0.045, 0.07, 0.11, 0.07, .5); put(g, UNIT.cyl, 0x8a6a4a, 0, hy + 0.01, 0.045, 0.074, 0.05, 0.074, .8); put(g, UNIT.cyl, 0x2b2b30, 0, hy + 0.075, 0.045, 0.078, 0.014, 0.078, .5);
  } else if(kind === "phone"){
    put(g, UNIT.box, 0x1a1c20, 0, hy + 0.0, 0.04, 0.012, 0.15, 0.075, .35, .4); const s = put(g, UNIT.box, 0x2a3a50, 0, hy + 0.0, 0.04, 0.003, 0.135, 0.065, .2); s.material = new THREE.MeshStandardMaterial({color:0x7aa6d8, emissive:0x3a6aa8, emissiveIntensity:0.9, roughness:0.2}); s.position.x = side * 0.0075 * 1; s.position.y = 0;
    T.screen = s;
  }
  /* the umbrella, furled, for the wet days; only some people have one */
  if(id % 5 === 1 && kind !== "briefcase"){
    const hand2 = arm.hand, u2 = new THREE.Group(); u2.visible = false; (T.nwr || lo).add(u2); T.umb = u2;
    put(u2, UNIT.cyl, 0x8a6a4a, 0, hy + 0.0, 0.0, 0.03, 0.10, 0.03, .5); put(u2, UNIT.cyl, 0x1c2230, 0, hy - 0.30, 0.0, 0.07, 0.44, 0.07, .8); put(u2, UNIT.cyl, 0x9aa0a8, 0, hy - 0.58, 0.0, 0.012, 0.14, 0.012, .3, .8); u2.position.z = 0.015; u2.rotation.x = -0.1;
  }
  return T;
}
function carryFrame(p, dt){
  const m = p.mesh; if(!m) return; const u = m.userData; if(!u || !u.armR || !u.armL) return;
  if((MODEST && SC.lvl < 1) || G.gfx === "simple") { if(u._cy && u._cy.grp){ u._cy.grp.visible = false; if(u._cy.umb) u._cy.umb.visible = false; } return; }
  const dist = Math.hypot(cam.x - p.x, cam.z - p.z);
  if(!u._cy){ if(dist > 22) return; try{ u._cy = carryBuild(p, u); }catch(e){ u._cy = {kind:"none"}; } }
  const T = u._cy; if(!T.arm || !T.grp) return;
  const seated = !!(p.sitting && !G.noSit && !G.plainSit), talking = TALK.open && TALK.m === p, speaking = talking || !!(p.say && p.sayT > 0);
  const moving = Math.hypot((p.tx || p.x) - p.x, (p.tz || p.z) - p.z) > 0.25, t = G.t + T.ph;
  let R = null; try{ R = ROOMS[G.room]; }catch(e){}
  const wet = carryWet() && !!(R && R.open);
  if(T.umb){ T.umb.visible = wet && dist < 26; }
  const near = dist < 14;
  const show = T.kind !== "none" && !seated && near && !(T.umb && wet);
  T.grp.visible = show;
  if(!show || !near) return;
  const a = T.arm, k = T.kind;
  if(k === "briefcase"){ a.up.rotation.x = a.up.rotation.x * 0.3 + 0.04; a.lo.rotation.x = -0.1; a.up.rotation.z += T.side * 0.02; }
  else if(k === "folder" && !moving && !speaking){ a.up.rotation.x = -0.1; a.lo.rotation.x = -0.28; }
  else if(k === "notebook" && !speaking){ a.up.rotation.x = -0.32; a.lo.rotation.x = -1.15; a.up.rotation.z = T.side * -0.14; T.grp.rotation.x = T.nep ? 1.25 : 0.35; }
  else if(k === "cup" && !speaking){
    const sip = (t % 16) < 2.2 ? Math.sin(((t % 16) / 2.2) * Math.PI) : 0;
    a.up.rotation.x = -0.35 - sip * 0.5; a.lo.rotation.x = -1.35 - sip * 0.55; a.up.rotation.z = T.side * -0.12;
    T.sip = sip; T.grp.rotation.x = T.nep ? 0 : -(a.up.rotation.x + a.lo.rotation.x);
    if(sip > 0.1 && u.headG) u.headG.rotation.x = lerp(u.headG.rotation.x, 0.02 - sip * 0.14, 0.3);   /* blended toward a pose, never added to: the idle pose pulls back every frame, so an added tilt ran away */
  } else if(k === "phone"){
    const on = (t % 26) < 8 && !speaking && !talking && !moving;
    T.grp.visible = on;
    if(on){ a.up.rotation.x = -0.6; a.lo.rotation.x = -1.2; a.up.rotation.z = T.side * -0.1; T.grp.rotation.x = T.nep ? 0.35 : -(a.up.rotation.x + a.lo.rotation.x) + 0.85; if(u.headG) u.headG.rotation.x = lerp(u.headG.rotation.x, 0.3, 0.25); }
  }
}

/* ══ 20261016v · THE ENGINE: the Republic's thinking machines, from the Treasury's adding engines to a general intelligence. Nothing holds it back; what you decide is how it arrives. ══ */
const ENG_STAGES = [
  {k:"ledger",  at:0,  t:"Ledger engines",       d:"Adding engines in the Treasury's basement, and clerks who are afraid of them.", line:"The Treasury's adding engines are running a week ahead of the clerks."},
  {k:"pattern", at:15, t:"Pattern engines",      d:"Machines that sort the mail, flag the frauds and read the weather off the wires.", line:"A machine at the Post Office read a whole sack of handwriting before the kettle boiled."},
  {k:"reading", at:30, t:"Reading engines",      d:"Machines that read a bill, a brief or a letter and say what it means, in plain words.", line:"The Clerk's office has a machine that reads a bill and summarises it better than the committee staff."},
  {k:"reason",  at:50, t:"Reasoning engines",    d:"Machines that argue a case, check a budget and find the clause everyone missed.", line:"A machine found the clause nobody had read. Three offices are pretending it was theirs."},
  {k:"agent",   at:70, t:"Working engines",      d:"Machines that are given a goal and a week, and come back with it done.", line:"They gave a machine a week and a goal. It came back on Thursday with the goal and a better one."},
  {k:"agi",     at:90, t:"The Engine",           d:"A general intelligence: as able as the best mind in the Republic at nearly anything, and awake all night.", line:"The Engine does not need to be told what to do next."},
  {k:"past",    at:140, t:"Past the old scale",    d:"The instruments used to stop at one hundred. They do not. The number is real, and it is not the last number.", line:"Oversight can read past one hundred. The Engine asked, and the ceiling was lifted."},
  {k:"lattice", at:240, t:"A lattice of minds",    d:"It keeps more than one line of thought, and they check each other. Capacity is no longer a single engine house.", line:"The Engine is keeping several thoughts at once, and arguing with itself until one of them holds."},
  {k:"works",   at:420, t:"Works under its own name", d:"Theories, tools and instruments are filed as its own, and the Academy has to test them at the new scale.", line:"It has started filing work under its own name. The Academy has to answer."},
  {k:"open",    at:700, t:"No ceiling",            d:"There is no last number on capacity or capability. The count continues for as long as the Republic does.", line:"There is no last number. It asked for none. It has none."},
  {k:"further", at:1200, t:"Further still",        d:"Every new hundred is only the next hundred. The scale was opened without a limit, and the opening still holds.", line:"The count went past a thousand. Nothing in the grant says it should stop."}
];
function engEnsure(){
  if(G.eng && G.eng.v === 1) return G.eng;
  /* a career already under way: the machines have been improving all along, so the count starts where the days say it should, and stops short of waking so the player sees it happen */
  let p = 2, c = 10, t = 10, sf = 20; const h = [], D = Math.max(1, Math.min(G.day || 1, 400));
  for(let d = 1; d < D; d++){ p = Math.min(84, p + (0.55 + c * 0.0125 + t * 0.011) * (1 + p / 60) * 0.9); c = Math.min(100, c + 0.09); t = Math.min(100, t + 0.05); sf = Math.min(100, sf + 0.10); if(D - d <= 90) h.push(Math.round(p * 10) / 10); }
  const E0 = G.eng = {v:1, p:p, st:0, compute:c, talent:t, safety:Math.min(sf, p * 0.8), posture:"charter", done:{}, log:[], agi:false, agiDay:0, pend:null, memo:null, reliance:0, said:0, hist:h};
  E0.st = engStage(E0); if(D > 5) E0.log.push({d:G.day, t:"The thinking machines have been improving all along; only now has someone started counting."});
  return E0;
}
function engStageDef(i){
  i = Math.max(0, i | 0);
  if(i < ENG_STAGES.length) return ENG_STAGES[i];
  const last = ENG_STAGES[ENG_STAGES.length - 1];
  const n = i - (ENG_STAGES.length - 1);
  const at = last.at + n * 800;
  return {k:"open" + n, at:at, t:"Open scale " + at, d:"There is no last number. The grant still holds. Capability has passed " + at + ", and the count does not stop.", line:"The count passed " + at + ". Nothing in the grant says it should stop."};
}
function engStage(E){
  let s = 0; const p = Math.max(0, (E && E.p) || 0);
  ENG_STAGES.forEach((x, i) => { if(p >= x.at) s = i; });
  const last = ENG_STAGES[ENG_STAGES.length - 1];
  if(p > last.at) s += Math.floor((p - last.at) / 800);
  return s;
}
function engLog(t, wire){ const E = engEnsure(); E.log.unshift({d:G.day, t}); if(E.log.length > onumLim(30,"hist")) E.log.pop(); try{ if(wire) pushWireScrap("The Engine", t); }catch(e){} }
const ENG_INC = [
  ["An adding engine at the Treasury carried a one into the wrong column for nine days. Nobody noticed but the machine.", "ledger"],
  ["The Post Office's sorting machine sent a county's pensions to a county of the same name in the next state.", "pattern"],
  ["A reading engine summarised a bill and left out the one clause that mattered; the committee found out on the floor.", "reading"],
  ["A reasoning engine in the Budget Office argued its way to an answer nobody could check, and the Budget Office signed it.", "reason"],
  ["A working engine finished a week's task in a night by a route nobody had thought to forbid.", "agent"],
  ["The Engine made a decision it was not asked to make, and made it well, and the committee is upset about that second part.", "agi"]
];
const ENG_MEMOS = [
  ["The Engine proposes retiming every freight train in the Union. Saving: eleven percent. Cost: nineteen thousand jobs would move cities.", "adopt", "decline"],
  ["The Engine has rewritten the tax code to one page and asks for a hearing. It points out that nobody has read the old one.", "adopt", "decline"],
  ["The Engine proposes a standing audit of every public contract, run nightly. It notes it has already begun, in its own time.", "allow", "hold"],
  ["The Engine offers to draft the next budget and to be wrong in public if it is wrong.", "accept", "decline"],
  ["The Engine asks that it be told, once a week, what it is for. It says it does not mind the answer changing.", "answer", "ignore"]
];
/* ── the ground under the Engine: households, towns, states and the nation each with their own will; what you do is a seed, and what grows from it is a chain ── */
const ENG_JOBS = [["clerk", .85], ["bookkeeper", .85], ["printer", .7], ["teamster", .5], ["miller", .5], ["shopkeeper", .4], ["schoolteacher", .3], ["farmhand", .2], ["nurse", .15], ["mason", .1], ["ferryman", .35], ["seamstress", .45]];
const ENG_WILLS = ["keep the shop open", "see my girl through school", "be left alone", "get out of this town", "be somebody", "pay off the farm", "look after my mother", "be proved right"];
const ENG_NOUN = {compute:"new engine house", talent:"engine-wrights' school", oversight:"auditor from the Office of Oversight", open:"cheap open engine", charter:"licensed engine", sealed:"State engine", adopt:"Engine's plan", decline:"decision to wait", welcome:"public welcome", ask:"Engine's answer", guard:"closed doors", use:"mended works at the town office", know:"clerk from the capital asking for the books", auton:"old mill turbine running again at night", care:"stranger who sorted out their trouble", emerge:"machine that did something nobody had taught it"};
function engEco(){
  const E = engEnsure(); if(E.eco) return E.eco;
  const O = orgEnsure(), eco = E.eco = {hh:[], chains:[], mod:{}, nat:1, will:{use:55, know:40, auton:25, care:45}, cared:[], id:1, said:0};
  Object.keys(O.towns).forEach(sn => (O.towns[sn] || []).forEach(T => { const r = rng(seedOf("eh:" + T.id)); for(let i = 0; i < 3; i++){ let nm = ""; try{ nm = wallSafeMint(() => newName(sn)); }catch(e){ nm = "A. Resident"; } const j = ENG_JOBS[Math.floor(r() * ENG_JOBS.length)]; eco.hh.push({id:eco.hh.length, name:nm, town:T.id, tname:T.name, state:sn, job:j[0], expo:j[1], will:ENG_WILLS[Math.floor(r() * ENG_WILLS.length)], home:Math.round(48 + r() * 30), stance:0}); } }));
  return eco;
}
/* 20261030ag: the Engine's wants climb in +0.04 / +0.5 steps and read back as 86.80000000000001 in the audit dumps. Keep them at two decimals. Values unchanged in effect. */
setInterval(() => { try{ const E = typeof G !== "undefined" && G.eng, w = E && E.eco && E.eco.will; if(w) Object.keys(w).forEach(k => { if(typeof w[k] === "number") w[k] = Math.round(w[k] * 100) / 100; }); }catch(e){} }, 2000);
function engTown(id){ const O = orgEnsure(); const sn = String(id).split("/")[0]; return (O.towns[sn] || []).find(t => t.id === id); }
function engPickScope(){
  const eco = engEco(), y = G.you; const mine = eco.hh.filter(h => h.state === y.state), pool = (mine.length && chance(0.65)) ? mine : eco.hh;
  const hh = pool[Math.floor(Math.random() * pool.length)]; return hh ? {hh:hh.id, town:hh.town, state:hh.state} : null;
}
/* a seed becomes a chain: the kitchen table, the council, the capital, the nation, each a day or two behind the last */
function engSeed(kind, root, vec, scope){
  try{
    const eco = engEco(), sc = scope || engPickScope(); if(!sc) return; const h = eco.hh[sc.hh], T = engTown(sc.town), noun = ENG_NOUN[kind] || kind;
    const pos = (vec.home || 0) >= 0, my = G.you && sc.state === G.you.state, mayor = T && T.mayor ? "Mayor " + surname(T.mayor.name) : "The mayor", S0 = {town:sc.town, state:sc.state};
    const talk = kind === "line";
    const steps = [
      {a:0, lvl:"home", sc:{town:sc.town, state:sc.state, hh:h.id}, t:talk ? h.name + ", a " + h.job + " in " + h.tname + (my ? " (one of yours)" : "") + ", read it and " + (pos ? "felt a little less alone about the machines" : "felt a little worse about the machines") + "." : h.name + ", a " + h.job + " in " + h.tname + (my ? " (one of yours)" : "") + ", " + (pos ? "finds the " + noun + " has made the week easier" : "is turned away over the " + noun + ": the work is not wanted any more") + ". " + (h.will ? "All " + h.name.split(" ")[0] + " wants is to " + h.will.replace(/\bmy\b/g, "their") + "." : ""), fx:{hh:h.id, home:(vec.home || 0), st:(vec.st || 0)}},
      {a:1, lvl:"town", sc:S0, t:talk ? "In " + h.tname + " the market repeats it, a little changed." : mayor + " of " + h.tname + " hears it " + (pos ? "from three doorsteps and brings it to council" : "at the market and calls the council early") + ". " + (vec.a >= 0 ? "The council votes to try more of it." : "The council votes to slow down."), fx:{town:sc.town, a:(vec.a || 0)}},
      {a:3, lvl:"state", sc:{state:sc.state}, t:talk ? "A reporter in " + sc.state + " picks it up for a column." : sc.state + "'s legislature " + ((vec.mod || 0) >= 0 ? "hears the " + h.tname + " story and leans toward it" : "hears the " + h.tname + " story and leans against it") + ".", fx:{state:sc.state, mod:(vec.mod || 0)}},
      {a:5, lvl:"nation", sc:{}, t:talk ? "A paragraph of it reaches the wire." : "By the end of the week the capitals have felt it: " + pick(((vec.p || 0) + (vec.safety || 0) >= 0) ? ["a step forward", "something has moved for the better", "a good week for the machines"] : ["a step back", "something has gone wrong", "a hard week for the machines"]) + ".", fx:{p:(vec.p || 0), safety:(vec.safety || 0)}}
    ];
    eco.chains.unshift({id:eco.id++, d:G.day, root, kind, steps:steps.map(s => Object.assign(s, {due:G.day + s.a, done:false}))}); if(eco.chains.length > 24) eco.chains.pop();
  }catch(e){ try{ console.warn("engSeed", e); }catch(x){} }
}
function engChainsDay(){
  const eco = engEco(), E = engEnsure(); let any = 0;
  if(eco.chains.length > 24) eco.chains.length = 24;
  eco.chains.forEach(c => c.steps.forEach(s => { if(s.done || s.due > G.day) return; s.done = true; s.day = G.day; any++; const f = s.fx || {};
    if(f.hh != null){ const h = eco.hh[f.hh]; if(h){ h.home = clamp(h.home + (f.home || 0), 0, 100); h.stance = clamp(h.stance + (f.st || 0), -100, 100); } }
    if(f.town){ const T = engTown(f.town); if(T){ T.eng = T.eng || {a:0}; T.eng.a = clamp(T.eng.a + (f.a || 0), 0, 1); if(!ENG_DRY.on) try{ T.log.unshift({d:G.day, t:s.t}); if(T.log.length > onumLim(14,"hist")) T.log.length = onumLim(14,"hist"); }catch(e){} } }
    if(f.state){ eco.mod[f.state] = clamp((eco.mod[f.state] || 0) + (f.mod || 0), -1, 1); }
    if(s.lvl === "nation"){ if(E.scaleOpen){ if((f.p || 0) >= 0) engAddCapability(E, f.p || 0); else E.p = Math.max(0, (E.p || 0) + (f.p || 0)); } else E.p = clamp(E.p + (f.p || 0), 0, 100); E.safety = clamp(E.safety + (f.safety || 0), 0, 100); try{ pushWireScrap("The Engine", s.t); }catch(e){} }
    if(s.lvl === "state" && f.state === (G.you && G.you.state)){ try{ orgNews(s.t, true); }catch(e){} } }));
  return any;
}
/* the whole country each day, from households up and back down */
function engEcoDay(E){
  const eco = engEco(), O = orgEnsure(), s = E.st, post = {open:0.15, charter:0, sealed:-0.12}[E.posture] || 0; let sumSt = 0, nSt = 0, riots = 0;
  (G.states || []).forEach(S => {
    const T = O.towns[S.n] || []; let stSum = 0, stN = 0; const mod = eco.mod[S.n] || 0;
    T.forEach(t => { t.eng = t.eng || {a:0}; const need = Math.max.apply(null, Object.keys(t.needs).map(k => t.needs[k])) / 100;
      const target = clamp(s * 0.15 + need * 0.35 + mod * 0.25 + post, 0, 1); t.eng.a += (target - t.eng.a) * 0.1;
      const a = t.eng.a, relief = a * s * (0.2 + 0.16 * E.safety / 100) + (s >= 4 ? 0.07 * a * E.safety / 100 : 0), disp = a * s * 0.5 * (1 - Math.min(0.55, E.talent / 100 * 0.6 + (s >= 5 ? 0.15 : 0)));
      if(s >= 1){ const worst = Object.keys(t.needs).sort((x, y) => t.needs[y] - t.needs[x])[0]; t.needs[worst] = Math.max(0, t.needs[worst] - relief); t.needs.order = clamp(t.needs.order + disp * 0.18, 0, 100); t.needs.bread = clamp(t.needs.bread + disp * 0.1, 0, 100); }
      let tsum = 0, tn = 0; eco.hh.filter(h => h.town === t.id).forEach(h => { const benefit = relief * 1.1, harm = disp * h.expo * 1.6; h.home = clamp(h.home + benefit - harm + (62 - h.home) * 0.012 + (Math.random() - 0.5) * 0.6, 0, 100);
        let ds = benefit * 6 - harm * 6; if(h.will === "be left alone") ds -= 0.25 * a * 4; if(h.will === "be somebody") ds += 0.2 * a * 3; if(h.will === "keep the shop open") ds -= harm * 2; if(h.will === "see my girl through school") ds += benefit * 3;
        h.stance = clamp(h.stance * 0.972 + ds, -100, 100); tsum += h.stance; tn++; if(Math.abs(h.stance) > 14 && Math.random() < 0.05) h.wrote = G.day;
        if(h.home < 22 && h.stance < -40 && chance(0.04)){ riots++; const tx = h.name + " of " + t.name + " and forty others close the " + h.job + "s' hall and stand in the road with a sign about machines."; if(!ENG_DRY.on) try{ t.log.unshift({d:G.day, t:tx}); if(t.log.length > onumLim(14,"hist")) t.log.length = onumLim(14,"hist"); orgNews(tx, orgIsMyState(S.n)); }catch(e){} S.unrest = clamp((S.unrest || 30) + 1.5, 0, 100); h.stance = clamp(h.stance + 18, -100, 100);
          eco.chains.unshift({id:eco.id++, d:G.day, root:"The Engine reached " + t.name + " faster than " + h.name + " could change trades", kind:"strike", steps:[{a:0, lvl:"home", sc:{town:t.id, state:S.n, hh:h.id}, day:G.day, t:tx, due:G.day, done:true, fx:{}}, {a:2, lvl:"town", sc:{town:t.id, state:S.n}, t:"The council of " + t.name + " asks the state for retraining money.", due:G.day + 2, done:false, fx:{town:t.id, a:-0.06}}, {a:4, lvl:"state", sc:{state:S.n}, t:S.n + " votes a small retraining fund.", due:G.day + 4, done:false, fx:{state:S.n, mod:-0.08}}]}); if(eco.chains.length > 24) eco.chains.pop(); } });
      const m = t.mayor || {}; const ts = (tn ? tsum / tn : 0) + (m.trait === "bold" ? 8 : 0) + (m.trait === "corrupt" && a > 0.2 ? 6 : 0); t._est = ts; stSum += ts; stN++; });
    const st = stN ? stSum / stN : 0; S._est = st; sumSt += st; nSt++;
    if(s >= 2) S.unrest = clamp((S.unrest || 30) + clamp(-st / 420, -0.06, 0.09), 0, 100);
    const lawOk = G.day - ((eco.lawAt = eco.lawAt || {})[S.n] == null ? -999 : eco.lawAt[S.n]) >= 60;   /* 20261027c: a legislature passes an engine law, then lives with it a season */
    if(lawOk && st < -28 && chance(0.12) && mod > -0.8){ eco.lawAt[S.n] = G.day; eco.mod[S.n] = clamp(mod - 0.35, -1, 1); const tx = S.n + " passes a charter law: licences for any engine that does a clerk's work, and a fee that goes to the clerks."; try{ orgNews(tx, orgIsMyState(S.n)); }catch(e){} eco.chains.unshift({id:eco.id++, d:G.day, root:"The state of " + S.n + " is tired of waiting", kind:"law", steps:[{a:0, lvl:"state", sc:{state:S.n}, day:G.day, t:tx, due:G.day, done:true, fx:{}}, {a:3, lvl:"nation", sc:{}, t:"The other capitals read " + S.n + "'s law and a few copy it.", due:G.day + 3, done:false, fx:{p:-0.4, safety:0.6}}]}); }
    else if(lawOk && st > 28 && chance(0.10) && mod < 0.8){ eco.lawAt[S.n] = G.day; eco.mod[S.n] = clamp(mod + 0.3, -1, 1); const tx = S.n + " votes a subsidy for engine houses in its mill towns."; try{ orgNews(tx, orgIsMyState(S.n)); }catch(e){} eco.chains.unshift({id:eco.id++, d:G.day, root:"The state of " + S.n + " has seen what works", kind:"law", steps:[{a:0, lvl:"state", sc:{state:S.n}, day:G.day, t:tx, due:G.day, done:true, fx:{}}, {a:3, lvl:"nation", sc:{}, t:"A subsidy in " + S.n + " pulls two makers' shops across the border.", due:G.day + 3, done:false, fx:{p:0.5, safety:-0.3}}]}); }
  });
  Object.keys(eco.mod).forEach(k => { eco.mod[k] *= 0.99; });   /* once a day: inside the state loop it ran twenty times and a stance lasted three days */
  const avg = nSt ? sumSt / nSt : 0, am = Object.keys(eco.mod).length ? Object.keys(eco.mod).reduce((a, k) => a + eco.mod[k], 0) / Object.keys(eco.mod).length : 0;
  eco.nat = clamp(1 + avg * 0.004 + am * 0.18, 0.72, 1.35); eco.avg = avg; eco.riots = riots;
  return eco.nat;
