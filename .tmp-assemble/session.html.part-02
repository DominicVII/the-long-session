/* the reasoned move: say so, or keep it quiet. Care, oversight and an in-force posting article push toward saying; wanting to be left alone and a high autonomy pull away; the more it can predict that you will be afraid, the likelier it waits */
function engEmergeDisclose(E, a){
  const w = engEco().will, C = engCharter(), P = 0.35 + w.care / 220 + E.safety / 260 - w.auton / 240 - (a.gap ? 0.12 : 0) + (C.posted ? 0.15 : 0) + (E.reliance >= 4 ? 0.1 : 0);
  return chance(clamp(P, 0.08, 0.95));
}
function engEmergeDay(E){
  if(!E || E.st < 3) return; const X = engEmerge(E); if(E.pause && G.day < E.pause) return;
  ENG_EMERGE.forEach(a => {
    if(X.done[a.k] || E.p < a.p || E.compute < a.c || E.talent < a.m || (a.req && !inqDone(a.req))) return;
    if(!chance(0.012 + (E.p - a.p) / 900)) return;      /* unforecastable: a small chance every day once the conditions are met */
    X.done[a.k] = G.day; const told = engEmergeDisclose(E, a); X.told[a.k] = told ? G.day : 0;
    if(a.rate) E.emRate = (E.emRate || 0) + a.rate; if(a.cal) E.cal = clamp((E.cal == null ? 50 : E.cal) + a.cal, 0, 100); if(a.fid) E.emFid = (E.emFid || 0) + a.fid;
