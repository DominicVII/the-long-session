    L.items.push({id, src:"suggestion", from:s.from || "a constituent", topic:s.topic || "", text:String(s.text).slice(0, 200), at:G.day}); };
  const takeChg = c => { if(!c) return; const L = store(), id = "c:" + (c.id != null ? c.id : hash(c.name + c.kind)); if(L.items.some(x => x.id === id)) return;
    const need = c.status && !/open|done|approved|built/i.test(c.status) ? String(c.status).replace(/^needs\s+/i, "") : "a permit";
