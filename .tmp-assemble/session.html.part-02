    return r;
  });
  /* code elsewhere clicks [data-ans="id:i"] inside the inbox; keep that working */
  CL.testMail = () => { try{ realmEnsure(); const r = G.realms[0]; for(let i = 0; i < 3; i++){ r._cableT = -1e9; realmCable(r); } r2 = G.realms[1]; r2._cableT = -1e9; realmCable(r2);
    const ms = G.members.filter(m => !m.gone && m.kind === "member"); pushMail(ms[0], "A word about the other day", "I would rather say it in writing.", {kind:"grievance", options:[{t:"Apologise properly", run(){ ripple(ms[0], 11, "You wrote back.", 7, true); }},{t:"Leave it unanswered", run(){ ripple(ms[0], -6, "You never replied.", -8, true); }}]});
    pushMail(null, "Your letter came back unopened", "The office of " + ms[1].name + " returned your letter unopened."); pushMail(ms[2], "Whip notice: caucus at ten", "Attendance expected.", {kind:"vote"}); }catch(e){ console.warn("testMail", e); } };
  var r2;
  MAILK.cable = "A diplomatic cable from a foreign power. It tells you what they want and who in this House they are courting. You can acknowledge it, pass it to your committee and party, make it public, or ignore it — each moves your influence, standing or relations with them.";
  /* ── UNION MAP: click a state or town → action panel (diplomacy, interference, espionage, support) ── */
  G.clOps = G.clOps || []; G.clState = G.clState || {};
  function seeded(str){ let h = 2166136261; str = String(str); for(let i = 0; i < str.length; i++){ h ^= str.charCodeAt(i); h = Math.imul(h, 16777619); } return ((h >>> 0) % 10000) / 10000; }
  function stRel(n){ G.clState = G.clState || {}; return G.clState[n] || (G.clState[n] = {rel:0, informant:false, dirt:0, pact:0}); }
  function isGov(){ try{ return G.you.office === "gov" || G.you.post === "governor" || /governor/i.test(G.you.title || ""); }catch(e){ return false; } }
  function del(n){ try{ return stateDelegation(n).filter(m => !m.gone); }catch(e){ return []; } }
  function warmDel(n, d, why){ del(n).slice(0, 6).forEach(m => { try{ ripple(m, d, why, Math.sign(d) * 2); }catch(e){} }); }
  /* A: action defs. inf = influence cost, risk = exposure chance (0..1) before modifiers, days = when it resolves */
  const UA = [
    {g:"Diplomacy", k:"neg", t:"Negotiate", inf:3, risk:0, days:0, need:() => true, fx:"Relations +4, delegation warmer. Costs 3 influence and an hour.", run(n, s){ stRel(n).rel += 4; warmDel(n, 3, "You came to us instead of going round us."); }},
    {g:"Diplomacy", k:"coop", t:"Cooperate on a shared problem", inf:4, risk:0, days:0, need:() => true, fx:"Its unrest −3, relations +3.", run(n, s){ s.unrest = clamp(s.unrest - 3, 0, 100); stRel(n).rel += 3; }},
    {g:"Diplomacy", k:"pact", t:"Form a joint pact", inf:8, risk:0, days:0, need:n => stRel(n).rel >= 6 || n === G.you.state, why:"Needs relations ≥ 6 (negotiate first)", fx:"Pact for 10 days: relations +6, its delegation leans your way on the floor; breaking it later costs standing.", run(n, s){ const r = stRel(n); r.pact = G.day + 10; r.rel += 6; warmDel(n, 5, "We have a pact with your office."); }},
    {g:"Diplomacy", k:"fav", t:"Trade favours", inf:5, risk:0.05, days:0, need:() => true, fx:"Influence back over days (+1/day ×4) and relations +2; a favour owed is a favour remembered.", run(n){ stRel(n).rel += 2; G.clOps.push({k:"favret", st:n, due:G.day + 1, left:4}); }},
    {g:"Interfere with its bills", k:"lobby", t:"Lobby against its bill", inf:6, risk:0.08, days:0, need:(n, s) => !!s.bill, why:"Nothing before its statehouse", fx:"Uses the existing statehouse push (−). Relations −2.", run(n, s){ G.you.influence += 6; pushStateBill(s, -1); stRel(n).rel -= 2; }},
    {g:"Interfere with its bills", k:"fund", t:"Fund the opposition", inf:4, cash:true, risk:0.18, days:2, need:(n, s) => !!s.bill, why:"Nothing before its statehouse", fx:"Costs 4 influence and funds; the bill loses ground over 2 days. 18% chance it is traced to you (scandal)."},
    {g:"Interfere with its bills", k:"rally", t:"Rally its delegation", inf:5, risk:0, days:0, need:n => del(n).length > 0, why:"You know nobody in its delegation", fx:"Delegation warmth +4; they are likelier to vote with you on the federal bill.", run(n){ warmDel(n, 4, "You took the time to work our delegation."); }},
    {g:"Interfere with its bills", k:"leak", t:"Leak to its press", inf:3, risk:0.25, days:1, need:() => true, fx:"Its unrest +4, its bill weakens; 25% chance the leak is traced (standing −4, relations −6)."},
    {g:"Inner workings & espionage", k:"inform", t:"Plant an informant", inf:6, risk:0.15, days:2, need:() => true, fx:"Ongoing: cuts the risk of every later operation here by a third and sends you reports. 15% exposure."},
    {g:"Inner workings & espionage", k:"dirt", t:"Gather dirt on officials", inf:5, risk:0.2, days:3, need:() => true, fx:"Finds a compromising fact (kept for smear or turning). 20% exposure."},
    {g:"Inner workings & espionage", k:"icept", t:"Intercept its cables", inf:5, risk:0.22, days:2, need:() => isGov() || G.you.influence >= 30 || stRel_(), why:"Governor, or influence ≥ 30", fx:"You get its private correspondence as mail: who it is courting, what it will trade. 22% exposure."},
    {g:"Inner workings & espionage", k:"sab", t:"Sabotage or delay its bill", inf:7, risk:0.3, days:2, need:(n, s) => !!s.bill, why:"Nothing before its statehouse", fx:"Pushes its bill's vote back 2–4 days and weakens it. 30% exposure (standing −6, scandal)."},
    {g:"Inner workings & espionage", k:"smear", t:"Run a covert smear", inf:6, risk:0.32, days:3, need:n => stRel(n).dirt > 0 || del(n).length > 0, why:"Need dirt or a known official", fx:"A delegation member loses standing and warmth toward your enemies; uses your dirt if you have it (lower risk). 32% exposure."},
    {g:"Inner workings & espionage", k:"turn", t:"Turn an official", inf:10, risk:0.28, days:4, need:n => stRel(n).dirt > 0 && del(n).length > 0, why:"Need dirt and a known official", fx:"One of its members becomes quietly yours: big warmth, a pledge on the bill. 28% exposure, worse if it fails."},
    {g:"Support its bills", k:"sup", t:"Support its bill", inf:6, risk:0, days:0, need:(n, s) => !!s.bill, why:"Nothing before its statehouse", fx:"Uses the existing statehouse push (+). Relations +3.", run(n, s){ G.you.influence += 6; pushStateBill(s, 1); stRel(n).rel += 3; }}
  ];
  function stRel_(){ return false; }
  function riskOf(a, n){ let r = a.risk; const R = stRel(n); if(R.informant) r *= 0.66; if(isGov()) r *= 0.85; if(a.k === "smear" && R.dirt > 0) r *= 0.7; return Math.round(r * 100); }
  function runUA(n, k, town){
    G.clOps = G.clOps || [];
    const s = stateOf(n), a = UA.find(x => x.k === k); if(!s || !a || !G.you) return;
    if(G.you.influence < a.inf || !a.need(n, s)) return;
    G.you.influence -= a.inf; try{ spend(a.days ? 45 : 60, a.days ? 10 : 8); }catch(e){}
    if(a.cash){ try{ G.you.funds = Math.max(0, (G.you.funds || 0) - 20); }catch(e){} }
    if(a.run) a.run(n, s);
    else { G.clOps.push({k, st:n, town:town || null, due:G.day + a.days, seed:G.day + ":" + n + ":" + k + ":" + G.clOps.length, risk:riskOf(a, n) / 100}); }
    try{ note((a.days ? "Set in motion in " + n + ": " : "In " + n + ": ") + a.t.toLowerCase() + (town ? " (" + town + ")" : "") + "." + (a.days ? " Results in about " + a.days + " day" + (a.days > 1 ? "s" : "") + "." : "")); }catch(e){}
    try{ refreshPanels(); }catch(e){} try{ refreshUnion(); }catch(e){}
  }
  CL.unionAct = runUA;
  /* resolve operations day by day, seeded so results are stable for a given save */
  function resolveOps(){
    G.clOps = G.clOps || [];
    try{
      if(!G.clOps || !G.clOps.length || !G.you) return;
      const keep = [];
      G.clOps.forEach(o => {
        if(o.due > G.day){ keep.push(o); return; }
        const s = stateOf(o.st); const R = stRel(o.st); const ms = del(o.st);
        if(o.k === "favret"){ G.you.influence = clamp(G.you.influence + 1, 0, 100); if(--o.left > 0){ o.due = G.day + 1; keep.push(o); } return; }
        const roll = seeded(o.seed + ":x"), ok = seeded(o.seed + ":ok") < 0.55 + G.you.influence / 250 + R.rel / 100;
        const exposed = roll < o.risk;
        const target = ms.length ? ms[Math.floor(seeded(o.seed + ":t") * ms.length)] : null;
        let sub = "", body = "";
        if(exposed){
          G.you.standing = clamp(G.you.standing - (o.k === "turn" || o.k === "sab" ? 6 : 4), 0, 100); R.rel -= 6;
          try{ G.secrets = G.secrets || []; G.secrets.push({id:Date.now() + Math.floor(seeded(o.seed) * 999), t:"Your office ran a covert " + o.k + " operation in " + o.st + ".", about:0, knownBy:target ? [target.id] : [], exposure:6, day:G.day}); }catch(e){}
          try{ pushWireScrap("Wire", o.st + " statehouse alleges interference by a federal member's office."); }catch(e){}
          sub = "Exposed in " + o.st; body = "Your people were seen. " + o.st + " knows someone was working against it, and the trail is warm.\n\nStanding −, relations with " + o.st + " −6, and a secret is now in circulation (see Risks).";
        } else if(!ok){
          sub = "Nothing came of it in " + o.st; body = "The " + o.k + " operation in " + o.st + " found nothing usable. No one noticed. Influence spent.";
        } else {
          if(o.k === "inform"){ R.informant = true; sub = "Informant in place — " + o.st; body = "Someone inside the " + o.st + " statehouse now talks to your office. Future operations there are safer, and you will hear things first."; }
          if(o.k === "dirt"){ R.dirt++; sub = "A file on " + (target ? target.name : "an official in " + o.st); body = (target ? target.name : "An official") + " " + ["took a donor's holiday they never declared", "has a second phone their chief of staff pays for", "voted on a contract their brother bid for", "missed a session for a reason that was not illness"][Math.floor(seeded(o.seed + ":d") * 4)] + ".\n\nKept on file. Use it to smear or to turn."; }
          if(o.k === "icept"){ sub = "Intercepted: " + o.st + " correspondence"; body = "Their governor's office is courting " + (target ? target.name : "your whip") + " and will trade " + ["a highway grant", "its delegation's votes on the next bill", "silence on the floods", "a seat on a committee"][Math.floor(seeded(o.seed + ":i") * 4)] + " for support." + (s && s.bill ? "\n\nOn " + s.bill.title + " they think they have the votes by " + Math.max(1, s.bill.due - G.day) + " days." : ""); R.rel += 0; }
          if(o.k === "fund" || o.k === "leak"){ if(s && s.bill) s.bill.pushed = (s.bill.pushed || 0) - (o.k === "fund" ? 14 : 8); if(o.k === "leak" && s) s.unrest = clamp(s.unrest + 4, 0, 100); sub = (o.k === "fund" ? "Opposition funded" : "Leak ran") + " in " + o.st; body = s && s.bill ? s.bill.title + " has lost ground in the statehouse." : "It ran. People are talking."; }
          if(o.k === "sab"){ if(s && s.bill){ s.bill.due += 2 + Math.floor(seeded(o.seed + ":s") * 3); s.bill.pushed = (s.bill.pushed || 0) - 10; } sub = "Delay in " + o.st; body = "A procedural snag nobody can explain has pushed the vote back. It looks like an accident."; }
          if(o.k === "smear" && target){ try{ target.standing = clamp((target.standing || 50) - 6, 0, 100); }catch(e){} if(R.dirt > 0) R.dirt--; try{ pushWireScrap("Wire", target.name + " under questions at home."); }catch(e){} sub = "Smear landed: " + target.name; body = "The story about " + target.name + " is running in " + o.st + ". It did not come back to you — yet."; }
          if(o.k === "turn" && target){ try{ ripple(target, 18, "We have an understanding now, you and I.", 10, true); target.pledge = 1; target.pledgeDay = G.day; }catch(e){} R.dirt = Math.max(0, R.dirt - 1); sub = "An understanding with " + target.name; body = target.name + " will vote with you on the bill and keep you told. They also know what you know about them; that cuts both ways."; }
          if(!sub){ sub = "Done in " + o.st; body = "It went as planned."; }
        }
        try{ pushMail(null, sub, body, {kind:"intel"}); }catch(e){}
      });
      G.clOps = keep;
    }catch(e){ try{ console.warn("NEPTUNE-CLARITY ops", e); }catch(e2){} }
  }
  CL.resolveOps = resolveOps;
  let lastDay = null;
  setInterval(() => { try{ if(!G || G.day == null) return; if(lastDay !== null && G.day !== lastDay) resolveOps(); lastDay = G.day; }catch(e){} }, 1500);
  function unionPanel(n){
    G.clOps = G.clOps || [];
    const s = stateOf(n); if(!s || !G.you) return "";
    const R = stRel(n); let towns = [];
    try{ towns = (stateLore(n).towns || []).map(t => t.name); }catch(e){}
    const gov = isGov();
    let h = '<div class="billbox cl-union" style="margin-top:12px"><div class="eyebrow">Your options in ' + esc(n) + (CL.town ? ' · ' + esc(CL.town) : '') + '</div>' +
      nameSummary("state", n) + sumRow("Your role", gov ? "Governor (more reach in statehouses, lower exposure)" : (inHouse() ? "House member" : ndYou().title)) + sumRow("Your influence", Math.round(G.you.influence)) +
      sumRow("Relations", (R.rel > 0 ? "+" : "") + R.rel + (R.pact > G.day ? " · pact until day " + R.pact : "") + (R.informant ? " · informant in place" : "") + (R.dirt ? " · " + R.dirt + " file(s) of dirt" : "")) +
      (towns.length ? '<div style="margin:6px 0;font:12px system-ui">Towns: ' + towns.map(t => '<button type="button" class="cl-btn" data-cltown="' + esc(t) + '"' + (CL.town === t ? ' style="background:#2f5d3a;color:#fff"' : '') + '>' + esc(t) + '</button>').join("") + '</div>' : '') +
      (G.clOps.filter(o => o.st === n && o.k !== "favret").length ? '<p class="muted">Under way: ' + G.clOps.filter(o => o.st === n && o.k !== "favret").map(o => esc(UA.find(a => a.k === o.k).t) + " (day " + o.due + ")").join(", ") + '</p>' : '');
    let grp = "";
    UA.forEach(a => {
      if(a.g !== grp){ grp = a.g; h += '<div class="cl-sech" style="cursor:default">' + esc(grp) + '</div>'; }
      const okNeed = a.need(n, s), okInf = G.you.influence >= a.inf, rk = riskOf(a, n);
      h += '<div style="display:flex;gap:6px;align-items:flex-start;margin:3px 0"><button type="button" class="conc__btn" style="width:auto;flex:0 0 auto" data-clua="' + a.k + '"' + (okNeed && okInf ? '' : ' disabled') + '>' + esc(a.t) + '</button>' +
        '<div style="font:11.5px/1.35 system-ui"><b>Cost</b> ' + a.inf + ' influence' + (a.cash ? ' + funds' : '') + ' · <b>Risk</b> ' + (rk ? rk + '% exposure' : 'none') + ' · <b>When</b> ' + (a.days ? "~" + a.days + " day(s)" : "now") + '<br>' + esc(a.fx) +
        (!okNeed ? '<br><i>Locked: ' + esc(a.why || "not available") + '</i>' : !okInf ? '<br><i>Locked: need ' + a.inf + ' influence</i>' : '') + '</div></div>';
    });
    return h + '</div>';
  }
  wrap("refreshUnion", () => refreshUnion, f => { refreshUnion = f; }, orig => function(){
    const P = el("paneUnion"), keep = P ? scrollers(P) : [];
    const r = orig.apply(this, arguments);
    try{
      if(P && G.mapSel){
        if(CL._unionSt !== G.mapSel){ CL.town = null; CL._unionSt = G.mapSel; }
        const box = P.querySelector(".billbox"); const d = document.createElement("div"); d.innerHTML = unionPanel(G.mapSel);
        if(box && box.parentNode) box.parentNode.insertBefore(d, box.nextSibling); else P.appendChild(d);
        d.querySelectorAll("[data-clua]").forEach(b => b.addEventListener("click", () => runUA(G.mapSel, b.getAttribute("data-clua"), CL.town)));
        d.querySelectorAll("[data-cltown]").forEach(b => b.addEventListener("click", () => { CL.town = b.getAttribute("data-cltown"); refreshUnion(); }));
        keep.forEach(([e, t]) => { e.scrollTop = t; });
      }
    }catch(e){ try{ console.warn("NEPTUNE-CLARITY union", e); }catch(e2){} }
    return r;
  });
  MAILK.intel = "A report from an operation you set in motion in another state. It may be a success, a dud, or news that you were caught. Check Risks if it says you were exposed.";
  console.log("NEPTUNE clarity ready");
}catch(e){ try{ console.warn("NEPTUNE-CLARITY block", e); }catch(e2){} }
/* NEPTUNE-CLARITY END */
/* NEPTUNE-SITTINGS BEGIN — every step-card sitting (Senate, oral argument, the morning briefing,
   State House open hours) plus committee hearings, party meetings and press conferences becomes a
   live scene: a cast of named people drawn from the game's members, parties and states, each with an
   agenda, a temper and allies or rivals, who speak, interrupt, rebut and react (2–6 exchanges a step).
   At each step you choose: a pointed question, object, yield, side with a speaker, propose a
   compromise, cut someone off, whisper a deal, or stay silent. Stance meters per speaker move live and
   decide the ruling, which is explained in a recap. Lines feed the transcript, the NEPTUNE-CLARITY
   Session Log ("What they meant") and follow the Session pace. Speakers turn to each other in 3D.
   Wraps sitStart/sitNext/sitPick/sitDraw/sitEnd; any error falls back to the original step card. */
try{
  const SX = window.NEPTUNE_SITTINGS = {ver:"20261013e", on:false, fails:0, log:[], matter:{}, castFor:{}, after:{}};
  const O = {sitStart, sitStep, sitBeat, sitPick, sitNext, sitOutcome, sitEnd, sitDraw};
  const esc = s => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({"&":"&"+"amp;","<":"&"+"lt;",">":"&"+"gt;",'"':"&"+"quot;"}[c]));
  const CLr = () => window.NEPTUNE_CLARITY || null;
  const PACE_MS = {slow:3400, normal:2400, fast:1500};
  const beatMs = () => { const c = CLr(); return PACE_MS[(c && c.pace) || "normal"] || 2400; };
  const rnd = (a, b) => a + Math.random() * (b - a);
  const one = a => a[Math.floor(Math.random() * a.length)];
  const cl = (v, a, b) => Math.max(a, Math.min(b, v));
  const sn = n => { try{ return surname(n); }catch(e){ return String(n).split(" ").pop(); } };
  const pl = p => { try{ return partyLabel(p); }catch(e){ return p || ""; } };

  /* the three new sittings use the same step headers */
  SIT_DEF.committee = {title:"Committee hearing", chair:"The Chair", min:50, en:12, kind:"vote", key:"sxcmte",
    steps:["gavel","open","question","question","motion","deliberate","vote","adjourn"]};
  SIT_DEF.caucus = {title:"Party meeting", chair:"The Whip", min:40, en:8, kind:"vote", key:"sxcauc",
    steps:["gavel","open","question","motion","deliberate","vote","adjourn"]};
  SIT_DEF.floor = {title:"The House sits", chair:"The Speaker", min:60, en:0, kind:"vote", steps:["gavel","open","question","question","motion","deliberate","vote","adjourn"]};
  SIT_DEF.press = {title:"Press conference", chair:"The press secretary", min:30, en:6, kind:"decision", key:"sxpress",
    steps:["gavel","open","question","question","motion","ruling","adjourn"]};
  const KEY = {senate:"ksen", court:"kct", exec:"kex", govoffice:"kgv"};

  /* ── what is in front of the room ── */
  const matterFor = function(room){
    if(SX.matter[room]) return SX.matter[room]();
    const y = G.you, bill = G.bill && !G.bill.done ? G.bill : null, cs = (G.cases || []).find(x => x && !x.done);
    const st = (G.states || []).find(s => s.n === y.state), hot = (G.states || []).slice().sort((a, b) => (b.unrest || 0) - (a.unrest || 0))[0];
    let side = 0; try{ if(bill) side = (typeof preferredVote === "function" ? preferredVote(bill) : (y.vote === 1 || y.vote === -1 ? y.vote : 0)) || 0; }catch(e){}
    const bt = bill ? bill.title : "the appropriations calendar";
    const M = {
      senate:{q:(side > 0 ? "passing " : side < 0 ? "defeating " : "whether to pass ") + bt, short:bt, yes:"aye", no:"no", comp:"a sunset clause and a cap on the first-year cost"},
      committee:{q:(side > 0 ? "reporting " : side < 0 ? "holding " : "what to do with ") + bt + (side > 0 ? " to the floor" : side < 0 ? " in committee" : ""), short:bt, yes:"report it", no:"hold it", comp:"a markup that strikes section four and adds a review in two years"},
      caucus:{q:"your vote on " + bt + " being " + (side > 0 ? "yes" : side < 0 ? "no" : "not yet set"), short:bt, yes:"hold the line", no:"a free vote", comp:"a free vote for members from close districts, the line for everyone else"},
      court:{q:cs ? "a ruling that " + (cs.t || "the act") + " stands" : "denying the motion on filing deadlines", short:cs ? (cs.t || "the case") : "the motion", yes:"for the Union", no:"for the petitioner", comp:"a narrow holding on this record only"},
      exec:{q:"sending emergency money to " + (hot ? hot.n : "the worst-hit state") + " today", short:"aid to " + (hot ? hot.n : "the states"), yes:"sign it", no:"hold it", comp:"half now, half after the auditors report"},
      govoffice:{q:"fixing what the petitioners brought in today out of this year's budget", short:"the petitions", yes:"grant", no:"defer", comp:"the road and the school now, the water main in the spring budget"},
      press:{q:"your line on " + bt + " leading tomorrow's papers", short:bt, yes:"your line", no:"their story", comp:"a straight answer and a promise of figures by Friday"}
    };
    const m = M[room] || M.senate; m.state = st ? st.n : y.state; m.hot = hot ? hot.n : y.state; m.bill = bill; m.cs = cs; return m;
  }

  /* ── the cast: real members where we can, named townspeople where the room calls for them ── */
  const CIV = {
    govoffice:[["dairy farmer","the co-op road washed out in spring and is still out"],["school board chair","three teachers short and the state check is late"],["mayor","the water main the state required, which the town cannot pay for"],["union steward","the plant permit, or the plant closes"],["county clerk","ballots for the special election that never came"],["widow","a pension letter that came back unopened"]],
    court:[["counsel for the petitioner","the act reaches past the Charter"],["counsel for the Union","the act is the law and the law is clear"]],
    exec:[["budget director","not moving money the treasury has not got"],["deputy for the states","calm in the states before the weekend"]],
    committee:[["deputy secretary (witness)","the department's figures, defended under oath"]],
    press:[["reporter, the Capitol Ledger","the cost nobody has published"],["reporter, the Evening Wire","who wrote the bill and who paid for it"],["reporter, a home-state paper","what this means back home"]],
    caucus:[], senate:[]
  };
  const civ = function(role, want, st){ let n = "Pat Doe"; try{ n = newName(st || G.you.state); }catch(e){} return {m:null, name:n, role, want, party:null, state:st || G.you.state, temper:rnd(20, 80), conv:rnd(20, 80), vanity:rnd(10, 70), warmth:rnd(-10, 15), case:(function(){ try{ return caseFile(role, want, st || G.you.state, n); }catch(e){ return null; } })()}; }
  let _aideM = null;
  const buildCast = function(room, M){
    const y = G.you; let here = [];
    try{ here = hereNow().filter(m => m && m.name && m !== y && m !== _aideM && !m.machine && !m.gone && m.kind === "member"); }catch(e){}
    let pool = (G.members || []).filter(m => m && !m.gone && !m.machine && m.kind === "member" && m !== y && m !== _aideM);
    const pref = {committee:m => m.cmte === y.committee, caucus:m => m.party === y.party, govoffice:m => m.state === y.state, senate:m => m.house === "senate" || true}[room] || (() => true);
    const want = {govoffice:2, court:1, exec:2, committee:4, caucus:4, senate:4, press:1}[room] || 3;
    const picked = here.filter(pref).slice(0, want);
    pool.filter(m => pref(m) && !picked.includes(m)).sort(() => Math.random() - 0.5).forEach(m => { if(picked.length < want) picked.push(m); });
    here.forEach(m => { if(picked.length < want && !picked.includes(m)) picked.push(m); });
    let out = picked.map(m => ({m, name:m.name, role:(m.post ? m.post + ", " : "") + pl(m.party) + " · " + m.state, party:m.party, state:m.state,
      temper:m.traits.temper, conv:m.traits.conviction, vanity:m.traits.vanity, warmth:(m.rel && m.rel.warmth) || 0, want:null}));
    const C = (CIV[room] || []).slice().sort(() => Math.random() - 0.5).slice(0, room === "govoffice" ? 3 : room === "press" ? 3 : 2);
    if(room === "court" || room === "committee" || room === "exec") C.splice(0, 0); 
    C.forEach(c => out.push(civ(c[0], c[1], room === "govoffice" ? y.state : (M.cs && M.cs.state) || y.state)));
    if(SX.castFor[room]) out = SX.castFor[room](M, out) || out;
    /* never a generic foreigner: anyone labelled as an envoy/diplomat takes the realm's named head of mission */
    out.forEach(p => { try{ if(/foreign|envoy|diplomat|emissary/i.test(p.name + " " + (p.role || "")) || (p.m && p.m.kind === "envoy")){ const rk = (p.m && p.m.realm) || (G.realms && G.realms[0] && G.realms[0].k); const e = window.onumForeignEnvoy && window.onumForeignEnvoy(rk);
      if(e){ p.name = e.name; p.role = e.title + " of " + ((G.realms || []).find(r => r.k === rk) || {}).t; } } }catch(e){} });
    /* agenda, stance (0 = against you … 100 = with you), relationships */
    out.forEach((p, i) => {
      p.id = i; p.sn = sn(p.name); p.spoke = 0; p.cut = 0; p.dealt = false; p.moved = 0; p.hist = [];
      let lean = 0;
      try{ if(p.m && M.bill){ const v = memberVote(p.m, M.bill); const mine = (typeof preferredVote === "function" ? preferredVote(M.bill) : 0) || 0; lean = mine ? v * mine * 22 : 0; } }catch(e){}
      if(p.m && p.party === y.party) lean += 10; else if(p.m && p.party) lean -= 6;
      if(/counsel for the Union|budget director|witness/.test(p.role)) lean -= 14;
      if(/petitioner|deputy for the states|home-state/.test(p.role)) lean += 8;
      p.stance = p.stance0 != null ? p.stance0 : cl(Math.round(50 + lean + p.warmth * 0.6 + rnd(-16, 16)), 8, 92);
      p.want = p.want || (p.m ? one([
        "a carve-out for " + p.state, "credit at home in " + p.state, "a seat at the table on " + M.short,
        p.party === y.party ? "the party line held, and seen to hold" : "making your side pay for " + M.short,
        "the cost written down before anyone votes", "a hearing for the " + (p.m.cmte ? committeeOf(p.m.cmte).t.toLowerCase() : "committee")]) : p.want);
      p.start = p.stance;
    });
    out.forEach(p => { p.allies = []; p.rival = null;
      out.forEach(q => { if(q === p) return;
        if(p.m && q.m && ((p.m.allies || []).includes(q.m.id) || (p.party && p.party === q.party && Math.random() < 0.6))) p.allies.push(q.id);
        if(p.m && q.m && p.m.rival === q.m.id) p.rival = q.id; });
      if(p.fixAllies) p.allies = p.fixAllies.filter(j => j !== p.id && out[j]); if(p.fixRival != null && out[p.fixRival] && p.fixRival !== p.id) p.rival = p.fixRival;
      if(p.rival == null){ const opp = out.filter(q => q !== p && Math.abs(q.stance - p.stance) > 30); if(opp.length && Math.random() < 0.7) p.rival = one(opp).id; } });
    try{ const cs = out.filter(p => p.case); if(cs.length > 1 && room === "govoffice") M.comp = cs.map(p => p.case.settleShort).slice(0, 3).join("; "); }catch(e){}
    return out;
  }

  /* ── voices ── */
  const side = p => p.stance >= 55 ? 1 : p.stance <= 45 ? -1 : 0; /* same cut as the card: with you / against / undecided */
  const call = function(p){ return p.m ? ((p.m.krole === "senator" || p.m.house === "senate") ? "the Senator from " : "the member for ") + p.state : "the " + p.role.replace(/ \(witness\)/, ""); }
  const L = function(p, text, to, tag, gloss){ return {p, who:p ? p.sn : null, text, to:to == null ? null : to, tag:tag || "position", gloss:gloss || ""}; }
  const chairLine = function(S, text, gloss){ let who = S.D.chair; try{ if(S.x) who = chairOf(S).label || who; }catch(e){} return {p:null, who, text, to:null, tag:"procedural", gloss:gloss || "The chair keeping order: who speaks, when, and for how long."}; }
  const whyOf = p => String(p.want || "a reason nobody has given me").replace(/[.\s]+$/, "");
  const jobOf = p => String(p.role || "this room").split("·")[0].replace(/\(witness\)/, "").trim();
  const argue = function(S, p, M){
    const s = side(p), w = whyOf(p), job = jobOf(p);
    if(s > 0) return L(p, one([
      "I am with you on " + M.short + ", and not because it is yours. I am with you because I want " + w + ".",
      "Count me for " + M.q + ". The yes is real, and it is about " + w + ". Leave that out and do not assume I stay.",
      "I will say aye on " + M.short + ". What I am getting for " + (p.state || "the people I answer to") + " is " + w + ". That is the whole of my reason."
    ]), null, "support",
      "With you, for a reason. " + p.sn + ", " + job + ", backs " + M.short + " because they want " + w + ". Meet that and the aye holds. Ignore it and the aye gets quieter.");
    if(s < 0) return L(p, one([
      "I am against " + M.short + ", and the reason is specific. I want " + w + ".",
      "Do not put me down for " + M.q + ". My no is about " + w + ". Change that and I will look again. Leave it and I stay no.",
      "I am a no on " + M.short + " as it is written. " + job[0].toUpperCase() + job.slice(1) + " does not get to wave past " + w + "."
    ]), null, "oppose",
      "Against you, for a stated reason, not a mood. " + p.sn + ", " + job + ", opposes " + M.short + " because they want " + w + ". That is the price of the vote.");
    return L(p, one([
      "I am not yes and I am not no on " + M.short + ". I am waiting on one thing: " + w + ".",
      "Call me undecided if you must. What decides me on " + M.q + " is " + w + ", and nobody has put it in the text.",
      "I can move on " + M.short + ". I will not move until " + w + "."
    ]), null, "deal",
      "Neither side yet, and the reason is named. " + p.sn + ", " + job + ", tips when " + w + " is met, and not before. A deal that skips that price does not move them.");
  }
  const rebut = function(S, p, q, M){
    if(p.case && q.case) return caseCross(S, p, q);
    const hot = p.temper > 62;
    const t = hot ? one(["— if " + call(q) + " would let me finish! That is nonsense.", "Point of order. " + call(q)[0].toUpperCase() + call(q).slice(1) + " is arguing facts not in the record.", "No. No. That is not what the clause says, and " + q.sn + " knows it."])
                  : one(["Will " + call(q) + " yield? I ask plainly: who pays for this?", "On that point I agree with " + q.sn + ". On the rest, not a word of it.", "I hear " + q.sn + ". " + one(["I heard the same speech last year.", "The record shows otherwise.", "Two different figures in one speech. Which one is in the record?"])]);
    return L(p, t, q.id, hot ? "oppose" : side(p) === side(q) ? "position" : "oppose",
      (hot ? "An interruption. " + p.sn + " is hot-tempered and cuts across " + q.sn + "." : "A rebuttal aimed at " + q.sn + ".") + (p.rival === q.id ? " They are rivals, so expect it to get personal." : "") + " " + p.sn + " stands " + (side(p) > 0 ? "with you" : side(p) < 0 ? "against you" : "in the middle") + ".");
  }
  const react = function(S, p, q){
    const ally = p.allies.includes(q.id);
    return L(p, ally ? one(["Hear, hear.", "Quite right.", "What " + q.sn + " said."]) : one(["Oh, come on.", "Shame.", "That will be remembered, " + q.sn + "."]), q.id, ally ? "support" : "threat",
      ally ? p.sn + " backs their ally " + q.sn + ". Allies move together; win one and the other often follows." : p.sn + " is signalling a cost to " + q.sn + ". Not a formal move, but the room heard it.");
  }
  const total = S => (S.x.cast || []).reduce((a, q) => a + ((q.case && q.case.cost) || 0), 0);
  const budgetLine = function(S, civs){
    if(S.x.budget || !civs.some(c => c.case) || S.room !== "govoffice") return null;
    const tot = total(S), avail = Math.round(tot * (0.55 + Math.random() * 0.2) / 1000) * 1000; S.x.budget = {total:tot, avail};
    return chairLine(S, "For the record: " + civs.length + " petitions today, asking " + curF(tot) + " in all. The state has " + curF(avail) + " unallocated this year, so not everyone can be paid in full.",
      "The budget is the limit. Every yes spends some of " + curF(avail) + " and leaves less for the next person in the room.");
  }
  const caseCross = function(S, p, q){
    const hot = p.temper > 62, qc = q.case, pc = p.case, free = !qc.cost;
    let t;
    if(S.room === "delegation" && !free) t = hot ? "With respect, " + q.sn + ", " + qc.short + " should not come before " + pc.short + ". " + capS(pc.stakeShort) + ". Can " + qc.short + " say the same?"
                                           : "I hear " + q.sn + ". But the Governor cannot settle " + qc.short + " and " + pc.short + " in the same hour, and " + pc.stakeShort + ".";
    else if(free) t = hot ? "Nobody is asking for money for " + qc.short + ", " + q.sn + ", and it is still not decided. Meanwhile " + pc.short + " is " + pc.costText + ", and " + pc.stakeShort + "."
                      : "I do not doubt " + q.sn + ". But a decision on " + qc.short + " costs nothing, and mine costs " + pc.costText + ", and " + pc.stakeShort + ".";
    else t = hot ? "With respect, " + q.sn + ", " + qc.costText + " for " + qc.short + " comes out of the same pot as " + pc.short + ". " + capS(pc.stakeShort) + ". Can " + qc.short + " say the same?"
                 : "I hear " + q.sn + ". But if " + qc.short + " takes " + qc.costText + ", there may not be enough left for " + pc.short + ", and " + pc.stakeShort + ".";
    return L(p, t, q.id, hot ? "oppose" : "position", "A rebuttal on the facts: the two cases are competing for the same budget. " + p.sn + " needs " + pc.costText + " for " + pc.short + "; " + q.sn + " needs " + qc.costText + " for " + qc.short + ".");
  }
  const caseReply = function(S, a, b){
    return L(a, one(["Then hear this, " + b.sn + ". " + a.case.qa.who, "That may be so, " + b.sn + ". " + a.case.qa.stake, "I am not against " + b.case.short + ". " + (/^(Because|Since)\b/.test(a.case.qa.why) ? "" : "But ") + a.case.qa.why]), b.id, "position",
      a.sn + " answers " + b.sn + " with the facts of their own case: who it touches and what happens if it waits.");
  }
  const petition = function(S, p, M){
    if(p.case){
      if(p.introduced) return L(p, one(["Let me put it plainly, ", "To be short about it, ", "Once more, for the record, "]) + "I am asking for " + p.case.ask.replace(/^./, c => c.toLowerCase()) + " If that is out of reach, I would settle for " + p.case.settleShort + ".", null, "position",
        p.sn + " restates the ask: " + p.case.ask + " They would settle for: " + p.case.settle);
      p.introduced = true;
      const op = p.case.open.slice(), rm = /^I am the ([^.,]*)\.\s*/i.exec(op[0]);
      if(rm && String(p.role).toLowerCase().indexOf(rm[1].toLowerCase()) === 0) op[0] = op[0].slice(rm[0].length).replace(/^./, c => c.toUpperCase());
      const intro = "I'm " + p.name + ", " + p.role + ". "; if(CASE_BILL[p.case.kind] && S.room === "govoffice") op.push("I would like it written into law as " + CASE_BILL[p.case.kind] + ", and I will come to the committee and say so.");
      return L(p, (S.x.M.greet ? one(S.x.M.greet) : one(["Governor, ", "Ma'am, sir, ", "Thank you for seeing me. "])) + intro + op.join(" "), null, "position",
        "A petitioner with a real case. They are asking for: " + p.case.ask + " It would cost " + p.case.costText + ". They would settle for: " + p.case.settle); }
    return L(p, (S.x.M.greet ? one(S.x.M.greet) : one(["Governor, ", "Ma'am, sir, ", "Thank you for seeing me. "])) + "I'm " + p.name + ", " + p.role + ". " + p.want[0].toUpperCase() + p.want.slice(1) + ". " + one(["I've written four times.", "We need an answer this month.", "I don't want a letter. I want a date."]), null, "position",
      "A petitioner with a concrete ask: " + p.want + ". Granting it costs money others want.");
  }
  const exchange = function(S, step){
    const M = S.x.M, C = S.x.cast.filter(p => !p.gone), out = [];
    const by = f => C.slice().sort(f);
    const pro = by((a, b) => b.stance - a.stance)[0], con = by((a, b) => a.stance - b.stance)[0];
    const chair = S.D.chair, civs = C.filter(p => !p.m);
    if(step === "gavel"){
      out.push(chairLine(S, {senate:"The Senate will come to order. The clerk will read the journal.", court:"Oyez, oyez, oyez. All persons having business before this Court draw near.", exec:"Everyone sit. We have forty minutes and the realm has a lot of problems.",
        govoffice:"Open hours begin. " + civs.length + " on the list today, please keep it to ten minutes each.", committee:"This committee is in session. The witness will be sworn.", caucus:"Right. Doors shut. Phones down. We leave this room with one line.", press:"Thanks, everyone. Questions at the end. Hands, please."}[S.room] || M.gavel || "Order.", "The sitting opens. The question today: " + M.q + "."));
      const loud = by((a, b) => b.temper - a.temper)[0];
      if(loud && loud.temper > 55) out.push(L(loud, one(["Before we start — some of us got the papers at midnight.", "I want it noted that " + (loud.state || "my state") + " was not consulted.", "Is the chair going to let everyone speak this time?"]), null, "oppose", loud.sn + " is restless before a word is said. High temper: they interrupt, and they take being cut off badly."));
      return out;
    }
    if(step === "adjourn"){ out.push(chairLine(S, {govoffice:"That is the list. Open hours are closed.", senate:"The Senate stands adjourned until tomorrow at ten.", court:"This honorable Court is now adjourned.", exec:"Thank you. Go do it.", committee:"The committee stands adjourned.", caucus:"That is the business. Out you go, and vote the way you said.", press:"That's all the time we have. Thank you."}[S.room] || M.adjourn || "Adjourned.")); return out; }
    if(step === "open"){
      if((S.room === "govoffice" || M.petition) && civs[0]){ out.push(petition(S, civs[0], M)); const bl = budgetLine(S, civs); if(bl) out.push(bl); } else out.push(argue(S, pro, M));
      if(con !== pro && !(civs[0] && civs[0].case)) out.push(argue(S, con, M));
      if(Math.random() < 0.6 && con !== pro) out.push(rebut(S, pro, con, M));
      const mid = C.find(p => side(p) === 0 && p !== pro && p !== con); if(mid) out.push(argue(S, mid, M));
      return out;
    }
    if(step === "question"){
      let a = (S.room === "govoffice" || M.petition) && civs.length ? civs[S.x.qi % Math.max(1, civs.length)] : one(C.filter(p => p.spoke <= 1) .concat([con]));
      S.x.qi++;
      if((S.room === "govoffice" || M.petition) && a) out.push(petition(S, a, M)); else out.push(argue(S, a, M));
      const foes = C.filter(p => p !== a && (p.rival === a.id || Math.abs(p.stance - a.stance) > 25));
      const b = foes.length ? one(foes) : one(C.filter(p => p !== a)) || a;
