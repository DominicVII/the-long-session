  const moving = Math.hypot(cam.vx || 0, cam.vz || 0) > 0.12;
  if(G._renderDirty && (!moving || (FRAME_ID & 7) === 0)){
    if(!(typeof frameOverBudget === "function" && frameOverBudget(6))){
      G._renderDirty = false;
      try{ syncPeopleStaged(); }catch(e){}
    }
  }
  if((FRAME_ID & 11) !== 0) return;
  if(typeof frameOverBudget === "function" && frameOverBudget(6)) return;
  try{ warmAhead(); }catch(e){}
}
function forceUnstickMove(){
  G.moving = false;
  G._moveAt = 0;
  try{ _buildingRoom = false; }catch(e){}
  try{ syncPeopleStaged._busy = false; }catch(e){}
  try{
    const fd = el("fade");
    if(fd){ fd.style.opacity = "0"; fd.style.pointerEvents = "none"; }
  }catch(e){}
}
function forcePaint(){
  forceUnstickMove();
  try{ resize(); }catch(e){}
  try{
    if(G.room && ROOMS[G.room] && roomGroup && roomGroup.children.length < 4 && !_buildingRoom){
      buildRoomShell(G.room);
      _roomBuiltId = G.room;
      _roomFurnished = false;
    }
  }catch(e){}
  try{
    if(!isFinite(cam.x)) cam.x = 0;
    if(!isFinite(cam.z)) cam.z = 2;
    if(!isFinite(cam.yaw)) cam.yaw = 0;
    const eye = sitEye();
    camera.position.set(cam.x, eye, cam.z);
    camera.rotation.set(0, cam.yaw + Math.PI, 0, "YXZ");
    camera.updateMatrixWorld(true);
  }catch(e){}
  try{ updateLighting(0.016); }catch(e){}
  try{ ndPad(); }catch(e){}
  try{ if(renderer && !GL_LOST) renderer.render(scene, camera); }catch(e){}
}
function enterRoom(dest, fromRoom){
  /* Instant feet. Mesh later. Keep walking inward — never stop at the jamb. */
  if(!ROOMS[dest]) return;
  try{ kEnsurePeople(); }catch(e){}
  try{ mStandFix(); }catch(e){}
  try{ if(!NM.ready && !NM.tried){ NM.tried = true; nmInit(); } nmRoomPass(); }catch(e){}
  try{ tlog("", (ROOMS[dest] && ROOMS[dest].name) || dest, "room"); }catch(e){}
  forceUnstickMove();
  try{ catchClear("door"); }catch(e){}
  G.speechApproach = null;
  if(G.you){ G.you.sitting = false; G.you.room = dest; }
  const prev = fromRoom || G.room;
  G.room = dest;
  if(dest !== "visit") G.visitId = null;
  const b = roomBox(dest);
  const home = (DOORS[dest] || []).find(d => d.to === prev);
  let ix = 0, iz = 1.35;
  if(home){
    const hp = doorAt(dest, home);
    const inward = hp.z < ROOMS[dest].d/2 ? 1 : -1;
    cam.x = clamp(hp.x, -b.hw, b.hw);
    cam.z = clamp(hp.z + inward*1.05, b.d0, b.d1);
    cam.yaw = inward > 0 ? 0 : Math.PI;
    ix = 0; iz = inward * 0.42;
    if(home.side === "left"){ cam.x = clamp(hp.x + 1.35, -b.hw, b.hw); cam.yaw = Math.PI/2; ix = 0.42; iz = 0; }
    if(home.side === "right"){ cam.x = clamp(hp.x - 1.35, -b.hw, b.hw); cam.yaw = -Math.PI/2; ix = -0.42; iz = 0; }
  } else {
    try{ const sp = safeSpawn(dest); cam.x = sp.x; cam.z = sp.z; }catch(e){ cam.x = 0; cam.z = b.d0 + 1.2; }
    cam.yaw = 0;
  }
  cam.vx = ix; cam.vz = iz; cam.yawVel = 0;
  cam.pitch = 0;
  G.doorGrace = (G.t || 0) + 1.8;
  G._lastDoorTo = dest;
  G._lastDoorFrom = prev;
  try{ const Gs = goalsEnsure(); if(Gs){ Gs.seen = Gs.seen || {}; Gs.seen[dest] = 1; } }catch(e){}
  try{ document.body.classList.remove("keys-intro"); }catch(e){}
  try{
    el("whereName").textContent = ROOMS[dest].t;
    el("whereTag").textContent = ROOMS[dest].tag;
  }catch(e){}
  try{
    if(_roomBuiltId !== dest){
      try{ stashLiveRoom(); }catch(e){}
      if(!takeRoomKit(dest)){
        try{ buildRoomShell(dest); _roomBuiltId = dest; _roomFurnished = false; }catch(e){}
      }
    }
  }catch(e){}
  try{ forcePaint(); }catch(e){}
  try{
    const fd = el("fade");
    if(fd){ fd.style.opacity = "0"; fd.style.pointerEvents = "none"; }
  }catch(e){}
  const furnishAt = 0;
  nextFrameOrTimeout(() => {
    if(G.room !== dest) return;
    try{
      if(!_roomFurnished && !_buildingRoom) buildRoom(dest);
    }catch(e){}
    try{ forcePaint(); }catch(e){}
  }, furnishAt);
  G._crowdPauseUntil = Math.max(G._crowdPauseUntil || 0, performance.now() + 180);
  G._deferPeopleUntil = performance.now() + 200;
  nextFrameOrTimeout(() => {
    if(G.room !== dest) return;
    try{ syncPeopleStaged(); }catch(e){}
  }, 16);
  nextFrameOrTimeout(() => {
    if(G.room !== dest) return;
    try{ if(dest === "floor") seatChamber(); }catch(e){}
  }, 900);
  laterHouse(() => { try{ queueSave(); }catch(e){} });
}
/* Walk into a doorway and you go through it. No menu required. */
function nearDoor(){
  if(G.t < (G.doorGrace||0)) return null;
  const moving = Math.hypot(cam.vx || 0, cam.vz || 0);
  if(moving < 0.55) return null;
  const list = DOORS[G.room] || [];
  for(const dr of list){
    if(!outsideAllowed(dr.to)) continue;
    const p = doorAt(G.room, dr);
    const dx = p.x - cam.x, dz = p.z - cam.z;
    const dist = Math.hypot(dx, dz);
    const reach = (dr.side === "front" || dr.side === "back") ? 1.05 : 0.95;
    if(dist >= reach || dist < 0.02) continue;
    const toward = (cam.vx * dx + cam.vz * dz) / dist;
    if(toward < 0.35) continue;
    if(G.room === "steps"){
      const g = cam.ground || 0;
      if(dr.to === "corridor" && g < 1.25) continue;
      if(dr.to === "district" && g > 0.35) continue;
    }
    return {dr, p};
  }
  return null;
}
function walkThroughDoors(){
  if(G.moving){
    if(!G._moveAt || performance.now() - G._moveAt > 400) forceUnstickMove();
    else return;
  }
  const hit = nearDoor();
  if(!hit) return;
  const dest = hit.dr.to, fromRoom = G.room;
  if(!ROOMS[dest] || dest === fromRoom) return;
  G.doorGrace = (G.t || 0) + 1.8;
  feed("Through to " + ROOMS[dest].t + ".");
  enterRoom(dest, fromRoom);
}
/* Show a line of text, or hide the thing that would have held it —
   touching the DOM only when the words are not already there. */
function say(node, text){
  if(text === null || text === undefined){
    if(!node.hidden) node.hidden = true;
    node._html = null;
    return;
  }
  if(node._said !== text){ node._said = text; node._html = null; node.textContent = text; }
  if(node.hidden) node.hidden = false;
}
let last = performance.now(), acc = 0, frameFails = 0, frameFailLogged = false;
let hailT = 0, hailWho = null, matChkT = 0, matChk = 0, matChkSaid = 0;

/* Draw on a divisor of the panel. 32fps on 60Hz is a beat that looks like
   a hitch. 30 and 60 are the only rates that sit still on a 60/120Hz screen.
   Modest locks 30. A strong machine holds 60 until a frame costs too much,
   then it drops to 30 and stays there until the work is cheap again. */
const FRAME_HZ_LO = 30;
const FRAME_HZ_HI = 60;
let _wantHz = (typeof MODEST !== "undefined" && MODEST) ? FRAME_HZ_LO : FRAME_HZ_HI;
let _vsyncN = 0;
let _rafPrev = 0;
let _hzEma = 60;
let _stride = (typeof MODEST !== "undefined" && MODEST) ? 2 : 1;
let _holdLo = 0;
let _lastDrawn = 0;
let _cardFrames = 0;
let _emaMs = 16;
let _frameArmed = false;
function armFrame(){
  if(_frameArmed) return;
  _frameArmed = true;
  try{
    const hidden = typeof document !== "undefined" && document.hidden;
    const card = !!(typeof veil !== "undefined" && veil && !veil.hidden);
    if(hidden){
      setTimeout(() => { _frameArmed = false; frame(performance.now()); }, 1000);
      return;
    }
    requestAnimationFrame((t) => { _frameArmed = false; frame(t); });
  }catch(e){
    _frameArmed = false;
    setTimeout(() => { try{ armFrame(); }catch(e2){} }, 250);
  }
}
function kickFrame(){
  if(_frameArmed) return;
  /* Do not kick into a double-tick storm during save / room build / door fade. */
  try{
    if(typeof saveBusy !== "undefined" && saveBusy) return;
    if(typeof _buildingRoom !== "undefined" && _buildingRoom) return;
    if(houseQuiet() && G.moving) return;
  }catch(e){}
  armFrame();
}
function crowdFreezeMesh(mesh){
  /* 20261005a: deep-freeze a person group — root-only freeze left child meshes
     paying updateMatrix every frame (suits/faces/hair). Full meshes kept. */
  if(!mesh) return;
  try{
    if(!mesh.userData) mesh.userData = {};
    const ud = mesh.userData;
    if(ud._crowdFrozen){
      /* already frozen: if the root moved, carry the whole body with it */
      if(ud._fzX !== mesh.position.x || ud._fzZ !== mesh.position.z || ud._fzY !== mesh.position.y || ud._fzR !== mesh.rotation.y){
        mesh.updateMatrix(); mesh.updateMatrixWorld(true);
        ud._fzX = mesh.position.x; ud._fzZ = mesh.position.z; ud._fzY = mesh.position.y; ud._fzR = mesh.rotation.y;
      }
      return;
    }
    /* bake every local matrix from the current pose first, then stop the per-frame walk */
    mesh.traverse(o => { o.updateMatrix(); o.matrixAutoUpdate = false; });
    mesh.updateMatrixWorld(true);
    ud._fzX = mesh.position.x; ud._fzZ = mesh.position.z; ud._fzY = mesh.position.y; ud._fzR = mesh.rotation.y;
    ud._crowdFrozen = true;
  }catch(e){}
}
function crowdThawMesh(mesh){
  if(!mesh || !mesh.userData || !mesh.userData._crowdFrozen) return;
  try{
    mesh.userData._crowdFrozen = false;
    mesh.traverse(o => { o.matrixAutoUpdate = true; });
    mesh.updateMatrixWorld(true);
  }catch(e){}
}
function animateCrowd(dt){
  const crowd = hereNow();
  const talk = (TALK.open && TALK.m) || null;
  const sy = Math.sin(cam.yaw), cy = Math.cos(cam.yaw);
  let full = 0;
  /* 20261011d: everyone in view is posed on a fair rotation with their own
     elapsed time — the old "first two in the list" left the rest in stale poses */
  const maxFull = MODEST ? 4 : 9;
  const rr = (animateCrowd._rr = ((animateCrowd._rr || 0) + 1) % 1024);
  const playerMoving = Math.hypot(cam.vx || 0, cam.vz || 0) > 0.12;
  for(let i=0;i<crowd.length;i++){
    const p = crowd[i];
    if(!p.mesh) continue;
    const dx = p.x - cam.x, dz = p.z - cam.z;
    const d2 = dx*dx + dz*dz;
    const fwd = sy*dx + cy*dz;
    const talking = talk === p;
    const gy = (G.room === "steps") ? groundAt(p.z, p.room || G.room) : 0;
    const mx = p.mesh.position;
    /* Draw only. Being is not optional. A back is still a person. */
    if(!talking){
      if(playerMoving){
        if(fwd < 0 || d2 > 25){
          /* Culled while walking: hide + deep-freeze so children skip matrix walks. */
          mx.x = p.x; mx.z = p.z; mx.y = gy;
          p.mesh.rotation.y = p.facing || 0;
          if(p.mesh.visible) p.mesh.visible = false;
          crowdFreezeMesh(p.mesh);
          continue;
        }
      } else if(G.room !== "corridor" && fwd < -1.8 && d2 > 16){
        if(p.mesh.visible) p.mesh.visible = false;
        continue;
      }
    }
    if(!p.mesh.visible) p.mesh.visible = true;
    /* 20261001a + 20261005a: while walking, FAR (d2>12) deep-freeze pose — snap once,
       no per-frame updateMatrix; near keep soft follow + pose-only. Full meshes kept. */
    if(playerMoving && !talking && d2 > 12){
      const frozen = !!(p.mesh.userData && p.mesh.userData._crowdFrozen);
      const moved = !frozen || ((FRAME_ID + i) & 3) === 0 && (mx.x !== p.x || mx.z !== p.z || mx.y !== gy);
      if(moved){
        mx.x = p.x; mx.z = p.z; mx.y = gy;
        p.mesh.rotation.y = p.facing || 0;
        if(frozen) p.mesh.userData._crowdFrozen = false;
        crowdFreezeMesh(p.mesh);
      }
      continue;
    }
    crowdThawMesh(p.mesh);
    if(p.mesh.matrixAutoUpdate === false) p.mesh.matrixAutoUpdate = true;
    mx.x += (p.x - mx.x) * 0.35;
    mx.z += (p.z - mx.z) * 0.35;
    mx.y = gy;
    p._adt = Math.min(0.25, (p._adt || 0) + dt);
    const pm = Math.hypot((p.tx || p.x) - p.x, (p.tz || p.z) - p.z) > 0.25;
    /* While walking: the near ones who are themselves walking keep their gait; the rest pose-only */
    if(playerMoving && !talking){
      if(pm && fwd > 0 && full < 3){ animatePerson(p, p._adt); p._adt = 0; full++; continue; }
      if(pm){ p.facing += clamp(wrapPi(Math.atan2(p.tx - p.x, p.tz - p.z) - (p.facing || 0)), -2.6*dt, 2.6*dt); }
      p.mesh.rotation.y = p.facing || 0;
      continue;
    }
    const near = d2 < 20 && fwd > -0.5;
    if(talking || near || pm || ((i + rr) % 2 === 0 && full < maxFull)){
      animatePerson(p, p._adt); p._adt = 0;
      full++;
    } else {
      if(pm){ p.facing += clamp(wrapPi(Math.atan2(p.tx - p.x, p.tz - p.z) - (p.facing || 0)), -2.6*dt, 2.6*dt); }
      p.mesh.rotation.y = p.facing || 0;
    }
  }
}

/* ── ONUM_PROF: frame section profiler (quiet ring always; verbose ?prof=1) ── */
const ONUM_PROF = (() => {
  let verbose = false;
  try{ verbose = /(?:\?|&)prof=1(?:&|$)/.test(location.search || ""); }catch(e){}
  const RING_MAX = 180, SPIKE_MAX = 48;
  const ring = [];
  const spikes = [];
  let lastInfo = null, lastSampleAt = 0;
  let cur = null, tSec = 0;
  const names = ["tick","crowd","lighting","shadow","render","hud","feed","sync","furnish","ui"];
  function blank(){
    const o = {t:0, total:0};
    for(const n of names) o[n] = 0;
    return o;
  }
  function begin(){
    cur = blank();
    tSec = performance.now();
    return cur;
  }
  function mark(name){
    if(!cur) return;
    const n = performance.now();
    cur[name] = (cur[name] || 0) + (n - tSec);
    tSec = n;
  }
  function add(name, ms){
    if(!cur || !(ms > 0)) return;
    cur[name] = (cur[name] || 0) + ms;
  }
  function sampleInfo(){
    try{
      if(!renderer || !renderer.info) return null;
      const r = renderer.info.render || {};
      const m = renderer.info.memory || {};
      const out = {
        calls: r.calls|0,
        triangles: r.triangles|0,
        geometries: m.geometries|0,
        textures: m.textures|0,
        programs: (renderer.info.programs && renderer.info.programs.length) || 0
      };
      try{
        if(performance.memory) out.heapMB = Math.round(performance.memory.usedJSHeapSize / 1048576);
      }catch(e){}
      return out;
    }catch(e){ return null; }
  }
  function end(draw){
    if(!cur) return null;
    mark("_tail");
    cur.total = 0;
    for(const n of names) cur.total += (cur[n] || 0);
    cur.draw = !!draw;
    cur.at = performance.now();
    const now = cur.at;
    if(now - lastSampleAt > 1000){
      lastSampleAt = now;
      lastInfo = sampleInfo();
    }
    cur.info = lastInfo;
    ring.push(cur);
    if(ring.length > RING_MAX) ring.shift();
    const spike = cur.total > 22 || (cur.render || 0) > 12;
    if(spike){
      spikes.push(Object.assign({}, cur));
      if(spikes.length > SPIKE_MAX) spikes.shift();
      if(verbose && typeof console !== "undefined" && console.debug){
        console.debug("ONUM_PROF spike", cur.total.toFixed(1), "ms", cur);
      }
    }
    const out = cur; cur = null; return out;
  }
  function dump(){
    const top = spikes.slice().sort((a,b) => b.total - a.total).slice(0, 12);
    const sums = blank();
    let n = 0;
    for(const f of (top.length ? top : ring.slice(-60))){
      for(const k of names) sums[k] += (f[k] || 0);
      sums.total += (f.total || 0);
      n++;
    }
    const avg = {};
    if(n){
      for(const k of names) avg[k] = +(sums[k] / n).toFixed(3);
      avg.total = +(sums.total / n).toFixed(3);
    }
    const ranked = names.map(k => ({
      name: k,
      ms: avg[k] || 0,
      pct: avg.total ? +(((avg[k] || 0) / avg.total) * 100).toFixed(1) : 0
    })).sort((a,b) => b.ms - a.ms);
    return {
      verbose, spikeCount: spikes.length, ringCount: ring.length,
      topSpikes: top, ranked, avg, lastInfo,
      verdict: (function(){
        const r = ranked[0];
        if(!r) return "unknown";
        if(r.name === "render" || r.name === "shadow" || r.name === "lighting") return "GPU/draw-bound (render/lighting/shadow dominate)";
        if(r.name === "tick" || r.name === "crowd" || r.name === "sync" || r.name === "furnish") return "CPU-bound (tick/crowd/sync dominate)";
        return "mixed (" + r.name + " leads)";
      })()
    };
  }
  function stressBoot(){
    try{
      if(typeof buildWorld === "function"){
        buildWorld("Profiler Seat", "FED", typeof makeLook === "function" ? makeLook() : null);
      }
      G.room = "corridor";
      G.day = Math.max(G.day || 1, 2);
      G.minute = 10 * 60 + 30;
      G._savedCam = false;
      if(typeof begin === "function") begin();
      api._lastBoot = { ok:true, room: G.room, n: (G.members&&G.members.length)||0, running: !!G.running };
      return true;
    }catch(e){
      if(console && console.warn) console.warn("ONUM_PROF.stressBoot", e);
      api._lastBoot = { ok:false, err: String((e&&e.message)||e) };
      return false;
    }
  }
  function snap(){
    try{
      return {
        boot: api._lastBoot || null,
        running: !!(typeof G !== "undefined" && G.running),
        room: (typeof G !== "undefined" && G.room) || null,
        people: (typeof peopleGroup !== "undefined" && peopleGroup && peopleGroup.children) ? peopleGroup.children.length : 0,
        furnished: !!(typeof _roomFurnished !== "undefined" && _roomFurnished),
        members: (typeof G !== "undefined" && G.members) ? G.members.length : 0
      };
    }catch(e){ return { err: String(e) }; }
  }
  function autoWalk(ms){
    ms = ms || 10000;
    const KB = (typeof G !== "undefined" && G.bind) || (typeof DEFAULT_BIND !== "undefined" ? DEFAULT_BIND : {forward:"w"});
    try{ keys[KB.forward] = true; }catch(e){}
    const t0 = performance.now();
    const iv = setInterval(() => {
      try{ keys[KB.forward] = true; }catch(e){}
      /* gentle yaw so we sweep corridor */
      try{ cam.yaw += 0.004; }catch(e){}
      if(performance.now() - t0 >= ms){
        clearInterval(iv);
        try{ keys[KB.forward] = false; }catch(e){}
      }
    }, 50);
    return true;
  }
  const api = {begin, mark, add, end, dump, sampleInfo, stressBoot, autoWalk, snap, ring, spikes, get verbose(){ return verbose; }, get cur(){ return cur; }};
  try{ window.ONUM_PROF = api; }catch(e){}
  return api;
})();

function frame(now){
  if(GL_LOST){ last = now; armFrame(); return; }
  if(typeof document !== "undefined" && document.hidden){ armFrame(); return; }
  if(_rafPrev){
    const dtR = Math.max(7, now - _rafPrev);
    _hzEma = _hzEma * 0.9 + (1000 / dtR) * 0.1;
  }
  _rafPrev = now;
  _vsyncN++;
  const hz = _hzEma < 70 ? 60 : (_hzEma < 100 ? 90 : (_hzEma < 135 ? 120 : (_hzEma < 170 ? 144 : 240)));
  let stride = 1, best = 999;
  for(let s = 1; s <= 8; s++){
    const e = Math.abs(hz / s - _wantHz);
    if(e < best){ best = e; stride = s; }
  }
  _stride = stride;
  const draw = (_vsyncN % stride) === 0;
  if(draw) _lastDrawn = now;
  const t0 = now;
  try{
    frameBody(now, draw);
    if(frameFails > 0){ frameFails = Math.max(0, frameFails - 1); if(frameFails === 0) frameFailLogged = false; }
  }catch(err){
    frameFails++;
    last = performance.now();
    if(!frameFailLogged && window.console){
      frameFailLogged = true;
      console.error("frame error (recovering; further errors silent)", err);
    }
    try{
      if(renderer && renderer.shadowMap) renderer.shadowMap.needsUpdate = true;
    }catch(e){}
  }
  const took = performance.now() - t0;
  if(draw){
    _emaMs = _emaMs * 0.86 + took * 0.14;
    if(_emaMs > 22 || took > 40){
      _holdLo++;
      if(_holdLo > 6) _wantHz = FRAME_HZ_LO;
    } else if(_emaMs < 11){
      _holdLo = Math.max(0, _holdLo - 2);
      if(_holdLo === 0 && !(typeof MODEST !== "undefined" && MODEST)) _wantHz = FRAME_HZ_HI;
    }
  }
  armFrame();
}
/* 20261025a · dynamic resolution, so play stays smooth at the sharpest picture the machine can hold. It watches how often frames
   actually arrive. When they come late for about a second and a half it lowers the resolution a step; when they have come on time
   for ten seconds and you are standing still, it raises it back toward full. One change at most every few seconds. Shadows,
   materials and detail are never switched here, because switching them recompiles shaders, and that is a hitch of its own. */
const DRS = {ema:16.7, vs:16.7, prev:0, bad:0, good:0, at:0, n:0};
function drsTick(now){
  try{
    if(DRS.prev){ const dt = now - DRS.prev; if(dt > 3 && dt < 250){ DRS.ema = DRS.ema * 0.9 + dt * 0.1; DRS.vs = dt < DRS.vs ? Math.max(4, dt) : DRS.vs + (dt - DRS.vs) * 0.0015; } }
    DRS.prev = now;
    const card = typeof veil !== "undefined" && veil && !veil.hidden;
    if(document.hidden || card || !G || !G.running || GL_LOST || G.moving){ DRS.bad = 0; DRS.good = 0; }
    else {
      const cur = _lastPR > 0 ? _lastPR : GFX_PR, base = Math.min(devicePixelRatio || 1, GFX_PR), lo = MODEST ? 0.5 : 0.7;
      if(DRS.ema > DRS.vs * 1.45){ DRS.bad++; DRS.good = 0; } else if(DRS.ema < DRS.vs * 1.12){ DRS.good++; DRS.bad = Math.max(0, DRS.bad - 1); } else DRS.good = 0;
      const walking = Math.hypot(cam.vx || 0, cam.vz || 0) > 0.12;
      if(DRS.bad > 90 && cur > lo + 0.01 && now - DRS.at > 2500){ DRS.at = now; DRS.bad = 0; DRS.n++; setPR(Math.max(lo, cur - 0.1)); }
      else if(DRS.good > 600 && cur < base - 0.01 && now - DRS.at > 8000 && !walking){ DRS.at = now; DRS.good = 0; DRS.n++; setPR(Math.min(base, cur + 0.05)); }
    }
  }catch(e){}
  requestAnimationFrame(drsTick);
