/* their body speaks before their politics does, sometimes */
function bodyVoice(m){
  const b = bodyOf(m); if(b.hunger > 0.9 && chance(0.4)) return pick(["I have not eaten since " + bodyClock(b.ate) + ". Ask me after lunch and I will be kinder.", "Walk with me to the dining room. I can argue and eat at the same time.", "Forgive me, I am starving. What was it?"]);
  if(b.tired > 0.95 && chance(0.35)) return pick(["I have been up since before six. Say it slowly.", "If I yawn, it is the hour and not you.", "I am too tired to pretend to agree with you. Go on."]);
  return "";
}
