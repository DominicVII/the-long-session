  function chatPaint(){
    const C = chatBox(), cs = contacts(); if(!LT.chatTo) LT.chatTo = LSG("chatTo", "aide"); if(!cs.some(c => c.id === LT.chatTo)) LT.chatTo = "aide";
    const sel = C.querySelector("#ltcTo"), grps = [...new Set(cs.map(c => c.grp))];
    sel.innerHTML = grps.map(g => '<optgroup label="' + esc2(g) + '">' + cs.filter(c => c.grp === g).map(c => '<option value="' + esc2(c.id) + '">' + esc2(c.label) + '</option>').join("") + '</optgroup>').join(""); sel.value = LT.chatTo;
    const c = cs.find(x => x.id === LT.chatTo), log = C.querySelector("#ltcLog"); log.innerHTML = "";
    (MEM[LT.chatTo] || []).slice(-30).forEach(t => { const d = document.createElement("div"); d.className = "ltc-m" + (t.r === "u" ? " ltc-you" : ""); d.innerHTML = "<b></b><span></span>"; d.firstChild.textContent = t.r === "u" ? "You" : (c ? c.m.name : ""); d.lastChild.textContent = t.c; log.appendChild(d); });
    if(!log.children.length){ const d = document.createElement("div"); d.className = "ltc-note"; d.textContent = c && c.m.kind === "aide" ? "Ask about the bill, your numbers, the money, the diary, the mail, a member by name, or what people are saying about you." : "Start the conversation. What you say here travels like anything else."; log.appendChild(d); }
