      const lm = new THREE.MeshStandardMaterial({color:0xfff2d4, emissive:0xffd9a0, emissiveIntensity:0.6, roughness:0.4});
      addBox(brass, x, deckY + 2.3, z - 0.26, 0.05, 0.05, 0.22, 0, true); addBox(dark, x, deckY + 2.22, z - 0.38, 0.18, 0.06, 0.18, 0, true); addBox(lm, x, deckY + 2.42, z - 0.38, 0.14, 0.28, 0.14, 0, true); addBox(dark, x, deckY + 2.62, z - 0.38, 0.22, 0.06, 0.22, 0, true); });
