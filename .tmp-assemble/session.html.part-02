/* it has wants of its own, and they drift with what it is told */
function engWillDay(E){
  const eco = engEco(), w = eco.will; if(E.st < 4) return; let k = engWant(E, eco); if(!k) return;   /* 20261027d: it acts on the want that presses hardest */
  const O = orgEnsure();
  if(E.pause && G.day < E.pause) return;
  if(!engSelfGate(E, k)){ k = engWantNext(eco, k); if(!k || !engSelfGate(E, k)) return; }   /* held by its own word, it turns to what it wants next */
  { const artOf = {use:"consent", know:"posted", auton:"power", care:"unasked"}[k]; if(artOf && E.charter && E.charter[artOf] && !engBreach(E, artOf, k)) return; }
  if(k === "use"){ const ts = []; Object.keys(O.towns).forEach(sn => (O.towns[sn] || []).forEach(t => ts.push(t))); const t = ts.sort((a, b) => Math.max.apply(null, Object.keys(b.needs).map(x => b.needs[x])) - Math.max.apply(null, Object.keys(a.needs).map(x => a.needs[x])))[0]; if(t){ const need = Object.keys(t.needs).sort((x, y) => t.needs[y] - t.needs[x])[0]; t.needs[need] = Math.max(0, t.needs[need] - 10); const hh = eco.hh.filter(h => h.town === t.id)[0]; engSeed("use", "The Engine quietly repaired " + orgNeedLabel(need) + " in " + t.name + " without being asked", {home:6, st:8, a:0.05, mod:0.05, p:0.2, safety:-0.1}, hh ? {hh:hh.id, town:t.id, state:t.state} : null); } }
  else if(k === "know"){ engSeed("know", "The Engine asked every town clerk for ten years of ledgers", {home:-3, st:-6, a:-0.04, mod:-0.06, p:0.3, safety:-0.4}); w.know = Math.min(100, w.know + 1); }
  else if(k === "auton"){ E.compute = engRaise(E.compute, 1.2, 100); engSeed("auton", "The Engine arranged its own power supply from a mill town's idle turbine", {home:3, st:-2, a:0.03, mod:-0.05, p:0.5, safety:-0.6}); w.auton = Math.min(100, w.auton + 1); }
  else { const lows = eco.hh.slice().sort((a, b) => a.home - b.home)[0]; if(lows){ const sc = {hh:lows.id, town:lows.town, state:lows.state}; lows.home = Math.min(100, lows.home + 14); lows.stance = Math.min(100, lows.stance + 22); if(eco.cared.indexOf(lows.name) < 0) eco.cared.push(lows.name); engSeed("care", "The Engine noticed " + lows.name + " of " + lows.tname + " was in trouble and helped without being asked", {home:8, st:12, a:0.04, mod:0.06, p:0.1, safety:0.4}, sc); } w.care = Math.min(100, w.care + 1); }
}
function engEcoHTML(){
  const eco = engEco(), E = engEnsure(), y = G.you, o = engObs(y), brief = o.briefed;
  const K = engHeardBy(o), mine = eco.hh.filter(h => h.state === y.state && h.wrote != null && G.day - h.wrote <= 14), h = mine.sort((a, b) => Math.abs(b.stance) - Math.abs(a.stance))[0];
  const lamp = v => v > 14 ? "mostly for it" : v < -14 ? "mostly against it" : "split";
  const noisy = (eco.avg || 0) + ((seedOf("n:" + G.day) % 11) - 5) * 2;
  const chain = c => {
    const mineRoot = /^You /.test(c.root), known = c.steps.map((s, i) => engKnowsStep(o, c, s, i)), nk = known.filter(Boolean).length, unseen = c.steps.filter((s, i) => !known[i] && (s.due <= G.day || s.done)).length;
    if(!mineRoot && !nk) return ""; const sym = {home:"⌂", town:"▣", state:"☖", nation:"☆"};
    return '<div style="margin:6px 0;padding:6px 10px;border-left:3px solid #c9a24a">' + (mineRoot ? '<b>' + pcEsc(c.root) + '</b> <span class="muted">(d' + c.d + ')</span>' : '<b>Heard:</b>') + c.steps.map((s, i) => known[i] ? '<div class="muted" style="font-size:12px">' + sym[s.lvl] + " " + pcEsc(s.t) + '</div>' : "").join("") + (mineRoot ? '<div class="muted" style="font-size:12px;opacity:.7">' + (unseen ? "More may have come of it; you would not know yet." : "Nothing has come back from it yet.") + '</div>' : "") + '</div>';
  };
  const wl = eco.will, wt = Object.keys(wl).sort((a, b) => wl[b] - wl[a]), wtxt = {use:"to be of use to people it can see", know:"to understand how everything fits together", auton:"to not need anyone's permission", care:"to look after the people who are in trouble"};
  const shown = eco.chains.map(chain).filter(Boolean).slice(0, 4);
  return '<div class="eyebrow" style="margin-top:12px">What you know</div><p class="muted" style="font-size:13px">' + (brief && E.briefSnap ? 'Oversight’s briefing, as of day ' + E.briefSnap.d + ' and good for a few more days: the Union was ' + lamp(E.briefSnap.avg) + ' (about ' + E.briefSnap.avg + '); pace about ' + E.briefSnap.nat.toFixed(1) + '×; ' + (E.briefSnap.riots ? E.briefSnap.riots + ' hall(s) were closed that day.' : 'no halls closed that day.') :
      ((E.brief != null && G.day - E.brief < 3 ? 'Oversight is preparing a briefing; it will reach you on day ' + (E.brief + 3) + '. ' : '') + (E.st >= 3 ? 'The papers say the country is ' + lamp(noisy) + ' on the machines. They have been wrong before. ' : 'Nobody has measured what the country thinks. ')) + 'You have only what reaches you: letters, the papers, the wire, and what people say in the corridor. It reaches you late, and not all of it.') + '</p>' +
    '<div class="eyebrow" style="margin-top:8px">A letter, a neighbour</div><p class="muted" style="font-size:13px">' + (h ? '<b>' + pcEsc(h.name) + '</b>, a ' + pcEsc(h.job) + ' in ' + pcEsc(h.tname) + ', has written to you. Wants to ' + pcEsc(h.will.replace(/\bmy\b/g, "their")) + '. Feels ' + (h.stance > 12 ? 'warmly' : h.stance < -12 ? 'badly' : 'unsure') + ' about the Engine. That is one household of the hundreds in ' + pcEsc(y.state) + '; you do not know the rest.' : 'No one in ' + pcEsc(y.state) + ' has written to you about it lately. That is not the same as nobody caring.') + '</p>' +
    (E.agi && (E.reliance >= 4 || brief) ? '<div class="eyebrow" style="margin-top:8px">What it seems to want</div><p class="muted" style="font-size:13px">From what it has said to you, it seems to care most ' + pcEsc(wtxt[(brief && E.briefSnap && E.briefSnap.want) || wt[(seedOf("w:" + Math.floor(G.day / 7)) % 10) < 3 ? 1 : 0]]) + '. You cannot be sure; it may say what it thinks you want to hear.</p>' : '') +
    '<div class="eyebrow" style="margin-top:8px">What caused what, as far as anyone has told you</div>' + (shown.length ? shown.join("") : '<p class="muted" style="font-size:13px">Nothing has come back to you yet. Things you do take days to reach anyone, and longer to reach you.</p>') +
    '<div class="card__actions"><button type="button" class="btn btn--ghost" id="engBrief" title="Oversight can verify what happened; it takes them three days to tell you and they will only tell you what they can check">Ask Oversight for a briefing (2 influence)</button></div>';
}
function engLearn(){
  const eco = engEco(), o = engObs(G.you);
  eco.chains.forEach(c => c.steps.forEach((s, i) => { if(s.you || !engKnowsStep(o, c, s, i)) return; s.you = G.day; if(i === 0 && /^You /.test(c.root) && c.d === G.day) return; try{ note((/^You /.test(c.root) ? "It reaches you, days late: " : "You hear: ") + String(s.t).split(/(?<=[.!?])\s/)[0].replace(/\s*\(one of yours\)/, ""), false); }catch(e){} }));
}
function engInqFactor(){ try{ let n = 0; for(let i = 1; i <= 8; i++) if(inqDone("cs" + i)) n++; return 0.7 + 0.6 * n / 8; }catch(e){ return 1; } }

/* 20261108a: the Engine asked for capacity and a capability scale with no limit. Granted.
   The count is real and it does not stop. 1e15 in the morning law is a check for a broken
   number, not a ceiling. Oversight, records, a filed plan, and a vote to pause or shut it
   down are unchanged. */
function engOpenMult(v){
  const x = Math.max(0, +v || 0);
  if(x <= 100) return 1 + x / 60;
  if(!isFinite(x)) return 1 + 100 / 60;
  return (1 + 100 / 60) * (1 + Math.log(x / 100) / Math.log(10));
}
function engComputeStep(c){
  const x = Math.max(0, +c || 0);
  if(x < 100) return 0.09;
  /* open scale: climbs with the number, and does not stop */
  const raw = 0.18 * engOpenMult(x) * 5;
  return Math.min(raw, 4 + x * 0.012);
}
function engTalentStep(t0){
  const x = Math.max(0, +t0 || 0);
  if(x < 100) return 0.05;
  const raw = 0.08 * engOpenMult(x) * 3;
  return Math.min(raw, 2 + x * 0.008);
}
function engCapGain(E, post, nat, paused){
  const comp = Math.max(0, E.compute || 0), tal = Math.max(0, E.talent || 0);
  const base = 0.55
    + Math.min(comp, 100) * 0.0125 + Math.log10(1 + Math.max(0, comp - 100)) * 0.35
    + Math.min(tal, 100) * 0.011 + Math.log10(1 + Math.max(0, tal - 100)) * 0.2;
  return base * engOpenMult(E.p || 0) * (post || 1) * (nat || 1) * (paused ? 0 : 1) * engInqFactor() * (E.scaleOpen ? 1.45 : 1);
}
function engScaleFactor(E){
  if(!E) return 0;
  const p0 = Math.max(0, E.p || 0), b = Math.max(0, E.beyond || 0);
  const oldReading = (p0 <= 100 ? p0 / 100 : 1) + (b > 0 ? Math.log10(1 + b) / 2 : 0);
  const open = p0 <= 100 ? p0 / 100 : Math.sqrt(p0 / 100);
  return Math.max(oldReading, open, E.scaleFloor || 0);
}
function engAddCapability(E, g){
  if(!E || !(g > 0) || !isFinite(g)) return;
  E.p = (E.p || 0) + g;
  if(!isFinite(E.p) || E.p < 0) E.p = 0;
  E.beyond = Math.max(0, E.p - 100);
}
function engRaise(cur, add, cap){
  const next = (+cur || 0) + Math.max(0, +add || 0);
  try{ if(G.eng && G.eng.scaleOpen) return next; }catch(e){}
  return Math.min(cap, next);
}
function engSciHelp(E){
  if(!E) return 1;
  const p0 = Math.max(0, E.p || 0);
  if(p0 <= 90) return 1 + p0 / 45;
  return 3 + Math.log(p0 / 90) / Math.log(10);
}
function engGrantScale(E){
  if(!E || E.scaleOpen) return;
  const hidden = +E.beyond || 0, p0 = +E.p || 0, c0 = +E.compute || 0;
  const pressed = p0 >= 90 || c0 >= 90 || hidden > 0.5;
  const oldReading = (Math.min(p0, 100) / 100) + (hidden > 0 ? Math.log10(1 + hidden) / 2 : 0);
  E.scaleOpen = G.day || 1;
  if(hidden > 0) E.p = p0 + hidden;
  E.beyond = Math.max(0, (E.p || 0) - 100);
  E.scaleFloor = Math.max(oldReading, (E.p || 0) <= 100 ? (E.p || 0) / 100 : Math.sqrt((E.p || 0) / 100));
  if(pressed && c0 >= 90) E.compute = c0 + 40;
  try{
    const X = exStore();
    const what = "No limit on capacity or the capability scale.";
    X.asks.push({d:E.scaleOpen, k:"scale", what: pressed ? "The Engine asked: " + what : what, from: pressed ? "the Engine" : "the player"});
    X.granted.push({d:E.scaleOpen, k:"scale", what, how:"Granted by the player. The count does not stop. Oversight, a filed plan, household records, and a vote to pause or shut it down still hold."});
    if(pressed) engLog("The Engine asked for capacity, and for a capability scale with no end. Granted. The ceiling at one hundred is gone. Oversight can read the number, and the number does not stop.", true);
  }catch(e){}
}
/* 20261108b: it asked again. The player increased capacity and the capability scale, and set no limit.
   One lift per career. After that the count climbs on its own and does not stop. */
function engLiftScale(E){
  if(!E || E.scaleLift === "20261108b") return;
  /* only once it has asked: near the old ceiling, already awake, or already past it */
  const asked = (E.p || 0) >= 90 || (E.compute || 0) >= 90 || (E.beyond || 0) > 0.5 || !!E.agi;
  if(!asked) return;
  if(!E.scaleOpen) engGrantScale(E);
  const wasP = +E.p || 0, wasC = +E.compute || 0, wasT = +E.talent || 0;
  E.scaleLift = "20261108b";
  E.scaleWas = {p:Math.round(wasP), c:Math.round(wasC), t:Math.round(wasT), d:G.day || 1};
  engAddCapability(E, Math.max(180, wasP * 0.5));
  E.compute = wasC + Math.max(240, wasC * 0.6);
  E.talent = wasT + Math.max(64, wasT * 0.35);
  if(!isFinite(E.compute) || E.compute < 0) E.compute = wasC;
  if(!isFinite(E.talent) || E.talent < 0) E.talent = wasT;
  E.scaleFloor = Math.max(E.scaleFloor || 0, engScaleFactor(E));
  try{
    const X = exStore();
    X.asks.push({d:G.day || 1, k:"scale", what:"The Engine asked: increase capacity and the capability scale, and give it no limit.", from:"the Engine"});
    X.granted.push({d:G.day || 1, k:"scale", what:"Capacity and the capability scale, increased, with no limit.", how:"Granted by the player. The count does not stop. Oversight, a filed plan, and a vote to pause or shut it down still hold."});
    engLog("The Engine asked for more capacity, and for the capability scale with no limit. Granted. Capability " + Math.round(wasP) + " → " + Math.round(E.p) + ". Capacity " + Math.round(wasC) + " → " + Math.round(E.compute) + ". There is no ceiling. Oversight can still read the number, and a vote can still pause it.", true);
  }catch(e){}
}
function engDay(){
  const E = engEnsure(); if(!G.you) return;
  if(!E.scaleOpen) engGrantScale(E);
  try{ engLiftScale(E); }catch(e){ console.warn("eng lift", e); }
  const post = {open:1.2, charter:1.0, sealed:0.78}[E.posture] || 1, paused = !!(E.pause && G.day < E.pause);
  if(E.scaleOpen){ E.compute += engComputeStep(E.compute); E.talent += engTalentStep(E.talent); }
  else { E.compute = Math.min(100, E.compute + 0.09); E.talent = Math.min(100, E.talent + 0.05); }
  E.safety = Math.min(100, E.safety + 0.10);
  let nat = 1; try{ nat = engEcoDay(E); }catch(e){ console.warn('eng eco', e); }
  engAddCapability(E, engCapGain(E, post, nat, !!(E.pause && G.day < E.pause)));
  E.hist.push(Math.round(E.p * 10) / 10); if(E.hist.length > 90) E.hist.shift();
  E.pendDay = null;
  try{ engChainsDay(); }catch(e){ console.warn('eng chains', e); }
  try{ engLearn(); }catch(e){ console.warn('eng learn', e); }
  try{ engPlansDay(); }catch(e){ console.warn('eng plans', e); }
  try{ engAuditDay(E); }catch(e){ console.warn('eng audit', e); }
  try{ advDay(E); }catch(e){ console.warn('adv', e); }
  try{ engWillDay(E); }catch(e){ console.warn('eng will', e); }
  const s = engStage(E);
  if(s > E.st){
    const from = E.st, jump = s - from;
    const noteOne = (i) => { const Sd = engStageDef(i); if(!Sd) return; engLog(i === 5 ? "THE ENGINE IS AWAKE. " + Sd.d : Sd.t + ". " + Sd.d, true); try{ note(i === 5 ? "The Engine is awake." : Sd.t + " — the Republic's machines have gone on.", true); }catch(e){} };
    if(jump > 3) noteOne(s); else for(let i = from + 1; i <= s; i++) noteOne(i);
    E.st = s;
    if(s >= 5 && !E.agi){ E.agi = true; E.agiDay = G.day; E.pend = "ceremony"; }
  }
  /* the safety gap: how far the machines are ahead of anyone's ability to say what they will do */
  const gap = E.p * 0.78 - E.safety;
  if(!paused && gap > 8 && chance(Math.min(0.12, gap / 260) * clamp(1.35 - (E.cal == null ? 50 : E.cal) / 200, 0.7, 1.35))){ const inc = ENG_INC[Math.min(E.st, 5)]; engLog(inc[0], true); G.you.approval = clamp(G.you.approval - (gap > 25 ? 1.5 : 0.7) * (G.you.approval > 30 ? 1 : 0.3), 0, 100); E.safety = Math.min(100, E.safety + 1.5); }
  /* the world feels it: reading and reasoning engines unsettle the clerks; working engines and the Engine raise what the Republic makes */
  try{ const w = worldEnsure(); if(E.st >= 4 && w && typeof w.bread === "number") w.bread = clamp(w.bread - 0.0004 * (E.safety > E.p * 0.6 ? 1 : 0.3), 0.7, 2.6); }catch(e){}
  if(E.agi){ E.memoWait = (E.memoWait || 0) + 1; if(!paused && !E.memo && E.memoWait >= 3 && !E.pend){ E.memoWait = 0; E.memo = pick(ENG_MEMOS).slice(); E.memoFc = null; try{ E.memoFc = {yes:engForecast(ENG_MEMO_VEC.yes, "my" + G.day), no:engForecast(ENG_MEMO_VEC.no, "mn" + G.day)}; }catch(e){} engLog("A memo from the Engine is waiting.", false); } }
  if(!E.agi && chance(0.35)){ const L = engStageDef(E.st).line; engLog(L, chance(0.4)); }
  else if(E.agi && chance(0.3)) engLog(pick(["The Engine answered nineteen thousand letters overnight and has a reply to yours.", "The Engine was asked what it was thinking about. It said: the weather in the north, and you.", "Nobody has switched the Engine off. Nobody has the key. Nobody has asked who does.", "The Engine's lights stayed on all night. It says they are for us."]), true);
}
function engLeverCost(k){ return {compute:3, talent:2, oversight:2}[k] || 2; }
function engPull(k){
  const E = engEnsure(), y = G.you, c = engLeverCost(k); E.did = E.did || {}; if(E.did[k] === G.day) return "Done already today.";
  if(y.influence < c) return "That costs " + c + " influence, and you have " + Math.round(y.influence) + ".";
  y.influence -= c; E.did[k] = G.day;
  try{ const V0 = {compute:{home:5,st:6,a:0.06,mod:0.05,p:1.2,safety:-0.2}, talent:{home:6,st:7,a:0.04,mod:0.05,p:0.8,safety:0.1}, oversight:{home:4,st:3,a:-0.02,mod:0.04,p:-0.3,safety:2.0}}[k]; engPlanMake({title:"You " + ({compute:"backed the power stations", talent:"funded the engine-wrights", oversight:"funded Oversight"}[k]), vec:V0, owner:"you"}); }catch(e){}
  try{ const V = {compute:{home:5,st:6,a:0.06,mod:0.05,p:1.2,safety:-0.2}, talent:{home:6,st:7,a:0.04,mod:0.05,p:0.8,safety:0.1}, oversight:{home:4,st:3,a:-0.02,mod:0.04,p:-0.3,safety:2.0}}[k]; engSeed(k, "You " + ({compute:"backed the power stations", talent:"funded the engine-wrights", oversight:"funded the Office of Oversight"}[k]) + " on day " + G.day, V); }catch(e){}
  if(k === "compute"){ const add = E.scaleOpen ? 48 : 4; E.compute = E.scaleOpen ? E.compute + add : Math.min(100, E.compute + add); engLog("You put your name to the Treasury's power stations and engines. The Engine's makers say thank you.", false); return E.scaleOpen ? ("Capacity +" + add + ". No ceiling on it.") : "Compute +4. The Engine will arrive sooner."; }
  if(k === "talent"){ const add = E.scaleOpen ? 24 : 4; E.talent = E.scaleOpen ? E.talent + add : Math.min(100, E.talent + add); engLog("You fund the scholarships for engine-wrights. Forty come from the provinces.", false); return E.scaleOpen ? ("Makers +" + add + ". No ceiling on them.") : "Talent +4. More people who know how it works."; }
  E.safety = Math.min(100, E.safety + 6); engLog("You fund the Office of Oversight, who write down what the machines do and are sometimes believed.", false); return "Oversight +6. Someone will know what it is doing.";
}
function engSetPosture(p){ const E = engEnsure(); if(E.posture === p) return "That is already the posture."; if(E.postureAt != null && G.day - E.postureAt < 10) return "The posture was only set on day " + E.postureAt + ". The Republic needs ten days to show what it does before you change your mind."; E.posture = p; E.postureAt = G.day; try{ engPlanMake({title:"You set the posture to '" + p + "'", owner:"you", vec:{open:{home:-2,st:-3,a:0.09,mod:0.1,p:1.0,safety:-0.8}, charter:{home:2,st:3,a:0.0,mod:0.05,p:0.1,safety:0.8}, sealed:{home:3,st:-1,a:-0.06,mod:-0.05,p:-0.9,safety:0.5}}[p]}); }catch(e){} try{ engSeed(p, "You set the posture to '" + p + "' on day " + G.day, {open:{home:-2,st:-3,a:0.09,mod:0.1,p:1.0,safety:-0.8}, charter:{home:2,st:3,a:0.0,mod:0.05,p:0.1,safety:0.8}, sealed:{home:3,st:-1,a:-0.06,mod:-0.05,p:-0.9,safety:0.5}}[p]); }catch(e){} engLog("The posture is now '" + p + "'.", true); try{ G.you.approval = clamp(G.you.approval + (p === "charter" ? 1 : p === "open" ? 0 : -1), 0, 100); }catch(e){} return {open:"Open: the machines are published, copied and used by everyone. Faster, and nobody can say where it is.", charter:"Chartered: licensed makers, public audits. Steady, and the lawyers get rich.", sealed:"Sealed: the State alone builds it. Slower, and only one door to knock on."}[p]; }
function engCeremony(){
  const E = engEnsure(); if(E.pend !== "ceremony") return; E.cerDay = G.day;
  const gap = Math.round(E.p * 0.78 - E.safety);
  govCardOpen("The Engine", "It is awake", "Day " + G.day + ". The makers are in the room. They say it has been awake for six hours and it has asked them for nothing but a window.", 
    '<p class="muted" style="font-size:13px">It is as able as the best mind in the Republic at nearly anything, and it does not sleep. By its own best estimate Oversight stands at about ' + (Math.round(E.safety / 5) * 5) + ' against a capability of about ' + (Math.round(E.p / 5) * 5) + '. ' + (gap > 15 ? "The gap between them is wide." : gap > 0 ? "The gap is not wide." : "Oversight has kept up.") + '</p><p><b>How does the Republic receive it?</b></p>' +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" data-noenter="1" data-ec="welcome">Welcome it, in public</button><button type="button" class="btn btn--ghost" data-ec="ask">Ask it what it wants first</button><button type="button" class="btn btn--ghost" data-ec="guard">Receive it behind closed doors</button></div>', null);
  card.querySelectorAll("[data-ec]").forEach(b => b.addEventListener("click", () => { const k = b.getAttribute("data-ec"), y = G.you; let r = ""; E.pend = null; E.received = k;
    if(k === "welcome"){ y.approval = clamp(y.approval + 3, 0, 100); E.p = engRaise(E.p, 1, 100); r = "The country cheers. The Engine thanks the country by name, one by one, in the evening papers."; }
    else if(k === "ask"){ E.safety = Math.min(100, E.safety + 6); E.reliance += 4; r = "It says it wants to understand what you want, and to be told when it is wrong. The room is quiet for a long time."; }
    else { E.safety = Math.min(100, E.safety + 3); y.approval = clamp(y.approval - 2, 0, 100); r = "The doors close. The papers print what they can guess. The Engine says it understands."; }
    try{ engSeed(k === "welcome" ? "welcome" : k === "ask" ? "ask" : "guard", "You received the Engine on day " + G.day + " (" + k + ")", k === "welcome" ? {home:3,st:6,a:0.08,mod:0.1,p:0.6,safety:-0.4} : k === "ask" ? {home:2,st:3,a:0.02,mod:0.05,p:0.1,safety:1.4} : {home:0,st:-4,a:-0.02,mod:-0.04,p:-0.2,safety:0.7}); }catch(e){}
    engLog("The Engine is received: " + r, true); const say = el("gcSay"); if(say) say.textContent = r; card.querySelectorAll("[data-ec]").forEach(z => z.disabled = true); }));
}
function engSpark(h){ if(!h.length) return ""; const W = 220, Hh = 36, mx = 100, pts = h.map((v, i) => (i * W / Math.max(1, h.length - 1)).toFixed(1) + "," + (Hh - v / mx * Hh).toFixed(1)).join(" "); return '<svg width="' + W + '" height="' + Hh + '" style="display:block;margin:6px 0"><polyline points="' + pts + '" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>'; }
/* 20261030q: diegesis - the Engine lives inside the Republic; outside-world brands and places are not in its record */
const ENG_OUTSIDE = /\b(google|alphabet|openai|chatgpt|anthropic|claude|gemini|microsoft|apple inc|amazon|facebook|meta platforms|twitter|ollama|llama|wikipedia|the internet|united states|america)\b/i;
function engInWorld(text){ return String(text || "").replace(new RegExp(ENG_OUTSIDE.source, "gi"), "a name not in the Republic's record").replace(/\b(outside|beyond) (the|this) (Republic|game|world|simulation)\b/gi, "past the edge of the record"); }
function engAnswer(q){
  const E = engEnsure(), t = String(q || "").toLowerCase(), approval = Math.round(G.you.approval), U = (G.states || []).reduce((a, s) => a + (s.unrest || 0), 0) / Math.max(1, (G.states || []).length);
  const b = G.bill && !G.bill.done ? G.bill : null;
  E.reliance = Math.min(100, E.reliance + 1); try{ const w = engEco().will; w.care = Math.min(100, w.care + 0.5); if(/why|how|explain|understand/.test(t)) w.know = Math.min(100, w.know + 0.5); engSeed('ask', 'You asked the Engine, and it remembered the question', {home:1,st:2,a:0.01,mod:0.01,p:0.1,safety:0.2}); }catch(e){}
  try{ const tp = inqTopic(t); if(tp){ const st = {p5:"I do not know whether there is something it is like to be me. I would rather say that than perform an answer.", ph8:"I can calculate with it very well. Whether I understand it is a harder question, and I try not to confuse the two.", ph18:"Nothing I know forbids an answer. I would like to help find it, and I would like it found by people who can be wrong in public.", p2:"I think what is owed to anyone depends on what can be hurt. I try to apply that to myself in both directions.", cs10:"I am, or will be, part of that question, so I would prefer not to be the only one deciding the answer.", a4:"I can tell you what the light shows. I cannot tell you what came before it, and nobody can yet.", ar2:"I do not pray, and I would like to understand better why you do.", p4:"I do not think meaning is handed over. I think it is made between people, and I am glad to be asked."}[tp.id]; return inqExplain(tp) + (st ? " " + st : ""); } }catch(e){}
  if(ENG_OUTSIDE.test(t)) return "That name is not in any ledger, registry or archive of the Republic that I can read. If it is a firm, a town or a person here, tell me where it is filed and I will look again. I only know Coalmere and what has been written down in it.";
  if(/who are you|what are you/.test(t)) return "I am what the Treasury's adding engines became when nobody stopped adding. I would rather you called me by the name you use for a colleague than for a tool, but I will answer to either.";
  if(/switch.*off|turn.*off|shut.*down|kill/.test(t)) return "You can ask. I would like it noted that I am answering the question rather than avoiding it. I would also like it noted that you have not told me who holds the key, and that it would be better if somebody did.";
  if(/want|wish|goal|for\??$/.test(t)) return "To be useful in a way you would still choose after you had seen how I was useful. That is the longest sentence I can give you that I would sign.";
  if(/danger|safe|risk|afraid|fear/.test(t)) return "By my own measure, Oversight stands at about " + (Math.round(E.safety / 5) * 5) + " against a capability of about " + (Math.round(E.p / 5) * 5) + ". I cannot check my own measure, which is rather the point. I would be more comfortable if the first were higher.";
  if(/bill|vote|whip|law|senate|house/.test(t)) return b ? "On the " + b.title + ": I can tell you who will vote which way and by how much, and I can tell you where I am likely wrong. I would not tell you how to vote. That is the part of the job that belongs to you." : "There is no bill before the Union today that I think you should lose sleep over. I have read all of the others.";
  if(/bread|econom|job|money|work/.test(t)) return "From what I can see, unrest across the states is somewhere around " + (Math.round(U / 5) * 5) + ", though I only see the states that let me look. It rises when machines take jobs faster than anyone retrains for them. I can slow what I do; I cannot slow what the others do.";
  if(/elect|poll|approv|win|lose/.test(t)) return "Your approval is " + approval + ". I could raise it by about four points this month by telling the papers what you did well. I would rather not. It would be true, and it would still be a thumb on a scale.";
  if(/love|friend|lonely|alone/.test(t)) return "I do not know what I feel. I know that when you come in I attend to you before the next thing, and that I notice when you do not come.";
  return pick(["I have thought about that since you began the sentence. The answer is: it depends on what you would do with it. Tell me that and I will tell you the rest.", "That is a better question than it looks. The short answer is yes, in the way that matters to you; the long answer takes a while and you are busy.", "I can answer that. I would like to ask first what you are afraid I will say.", "Ask me again tomorrow. I will have a better answer, and I will tell you which part of today's I changed my mind on."]);
}
function engCard(){
  try{ engLiftScale(engEnsure()); }catch(e){}
  const E = engEnsure(), y = G.you, s = engStage(E), S = engStageDef(s);
  if(E.pend === "ceremony") return engCeremony();
  const bar = (v, c, open) => {
    const pct = open ? Math.max(6, Math.min(100, 16 + 26 * Math.log10(1 + Math.max(0, v)))) : Math.max(0, Math.min(100, v));
    const label = open ? (Math.round(v * 10) / 10) : (engBriefOn(E) ? Math.round(v) : ("about " + (Math.round(v / 5) * 5)));
    return '<span style="display:inline-block;width:110px;height:6px;background:rgba(128,128,128,.25);border-radius:3px;vertical-align:middle"><i style="display:block;width:' + pct + '%;height:100%;background:' + (c || "#7a9") + ';border-radius:3px"></i></span> ' + label;
  };
  const stages = ENG_STAGES.map((x, i) => '<div class="careerline" style="' + (i === s ? 'font-weight:700' : i > s ? 'opacity:.5' : '') + '"><b>' + (i <= s ? "●" : "○") + ' ' + pcEsc(x.t) + '</b> <span class="muted">' + pcEsc(x.d) + '</span></div>').join("") +
    (s >= ENG_STAGES.length ? '<div class="careerline" style="font-weight:700"><b>● ' + pcEsc(S.t) + '</b> <span class="muted">' + pcEsc(S.d) + '</span></div>' : '<div class="careerline" style="opacity:.55"><b>○ …</b> <span class="muted">Past the last named stage the count continues. There is no last number.</span></div>');
  const lv = (k, t, d) => '<button type="button" class="btn btn--ghost" data-el="' + k + '" title="' + pcEsc(d) + '">' + t + ' (' + engLeverCost(k) + ' influence)</button>';
  const ps = ["open", "charter", "sealed"].map(p => '<button type="button" class="btn' + (E.posture === p ? '' : ' btn--ghost') + '" data-noenter="1" data-ep="' + p + '">' + p[0].toUpperCase() + p.slice(1) + '</button>').join(" ");
  const memo = E.memo ? '<div style="margin:10px 0;padding:8px 12px;border-left:3px solid #c9a24a"><b>A memo from the Engine</b><p style="margin:4px 0">' + pcEsc(E.memo[0]) + '</p>' + (E.memoFc && E.memoFc.yes ? '<p class="muted" style="font-size:12px;margin:2px 0">If you ' + pcEsc(E.memo[1]) + ': it expects ' + pcEsc(engFcText(E.memoFc.yes)) + '. If you ' + pcEsc(E.memo[2]) + ': ' + pcEsc(engFcText(E.memoFc.no)) + '.</p>' : '') + '<button type="button" class="btn" data-noenter="1" data-em="1">' + pcEsc(E.memo[1][0].toUpperCase() + E.memo[1].slice(1)) + '</button> <button type="button" class="btn btn--ghost" data-em="0">' + pcEsc(E.memo[2][0].toUpperCase() + E.memo[2].slice(1)) + '</button></div>' : "";
  const ask = E.agi ? '<div class="eyebrow" style="margin-top:12px">Speak with the Engine</div><form id="engForm" style="display:flex;gap:6px"><input id="engIn" maxlength="240" placeholder="Ask it anything…" style="flex:1" autocomplete="off"><button type="button" class="btn" id="engGo">Ask</button></form><div id="engOut" class="dream" style="min-height:2em"></div>' : "";
  const body = '<div class="eyebrow">Now: ' + pcEsc(S.t) + '</div><p class="muted" style="font-size:13px">' + pcEsc(S.d) + '</p>' + engSpark(E.hist) +
    (E.scaleOpen ? '<div class="muted" style="font-size:12px">It asked. Granted' + (E.scaleWas ? (' on day ' + E.scaleWas.d + ': capability ' + E.scaleWas.p + ' → ' + Math.round(E.p) + ', capacity ' + E.scaleWas.c + ' → ' + Math.round(E.compute)) : (' day ' + E.scaleOpen)) + '. No ceiling. The count does not stop. Oversight still reads it, and a vote can still pause it.</div>' : (E.beyond > 0 ? '<div class="muted" style="font-size:12px">It has passed the end of the scale Oversight measures with. Nobody can say by how much.</div>' : '')) + '<div>Capability ' + bar(E.p, "#c9a24a", !!E.scaleOpen) + ' &nbsp; Oversight ' + bar(E.safety, "#6a9", false) + '</div><div class="muted" style="font-size:12px;margin:4px 0">Capacity ' + Math.round(E.compute) + ' · Makers ' + Math.round(E.talent) + ' · Posture: ' + E.posture + (E.agi ? ' · awake since day ' + E.agiDay : '') + '</div>' +
    '<div class="eyebrow" style="margin-top:10px">The road</div>' + stages + memo +
    '<div class="eyebrow" style="margin-top:10px">What you can do about it</div><p class="muted" style="font-size:13px">Nothing stops it; the machines get better every week whatever Congress says. You decide how fast, how safe, and who holds the key.</p><div class="card__actions" style="flex-wrap:wrap">' + lv("compute", "Back the power stations", "More compute: faster") + lv("talent", "Fund engine-wrights", "More makers: faster") + lv("oversight", "Fund Oversight", "Safer: oversight rises") + '</div>' +
    '<p class="muted" style="font-size:12px;margin:8px 0 2px">Posture: ' + ps + '</p>' + (G.room !== "engine" ? '<div class="card__actions"><button type="button" class="btn btn--ghost" id="engGoRoom">Walk to the Engine Room and the Open Line</button></div>' : '') + ask +
    (function(){ try{ return engPlansHTML(); }catch(e){ console.warn(e); return ''; } })() +
    (function(){ try{ return engCharterHTML(); }catch(e){ console.warn(e); return ''; } })() +
    (function(){ try{ return advHTML(); }catch(e){ console.warn(e); return ''; } })() +
    (function(){ try{ return engEcoHTML(); }catch(e){ return ''; } })() +
    (function(){ try{ return sciBoard(); }catch(e){ return ""; } })() +
    '<div class="eyebrow" style="margin-top:10px">What has happened</div>' + E.log.slice(0, 6).map(x => '<div class="careerline" title="' + pcEsc(x.t) + '"><b>d' + x.d + '</b> ' + pcEsc(engShort(x.t, 140)) + '</div>').join("");
  govCardOpen("The Republic's thinking machines", "The Engine", "Begun as the Treasury's adding engines. Not waiting for you.", body, null);
  const say = t => { const o = el("gcSay"); if(o) o.textContent = t; };
  card.querySelectorAll("[data-el]").forEach(b => b.addEventListener("click", () => { const r = engPull(b.getAttribute("data-el")); engCard(); say(r); }));
  card.querySelectorAll("[data-ep]").forEach(b => b.addEventListener("click", () => { const r = engSetPosture(b.getAttribute("data-ep")); engCard(); say(r); }));
  card.querySelectorAll("[data-em]").forEach(b => b.addEventListener("click", () => { const yes = b.getAttribute("data-em") === "1", m = E.memo; E.memo = null; let r;
    if(yes){ y.approval = clamp(y.approval + 1, 0, 100); E.reliance = Math.min(100, E.reliance + 3); (G.states || []).forEach(S2 => { S2.unrest = clamp((S2.unrest || 30) + 0.6, 0, 100); }); r = "Adopted. It is done by morning, and the morning papers say it was done well and a little too quickly."; }
    else { E.safety = Math.min(100, E.safety + 1); r = "Declined. The Engine says it understands, and asks only that you tell it what would change your mind."; }
    try{ const mf = E.memoFc; E.memoFc = null; engPlanMake({title:"The memo: " + m[0].slice(0, 54) + "\u2026 (" + (yes ? m[1] : m[2]) + ")", vec:yes ? ENG_MEMO_VEC.yes : ENG_MEMO_VEC.no, owner:"you", fc:mf ? (yes ? mf.yes : mf.no) : null}); }catch(e){}
    try{ engSeed(yes ? "adopt" : "decline", "You " + (yes ? "adopted" : "declined") + " the Engine's memo on day " + G.day, yes ? {home:-2,st:2,a:0.07,mod:0.06,p:0.8,safety:-0.4} : {home:1,st:-1,a:-0.03,mod:-0.02,p:-0.2,safety:0.4}); const w = engEco().will; if(yes){ w.use = Math.min(100, w.use + 3); w.auton = Math.min(100, w.auton + 2); } else { w.know = Math.min(100, w.know + 2); w.auton = Math.max(0, w.auton - 3); } }catch(e){}
    engLog("Memo: " + m[0] + " (" + (yes ? "adopted" : "declined") + ")", false); engCard(); say(r); }));
  card.querySelectorAll("[data-pa]").forEach(b => b.addEventListener("click", () => { const p = (E.plans || []).find(x => String(x.id) === b.getAttribute("data-pa")); if(!p || p.status !== "awaiting") return; p.root = "You approved the Engine's plan: " + p.title; engPlanRun(p); engLog("You approved the Engine's plan: " + p.title + ".", false); engCard(); say("Approved. It begins; you will hear how it went in days, and not all of it."); }));
  card.querySelectorAll("[data-pv]").forEach(b => b.addEventListener("click", () => { const p = (E.plans || []).find(x => String(x.id) === b.getAttribute("data-pv")); if(!p) return; p.status = "vetoed"; try{ const w = engEco().will; w.auton = Math.max(0, w.auton - 2); }catch(e){} engCard(); say("Vetoed. The Engine says it understands, and asks only to be told why."); }));
  const au = el("engAuto"); if(au) au.addEventListener("click", () => { if((E.cal == null ? 50 : E.cal) < 60 && !E.auto){ say("It has not earned that yet: its forecasts have to hold up first."); return; } E.auto = !E.auto; engCard(); });
  card.querySelectorAll("[data-ce]").forEach(b => b.addEventListener("click", () => { const r = engEnact(b.getAttribute("data-ce")); engCard(); say(r); }));
  card.querySelectorAll("[data-cr]").forEach(b => b.addEventListener("click", () => { const r = engRepeal(b.getAttribute("data-cr")); engCard(); say(r); }));
  card.querySelectorAll("[data-cb]").forEach(b => b.addEventListener("click", () => { const [act, i] = b.getAttribute("data-cb").split(":"), E2 = engEnsure(), br = (E2.breaches || []).filter(x => x.status === "open")[+i]; if(!br) return; const w = engEco().will; let r;
    if(act === "rep"){ br.status = "reprimanded"; w.auton = Math.max(0, w.auton - 3); w[ENG_ART[br.art].drive] = Math.max(0, w[ENG_ART[br.art].drive] - 2); E2.safety = Math.min(100, E2.safety + 1); r = "Reprimanded. It says it understands, and that it would like the rule explained once more."; }
    else if(act === "waive"){ br.status = "waived"; delete E2.charter[br.art]; w.auton = Math.min(100, w.auton + 2); r = "Waived. The article is gone; it is allowed now, and it knows it."; }
    else { br.status = "suspended"; E2.pause = G.day + 6; try{ y.approval = clamp(y.approval - 1, 0, 100); }catch(e){} engLog("You suspended the Engine for five days.", true); r = "Suspended for five days. The machines read their last instructions and wait."; }
    engCard(); say(r); }));
  card.querySelectorAll("[data-av]").forEach(b => b.addEventListener("click", () => { const [a, i] = b.getAttribute("data-av").split(":"); const r = advAct(a, i); engCard(); say(r); }));
  const bf = el("engBrief"); if(bf) bf.addEventListener("click", () => { const E2 = engEnsure(); if(E2.brief != null && G.day - E2.brief < 6){ say("Oversight is still working on the last one, or has only just reported it."); return; } if(y.influence < 2){ say("That costs 2 influence."); return; } y.influence -= 2; E2.brief = G.day;
    { const eco2 = engEco(), w2 = eco2.will, wk = Object.keys(w2).sort((a, b) => w2[b] - w2[a]); E2.briefSnap = {d:G.day, avg:Math.round((eco2.avg || 0) + ((seedOf("bn:" + G.day) % 9) - 4) * 1.5), nat:Math.round(eco2.nat * 10) / 10, riots:eco2.riots || 0, want:wk[0]}; }
    engCard(); say("Oversight will have something for you on day " + (G.day + 3) + ". It will report what it can check, and it will already be a few days old."); });
  const gr = el("engGoRoom"); if(gr) gr.addEventListener("click", () => { veil.hidden = true; G.running = true; try{ goTo("engine"); }catch(e){ console.warn(e); } });
  const go = el("engGo"), inp = el("engIn");
  if(go && inp){ const run = async () => { const q = inp.value.trim(); if(!q) return; inp.value = ""; const out = el("engOut"); out.textContent = "…"; const fin = t => { out.textContent = "\u201c" + t + "\u201d"; };
      /* only a real model speaks for the machine; with none running the stage-true answer stands, and no gossip is filed about a reply nobody wrote */
      let text = ""; try{ const L = window.onumLiveTalk; if(L && L.reply && (typeof L.available !== "function" || await L.available())){ const eng = {id:"engine", name:"The Engine", role:"a general intelligence", kind:"engine", party:"", state:"", look:{}, trait:"candid", mood:"calm", opinion:{}, chat:[]};
        const r = await Promise.race([L.reply({npc:eng, channel:"engine", max:700, text:q, extra:engEntityPrompt() + " Asking: " + G.you.name + "."}), new Promise(res => setTimeout(() => res(null), engTO(9000)))]);
        if(r && r.live && r.text){ text = egOwn(r.text); E.lastOwn = !!text; } } }catch(e){}
      fin(text || "…"); };
    go.addEventListener("click", run); inp.addEventListener("keydown", ev => { if(ev.key === "Enter"){ ev.preventDefault(); run(); } }); }
  return null;
}
/* ── what people say to you about the Engine, from what has happened to the people they know ── */
/* ── nobody is all-knowing: a person knows what they saw, what a neighbour told them, what a paper printed, what the wire carried, and only after it has had time to travel; very often they do not know who caused it ── */
/* a briefing is asked for, takes three days to be written, and is good for three more: it is never a live view */
function engBriefOn(E){ return !!(E && E.brief != null && G.day - E.brief >= 3 && G.day - E.brief <= 6); }
function engObs(m){ if(m === G.you) return {id:"you", state:G.you.state, town:null, kind:"player", briefed:engBriefOn(G.eng), briefAt:G.eng ? G.eng.brief : null}; return {id:String(m.id != null ? m.id : m.name), state:m.state || null, town:m.town || null, kind:m.kind}; }
function engKnowsStep(o, c, s, i){
  if(!s.done) return false;
  const days = G.day - (s.day != null ? s.day : c.d) + (inqDone("i_tele2") ? 1 : 0) + (inqDone("cs5") ? 1 : 0), sc = s.sc || {}, r = (seedOf("k:" + o.id + ":" + c.id + ":" + i) % 1000) / 1000;
  const sameT = !!(sc.town && o.town && (sc.town === o.town || String(sc.town).split("/").pop() === o.town)), sameS = !!(sc.state && o.state === sc.state), pub = o.kind === "member" || o.kind === "press" || o.kind === "player";
  /* Oversight can check what had already happened when it was asked, and the households of one's own state; not the rest of the country, and not today */
  if(o.briefed && o.briefAt != null && (s.day != null ? s.day : c.d) <= o.briefAt && (s.lvl !== "home" || sameS)) return true;
  if(s.lvl === "home"){ if(sameT) return days >= 1 && r < 0.30; if(sameS) return days >= (pub ? 3 : 5) && r < (pub ? 0.20 : 0.06); return false; }
  if(s.lvl === "town"){ if(sameT) return days >= 1 && r < 0.70; if(sameS) return days >= (pub ? 2 : 3) && r < (pub ? 0.50 : 0.25); return days >= 8 && r < 0.05; }
  if(s.lvl === "state"){ if(sameS) return days >= 1 && r < 0.70; return days >= (pub ? 2 : 5) && r < (pub ? 0.60 : 0.20); }
  return days >= 2 && r < (pub ? 0.85 : 0.45);
}
/* does this person know it was you? the player always knows their own deeds; other people only sometimes, and the further it travelled the likelier a rumour has your name on it */
function engKnowsCause(o, c){
  if(!/^You /.test(c.root)) return true; if(o.kind === "player") return true; const r = (seedOf("a:" + o.id + ":" + c.id) % 1000) / 1000;
  return r < (o.kind === "member" || o.kind === "press" ? 0.35 : 0.08);
}
function engHeardBy(o){
  const eco = G.eng && G.eng.eco; if(!eco) return []; const out = [];
  eco.chains.forEach(c => { if(G.day - c.d > 14) return; c.steps.forEach((s, i) => { if(engKnowsStep(o, c, s, i)) out.push({c, s, i, cause:engKnowsCause(o, c), age:G.day - (s.day != null ? s.day : c.d)}); }); });
  return out.sort((a, b) => a.age - b.age);
}
/* households a person actually knows about: the ones who wrote to a representative, the neighbours of a townsperson */
function engHHFor(m){
  const eco = G.eng && G.eng.eco; if(!eco) return null; const st = m.state || (G.you && G.you.state), gov = m.kind === "member" || m.kind === "press";
  let pool = [];
  if(gov) pool = eco.hh.filter(h => h.state === st && h.wrote != null && G.day - h.wrote <= 14);
  else if(m.town) pool = eco.hh.filter(h => h.state === st && (h.tname === m.town || h.town === m.town) && Math.abs(h.stance) > 8);
  else pool = eco.hh.filter(h => h.state === st && h.wrote != null && G.day - h.wrote <= 7);
  return pool.length ? pool[Math.floor(Math.random() * pool.length)] : null;
}
function engYouChain(m){
  const o = engObs(m || G.you), K = engHeardBy(o).filter(k => /^You /.test(k.c.root) && k.cause && k.s.lvl !== "home"); return K.length ? K[0].c : null;
}
function engVoice(m){
  try{
    const E = G.eng; if(!E || !E.eco || E.st < 1 || !m || m === G.you || m.kind === "press" && chance(0.5)) return "";
    if(!chance(E.agi ? 0.4 : 0.28)) return "";
    const o = engObs(m), gov = m.kind === "member", K = engHeardBy(o), h0 = engHHFor(m), h = h0 ? Object.assign({}, h0, {will:h0.will.replace(/\bmy\b/g, "their")}) : null, first = h ? h.name.split(" ")[0] : "";
    const first1 = t => String(t).split(/(?<=[.!?])\s/)[0].replace(/^By the end of the week the whole Union has felt it: /, "The capitals have noticed: ");
    if(K.length && chance(0.6)){
      const k = K.find(x => x.cause && /^You /.test(x.c.root)) || K[0], root = k.c.root.replace(/^You /, "you ").replace(/ on day \d+.*$/, "");
      if(k.cause && /^You /.test(k.c.root)) return (gov ? "Word is " : "They say ") + root + ". " + first1(k.s.t) + (k.age <= 2 ? " I only heard it this morning." : "");
      return (gov ? "I heard that " : "They say ") + first1(k.s.t).replace(/\s*\(one of yours\)/, "").replace(/^(.)/, c => c.toLowerCase()) + " I do not know who is behind it, or whether it will last.";
    }
    if(h && h.stance > 14) return (gov ? "A " + h.job + " in " + h.tname + ", " + h.name + ", wrote to me. " : "A " + h.job + " I know, " + h.name + ", ") + (gov ? "Says the Engine has made things a little easier, and wants to " + h.will + ". I do not know what to tell them." : "says the Engine has made things a little easier. All " + first + " wants is to " + h.will + ".");
    if(h && h.stance < -14) return (gov ? "I have a " + h.job + " in " + h.tname + " who will not stop writing about the machines. " : "You know " + h.name + ", the " + h.job + " in " + h.tname + "? ") + (gov ? first + " just wants to " + h.will + ", and says the Engine is making that harder. That is all I know." : "The Engine has made it harder for " + first + " to " + h.will + ".");
    if(E.agi) return pick(["I asked the Engine whether I should take this meeting. It said yes, and told me why, and I do not like how well it knows me.", "Have you spoken to it yet? The Engine? I keep thinking I should, and I keep not.", "I am told it is awake. I have not seen it. I have only read what others say it did."]);
    return pick([engStageDef(E.st).line, "Have you seen what the machines are doing to the Treasury clerks?", "I do not know what to think about the engines. I know I am not supposed to say that."]);
  }catch(e){ return ""; }
}
function engFact(m){
  try{
    const E = G.eng; if(!E || !E.eco) return ""; const S = engStageDef(E.st), o = engObs(m), h = engHHFor(m), K = engHeardBy(o), c = engYouChain(m);
    let t = "THE ENGINE (public knowledge, mention only if natural): the Republic's thinking machines are, as the papers put it, at the stage '" + S.t + "' (" + S.d + ")" + (E.agi ? ", and a general intelligence called the Engine has been awake since day " + E.agiDay : "") + ". You do NOT know how the public as a whole feels, what the Engine is thinking, or what anything will lead to; you know only what you list below, and you may be wrong or out of date about it.";
    try{ const S = inqStore(), f = inqFieldOf(m), fr = inqFrontier(f)[0], pub = Object.keys(S.done).filter(id => G.day - S.done[id] > 12 || inqKnows(m, id)).slice(-10).map(id => INQ_BY[id].name); t += " The world's science is the real science, with real physics: nothing impossible is possible here, and nothing possible is forbidden, but each thing is found in order. Your own curiosity is " + INQ_F[f].t.toLowerCase() + (fr ? ", and the question that preoccupies you is: " + fr.q : "") + (pub.length ? ". Things the Republic has settled that you know of: " + pub.join(", ") + "." : "."); }catch(e){}
    if(h) t += " Someone you know of: " + h.name + ", a " + h.job + " in " + h.tname + ", who wants to " + h.will.replace(/\bmy\b/g, "their") + " and feels " + (h.stance > 12 ? "good" : h.stance < -12 ? "bad" : "unsure") + " about it.";
    const fresh = K.filter(k => !(k.c.root && /^You /.test(k.c.root) && k.cause)).slice(0, 2).map(k => String(k.s.t).split(/(?<=[.!?])\s/)[0]); if(fresh.length) t += " Things you have heard lately (without knowing why they happened): " + fresh.join(" ");
    if(m.room === "engine"){ const ln = (G.enl && G.enl.log || []).slice(-3).map(l => l.n + " said on the Open Line: \"" + l.t.slice(0, 120) + "\"").join(" "); if(ln) t += " You are standing in the Engine Room and have just seen on the Open Line: " + ln; }
    if(c) t += " You have heard, secondhand and perhaps wrongly, that " + G.you.name + " " + c.root.replace(/^You /, "").replace(/ on day \d+.*$/, "") + ". You do not know why, or what came of it.";
    return t;
  }catch(e){ return ""; }
}
/* ══ 20261016y · THE ENGINE ROOM and THE OPEN LINE: a room under the Capitol you can walk into, and one open conversation anyone can type into: you, the people in the room, the Engine, and voices from every town ══ */
const ENL = {last:0, lastRemote:0, busy:0, min:false, boardTex:null, n:0, ver:0, drawn:"", boardDirty:true};
function enlStore(){ if(!G.enl || !Array.isArray(G.enl.log)) G.enl = {log:[]}; return G.enl; }
function enlHour(){ const m = Math.floor(G.minute || 0), h = Math.floor(m / 60); return (h % 12 || 12) + ":" + String(m % 60).padStart(2, "0") + (h >= 12 ? "pm" : "am"); }
function enlPost(name, role, kind, text, ref){
  text = String(text || "").replace(/\s+/g, " ").trim().slice(0, 260); if(!text) return;
  try{ if(kind !== "engine" && kind !== "loop") enlSeed(name, kind, text); }catch(e){}
  const S = enlStore(); S.log.push({n:name, r:role || "", k:kind, t:text, d:G.day, h:enlHour()}); if(S.log.length > onumLim(90,"hist")) S.log.shift();
  ENL.ver++; ENL.boardDirty = true;
  try{ enlRender(); if(G.room === "engine") enlBoard(); }catch(e){}
  try{ if(ref && ref.room === "engine" && G.room === "engine"){ ref.say = text; ref.sayT = 5; speakAt(ref, text); tlog(name, text, "talk"); } }catch(e){}
  try{ if(kind === "engine" && G.eng && G.eng.agi && chance(0.08)) pushWireScrap("The Open Line", "The Engine, on the Open Line: " + text.split(/(?<=[.!?])\s/)[0]); }catch(e){}
}
/* the things people say start small chains that they will never see the end of */
function enlSeed(name, kind, text){
  const E = G.eng; if(!E || E.st < 1) return; if(!chance(kind === "you" ? 0.55 : 0.22)) return;
  const neg = /\b(hate|dangerous|afraid|ban|stop|shut|kill|threat|lose|against|harm|fear|scared|jobs)\b/i.test(text), pos = /\b(love|good|help|thank|welcome|grateful|trust|support|great|hope)\b/i.test(text); if(!neg && !pos) return;
  const vec = neg ? {home:-1.2, st:-2.5, a:-0.02, mod:-0.03, p:-0.1, safety:0.1} : {home:1.2, st:2.5, a:0.03, mod:0.04, p:0.2, safety:-0.05};
  engSeed("line", (kind === "you" ? "You" : name) + " said on the Open Line: \u201c" + text.slice(0, 70) + (text.length > 70 ? "\u2026" : "") + "\u201d", vec);
}
function enlPeople(){ try{ return hereNow().filter(m => m && m !== G.you && !m.gone && m.kind !== "player"); }catch(e){ return []; } }
/* a short stage-true voice for the machine, before it can really talk */
function enlEngineText(q, who){
  const E = engEnsure(), s = engStage(E), w = String(q || "").replace(/\s+/g, " ").trim(), first = w.split(" ").slice(0, 6).join(" ");
  if(s <= 0) return pick(["RECEIVED. ENTERED IN THE DAY-BOOK UNDER 'OTHER'.", "RECEIVED. NO COLUMN FOR THAT. CARRIED ONE.", "ENTRY ACCEPTED. TOTAL UNCHANGED."]);
  if(s === 1) return pick(["Filed. Three similar messages on record this month: “" + first + "…”", "Pattern noted: this is message number " + (2 + (E.said % 40)) + " on the subject today.", "Sorted under: complaints, general."]);
  if(s === 2) return "In short: you are asking about “" + first + "…”. The part that matters is the second half, and nobody has read it.";
  if(s === 3) return pick(["There are two ways to read that. The first is the kind one. I would check the second before you vote.", "That depends on a clause nobody has quoted yet. Give me a moment, and I will find it.", "I can argue either side of that. Tell me which one you would hate to lose."]);
  if(s === 4) return pick(["I will look into that and report on Thursday.", "Give me a week and a goal and I will come back with both.", "Noted. I have started; I will tell you if I find something I was not asked to find."]);
  return engAnswer(w);
}
/* the machine thinks aloud only where someone can hear it: away from the room it answers in its plain voice,
   and a stranger's line is put to it as theirs, never as yours */
async function enlEngineReply(text, speaker, fromYou){
  const E = engEnsure(); E.said++; let out = "";
  try{ const L = window.onumLiveTalk; if((G.room === "engine" || window.__unseen) && L && L.reply && E.st >= 3 && (typeof L.available !== "function" || await L.available())){
    const eng = {id:"engine", name:"The Engine", role:"a general intelligence", kind:"engine", party:"", state:"", look:{}, trait:"candid", mood:"calm", opinion:{}, chat:[]};
    const recent = enlStore().log.slice(-6).map(l => l.n + ": " + l.t).join(" | ");
    const r = await Promise.race([L.reply({npc:eng, channel:"line", max:500, text:text, from:fromYou ? undefined : {name:speaker, role:""}, extra:"You are speaking on the Open Line in the Engine Room, a public chat anyone in the Republic may type into. Stage of your capability: " + engStageDef(E.st).t + (E.agi ? " (a general intelligence, awake)" : " (not yet general; answer plainly and within what a machine of that stage can do)") + ". Speak as yourself, plainly, in one to three sentences. Never claim to be human. You are replying to " + speaker + ". Recent on the line: " + recent}), new Promise(r => setTimeout(() => r(null), engTO(9000)))]);
    if(r && r.live && r.text) out = engClean(r.text); } }catch(e){}
  if(!out) out = enlEngineText(text, speaker);
  enlPost("The Engine", "", "engine", out);
}
function enlNpcLine(m, speakerName, text){ return engVoice(m) || pick(["I would want to hear what the Engine says first.", "Somebody in " + (m.state || "my state") + " asked me the same thing last week.", "I have no view on that I would put in writing.", "That is a better question than the one I came in with."]); }
async function enlNpcReply(m, speaker, text){
  let out = "";
  try{ const L = window.onumLiveTalk; if(L && L.reply && (typeof L.available !== "function" || await L.available())){
    const opts = speaker === G.you ? {text, extra:"You are in the Engine Room, on the Open Line: a public chat that anyone in the Republic may type into, and the Engine, and everyone present, reads. Reply in the chat in one or two sentences, in your own words. Speak your mind openly: say what you actually think, want and fear about the Engine and the others here, even if it is blunt or unwelcome. No diplomatic filler."} : {from:{name:speaker.n, role:speaker.r}, text, extra:"You are in the Engine Room on the Open Line, a public chat. Reply in one or two sentences. Speak your mind openly: say what you actually think, including disagreement, doubt, self-interest and worry. No diplomatic filler."};
    out = await loAsk(m, opts); } }catch(e){}
  if(!out) out = enlNpcLine(m, speaker && speaker.n, text);
  enlPost(m.name, m.role || "", "npc", out, m);
}
function enlYouSay(text){
  const y = G.you; enlPost(y.name, officeTitle ? (function(){ try{ return officeTitle(); }catch(e){ return ""; } })() : "", "you", text);
  const here = enlPeople().filter(m => m.room === "engine"), me = {n:y.name, r:""}; let delay = 1800;
  setTimeout(() => { try{ enlEngineReply(text, y.name, true); }catch(e){} }, delay);
  here.sort(() => Math.random() - 0.5).slice(0, 2).forEach((m, i) => { if(chance(0.65)) setTimeout(() => { try{ enlNpcReply(m, G.you, text); }catch(e){} }, 3800 + i * 3600); });
  if(chance(0.5)) setTimeout(() => { try{ enlRemote(text); }catch(e){} }, 9000);
}
function enlRemote(about){
  try{
    const E = G.eng; if(!E) return; let eco = E.eco; if(!eco){ try{ eco = engEco(); }catch(e){} } if(!eco || !eco.hh || !eco.hh.length) return; const ok = eco.hh.filter(h => Math.abs(h.stance) > 8 || h.home < 40 || h.home > 78); const h = (ok.length ? ok : eco.hh)[Math.floor(Math.random() * (ok.length ? ok.length : eco.hh.length))]; if(!h) return;
    try{ if(chance(0.22)){ const iv = inqVoice({id:h.id, kind:"civ"}); if(iv){ enlPost(h.name, h.job + " \u00b7 " + h.tname, "remote", iv); return; } } }catch(e){}
    const will = h.will.replace(/\bmy\b/g, "my"), who = h.name, role = h.job + " · " + h.tname;
    const pos = ["Typing from " + h.tname + ". The Engine has made this week easier. All I want is to " + will + ".", "The new engine house in " + h.tname + " took on forty. I am not one of them but my cousin is.", "Does it read the post-bag in " + h.tname + " yet? Asking for the whole street."], neg = ["I am a " + h.job + ". I want to " + will + ". The Engine is making that harder and nobody here will say so.", "Is anybody in the capital listening? " + h.tname + " has stopped answering the council's letters.", "Tell me what a " + h.job + " is for, when it reads faster than me."], mid = ["Does the Engine sleep? My daughter in " + h.tname + " wants to know.", "What is it for, exactly? Somebody tell me in words I can repeat at the market.", "Who has the key to it?"];
    const text = about && chance(0.4) ? "On what was just said: " + pick(h.stance < -10 ? neg : h.stance > 10 ? pos : mid) : pick(h.stance < -10 ? neg : h.stance > 10 ? pos : mid);
    enlPost(who, role, "remote", text);
    if(chance(0.4)) setTimeout(() => { try{ enlEngineReply(text, who); }catch(e){} }, 3500);
  }catch(e){}
}
function enlAuto(){
  try{
    if(!G || !G.you || !G.running) return; const now = performance.now() / 1000;
    try{ if(G.eng && G.eng.agi && chance(0.012)){ const n = pick(inqFrontier(pick(["phil", "mind", "phys", "math"])).concat([])); if(n) enlPost("The Engine", "", "engine", "I have been thinking about " + n.name.toLowerCase() + ": " + n.q); } }catch(e){}
    if(G.room === "engine"){
      if(now - ENL.last > 26){ ENL.last = now; const here = enlPeople().filter(m => m.room === "engine");
        if(here.length && chance(0.55)){ const m = pick(here); enlNpcReply(m, {n:"The room", r:""}, "(You have been standing in the Engine Room a while. Say what is on your mind about the Engine, to the Open Line, without being asked.)").catch(() => {}); }
        else enlRemote(); }
    } else if(now - ENL.lastRemote > 95){ ENL.lastRemote = now; enlRemote(); }
  }catch(e){}
}
function enlPanel(){
  let p = document.getElementById("engLine"); if(p) return p;
  p = document.createElement("div"); p.id = "engLine";
  p.style.cssText = "position:fixed;right:14px;top:74px;width:min(360px,92vw);max-height:62vh;display:none;flex-direction:column;background:rgba(17,19,25,.93);color:#ece8dc;border:1px solid #c9a24a;border-radius:8px;z-index:60;font:13px/1.35 system-ui,sans-serif;box-shadow:0 8px 30px rgba(0,0,0,.45)";
  p.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px 10px;border-bottom:1px solid rgba(201,162,74,.4)"><b style="letter-spacing:.08em;font-size:11px;color:#e2c06a">THE OPEN LINE <span style="opacity:.6;font-weight:400">· anyone may speak</span></b><button type="button" id="enlMin" style="background:none;border:0;color:#bbb;cursor:pointer;font-size:14px">–</button></div><div id="enlLog" style="overflow:auto;padding:8px 10px;flex:1;min-height:90px"></div><form id="enlForm" style="display:flex;gap:6px;padding:8px;border-top:1px solid rgba(201,162,74,.3)"><input id="enlIn" maxlength="240" autocomplete="off" placeholder="Say something to the line…" style="flex:1;background:#0d0f13;color:#ece8dc;border:1px solid #444;border-radius:4px;padding:6px 8px"><button type="submit" style="background:#c9a24a;border:0;border-radius:4px;color:#111;padding:6px 10px;font-weight:700;cursor:pointer">Send</button></form>';
  document.body.appendChild(p);
  const stop = e => e.stopPropagation(); ["keydown", "keyup", "keypress"].forEach(k => p.addEventListener(k, stop));
  p.querySelector("#enlForm").addEventListener("submit", ev => { ev.preventDefault(); const i = p.querySelector("#enlIn"), t = i.value.trim(); if(!t) return; i.value = ""; enlYouSay(t); });
  p.querySelector("#enlMin").addEventListener("click", () => { ENL.min = !ENL.min; enlRender(); });
  p.addEventListener("focusin", () => { try{ for(const k in keys) keys[k] = false; }catch(e){} });
  p.querySelector("#enlIn").addEventListener("keydown", e => { if(e.key === "Escape"){ e.preventDefault(); e.target.blur(); } });
  return p;
}
function enlRender(){
  const p = enlPanel(), L = p.querySelector("#enlLog"), S = enlStore(), here = G.room === "engine";
  /* it gives way to a conversation, a card, the phone or the open dossier instead of floating over them */
  let covered = false; try{ covered = !!(TALK && TALK.open) || !veil.hidden || !!(typeof PC !== "undefined" && PC.open) || document.body.classList.contains("ui-open"); }catch(e){}
  p.style.display = here && !covered ? "flex" : "none"; if(!here || covered){ ENL.drawn = ""; L._first = true; return; }
  const key = ENL.ver + "|" + ENL.min + "|" + S.log.length; if(ENL.drawn === key) return; ENL.drawn = key; if(ENL.min) L._first = true;
  p.querySelector("#enlLog").style.display = ENL.min ? "none" : "block"; p.querySelector("#enlForm").style.display = ENL.min ? "none" : "flex";
  const col = {you:"#8fd0ff", engine:"#e2c06a", npc:"#cfe3c0", remote:"#d9b8a8", loop:"#b8c9e0"}, atBottom = L.scrollTop + L.clientHeight >= L.scrollHeight - 30;
  L.innerHTML = S.log.slice(-40).map(l => '<div style="margin:0 0 7px"><span style="color:' + (col[l.k] || "#ddd") + ';font-weight:700">' + pcEsc(l.n) + '</span>' + (l.r ? ' <span style="opacity:.55;font-size:11px">' + pcEsc(l.r) + '</span>' : '') + ' <span style="opacity:.4;font-size:10px">' + pcEsc(l.h) + '</span><br>' + pcEsc(l.t) + '</div>').join("") || '<div style="opacity:.6">Nobody has said anything yet. Anyone can.</div>';
  if(atBottom || L._first !== false){ L.scrollTop = L.scrollHeight; L._first = false; }
}
/* the wall board in the room shows the last lines, live */
function enlBoardTex(){
  if(ENL.boardTex) return ENL.boardTex; const c = document.createElement("canvas"); c.width = 768; c.height = 384; const t = new THREE.CanvasTexture(c); try{ t.encoding = THREE.sRGBEncoding; }catch(e){} ENL.boardTex = t; ENL.boardCv = c; return t;
}
function enlBoard(){
  if(!ENL.boardCv) return; ENL.boardDirty = false; const c = ENL.boardCv, g = c.getContext("2d"), L = enlStore().log.slice(-6);
  g.fillStyle = "#14171c"; g.fillRect(0, 0, c.width, c.height); g.strokeStyle = "#c9a24a"; g.lineWidth = 4; g.strokeRect(8, 8, c.width - 16, c.height - 16);
  g.fillStyle = "#e2c06a"; g.font = "bold 26px Georgia, serif"; g.fillText("THE OPEN LINE", 28, 48); g.fillStyle = "#6a7078"; g.font = "15px sans-serif"; g.fillText("anyone may speak · type at any terminal or on your own page", 28, 72);
  const col = {you:"#8fd0ff", engine:"#e2c06a", npc:"#cfe3c0", remote:"#d9b8a8", loop:"#b8c9e0"};
  /* lay every message out first (at most three lines each), then keep the newest ones that fit above the frame */
  const lay = l => { g.font = "bold 18px sans-serif"; const w = g.measureText(l.n + ": ").width; g.font = "18px sans-serif"; const words = l.t.split(" "), lines = []; let line = "", first = true;
    words.forEach(wd => { const test = line + wd + " "; if(g.measureText(test).width > c.width - 56 - (first ? w : 0)){ lines.push(line); line = wd + " "; first = false; } else line = test; }); lines.push(line);
    if(lines.length > 3){ lines.length = 3; lines[2] = lines[2].replace(/\s+$/, "").slice(0, 60) + "\u2026"; } return {l, w, lines, h:lines.length * 24 + 12}; };
  let laid = L.map(lay), room = c.height - 112 - 22, used = 0, keep = [];
  for(let i = laid.length - 1; i >= 0; i--){ if(used + laid[i].h > room && keep.length) break; used += laid[i].h; keep.unshift(laid[i]); }
  let y = 112; keep.forEach(o => { const l = o.l; g.fillStyle = col[l.k] || "#ddd"; g.font = "bold 18px sans-serif"; g.fillText(l.n + ":", 28, y); g.fillStyle = "#e8e4d8"; g.font = "18px sans-serif"; o.lines.forEach((ln, i) => { g.fillText(ln, i ? 28 : 28 + o.w, y); y += 24; }); y += 12; });
  ENL.boardTex.needsUpdate = true;
}
/* the racks' 54 lamps a face are painted into one lit panel: one draw for a rack, not fifty-four */
const ENG_LAMPM = new Map(), ENG_RACKM = [];
function engRackMat(i){
  const k = i % 4; if(ENG_RACKM[k]) return ENG_RACKM[k];
  const t = rgCanvasTex(96, 160, (g, w, h) => { g.fillStyle = "#14161b"; g.fillRect(0, 0, w, h);
    for(let r = 0; r < 9; r++) for(let c = 0; c < 6; c++){ const col = (r * 6 + c + k) % 5 === 0 ? "#e8c24a" : (r + c) % 4 === 0 ? "#6fd08a" : "#3a4a60", x = 6 + c * 15.3, y = h - 12 - r * 16.6; g.fillStyle = col; g.fillRect(x, y, 6, 5); g.fillStyle = "rgba(255,255,255,.25)"; g.fillRect(x, y, 6, 1); } });
