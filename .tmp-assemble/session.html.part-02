  ["cs2","cs","The stored-program computer","s",["cs1"],5,"Instructions as data: one machine that can be any machine.","Can a machine be told what to be?"],
  ["cs3","cs","Algorithms and complexity","s",["m7","cs2"],6,"What can be computed, how quickly, and what costs too much to ever try.","Which problems are truly hard?"],
  ["cs4","cs","Databases and large-scale computing","s",["cs2","i_trans"],5,"Records at the scale of a nation, searched in a breath.","Can everything known be kept and found?"],
  ["cs5","cs","Computer networks","s",["i_ic","m8","i_tele2"],6,"Machines talking to machines across the world.","Can every machine be one?"],
  ["cs6","cs","Machine learning","s",["cs3","m5","m6"],6,"Programs that improve from examples rather than rules.","Can a machine learn what nobody could write down?"],
  ["cs7","cs","Deep neural networks","s",["cs6","b12","i_ic"],7,"Layered networks trained on error: patterns found, not told.","How deep can learning go?"],
  ["cs8","cs","Large-scale learning systems","s",["cs7","cs5"],8,"Networks trained on a library, using a power station of compute: language, vision and planning in one model.","What happens when learning is given the world to read?"],
  ["cs9","cs","Autonomous agents and planning","s",["cs8","p11"],9,"Systems that set sub-goals, use tools, and check their own work over days.","Can a machine be given a purpose and trusted to keep it?"],
