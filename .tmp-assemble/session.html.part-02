function cabPaint(p, text, aside){ if(!p || !text) return; try{ const FD = window.NEPTUNE_FLOORDESK, D = document.getElementById("ndFd"); if(FD && typeof FD.line === "function" && D && !D.hidden){ const L0 = D.querySelector(".fd-log"), l0 = L0 && L0.lastElementChild, t0 = l0 && l0.querySelector(".t"); if(l0 && l0._pid === p.id && t0 && t0.textContent === String(text)) return; FD.line(p.id, String(text), !!aside); const L = D.querySelector(".fd-log"), d = L && L.lastElementChild; if(d){ d._done = true; d._pid = p.id; const t = d.querySelector(".t"); if(t) t.textContent = String(text); L.scrollTop = L.scrollHeight; } } }catch(e){} try{ vhSay(p, String(text)); }catch(e){} }
function cabFallback(p){ const role = String((p && p.role) || "my office"); return "Chair, from " + role + ": the department is working through today\u2019s papers. Nothing needs your decision this minute beyond what is on the order paper, and I will put the detail in writing. I need the chair\u2019s support on our next request."; }
