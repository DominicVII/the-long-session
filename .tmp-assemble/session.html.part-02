  const W = [cAcc(), cAcc(), cAcc(), cAcc()], roof = cAcc(), cor = cAcc(), M = cityMats();
  cBlock(W, roof, cor, x - 4.0, z - 3.6, 8.0, 3.55, 8.6, 1);
  const mk = (a, mat) => { const geo = cGeo(a); if(!geo) return; const m = new THREE.Mesh(geo, mat); m.matrixAutoUpdate = false; g.add(m); };
  W.forEach((a, i) => mk(a, M.walls[i])); mk(roof, M.roof); mk(cor, M.cornice);
  const stone = new THREE.MeshStandardMaterial({color:0xe2dccd, roughness:0.88}), shade = new THREE.MeshStandardMaterial({color:0xb9b09c, roughness:0.95}), gold = new THREE.MeshStandardMaterial({color:0xb8964a, roughness:0.4, metalness:0.7});
  [-1, 1].forEach(s => { const cx = x + s * 1.35; const col = new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.32, 3.9, 16), stone); col.position.set(cx, 0.45 + 1.95, z + 0.28); g.add(col); gateAdd(g, shade, cx, 0.45 + 0.09, z + 0.28, 0.8, 0.18, 0.8); gateAdd(g, stone, cx, 0.45 + 3.95, z + 0.28, 0.85, 0.2, 0.85); });
  gateAdd(g, stone, x, 4.78, z + 0.28, 3.6, 0.5, 0.95);
  const sh = new THREE.Shape(); sh.moveTo(-1.9, 0); sh.lineTo(1.9, 0); sh.lineTo(0, 0.85); sh.lineTo(-1.9, 0); const ped = new THREE.Mesh(new THREE.ExtrudeGeometry(sh, {depth:0.9, bevelEnabled:false}), stone); ped.position.set(x, 5.03, z - 0.17); g.add(ped);
  for(let i = 0; i < 3; i++) gateAdd(g, shade, x, 0.06 + i * 0.12, z + 1.0 - i * 0.1, 4.2 - i * 0.3, 0.12, 0.7);          /* steps */
  const plate = new THREE.Mesh(new THREE.PlaneGeometry(3.2, 0.8), new THREE.MeshStandardMaterial({map:gatePlate("THE STATE HOUSE", "Open hours"), roughness:0.5})); plate.position.set(x, 4.78, z + 0.77); g.add(plate);
  /* flag on a staff, and brass lanterns either side of the door */
  const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 4.2, 6), gold); pole.position.set(x + 2.6, 2.2 + 3.4, z + 0.5); g.add(pole);
  const flag = new THREE.Mesh(new THREE.PlaneGeometry(1.3, 0.8), new THREE.MeshStandardMaterial({color:0xb5432f, side:THREE.DoubleSide, roughness:0.8})); flag.position.set(x + 3.25, 7.3, z + 0.5); g.add(flag);
  const lm = new THREE.MeshStandardMaterial({color:0xfff2d4, emissive:0xffd9a0, emissiveIntensity:0.5, roughness:0.4}); [-1, 1].forEach(s => { gateAdd(g, lm, x + s * 0.95, 2.6, z + 0.14, 0.18, 0.3, 0.18); }); g.userData.lanterns = (g.userData.lanterns || []).concat([lm]);
}
function gateHide(x0, x1, z0, z1){
  try{ roomGroup.children.forEach(o => { if(o.userData.vDoorHid || !o.position) return; const p = o.position, sc = o.scale; if(p.x >= x0 && p.x <= x1 && p.z >= z0 && p.z <= z1 && p.y > 0.4 && p.y < 3.4 && (!sc || sc.x < 2.3)){ o.visible = false; o.userData.vDoorHid = 1; } }); }catch(e){}
}
function gateAttach(id){
  gateClear(); const R = ROOMS[id]; if(!R || !R.open) return;
  /* a gate is built once per room (and again only if the District's shopfronts change), then hung, not rebuilt */
  let key = id; try{ if(id === "district") key += "|" + (SF.signs || []).map(sg => sg.title + "/" + sg.sub + "/" + (sg.poi && sg.poi.door ? sg.poi.door.z : "")).join(";"); }catch(e){}
  GATE.cache = GATE.cache || {}; const hit = GATE.cache[id];
  if(hit && hit.key === key){ scene.add(hit.g); GATE.grp = hit.g; GATE.room = id; return; }
  const g = new THREE.Group(); g.name = "VISTA-GATES";
  if(id === "district"){ const d = R.d; gateArch(g, 0, d - 0.55, -1, 4.2, 7.6, 3.2, "THE EAST STEPS", "The Capitol"); gateStateHouse(g, 4.096, 0); }
  else if(id === "steps"){ gateArch(g, 0, 0.3, 1, 3.8, 9.7, 1.6, "THE DISTRICT", "Home"); }
  if(id === "district") try{ (SF.signs || []).forEach(sg => { const p = sg.poi, side = Math.sign(p.pos.x) || 1, pl = new THREE.Mesh(new THREE.PlaneGeometry(2.4, 0.78), new THREE.MeshStandardMaterial({map:gatePlate(sg.title, sg.sub), roughness:0.5, side:THREE.DoubleSide})); pl.position.set(side * 6.9, 3.3, p.door.z); pl.rotation.y = side > 0 ? -Math.PI / 2 : Math.PI / 2; g.add(pl); gateAdd(g, new THREE.MeshStandardMaterial({color:0x2a2f33, roughness:0.6, metalness:0.5}), side * 7.1, 3.78, p.door.z, 0.06, 0.06, 2.5); }); }catch(e){}
  scene.add(g); GATE.grp = g; GATE.room = id; GATE.cache[id] = {key, g};
}
function gateHideRoom(id){ const R = ROOMS[id]; if(!R || !R.open) return; if(id === "district") gateHide(-1.3, 1.3, R.d - 0.6, R.d + 1); else if(id === "steps") gateHide(-1.1, 1.1, -0.3, 0.3); }
function gateClear(){ if(GATE.grp){ if(GATE.grp.parent) GATE.grp.parent.remove(GATE.grp); GATE.grp = null; GATE.room = null; } }
function gateNight(n){ try{ if(GATE.grp && GATE.grp.userData.lanterns) GATE.grp.userData.lanterns.forEach(m => { m.emissiveIntensity = 0.5 + n * 1.6; }); }catch(e){} }

/* nobody stands in a wall: new arrivals are moved out of anything solid, and anyone found inside one is stepped clear */
const VW = {room:null, at:-1, boxes:[]};
function wallScan(){
  const out = [], bb = new THREE.Box3(), R = ROOMS[G.room] || {w:10, d:10};
  const visit = root => { if(!root) return; root.updateMatrixWorld(true); root.traverse(o => { if(!o.isMesh || !o.visible) return; let p = o.parent, nd = false; while(p){ if(p.name === "NEPTUNE-DISTRICT"){ nd = true; break; } p = p.parent; } if(nd) return;
    bb.setFromObject(o); if(!isFinite(bb.min.x)) return; const w = bb.max.x - bb.min.x, d = bb.max.z - bb.min.z, h = bb.max.y - bb.min.y;
    if(Math.max(w, d) <= 3.4 || h < 1.2 || bb.min.y > 0.7 || bb.max.y < 1.4) return; if(w > R.w * 0.75 && d > R.d * 0.6) return; if(w > R.w * 0.9 || d > R.d * 0.9) return;
    out.push({x0:bb.min.x, x1:bb.max.x, z0:bb.min.z, z1:bb.max.z}); }); };
  visit(roomGroup); visit(GATE.grp);
  VW.boxes = out.slice(0, 300); VW.room = G.room; VW.at = PHYS.at;
}
function wallInside(m){
  const x = m.x, z = m.z;
  try{ if(m.room === G.room){ if(VW.room !== G.room || VW.at !== PHYS.at) wallScan(); for(const b of VW.boxes){ if(x > b.x0 - 0.1 && x < b.x1 + 0.1 && z > b.z0 - 0.1 && z < b.z1 + 0.1) return b; } } }catch(e){}
  try{ if(PHYS.room === G.room && m.room === G.room) for(const b of PHYS.boxes){ if(x > b.x0 - 0.12 && x < b.x1 + 0.12 && z > b.z0 - 0.12 && z < b.z1 + 0.12 && (b.y1 === undefined || b.y1 > 0.5)) return {x0:b.x0, x1:b.x1, z0:b.z0, z1:b.z1}; } }catch(e){}
  /* 20261030q: bookcases are a body's width deep, not a box's edge. A person standing within a shoulder of a shelf (Exec Wing right wall,
     caucus, offices) is inside it, whatever the scanned box says. */
  try{ if(m.room === G.room && typeof SHELF_SPANS !== "undefined" && SHELF_SPANS.length){ const rb = roomBox(m.room);
      for(const s of SHELF_SPANS){ const side = Math.abs(Math.abs(s.x) - rb.hw) < 1.0, dep = 0.55, len = s.half + 0.3;
        const b = side ? {x0:s.x - dep, x1:s.x + dep, z0:s.z - len, z1:s.z + len} : {x0:s.x - len, x1:s.x + len, z0:s.z - dep, z1:s.z + dep};
        if(x > b.x0 && x < b.x1 && z > b.z0 && z < b.z1) return b; } } }catch(e){}
  try{ if(typeof NM !== "undefined" && NM.solids && (m.room === "district" || m.room === "steps")) for(const s of NM.solids){ if(Math.abs(x - s.x) < s.hx + 0.2 && Math.abs(z - s.z) < s.hz + 0.2) return {x0:s.x - s.hx, x1:s.x + s.hx, z0:s.z - s.hz, z1:s.z + s.hz}; } }catch(e){}
  return null;
}
function wallFix(m){
  if(!m || m.sitting || m.gone || m.ohSeat || !ROOMS[m.room] || m.kind === "player") return;
  for(let k = 0; k < 4; k++){ const r = wallInside(m); if(!r) return;
    const L = m.x - r.x0, Rr = r.x1 - m.x, F = m.z - r.z0, B = r.z1 - m.z, mn = Math.min(L, Rr, F, B), out = 0.42;
    if(mn === L) m.x = r.x0 - out; else if(mn === Rr) m.x = r.x1 + out; else if(mn === F) m.z = r.z0 - out; else m.z = r.z1 + out; }
  try{ const rb = roomBox(m.room); m.x = clamp(m.x, -rb.hw, rb.hw); m.z = clamp(m.z, rb.d0 + 0.05, rb.d1); }catch(e){}
  m.tx = m.x; m.tz = m.z;
}
{ const _pir = placeInRoom; placeInRoom = function(m){ _pir.apply(this, arguments); try{ wallFix(m); }catch(e){} }; }
let _wfT = 0;
function wallWatch(){ if(!G || !G.running || G.t - _wfT < 1.2) return; _wfT = G.t; try{ hereNow().forEach(m => { if(m && m !== G.you && !(TALK.open && TALK.m === m)) wallFix(m); }); }catch(e){} }

/* strangers talking to each other, once the model is there to do it: each answers what the other actually said */
const LO = {busy:false, last:-999};
function loRoom(){ try{ return (ROOMS[G.room] || {}).t || "the room"; }catch(e){ return "the room"; } }
function loAsk(who, opts){
  const LT = window.onumLiveTalk; if(!LT || typeof LT.reply !== "function") return Promise.resolve(null);
  return Promise.race([Promise.resolve(LT.reply(Object.assign({npcId:who.id, channel:"face"}, opts))).then(r => (r && r.live && r.text) ? (liveClean(r.text) || null) : null), new Promise(r => setTimeout(() => r(null), 9000))]).catch(() => null);
}
async function loChain(a, b, seed){
  const hint = String(seed || "").slice(0, 160), room = loRoom(), pa = {name:a.name, role:a.role}, pb = {name:b.name, role:b.role};
  const stage = "You are in " + room + " with " + b.name + (b.role ? ", " + b.role : "") + ". They have not spoken to you; you turn to them. " + (hint ? "On your mind: " + hint + " " : "") + "Say what you actually think, in your own words, one or two sentences.";
  const t1 = await loAsk(a, {to:pb, stage, text:stage});
  if(!t1) return null;
  const t2 = await loAsk(b, {from:pa, text:t1});
  if(!t2) return [t1];
  const t3 = Math.random() < 0.6 ? await loAsk(a, {from:pb, text:t2}) : null;
  return t3 ? [t1, t2, t3] : [t1, t2];
}
function loPlay(a, b, lines){
  const h = {a:a.id, b:b.id, lines:[], t:G.t}; try{ a._huddle = b._huddle = h; }catch(e){}
  lines.forEach((t, i) => setTimeout(() => { const who = i % 2 ? b : a, to = i % 2 ? a : b; if(!who || who.gone || who.room !== G.room && false) return;
    try{ h.lines.push([who.name, t]); h.t = G.t; }catch(e){} who.say = t; who.sayT = 4.8; who.sayTo = to.id; who.faceId = to.id; who.faceUntil = G.t + 5; try{ speakAt(who, t); }catch(e){}
    try{ if(a.room === G.room) tlog(who.name, t, "talk"); }catch(e){} }, i * 3300));
}
{ const _ov = overhear; overhear = function(a, b, la, lb){
    try{ const LT = window.onumLiveTalk;
      if(LT && typeof LT.reply === "function" && a && b && a !== G.you && b !== G.you && a.traits && b.traits && !LO.busy && G.t - LO.last > 18){
        LO.busy = true; LO.last = G.t;
        Promise.resolve(typeof LT.available === "function" ? LT.available() : true).then(ok => ok ? loChain(a, b, la) : null).then(lines => { LO.busy = false; if(lines && lines.length) loPlay(a, b, lines); else _ov.call(null, a, b, la, lb); }).catch(() => { LO.busy = false; try{ _ov.call(null, a, b, la, lb); }catch(e){} });
        return; } }catch(e){ LO.busy = false; }
    return _ov.apply(this, arguments); }; }
/* ══ 20261016j · the new storefronts are the storefronts: the diner, market, hardware, newsstand, church and the campaign office stand behind the real shopfronts, spread down the high street, and every other shop sells what its sign says ══ */
function richTownNow(){ try{ const N = window.NEPTUNE_DISTRICT; return !!(N && N.on && G.gfx !== "simple" && nmTier() > 0); }catch(e){ return false; } }
const SF = {done:"", signs:[]};
const SF_KIND = {"VAUGHN'S DINER":"diner", "CAFE ZEVEN":"diner", "BAKKERIJ TAYLOR":"market", "FLORIST":"market", "TAILOR & CUTTER":"market", "HABERDASHERY":"market", "WATCHMAKER":"market", "BOOKSELLER":"newsstand", "THE NO7 LEDGER":"newsstand", "TOBACCONIST":"newsstand", "VAN DIJK & ZONEN":"hardware"};
const SF_SUB = {diner:"Coffee, and everybody who votes", market:"Bread, cloth and the better end of the district", newsstand:"Papers, and books nobody asked for", hardware:"Hinges, nails and neighbours"};
function sfTitle(n){ return String(n).toLowerCase().replace(/(^|[\s'&-])([a-z])/g, (m, a, b) => a + b.toUpperCase()).replace(/\bNo7\b/i, "No7"); }
/* a prop you cannot reach is a prop that is not there: every interactive point must stand on open ground */
function sfFree(p){
  try{ const S = (typeof NM !== "undefined" && NM.solids) || []; for(let i = 0; i < S.length; i++){ const q = S[i]; if(Math.abs(p.x - q.x) < q.hx + 0.45 && Math.abs(p.z - q.z) < q.hz + 0.45) return false; } return true; }catch(e){ return true; }
}
function sfNearestFree(x, z){
  const ring = [[0, 0], [-1.2, 0], [1.2, 0], [0, 1.2], [0, -1.2], [-2.4, 0], [2.4, 0], [0, 2.4], [0, -2.4], [-1.5, 1.5], [1.5, 1.5], [-1.5, -1.5], [1.5, -1.5], [-3.6, 0], [3.6, 0], [0, 3.6], [0, -3.6]];
  for(const o of ring){ const c = {x:x + o[0], z:z + o[1]}; if(sfFree(c)) return c; } return null;
}
function sfApply(){
  try{
    const P = (window.ONUM_TOWN_POIS || []).filter(Boolean); if(!P.length || !PROPS.district) return;
    const key = P.length + ":" + (P[0] && P[0].id); if(SF.done === key) return;
    const main = P.filter(p => p.kind === "shop" && Math.abs(p.pos.x) < 12 && p.pos.z > -3 && p.pos.z < 52 && !/^(Hardware|Market)$/.test(p.name));
    const one = (name, side) => main.filter(p => p.name === name && (!side || Math.sign(p.pos.x) === side)).sort((a, b) => a.pos.z - b.pos.z)[0];
    const D = PROPS.district, byId = id => D.find(p => p.id === id), spot = p => { const st = (p.stand && p.stand[0]) || p.door || p.pos; return {x:st.x, z:st.z}; };
    const take = {}, used = new Set();
    const put = (pid, poi, label, sub) => { const pr = byId(pid); if(!pr || !poi) return false; const sp = spot(poi); pr.x = sp.x; pr.z = sp.z; if(label) pr.label = label; if(sub) pr.sub = sub; pr.r = Math.max(pr.r || 2, 2.4); used.add(poi.id); take[pid] = poi; return true; };
    put("diner", one("VAUGHN'S DINER", -1), "The counter at Vaughn's", "Coffee, and everybody who votes");
    put("market", one("BAKKERIJ TAYLOR", 1), "Bakkerij Taylor", "Bread, flowers, cloth and the better end of the district");
    put("hardware", one("VAN DIJK & ZONEN", 1), "Van Dijk & Zonen", "Hinges, nails and neighbours");
    { const hqNames = ["HABERDASHERY", "TAILOR & CUTTER", "WATCHMAKER", "TOBACCONIST", "BOOKSELLER", "ORANJE APOTHEEK", "DE GOUDEN KROON"]; let hp = null;
      for(const nm of hqNames){ hp = one(nm, 1) || one(nm, -1); if(hp && sfFree(spot(hp))) break; hp = null; }
      if(!hp){ hp = main.filter(p => !/^(VAUGHN|CAFE|BAKKERIJ|VAN DIJK|CONSULAR POST|THE NO7)/.test(p.name) && sfFree(spot(p))).sort((a, b) => Math.hypot(a.pos.x, a.pos.z - 14) - Math.hypot(b.pos.x, b.pos.z - 14))[0] || null; }
      if(hp){ put("hq", hp, "Campaign office", "Above the " + sfTitle(hp.name).toLowerCase() + ": folding tables, a phone bank, a whiteboard"); } }
    { const hqSide = take.hq ? Math.sign(take.hq.pos.x) : 1, dn = ["BOOKSELLER", "TOBACCONIST", "WATCHMAKER", "TAILOR & CUTTER", "HABERDASHERY", "ORANJE APOTHEEK", "DE GOUDEN KROON"]; let dp = null;
      for(const nm of dn){ dp = main.filter(p => p.name === nm && !used.has(p.id) && sfFree(spot(p))).sort((a, b) => (Math.sign(b.pos.x) === -hqSide ? 1 : 0) - (Math.sign(a.pos.x) === -hqSide ? 1 : 0) || a.pos.z - b.pos.z)[0] || null; if(dp) break; }
      if(!dp) dp = main.filter(p => !used.has(p.id) && !/^(VAUGHN|CAFE|BAKKERIJ|VAN DIJK|CONSULAR POST|THE NO7)/.test(p.name) && sfFree(spot(p)))[0] || null;
      if(dp) put("doffice", dp, "Your district office", "Constituents come in here, and the war chest is spent from the desk"); }
    const sqNews = P.find(p => p.kind === "newsstand" && /Square/i.test(p.name)); if(sqNews){ const pr = byId("newsstand"); if(pr){ const sp = spot(sqNews); pr.x = sp.x; pr.z = sp.z; pr.label = "The square newsstand"; take.newsstand = sqNews; } }
    const ch = P.find(p => p.kind === "church" && /Willibrord/i.test(p.name)); if(ch){ const pr = byId("church"); if(pr){ const sp = ch.stand && ch.stand[2] ? ch.stand[2] : spot(ch); pr.x = sp.x; pr.z = sp.z; pr.label = "St. Willibrord's"; pr.r = 2.6; take.church = ch; } }
    const legacy = {diner:"diner_1", church:"church_2", newsstand:"newsstand_2", hardware:"shop_25", market:"shop_26"};
    Object.keys(legacy).forEach(k => { const lp = P.find(p => p.id === legacy[k]), to = take[k]; if(lp && to){ lp.pos = Object.assign({}, to.pos); lp.door = Object.assign({}, to.door); lp.stand = (to.stand || []).map(s => Object.assign({}, s)); } });
    try{ D.forEach(pr => { if(pr && typeof pr.x === "number" && !sfFree({x:pr.x, z:pr.z})){ const f = sfNearestFree(pr.x, pr.z); if(f){ pr.x = f.x; pr.z = f.z; } } }); }catch(e){}
    SF.signs = [];
    main.forEach(p => { const kind = SF_KIND[p.name]; if(!kind || used.has(p.id)) return; const id = "sf:" + p.id; if(byId(id)) return; const sp = spot(p);
      D.push({id, label:sfTitle(p.name), sub:SF_SUB[kind], x:sp.x, z:sp.z, r:2.2, acts:() => purseShopActs(kind)}); });
    if(take.hq) SF.signs.push({poi:take.hq, title:"CAMPAIGN OFFICE", sub:"Open to anyone who will knock on a door"});
    if(take.doffice) SF.signs.push({poi:take.doffice, title:"DISTRICT OFFICE", sub:"Constituent hours, and the war chest"});
    if(take.diner) SF.signs.push({poi:take.diner, title:"THE COUNTER", sub:"Coffee and grievances"});
    SF.done = key; try{ if(G.room === "district") gateAttach("district"); }catch(e){}
  }catch(e){ try{ console.warn("storefronts", e); }catch(x){} }
}
window.addEventListener("onum-town-ready", () => { setTimeout(sfApply, 30); });
window.addEventListener("onum-town-pois-updated", () => { SF.done = ""; setTimeout(sfApply, 30); });
setInterval(() => { try{ if(G && G.running && G.room === "district" && window.ONUM_TOWN_READY) sfApply(); }catch(e){} }, 3000);
/* ══ 20261016j · statues that read as statues ══ */
/* one figure, described once as primitives with the feet at y 0 and the face toward +z; the town draws it merged, the corridor draws it as meshes */
function statueOps(kind){
  const bronze = {B:0x6b5a3a, L:0x8e7a4c, D:0x453b27, V:0x4f7a62, G:0xcaa24a}, marble = {B:0xe6e1d6, L:0xf2eee4, D:0xc9c2b2, V:0xb9c4bc, G:0xd9c68a};
  const C = kind === "founder" || kind === "scholar" ? marble : bronze, o = [];
  const cyl = (x, y, z, r, h, top, hex, seg) => o.push(["cyl", x, y, z, r, h, top, hex, seg || 12]), box = (x, y, z, w, h, d, hex, ry, rx, rz) => o.push(["box", x, y, z, w, h, d, hex, ry || 0, rx || 0, rz || 0]), ico = (x, y, z, sx, sy, sz, hex) => o.push(["ico", x, y, z, sx, sy, sz, hex]), along = (a, b, r, hex) => o.push(["along", a[0], a[1], a[2], b[0], b[1], b[2], r, hex]);
  const head = (y, hair) => { ico(0, y, 0.02, 0.125, 0.155, 0.135, C.L); ico(0, y + 0.08, -0.025, 0.135, 0.1, 0.145, hair || C.D); box(0, y + 0.03, 0.105, 0.18, 0.024, 0.04, C.D); ico(0, y - 0.03, 0.14, 0.026, 0.055, 0.04, C.L); ico(0, y - 0.1, 0.1, 0.05, 0.04, 0.05, C.L); ico(-0.126, y - 0.01, 0, 0.026, 0.04, 0.026, C.L); ico(0.126, y - 0.01, 0, 0.026, 0.04, 0.026, C.L); box(-0.05, y + 0.0, 0.12, 0.04, 0.012, 0.02, C.D); box(0.05, y + 0.0, 0.12, 0.04, 0.012, 0.02, C.D); };
  if(kind === "consul" || kind === "orator"){
    /* a frock coat to the knee, high collar, sash and epaulettes; the right arm raised with a scroll, the hat under the left */
    box(-0.12, 0.05, 0.07, 0.17, 0.1, 0.32, C.D); box(0.12, 0.05, 0.01, 0.17, 0.1, 0.3, C.D);
