    let p = 1 - mv.risk + (S.prep ? 0.15 : 0) + ((y.standing || 50) - 50) / 250 - S.rush * 0.08;
    if(mv.k === "whisper" && (y.funds || 0) < 2) p -= 0.5;
    if(mv.k === "question" && t) p -= (t.conv - 50) / 200;
    if(mv.k === "rule"){ const tl = S.x.tally(); p = tl.yes > tl.no ? 0.85 + (S.prep ? 0.1 : 0) : tl.yes === tl.no ? 0.5 : 0.15; }
    const ok = mv.risk === 0 || Math.random() < p;
    const you = text => said.push({p:null, who:"You", text, to:t ? t.id : null, tag:"position", gloss:"Your own words, now on the record."});
    const allies = q => C.filter(o => o !== q && o.allies.includes(q.id)), rival = q => q && q.rival != null ? S.x.cast[q.rival] : null;
    switch(mv.k){
      case "limits": you("Three minutes each. The chair will hold you to it."); C.forEach(o => { if(o.temper > 60) shift(S, o, -4, "bristled at the time limit"); }); S.x.brisk = 1; break;
      case "openfloor": you("Everyone will be heard. Take the time you need."); C.forEach(o => shift(S, o, 3, "glad to be heard")); break;
      case "silent": you("(You say nothing and watch the room.)"); if(S.x.aide){ aideSpeak(S, 1).forEach(l => said.push(l)); } else { const lean = S.x.tally(); C.forEach(o => shift(S, o, (lean.yes >= lean.no ? 2 : -3), "the room argued on without you")); } break;
      case "aide": you("(You nod to " + S.x.aide.sn + ".)"); aideSpeak(S, 2).forEach(l => said.push(l)); break;
      case "question": if(t.case){
          const asked = t.asked || (t.asked = []), keys = ["cost", "when", "why", "tried", "who", "stake"], key = keys.find(k => asked.indexOf(k) < 0) || "cost";
          asked.push(key);
          const QT = {cost:"What does it come to, exactly, and who gave you that figure?", when:"When did this start, and has anything changed since?", why:"Why did this happen, and who is responsible?",
            tried:"What have you already tried, and what did they tell you?", who:"Who is affected if it is not done?", stake:"What happens if the state does nothing?"};
          you(t.sn + ", " + QT[key].charAt(0).toLowerCase() + QT[key].slice(1));
          said.push(L(t, t.case.qa[key], "you", "position", t.sn + " gives you the facts of their case. " + (key === "cost" ? "The figure is " + t.case.costText + "." : "")));
          shift(S, t, ok ? 8 : 3, "you asked about their case and listened"); C.filter(o => o !== t && side(o) === 0).forEach(o => shift(S, o, 3, "watched you ask for the facts"));
          break; }
        you(one(["A plain question for " + t.sn + ": who pays, and when?", t.sn + ", have you read section four, or only the summary?", "Will " + t.sn + " tell this room what " + t.state + " gets out of it?"]));
        if(ok){ shift(S, t, 10, "had no answer to your question"); C.filter(o => side(o) === 0).forEach(o => shift(S, o, 6, "watched " + t.sn + " fail to answer")); said.push(L(t, one(["I — the figures are being revised.", "That is a fair question. I will come back with it.", "...I take the point."]), "you", "position", t.sn + " has no good answer. The undecideds noticed."));}
        else { shift(S, t, -5, "answered you well"); allies(t).forEach(o => shift(S, o, -4, "cheered " + t.sn + "'s answer")); said.push(L(t, one(["Page twelve. Read it.", "I have, and I will read it to you slowly if you like.", "A question the member could have answered with a phone call."]), "you", "oppose", t.sn + " turned the question round on you. It cost you."));}
        break;
      case "object": you("Objection. " + one(["That is not in the record.", "The member is misstating the bill.", "That figure is wrong and " + t.sn + " knows it."]));
        if(ok){ C.filter(o => side(o) === 0).forEach(o => shift(S, o, 7, "your objection landed")); shift(S, t, -2, "dug in after your objection"); said.push(chairLine(S, "The objection is sustained.", "You won the point: the chair agrees, and the undecideds moved."));}
        else { shift(S, t, -4, "dug in"); C.filter(o => side(o) === 0).forEach(o => shift(S, o, -3, "thought your objection was thin")); said.push(chairLine(S, "Overruled. The member may continue.", "You lost the point on procedure."));
          if(t.temper > 55) said.push(L(t, "As I was saying, before I was so rudely interrupted —", "you", "threat", t.sn + " is enjoying this."));}
        break;
      case "side": you("I'm with " + t.sn + " on this. " + one(["Every word.", "Put me down.", "They said it better than I could."]));
        shift(S, t, 10 + t.vanity / 10, "you sided with them publicly"); allies(t).forEach(o => shift(S, o, 5, "their ally " + t.sn + " has you now")); { const r = rival(t); if(r) shift(S, r, -8, "you sided with their rival " + t.sn); }
        said.push(L(t, one(["Thank you. I won't forget that.", "Hear, hear. Thank you.", "There. The chair agrees with me."]), "you", "support", t.sn + " is pleased (vanity " + Math.round(t.vanity) + "): flattery works best on the vain."));
        { const r = rival(t); if(r) said.push(react(S, r, t)); }
        break;
      case "amend": if(/vote|ruling/.test(S.D.steps[S.i])){ S.x.final = "rulecomp"; S.x.finalOk = true; }
        you("Then let me offer a way through: " + S.x.M.comp + ".");
        if(ok){ S.x.amended = true; C.forEach(o => shift(S, o, o.stance < 50 ? 14 : o.stance > 80 ? -5 : 6, "the compromise met them halfway")); const m2 = t || C[0]; said.push(L(m2, one(["I can live with that.", "Now that is a version everyone can live with.", "Put my name on the amendment."]), "you", "deal", "The compromise lands: the middle comes over and the hard edges soften."));}
        else { if(S.x.final === "rulecomp") S.x.final = "room"; C.forEach(o => shift(S, o, o.stance > 70 ? -7 : -2, "thought you blinked")); const h = C.slice().sort((a, b) => b.stance - a.stance)[0]; said.push(L(h, "We didn't come here to split the difference.", "you", "oppose", "Your own side thinks you gave ground too early."));}
        break;
      case "cut": you(t.sn + ", your time has expired. The chair recognises the next speaker.");
        t.cut++; shift(S, t, -12, "you cut them off"); allies(t).forEach(o => shift(S, o, -6, "you cut off their ally " + t.sn)); if(ok) C.filter(o => side(o) === 0 && o !== t).forEach(o => shift(S, o, 4, "liked a firm chair"));
        said.push(L(t, t.temper > 55 ? "You can gavel me down. You can't gavel down " + t.state + "." : "...Very well. The record will show I was not allowed to finish.", "you", "threat", t.sn + " was cut off and holds it against you." + (t.temper > 55 ? " High temper: expect it again." : "")));
        S.x.silenced = t.id; break;
      case "settle": if(t.case){ you(t.sn + ", if I cannot do all of it, what is the part you could not do without?");
          said.push(L(t, t.case.qa.settle + " That is what I could go home with.", "you", "deal", t.sn + " names the part of their ask they cannot do without. " + (ok ? "It is a real offer: you can build a compromise on it." : "")));
          t.settleKnown = true; shift(S, t, 6, "told you what they would settle for"); }
        break;
      case "whisper": if(t.case) you("(low, to " + t.sn + ") " + one3(["If I can get you " + t.case.settleShort + ", will you back me?", "I cannot promise all of it. I can promise " + t.case.settleShort + ", in writing."])); else you("(low, to " + t.sn + ") " + one(["Back me on this and " + t.want + " is yours.", "I can get you " + t.want + ". Not today, but in writing.", "Name it. Within reason."]));
        t.dealt = true;
        if(ok){ shift(S, t, 28, "took your deal (" + t.want + ")"); if(t.m){ try{ t.m.pledge = 1; t.m.pledgeDay = G.day; }catch(e){} } said.push(L(t, "(low) Done. Don't make me regret it.", "you", "deal", t.sn + " is with you now. They will expect " + t.want + "."));}
        else { shift(S, t, -6, "turned your deal down"); C.filter(o => o !== t).forEach(o => shift(S, o, -4, "heard about the whisper")); said.push(L(t, "(out loud) I think the room should know what I was just offered.", null, "threat", t.sn + " exposed the deal. Everyone heard."));}
        break;
      case "yield": you("I yield my time to " + t.sn + ".");
        shift(S, t, 6, "you gave them the floor"); C.filter(o => o !== t).forEach(o => shift(S, o, side(t) > 0 ? 4 : -2, t.sn + " argued your case"));
        said.push(argue(S, t, S.x.M)); if(S.x.aide) aideSpeak(S, 1).forEach(l => said.push(l)); break;
      case "rule": case "rulecomp": case "room": S.x.final = mv.k; you(mv.k === "rule" ? (S.D.kind === "vote" ? "Call the roll." : "Then I rule for " + S.x.M.q + ".") : mv.k === "rulecomp" ? "On the compromise, then: " + S.x.M.comp + "." : "The room has spoken. I'll go with it."); S.x.finalOk = ok; break;
    }
    if(S.x.aide && mv.k !== "aide" && mv.k !== "silent" && mv.k !== "yield" && Math.random() < 0.3 && S.D.steps[S.i] !== "gavel") aideSpeak(S, 1).forEach(l => said.push(l));
    const r = sitApply(ok ? STAT[mv.k][0] : STAT[mv.k][1]);
    S.score += ok ? SCORE[mv.k] : -1;
    S.tally.push({step:S.D.steps[S.i], pick:mv.t, ok, r, k:mv.k, who:t ? t.sn : null});
    return {said, ok, r};
  }

  /* ── 3D: speakers turn toward whom they address, bubble and a little gesture ── */
  const face = function(S, line){
    try{
      S.x.cast.forEach(p => { if(p.m){ p.m.sayT = 0; } });
      const p = line.p; if(!p || !p.m) return;
      const m = p.m, tgt = line.to === "you" || line.to == null ? null : S.x.cast[line.to];
      try{ speakAt(m, line.text); }catch(e){}
      m.say = line.text.slice(0, 140); m.sayT = beatMs() / 1000 + 0.6; m.sayTo = tgt && tgt.m ? tgt.m.id : "you"; m.faceUntil = (G.t || 0) + 4; m._sxTalk = performance.now();
      if(tgt && tgt.m){ tgt.m._sxLook = m.id; tgt.m.faceUntil = (G.t || 0) + 4; }
      if(m.room === G.room){ const tx = tgt && tgt.m ? tgt.m.x : (typeof cam !== "undefined" && cam ? cam.x : m.x), tz = tgt && tgt.m ? tgt.m.z : (typeof cam !== "undefined" && cam ? cam.z : m.z + 1); m._sxYaw = Math.atan2(tx - m.x, tz - m.z); }
    }catch(e){}
  }
  const anim = function(){
    const S = SIT.on; if(!S || !S.x){ SX.raf = 0; return; }
    try{ const t = performance.now();
      S.x.cast.forEach(p => { const m = p.m; if(!m || !m.mesh || m.room !== G.room) return;
        if(m._sxBrought){ m.mesh.position.x = m.x; m.mesh.position.z = m.z; m.mesh.visible = true; }
        if(m._sxYaw != null){ let d = m._sxYaw - m.mesh.rotation.y; d = Math.atan2(Math.sin(d), Math.cos(d)); m.mesh.rotation.y += d * 0.15; m.facing = m.mesh.rotation.y; }
        const talking = m._sxTalk && t - m._sxTalk < beatMs();
        if(m.mesh.userData){ if(m.mesh.userData._sxY == null) m.mesh.userData._sxY = m.mesh.position.y; m.mesh.position.y = m.mesh.userData._sxY + (talking ? Math.abs(Math.sin(t / 140)) * 0.025 : 0); }
        if(m._sxLook != null){ const o = S.x.cast.find(q => q.m && q.m.id === m._sxLook); if(o) m._sxYaw = Math.atan2(o.m.x - m.x, o.m.z - m.z); m._sxLook = null; } });
    }catch(e){}
    SX.raf = requestAnimationFrame(anim);
  }
  const bring = function(S){
    /* members drawn into the sitting come into the room for it, and go back after */
    S.x.moved = [];
    S.x.cast.forEach((p, i) => { const m = p.m; if(!m || m.room === G.room) return;
      S.x.moved.push([m, m.room, m.x, m.z]); m.room = G.room; m._sxBrought = true;
      let cx = 0, cz = 6, yw = Math.PI; try{ if(typeof cam !== "undefined" && cam){ cx = cam.x; cz = cam.z; yw = cam.yaw; } }catch(e){}
      const fx = Math.sin(yw), fz = Math.cos(yw), lat = -(0.7 + (i % 4) * 0.75), dist = 2.8 + (i % 2) * 0.5 + Math.floor(i / 4) * 0.8;
      m.x = cx + fx * dist + fz * lat; m.z = cz + fz * dist - fx * lat; m.tx = m.x; m.tz = m.z; m.wait = 30; m.sitting = false; });
    try{ if(S.x.moved.length && typeof syncPeople === "function") syncPeople(); }catch(e){}
  }
  const sendBack = function(S){ try{ (S.x.moved || []).forEach(([m, r, x, z]) => { m._sxBrought = false; m.room = r; m.x = x; m.z = z; m.tx = x; m.tz = z; if(m.mesh && m.mesh.userData) m.mesh.userData._sxY = null; }); if(S.x.moved.length && typeof syncPeople === "function") syncPeople(); }catch(e){} }

  /* ── transcript + Session Log ── */
  const record = function(S, line){
    try{ tlog(line.who || S.D.chair, line.text, line.who === "You" ? "you" : "sit"); }catch(e){}
    const c = CLr(), at = (() => { try{ return hhmm(); }catch(e){ return ""; } })();
    S.x.lines.push({who:line.who || S.D.chair, text:line.text, at, tag:line.tag, gloss:line.gloss, p:line.p ? line.p.id : null});
    if(c){ c.said = c.said || {}; }
  }
  const saveLog = function(S, outcome){
    try{ const c = CLr(); if(!c) return;
      const sess = {title:S.D.title, k:"sitting", day:G.day, at:S.x.at0, room:(ROOMS[G.room] && ROOMS[G.room].t) || G.room, lines:S.x.lines.map(l => ({who:l.who, text:l.text, at:l.at, tag:l.tag, gloss:l.gloss})).slice(-120), outcome};
      c.past = [sess].concat(c.past || []).slice(0, 15); try{ localStorage.setItem("clarity.sessions", JSON.stringify(c.past)); }catch(e){}
    }catch(e){}
  }

  /* ── engine ── */
  const start = function(room, key){
    const D = SIT_DEF[room]; if(!D) return false;
    try{ if(TALK.open) closeTalk(); }catch(e){}
    G.sitPrep = G.sitPrep || {};
    const prep = G.sitPrep[room] === G.day;
    const M = matterFor(room);
    const watch = !!G._sitWatch; G._sitWatch = false;
    const S = SIT.on = {room, D, i:0, li:0, lines:[], cast:{}, score:0, rush:0, prep, watch, t0:performance.now(), m0:G.minute || 0, tally:[], picked:false, key:key || KEY[room] || D.key};
    const aide = watch ? null : aideFor(room); _aideM = aide && aide.m ? aide.m : null;
    S.x = {M, aide, cast:buildCast(room, M), lines:[], queue:[], qi:0, at0:(() => { try{ return hhmm(); }catch(e){ return ""; } })(), amended:false, lastSpeaker:null, moves:null, said:[]};
    S.x.tally = () => { const C = S.x.cast.filter(p => !p.gone); return {yes:C.filter(p => p.stance >= 55).length, no:C.filter(p => p.stance <= 45).length, mid:C.filter(p => p.stance > 45 && p.stance < 55).length, avg:C.reduce((a, p) => a + p.stance, 0) / Math.max(1, C.length)}; };
    S.cast = {a:(S.x.cast[0] || {}).name, b:(S.x.cast[1] || {}).name, c:(S.x.cast[2] || {}).name, ppl:S.x.cast.map(p => p.m).filter(Boolean)};
    try{ if(!watch){ kMark(S.key); kMarkChamber(); } }catch(e){}
    G.running = false;
    bring(S);
    try{ veil.classList.add("sitx"); }catch(e){}
    SX.on = true; if(!SX.raf) SX.raf = requestAnimationFrame(anim);
    step();
    return true;
  }
  const step = function(){
    const S = SIT.on, st = S.D.steps[S.i];
    S.picked = false; S.res = ""; S.x.moves = null; S.x.said = [];
    if(S.x.silenced != null && st !== "question") S.x.silenced = null;
    let q = exchange(S, st);
    if(S.i === 0 && S.x.aide) q.unshift({p:null, who:S.x.aide.name + " (your aide)", text:"I will be at your shoulder, " + (function(){ try{ return ndYou().address; }catch(e){ return "sir"; } })() + ". If you cannot take the floor, I will make your case.", to:null, tag:"support", gloss:S.x.aide.name + " is the highest-influence " + (S.x.aide.official ? "person in your administration" : "member of your party") + ", and speaks for your line whenever you are not speaking."});
    if(S.x.silenced != null) q = q.filter(l => !l.p || l.p.id !== S.x.silenced);
    if(S.x.brisk && q.length > 3) q = q.slice(0, 3 + (Math.random() < 0.5 ? 1 : 0));
    S.x.queue = q.length ? q : [chairLine(S, "Order.")];
    S.lines = S.x.queue; S.li = 0; S.x.floor = {step:S.i, rounds:0, ans:{}, closed:false, refused:false};
    S.x.queue.slice(0, 4).forEach(ln => { if(ln.p && ln.p.m && !ln.p.case && ln.tag !== "procedural") liveFill(S, ln, ln.p, ln.to != null && ln.to !== "you" ? S.x.cast[ln.to] : null); });
    spend(Math.round(S.D.min / S.D.steps.length), Math.round(S.D.en / S.D.steps.length));
    draw(); beat();
  }
  const beat = function(){
    const S = SIT.on; if(!S || !S.x) return;
    clearTimeout(SIT.timer);
    const c = CLr(); if((c && c.paused) || (window.__typing && Date.now() < window.__typing.until)){ SIT.timer = setTimeout(beat, 400); return; }
    if(S.li < S.x.queue.length){
      const ln = S.x.queue[S.li++];
      if(ln.p){ ln.p.spoke++; S.x.lastSpeaker = ln.p.id; ln.p.lastText = ln.text; }
      ln.shown = true; record(S, ln); face(S, ln); S.x.said.push(ln);
      draw();
      SIT.timer = setTimeout(beat, beatMs());
    } else if(floorAuto(S)){ draw(); SIT.timer = setTimeout(beat, Math.min(900, beatMs())); } else draw();
  }
  const pick = function(ci){
    const S = SIT.on; if(!S || !S.x || S.picked) return;
    const mv = (S.x.moves || [])[ci]; if(!mv) return;
    if(mv.k === "recog" || mv.k === "letrun"){
      const ch = chairOf(S), f = floorState(S), c = mv.tgt != null ? S.x.cast[mv.tgt] : null; let ln;
      if(!ch.you && Math.random() < 0.15 + (ch.p ? ch.p.temper / 300 : 0.1)){ f.refused = true; f.closed = true; ln = [chairLine(S, "The chair has heard enough on that point. We will move on.")]; S.res = ch.label + " refuses. " + (c ? c.sn + " does not get the floor." : ""); }
      else { f.closed = false; ln = floorRound(S, c, true); if(c) shift(S, c, 2, "was given the floor"); S.res = ch.you ? "You call the next in order." : "The chair lets them go on."; }
      S.x.moves = null; S.x.queue = S.x.queue.concat(ln); S.lines = S.x.queue; beat(); return;
    }
    const before = S.x.cast.map(p => p.stance);
    const r = doMove(S, mv);
    S.picked = true;
    const moved = S.x.cast.map((p, i) => [p, p.stance - before[i]]).filter(x => x[1]).map(x => x[0].sn + " " + (x[1] > 0 ? "+" : "") + x[1]).join(", ");
    S.res = (r.ok ? "It lands." : "It goes badly.") + (moved ? " Moved: " + moved + "." : "") + (r.r ? " (" + r.r + ")" : "");
    S.tally[S.tally.length - 1].moved = moved;
    S.x.queue = S.x.queue.concat(r.said); S.lines = S.x.queue;
    beat();
  }
  const next = function(){
    const S = SIT.on; if(!S || !S.x) return;
    if(S.li < S.x.queue.length){ beat(); return; }
    const st = S.D.steps[S.i];
    if(S.watch && st !== "adjourn" && !S.picked){ S.picked = true; drift(S, st); S.tally.push({step:st, pick:"You watched from the gallery", ok:true, k:"watch"}); }
    if(st !== "adjourn" && !S.picked) return;
    if(st === "vote" || st === "ruling") outcome();
    S.i++;
    if(S.i >= S.D.steps.length){ end(false); return; }
    step();
  }
  /* the gallery: nobody asks you; the room moves on its own, by who said what to whom */
  const drift = function(S, st){
    const C = S.x.cast.filter(p => !p.gone); if(!C.length) return;
    (S.x.said || []).forEach(l => { if(!l.p || l.to == null || l.to === "you" || !S.x.cast[l.to]) return; const t = S.x.cast[l.to];
      if(l.tag === "support" || l.tag === "position") shift(S, t, 2 + Math.floor(Math.random() * 3), "heard " + l.p.sn); else if(l.tag === "oppose" || l.tag === "threat") shift(S, t, -(2 + Math.floor(Math.random() * 3)), "was pushed by " + l.p.sn); });
    for(let i = 0; i < 2; i++){ const p = C[Math.floor(Math.random() * C.length)]; shift(S, p, (Math.random() < 0.5 ? -1 : 1) * (2 + Math.floor(Math.random() * 4)), "thought on it between speeches"); }
  };
  const outcome = function(){
    const S0 = SIT.on;
    if(S0 && S0.watch){ const t0 = S0.x.tally(), carried0 = t0.avg >= 50 || t0.yes > t0.no, M0 = S0.x.M;
      S0.x.verdict = "From the gallery you watched the room decide: " + (carried0 ? (M0.yes || "it carried") : (M0.no || "it failed")) + ", " + t0.yes + " to " + t0.no + "."; S0.out = "You watched. " + S0.x.verdict + " Nothing here was yours to vote."; S0.x.good = true; return; }
    const S = SIT.on, y = G.you, t = S.x.tally(), M = S.x.M, fin = S.x.final || "room";
    const carried = t.avg >= 50 || t.yes > t.no;
    let verdict, good;
    if(fin === "rule"){ good = carried && S.x.finalOk; verdict = carried ? "Your line carried, " + t.yes + " to " + t.no + "." : "You pushed your line against the room and lost, " + t.yes + " to " + t.no + "."; }
    else if(fin === "rulecomp"){ good = t.avg >= 45; verdict = "Settled on the compromise (" + M.comp + "). " + (good ? "Most of the room can live with it." : "Even the compromise was a stretch."); }
    else { good = carried && S.score >= 2; verdict = "You went with the room: " + (carried ? M.yes : M.no) + ", " + t.yes + " to " + t.no + "."; }
    if(S.rush) good = false;
    const res = sitApply(good ? {standing:2, influence:1, approval:S.room === "govoffice" ? 3 : S.room === "press" ? 2 : 0, support:M.bill && (S.room === "senate" || S.room === "committee" || S.room === "caucus") ? Math.round((t.avg - 50) / 4) : 0} : S.score < 0 ? {standing:-2} : {standing:1});
    if(S.room === "exec" || S.room === "govoffice"){
      try{ const st = S.room === "exec" ? (G.states || []).slice().sort((a, b) => (b.unrest || 0) - (a.unrest || 0))[0] : (G.states || []).find(s => s.n === y.state);
        if(st) st.unrest = clamp((st.unrest || 0) - (good ? 3 : carried ? 1 : -1), 0, 100); }catch(e){}
    }
    try{ const r = rivalLive(); const rv = r && S.x.cast.find(p => p.m === r); if(rv && rv.stance < 40) r.heat = clamp((r.heat || 0) + 4, 0, 100); }catch(e){}
    S.out = (good ? "A clean sitting." : S.score < 0 ? "A rough sitting." : "A middling sitting.") + " " + verdict + (res ? " " + res : "");
    S.x.verdict = verdict; S.x.good = good;
    try{ tlog(S.D.chair, S.out, "sit"); }catch(e){}
    if(good && S.prep){ try{ achieve("sitting"); }catch(e){} }
    try{ if(SX.after[S.room]) S.x.extra = SX.after[S.room](S, good, t, carried) || ""; }catch(e){ try{ console.warn("NEPTUNE-SITTINGS after", e); }catch(e2){} }
  }
  const recap = function(S){
    const C = S.x.cast, T = {gavel:"Called to order", open:"Openings", question:"Questions", motion:"Motions", deliberate:"Deliberation", vote:"The vote", ruling:"The ruling"};
    const rows = S.tally.map(x => '<li><b>' + esc(T[x.step] || x.step) + ':</b> ' + esc(x.pick) + (x.k === "watch" ? "" : ' — ' + (x.ok ? "it landed" : "it went badly")) + (x.moved ? '. ' + esc(x.moved) : '') + '</li>').join("");
    const why = C.filter(p => Math.abs(p.stance - p.start) >= 6).map(p => '<li><b>' + esc(p.sn) + '</b> ' + p.start + ' → ' + p.stance + ': ' + esc(p.hist.slice(-2).join("; ")) + '</li>').join("");
    return '<div class="sx-recap"><h3>What happened</h3><p>' + esc(S.x.verdict || "") + (S.x.amended ? " The compromise was on the table." : "") + (S.rush ? " You rushed it, and the room noticed." : "") + '</p><ul>' + rows + '</ul>' +
      (why ? '<h3>Who moved, and why</h3><ul>' + why + '</ul>' : '<p>Nobody really moved. Minds were made up before the gavel.</p>') + (S.x.extra ? '<h3>What it means at home</h3><p>' + esc(S.x.extra) + '</p>' : '') + '</div>';
  }
  const end = function(walked){
    const S = SIT.on; if(!S) return;
    clearTimeout(SIT.timer);
    if(S.watch){ /* a visitor's gallery seat costs nothing and changes nobody's opinion of you */ }
    else if(walked){ sitApply({standing:-3, influence:-1}); try{ tlog("", "You walked out of the sitting.", "sit"); }catch(e){} S.x.cast.forEach(p => { if(p.m && p.m.rel) p.m.rel.warmth = clamp((p.m.rel.warmth || 0) - 2, -100, 100); }); }
    else S.x.cast.forEach(p => { if(p.m && p.m.rel){ p.m.rel.warmth = clamp((p.m.rel.warmth || 0) + Math.round((p.stance - p.start) / 10), -100, 100); } });
    SIT.log.push({room:S.room, ms:Math.round(performance.now() - S.t0), gameMin:(G.minute || 0) - S.m0, steps:S.i, walked:!!walked, score:S.score, live:true});
    saveLog(S, walked ? "You walked out" : (S.out || "Sat through"));
    SX.log.push({room:S.room, verdict:S.x.verdict, score:S.score, lines:S.x.lines.length, tally:S.tally.map(x => x.k)});
    try{ note((walked ? "Walked out of " : "Sat through ") + S.D.title.toLowerCase() + "." + (S.x.verdict ? " " + S.x.verdict : "")); }catch(e){}
    sendBack(S);
    S.x.cast.forEach(p => { if(p.m){ p.m._sxYaw = null; p.m._sxTalk = 0; p.m._sxLook = null; } });
    try{ veil.classList.remove("sitx"); }catch(e){}
    SIT.on = null; SX.on = false;
    walkNow();
  }
  /* free speech: the player types, the room answers through window.onumLiveTalk when it is there */
  const talk = function(text){
    const S = SIT.on; if(!S || !S.x || S.x.talking) return;
    S.x.talking = true;
    const C = S.x.cast.filter(p => !p.gone), last = S.x.lastSpeaker != null ? S.x.cast[S.x.lastSpeaker] : null;
    const tgt = C.find(p => text.toLowerCase().indexOf(p.sn.toLowerCase()) >= 0) || last || C[0];
    S.x.queue.push({p:null, who:"You", text, to:tgt ? tgt.id : null, tag:"position", gloss:"Your own words, now on the record."}); S.lines = S.x.queue; beat();
    const ca = tgt && tgt.case ? caseAnswer(tgt, text) : null;
    if(ca){
      setTimeout(() => { if(SIT.on !== S) return;
        shift(S, tgt, ca.d, "answered your question about their case"); if(ca.promise) tgt.promised = true;
        S.x.queue.push(L(tgt, ca.text, "you", ca.d > 0 ? "support" : ca.d < 0 ? "oppose" : "position", tgt.sn + " answers from their own case. " + (ca.d > 0 ? "It moved them toward you." : ca.d < 0 ? "It cost you with them." : "")));
        S.lines = S.x.queue; S.x.talking = false; beat(); }, 650);
      return;
    }
    const ctx = {sitting:S.D.title, step:SIT_STEP_T[S.D.steps[S.i]], question:S.x.M.q, speaker:tgt ? {name:tgt.name, role:tgt.role, wants:tgt.want, stance:tgt.stance} : null,
      room:S.x.cast.map(p => ({name:p.name, role:p.role, wants:p.want, stance:p.stance})), recent:S.x.lines.slice(-6).map(l => l.who + ": " + l.text)};
    let pr; const LTk = window.onumLiveTalk;
    try{ pr = Promise.resolve(typeof LTk === "function" ? LTk(text, ctx)
      : LTk.reply({npcId:tgt ? (tgt.m ? tgt.m.id : tgt.off ? tgt.off.id : tgt.name) : null, npc:tgt ? (tgt.m || {id:tgt.off ? tgt.off.id : tgt.name, name:tgt.name, kind:"local", role:tgt.role, party:tgt.party, state:tgt.state}) : null, channel:"sitting", text:text, extra:"SITTING: " + ctx.sitting + ", " + ctx.step + ". The question: " + ctx.question + (tgt ? ". You want " + tgt.want : "") + "."}).then(r => r && Object.assign({who:tgt && tgt.name}, r))); }catch(e){ pr = Promise.reject(e); }
    Promise.race([pr, new Promise(r => setTimeout(() => r(null), 15000))]).then(rep => {
      if(SIT.on !== S) return;
      let who = tgt, t = typeof rep === "string" ? rep : rep && (rep.text || rep.reply || rep.content);
      if(rep && rep.who){ const f = C.find(p => p.name === rep.who || p.sn === rep.who); if(f) who = f; }
      if(!t) t = one(["Noted. Now, to the point.", "I hear you. I am not sure the room does.", "Say that again when the vote is called."]);
      const d = rep && typeof rep.stance === "number" ? rep.stance : (/agree|fair|right|yes|good point|with you/i.test(t) ? 4 : /\bno\b|disagree|wrong|nonsense/i.test(t) ? -3 : 1);
      if(who) shift(S, who, d, "answered you directly");
      S.x.queue.push(L(who, String(t).slice(0, 400), "you", d > 0 ? "support" : d < 0 ? "oppose" : "position", (who ? who.sn : "They") + " answers you in their own words. " + (d > 0 ? "It moved them a little toward you." : d < 0 ? "It cost you a little with them." : "")));
      S.lines = S.x.queue; S.x.talking = false; beat();
    }).catch(e => { S.x.talking = false; try{ console.warn("NEPTUNE-SITTINGS live talk", e); }catch(e2){} });
  };
  SX.talk = talk;
  const meter = function(p, S){
    const now = S.x.queue[S.li - 1], talking = now && now.p === p, d = p.stance - p.start;
    const col = p.stance >= 55 ? "#3c8d5a" : p.stance <= 45 ? "#b0473c" : "#c08a1e";
    return '<div class="sx-p' + (talking ? ' is-talk' : '') + (S.x.silenced === p.id ? ' is-cut' : '') + '" title="' + esc(p.name + " — wants " + p.want + ". Temper " + Math.round(p.temper) + ", conviction " + Math.round(p.conv)) + '">' +
      '<div class="sx-n"><b>' + esc(p.sn) + '</b> <small>' + esc(p.role) + '</small></div>' +
      '<div class="sx-bar"><i style="width:' + p.stance + '%;background:' + col + '"></i><u style="left:50%"></u></div>' +
      '<div class="sx-w"><small>wants ' + esc(p.want) + '</small><small>' + (p.stance >= 55 ? "with you" : p.stance <= 45 ? "against" : "undecided") + (d ? ' <em>' + (d > 0 ? "+" : "") + d + '</em>' : '') + '</small></div></div>';
  }
  const draw = function(){
    if(PC.open) return;                                        /* your computer is up: the sitting waits behind it */
    const S = SIT.on; if(!S || !S.x) return;
    const st = S.D.steps[S.i], done = S.li >= S.x.queue.length;
    const prog = S.D.steps.map((s, i) => '<span class="sit__dot' + (i < S.i ? ' is-done' : i === S.i ? ' is-now' : '') + '">' + SIT_STEP_T[s] + '</span>').join("");
    const shown = S.x.said, lastI = shown.length - 1;
    const lines = shown.map((l, i) => '<div class="sit__l sx-l sx-' + l.tag + (i === lastI ? ' is-new' : '') + '"><b>' + esc(l.who || S.D.chair) + (l.to != null && l.to !== "you" && S.x.cast[l.to] ? ' <small>→ ' + esc(S.x.cast[l.to].sn) + '</small>' : l.to === "you" ? ' <small>→ you</small>' : '') + '</b> ' + esc(l.text) +
      (l.gloss ? (i === lastI ? '<div class="sx-g"><span>What they meant:</span> ' + esc(l.gloss) + '</div>' : '<details class="sx-gd"><summary>What they meant</summary>' + esc(l.gloss) + '</details>') : '') + '</div>').join("");
    let acts = "";
    if(S.watch && done && st !== "adjourn"){ acts = '<button type="button" class="btn" id="sitGo">' + (S.i === S.D.steps.length - 1 ? "Rise" : "Watch the next step") + '</button>'; }
    else if(done && st !== "adjourn" && !S.picked){
      S.x.moves = S.x.moves || movesFor(S, st);
      acts = '<div class="sx-moves">' + S.x.moves.map((m, i) => '<button type="button" class="btn' + (i ? ' btn--ghost' : '') + '" data-sit="' + i + '" title="' + esc(m.why) + '">' + esc(m.t) + (m.risk >= 0.3 ? ' <small>(risky)</small>' : '') + '<br><small class="sx-why">' + esc(m.why) + '</small></button>').join("") + '</div>';
    } else acts = '<button type="button" class="btn" id="sitGo">' + (done ? (S.i === S.D.steps.length - 1 ? "Rise" : "Next step") : "Continue") + '</button>';
    const t = S.x.tally();
    card.innerHTML = '<div class="eyebrow">' + esc(S.D.title) + ' · step ' + (S.i + 1) + ' of ' + S.D.steps.length + (S.prep ? ' · you read the file' : '') + ' · pace ' + esc((CLr() && CLr().pace) || "normal") + '</div>' +
      '<h1>' + SIT_STEP_T[st] + '</h1><div class="sit__prog">' + prog + '</div>' +
      '<p class="sx-q"><b>The question:</b> ' + esc(S.x.M.q) + ' · <span class="sx-c">' + t.yes + (S.watch ? ' for it · ' : ' with you · ') + t.mid + ' undecided · ' + t.no + ' against</span>' + (S.watch ? ' · <i>you are in the gallery</i>' : '') + (S.x.amended ? ' · <i>compromise on the table</i>' : '') + '</p>' +
      chairHTML(S) + (S.x.aide ? '<p class="sx-q"><b>Your aide:</b> ' + esc(S.x.aide.name) + ' <small>' + esc(S.x.aide.role || "") + ' \u00b7 influence ' + Math.round(S.x.aide.infl) + '</small> \u2014 speaks for your line when you do not.</p>' : '') +
      '<div class="sx-grid"><div class="sx-cast">' + S.x.cast.map(p => meter(p, S)).join("") + '</div><div class="sit__lines sx-lines">' + lines + '</div></div>' +
      (S.res ? '<p class="dream">' + esc(S.res) + '</p>' : '') + (st === "adjourn" && S.out ? '<p class="dream">' + esc(S.out) + '</p>' + recap(S) : '') +
      (done && st !== "adjourn" && !S.picked && !S.watch ? '<p class="sx-hint">Your move. Hover a choice to see what it does; it shifts the meters live.</p>' : '') +
      (done && st !== "adjourn" && !S.picked && !S.watch && (typeof window.onumLiveTalk === "function" || (window.onumLiveTalk && typeof window.onumLiveTalk.reply === "function")) ? '<form class="sx-talk lt-sit" id="sxTalk"><input id="sxTalkIn" maxlength="240" placeholder="Or say something in your own words…" autocomplete="off"><button type="button" class="btn btn--ghost" id="sxTalkGo">Say it</button></form>' : '') +
      '<div class="card__actions">' + acts + ((function(){ try{ return pcCanOpen(); }catch(e){ return false; } })() ? '<button type="button" class="btn btn--ghost" id="sitPC">My computer</button>' : '') + '<button type="button" class="btn btn--ghost" id="sitOut">Walk out</button></div>';
    veil.hidden = false;
    const spc = el("sitPC"); if(spc) spc.addEventListener("click", () => { veil.hidden = true; if(!pcOpen()) veil.hidden = false; });
    const g = el("sitGo"); if(g) g.addEventListener("click", sitNext);
    el("sitOut").addEventListener("click", () => sitEnd(true));
    card.querySelectorAll("[data-sit]").forEach(b => b.addEventListener("click", () => sitPick(+b.getAttribute("data-sit"))));
    const tf = el("sxTalk"); if(tf){ const go = ev => { if(ev) ev.preventDefault(); const v = (el("sxTalkIn").value || "").trim(); if(v) talk(v); }; tf.addEventListener("submit", go); el("sxTalkGo").addEventListener("click", go); }
    const lb = card.querySelector(".sx-lines"); if(lb) lb.scrollTop = lb.scrollHeight;
    try{ if(window.onumGlossary && typeof window.onumGlossary.scan === "function") card.querySelectorAll(".sx-l.is-new, .sx-q, .sx-recap").forEach(n => window.onumGlossary.scan(n)); }catch(e){}
    try{ refreshPicks(); }catch(e){}
  }

  /* ── wrap the step-card engine; any failure drops back to the original card ── */
  const live = () => SIT.on && SIT.on.x;
  const guard = (name, f, fb) => function(){ try{ return f.apply(this, arguments); }catch(e){ SX.fails++; try{ console.warn("NEPTUNE-SITTINGS " + name, e); }catch(e2){}
    try{ if(SIT.on && SIT.on.x){ sendBack(SIT.on); delete SIT.on.x; veil.classList.remove("sitx"); } }catch(e3){} return fb.apply(this, arguments); } };
  sitStart = guard("start", function(room){
    let key = null; const r0 = String(room); if(r0.indexOf(":") > 0){ key = r0.split(":")[1]; room = r0.split(":")[0]; }
    if(SX.disabled || !start(room, key)) return O.sitStart(room);
  }, function(room){ return O.sitStart(String(room).split(":")[0]); });
  sitStep = guard("step", function(){ return live() ? step() : O.sitStep(); }, () => O.sitStep());
  sitBeat = guard("beat", function(){ if(PC.open && live()){ clearTimeout(SIT.timer); SIT.timer = setTimeout(sitBeat, 700); return; } return live() ? beat() : O.sitBeat(); }, () => O.sitBeat());
  sitPick = guard("pick", function(i){ return live() ? pick(i) : O.sitPick(i); }, i => O.sitPick(i));
  sitNext = guard("next", function(){ return live() ? next() : O.sitNext(); }, () => O.sitNext());
  sitOutcome = guard("outcome", function(){ return live() ? outcome() : O.sitOutcome(); }, () => O.sitOutcome());
  sitEnd = guard("end", function(w){ return live() ? end(w) : O.sitEnd(w); }, w => O.sitEnd(w));
  sitDraw = guard("draw", function(){ if(PC.open) return; return live() ? draw() : O.sitDraw(); }, () => O.sitDraw());
  /* closing the computer puts the sitting back where it was */
  { const _pcClose = pcClose; pcClose = function(){ _pcClose.apply(this, arguments); try{ if(SIT.on && SIT.on.x){ veil.hidden = false; sitDraw(); } }catch(e){} }; }
  SX.defs = SIT_DEF;
  /* 20261020o: a renamed chair or a new day redraws the open sitting */
  ["onum-rename", "onum-day"].forEach(ev => addEventListener(ev, () => { try{ if(SIT.on && SIT.on.x && typeof sitDraw === "function") sitDraw(); }catch(e){} }));
  SX.cur = () => SIT.on && SIT.on.x ? SIT.on.x.cast.map(p => p.m).filter(Boolean) : [];
  SX.start = (room, key) => sitStart(key ? room + ":" + key : room);

  /* committee dais, caucus lectern, press lectern: the new sittings */
  const addAct = function(room, id, mk){ try{ const P = (PROPS[room] || []).find(p => p.id === id); if(!P || P._sx) return; const a0 = P.acts; P._sx = true; P.acts = function(){ let A = []; try{ A = a0.apply(this, arguments) || []; }catch(e){ A = []; } try{ const x = mk(); if(x) A.unshift(x); }catch(e){} return A; }; }catch(e){} }
  addAct("committee", "dais", () => ({t:"Sit the hearing: question the witness with the committee", c:"50m · step by step", off:kOnceToday("sxcmte"), run(){ sitStart("committee"); return null; }}));
  addAct("caucus", "lectern", () => ({t:"Hold a party meeting on the line", c:"40m · step by step", off:kOnceToday("sxcauc"), run(){ sitStart("caucus"); return null; }}));
  addAct("press", "podium", () => ({t:"Hold a press conference", c:"30m · step by step", off:kOnceToday("sxpress"), run(){ sitStart("press"); return null; }}));
  /* the governor's and president's press availability on the docket becomes a press conference */
  try{ const dF = docketFor; docketFor = function(k){ const D = dF.apply(this, arguments); try{ if(!SX.disabled) D.forEach(d => { if(d && (d.key === "gpress" || d.key === "ppress") && d.run){ d.sit = "press:" + d.key; d.d += " Step by step, with the reporters in the room."; } }); }catch(e){} return D; }; }catch(e){}

  const st = document.createElement("style");
  st.textContent = "#veil.sitx{background:none;backdrop-filter:none;-webkit-backdrop-filter:none;place-items:end start}#veil.sitx #card{width:min(980px,96vw);max-width:none;max-height:92vh;overflow:auto;background:#fbf8f0;color:#1d1d1d;opacity:1;backdrop-filter:none;border:1px solid #8a7f66}" +
    ".sx-q{margin:2px 0 8px;font-size:13px}.sx-c{color:#6a5f46}.sx-grid{display:grid;grid-template-columns:300px 1fr;gap:12px;align-items:start}" +
    ".sx-cast{display:flex;flex-direction:column;gap:6px}.sx-p{border:1px solid #cfc3a6;background:#fffdf7;border-radius:7px;padding:5px 7px;transition:all .25s}.sx-p.is-talk{border-color:#b08a2e;box-shadow:0 0 0 2px #d9c48f;background:#f4ead2}.sx-p.is-cut{background:#ece8df;color:#4a4a4a}" +
    ".sx-n{font-size:13px;line-height:1.2}.sx-n small{color:#4f4f4f}.sx-bar{position:relative;height:7px;background:#e3ddcf;border-radius:4px;margin:4px 0 2px;overflow:hidden}.sx-bar i{position:absolute;left:0;top:0;bottom:0;transition:width .5s}.sx-bar u{position:absolute;top:0;bottom:0;width:1px;background:#6b6b6b}" +
    ".sx-w{display:flex;justify-content:space-between;gap:6px;font-size:11px;color:#6a5f46}.sx-w em{font-style:normal;font-weight:700}.sx-lines{max-height:46vh}.sx-l{border-left:3px solid #999;padding:3px 8px;margin:5px 0}.sx-l.is-new{background:#f6efdc}" +
    ".sx-support{border-color:#3c8d5a}.sx-oppose{border-color:#b0473c}.sx-threat{border-color:#8a2be2}.sx-deal{border-color:#c08a1e}.sx-procedural{border-color:#5b6b7c}.sx-g{font-size:12px;color:#5b5240;margin-top:2px}.sx-g span{font-weight:700}" +
    ".sx-gd{font-size:12px;color:#5b5240}.sx-gd summary{cursor:pointer;color:#5b5240}.sx-moves{display:flex;flex-wrap:wrap;gap:6px;flex:1 1 100%}.sx-moves .btn{text-align:left;max-width:300px;white-space:normal}.sx-why{font-weight:400}.sx-hint{font-size:12px;color:#6a5f46;margin:6px 0 0}" +
    ".sx-recap{border-top:1px solid #d8d2c4;margin-top:8px;font-size:13px}.sx-recap h3{font-size:14px;margin:8px 0 4px}.sx-recap ul{margin:0 0 0 18px;padding:0}" +
    ".sx-talk{display:flex;gap:6px;margin:8px 0 0}.sx-talk input{flex:1;padding:6px 8px;border:1px solid #b8ab8a;border-radius:6px;font:14px Georgia,serif;background:#fffdf7}" +
    "#veil.sitx .sit__dot{opacity:1;background:#ece6d8;color:#3b3526}#veil.sitx .sit__dot.is-done{background:#e0d3b0;color:#2b261b}#veil.sitx .sit__dot.is-now{background:#b08a2e;color:#fff}" +
    "#veil.sitx .eyebrow,#veil.sitx .sx-c,#veil.sitx .sx-w,#veil.sitx .sx-hint,#veil.sitx .sx-g{color:#4a4231}#veil.sitx .btn--ghost{background:#fffdf7;color:#1d1d1d}" +
    "@media (max-width:760px){.sx-grid{grid-template-columns:1fr}}";
  document.head.appendChild(st);
  console.log("NEPTUNE sittings ready");
}catch(e){ try{ console.warn("NEPTUNE-SITTINGS block", e); }catch(e2){} }
/* NEPTUNE-SITTINGS END */
/* NEPTUNE-DISTRICT BEGIN — the outdoor haul: East Steps + Capitol plaza, and the home district as a walkable town.
   Wraps buildRoomInner (and plantTree / propStreetLamp while an outdoor room is dressed) and roomBox (district walk
   bounds), and adds: nosed steps, balustrades, candelabra standards, paving inlays, monuments, Capitol wings and dome,
   dense street walls (storefronts with signage, framed windows with mullions), sidewalks, curbs, crosswalks, parked
   cars, street furniture, layered trees, a square, a park, civic buildings, homes, NO7 (Consular Republic) flags on
   poles and buildings, and Taylor Day bunting and banners (when isTaylorDay()).

   PUBLIC API
   window.onumBuildTown(THREE, {stateId, culture, seed, style}) -> {group, pois, style, solids, dispose}
     Builds a whole town (the home district's street plan) in a state's housing style. culture (STATE_DEF .cult)
     or stateId (STATE_DEF .n) picks the style; seed varies details; opts.style forces one of window.onumTownStyles:
       dutch -> "dutch_gable" (stepped and neck gables, brick)   yankee / pacific / prairie -> "clapboard"
       midlands -> "brick_row"   delta -> "gallery"   highplains -> "adobe"   mountain -> "stone_cottage"
     group is a THREE.Group in metres, Main Street on x=0 running +z. dispose() frees its geometry.
     The home district is built by the same code in the player's home-state style.
   window.ONUM_TOWN_POIS = [{id, kind, name, room, pos:{x,y,z}, door:{x,y,z}, stand:[{x,y,z},...]}]
     kinds: diner, church, bank, post_office, newsstand, shop, home, park, square, capitol_steps.
     Coordinates are the "district" room's (capitol_steps is in room "steps"). Set each time the district is
     dressed; then window.ONUM_TOWN_READY = true and window fires "onum-town-ready" (detail {pois, style}).
   window.NEPTUNE_DISTRICT: {on, stats, style, cache}. ?nodistrict switches the whole block off.

   Night: shop and house windows carry a per-window threshold attribute (aOn); the shader lights a pane when the
   dusk ramp from the game clock passes it, so windows come on one by one around dusk at no per-window cost.
   A pool of 3 point lights moves to the lamps nearest the camera after dusk.
   Performance: geometry is merged per material and per streaming chunk (core, north, west, east, south), cached
   per room/variant and prewarmed when idle; chunks are frustum culled and distance streamed, far blocks use a lower
