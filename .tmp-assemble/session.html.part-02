    rgSign(rgBronzeDoorTex(), 0, deckY + dh / 2 + 0.01, fz - 0.135, Math.PI, 1.34, 2.26).material.transparent = false;
    [-1, 1].forEach(sd => { const x = sd * 1.18, z = fz - 0.12;
      addBox(stone, x, deckY + 0.14, z, 0.44, 0.28, 0.4); addBox(stone, x, deckY + 1.9, z, 0.32, 3.4, 0.28); addBox(stone, x, deckY + 3.7, z, 0.46, 0.18, 0.4); addBox(matCol(0x8f846c, .9), x, deckY + 3.86, z, 0.52, 0.1, 0.46);
