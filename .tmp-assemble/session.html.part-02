      '<div class="lt-row"><button type="button" class="btn btn--ghost" id="ltTest">Test</button><button type="button" class="btn btn--ghost" id="ltForget">Forget conversations</button><button type="button" class="btn" id="ltClose">Done</button></div>';
    const upd = () => { CFG.on = P.querySelector("#ltOn").checked; CFG.voices = P.querySelector("#ltVo").checked; { const nv = P.querySelector("#ltModel").value.trim() || "llama3.2:3b"; if(nv !== CFG.model) CFG.userModel = true; CFG.model = nv; } CFG.engineModel = (P.querySelector("#ltEng") || {value:""}).value.trim(); CFG.url = P.querySelector("#ltUrl").value.trim().replace(/\/$/, "") || "http://127.0.0.1:11434"; LT.up = null; save(); };
    P.querySelectorAll("input").forEach(i => i.addEventListener("change", upd));
    P.querySelectorAll("input").forEach(i => i.addEventListener("keydown", e => e.stopPropagation()));
    P.querySelector("#ltTest").onclick = async () => { upd(); await probe("ui"); panel(); };
    P.querySelector("#ltForget").onclick = () => { Object.keys(MEM).forEach(k => delete MEM[k]); W.facts = []; W.heard = {}; W.promises = []; save(); panel(); };
    P.querySelector("#ltClose").onclick = () => { upd(); P.hidden = true; probe("ui"); };
  }
