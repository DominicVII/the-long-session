const SECT_A = ["Open", "Silent", "Lamplit", "Returning", "Patient", "Numbered", "Undivided", "Watching", "Reckoning", "Third"], SECT_N = ["Hand", "Circle", "Vigil", "Assembly", "Lantern", "Order", "Fellowship", "Brethren", "Path", "School"];
function fndFigs(){ const F = fndStore(); if(!F.figs) F.figs = []; if(!F.sects) F.sects = []; return F; }
function figMake(){
  const keys = Object.keys(FIG_ROLE), f = pick(["phys", "phys", "phil", "phil", "mind", "anth", "arts", "arts", "math", "bio", "cs", "earth", "chem", "soc"]), st = (G.states && G.states.length) ? pick(G.states).n : "the Union"; let nm = "A. Scholar"; try{ nm = wallSafeMint(() => newName(st)); }catch(e){}
  return {id:"f" + (fndStore().n = (fndStore().n || 0) + 1), name:nm, field:f, role:FIG_ROLE[f], state:st, zeal:Math.random(), rep:30 + Math.random() * 40, born:G.day};
}
function figLean(fg, c){ const F = fndStore(), base = ((seedOf("ln:" + fg.id + ":" + c.id) % 2000) / 1000 - 1) * 0.9, o = F.open.find(x => x.k === c.id), ev = o ? clamp(o.ev, -1, 1) * 0.5 : 0, r = F.res[c.id]; return clamp(base + (fg.field === "phys" || fg.field === "math" || fg.field === "cs" ? ev : ev * 0.3) + (r ? (r.belief ? 0.3 : -0.3) : 0), -1, 1); }
function figDay(){
