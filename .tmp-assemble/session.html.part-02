/* ══ 20261017i · THE SUN: day length follows the season and the latitude (about 41.5° north); sunrise, sunset, the height of the noon sun and the length of dusk come from the same astronomy as the real sky ══ */
const SUN = {lat:41.5, memo:null};
function sunTimes(doy){
  const N = doy || dayOfYear(); if(SUN.memo && SUN.memo.N === N) return SUN.memo;
  const rad = Math.PI / 180, decl = 23.44 * rad * Math.sin(2 * Math.PI * (284 + N) / 365), lat = SUN.lat * rad;
  const x = clamp((Math.sin(-0.833 * rad) - Math.sin(lat) * Math.sin(decl)) / (Math.cos(lat) * Math.cos(decl)), -1, 1), H0 = Math.acos(x), len = 2 * H0 / rad / 15;
  const dst = N >= 70 && N <= 307 ? 1 : 0, noon = 12.2 + dst;   /* clocks go forward in spring and back in autumn */
  return SUN.memo = {N, rise:noon - len / 2, set:noon + len / 2, len, noon, maxEl:90 - SUN.lat + decl / rad};
}
