/* where the empty distance is: rooms are in their own frames; blocks stand outside the built town */
const CITY_PLAN = {
  steps:{zones:[{x0:-64, x1:64, z0:-62, z1:-13.5, gap:3.7, axis:"z"}], avenue:{x:0, z0:-13, z1:-62, w:7.4}},
  district:{zones:[{x0:-64, x1:64, z0:36, z1:92, gap:3.9, axis:"z"}, {x0:-64, x1:64, z0:-92, z1:-34, gap:3.9, axis:"z"}], avenue:{x:0, z0:34, z1:92, w:7.8, z2:-34, z3:-92}}
