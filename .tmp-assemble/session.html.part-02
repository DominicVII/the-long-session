  const DEPT = [[/treasur|budget|tax|money|fund|spend|debt|revenue/, /treasury/i], [/defen[cs]e|war|army|navy|troop|blockade|border/, /defen[cs]e|war/i], [/law|court|legal|justice|prosecut|rights|attorney/, /attorney|justice/i], [/foreign|treaty|envoy|ambassador|abroad|trade with/, /state\b|foreign/i]];
  for(const [re, role] of DEPT){ if(re.test(t)){ const p = seats.find(x => role.test(String(x.role || ""))); if(p) return p; } }
