  if(chance(0.05)){ const c = pick(all.filter(x => F.open.some(o => o.k === x.id) || F.res[x.id])); if(c){ const a = pick(F.figs), b = F.figs.find(f => f !== a && Math.sign(figLean(f, c)) !== Math.sign(figLean(a, c)) && Math.abs(figLean(f, c)) > 0.4 && Math.abs(figLean(a, c)) > 0.4); if(b && Math.abs(figLean(a, c)) > 0.4){ a.rep = clamp(a.rep + 1, 0, 100); b.rep = clamp(b.rep + 1, 0, 100); fndNews(a.name + ", " + a.role + ", and " + b.name + ", " + b.role + ", dispute in public whether this is so: " + c.claim.replace(/\.$/, "").toLowerCase() + ".", false); } } }
