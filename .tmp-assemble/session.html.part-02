    if(!typing && window.matchMedia && matchMedia("(pointer:fine)").matches) el("tkOwnIn").focus();
  }catch(e){} }, 120);
}
async function tkOwnSay(m, text){
  if(TKOWN_BUSY[m.id]) return; TKOWN_BUSY[m.id] = 1; try{ const g = el("tkOwnGo"); if(g) g.disabled = true; }catch(e){}
  try{
    appendMsg("you", text); setSay("…", "");
    let out = ""; const LT = window.onumLiveTalk;
    try{ if(LT && typeof LT.reply === "function" && (typeof LT.available !== "function" || await LT.available())){ const r = await Promise.race([LT.reply({npcId:m.id, channel:"face", text}), new Promise(r => setTimeout(() => r(null), 25000))]); if(r && r.text) out = liveClean(r.text) || r.text; } }catch(e){}
    if(!out){ try{ out = improvise(m, text); }catch(e){} }
    if(!out) out = pick(["Go on.", "Mm.", "Say that again, slowly?"]);
    try{ m.chat = m.chat || []; m.chat.push({role:"user", content:text}, {role:"assistant", content:out}); if(m.chat.length > onumLim(40,"npc")) m.chat.splice(0, m.chat.length - onumLim(40,"npc")); }catch(e){}
    if(TALK.open && TALK.m === m){ appendMsg("them", out, surname(m.name)); setSay(out, ""); }
    try{ speakAt(m, out); }catch(e){}
  } finally { delete TKOWN_BUSY[m.id]; try{ const g = el("tkOwnGo"); if(g) g.disabled = false; }catch(e){} }
}
