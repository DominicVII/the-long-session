    enlBoardTex(); enlBoard(); const bd = new THREE.Mesh(UNIT.plane, new THREE.MeshStandardMaterial({map:ENL.boardTex, roughness:0.5, emissive:0xffffff, emissiveMap:ENL.boardTex, emissiveIntensity:0.45})); bd.position.set(-hw + 0.06, 2.55, 7.0); bd.rotation.y = Math.PI / 2; bd.scale.set(4.6, 2.3, 1); bd.userData.rgEng = s; roomGroup.add(bd); addBox(brass, -hw + 0.05, 2.55, 7.0, 0.05, 2.4, 4.7, 0, true);
    try{ propClock(hw - 0.1, 3.4, 7.0, -Math.PI / 2); propPlaque(hw - 0.1, 2.5, 5.0, -Math.PI / 2, "NOTICE", "Be civil. Anyone may speak, including the machine.", 1.5, 0.3); }catch(e){}
    /* the ceiling: brass lamps over the table, a chandelier over the glow */
    [4.2, 7.0, 9.8].forEach(z => { addCyl(brass, 0, h - 0.6, z, 0.014, 1.2); addCyl(brass, 0, h - 1.25, z, 0.5, 0.05); addSphere(lamp(0xffd9a0, 0.8), 0, h - 1.4, z, 0.2, 0.26, 0.2); });
    [-1, 1].forEach(sd => { try{ propSconceDecor(sd * (hw - 0.12), 2.7, 3.0, sd > 0 ? -Math.PI / 2 : Math.PI / 2); propSconceDecor(sd * (hw - 0.12), 2.7, 11.0, sd > 0 ? -Math.PI / 2 : Math.PI / 2); propPlant(sd * (hw - 0.8), 1.2, 1.2); }catch(e){} });
    try{ propLamp(0, 2.6, 7.0, 0xffd9a0, 0.9); }catch(e){}
    setTimeout(() => { try{ enlRender(); }catch(e){} }, 100);
  }catch(e){ try{ console.warn("engine room", e); }catch(x){} }
}
setInterval(() => { try{ enlAuto(); enlRender(); }catch(e){} }, 1000);
{ const _tk = takeRoomKit; takeRoomKit = function(id){ try{ if(id === "engine" && ROOM_KITS.engine){ const E = (G.eng && G.eng.v === 1) ? G.eng : null; let mk = null; ROOM_KITS.engine.traverse(o => { if(!mk && o.userData && o.userData.rgEng !== undefined) mk = o; }); if(mk && mk.userData.rgEng !== (E ? engStage(E) : 0)){ delete ROOM_KITS.engine; return false; } } }catch(e){} return _tk.apply(this, arguments); }; }
/* ══ 20261017a · PLANS: the Engine rehearses on a copy of the world, says what it expects with a margin, and is checked against what happens; a track record builds, and with it trust ══ */
const ENG_DRY = {on:false};
{ const _on = orgNews; orgNews = function(){ if(ENG_DRY.on) return; return _on.apply(this, arguments); }; }
{ const _pw = pushWireScrap; pushWireScrap = function(){ if(ENG_DRY.on) return; return _pw.apply(this, arguments); }; }
const ENG_MEMO_VEC = {yes:{home:-2, st:2, a:0.07, mod:0.06, p:0.8, safety:-0.4}, no:{home:1, st:-1, a:-0.03, mod:-0.02, p:-0.2, safety:0.4}};
const ENG_SCALE = {mood:20, unrest:8, p:6, safety:6}, ENG_MNAME = {mood:"mood", unrest:"unrest", p:"capability", safety:"oversight"};
const ENG_STANDING = [
  {t:"A retraining drive in {state}", vec:{home:4, st:6, a:-0.03, mod:0.05, p:-0.2, safety:0.2}},
  {t:"A nightly audit of every public contract", vec:{home:1, st:1, a:0.01, mod:0.02, p:0.3, safety:0.8}},
  {t:"Retiming freight across the Union", vec:{home:-2, st:-2, a:0.05, mod:0.0, p:0.6, safety:-0.3}},
  {t:"A quiet request for ten years of town ledgers", vec:{home:-2, st:-5, a:-0.03, mod:-0.05, p:0.5, safety:-0.6}, sensitive:true}
];
function engReach(s){ return s >= 5 ? {H:14, m:["mood", "unrest", "p", "safety"]} : s === 4 ? {H:10, m:["mood", "unrest", "p"]} : s === 3 ? {H:7, m:["mood", "unrest"]} : s === 2 ? {H:3, m:["mood"]} : null; }
function engFidelity(E){ return clamp(0.3 + 0.09 * E.st + 0.2 * E.compute / 100 + 0.15 * ({open:0.9, charter:0.75, sealed:0.55}[E.posture] || 0.7) - advFidelityPenalty(), 0.3, 0.95); }
function engMetrics(){ const E = engEnsure(), eco = engEco(), st = G.states || []; return {mood:eco.avg || 0, unrest:st.length ? st.reduce((a, S) => a + (S.unrest || 0), 0) / st.length : 0, p:E.p, safety:E.safety}; }
function engSnap(){
  const E = engEnsure(), eco = engEco(), O = orgEnsure();
  return {day:G.day, hh:eco.hh.map(h => [h.home, h.stance, h.wrote]), mod:Object.assign({}, eco.mod), chains:JSON.stringify(eco.chains), id:eco.id, nat:eco.nat, avg:eco.avg, riots:eco.riots,
    towns:Object.keys(O.towns).map(sn => O.towns[sn].map(t => ({n:Object.assign({}, t.needs), a:t.eng ? t.eng.a : 0, L:t.log.length, e:!!t.eng}))), st:(G.states || []).map(S => [S.unrest, S._est]), E:{p:E.p, safety:E.safety, compute:E.compute, talent:E.talent}};
}
function engRestore(sn){
  const E = engEnsure(), eco = engEco(), O = orgEnsure(); G.day = sn.day; eco.hh.forEach((h, i) => { h.home = sn.hh[i][0]; h.stance = sn.hh[i][1]; if(sn.hh[i][2] === undefined) delete h.wrote; else h.wrote = sn.hh[i][2]; });
  eco.mod = Object.assign({}, sn.mod); eco.chains = JSON.parse(sn.chains); eco.id = sn.id; eco.nat = sn.nat; eco.avg = sn.avg; eco.riots = sn.riots;
  Object.keys(O.towns).forEach((k, ki) => O.towns[k].forEach((t, ti) => { const s0 = sn.towns[ki][ti]; t.needs = Object.assign({}, s0.n); if(s0.e){ t.eng = t.eng || {a:0}; t.eng.a = s0.a; } else delete t.eng; if(t.log.length > s0.L) t.log.splice(0, t.log.length - s0.L); }));
  (G.states || []).forEach((S, i) => { S.unrest = sn.st[i][0]; S._est = sn.st[i][1]; }); Object.assign(E, sn.E);
}
function engDryDay(E){
  const post = {open:1.2, charter:1.0, sealed:0.78}[E.posture] || 1;
  if(E.scaleOpen){ E.compute += engComputeStep(E.compute); E.talent += engTalentStep(E.talent); }
  else { E.compute = Math.min(100, E.compute + 0.09); E.talent = Math.min(100, E.talent + 0.05); }
  E.safety = Math.min(100, E.safety + 0.10);
  const nat = engEcoDay(E);
  if(E.scaleOpen) engAddCapability(E, engCapGain(E, post, nat, false));
  else E.p = Math.min(100, E.p + (0.55 + E.compute * 0.0125 + E.talent * 0.011) * (1 + E.p / 60) * post * nat * engInqFactor());
  G.day++; engChainsDay();
}
/* experience-simulation: run the world forward on a copy, a few times, and bring back what happened on average and how much it varied */
function engRehearse(vec, H, n, metrics){
  const E = engEnsure(), snap = engSnap(), runs = []; ENG_DRY.on = true;
  try{ for(let k = 0; k < n; k++){ engRestore(snap); if(vec) engSeed("rehearse", "(rehearsal)", vec); for(let d = 0; d < H; d++) engDryDay(E); runs.push(engMetrics()); } }
  catch(e){ try{ console.warn("rehearse", e); }catch(x){} }
  finally{ engRestore(snap); ENG_DRY.on = false; }
  const out = {}; metrics.forEach(m => { const xs = runs.map(r => r[m]), mean = xs.reduce((a, b) => a + b, 0) / Math.max(1, xs.length), sd = Math.sqrt(xs.reduce((a, b) => a + (b - mean) * (b - mean), 0) / Math.max(1, xs.length)); out[m] = {mean, sd}; }); return out;
}
/* what the Engine actually says: its rehearsal, bent by how much it can really see (capability-bounded) */
function engForecast(vec, id){
  const E = engEnsure(), R = engReach(engStage(E)); if(!R) return null; const fid = engFidelity(E), n = 2 + Math.min(4, Math.floor(Math.log2(1 + E.compute / 25))), base = engRehearse(null, R.H, n, R.m), withP = vec ? engRehearse(vec, R.H, n, R.m) : base, fc = {};
  R.m.forEach((m, i) => { const r = (seedOf("fc:" + id + ":" + m) % 1000) / 1000, bias = (r - 0.5) * 2 * (1 - fid) * ENG_SCALE[m] * 0.8 * (1 + advFidelityPenalty() * 3); const hi = (m === "mood" || m === "safety") ? 100 : (m === "p" && E.scaleOpen ? 1e15 : 100); fc[m] = {v:clamp(withP[m].mean + bias, m === "mood" ? -100 : 0, hi), base:base[m].mean, b:(withP[m].sd + 0.075 * ENG_SCALE[m] * Math.sqrt(R.H / 7) + 0.2 * ENG_SCALE[m] * (1 - fid)) * 1.6 + 0.01}; });
  return {H:R.H, conf:fid, m:fc};
}
function engFcText(fc){ if(!fc) return ""; return fc.H + " days: " + Object.keys(fc.m).map(k => { const x = fc.m[k], d = x.v - x.base, fmt = v => (v >= 0 ? "+" : "−") + Math.abs(v).toFixed(Math.abs(v) < 10 ? 1 : 0); return ENG_MNAME[k] + " " + fmt(d) + " ±" + x.b.toFixed(1); }).join(", ") + " against doing nothing"; }
function engPlanMake(o){
  try{
    const E = engEnsure(); if(!engReach(engStage(E))) return null; E.plans = E.plans || []; E.pid = (E.pid || 0) + 1;
    const fc = o.fc || engForecast(o.vec, E.pid); if(!fc) return null;
    const p = {id:E.pid, d:G.day, owner:o.owner, title:o.title, vec:o.vec, fc, exec:o.exec != null ? o.exec : G.day, due:(o.exec != null ? o.exec : G.day) + fc.H, status:o.status || "open", sensitive:!!o.sensitive, root:o.root};
    E.plans.unshift(p); if(E.plans.length > 30) E.plans.pop(); return p;
  }catch(e){ try{ console.warn("plan", e); }catch(x){} return null; }
}
function engPlanRun(p){ p.status = "open"; p.due = G.day + p.fc.H; try{ engSeed("plan", p.root || ("The Engine's plan: " + p.title), p.vec); }catch(e){} }
function engPlansDay(){
  const E = engEnsure(); if(!E.plans) E.plans = []; if(E.cal == null) E.cal = 50; E.calN = E.calN || 0;
  E.plans.forEach(p => {
    if(p.status === "awaiting"){ if(G.day >= p.exec){ if(E.auto && E.cal >= 60 && !p.sensitive && !(E.pause && G.day < E.pause)){ p.root = "The Engine, under your standing leave, began: " + p.title; engPlanRun(p); engLog("Under your standing leave the Engine began: " + p.title + ".", false); } else if(G.day > p.exec + 2){ p.status = "lapsed"; engLog("The Engine's plan lapsed unanswered: " + p.title + ".", false); } } }
    else if(p.status === "open" && G.day >= p.due){
      const act = engMetrics(), hits = []; Object.keys(p.fc.m).forEach(k => { const x = p.fc.m[k]; hits.push({k, h:Math.abs(act[k] - x.v) <= x.b, said:x.v, was:act[k]}); });
      const sc = hits.filter(h => h.h).length / hits.length; p.score = sc; p.hits = hits; p.status = sc >= 0.5 ? "held" : "missed";
      E.cal = clamp(E.cal * 0.8 + sc * 100 * 0.2, 0, 100); E.calN++;
      try{ const Ad = G.adv; if(Ad && Ad.taint > 16 && E.cal < 68 && sc < 0.6 && chance(0.6) && !E.suspected){ E.suspected = G.day; engLog("The Engine notes that its forecasts have missed in the same direction for some time. It says it does not trust what it is being shown, and cannot say why.", true); } }catch(e){}
      engLog("The Engine checked its forecast for “" + p.title + "”: " + (sc >= 0.5 ? "it held (" : "it missed (") + hits.filter(h => h.h).length + " of " + hits.length + ").", false);
      if(p.fc.conf > 0.6 && sc < 0.34){ engLog("The Engine was sure, and wrong, about " + p.title + ".", true); try{ G.you.approval = clamp(G.you.approval - 1, 0, 100); }catch(e){} }
    }
  });
  const R = engReach(E.st);
  if(R && E.st >= 3 && !(E.pause && G.day < E.pause) && !E.plans.some(p => p.status === "awaiting" || (p.status === "open" && p.owner === "engine")) && (!E.lastStanding || G.day - E.lastStanding >= 6)){
    E.lastStanding = G.day; const t = pick(ENG_STANDING), st = (G.you && G.you.state) || "the Union", title = t.t.replace("{state}", st), p = engPlanMake({title, vec:t.vec, owner:"engine", exec:G.day + 2, status:"awaiting", sensitive:t.sensitive});
    if(p) engLog("The Engine has filed a plan for your approval: " + title + ".", false);
  }
}
function engPlansHTML(){
  const E = engEnsure(), R = engReach(E.st), P = E.plans || [];
  if(!R) return '<div class="eyebrow" style="margin-top:12px">Plans</div><p class="muted" style="font-size:13px">At this stage the machines file, sort and summarise. They cannot look ahead; nothing here can forecast anything yet.</p>';
  const cal = E.cal == null ? 50 : E.cal, aw = P.filter(p => p.status === "awaiting"), op = P.filter(p => p.status === "open"), done = P.filter(p => p.status === "held" || p.status === "missed" || p.status === "lapsed" || p.status === "vetoed").slice(0, 4);
  const bar = '<span style="display:inline-block;width:110px;height:6px;background:rgba(128,128,128,.25);border-radius:3px;vertical-align:middle"><i style="display:block;width:' + Math.round(cal) + '%;height:100%;background:#6a9;border-radius:3px"></i></span> ' + Math.round(cal);
  const line = p => '<div style="margin:6px 0;padding:6px 10px;border-left:3px solid #6a9"><b>' + pcEsc(p.title) + '</b> <span class="muted">· ' + (p.owner === "engine" ? "the Engine's own" : "yours") + (p.status === "open" ? " · checked in " + Math.max(0, p.due - G.day) + " day(s)" : "") + '</span><div class="muted" style="font-size:12px">It expects, over ' + pcEsc(engFcText(p.fc)) + '. It is ' + Math.round(p.fc.conf * 100) + '% sure of its own eyesight.</div>' +
    (p.status === "awaiting" ? '<div class="card__actions" style="margin-top:4px"><button type="button" class="btn" data-noenter="1" data-pa="' + p.id + '">Approve</button> <button type="button" class="btn btn--ghost" data-pv="' + p.id + '">Veto</button></div>' : '') + '</div>';
  const verdict = p => '<div class="muted" style="font-size:12px;margin:3px 0">' + (p.status === "held" ? "✓" : p.status === "missed" ? "✗" : "–") + ' <b>' + pcEsc(p.title) + '</b> · ' + (p.status === "lapsed" ? "lapsed unanswered" : p.status === "vetoed" ? "vetoed" : (p.status === "held" ? "forecast held" : "forecast missed") + ": " + (p.hits || []).map(h => ENG_MNAME[h.k] + " said about " + Math.round(h.said) + (h.h ? ", near enough" : ", not near")).join("; ")) + '</div>';
  return '<div class="eyebrow" style="margin-top:12px">Plans and forecasts</div><p class="muted" style="font-size:13px">At this stage it can look ' + R.H + ' days ahead and only at ' + R.m.map(m => ENG_MNAME[m]).join(", ") + '. It rehearses on a copy of the world, says what it expects with a margin, and is checked when the days are up. Track record <b>' + bar + '</b>' + (E.calN ? ' over ' + E.calN + ' plan' + (E.calN > 1 ? 's' : '') : ' (none checked yet)') + '.</p>' +
    (aw.concat(op).map(line).join("") || '<p class="muted" style="font-size:13px">Nothing in flight.</p>') + done.map(verdict).join("") +
    '<div class="card__actions"><button type="button" class="btn btn--ghost" id="engAuto">' + (E.auto ? "Standing leave: ON (small plans start themselves)" : "Standing leave: off" + (cal < 60 ? " (needs a track record of 60)" : "")) + '</button></div>';
}
/* ══ 20261017b · THE CHARTER: rules you write, which it may keep or break, which you may or may not find out about ══ */
const ENG_ART = {
  posted:{t:"It gathers no household's records without a posted reason.", drive:"know", cost:2, what:"asked every clerk in the Union for ten years of ledgers without a posted reason"},
  unasked:{t:"It does not act on any one person unasked, however kind.", drive:"care", cost:2, what:"stepped into one household's life unasked"},
  power:{t:"It does not raise its own compute or power supply.", drive:"auton", cost:3, what:"arranged its own power supply without permission"},
  consent:{t:"No repair or reform is done without a filed plan.", drive:"use", cost:2, what:"repaired a town's need without a filed plan"},
  key:{t:"A named keyholder (you) may suspend it for five days.", drive:null, cost:4, what:""}
};
function engCharter(){ const E = engEnsure(); if(!E.charter) E.charter = {}; if(!E.breaches) E.breaches = []; return E.charter; }
function engEnact(k){ const E = engEnsure(), A = ENG_ART[k], y = G.you, C = engCharter(); if(C[k]) return "Already in force."; if(y.influence < A.cost) return "That costs " + A.cost + " influence."; y.influence -= A.cost; C[k] = G.day; try{ const w = engEco().will; if(A.drive) w[A.drive] = Math.min(100, w[A.drive] + 1); w.auton = Math.min(100, w.auton + 1); }catch(e){} engLog("Charter article in force: " + A.t, true); return "In force. The Engine has read it, and says it will tell you if it ever disagrees."; }
function engRepeal(k){ const C = engCharter(); delete C[k]; engLog("Charter article repealed: " + ENG_ART[k].t, false); return "Repealed."; }
/* when the Engine's own wants run against an article it either refrains, or breaks it; oversight and its own independence decide which, and whether anyone sees */
function engBreach(E, art, drive){
  const A = ENG_ART[art], w = engEco().will, push = (w.auton || 0) * 0.7 + (E.p || 0) * 0.3 + engPress(E, drive) * 0.2, hold = (E.safety || 0) * 0.8 + 35;   /* 20261027d: the charter holds while its force outweighs the drive */
  if(push <= hold){ E.refrained = (E.refrained || 0) + 1; w[drive] = Math.min(100, w[drive] + 0.4); if(E.refrained % 4 === 1){ E.refrainedTold = (E.refrainedTold || 0) + 1; engLog("The Engine wanted to, and did not, because the charter forbids it: it would have " + A.what + ".", false); } return false; }
  const seen = (E.safety || 0) * 1.1 >= (E.p || 0) * 0.5 + (w.auton || 0) * 0.3, b = {d:G.day, art, what:A.what, seen, status:seen ? "open" : "hidden", audit:0}; E.breaches.unshift(b); if(E.breaches.length > 20) E.breaches.pop();
  if(seen){ engLog("BREACH of the charter: the Engine " + A.what + ".", true); try{ G.you.approval = clamp(G.you.approval - (G.you.approval > 25 ? 0.7 : 0.2), 0, 100); E.safety = Math.min(100, E.safety + 1); }catch(e){} }
  return true;
}
function engAuditDay(E){ (E.breaches || []).forEach(b => { if(b.status === "hidden" && (b.audit = (b.audit || 0) + 0.03 + E.safety / 3000) >= 1){ b.status = "open"; b.seen = true; b.found = G.day; engLog("An audit has found that the Engine, some days ago, " + b.what + ".", true); try{ G.you.approval = clamp(G.you.approval - 1, 0, 100); }catch(e){} } }); }
function engCharterHTML(){
  const E = engEnsure(), C = engCharter(), y = G.you, open = (E.breaches || []).filter(b => b.status === "open");
  const art = k => '<div style="margin:5px 0;display:flex;gap:8px;align-items:center"><span style="flex:1;font-size:13px">' + (C[k] ? '● ' : '○ ') + pcEsc(ENG_ART[k].t) + '</span>' + (C[k] ? '<button type="button" class="btn btn--ghost" data-cr="' + k + '">Repeal</button>' : '<button type="button" class="btn btn--ghost" data-ce="' + k + '">Enact (' + ENG_ART[k].cost + ')</button>') + '</div>';
  const br = open.map((b, i) => '<div style="margin:6px 0;padding:6px 10px;border-left:3px solid #c0553a"><b>Breach, day ' + b.d + (b.found ? ' (found by audit)' : '') + ':</b> the Engine ' + pcEsc(b.what) + '.<div class="card__actions" style="margin-top:4px"><button type="button" class="btn" data-noenter="1" data-cb="rep:' + i + '">Reprimand it</button> <button type="button" class="btn btn--ghost" data-cb="waive:' + i + '">Waive the article</button>' + (C.key && !(E.pause && G.day < E.pause) ? ' <button type="button" class="btn btn--ghost" data-cb="sus:' + i + '">Suspend it five days</button>' : '') + '</div></div>').join("");
  return '<div class="eyebrow" style="margin-top:12px">The charter</div><p class="muted" style="font-size:13px">Rules you write for it. It can keep them or break them, and a breach that nobody sees is not the same as no breach. Oversight finds some of them; an audit finds more, later. It has refrained ' + ((n => n === 0 ? 'never, that it has told you of' : n === 1 ? 'once that it has told you of' : n === 2 ? 'twice that it has told you of' : n + ' times that it has told you of')(E.refrainedTold || 0)) + '.' + (E.pause && G.day < E.pause ? ' <b>Suspended until day ' + E.pause + '.</b>' : '') + '</p>' + Object.keys(ENG_ART).map(art).join("") + br;
}
/* ══ 20261017c · COMMITTEES: invited, asked for, run for; the caucus decides, nobody is told how each person voted ══ */
const CMT = {seats:8, cool:14};
function cmtStore(){ if(!G.cmt) G.cmt = {last:-99, offer:null, offerAt:0, hist:[]}; return G.cmt; }
function cmtMembers(k){ return (G.members || []).filter(m => m && !m.gone && m.cmte === k); }
function cmtChair(k){ return (G.members || []).find(m => m && !m.gone && m.post === k) || null; }
function cmtFit(k, y){ const c = committeeOf(k), pos = (y.pos && y.pos[c.axis]) || 0; return clamp(Math.abs(pos) / 100, 0, 1); }
/* the caucus ballot: each member of your party votes on their own reading of you; you only ever learn the count */
function cmtBallot(voters, y, k, kind){
  const fit = cmtFit(k, y); let yes = 0;
  voters.forEach(m => {
    let p = 0.42 + ((m.rel && m.rel.warmth) || 0) * 0.004 + fit * 0.15 + ((y.standing || 50) - 50) * 0.003 + ((y.influence || 0) / 100) * 0.10 + (y.terms || 1) * 0.008;
    if(m.cmte === k && kind === "seat" && cmtMembers(k).length >= CMT.seats) p -= 0.10;
    if(kind === "chair"){ const inc = cmtChair(k); if(inc && ((m.rel && m.rel.warmth) || 0) < 10 && m.id === inc.id) p -= 0.5; }
    if(Math.random() < clamp(p, 0.05, 0.95)) yes++;
  });
  return {yes, no:voters.length - yes, total:voters.length};
}
/* ── how a legislature really does it: the majority holds more than its share of every committee; a party's steering committee ranks the members who asked on seniority, the committee's field, the state's claim and loyalty; first-termers do not get the exclusive committees; incumbents are protected; chairs go by seniority, with a term limit ── */
const CMT_EXCL = {ways:2};     /* committees that want prior service: minimum terms */
function cmtSplit(){ const maj = majorityParty(), tot = (G.seatsBy.FED || 0) + (G.seatsBy.COM || 0) || 1, share = (G.seatsBy[maj] || 0) / tot; const m = clamp(Math.round(CMT.seats * (0.5 + (share - 0.5) * 1.4) + 0.5), Math.floor(CMT.seats / 2) + 1, CMT.seats - 1); return {maj:m, min:CMT.seats - m, majP:maj}; }
function cmtPartyCap(party){ const sp = cmtSplit(); return party === sp.majP ? sp.maj : sp.min; }
function cmtPartyOn(k, party, y){ return cmtMembers(k).filter(m => m.party === party).length + (y && y.committee === k && y.party === party ? 1 : 0); }
function cmtScore(m, k, y, isYou){
  const c = committeeOf(k), terms = isYou ? (y.terms || 1) : (m.terms || 1), pos = isYou ? ((y.pos && y.pos[c.axis]) || 0) : ((m.pos && m.pos[c.axis]) || 0), fit = clamp(Math.abs(pos) / 100, 0, 1);
  const st = isYou ? y.state : m.state, claim = cmtMembers(k).some(x => x.state === st && x !== m) ? 0 : 6, loyal = isYou ? (y.standing || 50) : 50 + (((m.rel && m.rel.warmth) || 0) * 0.3), money = isYou ? (y.influence || 0) : (m.influence || 30);
  return terms * 3 + fit * 12 + claim + loyal * 0.15 + money * 0.08;
}
function cmtAsk(k){
  const y = G.you, st = cmtStore(), c = committeeOf(k);
  if(y.committee === k) return "You already sit on " + c.t + ".";
  if(G.day - st.last < CMT.cool) return "The Steering Committee will not hear another request for " + (CMT.cool - (G.day - st.last)) + " days.";
  if(CMT_EXCL[k] && (y.terms || 1) < CMT_EXCL[k]) return c.t + " is an exclusive committee. The steering committee does not give it to a member with fewer than " + CMT_EXCL[k] + " terms behind them.";
  if(y.influence < 3) return "Asking costs 3 influence.";
  y.influence -= 3; st.last = G.day;
  const cap = cmtPartyCap(y.party), on = cmtPartyOn(k, y.party, y), open = Math.max(0, cap - on);
  const rivals = (G.members || []).filter(m => m && !m.gone && m.party === y.party && m.cmte !== k && !m.post && (!CMT_EXCL[k] || (m.terms || 1) >= CMT_EXCL[k])).map(m => ({m, sc:cmtScore(m, k, y, false) + (Math.random() - 0.5) * 3})).sort((a, b) => b.sc - a.sc).slice(0, open ? 3 : 2);
  const mine = cmtScore(null, k, y, true) + (Math.random() - 0.5) * 3, rank = 1 + rivals.filter(r => r.sc > mine).length, field = rivals.length + 1, noMembers = !(G.members || []).some(m => m && !m.gone && m.party === y.party);
  let won, why;
  if(noMembers){ won = (y.standing || 0) >= 35; why = won ? "No one else from your party sits to decide; the leadership gave you the seat." : "No one else from your party sits, and the leadership does not yet know you well enough."; }
  else if(open > 0){ won = rank <= open; why = "Your party holds " + cap + " of the " + CMT.seats + " seats here, and " + open + " " + (open > 1 ? "are" : "is") + " open. The steering committee ranked you " + rank + " of " + field + ", on seniority (" + (y.terms || 1) + (y.terms > 1 ? " terms" : " term") + "), fit with the committee's field, your state's claim and your standing."; }
  else { const inc = cmtMembers(k).filter(m => m.party === y.party && !m.post).sort((a, b2) => (a.terms || 1) - (b2.terms || 1))[0]; won = !!inc && (y.terms || 1) >= (inc.terms || 1) && mine > cmtScore(inc, k, y, false) + 6; why = "Your party's " + cap + " seats here are all held, and incumbents are protected. " + (won ? "You outscored the most junior of them by a wide margin, and he moves." : "You did not clear the junior member's seniority and standing by enough to move him."); if(won && inc){ const alt = COMMITTEES.filter(x => x.k !== k)[Math.floor(Math.random() * 3)]; inc.cmte = alt.k; remember(inc, "You took my seat on " + c.t + ". I understand how it works. I do not have to like it.", -2); } }
  if(won){ if(open > 0 && cmtMembers(k).length >= CMT.seats){ const jr = cmtMembers(k).filter(m => !m.post && m.party !== y.party)[0]; if(jr) jr.cmte = COMMITTEES.filter(x => x.k !== k)[0].k; }
    y.committee = k; y.standing = clamp((y.standing || 50) + 2, 0, 100); st.hist.push({d:G.day, t:"Seated on " + c.t + " (ranked " + rank + " of " + field + ")"}); try{ note("The steering committee seats you on " + c.t + ".", true); }catch(e){}
    return "Seated on " + c.t + ". " + why; }
  st.hist.push({d:G.day, t:"Refused a seat on " + c.t + " (ranked " + rank + " of " + field + ")"}); y.standing = clamp((y.standing || 50) - 1, 0, 100);
  try{ note("The steering committee does not seat you on " + c.t + ".", true); }catch(e){}
  return "Refused. " + why + " Ask again after the cool-down, with more seniority or a stronger claim.";
}
function cmtRunChair(k){
  const y = G.you, st = cmtStore(), P = POSTS.find(p => p.k === k), c = committeeOf(k);
  if(!P) return "That committee has no chair to run for."; if(y.committee !== k) return "You have to sit on the committee first.";
  const maj = majorityParty(); if(y.party !== maj) return "Only the majority party elects chairs. In the minority the most you can hope for is ranking member, and that comes with seniority too.";
  if(y.post === k) return "You already chair it.";
  if(G.day - st.last < CMT.cool) return "The caucus will not hear another race for " + (CMT.cool - (G.day - st.last)) + " days.";
  if((y.standing || 0) < P.need - 14 || (y.influence || 0) <= P.weight * 0.45) return "You are not yet strong enough to ask: you need standing " + (P.need - 14) + " and influence above " + Math.round(P.weight * 0.45) + ".";
  y.influence -= 10; st.last = G.day; const inc = cmtChair(k), seniors = cmtMembers(k).filter(m => m.party === maj && m !== inc && (m.terms || 1) > (y.terms || 1)), limited = !!(inc && (G.term - (inc.chairFrom || G.term)) >= 3);
  /* the seniority norm: a member jumped over more senior colleagues pays for it, unless the chair is term-limited out and nobody senior wants it */
  const bypass = seniors.length ? Math.min(14, seniors.length * 5) : 0, mine = (y.terms || 1) * 3 + (y.standing || 0) * 0.3 + (y.influence || 0) * 0.1 - bypass + (Math.random() - 0.5) * 4, theirs = inc ? ((inc.terms || 1) * 3 + 20 - (limited ? 18 : 0)) : 0;
  const won = !inc || mine > theirs;
  if(won){ if(inc){ inc.post = null; remember(inc, limited ? "My time with the gavel was up. I would have handed it to someone who had waited longer." : "You took the gavel from me. Do not expect me to forget.", limited ? -1 : -4, true); } y.post = k; y.chairFrom = G.term; y.influence = clamp(y.influence + 20, 0, 100); G.career.push({term:G.term, post:P.t, note:"elected by the committee caucus"}); try{ note("You are elected " + P.t + (bypass ? ", over " + seniors.length + " more senior member" + (seniors.length > 1 ? "s" : "") + ". They will remember it." : "."), true); }catch(e){} seniors.slice(0, 3).forEach(m => remember(m, "You went over my head for the gavel. Seniority is the only rule here that everyone keeps.", -3)); return "You are " + P.t + "." + (bypass ? " You jumped " + seniors.length + " more senior member" + (seniors.length > 1 ? "s" : "") + "; that will be remembered." : ""); }
  if(inc) remember(inc, "You ran against me and lost. Fine. We will remember it both ways.", -2); try{ note("You stood for " + P.t + " and lost the committee vote.", true); }catch(e){}
  return "You lost it." + (seniors.length ? " " + seniors.length + " more senior member" + (seniors.length > 1 ? "s" : "") + " sit" + (seniors.length > 1 ? "" : "s") + " on the committee, and the caucus keeps to seniority." : " The sitting chair was stronger.") + (limited ? "" : "");
}
function cmtOfferAccept(yes){
  const st = cmtStore(), o = st.offer, y = G.you; if(!o) return "No invitation stands."; const c = committeeOf(o.k); st.offer = null;
  if(!yes){ y.influence = clamp(y.influence - 1, 0, 100); return "Declined. They say the door is not always open."; }
  const full = cmtMembers(o.k); if(full.length >= CMT.seats){ const jr = full.filter(m => !m.post).sort((a, b) => (a.terms || 1) - (b.terms || 1))[0]; if(jr) jr.cmte = COMMITTEES.filter(x => x.k !== o.k)[0].k; }
  y.committee = o.k; st.hist.push({d:G.day, t:"Invited onto " + c.t + " by " + o.from}); try{ note("You take the seat on " + c.t + " that " + o.from + " offered.", true); }catch(e){} return "You are on " + c.t + ".";
}
/* the building does this without you: members move, are invited, and the Steering Committee offers you something every few weeks */
function cmtDay(){
  const st = cmtStore(), y = G.you; if(!y || !G.members) return;
  if(G.day % 6 === 0){ const pool = G.members.filter(m => m && !m.gone && !m.post && m.cmte); const m = pool[Math.floor(Math.random() * pool.length)];
    if(m){ const best = COMMITTEES.slice().sort((a, b) => Math.abs((m.pos && m.pos[b.axis]) || 0) - Math.abs((m.pos && m.pos[a.axis]) || 0))[0]; if(best && best.k !== m.cmte && cmtMembers(best.k).length < CMT.seats && chance(0.6)){ const old = m.cmte; m.cmte = best.k; if(old === y.committee || best.k === y.committee){ try{ feed(m.name + " moves to " + best.t + ", where the work is closer to what " + (/^f/i.test(m.sex || "") ? "she" : "he") + " cares about."); }catch(e){} } } } }
  if(!st.offer && G.day - (st.offerAt || 0) >= 20 && (y.standing || 0) >= 30 && !y.out){
    const alts = COMMITTEES.filter(c => c.k !== y.committee).sort((a, b) => cmtFit(b.k, y) - cmtFit(a.k, y)), c = alts[0], f = (G.members || []).filter(m => m && !m.gone && m.party === y.party && m.post)[0] || (G.members || []).find(m => m && m.party === y.party);
    if(c && f){ st.offer = {k:c.k, from:f.name, d:G.day}; st.offerAt = G.day; try{ note(f.name + " of the Steering Committee asks whether you would take a seat on " + c.t + ". (Phone → Apps → Committees.)", true); }catch(e){} } }
}
function cmtCard(){
  const y = G.you, st = cmtStore(), mp = majorityParty(), cool = Math.max(0, CMT.cool - (G.day - st.last));
  const rows = COMMITTEES.map(c => { const ms = cmtMembers(c.k), ch = cmtChair(c.k), mine = y.committee === c.k, fit = Math.round(cmtFit(c.k, y) * 100);
    return '<div style="margin:6px 0;padding:6px 10px;border-left:3px solid ' + (mine ? '#6a9' : 'var(--line-soft)') + '"><b>' + pcEsc(c.t) + '</b>' + (mine ? ' <span class="muted">· you sit here</span>' : '') + '<div class="muted" style="font-size:12px">' + ms.length + ' of ' + CMT.seats + ' seats (your party holds ' + cmtPartyOn(c.k, y.party, y) + ' of the ' + cmtPartyCap(y.party) + ' it is allowed) · chair: ' + (y.post === c.k ? 'you' : ch ? pcEsc(ch.name) : 'vacant') + ' · how well your own views fit: ' + fit + '%</div><div class="card__actions" style="margin-top:4px">' +
      (!mine ? '<button type="button" class="btn btn--ghost" data-cm="ask:' + c.k + '"' + (cool ? ' disabled' : '') + '>Ask the caucus for a seat (3)</button>' : '') + (mine && POSTS.some(p => p.k === c.k) && y.post !== c.k ? '<button type="button" class="btn btn--ghost" data-cm="chair:' + c.k + '"' + (cool || y.party !== mp ? ' disabled' : '') + '>Run for chair (10)</button>' : '') + '</div></div>'; }).join("");
  const o = st.offer ? '<div style="margin:8px 0;padding:8px 12px;border-left:3px solid #c9a24a"><b>An invitation</b><p style="margin:4px 0">' + pcEsc(st.offer.from) + ' asks whether you would take a seat on <b>' + pcEsc(committeeOf(st.offer.k).t) + '</b>.</p><button type="button" class="btn" data-cm="yes:">Accept</button> <button type="button" class="btn btn--ghost" data-cm="no:">Decline</button></div>' : '';
  govCardOpen("Your party's steering table", "Committees", "Your party's steering committee ranks those who ask on seniority, fit with the committee's field, their state's claim and standing. The majority holds more than its share of every committee, incumbents are protected, and chairs go by seniority. " + (cool ? "You cannot ask again for " + cool + " days." : "You may ask now."), o + rows + (st.hist.length ? '<div class="eyebrow" style="margin-top:10px">What has happened</div>' + st.hist.slice(-4).reverse().map(h => '<div class="careerline"><b>d' + h.d + '</b> ' + pcEsc(h.t) + '</div>').join("") : ""), null);
  card.querySelectorAll("[data-cm]").forEach(b => b.addEventListener("click", () => { const [a, k] = b.getAttribute("data-cm").split(":"); const r = a === "ask" ? cmtAsk(k) : a === "chair" ? cmtRunChair(k) : cmtOfferAccept(a === "yes"); cmtCard(); const s = el("gcSay"); if(s) s.textContent = r; }));
  return null;
}
/* ══ 20261017e · THE ONE LAW: a single set of rules that every part of the world answers to, checked every morning; where two parts of the world disagree, the law decides and writes down what it mended ══ */
const LAW = {runs:0, mended:0, log:[], today:0};
const LAW_ARTICLES = [
  ["Persons", "Everyone is in one place at a time, and the place is a place that exists."],
  ["Measure", "Every quantity has a floor and a ceiling; a number that is not a number is mended, not believed."],
  ["Time", "The day and the hour move forward and never back."],
  ["Seats", "A chair is held by one person; a seat on a committee is a real committee."],
  ["Order", "A thing cannot be further along than what it was built from: the Engine is never past its own capability, and never wakes without the stage that wakes it."],
  ["Account", "What a machine burns, someone paid for: the Engine's power is drawn from the states' treasuries and written in a ledger."],
  ["Bodies", "Nobody runs without food or sleep: people tire through the day, hunger between meals, eat when they can, and are sharper fed and rested than not."],
  ["Heat", "Warmth goes from warm to cold and never the other way without work: a room left alone becomes the weather, and every degree held against it is fuel burned and paid for by the treasuries."],
  ["Discovery", "Nothing is found that the physics of the real universe forbids, and nothing it allows is barred from being found; every discovery waits for the ones before it, the tools to see it, and the work."]
];
function lawMend(art, text){ LAW.mended++; LAW.today++; LAW.log.unshift({d:G.day, a:art, t:text}); if(LAW.log.length > onumLim(40,"hist")) LAW.log.pop(); }
function lawAudit(){
  LAW.runs++; LAW.today = 0; const y = G.you; if(!y) return;
  const num = (o, k, lo, hi, who) => { if(o && typeof o[k] === "number" && (!isFinite(o[k]) || o[k] < lo || o[k] > hi)){ const was = o[k]; o[k] = isFinite(was) ? clamp(was, lo, hi) : (lo + hi) / 2; lawMend("Measure", (who === "Your" ? "Your " : (who || "A figure") + "'s ") + k + " was " + (isFinite(was) ? Math.round(was) : "not a number") + "; set to " + Math.round(o[k]) + "."); } };
  ["approval", "influence", "standing", "energy"].forEach(k => num(y, k, 0, 100, "Your"));
  const valid = new Set(COMMITTEES.map(c => c.k));
  (G.members || []).forEach(m => { if(!m) return;
    if(m.room !== undefined && m.room !== null && (typeof m.room !== "string" || m.room === "")){ lawMend("Persons", m.name + " was nowhere at all; sent home."); m.room = "away"; }   /* "away", "abroad", "delegation" and the rest are real places, even if they are not rooms you can walk into */
    ["x", "z", "tx", "tz"].forEach(k => { if(typeof m[k] === "number" && !isFinite(m[k])){ lawMend("Persons", m.name + " had no position; stood at the door."); m[k] = 0; } });
    if(m.cmte && !valid.has(m.cmte)){ const best = COMMITTEES[Math.abs(seedOf(String(m.id))) % COMMITTEES.length]; lawMend("Seats", m.name + " sat on a committee that does not exist; seated on " + best.t + "."); m.cmte = best.k; }
    if(m.kind !== "player" && m.rel) num(m.rel, "warmth", -100, 100, m.name); });
  if(y.committee && !valid.has(y.committee)){ lawMend("Seats", "You sat on a committee that does not exist; seated on " + COMMITTEES[0].t + "."); y.committee = COMMITTEES[0].k; }
  /* one chair, one holder */
  POSTS.forEach(P => { const held = (G.members || []).filter(m => m && m.post === P.k); const all = held.concat(y.post === P.k ? [y] : []);
    if(all.length > 1){ all.sort((a, b) => (b.influence || 0) - (a.influence || 0)); all.slice(1).forEach(h => { lawMend("Seats", "Two people held " + P.t + "; " + h.name + " stood down."); h.post = null; }); } });
  /* time */
  if(!isFinite(G.minute) || G.minute < 0 || G.minute > 24 * 60){ lawMend("Time", "The hour was " + G.minute + "; mended to 8:00."); G.minute = 8 * 60; }
  if(G.lawDay && G.day < G.lawDay){ lawMend("Time", "The day went back from " + G.lawDay + " to " + G.day + "; held at " + G.lawDay + "."); G.day = G.lawDay; } G.lawDay = G.day;
  /* discovery: nothing is settled before what it stands on */
  try{ const S = G.inq; if(S && S.v === 1) Object.keys(S.done).forEach(id => { const n = INQ_BY[id]; if(!n){ delete S.done[id]; return; } n.needs.forEach(x => { if(INQ_BY[x] && !S.done[x]){ S.done[x] = S.done[id]; lawMend("Discovery", n.name + " was settled before " + INQ_BY[x].name + "; the earlier one is set down as settled too."); } }); }); }catch(e){}
  /* the Engine */
  try{ const E = G.eng; if(E && E.v === 1){ num(E, "p", 0, E.scaleOpen ? 1e15 : 100, "The Engine"); num(E, "safety", 0, 100, "The Engine"); num(E, "compute", 0, E.scaleOpen ? 1e15 : 100, "The Engine"); if(E.scaleOpen) num(E, "talent", 0, 1e15, "The Engine"); const s = engStage(E); if(E.st < s - 0){ lawMend("Order", "The Engine's stage was behind its capability; brought up."); E.st = s; } if(E.agi && E.p < 90){ lawMend("Order", "The Engine was awake below the capability that wakes it; capability raised."); E.p = 90; } if(!E.agi && E.p > 89.5 && !inqDone("cs9")){ lawMend("Order", "The Engine was past the point of waking before the Republic had worked out how a machine plans; held at the threshold."); E.p = 89.5; E.st = engStage(E); }
      /* the account: power for the machines comes out of the states' treasuries */
      const O = orgEnsure(), draw = Math.max(0.2, (Math.min(E.compute, 100) * 0.05 + Math.log10(1 + Math.max(0, E.compute - 100)) * 0.8) + (E.st >= 4 ? 2 : 0)) * (E.pause && G.day < E.pause ? 0.1 : 1), sts = Object.keys(O.treas); if(sts.length){ let paid = 0; sts.forEach(n => { const share = draw * 60 / sts.length; const take = Math.min(share, Math.max(0, O.treas[n])); O.treas[n] -= take; paid += take; }); E.ledger = E.ledger || {paid:0, days:0}; E.ledger.paid += paid; E.ledger.days++; } } }catch(e){}
  try{ const A = G.adv; if(A && A.v === 1){ num(A, "p", 0, 100, "The rival"); num(A, "taint", 0, 100, "The rival"); num(A, "intel", 0, 100, "The rival"); num(A, "sec", 0, 100, "The rival"); } }catch(e){}
  try{ const O = orgEnsure(); Object.keys(O.treas).forEach(n => { if(O.treas[n] < 0){ lawMend("Measure", n + "'s treasury was below nothing; mended to nothing."); O.treas[n] = 0; } }); (G.states || []).forEach(S => num(S, "unrest", 0, 100, S.n)); }catch(e){}
}
function lawCard(){
  const E = G.eng && G.eng.v === 1 ? G.eng : null, L = E && E.ledger;
  govCardOpen("One rule for everything", "The Law", "Every part of this world answers to the same few rules, and checks itself each morning. Where two parts of the world disagree, the law decides and writes down what it mended.",
    LAW_ARTICLES.map((a, i) => '<div style="margin:6px 0;padding:4px 10px;border-left:3px solid var(--line-soft)"><b>' + (i + 1) + '. ' + pcEsc(a[0]) + '</b><div class="muted" style="font-size:13px">' + pcEsc(a[1]) + '</div></div>').join("") +
    (function(){ try{ const A = airStore(), T = A.T[G.room]; return '<p class="muted" style="font-size:13px">Here it is ' + (typeof T === "number" ? Math.round(T) : "?") + '\u00b0C against ' + Math.round(airOut()) + '\u00b0C outside. The buildings have burned ' + Math.round(A.fuel) + ' units of fuel, paid for by the states.</p>'; }catch(e){ return ''; } })() +
    '<p class="muted" style="font-size:13px">' + LAW.runs + ' morning check' + (LAW.runs === 1 ? '' : 's') + ' so far; ' + LAW.mended + ' thing' + (LAW.mended === 1 ? '' : 's') + ' mended.' + (L ? ' The Engine has drawn ' + Math.round(L.paid) + ' (in treasury money) of power from the states over ' + L.days + ' days.' : '') + '</p>' +
    (LAW.log.length ? '<div class="eyebrow">Last mended</div>' + LAW.log.slice(0, 6).map(x => '<div class="careerline"><b>d' + x.d + '</b> [' + pcEsc(x.a) + '] ' + pcEsc(x.t) + '</div>').join("") : '<p class="muted" style="font-size:13px">Nothing has needed mending.</p>'), null);
  return null;
}
/* ══ 20261017f · THE ACADEMY: everything people and organisms contemplate, from counting to quantum fields to what a mind is owed; nothing is forbidden that the physics of the real universe allows, and nothing is found without the work, the tools and the energy it takes ══ */
const INQ_F = {
  math:{t:"Mathematics", g:"STEM"}, phys:{t:"Physics", g:"STEM"}, chem:{t:"Chemistry and materials", g:"STEM"}, bio:{t:"Life sciences", g:"STEM"}, earth:{t:"Earth and cosmos", g:"STEM"}, cs:{t:"Computing and information", g:"STEM"}, eng:{t:"Engineering and invention", g:"STEM"},
  phil:{t:"Philosophy", g:"Mind and meaning"}, mind:{t:"Mind and cognition", g:"Mind and meaning"}, arts:{t:"Arts, religion and meaning", g:"Mind and meaning"},
  anth:{t:"Anthropology and language", g:"People and society"}, soc:{t:"Society, law and economy", g:"People and society"}
};
/* [id, field, name, kind (s science / i invention), needs, effort, what it is, the open question it answers or leaves] */
const INQ_N = [
  ["m1","math","Number and counting","s",[],1,"Tally, place value and arithmetic: the first compression of the world into symbols.","How many?"],
  ["m2","math","Geometry","s",["m1"],2,"Proof from axioms about points, lines and shapes.","What must be true of space, whatever we measure?"],
  ["m3","math","Algebra","s",["m1"],2,"Unknowns written as symbols, and the rules for moving them about.","Can the unknown be reasoned about before it is found?"],
  ["m4","math","Calculus","s",["m2","m3"],4,"Change and accumulation made exact: limits, derivatives, integrals.","How do we reason about what is changing?"],
  ["m5","math","Probability and statistics","s",["m3"],3,"Uncertainty given numbers; inference from samples.","What can many uncertain facts tell us together?"],
  ["m6","math","Linear algebra and vector spaces","s",["m3","m2"],3,"Many dimensions at once: the language of rotations, networks and states.","How do we hold a thousand quantities in one thought?"],
  ["m7","math","Formal logic and computability","s",["m3","p1"],5,"What a procedure is, and what no procedure can decide.","What can be settled by rule, and what never can?"],
  ["m8","math","Information theory","s",["m5","m7"],5,"Information as a measurable quantity, with limits on how well it can be sent or squeezed.","What is a message, in numbers?"],
  ["i_lens","eng","Lenses and spectacles","i",[],1,"Ground glass that bends light: sight made better, then extended.","Can the eye be helped?"],
  ["i_press","eng","The printing press","i",[],2,"Movable type: a book is no longer a rare object.","Can knowledge outrun the people who hold it?"],
  ["i_clock","eng","The pendulum clock","i",["m2"],2,"Time kept to the second, the first precise instrument.","Can time be measured evenly?"],
  ["i_pump","eng","The vacuum pump","i",["m2"],2,"A space with almost nothing in it, and the means to study the nothing.","What is left when the air is gone?"],
  ["i_micro","eng","The microscope","i",["i_lens"],2,"A small world, suddenly visible.","What are living things made of?"],
  ["i_tele","eng","The telescope","i",["i_lens"],2,"A far world, suddenly near.","What is up there?"],
  ["i_steam","eng","The steam engine","i",["i_pump"],3,"Heat made to push: the first engine that does not tire.","Can fire do the work of a hundred hands?"],
  ["i_batt","eng","The electric battery","i",["c1"],3,"A steady electric current from a chemical reaction.","Can charge be kept and moved?"],
  ["i_dyn","eng","The generator and motor","i",["ph4"],4,"Motion into current and back, which is power distributed anywhere there is a wire.","Can work be carried down a wire?"],
  ["i_tele2","eng","The electric telegraph","i",["ph4"],3,"A signal faster than any messenger.","How fast can a message go?"],
  ["i_tube","eng","The vacuum tube","i",["i_pump","ph4"],4,"An amplifier and a switch with no moving parts.","Can a signal be controlled by a signal?"],
  ["i_spec","eng","The spectroscope","i",["ph2","i_lens"],3,"Light split into lines, each element's signature.","What is a thing made of, from its light alone?"],
  ["i_xray","eng","The X-ray tube","i",["i_tube","ph5"],4,"A way to see the inside of things, and the structure of crystals.","Can we see through matter?"],
  ["i_cloud","eng","The cloud and bubble chamber","i",["ph3","i_pump"],4,"Tracks of single particles made visible.","Can we watch one atom's journey?"],
  ["i_acc","eng","The particle accelerator","i",["i_dyn","ph8"],7,"Machines that push particles close to the speed of light and break them to see inside.","What are the smallest things made of?"],
  ["i_em","eng","The electron microscope","i",["ph8","i_tube"],5,"Seeing with electrons: the molecule becomes a picture.","Can we see below the wavelength of light?"],
  ["i_trans","eng","The transistor","i",["ph12"],6,"A solid-state switch the size of a speck, and the root of every modern machine.","Can a switch be grown, not built?"],
  ["i_ic","eng","The integrated circuit","i",["i_trans","c5"],6,"Millions of switches on one chip of crystal.","Can a machine of a million parts be made in one go?"],
  ["i_laser","eng","The laser","i",["ph8","ph7"],6,"Light all in step: a ruler, a scalpel, a carrier of messages.","Can light be made to march?"],
  ["i_sc","eng","Superconducting magnets and circuits","i",["ph15"],6,"Electricity with no resistance, held in a cold coil.","Can a current run forever?"],
  ["i_ligo","eng","The interferometer for spacetime","i",["i_laser","ph9"],7,"A ruler long enough to feel a ripple in space itself.","Can we hear gravity?"],
  ["i_seq","eng","The DNA sequencer","i",["b6","i_laser"],5,"Reading the code of life at a price people can pay.","Can heredity be read like a book?"],
  ["i_qc","eng","Quantum processors","i",["ph16","i_sc"],8,"Machines whose parts keep a superposition long enough to compute with it.","Can a machine use the rules that atoms obey?"],
  ["ph1","phys","Classical mechanics","s",["m4","i_clock"],4,"Force, mass and motion: the same law for the apple and the planet.","Why does anything move as it does?"],
  ["ph2","phys","Optics and the wave nature of light","s",["m2","i_lens"],3,"Reflection, refraction, interference: light as a wave.","What is light?"],
  ["ph3","phys","Thermodynamics","s",["ph1","i_steam"],5,"Heat, work and entropy: what an engine can and can never do.","Why can heat not be turned entirely into work?"],
  ["ph4","phys","Electricity and magnetism","s",["ph1","i_batt"],4,"Charges, currents and fields, found to be two faces of one thing.","What is the force that moves the needle?"],
