      st.rec.length ? "Things you actually remember them saying: " + st.rec.slice(-3).map(x => typeof x === "string" ? x : (x.gist || x.fact || x.text || x.c || "")).filter(Boolean).join(" | ") + "." : "",
      (() => { const A = safe(() => W.onumAddressYou()); return A && A.title ? "The person in front of you is the " + A.title + (A.address ? "; address them as \"" + A.address + "\"" : "") + (A.home ? ". " + A.home + " is only their home district, not their jurisdiction" : "") + ". Mention their past offices only as history." : ""; })(),
      "Rules: no speeches, no stock openers, no example phrasing. You may disagree, dodge, ask back, interrupt, admit you don't know, or trail off.",
      "Only mention events from the memories above. Never invent who held an office or what happened before.",
