  }
  try{
    /* 20261005a: while walking, light/motes/fan every 8th draw — sky does not hitch feet. */
    const litStride = (Math.hypot(cam.vx || 0, cam.vz || 0) > 0.12) ? 7 : 1;
    if((FRAME_ID & litStride) === 0) updateLighting(dt);
