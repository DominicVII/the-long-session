      }
      return null;
    }catch(e){ return null; }
  };
  W.onumCandid.isStock = s => STOCK.test(String(s || "").trim());
})();
/* ---- end MARS ---- */
  const CD = window.NEPTUNE_CANDID = {n:0, live:0, off:0, rej:0, log:[]};
  const sv = f => { try{ return f(); }catch(e){ return null; } };
  const memStr = x => typeof x === "string" ? x : x ? (x.gist || x.text || x.c || "") : "";
  const memText = x => typeof x === "string" ? x : x ? (x.text || x.gist || x.c || "") : "";
  const STOCK = /^\s*(mr\.?|madam)\s+speaker\b|^\s*i rise\b|^\s*indeed\b|^\s*as you know\b|^\s*well,? well\b|^\s*my friend,|^\s*honou?red colleague/i;
  const norm = s => String(s || "").toLowerCase().replace(/[^a-z0-9 ]+/g, "").replace(/\s+/g, " ").trim();
  /* names the game knows: people, office holders, ledger, places */
  function known(){ const K = new Set();
    const add = s => { String(s || "").split(/\s+/).forEach(w => { if(w) K.add(w.replace(/[^A-Za-z'-]/g, "").toLowerCase()); }); };
    sv(() => everyone().forEach(p => p && add(p.name))); sv(() => G.you && add(G.you.name));
    sv(() => { const S = (window.ONUM_OFFICE_HISTORY || {}).seats || {}; Object.keys(S).forEach(k => { add(S[k].title); (S[k].holders || []).forEach(h => add(h.name)); }); });
    sv(() => (G.history || []).forEach(h => add(typeof h === "string" ? h : (h.t || h.text || h.name || "")))); sv(() => (G.presidents || []).forEach(h => add(h && h.name)));
    sv(() => { const R = window.ONUM_REGIONS || {}; Object.keys(R).forEach(k => add(R[k] && R[k].name)); });
    sv(() => { add(G.bill && G.bill.title); (G.bills || G.docket || []).forEach(x => add(x && (x.title || x.name))); const S = window.ONUM_SESSION || {}; add(S.floor); add(S.motion && (S.motion.title || S.motion.name)); (S.docket || S.queue || []).forEach(x => add(x && (x.title || x.name || x))); });
    sv(() => document.querySelectorAll(".ticker, #wire, .wire").forEach(e => add(e.textContent)));
