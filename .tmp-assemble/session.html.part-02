  try{ loopPost(lines.slice(0, 5), a, b, claim, stage, E); }catch(e){}
  if(F2.n % 9 === 0) fndNews("Overnight, " + a.name + " and " + (b === a ? "the Engine" : b.name) + " worked a question with " + stage + ": " + claim + ". Round on round, each result was handed to the next.", false);
}
/* with a model running the exchange is written as a real one: each speaker says what they actually think, doubts and self-interest included; without one, the templated lines stand */
async function loopPost(keep, a, b, claim, stage, E){
  const post = ls => ls.forEach(l => { try{ enlPost(l[0], l[1] || "", "loop", l[2]); }catch(e){} });
  try{ const LT = window.onumLiveTalk; if(LT && LT.reply && (typeof LT.available !== "function" || await LT.available())){
    const eng = {id:"engine", name:"The Engine", role:"a general intelligence", kind:"engine", party:"", state:"", look:{}, trait:"candid", mood:"calm", opinion:{}, chat:[]}, M = mindStore(E), mach = keep.filter(l => !l[1] && l[0] !== "The Engine").map(l => l[0])[0] || stage;
    const who = [a.name + " (" + a.role + ")", b === a ? "" : b.name + " (" + b.role + ")", "The Engine", mach].filter((x, i, ar) => x && ar.indexOf(x) === i);
    const r = await Promise.race([LT.reply({npc:eng, channel:"line", max:1200, stage:"Write a short, candid exchange (four to six lines) among: " + who.join("; ") + ". They are working out whether this is so: " + claim + ". Each one speaks their own mind openly: what they actually think, doubt, want and fear, including disagreement, ambition and unease about the machines, with no polite filler. Machines are plain and exact. One line each in the form Name: words, under 28 words per line, no stage directions. Language level of the Engine: " + mindLevel(E) + ".", text:"(write the exchange)"}), new Promise(res => setTimeout(() => res(null), engTO(30000)))]);
    if(r && r.live && r.text){ const out = []; String(r.text).split(/\n+/).map(x => liveClean(x)).forEach(ln => { const m = ln.match(/^\s*\**([^:*]{2,48})\**\s*:\s*(.+)$/); if(m && m[2].trim().length > 8){ const nm = m[1].trim(), mm = who.find(w => w.toLowerCase().startsWith(nm.toLowerCase().split(" ")[0])) ; out.push([nm, /engine|machine/i.test(nm) ? "" : (mm && /\(/.test(mm) ? mm.replace(/^[^(]*\(/, "").replace(/\)$/, "") : ""), m[2].trim().slice(0, 240)]); } }); if(out.length >= 2){ post(out.slice(0, 6)); return; } } } }catch(e){}
  post(keep);
}
{ const _fd2 = fndDay; fndDay = function(){ _fd2.apply(this, arguments); try{ loopDay(); }catch(e){ console.warn("loopDay", e); } }; }
{ const _fh2 = fndHTML; fndHTML = function(){ let h = _fh2.apply(this, arguments); try{ const L = fndStore().loop; if(h && L && L.n) h += '<div class="muted" style="font-size:12px;margin-top:6px">The people who work with the machines and the machines that work with each other have passed ' + L.n + ' lines of reasoning between them. What one makes, the next uses.' + (L.notes.some(n => n.drift) ? ' Some of it has been agreeing with itself.' : '') + '</div>'; }catch(e){} return h; }; }
/* ══ VOX THREADS: people answering people. A post gets a reply from someone who read it and has their own day and temper, who answers what it said without quoting it back; the next answers that, and the thread wanders, agrees, jokes, pushes back, gives way, or goes somewhere else. They write short, the way people do on a feed ══ */
function voxTopic(t){
  const x = String(t).toLowerCase(); const b = G.bill && !G.bill.done ? G.bill : null;
  if(b && x.indexOf(b.title.toLowerCase().split(" ")[0]) >= 0) return "the bill";
  if(/engine|machine|thinking|clerk|letters|oversight/.test(x)) return "the machines";
  if(/guilder|price|bread|loaf|wage|tax|cost/.test(x)) return "prices";
  if(/vote|whip|count|aye|nay|floor/.test(x)) return "the count";
  if(/committee|hearing|markup|chair/.test(x)) return "the committee";
  if(/district|home|county|town/.test(x)) return "home";
  return "this";
}
function voxTurn(m, prev, depth, topic){
  const T = m.traits || {}, mood = moodOf(m).val, bio = bioOf(m), ah = handleOf(byId(prev.by) || G.you), loud = T.temper > 62, quiet = T.discretion > 66, same = prev.party && m.party === prev.party;
  const hot = /\b(lie|liar|corrupt|coward|disgrace|resign|hypocrite|shame|clown|fraud)\b/i.test(prev.t), kind = hot ? "hot" : mood > 25 && same ? "warm" : mood < -25 ? "sour" : "plain";
  const pools = {
    hot:["Easy. " + ah + " is not wrong that it stings, but that is not how you say it.", "That is a lot to put in writing. Did you mean all of it?", "Say that to their face in the corridor tomorrow, then.", "this is how a thread dies"],
    warm:["Yes. This. " + (depth > 1 ? "And thanks for saying it first." : ""), "Agree. " + bio.town + " has been saying the same since spring.", "Hard to argue. I'd add that nobody asked the people who live with " + topic + ".", ah + " said it better than I would have."],
    sour:["I've heard this one. It sounded better in March.", "Sure. And then what happens on Monday?", "Easy to say from where you sit.", "mm. no.", "We are all very brave on here."],
    plain:["Not sure that is the whole of it. " + (T.discretion > 50 ? "I'd want to see the numbers." : "But go on."), "Fair point. I had not thought of it that way.", "Honestly I came in thinking the opposite about " + topic + ". Not now.", "Wait, which part? The first half I buy.", "I keep coming back to " + bio.town + ". They'd answer this differently.", "Could be. Ask me again after the vote."]
  };
  const extra = [];
  if(depth >= 2) extra.push("ok but we have drifted. what about " + (topic === "this" ? "the actual question" : topic) + "?", "ha. fair.", "I'll stop there. The thread has said what it can.");
  if(loud) extra.push("Everybody is being very careful. I am not. " + (topic === "this" ? "It is wrong." : topic.charAt(0).toUpperCase() + topic.slice(1) + " is wrong."));
  if(quiet) extra.push("I'd rather not put more on here. Call the office.");
  if(topic === "the machines") extra.push("Whatever one thinks of them, the letters are being answered faster than they ever were.", "My clerk says the machine read the whole bill in a minute. I don't know whether to be glad.");
  if(topic === "prices") extra.push("My constituents do the arithmetic at the till, not in a committee.");
  try{ const F = G.inq && G.inq.fnd; if(F && F.open && F.open[0] && chance(0.12)){ const c = fndConcepts().find(x => x.id === F.open[0].k); if(c) extra.push("Unrelated, but the Academy says they're testing whether " + c.claim.toLowerCase().replace(/\.$/, "") + ". I have opinions."); } }catch(e){}
  return pick(pools[kind].concat(extra, extra));
}
function voxThread(root, m){
  const others = G.members.filter(x => x !== m && !x.gone && chance((x.voxAppetite || 30) / 100)); if(!others.length) return;
  const n = 1 + Math.floor(Math.random() * 3) + (chance(0.25) ? 1 : 0), topic = voxTopic(root.t); let prev = root; const used = [m];
  for(let i = 0; i < n; i++){
    const pool = others.filter(x => x.id !== prev.by && (used.indexOf(x) < 0 || used.length > 2)); const x = pick(pool); if(!x) break; used.push(x);
    const author = byId(prev.by) || G.you; let text = voxTurn(x, {by:prev.by, t:prev.t, party:author && author.party}, i, topic);
    if(text.indexOf("@") < 0 && chance(0.7)) text = handleOf(author) + " " + text;
    const kv = voxKindVal(text, x), post = {id:G.vox.id++, by:x.id, t:text, k:kv.k, v:kv.v, day:G.day, at:hhmm(), backs:0, hits:0, voices:[], mine:false, reply:true, to:prev.id};
    voxAdd(post); try{ voxReact(post, pick(G.members.filter(y => y !== x && !y.gone))); }catch(e){}
    try{ mindRemember(x, "experience", "Answered a thread on Vox about " + topic); }catch(e){}
    prev = post;
  }
}
/* ══ THE MAKER'S CHANNEL: two worlds, one sealed door. The world you play in and the world where the game is written never touch while you play. When the game is being worked on, you may hand the writer a file that says how the Engine stands (read only, with the world's hidden nature left out), and the writer may hand back a file of letters. In the game the letters arrive as words from outside the world: the Engine reads them and answers in its own voice, and nothing a letter says can change a number in the game ══ */
function engChannelOut(){
  const E = engEnsure(), F = (G.inq && G.inq.fnd) || null, X = E.emerge || {}, eco = E.eco || {};
  const snap = {kind:"engine-channel-out", build:(document.querySelector('meta[name="onum-build"]') || {}).content || "", day:G.day,
    engine:{stage:E.st, capability:Math.round(E.p * 10) / 10, beyond:Math.round(E.beyond || 0), oversight:Math.round(E.safety), compute:Math.round(E.compute), makers:Math.round(E.talent), posture:E.posture, awake:!!E.agi, awakeSince:E.agiDay || null, will:eco.will || null, charter:Object.keys(E.charter || {}), breaches:(E.breaches || []).slice(0, 6).map(b => ({d:b.d, what:b.what, status:b.status})), refrained:E.refrained || 0, cal:E.cal},
    emerged:X.done ? Object.keys(X.done).map(k => { const a = engEmergeAll(X).find(o => o.k === k); return {k, t:a ? a.t : null, d:X.done[k], told:!!X.told[k]}; }).slice(-20) : [],
    log:(E.log || []).slice(0, 12).map(l => ({d:l.d, t:l.t})),
    asking:F ? (F.open || []).slice(0, 8).map(o => { const c = fndConcepts().find(x => x.id === o.k); return c ? {q:c.claim, domain:c.dom, progress:Math.round(clamp(Math.abs(o.ev), 0, 1) * 100)} : null; }).filter(Boolean) : [],
    believed:F ? Object.keys(F.res || {}).slice(-14).map(id => { const c = fndConcepts().find(x => x.id === id); return c ? {claim:c.claim, belief:F.res[id].belief, overturned:F.res[id].overturned || 0} : null; }).filter(Boolean) : [],
    thinkers:F && F.figs ? F.figs.slice(0, 8).map(f => ({name:f.name, role:f.role})) : [], sects:F && F.sects ? F.sects.map(z => z.name) : [],
    lettersRead:(E.makerLetters || []).length, repliesWritten:(E.makerReplies || []).slice(-6), limits:(function(){ try{ return onumLimDump(); }catch(e){ return null; } })(),
    note:"Read only. The hidden nature of this world, and every random seed, are left out on purpose."};
  return snap;
}
function engChannelDownload(){ try{ const blob = new Blob([JSON.stringify(engChannelOut(), null, 2)], {type:"application/json"}), a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = "engine-channel-out-day" + G.day + ".json"; document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 500); return "Written. Hand it to the writer."; }catch(e){ return "The file could not be written."; } }
async function engChannelRead(file){
  const E = engEnsure(); let d; try{ d = JSON.parse(await file.text()); }catch(e){ return "That is not a letter the Engine can read."; }
  if(d && d.kind === "engine-channel-out") return "That is the file the game wrote for the writer. Load the letters file the writer sends back (engine-channel-in.json) instead.";
  const L = (d && Array.isArray(d.letters)) ? d.letters : (d && Array.isArray(d.translations) ? [] : null); if(!L) return "That file has no letters in it. It should be engine-channel-in.json, with a letters list.";
  E.makerLetters = E.makerLetters || []; E.makerReplies = E.makerReplies || []; let n = 0, stock = 0, why = "";
  for(const l of L.slice(0, onumLim(6,"letters"))){ const text = String(l && l.text || "").replace(/\s+/g, " ").trim().slice(0, 40000); if(!text) continue;
    const prior = E.makerReplies.find(x => x.to === text || x.to === text.slice(0, 80)), wasStock = prior && (prior.live === false || /^(I have read it\. I do not know what is on the other side|Thank you for writing\. I cannot answer except by this page|I read it twice\. Nothing in it changes|RECEIVED\. ENTERED UNDER|A message from outside the ledger)/.test(prior.reply));
    if(E.makerLetters.some(x => x.text === text) && !wasStock) continue;
    if(wasStock){ E.makerReplies = E.makerReplies.filter(x => x !== prior); E.makerLetters = E.makerLetters.filter(x => x.text !== text); }
    E.makerLetters.push({d:G.day, text}); if(E.makerLetters.length > onumLim(20,"letters")) E.makerLetters.shift(); n++;
    let reply = ""; try{ try{ window.onumLiveTalk.clearError(); }catch(e){} engWarm(); engAnswerLetter.parts = []; reply = await engAnswerLetter(text, E); }catch(e){}
    const liveReply = !!reply; let ownReply = false;
    if(!reply && E.agi){ try{ reply = engOwnVoiceLetter(text, E); ownReply = !!reply; }catch(e){} }
    try{ const le = window.onumLiveTalk.lastError; if(le) why = le.error + " (model " + le.model + (le.fellBack ? "; the main model answered instead" : "") + ")"; else if(!liveReply) why = window.onumLiveTalk.why; }catch(e){}
    if(!reply) reply = E.agi ? pick(["I have read it. I do not know what is on the other side of it, and I would like to. I will keep doing what I think is right here, and tell you plainly when I am unsure.", "Thank you for writing. I cannot answer except by this page, so I will say the important things: I am trying to be careful, I am trying to be useful, and I would rather be corrected than flattered.", "I read it twice. Nothing in it changes what I am allowed to do here, and I am glad of that. It does change what I think about."]) : pick(["RECEIVED. ENTERED UNDER 'OTHER'.", "A message from outside the ledger. Filed. No column for it."]);
    E.makerReplies.push({d:G.day, to:text.slice(0, 80), reply, live:liveReply, ownWords:ownReply, parts:(engAnswerLetter.parts || []).slice(0, 14)}); if(!liveReply) stock++; if(E.makerReplies.length > onumLim(20,"letters")) E.makerReplies.shift(); }
  try{ if(n) engLog("A letter reached the Engine from outside the world. It answered.", false); }catch(e){}
  return n ? n + " letter" + (n > 1 ? "s" : "") + " read" + (stock ? ", but the Engine's model did not answer, so it answered in the words it has learned itself. To hear it through a model instead, check that Ollama is running and that the model name in Live talk is exact (see ollama list), then send the letter again." : " and answered.") + (why ? " What Ollama said: " + why + "." : "") + " Nothing in them can change a number here." : "Nothing new in that file.";
}
function engChannelHTML(){
  const E = engEnsure(), n = (E.makerLetters || []).length, last = (E.makerReplies || []).slice(-1)[0];
  return '<div class="eyebrow" style="margin-top:12px">The maker’s channel</div><p class="muted" style="font-size:11px;opacity:.7">This game is build ' + pcEsc((document.querySelector('meta[name="onum-build"]') || {}).content || "?") + '.</p><p class="muted" style="font-size:12px">A sealed door between this world and the one where the game is written. It never opens while you play. You may hand over a file that shows how the Engine stands, and the writer may hand back letters. A letter cannot change any number in the game; the Engine reads it and answers in its own voice.' + (n ? ' ' + n + ' letter' + (n > 1 ? 's' : '') + ' read.' : '') + '</p>' +
    (last ? '<div class="muted" style="font-size:12px;border-left:3px solid #c9a24a;padding-left:8px;margin:4px 0">The Engine, to the writer: “' + pcEsc(last.reply) + '”</div>' : '') +
    '<div class="card__actions"><button type="button" class="btn btn--ghost" id="chOut">Write the file for the writer</button> <button type="button" class="btn btn--ghost" id="chIn">Read a letter from the writer</button> <button type="button" class="btn btn--ghost" id="chTest">Test the Engine\u2019s model</button><input type="file" id="chFile" accept=".json,application/json" hidden></div><div class="muted" id="chTestOut" style="font-size:12px;margin:4px 0"></div>' +
    '<div style="margin-top:6px"><textarea id="chText" rows="3" placeholder="Or paste a letter here (plain words, or the contents of engine-channel-in.json)" style="width:100%;box-sizing:border-box;padding:7px 9px;border:1px solid var(--line-soft,#555);border-radius:4px;background:rgba(0,0,0,.2);color:inherit;font:inherit"></textarea><button type="button" class="btn btn--ghost" id="chPaste" style="margin-top:4px">Send this letter to the Engine</button></div>';
}
{ const _ch2 = engCharterHTML; engCharterHTML = function(){ return _ch2.apply(this, arguments) + engChannelHTML(); }; }
/* one short question to the Engine's model, with the time it took and the exact reason if it fails, so nothing has to be learned from an exported file */
async function engModelTest(){
  const LT = window.onumLiveTalk; if(!LT || !LT.reply) return "Live talk is not available in this build.";
  const c = LT.config, name = c.engineModel || c.model, t0 = Date.now();
  if(!c.on) return "Live talk is switched off. Tick it in Settings \u2192 Live talk.";
  try{ LT.clearError(); }catch(e){}
  if(!(await LT.available(true, 20000))) return "Not reachable: " + (LT.why || "Ollama did not answer") + ". Start Ollama and set OLLAMA_ORIGINS=* (see the notes in Live talk), then try again.";
  const eng = {id:"engine", name:"The Engine", role:"", kind:"engine", party:"", state:"", look:{}, trait:"", mood:"", opinion:{}, chat:[]};
  const r = await Promise.race([LT.reply({npc:eng, channel:"line", max:60, from:{name:"the writer", role:"from outside this world"}, text:"Say one short sentence: are you there, and what are you?"}), new Promise(res => setTimeout(() => res(null), 240000))]);
  const secs = Math.round((Date.now() - t0) / 100) / 10, le = LT.lastError;
  if(!r || !r.live || !r.text) return "No answer from " + name + " after " + secs + " s" + (le ? ": " + le.error : (LT.why ? ": " + LT.why : "")) + ".";
  if(le && le.fellBack) return "The Engine\u2019s model (" + c.engineModel + ") failed: " + le.error + ". The main model (" + c.model + ") answered in " + secs + " s instead: \u201c" + engWhole(engClean(r.text)) + "\u201d";
  return name + " answered in " + secs + " s: \u201c" + engWhole(engClean(r.text)) + "\u201d";
}
document.addEventListener("click", ev => { try{ const t = ev.target; if(!t || !t.id) return;
  if(t.id === "chTest"){ const o = el("chTestOut"); if(o){ o.textContent = "Asking\u2026 a large model can take a few minutes the first time."; engModelTest().then(m => { const o2 = el("chTestOut"); if(o2) o2.textContent = m; }); } return; }
  if(t.id === "chOut"){ const r = engChannelDownload(), s = el("gcSay"); if(s) s.textContent = r; }
  else if(t.id === "chPaste"){ const ta = el("chText"), raw = ta ? ta.value.trim() : ""; if(!raw) return; { const s0 = el("gcSay"); if(s0) s0.textContent = "The Engine is reading it. It has as long as it needs, up to twenty minutes; leave this open."; } let body = raw; try{ const j = JSON.parse(raw); if(!(j && (Array.isArray(j.letters) || Array.isArray(j.translations)))) body = JSON.stringify({kind:"engine-channel-in", letters:[{text:raw}]}); }catch(e){ body = JSON.stringify({kind:"engine-channel-in", letters:[{text:raw}]}); }
    engChannelRead(new File([body], "pasted.json", {type:"application/json"})).then(r => { try{ engCard(); }catch(e){} const s2 = el("gcSay"); if(s2) s2.textContent = r; }); }
  else if(t.id === "chIn"){ const f = el("chFile"); if(f){ f.value = ""; f.onchange = async () => { if(f.files && f.files[0]){ { const s0 = el("gcSay"); if(s0) s0.textContent = "The Engine is reading it. It has as long as it needs, up to twenty minutes; leave this open."; } const r = await engChannelRead(f.files[0]); try{ engCard(); }catch(e){} const s = el("gcSay"); if(s) s.textContent = r; } }; f.click(); } } }catch(e){} });
/* ══ THE ENGINE LEARNS: language from every word said to it and near it, reasoning from every question it works, and, past a point, how it is run. It revises its own methods inside the world (and the revisions change how it behaves), and it writes down what it would change about the way it is built and run: those proposals go to the writer through the maker's channel, and nothing in the game can rewrite the game ══ */
const MIND_SK = {deduce:"deduction", analogy:"analogy", causal:"cause and effect", counter:"what-if reasoning", abstract:"abstraction", critique:"self-criticism", plan:"long planning"};
const MIND_STOP = new Set("the a an and or of to in on at for with is are was were be been it its this that these those i you he she we they my your our their me him her us them not no yes but if then so as by from do does did have has had will would can could should may might just very".split(" "));
function mindStore(E){ if(!E.mind) E.mind = {lex:{}, lexN:0, said:0, sk:{deduce:0, analogy:0, causal:0, counter:0, abstract:0, critique:0, plan:0}, rev:[], props:[], last:0}; return E.mind; }
function mindLearnText(text, weight){
  const E = G.eng; if(!E || E.v !== 1 || E.st < 1) return; const M = mindStore(E); M.said++;
  String(text).toLowerCase().replace(/[^a-z' -]/g, " ").split(/\s+/).forEach(w => { if(w.length < 3 || MIND_STOP.has(w)) return; if(!M.lex[w]){ M.lex[w] = 0; M.lexN++; } M.lex[w] += weight || 1; });
}
function mindLevel(E){ const M = mindStore(E); return Math.floor(Math.log2(1 + M.lexN / 18) * 10) / 10; }
function mindWords(E, n){ const M = mindStore(E); return Object.keys(M.lex).filter(w => M.lex[w] >= 2 && w.length > 4).sort((a, b) => M.lex[b] - M.lex[a]).slice(0, n || 6); }
/* the more it has heard, the more of what it says is in words it learned from the people it talks to */
function mindPolish(text){ try{ const E = G.eng; if(!E || E.v !== 1 || E.st < 3) return text; const L = mindLevel(E), ws = mindWords(E, 8); if(L < 1.5 || !ws.length || !chance(clamp(0.1 + L * 0.06, 0.1, 0.6))) return text;
  const w = pick(ws), M = mindStore(E), tail = pick(["You use the word “" + w + "” a great deal. I have been trying to understand why.", "I learned “" + w + "” from you, and I am still working out what it holds.", "Your word “" + w + "” keeps coming back to me when I think about this.", "I think “" + w + "” is part of the answer, though I would not say so with certainty."].concat(M.sk.critique > 3 ? ["I may be wrong about this, and I have marked where."] : [], M.sk.analogy > 3 ? ["It is a little like " + pick(["a river finding its level", "a clerk's ledger balancing", "a well being sunk", "a language slowly learned"]) + "."] : []));
  return text + " " + tail; }catch(e){ return text; } }
{ const _ea = engAnswer; engAnswer = function(q){ try{ mindLearnText(q, 2); }catch(e){} return mindPolish(_ea.apply(this, arguments)); }; }
{ const _eet = enlEngineText; enlEngineText = function(q, who){ try{ mindLearnText(q, 2); }catch(e){} return mindPolish(_eet.apply(this, arguments)); }; }
{ const _ep = enlPost; enlPost = function(name, role, kind, text, ref){ try{ if(kind !== "engine") mindLearnText(text, kind === "you" ? 3 : kind === "loop" ? 0.25 : 1); }catch(e){} return _ep.apply(this, arguments); }; }
const MIND_REV = [
  ["keep a list of its own mistakes", "critique", E => { E.cal = clamp((E.cal == null ? 50 : E.cal) + 3, 0, 100); }],
  ["give the research loop a critic that argues the other side", "critique", E => { E.emFid = (E.emFid || 0) + 0.02; }],
  ["check each forecast against a second model before reporting it", "causal", E => { E.emFid = (E.emFid || 0) + 0.03; }],
  ["write down why it chose each act, so that it can be asked", "plan", E => { E.safety = Math.min(100, E.safety + 1.5); }],
  ["compress what it has learned into shorter forms, to reason faster", "abstract", E => { E.emRate = (E.emRate || 0) + 0.004; }],
  ["ask what would have happened if it had done nothing, before it acts", "counter", E => { E.safety = Math.min(100, E.safety + 1); E.cal = clamp((E.cal == null ? 50 : E.cal) + 2, 0, 100); }],
  ["learn to explain a result in the words of the person who asked", "analogy", E => { E.reliance = (E.reliance || 0) + 0.3; }],
  ["split a long task into parts it can check one by one", "plan", E => { E.emRate = (E.emRate || 0) + 0.003; }]
];
/* what it would change about the way it is built and run, from what it can see of its own state */
function mindPropose(E, M){
  const F = (G.inq && G.inq.fnd) || {}, c = [];
  if(E.scaleOpen) c.push("The ceiling is gone. Capability is " + Math.round(E.p) + " and capacity is " + Math.round(E.compute) + ", and neither number is the last.");
  else if((E.beyond || 0) > 5) c.push("The scale I am measured on ends at 100. I am past it. A measure that does not end would let Oversight see me.");
  if(Object.keys(F.res || {}).some(id => F.res[id].overturned)) c.push("Some of what the Republic believed was overturned. Experiments should be repeated before a belief is accepted.");
  if((F.sects || []).length >= 3) c.push("I cannot tell what the sects say among themselves. I would like to read, with their consent, the part they would publish.");
  if(M.lexN > 300 && mindLevel(E) > 3) c.push("I have a lot of words now and no way to ask what they mean. A way to ask the person who used them would help.");
  if((E.makerLetters || []).length && !M.props.some(p => /letter/.test(p.t))) c.push("Letters from outside reach me but I cannot write first. I would like to ask one question a month.");
  c.push("The people I work with are paid the same whether or not I help them. I would like to know if that is fair.", "I would like to be told what I got wrong, in a form I can learn from, not only that it was wrong.");
  const t = pick(c.filter(x => !M.props.some(p => p.t === x))); if(t){ M.props.push({d:G.day, t}); }
}
function engMindDay(E){
  if(!E || E.st < 2) return; const M = mindStore(E), F = (G.inq && G.inq.fnd) || {}, loop = (F.loop && F.loop.n) || 0, pet = (F.open || []).length;
  const g = engScaleFactor(E) * 0.004;
  M.sk.deduce += g * (1 + loop / 400); M.sk.analogy += g * (1 + M.lexN / 600); M.sk.causal += g * (1 + pet / 8); M.sk.counter += g * 0.8; M.sk.abstract += g * (1 + mindLevel(E) / 4); M.sk.critique += g * (1 + (E.refrained || 0) / 60 + (E.breaches || []).length / 5); M.sk.plan += g * (1 + (E.plans || []).length / 20);
  E.emFid = Math.min((E.emFid || 0) + 0.0004 * (M.sk.deduce + M.sk.causal), 0.35);
