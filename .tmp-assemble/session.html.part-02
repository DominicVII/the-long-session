    return r;
  });
  setInterval(() => { try{ if(!PROC.on && el("clTx") && !el("clTx").hidden) paintTx(); }catch(e){} }, 1000);
  /* ── universal name cards: hover or tap any name link (people, parties, states, committees) ── */
  function stDef(n){ try{ return STATE_DEF.find(s => s.n === n) || null; }catch(e){ return null; } }
  function regionOf(n){
    const s = stDef(n); if(!s) return "";
    let cMax = 0, rMax = 0; STATE_DEF.forEach(x => { cMax = Math.max(cMax, x.col); rMax = Math.max(rMax, x.row); });
    const ns = s.row <= rMax / 3 ? "North" : s.row >= rMax * 2 / 3 ? "South" : "Central", ew = s.col <= cMax / 3 ? "west" : s.col >= cMax * 2 / 3 ? "east" : "";
    return ns + (ew ? "-" + ew : "") + (s.cult ? " · " + s.cult.charAt(0).toUpperCase() + s.cult.slice(1) + " country" : "");
  }
  function locator(n){
    try{
      const s = stDef(n); if(!s) return "";
      const k = 9;
      return '<svg width="120" height="80" viewBox="-2 -2 ' + (Math.max(...STATE_DEF.map(x => x.col)) * k + k + 4) + ' ' + (Math.max(...STATE_DEF.map(x => x.row)) * k + k + 4) + '" style="float:right;margin:0 0 4px 8px;background:#efe8d6;border-radius:4px">' +
        STATE_DEF.map(x => '<rect x="' + x.col * k + '" y="' + x.row * k + '" width="' + (k - 1) + '" height="' + (k - 1) + '" fill="' + (x.n === n ? "#b0473c" : "#c9bfa6") + '"><title>' + esc(x.n) + '</title></rect>').join("") + '</svg>';
    }catch(e){ return ""; }
  }
  function rel(m){ try{ const w = Math.round(m.rel.warmth), t = Math.round(m.rel.trust); return (w > 40 ? "Close ally" : w > 15 ? "Friendly" : w < -40 ? "Enemy" : w < -15 ? "Cool toward you" : "Neutral") + " (warmth " + w + ", trust " + t + ")"; }catch(e){ return "—"; } }
  function stance(m){ const b = billNow(); if(!b) return "No bill on the paper"; try{ const v = memberVote(m, b); return b.title + ": " + (v > 0 ? "leaning AYE" : v < 0 ? "leaning NO" : "undecided") + (m.pledge ? " (pledged to you)" : ""); }catch(e){ return "—"; } }
  function wants(m){ try{ return (m.intent && m.intent.t) || m.need || m.hope || "—"; }catch(e){ return "—"; } }
  function sumRow(k, v){ return '<div style="display:flex;gap:6px;font:12px/1.35 system-ui;margin:1px 0"><b style="min-width:92px;color:#6a5f46">' + k + '</b><span>' + v + '</span></div>'; }
  function nameSummary(kind, key){
    try{
      if(kind === "who"){
        const m = byId(isNaN(+key) ? key : +key); if(!m || m === G.you) return "";
        if(m.kind && m.kind !== "member") return '<div class="cl-sum">' + sumRow("Who", esc(m.role || m.kind)) + sumRow("Relationship", rel(m)) + sumRow("Wants", esc(wants(m))) + '</div>';
        const cm = (() => { try{ return (COMMITTEES.filter(c => (m.committees || []).includes(c.k) || m.committee === c.k).map(c => c.t).join(", ")); }catch(e){ return ""; } })();
        return '<div class="cl-sum">' + locator(m.state) + sumRow("Party", esc(partyLabel(m.party))) + sumRow("Home", esc(m.state) + " " + esc(m.dist) + (regionOf(m.state) ? " — " + esc(regionOf(m.state)) : "")) +
          sumRow("Role / seat", esc((m.post ? postTitle(m.post) + ", " : "") + "Member for " + m.state + " " + m.dist + (cm ? "; " + cm : ""))) +
          sumRow("On your bill", esc(stance(m))) + sumRow("With you", esc(rel(m))) + sumRow("What they want", esc(wants(m))) + '<div style="clear:both"></div></div>';
      }
      if(kind === "state"){
        const s = stDef(key); if(!s) return "";
        const ms = (G.members || []).filter(m => !m.gone && m.state === key && m.kind !== "press" && m.kind !== "civ");
        const b = billNow(); const ay = b ? ms.filter(m => { try{ return memberVote(m, b) > 0; }catch(e){ return false; } }).length : 0;
        const st = (G.states || []).find(x => x.n === key);
        return '<div class="cl-sum">' + locator(key) + sumRow("What", "A state of the Republic, " + s.seats + " seats") + sumRow("Region", esc(regionOf(key))) +
          sumRow("Delegation", ms.length + " members you know of" + (ms.length ? " (" + esc([...new Set(ms.map(m => partyLabel(m.party)))].join(", ")) + ")" : "")) +
          (b ? sumRow("On your bill", ay + " of " + ms.length + " leaning aye") : "") + sumRow("With you", key === (G.you && G.you.state) ? "Your home state" : "—") +
          sumRow("What it wants", esc(st && st.unrest > 55 ? "Relief: unrest is at " + Math.round(st.unrest) : s.note || "—")) + '<div style="clear:both"></div></div>';
      }
      if(kind === "party"){
        const ms = (G.members || []).filter(m => !m.gone && m.party === key);
        const b = billNow(); const ay = b ? ms.filter(m => { try{ return memberVote(m, b) > 0; }catch(e){ return false; } }).length : 0;
        let line = ""; try{ if(b){ const pl = partyLine(b)[key]; line = pl > 0 ? "Whipped AYE" : pl < 0 ? "Whipped NO" : "Free vote"; } }catch(e){}
        return '<div class="cl-sum">' + sumRow("What", "A party (faction) in the House") + sumRow("Seats", esc(G.seatsBy && G.seatsBy[key] != null ? G.seatsBy[key] : ms.length)) +
          (b ? sumRow("On your bill", esc((line ? line + "; " : "") + ay + " of " + ms.length + " leaning aye")) : "") +
          sumRow("With you", G.you && G.you.party === key ? "Your party — the whip expects your vote" : "Another party") +
          sumRow("What it wants", esc((() => { try{ return partyLore(key).creed; }catch(e){ return "—"; } })())) + '</div>';
      }
    }catch(e){}
    return "";
  }
  wrap("tipHTML", () => tipHTML, f => { tipHTML = f; }, orig => function(kind, key){
    if(kind === "committee"){
      try{ const c = COMMITTEES.find(x => x.k === key || x.t === key); if(c){ const ms = (G.members || []).filter(m => !m.gone && ((m.committees || []).includes(c.k) || m.committee === c.k));
        return '<div class="tip__t">' + esc(c.t) + ' Committee</div><div class="cl-sum">' + sumRow("What", "A standing committee: it holds hearings and marks up bills in its field before the floor sees them") +
          sumRow("Field", esc({econ:"Money, tax and trade", lib:"Courts, rights and policing", def:"Defence and the services", wel:"Welfare, health and schools"}[c.axis] || c.axis)) +
          sumRow("Members", ms.length ? ms.slice(0, 8).map(m => tipName(m)).join(", ") : "—") + sumRow("With you", "Hearings here are where you can press witnesses and shape the bill") + '</div>'; } }catch(e){}
    }
    const base = orig.apply(this, arguments);
    const s = nameSummary(kind, key);
    if(!s) return base;
    const i = base.indexOf("</div>", base.indexOf("tip__s") > 0 ? base.indexOf("tip__s") : 0);
    return i > 0 ? base.slice(0, i + 6) + s + base.slice(i + 6) : s + base;
  });
  /* hover opens the same card (tap/click already does) */
  let hovT = 0, hovEl = null;
  document.addEventListener("mouseover", ev => {
    try{
      const t = ev.target && ev.target.closest ? ev.target.closest("[data-tipk]") : null;
      if(!t || t === hovEl) return; hovEl = t; clearTimeout(hovT);
      hovT = setTimeout(() => { try{ if(hovEl === t && t.matches(":hover")) openTip(t.getAttribute("data-tipk"), t.getAttribute("data-tipv")); }catch(e){} }, 380);
    }catch(e){}
  });
  document.addEventListener("mouseout", ev => { try{ if(hovEl && ev.target && ev.target.closest && ev.target.closest("[data-tipk]") === hovEl) hovEl = null; }catch(e){} });
  /* make names in plain text clickable: transcripts, notices, explainer, mail and Wire text we render */
  function linkify(html){
    try{
      const pats = [];
      (G.members || []).forEach(m => { if(!m.gone && m.name && m !== G.you) pats.push([m.name, tipAttr("who", m.id)]); });
      (STATE_DEF || []).forEach(s => pats.push([s.n, tipAttr("state", s.n)]));
      try{ partyKeys().forEach(k => pats.push([partyLabel(k), tipAttr("party", k)])); }catch(e){}
      (COMMITTEES || []).forEach(c => pats.push([c.t, tipAttr("committee", c.k)]));
      pats.sort((a, b) => b[0].length - a[0].length);
      const done = {};
      return html.replace(/(<[^>]+>)|([^<]+)/g, (all, tag, txt) => {
        if(tag) return tag;
        pats.forEach(([n, a]) => { if(done[n] > 3) return; const ix = txt.indexOf(n); if(ix < 0) return; done[n] = (done[n] || 0) + 1;
          txt = txt.split(n).join("\u0001" + pats.indexOf(pats.find(p => p[0] === n)) + "\u0002"); });
        return txt.replace(/\u0001(\d+)\u0002/g, (_, i) => '<span' + pats[+i][1] + '>' + pats[+i][0] + '</span>');
      });
    }catch(e){ return html; }
  }
  CL.linkify = linkify;
  /* speakers in the transcript are surnames: link them to the member */
  function whoLink(who){ try{ const base = String(who).replace(/ \(chair\)$/, ""); const m = speakerOf(base) || (G.members || []).find(x => !x.gone && surname(x.name) === base); return m ? '<span' + tipAttr("who", m.id) + '>' + esc(who) + '</span>' : esc(who); }catch(e){ return esc(who); } }
  CL.whoLink = whoLink;
  /* the Wire, mail and panels: decorate names in any text node that appears there */
  /* Wire, mail, panes, dialogue, prompts and choices: names become quiet links (no restyling) */
  const LINK_ROOTS = ["#wire", "#paneFloor", "#paneMembers", "#paneInbox", "#paneVox", "#paneBook", "#paneJournal", "#paneRisks", "#talk", "#card", "#procBar", "#procLog"];
  function subtle(h){ return h.replace(/ class="tipword"/g, ' class="cl-nl"'); }
  function linkNode(root){
    try{
      if(!root || root._clLinking) return; root._clLinking = true;
      const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null), nodes = [];
      while(w.nextNode()){ const n = w.currentNode; if(n.parentElement && !n.parentElement.closest("[data-tipk],input,textarea,select,script,style,.cl-card,#clPanel") && n.nodeValue.trim().length > 3){ const bt = n.parentElement.closest("button,[data-join],[role=button]"); if(bt && bt.textContent.trim().length < 48) continue; nodes.push(n); } }
      nodes.slice(0, 300).forEach(n => { const e0 = esc(n.nodeValue), h = linkify(e0); if(h !== e0){ const s = document.createElement("span"); s.style.cssText = "all:inherit;display:inline"; s.innerHTML = subtle(h); n.parentNode.replaceChild(s, n); } });
    }catch(e){} finally { if(root) setTimeout(() => { root._clLinking = false; }, 0); }
  }
  const pend = new Set(); let pendT = 0;
  function queue(r){ pend.add(r); if(!pendT) pendT = setTimeout(() => { pendT = 0; pend.forEach(x => linkNode(x)); pend.clear(); }, 150); }
  function observeRoots(){ LINK_ROOTS.forEach(sel => { const r = document.querySelector(sel); if(r && !r._clObs){ r._clObs = true; try{ new MutationObserver(() => { if(!r._clLinking) queue(r); }).observe(r, {childList:true, subtree:true, characterData:true}); }catch(e){} queue(r); } }); }
  observeRoots(); setInterval(observeRoots, 4000);
  /* a name inside a choice button opens its card and does NOT pick the choice */
  const nlHit = ev => { const t = ev.target && ev.target.closest ? ev.target.closest(".cl-nl[data-tipk]") : null; if(!t) return null; ev.preventDefault(); ev.stopPropagation(); if(ev.stopImmediatePropagation) ev.stopImmediatePropagation(); return t; };
  window.addEventListener("click", ev => { const t = nlHit(ev); if(t) try{ openTip(t.getAttribute("data-tipk"), t.getAttribute("data-tipv")); }catch(e){} }, true);
  ["mousedown", "mouseup", "pointerdown", "pointerup", "touchend"].forEach(k => window.addEventListener(k, ev => { nlHit(ev); }, true));
  CL.linkNode = linkNode;
  /* ── INBOX: sections, Read all, scroll kept, side reading pane, cables with nuance and stacking ── */
  const REGIME = {reach:"grain monarchy (a king and a council of granaries)", horn:"merchant league (the ports elect a doge)", pale:"military regency", marches:"confederal republic of free towns", isles:"island thalassocracy", rift:"council of mountain clans"};
  const SECS = [["const","Constituents"],["party","Party and Whip"],["coll","Colleagues"],["cmte","Committees"],["lobby","Lobby and Interest Groups"],["press","Press"],["cable","Foreign Cables"],["staff","Staff and Admin"]];
  CL.inboxOpen = LS("inboxOpen") || {}; CL.mailSel = null;
  function mailSec(x){
    try{
      if(x.kind === "cable") return "cable"; if(x.kind === "intel") return "staff";
      const m = x.fromId != null ? byId(x.fromId) : null, s = (x.subject + " " + x.from).toLowerCase();
      if(x.kind === "press" || (m && m.kind === "press") || /press|gazette|herald|courier|editor/.test(s)) return "press";
      if(/lobby|donor|association|guild|union|council|bureau|chamber of/.test(s) || (m && m.kind === "lobby")) return "lobby";
      if(x.kind === "witness" || /committee|hearing|markup|subpoena/.test(s)) return "cmte";
      if(x.kind === "fan" || (m && m.kind === "civ") || /constituent|district|town|county|widow|resident/.test(s)) return "const";
      if(m && (m.post === "whip" || m.post === "leader" || /whip/.test(s)) || x.kind === "vote" || /party|caucus|whip/.test(s)) return "party";
      if(m) return "coll";
      return "staff";
    }catch(e){ return "staff"; }
  }
  /* foreign people always have real names and titles: one head of mission per realm, drawn deterministically
     from the realm's own name pool (FOREIGN_NAMES), titled by its regime, kept on the realm in the save */
  const ENVOY_T = {reach:"Ambassador", horn:"Consul-General", pale:"Colonel-Attaché", marches:"Minister Plenipotentiary", isles:"High Commissioner", rift:"Chargé d'affaires"};
  function envoyOf(r){
    try{ if(typeof r === "string"){ realmEnsure(); r = (G.realms || []).find(x => x.k === r || x.t === r); } if(!r) return null;
      if(!r.envoy || !r.envoy.name){ let h = 2166136261; for(const c of "envoy|" + r.k + "|" + (G.country || "")){ h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); }
        let a = h >>> 0; const rn = () => { a = (a + 0x6D2B79F5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
        let name = ""; try{ name = foreignName(rn, r.k); }catch(e){} if(!name) name = "Anouk Verhoeven";
        const title = ENVOY_T[r.k] || "Ambassador"; r.envoy = {name, title, full:title + " " + name + " of " + r.t}; }
      return r.envoy; }catch(e){ return null; }
  }
  CL.envoyOf = envoyOf; window.onumForeignEnvoy = envoyOf;
  function realmOf(x){ try{ realmEnsure(); return (G.realms || []).find(r => x.from === "Mission of " + r.t || (r.envoy && x.from === r.envoy.full) || x.subject === "Cable — " + r.t) || null; }catch(e){ return null; } }
  function cableCtx(x){
    const r = realmOf(x); if(!r) return null;
    const you = G.you || {}, b = billNow();
    const rel = (G.clRealm = G.clRealm || {})[r.k] || 0;
    const motive = b ? "They are watching " + b.title + ": " + r.adj.toLowerCase() + " interests want " + r.want + ", and any vote that touches trade, money or the services moves that." : "They want " + r.want + ", and are sounding out which members of this House will listen.";
    let dist = "Little direct effect on " + (you.state || "your district") + ".";
    try{ const sd = stDef(you.state); if(sd){ if(/dock|port|ship|harbour|coast|bank/i.test(sd.note)) dist = "Your state trades by sea: " + r.t + "'s ports and tariffs reach your docks and jobs."; else if(/mill|farm|grain|orchard|market/i.test(sd.note)) dist = "Your farms and mills sell into the same markets " + r.t + " fights over."; } }catch(e){}
    return {r, regime:REGIME[r.k] || "foreign government", motive, dist, cmte:"Matters for the Foreign and Armed Services committees; bring it up in a hearing to put it on record.", rel};
  }
  const CABLE_ACTS = [
    {k:"ack", t:"Acknowledge politely", fx:"Relations +3 · influence +1 · costs a little time", run(c){ c.rel(3); infl(1); try{ spend(6, 1); }catch(e){} }},
    {k:"fwd", t:"Forward to committee and party", fx:"Influence +2 · whip notes you are useful · relations +1", run(c){ c.rel(1); infl(2); try{ const w = (G.members || []).find(m => !m.gone && m.post === "whip" && m.party === G.you.party); if(w) ripple(w, 2, "You sent me the cable before it reached the papers.", 2); }catch(e){} }},
    {k:"raise", t:"Raise it on the floor / with the press", fx:"Standing +3 · relations −4 (they wanted it private) · may make the Wire", run(c){ c.rel(-4); stand(3); try{ pushWireScrap("Foreign", "Member raises a cable from " + c.r.t + " in public."); }catch(e){} }},
    {k:"ign", t:"Ignore it", fx:"Relations −1 · no cost", run(c){ c.rel(-1); }}
  ];
  function infl(n){ try{ G.you.influence = clamp(G.you.influence + n, 0, 100); }catch(e){} }
  function stand(n){ try{ G.you.standing = clamp(G.you.standing + n, 0, 100); }catch(e){} }
  wrap("pushMail(cable)", () => pushMail, f => { pushMail = f; }, orig => function(from, subject, body, opts){
    try{
      if(opts && opts.kind === "cable"){
        try{ const m = from && /^Mission of (.+)$/.exec(from.name || ""); if(m){ const r = (G.realms || []).find(x => x.t === m[1]); const e = r && envoyOf(r);
          if(e){ from = Object.assign({}, from, {name:e.full}); body = String(body).replace("— Mission of " + r.t, "— " + e.title + " " + e.name + ", for the Mission of " + r.t); arguments[0] = from; arguments[2] = body; } } }catch(e){}
        const name = from ? from.name : "";
        const ex = G.mail.find(x => x.kind === "cable" && x.from === name && !x.answered);
        if(ex){
          ex.stack = (ex.stack || 1) + 1;
          ex.body = String(body) + "\n\n— earlier (" + (ex.stack - 1) + ") —\n" + String(ex.body).split("\n\n— earlier")[0];
          ex.day = G.day; ex.at = hhmm(); if(ex.read){ ex.read = false; } ex.open = false;
          G.mail.splice(G.mail.indexOf(ex), 1); G.mail.unshift(ex);
          try{ refreshInbox(); }catch(e){}
          return;
        }
      }
    }catch(e){}
    return orig.apply(this, arguments);
  });
  function readOne(x){ if(!x || x.read || x.outgoing) return; x.read = true; }   /* same effect as opening it: marks read */
  function answer(x, i){
    if(!x || x.answered) return; const opt = x.options && x.options[i]; if(!opt) return;
    x.answered = true; x.read = true; try{ spend(12, 3); }catch(e){}
    try{ if(opt.run) opt.run(); }catch(e){}
    try{ note("Answered " + x.from + ": “" + opt.t + "”."); }catch(e){}
  }
  function cableAct(x, k){
    const c = cableCtx(x); const a = CABLE_ACTS.find(y => y.k === k); if(!c || !a || x.answered) return;
    c.rel = n => { G.clRealm = G.clRealm || {}; G.clRealm[c.r.k] = clamp((G.clRealm[c.r.k] || 0) + n, -50, 50); };
    x.answered = true; x.read = true; x.clDone = a.t; a.run(c);
    try{ note("Cable from " + c.r.t + ": " + a.t.toLowerCase() + "."); }catch(e){}
    const it = CL.items.find(y => y.mail === x); if(it){ it.handled = true; it.outcome = a.t; }
  }
  function mailPane(x){
    if(!x) return '<p class="muted" style="margin:10px 0">Select a message to read it here. The list stays where you left it.</p>';
    const c = x.kind === "cable" ? cableCtx(x) : null;
    let h = '<div class="eyebrow">' + esc(x.from) + (x.stack > 1 ? ' · ×' + x.stack + ' cables' : '') + ' · d' + x.day + ' ' + esc(x.at) + '</div><h3 style="margin:4px 0">' + esc(x.subject) + '</h3>';
    if(c) h += '<div class="cl-sum">' + sumRow("Sender", esc(c.r.t) + " — " + esc(c.regime) + " · capital " + esc(c.r.capital)) + sumRow("Why they wrote", esc(c.motive)) + sumRow("Your district", esc(c.dist)) + sumRow("Committees", esc(c.cmte)) + sumRow("Relations", (c.rel > 0 ? "+" : "") + c.rel) + '</div>';
    h += '<div class="mailrow__b" style="white-space:pre-wrap">' + esc(x.body) + '</div>';
    if(c && !x.answered) h += '<div class="mailrow__acts">' + CABLE_ACTS.map(a => '<button class="conc__btn" style="width:auto" data-clcab="' + x.id + ':' + a.k + '" title="' + esc(a.fx) + '">' + esc(a.t) + '</button><div class="muted" style="font-size:11px;margin:0 0 4px">' + esc(a.fx) + '</div>').join("") + '</div>';
    else if(x.options && !x.answered) h += '<div class="mailrow__acts">' + x.options.map((o, i) => '<button class="conc__btn" style="width:auto" data-clans="' + x.id + ':' + i + '" data-ans="' + x.id + ':' + i + '">' + esc(o.t) + '</button><div class="muted" style="font-size:11px;margin:0 0 4px">' + esc(fnFx(o.run)) + '</div>').join("") + '</div>';
    else if(x.answered) h += '<div class="mailrow__acts"><span class="muted">Handled ✓' + (x.clDone ? " — " + esc(x.clDone) : "") + '</span></div>';
    h += '<p><button type="button" class="cl-btn" data-clwhatmail="' + x.id + '">What\'s this?</button></p>';
    return h;
  }
  function scrollers(n){ const a = []; for(let p = n; p && a.length < 5; p = p.parentElement) a.push([p, p.scrollTop]); return a; }
  function renderInbox(P, again){
      const keep = scrollers(P), listEl = P.querySelector(".cl-ibl"), lsT = listEl ? listEl.scrollTop : 0;
      const n = unreadCount(); const tab = el("tabInbox"); if(tab) tab.innerHTML = "Inbox" + (n ? '<span class="badge">' + n + '</span>' : "");
      const groupsAll = {}; G.mail.forEach(x => { (groupsAll[mailSec(x)] = groupsAll[mailSec(x)] || []).push(x); });
      const _pw = paneWindow("inbox", G.mail, 1);
      const groups = {}; _pw.view.forEach(x => { (groups[mailSec(x)] = groups[mailSec(x)] || []).push(x); });
      const sel = G.mail.find(x => x.id === CL.mailSel) || null;
      let h = '<div class="eyebrow">Inbox · ' + n + ' unread <button type="button" class="cl-btn" data-clreadall="*">Read all</button></div>' +
        '<div class="cl-ib"><div class="cl-ibl">';
      SECS.forEach(([k, t]) => {
        const gAll = groupsAll[k]; if(!gAll || !gAll.length) return;
        const g = groups[k] || [];
        const u = gAll.filter(x => !x.read && !x.outgoing).length, open = CL.inboxOpen[k] !== false;
        h += '<div class="cl-sec"><div class="cl-sech" data-clsec="' + k + '">' + (open ? "▾ " : "▸ ") + t + ' <span class="muted">(' + gAll.length + ')</span>' + (u ? ' <span class="badge">' + u + '</span> <button type="button" class="cl-btn" data-clreadall="' + k + '">Read all</button>' : '') + '</div>';
        if(open) h += g.map(x => '<div class="mailrow' + (x.read || x.outgoing ? "" : " is-unread") + (sel === x ? " cl-sel" : "") + '" data-clmail="' + x.id + '"><div class="mailrow__h"><span class="mailrow__f">' + (x.read || x.outgoing ? "" : '<span class="dotmark"></span>') + (x.outgoing ? "→ " : "") + esc(x.from) + (x.stack > 1 ? ' ×' + x.stack : '') + '</span><span class="mailrow__d">' + (x.answered ? "✓ " : x.read ? "Read · " : "") + 'd' + x.day + ' · ' + esc(x.at) + '</span></div><div class="mailrow__s">' + esc(x.subject) + '</div></div>').join("");
        h += '</div>';
      });
      h += (_pw.more || '') + '</div><div class="cl-ibp">' + mailPane(sel) + '</div></div>';
      P.innerHTML = h;
      paneMoreClick(P, "inbox", again);
      const L2 = P.querySelector(".cl-ibl"); if(L2) L2.scrollTop = lsT;
      keep.forEach(([e, t]) => { e.scrollTop = t; });
      P.querySelectorAll("[data-clsec]").forEach(d => d.addEventListener("click", ev => { if(ev.target.closest("[data-clreadall]")) return; const k = d.getAttribute("data-clsec"); CL.inboxOpen[k] = CL.inboxOpen[k] === false; LS("inboxOpen", CL.inboxOpen); again(); }));
      P.querySelectorAll("[data-clreadall]").forEach(b => b.addEventListener("click", ev => { ev.stopPropagation(); const k = b.getAttribute("data-clreadall"); G.mail.filter(x => k === "*" || mailSec(x) === k).forEach(readOne); try{ refreshPanels(); }catch(e){} again(); }));
      P.querySelectorAll("[data-clmail]").forEach(r => r.addEventListener("click", ev => { if(ev.target.closest("[data-tipk]")) return; const x = G.mail.find(y => y.id === +r.getAttribute("data-clmail")); if(!x) return; CL.mailSel = x.id; readOne(x); x.open = true; again(); }));
      P.querySelectorAll("[data-clans]").forEach(b => b.addEventListener("click", ev => { ev.stopPropagation(); const [mid, oi] = b.getAttribute("data-clans").split(":"); answer(G.mail.find(x => x.id === +mid), +oi); try{ refreshPanels(); }catch(e){} again(); }));
      P.querySelectorAll("[data-clcab]").forEach(b => b.addEventListener("click", ev => { ev.stopPropagation(); const [mid, k] = b.getAttribute("data-clcab").split(":"); cableAct(G.mail.find(x => x.id === +mid), k); try{ refreshPanels(); }catch(e){} again(); }));
      P.querySelectorAll("[data-clwhatmail]").forEach(b => b.addEventListener("click", () => { const x = G.mail.find(y => y.id === +b.getAttribute("data-clwhatmail")); let it = CL.items.find(y => y.mail === x); if(!it && x) it = {k:"mail-" + x.kind, kind:"mail", title:"Mail · " + x.from, text:x.subject + " — " + String(x.body).slice(0, 200), mail:x, at:"d" + x.day + " " + x.at, urg:"low"}; openExplain(it); }));
  }
