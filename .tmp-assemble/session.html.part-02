function engTick(){ try{ const E = G.eng; if(!E || E.pend !== "ceremony" || E.cerDay === G.day || !G.running || !veil.hidden || (TALK && TALK.open)) return; engCeremony(); }catch(e){} }

/* ordinary people talk about it, in the words of their own stake */
const ENG_TALK = [
  [["The Treasury's adding engines never miss a column. I miss that.", "My brother-in-law keeps the Treasury books. He says the machines do them by lunch."], ["Then what does he do after lunch?", "He says that is the question."]],
  [["The Post Office has a machine that reads my handwriting. Mine. Nobody reads my handwriting.", "They sorted the pension mail by machine. It came on time for once."], ["I would take that. I would also take being asked.", "On time is on time. Do not complain."]],
  [["Did you read about the reading engines? They summarise a bill in one page.", "My clerk's been reading with one of those machines. She says it reads faster than she thinks."], ["Does it read the footnotes?", "That is where she says it earns its keep."]],
  [["A machine found the clause nobody read in the Budget Act. Someone is going to be embarrassed.", "They say the reasoning engines argue better than the committee staff."], ["Better than the committee is a low bar.", "Better than me is the bar I am worried about."]],
  [["They gave a machine a week and a goal and it came back with the goal done.", "My daughter's school has a working engine. It teaches her what I cannot."], ["Does she still need you?", "More than ever, which is the odd part."]],
  [["The Engine is awake. My mother asked it about her knees. It answered her.", "I asked the Engine whether I should run again. It asked what I wanted first."], ["Did you tell it?", "I told it. I am still thinking about what it said back."]]
];
(function(){ const prev = lifeContext; lifeContext = function(){ const out = prev(); try{ const E = G.eng; if(E){ const s = Math.min(5, engStage(E)), t = ENG_TALK[s]; if(t) out.push({k:"eng:" + s, a:t[0], b:t[1], w:3}); const eco = E.eco; if(eco && eco.riots) out.push({k:"eng:strike", a:["They closed the clerks' hall in the next county over a machine.", "Did you hear about the hall that shut for the machines?"], b:["I heard. I do not know whose side to be on.", "Both sides are right, that is what makes it ugly."], w:3}); } }catch(e){} return out; }; })();

/* ══ 20261017d · who speaks aloud: the first line is typed; they speak out loud only when you speak or ask them to; they keep typing if they have more ══ */
const NPCV = {mode:"ask", until:0, more:0};
try{ const v = localStorage.getItem("onum.npcv"); if(v === "always" || v === "never" || v === "ask") NPCV.mode = v; }catch(e){}
function voiceInvited(){ return NPCV.preview || NPCV.mode === "always" || (NPCV.mode === "ask" && (G.t || 0) < NPCV.until); }
