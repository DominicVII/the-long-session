function psyMoral(m, dW, text, weight){
  if(!m || !m.rel) return; const w = weight || 0, Y = youMoral(), t = String(text || "");
  if(MOR_REP.test(t)){ m.distress = Math.max(0, (m.distress || 0) - 12); const h = (m.mem || []).find(e => e.who === "you" && (e.mor || 0) < 0 && !e.forgiven); if(h){ h.w *= 0.6; h.forgiven = true; h.trauma = false; } Y.repair++; return; }
  if(w <= -6){ const mag = Math.abs(w); m.distress = clamp((m.distress || 0) + mag * 0.9, 0, 100); if(mag >= 12) m.traumaFlag = true; Y.harm += mag; Y.log.push({d:G.day, id:m.id, who:m.name, t:t.slice(0, 120), mag}); if(Y.log.length > onumLim(30,"hist")) Y.log.shift(); }
  else if(w >= 6){ Y.care += w; m.distress = Math.max(0, (m.distress || 0) - w * 0.4); }
}
{ const _rp = ripple; ripple = function(m, dW, text, weight, sticky){ const r = _rp.apply(this, arguments); try{ psyMoral(m, dW, text, weight); }catch(e){} return r; }; }
function psyRecallLines(m, n){
  const rank = e => (memRetention(m, e) + 0.6 * (e.sal || 0.3) + (e.trauma ? 0.8 : 0)) * (1 + Math.min(0.5, (e.rc || 0) * 0.1));
  const top = (m.mem || []).slice().sort((a, b) => rank(b) - rank(a)).slice(0, n || 6), out = [];
  top.forEach(e => { const R = memRetention(m, e), v = memWeight(m, e) < 0 ? "resents" : "values";
    out.push(R > 0.55 ? "- (" + v + ", day " + e.d + ", clear) " + e.t : R > 0.25 ? "- (" + v + ", day " + e.d + ", dim) " + String(e.t).split(/[.;—]/)[0] + "…" : "- (" + v + ", a feeling more than a memory) " + e.t);
    if(e.recallDay !== G.day){ e.recallDay = G.day; e.rc = (e.rc || 0) + 1; e.last = G.day; e.w += ((m.rel && m.rel.warmth || 0) / 100) * 0.4; } });                           /* recalling it changes it a little */
  const a = m.aff && m.aff.you; if(a && Math.abs(a.v) > 6) out.push("- (overall, " + (a.v > 0 ? "you feel warmly toward" : "you feel cold toward") + " the player, whatever the details)");
  if(m.distress > 20) out.push("- (you are still carrying a hurt from the player; it has not eased)");
  return out;
}
function psyPromptLine(m){ try{ const l = psyRecallLines(m, 3); return l.length ? " WHAT YOU REMEMBER, as a real person would (some of it clear, some only a feeling, none of it exact): " + l.join(" ") : ""; }catch(e){ return ""; } }
const _psyLT = setInterval(() => { const LT = window.onumLiveTalk; if(!LT) return; clearInterval(_psyLT); if(LT.__psy) return; LT.__psy = 1; const wrapO = o => { try{ const m = (o && o.npc) || (o && o.npcId != null ? byId(o.npcId) : null); if(m && m.mem && m.kind !== "engine" && !o.npc_isEngine){ o = Object.assign({}, o, {extra:String(o.extra || "") + psyPromptLine(m)}); } }catch(e){} return o; };
  const _r = LT.reply; LT.reply = function(o){ return _r.call(this, wrapO(o)); };
  if(LT.stream){ const _s = LT.stream; LT.stream = function(o){ return _s.call(this, wrapO(o)); }; } }, 500);
/* what the player can read of memory and conscience: the moral tally, and for those still carrying a hurt what they hold and how it is going */
function psyPanelHTML(){
  try{ const Y = youMoral(), people = everyone().filter(p => p && p.mem && p.mem.length && !p.gone).sort((a, b) => (b.distress || 0) - (a.distress || 0)).slice(0, 6);
    const tally = '<div class="muted" style="font-size:12px">Harm done: ' + Math.round(Y.harm) + " · Care given: " + Math.round(Y.care) + " · Repair made: " + (Y.repair || 0) + "</div>";
    const rows = people.map(p => { const lines = psyRecallLines(p, 2).map(x => pcEsc(x.replace(/^- /, ""))).join("<br>"); return '<div class="muted" style="font-size:12px;margin:4px 0"><b>' + pcEsc(p.name) + '</b>' + ((p.distress || 0) > 1 ? ' <i>(still carrying a hurt: ' + Math.round(p.distress) + ')</i>' : '') + '<br><span style="opacity:.8">' + (lines || "nothing in particular") + '</span></div>'; }).join("");
    const recent = (Y.log || []).slice(-4).reverse().map(x => '<div class="muted" style="font-size:12px">day ' + x.d + ' · ' + pcEsc(x.who) + ": " + pcEsc(String(x.t).slice(0, 90)) + "</div>").join("");
    return '<div class="eyebrow" style="margin-top:12px">Memory and conscience</div>' + tally + (recent ? '<div class="eyebrow" style="margin-top:6px">Recent harm</div>' + recent : "") + (rows ? '<div class="eyebrow" style="margin-top:6px">What people carry of you</div>' + rows : "") + '<div class="muted" style="font-size:11px;opacity:.7">Only what reaches people is shown. Feelings fade more slowly than details, and only an apology that makes it right eases a hurt.</div>';
  }catch(e){ return ""; } }
{ const _pch = engChannelHTML; engChannelHTML = function(){ let h = _pch.apply(this, arguments); try{ h += psyPanelHTML(); }catch(e){} return h; }; }
/* ===== offices, their holders and their duties =====
   Every office has its own duties and no one else's. Where an act needs more than one office, it says which, and nobody may do the other's part.
   The ledger of who has held each seat is JUPITER's (ONUM_OFFICE_HISTORY); this reads it and puts it in front of the player and of the people who speak. */
const OFFICE_DUTIES = {
  pres:{title:"President of the Union", duties:["Signs or vetoes the bills Congress passes","Negotiates treaties","Nominates the cabinet, ambassadors and judges","Commands the armed forces","Grants pardons","Reports to the Union on its state"], coop:[["the House and the Senate","a bill becomes law only if both pass it and the President signs it, or two thirds overrule a veto"],["the Senate","a treaty is ratified, and a cabinet officer, ambassador or judge confirmed, only with its consent"],["Congress","war must be declared and paid for by Congress"]], limits:["Makes no law","Rules on no case","Has no vote in Congress"]},
  vp:{title:"Vice President", duties:["Presides over the Senate and casts the vote that breaks a tie","Stands ready to take the President's place"], coop:[["the President","succeeds only if the President cannot serve"]], limits:["Has no other powers of their own"]},
  cab:{title:"Cabinet officer", duties:["Runs one department of the executive","Carries out the laws that concern it","Advises the President on it"], coop:[["the President","serves at the President's pleasure"],["the Senate","confirmed by it"]], limits:["Makes no law","Rules on no case","Speaks for the department, not for the Union"]},
  speaker:{title:"Speaker of the House", duties:["Presides over the House and keeps its order","Recognises members and sets the floor schedule","Refers bills to committees"], coop:[["the Senate","a bill must pass both houses"],["the Senate","articles of impeachment go to it for trial"]], limits:["Cannot pass a bill alone","Does not try impeachments"]},
  house:{title:"Representative", duties:["Speaks and votes for one district","Introduces bills, and every bill to raise revenue begins in the House","Votes to impeach"], coop:[["the Senate and the President","nothing the House passes becomes law without them"]], limits:["Cannot confirm or ratify","Cannot try an impeachment"]},
  sen:{title:"Senator", duties:["Speaks and votes for a state","Confirms nominations and ratifies treaties by two thirds","Tries impeachments"], coop:[["the House and the President","nothing the Senate passes becomes law without them"]], limits:["Cannot originate a revenue bill","Cannot impeach"]},
  bench:{title:"Justice", duties:["Decides cases and constitutional questions","Rules a law valid or void"], coop:[], limits:["Makes no law","Enforces nothing","Hears no case that is not brought"]},
  gov:{title:"Governor", duties:["Runs the executive of one state","Signs or vetoes the state's bills","Makes the state's appointments and grants its pardons","Calls out the state's guard in an emergency"], coop:[["the state legislature","state law needs both"],["the Union","federal money and federal law reach the state through its own officers"]], limits:["Makes no federal law","Cannot sit in judgement of a case"]}
};
const OFFICE_NICE = {vp:"Vice President", "cab:sos":"Secretary of State", "cab:treas":"Secretary of the Treasury", "cab:war":"Secretary of Defense", "cab:ag":"Attorney General", speaker:"Speaker of the House", pres:"President of the Union"};
function odKey(seatKey){ const p = String(seatKey).split(":")[0]; return OFFICE_DUTIES[p] ? p : null; }
window.onumDutiesOf = function(seatKey){ const k = odKey(seatKey); return k ? OFFICE_DUTIES[k] : null; };
window.onumCooperation = function(topic){ const t = String(topic || "").toLowerCase(), out = []; Object.keys(OFFICE_DUTIES).forEach(k => OFFICE_DUTIES[k].coop.forEach(c => { if(c[1].toLowerCase().indexOf(t) >= 0 || c[0].toLowerCase().indexOf(t) >= 0) out.push({office:OFFICE_DUTIES[k].title, with:c[0], why:c[1]}); })); return out; };
function odSeats(){ return ((window.ONUM_OFFICE_HISTORY || {}).seats) || {}; }
function odTitle(k, R){ return OFFICE_NICE[k] || (R && R.title && R.title !== k ? R.title : k); }
function odCurrent(k){ const R = odSeats()[k]; if(!R) return null; const h = (R.holders || []).find(x => x.to == null); return h ? Object.assign({}, h, {name:h.personId === "you" && G.you ? G.you.name : h.name}) : null; }
function odAgo(d){ if(d == null) return ""; const n = Math.round(G.day - d), T = G.termLength || 52; return n <= 0 ? "today" : n < T ? n + (n === 1 ? " day ago" : " days ago") : (n / T).toFixed(1) + " terms ago"; }
function odSeatOf(m){ const S = odSeats(); if(!m || !m.name) return null; const hit = Object.keys(S).filter(k => (S[k].holders || []).some(h => h.to == null && h.name === m.name)); return hit.length === 1 ? hit[0] : (hit.find(k => S[k].title === m.role) || hit[0] || null); }   /* ids repeat across the ledger's lists, so a holder is found by name, which is unique */
function odPromptLine(m){
  try{ const k = odSeatOf(m); if(!k) return ""; const D = window.onumDutiesOf(k); if(!D) return ""; const S = odSeats();
    const who = ["pres", "speaker", "vp"].map(x => { const c = odCurrent(x); return c ? odTitle(x, S[x]) + " " + c.name : null; }).filter(Boolean).join("; ");
    return " YOUR OFFICE: " + odTitle(k, S[k]) + ". YOUR DUTIES, AND ONLY YOURS: " + D.duties.join("; ") + ". YOU CANNOT: " + D.limits.join("; ") + "." + (D.coop.length ? " WHERE YOU MUST WORK WITH ANOTHER OFFICE: " + D.coop.map(c => c[0] + " (" + c[1] + ")").join("; ") + "." : "") + (who ? " WHO HOLDS THE OTHER SEATS NOW: " + who + "." : "") + " What belongs to another office is theirs to decide: say so, and send the matter to them.";
  }catch(e){ return ""; }
}
const _odLT = setInterval(() => { const LT = window.onumLiveTalk; if(!LT) return; clearInterval(_odLT); if(LT.__od) return; LT.__od = 1;
  const wrapO = o => { try{ const m = (o && o.npc) || (o && o.npcId != null ? byId(o.npcId) : null); if(m && m.kind !== "engine"){ const l = odPromptLine(m); if(l) o = Object.assign({}, o, {extra:String(o.extra || "") + l}); } }catch(e){} return o; };
  const _r = LT.reply; LT.reply = function(o){ return _r.call(this, wrapO(o)); }; if(LT.stream){ const _s = LT.stream; LT.stream = function(o){ return _s.call(this, wrapO(o)); }; } }, 700);
function officesCard(){
  if(!G.you) return;
  try{ if(TALK.open) closeTalk(); }catch(e){}
  phoneWasRunning = phoneWasRunning === null ? G.running : phoneWasRunning; G.running = false;
  const S = odSeats(), keys = Object.keys(S), groups = [["The Union executive", ["pres", "vp", "cab"]], ["Congress", ["speaker", "house", "sen"]], ["The bench", ["bench"]], ["State executives", ["gov"]]];
  const seatHTML = k => { const R = S[k], cur = odCurrent(k), past = (R.holders || []).filter(h => h.to != null).slice().reverse();
    return '<details style="margin:3px 0"><summary><b>' + pcEsc(odTitle(k, R)) + '</b> · ' + (cur ? pcEsc(cur.name) + ' <span class="muted">(' + (cur.from != null && cur.from > G.day - 3 ? "just now" : "since " + odAgo(cur.from)) + ')</span>' : '<i>vacant' + (R.vacantSince != null ? " since " + odAgo(R.vacantSince) : "") + '</i>') + '</summary>' +
      (past.length ? past.slice(0, 12).map(h => '<div class="muted" style="font-size:12px;margin-left:14px">' + pcEsc(h.name) + ' · ' + odAgo(h.from) + ' to ' + odAgo(h.to) + (h.how ? ' · ' + pcEsc(h.how) : '') + '</div>').join("") : '<div class="muted" style="font-size:12px;margin-left:14px">No earlier holder on record.</div>') + '</details>'; };
  const dutyHTML = pk => { const D = OFFICE_DUTIES[pk]; return '<div class="muted" style="font-size:12px;margin:2px 0 6px"><b>' + pcEsc(D.title) + ' — its own duties:</b> ' + D.duties.map(pcEsc).join("; ") + '.' + (D.coop.length ? '<br><b>Only together with:</b> ' + D.coop.map(c => pcEsc(c[0]) + ' (' + pcEsc(c[1]) + ')').join("; ") + '.' : '') + '<br><b>Never:</b> ' + D.limits.map(pcEsc).join("; ") + '.</div>'; };
  card.innerHTML = '<div class="eyebrow">The offices of the Union</div><h1>Who holds them, who held them, and what each is for.</h1><p class="muted">Each office has its own duties and no one else’s. Where an act needs more than one, it says which.</p>' +
    groups.map(([g, pre]) => '<div class="eyebrow" style="margin-top:12px">' + g + '</div>' + pre.map(p => dutyHTML(p) + keys.filter(k => odKey(k) === p && k.split(":")[0] === p).map(seatHTML).join("")).join("")).join("") +
    '<div class="card__actions"><button class="btn" type="button" id="offDone">Close</button></div>';
  veil.hidden = false; card.classList.add("card--open");
  const done = el("offDone"); if(done) done.onclick = () => { veil.hidden = true; card.classList.remove("card--open"); G.running = phoneWasRunning === null ? true : phoneWasRunning; phoneWasRunning = null; };
}
document.addEventListener("click", ev => { try{ const t = ev.target; if(t && t.id === "uiOfficesBtn" && G.you && veil.hidden) officesCard(); }catch(e){} });
/* ===== your turn is yours =====
   While you type, or have words in a box, nothing in the world speaks over you: ambient talk, the unseen scenes and the sittings' beats wait, and the aide never takes your turn.
   In a cabinet meeting or a governor's council you chair, what you say is answered by the person it is for, and you can call on any member by name. */
window.__typing = {until:0};
function playerTyping(){ return Date.now() < window.__typing.until; }
(function(){
  const isBox = t => t && (/^(INPUT|TEXTAREA)$/.test(t.tagName)) && !t.matches("[type=checkbox],[type=radio],[type=range],[type=file],[type=number]");
  document.addEventListener("input", e => { if(isBox(e.target) && String(e.target.value || "").trim()) window.__typing.until = Date.now() + 25000; }, true);
  document.addEventListener("focusin", e => { if(isBox(e.target)) window.__typing.until = Math.max(window.__typing.until, Date.now() + 8000); }, true);
  document.addEventListener("focusout", e => { if(isBox(e.target) && !String(e.target.value || "").trim()) window.__typing.until = 0; }, true);
  document.addEventListener("keydown", e => { if(e.key === "Enter" && isBox(e.target)) setTimeout(() => { window.__typing.until = 0; }, 50); }, true);
})();
{ const _oh = overhear; overhear = function(){ if(playerTyping()) return; return _oh.apply(this, arguments); }; }
{ const _ng = nearGreet; nearGreet = function(){ if(playerTyping()) return; return _ng.apply(this, arguments); }; }
{ const _ea = enlAuto; enlAuto = function(){ if(playerTyping()) return; return _ea.apply(this, arguments); }; }
{ const _ut = unseenTick; unseenTick = async function(){ if(playerTyping()) return; return _ut.apply(this, arguments); }; }
/* cabinet and council: speak to a member and they answer; call on a member and they report */
const CABINET_POSTS = [
  {k:"state", t:"Secretary of State", ab:"treaty"},
  {k:"treasury", t:"Secretary of the Treasury", ab:"purse"},
  {k:"war", t:"Secretary of War", ab:"readiness"},
  {k:"interior", t:"Secretary of the Interior", ab:"ground"},
  {k:"labour", t:"Secretary of Labor", ab:"works"},
  {k:"ag", t:"Attorney General", ab:"brief"}
];
function cabMake(post, src){
  const base = makeMember((G.you && G.you.party) || "IND", {name: src && src.name, state: (G.you && G.you.state) || null, keepParty:true});
  base.kind = "official";
  base.role = post.t;
  base._post = post.k;
  base._ability = post.ab;
  base.post = null;
  base.room = "exec";
  base.sitting = false;
  base.intent = {k:"office", t:"hold " + post.t + " and use it when the chair asks"};
  if(src && src.pos){ try{ Object.assign(base.pos, src.pos); }catch(e){} }
  try{ autoInit(base); ensureSelfhood(base); }catch(e){}
  return base;
}
function cabRoster(){
  if(!G.officials) G.officials = [];
  if(!G.cabPosts) G.cabPosts = {};
  CABINET_POSTS.forEach(post => {
    let p = G.cabPosts[post.k] != null ? byId(G.cabPosts[post.k]) : null;
    if(!p || p.gone){
      p = cabMake(post, null);
      G.officials.push(p);
      G.cabPosts[post.k] = p.id;
      _allCache = null;
    }
    p.role = post.t; p._post = post.k; p._ability = post.ab; p.kind = "official";
  });
  return CABINET_POSTS.map(post => byId(G.cabPosts[post.k])).filter(Boolean);
}
function cabOpenPost(){
  cabRoster();
  return CABINET_POSTS.find(post => { const p = byId(G.cabPosts[post.k]); return p && !p._named; }) || CABINET_POSTS[(G.day || 0) % CABINET_POSTS.length];
}
function cabInstall(post, official){
  if(!post) return null;
  if(!G.officials) G.officials = [];
  const old = G.cabPosts && byId(G.cabPosts[post.k]);
  if(old){ old.gone = true; old.room = "away"; old.sitting = false; }
  const p = cabMake(post, official || null);
  p._named = true;
  G.officials.push(p);
  G.cabPosts[post.k] = p.id;
  _allCache = null;
  try{ p.room = (typeof heldOffice === "function" && heldOffice() === "pres") ? "exec" : "away"; }catch(e){ p.room = "away"; }
  try{ placeInRoom(p); }catch(e){}
  return p;
}
function govRoster(){
  const y = G.you; if(!y) return [];
  const S = (G.states || []).find(s => s.n === y.state); if(!S || typeof govStaff !== "function") return [];
  govStaff(S);
  if(!G.officials) G.officials = [];
  const posts = [].concat(
    Object.keys(GOV_ROLES).map(k => ({k, t:GOV_ROLES[k].t, o:S.cab[k], ab:k === "press" ? "press" : k})),
    Object.keys(GOV_AGENCIES).map(k => ({k:"ag_"+k, t:GOV_AGENCIES[k].head, o:S.agency[k], ab:"agency"}))
  );
  return posts.map(post => {
    if(!post.o) return null;
    let p = post.o.pid != null ? byId(post.o.pid) : null;
    if(!p || p.gone){
      p = cabMake({k:post.k, t:post.t, ab:post.ab}, post.o);
      p.room = "govoffice";
      G.officials.push(p);
      post.o.pid = p.id;
      _allCache = null;
    }
    p.role = post.t; p._ability = post.ab; p.kind = "official";
    return p;
  }).filter(Boolean);
}
function cabSeatMeeting(S){
  if(!S) return;
  const people = S.kind === "cabinet_meeting" ? cabRoster() : S.kind === "governor_council" ? govRoster() : null;
  if(!people || !people.length) return;
  const room = S.kind === "cabinet_meeting" ? "exec" : "govoffice";
  const spots = [[-1.7,3.5],[1.7,3.5],[-1.7,5.1],[1.7,5.1],[-0.55,5.7],[0.55,5.7],[ -2.4,4.3],[2.4,4.3]];
  people.forEach((p, i) => {
    const s = spots[i % spots.length];
    p.room = room; p.away = false; p.gone = false;
    p.sitting = true; p.x = p.tx = s[0]; p.z = p.tz = s[1];
  });
  try{ moved(); }catch(e){}
  S.seats = people.map((p, i) => ({seatId:"appt"+i, personId:p.id}));
  if(!S.seats.some(s => s.personId === "you")) S.seats.push({seatId:"you", personId:"you"});
}
function cabUse(p){
  if(!p) return "Call on someone first. An empty chair has no office.";
  if(p._usedDay === G.day) return (typeof surname === "function" ? surname(p.name) : p.name) + " has already used the office today.";
  const y = G.you || {};
  let t = "", spent = true;
  const ab = p._ability || "";
  const stOf = (n) => (G.states || []).find(s => s.n === n);
  if(ab === "treaty"){
    const R = (G.realms || [])[0];
    if(R){ R.rel = Math.max(-100, Math.min(100, (R.rel || 0) + 6)); t = p.name + " opens a channel to " + (R.t || "a neighbour") + ". They are warmer than this morning."; }
    else { t = p.name + " sends the note. No capital is on the other end today."; spent = false; }
  } else if(ab === "purse"){
    y.funds = Math.round((y.funds || 0) + 25000);
    if(G.money) G.money.index = Math.max(42, Math.min(190, (G.money.index || 100) + 0.8));
    t = p.name + " releases a reserve from the Treasury. The chest takes twenty-five thousand.";
  } else if(ab === "readiness"){
    try{ const w = worldEnsure(); w.heat = Math.max(0, (w.heat || 0) - 4); }catch(e){}
    t = p.name + " stands the guard down a step. The heat drops.";
  } else if(ab === "ground"){
    const st = (G.states || []).slice().sort((a,b) => (b.unrest||0)-(a.unrest||0))[0];
    if(st){ st.unrest = Math.max(0, (st.unrest||0) - 8); t = p.name + " sends people into " + st.n + ". The unrest there comes down."; }
    else { t = p.name + " has the wagons ready and nowhere that needs them."; spent = false; }
  } else if(ab === "works"){
    const st = stOf(y.state) || (G.states || [])[0];
    if(st){ st.ind = Math.min(100, (st.ind||0) + 4); t = p.name + " keeps a shift open in " + st.n + "."; }
    else { t = p.name + " has the order and no state to send it to."; spent = false; }
  } else if(ab === "brief"){
    y.standing = Math.max(0, Math.min(100, (y.standing||0) + 2));
    t = p.name + " files the brief. It is in writing, and your standing moves with it.";
  } else if(ab === "chief"){
    y.influence = Math.max(0, Math.min(100, (y.influence||0) + 3));
    t = p.name + " clears the afternoon. Your reach in the building moves.";
  } else if(ab === "treasurer"){
    y.funds = Math.round((y.funds||0) + 12000);
    t = p.name + " finds twelve thousand the budget had buried.";
  } else if(ab === "safety"){
    const st = stOf(y.state); if(st) st.unrest = Math.max(0, (st.unrest||0) - 6);
    t = p.name + " puts a second shift on the corners.";
  } else if(ab === "press"){
    y.approval = Math.max(0, Math.min(100, (y.approval||0) + 2));
    t = p.name + " gives the wire your line before the wire invents one.";
  } else if(ab === "agency"){
    const st = stOf(y.state); if(st){ st.ind = Math.min(100, (st.ind||0)+2); st.unrest = Math.max(0, (st.unrest||0)-2); }
    t = p.name + " spends the office on the thing the department was built for.";
  } else { t = p.name + " holds " + (p.role || "an office") + ", and there is nothing in it to spend today."; spent = false; }
  if(spent) p._usedDay = G.day;
  try{ feed(t); }catch(e){}
  try{ remember(p, "You had me use the office.", 3); }catch(e){}
  return t;
}
function cabSeats(){ try{ if(!SSN || (SSN.kind !== "cabinet_meeting" && SSN.kind !== "governor_council")) return []; const seated = (SSN.seats || []).map(s => byId(isNaN(+s.personId) ? s.personId : +s.personId)).filter(p => p && p !== G.you && !p.gone), want = SSN.kind === "cabinet_meeting" ? /^(Secretary of (State|the Treasury|Defen[cs]e|War|the Interior|Commerce|Labor|Labour|Energy|Health|Education|Agriculture|Transportation|Justice|Homeland)|Attorney General|Vice President)/i : /Secretary|Commissioner|Treasurer|Attorney General|Adjutant|Chief of Staff|Director|Superintendent/i; const members = seated.filter(p => want.test(String(p.role || ""))); if(members.length) return members; const all = everyone().filter(p => p && !p.gone && p !== G.you && want.test(String(p.role || ""))); return all.length ? all : seated; }catch(e){ return []; } }   /* the cabinet is the secretaries, whoever else is standing in the room */
