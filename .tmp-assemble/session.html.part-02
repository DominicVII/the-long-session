    try{ propPlaque(-5.3, 1.5, 6.2, Math.PI / 2, "CONFERENCE", "Justices only", 0.9, 0.12); }catch(e){}
    propDesk(wood, wood, -4.4, 8.4, 1.4, 0.7, 0, 0.8); propPapers(-4.4, 0.82, 8.4, 3); try{ propPlaque(-4.4, 1.35, 8.1, 0, "CLERK", "petitions & docket", 0.8, 0.12); }catch(e){}
    propDesk(wood, wood, 4.4, 8.4, 1.4, 0.7, 0, 0.8); try{ propPlaque(4.4, 1.35, 8.1, 0, "MARSHAL", "order in the court", 0.8, 0.12); }catch(e){}
    cal(hw - 0.3, 3.6, -Math.PI / 2);
  } else if(id === "exec"){
    addBox(wood, 3.0, 0.4, 6.6, 1.7, 0.8, 1.1, 0, true); addBox(map, 3.0, 0.82, 6.6, 1.55, 0.03, 0.95, 0, true); [-0.55, 0, 0.55].forEach(o => addBox(cloth, 3.0 + o, 0.85, 6.6, 0.18, 0.03, 0.18, 0, true));   /* the situation table */
    try{ propPlaque(3.0, 1.45, 7.35, Math.PI, "SITUATION", "maps, ports, frontiers", 1.1, 0.14); }catch(e){}
    addBox(board, 0.9, 0.84, 9.1, 0.5, 0.06, 0.36, 0, true); addBox(matCol(0x1d1f26, .5), 1.2, 0.9, 9.0, 0.2, 0.1, 0.2, 0, true);                                  /* the telephones */
    try{ propPlaque(0.9, 1.25, 9.5, Math.PI, "TELEPHONES", "foreign capitals", 0.9, 0.12); }catch(e){}
    cal(hw - 0.3, 2.4, -Math.PI / 2);
  } else if(id === "govoffice"){
    addBox(wood, -2.6, 0.38, 5.6, 1.4, 0.76, 0.9, 0, true); propPapers(-2.6, 0.78, 5.6, 3); [-3.2, -2.0].forEach(x => propChair(wood, leather, x, 6.4, Math.PI));   /* the briefing table */
    try{ propPlaque(-2.6, 1.3, 5.1, 0, "BRIEFING", "morning, 8:00", 0.9, 0.12); }catch(e){}
    addBox(board, hw - 0.4, 1.5, 5.0, 0.08, 1.3, 1.4, 0, true); try{ propPlaque(hw - 0.45, 1.6, 5.0, -Math.PI / 2, "THE BREAD QUESTION", "prices, ports, grain", 1.2, 0.14); }catch(e){}
    cal(-hw + 0.3, 6.2, Math.PI / 2);
  }
}
function kRoomProps(){
  const P = (room, o) => { if(PROPS[room] && !PROPS[room].some(p => p.id === o.id)) PROPS[room].push(o); };
  P("senate", {id:"scal", ...KCAL("scal", -6.4, 2.4)});
  P("senate", {id:"streaty", label:"The treaty table", sub:"The dossier on whatever the executive has asked us to consent to", x:5.0, z:3.4, r:2.0, acts:() => [kRoleAct(["senate"], "Read the treaty and decide", "30m", "treaty"), {t:"Read what the Senate has said about treaties", c:"5m", run(){ setSay("Consent needs two thirds. Reservations lower the price and the risk: they say 'yes, but not that clause'. Rejecting costs you warmth with the other nation and wins you the hawks.", ""); }}]});
  P("senate", {id:"stally", label:"The roll-call board", sub:"Who is for, who is against, and who is somewhere else", x:6.2, z:9.4, r:2.2, acts:() => [{t:"Read the tally", c:"5m", run(){ const b = G.bill; setSay(b && !b.done ? "The " + b.title + ": " + (function(){ try{ const t = tallyBill(b, true); return t.aye + " ayes, " + t.no + " noes projected, roll call day " + b.voteDay; }catch(e){ return "the count is in pencil"; } })() + "." : "No question is before the Senate.", ""); }}, kRoleAct(["senate"], "Work the situation abroad (move an authorisation, hearings, sanctions)", "20m", "swar")]});
  P("senate", {id:"spress", label:"The press gallery", sub:"Three reporters and a view of everybody's good side", x:6.0, z:6.6, r:2.0, acts:() => [{t:"Give a quote from the floor", c:"15m", run(){ try{ closeTalk(); }catch(e){} try{ setSay(officePress("the Senate steps"), ""); }catch(e){} }}]});
  P("court", {id:"ccal", ...KCAL("ccal", 5.3, 3.6)});
  P("court", {id:"cconf", label:"The conference table", sub:"Where five justices argue it before anyone writes a word", x:-4.7, z:6.2, r:2.2, acts:() => [kRoleAct(["bench"], "Go into conference", "40m", "bconf"), {t:"Sit and listen to the room", c:"5m", run(){ setSay("The table is bare but for water, pencils and the day's one case. Nobody takes notes in conference; the clerks are not allowed in.", ""); }}]});
  P("court", {id:"cclerk", label:"The Clerk of the Court", sub:"Petitions, the docket and the filing deadlines", x:-4.4, z:8.4, r:2.0, acts:() => [kRoleAct(["bench"], "Take up the petitions for review", "20m", "bcert"), kRoleAct(["bench"], "Write the opinion at the bench", "60m", "bopin")]});
  P("court", {id:"cmarshal", label:"The Marshal's desk", sub:"Order in the court, the cryer, and who is in the gallery", x:4.4, z:8.4, r:2.0, acts:() => [kRoleAct(["bench"], "Call the Court to order for oral argument", "90m", "kct")]});
  P("exec", {id:"xcal", ...KCAL("xcal", 4.9, 2.4)});
  P("exec", {id:"xsit", label:"The situation table", sub:"Charts of the ports, the frontiers and the bread price", x:3.0, z:6.6, r:2.2, acts:() => [kRoleAct(["pres"], "Take the situation room", "40m", "pwar"), {t:"Study the chart", c:"5m", run(){ try{ const w = worldEnsure(), f = worldFoe(); setSay("The rival this term is " + f.t + ", heat " + Math.round(w.heat || 0) + ". Bread stands at " + (w.bread || 1).toFixed(2) + (w.ration ? ", and the northern towns are rationed." : ".") + " " + (G.conflict ? "A measure is already under way against " + ((WORLD_POWERS.find(p => p.k === G.conflict.k) || {}).t || "them") + "." : "Nothing is under way."), ""); }catch(e){ setSay("The chart is blank.", ""); } }}]});
  P("exec", {id:"xphone", label:"The telephones", sub:"Direct lines to the foreign capitals", x:0.9, z:9.0, r:1.8, acts:() => [kRoleAct(["pres"], "Take the calls with foreign capitals", "40m", "aid")]});
  P("exec", {id:"xcab", label:"The cabinet table", sub:"Four secretaries, a lot of coffee, and no agreement", x:0, z:4.4, r:2.4, acts:() => [kRoleAct(["pres"], "Hear the cabinet and appoint", "40m", "cab"), kRoleAct(["pres"], "The morning briefing", "45m", "kex")]});
  P("exec", {id:"xacts", label:"The signing tray", sub:"Acts waiting on a pen", x:-0.7, z:9.0, r:1.8, acts:() => [kRoleAct(["pres"], "Sign or veto what Congress sent", "20m", "pacts")]});
  P("govoffice", {id:"gcal", ...KCAL("gcal", -4.6, 6.2)});
  P("govoffice", {id:"gbrief", label:"The briefing table", sub:"Your advisors, with the day's file", x:-2.6, z:5.6, r:2.2, acts:() => [kRoleAct(["gov"], "Take the morning briefing", "30m", "gbrief")]});
  P("govoffice", {id:"gwait", label:"The waiting bench", sub:"Citizens, mayors and county clerks, in order", x:-4.2, z:3.2, r:2.2, acts:() => [kRoleAct(["gov"], "Open the doors: open hours", "60m", "kgv"), {t:"Glance down the bench", c:"1m", run(){ setSay("A farmer in his good coat, a woman with a folder held like a shield, and the mayor of somewhere small who has clearly practised.", ""); }}]});
  P("govoffice", {id:"gbread", label:"The bread board", sub:"The price of bread, county by county, and what the neighbours are doing", x:4.0, z:5.0, r:2.2, acts:() => [kRoleAct(["gov"], "Take up the bread question", "30m", "gwar")]});
  P("govoffice", {id:"gbook", label:"The ledger shelf", sub:"The budget, the appointments book and the agencies' letters", x:4.0, z:7.2, r:2.0, acts:() => [{t:"The towns' petitions", c:"20m", run(){ closeTalk(); orgPetitionsCard(); }}, kRoleAct(["gov"], "Agencies and the budget", "40m", "gbud"), kRoleAct(["gov"], "The statehouse desk: sign or veto", "20m", "gdesk")]});
}
try{ kRoomProps(); }catch(e){ console.warn("room props", e); }
/* ══ 20261104bg · JUPITER abilities past the House (Neptune survey bd) ══
   Real props with actions in exec/govoffice/senate/court, fuller rolePowers from OFFICE_DUTIES,
   VP and cabinet chairs (appointed: not on the ballot), bench fallback powers. */
(function(){
  const jc = (v) => clamp(v, 0, 100);
  const jOnce = (key) => kOnceToday("jb_" + key), jMark = (key) => kMark("jb_" + key);
  const jSay = (t, n) => { try{ closeTalk(); }catch(e){} try{ setSay(t, n || ""); }catch(e){ try{ note(t); }catch(e2){} } return t; };
  /* VP and the cabinet: appointed chairs, non-enumerable so the ballot (Object.keys(OFFICES)) never lists them */
  const JAPP = {vp:{t:"the Vice Presidency", short:"Vice President", room:"senate"},
    "cab:sos":{t:"the Department of State", short:"Secretary of State", room:"exec"},
    "cab:treas":{t:"the Treasury", short:"Secretary of the Treasury", room:"exec"},
    "cab:war":{t:"the Department of Defense", short:"Secretary of Defense", room:"exec"},
    "cab:ag":{t:"the Justice Department", short:"Attorney General", room:"exec"}};
  Object.keys(JAPP).forEach(k => { const a = JAPP[k];
    try{ if(!Object.prototype.hasOwnProperty.call(OFFICES, k)) Object.defineProperty(OFFICES, k, {value:{t:a.t, short:a.short, term:2, need:{}, appointed:true, blurb:"Appointed, not elected."}, enumerable:false, writable:true, configurable:true}); }catch(e){}
    ROLE_T[k] = a.short; K_ROOM_OF[k] = a.room; K_HOME_OF[k] = a.room; });
  K_HOME_OF.bench = "court"; K_HOME_OF.senate = K_HOME_OF.senate || "senate";
  try{ const _q = qualifies; qualifies = function(k){ if(OFFICES[k] && OFFICES[k].appointed) return false; return _q.apply(this, arguments); }; }catch(e){}
  /* QA / story hook: take an appointed chair (no eval needed) */
  window.onumTakeOffice = function(k){ if(!JAPP[k] || !G || !G.you) return false; G.you.office = k; try{ note("You take the oath as " + JAPP[k].short + ".", true); }catch(e){} return true; };

  const jP = (room, o) => { if(PROPS[room] && !PROPS[room].some(p => p.id === o.id)) PROPS[room].push(o); };
  const roleIs = (ks) => { let k = null; try{ k = roleKey(); }catch(e){} return ks.indexOf(k) >= 0; };
  const gate = (ks, t, c, key, fn) => ({t, c, off:jOnce(key), run(){ if(!roleIs(ks)){ jSay("That is the work of someone else's chair. You can watch, and you can ask."); return; } jMark(key); return fn(); }});
  /* exec */
  jP("exec", {id:"jxsec", label:"The Executive's secretary", sub:"The diary, the pens and the list of who is waiting", x:-3.2, z:3.0, r:2.0, acts:() => [
    gate(["pres"], "Draft the report on the state of the Union", "60m", "sotu", () => { spend(60, 10); G.you.standing = jc(G.you.standing + 3); G.you.approval = jc(G.you.approval + 2); try{ feed(execTitle() + " " + surname(G.you.name) + " reported on the state of the Union.", "good"); }catch(e){} return jSay("Forty minutes, one glass of water, and two standing ovations you did not expect.", fx("+3 standing · +2 approval", "an hour")); }),
    gate(["pres"], "Sign a pardon", "20m", "ppardon", () => { spend(20, 3); G.you.approval = jc(G.you.approval + (Math.random() < 0.5 ? 2 : -3)); return jSay("One name, one signature. The press will decide whether it was mercy or a favour.", fx("approval moves", "20 minutes")); }),
    {t:"Ask what the diary holds", c:"2m", run(){ jSay(typeof kCalText === "function" ? kCalText() : "The diary is full.", ""); }}]});
  jP("exec", {id:"jxcabc", label:"The cabinet chairs", sub:"Each secretary's seat, with a folder on it", x:-3.3, z:4.0, r:2.0 /* NEP_BF_SPOTS.cabinetTable */, acts:() => [
    gate(["cab:sos"], "Brief the Executive on the realms abroad", "30m", "csos", () => { spend(30, 4); try{ const r = pick(realmEnsure()); G.realmRel = G.realmRel || {}; G.realmRel[r.k] = clamp((G.realmRel[r.k] || 0) + 5, -100, 100); return jSay("Your cable from " + r.capital + " is read twice and quoted once.", fx(r.t + " warmer", "30 minutes")); }catch(e){ return jSay("The realms are quiet. You say so in one page."); } }),
    gate(["cab:treas"], "Steady the Union's money", "30m", "ctreas", () => { spend(30, 4); try{ if(G.money) G.money.index = Math.round(((G.money.index || 0) + 0.5) * 10) / 10; }catch(e){} return jSay("You move the rate a hair and the bond men breathe out.", fx("money steadier", "30 minutes")); }),
    gate(["cab:war"], "Review the readiness of the forces", "30m", "cwar", () => { spend(30, 4); try{ const w = worldEnsure(); w.heat = Math.max(0, (w.heat || 0) - 2); }catch(e){} return jSay("Three depots, two ships in dock, one general who wants more. You give him nothing and he salutes anyway.", fx("frontier calmer", "30 minutes")); }),
    gate(["cab:ag"], "Bring the Union's case to court", "30m", "cag", () => { spend(30, 4); const S = pick(G.states || [{n:"a state"}]); G.cases = G.cases || []; G.cases.push({t:"the Union v. " + S.n, state:S.n, day:G.day, voted:[]}); return jSay("You file against " + S.n + ". The bench will have it by the week's end.", fx("a case filed", "30 minutes")); })]});
  /* govoffice */
  jP("govoffice", {id:"jgsec", label:"The Governor's secretary", sub:"A list in her hand and a pencil behind her ear", x:3.3, z:3.0, r:2.0 /* NEP_BF_SPOTS.govSecretary */, acts:() => [
    gate(["gov"], "Grant a state pardon", "20m", "gpardon", () => { spend(20, 3); G.you.approval = jc(G.you.approval + (Math.random() < 0.5 ? 2 : -2)); return jSay("A man who stole a horse thirty years ago gets his vote back. His daughter writes to thank you.", fx("approval moves", "20 minutes")); }),
    gate(["gov"], "Call out the state guard", "30m", "gguard", () => { spend(30, 5); const S = (G.states || []).find(s => s.n === G.you.state); if(S) S.unrest = clamp((S.unrest || 0) - 6, 0, 100); G.you.approval = jc(G.you.approval - 1); return jSay("Two companies at the depot by dusk. The streets go quiet, and some people resent that.", fx(S ? S.n + " calmer" : "order kept", "-1 approval")); })]});
  /* senate: the dais and the cloakroom */
  jP("senate", {id:"jsdais", label:"The presiding officer's dais", sub:"The gavel, the journal and the tie-breaking vote", x:0, z:9.6, r:2.2, acts:() => [
    gate(["vp"], "Break the tie", "15m", "vptie", () => { const b = G.bill; if(!b || b.done) return jSay("No question is tied before the Senate today."); spend(15, 2); b.voteDay = Math.max(G.day, (b.voteDay || G.day) - 1); G.you.influence = jc(G.you.influence + 2); return jSay("Fifty to fifty. The chamber turns to you. You vote, and the " + b.title + " moves.", fx("+2 influence", "15 minutes")); }),
    gate(["senate", "vp"], "Sit as a court of impeachment", "90m", "simp", () => { spend(90, 12); G.you.standing = jc(G.you.standing + 2); return jSay("The Chief Justice in the chair, a hundred senators sworn, and you sitting as a juror on a man you have dined with.", fx("+2 standing", "90 minutes")); })]});
  jP("senate", {id:"jscloak", label:"The cloakroom", sub:"Coats, coffee, and the votes nobody counts in public", x:-6.0, z:7.4, r:2.0, acts:() => [
    gate(["senate"], "Place a hold on the bill", "15m", "shold", () => { const b = G.bill; if(!b || b.done) return jSay("Nothing to hold."); b.voteDay = (b.voteDay || G.day) + 2; G.you.influence = jc(G.you.influence - 2); return jSay("One note to the leader's office and the " + b.title + " sits two more days.", fx("vote slips 2 days", "-2 influence")); }),
    gate(["senate"], "Whip for cloture", "30m", "sclot", () => { const b = G.bill; if(!b || b.done || !b.filibustered) return jSay("No one is talking a bill to death today."); b.filibustered = false; b.voteDay = Math.max(G.day + 1, (b.voteDay || G.day) - 2); G.you.influence = jc(G.you.influence - 3); return jSay("Sixty names on the motion. The talking stops.", fx("filibuster ended", "-3 influence")); })]});
  /* court: counsel tables */
  jP("court", {id:"jccounsel", label:"The counsel tables", sub:"Petitioner on the left, the Union on the right", x:4.6, z:6.8, r:2.4 /* NEP_BF_SPOTS.witnessStand */, acts:() => [
    gate(["bench"], "Write a dissent", "45m", "bdiss", () => { spend(45, 6); G.you.standing = jc(G.you.standing + 1); return jSay("Twelve pages. It changes nothing today and will be quoted in thirty years.", fx("+1 standing", "45 minutes")); }),
    gate(["bench"], "Take up the petitions for review", "20m", "bcertj", () => { try{ benchCert(); return null; }catch(e){ return jSay("The clerk has no petitions ready."); } }),
    gate(["cab:ag"], "Argue the Union's case", "60m", "agarg", () => { spend(60, 8); G.you.standing = jc(G.you.standing + 2); return jSay("You stand at the right-hand table and argue that the act is the law. Two justices nod; one does not.", fx("+2 standing", "an hour")); })]});

  /* rolePowers from OFFICE_DUTIES */
  const _rp = rolePowers;
  rolePowers = function(){
    const P = _rp.apply(this, arguments) || [], y = G.you, b = G.bill, live = b && !b.done; let k = null; try{ k = roleKey(); }catch(e){}
    const once = (key) => { y.used = y.used || {}; return y.used[key] === G.day; }, mark = (key) => { y.used = y.used || {}; y.used[key] = G.day; };
    if(k === "house"){
      P.push({t:"Introduce a bill for your district", off:once("hintro"), d:"Every revenue bill begins in the House.", run(){ mark("hintro"); y.standing = jc(y.standing + 1); return "Filed in the hopper with your name on it."; }});
      P.push({t:"Vote to impeach", off:once("himp"), d:"The House impeaches; the Senate tries.", run(){ mark("himp"); y.standing = jc(y.standing + 1); y.approval = jc(y.approval + (Math.random() < 0.5 ? 2 : -2)); return "You sign on to the articles. Home is divided."; }});
    }
    if(k === "pres"){
      P.push({t:"Grant a pardon", off:once("ppardon"), d:"Mercy or a favour: the press decides.", run(){ mark("ppardon"); y.approval = jc(y.approval + (Math.random() < 0.5 ? 2 : -3)); return "One name, one signature."; }});
      const V = (typeof benchVacancy === "function") ? benchVacancy() : null;
      P.push({t:"Nominate a judge to the high bench", off:!V || !!V.nom, d:V ? (V.nom ? "Your nominee is before the Senate." : "A seat is empty.") : "No seat on the high bench is empty.", run(){ try{ const o = benchCands()[0]; benchNominate(o); return o.name + " is nominated. The Senate votes on day " + G.benchVac.vote + "."; }catch(e){ return "The clerks have no list yet."; } }});
      P.push({t:"Negotiate a treaty", off:once("ptreaty"), d:"Signed by you; ratified by two thirds of the Senate.", run(){ mark("ptreaty"); try{ const r = pick(realmEnsure()); G.realmRel = G.realmRel || {}; G.realmRel[r.k] = clamp((G.realmRel[r.k] || 0) + 8, -100, 100); return "Terms agreed with " + r.t + ". The Senate will have its say."; }catch(e){ return "A draft is agreed. The Senate will have its say."; } }});
      P.push({t:"Report on the state of the Union", off:once("jb_sotu"), d:"Once a session, before both houses.", run(){ mark("jb_sotu"); y.standing = jc(y.standing + 3); y.approval = jc(y.approval + 2); return "Forty minutes and two standing ovations."; }});
      P.push({t:"Command the forces", off:once("pcmd"), d:"The situation room: as far as the law lets you.", run(){ mark("pcmd"); try{ kMark("pwar"); warCard(); return null; }catch(e){ return "The generals wait for orders."; } }});
    }
    if(k === "gov"){
      const S = (G.states || []).find(s => s.n === y.state);
      P.push({t:"Grant a state pardon", off:once("jb_gpardon"), d:"The state's mercy is yours to give.", run(){ mark("jb_gpardon"); y.approval = jc(y.approval + (Math.random() < 0.5 ? 2 : -2)); return "Signed. The parole board grumbles."; }});
      P.push({t:"Call out the state guard", off:once("jb_gguard"), d:"In an emergency only. Calmer streets, some resentment.", run(){ mark("jb_gguard"); if(S) S.unrest = clamp((S.unrest || 0) - 6, 0, 100); y.approval = jc(y.approval - 1); return "Two companies at the depot by dusk."; }});
    }
    if(k === "senate"){
      P.push({t:"Sit as a court of impeachment", off:once("jb_simp"), d:"The House impeaches; you try it.", run(){ mark("jb_simp"); y.standing = jc(y.standing + 2); return "Sworn as a juror. The trial runs into the night."; }});
      P.push({t:"Place a hold", off:!live || once("jb_shold"), d:"One note and the bill sits two days.", run(){ mark("jb_shold"); b.voteDay += 2; y.influence = jc(y.influence - 2); return b.title + " is held."; }});
      P.push({t:"Move cloture", off:!live || !b.filibustered, d:"Sixty votes end the talking.", run(){ b.filibustered = false; b.voteDay = Math.max(G.day + 1, b.voteDay - 2); y.influence = jc(y.influence - 3); return "Cloture invoked. The vote is back on."; }});
    }
    if(k === "bench"){
      for(let i = P.length - 1; i >= 0; i--) if(P[i] && P[i].t === "No case is ripe") P.splice(i, 1);
      P.push({t:"Write a dissent", off:once("jb_bdiss"), d:"Changes nothing today; quoted in thirty years.", run(){ mark("jb_bdiss"); y.standing = jc(y.standing + 1); return "Twelve pages, filed."; }});
      P.push({t:"Take up the petitions for review", off:once("jb_bcert"), d:"Choose what the bench will hear.", run(){ mark("jb_bcert"); try{ benchCert(); }catch(e){} return null; }});
    }
    if(k === "vp"){
      P.push({t:"Break a tie in the Senate", off:!live || once("jb_vptie"), d:"The only vote you cast.", run(){ mark("jb_vptie"); b.voteDay = Math.max(G.day, b.voteDay - 1); y.influence = jc(y.influence + 2); return "Fifty to fifty, and you decide it."; }});
      P.push({t:"Preside over the Senate", off:once("jb_vppre"), d:"Gavel and journal.", run(){ mark("jb_vppre"); y.standing = jc(y.standing + 1); return "You keep the order for an afternoon."; }});
    }
    const CABP = {"cab:sos":["Send a cable abroad", () => { const r = pick(realmEnsure()); G.realmRel = G.realmRel || {}; G.realmRel[r.k] = clamp((G.realmRel[r.k] || 0) + 5, -100, 100); return r.t + " warms a little."; }],
      "cab:treas":["Steady the Union's money", () => { if(G.money) G.money.index = Math.round(((G.money.index || 0) + 0.5) * 10) / 10; return "The bond men breathe out."; }],
      "cab:war":["Review the forces", () => { const w = worldEnsure(); w.heat = Math.max(0, (w.heat || 0) - 2); return "The frontier is a little calmer."; }],
      "cab:ag":["File the Union's suit", () => { const S = pick(G.states); G.cases = G.cases || []; G.cases.push({t:"the Union v. " + S.n, state:S.n, day:G.day, voted:[]}); return "Filed against " + S.n + "."; }]};
    if(CABP[k]) P.push({t:CABP[k][0], off:once("jb_dept"), d:"Your department's one power.", run(){ mark("jb_dept"); try{ return CABP[k][1](); }catch(e){ return "Done."; } }});
    return P;
  };
})();
/* ── immersion: each room has a day of its own. You walk into a scene, the clock strikes, somebody at their post says something in their own voice, and what is going on depends on the hour ── */
const K_AMB = {
  senate:[
    {h:[8,10], t:"The chamber is half lit. Pages move down the aisles setting out the day's calendar, one folder per desk."},
    {h:[9,12], t:"Murmur from the cloakroom door: senators drifting in, coats over arms, already arguing."},
    {h:[10,17], t:"The presiding officer's gavel taps once, and the room finds its seats."},
    {h:[11,13], t:"The clerk's voice rises over the noise, reading the journal in the flat tone of a man who has read it for forty years."},
    {h:[12,15], t:"A senator is on the floor. Two rows are listening; the rest are counting."},
    {h:[13,18], t:"In the gallery, a school party is being told to stop whispering. They have not."},
    {h:[15,19], t:"Light slants through the high windows and lays the shadow of the rostrum across the carpet."},
    {h:[17,21], t:"The chamber empties by degrees. A page collects the folders nobody opened."}],
  court:[
    {h:[8,10], t:"The Marshal checks the doors, the water jugs and the cushion on the highest chair, in that order."},
    {h:[9,12], t:"Somewhere behind the bench a door closes softly and does not open again. Conference."},
    {h:[10,16], t:"The cryer's voice carries from the doorway: 'All persons having business before this Court.'"},
    {h:[11,17], t:"Counsel shuffle papers at the tables. A lawyer rereads a page for the fifth time and crosses a sentence out."},
    {h:[13,16], t:"A clerk walks the length of the room on tiptoe, which makes more noise than walking."},
    {h:[15,19], t:"The high windows go amber. The five tall chairs behind the bench look like they are waiting for someone."},
    {h:[17,21], t:"The Court is quiet. The only sound is a clerk turning pages in the next room."}],
  exec:[
    {h:[7,10], t:"A telephone rings in the outer office and is answered before the second ring."},
    {h:[8,12], t:"Aides cross the room with folders held to their chests, not meeting anyone's eyes."},
    {h:[9,14], t:"The map table is covered in markers; someone has moved the pin on the frontier since yesterday."},
    {h:[11,17], t:"The cabinet table has four coffee cups, three half-drunk, and no agreement on anything."},
    {h:[14,18], t:"A cable comes in from a foreign capital. It is read, folded, and carried through the inner door."},
    {h:[16,20], t:"Through the windows, the lamplighters are working along the south lawn."},
    {h:[18,22], t:"The wing winds down. One light stays on, at your desk."}],
  govoffice:[
    {h:[7,10], t:"The Governor's secretary is already at the door with a list in her hand and a pencil behind her ear."},
    {h:[9,12], t:"On the waiting bench a farmer in his good coat sits very straight, holding his hat on his knee."},
    {h:[10,15], t:"Voices rise and fall in the outer room as the line moves up. Somebody is practising a speech under their breath."},
    {h:[11,16], t:"A county map hangs unevenly on the wall, with pins in the places where the road floods."},
    {h:[13,17], t:"The statehouse messenger comes in with a satchel of bills and goes out without being thanked."},
    {h:[15,19], t:"Outside the window, the flag cracks in the wind from the river."},
    {h:[17,21], t:"The State House empties. A cleaner starts at the far end of the corridor, humming."}],
  office:[
    {h:[8,10], t:"Somebody is already running a vacuum two floors down; the whole building hums with it."},
    {h:[9,12], t:"The telephone in the outer room rings and rings and is finally answered by an intern with her mouth full."},
    {h:[12,14], t:"Lunch trays are carried past the door. Nobody in this building eats at a table."},
    {h:[14,18], t:"The afternoon light puts a bar of gold across the desk and the pile of letters on it."},
    {h:[18,22], t:"The corridor outside goes quiet. A last set of footsteps passes, and then none."}]
};
const K_STAFFTALK = {senclerk:["Order in the chamber, please.", "The journal will be read.", "Thank you, Senators."], courtclerk:["Filed, with the stamp.", "That petition came in late and nobody has noticed yet.", "The docket has moved."], marshal:["Keep to the rail, please.", "Quiet in the gallery.", "All rise."], chief:["The Executive is waiting.", "Three minutes. Tops.", "Not that door."], aide:["It is in the file.", "Page two, please.", "That came in overnight."], gsec:["Next, please.", "The Governor will see you now.", "Hold your place, you are fourth."], gcounsel:["I would not say that out loud.", "That will be litigated.", "Put it in writing."], senator:["Is that really the language?", "I will have to see the count.", "We are not there yet."], justice:["The question is narrower than they think.", "I want to read it again.", "Not on this record."]};
function kHourLine(room, h){ const L = (K_AMB[room] || []).filter(x => h >= x.h[0] && h < x.h[1]); return L.length ? L[Math.floor(Math.random() * L.length)].t : null; }
function kStaffHere(){ try{ return (G.civ || []).filter(c => c && c.krole && c.room === G.room && !c.gone); }catch(e){ return []; } }
function kScene(room){
  try{
    if(!K_AMB[room] || !G.you) return; const h = Math.floor((G.minute || 0) / 60), key = room + ":" + G.day + ":" + h; if(kScene._k === key) return; kScene._k = key;
    const line = kHourLine(room, h), st = kStaffHere().slice(0, 3), who = st.length ? " " + st.map(c => c.role + " " + surname(c.name)).join(", ") + (st.length > 1 ? " are" : " is") + " at " + (st.length > 1 ? "their posts" : "their post") + "." : "";
    const hint = (function(){ try{ const d = docketToday().find(x => !kOnceToday(x.key) && (G.minute || 0) >= x.h * 60 - 60); return d ? " On your calendar: " + d.t.toLowerCase() + "." : ""; }catch(e){ return ""; } })();
    if(line) feed(line + who + hint);
  }catch(e){}
}
{ const st = document.createElement("style"); st.textContent = "#kClock{position:fixed;right:14px;top:10px;z-index:9500;font:600 12px Archivo,system-ui,sans-serif;letter-spacing:.06em;color:#f0e4c8;background:rgba(14,16,20,.62);border:1px solid rgba(201,162,74,.4);border-radius:3px;padding:4px 9px;pointer-events:auto;cursor:pointer;text-align:right;line-height:1.25}#kClock b{display:block;font-size:15px;letter-spacing:.04em}#kClock small{font-weight:500;opacity:.75;font-size:10px;letter-spacing:.08em;text-transform:uppercase}#kClock.is-paused b::after{content:' \u23f8';opacity:.7}@media (max-width:620px){#kClock{top:auto;bottom:46px;right:8px}}";
  document.head.appendChild(st);
  setInterval(() => { try{ if(!G || !G.you){ const c0 = document.getElementById("kClock"); if(c0) c0.style.display = "none"; return; } let c = document.getElementById("kClock"); if(!c){ c = document.createElement("div"); c.id = "kClock"; document.body.appendChild(c); } c.style.display = ""; const d = (G.day - 1) % 7; c.className = G.running === false ? "is-paused" : ""; c.innerHTML = "<b>" + hhmm() + "</b><small>" + ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"][d] + " \u00b7 day " + G.day + "</small>"; }catch(e){} }, 1000); }
let _kAmbAt = 0, _kChime = "";
function kAmbient(){
  try{
    if(!G.running || !G.you || typeof TALK === "undefined" || TALK.open || (SIT && SIT.on) || !K_AMB[G.room]) return; const now = performance.now(); if(now < _kAmbAt) return; _kAmbAt = now + 26000 + Math.random() * 22000;
    const h = Math.floor((G.minute || 0) / 60), ck = G.room + ":" + G.day + ":" + h;
    if(_kChime !== ck && (G.minute || 0) % 60 < 20){ _kChime = ck; const words = ["one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"]; feed("The clock strikes " + words[((h + 11) % 12)] + "."); return; }
    const staff = kStaffHere(), r = Math.random();
    if(staff.length && r < 0.5){ const c = staff[Math.floor(Math.random() * staff.length)], bank = K_STAFFTALK[c.krole] || ["..."], line = bank[Math.floor(Math.random() * bank.length)]; c.say = line; c.sayT = 4; try{ speakAt(c, line); }catch(e){} return; }
    const t = kHourLine(G.room, h); if(t) feed(t);
  }catch(e){}
}
{ const _er = enterRoom; enterRoom = function(dest, from){ const r = _er.apply(this, arguments); try{ kScene(dest); }catch(e){} return r; }; }
function amendText(S){ const A = (S && S.amend) || []; return A.length ? " Amendments agreed at open hours, to be attached: " + A.map(a => a.title + " (" + a.from + ")").join("; ") + "." : ""; }
function amendApply(S){ const A = (S && S.amend) || []; if(!A.length) return ""; const y = G.you; S.unrest = clamp(S.unrest - A.length, 0, 100); y.approval = clamp(y.approval + A.length, 0, 100); S.amend = []; return " The amendments from open hours were attached: " + A.map(a => a.title).join(", ") + "."; }
function govBrief(S){
  spend(20, 3);
  if(!S) return "The secretary reads the day's file. Nothing in it is on fire.";
  const w = S.unrest > 60 ? "Unrest is high: crowds outside two county courthouses." : S.unrest > 35 ? "The counties are restless, not yet angry." : "The counties are quiet.";
  return "The state this morning. " + w + " Industry stands at " + Math.round(S.ind || 0) + ". " +
    (S.bill ? "The legislature has sent over the " + S.bill.title + "." : "Nothing new from the legislature.");
}
function govDesk(S){
  if(!S || !S.bill){ spend(10, 1); return "Nothing came over from the statehouse today. You read the files of two pardons and sign neither."; }
  const y = G.you, b = S.bill;
  choiceCard("The statehouse desk", "the " + b.title, "Passed by the legislature of " + y.state + ". Your signature makes it law; your veto sends it back." + amendText(S), [
    {t:"Sign it", d:"Law today. It moves industry and the mood the way it was written to.", run(){
      S.ind = clamp(S.ind + b.ind, 0, 100); S.unrest = clamp(S.unrest + b.unrest, 0, 100);
      S.lean = clamp(Math.round(S.lean + b.dir*3), -100, 100); S.bill = null;
      const fit = (b.dir > 0 ? 1 : -1) * (b.axis === "econ" ? S.lean : b.axis === "lib" ? -S.lean*0.4 : S.lean*0.3);
      y.approval = clamp(y.approval + (fit > 0 ? 3 : -2), 0, 100);
      reactState(S, b, true); feed("Governor " + surname(y.name) + " signed the " + b.title + ".", "good");
      return "Signed at the desk, with the bill's sponsors standing behind you." + amendApply(S); }},
    {t:"Veto it", d:"Back to the legislature. They may try again next session.", run(){
      S.bill = null; S.unrest = clamp(S.unrest + 2, 0, 100); y.approval = clamp(y.approval + rint(-3, 4), 0, 100);
      reactState(S, b, false); feed("Governor " + surname(y.name) + " vetoed the " + b.title + ".", "bad");
      return "Vetoed. The majority leader of the statehouse will not return your calls this week."; }}
  ], "gdesk", 15);
  return null;
}
function govBudget(S){
  const y = G.you;
  const pay = (unrest, ind, app, line) => () => {
    if(S){ S.unrest = clamp(S.unrest + unrest, 0, 100); S.ind = clamp(S.ind + ind, 0, 100); }
    y.approval = clamp(y.approval + app, 0, 100);
    return line;
  };
  choiceCard("Agencies and the budget", "This week's money", "There is money for one department. The others will say so, loudly.", [
    {t:"Roads and bridges", d:"Industry up; the counties notice in spring.", run:pay(-1, 3, 1, "Crews out on the bottom road by Monday.")},
    {t:"Schools", d:"Quieter counties, slower to show.", run:pay(-3, 1, 2, "Three teachers hired where the state check was late.")},
    {t:"The constabulary", d:"Order now; resentment later.", run:pay(-4, 0, -1, "More men on the corners. Some streets feel safer and some feel watched.")},
    {t:"Hospitals and the poor", d:"Approval, and a bill the legislature will remember.", run:pay(-2, -1, 3, "The maternity floor reopens. The treasurer sends a sharp letter.")}
  ], "gbud", 30);
  return null;
}
function officePress(where){
  const y = G.you;
  spend(30, 5);
  const ok = chance(0.45 + (y.standing - 50) / 160);
  y.approval = clamp(y.approval + (ok ? 2 : -2), 0, 100);
  return ok ? "Twenty minutes at " + where + ". You gave them a clean line and they used it."
            : "Twenty minutes at " + where + ". One question you did not see coming, and it leads the evening papers.";
}
function officeCalls(){
  const y = G.you;
  spend(30, 4); y.approval = clamp(y.approval + 1, 0, 100);
  return "An hour on the phone with " + y.state + ": two mayors, a statehouse leader and a woman whose son is waiting on a pension.";
}
function benchConference(){
  const y = G.you;
  spend(40, 5); y.standing = clamp(y.standing + 1, 0, 100);
  const c = (G.cases || []).find(x => x && !x.done);
  return c ? "In conference the bench splits on " + c.t + ". Nobody will say which way they lean until the opinion is drafted."
           : "In conference: nothing ripe. You talk about the long view and the coffee.";
}
/* a small decision card: options run once, then the day remembers it */
function choiceCard(eyebrow, title, text, opts, key, mins){
  G.running = false;
  card.innerHTML = '<div class="eyebrow">' + sitEsc(eyebrow) + '</div><h1>' + sitEsc(title) + '</h1><p>' + sitEsc(text) + '</p>' +
    opts.map((o, i) => '<div class="whip__row"><span class="whip__n">' + sitEsc(o.t) + '</span><span class="whip__w">' + sitEsc(o.d || "") + '</span>' +
      '<span class="whip__b"><button type="button" class="btn btn--ghost whip__go" data-ch="' + i + '">Choose</button></span></div>').join("") +
    '<div id="chSay" class="dream"></div>' +
    '<div class="card__actions"><button type="button" class="btn" id="chClose">Close</button></div>';
  veil.hidden = false;
  el("chClose").addEventListener("click", () => walkNow());
  card.querySelectorAll("[data-ch]").forEach(bt => bt.addEventListener("click", () => {
    const o = opts[+bt.getAttribute("data-ch")]; if(!o) return;
    spend(mins || 20, 3);
    const r = o.run();
    if(key) kMark(key);
    card.querySelectorAll("[data-ch]").forEach(x => x.disabled = true);
    const s = el("chSay"); if(s) s.textContent = r || "";
    try{ if(r) tlog("You", r, "you"); }catch(e){}
  }));
}

/* ── the panel: your chair, not the House ────────────────── */
function refreshOfficePane(){
  const y = G.you, k = heldOffice(), pane = el("paneFloor");
  if(!pane) return;
  const D = docketToday(), m = G.minute || 0, here = inMyWorkRoom();
  const rows = D.map((d, i) => {
    const done = kOnceToday(d.key);
    const when = (d.h > 12 ? d.h - 12 : d.h) + ":00 " + (d.h >= 12 ? "pm" : "am");
    const state = done ? "done" : m < d.h*60 - 60 ? "later" : m >= 19*60 ? "missed" : "now";
    return '<div class="whip__row"><span class="whip__n">' + when + ' · ' + sitEsc(d.t) + '</span><span class="whip__w">' + sitEsc(d.d) + '</span>' +
      '<span class="whip__b"><button type="button" class="btn btn--ghost whip__go" data-dk="' + i + '"' + (state !== "now" ? " disabled" : "") + '>' +
      (state === "done" ? "Done" : state === "later" ? "Later" : state === "missed" ? "Missed" : here ? "Do it" : "Go") + '</button></span></div>';
  }).join("");
  const P = rolePowers();
  const S = (G.states || []).find(s => s.n === y.state);
  let side = "";
  if(k === "gov" && S) side = '<p class="muted">' + y.state + ': unrest <b>' + Math.round(S.unrest || 0) + '</b> · industry <b>' + Math.round(S.ind || 0) + '</b>' +
    (S.bill ? ' · on your desk: <b>' + sitEsc(S.bill.title) + '</b>' : '') + '.</p>';
  const b = G.bill;
  const house = b && !b.done ? (function(){ const t = tallyBill(b, true);
    return '<div class="eyebrow" style="margin-top:14px">In the House, without you</div><p class="muted">' + sitEsc(b.title) + ': projected <b>' + t.aye + '</b> aye, <b>' + t.no + '</b> no, roll call day ' + b.voteDay +
      '. You have no vote there' + (k === "gov" ? '; the members from ' + y.state + ' still take your calls.' : '.') + '</p>'; })() : "";
  pane.innerHTML = '<div class="billbox"><div class="eyebrow">Your office · ' + ROLE_T[roleKey()] + '</div>' +
    '<div class="h-serif">' + sitEsc(officeTitle()) + '</div><div class="muted">' + sitEsc(officeSeat()) + ' · ' + sitEsc(ROOMS[homeRoom()].t) + '</div></div>' + side +
    '<div class="eyebrow">' + sitEsc(schedBy()) + '\'s diary</div>' + schedListHTML() +
    '<div class="eyebrow" style="margin-top:14px">The routine</div>' + (rows || '<p class="muted">Nothing scheduled.</p>') +
    '<div class="eyebrow" style="margin-top:14px">Powers of the office</div>' +
    P.map((p, i) => '<div class="whip__row"><span class="whip__n">' + sitEsc(p.t) + '</span><span class="whip__w">' + sitEsc(p.d || "") + '</span>' +
      '<span class="whip__b"><button type="button" class="btn btn--ghost whip__go" data-pw="' + i + '"' + (p.off ? ' disabled' : '') + '>Do it</button></span></div>').join("") +
    house;
  schedWire(pane, refreshOfficePane);
  pane.querySelectorAll("[data-dk]").forEach(bt => bt.addEventListener("click", () => docketRun(D[+bt.getAttribute("data-dk")])));
  pane.querySelectorAll("[data-pw]").forEach(bt => bt.addEventListener("click", () => {
    const p = P[+bt.getAttribute("data-pw")]; if(!p || p.off) return;
    spend(20, 4);
    const r = p.run();
    if(r) note(r, true);
    refreshPanels();
  }));
}
function officeTabName(){
  const k = heldOffice();
  return !k || k === "house" ? "Floor" : k === "gov" ? "State" : k === "senate" ? "Senate" : k === "bench" ? "Bench" : "Executive";
}
function officeTabLabel(){
  const t = document.querySelector('[data-pane="paneFloor"]'); if(!t) return;
  const lab = officeTabName();
  if(t.textContent !== lab) t.textContent = lab;
}

/* ── free will: a member who wins elsewhere may not let go ──
   Nothing here decides that it happens. Their own temper decides,
   and so do the people around them. Most go quietly. */
function dualStart(m, to, news){
  m.dual = {to, since:G.day};
  const where = to === "gov" ? "the governorship of " + m.state : "the Senate";
  G.cases = G.cases || [];
  G.cases.push({t:"the House v. " + surname(m.name), state:m.state, day:G.day, voted:[], dual:m.id});
  try{ remember(m, "They want me to choose. I was elected twice and I will not be told which one counts.", 0, true); }catch(e){}
  (G.members || []).forEach(o => {
    if(!o || o === m || o.gone || !chance(0.35)) return;
    try{ hears(o, m.name + " won " + where + " and will not give up the House seat."); }catch(e){}
  });
  const line = m.name + " won " + where + " and refuses to give up the House seat. The Speaker's office says the Charter forbids holding both; " + surname(m.name) + "'s counsel says it is silent.";
  if(news) news.push(line); else note(line, true);
}
function dualVacate(m, why, news){
  if(!m || !m.dual) return;
  const to = m.dual.to;
  m.dual = null;
  (G.cases || []).forEach(c => { if(c && c.dual === m.id && !c.done) c.done = true; });
  G.members = G.members.filter(x => x !== m);
  G.seatsBy[m.party] = Math.max(0, (G.seatsBy[m.party] || 1) - 1);
  try{
    const n = makeMember(chance(0.5) ? m.party : (m.party === "FED" ? "COM" : "FED"), {fresh:true});
    n.state = m.state; n.dist = m.dist; n.margin = rint(1, 9); n.terms = 1; n.freshman = true;
    G.members.push(n); G.seatsBy[n.party] = (G.seatsBy[n.party] || 0) + 1;
    try{ placeInRoom(n); }catch(e){}
    _allCache = null;
  }catch(e){}
  const line = m.name + " " + why + " " + m.state + " " + m.dist + " holds a special election; the new member is sworn in.";
  if(news) news.push(line); else note(line, true);
}
function dualTick(news){
  (G.members || []).filter(m => m && m.dual && !m.gone).forEach(m => {
    const days = G.day - m.dual.since;
    const friends = (G.members || []).filter(o => o !== m && o.allies && o.allies.indexOf(m.id) >= 0).length;
    const stubborn = ((m.traits.conviction || 50) + (m.traits.ambition || 50)) / 200;
    const c = (G.cases || []).find(x => x && x.dual === m.id);
    if(c && c.done && c.ruled === "member"){ m.dual.kept = true; return; }
    if(c && c.done && c.ruled === "union"){ dualVacate(m, "lost in the high court and gave up the House seat.", news); return; }
    if(m.dual.kept) return;
    if(chance(0.06 + days * 0.012 - stubborn * 0.05 - friends * 0.01)){ dualVacate(m, "gave in after " + days + " days and resigned the House seat.", news); return; }
    if(days >= 4 && majorityParty() !== m.party && chance(0.08)){ dualVacate(m, "was unseated by a vote of the House majority.", news); return; }
    if(days >= 6 && c && !c.done && !(G.you.office === "bench" && !G.you.out) && chance(0.12)){
      const forMember = chance(0.25);
      c.done = true; c.ruled = forMember ? "member" : "union";
      if(forMember){
        m.dual.kept = true;
        try{ setPrecedent("let a member keep the House seat while holding a second office", "that the Charter does not forbid holding two elected offices", false, "The high bench"); }catch(e){}
        const line = "The high court ruled for " + m.name + ": the Charter is silent, so both seats stand. Expect an amendment.";
        if(news) news.push(line); else note(line, true);
      } else dualVacate(m, "lost in the high court and gave up the House seat.", news);
    }
  });
}

/* ══════════════════════════════════════════════════════════
   20261012h · COUNSEL KEEPS THE DIARY
   Whoever holds the chair, somebody keeps the diary: counsel to a
   Governor, a chief of staff, a clerk. They bring you what the world
   is actually doing: laws that passed and now land somewhere, a county
   on strike, a bill on your desk, a lawsuit, a storm, a delegation, a
   rival. You accept or decline. Nothing is a template; if nothing is
   happening, the diary is thin. Ignore a thing and it keeps going
   without you, usually worse.
   ══════════════════════════════════════════════════════════ */
const SCHED_BY = {gov:"Counsel to the Governor", senate:"Your chief of staff", bench:"Your clerk", pres:"The Chief of Staff", house:"Your chief of staff"};
function schedBy(){ return SCHED_BY[heldOffice() || "house"] || "Your chief of staff"; }
function schedState(){ const y = G.you; return (G.states || []).find(s => s.n === y.state) || null; }
function schedHour(used, lo, hi){
  const free = [];
  for(let h = lo || 9; h <= (hi || 18); h++) if(used.indexOf(h) < 0) free.push(h);
  const h = free.length ? pick(free) : rint(lo || 9, hi || 18);
  used.push(h); return h;
}
/* what is going on, in the order counsel would raise it */
function schedSources(role){
  const y = G.you, S = schedState(), out = [];
  const seen = G.schedSeen || (G.schedSeen = {});
  const acts = (G.lastActs || []).filter(a => a && a.title && G.day - (a.day || 0) <= 6);
  acts.forEach(a => {
    const key = role + ":law:" + a.title;
    if(seen[key]) return;
    out.push({ok:"law", key, act:a, w:3});
    if(role === "senate" && !a.senate) out.push({ok:"senact", key:"senact:" + a.title, act:a, w:4});
    if(role === "pres" && !a.signed && !a.vetoed) out.push({ok:"sign", key:"sign:" + a.title, act:a, w:5});
  });
  if(S && (role === "gov" || role === "senate") && (S.unrest || 0) > 42) out.push({ok:"unrest", key:"unrest:" + G.day, w:(S.unrest > 60 ? 5 : 2)});
  if(role === "pres"){
    const hot = (G.states || []).slice().sort((a, b) => (b.unrest || 0) - (a.unrest || 0))[0];
    if(hot && hot.unrest > 55) out.push({ok:"unrest", key:"unrest:" + G.day, st:hot.n, w:4});
  }
  if(S && S.bill && role === "gov" && !S.bill.met) out.push({ok:"sponsors", key:"sponsors:" + S.bill.title, w:3});
  (G.cases || []).filter(c => c && !c.done).forEach(c => {
    if(role === "bench") out.push({ok:"argument", key:"arg:" + c.t, cs:c.t, w:3});
    else if((role === "gov" && c.state === y.state) || role === "pres") out.push({ok:"suit", key:"suit:" + c.t, cs:c.t, w:3});
  });
  let wx = null; try{ wx = wxToday(); }catch(e){}
  if(wx && (wx.k === "storm" || wx.k === "snow" && wx.cover >= 2 || wx.k === "heat") && role !== "bench") out.push({ok:"weather", key:"wx:" + G.day, wx:wx.k, w:4});
  if(role === "gov" || role === "pres" || role === "senate"){
    try{ const r = pick(realmEnsure()); if(r && chance(0.35)) out.push({ok:"realm", key:"realm:" + G.day, realm:r.k, w:1}); }catch(e){}
  }
  const b = G.bill;
  if(b && !b.done && (role === "gov" || role === "senate")){
    const fit = (function(){ try{ return districtFit(b); }catch(e){ return 0; } })();
    if(Math.abs(fit) > 15 || b.target === y.state) out.push({ok:"delegation", key:"deleg:" + b.title, w:2});
  }
  try{ const rv = rivalLive(); if(rv && chance(0.4)) out.push({ok:"rival", key:"rival:" + G.day, w:1}); }catch(e){}
  return out;
}
const SCHED_ROOM = r => ROOMS[r] ? r : homeRoom();
function schedMake(src, role, used){
  const y = G.you, S = schedState(), hr = homeRoom();
  const a = src.act;
  const E = {k:"office", ok:src.ok, key:src.key, by:schedBy(), day:G.day, done:false, _rich:true};
  if(src.ok === "law"){
    const kind = a.kind;
    Object.assign(E, {hour:schedHour(used), room:role === "house" ? "district" : hr, act:a.title, akind:kind,
      t:role === "gov" ? "Agencies on the " + a.title : role === "house" ? "Constituents on the " + a.title : "Briefing: how the " + a.title + " is landing",
      d:role === "gov" ? "It is law now, and the departments want to know how hard to carry it out in " + y.state + "." :
        role === "house" ? "People at home who live under it now want to tell you what it is doing." :
        "Staff have the first reports from the states on the " + a.title + "."});
  } else if(src.ok === "senact"){
    Object.assign(E, {hour:schedHour(used, 11, 16), room:"senate", act:a.title, t:"The Senate takes up the " + a.title,
      d:"Passed by the House on day " + a.day + ". The Senate votes on it today."});
  } else if(src.ok === "sign"){
    Object.assign(E, {hour:schedHour(used, 9, 15), room:"exec", act:a.title, t:"The " + a.title + " arrives for signature",
      d:"Enrolled, printed and on the desk. Sign it, or send it back."});
  } else if(src.ok === "unrest"){
    const st = src.st || y.state;
    const SS = (G.states || []).find(s => s.n === st);
    const what = pick(["a strike at the mills", "a march on the county courthouse", "a run on the savings bank", "a stand-off at the rail yard"]);
    Object.assign(E, {hour:schedHour(used), room:role === "pres" ? hr : "district", st, what,
      t:"Travel: " + what + " in " + st, d:"Unrest stands at " + Math.round((SS && SS.unrest) || 0) + ". The sheriff, the strike committee and the papers are all waiting to see who comes."});
  } else if(src.ok === "sponsors"){
    Object.assign(E, {hour:schedHour(used), room:hr, bill:S.bill.title, t:"The sponsors of the " + S.bill.title,
      d:"Statehouse members who wrote it want twenty minutes before it reaches your desk."});
  } else if(src.ok === "suit"){
    const cs = (G.cases || []).find(x => x.t === src.cs);
    let hook = "The lawyers want a decision before the next filing.";
    try{ const b = suitExplain(cs || {t:src.cs}); hook = b.split(". ").slice(0, 2).join(". ") + "."; }catch(e){}
    Object.assign(E, {hour:schedHour(used), room:hr, cs:src.cs, t:"Counsel on " + src.cs, d:hook});
  } else if(src.ok === "argument"){
    Object.assign(E, {hour:schedHour(used, 10, 15), room:"court", cs:src.cs, t:"Argument: " + src.cs, d:"Briefs are in. Counsel for both sides at the lectern."});
  } else if(src.ok === "weather"){
    const W = {storm:"storm damage along the river", snow:"roads shut under the snow", heat:"the heat in the tenements"}[src.wx] || "the weather";
    Object.assign(E, {hour:schedHour(used, 9, 14), room:"district", wx:src.wx, t:"Travel: " + W, d:"Calls from the counties since dawn. The cameras will go wherever the officials go."});
  } else if(src.ok === "realm"){
    const r = (realmEnsure() || []).find(x => x.k === src.realm);
    Object.assign(E, {hour:schedHour(used), room:hr, realm:src.realm, t:"A delegation from " + (r ? r.t : "abroad"), d:"They want " + ((r && r.want) || "a hearing") + ", and they have brought a letter."});
  } else if(src.ok === "delegation"){
    const b = G.bill;
    Object.assign(E, {hour:schedHour(used, 9, 16), room:"corridor", bill:b.title, t:"Travel: " + y.state + "'s House members on the " + b.title,
      d:"The members from home are in the Statuary Corridor. They will hear you out before the roll call."});
  } else if(src.ok === "rival"){
    const rv = rivalLive();
    Object.assign(E, {hour:schedHour(used, 12, 18), room:"steps", t:"Answer " + (rv ? rv.name : "your rival") + " on the Steps", d:"A rally across the plaza. Counsel thinks you should be seen; the press thinks so too."});
  } else return null;
  E.room = SCHED_ROOM(E.room);
  return E;
}
function schedBuild(role, n){
  const used = (G.events || []).filter(e => e.day === G.day).map(e => e.hour);
  try{ docketToday().forEach(d => used.push(d.h)); }catch(e){}
  const src = schedSources(role).sort((a, b) => b.w - a.w + (Math.random() - 0.5) * 2);
  const out = [];
  for(const s of src){
    if(out.length >= n) break;
    if((G.events || []).some(e => e.key === s.key && e.day === G.day)) continue;
    const e = schedMake(s, role, used);
    if(e){ out.push(e); (G.schedSeen || (G.schedSeen = {}))[s.key] = G.day; }
  }
  return out;
}
/* the morning diary for a chair that is not the House */
function schedMorning(){
  const role = heldOffice();
  const n = 1 + Math.min(3, Math.floor(schedSources(role).length / 2) + (chance(0.5) ? 1 : 0));
  schedBuild(role, n).forEach(e => G.events.push(e));
}
/* the House gets its share of what laws do, too */
function schedHouse(){
  const e = schedBuild("house", chance(0.5) ? 1 : 0);
  e.forEach(x => G.events.push(x));
}
/* during the day, counsel adds what has just happened */
function schedWatch(){
  if(!G.you || !G.running || G.you.out) return;
  const m = G.minute || 0;
  if(m < 8*60 || m > 16*60) return;
  if(!chance(abroadOffice() ? 0.22 : 0.06)) return;
  const role = heldOffice();
  const add = schedBuild(role, 1).filter(e => { e.hour = Math.max(e.hour, Math.floor(m / 60) + 2); return e.hour <= 19; });
  add.forEach(e => {
    G.events.push(e);
    feed(schedBy() + ": " + e.t + ", " + hourLabel(e.hour) + ". Accept or decline in the diary.", "big");
  });
  if(add.length){ try{ refreshPanels(); }catch(e){} }
}

/* ── what happens when it comes due ──────────────────────── */
/* what the bench is actually being asked, in words a person can read */
function suitExplain(c){
  if(!c) return "A case is on the docket. Counsel wants to know whether you defend it.";
  try{ if(typeof lxEnrich === "function") lxEnrich(c); }catch(e){}
  const t = String(c.t || "the case");
  const bits = t.split(" v. ");
  const left = (bits[0] || "The plaintiff").trim();
  const right = (bits[1] || "the other side").replace(/\s*\([^)]*\)\s*$/, "").trim();
  const paren = (/\(([^)]+)\)\s*$/.exec(t) || [])[1] || "";
  if(/House v\. the President/i.test(t)){
    return "The House has sued the President" + (paren ? " over " + paren : "") + ". Congress had not voted to authorise it. The Charter gives Congress the power to declare war and to raise and pay for soldiers. The executive may act alone only as far as Congress, or a standing precedent, has already allowed. The House says an act done first, and explained afterwards, is not law. The President's answer is that the danger would not wait for a vote. A claim under the Charter is heard first by the high bench, which is why this does not climb court by court.";
  }
  if(/^the Union v\./i.test(t)){
    return "The Union has sued " + right + (paren ? " over " + paren : "") + ". A State does not get to make a treaty, shut a port to a foreign country's goods, or put its own soldiers on a foreign frontier. Those powers stay with the Union unless the President has consented and Congress has allowed it. The State says it was looking after its own people. The bench is asked which of those readings the Charter will bear.";
  }
  if(c.dual != null || /^the House v\./i.test(t)){
    return "The House has sued " + (right || "one of its members") + ". The claim is that one person cannot hold a seat in the House and a second elected office at the same time. The member's answer is that the Charter never says so in words. The bench decides whether that silence is permission, or a gap the House may fill.";
  }
  if(c.lx && typeof LX_TH !== "undefined" && LX_TH[c.lx.th]){
    const L = c.lx, Th = LX_TH[L.th];
    const who = L.pk === "state" ? ("The attorney general of " + (L.plaintiff || left)) : L.pk === "person" ? ((L.plaintiff || left) + (L.who ? ", " + L.who : "")) : (L.plaintiff || left);
    return who + " has sued the Union over the " + L.act + ". The section under attack is section " + L.sec + ", " + String(L.head || "the operative section").toLowerCase() + ". The claim is that this section " + Th.phrase + ". Because that is a claim under the Charter, the Act's own judicial-review section sends it first to the high bench. If you fight it, the Union asks the bench to hold that " + Th.up.replace(/\.\s*$/, "") + ". If you lose, that section is struck. The Act's severability section keeps the rest of it in force.";
  }
  if(/v\. the Union/i.test(t)){
    const who = c.state ? ("The attorney general of " + c.state) : left;
    return who + " has sued the Union" + (paren ? " over the " + paren : "") + ". " + (c.state
      ? "A State sues when it says the Union has ordered its legislature, or tied its people's money to a condition the State cannot refuse, in a matter the Charter left at home. "
      : "A person sues when the law takes something the Charter protects: property without payment, liberty without a hearing, or a contract the public did not need to break. The Act says any person aggrieved may bring that action. ") +
      "A Charter claim is heard first by the high bench. Fighting it all the way up is the choice to defend the law there instead of rewriting it.";
  }
  return left + " has sued " + right + (paren ? " over " + paren : "") + ". The papers name the claim. The choice in front of you is whether the Union defends that claim in the high bench, gives the point up, or argues it in the papers before a judge has written a word.";
}
function schedOpts(e){
  const y = G.you, S = (G.states || []).find(s => s.n === (e.st || y.state)), role = heldOffice() || "house";
  const app = d => { y.approval = clamp(y.approval + d, 0, 100); };
  const sta = d => { y.standing = clamp(y.standing + d, 0, 100); };
  const inf = d => { y.influence = clamp(y.influence + d, 0, 100); };
  const un = d => { if(S) S.unrest = clamp((S.unrest || 0) + d, 0, 100); };
  const ind = d => { if(S) S.ind = clamp((S.ind || 0) + d, 0, 100); };
  const home = () => (G.members || []).filter(m => m && !m.gone && m.kind === "member" && m.state === y.state);
  const act = () => (G.lastActs || []).find(a => a.title === e.act);
  if(e.ok === "law"){
    if(role === "gov") return {body:"The department heads have read it. The question is how hard " + y.state + " leans into it.", opts:[
      {t:"Carry it out in full", run(){ ind(2); sta(2); app(e.akind === "statefed" ? -3 : 1); return "The departments move. It will be felt by the spring."; }},
      {t:"Slow-walk it", run(){ app(2); sta(-2); un(-2); return "Rules drafted, rules redrafted. The Union will notice in a month."; }},
      {t:"Challenge it in court", run(){ app(3); sta(-3); G.cases = G.cases || []; G.cases.push({t:y.state + " v. the Union (" + e.act + ")", state:y.state, day:G.day, voted:[]}); return "Your attorney general files by Friday. The claim is that the Union cannot make " + y.state + " carry out the " + e.act + " where the Charter left the matter to the State. A Charter claim is heard first by the high bench."; }}]};
    if(role === "house") return {body:"A parish hall and forty chairs. They have the law in hand and stories about it.", opts:[
      {t:"Listen to all of them", run(){ app(3); spend(60, 10); return "You stay until the last hand is down."; }},
      {t:"Promise to fix it with an amendment", run(){ app(2); sta(-1); return "Now you have to write one."; }},
      {t:"Defend the law", run(){ app(-1); sta(2); return "Some leave angry. The leadership hears you held the line."; }}]};
    return {body:"Reports from the states, sorted by how loud they are.", opts:[
      {t:"Push the agencies to deliver", run(){ inf(2); sta(1); return "Letters out under your name."; }},
      {t:"Note it and move on", run(){ return "Filed."; }}]};
  }
  if(e.ok === "senact"){
    const a = act(); const fit = (function(){ try{ return a && a.pos ? alignment(y, {pos:a.pos}) : 0; }catch(x){ return 0; } })();
    const done = v => () => { if(a) a.senate = v; return v; };
    return {body:"The clerk calls the roll. Your name is near the middle.", opts:[
      {t:"Vote aye", run(){ done("aye")(); sta(fit >= 0 ? 2 : -1); app(fit >= 0 ? 1 : -2); feed("Senator " + surname(y.name) + " voted aye on the " + e.act + "."); return "Aye. It goes to the Executive."; }},
      {t:"Vote no", run(){ done("no")(); sta(fit < 0 ? 2 : -1); app(fit < 0 ? 1 : -2); feed("Senator " + surname(y.name) + " voted no on the " + e.act + "."); return "No, and you said why in two sentences."; }},
      {t:"Hold the floor against it", off:y.influence < 6, run(){ done("filibuster")(); inf(-6); app(fit < 0 ? 4 : -4); return "Nine hours on your feet. The act waits another week."; }}]};
  }
  if(e.ok === "sign"){
    const a = act();
    return {body:"Eleven pens and a photographer, if you want them.", opts:[
      {t:"Sign it", run(){ if(a) a.signed = true; app(2); return "Law, with your name under it."; }},
      {t:"Veto it", run(){ if(a) a.vetoed = true; sta(-3); inf(3); feed(execTitle() + " " + surname(y.name) + " vetoed the " + e.act + ".", "bad"); return "Back to the House. They need two thirds."; }}]};
  }
  if(e.ok === "unrest") return {body:"A thousand people in the square and three cameras. " + e.what + ".", opts:[
    {t:"Sit down with both sides", run(){ un(-10); app(2); spend(90, 18); return "Four hours in a union hall. A truce, not a peace."; }},
    {t:"Send the state militia", run(){ un(-15); app(-3); (G.members || []).filter(m => m.pos && m.pos.lib > 30).forEach(m => ripple(m, -6, "Soldiers on a picket line. I will not forget whose order that was.", -6, true)); return "Boots on the cobbles by dark. Quiet, for now."; }},
    {t:"Send a deputy", run(){ un(-4); app(-1); return "A deputy reads your statement. The crowd boos the deputy."; }}]};
  if(e.ok === "sponsors") return {body:"Three members of the statehouse, one folder, a lot of hope.", opts:[
    {t:"Tell them you will sign", run(){ if(S && S.bill){ S.bill.met = "sign"; S.bill.pushed = (S.bill.pushed || 0) + 6; } sta(1); return "They leave lighter than they came."; }},
    {t:"Say you will read it", run(){ if(S && S.bill) S.bill.met = "read"; return "Noncommittal. They expected that."; }},
    {t:"Warn them of a veto", run(){ if(S && S.bill){ S.bill.met = "veto"; S.bill.pushed = (S.bill.pushed || 0) - 6; } sta(-1); app(1); return "They will try to amend it. Or they will try to override you."; }}]};
  if(e.ok === "suit"){
    const c = (G.cases || []).find(x => x.t === e.cs) || {t:e.cs};
    let brief = e.cs;
    try{ brief = suitExplain(c); }catch(x){}
    return {body: brief + " Counsel can take one of three roads.", opts:[
    {t:"Fight it all the way up", run(){ app(2); y.funds = Math.max(0, (y.funds || 0) - 8); return "You defend it in the high bench. The question in the brief is the one the justices will answer. Eight thousand from the chest for the printing alone."; }},
    {t:"Settle quietly", run(){ sta(1); app(-1); const cs = (G.cases || []).find(x => x.t === e.cs); if(cs){ cs.done = true; cs.settled = true; } return "You give the point up before a judge writes it down. The other side gets what they sued for, and neither of you calls it a win."; }},
    {t:"Take it to the press", run(){ app(3); sta(-2); return "You read the claim on the steps. The judges read the papers too, and a case argued in public is harder to settle afterwards."; }}]};
  }
  if(e.ok === "argument") return {body:"Counsel for both sides, and nine of you on the bench.", opts:[
    {t:"Question both sides hard", run(){ sta(2); return "Two questions nobody had prepared for."; }},
    {t:"Listen and say nothing", run(){ sta(1); return "You write three pages of notes and keep them."; }}]};
  if(e.ok === "weather") return {body:"Mud to the axles. The county engineer has a list.", opts:[
    {t:"Walk it with the cameras", run(){ app(3); spend(90, 16); return "Boots in the water. It runs on every front page."; }},
    {t:"Declare an emergency", run(){ un(-5); ind(-2); app(2); y.funds = Math.max(0, (y.funds || 0) - 5); return "Emergency money released by noon."; }},
    {t:"Leave it to the counties", run(){ app(-2); return "They manage. They remember who did not come."; }}]};
  if(e.ok === "realm") return {body:"Tea, a translator, and a letter on heavy paper.", opts:[
    {t:"Receive them: an audience, and negotiate", run(){ G._dlgRealm = e.realm; try{ sitStart("delegation"); }catch(x){} return "You sit down with the delegation."; }},
    {t:"Sign a letter of intent (no audience)", run(){ G.realmRel = G.realmRel || {}; G.realmRel[e.realm] = clamp((G.realmRel[e.realm] || 0) + 6, -100, 100); ind(2); return "A cannery, maybe a shipyard. Photographs on the steps."; }},
    {t:"Dinner and nothing signed", run(){ G.realmRel = G.realmRel || {}; G.realmRel[e.realm] = clamp((G.realmRel[e.realm] || 0) + 2, -100, 100); return "A long dinner. Nobody committed to anything."; }}]};
  if(e.ok === "delegation") return {body:"The members from " + y.state + ", standing by the bronze. They know why you came.", opts:[
    {t:"Ask them to vote aye", run(){ home().forEach(m => { m.sway = (m.sway || 0) + 5; ripple(m, 2, (role === "gov" ? "Our own governor" : "Our own senator") + " came to the corridor to ask.", 2); }); inf(-2); return "Two of them nod. One looks at the floor."; }},
    {t:"Ask them to vote no", run(){ home().forEach(m => { m.sway = (m.sway || 0) - 5; ripple(m, 2, (role === "gov" ? "Our own governor" : "Our own senator") + " came to the corridor to ask.", 2); }); inf(-2); return "They will think about it. That is not nothing."; }},
    {t:"Just listen", run(){ home().forEach(m => ripple(m, 4, (role === "gov" ? "The governor" : "The senator") + " came to listen, not to whip.", 4)); return "They talk; you take notes."; }}]};
  if(e.ok === "rival") return {body:"Across the plaza, their crowd. Yours is smaller and closer.", opts:[
    {t:"Speak to the crowd", run(){ const rv = rivalLive(); if(rv) rv.heat = clamp((rv.heat || 0) - 8, 0, 100); app(2); spend(45, 10); return "Your line carries further than theirs."; }},
    {t:"Stay out of it", run(){ return "You let them have the plaza."; }}]};
  return {body:"", opts:[{t:"Done", run(){ return ""; }}]};
}
function schedMiss(e, told){
  const y = G.you, S = (G.states || []).find(s => s.n === (e.st || y.state));
  y.standing = clamp(y.standing - (told ? 1 : 3), 0, 100);
  if(!told) y.approval = clamp(y.approval - 2, 0, 100);
  if(e.ok === "unrest" && S) S.unrest = clamp((S.unrest || 0) + 4, 0, 100);
  if(e.ok === "senact"){ const a = (G.lastActs || []).find(x => x.title === e.act); if(a && !a.senate) a.senate = "absent"; }
  return (told ? "You sent word. " : "You were not there and sent no word. ") +
    (e.ok === "unrest" ? "The crowd got bigger." : e.ok === "senact" ? "The Senate voted without you." : e.ok === "weather" ? "Somebody else stood in the water for the cameras." : "It went ahead without you.");
}
function schedCard(e){
  e.done = true;
  const here = G.room === e.room;
  G.running = false;
  let body, opts;
  if(!here){
    body = schedMiss(e, e.rsvp === false);
    opts = [{t:"Read about it later", run(){ return ""; }}];
    try{ markDay("ignored", e.t, null); }catch(x){}
  } else {
    const o = schedOpts(e);
    body = o.body; opts = o.opts;
  }
  card.innerHTML = '<div class="eyebrow">' + dateString() + " · " + hourLabel(e.hour) + " · " + sitEsc((ROOMS[e.room] && ROOMS[e.room].t) || e.room) + ' · scheduled by ' + sitEsc(e.by || schedBy()) + '</div>' +
    '<h1>' + sitEsc(e.t) + '</h1><p class="dream">' + sitEsc(e.d || "") + '</p><p>' + sitEsc(body) + '</p>' +
    '<div class="card__actions">' + opts.map((o, i) => '<button class="btn' + (i ? ' btn--ghost' : '') + '" type="button" data-sc="' + i + '"' + (o.off ? ' disabled' : '') + '>' + sitEsc(o.t) + '</button>').join("") + '</div>';
  veil.hidden = false;
  card.querySelectorAll("[data-sc]").forEach(bt => bt.addEventListener("click", () => {
    const o = opts[+bt.getAttribute("data-sc")]; if(!o || o.off) return;
    walkNow();
    if(here) spend(rint(30, 60), 8);
    const r = o.run();
    if(here){
      note(e.t + ": " + o.t + "." + (r ? " " + r : ""), true);
      try{ journal(e.t + " — " + o.t + "."); }catch(x){}
      try{ markDay("attended", e.t, null); }catch(x){}
    } else feed("You read about " + e.t.replace(/^A /, "a ") + " on the wire.");
    try{ refreshPanels(); queueSave(); }catch(x){}
  }));
}
/* the diary, in your office or in counsel's hands */
function schedListHTML(){
  const L = (G.events || []).filter(e => e && e.day === G.day && !e.done && (!abroadOffice() || outsideAllowed(e.room))).sort((a, b) => a.hour - b.hour);
  if(!L.length) return '<p class="muted">' + sitEsc(schedBy()) + ' has nothing on the diary yet. Things will come up.</p>';
  return L.map(e => '<div class="whip__row"><span class="whip__n">' + hourLabel(e.hour) + ' · ' + sitEsc(e.t) + '</span><span class="whip__w">' +
    sitEsc((ROOMS[e.room] && ROOMS[e.room].t) || e.room) + ' · ' + (e.rsvp === true ? "accepted" : e.rsvp === false ? "declined" : "waiting on you") + '</span>' +
    '<span class="whip__b"><button type="button" class="btn btn--ghost whip__go" data-rs="' + G.events.indexOf(e) + ':1"' + (e.rsvp === true ? " disabled" : "") + '>Accept</button>' +
    '<button type="button" class="btn btn--ghost whip__go" data-rs="' + G.events.indexOf(e) + ':0"' + (e.rsvp === false ? " disabled" : "") + '>Decline</button></span></div>').join("");
}
function schedWire(root, redraw){
  root.querySelectorAll("[data-rs]").forEach(bt => bt.addEventListener("click", () => {
    const [i, yes] = bt.getAttribute("data-rs").split(":");
    const e = G.events[+i]; if(!e) return;
    e.rsvp = yes === "1";
    feed((e.rsvp ? "Accepted: " : "Declined: ") + e.t + ".");
    try{ queueSave(); }catch(x){}
    redraw();
  }));
}
function scheduleCard(){
  G.running = false;
  card.innerHTML = '<div class="eyebrow">' + sitEsc(schedBy()) + ' · the diary</div><h1>Today, as it stands.</h1>' +
    '<p class="dream">Accepted items walk you there at the hour, wherever it is. Declined ones go ahead without you.</p>' + schedListHTML() +
    '<div class="card__actions"><button type="button" class="btn" id="scClose">Close</button></div>';
  veil.hidden = false;
  schedWire(card, scheduleCard);
  el("scClose").addEventListener("click", () => walkNow());
}

/* ── the furniture ───────────────────────────────────────── */
function kFlag(x, z, h){
  const brass = matCol(0xb08b45, .35, .8);
  addCyl(brass, x, h * 0.5, z, 0.026, h);
  addCyl(brass, x, 0.03, z, 0.16, 0.06);
  addSphere(brass, x, h + 0.04, z, 0.05, 0.05, 0.05);
  let fm = null; try{ fm = flagMat(); }catch(e){}
  addBox(fm || matCol(0x2a3d6b, .8), x + 0.45, h - 0.55, z, 0.86, 0.62, 0.025, 0, true);
}
function buildHigherRoom(id, o){
  const R = ROOMS[id]; if(!R) return;
  const w = R.w, d = R.d, h = R.h, hw = w/2;
  const wood = o.woodMat || matTex(TEX.panel, 1, 1, .6);
  const leather = o.leather || matCol(0x5a2a22, .7);
  const brass = matCol(0x9a7736, .4, .8);
  const paper = matCol(0xeee8da, .95);
  if(id === "senate"){
    /* rostrum at the back, a horseshoe of desks facing it, aisle down the middle to the door */
    const cz = d - 2.0;
    addBox(wood, 0, 0.18, cz + 0.4, 6.2, 0.36, 2.6, 0, true);           /* first tier */
    addBox(wood, 0, 0.42, cz + 0.9, 3.6, 0.12, 1.4, 0, true);           /* second tier */
    propDesk(wood, wood, 0, cz - 0.35, 4.2, 0.75, 0, 1.12);             /* clerks' desk, tall front */
    propDesk(wood, wood, 0, cz + 0.85, 2.0, 0.7, 0, 0.82);
    propChair(wood, leather, 0, cz + 1.45, Math.PI, 0.48);              /* presiding officer */
    propChair(wood, leather, -1.3, cz + 0.25, Math.PI, 0.36);
    propChair(wood, leather,  1.3, cz + 0.25, Math.PI, 0.36);
    addCyl(brass, 0.7, 0.48 + 0.82 + 0.06, cz + 0.85, 0.05, 0.10);      /* gavel block */
    const rows = [[4.0, 4], [5.4, 6], [6.8, 6]];
    rows.forEach(([r, n]) => {
      const span = 1.05;                               /* radians, each side */
      for(let i = 0; i < n; i++){
        const side = i < n/2 ? -1 : 1;
        const k = i < n/2 ? i : i - n/2;
        const th = side * (0.24 + (span - 0.24) * (k / Math.max(1, n/2 - 1)));
        const x = r * Math.sin(th), z = cz - r * Math.cos(th);
        if(Math.abs(x) > hw - 0.8 || z < 1.6) continue;
        const cx2 = (r + 0.62) * Math.sin(th), cz2 = cz - (r + 0.62) * Math.cos(th);
        if((DOORS[id] || []).some(dr => { if(dr.side === "front") return false; const dp = doorAt(id, dr); return Math.hypot(dp.x - cx2, dp.z - cz2) < 1.6 || Math.hypot(dp.x - x, dp.z - z) < 1.4; })) continue;
        propDesk(wood, wood, x, z, 0.92, 0.52, -th, 0.78);
        if(cz2 > 1.0) propChair(wood, leather, cx2, cz2, -th);
        propPapers(x, 0.80, z, 1);
      }
    });
    addBox(brass, -2.2, 0.98, 1.7, 3.0, 0.06, 0.08, 0, true);           /* gallery rail, aisle open */
    addBox(brass,  2.2, 0.98, 1.7, 3.0, 0.06, 0.08, 0, true);
    for(let i = 0; i < 4; i++){ const x = (i < 2 ? -1 : 1) * (0.9 + (i % 2) * 2.6); addCyl(brass, x, 0.49, 1.7, 0.03, 0.98); }
    [3.0, 10.4].forEach(z => propColumn(-hw + 0.55, z, h, 0.26));
    [3.0, 6.6, 10.4].forEach(z => propColumn(hw - 0.55, z, h, 0.26));
    kFlag(-2.4, d - 0.6, 2.7); kFlag(2.0, d - 0.6, 2.7);
    try{ propPlaque(0, 3.3, d - 0.02, Math.PI, "The Senate", "Advice and consent", 1.4, 0.32); }catch(e){}
    try{ propClock(0, 3.4, 0.09, 0); }catch(e){}
    propSconceDecor(-hw + 0.12, 3.0, 5.0, Math.PI/2);
    propSconceDecor(hw - 0.12, 3.0, 5.0, -Math.PI/2);
    propSconceDecor(-hw + 0.12, 3.0, 8.4, Math.PI/2);
    propSconceDecor(hw - 0.12, 3.0, 8.4, -Math.PI/2);
    propRug(0, 3.8, 1.6, 4.0);
    propPlant(-hw + 0.7, 1.0, 1.0); propPlant(hw - 0.7, 1.0, 1.0);
  } else if(id === "court"){
    const bz = d - 2.1;
    addBox(wood, 0, 0.15, bz + 0.6, 8.6, 0.30, 2.6, 0, true);          /* dais */
    addBox(wood, 0, 0.62, bz - 0.35, 8.2, 1.24, 0.30, 0, true);         /* bench front */
    addBox(wood, 0, 1.27, bz - 0.12, 8.4, 0.06, 0.78, 0, true);         /* bench top */
    for(let i = 0; i < 5; i++){
      const x = -3.2 + i * 1.6;
      propChair(wood, matCol(0x1d1f26, .7), x, bz + 0.85, Math.PI, 0.30);
      addBox(wood, x, 1.85, bz + 1.12, 0.62, 1.15, 0.10, 0, true);      /* tall chair backs */
      propPapers(x, 1.31, bz - 0.1, 1);
    }
    /* the bar, counsel tables, lectern */
    addBox(wood, -2.7, 0.48, 4.3, 4.2, 0.96, 0.10, 0, true);
    addBox(wood,  2.7, 0.48, 4.3, 4.2, 0.96, 0.10, 0, true);
    propDesk(wood, wood, -2.4, 5.6, 2.2, 0.8);
    propDesk(wood, wood,  2.4, 5.6, 2.2, 0.8);
    [-3.0, -1.8].forEach(x => propChair(wood, leather, x, 4.95, 0));
    [1.8, 3.0].forEach(x => propChair(wood, leather, x, 4.95, 0));
    propPapers(-2.4, 0.78, 5.6, 3); propPapers(2.4, 0.78, 5.6, 2);
    addBox(wood, 0, 0.55, 6.9, 0.62, 1.10, 0.48, 0, true);              /* lectern */
    addBox(wood, 0, 1.14, 6.85, 0.70, 0.06, 0.56, 0.0, true);
    /* public seats */
    for(let r = 0; r < 2; r++) for(let s = -1; s <= 1; s += 2)
      for(let c = 0; c < 3; c++) propChair(matCol(0x3e3428, .8), matCol(0x5b4c3e, .85), s * (1.4 + c * 0.95), 1.9 + r * 1.0, 0);
    [2.6, 6.0, 9.4].forEach(z => { propColumn(-hw + 0.6, z, h, 0.28); propColumn(hw - 0.6, z, h, 0.28); });
    kFlag(-4.6, d - 0.6, 2.6); kFlag(4.2, d - 0.6, 2.6);
    try{ propPlaque(0, 3.35, d - 0.02, Math.PI, "Equal Justice Under Law", "The Court", 1.6, 0.30); }catch(e){}
    try{ propClock(0, 3.6, 0.09, 0); }catch(e){}
    propSconceDecor(-hw + 0.12, 2.8, 4.3, Math.PI/2);
    propSconceDecor(hw - 0.12, 2.8, 4.3, -Math.PI/2);
    propRug(0, 3.0, 1.4, 3.2);
  } else if(id === "exec"){
    const dz = d - 2.6;
    propRug(0, dz - 0.4, 4.6, 3.6);
    propDesk(wood, wood, 0, dz, 2.3, 1.05, 0, 0.80);
    propChair(wood, leather, 0, dz + 0.85, Math.PI);
    propChair(wood, leather, -0.7, dz - 1.05, 0);
    propChair(wood, leather,  0.7, dz - 1.05, 0);
    propPapers(-0.4, 0.82, dz, 3);
    try{ propLamp(0.85, 0.80 + 0.32, dz + 0.2, 0xffd9a0, 0.7); }catch(e){}
    kFlag(-1.9, d - 0.55, 2.4); kFlag(1.5, d - 0.55, 2.4);
    /* the cabinet table nearer the door */
    propDesk(wood, wood, 0, 4.4, 3.6, 1.2, 0, 0.76);
    for(let i = 0; i < 3; i++){
      propChair(wood, leather, -1.2 + i * 1.2, 3.45, 0);
      propChair(wood, leather, -1.2 + i * 1.2, 5.35, Math.PI);
    }
    propPapers(-0.6, 0.78, 4.4, 2); propPapers(0.8, 0.78, 4.4, 2);
    propShelf(-hw + 0.35, 4.0, Math.PI/2, 2.0, 2.1);
    propShelf(-hw + 0.35, 8.2, Math.PI/2, 2.0, 2.1);
    propShelf(hw - 0.35, 6.2, -Math.PI/2, 2.0, 2.1);
    try{ propPlaque(0, 2.5, d - 0.02, Math.PI, "The Executive", "Under God, for the Union", 1.2, 0.28); }catch(e){}
    try{ propClock(0, 2.9, 0.09, 0); }catch(e){}
    propSconce(-hw + 0.12, 2.2, 8.2, Math.PI/2);
    propSconce(hw - 0.12, 2.2, 8.2, -Math.PI/2);
    propPlant(hw - 0.7, 1.0, 1.0); propPlant(-hw + 0.7, 1.0, 0.95); propPlant(hw - 0.7, d - 0.8, 1.1);
    try{ propCoatStand(-hw + 0.7, d - 0.8); }catch(e){}
  } else if(id === "govoffice"){
    const dz = d - 2.4;
    propRug(0, dz - 0.6, 3.6, 3.0);
    propDesk(wood, wood, 0, dz, 2.0, 0.95, 0, 0.78);
    propChair(wood, leather, 0, dz + 0.8, Math.PI);
    propChair(wood, leather, -0.7, dz - 1.0, 0);
    propChair(wood, leather,  0.7, dz - 1.0, 0);
    propPapers(0.3, 0.80, dz, 3);
    addBox(matCol(0xc9d6c0, .9), -0.3, 0.805, dz + 0.05, 0.9, 0.006, 0.6, 0, true);   /* state map under glass */
    try{ propLamp(-0.75, 0.78 + 0.32, dz + 0.2, 0xffd9a0, 0.65); }catch(e){}
    kFlag(-1.7, d - 0.55, 2.3); kFlag(1.3, d - 0.55, 2.3);
    /* the secretary at the door, a waiting bench */
    propDesk(wood, wood, 2.9, 3.0, 1.4, 0.7, -Math.PI/2);
    propChair(wood, leather, 3.6, 3.0, -Math.PI/2);
    propPapers(2.9, 0.78, 3.0, 2);
    for(let i = 0; i < 3; i++) propChair(matCol(0x4a4038, .75), matCol(0x6b5b4a, .85), -hw + 0.7, 2.4 + i * 0.85, Math.PI/2);
    propShelf(-hw + 0.35, 7.0, Math.PI/2, 1.8, 2.0);
    propShelf(hw - 0.35, 7.2, -Math.PI/2, 1.8, 2.0);
    const st = (G.you && G.you.state) || "The State";
    try{ propPlaque(0, 2.45, d - 0.02, Math.PI, "Office of the Governor", st, 1.2, 0.28); }catch(e){}
    try{ propClock(0, 2.8, 0.09, 0); }catch(e){}
    propSconce(-hw + 0.12, 2.1, 9.0, Math.PI/2);
    propSconce(hw - 0.12, 2.1, 9.0, -Math.PI/2);
    propPlant(hw - 0.7, d - 0.8, 1.0); propPlant(-hw + 0.7, d - 0.8, 1.0);
    try{ propCoatStand(hw - 0.7, 1.2); }catch(e){}
  } else if(id === "district"){
    /* the State House front around its door on the front walk */
    const dr = (DOORS.district || []).find(x => x.to === "govoffice"); if(!dr) return;
    const p = doorAt("district", dr), sx = p.x;
    const stone = matTex(TEX.stone, 2, 2, .92);
    addBox(stone, sx, 2.1, -1.55, 5.6, 4.2, 3.0, 0, true);                   /* the building itself */
    addBox(matCol(0xd8d2c4, .85), sx, 4.3, -1.45, 6.0, 0.22, 3.3, 0, true);  /* cornice */
    addBox(stone, sx, 0.08, 0.55, 3.2, 0.16, 1.0, 0, true);                 /* stoop */
    [-1.15, 1.15].forEach(o2 => propColumn(sx + o2, 0.62, 3.1, 0.16));
    addBox(stone, sx, 3.22, 0.55, 3.2, 0.24, 1.05, 0, true);                /* entablature */
    addBox(stone, sx, 3.48, 0.45, 2.4, 0.28, 0.85, 0, true);                /* pediment block */
    try{ propPlaque(sx, 3.22, 1.085, 0, "State House", (G.you && G.you.state) || "The State", 1.3, 0.22); }catch(e){}
  }
  try{ if(["senate", "court", "exec", "govoffice"].indexOf(id) >= 0){ buildHigherExtras(id, wood, leather, brass, paper); kRich(id, wood, leather, brass); } }catch(e){ if(window.console) console.warn("higher extras", id, e); }
}

/* ══════════════════════════════════════════════════════════
   20261011l · A WORLD THAT KEEPS GOING
   Seasons and weather, the households at home and the constituents
   who come to your door, the morning Ledger built from what really
   happened yesterday, and rivals whose feuds run for weeks.
   ══════════════════════════════════════════════════════════ */
function lHash(n){
  let x = (Math.imul((n | 0) + 0x9e37, 2654435761) ^ ((G.seedL || 7) * 40503)) >>> 0;
  x ^= x >>> 13; x = Math.imul(x, 1274126177) >>> 0; x ^= x >>> 16;
  return ((x >>> 0) % 100000) / 100000;
}
function lSeason(month){ return (month === 12 || month <= 2) ? "winter" : month <= 5 ? "spring" : month <= 8 ? "summer" : "autumn"; }
const L_WX = {
  winter:[["snow",.30],["frost",.25],["overcast",.20],["clear",.15],["fog",.10]],
  spring:[["rain",.30],["clear",.35],["overcast",.15],["wind",.10],["fog",.10]],
  summer:[["clear",.45],["heat",.22],["storm",.15],["overcast",.18]],
  autumn:[["clear",.30],["rain",.25],["wind",.20],["fog",.15],["overcast",.10]]
};
const L_WX_T = {snow:"Snow", frost:"Hard frost", overcast:"Overcast", clear:"Clear", fog:"Fog", rain:"Rain", wind:"High wind", heat:"Heat", storm:"Thunderstorms"};
function wxToday(){
  G.wx = G.wx || {};
  if(G.wx.day === G.day && G.wx.k) return G.wx;
  if(!G.seedL) G.seedL = rint(1, 9999);
  const c = civilDate(dayOfYear()), s = lSeason(c.month), table = L_WX[s];
  let k = "clear";
  const prev = G.wx;
  if(prev.k && prev.day === G.day - 1 && table.some(x => x[0] === prev.k) && lHash(G.day * 13 + 1) < 0.4) k = prev.k;
  else { let r = lHash(G.day * 7 + 3); for(const [kk, pr] of table){ if(r < pr){ k = kk; break; } r -= pr; } }
  const base = {winter:29, spring:55, summer:80, autumn:57}[s];
  const t = Math.round(base + (lHash(G.day * 5 + 11) - 0.5) * 16 + (k === "heat" ? 12 : k === "frost" ? -9 : k === "snow" ? -4 : k === "storm" ? -3 : 0));
  let cover = prev.cover || 0;
  if(k === "snow") cover = Math.min(3, cover + 1);
  else if(s === "winter" && t < 34 && k !== "rain") cover = Math.max(0, cover - 0.34);
  else cover = 0;
  G.wx = {day:G.day, k, s, t, cover:+cover.toFixed(2)};
  return G.wx;
}
function wxLine(w){
  w = w || wxToday();
  const L = {
    snow: w.cover >= 2 ? "Snow on snow. The plows are behind and Main Street is one lane." : "Snow coming down soft. The steps are salted, mostly.",
    frost:"A hard frost. Breath shows in the corridor by the steps door.",
    overcast:"A low grey lid on the town. Nobody is in a hurry.",
    clear: w.s === "spring" ? "Clear and mild. The cherry trees by the steps are out." : w.s === "autumn" ? "Clear and cold at the edges. The leaves are turning on Main Street." : "Clear skies.",
    fog:"Fog to the second floor. The dome is gone until noon.",
    rain:"Steady rain. Umbrellas in every doorway.",
    wind:"A hard wind off the river. Flags straight out.",
    heat:"Heat. The cloakroom fans are losing.",
    storm:"Thunderstorms by afternoon. The galleries will be thin."
  };
  return L_WX_T[w.k] + ", " + w.t + "°F. " + (L[w.k] || "");
}
function wxGloom(){ const k = (G.wx && G.wx.day === G.day) ? G.wx.k : null; return k === "storm" ? 0.55 : k === "rain" || k === "snow" ? 0.72 : k === "fog" || k === "overcast" ? 0.8 : 1; }
/* outdoor light and fog follow the day's weather */
const L_LAND = {winter:0x6b6a55, "winter-snow":0xe2e6ea, autumn:0x8a6a2e, spring:0x4f7a34};
function lSeasonLand(day){
  const w = wxToday(); if(!w) return;
  const key = w.s === "winter" ? (w.cover > 0 ? "winter-snow" : "winter") : w.s;
  const col = L_LAND[key];
  if(landGroup) landGroup.children.forEach(m => {
    if(!m.material || !m.material.color) return;
    if(m.userData.lHill === undefined){ m.userData.lHill = m.material.color.getHex() === 0x3f5e2c; }
    if(m.userData.lHill) m.material.color.setHex(col || 0x3f5e2c);
  });
  if(col && horizonMesh && horizonMesh.material && horizonMesh.material.color){
    horizonMesh.material.color.setHex(col).multiplyScalar(lerp(0.35, 1, day));
  }
}
function lWxLight(day){
  try{ nmLight(day); }catch(e){}
  const w = wxToday(); if(!w) return;
  try{ lSeasonLand(day); }catch(e){}
  const g = wxGloom();
  if(g >= 1 && w.k !== "heat") return;
  if(w.k === "heat"){ renderer.toneMappingExposure *= 1.06; return; }
  FOGC.setHSL(0.58, 0.10, lerp(0.24, 0.66, day) * (0.75 + g * 0.25));
  if(scene.fog){
    scene.fog.color.copy(FOGC);
    if(w.k === "fog"){ scene.fog.near = 4; scene.fog.far = 34; }
    else if(w.k === "snow"){ scene.fog.near = 12; scene.fog.far = 62; }
    else if(w.k === "storm" || w.k === "rain"){ scene.fog.near = 16; scene.fog.far = 80; }
  }
  renderer.setClearColor(FOGC);
  try{ if(scene.background && scene.background.setHSL) scene.background.setHSL(0.58, 0.10, lerp(0.10, 0.56, day) * g); }catch(e){}
  try{ if(skyMesh && skyMesh.material && skyMesh.material.color) skyMesh.material.color.setHSL(0.58, 0.10, lerp(0.18, 0.62, day) * g); }catch(e){}
  sun.intensity *= g;
}
/* precipitation: one static geometry, moved as a whole, so it costs a transform a frame */
let wxObj = null, wxKey = "", wxT = 0, wxH = 9;
function wxClear(){
  if(!wxObj) return;
  try{ scene.remove(wxObj); }catch(e){}
  try{ wxObj.children.forEach(o => { o.geometry && o.geometry.dispose(); }); }catch(e){}
  wxObj = null;
}
function wxBuild(R){
  wxClear();
  const w = wxToday();
  if(!R || !R.open || (MODEST && !sceneryRich()) || G.gfx === "simple") return;
  const rainy = w.k === "rain" || w.k === "storm", snowy = w.k === "snow";
  if(!rainy && !snowy) return;
  const n = ((G.gfx === "balanced" || (typeof crowdSafe !== "undefined" && crowdSafe)) ? (snowy ? 260 : 220) : (snowy ? 520 : (w.k === "storm" ? 900 : 650))) * 2;
  const hw = 14, d = 28, zc = -14;                          /* a curtain of weather that travels with you */
  const grp = new THREE.Group();
  let geo, mat;
  if(rainy){
    const p = new Float32Array(n * 6);
    for(let i = 0; i < n; i++){
      const x = (Math.random() * 2 - 1) * hw, y = Math.random() * wxH, z = Math.random() * d + zc;
      p.set([x, y, z, x + 0.07, y + 0.26, z + 0.025], i * 6);
    }
    geo = new THREE.BufferGeometry(); geo.setAttribute("position", new THREE.BufferAttribute(p, 3));
    mat = new THREE.LineBasicMaterial({color:0xdfe6ee, transparent:true, opacity:0.3, depthWrite:false});
    for(let k = 0; k < 2; k++){ const o = new THREE.LineSegments(geo, mat); o.position.y = k * wxH; o.frustumCulled = false; grp.add(o); }
    /* 20261012a: a darker second sheet so rain reads against a pale sky too */
    const mat2 = new THREE.LineBasicMaterial({color:0x56616d, transparent:true, opacity:0.26, depthWrite:false});
    for(let k = 0; k < 2; k++){ const o = new THREE.LineSegments(geo, mat2); o.position.set(0.37, k * wxH + 0.9, 0.53); o.frustumCulled = false; grp.add(o); }
  } else {
    const p = new Float32Array(n * 3);
    for(let i = 0; i < n; i++) p.set([(Math.random() * 2 - 1) * hw, Math.random() * wxH, Math.random() * d + zc], i * 3);
    geo = new THREE.BufferGeometry(); geo.setAttribute("position", new THREE.BufferAttribute(p, 3));
    mat = new THREE.PointsMaterial({color:0xffffff, size:0.07, transparent:true, opacity:0.85, depthWrite:false});
    for(let k = 0; k < 2; k++){ const o = new THREE.Points(geo, mat); o.position.y = k * wxH; o.frustumCulled = false; grp.add(o); }
  }
  grp.userData.snow = snowy; grp.userData.speed = snowy ? 0.85 : (w.k === "storm" ? 12 : 9);
  scene.add(grp); wxObj = grp;
}
function wxFrame(dt){
  if(!wxObj) return;
  wxT += Math.min(0.05, dt || 0.016);
  const sp = wxObj.userData.speed;
  wxObj.position.y = -((wxT * sp) % wxH);
  wxObj.position.x = cam.x + (wxObj.userData.snow ? Math.sin(wxT * 0.6) * 0.35 : 0); wxObj.position.z = cam.z;
}
/* the town changes with the season: canopies, and snow on the walks */
const L_CANOPY = 0x3a6a32;
const L_SEASON_MAT = {};
function lSeasonMat(key){
  if(L_SEASON_MAT[key]) return L_SEASON_MAT[key];
  const col = key === "autumn" ? 0xb4652a : key === "winter-snow" ? 0xe4e8ec : key === "winter" ? 0x5e5446 : key === "spring" ? 0x6aa84a : L_CANOPY;
  L_SEASON_MAT[key] = matCol(col, .95);
  return L_SEASON_MAT[key];
}
function lDressSeason(id){
  const R = ROOMS[id]; if(!R || !R.open || !roomGroup) return;
  const w = wxToday();
  const key = w.s === "winter" ? (w.cover > 0 ? "winter-snow" : "winter") : w.s;
  roomGroup.traverse(o => {
    if(!o.isMesh || !o.material) return;
    const ud = o.userData;
    if(ud.lCanopy === undefined){
      ud.lCanopy = !!(o.material.color && o.material.color.getHex && o.material.color.getHex() === L_CANOPY);
      if(ud.lCanopy) ud.lMat0 = o.material;
    }
    if(!ud.lCanopy) return;
    o.material = key === "summer" ? ud.lMat0 : lSeasonMat(key);
  });
  /* snow lying on the walks */
  for(let i = roomGroup.children.length - 1; i >= 0; i--){
    const c = roomGroup.children[i];
    if(c.userData && c.userData.lSnow){ roomGroup.remove(c); }
  }
  if(w.cover > 0 && id === "district"){
    const snow = matCol(0xf2f4f6, .96);
    const add = (x, y, z, sx, sz) => { const m = addBox(snow, x, y, z, sx, 0.012 + w.cover * 0.01, sz, 0, true); m.userData.lSnow = true; m.castShadow = false; };
    add(-5.0, 0.105, R.d / 2, 5.0, R.d - 0.6);
    add( 5.0, 0.105, R.d / 2, 5.0, R.d - 0.6);
    if(w.cover >= 2){ add(-1.7, 0.045, R.d / 2, 0.8, R.d - 0.6); add(1.7, 0.045, R.d / 2, 0.8, R.d - 0.6); }
  }
}

/* ── households at home ─────────────────────────────────── */
const L_STREETS = ["Elm Street","Mill Road","Church Lane","Water Street","Orchard Row","Depot Street","River Road"];
const L_NEEDS = ["the bridge on Mill Road","a pension letter that never came","the school bus route","the flooding behind the church",
  "the plant's last shift","a son's visa hearing","the clinic's hours","a farm loan","the rail crossing gates","a veteran's claim",
  "the post office closing","the water bills","a daughter's student loan","the grain elevator's scales"];
const L_KID = ["started at the high school and wants to be a nurse","made the county band","is home from the army for Christmas",
  "got into the state college","broke an arm on the ice and is proud of it","is learning the trade at the mill","sings in the choir now"];
function townEnsure(){
  G.town = G.town || {};
  const T = G.town;
  if(!T.hh || !T.hh.length){
    const st = G.you && G.you.state;
    T.hh = [];
    for(let i = 0; i < 7; i++){
      const head = newName(st), fam = surname(head);
      const spouse = newName(st).split(" ")[0] + " " + fam;
      T.hh.push({id:i + 1, fam, street:L_STREETS[i], people:[head, spouse], kid:newName(st).split(" ")[0], kidNews:pick(L_KID),
        need:pick(L_NEEDS), mood:50 + rint(-10, 10), mem:[], helped:0, visits:0, wait:0});
    }
    T.letters = []; T.spawnDay = 0;
  }
  return T;
}
function hhById(id){ const T = townEnsure(); return T.hh.find(h => h.id === id) || null; }
function hhRemember(h, text){ h.mem.push({d:G.day, t:text}); if(h.mem.length > onumLim(8,"hist")) h.mem.shift(); }
function townMood(){ const T = townEnsure(); return T.hh.reduce((a, h) => a + h.mood, 0) / T.hh.length; }
function lSpawnTown(){
  const T = townEnsure();
  if(!G.civ) G.civ = [];
  G.civ = G.civ.filter(c => !(c && c.hhTemp && c.hhDay !== G.day));
  _allCache = null;
  if(T.spawnDay === G.day) return;
  T.spawnDay = G.day;
  const w = wxToday(), t = dayType();
  const make = (h, room, role, who) => {
    try{
      const c = makeCivilian();
      c.name = who; c.hh = h.id; c.hhTemp = true; c.hhDay = G.day; c.role = role; c.cause = h.need;
      c.caseOpen = false; c.room = room; c.state = G.you.state;
      try{ placeInRoom(c); }catch(e){}
      G.civ.push(c); _allCache = null;
      return c;
    }catch(e){ return null; }
  };
  /* a constituent at the office door on working days */
  if((t === "session" || t === "district") && inHouse() && !(w.k === "storm" || w.cover >= 2.5) && lHash(G.day * 3 + 17) < 0.7){
    const h = T.hh.slice().sort((a, b) => (a.mood - a.wait * 4) - (b.mood - b.wait * 4))[0];
    const c = make(h, "office", "Constituent · " + h.street, h.people[h.visits % 2]);
    if(c){ c.visitor = true; h.visits++; h.wait = 0; }
  }
  /* neighbours on Main Street */
  const out = w.k === "storm" ? 0 : (w.k === "snow" || w.k === "rain" || w.k === "frost") ? 1 : w.k === "clear" ? 3 : 2;
  const order = T.hh.slice().sort(() => Math.random() - 0.5);
  for(let i = 0; i < out && i < order.length; i++){
    const h = order[i];
    make(h, "district", "Neighbour · " + h.street, h.people[(G.day + i) % 2]);
  }
}
function hhLine(m){
  const h = hhById(m.hh); if(!h) return null;
  const w = wxToday();
  const last = h.mem[h.mem.length - 1];
  const P = [];
  if(last && last.t) P.push("Last time: " + last.t + " I have not forgotten it.");
  if(h.helped) P.push("The " + h.need.replace(/^the /, "") + " business is next. You fixed the last thing, so I came back.");
  P.push("It is about " + h.need + ". I have written twice.");
  P.push("My " + (chance(.5) ? "boy" : "girl") + ", " + h.kid + ", " + h.kidNews + ".");
  if(w.k === "snow") P.push("Snow up to the porch on " + h.street + ". The plow came once.");
  if(w.k === "heat") P.push("It is ninety on " + h.street + " and the fans at the senior center are broken.");
  if(h.mood < 35) P.push("People on " + h.street + " have stopped expecting anything from this office. I would like to be wrong about that.");
  if(h.mood > 70) P.push("Everybody on " + h.street + " says you are all right. Do not make them liars.");
  return pick(P);
}
function hhActs(c){
  const h = hhById(c.hh), you = G.you, A = [];
  if(!h) return A;
  A.push({t:"Hear them out", c:"20m", off:!!c.hhHeard, run(){
    spend(20, 3); c.hhHeard = true; h.mood = clamp(h.mood + 4, 0, 100); you.approval = clamp(you.approval + 1, 0, 100);
    hhRemember(h, "you sat with us about " + h.need + ".");
    setSay("It is about " + h.need + ". You listen to the whole of it, which nobody has done before.", fx("+1 approval · the " + h.fam + "s remember", "20 minutes"));
  }});
  A.push({t:"Take it on as casework", c:"40m · 3 infl", off:!!c.hhTaken || you.influence < 3 || G.casework.some(x => x && x.hh === h.id), run(){
    spend(40, 6); you.influence -= 3; c.hhTaken = true;
    G.casework.push({cause:h.need, who:c.name, due:G.day + rint(3, 6), hh:h.id});
    hhRemember(h, "you said your office would take on " + h.need + ".");
    setSay("You have your caseworker write it down in front of them. They watch every word.", fx("casework opened for the " + h.fam + "s", "−3 influence"));
    note("Opened casework for the " + h.fam + " family on " + h.need + ".");
  }});
  A.push({t:"Ask after the family", c:"10m", off:!!c.hhAsked, run(){
    spend(10, 1); c.hhAsked = true; h.mood = clamp(h.mood + 2, 0, 100);
    hhRemember(h, "you asked after " + h.kid + ".");
    setSay(h.kid + " " + h.kidNews + ". They show you a photograph from a wallet.", fx("the " + h.fam + "s warm to you", ""));
  }});
  A.push({t:"Show them out", c:"0m", run(){
    h.mood = clamp(h.mood - 3, 0, 100); hhRemember(h, "you were busy.");
    c.room = "away"; _allCache = null;
    setSay("They go. They will tell " + h.street + " you were busy.", fx("", "the " + h.fam + "s cool"));
  }});
  return A;
}
function lCaseDone(c2, news){
  if(!c2 || !c2.hh) return;
  const h = hhById(c2.hh); if(!h) return;
  h.helped++; h.mood = clamp(h.mood + 10, 0, 100);
  hhRemember(h, "your office sorted out " + h.need + ".");
  const T = townEnsure();
  T.letters.push({d:G.day, fam:h.fam, street:h.street, good:true,
    t:"The " + h.fam + " family of " + h.street + " write to say " + h.need + " is settled, and that they did not think anyone in the Capitol would bother."});
  h.need = pick(L_NEEDS.filter(x => x !== h.need));
}
function lTownNight(news){
  const T = townEnsure(), w = wxToday();
  T.hh.forEach(h => {
    h.wait = (h.wait || 0) + 1;
    let dm = (50 - h.mood) * 0.03;
    if(w.k === "storm" || w.cover >= 2) dm -= 0.6;
    if(w.k === "clear" && w.s !== "winter") dm += 0.3;
    if(h.wait > 10) dm -= 0.3;
    h.mood = clamp(h.mood + dm, 0, 100);
    if(h.mood < 30 && !T.letters.some(l => l.fam === h.fam && G.day - l.d < 6)){
      T.letters.push({d:G.day, fam:h.fam, street:h.street, good:false,
        t:"A letter from " + h.people[0] + " of " + h.street + ": \"We have asked about " + h.need + " since the winter. Is anybody there?\""});
    }
  });
  if(T.letters.length > onumLim(20,"hist")) T.letters.splice(0, T.letters.length - onumLim(20,"hist"));
  const avg = townMood();
  if(G.you && !G.you.out) G.you.approval = clamp(G.you.approval + clamp((avg - 50) / 40, -0.5, 0.5), 0, 100);
}

/* ── rivals with long arcs ──────────────────────────────── */
function rivalCandidates(){
  const y = G.you;
  return (G.members || []).filter(m => m && !m.gone && m.kind === "member" && !m.machine && !m.sanctioned && !m.chaplain &&
    !(typeof isConsular === "function" && isConsular(m)) && !(G.rivals || []).some(r => r.id === m.id));
}
function rivalPick(){
  const y = G.you; const C = rivalCandidates(); if(!C.length) return null;
  let m = C.filter(x => x.rel && x.rel.warmth < -10).sort((a, b) => a.rel.warmth - b.rel.warmth)[0];
  if(!m) m = C.filter(x => x.party !== y.party && x.state === y.state)[0];
  if(!m) m = C.filter(x => x.party !== y.party).sort((a, b) => ((b.traits && b.traits.vanity) || 0) - ((a.traits && a.traits.vanity) || 0))[0];
  if(!m) return null;
  try{ const alt = C.filter(x => x.rel && x.rel.warmth < 0 && x.party !== y.party).sort((a, b) => kinRunScore(b).score - kinRunScore(a).score)[0]; if(alt && kinRunScore(alt).score > kinRunScore(m).score + 8) m = alt; }catch(e){}
  m.rel.warmth = Math.min(m.rel.warmth, -20);
  const r = {id:m.id, name:m.name, since:G.day, stage:0, next:G.day + rint(1, 3), heat:20, answered:0, dug:false, out:null, log:[]};
  G.rivals = G.rivals || []; G.rivals.push(r);
  return r;
}
function rivalSay(r, text, news, kind){
  r.log.push({d:G.day, t:text});
  if(r.log.length > onumLim(12,"hist")) r.log.shift();
  if(news) news.push(text); else feed(text, kind || "");
}
function rivalEnd(r, out, text, news){
  r.out = out; r.ended = G.day; rivalSay(r, text, news);
  G.rivalNext = G.day + rint(8, 14);
  try{ if(out === "beaten") achieve("rival"); if(out === "truce") achieve("truce"); }catch(e){}
}
function rivalAdvance(r, news){
  const y = G.you, m = byId(r.id), sn = surname(r.name), you = surname(y.name);
  if(!m || m.gone){ return rivalEnd(r, "gone", sn + " is gone from the House. The feud went with " + (chance(.5) ? "them" : "the nameplate") + ".", news); }
  if(m.rel && m.rel.warmth > 15){
    y.approval = clamp(y.approval + 1, 0, 100); m.rel.warmth = clamp(m.rel.warmth + 10, -100, 100);
    return rivalEnd(r, "truce", sn + " and " + you + " were seen sharing a booth at the diner. The feud is over, for now.", news);
  }
  r.stage++; r.heat = clamp(r.heat + 10, 0, 100);
  if(r.stage === 1){
    y.approval = clamp(y.approval - 1, 0, 100);
    rivalSay(r, sn + " told the Ledger that " + you + " \"has never read a bill past its title.\"", news);
  } else if(r.stage === 2){
    const hit = r.answered ? 1 : 3;
    y.approval = clamp(y.approval - hit, 0, 100);
    rivalSay(r, sn + " bought radio time in " + y.state + " to talk about " + you + "'s record." + (r.answered ? " Your answer took the edge off." : ""), news);
  } else if(r.stage === 3){
    y.standing = clamp(y.standing - 2, 0, 100);
    const b = G.bill && !G.bill.done ? G.bill : null;
    rivalSay(r, b ? sn + " is whipping against " + b.title + " door to door, and telling people it is about " + you + "."
                  : rivalOffice() === "house" ? sn + " took the committee seat " + you + " wanted, and thanked the Speaker in public."
                  : sn + " is telling the cloakroom that nothing " + you + " sends up will get a hearing while " + sn + " has a say.", news);
  } else if(r.stage === 4){
    y.rivalPen = Math.min(8, Math.round(r.heat / 8));
    rivalSay(r, sn + " is raising money for " + rivalTarget() + ". The first mailer is already out.", news);
  } else {
    const me = y.approval * 0.6 + y.standing * 0.4 + (r.dug ? 8 : 0) + r.answered * 3 + rint(-10, 10);
    const them = 44 + r.heat * 0.15;
    if(me >= them){
      y.approval = clamp(y.approval + 4, 0, 100); y.rivalPen = 0;
      m.rel.warmth = Math.max(m.rel.warmth, -5);
      rivalEnd(r, "beaten", sn + " dropped the challenger and asked, quietly, " + (rivalOffice() === "house" ? "for a seat on one of " + you + "'s committees" : "for a meeting with " + you + "'s office") + ". The town noticed who blinked.", news);
    } else {
      y.standing = clamp(y.standing - 4, 0, 100); y.approval = clamp(y.approval - 3, 0, 100);
      rivalEnd(r, "lost", sn + " has the better of " + you + " this season. The cloakroom has started saying it out loud.", news);
    }
    return;
  }
  r.next = G.day + rint(3, 5);
}
function rivalTick(news){
  G.rivals = G.rivals || [];
  const live = G.rivals.filter(r => !r.out);
  if(!live.length && G.day >= (G.rivalNext || 3) && G.you && !G.you.out){
    const r = rivalPick();
    if(r) rivalSay(r, surname(r.name) + " has started telling people " + surname(G.you.name) + " is " + pick(["a show horse","in over their head","bought and paid for","all hat"]) + ".", news);
  }
  G.rivals.filter(r => !r.out && G.day >= r.next).forEach(r => rivalAdvance(r, news));
  if(G.rivals.length > 8) G.rivals.splice(0, G.rivals.length - 8);
}
function rivalLive(){ return (G.rivals || []).find(r => !r.out) || null; }
function lRivalOf(m){ const r = rivalLive(); return r && m && r.id === m.id ? r : null; }
function lHomeSwing(){
  const y = G.you; let s = 0;
  try{ s += clamp((townMood() - 50) / 6, -6, 6); }catch(e){}
  s -= (y.rivalPen || 0); y.rivalPen = 0;
  return s;
}
function rivalCard(){
  G.running = false;
  const y = G.you, r = rivalLive(), m = r ? byId(r.id) : null;
  const once = k => { y.used = y.used || {}; return y.used[k] === G.day; };
  const mark = k => { y.used = y.used || {}; y.used[k] = G.day; };
  const STAGE = ["Words in the cloakroom", "Words in the paper", "Radio time at home", "Working against you", "Funding a challenger", "The reckoning"];
  const past = (G.rivals || []).filter(x => x.out).slice(-4).reverse();
  const OUT = {truce:"made peace", beaten:"you came out ahead", lost:"they came out ahead", gone:"left the House"};
  const acts = r ? [
    {k:"truce", t:"Seek a truce", d:"30 minutes over coffee. They may take it.", off:once("rvT")},
    {k:"press", t:"Answer them in the press", d:"3 influence. Takes the sting out of the next hit.", off:once("rvP") || y.influence < 3},
    {k:"dig", t:"Dig into their record", d:"An hour and 5 influence. It will matter at the end.", off:r.dug || y.influence < 5}
  ] : [];
  card.innerHTML = '<div class="eyebrow">Rivals</div><h1>' + (r ? r.name : "Nobody, for now") + '</h1>' +
    (r ? '<p class="dream">' + STAGE[Math.min(5, r.stage)] + '. Heat ' + r.heat + '. Since day ' + r.since + '.</p>' +
      r.log.slice(-4).map(x => '<p>Day ' + x.d + ': ' + x.t + '</p>').join("") : '<p>The building is quiet about you. It will not stay that way.</p>') +
    acts.map((a, i) => '<div class="whip__row"><span class="whip__n">' + a.t + '</span><span class="whip__w">' + a.d + '</span>' +
      '<span class="whip__b"><button type="button" class="btn btn--ghost whip__go" data-rv="' + a.k + '"' + (a.off ? ' disabled' : '') + '>Do it</button></span></div>').join("") +
    (past.length ? '<p class="dream">Before: ' + past.map(x => x.name + " (" + (OUT[x.out] || x.out) + ")").join(", ") + '.</p>' : '') +
    '<div id="rvSay" class="dream"></div><div class="card__actions"><button type="button" class="btn" id="rvClose">Close</button></div>';
  veil.hidden = false;
  el("rvClose").addEventListener("click", () => walkNow());
  card.querySelectorAll("[data-rv]").forEach(bt => bt.addEventListener("click", () => {
    const k = bt.getAttribute("data-rv"); let msg = "";
    if(!r) return;
    if(k === "truce"){
      mark("rvT"); spend(30, 4);
      const ok = m && wlTruce(r);
      if(m) m.rel.warmth = clamp(m.rel.warmth + (ok ? 14 : 4), -100, 100);
      msg = ok ? surname(r.name) + " hears you out and does not say no. That is how these things start." : surname(r.name) + " drinks the coffee and gives you nothing.";
    } else if(k === "press"){
      mark("rvP"); y.influence -= 3; y.approval = clamp(y.approval + 2, 0, 100); r.answered++; r.heat = clamp(r.heat - 6, 0, 100);
      msg = "Your answer runs on page two, under theirs. It reads better.";
    } else if(k === "dig"){
      spend(60, 8); y.influence -= 5; r.dug = true; r.heat = clamp(r.heat + 10, 0, 100);
      msg = "A vote from six years ago, a donor from last spring. You keep it in a folder for the right day.";
    }
    rivalCard();
    const s = el("rvSay"); if(s) s.textContent = msg;
  }));
}

/* ── the morning Ledger ─────────────────────────────────── */
const L_NOT_NEWS = /[✓✔]|\b(standing|influence|approval|energy) [+−-]\d|^Ignored |^Today |^Missed |^Saved|^Achievement|minutes\)/i;
function lLog(text, kind){
  const you = !!G._lNote; G._lNote = false;
  if(!text || text.length < 14 || L_NOT_NEWS.test(text)) return;
  G.daylog = G.daylog || [];
  G.daylog.push({d:G.day, t:String(text).slice(0, 220), k:kind || "", you});
  if(G.daylog.length > onumLim(180,"hist")) G.daylog.splice(0, G.daylog.length - onumLim(180,"hist"));
}
function lScore(x){
  const t = x.t; let s = 0;
  if(/passed|failed|fails|falls|ruled|elected|won |lost |veto|amendment|confirm|resign|left the|switch|sworn|impeach/i.test(t)) s += 4;
  if(/envoy|realm|cable|mission/i.test(t)) s += 1;
  if(x.k === "big") s += 3;
  if(x.k === "bad" || x.k === "good") s += 1;
  try{ if(G.you && t.indexOf(surname(G.you.name)) >= 0) s += 2; }catch(e){}
  if(/^You /.test(t)) s -= 1;
  return s;
}
function lHeadline(t){
  t = String(t).replace(/\s+/g, " ").trim();
  if(t.length > 110) t = t.slice(0, 107).replace(/\s+\S*$/, "") + "...";
  return t;
}
/* 20261109b · the book of races. Polls, why the number, the map, the mood, and the vote that did it. */
const RACE_SAY = [
  "Three races are being counted: the executive, your seat, and the governor at home.",
  "The papers have added your senator and the attorney general at home.",
  "Every governor is on the board, and the treasurer at home.",
  "Every state now has a senator and an attorney general in the count.",
  "The book is fat: secretary of state, comptroller, and the state House, in every state, with a longer poll."
];
let RACE_UI = {view:"watch", st:""};
function raceDepth(){
  const d = G.day || 1, c = G.congress || 1, n = (G.races && G.races.n) || 0;
  let k = 0;
  if(d >= 12 || n >= 1) k = 1;
  if(d >= 40 || n >= 2 || c >= 3) k = 2;
  if(d >= 90 || n >= 3) k = 3;
  if(d >= 160 || n >= 5) k = 4;
  return k;
}
function raceId(k, st){ return st ? k + "@" + st : k; }
function raceTitle(k, st){
  const home = (G.you && (G.you.state || "") + (G.you.dist ? " " + G.you.dist : "")) || "";
  if(k === "pres"){ try{ return execTitle(); }catch(e){ return "President"; } }
  if(k === "house") return "Your seat" + (home ? ", " + home : "");
  const T = {gov:"Governor", sen:"Senator", ag:"Attorney General", treas:"Treasurer", sos:"Secretary of State", comp:"Comptroller", housegen:"State House"};
  return (T[k] || k) + (st ? (k === "sen" ? " from " : k === "gov" ? " of " : ", ") + st : "");
}
function raceWant(){
  const depth = raceDepth(), y = G.you || {}, home = y.state || "", states = (G.states || []).map(s => s.n);
  const list = [["pres", ""], ["house", ""]];
  if(home) list.push(["gov", home]);
  if(depth >= 1 && home){ list.push(["sen", home]); list.push(["ag", home]); }
  if(depth >= 2){ states.forEach(n => { if(n !== home) list.push(["gov", n]); }); if(home) list.push(["treas", home]); }
  if(depth >= 3){ states.forEach(n => { if(!list.some(x => x[0] === "sen" && x[1] === n)) list.push(["sen", n]); if(n !== home) list.push(["ag", n]); }); }
  if(depth >= 4){ states.forEach(n => { list.push(["sos", n]); list.push(["comp", n]); list.push(["housegen", n]); }); }
  return list;
}
function raceLean(st){
  if(!st) return G.mood || 0;
  const s = (G.states || []).find(x => x.n === st);
  return s ? (s.lean || 0) : 0;
}
function raceMake(k, st){
  const lean = raceLean(st), y = G.you || {};
  const incP = lean > 8 ? "FED" : lean < -8 ? "COM" : (Math.random() < 0.5 ? "FED" : "COM");
  const chP = incP === "FED" ? "COM" : "FED";
  let inc = newName(st || (y.state || null)), you = false, pInc = incP;
  if(k === "pres" && G.exec && G.exec.name){ inc = G.exec.name; pInc = G.exec.party || incP; you = !!(G.exec.you || y.office === "pres"); }
  else if(k === "house" && y.name && !y.out && (y.office || "house") === "house"){ inc = y.name; pInc = y.party || incP; you = true; }
  else if(k === "gov" && y.office === "gov" && st && st === y.state){ inc = y.name; pInc = y.party || incP; you = true; }
  else if(k === "sen" && y.office === "senate" && st && st === y.state){ inc = y.name; pInc = y.party || incP; you = true; }
  const pull = you ? 50 + ((y.approval || 50) - 50) * 0.35 + (y.margin || 0) * 0.25 : 50 + lean * 0.2;
  const base = clamp(Math.round(pull + rint(-4, 4)), 34, 66);
  const day = G.day || 1;
  return {k, st:st || "", you, field:[{n:inc, p:pInc, you:you}, {n:newName(st || (y.state || null)), p:chP, you:false}], series:[[Math.max(1, day - 3), clamp(base + rint(-3, 3), 32, 68)], [day, base]]};
}
function raceSync(rc){
  const y = G.you; if(!y || !rc) return;
  if(rc.k === "house" && !y.out && (y.office || "house") === "house"){ rc.you = true; rc.field[0].n = y.name; rc.field[0].p = y.party || rc.field[0].p; rc.field[0].you = true; }
  else if(rc.k === "pres" && ((G.exec && G.exec.you) || y.office === "pres")){ rc.you = true; rc.field[0].n = y.name; rc.field[0].p = y.party || rc.field[0].p; rc.field[0].you = true; }
  else if(rc.k === "gov" && y.office === "gov" && rc.st === y.state){ rc.you = true; rc.field[0].n = y.name; rc.field[0].p = y.party || rc.field[0].p; rc.field[0].you = true; }
  else if(rc.k === "sen" && y.office === "senate" && rc.st === y.state){ rc.you = true; rc.field[0].n = y.name; rc.field[0].p = y.party || rc.field[0].p; rc.field[0].you = true; }
  else if(rc.k === "pres" && G.exec && G.exec.name && !rc.you){ rc.field[0].n = G.exec.name; if(G.exec.party) rc.field[0].p = G.exec.party; }
}
function raceEnsure(){
  if(typeof ENG_DRY !== "undefined" && ENG_DRY.on) return G.races || {live:{}, hist:[], n:0};
  if(!G.races || !G.races.live) G.races = {v:1, n:0, hist:[], live:{}, polled:0, seeded:0};
  const B = G.races;
  raceWant().forEach(pair => { const id = raceId(pair[0], pair[1]); if(!B.live[id]) B.live[id] = raceMake(pair[0], pair[1]); });
  Object.keys(B.live).forEach(id => { try{ raceSync(B.live[id]); }catch(e){} });
  if(!B.seeded){ raceBackfill(B); B.seeded = 1; }
  return B;
}
function raceBackfill(B){
  if(B.hist && B.hist.length) return;
  B.hist = B.hist || [];
  const y = G.you || {}, cong = G.congress || 1;
  const back = Math.min(4, 1 + Math.floor((G.day || 1) / 55));
  const home = y.state || ((G.states || [])[0] || {}).n || "";
  for(let i = back; i >= 1; i--){
    const c = Math.max(1, cong - i);
    const presP = (G.mood || 0) >= 0 ? "FED" : "COM";
    B.hist.push({c, d:Math.max(1, (G.day || 1) - i * 70), k:"pres", st:"", w:(G.exec && i === 1 && G.exec.name) ? G.exec.name : newName(null), p:(G.exec && i === 1 && G.exec.party) ? G.exec.party : presP, m:4 + (i * 3) % 9, y:false});
    if(y.name && (y.terms || 1) > i && (y.office || "house") === "house") B.hist.push({c, d:Math.max(1, (G.day || 1) - i * 70), k:"house", st:home, w:y.name, p:y.party || "IND", m:Math.max(1, Math.round(y.margin || 6)), y:true});
    else B.hist.push({c, d:Math.max(1, (G.day || 1) - i * 70), k:"house", st:home, w:newName(home), p:presP, m:3 + i, y:false});
    if(home) B.hist.push({c, d:Math.max(1, (G.day || 1) - i * 70), k:"gov", st:home, w:(y.office === "gov" && i === 1) ? y.name : newName(home), p:(y.office === "gov" && i === 1) ? (y.party || presP) : presP, m:5 + i, y:!!(y.office === "gov" && i === 1)});
  }
}
function raceStep(rc){
  const y = G.you || {}, lean = raceLean(rc.st);
  let pull = rc.you ? 50 + ((y.approval || 50) - 50) * 0.4 + (y.margin || 0) * 0.3 : 50 + lean * 0.18;
  if(rc.k === "pres") pull += (G.mood || 0) * 0.08;
  if(rc.st){ const s = (G.states || []).find(x => x.n === rc.st); if(s) pull -= Math.max(0, (s.unrest || 0) - 45) * 0.05; }
  const last = rc.series.length ? rc.series[rc.series.length - 1][1] : pull;
  const nxt = clamp(Math.round(last * 0.7 + pull * 0.3 + rint(-3, 3)), 31, 69);
  rc.series.push([G.day || 1, nxt]);
  const cap = [8, 12, 18, 28, 42][raceDepth()];
  if(rc.series.length > cap) rc.series.splice(0, rc.series.length - cap);
}
function raceDay(){
  if(typeof ENG_DRY !== "undefined" && ENG_DRY.on) return;
  if(!G.you) return;
  const B = raceEnsure();
  if(B.polled === G.day) return;
  B.polled = G.day;
  const depth = raceDepth(), home = (G.you && G.you.state) || "";
  const ids = Object.keys(B.live);
  ids.forEach(id => {
    const rc = B.live[id];
    const hot = rc.k === "pres" || rc.k === "house" || (home && rc.st === home);
    const turn = (seedOf("rx:" + id + ":" + G.day) % Math.max(1, 5 - depth)) === 0;
    if(hot || turn) raceStep(rc);
  });
  if((G.day || 0) % 6 === 0 && B.live.pres && B.live.pres.series.length){
    const rc = B.live.pres, pct = rc.series[rc.series.length - 1][1];
    try{ lLog("A poll puts " + rc.field[0].n + " at " + pct + " for " + raceTitle("pres") + ", " + rc.field[1].n + " at " + (100 - pct) + ".", "press"); }catch(e){}
  }
}
function raceTrim(B){
  const cap = [40, 90, 160, 280, 520][raceDepth()];
  if(!B.hist || B.hist.length <= cap) return;
  const keep = [], rest = [];
  const home = (G.you && G.you.state) || "";
  B.hist.forEach(h => { if(h.y || h.k === "pres" || h.k === "house" || (home && h.st === home)) keep.push(h); else rest.push(h); });
  B.hist = keep.concat(rest.slice(Math.max(0, keep.length + rest.length - cap)));
  if(B.hist.length > cap + keep.length) B.hist = B.hist.slice(-cap);
}
function raceSettleOne(rc, pct, cong){
  const a = clamp(Math.round(pct), 30, 70), win = a >= 50 ? 0 : 1, winner = rc.field[win];
  G.races.hist.push({c:cong, d:G.day || 1, k:rc.k, st:rc.st || "", w:winner.n, p:winner.p, m:Math.max(1, Math.round(Math.abs(a - 50) * 2)), y:!!(rc.you && win === 0)});
  if(win === 1){ const loser = rc.field[0]; rc.field[0] = {n:rc.field[1].n, p:rc.field[1].p, you:false}; rc.field[1] = {n:newName(rc.st || null), p:loser.p, you:false}; rc.you = false; }
  else rc.field[1] = {n:newName(rc.st || null), p:rc.field[1].p, you:false};
  const lead = win === 0 ? a : 100 - a;
  rc.series = [[G.day || 1, clamp(lead, 32, 68)]];
}
function raceOnElection(meta){
  if(typeof ENG_DRY !== "undefined" && ENG_DRY.on) return;
  meta = meta || {};
  const B = raceEnsure(); B.n = (B.n || 0) + 1;
  const cong = (G.congress || 1) + 1;
  Object.keys(B.live).forEach(id => {
    const rc = B.live[id];
    if(meta.midTerm && rc.you && (rc.k === "pres" || rc.k === "gov" || rc.k === "sen")) return;
    let pct = (rc.series.length ? rc.series[rc.series.length - 1][1] : 50) + rint(-4, 4);
    const mine = !meta.midTerm && ((rc.k === "house" && (meta.seeking === "house" || !meta.seeking)) || (rc.k === "pres" && meta.seeking === "pres") || (rc.k === "gov" && meta.seeking === "gov" && rc.you) || (rc.k === "sen" && meta.seeking === "senate" && rc.you));
    if(mine) pct = meta.youWon ? clamp(50 + Math.abs(meta.margin || 2) / 2, 51, 68) : clamp(49 - Math.abs(meta.margin || 2) / 2, 32, 49);
    if(rc.k === "house" && !meta.midTerm && meta.seeking && meta.seeking !== "house" && meta.seeking !== "none" && meta.youWon){ rc.you = false; pct = 50 + rint(-6, 8); }
    raceSettleOne(rc, pct, cong);
  });
  raceTrim(B);
}
function raceMoe(rc){
  const n = (rc && rc.series && rc.series.length) || 1;
  return Math.max(1.1, 5.6 - raceDepth() * 0.75 - Math.min(2.2, n / 14));
}
function raceSample(rc){
  const n = (rc && rc.series && rc.series.length) || 1;
  return 380 + raceDepth() * 420 + n * 55;
}
function raceCol(p){ try{ return partyColorHex(p) || "#5B6670"; }catch(e){ return p === "FED" ? "#2f5f8a" : p === "COM" ? "#8e2f3b" : "#6b6456"; } }
function raceSpark(series){
  if(!series || series.length < 2) return "";
  const ys = series.map(p => p[1]), min = Math.min(42, Math.min.apply(null, ys)), max = Math.max(58, Math.max.apply(null, ys));
  const w = 240, h = 46;
  const pts = ys.map((y, i) => { const x = 1 + (i / (ys.length - 1)) * (w - 2); const yy = (h - 3) - ((y - min) / (max - min || 1)) * (h - 6); return x.toFixed(1) + "," + yy.toFixed(1); }).join(" ");
  const y50 = (h - 3) - ((50 - min) / (max - min || 1)) * (h - 6);
  return '<svg class="rx__svg" viewBox="0 0 ' + w + ' ' + h + '" aria-hidden="true"><line x1="0" y1="' + y50.toFixed(1) + '" x2="' + w + '" y2="' + y50.toFixed(1) + '" stroke="#c9a24a" stroke-dasharray="3 3" stroke-width="1"/><polyline fill="none" stroke="#1d3f66" stroke-width="1.7" points="' + pts + '"/></svg>';
}
function raceBars(rc){
  const a = rc.series.length ? rc.series[rc.series.length - 1][1] : 50, b = 100 - a;
  const f0 = rc.field[0], f1 = rc.field[1];
  return '<div class="rx__bars"><span style="width:' + a + '%;background:' + raceCol(f0.p) + '">' + a + '</span><span style="width:' + b + '%;background:' + raceCol(f1.p) + '">' + b + '</span></div>' +
    '<small>' + pcEsc(f0.n) + ' ' + pcEsc(partyLabel(f0.p)) + ' ' + a + ' · ' + pcEsc(f1.n) + ' ' + pcEsc(partyLabel(f1.p)) + ' ' + b + ' · ±' + raceMoe(rc).toFixed(1) + ' · sample ' + raceSample(rc).toLocaleString("en-US") + '</small>';
}
function raceStateOf(st){ return (G.states || []).find(x => x.n === st) || STATE_DEF.find(x => x.n === st) || null; }
function raceLeadOf(rc){
  const a = rc && rc.series && rc.series.length ? rc.series[rc.series.length - 1][1] : 50;
  const i = a >= 50 ? 0 : 1;
  const lead = rc.field[i], other = rc.field[i ? 0 : 1];
  return {a, share:i ? 100 - a : a, lead, other, gap:Math.abs(a - 50) * 2, toss:Math.abs(a - 50) * 2 < raceMoe(rc) * 2};
}
function raceWhy(rc, short){
  if(!rc || !rc.field) return "";
  const L = raceLeadOf(rc), y = G.you || {}, st = rc.st ? raceStateOf(rc.st) : null, bits = [];
  if(L.toss) bits.push(L.lead.n + " and " + L.other.n + " are inside the error. One week, or one vote the district hated, moves it.");
  else bits.push(L.lead.n + " leads " + L.other.n + " by about " + Math.round(L.gap) + ". Sample " + raceSample(rc).toLocaleString("en-US") + ", error ±" + raceMoe(rc).toFixed(1) + ". The chart is the incumbent's share. Fifty is a tie.");
  if(st){
    const lean = st.lean || 0, way = lean > 8 ? "Federalist" : lean < -8 ? "Commonwealth" : "split";
    bits.push(st.n + " leans " + way + (Math.abs(lean) > 3 ? " by " + Math.abs(Math.round(lean)) : "") + ". " + (st.note || ""));
    if((st.unrest || 0) > 55) bits.push("Unrest is " + Math.round(st.unrest) + ". People in a loud street punish whoever already holds the office.");
    else if((st.unrest || 0) < 22) bits.push("Unrest is quiet (" + Math.round(st.unrest || 0) + "). They are voting the habit, not the emergency.");
    if((st.ind || 0) >= 70) bits.push("Industry is " + Math.round(st.ind) + ". A fat year helps whoever looks like the people who sign the payroll.");
    else if((st.ind || 0) > 0 && st.ind < 42) bits.push("Industry is thin (" + Math.round(st.ind) + "). Bread and wages are the argument, not the speech.");
  } else if(rc.k === "pres"){
    const m = G.mood || 0;
    bits.push("National mood is " + Math.round(m) + (m > 12 ? ", with the government" : m < -12 ? ", against the government" : ", and not yet decided") + ". The executive's number follows that more than any one state.");
    try{
      const cm = chamberMood();
      bits.push("The chamber leans " + (cm.econ > 8 ? "toward the market" : cm.econ < -8 ? "toward the public purse" : "neither way on money") + " and " + (cm.lib > 8 ? "toward liberty" : cm.lib < -8 ? "toward order" : "the middle on liberty") + ". Mean unrest is " + Math.round(cm.unrest || 0) + ".");
    }catch(e){}
  }
  if(!short && rc.st){
    try{
      const c = creedOfState(rc.st);
      if(c) bits.push("Most of the ground is " + c.t + ". " + (c.sincere ? c.holds : (c.jab || c.holds)));
    }catch(e){}
  }
  if(rc.you){
    bits.push("This is your race. Approval at home is " + Math.round(y.approval || 0) + " and the last margin was " + Math.round(y.margin || 0) + ".");
    if(G.town && G.town.hh && G.town.hh.length && (!rc.st || rc.st === y.state)){
      try{
        const tm = townMood();
        bits.push("The households at home are " + (tm > 60 ? "warm" : tm < 40 ? "cool" : "still making up their minds") + " (" + Math.round(tm) + "). They remember a letter and a need before they remember a floor speech.");
      }catch(e){}
    }
    try{
      const w = worstVote();
      if(w && w.v && w.fit < 0) bits.push("The vote they can hang on you is " + (w.v.vote > 0 ? "aye" : "no") + " on " + w.v.title + ", day " + w.v.day + ". It does not fit the district.");
    }catch(e){}
  }
  const prior = ((G.races && G.races.hist) || []).filter(h => h.k === rc.k && (h.st || "") === (rc.st || ""));
  const last = prior.length ? prior[prior.length - 1] : null;
  if(last) bits.push("Last time this office was counted, " + last.w + " took it by " + last.m + " in the " + ordinal(last.c) + " Congress.");
  if(rc.series && rc.series.length >= 2){
    const dlt = rc.series[rc.series.length - 1][1] - rc.series[0][1];
    bits.push("Since day " + rc.series[0][0] + " the incumbent's number has " + (dlt > 1 ? "risen " + dlt : dlt < -1 ? "fallen " + Math.abs(dlt) : "held") + ".");
  }
  return short ? bits.slice(0, 2).join(" ") : bits.join(" ");
}
function raceVoteSentence(v){
  const y = G.you || {}, pos = v.pos || {};
  let axis = "econ", best = -1;
  AXES.forEach(a => { const mag = Math.abs(pos[a.k] || 0); if(mag > best){ best = mag; axis = a.k; } });
  const ax = AXES.find(a => a.k === axis) || AXES[0];
  const dir = pos[axis] || 0, aye = (v.vote || 0) > 0;
  const toward = (aye ? dir : -dir) >= 0 ? ax.hi : ax.lo;
  let fit = 0;
  try{
    const d = y.district || {};
    let s = 0;
    AXES.forEach(a => { s += -Math.abs((d[a.k] || 0) - (pos[a.k] || 0)) / 4 + 12; });
    fit = aye ? s : -s;
  }catch(e){}
  const home = y.state || "home", lean = raceLean(home);
  const help = Math.abs(dir) < 8 ? "barely moves the district either way" : (fit >= 0 ? "sits with the district" : "sits against the district");
  return (aye ? "Aye" : "No") + " on " + (v.title || "a bill") + ", day " + (v.day || "?") + ", and it " + (v.passed ? "passed" : "failed") + ". The sharp edge is " + ax.n + ", toward " + toward + ". " + cap(help) + " in " + home + ", which leans " + (lean > 8 ? "Federalist" : lean < -8 ? "Commonwealth" : "split") + ".";
}
function raceTidbit(rc){
  const y = G.you || {}, bits = [];
  const st = rc && rc.st ? raceStateOf(rc.st) : (y.state ? raceStateOf(y.state) : null);
  try{
    if(st){
      const ch = (G.rite && G.rite.chapels && G.rite.chapels[st.n]) || 0;
      if(ch) bits.push(st.n + " keeps " + ch + " Consular chapel" + (ch > 1 ? "s" : "") + ". The lawgiver they quote is a man, never God. The pews still vote.");
      if(st.bill && st.bill.title) bits.push("The statehouse is sitting on " + st.bill.title + ". A governor's race feels that before the Capitol does.");
    }
    if(G.town && G.town.hh && G.town.hh.length && (!rc || !rc.st || rc.st === y.state)){
      const h = G.town.hh[Math.abs(seedOf("tidh:" + (G.day || 1))) % G.town.hh.length];
      if(h) bits.push("On " + h.street + ", the " + h.fam + " household is at " + Math.round(h.mood) + " over " + h.need + ".");
    }
    if(G.town && G.town.letters && G.town.letters.length && (!rc || !rc.st || rc.st === y.state)){
      const L = G.town.letters[G.town.letters.length - 1];
      if(L && L.t) bits.push("A letter still on the desk: " + String(L.t).replace(/\s+/g, " ").slice(0, 140));
    }
    if(rc && rc.you){
      let rv = null; try{ rv = rivalLive(); }catch(e){}
      if(rv && rv.name) bits.push(rv.name + " is still in it. A rival quotes the vote you hoped was procedural.");
    }
    if(G.money && typeof guilderIndex === "function") bits.push("The guilder index is " + guilderIndex().toFixed(1) + ". In Coalport one guilder is still called a day's wage. A poll does not buy bread.");
  }catch(e){}
  if(!bits.length) return "";
  return bits[Math.abs(seedOf("tid:" + ((rc && rc.k) || "") + ":" + ((rc && rc.st) || "") + ":" + (G.day || 1))) % bits.length];
}
function raceHow(){
  return "A poll is not a vote. Each morning the hot races, the executive and your seat and home, take a new point. The rest of the book is sampled in turn, so a long career does not pretend every comptroller was called every day. Election night files the return, names a new challenger, and starts the next chart. The book grows with the term: " + (RACE_SAY[raceDepth()] || "") + " History keeps your races, the executive, your seat, and home, and trims the rest so the file can still be read. Nothing here raises a meter's ceiling, and a dry day does not write the book.";
}
function raceMoodBox(){
  const y = G.you || {};
  let tm = null;
  if(G.town && G.town.hh && G.town.hh.length){ try{ tm = townMood(); }catch(e){} }
  let cm = null; try{ cm = chamberMood(); }catch(e){}
  const st = y.state ? raceStateOf(y.state) : null;
  let line = "National mood " + Math.round(G.mood || 0) + ". Your approval " + Math.round(y.approval || 0) + ".";
  if(tm != null) line += " Households at home " + Math.round(tm) + (tm > 60 ? ", warm" : tm < 40 ? ", cool" : ", undecided") + ".";
  if(st) line += " " + st.n + ": unrest " + Math.round(st.unrest || 0) + ", industry " + Math.round(st.ind || 0) + ", lean " + Math.round(st.lean || 0) + ". " + (st.note || "");
  if(cm) line += " The chamber is " + (cm.econ > 8 ? "market-minded" : cm.econ < -8 ? "public-purse-minded" : "in the middle on money") + ", and mean unrest across the states is " + Math.round(cm.unrest || 0) + ".";
  line += " People feel a vote in their town before they feel a speech in the Capitol.";
  return '<div class="rx__c"><b>Why the mood is what it is</b><p class="rx__why">' + pcEsc(line) + '</p></div>';
}
function raceMapLead(name){
  const B = G.races && G.races.live;
  const rc = B && B["gov@" + name];
  if(!rc || !rc.series || !rc.series.length || !rc.field) return null;
  const a = rc.series[rc.series.length - 1][1];
  const lead = a >= 50 ? rc.field[0] : rc.field[1];
  return {p:lead.p, n:lead.n};
}
function raceMapSVG(){
  const S = G.states || [];
  if(!S.length) return "";
  const C = 48, ox = 6, oy = 6;
  const maxC = Math.max.apply(null, S.map(s => s.col)), maxR = Math.max.apply(null, S.map(s => s.row));
  const W = ox * 2 + (maxC + 1) * C, H = oy * 2 + (maxR + 1) * C;
  let g = '<svg class="rx__svgmap" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="Who leads for governor">';
  S.forEach(st => {
    const x = ox + st.col * C, y = oy + st.row * C;
    const lead = raceMapLead(st.n);
    const fill = lead ? raceCol(lead.p) : (st.lean > 8 ? "#8a4b4b" : st.lean < -8 ? "#4b5f8a" : "#6b6456");
    const mine = G.you && G.you.state === st.n, sel = RACE_UI.st === st.n;
    const label = st.n.length > 12 ? st.n.slice(0, 11) : st.n;
    g += '<g data-rxst="' + pcEsc(st.n) + '" style="cursor:pointer"><title>' + pcEsc(st.n + (lead ? ": " + lead.n + " leads" : ": not yet in the governor count")) + '</title><rect x="' + x + '" y="' + y + '" width="' + (C - 4) + '" height="' + (C - 4) + '" rx="4" fill="' + fill + '" stroke="' + (sel ? "#ffe08a" : mine ? "#fff" : "#1a140c") + '" stroke-width="' + (sel || mine ? 2.5 : 1) + '"/><text x="' + (x + (C - 4) / 2) + '" y="' + (y + (C - 4) / 2 + 3) + '" fill="#fff" font-size="7.5" text-anchor="middle">' + pcEsc(label) + '</text></g>';
  });
  g += '</svg>';
  return '<div class="rx__map"><div class="eyebrow">Who leads for governor · white ring is home · click a state</div>' + g + '<p class="rx__how">Colour is the party ahead for governor, where that race is already in the book. Everywhere else the colour is only the lean. An early career has a short map on purpose.</p></div>';
}
function raceHistLine(h){
  const lean = h.st ? raceLean(h.st) : (G.mood || 0);
  const side = h.p === "FED" ? "Federalist" : h.p === "COM" ? "Commonwealth" : (partyLabel(h.p) || "independent");
  const read = h.m < 4 ? "A margin that small is a squeaker. One bad month undoes it." : h.m > 10 ? "That looked safe, until the mood moved." : "Real, and not a dynasty.";
  return (h.y ? "That was you. " : "") + h.w + " (" + side + ") carried " + raceTitle(h.k, h.st) + " by " + h.m + " in the " + ordinal(h.c) + " Congress, day " + h.d + ". The ground leaned " + (lean > 8 ? "Federalist" : lean < -8 ? "Commonwealth" : "split") + ". " + read;
}
function raceVotesHTML(){
  const y = G.you || {};
  const votes = (y.record && y.record.votes) || [];
  if(!votes.length) return '<div class="rx__vote"><b>Your roll calls, read against home</b><p class="rx__how">No roll call filed yet. The first one you cast is the sentence the district will quote.</p></div>';
  return '<div class="rx__vote"><b>Your roll calls, read against home</b>' + votes.slice(-6).reverse().map(v => '<p>' + pcEsc(raceVoteSentence(v)) + '</p>').join("") + '<p class="rx__how">' + votes.length + ' roll calls on the record' + (y.record.partyBreaks ? ", " + y.record.partyBreaks + " against your party" : "") + (y.record.conscience ? ", " + y.record.conscience + " against your own position" : "") + (y.record.bills != null ? ", " + y.record.bills + " on the winning side" : "") + '.</p></div>';
}
function raceCardHTML(rc, mode){
  const full = mode === "full";
  const why = '<p class="rx__why">' + pcEsc(raceWhy(rc, !full)) + '</p>';
  let tid = "";
  if(full){ const t = raceTidbit(rc); if(t) tid = '<p class="rx__tid">' + pcEsc(t) + '</p>'; }
  return '<div class="rx__c"><b>' + pcEsc(raceTitle(rc.k, rc.st)) + (rc.you ? " · yours" : "") + '</b>' + raceBars(rc) + raceSpark(rc.series) + why + tid + '</div>';
}
function raceHouseBar(){
  const s = G.seatsBy || {}, keys = Object.keys(s).filter(p => (s[p] || 0) > 0);
  const tot = keys.reduce((a, p) => a + (s[p] || 0), 0) || 1;
  return '<div class="rx__c"><b>The House, as it stands</b><div class="rx__bars">' + keys.sort((a, b) => s[b] - s[a]).map(p => '<span style="width:' + ((s[p] / tot) * 100) + '%;background:' + raceCol(p) + '">' + s[p] + '</span>').join("") + '</div><small>' + keys.map(p => s[p] + ' ' + partyName(p)).join(" · ") + '</small><p class="rx__how">Seats already won, not a poll. A party can hold the room and still lose the next governor.</p></div>';
}
function racePaperHTML(){
  const B = raceEnsure(), depth = raceDepth();
  const home = (G.you && G.you.state) || "";
  const ids = Object.keys(B.live).filter(id => { const rc = B.live[id]; return rc.k === "pres" || rc.k === "house" || (home && rc.st === home); }).slice(0, 4);
  return '<p class="np__deck">' + pcEsc(RACE_SAY[depth] || "") + ' The count gets longer as the term does. The paragraph under each number is why it sits there.</p><div class="rx">' + raceHouseBar() + ids.map(id => raceCardHTML(B.live[id])).join("") + '</div>';
}
function raceCard(){
  G.running = false;
  const B = raceEnsure(), depth = raceDepth(), y = G.you || {};
  const sts = (G.states || []).map(s => s.n);
  if(!RACE_UI.st) RACE_UI.st = y.state || sts[0] || "";
  const view = RACE_UI.view || "watch";
  let body = "";
  if(view === "past"){
    const rows = (B.hist || []).slice().reverse().slice(0, 48);
    body = '<p class="rx__how">How to read a return. The plus is the margin, not the share. A small plus in a state that leans the other way is a borrowed win. Your own returns stay in the book even after the rest is trimmed. Older cycles before this career are a short backfill, not a fabricated century. The live board is what grows.</p>' +
      (rows.length ? '<div class="results">' + rows.map(h => '<div><span>' + pcEsc(raceHistLine(h)) + '</span><b class="win">+' + h.m + '</b></div>').join("") + '</div>' : '<p>No returns filed yet. The first election night writes them.</p>');
  } else {
    let ids = Object.keys(B.live);
    if(view === "watch") ids = ids.filter(id => { const rc = B.live[id]; return rc.k === "pres" || rc.k === "house" || rc.st === (y.state || ""); });
    else if(view === "home") ids = ids.filter(id => B.live[id].st === (y.state || "") || B.live[id].k === "house" || B.live[id].k === "pres");
    else ids = ids.filter(id => B.live[id].st === RACE_UI.st || B.live[id].k === "pres");
    body = raceMapSVG() + raceMoodBox() + '<p class="rx__how">' + pcEsc(raceHow()) + '</p>' +
      (view === "all" ? '<label class="rx__sel">State <select id="rxSt" class="rx__sel">' + sts.map(n => '<option' + (n === RACE_UI.st ? ' selected' : '') + '>' + pcEsc(n) + '</option>').join("") + '</select></label>' : '') +
      '<div class="rx">' + (view !== "all" ? raceHouseBar() : '') + ids.map(id => raceCardHTML(B.live[id], "full")).join("") + '</div>' +
      raceVotesHTML();
  }
  const tab = (id, t) => '<button type="button" data-rvw="' + id + '"' + (view === id ? ' class="on"' : '') + '>' + t + '</button>';
  card.innerHTML = '<div class="eyebrow">The book of races · ' + (depth + 1) + ' of 5</div><h1>Polls, maps, why</h1>' +
    '<p class="dream">' + pcEsc(RACE_SAY[depth] || "") + ' Open a state to see who leads, why the ground feels that way, and which of your votes the district will still be quoting.</p>' +
    '<div class="rx__tabs">' + tab("watch", "Watching") + tab("home", "Your state") + tab("all", "Every state") + tab("past", "History") + '</div>' + body +
    '<div class="card__actions"><button type="button" class="btn" id="rxBack">Back to the Ledger</button><button type="button" class="btn btn--ghost" id="rxClose">Close</button></div>';
  veil.hidden = false;
  card.querySelectorAll("[data-rvw]").forEach(b => b.addEventListener("click", () => { RACE_UI.view = b.getAttribute("data-rvw"); raceCard(); }));
  card.querySelectorAll("[data-rxst]").forEach(g => g.addEventListener("click", () => { RACE_UI.st = g.getAttribute("data-rxst"); RACE_UI.view = "all"; raceCard(); }));
  const sel = el("rxSt"); if(sel) sel.addEventListener("change", () => { RACE_UI.st = sel.value; raceCard(); });
  el("rxBack").addEventListener("click", () => paperCard());
  el("rxClose").addEventListener("click", () => walkNow());
}
function onumLedgerFacts(stateName){
  const y = G.you || {};
  const name = stateName || y.state || ((G.states || [])[0] && G.states[0].n) || "";
  const st = name ? (raceStateOf(name) || {}) : {};
  const home = !!(y.state && name === y.state);
  const B = (G.races && G.races.live) || {};
  const pack = id => {
    const rc = B[id];
    if(!rc || !rc.series || !rc.series.length || !rc.field) return null;
    const L = raceLeadOf(rc);
    return {title:raceTitle(rc.k, rc.st), lead:L.lead.n, party:L.lead.p, share:L.share, you:!!rc.you, why:raceWhy(rc, true), k:rc.k};
  };
  const races = [];
  ["gov","sen","ag","treas","sos","comp","housegen"].forEach(k => { const p = pack(raceId(k, name)); if(p) races.push(p); });
  if(home){ const h = pack("house"); if(h) races.unshift(h); }
  const pres = pack("pres");
  let creed = null;
  try{ const c = name && creedOfState(name); if(c) creed = {t:c.t, line:c.sincere ? c.holds : (c.jab || c.holds), sincere:!!c.sincere}; }catch(e){}
  const votes = home ? ((y.record && y.record.votes) || []).slice(-6).reverse().map(v => { try{ return raceVoteSentence(v); }catch(e){ return (v.vote > 0 ? "Aye" : "No") + " on " + v.title; } }) : [];
  const daylog = [];
  (G.daylog || []).slice(-50).forEach(x => { if(x && x.t && name && String(x.t).indexOf(name) >= 0) daylog.push("Day " + x.d + ": " + String(x.t).replace(/\s+/g, " ").slice(0, 220)); });
  let town = null;
  if(home && G.town && G.town.hh && G.town.hh.length){
    let mood = 50; try{ mood = Math.round(townMood()); }catch(e){}
    const letter = (G.town.letters && G.town.letters.length) ? String(G.town.letters[G.town.letters.length - 1].t || "").replace(/\s+/g, " ").slice(0, 240) : "";
    town = {mood, letter, streets:(G.town.hh || []).slice(0, 7).map(h => ({street:h.street, fam:h.fam, mood:Math.round(h.mood || 0), need:h.need || ""}))};
  }
  let gov = null;
  try{ const g = stateGovInfo(name); if(g && g.g) gov = {t:g.g.t, d:g.g.d, short:g.g.short, name:(g.rec && g.rec.gov) || ""}; }catch(e){}
  const hist = ((G.races && G.races.hist) || []).filter(h => h.st === name || (home && (h.y || h.k === "house"))).slice(-8).map(h => ({c:h.c, d:h.d, k:h.k, w:h.w, p:h.p, m:h.m, y:!!h.y, line:raceHistLine(h)}));
  return {
    ok:!!(name && (st.n || (G.states || []).some(s => s.n === name) || home)),
    day:G.day || 1, name, home,
    state:{n:st.n || name, lean:Math.round(st.lean || 0), unrest:Math.round(st.unrest || 0), ind:Math.round(st.ind || 0), pop:st.pop || 0, creed:st.creed || "", note:st.note || "", seats:st.seats || 0, bill:st.bill && st.bill.title ? st.bill.title : ""},
    you:home ? {name:y.name || "", approval:Math.round(y.approval || 0), margin:Math.round(y.margin || 0), party:y.party || "", office:y.office || "house"} : null,
    mood:Math.round(G.mood || 0), town, creed, gov, races, pres, votes,
    daylog:daylog.slice(-6), hist,
    states:(G.states || []).map(s => s.n),
    chapel:(G.rite && G.rite.chapels && G.rite.chapels[name]) || 0,
    guilder:(G.money && typeof guilderIndex === "function") ? Math.round(guilderIndex() * 10) / 10 : null
  };
}
try{ window.onumLedgerFacts = onumLedgerFacts; }catch(e){}
function paperBuild(){
  const D = G.day, y = G.you;
  const prev = (G.daylog || []).filter(x => x.d === D - 1 || (x.d === D && /overnight|this morning/i.test(x.t)));
  const night = ((G.nightNews && (G.nightNews.day === D - 1 || G.nightNews.day === D)) ? G.nightNews.items.map(t => ({t, k:"", d:D})) : []).concat((G.reactNews || []).filter(x => x.d >= D - 1).map(x => ({t:x.t, k:"", d:D})));
  const seen = new Set(), all = [];
  const sn = y ? surname(y.name) : "The member";
  night.concat(prev).forEach(x => {
    if(L_NOT_NEWS.test(x.t)) return;
    let t = x.t;
    if(x.you && !/^(You|Your|The|A|An)\b/.test(t) && t.indexOf(sn) < 0) t = sn + " " + t.charAt(0).toLowerCase() + t.slice(1);
    else if(/^You /.test(t)) t = sn + " " + t.slice(4);
    const key = t.slice(0, 60); if(seen.has(key)) return; seen.add(key); all.push({t, k:x.k, d:x.d});
  });
  all.sort((a, b) => lScore(b) - lScore(a));
  const top = all[0];
  const T = townEnsure();
  const letter = T.letters.filter(l => D - l.d <= 3).slice(-1)[0];
  const r = rivalLive() || (G.rivals || []).filter(x => x.ended && D - x.ended <= 1).slice(-1)[0];
  const rl = r && r.log.length ? r.log[r.log.length - 1] : null;
  return {
    day:D,
    head: top ? lHeadline(top.t) : (G.bill && !G.bill.done ? "The House turns to " + G.bill.title : "A quiet day in the Capitol"),
    stories: all.slice(1, 5).map(x => lHeadline(x.t)),
    rival: rl && D - rl.d <= 2 ? rl.t : null,
    letter: letter ? letter.t : null,
    wx: wxLine(),
    poll: y ? "Your approval at home stands at " + Math.round(y.approval) + ". The households on " + pick(T.hh).street + " are " + (townMood() > 60 ? "warm to you" : townMood() < 40 ? "cool on you" : "making up their minds") + "." : ""
  };
}
/* ── the Ledger as a newspaper: one lead, the party presses, the pulpit, the independents, and the small headlines of other papers ── */
const NP_PAPERS = {
  FED:{n:"The Federal Standard", tag:"for the Federalist Union"}, COM:{n:"The Commonwealth Courier", tag:"for the common wealth"},
  faith:{n:"The Kerk & Chapel Review", tag:"a weekly of the faithful"}, ind:{n:"The Harbour Independent", tag:"owned by no one who will admit it"},
  wire:{n:"The Wire", tag:"as received"}
};
function npSpin(party, headline, r){
  const h = String(headline).replace(/\.$/, "");
  const f = {
    FED:["Order, at last: " + h, "A sound result. " + h + ", and the markets agree", "The Federal view: " + h + "; the alternative was worse"],
    COM:["At whose expense? " + h, "The people were not asked: " + h, "A hollow win: " + h + ", and the bill arrives later"]
  };
  return drawn(f[party], r);
}
function npHTML(){
  const P = paperBuild(), D = G.day, y = G.you, r = rng(seedOf("np:" + D + ":" + (G.country || "")));
  const sts = (G.states || []).slice(), hot = sts.slice().sort((a, b) => b.unrest - a.unrest)[0], bright = sts.slice().sort((a, b) => b.ind - a.ind)[0];
  const W = G.world || {}, foe = WORLD_POWERS.find(p => p.k === W.foe);
  const chap = Object.keys((G.rite && G.rite.chapels) || {}).filter(k => G.rite.chapels[k] > 0);
  const stories = P.stories.slice();
  const lead = P.head;
  const col = (t, body) => '<section class="np__col"><h3>' + t + '</h3>' + body + '</section>';
  const small = (arr) => '<ul class="np__small">' + arr.map(x => '<li><b>' + pcEsc(x[0]) + '.</b> ' + pcEsc(x[1]) + '</li>').join("") + '</ul>';
  const around = [];
  if(hot) around.push(hot.n + " is restless; unrest " + Math.round(hot.unrest) + " and the courthouses are watching the street.");
  if(bright) around.push(bright.n + " leads on industry, at " + Math.round(bright.ind) + ".");
  (G.states || []).filter(s => s.bill).slice(0, 3).forEach(s => around.push("In " + s.n + ", the statehouse has the " + s.bill.title + " before it."));
  const abroad = [];
  if(foe) abroad.push(cap(foe.t) + " is the Republic's chief rival this term; the temperature is " + Math.round(W.heat || 0) + ". " + (WORLD_WARS.find(w => w.k === W.war) ? cap(WORLD_WARS.find(w => w.k === W.war).t) + "." : ""));
  WORLD_POWERS.filter(p => !foe || p.k !== foe.k).slice(0, 2).forEach(p => { const rel = (G.realmRel || {})[p.k] || 0; abroad.push(cap(p.t) + " is " + realmRelLabel(rel) + " towards the Union, and still wants " + p.want + "."); });
  const pulpit = [];
  try{ const c = creedOfState(y && y.state ? y.state : (sts[0] || {}).n); pulpit.push("In " + ((y && y.state) || "the Union") + " the ground leans " + c.t + ": " + String(c.sincere ? c.holds : (c.jab || c.holds)).replace(/\.+$/, "") + "."); }catch(e){}
  pulpit.push(chap.length ? "The Consular Rite keeps chapels at " + chap.slice(0, 4).join(", ") + ". Its preachers say the form of the state follows the will of the chamber, and the chamber should remember who sent it." : "No Consular chapel is open yet; the kerk and the others preach on as they always have.");
  const letters = (townEnsure().letters || []).filter(l => D - l.d <= 4).slice(-3);
  const other = [
    ["The Harbour Independent", lead.length > 60 ? lead.slice(0, 57).replace(/\s+\S*$/, "") + "… and nobody asked the harbour" : lead],
    ["The Kerk & Chapel Review", pulpit.length ? "A sermon on duty, and a collection for the " + (hot ? hot.n : "county") + " poor" : "A quiet Sunday"],
    ["The Grain Exchange Sheet", "Bread at " + (W.bread || 1.2).toFixed(2) + (W.ration ? ", rationing in the northern towns" : ", no rationing yet")],
    ["The Salt Isles Post", foe ? "Fleet watches " + foe.t.replace(/^the /, "") + " " + drawn(["nervously", "with interest", "and says nothing"], r) : "Fishing grounds, as ever, in dispute"],
    ["The Vendor's Daily", drawn(["Lamp oil up a penny", "A dog has been elected to the school board in a small county", "The ferry is late again", "Rain expected at the Capitol, and also in the opinion pages"], r)]
  ];
  const party = ["FED", "COM"].map(pk => col(pcEsc(NP_PAPERS[pk].n) + ' <small>' + pcEsc(NP_PAPERS[pk].tag) + '</small>', '<p class="np__lede">' + pcEsc(npSpin(pk, lead, r)) + '</p>' + (stories[0] ? '<p>' + pcEsc(npSpin(pk, stories[0], r)) + '</p>' : '')));
  const faith = col(pcEsc(NP_PAPERS.faith.n) + ' <small>' + pcEsc(NP_PAPERS.faith.tag) + '</small>', pulpit.map(x => '<p>' + pcEsc(x) + '</p>').join(""));
  const ind = col("From the independents", (letters.length ? letters.map(l => '<p class="np__q">“' + pcEsc(l.t) + '” <small>— the ' + pcEsc(l.fam) + 's, ' + pcEsc(l.street) + '</small></p>').join("") : '<p class="np__q">“Nobody writes when it is quiet, and nobody writes when it is bad. It is neither this week.” <small>— a reader</small></p>') + '<p class="np__q">“' + pcEsc(drawn(["The bread price is the only poll I trust.", "I do not care which party, only that they come to our road.", "My pastor says wait. My landlord says pay. I will do the second.", "If the sums were honest, the speeches would be shorter."], r)) + '” <small>— on the omnibus, overheard</small></p>');
  return '<div class="np">' +
    '<div class="np__mast"><div class="np__rule"></div><h1>The Capitol Ledger</h1><div class="np__dateline"><span>' + dateString() + '</span><span>' + pcEsc((G.country && G.country.name) || "Nieuw Oranje 7") + '</span><span>five cents</span></div><div class="np__rule"></div></div>' +
    '<h2 class="np__lead">' + pcEsc(lead) + '</h2><p class="np__deck">' + pcEsc(P.wx) + '</p>' +
    '<div class="np__cols">' +
      col("The day", (stories.length ? stories.map(x => '<p>' + pcEsc(x) + '</p>').join("") : '<p>The galleries were thin and the clerks went home on time.</p>') + (P.rival ? '<p><strong>The feud:</strong> ' + pcEsc(P.rival) + '</p>' : '')) +
      col("Around the Union", small(around.map((x, i) => [["Unrest", "Industry", "Statehouse", "Statehouse", "Statehouse"][i] || "Notes", x]))) +
      col("Abroad", small(abroad.map((x, i) => [["Frontier", "Neighbours", "Neighbours"][i] || "Notes", x]))) +
    '</div>' +
    '<div class="np__band">The presses disagree</div><div class="np__cols">' + party.join("") + faith + '</div>' +
    '<div class="np__cols">' + ind + col("Small headlines, from other papers", small(other)) + col("From the desks", (function(){ let h = ""; [() => agLedgerHTML(), () => sbLedgerHTML(), () => riteLedgerHTML(), () => govLedgerHTML(), () => orgLedgerHTML()].forEach(f => { try{ h += f() || ""; }catch(e){} }); return h || '<p class="np__q">Nothing from the desks today.</p>'; })()) + '</div>' +
    '<div class="np__band">The numbers</div>' +
    (function(){ try{ return racePaperHTML(); }catch(e){ return ""; } })() +
    '<p class="np__foot">' + pcEsc(P.poll) + (P.letter ? ' Letters from home: ' + pcEsc(P.letter) : '') + '</p></div>';
}
function paperCard(){
  G.running = false;
  const P = paperBuild();
  G.paperRead = G.day;
  card.innerHTML = npHTML() +
    '<div class="card__actions"><button type="button" class="btn" id="lpClose">Fold it</button>' +
    '<button type="button" class="btn btn--ghost" id="lpRaces">Races</button>' +
    '<button type="button" class="btn btn--ghost" id="lpRival">Rivals</button><button type="button" class="btn btn--ghost" id="lpHome">Home</button></div>';
  veil.hidden = false;
  el("lpClose").addEventListener("click", () => walkNow());
  const lpR = el("lpRaces"); if(lpR) lpR.addEventListener("click", () => { try{ raceCard(); }catch(e){ note("The book of races did not open.", true); } });
  el("lpRival").addEventListener("click", () => rivalCard());
  el("lpHome").addEventListener("click", () => homeCard());
}
function homeCard(){
  G.running = false;
  const T = townEnsure(), w = wxToday();
  card.innerHTML = '<div class="eyebrow">Home · ' + (G.you.state || "") + ' ' + (G.you.dist || "") + '</div><h1>The households</h1>' +
    '<p class="dream">' + wxLine(w) + ' The ' + w.s + ' at home.</p>' +
    T.hh.map(h => '<div class="whip__row"><span class="whip__n">The ' + h.fam + 's, ' + h.street + '</span><span class="whip__w">' +
      (h.mood > 65 ? "warm" : h.mood < 35 ? "sore" : "watching") + ' · ' + h.need + (h.mem.length ? ' · they remember ' + h.mem[h.mem.length - 1].t : '') + '</span></div>').join("") +
    '<div class="card__actions"><button type="button" class="btn" id="hmClose">Close</button></div>';
  veil.hidden = false;
  el("hmClose").addEventListener("click", () => walkNow());
}

/* ── daily wiring ───────────────────────────────────────── */
let _lDay = -1, _lRoomKey = "";
function lMorning(){
  const w = wxToday();
  townEnsure();
  try{ lSpawnTown(); }catch(e){ if(window.console) console.warn("town", e); }
  try{ mStandFix(); }catch(e){}
  const y = G.you; if(!y) return;
  if(G._lEnergyDay !== G.day && (G.minute || 0) < 9 * 60){
    G._lEnergyDay = G.day;
    if(w.k === "heat") y.energy = clamp(y.energy - 6, 0, 100);
    else if(w.k === "storm") y.energy = clamp(y.energy - 3, 0, 100);
    else if(w.k === "clear" && w.s === "spring") y.energy = clamp(y.energy + 4, 0, 100);
    try{ feed(wxLine(w)); }catch(e){}
  }
  try{ raceDay(); }catch(e){}
}
function lTick(){
  if(!G.you || !G.running) return;
  if(_lDay !== G.day){ _lDay = G.day; lMorning(); }
  const w = wxToday();
  const key = G.room + "|" + G.day + "|" + w.k + "|" + w.cover + "|" + (_roomBuiltId === G.room && _roomFurnished ? 1 : 0);
  if(key !== _lRoomKey && _roomBuiltId === G.room){
    _lRoomKey = key;
    try{ lDressSeason(G.room); }catch(e){}
    try{ wxBuild(ROOMS[G.room]); }catch(e){}
  }
}
function lNight(news){
  G.nightNews = {day:G.day, items:news};
  try{ rivalTick(news); }catch(e){ if(window.console) console.warn("rivals", e); }
  try{ lTownNight(news); }catch(e){ if(window.console) console.warn("townNight", e); }
}
function lJobLine(){
  const here = hereNow();
  const v = (G.civ || []).find(c => c && c.visitor && c.hhDay === G.day && c.room === "office" && !c.hhHeard);
  if(v && (G.minute || 0) < 19 * 60) return G.room === "office" ? v.name + " from " + v.role.split("· ")[1] + " is waiting. Walk over. E." : v.name.split(" ")[0] + " from home is waiting in your office.";
  if(G.paperRead !== G.day && (G.minute || 0) < 11 * 60) return "The Ledger is out. Side table in your office, or Pause > Today's paper.";
  return null;
}
PROPS.office = PROPS.office || [];
PROPS.office.push({id:"ledger", label:"The morning Ledger", sub:"Folded on the side table, still warm from the van", x:1.55, z:4.85, r:1.25,
  acts:() => [{t:"Read today's Ledger", c:"10m", run(){ spend(10, -2); paperCard(); }},
              {t:"The horse race", c:"10m", run(){ spend(10, -1); try{ raceCard(); }catch(e){} }},
              {t:"Look at the letters from home", c:"5m", run(){ spend(5, 0); homeCard(); }}]});

/* ══════════════════════════════════════════════════════════
   20261011m · PLAYABILITY SWEEP
   People in the new rooms stand where a person would stand (never in
   a desk), visitors wait by the visitor chairs, the map lists rooms in
   walking order, and B folds the Ledger like any other card.
   ══════════════════════════════════════════════════════════ */
const M_STAND = {
  "senate:0":[-3.0, 2.6], "senate:1":[3.0, 2.8], "senate:2":[-4.6, 11.0],
  "court:0":[-4.9, 8.4], "court:1":[4.6, 7.6], "court:2":[-4.6, 3.6],
  "exec:0":[-3.2, 7.6], "exec:1":[3.4, 3.0],
  "govoffice:0":[3.0, 4.4], "govoffice:1":[-2.6, 6.2]
};
function mFaceCentre(c){
  const R = ROOMS[c.room]; if(!R || !c.kStand) return 0;
  return Math.atan2(0 - c.kStand[0], R.d * 0.5 - c.kStand[1]);
}
function mStandSpot(m){
  if(!m || m.kind !== "civ") return null;
  if(m.kslot && M_STAND[m.kslot] && m.chamber && m.room === m.chamber) return M_STAND[m.kslot];
  if(m.visitor && m.room === "office" && m.hhDay === G.day) return [2.7, 2.9];
  return null;
}
/* called at the end of placeInRoom: a person with a post stands at it */
function mPlaceStand(m){
  const ks = mStandSpot(m);
  if(ks){
    m.kStand = ks; m.backStand = true; m.sitting = false; m.wait = 999;
    m.x = ks[0]; m.z = ks[1]; m.seatFace = mFaceCentre(m);
  } else if(m && m.kStand){ m.kStand = null; m.backStand = false; m.wait = 1; }
}
function mStandFix(){
  (G.civ || []).forEach(c => {
    if(!c) return;
    if(c.kslot && M_STAND[c.kslot] && c.room === c.chamber) c.kStand = M_STAND[c.kslot];
    else if(c.visitor && c.room === "office" && c.hhDay === G.day) c.kStand = [2.7, 2.9];
    else if(c.kStand && !(c.kslot && c.room === c.chamber)){ c.kStand = null; c.backStand = false; return; }
    if(c.kStand){
      c.backStand = true; c.sitting = false; c.wait = 999;
      c.seatFace = mFaceCentre(c);
      if(c.room !== G.room || Math.hypot((c.x || 0) - c.kStand[0], (c.z || 0) - c.kStand[1]) > 0.6){
        c.x = c.tx = c.kStand[0]; c.z = c.tz = c.kStand[1];
      }
    }
  });
}

/* ── first-time hints: one line on the NOW bar, once per new system ── */
const M_HINTS = [
  ["chamber", () => (G.room === "senate" || G.room === "court" || G.room === "exec" || G.room === "govoffice"),
    () => ROOMS[G.room].t + ". The staff keep to their posts; walk up and press E. The big desk is where this office does its work."],
  ["visitor", () => G.room === "office" && (G.civ || []).some(c => c && c.visitor && c.hhDay === G.day && c.room === "office" && !c.hhHeard),
    () => "Constituents come to your office now. Hear them, take their case, ask after the family. They remember."],
  ["ledger", () => G.room === "office" && G.paperRead !== G.day && (G.minute || 0) < 11 * 60,
    () => "Every morning the Ledger prints what really happened yesterday. Side table, E, or Pause > Today's paper."],
  ["rival", () => !!(typeof rivalLive === "function" && rivalLive()),
    () => "Somebody at home wants your seat. Pause > Rivals shows the feud. It ends at the ballot, or in a diner booth."],
  ["weather", () => !!(G.wx && G.wx.day === G.day && /rain|storm|snow|heat|fog/.test(G.wx.k)),
    () => "Weather is real now. Storms and heat tire you, snow lies on Main Street, and a hard winter sours the town."]
];
let _mHint = null;
function mHintLine(){
  if(!G.you || !G.running) return null;
  const now = performance.now();
  if(_mHint && now < _mHint.until && _mHint.room === G.room) return _mHint.text;
  _mHint = null;
  if(!G.mHints) G.mHints = {};
  if((G.day || 1) < 1) return null;
  for(let i = 0; i < M_HINTS.length; i++){
    const h = M_HINTS[i];
    if(G.mHints[h[0]]) continue;
    let ok = false; try{ ok = h[1](); }catch(e){}
    if(!ok) continue;
    G.mHints[h[0]] = G.day || 1;
    _mHint = {text:h[2](), until:now + 14000, room:G.room};
    return _mHint.text;
  }
  return null;
}
/* the NOW bar speaks the controller's language when one is in hand */
function mPadWords(line){
  if(!line || !PAD_SEEN) return line;
  return line.replace(/\bpress E\b/g, "press A").replace(/\bE\.(?=\s|$)/g, "A.").replace(/, E,/g, ", A,");
}
function mPadPrompt(w){
  try{ return (w && PAD_SEEN) ? w.replace(/^Press E\b/, "Press A") : w; }catch(e){ return w; }
}

/* ══════════════════════════════════════════════════════════
   20261012a · THE TRANSCRIPT
   Every line spoken where you can hear it is written down with who
   said it and when. L on the keyboard, R3 (right stick click) on a pad,
   or the Log button. It does not stop the clock.
   ══════════════════════════════════════════════════════════ */
const TL = {open:false, max:500, lastKey:"", n:0};
function tlNow(){ try{ return "Day " + (G.day || 1) + " · " + hhmm(); }catch(e){ return "Day " + (G.day || 1); } }
function tlog(who, line, kind){
  try{
    if(!line) return;
    const text = String(line).replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
    if(!text || text.length < 2) return;
    const name = typeof who === "string" ? who : (who && who.name) || "";
    const key = name + "|" + text;
    if(key === TL.lastKey) return;
    TL.lastKey = key;
    if(!Array.isArray(G.tlog)) G.tlog = [];
    const row = {d:G.day || 1, at:(function(){ try{ return hhmm(); }catch(e){ return ""; } })(), who:name || "", t:text.slice(0, 400), k:kind || "talk"};
    G.tlog.push(row);
    if(G.tlog.length > onumLim(TL.max,"hist")) G.tlog.splice(0, G.tlog.length - onumLim(TL.max,"hist"));
    TL.n++;
    if(TL.open) tlAppend(row, true);
    else { const b = el("uiLogBtn"); if(b) b.classList.add("has-new"); }
  }catch(e){}
}
function tlRowHTML(r){
  const esc = s => String(s).replace(/&/g, "&"+"amp;").replace(/</g, "&"+"lt;");
  return '<div class="tl__row' + (r.who === "You" ? " is-you" : "") + (r.k === "proc" ? " is-proc" : "") + '">' +
    '<div class="tl__h"><b>' + esc(r.who || "In the room") + '</b><span>Day ' + r.d + (r.at ? " · " + esc(r.at) : "") + '</span></div>' +
    '<div class="tl__t">' + esc(r.t) + '</div></div>';
}
function tlAppend(r, stick){
  const box = el("tlList"); if(!box) return;
  const atEnd = box.scrollTop + box.clientHeight >= box.scrollHeight - 30;
  box.insertAdjacentHTML("beforeend", tlRowHTML(r));
  while(box.children.length > TL.max) box.removeChild(box.firstChild);
  if(stick && atEnd) box.scrollTop = box.scrollHeight;
}
function tlEnsureDOM(){
  if(el("tlPanel")) return;
  const st = document.createElement("style"); st.id = "tlStyle";
  st.textContent =
    "#tlPanel{position:fixed;right:14px;top:64px;bottom:64px;width:min(420px,46vw);z-index:60;display:flex;flex-direction:column;" +
    "background:rgba(20,18,15,.88);color:#efe7d6;border:1px solid rgba(176,139,69,.45);border-radius:10px;box-shadow:0 18px 48px rgba(0,0,0,.5);backdrop-filter:blur(4px);font:14px/1.4 inherit}" +
    "#tlPanel[hidden]{display:none}" +
    "#tlPanel .tl__top{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid rgba(176,139,69,.3);letter-spacing:.08em;text-transform:uppercase;font-size:12px}" +
    "#tlPanel .tl__top button{background:none;border:1px solid rgba(239,231,214,.35);color:#efe7d6;border-radius:6px;padding:3px 10px;cursor:pointer}" +
    "#tlList{flex:1;overflow-y:auto;padding:8px 14px 14px;overscroll-behavior:contain;cursor:grab;user-select:none}" +
    "#tlList.is-drag{cursor:grabbing}" +
    ".tl__row{padding:7px 0;border-bottom:1px solid rgba(239,231,214,.08)}" +
    ".tl__row.is-you .tl__h b{color:#e7c46e}.tl__row.is-proc .tl__h b{color:#9fc3e0}" +
    ".tl__h{display:flex;justify-content:space-between;gap:10px;font-size:12px;opacity:.85}.tl__h span{opacity:.7;white-space:nowrap}" +
    ".tl__t{margin-top:2px}" +
    ".tl__foot{padding:6px 14px;font-size:11px;opacity:.6;border-top:1px solid rgba(176,139,69,.2)}" +
    "#uiLogBtn.has-new::after{content:'';display:inline-block;width:6px;height:6px;border-radius:50%;background:#e7c46e;margin-left:6px;vertical-align:middle}";
  document.head.appendChild(st);
  const p = document.createElement("div"); p.id = "tlPanel"; p.hidden = true;
  p.setAttribute("role", "log"); p.setAttribute("aria-label", "Transcript");
  p.innerHTML = '<div class="tl__top"><span>Transcript</span><button type="button" id="tlClose">Close</button></div>' +
    '<div id="tlList" tabindex="0"></div><div class="tl__foot">Wheel, drag, arrow keys or the stick to scroll · L or R3 to close</div>';
  document.body.appendChild(p);
  el("tlClose").addEventListener("click", () => tlToggle(false));
  const box = el("tlList");
  let drag = null;
  box.addEventListener("pointerdown", e => { drag = {y:e.clientY, s:box.scrollTop}; box.classList.add("is-drag"); try{ box.setPointerCapture(e.pointerId); }catch(x){} });
  box.addEventListener("pointermove", e => { if(drag) box.scrollTop = drag.s - (e.clientY - drag.y); });
  const up = () => { drag = null; box.classList.remove("is-drag"); };
  box.addEventListener("pointerup", up); box.addEventListener("pointercancel", up);
  box.addEventListener("wheel", e => { e.stopPropagation(); }, {passive:true});
  /* the HUD button */
  const bar = el("uiToolbar");
  if(bar && !el("uiLogBtn")){
    const b = document.createElement("button"); b.type = "button"; b.id = "uiLogBtn"; b.title = "Transcript of what has been said (L). Pad: R3."; b.textContent = "Log";
    const map = el("uiMapBtn");
    if(map && map.nextSibling) bar.insertBefore(b, map.nextSibling); else bar.appendChild(b);
    b.addEventListener("click", () => tlToggle());
  }
}
function tlToggle(on){
  tlEnsureDOM();
  TL.open = on === undefined ? !TL.open : !!on;
  const p = el("tlPanel"); p.hidden = !TL.open;
  if(TL.open){
    const box = el("tlList");
    box.innerHTML = (G.tlog || []).map(tlRowHTML).join("") || '<div class="tl__row"><div class="tl__t">Nothing said yet that you could hear.</div></div>';
    box.scrollTop = box.scrollHeight;
    const b = el("uiLogBtn"); if(b) b.classList.remove("has-new");
  }
}
function tlScroll(px){ const box = el("tlList"); if(box) box.scrollTop += px; }
/* keyboard while it is open: arrows and page keys scroll it, Escape or L closes */
function tlKey(e){
  if(!TL.open) return false;
  const k = (e.key || "").toLowerCase();
  if(k === "arrowup"){ tlScroll(-60); e.preventDefault(); return true; }
  if(k === "arrowdown"){ tlScroll(60); e.preventDefault(); return true; }
  if(k === "pageup"){ tlScroll(-400); e.preventDefault(); return true; }
  if(k === "pagedown"){ tlScroll(400); e.preventDefault(); return true; }
  if(k === "home"){ tlScroll(-1e6); e.preventDefault(); return true; }
  if(k === "end"){ tlScroll(1e6); e.preventDefault(); return true; }
  if(k === "escape" || k === "l"){ tlToggle(false); e.preventDefault(); return true; }
  return false;
}
/* pad while it is open: either stick or the D-pad scrolls, B or R3 closes; you stand still */
let _tlPadHeld = {};
function tlPad(gp){
  const b = gp.buttons || [], ax = gp.axes || [];
  const down = i => !!(b[i] && b[i].pressed);
  const edge = i => { const d = down(i), was = !!_tlPadHeld[i]; _tlPadHeld[i] = d; return d && !was; };
  const r3 = edge(11);
  if(!TL.open){ if(r3 && veil.hidden){ tlToggle(true); return true; } return false; }
  if(r3 || edge(1)){ tlToggle(false); try{ PADHELD[1] = true; }catch(e){} return true; }
  const y = Math.abs(ax[3] || 0) > Math.abs(ax[1] || 0) ? (ax[3] || 0) : (ax[1] || 0);
  if(Math.abs(y) > 0.2) tlScroll(y * 14);
  if(down(12)) tlScroll(-10); if(down(13)) tlScroll(10);
  try{ PAD.vx = 0; PAD.vz = 0; PAD.turn = 0; }catch(e){}
  return true;
}
/* people talking where you can hear them */
function tlHeard(m){
  if(!m || !m.say || !(m.sayT > 0) || m._tlSaid === m.say) return;
  m._tlSaid = m.say;
  tlog(m.name || "", m.say, m.kind === "civ" ? "civ" : "talk");
}

/* ══════════════════════════════════════════════════════════
   20261012a · A CAPITAL THAT RUNS WITHOUT YOU
   Every member carries goals, allies, enemies and favors owed. Each
   game hour, off-screen and cheaply, some of them meet, trade,
   cosponsor, whip, file bills and campaign; rain keeps people in,
   bad news makes them talk. Their bills go through committee, the
   floor, the Senate, the Executive's desk and sometimes the Court on
   their own. Caucus posts are elected on schedule. Results land in
   the Ledger, the transcript and the laws register.
   ══════════════════════════════════════════════════════════ */
const AG_GOALS = ["pass a bill of their own", "win the caucus post", "protect the home district", "settle a score", "build a coalition", "raise money for the campaign"];
const AG_TOPICS = ["roads", "schools", "water", "the harbor", "pensions", "farm credit", "rail", "the courts", "border posts", "the militia", "tariffs", "clinics"];
const AG_POSTS = ["Majority Whip", "Caucus Chair", "Appropriations Vice-Chair", "Rules Vice-Chair"];
function agState(){
  if(!G.ag) G.ag = {hour:-1, day:0, bills:[], laws:[], posts:{}, n:{meet:0, deal:0, cos:0, whip:0, filed:0, passed:0, failed:0, vetoed:0, struck:0, camp:0, react:0, office:0}, seq:1};
  return G.ag;
}
function agLive(){ return (G.members || []).filter(m => m && !m.gone && m.kind === "member" && !m.machine && !(typeof isConsular === "function" && isConsular(m))); }
function agOf(m){
  if(!m.ag){
    const h = ((m.id || 0) * 2654435761) >>> 0;
    m.ag = {goal:AG_GOALS[h % AG_GOALS.length], topic:AG_TOPICS[(h >>> 5) % AG_TOPICS.length], allies:[], enemies:[], owes:{}, sched:(h >>> 9) % 3, drive:0.3 + ((h >>> 12) % 60) / 100};
  }
  return m.ag;
}
function agRel(a, b, d){
  const A = agOf(a);
  const rm = (L, id) => { const i = L.indexOf(id); if(i >= 0) L.splice(i, 1); };
  if(d > 0){ rm(A.enemies, b.id); if(A.allies.indexOf(b.id) < 0) A.allies.push(b.id); if(A.allies.length > 6) A.allies.shift(); }
  else { rm(A.allies, b.id); if(A.enemies.indexOf(b.id) < 0) A.enemies.push(b.id); if(A.enemies.length > 4) A.enemies.shift(); }
}
function agSay(who, line){ try{ if(G.room && line) tlog(who, line, "world"); }catch(e){} }
function agLedger(t){ try{ G._lNote = false; lLog(t, "world"); }catch(e){} }
function agFile(m){
  const S = agState(), A = agOf(m);
  const b = {id:S.seq++, t:(m.name ? surname(m.name) : "A") + " " + pick(["Act", "Bill", "Relief Act", "Reform Act"]) + " on " + A.topic,
    by:m.id, party:m.party, cos:[], stage:"committee", day:G.day, next:G.day + 2 + ((m.id || 0) % 3), sup:0};
  S.bills.push(b); S.n.filed++;
  agLedger((m.name || "A member") + " filed the " + b.t + ".");
  return b;
}
function agStageRoll(b, live){
  /* support: author's allies, cosponsors, same party, minus the author's enemies */
  const by = live.find(x => x.id === b.by);
  const al = by ? agOf(by).allies.length : 0, en = by ? agOf(by).enemies.length : 0;
  const same = live.filter(x => x.party === b.party).length / Math.max(1, live.length);
  return same * 0.7 + b.cos.length * 0.04 + al * 0.03 - en * 0.035 + b.sup * 0.02 + (Math.random() - 0.5) * 0.3;
}
function agAdvance(live){
  const S = agState();
  for(const b of S.bills){
    if(b.done || G.day < b.next) continue;
    const s = agStageRoll(b, live);
    const step = (ok, nxt, fail, note) => {
      if(ok){ b.stage = nxt; b.next = G.day + 1 + ((b.id) % 3); agLedger("The " + b.t + " " + note + "."); }
      else { b.done = true; b.fate = fail; S.n[fail === "vetoed" ? "vetoed" : fail === "struck" ? "struck" : "failed"]++; agLedger("The " + b.t + " " + (fail === "vetoed" ? "was vetoed by the Executive" : fail === "struck" ? "was struck down by the Court" : "died " + (b.stage === "committee" ? "in committee" : (b.stage === "house" ? "on the House floor" : "in the Senate"))) + "."); }
    };
    if(b.stage === "committee") step(s > 0.24, "house", "failed", "cleared committee");
    else if(b.stage === "house") step(s > 0.30, "senate", "failed", "passed the House");
    else if(b.stage === "senate") step(s > 0.28, "exec", "failed", "passed the Senate");
    else if(b.stage === "exec") step(Math.random() < 0.80, "law", "vetoed", "was signed into law");
    else if(b.stage === "law"){
      /* some laws get challenged; most survive */
      if(Math.random() < 0.12){ b.done = true; b.fate = "struck"; S.n.struck++; agLedger("The Court struck down the " + b.t + "."); }
      else { b.done = true; b.fate = "law"; S.n.passed++; S.laws.push({t:b.t, day:G.day, by:b.by}); if(S.laws.length > onumLim(120,"hist")) S.laws.shift(); agSay("The Clerk", "Entered in the register of laws: the " + b.t + "."); }
    }
  }
  if(S.bills.length > 160) S.bills = S.bills.filter(b => !b.done || G.day - b.day < 20);
}
function agHour(h){
  const S = agState(), live = agLive(); if(live.length < 6) return;
  let wxk = ""; try{ wxk = (wxToday() || {}).k || ""; }catch(e){}
  const rainy = /rain|storm|snow/.test(wxk);
  const busy = h >= 9 && h <= 18;
  const n = busy ? (rainy ? 2 : 4) : 1;
  for(let i = 0; i < n; i++){
    const a = live[(Math.random() * live.length) | 0], A = agOf(a);
    /* a meeting: someone they like, someone they need, or someone they are feuding with */
    let b = live[(Math.random() * live.length) | 0]; if(b === a) continue;
    if(A.allies.length && Math.random() < 0.4){ const x = live.find(m => m.id === A.allies[(Math.random() * A.allies.length) | 0]); if(x) b = x; }
    S.n.meet++;
    const warm = (a.party === b.party ? 0.25 : -0.05) + (A.allies.indexOf(b.id) >= 0 ? 0.3 : 0) - (A.enemies.indexOf(b.id) >= 0 ? 0.4 : 0) + (Math.random() - 0.5) * 0.6;
    if(warm > 0.15){
      agRel(a, b, 1); agRel(b, a, 1);
      const open = S.bills.find(x => !x.done && x.by === a.id && x.stage !== "law");
      if(open && open.cos.indexOf(b.id) < 0 && Math.random() < 0.6){ open.cos.push(b.id); S.n.cos++; if(Math.random() < 0.3) agLedger(b.name + " signed on to the " + open.t + "."); }
      else { S.n.deal++; A.owes[b.id] = (A.owes[b.id] || 0) + 1; if(Math.random() < 0.03) agLedger(a.name + " and " + b.name + " struck a deal over " + A.topic + "."); }
    } else if(warm < -0.25){ agRel(a, b, -1); agRel(b, a, -1); }
    /* whipping the bill on the floor */
    if(G.bill && !G.bill.done && Math.random() < 0.25 && !b.pledge && a.party === b.party){
      b.pledge = Math.random() < 0.7 ? 1 : -1; b.pledgeDay = G.day; S.n.whip++;
    }
    /* filing */
    if(A.goal === "pass a bill of their own" && Math.random() < 0.05 * A.drive && S.bills.filter(x => !x.done && x.by === a.id).length === 0) agFile(a);
    else if(Math.random() < 0.012) agFile(a);
    /* campaigning on a slow afternoon */
    if(!busy && A.goal === "raise money for the campaign" && Math.random() < 0.3){ S.n.camp++; a.ag.chest = (a.ag.chest || 0) + 1; }
  }
  /* reacting to the news of the day */
  try{
    const last = (G.daylog || [])[(G.daylog || []).length - 1];
    if(last && last.d === G.day && last.k !== "world" && S._react !== last.t && Math.random() < 0.5){
      S._react = last.t; S.n.react++;
      const m = live[(Math.random() * live.length) | 0];
      if(m && m.room === G.room && !m.sayT){ m.say = pick(["Did you see that? ", "Well, there it is. ", "I heard. "]) + (DTCNO.say(m, {intent:"react"}) || ""); m.sayT = 6; }
    }
  }catch(e){}
}
function agDay(){
  const S = agState(), live = agLive(); if(live.length < 6) return;
  agAdvance(live);
  /* caucus elections every ten days: allies vote for allies */
  if(G.day % 10 === 0){
    for(const post of AG_POSTS){
      const C = live.slice().sort(() => Math.random() - 0.5).slice(0, 4);
      const score = c => agOf(c).allies.length * 2 + (agOf(c).goal === "win the caucus post" ? 3 : 0) + (agOf(c).chest || 0) * 0.5 + Math.random() * 3;
      const w = C.sort((x, y) => score(y) - score(x))[0];
      const prev = S.posts[post];
      if(w && (!prev || prev.id !== w.id)){
        const inc = prev && live.find(m => m.id === prev.id);
        if(!inc || score(inc) < score(w)){
          S.posts[post] = {id:w.id, name:w.name, since:G.day}; S.n.office++;
          agLedger(w.name + " was elected " + post + (prev ? ", replacing " + prev.name : "") + ".");
        }
      }
    }
  }
}
function agTick(){
  const S = agState();
  if(!G.members || !G.you) return;
  const h = Math.floor((G.minute || 0) / 60);
  const key = (G.day || 1) * 24 + h;
  if(S.hour < 0){ S.hour = key; S.day = G.day; return; }
  if(G.day !== S.day){ const dd = Math.min(5, G.day - S.day); for(let i = 0; i < dd; i++) agDay(); S.day = G.day; }
  if(key === S.hour) return;
  const steps = Math.min(3, key - S.hour);
  S.hour = key;
  for(let i = 0; i < steps; i++) agHour(h);
}
function agLedgerHTML(){
  const S = agState();
  const posts = AG_POSTS.map(p => S.posts[p] ? '<div class="whip__row"><span class="whip__n">' + p + '</span><span class="whip__w">' + S.posts[p].name + ' since day ' + S.posts[p].since + '</span></div>' : '').join("");
  const moving = S.bills.filter(b => !b.done).slice(-6).map(b => '<div class="whip__row"><span class="whip__n">' + b.t + '</span><span class="whip__w">' + b.stage + ' · ' + b.cos.length + ' cosponsors</span></div>').join("");
  const laws = S.laws.slice(-5).reverse().map(l => '<div class="whip__row"><span class="whip__n">' + l.t + '</span><span class="whip__w">law, day ' + l.day + '</span></div>').join("");
  return '<h3>The capital, on its own</h3>' + (posts || '') + (moving ? '<p class="dream">Bills moving</p>' + moving : '') + (laws ? '<p class="dream">Laws entered</p>' + laws : '');
}

function refreshTravel(){
  refreshTravel._r = G.room;
  const box = el("travel"); box.innerHTML = "";
  const t = dayType();
  ROOM_ORDER.forEach(id => {
    const R = ROOMS[id];
    if(id === "office" && abroadOffice() && G.room !== "office") return;   /* the Cannon office is a member's, not yours */
    const b = document.createElement("button");
    b.type = "button";
    b.className = "travel__btn" + (id===G.room?" is-here":"");
    const n = everyone().filter(m => m.room===id && !m.gone).length;
    const mine = abroadOffice() && id === homeRoom();
    b.innerHTML = (mine ? "My Office · " + R.t.replace(/^The /, "") : R.t) + "<u>" + (id===G.room ? "here" : n + " here · " + R.travel + "m") + "</u>";
    const blocked = ((id==="district" || (id==="govoffice" && !kHolds("govoffice"))) && t==="session" && inHouse())
                 || (id!=="district" && id!=="office" && id!=="govoffice" && t==="recess")
                 || !outsideAllowed(id);
    b.disabled = id===G.room || blocked || !G.running;
    b.addEventListener("click", () => goTo(id));
    box.appendChild(b);
  });
  /* 20261013m: after five, the day can always end, from any room */
  if((G.minute || 0) >= 17 * 60 && G.you && !G.you.out_none){
    const endB = document.createElement("button");
    endB.type = "button"; endB.className = "travel__btn";
    endB.innerHTML = "Go home and sleep<u>the day is done</u>";
    endB.disabled = !G.running;
    endB.addEventListener("click", () => { try{ closeTalk(); }catch(e){} sleepToMorning(G.room === "office" ? "your office" : "home"); });
    box.appendChild(endB);
  }
  /* save, at any moment, from the menu */
  const sp = document.createElement("span");
  sp.style.cssText = "flex:1 1 auto";
  box.appendChild(sp);
  const sv = document.createElement("button");
  sv.type = "button";
  sv.className = "travel__btn";
  sv.innerHTML = "Save game<u id=\"saveNote\">" + (G.savedAt ? "saved " + G.savedAt : "keeps your place") + "</u>";
  sv.addEventListener("click", () => {
    const ok = save(true);
    G.savedAt = hhmm();
    const n = el("saveNote");
    if(n) n.textContent = ok ? "saved " + G.savedAt : "could not save here";
  });
  box.appendChild(sv);
  /* the office, in your pocket, wherever you happen to be standing */
  const ph = document.createElement("button");
  ph.type = "button"; ph.className = "travel__btn";
  ph.innerHTML = "Phone<u>vox, mail, the count</u>";
  ph.disabled = !G.running && !G.over;
  ph.addEventListener("click", phoneCard);
  box.appendChild(ph);
  const hbk = document.createElement("button");
  hbk.type = "button"; hbk.className = "travel__btn";
  hbk.innerHTML = "Handbook<u>how all of it works</u>";
  hbk.addEventListener("click", handbookCard);
  box.appendChild(hbk);
  const bare = document.createElement("button");
  bare.type = "button"; bare.className = "travel__btn";
  bare.innerHTML = (G.bare ? "Exit immersive (desk HUD)" : "Enter immersive") + "<u>Shift+H</u>";
  bare.addEventListener("click", () => setImmersive(!G.bare));
  const panBtn = document.createElement("button"); panBtn.type="button"; panBtn.className="btn";
  panBtn.innerHTML = (uiOpen() ? "Put panels away" : "Open house panels") + "<u>H · phone</u>";
  panBtn.addEventListener("click", () => immersion());
  if(bare && bare.parentNode) bare.parentNode.insertBefore(panBtn, bare.nextSibling);
  box.appendChild(bare);
  const st = document.createElement("button");
  st.type = "button"; st.className = "travel__btn";
  st.innerHTML = "Settings<u>keys and look</u>";
  st.addEventListener("click", settingsCard);
  box.appendChild(st);
  const cb = document.createElement("button");
  cb.type = "button"; cb.className = "travel__btn";
  cb.innerHTML = "Collab<u>" + (typeof TLSCollab !== "undefined" ? TLSCollab.summary().replace(/</g,"") : "two seats") + "</u>";
  cb.addEventListener("click", collabCard);
  box.appendChild(cb);
}
function callOn(m){
  if(!m || !G.running) return;
  closeTalk();
  spend(ROOMS.visit.travel, 3);
  feed("Walking to " + m.suite + ".");
  G.visitId = m.id;
  m.x = 0.2; m.z = 6.0; m.tx = m.x; m.tz = m.z; m.facing = Math.PI;
  m.room = "visit";
  enterRoom("visit", G.room);
  try{
    el("whereName").textContent = surname(m.name) + "'s office";
    el("whereTag").textContent = m.suite;
  }catch(e){}
  m.known = Math.max(m.known, 1);
  ripple(m, 3, "You came to my office rather than catching me in a corridor.", 3);
  note("Called on " + m.name + " at " + m.suite + ".");
}
function goTo(id){
  if(!ROOMS[id] || id === G.room) return;
  try{ leaveSittingQuiet(); }catch(e){}
  closeTalk();
  feed("Walking to " + ROOMS[id].t + ".");
  enterRoom(id, G.room);
}
function refreshFloor(){
  const b = G.bill, you = G.you;
  try{ officeTabLabel(); }catch(e){}
  if(you && abroadOffice()){ refreshOfficePane(); return; }
  if(!b){ el("paneFloor").innerHTML = '<p class="muted">The calendar is clear.</p>'; return; }
  const t = tallyBill(b, true);
  const axes = AXES.map(a =>
    '<div class="axis"><i>'+a.lo+' / '+a.hi+'</i><span><b style="left:'+((b.pos[a.k]+100)/200*100)+
    '%"></b><em style="left:'+((you.district[a.k]+100)/200*100)+'%"></em></span></div>').join("");
  const pledged = G.members.filter(m => m.pledge && G.day-m.pledgeDay<8);
  const com = committeeOf(you.committee);
  const canMark = !b.marked && Math.abs(b.pos[com.axis]) > 15 && you.influence >= 10;
  el("paneFloor").innerHTML =
    '<div class="billbox"><div class="eyebrow">On the calendar · ' + b.stakes + '</div>' +
      '<div class="h-serif"><span'+tipAttr("bill","now")+'>' + b.title + '</span></div>' +
      '<div class="muted">' + b.line + ' Sponsored by ' + youMark(b.sponsor) + '. ' +
        '<span'+tipAttr("bill","now")+'>Read it in full</span>.</div>' +
      '<div class="billbox__pos">' + axes + '</div>' +
      '<div class="muted" style="margin-top:7px">Dark tick: the bill. Green tick: what your district wants.</div>' +
    '</div>' +
    '<div class="eyebrow">Projected roll call</div>' +
    '<div class="count"><div class="c-aye"><i>Ayes</i><b>'+t.aye+'</b></div>' +
      '<div class="c-no"><i>Noes</i><b>'+t.no+'</b></div>' +
      '<div class="c-un"><i>Unknown</i><b>'+t.un+'</b></div></div>' +
    '<div class="countbar"><span style="width:'+(t.aye/G.seats*100)+'%;background:var(--good)"></span>' +
      '<span style="width:'+(t.no/G.seats*100)+'%;background:var(--bad)"></span>' +
      '<span style="width:'+(t.un/G.seats*100)+'%;background:var(--line)"></span></div>' +
    '<p class="muted" style="margin-top:10px">Roll call on <b>day ' + b.voteDay + '</b> at ' +
      (b.voteHour>12?b.voteHour-12:b.voteHour) + ':00 pm. Majority is <b>91</b>. ' +
      (G.day===b.voteDay ? '<strong>Be on the floor.</strong>' : '') + '</p>' +
    '<p class="muted">District reads it as <strong>' +
      (districtFit(b)>20?"a win":districtFit(b)<-20?"a problem":"noise") + '</strong>; you read it as <strong>' +
      (alignment(you,b)>20?"right":alignment(you,b)<-20?"wrong":"borderline") + '</strong>.</p>' +
    ((G.fads && G.fads.length)
      ? '<p class="muted">What they talk about when the whip is gone: <strong>' +
        G.fads.slice(0,4).map(f => f.t).join(", ") + '</strong>.</p>'
      : '') +
    (pledged.length ? '<p class="muted"><strong>Pledged:</strong> ' +
      listify(pledged.map(m=>surname(m.name)+" ("+(m.pledge>0?"aye":"no")+")")) + '.</p>' : '') +
    '<div class="conc" style="border-top:1px solid var(--line);margin-top:14px">' +
      '<div class="conc__row"><div class="eyebrow">Introduce a bill of your own</div>' +
        '<div class="conc__count">' + (you.influence >= 10 ? "10 influence · 150m" : "needs 10 influence") + '</div></div>' +
      '<p class="muted" style="margin:0 0 8px">It replaces what is on the calendar and it carries your name. ' +
        'Carry it and everything moves; lose it and so does your standing.</p>' +
      '<div class="conc__list">' +
        AXES.map(a =>
          '<div style="display:flex;gap:5px">' +
          '<button class="conc__btn" style="flex:1" type="button" data-bill="' + a.k + ':1"' +
            (you.influence < 10 || you.out ? ' disabled' : '') + '>Toward ' + a.hi +
            '<u>a bill pushing ' + a.n.toLowerCase() + ' hard to the ' + a.hi + '</u></button>' +
          '<button class="conc__btn" style="flex:1" type="button" data-bill="' + a.k + ':-1"' +
            (you.influence < 10 || you.out ? ' disabled' : '') + '>Toward ' + a.lo +
            '<u>a bill pushing ' + a.n.toLowerCase() + ' hard to the ' + a.lo + '</u></button></div>').join("") +
      '</div></div>' +
    '<div class="card__actions"><button class="btn btn--ghost" type="button" id="voteAye">My vote: aye</button>' +
      '<button class="btn btn--ghost" type="button" id="voteNo">My vote: no</button>' +
      '<button class="btn btn--ghost" type="button" id="voteClear">Clear it</button>' +
      (canMark ? '<button class="btn btn--ghost" type="button" id="markUp">Mark it up in ' + com.t + '</button>' : '') +
    '</div>' +
    '<p class="muted" style="margin-top:8px">Intention: <strong>' +
      (you.vote===1?"aye":you.vote===-1?"no":"not set") + '</strong>. This is what you tell them when they ask. Mood does not change it.' +
      (canMark ? ' · Marking up costs 60 minutes and 10 influence, moves the bill toward your district, and the leadership will notice.' : '') + '</p>';
  /* the chamber: only offered when you are actually on the floor */
  if(G.room === "floor"){
    const acts = floorActions();
    const box = document.createElement("div");
    box.className = "conc";
    box.style.borderTop = "1px solid var(--line)";
    box.innerHTML = '<div class="conc__row"><div class="eyebrow">On the floor</div>' +
      '<div class="conc__count">' + (inSession() ? "the House is sitting" : "not sitting") + '</div></div>' +
      '<div class="conc__list">' + acts.map((a,i) =>
        '<button class="conc__btn" type="button" data-fl="' + i + '"' + (a.off?' disabled':'') + '>' +
        a.t + '<u>' + (a.c || "") + '</u></button>').join("") + '</div>';
    const pf = el("paneFloor"); if(pf) pf.appendChild(box);
    box.querySelectorAll("[data-fl]").forEach(btn => btn.addEventListener("click", () => {
      const a = acts[+btn.getAttribute("data-fl")];
      if(!a || a.off) return;
      if(!TALK.open){ TALK.open = true; TALK.m = null; TALK.prop = null;
        el("talk").classList.add("is-open"); el("tkName").textContent = "The floor";
        el("tkMeta").innerHTML = '<span class="chip chip--ind">The House Floor</span>';
        el("tkMood").textContent = "—"; el("tkBars").innerHTML = "";
        el("tkThink").hidden = true; wireHome(); el("chat").hidden = true;
        el("tkActs").innerHTML = '<button class="talk__btn talk__btn--exit" type="button" id="flClose">Leave it</button>';
        el("flClose").addEventListener("click", closeTalk);
      }
      a.run();
      refreshPanels();
    }));
  }
  el("paneFloor").querySelectorAll("[data-bill]").forEach(btn => btn.addEventListener("click", () => {
    const [ax, d] = btn.getAttribute("data-bill").split(":");
    proposeBill(ax, +d);
  }));
  const a = el("voteAye"), n = el("voteNo"), vc = el("voteClear"), mk = el("markUp");
  if(vc) vc.addEventListener("click", () => { setMyVote(null); refreshPanels(); });
  if(a) a.addEventListener("click", () => {
    setMyVote(1);
    try{ taylorDayVoteDefiance(1); }catch(e){}
    refreshPanels();
    /* COLLAB HOOK: intention logged as soft signal until roll call */
    try{ if(typeof TLSCollab !== "undefined" && G.bill) TLSCollab.recordAction({kind:"intention", vote:1, billId:G.bill.id, title:G.bill.title, pos:G.bill.pos&&{econ:G.bill.pos.econ,lib:G.bill.pos.lib,def:G.bill.pos.def,wel:G.bill.pos.wel}}); }catch(e){}
  });
  if(n) n.addEventListener("click", () => {
    setMyVote(-1);
    try{ taylorDayVoteDefiance(-1); }catch(e){}
    refreshPanels();
    try{ if(typeof TLSCollab !== "undefined" && G.bill) TLSCollab.recordAction({kind:"intention", vote:-1, billId:G.bill.id, title:G.bill.title, pos:G.bill.pos&&{econ:G.bill.pos.econ,lib:G.bill.pos.lib,def:G.bill.pos.def,wel:G.bill.pos.wel}}); }catch(e){}
  });
  if(mk) mk.addEventListener("click", () => {
    b.marked = true; you.influence -= 10;
    const target = you.district[com.axis];
    b.pos[com.axis] = Math.round(lerp(b.pos[com.axis], target, 0.55));
    b.line = describeBill(b);
    you.standing = clamp(you.standing-4,0,100);
    spend(60, 14);
    note("Marked up " + b.title + " in " + com.t + ".", true);
    refreshPanels();
  });
}
function refreshMembers(){
  const rows = G.members.slice().sort((x,y)=>y.rel.warmth-x.rel.warmth).map(m => {
    const mood = moodOf(m), t = topMemory(m);
    const w = clamp((m.rel.warmth+100)/200*100,0,100);
    const pins = (m.post ? '<span class="pin pin--post">'+postTitle(m.post)+'</span>' : "") +
      (m.rel.debtFromYou ? '<span class="pin pin--debt">owes '+m.rel.debtFromYou+'</span>' : "");
    return '<div class="mrow" data-call="'+m.id+'"><div class="mrow__n"><span'+tipAttr("who",m.id)+'>'+m.name+'</span> '+chipFor(m)+pins+'</div>' +
      '<div class="mrow__r">'+roomLabel(m)+'<br><span style="color:var(--fed)">call on them →</span></div>' +
      '<div class="mrow__m">' + (t ? "“"+t.t+"”" : (m.met ? "Nothing between you yet." : "You have not spoken.")) +
      ' <span style="color:'+feelColor(mood.val)+'">— '+mood.label+'</span></div></div>';
  }).join("");
  el("paneMembers").innerHTML = '<div class="eyebrow">The chamber · ' + G.members.length + ' you know by name</div>' +
    '<p class="muted" style="margin:6px 0 10px">The line in quotes is what they would bring up first if you walked in right now. ' +
    'Everything you do to one of them reaches their friends. Click a row to call on them at their office.</p>' + rows;
  el("paneMembers").querySelectorAll("[data-call]").forEach(r =>
    r.addEventListener("click", () => callOn(byId(+r.getAttribute("data-call")))));
}
/* Eleven panels, ten of them behind a tab you cannot see. Rebuilding
   all of them on every action was most of the cost of doing anything —
   so a hidden panel is only marked stale, and built when you look at
   it. The bar and the floor are the exceptions: they are always live. */
const PANE_BUILD = {
  paneFloor:   () => refreshFloor(),
  paneMembers: () => refreshMembers(),
  paneInbox:   () => refreshInbox(),
  paneVox:     () => refreshVox(),
  paneUnion:   () => refreshUnion(),
  paneRisks:   () => refreshRisks(),
  paneJournal: () => refreshJournal(),
  paneCareer:  () => refreshCareer(),
  paneBook:    () => refreshBook()
};
const PANE_STALE = {};
function currentPane(){
  const p = document.querySelector(".pane.is-on");
  return p ? p.id : "paneFloor";
}
function buildPane(id){
  const f = PANE_BUILD[id];
  if(!f) return;
  PANE_STALE[id] = false;
  try{ f(); }catch(e){}
}
function showPane(id){
  document.querySelectorAll(".tabs button").forEach(b => b.classList.toggle("is-on", b.getAttribute("data-pane") === id));
  document.querySelectorAll(".pane").forEach(p => p.classList.toggle("is-on", p.id === id));
  if(PANE_STALE[id] !== false) buildPane(id);
}
/* 20261110bs: inbox/journal/career/statute panes render the newest 120, with Show more for the rest. */
const PANE_PAGE = 120, PANE_N = {};
function paneWindow(key, arr, newestFirst){
  arr = arr || [];
  const n = arr.length, shown = Math.min(PANE_N[key] || PANE_PAGE, n);
  return { view: newestFirst ? arr.slice(0, shown) : arr.slice(n - shown),
           more: n > shown ? '<div class="muted" data-pane-more="' + key + '" style="margin:8px 0;cursor:pointer">Show more (' + (n - shown) + ' older)</div>' : "" };
}
function paneMoreClick(root, key, refresh){
  const node = typeof root === "string" ? el(root) : root;
  const b = node && node.querySelector && node.querySelector('[data-pane-more="' + key + '"]');
  if(b) b.addEventListener("click", ev => { ev.preventDefault(); ev.stopPropagation(); PANE_N[key] = (PANE_N[key] || PANE_PAGE) + PANE_PAGE; refresh(); });
}
function refreshInbox(){
  const n = unreadCount();
  const tab = el("tabInbox");
  tab.innerHTML = "Inbox" + (n ? '<span class="badge">' + n + '</span>' : "");
  if(!G.mail.length){
    el("paneInbox").innerHTML = '<div class="eyebrow">Inbox</div>' +
      '<p class="muted" style="margin-top:8px">Nothing yet. People write once they know who you are.</p>';
    return;
  }
  const _pw = paneWindow("inbox", G.mail, 1);
  el("paneInbox").innerHTML = '<div class="eyebrow">Inbox · ' + n + ' unread</div>' +
    '<p class="muted" style="margin:6px 0 10px">Answers here count exactly as much as answers in the corridor.</p>' +
    _pw.view.map(x =>
      '<div class="mailrow' + (x.read||x.outgoing ? "" : " is-unread") + '" data-mail="' + x.id + '">' +
        '<div class="mailrow__h"><span class="mailrow__f">' +
          (x.read||x.outgoing ? "" : '<span class="dotmark"></span>') +
          (x.outgoing ? "→ " : "") + x.from + '</span>' +
          '<span class="mailrow__d">d' + x.day + ' · ' + x.at + '</span></div>' +
        '<div class="mailrow__s">' + x.subject + '</div>' +
        (x.open ? '<div class="mailrow__b">' + x.body + '</div>' +
          (x.options && !x.answered ? '<div class="mailrow__acts">' +
            x.options.map((o,i) => '<button class="conc__btn" style="width:auto" data-ans="' + x.id + ':' + i + '">' + o.t + '</button>').join("") +
            '</div>' : x.answered ? '<div class="mailrow__acts"><span class="muted">Answered.</span></div>' : "")
        : "") +
      '</div>').join("") + _pw.more;
  paneMoreClick("paneInbox", "inbox", refreshInbox);
  el("paneInbox").querySelectorAll("[data-mail]").forEach(r => r.addEventListener("click", e => {
    if(e.target.hasAttribute("data-ans")) return;
    const m = G.mail.find(x => x.id === +r.getAttribute("data-mail"));
    if(!m) return;
    m.open = !m.open; m.read = true;
    refreshInbox();
  }));
  el("paneInbox").querySelectorAll("[data-ans]").forEach(b => b.addEventListener("click", e => {
    e.stopPropagation();
    const [mid, oi] = b.getAttribute("data-ans").split(":");
    const mail = G.mail.find(x => x.id === +mid);
    if(!mail || mail.answered) return;
    mail.answered = true; mail.read = true;
    spend(12, 3);
    const opt = mail.options[+oi];
    if(opt && opt.run) opt.run();
    note("Answered " + mail.from + ": “" + opt.t + "”.");
    refreshPanels();
  }));
}
function refreshRisks(){
  const you = G.you;
  const secrets = G.secrets.map(s => {
    const pc = clamp(s.exposure/24*100, 0, 100);
    return '<div class="risk"><div class="risk__t">' + s.t + '</div>' +
      '<div class="risk__b"><b style="width:'+pc+'%"></b></div>' +
      '<div class="risk__m">' + Math.round(pc) + '% out · ' + s.knownBy.length + ' ' +
      (s.knownBy.length===1?'person knows':'people know') + ' · since day ' + s.day + '</div></div>';
  }).join("");
  const donors = G.donors.slice(-6).reverse().map(d => {
    const ax = AXES.find(a=>a.k===d.axis);
    return '<div class="dn"><span>' + d.name + (d.angry?' <span class="pin">unhappy</span>':'') + '</span>' +
      '<b>' + d.given + '</b><span class="s">wants ' + (d.want>0?ax.hi:ax.lo) + ' on ' + ax.n.toLowerCase() + '</span></div>';
  }).join("");
  const cases = G.casework.map(c2 =>
    '<div class="dn"><span>' + c2.cause + '</span><b>day ' + c2.due + '</b><span class="s">filed for ' + c2.who + '</span></div>').join("");
  el("paneRisks").innerHTML =
    '<div class="eyebrow">What could come out</div>' +
    '<p class="muted" style="margin:6px 0 12px">Every private thing you do is known by somebody. Indiscreet people ' +
      'tell their friends; people who dislike you tell everybody. When a secret reaches the top of the bar it runs.</p>' +
    (secrets || '<p class="muted">Nothing outstanding. That is worth something.</p>') +
    '<div class="eyebrow" style="margin-top:18px">Party standing</div>' +
    '<p class="muted" style="margin:6px 0 12px">At <strong>' + Math.round(you.standing) + '%</strong>. ' +
      (you.standing < 28 ? 'Low enough that the party will find someone to primary you.'
       : you.standing > 70 ? 'High enough for a gavel — and high enough that your district notices you voting with them.'
       : 'Middling. Enough to be left alone.') + '</p>' +
    '<div class="eyebrow" style="margin-top:18px">Money and what it expects</div>' +
    (donors || '<p class="muted">Nobody has given you anything, which is its own problem.</p>') +
    (cases ? '<div class="eyebrow" style="margin-top:18px">Casework outstanding</div>' + cases : '');
}
/* ── 20261013s · how each state is governed, who leads it, and who you know there ── */
const GOV_STYLE = {
  "consensus":{t:"Consensus government", short:"consensus", d:"Ruled by bargaining among the leading parties and families. Slow and steady, and hard to hurry."},
  "boss rule":{t:"Boss rule", short:"boss rule", d:"One boss and a machine control the jobs, contracts and votes. Loyalty is the currency."},
  "reformist":{t:"Reform government", short:"reform", d:"A coalition committed to changing how the state is run. Ambitious, and often at odds with old interests."},
  "pious":{t:"Clerical government", short:"clerical", d:"The churches have a strong say in law and schooling. Moral questions come before budgets."},
  "technocratic":{t:"Technocratic government", short:"technocrat", d:"Run by engineers, economists and officials who answer to figures more than to crowds."},
  "populist":{t:"Populist government", short:"populist", d:"Governs in the name of the people against the capital and the old elites. Loud, popular and volatile."},
  "old-family":{t:"Old-family rule", short:"old family", d:"A few long-established families hold the offices in turn. Stable for those inside the circle."}
};
function stateGovInfo(n){
  let r = null; try{ r = scEnsure().st[n]; }catch(e){}
  const g = (r && GOV_STYLE[r.style]) || {t:"Elected government", short:"elected", d:"The state is run by its elected governor and legislature."};
  return {rec:r, g};
}
function stateGovHTML(n){
  try{
    const {rec, g} = stateGovInfo(n);
    const mine = !!((rec && rec.youGov) || (G.you && heldOffice() === "gov" && n === G.you.state));
    let pol = null; try{ pol = (scEnsure().polities || []).find(p => (p.memberStates || []).indexOf(n) >= 0) || null; }catch(e){}
    const reps = (G.members || []).filter(m => m && !m.gone && m.state === n);
    const kn = reps.filter(m => (m.known || 0) >= 1 || m.met);
    let oh = []; try{ oh = (OH.list || []).filter(o => o && o.ohK === "sen:" + n); }catch(e){}
    const seatsN = ((G.states || []).find(x => x.n === n) || {}).seats || 0;
    const land = (G.civ || []).filter(c => c && !c.gone && c.state === n && !c.formerOf && c.name).sort((a, b) => (b.met ? 1 : 0) - (a.met ? 1 : 0));
    const knownLand = land.filter(c => c.met);
    const line = (k, v) => '<p class="muted" style="margin:4px 0"><strong>' + k + '</strong> ' + v + '</p>';
    return '<div style="border-top:1px solid var(--line-soft);margin-top:10px;padding-top:10px"><div class="eyebrow">How ' + pcEsc(n) + ' is governed</div>' +
      line(pcEsc(g.t) + '.', pcEsc(g.d)) +
      (pol ? line("Breakaway movement.", pcEsc(pol.name) + " (" + pcEsc(pol.govType || "movement") + ", " + pcEsc(pol.status) + ")") : '') +
      line("Leader.", rec ? (mine ? "You, as Governor." : "Governor " + pcEsc(rec.gov || "unnamed") + ".") : "Not yet known.") +
      line("Officials.", (oh.length ? listify(oh.map(o => pcEsc(o.name) + " (" + pcEsc(o.role || "official") + ")")) + ". " : "") +
        (reps.length ? "In the House: " + listify(reps.slice(0, 6).map(m => pcEsc(m.name) + " (" + m.party + ")")) + (reps.length > 6 ? ", and " + (reps.length - 6) + " more" : "") + "." : "None of its " + seatsN + " House seats are held by people you deal with yet.")) +
      line("People of the land.", knownLand.length ? "You know " + listify(knownLand.slice(0, 6).map(c => pcEsc(c.name) + (c.role ? " (" + pcEsc(c.role) + ")" : ""))) + "." : (land.length ? "You do not know anyone from here yet. " + land.length + " live here and can be met." : "Nobody from here is known to you yet.")) +
      '</div>';
  }catch(e){ return ""; }
}
function refreshUnion(){
  const sel = G.mapSel || G.you.state;
  const s = stateOf(sel);
  const act = G.prog.active;
  const actDef = act ? PROGRAMMES.find(p => p.k === act.k) : null;
  const progs = PROGRAMMES.map(p => {
    const done = G.prog.doneList.indexOf(p.k) >= 0;
    const locked = p.needs && G.prog.doneList.indexOf(p.needs) < 0;
    const running = act && act.k === p.k;
    const can = !done && !locked && !act && G.you.influence >= p.cost;
    return '<button class="conc__btn' + (done ? " is-done" : "") + '" type="button" data-prog="' + p.k + '"' +
      (can ? "" : " disabled") + '>' + (done ? "✓ " : "") + p.t +
      '<u>' + (done ? "in force" : running ? "in progress — day " + act.until
              : locked ? "needs " + PROGRAMMES.find(x=>x.k===p.needs).t
              : p.d + " · " + p.days + " days · " + p.cost + " influence") + '</u></button>';
  }).join("");
  const del = s ? stateDelegation(s.n) : [];
  el("paneUnion").innerHTML =
    '<div class="eyebrow" style="padding-top:40px">The Union · ' + G.states.length + ' states · ' + G.seats + ' seats</div>' +
    '<p class="muted" style="margin:6px 0 10px">' + (MAP.mode === "race"
      ? "Colour is who leads for governor, or the lean where that race is not in the book yet. "
      : MAP.mode === "lean"
      ? "Colour is the state's lean; the dot is unrest; the small word is how it is governed. "
      : "Colour follows the shade under the map. ") +
      'Click a state to read it.</p>' +
    renderMap(sel) +
    (s ? '<div class="billbox" style="margin-top:14px">' +
      '<div class="h-serif" style="margin-bottom:2px">' + s.n + '</div>' +
      '<div class="muted">' + s.note + '</div>' +
      '<div class="count" style="margin:12px 0 6px">' +
        '<div><i>Seats</i><b>' + s.seats + '</b></div>' +
        '<div><i>Industry</i><b>' + Math.round(s.ind) + '</b></div>' +
        '<div class="' + (s.unrest > 55 ? "c-no" : "c-aye") + '"><i>Unrest</i><b>' + Math.round(s.unrest) + '</b></div>' +
      '</div>' +
      '<p class="muted">Population ' + s.pop.toFixed(1) + 'm · leans <strong>' +
        (s.lean > 8 ? "Federalist" : s.lean < -8 ? "Commonwealth" : "neither way") + '</strong> by ' +
        Math.abs(s.lean) + '.</p>' +
      stateGovHTML(s.n) +
      (del.length ? '<p class="muted"><strong>Delegation you know:</strong> ' +
        listify(del.map(m => m.name + " (" + m.party + ")")) + '.</p>'
        : '<p class="muted">You know nobody from this delegation.</p>') +
      (s.n === G.you.state ? '<p class="muted"><strong>This is your state.</strong> Its unrest is your problem first.</p>' : '') +
      (function(){ try{ const c = creedOfState(s.n); return '<p class="muted">The ground leans <strong>' + c.t + '</strong> — ' + (c.sincere ? c.holds : (c.jab || c.holds)) + '.</p>'; }catch(e){ return ''; } })() +
      (s.bill
        ? '<div style="border-top:1px solid var(--line-soft);margin-top:10px;padding-top:10px">' +
          '<div class="eyebrow">In the statehouse</div>' +
          '<div class="h-serif" style="font-size:17px;margin:4px 0 2px">' + s.bill.title + '</div>' +
          '<p class="muted">A vote in ' + Math.max(0, s.bill.due - G.day) + ' days. ' +
            'It would move the state ' + (s.bill.dir>0 ? "toward " + AXES.find(a=>a.k===s.bill.axis).hi
                                                      : "toward " + AXES.find(a=>a.k===s.bill.axis).lo) + '.' +
            (s.bill.pushed ? ' You have leaned on them ' + (s.bill.pushed>0?"for":"against") + ' it.' : '') + '</p>' +
          '<div style="display:flex;gap:5px;margin-top:6px">' +
            '<button class="conc__btn" style="flex:1" type="button" data-sb="' + s.n + ':1"' +
              (G.you.influence < 6 ? ' disabled' : '') + '>Push it through<u>6 influence · 60m</u></button>' +
            '<button class="conc__btn" style="flex:1" type="button" data-sb="' + s.n + ':-1"' +
              (G.you.influence < 6 ? ' disabled' : '') + '>Help kill it<u>6 influence · 60m</u></button>' +
          '</div></div>'
        : '<p class="muted" style="margin-top:8px">Nothing before the statehouse this week.</p>') +
    '</div>' : '') +
    '<div class="conc"><div class="conc__row"><div class="eyebrow">National programmes</div>' +
      '<div class="conc__count">' + (actDef ? "in progress" : G.prog.doneList.length + " in force") + '</div></div>' +
      (actDef ? '<p class="muted" style="margin-bottom:9px"><strong>' + actDef.t + '</strong> — ' +
        Math.max(0, act.until - G.day) + ' days to run. Nothing else can be started until it lands.</p>' : '') +
      '<div class="conc__list">' + progs + '</div></div>';
  el("paneUnion").querySelectorAll("[data-st]").forEach(g =>
    g.addEventListener("click", () => { G.mapSel = g.getAttribute("data-st"); refreshUnion(); }));
  el("paneUnion").querySelectorAll("[data-sb]").forEach(b =>
    b.addEventListener("click", () => { const p=b.getAttribute("data-sb").split(":"); pushStateBill(stateOf(p[0]), +p[1]); }));
  el("paneUnion").querySelectorAll("[data-prog]").forEach(b =>
    b.addEventListener("click", () => startProgramme(b.getAttribute("data-prog"))));
}
function refreshJournal(){
  const _pw = paneWindow("journal", G.journal, 1);
  el("paneJournal").innerHTML = '<div class="eyebrow">My journal</div>' +
    (G.journal.length ? _pw.view.map(e =>
      '<div class="entry'+(e.big?" is-big":"")+'"><div class="entry__d">Day '+e.d+'</div>' +
      '<div class="entry__t">'+e.t+'</div></div>').join("") + _pw.more : '<p class="muted">Nothing written down yet.</p>');
  paneMoreClick("paneJournal", "journal", refreshJournal);
}
/* 20261013q · who holds what, so the offices are never a guess */
function powerMapHTML(){
  try{
    const y = G.you, f = (G.regime && G.regime.form) || "republic";
    const R = (typeof REGIMES !== "undefined" && REGIMES[f]) || {t:f};
    const x = G.exec, spk = (G.members || []).find(m => m && !m.gone && m.post === "speaker");
    const maj = majorityParty();
    const row = (k, v) => '<div class="whip__row"><span class="whip__n">' + pcEsc(k) + '</span><span class="whip__w">' + v + '</span></div>';
    const you = inHouse() ? "Representative for " + y.state + " " + y.dist : officeTitle() + ", " + officeSeat();
    const exec = x ? pcEsc(x.name) + " (" + pcEsc(partyName(x.party)) + "), " + pcEsc(execTitle()) + (x.you ? " — that is you" : "") : "none";
    let bloc = ""; try{ bloc = govBloc(); }catch(e){}
    const own = y.party === "OWN" ? "A party of your own. It is separate from the two large blocs, so having it does not make you head of the nation." : "";
    return '<div class="eyebrow" style="margin-top:12px">Who holds power</div>' +
      row("You", pcEsc(you)) +
      row("Your party", pcEsc(partyName(y.party)) + (own ? '<br><span class="muted">' + pcEsc(own) + '</span>' : "")) +
      row("The nation's executive", exec) +
      row("The form of the state", pcEsc(R.t || f) + (G.country ? " — " + pcEsc(G.country.name) : "")) +
      (bloc ? row("Ruling bloc", bloc) : "") +
      row("The House", pcEsc(partyName(maj)) + " holds the majority" + (spk ? "; the Speaker is " + pcEsc(spk.name) : "")) +
      '<p class="muted" style="margin-top:8px">A governor runs one state: its budget, its laws, its statehouse. The nation has its own executive, elected separately, and the House and Senate write the national laws. A party is not an office: a party can be large, or be yours, without you leading the country. People call you by the office you hold, which here is <b>' + pcEsc(youAddress()) + '</b>.</p>';
  }catch(e){ return ""; }
}
function refreshCareer(){
  const you = G.you;
  const _pw = paneWindow("career", G.career, 0);
  const rows = _pw.more + _pw.view.map(c2 => '<div class="careerline"><b>Term '+c2.term+'</b><span>'+c2.post+' — '+c2.note+'</span></div>').join("");
  const votes = you.record.votes.slice(-6).reverse().map(v =>
    '<div class="careerline"><b>' + (v.vote>0?"AYE":"NO") + '</b><span>' + v.title +
    ' <span class="muted">— day ' + v.day + ', ' + (v.passed?"passed":"failed") + '</span></span></div>').join("");
  el("paneCareer").innerHTML =
    '<div class="eyebrow">Service record</div><div class="h-serif">' + you.name + '</div>' +
    '<p class="muted">' + (inHouse() ? (you.post?postTitle(you.post):"Member of the House") + " for " + you.state + " " + you.dist : officeTitle() + " · " + officeSeat()) +
      " · " + partyName(you.party) + (inHouse() ? " · " + committeeOf(you.committee).t : "") + '</p>' + powerMapHTML() +
    '<div class="card__actions" style="margin:10px 0 14px">' +
      '<button class="btn btn--ghost" type="button" id="saveExport">Export career save</button>' +
      '<button class="btn btn--ghost" type="button" id="saveImport">Import career save</button></div>' +
    '<div class="careerline"><b>Terms</b><span>'+you.terms+'</span></div>' +
    (inHouse() || you.out ?
      '<div class="careerline"><b>Roll calls</b><span>'+you.record.votes.length+' cast, '+you.record.bills+' on the winning side</span></div>' +
      '<div class="careerline"><b>Party</b><span>'+you.record.partyBreaks+' votes against the line</span></div>' +
      '<div class="careerline"><b>Conscience</b><span>'+you.record.conscience+' votes against your own position</span></div>'
    : '<div class="careerline"><b>Office</b><span>' + pcEsc(officeTitle()) + ', ' + pcEsc(officeSeat()) + '</span></div>' +
      '<div class="careerline"><b>House record</b><span>' + (you.record.votes.length) + ' roll calls cast before you left it</span></div>') +
    '<div class="careerline"><b>Elections</b><span>'+you.record.won+' won, '+you.record.lost+' lost</span></div>' +
    (rows ? '<h2 class="h-serif" style="font-size:17px;margin-top:16px">Offices held</h2>' + rows : '') +
    (votes ? '<h2 class="h-serif" style="font-size:17px;margin-top:16px">Recent votes</h2>' + votes : '') +
    (function(){
      const ob = officeBoard();
      if(ob){
        const rk = ob.rows.findIndex(r => r.you) + 1;
        return '<h2 class="h-serif" style="font-size:17px;margin-top:18px">' + pcEsc(ob.title) + '</h2>' +
          '<p class="muted" style="margin:0 0 8px">You are <strong>' + rk + '</strong> of ' + ob.rows.length + '. ' + pcEsc(ob.blurb) + '</p>' +
          ob.rows.slice(0, 10).map((r, i) => '<div class="careerline"' + (r.you ? ' style="background:var(--surface)"' : '') + '><b>' + (i + 1) + '</b><span>' + pcEsc(r.name) +
            ' <span class="chip chip--' + (r.party === "FED" ? "fed" : r.party === "COM" ? "com" : "ind") + '">' + pcEsc(r.party || "") + '</span> <span class="muted">— ' + pcEsc(r.post) + '</span>' +
            (r.you ? ' <strong>— you</strong>' : '') + '<br><span class="muted" style="font-size:12px">' + pcEsc(r.note) + '</span></span></div>').join("") +
          (rk > 10 ? '<div class="careerline"><b>' + rk + '</b><span><strong>' + pcEsc(G.you.name) + ' — you</strong></span></div>' : '');
      }
      const board = leaderboard();
      const rank = board.findIndex(r => r.you) + 1;
      return '<h2 class="h-serif" style="font-size:17px;margin-top:18px">Standing in the building</h2>' +
        '<p class="muted" style="margin:0 0 8px">You are <strong>' + rank + '</strong> of ' + board.length +
        '. Influence, money, margin, seniority and whatever gavel you hold.</p>' +
        board.slice(0,10).map((r,i) =>
          '<div class="careerline"' + (r.you ? ' style="background:var(--surface)"' : '') + '><b>' + (i+1) + '</b>' +
          '<span>' + r.name + ' <span class="chip chip--' +
          (r.party==="FED"?"fed":r.party==="COM"?"com":"ind") + '">' + r.party + '</span>' +
          (r.post ? ' <span class="muted">— ' + r.post + '</span>' : '') +
          (r.you ? ' <strong>— you</strong>' : '') + '</span></div>').join("") +
        (rank > 10 ? '<div class="careerline"><b>' + rank + '</b><span><strong>' + G.you.name + ' — you</strong></span></div>' : '');
    })() +
    (function(){
      const R = REGIMES[(G.regime||{form:"republic"}).form];
      const c = chamberMood();
      const amend = amendmentsOpen();
      return '<h2 class="h-serif" style="font-size:17px;margin-top:18px">The state of the Union</h2>' +
        '<p class="muted" style="margin:0 0 8px"><strong>' + R.t + '</strong> since the ' +
          (G.regime?G.regime.since:G.congress) + 'th. ' + R.d + '</p>' +
        '<div class="careerline"><b>Chamber</b><span>' +
          AXES.map(a => a.n.split(" / ")[c[a.k]>0?1:0].toLowerCase() + " " + Math.abs(c[a.k])).join(" · ") +
          '</span></div>' +
        '<div class="careerline"><b>Largest</b><span>' + Math.round(c.dom*100) + '% of the named chamber</span></div>' +
        '<div class="careerline"><b>Powers</b><span>' + powerPrecedents() +
          ' precedents that concentrate authority</span></div>' +
        '<div class="careerline"><b>' + execTitle() + '</b><span>' +
          (G.exec ? G.exec.name + (G.exec.you ? " — you" : "") + " (" + partyLabel(G.exec.party) + "), " +
            G.exec.vetoes + " vetoes" : "vacant") + '</span></div>' +
        '<div class="careerline"><b>Court</b><span>' + (G.court?G.court.length:0) +
          ' justices' + (G.electedCourt ? ", elected" : ", appointed") + '</span></div>' +
        '<h2 class="h-serif" style="font-size:17px;margin-top:16px">Amendments</h2>' +
        '<p class="muted" style="margin:0 0 8px">Two thirds of the House. What passes here changes what the ' +
          'Union is — and the chamber votes its own politics, not yours.</p>' +
        amend.map(a => '<button class="conc__btn" type="button" data-am="' + a.k + '"' +
          (G.you.influence < a.cost || G.you.out ? ' disabled' : '') + '>' + a.t +
          '<u>' + a.d + ' · ' + a.cost + ' influence' + (a.power ? ' · concentrates power' : '') +
          '</u></button>').join("") +
        ((G.amended||[]).length ? '<p class="muted" style="margin-top:8px"><strong>In force:</strong> ' +
          listify((G.amended||[]).map(k => (AMENDMENTS.find(x=>x.k===k)||{t:k}).t)) + '.</p>' : '') +
        '<button class="conc__btn" type="button" id="btnGreatness"' +
          (G.you.out || G.you.influence < 8 ? ' disabled' : '') + '>Nominate to The Greatest' +
          '<u>Floor motion · 8 infl · two thirds · ranks 2+ only · never above Taylor</u></button>' +
        ((G.greatnessOpen || (G.amended||[]).indexOf("lore") >= 0)
          ? '<p class="muted" style="margin-top:6px">Lore amendment in force — secondary myth may be written below the First Consul.</p>'
          : '<p class="muted" style="margin-top:6px">Pass the lore amendment to rewrite civic myth notes; floor motions may still name ranks 2+.</p>') +
        (G.blasphemy ? '<p class="muted" style="margin-top:8px;color:#9B1B2E"><strong>Blasphemy recorded</strong> (day ' +
          G.blasphemy.day + '): “' + String(G.blasphemy.text||"").replace(/[<>]/g,"") + '”</p>' : '');
    })() +
    '<h2 class="h-serif" style="font-size:17px;margin-top:18px">The guilder</h2>' +
    '<p class="muted" style="margin:0 0 8px">100 stuivers to the ' + CURRENCY.name + ', 1,000 ' +
      CURRENCY.plural + ' to the mille. A guilder is a day\'s wage for a machinist in Coalport. ' +
      'The index opened at 100 the day you were sworn in and stands at <strong>' +
      guilderIndex().toFixed(1) + '</strong>.</p>' +
    '<div class="careerline"><b>Index</b><span>' + guilderIndex().toFixed(1) +
      ' — ' + (guilderIndex()>110?"the Union is earning":guilderIndex()<92?"money buys less than it did":"steady") + '</span></div>' +
    '<div class="careerline"><b>Chest</b><span>' + money(G.you.funds) + '</span></div>' +
    ((G.relics && G.relics.length)
      ? '<h2 class="h-serif" style="font-size:17px;margin-top:18px">What the building keeps</h2>' +
        '<p class="muted" style="margin:0 0 8px">' + G.relics.length + ' found — letters, plaques and ' +
        'tablets to people who served.</p>' +
        G.relics.slice(-8).reverse().map(x =>
          '<div class="careerline"><b>' + x.k + '</b><span>' + x.d + '</span></div>').join("")
      : '') +
    '<h2 class="h-serif" style="font-size:17px;margin-top:18px">Precedent</h2>' +
    '<p class="muted" style="margin:0 0 8px">What the people before you settled, and what you have settled since.</p>' +
    (function(){ const grp = []; (G.history||[]).slice().reverse().forEach(h => { const key = (h.byYou ? "y" : h.who) + "|" + h.act + "|" + h.precedent, g = grp.find(x => x.key === key); if(g){ g.n++; g.first = h.congress; } else grp.push({key, h, n:1, first:h.congress}); });
      return grp.slice(0,10).map(g => { const h = g.h;
        return '<div class="careerline"' + (h.byYou ? ' style="background:var(--surface)"' : '') + '>' +
        '<b>' + (g.n > 1 ? g.first + 'th\u2013' + h.congress + 'th' : h.congress + 'th') + '</b><span>' + (h.byYou ? '<strong>You</strong>' : h.who) +
        (h.party ? ' ' + partyChipHTML(h.party) : '') + ' ' + h.act + (g.n > 1 ? ' <strong>\u00d7' + g.n + '</strong>' : '') +
        ' <span class="muted">\u2014 ' + h.precedent + '</span></span></div>'; }).join(""); })() +
    '<p class="muted" style="margin-top:14px">The House: <strong>'+G.seatsBy.FED+'</strong> Federalist, <strong>'+
      G.seatsBy.COM+'</strong> Commonwealth, <strong>'+G.seatsBy.IND+'</strong> independent. Majority is 91.</p>';
  const saveExport = el("saveExport"), saveImport = el("saveImport");
  if(saveExport) saveExport.addEventListener("click", exportCareerSave);
  if(saveImport) saveImport.addEventListener("click", () => { if(window.onumPickCareer) window.onumPickCareer(); });
  el("paneCareer").querySelectorAll("[data-am]").forEach(b =>
    b.addEventListener("click", () => proposeAmendment(b.getAttribute("data-am"))));
  const bg = el("btnGreatness");
  if(bg) bg.addEventListener("click", () => {
    askLine("A motion of the House", "Name a figure for The Greatest — ranks 2 and below only. The First Consul's rank is sealed.", "A name", n => {
      if(!(n && String(n).trim())) return;
      if(G.you.influence < 8){ note("Need 8 influence to move a greatness nomination.", true); return; }
      G.you.influence -= 8;
      voteGreatness(String(n).trim(), "Named by floor motion of the House");
      refreshPanels();
    });
  });
  paneMoreClick("paneCareer", "career", refreshCareer);
}
/* Ask for a line of text without blocking the renderer.

   window.prompt() stops the whole page dead until it is answered: no
   frames, no timers, no game. In a plain tab you at least see the dialog
   and can dismiss it; in an app-mode window it can open behind or off to
   one side, and what you are looking at is a game that has simply stopped
   — indistinguishable from a freeze, and unrecoverable until it is found
   and dismissed. This does the same job with the card the game already
   uses for every other question it asks. */
function askLine(title, msg, placeholder, cb){
  const done = v => {
    try{ veil.hidden = true; card.classList.remove("card--open"); }catch(e){}
    try{ G.running = wasRunning; }catch(e){}
    try{ cb(v); }catch(e){ if(window.console) console.warn("askLine", e); }
  };
  const wasRunning = G.running;
  G.running = false;
  card.innerHTML =
    '<div class="eyebrow">' + title + '</div>' +
    '<p>' + msg + '</p>' +
    '<p><input class="mk__name" id="askLineInput" maxlength="60" placeholder="' +
      (placeholder || "") + '" style="font-size:19px"></p>' +
    '<div class="card__actions">' +
      '<button class="btn btn--ghost" type="button" id="askLineNo">Cancel</button>' +
      '<button class="btn" type="button" id="askLineYes">Confirm</button></div>';
  veil.hidden = false;
  card.classList.add("card--open");
  const input = el("askLineInput");
  const yes = el("askLineYes"), no = el("askLineNo");
  if(yes) yes.addEventListener("click", () => done(input ? input.value : ""));
  if(no) no.addEventListener("click", () => done(""));
  if(input){
    input.addEventListener("keydown", ev => {
      if(ev.key === "Enter"){ ev.preventDefault(); done(input.value); }
      else if(ev.key === "Escape"){ ev.preventDefault(); done(""); }
    });
    try{ input.focus(); }catch(e){}
  }
}
function refreshPanels(){
  try{ refreshBar(); }catch(e){}
  if((TALK && TALK.open) || (typeof veil !== "undefined" && veil && !veil.hidden)){
    for(const k in PANE_BUILD) PANE_STALE[k] = true;
    return;
  }
  try{ refreshTravel(); refreshWire(); }catch(e){}
  for(const k in PANE_BUILD) PANE_STALE[k] = true;
  try{ buildPane(currentPane()); }catch(e){}
  const n = unreadCount(), tab = el("tabInbox");
  if(tab) setHTML(tab, "Inbox" + (n ? '<span class="badge">' + n + '</span>' : ""));
}

document.querySelectorAll(".tabs button").forEach(btn => btn.addEventListener("click", () => {
  showPane(btn.getAttribute("data-pane"));
}));

/* ══════════════════════════════════════════════════════════
   15 · INPUT
   ══════════════════════════════════════════════════════════ */
const keys = {};
function typingInField(e){
  const t = e.target;
  return !!t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable);
}
/* Hold ? or / to show on-glass KBM tips (.keys). No permanent tip chrome in FPV. */
function setHelpHeld(on){
  document.body.classList.toggle("help-held", !!on);
  const tip = el("keysTips") || document.querySelector(".keys");
  if(tip) tip.setAttribute("aria-hidden", on ? "false" : "true");
}
function isHelpTipKey(e){
  const k = (e.key || "").toLowerCase();
  return e.code === "Slash" || k === "/" || k === "?" || e.key === "?";
}
/* KBM: fire a #prompt glass button by index — never requires pad D-pad arming or has-pad. */
function kbmFireGlass(idx){
  const pr = el("prompt");
  if(!pr || pr.hidden || !pr.classList.contains("is-live")) return false;
  const btns = [...pr.querySelectorAll("button.prompt__btn")];
  if(!btns.length) return false;
  const b = btns[Math.max(0, idx|0)];
  if(!b) return false;
  b.click();
  picksDirty = true;
  return true;
}
addEventListener("keydown", e => {
  if(typingInField(e)) return;            /* never walk the player while they type */
  const k = e.key.toLowerCase();
  try{ if(tlKey(e)) return; if(k === "l" && !e.repeat && veil.hidden && !e.ctrlKey && !e.metaKey){ tlToggle(true); e.preventDefault(); return; } }catch(_e){}
  /* Hold ? or / → show KBM help tips (hidden again on keyup) */
  if(isHelpTipKey(e)){ e.preventDefault(); setHelpHeld(true); return; }
  if(["arrowup","arrowdown","arrowleft","arrowright"].indexOf(k) >= 0) e.preventDefault();
  if(CATCH.on && CATCH.current && (k === "arrowleft" || k === "[" || k === ",")){
    e.preventDefault(); catchStep(-1); return;
  }
  if(CATCH.on && CATCH.current && (k === "arrowright" || k === "]" || k === ".")){
    e.preventDefault(); catchStep(1); return;
  }
  if(k === " " && veil.hidden) e.preventDefault();
  if(k === (G.bind||DEFAULT_BIND).pause){ togglePause(); return; }
  /* Number keys = quick prompt answers — KBM path, no pad / PICK arming required */
  if(k >= "1" && k <= "9" && !e.ctrlKey && !e.metaKey && !e.altKey){
    if(e.repeat){ e.preventDefault(); return; }
    const _now = performance.now();
    if(_now - (window._digitT || 0) < 260){ e.preventDefault(); return; }
    window._digitT = _now;
    if(!veil.hidden){
      const opts = card.querySelectorAll(".qz__opts .mk__opt");
      if(opts.length){ e.preventDefault(); const o = opts[k.charCodeAt(0) - 49]; if(o) o.click(); return; }
    }
    refreshPicks();
    const idx = k.charCodeAt(0) - 49;
    /* Prefer glass #prompt buttons when live (seated voice, station waits, etc.) */
    if(kbmFireGlass(idx)){ e.preventDefault(); return; }
    if(NUMS[idx]){
      e.preventDefault();
      PICK = PICKS.indexOf(NUMS[idx]);
      PICKS.forEach(b => b.classList.remove("is-pick"));
      NUMS[idx].classList.add("is-pick");
      if(PICK >= 0) firePick(); else NUMS[idx].click();
      return;
    }
  }
  keys[k] = true;
  if(k === "e" && !TALK.open && !(CATCH.on) && G.you && G.you.sitting && atMyDesk() && veil.hidden){
    e.preventDefault();
    if(PC.open) pcClose(); else pcOpen();
    return;
  }
  if(k === "e" && !TALK.open){
    /* Catch / deliver / seated voice / live glass — all without pad or PICK arming */
    if(CATCH.on && CATCH.current){ e.preventDefault(); catchNow(); return; }
    if(CATCH.on && CATCH.pieces && CATCH.pieces.length && !CATCH.current){ e.preventDefault(); deliverAssembledSpeech(); return; }
    /* 20261030m: seated press chair + person in focus → E calls on the FOCUSED person (direct callon, else openTalk); never falls to glass/seek */
    { const fP = (G.you && G.you.sitting) ? focusThing() : null;
      const S1 = window.ONUM_SESSION || null, S2 = (typeof SSN !== "undefined" && SSN) ? SSN : null;
      const sKind = (S2 && S2.kind) || (S1 && S1.kind), sChair = (S2 && S2.chairId) || (S1 && S1.chairId);
      if(fP && fP.type === "person" && fP.ref && fP.ref !== G.you && sKind === "press_conference" && (sChair === "you" || (S1 && S1.chairId === "you"))){
        e.preventDefault();
        const r = fP.ref, rid = String(r.id);
        let ok = r.kind === "press" || !!r.outlet;
        if(!ok){ try{ ok = [].concat((S1 && S1.seats) || [], (S2 && S2.seats) || []).some(x => x && String(x.personId) === rid && rid !== "you"); }catch(_){} }
        if(!ok){ try{ ok = ((typeof hereNow === "function" ? hereNow() : []) || []).concat(G.press || []).some(p => p && p.kind === "press" && String(p.id) === rid); }catch(_){} }
        let done = false;
        if(ok && window.onumSession && typeof window.onumSession.callon === "function"){ try{ done = window.onumSession.callon(r.id) !== false; }catch(_){ done = false; } }
        if(!done) openTalk(r);
        return; } }
    if((typeof seatVoiceAvailable === "function") && seatVoiceAvailable()){
      e.preventDefault();
      refreshPicks();
      /* Confirm selected glass line if any; else first seated act — never wait for D-pad */
      if(PICK >= 0 && PICKS[PICK] && el("prompt") && el("prompt").contains(PICKS[PICK])){ firePick(); }
      else if(!kbmFireGlass(0)){
        if(PICKS[0]){ PICK = 0; firePick(); }
      }
      return;
    }
    /* Other live glass choices (well full, wait for recognition, …): E confirms
       selected prompt btn if any, else first — never waits for pad D-pad */
    {
      refreshPicks();
      const pr = el("prompt");
      let gi = 0;
      if(pr && PICK >= 0 && PICKS[PICK] && pr.contains(PICKS[PICK])){
        const ix = [...pr.querySelectorAll("button.prompt__btn")].indexOf(PICKS[PICK]);
        if(ix >= 0) gi = ix;
      }
      if(kbmFireGlass(gi)){ e.preventDefault(); return; }
    }
    const seat = seatUnderYou();
    const talk = personInTalkRange();
    const f = focusThing();
    if(seat && !talk && !(G.you && G.you.sitting && f && f.type === "person")) toggleSit();   /* 20261030j: seated with a person in focus (prompt says speak), E talks, never stands you up */
    else if(f) (f.type === "person" ? openTalk : interactPropOrSpeech)(f.ref);
    else if(seat) toggleSit();
  }
  if(k === "escape"){
    if(G._pauseOpen || e._pzHandled || (performance.now() - (G._pauseClosedAt || 0)) < 300) return; /* the overlay's own Esc closes it */
    if(TALK.open){ closeTalk(); return; }
    try{
      const tipUp = (el("tipCard") && !el("tipCard").hidden);
      const busy = (typeof CATCH !== "undefined" && (CATCH.on || CATCH.current || (CATCH.pieces && CATCH.pieces.length))) || G.speechApproach || promptLive();
      if(veil.hidden && !tipUp && !uiOpen() && !PROC.on && !busy && G.you && G.members && G.members.length){
        openSettings(); return;
      }
    }catch(e){}
    /* Same peel as pad B — including stuck speech / CATCH prompts */
    padBack();
    return;
  }
  /* KBM: H opens/closes house panels on the phone (independent of the pad).
     Shift+H toggles immersive play vs desk HUD. */
  if(k === "h"){
    if(e.shiftKey){ setImmersive(!G.bare); return; }
    if(!veil.hidden && phoneWasRunning !== null){ phoneClose(); return; }
    if(veil.hidden){ openPanels(); return; }
    return;
  }
  if(k === "v" && veil.hidden && !listening){ const ab=el("aloudBtn"); if(ab) ab.classList.add("is-live"); micHeld = true; micStart(); return; }
  /* KBM: X opens today's schedule, the same as pad X — the phone's own
     hint and the quickstart both promise it, and only the pad had it. */
  if(k === "x" && !bindTaken("x") && veil.hidden && !TALK.open && (G.running || phoneWasRunning !== null)){
    openDaySchedule();
    return;
  }
  if(k === ((G.bind||DEFAULT_BIND).phone || "f") && veil.hidden && !TALK.open && G.running) phoneCard();
});
/* A rebound key wins over the extras above: whatever the player mapped
   walk / look / step / interact / pause / phone to is theirs. */
function bindTaken(k){
  const B = G.bind || DEFAULT_BIND;
  for(const name in B){ if(B[name] === k) return true; }
  return false;
}
addEventListener("keyup", e => {
  if(typingInField(e)) return;
  if(isHelpTipKey(e)){ setHelpHeld(false); return; }
  const k = e.key.toLowerCase();
  keys[k] = false;
  if(k === "v" && listening){ const ab=el("aloudBtn"); if(ab) ab.classList.remove("is-live"); micStop(); }
});
addEventListener("blur", () => {
  setHelpHeld(false);
  /* Keys held when the window goes away never send their keyup, so the
     player came back walking into a wall with the microphone still open.
     Let go of all of it. */
  for(const k in keys) keys[k] = false;
  micRelease();
});

/* Mouse look / click — always live, even with a pad connected (hybrid).
   Deltas are incremental so right-stick look stays additive while dragging. */
let drag = null;
renderer.domElement.addEventListener("pointerdown", e => {
  drag = {x:e.clientX, y:e.clientY, moved:0};
  renderer.domElement.setPointerCapture(e.pointerId);
});
renderer.domElement.addEventListener("pointermove", e => {
  if(!drag) return;
  const dx = clamp(e.clientX - drag.x, -32, 32);
  const dy = clamp(e.clientY - drag.y, -32, 32);
  drag.x = e.clientX; drag.y = e.clientY;
  drag.moved = Math.max(drag.moved, Math.abs(dx) + Math.abs(dy));
  /* Never gated on has-pad — pad sticks and mouse yaw/pitch both apply */
  const sens = G.sens || 1, inv = G.invertY ? -1 : 1;
  cam.yaw -= dx * 0.0024 * sens;
  cam.pitch = clamp(cam.pitch - dy * 0.0018 * sens * inv, -1.05, 1.05);
});
renderer.domElement.addEventListener("pointerup", () => {
  const wasDrag = drag && drag.moved > 6;
  drag = null;
  if(wasDrag || TALK.open || !G.running) return;
  /* Click interact works with pad live (hybrid); glass buttons use their own handlers */
  const seat = seatUnderYou();
  const talk = personInTalkRange();
  const f = focusThing();
  if(seat && !talk) toggleSit();
  else if(f) (f.type === "person" ? openTalk : interactPropOrSpeech)(f.ref);
  else if(seat) toggleSit();
});

/* ══════════════════════════════════════════════════════════
   15b · COLLAB (localStorage seats + Proxy AI)
   Seat A = you (existing save). Seat B = partner profile.
   Sync via Export/Import JSON into collab/ for git — file://
   cannot scan collab/players/. See collab/README.md.
   COLLAB HOOK: vote/speech logging + proxy in memberVote.
   ══════════════════════════════════════════════════════════ */
const COLLAB_KEY = "tls-collab-players";
const TLSCollab = (function(){
  function blankPlayer(id, displayName){
    return {
      id: id || "seat-b",
      displayName: displayName || "Partner",
      memberId: null,
      present: true,
      style: {econ:0, lib:0, def:0, wel:0, partyLineBreakRate:0, voteAyeRate:0.5},
      actions: [],
      lastSeen: null
    };
  }
  function defaultState(){
    return {
      version: 1,
      activeSeat: "A",
      proxyAbsent: false,
      seatA: {id:"seat-a", displayName:"You", memberId:"you", present:true, style:{}, actions:[], lastSeen:null},
      seatB: blankPlayer("seat-b", "Partner"),
      world: {version:1, session:null, members:{}}
    };
  }
  function load(){
    try{
      const raw = localStorage.getItem(COLLAB_KEY);
      if(!raw) return defaultState();
      const d = JSON.parse(raw);
      const base = defaultState();
      return Object.assign(base, d, {
        seatA: Object.assign(base.seatA, d.seatA||{}),
        seatB: Object.assign(base.seatB, d.seatB||{}),
        world: Object.assign(base.world, d.world||{})
      });
    }catch(e){ return defaultState(); }
  }
  function saveState(st){
    try{ localStorage.setItem(COLLAB_KEY, JSON.stringify(st)); return true; }
    catch(e){ return false; }
  }
  let state = load();
  function persist(){ saveState(state); }
  function activeProfile(){
    return state.activeSeat === "B" ? state.seatB : state.seatA;
  }
  function partnerProfile(){ return state.seatB; }
  function setActiveSeat(s){
    state.activeSeat = (s === "B") ? "B" : "A";
    const p = activeProfile();
    p.present = true;
    p.lastSeen = new Date().toISOString();
    persist();
  }
  function setPartnerName(name){
    state.seatB.displayName = (name || "Partner").trim() || "Partner";
    persist();
  }
  function setPartnerMemberId(id){
    const n = (id === "" || id === null || id === undefined) ? null : +id;
    state.seatB.memberId = (n === n) ? n : null;
    if(state.world && state.world.members && state.seatB.id){
      state.world.members[state.seatB.id] = state.seatB.memberId;
    }
    persist();
  }
  function setProxyAbsent(on){
    state.proxyAbsent = !!on;
    state.seatB.present = !state.proxyAbsent;
    persist();
  }
  function recordAction(action){
    const p = activeProfile();
    if(!p.actions) p.actions = [];
    const row = Object.assign({at: new Date().toISOString(), day: (typeof G !== "undefined" && G.day) || null}, action);
    p.actions.push(row);
    if(p.actions.length > onumLim(400,"hist")) p.actions = p.actions.slice(-onumLim(400,"hist"));
    p.lastSeen = row.at;
    if(window.ProxyAI && ProxyAI.learnStyle) ProxyAI.learnStyle(p);
    persist();
  }
  function recordVote(bill, vote, brokeLine){
    if(!bill) return;
    recordAction({
      kind: "vote",
      billId: bill.id,
      title: bill.title,
      pos: bill.pos ? {econ:bill.pos.econ, lib:bill.pos.lib, def:bill.pos.def, wel:bill.pos.wel} : null,
      vote: vote,
      brokeLine: !!brokeLine,
      party: (G.you && G.you.party) || null
    });
  }
  function recordSpeech(dir, text){
    recordAction({
      kind: "speech",
      dir: dir || 0,
      text: (text || "").slice(0, 240)
    });
  }
  function shouldProxy(m){
    if(!state.proxyAbsent || !m) return false;
    const mid = state.seatB.memberId;
    if(mid === null || mid === undefined) return false;
    return m.id === mid;
  }
  function proxyVote(m, bill){
    if(!window.ProxyAI || !ProxyAI.decide) return null;
    const lineMap = (typeof partyLine === "function" && bill) ? partyLine(bill) : {};
    const line = (m && lineMap[m.party]) || 0;
    const v = ProxyAI.decide(state.seatB, {kind:"vote", bill:bill, partyLine:line, member:m});
    return (v === 1 || v === -1) ? v : null;
  }
  function exportBundle(){
    return {
      version: 1,
      world: state.world,
      players: {
        [state.seatA.id]: state.seatA,
        [state.seatB.id]: state.seatB
      },
      meta: {activeSeat: state.activeSeat, proxyAbsent: state.proxyAbsent, exportedAt: new Date().toISOString()}
    };
  }
  function importBundle(data){
    if(!data || typeof data !== "object") throw new Error("Bad collab JSON");
    if(data.world) state.world = Object.assign(state.world, data.world);
    const players = data.players || {};
    const ids = Object.keys(players);
    if(data.seatA) state.seatA = Object.assign(blankPlayer("seat-a","You"), data.seatA);
    if(data.seatB) state.seatB = Object.assign(blankPlayer("seat-b","Partner"), data.seatB);
    if(ids.length){
      /* Prefer non-you as seat B; first as A if structured that way */
      const list = ids.map(k => players[k]);
      const youish = list.find(p => p.memberId === "you" || p.id === "seat-a") || list[0];
      const other = list.find(p => p !== youish) || blankPlayer("seat-b", "Partner");
      state.seatA = Object.assign(blankPlayer("seat-a","You"), youish, {memberId: youish.memberId || "you"});
      state.seatB = Object.assign(blankPlayer("seat-b","Partner"), other);
    }
    if(data.meta){
      if(data.meta.activeSeat) state.activeSeat = data.meta.activeSeat;
      if(typeof data.meta.proxyAbsent === "boolean") state.proxyAbsent = data.meta.proxyAbsent;
    }
    persist();
  }
  function downloadExport(){
    const blob = new Blob([JSON.stringify(exportBundle(), null, 2)], {type:"application/json"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = "tls-collab-export.json";
    a.textContent = "Download tls-collab-export.json";
    a.style.cssText = "position:fixed;left:8px;bottom:8px;z-index:200000;background:#ffe08a;color:#111;padding:10px 14px;border-radius:8px;font:700 14px system-ui";
    if(document.body) document.body.appendChild(a);
    try{ a.click(); }catch(e){}
    setTimeout(() => { try{ URL.revokeObjectURL(url); a.remove(); }catch(e){} }, 120000);
  }
  function summary(){
    const b = state.seatB;
    const n = (b.actions||[]).length;
    return (b.displayName||"Partner") + " · " + n + " logged action" + (n===1?"":"s") +
      (state.proxyAbsent ? " · proxy on" : "");
  }
  return {
    get state(){ return state; },
    reload(){ state = load(); return state; },
    persist, activeProfile, partnerProfile, setActiveSeat, setPartnerName,
    setPartnerMemberId, setProxyAbsent, recordAction, recordVote, recordSpeech,
    shouldProxy, proxyVote, exportBundle, importBundle, downloadExport, summary, blankPlayer
  };
})();

/* ══════════════════════════════════════════════════════════
   16 · SAVE
   ══════════════════════════════════════════════════════════ */
/* The career lives in this browser only (localStorage). Never Claude,
   never Opus, never a hosted artifact DB — play does not spend Claude credit. */
const SAVE_KEY = "longsession.v3";
const SAVE_BACKUP_KEY = "longsession.v3.backup";
const SAVE_BEST_KEY = "longsession.v3.best";
const SAVE_META_KEY = "longsession.v3.meta";
const SAVE_CAREERS_INDEX = "longsession.v3.careers";
const SAVE_ARCHIVE_PREFIX = "onum_career_archive_";
function careerRank(d){
  if(!d || !d.you) return -1;
  const cong = +(d.congress || 1);
  const day = +(d.day || 0);
  const sit = +(d.sittingDay || d.day || 0);
  const min = +(d.minute || 0);
  return cong * 1e9 + day * 1e6 + sit * 1e4 + min;
}
function parseSaveRaw(raw){
  if(!raw) return null;
  try{
    const d = JSON.parse(raw);
    if(!d || !d.you || !Array.isArray(d.members) || !d.members.length) return null;
    return d;
  }catch(e){ return null; }
}
function readSaveKey(key){
  try{ return parseSaveRaw(localStorage.getItem(key)); }catch(e){ return null; }
}
function isBetterSave(a, b){
  if(!a) return false;
  if(!b) return true;
  const ra = careerRank(a), rb = careerRank(b);
  if(ra !== rb) return ra > rb;
  return (+(a.savedAtMs || 0)) >= (+(b.savedAtMs || 0));
}
function pickNewestSave(){
  const cands = [SAVE_KEY, SAVE_BACKUP_KEY, SAVE_BEST_KEY].map(readSaveKey).filter(Boolean);
  if(!cands.length) return null;
  let best = cands[0];
  for(let i=1;i<cands.length;i++) if(isBetterSave(cands[i], best)) best = cands[i];
  return best;
}
function writeSaveKey(key, raw){
  try{ localStorage.setItem(key, raw); return true; }catch(e){ return false; }
}
/* ── 20261013q · saves that always fit ──────────────────────
   Browser storage holds about 5 MB. A late career is 2.5 MB, and the game
   wrote three copies of it, so once a save passed ~1.7 MB the newest write
   failed in silence and the old copy kept coming back (day 88 again). Numbers
   are rounded to four places, space is freed when a write does not fit, and a
   failure is said out loud. */
function saveRound(k, v){ return (typeof v === "number" && isFinite(v) && v % 1 !== 0) ? Math.round(v * 10000) / 10000 : v; }
function storeCareer(payload){
  let ok = writeSaveKey(SAVE_KEY, payload);
  if(!ok){
    careerFreeQuota();
    ok = writeSaveKey(SAVE_KEY, payload);
  }
  if(ok){
    writeSaveKey(SAVE_BACKUP_KEY, payload);                         /* a second copy, if it fits */
    if(payload.length < 1600000) writeSaveKey(SAVE_BEST_KEY, payload);
  }
  return ok;
}
function wipeCareerSaves(){
  /* 20261110bv JUPITER: a career is never deleted. Older callers used this
     to clear the active slot before a new oath; that path now archives and
     leaves the blob in place. This function is a no-op on purpose. */
}

function svWriteCareerMeta(rawOrData){
  try{
    let d = rawOrData;
    if(typeof d === "string") d = parseSaveRaw(d);
    if(!d || !d.you){
      if(typeof G !== "undefined" && G && G.you) d = {you:G.you, day:G.day, congress:G.congress, country:G.country, room:G.room, minute:G.minute, savedAtMs:Date.now()};
      else return false;
    }
    const slot = (arguments.length > 1 && arguments[1]) ? arguments[1] : "career";
    const meta = {
      name: d.you && d.you.name,
      day: d.day || 1,
      rank: careerRank(d),
      slot: slot,
      congress: d.congress || 1,
      country: d.country || null,
      room: d.room || "office",
      minute: d.minute || 0,
      savedAtMs: d.savedAtMs || Date.now(),
      bytes: (typeof rawOrData === "string") ? rawOrData.length : 0
    };
    localStorage.setItem(SAVE_META_KEY, JSON.stringify(meta));
    return true;
  }catch(e){ return false; }
}
function peekCareerMeta(){
  try{
    const m = JSON.parse(localStorage.getItem(SAVE_META_KEY) || "null");
    if(m && (m.name || m.day || m.slot || m.rank)) return m;
  }catch(e){}
  return null;
}
function pickNewestRaw(){
  const cands = [];
  const push = (raw, src) => {
    if(!raw) return;
    let d = null;
    try{ d = parseSaveRaw(raw); }catch(e){ d = null; }
    if(d) cands.push({raw:raw, d:d, src:src});
  };
  try{ push(localStorage.getItem(SAVE_KEY), SAVE_KEY); }catch(e){}
  try{ push(localStorage.getItem(SAVE_BACKUP_KEY), SAVE_BACKUP_KEY); }catch(e){}
  try{ push(localStorage.getItem(SAVE_BEST_KEY), SAVE_BEST_KEY); }catch(e){}
  try{ if(ENG_IDB && ENG_IDB.cache) push(ENG_IDB.cache, "idb:career"); }catch(e){}
  if(!cands.length) return null;
  let best = cands[0];
  for(let i = 1; i < cands.length; i++) if(isBetterSave(cands[i].d, best.d)) best = cands[i];
  return best;
}
function careerSlug(name){
  return String(name || "career").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 40) || "career";
}
function careerArchiveId(name){
  const iso = new Date().toISOString().replace(/[:.]/g, "-");
  return SAVE_ARCHIVE_PREFIX + iso + "_" + careerSlug(name);
}
let CAREER_INDEX_MEM = [];
function careerIndexRead(){
  let idx = [];
  try{ idx = JSON.parse(localStorage.getItem(SAVE_CAREERS_INDEX) || "[]"); }catch(e){ idx = []; }
  if(!Array.isArray(idx)) idx = [];
  const seen = {};
  const out = [];
  const add = (x) => { if(x && x.id && !seen[x.id]){ seen[x.id] = 1; out.push(x); } };
  idx.forEach(add);
  CAREER_INDEX_MEM.forEach(add);
  return out;
}
function careerIndexWrite(idx){
  CAREER_INDEX_MEM = Array.isArray(idx) ? idx.slice() : [];
  try{ localStorage.setItem(SAVE_CAREERS_INDEX, JSON.stringify(CAREER_INDEX_MEM)); }catch(e){}
  try{ engIdbPutAt("careers", JSON.stringify(CAREER_INDEX_MEM)); }catch(e){}
}
function careerIndexMergeIdb(){
  engIdbGetAt("careers", function(raw){
    if(!raw) return;
    let extra = raw;
    try{ if(typeof extra === "string") extra = JSON.parse(extra); }catch(e){ return; }
    if(!Array.isArray(extra) || !extra.length) return;
    const idx = careerIndexRead();
    const seen = {};
    idx.forEach(x => { if(x && x.id) seen[x.id] = 1; });
    extra.forEach(x => { if(x && x.id && !seen[x.id]) idx.push(x); });
    careerIndexWrite(idx);
  });
}
function careerScanLocalArchives(idx){
  const out = (idx || careerIndexRead()).slice();
  const seen = {};
  out.forEach(x => { if(x && x.id) seen[x.id] = 1; });
  try{
    for(let i = 0; i < localStorage.length; i++){
      const k = localStorage.key(i);
      if(!k || k.indexOf(SAVE_ARCHIVE_PREFIX) !== 0 || seen[k]) continue;
      let d = null;
      try{ d = parseSaveRaw(localStorage.getItem(k)); }catch(e){}
      out.push({id:k, name:d && d.you && d.you.name, day:d && d.day, congress:d && d.congress, bytes:(localStorage.getItem(k) || "").length, source:"scan"});
      seen[k] = 1;
    }
  }catch(e){}
  return out;
}
function careerArchiveCurrent(reason, cb){
  const done = (res) => { if(typeof cb === "function") try{ cb(res); }catch(e){} return res; };
  const run = () => {
    const picked = pickNewestRaw();
    if(!picked || !picked.raw) return done({ok:true, empty:true});
    const d = picked.d;
    const id = careerArchiveId(d && d.you && d.you.name);
    const raw = picked.raw;
    let lsOk = false;
    try{ localStorage.setItem(id, raw); lsOk = localStorage.getItem(id) === raw; }catch(e){}
    const entry = {
      id:id,
      name:d.you && d.you.name,
      day:d.day || 1,
      rank:careerRank(d),
      congress:d.congress || 1,
      savedAtMs:d.savedAtMs || Date.now(),
      bytes:raw.length,
      reason:reason || "archive",
      source:picked.src,
      stamp:"20261110bv"
    };
    const commit = (idbOk, verified) => {
      if(!verified) return done({ok:false, why:"no-store", id:id, lsOk:lsOk, idbOk:!!idbOk});
      const idx = careerIndexRead().filter(x => x && x.id !== id);
      idx.unshift(entry);
      careerIndexWrite(idx);
      try{ svWriteCareerMeta(d, id); }catch(e){}
      return done({ok:true, id:id, entry:entry, lsOk:lsOk, idbOk:!!idbOk, verified:true, raw:raw});
    };
    const finish = (idbOk) => {
      if(lsOk){
        let same = false;
        try{ same = localStorage.getItem(id) === raw; }catch(e){}
        if(same) return commit(idbOk, true);
      }
      if(idbOk){
        engIdbGetAt(id, function(got){ commit(true, got === raw); });
        return;
      }
      return commit(false, false);
    };
    let issued = false;
    try{ issued = !!engIdbPutAt(id, raw, function(ok){ finish(ok); }); }catch(e){ issued = false; }
    if(!issued) finish(false);
  };
  if(typeof ENG_IDB === "undefined" || ENG_IDB.ready) return run();
  engIdbWhenReady(run, 2000);
}
function careerReadArchiveRaw(id, cb){
  let raw = null;
  try{ raw = localStorage.getItem(id); }catch(e){}
  if(raw){ if(cb) cb(raw); return; }
  engIdbGetAt(id, function(v){ if(cb) cb(v || null); });
}
function careerWriteActiveRaw(raw, cb){
  let lsOk = false;
  try{ lsOk = !!writeSaveKey(SAVE_KEY, raw); }catch(e){}
  if(lsOk){ try{ writeSaveKey(SAVE_BACKUP_KEY, raw); }catch(e){} }
  try{ svWriteCareerMeta(raw); }catch(e){}
  try{ if(typeof ENG_IDB !== "undefined") ENG_IDB.cache = raw; }catch(e){}
  let issued = false;
  try{ issued = !!engIdbPutAt("career", raw, function(idbOk){ if(cb) cb(!!(lsOk || idbOk)); }); }catch(e){ issued = false; }
  if(!issued){ if(cb) cb(!!lsOk); }
}
function careerRestore(id, cb){
  const done = (res) => { if(typeof cb === "function") try{ cb(res); }catch(e){} return res; };
  if(!id) return done({ok:false, why:"no-id"});
  careerArchiveCurrent("before-restore", function(a){
    if(!a || !a.ok) return done({ok:false, why:"could-not-archive-current"});
    careerReadArchiveRaw(id, function(raw){
      if(!raw) return done({ok:false, why:"missing", id:id});
      careerWriteActiveRaw(raw, function(ok){
        done({ok:!!ok, id:id, bytes:raw.length, raw:raw});
      });
    });
  });
}

function careerKeyProtected(k){
  /* 20261110bv: never evict an archive, the careers index, or the sidecar to free quota. */
  if(!k) return false;
  if(k === SAVE_META_KEY || k === SAVE_CAREERS_INDEX) return true;
  if(k.indexOf(SAVE_ARCHIVE_PREFIX) === 0) return true;
  return false;
}
function careerFreeQuota(){
  for(const k of [SAVE_BEST_KEY, SAVE_BACKUP_KEY]){
    if(careerKeyProtected(k)) continue;
    try{ localStorage.removeItem(k); }catch(e){}
  }
}
function careerWipeActive(){
  /* Active slot only, and only after a verified archive. Archives stay. */
  [SAVE_KEY, SAVE_BACKUP_KEY, SAVE_BEST_KEY].forEach(k => {
    if(careerKeyProtected(k)) return;
    try{ localStorage.removeItem(k); }catch(e){}
  });
  try{
    if(typeof ENG_IDB !== "undefined" && ENG_IDB.db){
      ENG_IDB.db.transaction("s", "readwrite").objectStore("s").delete("career");
      ENG_IDB.cache = null;
    }
  }catch(e){}
  try{
    const idx = careerIndexRead();
    const m = peekCareerMeta() || {};
    if(idx[0] && idx[0].id){
      m.slot = idx[0].id;
      if(idx[0].name) m.name = m.name || idx[0].name;
      if(idx[0].day) m.day = m.day || idx[0].day;
      if(idx[0].rank != null) m.rank = m.rank || idx[0].rank;
      localStorage.setItem(SAVE_META_KEY, JSON.stringify(m));
    }
  }catch(e){}
  /* 20261110bx: a new career starts at day 1; drop the old sitting's
     save-rank ratchet so the first write is not refused. Back/clearWipe
     does not call this, and must not reset the guard. */
  try{ if(typeof SV !== "undefined" && SV){ SV.rank = null; SV.lastBody = null; } }catch(e){}
}
function careerClearWipe(){
  try{ if(typeof G !== "undefined" && G){ G._wipeOnOath = false; G._freshOk = false; } }catch(e){}
  return true;
}
function careerLoad(slotId, cb){
  const done = (res) => { if(typeof cb === "function") try{ cb(res); }catch(e){} return res; };
  const apply = (raw, slot) => {
    const d = parseSaveRaw(raw);
    if(!d) return done({ok:false, why:"parse", slot:slot});
    return done({ok:true, slot:slot, raw:raw, data:d, peek:{name:d.you && d.you.name, day:d.day || 1, rank:careerRank(d), slot:slot}});
  };
  const id = slotId || (peekCareerMeta() && peekCareerMeta().slot) || "career";
  if(id === "career" || id === "active" || id === SAVE_KEY){
    const p = pickNewestRaw();
    if(p && p.raw) return apply(p.raw, p.src || "career");
    const meta = peekCareerMeta();
    if(meta && meta.slot && meta.slot !== "career" && meta.slot !== "active") return careerLoad(meta.slot, cb);
    return done({ok:false, why:"empty"});
  }
  if(id === SAVE_BACKUP_KEY || id === SAVE_BEST_KEY){
    let raw = null;
    try{ raw = localStorage.getItem(id); }catch(e){}
    if(raw) return apply(raw, id);
    return done({ok:false, why:"empty", slot:id});
  }
  careerReadArchiveRaw(id, function(raw){
    if(!raw) return done({ok:false, why:"missing", slot:id});
    apply(raw, id);
  });
}
function careerOnReady(cb){
  const fire = () => { try{ if(typeof cb === "function") cb(window.ONUM_CAREERS); }catch(e){} };
  engIdbWhenReady(fire, 2000);
}

window.ONUM_CAREERS = {
  stamp:"20261110bv",
  peek: function(){ return peekCareerMeta() || peekSave(); },
  list: function(cb){
    const archives = careerScanLocalArchives(careerIndexRead());
    const out = {stamp:"20261110bv", active:peekSave(), archives:archives};
    if(typeof cb === "function") cb(out);
    return out;
  },
  load: function(slotId, cb){ return careerLoad(slotId, cb); },
  archiveCurrent: function(cb){ return careerArchiveCurrent("api", cb); },
  restore: function(slotId, cb){ return careerRestore(slotId, cb); },
  onReady: function(cb){ return careerOnReady(cb); },
  clearWipe: function(){
    careerClearWipe();
    return {ok:true, wipeOnOath:!!(typeof G!=="undefined" && G && G._wipeOnOath), freshOk:!!(typeof G!=="undefined" && G && G._freshOk)};
  },
  _qaSetWipe: function(v){ try{ if(!G) return false; G._wipeOnOath = !!v; G._freshOk = !!v; return true; }catch(e){ return false; } },
  /* aliases */
  current: function(){ return peekCareerMeta() || peekSave(); },
  archive: function(reason, cb){ return careerArchiveCurrent(reason || "manual", cb); },
  ready: function(cb){ return careerOnReady(cb); },
  activeRaw: function(){ const p = pickNewestRaw(); return p ? p.raw : null; },
  readRaw: function(id, cb){ return careerReadArchiveRaw(id, cb); },
  writeActive: function(raw, cb){ return careerWriteActiveRaw(raw, cb); },
  wipeActive: function(){ return careerWipeActive(); },
  freeQuota: function(){ return careerFreeQuota(); }
};
let saveBusy = false, saveCount = 0, saveQueued = false;
function queueSave(explicit){
  if(explicit){ try{ return save(true); }catch(e){ return false; } }
  if(PROC.on || TALK.open) return false;
  /* Never block a walk frame with autosave. */
  try{ if(houseQuiet()) return false; }catch(e){} /* feet ok — flat drip 20260921f */
  if(saveQueued || saveBusy) return false;
  saveQueued = true;
  setTimeout(() => {
    saveQueued = false;
    try{
      if(houseQuiet()) return; /* feet ok 20260921f */
      save(false);
    }catch(e){}
  }, 280);
  return true;
}
function stripMesh(m){
  const c = Object.assign({}, m);
  delete c.mesh;
  delete c.faceTex;
  if(c.chat && c.chat.length > onumLim(8,"save")) c.chat = c.chat.slice(-onumLim(8,"save"));
  if(c.brain && c.brain.inner) c.brain.inner = String(c.brain.inner).slice(0, 160);
  if(c.sent){
    c.sent.now = String(c.sent.now || "").slice(0, 140);
    c.sent.private = String(c.sent.private || "").slice(0, 140);
    c.sent.secret = String(c.sent.secret || "").slice(0, 160);
  }
  if(c.led){
    if(c.led.saw) c.led.saw = c.led.saw.slice(0, 16);
    if(c.led.told) c.led.told = c.led.told.slice(0, 12);
    if(c.led.grudge) c.led.grudge = c.led.grudge.slice(0, 8);
  }
  return c;
}
function saveCaptureBase(){
  return {
    _gfxOk:true,
    day:G.day, minute:G.minute, congress:G.congress, term:G.term, sittingDay:G.sittingDay,
    mood:G.mood, seatsBy:G.seatsBy, recessLeft:G.recessLeft, billIndex:G.billIndex, secretId:G.secretId,
    bill:G.bill, secrets:G.secrets, donors:G.donors, casework:G.casework,
    journal:G.journal, career:G.career, room:G.room, savedAt:G.savedAt,
    feed:(G.feed||[]).slice(0, onumLim(24,"save")), mail:(G.mail||[]).slice(0, onumLim(20,"save")), mailId:G.mailId, pendingReplies:G.pendingReplies, visitId:G.visitId,
    states:G.states, prog:G.prog, lobbies:G.lobbies, money:G.money, history:G.history, events:G.events,
    races:G.races || null,
    regime:G.regime, amended:G.amended, exec:G.exec, presidents:G.presidents, statute:G.statute,
    bare:G.bare, gfx:G.gfx, simple:G.simple, fullDetail:G.fullDetail, noSit:G.noSit,
    voiceVar:G.voiceVar, voiceRate:G.voiceRate, voiceCarry:G.voiceCarry, hours:G.hours,
    withWhom:G.withWhom, ties:G.ties, rite:G.rite, gov:G.gov, placed:G.placed, panel:null, court:G.court, own:G.own, parties:G.parties,
    termLength:G.termLength, country:G.country,
    speechHold:G.speechHold || {},
    greatest:G.greatest, blasphemy:G.blasphemy, loreNote:G.loreNote, greatnessOpen:G.greatnessOpen,
    relics:G.relics, relicSpots:G.relicSpots, consularLore:G.consularLore, bind:G.bind, sens:G.sens, invertY:!!G.invertY, voiceVol:G.voiceVol, goals:G.goals, whip:G.whip || null, billQueue:G.billQueue || [], faith:G.faith || null, life:G.life || null, ach:G.ach || {}, law:G.law || null, ladder:G.ladder || [], cases:G.cases || [], lastActs:G.lastActs || [], wx:G.wx || null, town:G.town || null, rivals:G.rivals || [], rivalNext:G.rivalNext || 0, daylog:(G.daylog || []).slice(-onumLim(120,"save")), paperRead:G.paperRead || 0, seedL:G.seedL || 0, mHints:G.mHints || {}, tlog:(G.tlog || []).slice(-onumLim(500,"save")), ag:G.ag || null, sitPrep:G.sitPrep || {}, echoes:G.echoes || [], billKinds:G.billKinds || {}, realmRel:G.realmRel || {}, org:G.org || null, conflict:G.conflict || null, conflictLog:G.conflictLog || [], warAuth:G.warAuth || null, react:G.react || [], reactNews:G.reactNews || [], senStaff:G.senStaff || null, presStaff:G.presStaff || null, listened:G.listened || 0,
    world:G.world, ofh:G.ofh || null, rgn:G.rgn || null, dyn:G.dyn || null, ssn:G.ssn || null, app:G.app || null, shp:G.shp || null, dn:G.dn || null, rs:G.rs || null, mm:G.mm || null, sc:G.sc || null, ph:G.ph || null,  sbox:G.sbox || null, dist:G.dist || null, fam:G.fam || null, loreBookSeeded:!!G.loreBookSeeded, saidHash:G.saidHash || [], dm:G.dm || null, lore:G.lore || null, trip:G.trip || null,
    pendingNight:!!G.pendingNight,
    cam:{x:cam.x, z:cam.z, yaw:cam.yaw, pitch:cam.pitch},
    /* the clock the shared save is compared by — not the game clock, the
       real one, so two browsers can be told apart by which wrote last */
    savedAtMs: Date.now()
  };
}
function saveCommit(payloadObj, explicit){
  try{
    const payload = JSON.stringify(payloadObj, saveRound);
    /* Never write a shorter career over a longer one. That is how day 10
       became day 5 — a torn primary, an old backup, or the shared store. */
    const newest = pickNewestSave();
    if(newest && careerRank(payloadObj) < careerRank(newest)){
      saveBusy = false;
      return false;
    }
    saveCount++;
    const wrote = storeCareer(payload);
    if(!wrote){
      saveBusy = false;
      G._saveFails = (G._saveFails || 0) + 1;
      const t = Date.now();
      if(!G._saveWarnAt || t - G._saveWarnAt > 120000){
        G._saveWarnAt = t;
        try{ note("The game could not save: this browser's storage is full. Career, then Export career save, keeps your day.", true); }catch(e){}
      }
      return false;
    }
    G._saveFails = 0;
    G.savedAt = hhmm();
    if(explicit) note("Saved.", false);
    try{
      const pip = el("savePip");
      if(pip){ pip.classList.add("is-on"); clearTimeout(save._pip); save._pip = setTimeout(() => pip.classList.remove("is-on"), 1200); }
    }catch(e){}
    saveBusy = false;
    return true;
  }catch(e){
    saveBusy = false;
    try{ if(window.console) console.warn("save", e); }catch(e2){}
    return false;
  }
}
function saveIdle(fn){
  try{
    if(typeof requestIdleCallback === "function"){
      requestIdleCallback(() => { try{ fn(); }catch(e){} }, {timeout: 180});
      return;
    }
  }catch(e){}
  setTimeout(() => { try{ fn(); }catch(e){} }, 0);
}
function save(explicit, sync){
  if(saveBusy) return false;
  /* Autosave never runs mid-walk / door fade. Explicit still yields. */
  if(!explicit && !sync){
    try{ if(houseQuiet()) return false; }catch(e){} /* feet ok — flat drip 20260921f */
  }
  saveBusy = true;
  try{
    const base = saveCaptureBase();
    const memSrc = (G.members || []).slice();
    const pressSrc = (G.press || []).slice();
    const civSrc = (G.civ || []).slice();
    const youSrc = G.you;
    /* beforeunload: one sync pass is allowed so the tab can die with a career. */
    if(sync){
      base.members = memSrc.map(stripMesh);
      base.press = pressSrc.map(stripMesh);
      base.civ = civSrc.map(stripMesh);
      base.you = stripMesh(youSrc);
      return saveCommit(base, !!explicit);
    }
    /* Off the movement critical path: stripMesh in batches of ~5, then stringify. */
    const buckets = [
      {src: memSrc, key: "members", out: []},
      {src: pressSrc, key: "press", out: []},
      {src: civSrc, key: "civ", out: []}
    ];
    let bi = 0, ii = 0;
    const step = () => {
      try{
        if(!explicit && houseQuiet()){ /* feet ok 20260921f */
          saveBusy = false;
          return;
        }
        let n = 5;
        while(n > 0 && bi < buckets.length){
          const b = buckets[bi];
          if(ii >= b.src.length){ bi++; ii = 0; continue; }
          b.out.push(stripMesh(b.src[ii++]));
          n--;
        }
        if(bi < buckets.length){
          saveIdle(step);
          return;
        }
        for(let i=0;i<buckets.length;i++) base[buckets[i].key] = buckets[i].out;
        base.you = stripMesh(youSrc);
        /* stringify also off the walk frame */
        saveIdle(() => {
          try{
            if(!explicit && houseQuiet()){ /* feet ok 20260921f */
              saveBusy = false;
              return;
            }
            saveCommit(base, !!explicit);
          }catch(e){
            saveBusy = false;
          }
        });
      }catch(e){
        saveBusy = false;
        try{ if(window.console) console.warn("save", e); }catch(e2){}
      }
    };
    saveIdle(step);
    return true;
  }catch(e){
    saveBusy = false;
    try{ if(window.console) console.warn("save", e); }catch(e2){}
    return false;
  }
}
function loadSave(){
  try{
    let d = pickNewestSave();
    if(!d){
      let raw = localStorage.getItem(SAVE_KEY);
      if(!raw) raw = localStorage.getItem(SAVE_BACKUP_KEY);
      d = parseSaveRaw(raw);
    }
    if(!d) return false;
    Object.assign(G, d);
    try{ if(localStorage.getItem("longsession.v3.force") === "idb") localStorage.removeItem("longsession.v3.force"); }catch(e){}
    if(G.fullDetail === undefined || G.fullDetail === null) G.fullDetail = true;
    if(!G.gfx || (G.gfx !== "best" && G.gfx !== "balanced" && G.gfx !== "simple")){
      G.gfx = (G.simple === true) ? "simple" : "best";
    }
    /* No silent Best→Balanced soften / MODEST Simple force (20260921b). */
    if(G.gfx === "best") G.fullDetail = true;
    else if(G.gfx !== "best") G.fullDetail = false;
    G.simple = (G.gfx === "simple");
    if(!G.muteSet) G.mute = false;
    if(!G.room || typeof G.room !== "string") G.room = "office";
    if(typeof G.day !== "number" || !(G.day > 0)) G.day = 1;
    if(typeof G.minute !== "number" || G.minute < 0) G.minute = 8*60;
    /* 20261011b: a 10pm save resumes a minute before ten so the night card still comes (was a soft-lock). */
    if(G.minute >= 22*60){ G.minute = 22*60 - 1; }
    G.pendingNight = false;
    if(!G.states || !G.states.length) buildUnion();
    if(!G.lobbies || !G.lobbies.length) buildLobbies();
    if(!G.money) G.money = {index:100, hist:[100]};
    if(!G.history) buildHistory();
    try{ ensureMythHistory(); }catch(e){}
    try{ ensureGreatest(); }catch(e){}
    if(G.country) TEX.flag = flagTexture(G.country.flag); else renameCountry((G.regime&&G.regime.form)||"republic");
    if(!G.prog) G.prog = {active:null, doneList:[]};
    if(!Array.isArray(G.press)) G.press = [];
    if(!Array.isArray(G.civ)) G.civ = [];
    ensureParties();
    mergeWorldParties();
    G.members.forEach(m => hydrateLoadedPerson(m));
    G.press.forEach(m => hydrateLoadedPerson(m));
    G.civ.forEach(m => hydrateLoadedPerson(m));
    if(G.you) hydrateLoadedPerson(G.you);
    try{ idMend(); }catch(e){ try{ console.warn("idMend", e); }catch(e2){} }   /* 20261027a: one person, one number, before anyone new is made */
    try{ ensureMachineSeat(); }catch(e){}
    if(d.cam && isFinite(d.cam.x) && isFinite(d.cam.z)){
      cam.x = d.cam.x; cam.z = d.cam.z;
      if(isFinite(d.cam.yaw)) cam.yaw = d.cam.yaw;
      if(isFinite(d.cam.pitch)) cam.pitch = d.cam.pitch;
      G._savedCam = true;
    } else G._savedCam = false;
    return true;
  }catch(e){ return false; }
}
function hydrateLoadedPerson(m){
  if(!m) return;
  m.mesh = null;
  m.faceTex = null;
  if(!m.rel) m.rel = {warmth:0, known:0, debtFromYou:0, debtToYou:0};
  if(m.rel.warmth == null) m.rel.warmth = 0;
  if(!m.look){ try{ m.look = rollLook(); }catch(e){} }
  /* Morphs wait until the mesh is built — hydrating 25 faces on Continue hung Edge. */
  if(!m.room || typeof m.room !== "string") m.room = "away";
  if(!m.pos) m.pos = {econ:0, lib:0, def:0, wel:0};
  try{ if(m.name) usedNames.add(m.name); }catch(e){}
}
function careerSnapshot(){
  try{
    if(G && G.you && G.members && G.members.length){
      const base = saveCaptureBase();
      base.members = G.members.map(stripMesh);
      base.press = (G.press || []).map(stripMesh);
      base.civ = (G.civ || []).map(stripMesh);
      base.you = stripMesh(G.you);
      base.savedAtMs = Date.now();
      return base;
    }
  }catch(e){}
  try{ return pickNewestSave(); }catch(e){ return null; }
}
function downloadNamed(name, text){
  const blob = new Blob([text], {type:"application/json"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = name; a.textContent = "Download " + name;
  a.style.cssText = "position:fixed;left:8px;bottom:8px;z-index:200000;background:#ffe08a;color:#111;padding:12px 16px;border-radius:8px;font:700 15px system-ui;text-decoration:none";
  document.body.appendChild(a);
  try{ a.click(); }catch(e){}
  setTimeout(() => { try{ URL.revokeObjectURL(url); a.remove(); }catch(e){} }, 120000);
}
function exportCareerSave(){
  const d = careerSnapshot();
  if(!d || !d.you){ note("There is no career save to export.", true); return; }
  const name = "one-nation-under-me-day" + (d.day || "x") + ".json";
  let raw;
  try{ raw = JSON.stringify(d); }catch(e){ note("Could not write the career file.", true); return; }
  const file = new File([raw], name, {type:"application/json"});
  const link = () => {
    downloadNamed(name, raw);
    note("Career exported, day " + (d.day || "?") + ". If the browser did not save it, tap the gold Download link.", false);
  };
  const share = () => {
    try{
      if(navigator.share && navigator.canShare && navigator.canShare({files:[file]})){
        navigator.share({files:[file], title:name}).then(() => {
          note("Career exported, day " + (d.day || "?") + ". Save it into Files.", false);
        }).catch(err => { if(err && err.name === "AbortError") return; link(); });
        return;
      }
    }catch(e){}
    link();
  };
  if(typeof window.showSaveFilePicker === "function"){
    let pick;
    try{
      pick = window.showSaveFilePicker({suggestedName:name, types:[{description:"Career save", accept:{"application/json":[".json"]}}]});
    }catch(e){ share(); return; }
    pick.then(h => {
      if(!h || typeof h.createWritable !== "function"){ share(); return; }
      return h.createWritable().then(w => w.write(new Blob([raw], {type:"application/json"})).then(() => w.close())).then(() => {
        note("Career saved to the file you chose, day " + (d.day || "?") + ".", false);
      });
    }).catch(err => { if(err && err.name === "AbortError"){ note("Export cancelled.", false); return; } share(); });
    return;
  }
  share();
}
function careerFromText(text){
  let t = String(text || "").replace(/^\uFEFF/, "").trim();
  if(!t) throw new Error("That file is empty.");
  if(t.slice(0, 5) === "ONZ1|"){
    const j = (typeof engOpen === "function") ? engOpen(t) : null;
    if(!j) throw new Error("That save file is damaged.");
    t = j;
  }
  let d;
  try{ d = (typeof t === "string") ? JSON.parse(t) : t; }
  catch(e){
    const i = t.indexOf("{"), j = t.lastIndexOf("}");
    if(i < 0 || j <= i) throw new Error("That file is not a career save. It needs you and the House.");
    d = JSON.parse(t.slice(i, j + 1));
  }
  if(typeof d === "string"){ try{ d = JSON.parse(d); }catch(e){} }
  if(d && d.you && Array.isArray(d.members) && d.members.length) return d;
  if(d && d.career && d.career.you && Array.isArray(d.career.members) && d.career.members.length) return d.career;
  throw new Error("That file is not a career save. It needs you and the House.");
}
function idbPutCareer(raw){
  return new Promise(res => {
    try{
      const finish = db => {
        try{
          const tx = db.transaction("s", "readwrite");
          tx.objectStore("s").put(raw, "career");
          tx.oncomplete = () => { try{ ENG_IDB.cache = raw; ENG_IDB.db = db; }catch(e){} res(true); };
          tx.onerror = () => res(false);
          tx.onabort = () => res(false);
        }catch(e){ res(false); }
      };
      if(ENG_IDB.db) return finish(ENG_IDB.db);
      const rq = indexedDB.open("onum-saves", 1);
      rq.onupgradeneeded = () => { try{ if(!rq.result.objectStoreNames.contains("s")) rq.result.createObjectStore("s"); }catch(e){} };
      rq.onsuccess = () => finish(rq.result);
      rq.onerror = () => res(false);
    }catch(e){ res(false); }
  });
}
function whenCareerReady(cb){
  const go = () => {
    let n = 0;
    const tick = () => {
      let ok = false;
      try{ ok = !!pickNewestSave(); }catch(e){}
      if(ok || n++ > 15) cb(!!ok);
      else setTimeout(tick, 100);
    };
    tick();
  };
  try{
    if(ENG_IDB && ENG_IDB.ready && typeof ENG_IDB.ready.then === "function"){
      let done = false;
      const t = setTimeout(() => { if(!done){ done = true; go(); } }, 4500);
      ENG_IDB.ready.then(() => { if(!done){ done = true; clearTimeout(t); go(); } }, () => { if(!done){ done = true; clearTimeout(t); go(); } });
      return;
    }
  }catch(e){}
  try{
    if(typeof engIdbWhenReady === "function" && typeof ENG_IDB !== "undefined" && !ENG_IDB.ready){
      engIdbWhenReady(go, 2000);
      return;
    }
  }catch(e){}
  go();
}
function importCareerSave(file){
  if(!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    let d, payload;
    try{
      d = careerFromText(String(reader.result || ""));
      payload = JSON.stringify(d);
    }catch(e){ note((e && e.message) || "Could not read that career save.", true); return; }
    window.ONUM_IMPORTING = true;
    idbPutCareer(payload).then(idbOk => {
      let lsOk = false;
      if(payload.length < 4200000){
        try{ lsOk = !!storeCareer(payload); }catch(e){}
      }
      if(idbOk){
        try{
          if(payload.length >= 4200000){
            localStorage.removeItem("longsession.v3");
            localStorage.removeItem("longsession.v3.backup");
            localStorage.removeItem("longsession.v3.best");
          }
          localStorage.setItem("longsession.v3.force", "idb");
          localStorage.setItem("longsession.v3.pointer", "idb");
        }catch(e){}
      }
      if(!idbOk && !lsOk){
        window.ONUM_IMPORTING = false;
        note("This browser has no room for that career. Clear site data for this page and try again.", true);
        return;
      }
      note("Career imported, day " + (d.day || "?") + ". Reloading.", false);
      setTimeout(() => { try{ location.reload(); }catch(e){} }, 400);
    });
  };
  reader.onerror = () => note("Could not read that file.", true);
  reader.readAsText(file);
}
window.onumPickCareer = function(){
  const take = f => { if(f) importCareerSave(f); };
  if(typeof window.showOpenFilePicker === "function"){
    let pick;
    try{
      pick = window.showOpenFilePicker({multiple:false, types:[{description:"Career save", accept:{"application/json":[".json"], "text/plain":[".txt"]}}]});
    }catch(e){ pick = null; }
    if(pick){
      pick.then(hs => hs && hs[0] && hs[0].getFile()).then(take).catch(err => {
        if(err && err.name === "AbortError") return;
        onumCareerInput();
      });
      return;
    }
  }
  onumCareerInput();
  function onumCareerInput(){
    let inp = document.getElementById("onumCareerFile");
    if(!inp){
      inp = document.createElement("input");
      inp.type = "file"; inp.id = "onumCareerFile";
      inp.accept = ".json,.txt,application/json,text/plain,*/*";
      inp.style.cssText = "position:fixed;left:0;top:0;width:100%;height:100%;opacity:0.01;z-index:2147483000";
      inp.addEventListener("change", () => { const f = inp.files && inp.files[0]; inp.value = ""; inp.style.display = "none"; take(f); });
      inp.addEventListener("cancel", () => { inp.style.display = "none"; });
      document.body.appendChild(inp);
    }
    inp.style.display = "block";
    try{ inp.click(); }catch(e){ note("The file window did not open. Try the menu again.", true); }
    setTimeout(() => { try{ if(inp) inp.style.display = "none"; }catch(e){} }, 120000);
  }
};

/* ══════════════════════════════════════════════════════════
   17 · LOOP & BOOT
   ══════════════════════════════════════════════════════════ */
function setSpeed(s){
  G.speed = s;
  if(s > 0) G.prevSpeed = s;
  document.querySelectorAll("#speed button[data-s]").forEach(b => {
    b.classList.toggle("is-on", (+b.getAttribute("data-s")) === G.prevSpeed);
  });
  const pb = el("btnPause");
  pb.textContent = s === 0 ? "▶" : "II";
  pb.title = s === 0 ? "Resume (space)" : "Pause (space)";
  pb.classList.toggle("is-held", s === 0);
}
function togglePause(){
  setSpeed(G.speed > 0 ? 0 : (G.prevSpeed || 1));
  G.speechApproach = null;
  try{ forceUnstickMove(); }catch(e){}
}
function showGameMenu(){
  if(!G.you || !(G.members && G.members.length) || !G.running) return;
  try{ save(); }catch(e){}
  G.running = false;
  setSpeed(0);
  opening();
}

/* ════════════════════════════════════════════════════════════
   SETTINGS MENU SYSTEM - MAX OP
   ════════════════════════════════════════════════════════════ */
let settingsState = {
  difficulty: "normal",
  graphicsQuality: "balanced",
  shadowsOn: true,
  bloomOn: true,
  antialiasing: "msaa4x",
  masterVolume: 80,
  voiceVolume: 85,
  sfxVolume: 70,
  spatialAudio: true,
  ttsEnabled: true,
  mouseSensitivity: 1.0,
  invertMouseY: false,
  walkSpeed: "normal",
  gamepadMode: false,
  autoSave: true,
  charSkinTone: "fair",
  charHairColor: "black",
  charEyeColor: "brown",
  charBodyType: "slim",
  charOutfitStyle: "formal"
};

function loadSettings(){
  try{
    const saved = localStorage.getItem("gameSettings_v1");
    if(saved) settingsState = Object.assign(settingsState, JSON.parse(saved));
  }catch(e){}
  applySettings();
}

function saveSettings(){
  try{
    localStorage.setItem("gameSettings_v1", JSON.stringify(settingsState));
  }catch(e){}
}

function applySettings(){
  if(settingsState.mouseSensitivity) window.mouseSensitivity = settingsState.mouseSensitivity;
  if(settingsState.invertMouseY !== undefined) window.invertMouseY = settingsState.invertMouseY;
}

function openSettings(){
  const overlay = el("pauseOverlay");
  if(overlay){
    if(overlay.classList.contains("is-open")) return;
    if(G.speed > 0) G.prevSpeed = G.speed;
    G._pauseOpen = true;
    try{ for(const k in keys) keys[k] = false; cam.vx = cam.vz = cam.yawVel = 0; }catch(e){}
    overlay.classList.add("is-open");
    setSpeed(0);
    G.running = false;
    try{ save(); }catch(e){}
    setupSettingsUI();
  }
}

function closeSettings(){
  const overlay = el("pauseOverlay");
  if(overlay) overlay.classList.remove("is-open");
  G._pauseOpen = false;
  G._pauseClosedAt = performance.now();
  try{ for(const k in keys) keys[k] = false; last = performance.now(); }catch(e){}
  if(G.you && G.members && G.members.length){
    G.running = true;
    setSpeed(G.prevSpeed || 1);
  }
}

function setupSettingsUI(){
  /* 20261011b: every row here does something. The old tabs (bloom, AA, difficulty,
     walk speed, character swatches) saved values nothing read; they are gone. */
  const panel = document.querySelector("#pauseOverlay .settings-panel");
  if(!panel) return;
  const tabsEl = panel.querySelector(".settings-tabs");
  const content = panel.querySelector(".settings-content");
  const on = (b) => b ? " is-on" : "";
  const opt = (attr, val, label, cur) => '<button type="button" class="settings-btn settings-btn-secondary pz-opt' +
    (cur ? " is-picked" : "") + '" data-' + attr + '="' + val + '">' + label + '</button>';
  const row = (label, desc, val) => '<div class="settings-row"><div><div class="settings-label">' + label +
    '</div>' + (desc ? '<div class="settings-desc">' + desc + '</div>' : '') + '</div><div class="settings-value">' + val + '</div></div>';
  let padName = "None connected";
  try{ const ps = navigator.getGamepads ? navigator.getGamepads() : []; for(let i=0;i<ps.length;i++) if(ps[i] && ps[i].connected){ padName = String(ps[i].id || "Controller").slice(0, 48); break; } }catch(e){}
  const sp = G.prevSpeed || 1;
  const dayLine = G.you ? (dateString() + " · " + hhmm() + " · sitting day " + G.sittingDay) : "";
  if(tabsEl) tabsEl.innerHTML =
    '<button class="settings-tab is-active" data-tab="game">Game</button>' +
    '<button class="settings-tab" data-tab="graphics">Graphics</button>' +
    '<button class="settings-tab" data-tab="audio">Voices</button>' +
    '<button class="settings-tab" data-tab="controls">Controls</button>';
  if(content) content.innerHTML =
    '<div class="settings-section is-open" data-section="game">' +
      '<h3 class="settings-section-title">' + (G.you ? G.you.name : "Paused") + '</h3>' +
      (dayLine ? '<p class="settings-desc" style="margin:-8px 0 8px">' + dayLine + '</p>' : '') +
      (G.you ? '<div class="settings-label" style="margin-top:6px">Today’s aims</div>' + goalsHTML() : '') +
      row("Pace of the day", "How fast the clock runs around you", opt("pzspeed", 1, "1×", sp === 1) + opt("pzspeed", 2, "2×", sp === 2) + opt("pzspeed", 4, "4×", sp === 4)) +
      row("Save", '<span id="pzSaved">Autosaves at every door and every few minutes</span>', '<button type="button" class="settings-btn settings-btn-secondary" id="pzSave">Save now</button>') +
      row("The handbook", "Everything the House does, in order", '<button type="button" class="settings-btn settings-btn-secondary" id="pzBook">Open</button>') +
      row("Today's paper", "The Capitol Ledger: yesterday in the building, the feud, letters from home, the weather", '<button type="button" class="settings-btn settings-btn-secondary" id="pzPaper">Read</button>') +
      row("The government", "Its form and name, who holds it, and what people call it", '<button type="button" class="settings-btn settings-btn-secondary" id="pzGov">Open</button>') +
      row("Consular precepts", "Write, order and repeal the precepts; hands-on or let the Rite run itself", '<button type="button" class="settings-btn settings-btn-secondary" id="pzRite">Open</button>') +
      row("Rivals", "Who has it in for you, how far it has gone, and what you can do about it", '<button type="button" class="settings-btn settings-btn-secondary" id="pzRival">Open</button>') +
      row("Home", "The households in your district: what they need and what they remember", '<button type="button" class="settings-btn settings-btn-secondary" id="pzHome">Open</button>') +
      row("Your office", "The powers of the chair you hold, and the term limits in law", '<button type="button" class="settings-btn settings-btn-secondary" id="pzOffice">Open</button>') +
      row("Achievements", "What the record will say. Some are hidden until you find them", '<button type="button" class="settings-btn settings-btn-secondary" id="pzAch">Open</button>') +
      row("War chest", "Spend it on ads, staff, offices, allies, counsel, polls and press time", '<button type="button" class="settings-btn settings-btn-secondary" id="pzChest">Open</button>') +
      row("Notebook", "Happenings, faith on the wire, and the things nobody explains", '<button type="button" class="settings-btn settings-btn-secondary" id="pzNote">Open</button>') +
      row("Whip count", "Who is with you on the bill, who to work, and where they are", '<button type="button" class="settings-btn settings-btn-secondary" id="pzWhip"' + (G.bill && !G.bill.done ? '' : ' disabled') + '>Open</button>') +
      row("Export save", "Download this career as a file you can keep", '<button type="button" class="settings-btn settings-btn-secondary" id="pzExport">Export save</button>') +
      row("Import save", "Load a career file, including a .txt paste; the game reloads into it", '<button type="button" class="settings-btn settings-btn-secondary" id="pzImport">Import save</button>') +
      row("Title", "Continue, or begin a new career", '<button type="button" class="settings-btn settings-btn-secondary" id="pzTitle">Title menu</button>') +
    '</div>' +
    '<div class="settings-section" data-section="graphics">' +
      '<h3 class="settings-section-title">Graphics</h3>' +
      row("Detail", "Best is the default. Simple if the machine struggles.", opt("pzgfx", "best", "Best", G.gfx === "best") + opt("pzgfx", "balanced", "Balanced", G.gfx === "balanced") + opt("pzgfx", "simple", "Simple", G.gfx === "simple")) +
      row("Graphics power", "Detected: " + pcEsc((window.ONUM_GPU && window.ONUM_GPU.name) || "unknown card") + ". Now running " + (MODEST ? "modest" : "full") + ". A change applies when the game reloads.", opt("pzpow", "auto", "Auto", !(function(){ try{ return localStorage.getItem("onum.power"); }catch(e){ return null; } })()) + opt("pzpow", "full", "Full", (function(){ try{ return localStorage.getItem("onum.power") === "full"; }catch(e){ return false; } })()) + opt("pzpow", "modest", "Modest", (function(){ try{ return localStorage.getItem("onum.power") === "modest"; }catch(e){ return false; } })())) +
      row("Scenery", "Rich is the default and eases itself if the machine cannot keep up", opt("pzrich", "2", "Rich", SC.lvl === 2) + opt("pzrich", "1", "Smooth", SC.lvl === 1) + opt("pzrich", "0", "Light", SC.lvl === 0)) +
      row("Film grain", "", '<div class="settings-toggle' + on(!G.noGrain) + '" id="pzGrain"><div class="settings-toggle-dot"></div></div>') +
      row("Seated poses", "Everyone stands if bodies look wrong", '<div class="settings-toggle' + on(!G.noSit) + '" id="pzSit"><div class="settings-toggle-dot"></div></div>') +
    '</div>' +
    '<div class="settings-section" data-section="audio">' +
      '<h3 class="settings-section-title">Voices</h3>' +
      row("Hear them", "Off reads every line instead", '<div class="settings-toggle' + on(!G.mute) + '" id="pzVoice"><div class="settings-toggle-dot"></div></div>') +
      row("Voice volume", "", '<input type="range" class="settings-slider" id="pzVol" min="0" max="100" value="' + Math.round((G.voiceVol === undefined ? 1 : G.voiceVol) * 100) + '">') +
      row("How fast they talk", "", '<input type="range" class="settings-slider" id="pzRate" min="70" max="130" value="' + Math.round((G.voiceRate === undefined ? 1 : G.voiceRate) * 100) + '">') +
      row("How far a voice carries", "", '<input type="range" class="settings-slider" id="pzCarry" min="60" max="200" value="' + Math.round((G.voiceCarry === undefined ? 1 : G.voiceCarry) * 100) + '">') +
      row("Who speaks aloud", "Typed first. They speak when you do, or when you ask.", opt("pzvm", "never", "Typed only", NPCV.mode === "never") + opt("pzvm", "ask", "When I speak", NPCV.mode === "ask") + opt("pzvm", "always", "Always", NPCV.mode === "always")) +
      row("Ambient sound", "Rooms, weather, footsteps, birds and the hour", opt("pzamb", "1", "On", AMB.on) + opt("pzamb", "0", "Off", !AMB.on)) +
      row("Test", "", '<button type="button" class="settings-btn settings-btn-secondary" id="pzTry">Hear a voice</button>') +
    '</div>' +
    '<div class="settings-section" data-section="controls">' +
      '<h3 class="settings-section-title">Controls</h3>' +
      row("Look speed", "Mouse drag, A/D and the right stick", '<input type="range" class="settings-slider" id="pzSens" min="40" max="220" value="' + Math.round((G.sens || 1) * 100) + '">') +
      row("Invert look up/down", "Mouse and right stick", '<div class="settings-toggle' + on(!!G.invertY) + '" id="pzInv"><div class="settings-toggle-dot"></div></div>') +
      row("Controller", padName, '<span class="settings-desc">Left stick walk · right stick look · A use · B back · LT/RT browse</span>') +
      row("Keys", "W/S walk · A/D look · Q/C step · Shift stride · E use · F phone · H panels", '<button type="button" class="settings-btn settings-btn-secondary" id="pzKeys">Rebind keys</button>') +
    '</div>';
  panel.querySelectorAll(".settings-tab").forEach(tab => {
    tab.addEventListener("click", () => switchSettingsTab(tab.getAttribute("data-tab")));
  });
  const re = () => { try{ setupSettingsUI(); }catch(e){} };
  const keepTab = (t) => { re(); switchSettingsTab(t); };
  panel.querySelectorAll("[data-pzspeed]").forEach(b => b.addEventListener("click", () => {
    G.prevSpeed = +b.getAttribute("data-pzspeed") || 1; keepTab("game");
  }));
  const bySave = el("pzSave");
  if(bySave) bySave.addEventListener("click", () => {
    let ok = false; try{ ok = save(true) !== false; }catch(e){}
    const t = el("pzSaved"); if(t) t.textContent = ok ? ("Saved · day " + G.day + " · " + hhmm()) : "Could not save — storage may be full";
  });
  const byBook = el("pzBook"); if(byBook) byBook.addEventListener("click", () => { closeSettings(); try{ handbookCard(); }catch(e){} });
  const byGov = el("pzGov"); if(byGov) byGov.addEventListener("click", () => { closeSettings(); setTimeout(() => { try{ govBoot(); govCard(); }catch(e){} }, 30); });
  const byRite = el("pzRite"); if(byRite) byRite.addEventListener("click", () => { closeSettings(); setTimeout(() => { try{ riteCard(); }catch(e){} }, 30); });
  const byPaper = el("pzPaper"); if(byPaper) byPaper.addEventListener("click", () => { closeSettings(); setTimeout(() => { try{ paperCard(); }catch(e){} }, 30); });
  const byRival = el("pzRival"); if(byRival) byRival.addEventListener("click", () => { closeSettings(); setTimeout(() => { try{ rivalCard(); }catch(e){} }, 30); });
  const byHome = el("pzHome"); if(byHome) byHome.addEventListener("click", () => { closeSettings(); setTimeout(() => { try{ homeCard(); }catch(e){} }, 30); });
  const byOff = el("pzOffice"); if(byOff) byOff.addEventListener("click", () => { closeSettings(); setTimeout(() => { try{ officeCard(); }catch(e){} }, 30); });
  const byAch = el("pzAch"); if(byAch) byAch.addEventListener("click", () => { closeSettings(); setTimeout(() => { try{ achCard(); }catch(e){} }, 30); });
  const byChest = el("pzChest"); if(byChest) byChest.addEventListener("click", () => { closeSettings(); setTimeout(() => { try{ chestCard(); }catch(e){} }, 30); });
  const byNote = el("pzNote"); if(byNote) byNote.addEventListener("click", () => { closeSettings(); setTimeout(() => { try{ notebookCard(); }catch(e){} }, 30); });
  const byExp = el("pzExport"); if(byExp) byExp.addEventListener("click", () => exportCareerSave());
  const byImp = el("pzImport");
  if(byImp) byImp.addEventListener("click", () => { if(window.onumPickCareer) window.onumPickCareer(); });
  const byWhip = el("pzWhip"); if(byWhip) byWhip.addEventListener("click", () => { closeSettings(); setTimeout(() => { try{ whipCard(); }catch(e){} }, 30); });
  const byTitle = el("pzTitle"); if(byTitle) byTitle.addEventListener("click", () => { closeSettings(); try{ G.running = true; showGameMenu(); }catch(e){} });
  const byKeys = el("pzKeys"); if(byKeys) byKeys.addEventListener("click", () => { closeSettings(); try{ settingsCard(); }catch(e){} });
  panel.querySelectorAll("[data-pzgfx]").forEach(b => b.addEventListener("click", () => {
    G.gfx = b.getAttribute("data-pzgfx");
    G.simple = G.gfx === "simple";
    G.fullDetail = (G.gfx === "best");
    try{ applyQuality(); }catch(e){}
    try{ save(); }catch(e){}
    keepTab("graphics");
  }));
  panel.querySelectorAll("[data-pzvm]").forEach(b => b.addEventListener("click", () => {
    NPCV.mode = b.getAttribute("data-pzvm"); try{ localStorage.setItem("onum.npcv", NPCV.mode); }catch(e){} if(NPCV.mode === "never") NPCV.until = 0; keepTab("audio");
  }));
  panel.querySelectorAll("[data-pzamb]").forEach(b => b.addEventListener("click", () => {
    AMB.on = b.getAttribute("data-pzamb") === "1"; try{ localStorage.setItem("onum.amb", AMB.on ? "1" : "0"); }catch(e){} if(AMB.on) ambInit(); else ambHush(); keepTab("audio");
  }));
  panel.querySelectorAll("[data-pzpow]").forEach(b => b.addEventListener("click", () => {
    const v = b.getAttribute("data-pzpow"); try{ if(v === "auto") localStorage.removeItem("onum.power"); else localStorage.setItem("onum.power", v); }catch(e){}
    try{ panel.querySelectorAll("[data-pzpow]").forEach(x => x.classList.toggle("is-picked", x === b)); }catch(e){}
    try{ feed(v === "auto" ? "Graphics power will follow the card in this machine, from the next reload." : v === "full" ? "Full graphics power from the next reload: sharp picture, shadows, anti-aliasing, sixty frames a second." : "Modest graphics power from the next reload."); }catch(e){} keepTab("graphics");
  }));
  panel.querySelectorAll("[data-pzrich]").forEach(b => b.addEventListener("click", () => {
    const lv = +b.getAttribute("data-pzrich"); SC.lvl = lv; SC.done = false; SC.since = 0; SC.cnt = 0; try{ localStorage.setItem("onum.rich.lvl", String(lv)); }catch(e){}
    try{ feed(lv ? "Rich picture is on. Materials change the next time you walk into a room." : "Light picture. Materials change the next time you walk into a room."); }catch(e){} keepTab("graphics");
  }));
  const tg = (id, fn, tab) => { const n = el(id); if(n) n.addEventListener("click", () => { try{ fn(); }catch(e){} keepTab(tab); }); };
  tg("pzGrain", () => { G.noGrain = !G.noGrain; const g = el("grain"); if(g) g.style.display = G.noGrain ? "none" : ""; }, "graphics");
  tg("pzSit", () => { G.noSit = !G.noSit; if(G.noSit) everyone().forEach(m => { m.sitting = false; }); }, "graphics");
  tg("pzVoice", () => { G.mute = !G.mute; G.muteSet = true; voiceStore(G.mute); if(G.mute) hush(); else unlockVoice(); }, "audio");
  tg("pzInv", () => { G.invertY = !G.invertY; }, "controls");
  const sl = (id, fn) => { const n = el(id); if(n) n.addEventListener("input", () => { try{ fn(+n.value); }catch(e){} }); };
  sl("pzVol", v => { G.voiceVol = v / 100; });
  sl("pzRate", v => { G.voiceRate = v / 100; });
  sl("pzCarry", v => { G.voiceCarry = v / 100; });
  sl("pzSens", v => { G.sens = v / 100; });
  const byTry = el("pzTry");
  if(byTry) byTry.addEventListener("click", () => {
    try{ hush(); unlockVoice(); G.mute = false; NPCV.preview = true; setTimeout(() => { NPCV.preview = false; }, 6000); const m = (G.members || []).find(x => x && !x.gone); speak(m || G.you, "The member for " + ((m || G.you || {}).state || "the Republic") + ". That is my voice."); }catch(e){}
  });
}

function switchSettingsTab(tabName){
  document.querySelectorAll("#pauseOverlay .settings-tab").forEach(t => t.classList.toggle("is-active", t.getAttribute("data-tab") === tabName));
  document.querySelectorAll("#pauseOverlay .settings-section").forEach(s => s.classList.toggle("is-open", s.getAttribute("data-section") === tabName));
}

function setupSettingControls(){}
function setupCharacterUI(){}

/* ── settings, and rebinding the keys ── */
/* ══════════════════════════════════════════════════════════
   THE MEMBER'S HANDBOOK
   Everything this game does, written down in one place, in the order
   somebody would actually need it. It is reachable from the strip
   under the view and from Settings, and it does not assume you have
   read anything else.
   ══════════════════════════════════════════════════════════ */
const HANDBOOK = [
  {t:"The canon", rows:[
    ["God", "The Latin Rite holds that God is the Most High and Christ is King. No man in this building is God."],
    ["The House", "The sitting is here. Here is there. They have not all pondered it yet. The hunger under it is for God, not for a man."],
    ["The remnant", "The Consular Rite hides remainders in the building — flakes, folds, a chair they will not sit. They call them horcruxes. The Church calls them idols. They recruit in the corridor and among the new class. Every confession can arrive with a freshman. The chaplain still will not give them the Host."],
    ["Riverbend at large", "A clerk who does not leave. Ask him about the sitting."]
  ]},
  {t:"Moving about", rows:[
    ["W / S", "Walk forward and back."],
    ["A / D", "Turn your head left and right."],
    ["Q / C", "Step sideways without turning."],
    ["Arrow keys", "Look around, including up and down."],
    ["Drag the view", "Look, both axes, with the mouse."],
    ["Shift", "Stride. People notice if you barge past them."],
    ["The strip under the view", "Every room you can walk to, and how long it takes."]
  ]},
  {t:"Doing things", rows:[
    ["E", "Speak to whoever you are facing, or use whatever you are facing."],
    ["The prompt in the middle", "Tells you what E will do right now."],
    ["Sit", "Face a bench or a chair and press E. In a sitting, you take your own seat."],
    ["F", "Your phone — Vox, posting, your mail, and the count."],
    ["Hold V / Speak Aloud", "Speak into the room — no popup. 1–9 answer prompts. Pad: hold X to speak aloud, D-pad then A to confirm a numbered line."],
    ["H", "Open or close the covering panels. While you play, the UI stays off the glass."],
    ["Space", "Pause. 1× 2× 4× set the speed of the day."]
  ]},
  {t:"The controller", rows:[
    ["A", "Do the thing. Speak to whoever you face, use what you face, sit down — and in a conversation, say the line you have picked. A never answers for you: if nothing is picked, it picks the first and waits."],
    ["B", "Back out of anything: a note, the phone, a conversation, a card."],
    ["X and Y", "The first and second answers to whatever is being asked, straight off."],
    ["Y (nothing asked)", "Your phone."],
    ["D-pad", "Move through every answer on screen, however many there are."],
    ["LB / RB", "Walk through the panels on the right."],
    ["Start", "Pause."],
    ["The line at the bottom", "Says what each button does right now. It changes with what is in front of you."]
  ]},
  {t:"Talking to people", rows:[
    ["They start", "Everyone you stop wanted something out of their own day. Deal with that and they will hear yours."],
    ["Answering", "Pick a line, or type anything you like in the bar. They read what you actually wrote."],
    ["Out loud", "Whoever is close enough hears it too. The conversation header names them."],
    ["To the room", "Choose 'Everyone in the room' in the bar, or hold V with nobody in front of you."],
    ["Walking off", "Push somebody who is already sour and they will leave mid-sentence."],
    ["Nothing repeats", "No line in this building is said twice unless the game has run out of ways to say it."]
  ]},
  {t:"What matters", rows:[
    ["Memory", "Every favour, threat and broken promise is written down in their words and fades slowly. Grudges fade slowest."],
    ["You cannot see numbers", "You get a read, and the read is wrong in proportion to how little you know them."],
    ["It travels", "Hurt one and their friends hear. Every private threat becomes a secret with a clock on it."],
    ["Nothing for turning up", "Influence, standing, approval and money come only from what you do."],
    ["They have their own lives", "Members deal with each other all day — trading, leaning, falling out — whether you are there or not."]
  ]},
  {t:"The flag of Nieuw Oranje VII", rows:[
    ["The cross", "A Jerusalem cross: Christ at the center, the four corners of the earth. Salvation is in Him. Not in the Consul. Not in the House."],
    ["The old motto", "Non solis radios, sed fulmina Iovis affero — I bring not the rays of the sun, but the thunderbolts of Jupiter."],
    ["The thunderbolts", "Whose they are is written plainly: Jupiter's, and above Jupiter, God's. The hand that carried them across was a man's, and the oldest Ledger signs it only “P.”"],
    ["The Cross", "Salus in Christo solo — salvation in Christ alone. The thunderbolt is His. The Consul is not."],
    ["Taylor Day", "Only this flag flies. The First Consul pointed at the Cross so the living would not point at him."],
    ["You", "You follow the Lord. Through a member they may find Him. They know nothing, and they can learn."],
    ["The rest", "Open Circle, Congregation of the Self, Latest Study, Civic Flame, Green Observance, Chapel of the Numbers, Reformed Kerk — lampoons that still vote. Ask them their creed. They will explain themselves."],
    ["The net", "Each of them is a loop: they model you, pick a want, speak from it, and learn whether the world matched. Prediction error makes them slower to believe. Elsewhere means they were already in a thought that was not you."],
    ["Will", "Each of them carries a destiny that is not yours. Home, name, creed, a life outside the corridor. They will act on it when you are not looking. They will say no because of it. The pin is will."],
    ["The world", "There is a war that is not the bill. Grain, the strait, bread, a sky that rains on the steps. Ask them about abroad."],
    ["Soul", "Sanctioned. Each of them has a good they will not trade and a wound they still hear. The Latin Rite still prays. The pin is soul."],
    ["Shriving", "The chaplain sits the quiet end of the cloakroom. Say the thing. Not the speech. He is a clerk of it, not the mercy. Christ is the salvation. A desk goes empty for a funeral. Not for a war the House did not march to."],
    ["The wall", "If the fourth wall breaks, the sim cannot touch Dominic Zachary Taylor or his kin. Real names, real towns, real family — not in this. The utterance dies. The House continues."],
    ["The clerk", "Ioan Merrick, Independent, Riverbend at large. Seated by sanction. He does not leave. He is not the First Consul. Ask him who he is. He will not break the wall to answer."],
    ["Off duty", "They have teams, songs, hobbies — some with names this building has never heard. Ask about sport or music. They will invent if they have to."]
  ]},
  {t:"The House", rows:[
    ["The bill", "Drawn from a real state and a real town's real problem. Read it in full from the Floor panel."],
    ["Sittings", "Party meetings, hearings and debates happen in real time in the room. You are called and you speak."],
    ["Hearings", "Up to three witnesses at the table. Press them, give them room, or let them go. A member can be called too."],
    ["The roll call", "Two thirds overrides a veto. A court of five can strike a bill down."],
    ["Precedent", "You start at the 1st Congress. Everything in the record is something somebody here did."]
  ]},
  {t:"Vox", rows:[
    ["Everyone has a handle", "They @ each other by name, and they will @ you."],
    ["Being named", "Whoever you name sees it and answers, a minute or two later."],
    ["Posting", "Write it yourself on the phone. The game reads who you named and how you said it."],
    ["Reach", "A roll weighted by your standing. It carries, does its rounds, or goes nowhere."]
  ]},
  {t:"Keeping your place", rows:[
    ["Saving", "Save at any moment from the strip. It also auto-saves often (about every 8 in-game minutes, plus a wall-clock backup) and at every door / begin."],
    ["Ending the day", "Your desk, after five o'clock. Or the sofa, if you need the hours back first."],
    ["If it runs badly", "Settings → Graphics → Simple (Balanced is the default; Best is optional). Same game, much less asked of the machine."],
    ["A full room", "When a room fills (more than seven people) the game eases LODs and seated poses by itself — shadows stay on Best/Balanced. It goes back when the room thins below four."],
    ["If bodies look wrong", "Settings → Seated poses → Everyone stands, and Graphics → Simple. If either one fixes it, that is worth knowing."],
    ["Voices", "Settings → Voices. They speak aloud by default, and quieter the further away they are."]
  ]}
];
(function handbookInDom(){
  try{
    if(document.getElementById("handbookText")) return;
    const s = document.createElement("section");
    s.id = "handbookText"; s.setAttribute("aria-label", "The member's handbook");
    s.style.cssText = "position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:normal";
    s.innerHTML = "<h2>The member's handbook</h2>" + HANDBOOK.map(sec => "<h3>" + sec.t + "</h3>" + sec.rows.map(r => "<p><b>" + r[0] + "</b> " + r[1] + "</p>").join("")).join("");
    document.body.appendChild(s);
  }catch(e){}
})();
function handbookCard(){
  const wasRunning = G.running;
  G.running = false;
  card.innerHTML =
    '<div class="eyebrow">The member\'s handbook</div>' +
    '<h1>How all of this works.</h1>' +
    '<p>Nothing here is hidden behind anything else. If something in the building is not explained ' +
      'on this page, it is not a rule — it is somebody having an opinion about you.</p>' +
    HANDBOOK.map(sec =>
      '<div class="hb"><div class="hb__t">' + sec.t + '</div>' +
      sec.rows.map(r => '<div class="hb__r"><b>' + r[0] + '</b><span>' + r[1] + '</span></div>').join("") +
      '</div>').join("") +
    '<div class="card__actions"><button class="btn" type="button" id="hbDone">Back to it</button></div>';
  veil.hidden = false;
  el("hbDone").addEventListener("click", () => {
    veil.hidden = true;
    G.running = wasRunning || true;
    refreshPanels();
  });
}

function collabCard(){
  const wasRunning = G.running;
  G.running = false;
  TLSCollab.reload();
  const st = TLSCollab.state;
  const members = (G.members||[]).slice().sort((a,b)=>a.name.localeCompare(b.name));
  const mid = st.seatB.memberId;
  const memberOpts = '<option value="">— pick partner’s member —</option>' +
    members.map(m => '<option value="'+m.id+'"'+(m.id===mid?" selected":"")+'>'+m.name+' ('+m.party+')</option>').join("");
  const aN = (st.seatA.actions||[]).length, bN = (st.seatB.actions||[]).length;
  card.innerHTML =
    '<div class="eyebrow">Collab · two seats</div><h1>Play with someone.</h1>' +
    '<p>Seat <b>A</b> is your career save. Seat <b>B</b> is a partner profile tied to one House member. ' +
      'Votes and speeches log into whichever seat you are playing as. When they are away, Proxy AI votes from their real action history — not a random NPC. ' +
      'Sync by Export/Import JSON into <code>collab/</code> and git (browsers cannot scan that folder from <code>file://</code>).</p>' +
    '<div class="mk">' +
      '<div class="mk__row"><i>I’m playing as</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt'+(st.activeSeat!=="B"?" is-on":"")+'" data-seat="A">Seat A · you</button>' +
        '<button type="button" class="mk__opt'+(st.activeSeat==="B"?" is-on":"")+'" data-seat="B">Seat B · partner</button>' +
      '</div></div>' +
      '<div class="mk__row"><i>Partner name</i><div class="mk__opts">' +
        '<input type="text" id="colName" maxlength="40" value="'+(st.seatB.displayName||"").replace(/"/g,"\x26quot;")+'" ' +
          'style="flex:1;min-width:140px;padding:6px 8px;border:1px solid var(--line);border-radius:2px;background:var(--surface);color:var(--ink)">' +
      '</div></div>' +
      '<div class="mk__row"><i>Partner member</i><div class="mk__opts">' +
        '<select class="wire__to" id="colMember" '+(G.you?'':'disabled')+'>'+memberOpts+'</select>' +
      '</div></div>' +
      '<div class="mk__row"><i>Partner absent</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt'+(st.proxyAbsent?" is-on":"")+'" data-proxy="1">Proxy AI on</button>' +
        '<button type="button" class="mk__opt'+(!st.proxyAbsent?" is-on":"")+'" data-proxy="0">They’re here</button>' +
      '</div></div>' +
      '<div class="mk__row"><i>Style log</i><span class="muted" style="font-size:10.5px">' +
        'A: '+aN+' actions · B ('+(st.seatB.displayName||"Partner")+'): '+bN+' actions' +
        (window.ProxyAI ? ' · ProxyAI loaded' : ' · ProxyAI missing (collab/proxy.js)') +
      '</span></div>' +
      '<div class="mk__row"><i>Share</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt" id="colExport">Export JSON</button>' +
        '<button type="button" class="mk__opt" id="colImport">Import JSON</button>' +
        '<input type="file" id="colFile" accept="application/json,.json" hidden>' +
      '</div></div>' +
    '</div>' +
    '<div class="card__actions">' +
      '<button class="btn btn--ghost" type="button" id="colSettings">Settings</button>' +
      '<button class="btn" type="button" id="colDone">Back to it</button></div>';
  veil.hidden = false;
  card.querySelectorAll("[data-seat]").forEach(b => b.addEventListener("click", () => {
    TLSCollab.setActiveSeat(b.getAttribute("data-seat"));
    note("Recording style as Seat " + TLSCollab.state.activeSeat + ".");
    collabCard();
  }));
  const cn = el("colName");
  if(cn) cn.addEventListener("change", () => { TLSCollab.setPartnerName(cn.value); collabCard(); });
  const cm = el("colMember");
  if(cm) cm.addEventListener("change", () => {
    TLSCollab.setPartnerMemberId(cm.value);
    const m = byId(+cm.value);
    if(m) note("Partner seat is " + m.name + ".");
    collabCard();
  });
  card.querySelectorAll("[data-proxy]").forEach(b => b.addEventListener("click", () => {
    TLSCollab.setProxyAbsent(b.getAttribute("data-proxy") === "1");
    note(TLSCollab.state.proxyAbsent
      ? "Partner absent — Proxy AI will vote from their log."
      : "Partner present — Proxy AI off.");
    collabCard();
  }));
  el("colExport").addEventListener("click", () => {
    TLSCollab.downloadExport();
    note("Collab JSON downloaded — put it under collab/ for git.");
  });
  el("colImport").addEventListener("click", () => el("colFile").click());
  el("colFile").addEventListener("change", () => {
    const f = el("colFile").files && el("colFile").files[0];
    if(!f) return;
    const reader = new FileReader();
    reader.onload = () => {
      try{
        TLSCollab.importBundle(JSON.parse(reader.result));
        note("Collab profiles imported.");
        collabCard();
      }catch(e){ note("Could not import that JSON."); }
    };
    reader.readAsText(f);
  });
  el("colSettings").addEventListener("click", settingsCard);
  el("colDone").addEventListener("click", () => {
    veil.hidden = true; G.running = wasRunning || true; refreshPanels();
  });
}

const BIND_LABELS = {forward:"Walk forward", back:"Walk back", lookL:"Look left",
  lookR:"Look right", stepL:"Step left", stepR:"Step right",
  interact:"Speak / use", pause:"Pause", phone:"Your phone"};
let awaitingBind = null;
function keyName(k){ return k === " " ? "space" : (k || "—").toUpperCase(); }
function settingsCard(){
  const wasRunning = G.running;
  G.running = false;
  G.bind = G.bind || Object.assign({}, DEFAULT_BIND);
  card.innerHTML =
    '<div class="eyebrow">Settings</div><h1>How this plays.</h1>' +
    '<p><strong>KBM solo</strong> — full play, no pad, no D-pad arming. Hold <strong>?</strong> or <strong>/</strong> for on-glass tips. ' +
      '<strong>Pad solo</strong> — every action on the controller (sticks, A/B/X/Y, LT·RT, D-pad, shoulders, Start). ' +
      '<strong>Hybrid</strong> — pad + mouse look/click at once; neither stream disables the other. ' +
      'At a podium: <strong>E</strong> / <strong>1–9</strong> or pad <strong>A</strong> / <strong>LT·RT</strong>.</p>' +
    '<div class="mk">' +
      Object.keys(BIND_LABELS).map(k =>
        '<div class="mk__row"><i>' + BIND_LABELS[k] + '</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (awaitingBind===k?" is-on":"") +
        '" data-bind="' + k + '">' + (awaitingBind===k ? "press a key…" : keyName(G.bind[k])) +
        '</button></div></div>').join("") +
      '<div class="mk__row"><i>Look speed</i><input type="range" id="setSens" min="40" max="220" value="' +
        Math.round((G.sens||1)*100) + '"></div>' +
      '<div class="mk__row"><i>Film grain</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (G.noGrain?"":" is-on") + '" data-gr="0">On</button>' +
        '<button type="button" class="mk__opt' + (G.noGrain?" is-on":"") + '" data-gr="1">Off</button>' +
      '</div></div>' +
      (G.you ? '<div class="mk__row"><i>Your seat</i><div class="mk__opts">' +
        '<select class="wire__to" id="setState">' + STATES.map(st =>
          '<option value="' + st + '"' + (st === G.you.state ? " selected" : "") + '>' + st + '</option>').join("") +
        '</select>' +
        '<input type="number" id="setDist" min="1" max="24" value="' + G.you.dist +
          '" style="width:64px" aria-label="District">' +
      '</div></div>' : "") +
      '<div class="mk__row"><i>Seated poses</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (G.noSit?"":" is-on") + '" data-sit="0">People sit</button>' +
        '<button type="button" class="mk__opt' + (G.noSit?" is-on":"") + '" data-sit="1">Everyone stands</button>' +
      '</div></div>' +
      '<div class="mk__row"><i>Graphics</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (G.gfx==="best"?" is-on":"") + '" data-gfx="best">Best</button>' +
        '<button type="button" class="mk__opt' + (G.gfx==="balanced"?" is-on":"") + '" data-gfx="balanced">Balanced</button>' +
        '<button type="button" class="mk__opt' + (G.gfx==="simple"?" is-on":"") + '" data-gfx="simple">Simple</button>' +
      '</div></div>' +
      '<div class="mk__row"><i>People\u2019s voices</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (NPCV.mode === "never" ? " is-on" : "") + '" data-npcv="never" title="Everything they say is typed">Typed only</button>' +
        '<button type="button" class="mk__opt' + (NPCV.mode === "ask" ? " is-on" : "") + '" data-npcv="ask" title="Typed first; they speak aloud when you speak, or ask them to">When I speak</button>' +
        '<button type="button" class="mk__opt' + (NPCV.mode === "always" ? " is-on" : "") + '" data-npcv="always">Always</button>' +
      '</div></div>' +
      '<div class="mk__row"><i>Ambient sound</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (AMB.on ? " is-on" : "") + '" data-amb="1">On</button>' +
        '<button type="button" class="mk__opt' + (!AMB.on ? " is-on" : "") + '" data-amb="0">Off</button>' +
      '</div></div>' +
      '<div class="mk__row"><i>Scenery</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (SC.lvl === 2 ? " is-on" : "") + '" data-rich="2">Rich</button>' +
        '<button type="button" class="mk__opt' + (SC.lvl === 1 ? " is-on" : "") + '" data-rich="1">Smooth</button>' +
        '<button type="button" class="mk__opt' + (SC.lvl === 0 ? " is-on" : "") + '" data-rich="0">Light</button>' +
      '</div></div>' + (MODEST && SC.lvl < 2 ? '<div class="mk__row"><i></i><span class="muted" style="font-size:10.5px">' + (SC.lvl ? "Eased a step to keep the frame rate up." : "Light picture. It was switched on by hand or because the machine struggled.") + '</span></div>' : "") +
      (crowdSafe && G.gfx !== "simple"
        ? '<div class="mk__row"><i></i><span class="muted" style="font-size:10.5px">' +
          'The room is full, so people are being drawn a little plainer for now. Shadows stay on. It goes back on its own.' +
          '</span></div>' : "") +
      (SHADER_TROUBLE ? '<div class="mk__row"><i>Driver said</i><span class="muted" style="font-size:10.5px">' +
        SHADER_TROUBLE.replace(/[<>]/g, "") + '</span></div>' : "") +
      '<div class="mk__row"><i>Voices</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt' + (G.mute?"":" is-on") + '" data-vo="0">Hear them</button>' +
        '<button type="button" class="mk__opt' + (G.mute?" is-on":"") + '" data-vo="1">Read only</button>' +
      '</div></div>' +
      (G.mute ? "" :
      '<div class="mk__row"><i>How different</i><input type="range" id="setVar" min="0" max="200" value="' +
        Math.round((G.voiceVar === undefined ? 1 : G.voiceVar) * 100) + '"></div>' +
      '<div class="mk__row"><i>How fast</i><input type="range" id="setRate" min="70" max="130" value="' +
        Math.round((G.voiceRate === undefined ? 1 : G.voiceRate) * 100) + '"></div>' +
      '<div class="mk__row"><i>How far it carries</i><input type="range" id="setCarry" min="60" max="200" value="' +
        Math.round((G.voiceCarry === undefined ? 1 : G.voiceCarry) * 100) + '"></div>' +
      '<div class="mk__row"><i></i><button type="button" class="mk__opt" id="setTry">Hear a voice</button></div>') +
    '</div>' +
    '<div class="card__actions">' +
      '<button class="btn btn--ghost" type="button" id="setCollab">Collab</button>' +
      '<button class="btn btn--ghost" type="button" id="setBook">The handbook</button>' +
      '<button class="btn btn--ghost" type="button" id="setReset">Reset to defaults</button>' +
      '<button class="btn" type="button" id="setDone">Back to it</button></div>';
  veil.hidden = false;
  card.querySelectorAll("[data-bind]").forEach(b => b.addEventListener("click", () => {
    awaitingBind = b.getAttribute("data-bind"); settingsCard();
  }));
  const ss = el("setState"), sd = el("setDist");
  if(ss) ss.addEventListener("change", () => {
    G.you.state = ss.value; save(); refreshPanels();
    note("You now sit for " + G.you.state + " " + G.you.dist + ".");
  });
  if(sd) sd.addEventListener("change", () => {
    G.you.dist = clamp(+sd.value || 1, 1, 24); save(); refreshPanels();
  });
  card.querySelectorAll("[data-sit]").forEach(b => b.addEventListener("click", () => {
    G.noSit = b.getAttribute("data-sit") === "1";
    if(G.noSit) everyone().forEach(m => { m.sitting = false; });
    settingsCard();
  }));
  card.querySelectorAll("[data-gfx]").forEach(b => b.addEventListener("click", () => {
    G.gfx = b.getAttribute("data-gfx");
    G.simple = G.gfx === "simple";
    G.fullDetail = (G.gfx === "best");
    applyQuality();
    save();
    settingsCard();
  }));
  card.querySelectorAll("[data-vo]").forEach(b => b.addEventListener("click", () => {
    G.mute = b.getAttribute("data-vo") === "1";
    G.muteSet = true; voiceStore(G.mute);
    if(G.mute) hush();
    else {
      unlockVoice();
      speak(G.you, "You can hear them now.");
    }
    settingsCard();
  }));
  card.querySelectorAll("[data-gr]").forEach(b => b.addEventListener("click", () => {
    G.noGrain = b.getAttribute("data-gr") === "1";
    el("grain").style.display = G.noGrain ? "none" : "";
    settingsCard();
  }));
  const sn = el("setSens");
  if(sn) sn.addEventListener("input", () => { G.sens = +sn.value/100; });
  const vv = el("setVar"), vr = el("setRate"), vc = el("setCarry"), vt = el("setTry");
  if(vv) vv.addEventListener("input", () => { G.voiceVar = +vv.value/100; });
  if(vr) vr.addEventListener("input", () => { G.voiceRate = +vr.value/100; });
  if(vc) vc.addEventListener("input", () => { G.voiceCarry = +vc.value/100; });
  if(vt) vt.addEventListener("click", () => {
    hush();
    unlockVoice();
    G.mute = false; G.muteSet = true; voiceStore(false);
    const three = G.members.filter(m => !m.gone).slice(0, 3);
    NPCV.preview = true; setTimeout(() => { NPCV.preview = false; }, 2200 * 3 + 800);   /* trying a voice is you asking to hear it, even with the clock frozen behind the card */
    if(!three.length && G.you) speak(G.you, "This is a voice in the House.");
    three.forEach((m, i) => setTimeout(() =>
      speak(m, "The member for " + m.state + " " + m.dist + ". That is my voice."), i * 2200));
  });
  el("setCollab").addEventListener("click", collabCard);
  el("setBook").addEventListener("click", handbookCard);
  el("setReset").addEventListener("click", () => {
    G.bind = Object.assign({}, DEFAULT_BIND); G.sens = 1; awaitingBind = null; settingsCard();
  });
  el("setDone").addEventListener("click", () => {
    awaitingBind = null; veil.hidden = true; G.running = wasRunning || true; save(); refreshPanels();
  });
}
el("btnPause").addEventListener("click", togglePause);
el("btnMenu").addEventListener("click", openSettings);

/* Settings menu event listeners */
const closeSettingsBtn = el("closeSettings");
if(closeSettingsBtn) closeSettingsBtn.addEventListener("click", closeSettings);
const resumeGameBtn = el("resumeGame");
if(resumeGameBtn) resumeGameBtn.addEventListener("click", closeSettings);
const resetSettingsBtn = el("resetSettings");
if(resetSettingsBtn) resetSettingsBtn.addEventListener("click", () => {
  try{ G.sens = 1; G.invertY = false; G.voiceVol = 1; G.voiceRate = 1; G.voiceCarry = 1; G.noGrain = false; G.noSit = false; const g = el("grain"); if(g) g.style.display = ""; }catch(e){}
  settingsState = {
    difficulty: "normal", graphicsQuality: "balanced", shadowsOn: true, bloomOn: true,
    antialiasing: "msaa4x", masterVolume: 80, voiceVolume: 85, sfxVolume: 70,
    spatialAudio: true, ttsEnabled: true, mouseSensitivity: 1.0, invertMouseY: false,
    walkSpeed: "normal", gamepadMode: false, autoSave: true,
    charSkinTone: "fair", charHairColor: "black", charEyeColor: "brown",
    charBodyType: "slim", charOutfitStyle: "formal"
  };
  saveSettings();
  setupSettingsUI();
});

document.addEventListener("keydown", (e) => {
  if(e.key === "Escape"){
    const overlay = el("pauseOverlay");
    if(overlay && overlay.classList.contains("is-open")){ e._pzHandled = true; closeSettings(); }
  }
});

loadSettings();

(function(){
  const openBtn = el("uiOpenBtn");
  if(openBtn) openBtn.addEventListener("click", () => openPanels());
  const mapBtn = el("uiMapBtn");
  if(mapBtn) mapBtn.addEventListener("click", () => {
    try{ mapCard(); }catch(e){ openPanels(); }
  });
  const walkBtn = el("uiWalkOut");
  if(walkBtn) walkBtn.addEventListener("click", () => { try{ walkOutNow(); }catch(e){} });
  const ub = el("unBare");
  if(ub) ub.addEventListener("click", () => openPanels());
  const purseBtn = el("uiPurseBtn");
  if(purseBtn) purseBtn.addEventListener("click", () => { try{ if(G.you && veil.hidden) purseCard(); }catch(e){ console.warn(e); } });
  const galBtn = el("uiGalleryBtn");
  if(galBtn) galBtn.addEventListener("click", () => { try{ if(G.you && veil.hidden) watchCard(); }catch(e){ console.warn(e); } });
  const paperBtn = el("uiPaperBtn");
  if(paperBtn) paperBtn.addEventListener("click", () => { try{ if(G.you && veil.hidden) paperCard(); }catch(e){ console.warn(e); } });
  const settingsBtn = el("uiSettingsBtn");
  if(settingsBtn) settingsBtn.addEventListener("click", openSettings);
})();
document.querySelectorAll("#speed button[data-s]").forEach(b =>
  b.addEventListener("click", () => setSpeed(+b.getAttribute("data-s"))));

/* ── Xbox / any standard gamepad (optional, parallel to KBM) ─
   Three modes: KBM solo | pad solo | pad+mouse hybrid.
   Pad alone reaches every play action (sticks, A/B/X/Y, LT/RT, D-pad,
   LB/RB, Start). KBM alone never needs has-pad or D-pad PICK arming.
   Hybrid: mouse look/click stay live with a pad connected; pad sticks
   stay live while the mouse moves — both streams additive/parallel.
   Left stick walks, right stick looks, A speaks or confirms a D-pad-
   selected prompt, B closes, Start pauses. LT/RT browse speech and interview lines; A takes the one on the glass.
   Pad prompts (except catch/deliver) arm after D-pad selects them;
   KBM uses E / 1–9 / click with no such gate.
   Read once a frame rather than inside the clock, so it still answers
   while the game is paused or a card is up. */
const PAD = {vx:0, vz:0, turn:0, tilt:0, sprint:false};
const PADHELD = {};
const NOPICKS = [];
/* A sits / interacts, and confirms a line only after D-pad selects it.
   X/Y never auto-answer prompts. B is the way out. */
const PAD_GLYPH = [];
let PICKS = NOPICKS, PICK = -1, pickKey = "";
/* Everything you could click, in the order you would read it. With a card
   up that is the card; in a conversation it is the whole conversation and
   the bar under it; otherwise it is the room's own controls — where to go,
   the phone, save, settings, and the panel you are reading. */
function promptLive(){
  const pr = el("prompt");
  return !!(pr && !pr.hidden && pr.classList.contains("is-live"));
}
let _tabsEl = null, _paneOn = null;
function pickScopes(){
  if(!veil.hidden) return [card];
  if(TALK.open) return [el("talk")];
  const pr = el("prompt");
  /* Live glass prompt: D-pad / picks are prompt buttons only — never travel/dossier mix */
  if(pr && !pr.hidden && pr.classList.contains("is-live")) return [pr];
  const out = [];
  const pb = el("procBar");
  if(pb && !pb.hidden) out.push(pb);
  out.push(el("travel"));
  /* Cache dossier tabs/pane until markPicks — MutationObserver already dirties picks. */
  if(!_tabsEl) _tabsEl = document.querySelector(".tabs");
  if(picksDirty || !_paneOn || !_paneOn.classList.contains("is-on")){
    _paneOn = document.querySelector(".pane.is-on") || null;
  }
  if(_tabsEl) out.push(_tabsEl);
  if(_paneOn) out.push(_paneOn);
  out.push(el("speed"));
  return out.filter(Boolean);
}
/* The list is only re-read when the panel underneath it actually changes.
   A MutationObserver tells us when that happens for nothing, where a
   querySelectorAll every frame would cost real time. */
let picksDirty = true;
function markPicks(){ picksDirty = true; _tabsEl = null; _paneOn = null; }
if(window.MutationObserver){
  const mo = new MutationObserver(markPicks);
  mo.observe(card, {childList:true, subtree:true});
  mo.observe(el("chatSuggest"), {childList:true, subtree:true});
  mo.observe(veil, {attributes:true, attributeFilter:["hidden"]});
  const travel = el("travel"); if(travel) mo.observe(travel, {childList:true, subtree:true});
  const tk = el("tkActs"); if(tk) mo.observe(tk, {childList:true, subtree:true});
  const prn = el("prompt"); if(prn) mo.observe(prn, {childList:true, subtree:true, attributes:true, attributeFilter:["hidden","class"]});
  const pbar = el("procBar"); if(pbar) mo.observe(pbar, {childList:true, subtree:true, attributes:true, attributeFilter:["hidden"]});
}
let pickKeyCheap = "";
let NUMS = [];
function refreshPicks(){
  const pr = el("prompt");
  const live = !!(pr && !pr.hidden && pr.classList.contains("is-live"));
  /* Cheap key first — avoid querySelectorAll on the hot path when nothing changed. */
  let gpSig = "-";
  if(live){
    gpSig = "L:" + (CATCH.on ? ("c:" + (CATCH.current ? CATCH.current.key : "done") + ":" + ((CATCH.pieces&&CATCH.pieces.length)||0)) : ("p:" + (promptKey||"")));
  } else if(!veil.hidden){
    gpSig = "card:" + (phoneWasRunning !== null ? ("ph:"+phoneTab) : "veil");
  } else if(TALK.open){
    gpSig = "talk";
  }
  const keyCheap = (veil.hidden ? "0" : "1") + "|" + (TALK.open ? "1" : "0") + "|" + (uiOpen() ? "1" : "0") + "|" + gpSig;
  if(!picksDirty && keyCheap === pickKeyCheap) return;
  /* Catch/prompt identity in pickKey so rebuilds with the same buttons do not thrash */
  if(live){
    gpSig += "|" + [...pr.querySelectorAll("button.prompt__btn")].map(b => b.getAttribute("data-gp")||"").join(",");
  }
  const key = keyCheap + (live ? ("#" + gpSig) : "");
  /* Remember selection across DOM rebuilds (data-gp on prompt buttons) */
  let keepGp = null;
  if(PICK >= 0 && PICKS[PICK]) keepGp = PICKS[PICK].getAttribute("data-gp");
  const prevPick = PICK;
  const sameSet = (key === pickKey);
  if(!picksDirty && sameSet){ pickKeyCheap = keyCheap; return; }
  picksDirty = false; pickKey = key; pickKeyCheap = keyCheap;
  PICKS.forEach(b => b.classList.remove("is-pick"));
  const out = [];
  for(const sc of pickScopes()){
    const q = (live && sc === pr) ? "button.prompt__btn" : "button, .sugg, .mk__opt, [data-ans], [data-mail], .tabs button";
    sc.querySelectorAll(q).forEach(b => {
      if(b.disabled || b.hidden) return;
      if(b.id === "uiOpenBtn" || b.id === "uiMapBtn" || b.id === "unBare") return;
      if(!b.offsetParent && b.offsetHeight === 0) return;   /* not on screen */
      if(out.indexOf(b) < 0) out.push(b);
    });
  }
  PICKS = out.length ? out : NOPICKS;
  /* Number badges 1–9 for quick answers (keyboard + visible on pad). */
  const _pb = el("procBar");
  const _numOK = !veil.hidden || TALK.open || live || (_pb && !_pb.hidden);
  NUMS = _numOK ? PICKS.filter(b => !b.closest(".tabs") && !b.closest("#travel") && !b.closest(".mk") && !b.matches("[data-edit], .swatch, .tk-nonum, #tkOwn button, #wire button, .mk__sw, .mk__opt[data-set]") && !/^(close|back|×|✕)$/i.test((b.textContent || "").trim())) : [];
  document.querySelectorAll("[data-btn]").forEach(b => { delete b.dataset.btn; });
  NUMS.forEach((b, i) => { if(i < 9) b.dataset.btn = String(i + 1); });
  /* Preserve selection: never wipe PICK on an identical button set; re-apply is-pick by data-gp */
  let restored = -1;
  if(keepGp != null){
    const ix = PICKS.findIndex(b => b.getAttribute("data-gp") === keepGp);
    if(ix >= 0) restored = ix;
  }
  if(restored < 0 && sameSet && prevPick >= 0 && prevPick < PICKS.length) restored = prevPick;
  if(restored >= 0){
    PICK = restored;
    PICKS[PICK].classList.add("is-pick");
  } else {
    PICK = -1;
  }
}
function movePick(d){
  if(!PICKS.length) return;
  PICKS.forEach(b => b.classList.remove("is-pick"));
  PICK = PICK < 0 ? (d > 0 ? 0 : PICKS.length-1) : (PICK + d + PICKS.length) % PICKS.length;
  const b = PICKS[PICK];
  b.classList.add("is-pick");
  if(b.scrollIntoView) b.scrollIntoView({block:"nearest"});
}
function firePick(){
  const b = PICKS[PICK];
  if(!b) return false;
  b.classList.remove("is-pick");
  PICK = -1; picksDirty = true;
  b.click();
  return true;
}
/* Out of whatever is nearest, one layer at a time: a note, then the
   phone, then a conversation, then a card that can be dismissed. If
   there is nothing to leave, B puts the display back. */
/* A line along the bottom of the view saying what each button does
   right now — it changes with what is in front of you, and it is only
   there when a pad actually is. */
let legendWas = "";
function padLegend(on){
  const box = el("padBar");
  if(!box) return;
  document.body.classList.toggle("has-pad", !!on);
  document.body.classList.toggle("in-session", !!(PROC && PROC.on));
  /* Pad legend stays up whenever a pad is connected — including while CATCH / glass prompts are live */
  if(!on){ if(!box.hidden){ box.hidden = true; legendWas = ""; } return; }
  const n2 = PICKS.length;
  const bits = [];
  const glass = promptLive();
  const phoneOpen = !veil.hidden && phoneWasRunning !== null;
  const asked = !veil.hidden || TALK.open || (PROC.on && PROC.phase === "you") || glass;
  const focus = !asked && focusThing();
  /* Prompts are only armed after D-pad moves onto them; A confirms. */
  const canDeliver = CATCH.on && CATCH.pieces && CATCH.pieces.length && !CATCH.current;
  const seatVoice = !canDeliver && !CATCH.current && (typeof seatVoiceAvailable === "function") && seatVoiceAvailable();
  bits.push(["A", (CATCH.on && CATCH.current) ? "take this line"
           : canDeliver ? "deliver speech"
           : seatVoice ? (PICK >= 0 && PICKS[PICK] ? "confirm seated #" + (PICK+1) : "D-pad a seated line")
           : glass && PICK >= 0 && PICKS[PICK] ? "confirm prompt #" + (PICK+1)
           : glass && n2 === 1 ? "confirm prompt"
           : phoneOpen ? (PICK >= 0 && PICKS[PICK] ? "confirm #" + (PICK+1) : "D-pad / stick a button")
           : focus ? (focus.type === "person" ? "speak to " + surname(focus.ref.name) : (focus.ref && focus.ref.id === "desk" && !G.you.sitting ? "sit at desk" : "use " + focus.ref.label))
           : PICK >= 0 && PICKS[PICK] ? "confirm #" + (PICK+1)
           : (nearOfficeDesk && nearOfficeDesk()) ? (G.you.sitting ? "stand" : "sit at desk")
           : seatUnderYou() ? (G.you.sitting ? "stand" : "sit")
           : n2 ? "D-pad / 1–9 a line"
           : "speak / use"]);
  if(phoneOpen) bits.push(["LT·RT", "phone tabs"]);
  else if(CATCH.on && CATCH.current) bits.push(["LT·RT", "browse speech / interview"]);
  else if(canDeliver) bits.push(["LT·RT", "deliver pieced speech"]);
  else if(seatVoice) bits.push(["LT·RT", "cycle seated voice"]);
  if(phoneOpen) bits.push(["L-stick", "move cursor"]);
  if(n2) bits.push(["✛", PICK >= 0 ? ("#" + (PICK+1) + "/" + n2) : "choose 1–" + Math.min(9, n2)]);
  bits.push(["X", "day schedule"]);
  bits.push(["hold X", "speak aloud"]);
  bits.push(["Y", "phone"]);
  bits.push(["B", !el("tipCard").hidden ? "close" : !veil.hidden ? "put it away"
                : TALK.open ? "leave it" : uiOpen() ? "back to room"
                : (CATCH.on || glass) ? "back out of speech" : "clear / back"]);
  bits.push(["LB RB", phoneOpen ? (phoneTab === "panels" ? "house tabs / apps" : "phone apps") : "panels"]);
  const html = bits.map(b => '<span><b>' + b[0] + '</b>' + b[1] + '</span>').join("");
  if(html !== legendWas){ legendWas = html; setHTML(box, html); }
  box.hidden = false;
}
function clearSpeechBusy(reason){
  /* Peel stuck CATCH / approach / glass so B and Esc always free you */
  const wasSpeech = !!(CATCH.on || CATCH.current || (CATCH.pieces && CATCH.pieces.length) ||
    CATCH.armedByInteract || G.speechApproach || (typeof promptLive === "function" && promptLive()));
  try{ G.speechApproach = null; }catch(e){}
  /* Only mark suppressed when backing out of real speech UI — not when peeling phone/panels */
  const why = (reason === "back" || reason === "esc") && wasSpeech ? "back"
            : reason === "busy" && wasSpeech ? "back"
            : (reason || "busy");
  try{ catchClear(why === "back" ? "back" : "busy-clear"); }catch(e){}
  try{
    promptKey = "";
    const pr = el("prompt");
    if(pr){ pr.classList.remove("is-catch"); }
    /* If still in a live sitting and seated, let updatePrompt redraw seat voice */
    if(!(PROC.on && G.you && G.you.sitting && SEATED_ROOMS[G.room])){
      setGlassPrompt(null, null);
    }
  }catch(e){}
  picksDirty = true;
}
function padBack(){
  /* B always wins: peel one layer, then covering UI, then hard-reset busy state to the room */
  const tip = el("tipCard");
  if(tip && !tip.hidden){ closeTip(); return; }
  if(!veil.hidden && phoneWasRunning !== null){ phoneClose(); return; }
  if(TALK.open){ closeTalk(); return; }
  if(!veil.hidden){
    /* a card with a plain way out takes it; a card that must be answered
       is left alone, because that is the point of it */
    const outs = [...card.querySelectorAll(".btn, .conc__btn")].filter(b =>
      !b.disabled && /back to it|leave it|close|not now|later|done|start the day|put it away|fold it|stay here/i.test(b.textContent));
    if(outs.length){ outs[outs.length - 1].click(); return; }
    return;
  }
  if(uiOpen()){ closePanels(); resetPlayerBusy(); return; }
  if(PROC.on){ leaveSittingQuiet(); return; }
  /* Stuck in CATCH / speech glass / approach — B backs all the way out */
  if(CATCH.on || CATCH.current || (CATCH.pieces && CATCH.pieces.length) || CATCH.armedByInteract || G.speechApproach || promptLive()){
    clearSpeechBusy("back");
    feed("Back out of the speech prompt.");
    try{ if(typeof updatePrompt === "function"){ const seat = seatUnderYou(); updatePrompt(focusThing(), null, seat); } }catch(e){}
    return;
  }
  /* Already on the main screen — clear whatever the character was doing */
  resetPlayerBusy();
}
/* the shoulders move through the panels */
function padTab(d){
  /* Phone open: LB/RB walk phone apps accurately (Day / House / Vox / …).
     House panels tab: then walk dossier tabs inside. Otherwise open House panels. */
  const phoneOpen = !veil.hidden && phoneWasRunning !== null;
  if(phoneOpen){
    if(phoneTab === "panels"){
      const tabs = [...document.querySelectorAll(".dossier .tabs button")];
      if(tabs.length){
        let i = tabs.findIndex(b => b.classList.contains("is-on"));
        if(i < 0) i = 0;
        const atEnd = (d > 0 && i === tabs.length - 1) || (d < 0 && i === 0);
        if(!atEnd){
          tabs[(i + d + tabs.length) % tabs.length].click();
          picksDirty = true;
          return;
        }
      }
      /* Fall off either end of dossier tabs → neighbouring phone app */
      phoneCycleTab(d);
      return;
