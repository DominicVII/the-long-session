      const primary = card.querySelector(".card__actions .btn:not(.btn--ghost):not([data-noenter])") || card.querySelector(".card__actions .btn:not([data-noenter])") || PICKS[0];
      const ix = primary ? PICKS.indexOf(primary) : 0;
