      const g = m.kind === "member" ? "Members" : m.kind === "press" ? "Press" : m.kind === "envoy" ? "Foreign missions" : m.kind === "civ" ? "Citizens & neighbours" : /aide|staff|clerk|secretary/i.test(m.role || "") ? "Staff & aides" : "Others";
