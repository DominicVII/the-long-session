  function chatBox(){
    let C = document.getElementById("ltChat"); if(C) return C;
    C = document.createElement("div"); C.id = "ltChat"; C.hidden = true;
    C.innerHTML = '<div class="ltc-top"><b>Chat</b><select id="ltcTo"></select><span id="ltcBadge" class="ltc-badge"></span><button type="button" id="ltcX">Close</button></div><div class="ltc-log" id="ltcLog"></div><div class="ltc-row"><input id="ltcIn" maxlength="500" placeholder="Say something…"><button type="button" id="ltcSend">Send</button></div>';
    document.body.appendChild(C);
    ["keydown","keyup","keypress","mousedown","pointerdown","wheel"].forEach(ev => C.addEventListener(ev, e => e.stopPropagation(), {passive:ev === "wheel"}));
    C.querySelector("#ltcX").onclick = () => chatClose();
    C.querySelector("#ltcTo").onchange = e => { LT.chatTo = e.target.value; LSS("chatTo", LT.chatTo); chatPaint(); };
    const send = async () => { const i = C.querySelector("#ltcIn"), t = i.value.trim(); if(!t || LT.cbusy) return; i.value = "";
      const c = contacts().find(x => x.id === LT.chatTo) || contacts()[0]; const m = c.m;
      const log = C.querySelector("#ltcLog"); const me = document.createElement("div"); me.className = "ltc-m ltc-you"; me.innerHTML = "<b>You</b><span></span>"; me.lastChild.textContent = t; log.appendChild(me);
      const r0 = document.createElement("div"); r0.className = "ltc-m lt-typing"; r0.innerHTML = "<b></b><span>…</span>"; r0.firstChild.textContent = m.kind === "aide" ? m.name + " (chief of staff)" : m.name; log.appendChild(r0); log.scrollTop = 1e9;
      LT.cbusy = 1;
      try{ const r = await reply({npc:m, channel:m.kind === "aide" ? "aide" : m.kind === "envoy" ? "cable" : "dm", text:t, extra:m.kind === "aide" ? "FACTS ABOUT THE PLAYER'S POSITION (true, from the game): " + offAide("bill vote numbers money schedule mail gossip rival") : ""}, ).catch(() => null);
        r0.lastChild.textContent = r ? r.text : "…"; gloss(r0); }
      finally{ LT.cbusy = 0; r0.classList.remove("lt-typing"); log.scrollTop = 1e9; }
    };
    C.querySelector("#ltcSend").onclick = send; C.querySelector("#ltcIn").addEventListener("keydown", e => { if(e.key === "Enter"){ e.preventDefault(); send(); } if(e.key === "Escape") chatClose(); });
    return C;
