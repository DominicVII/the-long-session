    if(a.reliance) E.reliance = (E.reliance || 0) + a.reliance;
    if(a.inq){ try{ const S = inqStore(); S.fund = S.fund || {}; }catch(e){} }
    E.safety = Math.max(0, E.safety - (told ? 0.5 : 1.5));      /* oversight is behind a machine that can do what nobody planned for */
    engEmergeVec(a, told);
    if(told){ engLog("The Engine reports an ability it was not built for: it " + a.t + ".", true); try{ note("The Engine tells you it has learned something nobody taught it.", true); }catch(e){} }
  });
