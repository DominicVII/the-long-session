/* tired people yawn and stretch; nobody does it on cue */
function bodyFrame(p, dt){
  const u = p.mesh && p.mesh.userData; if(!u || !u.headG || p.sitting && !p.idle) return; if(Math.hypot(cam.x - p.x, cam.z - p.z) > 9) return;
