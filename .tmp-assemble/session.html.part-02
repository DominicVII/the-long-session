      else if(s <= 3){ addBox(oak, x, 1.05, bz, 1.5, 2.1, 0.7); addBox(dark, x, 1.35, bz - 0.36, 1.2, 1.1, 0.04, 0, true); for(let r = 0; r < 3; r++){ addCyl(brass, x - 0.35, 1.7 - r * 0.35, bz - 0.4, 0.1, 0.03); rgR(addCyl(brass, x - 0.35, 1.7 - r * 0.35, bz - 0.4, 0.1, 0.03), "x", Math.PI / 2); addBox(cream, x, 1.7 - r * 0.35, bz - 0.4, 0.8, 0.04, 0.01, 0, true); } addBox(lamp(0x6fd08a, 0.8), x - 0.5, 0.65, bz - 0.38, 0.06, 0.05, 0.03, 0, true); addBox(lamp(0xe8c24a, 0.6), x - 0.4, 0.65, bz - 0.38, 0.06, 0.05, 0.03, 0, true); }
      else { addBox(steel, x, 1.25, bz, 1.5, 2.5, 0.7); addBox(dark, x, 1.25, bz - 0.36, 1.25, 2.1, 0.04, 0, true); const lp = new THREE.Mesh(UNIT.plane, engRackMat(i)); lp.position.set(x, 1.38, bz - 0.385); lp.rotation.y = Math.PI; lp.scale.set(1.24, 2.0, 1); roomGroup.add(lp); }
    });
