    } }catch(e){}

  /* the pocketbook card */
  function css(){ if(document.getElementById("ndPbCss")) return; const st = document.createElement("style"); st.id = "ndPbCss";
    st.textContent = "#ndPb{position:fixed;inset:0;z-index:10050;background:rgba(0,0,0,.72);display:flex;align-items:center;justify-content:center}" +
      "#ndPb .pb{background:#14161b;color:#f4f1e8;border:2px solid #c9a24a;border-radius:8px;width:min(560px,94vw);max-height:90vh;overflow:auto;padding:12px 16px;font:14px/1.35 system-ui,sans-serif;box-shadow:0 10px 40px #000}" +
      "#ndPb h2{margin:0 0 6px;font:700 19px Georgia,serif;color:#ffe08a;display:flex;justify-content:space-between;align-items:center}#ndPb button{background:#2a2d35;color:#fff;border:1px solid #6b6f7a;border-radius:4px;cursor:pointer;font:13px system-ui;padding:3px 9px}#ndPb button:hover{border-color:#ffe08a}" +
