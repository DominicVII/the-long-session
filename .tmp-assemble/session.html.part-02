/* the wire, as one quiet line above the bottom bar: the newest headline, then the next, every few seconds. Click it for the Ledger. */
(function(){
  let el0 = null, i = 0, last = "";
  const mk = () => { if(el0 && el0.isConnected) return el0; el0 = document.createElement("div"); el0.id = "hmWire"; el0.title = "The wire. Click to read the Ledger.";
    el0.style.cssText = "position:fixed;left:8px;right:8px;z-index:10049;background:#12151a;color:#d8d2bf;border:1px solid #3a424d;border-radius:6px;padding:3px 10px;font:12px/1.3 system-ui,sans-serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;opacity:.95";
    el0.addEventListener("click", () => { try{ if(G.you && veil.hidden) paperCard(); }catch(e){} }); document.body.appendChild(el0); return el0; };
  const place = () => { const w = mk(); const tops = ["hmBar", "ndFd"].map(id => document.getElementById(id)).filter(e => { if(!e || e.hidden || (e.closest && e.closest("#sxDock"))) return false; const cs = getComputedStyle(e), r = e.getBoundingClientRect(); return cs.display !== "none" && cs.visibility !== "hidden" && r.width > 0 && r.height > 0; }).map(e => e.getBoundingClientRect().top); const top = tops.length ? Math.min.apply(null, tops) : innerHeight; w.style.bottom = Math.max(4, Math.round(innerHeight - top + 4)) + "px"; };
  const tick = () => { try{ const w = mk(); if(!G || !G.running || !G.you || !veil.hidden){ w.style.display = "none"; return; } let H = []; try{ H = makeHeadlines(); }catch(e){} if(!H.length){ w.style.display = "none"; return; } w.style.display = "block"; const h = H[i++ % H.length]; const txt = String(h[0]).toUpperCase() + "  " + String(h[1]).replace(/<[^>]+>/g, ""); if(txt !== last){ w.innerHTML = '<b style="color:#c9a24a;letter-spacing:.12em;font-size:10px;margin-right:8px">THE WIRE</b>'; w.appendChild(document.createTextNode(String(h[0]).toUpperCase() + "  " + String(h[1]).replace(/<[^>]+>/g, ""))); last = txt; } place(); }catch(e){} };
