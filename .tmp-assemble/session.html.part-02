  if(k === "senate"){ p = (O.up[y.state] || []).filter(x => x.status === "open").sort((a, b) => a.day - b.day)[0]; if(p && y.influence >= 4){ y.influence -= 4; orgRefer(p, true); msg = "You raise " + p.townName + "'s petition for " + orgNeedLabel(p.need) + " with the committee. It goes up as a priority."; } else msg = p ? "You are short of influence." : "Nothing is stuck in your state."; }
  else if(k === "pres"){ p = O.fed.filter(x => x.status === "open").sort((a, b) => b.cost - a.cost)[0]; if(p){ orgFund(Object.assign(p, {status:"open"}), "congress"); y.approval = clamp(y.approval + 1, 0, 100); msg = "You release federal aid to " + p.townName + " for " + orgNeedLabel(p.need) + " (" + curF(p.cost) + "), without waiting for an act."; reactEmit("foreign", {k:"reach", verb:"trade"}); } else msg = "Nothing has reached the capital."; }
