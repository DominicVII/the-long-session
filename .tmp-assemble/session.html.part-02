/* ── you can always just say it: a line to type into, and a microphone, whoever you are talking to; the buttons are things you can do, not the only things you can say ── */
const TKOWN_BUSY = {};
function tkOwnMount(m){
  const T = el("talk"); if(!T) return; let box = el("tkOwn");
  if(!box){
    box = document.createElement("div"); box.id = "tkOwn"; box.style.cssText = "display:flex;gap:6px;margin:8px 0 4px;align-items:center";
    box.innerHTML = '<input id="tkOwnIn" type="text" maxlength="400" autocomplete="off" placeholder="Say it in your own words…" style="flex:1;min-width:0;padding:7px 9px;border:1px solid var(--line-soft,#555);border-radius:4px;background:rgba(0,0,0,.25);color:inherit"><button type="button" class="btn" id="tkOwnGo">Say it</button><button type="button" class="btn btn--ghost" id="tkOwnMic" title="Speak aloud (or hold V)">🎤</button>';
    const anchor = el("tkNote") || el("tkActs"); if(anchor && anchor.parentNode) anchor.parentNode.insertBefore(box, anchor); else T.appendChild(box);
    ["keydown", "keyup", "keypress"].forEach(k => box.addEventListener(k, e => e.stopPropagation()));
    /* a line is only taken from the box when it can be sent: a second one typed while the first is being answered stays where it is */
    const send = () => { const i = el("tkOwnIn"), t = (i.value || "").trim(); if(!t || !TALK.open || !TALK.m || TKOWN_BUSY[TALK.m.id]) return; i.value = ""; tkOwnSay(TALK.m, t); };
    el("tkOwnGo").addEventListener("click", send);
    el("tkOwnIn").addEventListener("keydown", e => { if(e.key === "Enter"){ e.preventDefault(); send(); } else if(e.key === "Escape"){ e.preventDefault(); const i = el("tkOwnIn"); if(i.value.trim()){ i.blur(); } else { i.blur(); try{ closeTalk(); }catch(x){} } } });
    /* a key you were holding when the box took focus never sends its release to the walk, so let go of everything as the box is entered */
    el("tkOwnIn").addEventListener("focus", () => { try{ for(const k in keys) keys[k] = false; }catch(e){} });
    el("tkOwnMic").addEventListener("click", () => { try{
      if(typeof listening !== "undefined" && listening){ micStop(); el("tkOwnMic").classList.remove("is-live"); return; }
      if(!micReady()){ aloudFallback("This browser cannot listen."); try{ el("tkOwnIn").focus(); }catch(e){} return; }
      micStart(); el("tkOwnMic").classList.toggle("is-live", !!listening);
      const poll = setInterval(() => { try{ if(typeof listening === "undefined" || !listening || !TALK.open){ const b = el("tkOwnMic"); if(b) b.classList.remove("is-live"); clearInterval(poll); } }catch(e){ clearInterval(poll); } }, 400);
    }catch(e){} });
  }
  box.hidden = false; try{ const c = el("chat"); if(c) c.hidden = false; }catch(e){}
