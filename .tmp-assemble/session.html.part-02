      for(let k = 0; k < 6; k++){
        const r = seedRng((npc.id || npc.name) + ":" + Date.now() + ":" + Math.random() + ":" + k);
        const want = wantOf(st, v, r), text = buildText(npc, ctx, v, st, want, r);
