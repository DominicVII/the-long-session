  if(G.you && spd > 0.15) G.you.energy = clamp(G.you.energy - dt*0.34*(spd/1.8), 0, 100);
  if(G.t >= (G.doorGrace||0)) walkThroughDoors();
  if(!G.moving && G.t >= (G.doorGrace||0) && ((FRAME_ID & 3) === 0 || spd < 0.08)) bumpCheck(sprint);
