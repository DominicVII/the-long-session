}
function wanderFrame(dt){
  if(!G.running || G.pendingNight) return;
  const list = hereNow();
  for(let i = 0; i < list.length; i++){
    const m = list[i];
    if(!m || m.gone) continue;
    try{ wander(m, dt); }catch(e){}
  }
}
function drainHouseOne(w, dt){
  /* One House mind per premise beat. Not the frame.
     20261001a: bail if this premise pulse already paid >3.5ms (keep one unit max). */
  const t0 = performance.now();
  if((G._premSpent || 0) > 3.5){ return; }
  if(G._drainLane == null) G._drainLane = 0;
  const lane = (G._drainLane++) % 13;
  if(lane === 0) sentWorld(w);
  else if(lane === 1) clockRoom(w);
  else if(lane === 2) crowdWatch(dt);
  else if(lane === 3) voxTick(w);
  else if(lane === 4){ autonomyTick(w); try{ agTick(); }catch(e){} }
  else if(lane === 5){
    try{
      const h = Math.floor((G.minute || 0) / 60);
      if(!inHall()) consularBody(h);
    }catch(e){}
  } else if(lane === 6){
    try{ realmTick(); }catch(e){}
  } else if(lane === 7){
    try{
      const live = G.members || [];
      if(live.length){
        const m = live[(FRAME_ID || 0) % live.length];
        if(m && m.room === G.room) agiStep(m);
      }
    }catch(e){}
  } else if(lane === 8){
    try{ tickWanderBatch(w); }catch(e){}
  } else if(lane === 9){
    try{ confabulate(w); }catch(e){}
    try{ purseLive(w); }catch(e){}
    try{ kAmbient(); }catch(e){}
    try{ orgTick(); }catch(e){}
    try{ nearGreet(); }catch(e){}
    try{ stdTick(); }catch(e){}
    try{ stdLive(); }catch(e){}
    try{ lifeTick(); }catch(e){}
    try{ wallWatch(); }catch(e){}
  } else if(lane === 10){
    try{ tieTick(w); }catch(e){}
  } else if(lane === 11){
    try{ chamberDebate(w); }catch(e){}
  } else {
    try{
      const live = G.members || [];
      if(live.length){
        const a = live[(FRAME_ID || 0) % live.length];
        ledgerTick(a);
        const b = live[((FRAME_ID || 0) * 5) % live.length];
        if(b) ledgerEnsure(b);
      }
    }catch(e){}
  }
  G._premSpent = (G._premSpent || 0) + (performance.now() - t0);
}
function markRenderDirty(){ try{ G._renderDirty = true; }catch(e){} }
const PREMISE = { hz: 10, last: 0, timer: 0 };
function premisePulse(){
  /* System A. Does not draw. Does not know the window exists.
     Hidden tab still ticks — catch-up is capped so a return is not a flush. */
  if(!G || !G.you) return;
  if(G.pendingNight) return;
  if(PROC && PROC.on) return;
  try{
    if(G._bootGraceUntil && performance.now() < G._bootGraceUntil) return;
  }catch(e){}
  const now = performance.now();
  const hidden = (typeof document !== "undefined" && document.hidden);
  /* the day used to run on behind any card (the handbook, the morning plan, the night card's own
     replacement) and in a background tab: twelve minutes away was 4:30 PM to ten o'clock, and the
     night card then painted over whatever you were reading. Nothing passes while you are not in the room. */
  if(!G.running || hidden || G._pauseOpen || (typeof veil !== "undefined" && veil && !veil.hidden)){ PREMISE.last = now; return; }
  const raw = PREMISE.last ? Math.min(0.2, (now - PREMISE.last) / 1000) : 0.1;
  PREMISE.last = now;
  G._premSpent = 0;
  const w = raw * (G.speed || 1);
  try{
    if(!TALK.open && w > 0) spend(w * DAY_RATE, 0);
  }catch(e){}
  try{ drainHouseOne(w, raw); }catch(e){}
  if((G._premSpent || 0) < 2.5){
    try{ drainHouseOne(w, raw); }catch(e){}
  }
}
function armPremise(){
  if(PREMISE.timer) return;
  PREMISE.timer = setInterval(function(){
    try{ premisePulse(); }catch(e){}
  }, 100);
}
function renderRead(){
  /* System B. Reads. Never writes a ledger. Room builds are rare, never every frame.
