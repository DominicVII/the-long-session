    x += bw + 2 + r() * 14; }
  const dx = W * 0.5; g.fillStyle = "#8a8f90"; g.fillRect(dx - 90, ground - 46, 180, 46); g.fillStyle = "#a0a5a5"; for(let i = -80; i <= 70; i += 20) g.fillRect(dx + i, ground - 42, 6, 38);
  g.fillStyle = "#b4b8b8"; g.beginPath(); g.ellipse(dx, ground - 52, 44, 52, 0, Math.PI, 0); g.fill(); g.fillRect(dx - 44, ground - 54, 88, 8); g.fillStyle = "#8e9494"; g.fillRect(dx - 12, ground - 124, 24, 28); g.beginPath(); g.moveTo(dx - 14, ground - 124); g.lineTo(dx, ground - 156); g.lineTo(dx + 14, ground - 124); g.fill();
  [[W * 0.22, 118], [W * 0.78, 132]].forEach(a => { g.fillStyle = "#6e7474"; g.fillRect(a[0] - 8, ground - a[1] + 30, 16, a[1] - 30); g.beginPath(); g.moveTo(a[0] - 10, ground - a[1] + 30); g.lineTo(a[0], ground - a[1] - 22); g.lineTo(a[0] + 10, ground - a[1] + 30); g.fill(); });
  g.globalCompositeOperation = "destination-out"; const fd = g.createLinearGradient(0, H - 70, 0, H); fd.addColorStop(0, "rgba(0,0,0,0)"); fd.addColorStop(1, "rgba(0,0,0,.95)"); g.fillStyle = fd; g.fillRect(0, 0, W, H);
  return VST.tex.sky2 = vTex(c, 0);
}
function vGrassTexture(){
  if(VST.tex.grass) return VST.tex.grass; const S = 256, c = vCanvas(S, S), g = c.getContext("2d"), r = vRng(3); g.fillStyle = "#d9d9d2"; g.fillRect(0, 0, S, S);
  for(let i = 0; i < 2600; i++){ const l = 170 + Math.floor(r() * 80), gr = l + Math.floor(r() * 18); g.fillStyle = "rgba(" + l + "," + gr + "," + (l - 20) + ",.38)"; g.fillRect(r() * S, r() * S, 1 + r() * 2.2, 2 + r() * 5); }
  for(let i = 0; i < 40; i++){ g.fillStyle = "rgba(255,255,230,.18)"; g.beginPath(); g.arc(r() * S, r() * S, 4 + r() * 12, 0, 6.3); g.fill(); }
