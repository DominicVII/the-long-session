    else {
      const sal = +B.salary || 0, rent = +B.rentOrMortgage || 0, net = sal - rent, days = rent > 0 ? Math.floor((+B.savings || 0) / rent) : null;
      const rentWord = H && H.ownedOrRented === "owned" ? "Mortgage" : "Rent";
