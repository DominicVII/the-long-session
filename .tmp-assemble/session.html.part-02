}
function cityClear(){ if(CITY.grp){ if(CITY.grp.parent) CITY.grp.parent.remove(CITY.grp); CITY.grp = null; CITY.room = null; } }
function cityNight(n){ try{ if(CITY.mats) CITY.mats.walls.forEach(w => { w.emissiveIntensity = n * 1.15; }); }catch(e){} }
/* ══ 20261016i · gateways, not floating doors: the outdoor doors are now arches and a State House front, people are kept out of walls, and strangers talk through what they understand ══ */
const GATE = {grp:null, room:null, tex:{}};
function gatePlate(a, b){
  const k = a + "|" + b; if(GATE.tex[k]) return GATE.tex[k]; const c = vCanvas(512, 128), g = c.getContext("2d");
  g.fillStyle = "#1d2a22"; g.fillRect(0, 0, 512, 128); g.strokeStyle = "#c9a24a"; g.lineWidth = 4; g.strokeRect(8, 8, 496, 112);
  g.fillStyle = "#e3c06a"; g.textAlign = "center"; g.textBaseline = "middle"; g.font = "bold 46px Georgia, 'Times New Roman', serif"; g.fillText(a, 256, 52); g.font = "italic 26px Georgia, serif"; g.fillStyle = "#cdb98a"; g.fillText(b, 256, 94);
  const t = new THREE.CanvasTexture(c); try{ t.encoding = THREE.sRGBEncoding; }catch(e){} return GATE.tex[k] = t;
}
function gateAdd(g, mat, x, y, z, w, h, d, ry){ const m = new THREE.Mesh(UNIT.box, mat); m.position.set(x, y, z); m.scale.set(w, h, d); if(ry) m.rotation.y = ry; m.castShadow = false; m.receiveShadow = true; g.add(m); return m; }
function gateArch(g, x, z, dirZ, gap, wingHalf, wallH, title, sub){
