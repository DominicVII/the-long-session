    }
  } else if(_movePrOn){
    try{ setPR(_movePrSaved || GFX_PR); }catch(e){}
    _movePrOn = false;
  }
  if(!playerMoving) matChkT -= dt;
  if(!playerMoving && matChkT <= 0 && !MODEST){
    const crowdN = peopleGroup ? peopleGroup.children.length : 0;
    matChkT = crowdN > 6 ? (MODEST ? 1.6 : 0.9) : (MODEST ? 1.1 : 0.55);
    const list = hereNow();
    /* Round-robin a few bodies per tick — full scan every frame was wasted work. */
    const step = Math.max(1, Math.ceil(list.length / 4));
    const start = (matChk|0) % Math.max(1, list.length);
    for(let i=0;i<list.length;i+=step){
      const p = list[(start + i) % list.length];
      const g = p && p.mesh;
      if(!g || g.parent !== peopleGroup) continue;
      const e = g.matrixWorld.elements;
      let bad = false;
      for(let j = 0; j < 16; j++) if(!isFinite(e[j])){ bad = true; break; }
      if(!bad){
        const sx = Math.hypot(e[0], e[1], e[2]), sy = Math.hypot(e[4], e[5], e[6]);
        if(sx < 1e-4 || sy < 1e-4) bad = true;
      }
      if(bad){
        g.matrixAutoUpdate = true;
        g.updateMatrixWorld(true);
        g.traverse(o => {
          o.matrixAutoUpdate = true;
          if(o.isSkinnedMesh && o.skeleton) o.skeleton.update();
        });
        matChk++;
      }
    }
    if(matChk > matChkSaid && matChk % 8 === 1){
      matChkSaid = matChk;
      feed("A body was drawing wrong and has been put right.");
    }
  }
  /* the head keeps living even when the feet stop: bob under stride,
     a slow breath at rest, and a lean into the turn */
  cam.drift = smooth(cam.drift, 0, 0.2, dt);
  const breath = Math.sin(G.t*0.72)*0.0085 + Math.sin(G.t*1.63)*0.0035;
  const sway = Math.sin(cam.bob*0.5)*0.011*cam.speed;
  /* seated, your eye is where a seated eye is — otherwise you are
     standing inside the desk in front of you and the whole view is the
     flat side of it */
  const eye = sitEye();
  cam.eye = cam.eye === undefined ? eye : smooth(cam.eye, eye, 0.004, dt);
  camera.position.set(
    cam.x + Math.cos(cam.yaw)*sway,
    cam.eye + Math.sin(cam.bob)*0.026*cam.speed + breath + cam.drift,
    cam.z - Math.sin(cam.yaw)*sway
