function bodyWord(b){ const w = []; if(b.hunger > 0.85) w.push("hungry"); else if(b.hunger > 0.6) w.push("peckish"); if(b.tired > 0.95) w.push("worn out"); else if(b.tired > 0.75) w.push("tired"); return w.join(" and ") || "fine"; }
function bodyClock(abs){ const mn = ((abs % 1440) + 1440) % 1440, hh = Math.floor(mn / 60), mm = Math.floor(mn % 60); return (hh % 12 || 12) + ":" + String(mm).padStart(2, "0") + (hh >= 12 ? "pm" : "am"); }
/* people eat where people eat: the members' dining room off the floor, the diner, their own kitchens */
const BODY_EATS = {cloak:1, district:1, away:1, abroad:1, steps:0.4, press:0.5, office:0.3};
function bodyTick(){
  try{
    if(!G || !G.running || !G.you) return; const now = bodyNow(); if(BODY.last >= 0 && now - BODY.last < 10) return; BODY.last = now;
    const h = (G.minute || 0) / 60, meal = (h >= 11.6 && h < 14.2) || (h >= 18.3 && h < 20.8);
    if(meal) everyone().forEach(m => { if(!m || m.gone || m === G.you) return; const p = BODY_EATS[m.room] || 0; if(!p) return; const b = bodyOf(m); if(b.hunger > 0.45 && Math.random() < p * 0.35){ m.ate = now; } });
    /* you: your stomach and your eyelids keep the time even when you do not */
    const y = G.you, b = bodyOf(y);
    if(b.hunger > 1.0) y.energy = clamp((y.energy || 50) - 0.15, 0, 100);
    if(now - BODY.warnAt > 150){ if(b.hunger > 1.0){ BODY.warnAt = now; try{ feed("You have not eaten since " + bodyClock(b.ate) + ". Your stomach says so. " + foodHint()); }catch(e){} } else if(b.hunger > 0.75){ BODY.warnAt = now; try{ feed("You look hungry, and people are noticing. " + foodHint()); }catch(e){} } else if(b.tired > 1.05){ BODY.warnAt = now; try{ feed("Your eyes are heavy. It has been a long day."); }catch(e){} } }
    const c = el("kClock"); if(c){ const base = (c.title || "").split(" · you")[0]; c.title = base + " · you last ate at " + bodyClock(b.ate) + " and feel " + bodyWord(b); }
  }catch(e){}
}
