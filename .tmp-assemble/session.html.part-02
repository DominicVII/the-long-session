      if(window.console && !frameFailLogged){ frameFailLogged = true; console.error("render error", e); }
    }
  }
  if(_prof) _prof.mark("render");
  const thing = G.running ? focusThing() : null;
  const foc = thing && thing.type === "person" ? thing.ref : null;
  /* Moving: skip HUD plate/track/tele work — feet first. */
  if(playerMoving){ if((FRAME_ID & 7) === 0) try{ updatePlates(foc); }catch(e){} }   /* 20261030q: turning to a wall hides plates too */
  if(!playerMoving){
    if(!MODEST || (FRAME_ID & 3) === 0) updatePlates(foc);
    if(!MODEST || (FRAME_ID & 7) === 0) updateTrack(TALK.m || foc);
    if(!MODEST || (FRAME_ID & 7) === 1) updateTele(dt);
  }
  if(_prof) _prof.mark("hud");
  /* Moving: feed much less often — HUD text is not feet. */
  if(playerMoving){
    if((FRAME_ID & 7) === 0) feedTick(dt);
  } else if(!MODEST || (FRAME_ID & 1) === 0){
    feedTick(dt);
  }
  try{ tickScrollFrame(); }catch(e){}
  if(_prof) _prof.mark("feed");
  /* the marker's pulse is the only thing left writing a uniform every
     frame for something you may not even be looking at */
  const wantMarker = !!(thing && thing.type === "prop" && !TALK.open);
  if(marker.visible !== wantMarker) marker.visible = wantMarker;
  if(marker.visible){
    marker.position.set(thing.ref.x, 0.035, thing.ref.z);
    marker.material.opacity = 0.55 + Math.sin(G.t*3)*0.22;
  }
  const dr = G.running && !TALK.open ? nearDoor() : null;
  /* If there is a seat where you are standing and nothing else wants
     you, the prompt is simply that: sit down. No question, no card. */
  const atSpeech = !!(speechStationNear && speechStationNear(0.72) && !playerIsMoving());
  const seat = (!thing && !dr && !atSpeech && !CATCH.on && G.running && !TALK.open && !PROC.on) ? seatUnderYou() : null;
  try{ catchFrame(dt); }catch(e){}
  updatePrompt(thing, dr, seat);
  /* someone waiting to catch you — checked a few times a second, not
     sixty; nobody's patience turns over faster than that */
  hailT -= dt;
  if(hailT <= 0){
    hailT = 0.4;
    hailWho = null;
    if(G.running && !TALK.open){
      for(const x of hereNow()) if(x.wantsWord){
        if(x.wwT && G.t - x.wwT > 240){ x.wantsWord = null; continue; }
        hailWho = x; break; }
      if(((hailSweep = (hailSweep||0) + 1) % 10) === 0)
        for(const x of G.members) if(x.wantsWord && x.wwT && G.t - x.wwT > 240) x.wantsWord = null;
    }
  }
  const waiting = hailWho;
  say(el("hail"), waiting ? waiting.name.split(" ")[0] + " wants a word · E when close"
    : (window._nudge && performance.now() < window._nudge.until ? window._nudge.t : null));
  if(PC.open) pcTick(dt);
  try{ dayWatch(dt); }catch(e){}
  try{ poseGuard(); }catch(e){}
  try{ if(!G._namesFix && G.you){ G._namesFix = 1;
    (G.realms || []).forEach(rl => (rl.chamber || []).forEach(c => { c.name = foreignName(Math.random, rl.k); }));
    (G.members || []).forEach(m => { if(m.kind === "envoy"){ const rk = (m.abroad && m.abroad.k) || null; m.name = foreignName(Math.random, rk); } });
    if(G.world && Array.isArray(G.world.names)) G.world.names = G.world.names.map(() => foreignName(Math.random));
  } }catch(e){}
  try{ if(!G._marginFix && G.members){ G._marginFix = 1; G.members.forEach(m => { if(!(m.margin >= 1)){ let h = 7; for(const ch of String(m.name || m.id)) h = (h * 31 + ch.charCodeAt(0)) >>> 0; m.margin = 1 + h % 24; } }); } }catch(e){}
  try{ if(refreshTravel._r !== G.room && !_buildingRoom) refreshTravel(); }catch(e){}
  acc += dt;
  if(acc > (MODEST ? 0.9 : 0.4)){ acc = 0; if(!G.over) refreshBar(); }
  if(_prof){ _prof.mark("ui"); _prof.end(true); }
}

function titleEsc(s){ return String(s==null?"":s).replace(/[&<>"]/g,c=>({"&":"&"+"amp;","<":"&"+"lt;",">":"&"+"gt;",'"':"&"+"quot;"}[c])); }
function titlePeek(){
  try{ if(window.ONUM_CAREERS && window.ONUM_CAREERS.peek){ const p = window.ONUM_CAREERS.peek(); if(p && (p.name || p.day || p.slot || p.rank)) return p; } }catch(e){}
  try{ return peekSave(); }catch(e){ return null; }
}
function titleCareersReady(){
  try{ if(window.__onumCareersReady) return true; }catch(e){}
  try{ if(typeof ENG_IDB !== "undefined" && ENG_IDB && ENG_IDB.ready) return true; }catch(e){}
  return false;
}
function titleArchiveCount(){
  try{
    if(window.ONUM_CAREERS && window.ONUM_CAREERS.list){
      const L = window.ONUM_CAREERS.list();
      return (L && L.archives && L.archives.length) || 0;
    }
  }catch(e){}
  return 0;
}
function titleClearWipeAndOpen(){
  try{ if(window.ONUM_CAREERS && window.ONUM_CAREERS.clearWipe) window.ONUM_CAREERS.clearWipe(); else careerClearWipe(); }catch(e){}
  try{ if(typeof G !== "undefined" && G) G.make = null; }catch(e){}
  try{ veil.classList.remove("veil--make"); }catch(e){}
  opening();
}
function titleBindReady(){
  if(window.__onumTitleReadyBound) return;
  window.__onumTitleReadyBound = true;
  const refresh = () => {
    window.__onumCareersReady = true;
    try{
      if(typeof G !== "undefined" && G){
        if(G._booting) return;
        if(G.make) return;
        if(G.running && G.you && G.members && G.members.length) return;
      }
      if(!document.body.classList.contains("boot-menu")) return;
      if(typeof veil !== "undefined" && veil && veil.hidden) return;
      if(el("freshBack") || el("freshYes") || el("bootArchBack") || el("bootArchYes") || el("mkGo") || el("mkNameBack") || el("sortedBack")) return;
      const h = card && card.querySelector("h1");
      const looking = !!(h && /Looking for your career/.test(h.textContent || ""));
      const onTitle = !!(el("cont") || el("fresh") || looking);
      if(onTitle) opening();
    }catch(e){}
  };
  try{ document.addEventListener("onum-careers-ready", refresh); }catch(e){}
  try{ if(window.ONUM_CAREERS && window.ONUM_CAREERS.onReady) window.ONUM_CAREERS.onReady(refresh); }catch(e){}
}
function titleShowArchives(){
  let list = {active:null, archives:[]};
  try{ if(window.ONUM_CAREERS && window.ONUM_CAREERS.list) list = window.ONUM_CAREERS.list(); }catch(e){}
  const archives = (list && list.archives) || [];
  document.body.classList.add("boot-menu");
  card.classList.add("card--open");
  try{ veil.classList.remove("veil--make"); }catch(e){}
  veil.hidden = false;
  const rows = archives.map(a => {
    const id = titleEsc(a && a.id || "");
    const label = titleEsc((a && a.name || "Career") + (a && a.day ? " · day " + a.day : "") + (a && a.congress ? " · Congress " + a.congress : ""));
    return '<button class="btn btn--ghost" type="button" data-arch="' + id + '" style="display:block;width:100%;text-align:left;margin:4px 0">' + label + '</button>';
  }).join("");
  card.innerHTML =
    '<div class="eyebrow">Earlier careers</div>' +
    '<h1>Your saved sittings</h1>' +
    '<p>These careers stay saved. Restoring one first archives the career you are on now, so nothing is lost.</p>' +
    '<div class="boot-arch-list">' + (rows || '<p class="muted">No earlier careers in this browser.</p>') + '</div>' +
    '<div class="card__actions"><button class="btn" type="button" id="bootArchBack">Back</button></div>';
  const bb = el("bootArchBack");
  if(bb) bb.onclick = (ev) => { try{ ev.preventDefault(); ev.stopPropagation(); }catch(e){} opening(); };
  card.querySelectorAll("[data-arch]").forEach(b => b.addEventListener("click", (ev) => {
    try{ ev.preventDefault(); ev.stopPropagation(); }catch(e){}
    const id = b.getAttribute("data-arch");
    const entry = archives.filter(x => x && x.id === id)[0] || {id:id};
    titleConfirmRestore(entry);
  }));
  try{ markPicks(); }catch(e){}
  try{ if(bb) bb.focus(); }catch(e){}
}
function titleConfirmRestore(entry){
  const name = (entry && entry.name) || "this career";
  const day = (entry && entry.day) || "";
  card.innerHTML =
    '<div class="eyebrow">Earlier careers</div>' +
    '<h1>Restore this career?</h1>' +
    '<p><strong>' + titleEsc(name) + '</strong>' + (day ? ' (day <strong>' + titleEsc(String(day)) + '</strong>)' : '') +
      ' will become the sitting you continue. Your current career is archived first and kept, and you can return to it any time.</p>' +
    '<div class="card__actions">' +
      '<button class="btn" type="button" id="bootArchBack">Back</button>' +
      '<button class="btn btn--ghost" type="button" id="bootArchYes" data-noenter>Yes, restore this career</button></div>';
  const bb = el("bootArchBack"), by = el("bootArchYes");
  if(bb) bb.onclick = (ev) => { try{ ev.preventDefault(); ev.stopPropagation(); }catch(e){} titleShowArchives(); };
  if(by) by.onclick = (ev) => {
    try{ ev.preventDefault(); ev.stopPropagation(); }catch(e){}
    if(by._busy) return;
    by._busy = true;
    try{ by.disabled = true; }catch(e){}
    try{
      window.ONUM_CAREERS.restore(entry.id, function(res){
        if(!res || !res.ok){
          by._busy = false;
          try{ by.disabled = false; }catch(e){}
          try{
            const p = card.querySelector("p");
            if(p) p.textContent = (res && res.why === "could-not-archive-current")
              ? "Could not archive the current career first, so nothing was moved. Export it from Settings, then try again. Back returns to the list; the career is still there."
              : "Could not restore that career. It is still in the list. Nothing was moved. Back returns to Earlier careers.";
          }catch(e){}
          return;
        }
        try{ cardActContinue(); }catch(e){ showContinueBroken(e); }
      });
    }catch(e){
      by._busy = false;
      try{ by.disabled = false; }catch(e2){}
      try{
        const p = card.querySelector("p");
        if(p) p.textContent = "Could not restore that career. It is still in the list. Nothing was moved. Back returns to Earlier careers.";
      }catch(e3){}
    }
  };
  try{ markPicks(); }catch(e){}
  try{ if(bb) bb.focus(); }catch(e){}
}
function peekSave(){
  const d = pickNewestSave();
  if(d) return {
    day: d.day || 1,
    congress: d.congress || 1,
    country: d.country || null,
    name: d.you && d.you.name,
    room: d.room || "office",
    minute: d.minute || 0
  };
  return peekCareerMeta();
}
function bootFreshCareer(){
  if(G._booting) return;
  /* 20261110bv JUPITER: a new career never deletes the old one. Archive first.
     NEPTUNE-TITLE hook (copy only): eyebrow "New career", heading, the confirm
     paragraph, Back / Yes buttons — presentation is Neptune's; the data path
     is archive-and-keep, never wipe. Oath (nameCard) is only reached after Yes. */
  let pk = null; try{ pk = peekSave(); }catch(e){}
  if(pk && !G._freshOk){
    try{
      veil.hidden = false;
      card.classList.add("card--open");
      document.body.classList.add("boot-menu");
      card.innerHTML =
        '<div class="eyebrow">Start a new career</div>' +
        '<h1>Start a new career?</h1>' +
        '<p>Your day <strong>' + (pk.day || 1) + '</strong> career' + (pk.name ? ' as <strong>' + titleEsc(pk.name) + '</strong>' : '') +
          ' stays saved as an archive, and you can return to it any time. The oath is only for a new career.</p>' +
        '<div class="card__actions">' +
          '<button class="btn" type="button" id="freshBack" data-gp="boot:back">Back</button>' +
          '<button class="btn btn--ghost" type="button" id="freshYes" data-noenter style="border-color:var(--bad);color:var(--bad)">Yes, start a new career</button></div>';
      const by = el("freshYes"), bb = el("freshBack");
      if(by) by.onclick = (ev) => {
        try{ ev.preventDefault(); ev.stopPropagation(); }catch(e){}
        if(by._busy) return;
        if(by._needType){
          const typed = ((el("freshType") && el("freshType").value) || "").trim();
          if(typed.toLowerCase() !== String(by._needType).toLowerCase()){
            try{ const box = el("freshType"); if(box){ box.style.borderColor = "var(--bad)"; box.focus(); } }catch(e){}
            return;
          }
        }
        by._busy = true;
        try{ by.disabled = true; }catch(e){}
        careerArchiveCurrent("new-career", function(res){
          if(!res || !res.ok){
            by._busy = false;
            try{ by.disabled = false; }catch(e){}
            try{
              const p = card.querySelector("p");
              if(p) p.textContent = "Could not archive the current career, so a new one was not started. Nothing was erased. Export the career from Settings, then try again. To try archiving again, type the career name below and press Yes once more.";
              let box = el("freshType");
              if(!box){
                box = document.createElement("input");
                box.id = "freshType";
                box.type = "text";
                box.className = "mk__name";
                box.setAttribute("autocomplete","off");
                box.setAttribute("spellcheck","false");
                box.placeholder = "Type " + (pk.name || "the career name") + " to try again";
                const acts = card.querySelector(".card__actions");
                if(acts && acts.parentNode) acts.parentNode.insertBefore(box, acts);
              }
              by._needType = String((pk && pk.name) || "START").trim();
              try{ box.focus(); }catch(e2){}
            }catch(e){}
            return;
          }
          G._archiveVerified = res;
          G._freshOk = true;
          G._wipeOnOath = true; /* armed; startRun wipes the active slot only after this verified archive */
          bootFreshCareer();
        });
      };
      if(bb) bb.onclick = (ev) => { try{ ev.preventDefault(); ev.stopPropagation(); }catch(e){} careerClearWipe(); opening(); };
      try{ markPicks(); }catch(e){}
      return;
    }catch(e){}
  }
  G._freshOk = false;
  G._booting = true;
  /* 20261110bv: leave G._wipeOnOath / G._archiveVerified armed for startRun.
     Back already called clearWipe. Do not wipe here. */
  try{ G.you = null; G.members = []; G.make = null; G.running = false; }catch(e){}
  try{ card.classList.remove("card--open"); }catch(e){}
  try{ veil.classList.remove("veil--make"); }catch(e){}
  try{
    nameCard();
    G._booting = false;
  }catch(e){
    if(window.console) console.warn("nameCard", e);
    try{
      veil.hidden = false;
      card.classList.add("card--open");
      card.innerHTML = '<h1>Could not open swearing-in</h1><p class="muted">' +
        String((e && e.message) || e) + '</p><div class="card__actions">' +
        '<button class="btn" type="button" id="freshRetry">Try New career again</button></div>';
      const r = el("freshRetry");
      if(r) r.addEventListener("click", () => bootFreshCareer());
    }catch(e2){ softUnstickVeil(); }
    G._booting = false;
  }
}
function opening(){
  /* Do NOT loadSave() here — hydrating a full career on the start card freezes the UI
     so Continue/Start a new career look dead. Peek only; load on Continue click. */
  /* 20261110bu NEPTUNE-TITLE: Continue is the primary, first, default-focused button
     whenever any save exists (sidecar peek, localStorage, or IDB). While the larger
     store is still loading, show "Looking for your career…" — never a New-career-only
     first frame. Enter/Space never reach Start a new career when a save exists or the
     load is still pending. */
  titleBindReady();
  const peek = titlePeek();
  const hasSave = !!peek;
  const pending = !hasSave && !titleCareersReady();
  try{
    if(!G.parties) G.parties = defaultPartyMap();
    ensureParties();
    mergeWorldParties();
  }catch(e){ if(window.console) console.warn("opening parties", e); }
  document.body.classList.add("boot-menu");
  card.classList.add("card--open");
  try{ veil.classList.remove("veil--make"); }catch(e){}
  if(pending){
    card.innerHTML = '<div class="eyebrow">One Nation, Under, ME.</div><h1>Looking for your career…</h1><p>Checking this browser\'s larger store for a saved sitting.</p>';
    veil.hidden = false;
    try{ markPicks(); }catch(e){}
    return;
  }
  const cong = hasSave ? (peek.congress || 1) : 1;
  const dayN = hasSave ? (peek.day || 1) : 1;
  const cname = (peek && peek.country && peek.country.name) ? peek.country.name : (G.country && G.country.name);
  const archN = titleArchiveCount();
  const contLabel = "Continue" + (peek && peek.name ? " — " + peek.name : "") + " · day " + dayN;
  card.innerHTML =
    '<img class="card__logo" src="assets/logo.png" width="220" height="147" alt="One Nation, Under, ME." onerror="this.onerror=null;this.replaceWith(Object.assign(document.createElement(\'div\'),{className:\'card__logo card__logo--text\',textContent:\'One Nation, Under, ME.\'}))">' +    '<div class="eyebrow">One Nation, Under, ME. · The ' + ordinal(cong) + ' Congress' +
      (cname ? ' · ' + cname : '') + '</div>' +
    '<h1>Everyone in this building remembers what you did to them.</h1>' +
    '<p>You are a member of the House. Everyone remembers what you did to them.</p>' +
    '<details class="lore"><summary>What is this?</summary>' +
    '<p>There is a bill on the calendar, a roll call coming, and twenty-five ' +
      'people whose votes you might move — each with a fixed temperament, a district to answer to, two close ' +
      'friends, one rival, and a running account of every favor, threat and broken promise between you.</p>' +
    '<p>Nothing you do stays where you put it. Hurt one of them and their friends hear about it. Every private ' +
      'threat becomes a secret with its own clock. Every vote goes on a record your opponent will read aloud in ' +
      'October. Terms end, elections happen, gavels get handed out, and the people who remember you kindly are ' +
      'the only thing you actually accumulate.</p>' +
    '<p class="muted">The Republic still measures itself against ' + FIRST_CONSUL.name + ', first Consul of the First Order — ' +
      'reviled in every aisle, forever rank 1. His birthday, ' + (FIRST_CONSUL.born || "7/7") + ', is ' +
      (FIRST_CONSUL.holiday || "Taylor Day") + ' (' + (FIRST_CONSUL.holidayFull || "Day of the First Consul") +
      '), a national holiday. Comparison to him is blasphemy; The Greatest may descend under him only.</p></details>' +
    '<div class="legend">' + (function(){ try{ return partyLegendHTML(); }catch(e){ return ""; } })() + '</div>' +
    /* 20261110bu NEPTUNE-TITLE: primary is Continue (existing career, loads it
       directly). Secondary is "Start a new career". No delete or replace warning
       belongs on this card. */
    '<div class="card__actions">' +
      (hasSave ? '<button class="btn" type="button" id="cont" data-gp="boot:cont" autofocus>' + titleEsc(contLabel) + '</button>' : '') +
      '<button class="btn' + (hasSave?' btn--ghost':'') + '" type="button" id="fresh" data-gp="boot:fresh"' + (hasSave ? ' data-noenter' : '') + '>Start a new career</button>' +
      '<button class="btn btn--ghost" type="button" id="bootBook" data-gp="boot:book">Handbook</button></div>' +
      (archN ? '<p class="muted" style="margin:10px 0 0"><button type="button" class="btn btn--ghost" id="bootArchives" style="font-size:12px;min-height:0;padding:4px 10px;letter-spacing:.06em">Earlier careers (' + archN + ')</button></p>' : '') +
      '<p class="boot-hint">' + (hasSave ? 'Enter continues · Esc does nothing here · H hides the panels once you are inside' : 'Enter starts a new career only when none is saved · Esc does nothing here') + '</p>';
  veil.hidden = false;
  const bindBoot = (node, fn) => {
    if(!node) return;
    node.onclick = (ev) => {
      try{ if(ev){ ev.preventDefault(); ev.stopPropagation(); } }catch(e){}
      try{ fn(); }catch(e){ if(window.console) console.warn("boot", e); softUnstickVeil(); }
    };
  };
  bindBoot(el("cont"), cardActContinue);
  bindBoot(el("fresh"), bootFreshCareer);
  bindBoot(el("bootBook"), () => { try{ handbookCard(); }catch(e){} });
  bindBoot(el("bootArchives"), titleShowArchives);
  markPicks();
  try{ const c = el("cont"); if(c) c.focus(); }catch(e){}
}
function softUnstickVeil(){
  G._booting = false;
  try{ document.body.classList.remove("boot-menu"); }catch(e){}
  try{ document.body.classList.remove("boot-menu"); veil.hidden = true; card.classList.remove("card--open"); veil.classList.remove("veil--make"); }catch(e){}
  try{
    G.moving = false;
    const f = el("fade");
    if(f){ f.style.transition = "opacity .2s ease"; f.style.opacity = "0"; }
    G.running = !!(G.you && G.members && G.members.length);
  }catch(e){}
}
if(!window.__onumBootEnterBound){
  window.__onumBootEnterBound = true;
  addEventListener("keydown", e => {
    if(e.key !== "Enter" && e.key !== " " && e.key !== "Escape") return;
    if(!document.body.classList.contains("boot-menu")) return;
    if(veil.hidden) return;
    /* 20261110bu: Esc does nothing destructive on the title; on confirm/oath it is Back. */
    if(e.key === "Escape"){
      const back = el("freshBack") || el("bootArchBack") || el("mkNameBack") || el("sortedBack");
      if(back){ e.preventDefault(); e.stopPropagation(); try{ back.click(); }catch(err){} return; }
      e.preventDefault();
      e.stopPropagation();
      return;
    }
    const t = e.target;
    if(t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
    /* 20261110bu: Enter and Space on the title must never reach Start a new career
       when a save exists, or while the load is still pending. Even if #fresh is focused. */
    const freshEl = el("fresh");
    const aimedFresh = !!(t && (t.id === "fresh" || (t.getAttribute && t.getAttribute("data-gp") === "boot:fresh") || (freshEl && (t === freshEl || (freshEl.contains && freshEl.contains(t))))));
    const peekNow = titlePeek();
    const pendingNow = !peekNow && !titleCareersReady();
    if(aimedFresh && (peekNow || pendingNow)){ e.preventDefault(); e.stopPropagation(); return; }
    if(t && (t.tagName === "BUTTON" || t.tagName === "A" || t.tagName === "SELECT") && card.contains(t)) return;
    if(el("freshBack") || el("freshYes") || el("bootArchBack") || el("bootArchYes") || el("mkGo") || el("mkNameBack") || el("sortedBack")) return;
    const cont = el("cont");
    if(cont && !cont.hidden && !cont.disabled){ e.preventDefault(); e.stopPropagation(); cont.click(); return; }
    if(peekNow || pendingNow){ e.preventDefault(); e.stopPropagation(); return; }
    if(freshEl && !freshEl.hidden){ e.preventDefault(); e.stopPropagation(); freshEl.click(); }
  });
}
if(!window.__onumBootClickBound){
  window.__onumBootClickBound = true;
  document.addEventListener("click", (e) => {
    const t = e.target && e.target.closest ? e.target.closest("#cont, #fresh, [data-gp='boot:cont'], [data-gp='boot:fresh']") : null;
    if(!t) return;
    e.preventDefault();
    e.stopPropagation();
    const gp = t.getAttribute("data-gp") || (t.id === "cont" ? "boot:cont" : (t.id === "fresh" ? "boot:fresh" : ""));
    try{
      if(gp === "boot:cont" || t.id === "cont") cardActContinue();
      else if(gp === "boot:fresh" || t.id === "fresh") bootFreshCareer();
    }catch(err){ if(window.console) console.warn("boot click", err); softUnstickVeil(); }
  }, true);
}
document.addEventListener("keydown", (e) => {
  if(veil.hidden) return;
  if(e.key !== "Enter" && e.key !== " ") return;
  const t = e.target;
  if(t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
  /* 20261110bu: even a focused Start a new career button must not take Enter/Space
     when a save exists or the load is still pending. */
  const freshEl = el("fresh");
  const aimedFresh = !!(t && (t.id === "fresh" || (t.getAttribute && t.getAttribute("data-gp") === "boot:fresh") || (freshEl && (t === freshEl || (freshEl.contains && freshEl.contains(t))))));
  if(aimedFresh && document.body.classList.contains("boot-menu")){
    const peekNow = titlePeek();
    if(peekNow || !titleCareersReady()){ e.preventDefault(); e.stopPropagation(); return; }
  }
  /* a button you have tabbed to does its own thing; Enter is only a shortcut for the card's primary when nothing is focused, and never for a choice that cannot be undone */
  if(t && (t.tagName === "BUTTON" || t.tagName === "A" || t.tagName === "SELECT") && card.contains(t)) return;
  const primary = card.querySelector(".card__actions .btn:not(.btn--ghost):not([data-noenter])") || card.querySelector(".card__actions .btn:not([data-noenter])");
  if(!primary) return;
  if((primary.id === "fresh" || (primary.getAttribute && primary.getAttribute("data-gp") === "boot:fresh")) && document.body.classList.contains("boot-menu")){
    const peekNow = titlePeek();
    if(peekNow || !titleCareersReady()){ e.preventDefault(); e.stopPropagation(); return; }
  }
  e.preventDefault();
  e.stopPropagation();
  primary.click();
}, true);

function cardActContinue(){
  if(G._booting) return;
  /* Skyrim / pause-menu: world already in memory — just stand up. Never rebuild. */
  if(G.you && G.members && G.members.length && G.room && ROOMS[G.room] && !G.over){
    resumeLiveCareer();
    return;
  }
  G._booting = true;
  try{
    const h = card.querySelector("h1");
    if(h) h.textContent = "Resuming the House.";
    const acts = card.querySelector(".card__actions");
    if(acts) acts.innerHTML = '<button class="btn" type="button" disabled>Loading career…</button>';
  }catch(e){}
  const finish = (ok, err) => {
    if(!ok || !G.you || !(G.members && G.members.length)){
      G._booting = false;
      showContinueBroken(err);
      return;
    }
    yieldPaint(() => {
      try{ begin(); }
      catch(e){
        if(window.console) console.warn("begin", e);
        G._booting = false;
        showContinueBroken(e);
      }
    });
  };
  const archiveSlotOf = () => {
    try{
      const p = (window.ONUM_CAREERS && window.ONUM_CAREERS.peek)
        ? window.ONUM_CAREERS.peek()
        : (typeof peekCareerMeta === "function" ? peekCareerMeta() : null);
      const slot = p && p.slot;
      if(!slot) return null;
      if(slot === "career" || slot === "active" || slot === SAVE_KEY || slot === SAVE_BACKUP_KEY || slot === SAVE_BEST_KEY) return null;
      return slot;
    }catch(e){ return null; }
  };
  const go = () => {
    yieldMain(() => {
      let ok = false, err = null;
      try{ ok = !!loadSave(); }catch(e){ ok = false; err = e; }
      if(ok && G.you && G.members && G.members.length){ finish(true); return; }
      /* 20261110bw: after the oath wipes the active slot, the sidecar still
         names the archived career. loadSave only reads the empty active
         keys, so Continue would fail. Restore that slot through the
         careers API (safe on an empty active: archiveCurrent no-ops),
         then load the sitting as usual. */
      const slot = archiveSlotOf();
      const api = window.ONUM_CAREERS;
      if(!slot || !api || typeof api.restore !== "function"){ finish(false, err); return; }
      try{
        api.restore(slot, function(res){
          if(!res || !res.ok){
            finish(false, (res && res.why) || err);
            return;
          }
          let ok2 = false, err2 = err;
          try{ ok2 = !!loadSave(); }catch(e){ ok2 = false; err2 = e; }
          finish(ok2, err2);
        });
      }catch(e){ finish(false, e); }
    });
  };
  /* 20261110bv: the IDB career may not be in cache yet on a fast Continue click. */
  if(typeof ENG_IDB !== "undefined" && !ENG_IDB.ready) engIdbWhenReady(go, 2000);
  else go();
}
function resumeLiveCareer(){
  /* Pause menu Continue: HUD back. Chamber rooms still trap — walk out. */
  G._booting = false;
  G.running = true;
  G.over = false;
  G.speed = 1;
  G.prevSpeed = 1;
  if(G.you) G.you.sitting = false;
  try{ leaveSittingQuiet(); }catch(e){}
  try{ if(TALK.open) closeTalk(); }catch(e){}
  try{ document.body.classList.remove("boot-menu"); }catch(e){}
  try{ veil.hidden = true; card.classList.remove("card--open"); veil.classList.remove("veil--make"); }catch(e){}
  try{ catchClear("resume"); }catch(e){}
  G.doorGrace = (G.t || 0) + 2.4;
  if(G.room === "floor" || G.room === "committee" || G.room === "caucus" || G.room === "press"){
    try{ walkOutNow(); return; }catch(e){}
  }
  try{ refreshPanels(); }catch(e){}
  forcePaint();
}
function showContinueBroken(err){
  /* Stardew rule: a bad load never deletes the farm. */
  try{
    veil.hidden = false;
    card.classList.add("card--open");
    document.body.classList.add("boot-menu");
    const peek = (typeof titlePeek === "function") ? titlePeek() : peekSave();
    let nArch = 0;
    try{ nArch = titleArchiveCount(); }catch(e){}
    const why = (err && err.why) || (err && err.message) || err;
    const whyKey = (typeof why === "string") ? why : "";
    const body = (whyKey === "could-not-archive-current")
      ? "Could not archive the current career first, so nothing was moved. Export it from Settings, then try again."
      : (whyKey === "missing" || whyKey === "empty" || whyKey === "no-store" || whyKey === "parse")
        ? "The named career is still listed under Earlier careers. It was not erased."
        : "The career was not erased. Restore it from Earlier careers, or try Continue again.";
    const raw = (whyKey && whyKey !== "could-not-archive-current" && whyKey !== "missing" && whyKey !== "empty" && whyKey !== "no-store" && whyKey !== "parse")
      ? String(whyKey).slice(0, 180)
      : "";
    card.innerHTML =
      '<div class="eyebrow">Career save is still here</div>' +
      '<h1>Could not open that sitting.</h1>' +
      '<p>' + body + '</p>' +
      (peek ? '<p class="muted">On disk: day ' + peek.day + (peek.name ? ' · ' + peek.name : '') + '.</p>' : '') +
      (raw ? '<p class="muted">' + raw + '</p>' : '') +
      '<div class="card__actions">' +
        (nArch ? '<button class="btn" type="button" id="bootArchives">Restore from Earlier careers</button>' : '') +
        '<button class="' + (nArch ? 'btn btn--ghost' : 'btn') + '" type="button" id="cont" data-gp="boot:cont">Try Continue again</button>' +
        '<button class="btn btn--ghost" type="button" id="fresh" data-gp="boot:fresh">Start a new career</button>' +
      '</div>';
    const c = el("cont"), f = el("fresh"), a = el("bootArchives");
    if(c) c.onclick = () => { try{ cardActContinue(); }catch(e){ softUnstickVeil(); } };
    if(a) a.onclick = () => { try{ titleShowArchives(); }catch(e){ softUnstickVeil(); } };
    if(f) f.onclick = () => { try{ bootFreshCareer(); }catch(e){ softUnstickVeil(); } };
    try{ markPicks(); }catch(e){}
    try{ const focus = a || c; if(focus) focus.focus(); }catch(e){}
  }catch(e2){ softUnstickVeil(); }
}
/* ══════════════════════════════════════════════════════════
   THE QUESTIONNAIRE
   Nobody assigns you a party. You answer, and the answers
   either find you one or make you one.
   ══════════════════════════════════════════════════════════ */
const QUIZ = [
  {q:"The Union's first duty is —", a:[
    {t:"To let people get on and prosper", d:{econ: 26, wel:-12}},
    {t:"To leave people alone",            d:{lib: 28, econ: 10}},
    {t:"To keep the Union safe",           d:{def: 26, lib:-10}},
    {t:"To look after those who cannot",   d:{wel: 28, econ:-14}}]},
  {q:"A mill closes in a town of four thousand. You —", a:[
    {t:"Let the market find them work",    d:{econ: 24, wel:-14}},
    {t:"Vote federal retraining money",    d:{wel: 24, econ:-12}},
    {t:"Put a tariff on the imports",      d:{econ:-18, def: 8}},
    {t:"Say plainly it is the state's job",d:{lib: 20, wel:-10}}]},
  {q:"On the militia —", a:[
    {t:"Larger, and better paid",          d:{def: 28, econ:-8}},
    {t:"Under civilian control, always",   d:{lib: 24, def:-12}},
    {t:"Cheaper. It is a line in a budget",d:{econ: 18, def:-16}},
    {t:"For floods and fires, not for order",d:{wel: 16, def:-14}}]},
  {q:"A newspaper prints something the Treasury wanted kept quiet. You —", a:[
    {t:"Prosecute. There are rules",       d:{lib:-28, def: 8}},
    {t:"Defend them on the floor",         d:{lib: 30}},
    {t:"Ask them quietly not to do it again",d:{lib:-6}},
    {t:"Say nothing and read it",          d:{lib: 8}}]},
  {q:"Taxes should —", a:[
    {t:"Fall, and keep falling",           d:{econ: 28, wel:-16}},
    {t:"Pay for provision",                d:{wel: 26, econ:-16}},
    {t:"Pay for the fleet",                d:{def: 24, econ: 6}},
    {t:"Be simple enough to understand",   d:{econ: 8, lib: 8}}]},
  {q:"When your party is wrong, you —", a:[
    {t:"Vote with them anyway",            d:{}, loyal: 22},
    {t:"Vote how the district would",      d:{}, loyal: -6},
    {t:"Vote your conscience and say why", d:{}, loyal: -20},
    {t:"Get the bill changed first",       d:{}, loyal: 6}]}
];
const ARCH = {
  FED:{econ: 36, lib:  6, def: 26, wel:-30},
  COM:{econ:-30, lib: 14, def: -8, wel: 32}
};
/* Everyone in this world is sorted by the same six questions —
   the member you are talking to answered them too. */
function quizPosFrom(answers){
  const p = {econ:0, lib:0, def:0, wel:0};
  let loyal = 0;
  (answers || []).forEach((ai, qi) => {
    if(ai === null || ai === undefined || !QUIZ[qi]) return;
    const a = QUIZ[qi].a[ai];
    if(!a) return;
    for(const k in a.d) p[k] += a.d[k];
    if(a.loyal) loyal += a.loyal;
  });
  for(const k in p) p[k] = clamp(Math.round(p[k]*1.25), -100, 100);
  return {pos:p, loyal};
}
/* An individual's answers, coloured by where they came from. */
function answersFor(bg, lean){
  const out = [];
  QUIZ.forEach(q => {
    let best = 0, bs = -1e9;
    q.a.forEach((a, i) => {
      let s = rint(-26, 26);
      for(const k in a.d){
        const want = k === "econ" ? lean*26 + (bg.pos.econ||0)
                   : k === "wel"  ? -lean*22 + (bg.pos.wel||0)
                   : k === "def"  ? lean*12 + (bg.pos.def||0)
                   : (bg.pos.lib||0);
        s += (a.d[k] > 0 ? 1 : -1) * (want > 0 ? 1 : -1) * Math.min(24, Math.abs(want)) * 0.5;
      }
      if(a.loyal) s += a.loyal * ((bg.tr.loyalty||0) > 0 ? 0.4 : -0.2);
      if(s > bs){ bs = s; best = i; }
    });
    out.push(best);
  });
  return out;
}
function quizPos(){
  const p = {econ:0, lib:0, def:0, wel:0};
  let loyal = 0;
  (G.make.answers || []).forEach((ai, qi) => {
    if(ai === null || ai === undefined) return;
    const a = QUIZ[qi].a[ai];
    for(const k in a.d) p[k] += a.d[k];
    if(a.loyal) loyal += a.loyal;
  });
  for(const k in p) p[k] = clamp(Math.round(p[k]*1.25), -100, 100);
  return {pos:p, loyal};
}
function distTo(p, arch){
  let s = 0;
  for(const k in arch) s += Math.pow(p[k] - arch[k], 2);
  return Math.sqrt(s);
}
function partyNameFor(p){
  const bits = [];
  if(p.econ >  30) bits.push("Free Trade");
  if(p.econ < -30) bits.push("Labour");
  if(p.wel  >  35) bits.push("Commonweal");
  if(p.wel  < -30) bits.push("Retrenchment");
  if(p.lib  >  35) bits.push("Liberty");
  if(p.lib  < -30) bits.push("Order");
  if(p.def  >  35) bits.push("Union Defence");
  if(p.def  < -30) bits.push("Peace");
  if(!bits.length) bits.push("Independent");
  const tail = pick(["League","Party","Union","Alliance","Caucus","Movement"]);
  return bits.slice(0,2).join(" and ") + " " + tail;
}
function sortHat(){
  const {pos, loyal} = quizPos();
  const dF = distTo(pos, ARCH.FED), dC = distTo(pos, ARCH.COM);
  const near = dF < dC ? "FED" : "COM";
  const gap = Math.min(dF, dC);
  return {pos, loyal, near, gap, homeless: gap > 78};
}

/* ── character creation, with the model standing in front of you ── */
let mkMesh = null, mkKey = null, mkFill = null;
function mkLights(on){
  if(!mkKey){
    mkKey = new THREE.PointLight(0xfff0dc, 0, 6, 2);
    mkFill = new THREE.PointLight(0xbfd4ff, 0, 7, 2);
    scene.add(mkKey); scene.add(mkFill);
  }
  mkKey.intensity = on ? 3.4 : 0;
  mkFill.intensity = on ? 0.9 : 0;
  mkKey.visible = mkFill.visible = !!on;
}
function mkPreview(){
  if(mkMesh){ scene.remove(mkMesh); mkMesh = null; }
  const stand = {look:G.make.look, party:G.make.party, kind:"you", id:0, _full:true, _cheap:false};
  mkMesh = buildPerson(stand);
  mkMesh.position.set(-1.15, 0, 2.7);
  mkMesh.rotation.y = Math.PI + 0.30;      /* face the camera, slightly turned */
  scene.add(mkMesh);
  cam.x = -1.15; cam.z = 1.30; cam.yaw = 0; cam.pitch = 0;
  camera.position.set(cam.x, 1.50, cam.z);
  camera.rotation.set(0, Math.PI, 0, "YXZ");
  /* light the sitter properly: a key just off the camera, a cool fill
     from the other side, so the face is actually readable */
  mkLights(true);
  const H = G.make.look.height;
  mkKey.position.set(mkMesh.position.x + 0.75, H*0.95, mkMesh.position.z - 1.15);
  mkFill.position.set(mkMesh.position.x - 1.05, H*0.80, mkMesh.position.z - 0.65);
}
function nameCard(){
  if(!G.make){
    const st0 = pick(STATES);
    const auto0 = newName(st0);
    G.make = {name: auto0, autoName: auto0, party:"FED", state:st0, dist:rint(1,14), look: makeLook({frame:"masc"})};
    G.make.look.wear = "suit_tie";
  }
  if(!G.make.autoName) G.make.autoName = G.make.name;
  const L = G.make.look;
  const opts = (label, list, cur, attr) =>
    '<div class="mk__row"><i>' + label + '</i><div class="mk__opts">' +
      list.map(o => '<button type="button" class="mk__opt' + (o.v === cur ? " is-on" : "") +
        '" data-set="' + attr + '" data-val="' + o.v + '">' + o.t + '</button>').join("") +
    '</div></div>';
  const swatches = (label, list, cur, attr) =>
    '<div class="mk__row"><i>' + label + '</i><div class="mk__opts">' +
      list.map(hex => '<button type="button" class="mk__sw' + (hex === cur ? " is-on" : "") +
        '" style="background:#' + hex.toString(16).padStart(6,"0") + '" data-set="' + attr +
        '" data-val="' + hex + '" aria-label="colour"></button>').join("") +
    '</div></div>';
  card.innerHTML =
    '<div class="eyebrow">Swearing in</div><h1>Raise your right hand.</h1>' +
    '<p style="margin-bottom:4px">Everything after this is between you and them.</p>' +
    '<div class="mk">' +
      '<div class="mk__namewrap">' +
        '<input class="mk__name" id="nameIn" value="' + G.make.name + '" maxlength="40">' +
        '<button type="button" class="btn btn--ghost mk__reroll" id="mkNameReroll">Another name</button>' +
      '</div>' +
      '<div class="mk__culthint" id="mkCultHint">' + cultureHint(G.make.state) + '</div>' +
      /* party is decided by the six questions — not picked here */
      '<div class="mk__row"><i>Seat</i><div class="mk__opts">' +
        '<select class="wire__to" id="mkState">' + STATES.map(st =>
          '<option value="' + st + '"' + (st === G.make.state ? " selected" : "") + '>' + st + '</option>').join("") +
        '</select>' +
        '<input type="number" id="mkDist" min="1" max="24" value="' + (G.make.dist || 1) +
          '" style="width:64px" aria-label="District">' +
      '</div></div>' +
      '<div class="mk__row"><i>Faith</i><div class="mk__opts">' +
        '<select class="wire__to" id="mkCreed">' + CREEDS.filter(c => c.k !== "consul").map(c =>
          '<option value="' + c.k + '"' + (c.k === (G.make.creed || "latin") ? " selected" : "") + '>' + c.t.replace(/^the /, "The ").replace(/^no /, "No ") + '</option>').join("") +
        '</select></div></div>' +
      opts("Frame", [{v:"masc",t:"Masculine"},{v:"fem",t:"Feminine"}], L.frame, "frame") +
      opts("Dress", (L.frame === "fem" ? WEAR_FEM : WEAR_MASC).filter((v,i,a)=>a.indexOf(v)===i)
            .map(k => ({v:k, t:WARDROBE[k].t})), L.wear, "wear") +
      swatches("Skin", SKINS, L.skin, "skin") +
      swatches("Hair", HAIRS, L.hair, "hair") +
      opts("Style", HAIRSTYLES.map((t,i) => ({v:i, t})), L.style, "style") +
      swatches("Cloth", SUITS, L.suit, "suit") +
      swatches("Shirt", SHIRTS, L.shirt, "shirt") +
      '<div class="mk__row"><i>Height</i><input type="range" id="mkH" min="150" max="196" value="' +
        Math.round(L.height*100) + '"></div>' +
      '<div class="mk__row"><i>Build</i><input type="range" id="mkB" min="82" max="126" value="' +
        Math.round(L.build*100) + '"></div>' +
      opts("Glasses", [{v:1,t:"Yes"},{v:0,t:"No"}], L.glasses?1:0, "glasses") +
      (L.frame === "masc" ? opts("Beard", [{v:1,t:"Yes"},{v:0,t:"No"}], L.beard?1:0, "beard") : "") +
    '</div>' +
    '<div class="card__actions">' +
      '<button class="btn btn--ghost" type="button" id="mkNameBack">Back</button>' +
      '<button class="btn btn--ghost" type="button" id="mkRand">Surprise me</button>' +
      '<button class="btn" type="button" id="mkGo">Take the oath</button></div>';
  veil.classList.add("veil--make");
  veil.hidden = false;
  mkPreview();

  const mkS = el("mkState"), mkD = el("mkDist");
  const mkC = el("mkCreed"); if(mkC) mkC.addEventListener("change", () => { G.make.creed = mkC.value; });
  if(mkS) mkS.addEventListener("change", () => {
    G.make.state = mkS.value;
    const nameIn = el("nameIn");
    const cur = nameIn ? nameIn.value.trim() : G.make.name;
    if(!cur || cur === G.make.autoName){
      G.make.autoName = newName(G.make.state);
      G.make.name = G.make.autoName;
      if(nameIn) nameIn.value = G.make.name;
    }
    const hint = el("mkCultHint");
    if(hint) hint.textContent = cultureHint(G.make.state);
  });
  if(mkD) mkD.addEventListener("input", () => { G.make.dist = clamp(+mkD.value || 1, 1, 24); });
  const mkReroll = el("mkNameReroll");
  if(mkReroll) mkReroll.addEventListener("click", () => {
    G.make.autoName = newName(G.make.state);
    G.make.name = G.make.autoName;
    const nameIn = el("nameIn");
    if(nameIn) nameIn.value = G.make.name;
  });
  card.querySelectorAll("[data-set]").forEach(b => b.addEventListener("click", () => {
    const k = b.getAttribute("data-set"), raw = b.getAttribute("data-val");
    if(k === "party") G.make.party = raw;
    else if(k === "frame"){
      L.frame = raw;
      L.wear = raw === "fem" ? "skirt_suit" : "suit_tie";
      if(raw === "fem") L.beard = false;
      L.height = raw === "fem" ? Math.min(L.height, 1.77) : Math.max(L.height, 1.66);
    }
    else if(k === "wear") L.wear = raw;
    else if(k === "style") L.style = +raw;
    else if(k === "glasses") L.glasses = raw === "1";
    else if(k === "beard") L.beard = raw === "1";
    else L[k] = +raw;
    G.make.name = el("nameIn").value;
    nameCard();
  }));
  const hR = el("mkH"), bR = el("mkB");
  hR.addEventListener("input", () => { L.height = +hR.value/100; mkPreview(); });
  bR.addEventListener("input", () => { L.build = +bR.value/100; mkPreview(); });
  el("mkRand").addEventListener("click", () => {
    G.make.look = makeLook({frame: chance(.5) ? "masc" : "fem"});
    G.make.state = G.make.state || pick(STATES);
    G.make.autoName = newName(G.make.state);
    G.make.name = G.make.autoName;
    nameCard();
  });
  const mkBack = el("mkNameBack");
  if(mkBack) mkBack.addEventListener("click", (ev) => {
    try{ ev.preventDefault(); ev.stopPropagation(); }catch(e){}
    titleClearWipeAndOpen();
  });
  el("mkGo").addEventListener("click", () => {
    G.make.name = (el("nameIn").value || G.make.name).slice(0,40);
    G.make.answers = G.make.answers || [];
    quizCard();
  });
}

/* ── the questionnaire ─────────────────────────────────── */
function quizStanceLive(){
  const {pos} = quizPosFrom(G.make.answers || []);
  const dF = distTo(pos, ARCH.FED), dC = distTo(pos, ARCH.COM);
  const answered = (G.make.answers || []).filter(x => x !== null && x !== undefined).length;
  /* As answers land, benches that no longer fit check away so the card stays short */
  const away = {FED:false, COM:false, IND:false, OWN:false};
  if(answered >= 2){
    const gap = Math.abs(dF - dC);
    if(dF + 18 < dC) away.COM = true;
    if(dC + 18 < dF) away.FED = true;
  }
  if(answered >= 4){
    const near = Math.min(dF, dC);
    if(near < 55){ away.IND = true; away.OWN = true; }
    if(near > 78){ /* homeless path opens — keep IND/OWN, mute the far bench harder */
      if(dF > dC) away.FED = true; else away.COM = true;
    }
  }
  return {pos, dF, dC, answered, away};
}
function quizCard(){
  if(!G.make.answers || G.make.answers.length !== QUIZ.length)
    G.make.answers = QUIZ.map((_, i) => (G.make.answers && G.make.answers[i] !== undefined ? G.make.answers[i] : null));
  const A = G.make.answers;
  const doneN = A.filter(x => x !== null && x !== undefined).length;
  let cur = A.findIndex(x => x === null || x === undefined);
  const allDone = cur < 0;
  if(allDone) cur = QUIZ.length - 1;
  const live = quizStanceLive();
  const stance = [
    {k:"FED", t:"Federalist"},
    {k:"COM", t:"Commonwealth"},
    {k:"IND", t:"Independent"},
    {k:"OWN", t:"Own party"}
  ].map(p => {
    const tone = p.k === "FED" ? "fed" : p.k === "COM" ? "com" : p.k === "IND" ? "ind" : "dyn";
    const style = p.k === "OWN" ? ' style="--pc:' + (G.make.ownColor || unusedPartyColor()) + '"' : "";
    return '<span class="chip chip--' + tone + (live.away[p.k] ? " is-away" : "") + '"' + style + '>' + p.t + '</span>';
  }).join("");
  /* Answered questions check away into a single compact strip — edit by tapping */
  const checked = A.map((ai, qi) => {
    if(ai === null || ai === undefined) return "";
    return '<button type="button" data-edit="' + qi + '"><b>' + (qi+1) + '.</b> ' + QUIZ[qi].a[ai].t + '</button>';
  }).join("");
  let body = "";
  if(allDone){
    body =
      '<p class="qz__prog">Six of six — stance set</p>' +
      '<div class="qz__stance" aria-label="Party stance">' + stance + '</div>' +
      '<p>That is enough for the returning officer. You can still open any answer above and change it.</p>';
  } else {
    const q = QUIZ[cur];
    body =
      '<p class="qz__prog">Question ' + (cur+1) + ' of ' + QUIZ.length + '</p>' +
      '<div class="qz__stance" aria-label="Party stance">' + stance + '</div>' +
      '<div class="qz__q">' + q.q + '</div>' +
      '<div class="qz__opts">' +
        q.a.map((a, ai) =>
          '<button type="button" class="mk__opt" data-q="' + cur + '" data-a="' + ai + '">' + a.t + '</button>'
        ).join("") +
      '</div>';
  }
  card.innerHTML =
    '<div class="eyebrow">Before the ballot</div>' +
    '<h1>Nobody is going to tell you what you think.</h1>' +
    '<p>One question at a time. As you answer, benches that no longer fit check away — no scrolling a wall of picks.</p>' +
    (checked ? '<div class="qz__done" aria-label="Answers so far">' + checked + '</div>' : '') +
    body +
    '<div class="card__actions">' +
      '<button class="btn btn--ghost" type="button" id="qzBack">Back</button>' +
      '<button class="btn" type="button" id="qzGo"' + (allDone ? "" : " disabled") +
        '>See where that puts me</button></div>';
  veil.hidden = false;
  card.querySelectorAll("[data-q]").forEach(b => b.addEventListener("click", () => {
    G.make.answers[+b.getAttribute("data-q")] = +b.getAttribute("data-a");
    quizCard();
  }));
  card.querySelectorAll("[data-edit]").forEach(b => b.addEventListener("click", () => {
    const qi = +b.getAttribute("data-edit");
    G.make.answers[qi] = null;
    /* clear later answers so stance re-forms forward from the edit */
    for(let i = qi + 1; i < QUIZ.length; i++) G.make.answers[i] = null;
    quizCard();
  }));
  el("qzBack").addEventListener("click", () => {
    if(doneN > 0 && !allDone){
      /* step back one question instead of dumping to the look card */
      for(let i = QUIZ.length - 1; i >= 0; i--){
        if(A[i] !== null && A[i] !== undefined){ G.make.answers[i] = null; break; }
      }
      quizCard();
      return;
    }
    nameCard();
  });
  const go = el("qzGo");
  if(go) go.addEventListener("click", sortedCard);
}
function sortedCard(){
  const r = sortHat();
  G.make.sorted = r;
  G.make.ownName = G.make.ownName || partyNameFor(r.pos);
  G.make.ownColor = G.make.ownColor || unusedPartyColor();
  ensureParties();
  const axisLine = AXES.map(a => a.n.split(" / ")[r.pos[a.k] > 0 ? 1 : 0].toLowerCase() +
    " " + Math.abs(r.pos[a.k])).join(" · ");
  const extras = partyKeys().filter(k => k !== "FED" && k !== "COM" && k !== "IND" && k !== "OWN");
  const extraBtns = extras.map(k => {
    const P = G.parties[k];
    return '<button class="btn btn--ghost" type="button" data-join="' + k + '" style="border-color:' + P.color + '">' +
      '<i class="dot" style="background:' + P.color + ';display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:middle"></i>' +
      'Join the ' + P.name + '</button>';
  }).join("");
  const swatches = PARTY_PALETTE.map(c =>
    '<button type="button" class="swatch' + (c.toLowerCase() === String(G.make.ownColor).toLowerCase() ? ' is-on' : '') +
      '" data-color="' + c + '" style="background:' + c + '" title="' + c + '" aria-label="Party colour ' + c + '"></button>'
  ).join("");
  card.innerHTML =
    '<div class="eyebrow">The returning officer reads it back</div>' +
    '<h1>' + (r.homeless
      ? "Neither of them fits you."
      : (r.near === "FED" ? "That is a Federalist." : "That is a Commonwealth answer.")) + '</h1>' +
    '<p class="dream">' + axisLine + '</p>' +
    '<p>' + (r.homeless
      ? "You are a long way from both benches. You can still take a party's ticket and live with it, " +
        "sit as an independent, or put your own name over a door and see who follows."
      : "You could take their ticket. You could also refuse it — plenty do, and some of them last longer.") +
    '</p>' +
    '<p id="hatSay" class="muted" style="min-height:1.2em"></p>' +
    '<div class="card__actions">' +
      '<button class="btn' + (r.near==="FED" && !r.homeless ? '' : ' btn--ghost') +
        '" type="button" data-join="FED">Take the Federalist ticket</button>' +
      '<button class="btn' + (r.near==="COM" && !r.homeless ? '' : ' btn--ghost') +
        '" type="button" data-join="COM">Take the Commonwealth ticket</button>' +
      '<button class="btn btn--ghost" type="button" data-join="IND">Sit as an independent</button>' +
      extraBtns +
      '<button class="btn' + (r.homeless ? '' : ' btn--ghost') +
        '" type="button" data-join="OWN" id="foundOwn">Found your own party</button>' +
      '<button class="btn btn--ghost" type="button" id="sortedBack">Back</button>' +
    '</div>' +
    '<p style="margin:8px 0 0"><button class="btn btn--ghost" type="button" id="hatRead" style="font-size:12px;min-height:0;padding:4px 10px">Let the returning officer read it back</button></p>' +
    '<div id="ownStep" hidden><p class="muted" style="margin:10px 0 4px">Name your party, and choose its colour. Then found it.</p>' +
      '<p><input class="mk__name" id="ownName" value="' + G.make.ownName + '" maxlength="42" style="font-size:19px"></p>' +
      '<div class="swatches" id="ownSwatches" aria-label="Party colour">' + swatches + '</div></div>';
  veil.hidden = false;
  const hb = el("hatRead");
  if(hb) hb.addEventListener("click", async () => {
    const out = el("hatSay");
    /* the officer reads it back out of the form itself */
    hb.disabled = true;
    const P = r.pos, dom = AXES.slice().sort((a,b) => Math.abs(P[b.k]) - Math.abs(P[a.k]))[0];
    const strong = Math.abs(P[dom.k]) > 55;
    const bench = r.homeless ? "neither bench, which is its own kind of answer"
                : r.party === "FED" ? "the Federalist side of the room"
                : r.party === "COM" ? "the Commonwealth side of the room"
                : "the cross benches";
    out.textContent = fresh(() =>
      pick(["Right. Let us see.", "Mm. I have read worse.", "I have had four hundred of these this month."]) +
      " You come down " + (P[dom.k] > 0 ? dom.hi : dom.lo).toLowerCase() +
      " on " + dom.k + (strong ? ", and hard" : ", though not by much") + ". " +
      pick(["That puts you on ", "The form says ", "On paper that is "]) + bench + ". " +
      pick(["Whether you stay there is not my business.",
            "People change their minds in that building. Not often.",
            "Sign at the bottom and mind how you go.",
            "It is not a verdict. It is a starting position."]));
    return;

    hb.disabled = true; out.textContent = "The returning officer reads the form…";
    const lines = QUIZ.map((q,i) => "- " + q.q + " → " + (G.make.answers[i] !== undefined ? q.a[G.make.answers[i]].t : "no answer"));
    try{
      const res = await SAMPLE(
        "You are a dry, unsentimental returning officer in a fictional republic, registering a new " +
        "candidate. Below is how they answered the standard six questions. In 2-4 sentences, tell them " +
        "plainly what their answers add up to and which bench they belong on — Federalist (market, order, " +
        "defence, thrift), Commonwealth (public spending, provision, dovish), or neither. Be blunt and a " +
        "little weary. Do not flatter. No lists, no headings.\n\nCandidate: " + G.make.name + "\n" +
        lines.join("\n") + "\n\nComputed leaning: " + AXES.map(a => a.k + " " + r.pos[a.k]).join(", ") +
        (r.homeless ? "\nThey fit neither bench well." : "\nThey are closest to the " +
          (r.near === "FED" ? "Federalists" : "Commonwealth") + "."),
        {modelTier:"quick", onText:({text}) => { out.textContent = text; }});
      out.textContent = res.text;
    }catch(e){
      out.textContent = (e && e.text) ? e.text : "The officer says nothing useful.";
      hb.disabled = false;
    }
  });
  card.querySelectorAll("[data-color]").forEach(b => b.addEventListener("click", () => {
    G.make.ownColor = b.getAttribute("data-color");
    card.querySelectorAll("[data-color]").forEach(x => x.classList.toggle("is-on", x === b));
    const found = el("foundOwn");
    if(found) found.style.borderColor = G.make.ownColor;
  }));
  {
    const found = el("foundOwn");
    if(found) found.style.borderColor = G.make.ownColor;
  }
  card.querySelectorAll("[data-join]").forEach(b => b.addEventListener("click", () => {
    const k = b.getAttribute("data-join");
    G.make.party = k;
    if(k === "OWN"){
      const step = el("ownStep");
      if(step && step.hidden){ step.hidden = false; b.textContent = "Found it"; try{ el("ownName").focus(); }catch(e){} return; }   /* first press asks for the name and colour; the second founds it */
      const nm = (el("ownName").value || G.make.ownName).slice(0,42);
      const col = G.make.ownColor || unusedPartyColor();
      G.own = {name:nm, color:col, born:G.congress || 1};
      registerParty({id:"OWN", name:nm, color:col, born:G.congress || 1, short:nm.split(/\s+/)[0] || "Own"});
    } else if(k !== "FED" && k !== "COM" && k !== "IND"){
      /* joining a party that already formed earlier in this world */
      ensureParties();
    }
    startRun();
  }));
  const sb = el("sortedBack");
  if(sb) sb.addEventListener("click", (ev) => {
    try{ ev.preventDefault(); ev.stopPropagation(); }catch(e){}
    titleClearWipeAndOpen();
  });
}
function startRun(){
  const r = G.make.sorted || {pos:{econ:0,lib:0,def:0,wel:0}, loyal:0};
  /* 20261110bv: wipe the active slot only after a verified archive. Archives stay. */
  if(G._wipeOnOath){
    G._wipeOnOath = false;
    if(G._archiveVerified && G._archiveVerified.ok){
      try{ careerWipeActive(); }catch(e){}
      /* 20261110bx: reset again after the verified wipe, in case a peek
         between the two re-ratcheted the guard. Do not reset when the
         active slot was left in place. */
      try{ if(typeof SV !== "undefined" && SV){ SV.rank = null; SV.lastBody = null; } }catch(e){}
    }else{
      /* Should have been archived on Yes. If not, do not wipe. */
      try{ careerArchiveCurrent("start-run"); }catch(e){}
    }
  }
  if(mkMesh){ scene.remove(mkMesh); mkMesh = null; }
  mkLights(false);
  veil.classList.remove("veil--make");
  veil.hidden = true;
  buildWorld(G.make.name, G.make.party, G.make.look);
  /* your answers are your politics, not a preset */
  G.you.pos = {econ:r.pos.econ, lib:r.pos.lib, def:r.pos.def, wel:r.pos.wel};
  G.you.district = {
    econ:clamp(r.pos.econ + rint(-38,38),-100,100), lib:clamp(r.pos.lib + rint(-38,38),-100,100),
    def:clamp(r.pos.def + rint(-38,38),-100,100),  wel:clamp(r.pos.wel + rint(-38,38),-100,100)};
  G.you.loyalTrait = r.loyal;
  G.you.answers = (G.make.answers || []).slice();
  /* Player is an individual too — same fields NPCs carry into their suite */
  if(!G.you.traits){
    G.you.traits = {
      ambition:rint(20,88), conviction:rint(22,90),
      loyalty:clamp(48 + Math.round(r.loyal*0.55), 0, 100),
      vanity:rint(15,82), discretion:rint(18,90), temper:rint(12,80)
    };
  } else {
    G.you.traits.loyalty = clamp((G.you.traits.loyalty||50) + Math.round(r.loyal*0.35), 0, 100);
  }
  if(!G.you.creed) G.you.creed = (G.make && G.make.creed && G.make.creed !== "consul") ? G.make.creed : "latin";
  if(!G.you.origin) G.you.origin = pick(ORIGINS).k;
  if(!G.you.bg) G.you.bg = pick(BACKGROUNDS).t;
  if(!G.you.suite) G.you.suite = "Cannon " + rint(101, 448);
  try{ autoInit(G.you); ensureSelfhood(G.you); mindEnsure(G.you); }catch(e){}
  G.you.standing = clamp(55 + r.loyal*0.5, 10, 90);
  if(G.make.party === "OWN"){
    ensureParties();
    G.seatsBy.OWN = 1;
    G.you.standing = 25;
    G.you.influence = 16;
    note("Founded the " + G.own.name + ". One seat, and no whip but your own.", true);
    setPrecedent("founded the " + G.own.name, "that a member may sit under a party of their own making");
  } else if(G.make.party === "IND"){
    G.seatsBy.IND++;
    G.you.standing = 30;
    note("Took the oath as an independent.", true);
  } else {
    note("Sworn in to the " + ordinal(G.congress) + " Congress of " + (G.country?G.country.name:"the Republic") + " on the " + partyName(G.make.party) + " ticket.", true);
  }
  try{
    document.body.classList.add("keys-intro");
    setTimeout(() => { try{ document.body.classList.remove("keys-intro"); }catch(e){} }, 45000);
  }catch(e){}
  /* the room forms a first impression from where you actually stand */
  G.members.forEach(m => {
    const fit = -Math.abs(m.pos.econ-G.you.pos.econ)/8 - Math.abs(m.pos.wel-G.you.pos.wel)/8 + 12;
    m.rel.warmth = clamp(m.rel.warmth + clamp(Math.round(fit), -14, 14), -100, 100);
    if(Math.abs(fit) > 9)
      remember(m, fit > 0 ? "You said the right things at the start, and I remembered."
                          : "I heard what you stood for on day one and I did not care for it.",
        fit > 0 ? 5 : -5);
  });
  begin();
}
function begin(){
  if(!G.you || !(G.members && G.members.length)){
    G._booting = false;
    try{ opening(); }catch(e){ nameCard(); }
    return;
  }
  /* FREEZE FIX: Continuity first. Heavy work deferred. Furniture, Caesar, Consular, horcruxes stay. */
  G.running = true; G.over = false;
  try{ armPremise(); }catch(e){}
  G._bootGraceUntil = performance.now() + 8000;
  try{ sweepAbroad(); moved(); }catch(e){}
  G._deferPeopleUntil = performance.now() + ((G.room === "corridor") ? 6500 : 2500);
  G.bare = true;
  document.body.classList.add("is-bare");
  document.body.classList.remove("ui-open");
  try{
    PROC.on = false; PROC.phase = "idle"; PROC.speaker = null; PROC.e = null;
    const bar = el("procBar"); if(bar) bar.hidden = true;
    document.body.classList.remove("in-session");
  }catch(e){}
  G.moving = false;
  G.speechApproach = null;
  if(G.you) G.you.sitting = false;
  const trap = (G.room === "floor" || G.room === "committee" || G.room === "caucus" || G.room === "press") ? G.room : null;
  if(trap){
    G.room = "corridor";
    G._savedCam = false;
  }
  if(!G.room || !ROOMS[G.room]) G.room = "office";
  try{ if(G.you && abroadOffice() && !outsideAllowed(G.room)) G.room = homeRoom(); }catch(e){}
  if(G.you) G.you.room = G.room;
  try{ ensureParties(); }catch(e){}
  try{ catchClear("begin"); }catch(e){}
  try{ if(TALK.open) closeTalk(); }catch(e){}
  G.doorGrace = (G.t || 0) + 1.6;
  G._crowdPauseUntil = performance.now() + 600;
  G._deferPeopleUntil = performance.now() + 400;
  try{
    /* Keep saved gfx; migrateGfx pins Best/fullDetail when unset. Never force Simple here.
       applyQuality with _aqBusy skips mid-begin room rebuild+syncPeople. */
    migrateGfx();
    _aqBusy = true;
    try{ applyQuality(); }finally{ _aqBusy = false; }
  }catch(e){ try{ _aqBusy = false; }catch(e2){} }
  const R0 = ROOMS[G.room];
  try{ el("whereName").textContent = R0.t; el("whereTag").textContent = R0.tag; }catch(e){}
  if(!G._savedCam){
    try{
      if(trap){
        const dr = (DOORS.corridor || []).find(d => d.to === trap);
        if(dr){
          const hp = doorAt("corridor", dr);
          const b = roomBox("corridor");
          cam.x = clamp(hp.x + (dr.side === "left" ? 1.05 : dr.side === "right" ? -1.05 : 0), -b.hw, b.hw);
          cam.z = clamp(hp.z + (dr.side === "front" ? 1.05 : dr.side === "back" ? -1.05 : 0), b.d0, b.d1);
          cam.yaw = dr.side === "left" ? Math.PI/2 : dr.side === "right" ? -Math.PI/2 : 0;
        } else {
          const sp = safeSpawn("corridor"); cam.x = sp.x; cam.z = sp.z; cam.yaw = 0;
        }
      } else {
        const sp = safeSpawn(G.room); cam.x = sp.x; cam.z = sp.z; cam.yaw = 0;
      }
    }catch(e){}
  }
  try{ veil.hidden = true; card.classList.remove("card--open"); veil.classList.remove("veil--make"); }catch(e){}
  try{ document.body.classList.remove("boot-menu"); }catch(e){}
  const roomId = G.room;
  G._booting = false;
  requestAnimationFrame(() => {
    try{
      if(!_buildingRoom){
        try{ buildRoomShell(roomId); _roomBuiltId = roomId; _roomFurnished = false; }catch(e0){
          try{ buildRoom(roomId); }catch(e1){}
        }
        try{ resize(); }catch(e){}
      }
    }catch(e){
      if(window.console) console.warn("begin build", e);
      try{ G.room = "office"; buildRoomShell("office"); _roomBuiltId = "office"; _roomFurnished = false; }catch(e2){}
    }
    try{ forcePaint(); }catch(e){}
    /* 20260928a: after shell is up, drip-warm a neighbor shell — never block begin. */
    try{
      nextFrameOrTimeout(() => { try{ warmAhead(); }catch(e){} }, 0);
    }catch(e){}
    requestAnimationFrame(() => {
      try{
        if((G.room || roomId) === "corridor") return;
        if(!_roomFurnished && !_buildingRoom) buildRoom(G.room || roomId);
      }catch(e){}
      try{ forcePaint(); }catch(e){}
    });
    setTimeout(() => {
      const run = (fn) => { try{ fn(); }catch(e){} };
      const chain = (steps, i) => {
        if(i >= steps.length) return;
        const step = steps[i];
        if(typeof yieldMain === "function") yieldMain(() => { run(step); chain(steps, i + 1); });
        else { run(step); setTimeout(() => chain(steps, i + 1), 16); }
      };
      chain([
        () => { ensureMythHistory(); ensureGreatest(); },
        () => { ensureConsularCaucus(); },
        () => { everyone().forEach(m => { if(m.room === G.room) placeInRoom(m); }); },
        () => { if(!_roomFurnished && !_buildingRoom) buildRoom(G.room || roomId); },
        () => { /* Corridor does not remesh on Continue. Feet already walk. */ },
        () => { try{ queueSave(); }catch(e){} }
      ], 0);
    }, 2500);
  });
  setTimeout(() => {
    if(G.running) return;
    G._booting = false;
    try{ forceUnstickMove(); }catch(e){}
    try{ G.running = true; }catch(e){}
    try{ forcePaint(); }catch(e){}
  }, 4000);
}

/* ── Add to Home Screen ──────────────────────────────────
   An icon, a manifest and the mobile web-app meta, injected into
   the head at runtime so it works from inside the viewer. */
(function(){
  try{
    const ic = document.createElement("canvas"); ic.width = ic.height = 192;
    const x = ic.getContext("2d");
    x.fillStyle = "#161A20"; x.fillRect(0,0,192,192);
    x.fillStyle = "#A45F27"; x.fillRect(0,150,192,42);
    x.fillStyle = "#E2E5E9";
    x.beginPath(); x.moveTo(96,26); x.lineTo(160,74); x.lineTo(32,74); x.closePath(); x.fill();
    for(let i=0;i<5;i++) x.fillRect(40+i*26, 82, 13, 60);
    x.fillRect(28,142,136,10);
    const icon = ic.toDataURL("image/png");
    const man = {
      name:"One Nation, Under, ME.", short_name:"Under ME",
      display:"standalone", orientation:"any",
      background_color:"#0D1014", theme_color:"#161A20", start_url:location.href,
      icons:[{src:icon, sizes:"192x192", type:"image/png", purpose:"any maskable"}]
    };
    const add = (tag, attrs) => {
      const e = document.createElement(tag);
      for(const k in attrs) e.setAttribute(k, attrs[k]);
      if(document.head) document.head.appendChild(e);
    };
    add("link", {rel:"manifest",
      href:"data:application/manifest+json," + encodeURIComponent(JSON.stringify(man))});
    add("link", {rel:"apple-touch-icon", href:icon});
    add("meta", {name:"apple-mobile-web-app-capable", content:"yes"});
    add("meta", {name:"mobile-web-app-capable", content:"yes"});
    add("meta", {name:"apple-mobile-web-app-status-bar-style", content:"black-translucent"});
    add("meta", {name:"apple-mobile-web-app-title", content:"Under ME"});
    add("meta", {name:"theme-color", content:"#161A20"});
  }catch(e){}
})();

/* film grain, generated once */
(function(){
  const c = document.createElement("canvas");
  c.width = c.height = 110;
  const x = c.getContext("2d");
  const img = x.createImageData(110,110), d = img.data;
  for(let i=0;i<d.length;i+=4){
    const v = 128 + (Math.random()-0.5)*190;
    d[i]=d[i+1]=d[i+2]=v; d[i+3]=255;
  }
  x.putImageData(img,0,0);
  try{ el("grain").style.backgroundImage = "url(" + c.toDataURL("image/png") + ")"; }catch(e){}
})();

try{ buildLobbies(); }catch(e){ if(window.console) console.warn("buildLobbies", e); }
if(G.bare !== false){ G.bare = true; document.body.classList.add("is-bare"); }
document.body.classList.remove("ui-open");
try{ migrateGfx(); }catch(e){}
/* Keep the opening card responsive. Quality setup and the first room build
   happen after Continue/New career, never on the menu's critical path. */
try{ resize(); }catch(e){}
function bootTitle(){
  /* 20261110bv JUPITER: do not decide "no save" until IndexedDB has answered
     (or a short timeout). A large career is often IDB-only. */
  const fallback = (e) => {
    if(window.console) console.warn("opening", e);
    try{
      veil.hidden = false;
      card.classList.add("card--open");
      card.innerHTML = '<h1>One Nation, Under, ME.</h1><p>Could not finish the start card.</p>' +
        '<div class="card__actions">' +
        '<button class="btn" type="button" id="cont" data-gp="boot:cont">Continue</button>' +
        '<button class="btn" type="button" id="fresh" data-gp="boot:fresh">Start a new career</button></div>';
      const c = el("cont"), f = el("fresh");
      if(c) c.onclick = () => { try{ cardActContinue(); }catch(err){ softUnstickVeil(); } };
      if(f) f.onclick = () => { try{ bootFreshCareer(); }catch(err){ softUnstickVeil(); } };
    }catch(e2){}
  };
  const safeOpen = () => {
    try{
      if(G._booting) return;
      if(G.make) return;
      if(G.running && G.you && G.members && G.members.length) return;
      opening();
    }catch(e){ fallback(e); }
  };
  let peeked = null;
  try{ peeked = peekSave(); }catch(e){}
  if(peeked) safeOpen();
  else {
    try{
      document.body.classList.add("boot-menu");
      card.classList.add("card--open");
      veil.hidden = false;
      card.innerHTML = '<div class="eyebrow">One Nation, Under, ME.</div><h1>Looking for your career…</h1><p>Checking this browser\'s larger store for a saved sitting.</p>';
    }catch(e){}
  }
  engIdbWhenReady(safeOpen, 2000);
}
try{ bootTitle(); }catch(e){
  if(window.console) console.warn("opening", e);
  try{
    veil.hidden = false;
    card.classList.add("card--open");
    card.innerHTML = '<h1>One Nation, Under, ME.</h1><p>Could not finish the start card.</p>' +
      '<div class="card__actions">' +
      '<button class="btn" type="button" id="cont" data-gp="boot:cont">Continue</button>' +
      '<button class="btn" type="button" id="fresh" data-gp="boot:fresh">Start a new career</button></div>';
    const c = el("cont"), f = el("fresh");
    if(c) c.onclick = () => { try{ cardActContinue(); }catch(err){ softUnstickVeil(); } };
    if(f) f.onclick = () => { try{ bootFreshCareer(); }catch(err){ softUnstickVeil(); } };
  }catch(e2){}
}

/* warmRooms DISABLED (2026-09-08 freeze fix, reconfirmed 2026-09-09):
   buildRoom() rebuilds the single shared `roomGroup` used by whichever
   room is currently on screen, so pre-building other rooms in the
   background does not warm a cache — it repeatedly clears and replaces
   the room the player is standing in, synchronously, on the main thread.
   A 2026-09-09 attempt to pre-load caucus/press/committee/floor/steps via
   requestIdleCallback reproduced the original freeze (worse: it could
   fire the instant a saved game loads with G.running already true,
   before the player even reached the start card) and was reverted.
   Rooms build on first enter instead; see buildRoom()/rebuildRoomStaged(). */
(function warmRooms(){ /* no-op */ })();

/* Continuity: wall-clock autosave while running (survives long AFK in one room). */
setInterval(() => {
  try{
    if(!G.running || G.over || !G.you || !G.members || !G.members.length) return;
    if(houseQuiet()) return; /* feet ok 20260921f */
    queueSave();
  }catch(e){}
}, 45000);
setInterval(() => {
  try{
    if(typeof document !== "undefined" && document.hidden) return;
    if(typeof saveBusy !== "undefined" && saveBusy) return;
    if(typeof _buildingRoom !== "undefined" && _buildingRoom) return;
    try{ if(houseQuiet() && G.moving) return; }catch(e){}
    if(performance.now() - (_lastDrawn || 0) > 2200) kickFrame();
  }catch(e){}
}, 1500);
addEventListener("beforeunload", () => {
  /* 20261021d: the sync flush happens on pagehide only (it always follows); nothing here. */
});
addEventListener("visibilitychange", () => {
  try{
    if(document.visibilityState === "hidden"){
      /* Hidden may queue only if feet are still. */
      if(G.you && G.members && G.members.length && !playerMoving() && !houseQuiet()) queueSave();
    } else {
      last = performance.now();
      cam.vx = 0; cam.vz = 0; cam.yawVel = 0;
      try{ for(const k in keys) keys[k] = false; }catch(e){}
      try{ premisePulse(); }catch(e){}
      kickFrame();
    }
  }catch(e){}
});
try{
  window.ONUM = {
    goTo, enterRoom, forceUnstickMove,
    room(){ return G.room; },
    moving(){ return !!G.moving; },
    running(){ return !!G.running; },
    cam(){ return {x:cam.x, z:cam.z, yaw:cam.yaw, sitting:!!(G.you && G.you.sitting), furnished:!!_roomFurnished}; },
    walk(vx, vz){ cam.vx = vx; cam.vz = vz; G.running = true; },
    day(){ return {day:G.day, sittingDay:G.sittingDay, minute:G.minute, rank:careerRank(G)}; },
    pane(id){
      try{
        if(id && id.indexOf("pane") !== 0){
          id = "pane" + id.charAt(0).toUpperCase() + id.slice(1);
        }
        if(id) showPane(id);
      }catch(e){}
      return (typeof currentPane === "function") ? currentPane() : null;
    },
    kick(){ try{ kickFrame(); }catch(e){} return true; },
    stations(){
      const fade = el("fade");
      return {
        room: G.room,
        running: !!G.running,
        moving: !!G.moving,
        sitting: !!(G.you && G.you.sitting),
        furnished: !!_roomFurnished,
        camOk: isFinite(cam.x) && isFinite(cam.z) && isFinite(cam.yaw),
        glLost: !!GL_LOST,
        fade: fade ? String(fade.style.opacity || "0") : "0",
        veil: !!(veil && !veil.hidden),
        day: G.day,
        people: (typeof hereNow === "function" ? hereNow().length : 0),
        loopLag: performance.now() - (_lastDrawn || 0),
        rooms: (typeof ROOM_ORDER !== "undefined" ? ROOM_ORDER.slice() : [])
      };
    },
    consular(){ try{ ensureConsularCaucus(); }catch(e){} return (G.members||[]).filter(m => m && isConsular(m)).map(m => m.name); },
    horcrux(){ const h = horcruxOf(G.room); return h ? h.id : null; },
    lore(){ return consularLoreEnsure(); },
    gather(h){ try{ ensureConsularCaucus(); consularBody(h == null ? 12 : h); }catch(e){} return G.consularAtBronze || 0; }
  };
}catch(e){}
/* NEPTUNE-UNIFORMS BEGIN — loads neptune/onum-*.js (characters, flags, materials, office amenities).
   Everything is guarded: if a module fails to load, the game runs exactly as before. */
try{
  const NEP = {mods:null, decree:null, failed:false};
  window.NEPTUNE = NEP; NEP.debug = () => ({G, cam, camera, scene, govCard, PROPS, hereNow, syncPeople, enterRoom, purseShopActs, ROOMS});
  const GOV_MAP = {republic:"republic", democracy:"democracy", conservative:"parliamentary", commonwealth:"socialist",
    national:"dictatorship", monarchy:"constitutional_monarchy", empire:"empire", consular:"consular_republic",
    theocratic:"theocracy", junta:"junta", mob:"anarchist", oligarchy:"oligarchy", machine:"corporate"};
  const nepGov = () => { try{ return GOV_MAP[(G.regime && G.regime.form) || "republic"] || "republic"; }catch(e){ return "republic"; } };
  const nepHash = s => { let h = 2166136261; s = String(s == null ? "" : s); for(let i = 0; i < s.length; i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return (h >>> 0) % 100000 + 1; };
  const nepSeed = () => { try{ return nepHash(G.country && G.country.name); }catch(e){ return 1; } };
  NEP.isLeader = () => { try{ const y = G.you; if(!y) return false; return y.post === "speaker" || y.post === "leader" || heldOffice() === "pres"; }catch(e){ return false; } };
  NEP.nation = () => {
    if(!G.nepDecree && NEP.decree) G.nepDecree = NEP.decree;
    const d = G.nepDecree || null;
    return {govType:nepGov(), seed:nepSeed(), decree: d && d.active ? {govType:nepGov(), seed:nepSeed(), style:d.style || undefined} : null};
  };
  NEP.setDecree = (on, style) => {
    G.nepDecree = on ? {active:true, style:style || null, day:G.day} : null; NEP.decree = G.nepDecree;
    NEP.remeshAll();
  };
  NEP.remeshAll = () => { try{ everyone().forEach(m => { if(m && m.mesh){ try{ disposePersonMesh(m.mesh); }catch(e){} m.mesh = null; m.faceTex = null; } }); }catch(e){}
    try{ syncPeople(); }catch(e){}
    try{ if(typeof mkMesh !== "undefined" && mkMesh && G.make) mkPreview(); }catch(e){} };

  /* characters: the game's rig still runs (animation, seats), Neptune's figure is what is drawn.
     20261012u fallback: NEPTUNE.fullFigure = false keeps the game's own figure and only re-colours its clothes for a
     decreed uniform (uniformLook) with Neptune's insignia + lapel pin as overlays on the game's bones (dressGameRig). */
  const _buildPerson = buildPerson;
  /* the legs walk at the pace the body actually moves: the game's own gait weight eases it in and out, and the
     speed handed over is scaled so a step is about 0.6 m (an indoor pace of half a metre a second is short steps, not a glide) */
  const nepStride = p => { try{ if(!p || p === G.you || p.sitting) return 0; const gw = p._gw || 0; if(gw < 0.03) return 0; return Math.max(0.3, p._v || 0) * 2.0 * Math.min(1, gw * 1.4); }catch(e){ return 0; } };
  /* what the hand holds, so the arm that shows is the arm that holds it */
  /* the real ground speed, m/s: the figure plants each foot and lets the body pass over it (foot slip measured at 2 to 5% of the distance walked) */
  const nepGround = (p, g) => { try{ if(!p || p === G.you || p.sitting) return null;
      /* measured from where the body is actually drawn, frame to frame, so the feet match what you see at any frame rate */
      const u = g.userData, now = performance.now(), x = g.position.x, z = g.position.z;
      if(u._gvT){ const dtt = (now - u._gvT) / 1000; if(dtt > 0.002 && dtt < 1.0){ const sp = Math.min(3, Math.hypot(x - u._gvX, z - u._gvZ) / dtt); u._gv = (u._gv || 0) * 0.7 + sp * 0.3; } else u._gv = 0; }
      u._gvT = now; u._gvX = x; u._gvZ = z;
      return (u._gv || 0) < 0.04 ? 0 : u._gv; }catch(e){ return null; } };
  /* how fast the body is turning (rad/s), so a turn on the spot is stepped round */
  const nepTurn = g => { try{ const u = g.userData, now = performance.now(), a = g.rotation.y; let tr = 0;
      if(u._trT){ const dtt = (now - u._trT) / 1000; if(dtt > 0.002 && dtt < 1.0){ let da = a - u._trA; da = Math.atan2(Math.sin(da), Math.cos(da)); u._tr = (u._tr || 0) * 0.7 + (da / dtt) * 0.3; } }
      u._trT = now; u._trA = a; return u._tr || 0; }catch(e){ return 0; } };
  /* eye contact: the person you are talking with looks at you; anyone standing close, not walking, glances your way */
  const NEP_EYE = new THREE.Vector3();
  const nepLook = (p, c) => { try{ if(!p || p === G.you || !c) return null; const d = Math.hypot(cam.x - p.x, cam.z - p.z);
      const talking = TALK.open && TALK.m === p, idle = (p._gw || 0) < 0.1;
      if(!(talking && d < 6) && !(idle && d < 2.4)) return null; c.getWorldPosition(NEP_EYE); return NEP_EYE; }catch(e){ return null; } };
  const nepCarry = g => { try{ const cy = g.userData._cy; if(!cy || !cy.grp || !cy.grp.visible || !cy.nep || cy.kind === "none") return null; return {side:cy.side, pose:cy.kind, sip:cy.sip || 0}; }catch(e){ return null; } };
  const nepDressInfo = p => { const nat = NEP.nation();
    const st = p.state || (p.kind === "you" && G.you && G.you.state) || (G.country && G.country.name) || "home";
    return NEP.mods.chars.dressFor({homeFlag:{type:nepGov(), seed:nepHash(st)}}, nat); };
  buildPerson = function(p){
    try{
      const C = NEP.mods && NEP.mods.chars;
      if(NEP.fullFigure === false && C && C.dressGameRig && p && p.look){
        const dress = nepDressInfo(p), L0 = p.look, L1 = dress.uniform ? C.uniformLook(L0, dress.uniform) : L0;
        let g = null;
        if(L1 !== L0) p.look = L1;
        try{ g = _buildPerson(p); } finally { p.look = L0; }
        try{ if(g && !g.userData.cheap) C.dressGameRig(THREE, g, {look:L0, uniform:dress.uniform, homeFlag:dress.homeFlag}); }
        catch(e){ if(!NEP._dw){ NEP._dw = true; console.warn("NEPTUNE dress", e); } }
        return g;
      }
    }catch(e){ if(!NEP._warned){ NEP._warned = true; console.warn("NEPTUNE character", e); } }
    const g = _buildPerson(p);
    try{
      const C = NEP.mods && NEP.mods.chars;
      if(NEP.fullFigure === false || !C || !p || !p.look || !g || g.userData.cheap) return g;
      const nat = NEP.nation();
      const st = p.state || (p.kind === "you" && G.you && G.you.state) || (G.country && G.country.name) || "home";
      const dress = C.dressFor({homeFlag:{type:nepGov(), seed:nepHash(st)}}, nat);
      const L = p.look;
      const o = C.optionsFromLook(L, {uniform:dress.uniform, homeFlag:dress.homeFlag, quality:G.gfx === "best" ? "high" : "med"});
      o.beard = L.beard ? (L.kaiser || nepHash(p.name || p.id) % 9 === 0 ? "kaiser" : true) : false;
      const h = C.makeCharacter(THREE, o);
      g.traverse(m => { if(m.isMesh || m.isSkinnedMesh) m.layers.set(31); });   /* hide the old figure, keep its bones */
      const n = h.group;
      n.scale.set(1/(g.scale.x || 1), 1/(g.scale.y || 1), 1/(g.scale.z || 1));
      g.add(n);
      g.userData.nep = h;
      let last = performance.now();
      let hooked = false;
      n.traverse(m => { if(hooked || !m.isMesh) return; hooked = true;
        m.onBeforeRender = function(r, s, cam){ const t = performance.now(), dt = Math.min(0.1, (t - last)/1000); last = t; if(dt <= 0) return;
          try{ h.update(dt, {camera:cam, sitting: p.kind === "you" ? !!(G.you && G.you.sitting) : !!(p.sitting && !G.noSit && !G.plainSit),
            moving: !!p.moving || !!p.walking, speed: nepStride(p), velocity: nepGround(p, g), turn: nepTurn(g), lookAt: nepLook(p, cam), talking: !!p.talking || !!(TALK.open && TALK.m === p) || !!(p.say && p.sayT > 0), carry: nepCarry(g)}); }catch(e){} }; });
    }catch(e){ if(!NEP._warned){ NEP._warned = true; console.warn("NEPTUNE character", e); } }
    return g;
  };

  /* flags: the national flag drawn by Neptune for the 21 government types */
  const _flagTexture = flagTexture;
  flagTexture = function(fl){
    try{ const F = NEP.mods && NEP.mods.flags;
      if(F && G.country && fl === G.country.flag) return F.makeFlagTexture(THREE, nepGov(), nepSeed(), {width:512}); }catch(e){}
    return _flagTexture(fl);
  };

  /* materials: Neptune PBR surfaces in place of the canvas ones, brightness matched to the original */
  const _matTex = matTex, NEP_MAT = new Map();
  const nepLum = img => { try{ const c = document.createElement("canvas"); c.width = c.height = 16; const x = c.getContext("2d"); x.drawImage(img, 0, 0, 16, 16);
    const d = x.getImageData(0, 0, 16, 16).data; let s = 0; for(let i = 0; i < d.length; i += 4) s += d[i]*.2126 + d[i+1]*.7152 + d[i+2]*.0722; return s / (d.length/4) / 255; }catch(e){ return 0; } };
  matTex = function(tex, rx, ry, rough, col){
    try{ const M = NEP.mods && NEP.mods.mats;
      if(M && tex && tex.image && G.gfx !== "simple"){
        const nm = tex.image === (TEX.marble && TEX.marble.image) ? "marble" : tex.image === (TEX.panel && TEX.panel.image) ? "wood_panel"
          : tex.image === (TEX.carpet && TEX.carpet.image) ? "carpet" : tex.image === (TEX.stone && TEX.stone.image) ? "limestone"
          : tex.image === (TEX.leather && TEX.leather.image) ? "leather" : null;
        if(nm){
          const k = nm + "|" + qrep(rx) + "|" + qrep(ry) + "|" + (col === undefined ? "x" : col);
          if(NEP_MAT.has(k)) return NEP_MAT.get(k);
          const m = M.makeMaterial(nm, THREE, {repeat:[qrep(rx), qrep(ry)], quality:G.gfx === "best" ? "high" : "med"});
          m.aoMap = null;  /* game geometry has no uv2 */
          const tx = M.getTextures(nm, THREE, {repeat:[qrep(rx), qrep(ry)], quality:G.gfx === "best" ? "high" : "med"});
          const a = nepLum(tex.image), b = nepLum(tx.map.image);
          const k2 = (a > 0 && b > 0) ? Math.max(0.5, Math.min(2, a / b)) : 1;
          m.color.setScalar(k2); if(col !== undefined) m.color.multiply(new THREE.Color(col));
          m.needsUpdate = true; NEP_MAT.set(k, m); return m;
        }
      } }catch(e){ if(!NEP._mw){ NEP._mw = true; console.warn("NEPTUNE material", e); } }
    return _matTex(tex, rx, ry, rough, col);
  };

  /* office amenities: session.html's own kAmenities() calls window.addOfficeAmenities (loaded below) for a new office.
     Its label sprites must not throw when the game's pick rays (no camera set) hit them. */
  try{ const _sr = THREE.Sprite.prototype.raycast; THREE.Sprite.prototype.raycast = function(rc, out){ if(!rc || !rc.camera) return; return _sr.call(this, rc, out); }; }catch(e){}

  /* the leader's decree: a button on the government card */
  const _govCard = govCard;
  govCard = function(){
    _govCard();
    try{
      if(!NEP.mods) return;
      const act = card.querySelector(".card__actions"); if(!act) return;
      const on = !!(G.nepDecree && G.nepDecree.active), lead = NEP.isLeader();
      const p = document.createElement("p");
      p.innerHTML = "<strong>Dress code.</strong> " + (on ? "By decree, everyone in public life wears the " + nepGov().replace(/_/g, " ") + " uniform."
        : "No uniform is decreed; members wear their own clothes and their home state's lapel pin.") + (lead ? "" : " Only the nation's leader can change it.");
      act.parentNode.insertBefore(p, act);
      if(lead){ const b = document.createElement("button"); b.type = "button"; b.className = "btn"; b.id = "nepDecree";
        b.textContent = on ? "Revoke the uniform decree" : "Decree a uniform";
        b.addEventListener("click", () => { NEP.setDecree(!on); govCard(); }); act.insertBefore(b, act.firstChild); }
    }catch(e){ console.warn("NEPTUNE decree", e); }
  };

  /* loader */
  const base = (() => { try{ return new URL("neptune/", location.href).href; }catch(e){ return "neptune/"; } })();
  const sc = document.createElement("script"); sc.src = base + "onum-office-amenities.js"; sc.onerror = () => console.warn("NEPTUNE: amenities not loaded"); document.head.appendChild(sc);
  /* 20261030n: walls/blocked props everywhere: the furniture runtime fixes (neptune/FURNITURE-QA.md: props through walls, radiator in doorways, in-wall ledges, off-wall TV) were written but never loaded. Look-only; collision untouched. */
  { const ff = document.createElement("script"); ff.src = base + "onum-furniture-fixes.js"; ff.onerror = () => console.warn("NEPTUNE: furniture fixes not loaded"); document.head.appendChild(ff); }
  /* 20261012u: ES modules cannot load from file:// (Play.bat / double-click), so Neptune never ran there and every
     person was the game's boxy fallback figure. The same modules ship pre-bundled as a classic script for that case. */
  const nepClassic = () => new Promise((ok, no) => { if(window.ONUM_NEPTUNE) return ok(window.ONUM_NEPTUNE);
    const s2 = document.createElement("script"); s2.src = base + "onum-neptune.js?v=" + (function(){ try{ return document.querySelector('meta[name="onum-build"]').content; }catch(e){ return ""; } })();   /* the build stamp, so a changed figure is never served from cache */
    s2.onload = () => window.ONUM_NEPTUNE ? ok(window.ONUM_NEPTUNE) : no(new Error("onum-neptune.js empty"));
    s2.onerror = () => no(new Error("onum-neptune.js missing")); document.head.appendChild(s2); });
  (location.protocol === "file:" ? nepClassic().then(b => [b.chars, b.flags, b.mats])
    : Promise.all([import(base + "onum-characters.js?v=" + (function(){ try{ return document.querySelector('meta[name="onum-build"]').content; }catch(e){ return ""; } })()), import(base + "onum-flags.js"), import(base + "onum-materials.js")])
      .catch(e => { console.warn("NEPTUNE: module import failed, using the bundled copy", e); return nepClassic().then(b => [b.chars, b.flags, b.mats]); })
  ).then(([c, f, m]) => {
    NEP.mods = {chars:c, flags:f, mats:m};
    try{ if(G.country) TEX.flag = flagTexture(G.country.flag); }catch(e){}
    NEP.remeshAll();
    try{ if(_roomBuiltId && !_buildingRoom){ const r = _roomBuiltId; _roomBuiltId = null; _roomFurnished = false; clearRoom(); buildRoom(r); } }catch(e){ console.warn("NEPTUNE rebuild", e); }
    console.log("NEPTUNE modules loaded");
  }).catch(e => { NEP.failed = true; console.warn("NEPTUNE modules failed; game continues without them", e); });
}catch(e){ try{ console.warn("NEPTUNE block", e); }catch(e2){} }
/* NEPTUNE-UNIFORMS END */
/* NEPTUNE-CLARITY BEGIN — "What's this?" explainers, live session transcript with glosses,
   session pace (Slow/Normal/Fast), wall-clock speaking timer, read/handled/outcome badges.
   Wraps existing functions only; every hook falls back to the original on any error. */
try{
  const CL = window.NEPTUNE_CLARITY = {items:[], sess:null, past:[], ctx:null, hold:false, paused:false, lastReal:0, said:{}};
  const LS = (k, v) => { try{ if(v === undefined) return JSON.parse(localStorage.getItem("clarity." + k) || "null"); localStorage.setItem("clarity." + k, JSON.stringify(v)); }catch(e){ return null; } };
  CL.pace = LS("pace") || "slow";
  CL.past = LS("sessions") || [];
  const PACE = {slow:0.5, normal:0.75, fast:1};
  const esc = s => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({"&":"&"+"amp;","<":"&"+"lt;",">":"&"+"gt;",'"':"&"+"quot;"}[c]));
  const now = () => { try{ return "d" + (typeof ndDayN === "function" ? ndDayN() : G.day) + " " + hhmm(); }catch(e){ return ""; } };
  const roomName = r => { try{ return (ROOMS[r] && ROOMS[r].t) || r || ""; }catch(e){ return r || ""; } };
  const billNow = () => { try{ return G.bill && !G.bill.done ? G.bill : null; }catch(e){ return null; } };

  /* ── hand-written dictionary, one entry per kind of thing that happens to you ── */
  const MISS = {caucus:9, crisis:8, hearing:6, lobby:5};
  const KIND = {
    caucus:{n:"Party meeting (caucus)", what:"Your party's members meet behind closed doors to agree one line before the floor vote. The chair calls each member in turn; the whip watches who speaks and how.",
      why:"This is where your party decides whether it trusts you. The whip's count, your standing inside the party, and how colleagues vote later all move here.",
      can:["Attend and speak when the chair calls you (hold the line, speak for the doubters, keep quiet, or argue your own vote)","Stay away (costs more if you did not send apologies)"]},
    hearing:{n:"Committee hearing", what:"A committee questions a witness (an official, an expert, sometimes a fellow member) in rounds. Members ask; the witness answers into the record.",
      why:"Hearings shape the bill before it reaches the floor. A good question moves the room and your standing; a witness who breaks can sink a bill.",
      can:["Press the witness hard (bigger standing gain, risk of looking cruel)","Give them room (smaller, safer gain)","Yield your time (standing falls)"]},
    presser:{n:"Press conference", what:"You and others take questions from the press gallery. What you say here becomes the story tomorrow.",
      why:"Moves your press standing and public approval; rivals use it to catch you out.",
      can:["Take the hard question","Stay on message","Go after the other side (risky)"]},
    crisis:{n:"Emergency debate", what:"The House is recalled to act on an emergency (floods, unrest, money that must move today). Longer than a party meeting and runs in rounds.",
      why:"States in trouble are watching. Moving fast wins standing; refusing to vote blind can be principled but is risky.",
      can:["Move the money now","Insist on reading it first (risky)","Stand aside for affected members"]},
    townhall:{n:"Constituency surgery (town hall)", what:"People from your district bring you their problems in person.",
      why:"This is your re-election. Approval at home and your margin move here.", can:["Listen and promise help","Explain the vote","Leave early"]},
    lobby:{n:"A quiet approach (lobby)", what:"Someone with money or influence wants a private word, usually about a vote.",
      why:"Deals made here buy support or war-chest money, but can surface later as scandal.", can:["Hear them out","Make or refuse a deal","Not turn up (they notice, and the cloakroom talks)"]},
    statefed:{n:"State–federal business", what:"A dispute between a state government and the federal level that needs a member's attention.", why:"Your state's governor and voters will remember which side you took.", can:["Back the state","Back the federal standard","Stay out of it"]},
    office:{n:"Office appointment", what:"Something booked into your own diary.", why:"Missing your own appointments costs standing with whoever booked them.", can:["Go","Reschedule"]},
    vote:{n:"Floor vote (roll call)", what:"The whole House votes aye or no on the bill on the paper. Every member's vote is recorded.",
      why:"The single most visible thing you do. Breaking the party line costs trust with the whip; broken pledges by colleagues are remembered.",
      can:["Vote aye","Vote no","Be absent (counts against you)"]},
    session:{n:"Sitting", what:"A formal sitting run by a chair: members speak in order and you are called once or twice.", why:"Silence is noticed: sitting through without speaking lowers your standing.", can:["Speak when called","Read the transcript to see who is with you"]}
  };
  const MAILK = {
    grievance:"A colleague is telling you, in writing, that something you did hurt them. Answering repairs or hardens it; ignoring it makes it worse.",
    ask:"Someone wants something from you (a post, a vote, a favour). Saying yes earns warmth and sometimes a debt; no costs some warmth.",
    note:"Information from the Clerk or a colleague. Usually no answer needed.",
    vote:"About how you or others voted. Read it for who is angry and who owes you.",
    decision:"A choice that needs your answer; each option has a lasting effect.",
    reply:"An answer to something you sent.", witness:"About a hearing witness or being called before a committee.",
    cable:"Official word from outside the House (government, the realms).", fan:"A member of the public writing to you. Good for morale; rarely needs action.",
    press:"The press want a comment. What you say may be printed.", ruling:"A ruling from the chair or a court that changes the rules you play by."
  };
  /* plain-language meaning of common notices and Wire lines */
  const PHR = [
    [/unopened|returned to sender|came back/i, "Returned unopened", "Your letter was refused or not read. It is not a postal fault: the person is freezing you out (low warmth or trust) or the matter is closed to them.", ["Speak to them in person, or go through an ally they trust","Repair first: keep a promise, do them a favour, apologise if it was personal","Then write again"], "Writing again at once usually changes nothing."],
    [/unanswered|never replied|leave it unanswered/i, "Left unanswered", "Someone reached out and got no reply. People read silence as an answer.", ["Answer it late (better than never)","Make it up in person"], "Their warmth toward you falls; the cloakroom may hear."],
    [/never spoke|said nothing/i, "You stayed silent in a sitting", "You were present but never took the floor when the chair called you.", ["Next time, answer when called; even a short line counts"], "Standing −5; everyone in the room thinks a little less of you."],
    [/time is up|let the moment go/i, "Your speaking time ran out", "The chair gave you the floor and the clock ran down before you spoke.", ["Pick an option or type your own words while the clock runs"], "Standing −4."],
    [/escort/i, "Escorted to an event", "You said you'd attend, so your staff walked you there.", ["Take part, or walk out (counts as missing it)"], ""],
    [/present for|you were there|you are in the room/i, "Attended in person", "You sat in the room in real time instead of reading a summary.", ["Speak when called; watch the transcript"], "Attending protects your standing."],
    [/has been called before the committee|sworn/i, "A witness is called", "Someone must answer the committee's questions under oath.", ["Question them when it's your turn","Defend them if they are a colleague (they remember)"], ""],
    [/rises|concludes|has begun/i, "Sitting opened/closed", "Procedural: the sitting started or ended.", [], ""],
    [/blasphem/i, "Blasphemy", "You said something the House treats as sacrilege. In this Republic that is a grave offence.", ["Apologise; confession at the chapel"], "Standing and faith standing fall sharply."],
    [/whip/i, "The whip", "The whip counts votes for your party and enforces the line.", ["Keep the line to stay in favour, or bargain for a free vote"], "Breaking the line costs the whip's trust."],
    [/approach .*unanswered|cloak/i, "Cloakroom talk", "Members are gossiping about something you did or didn't do.", ["Correct it in person if it matters"], "Reputation drifts."]
  ];
  function phrase(t){ t = String(t || ""); for(const p of PHR) if(p[0].test(t)) return p; return null; }

  /* ── notices log (events, notes, wire, mail) ── */
  function urg(k, t){ if(k === "crisis" || /emergenc|urgent|now\b|time is up/i.test(t || "")) return "high"; if(k === "caucus" || k === "hearing" || k === "vote" || k === "mail-ask" || k === "mail-decision" || k === "mail-grievance") return "med"; return "low"; }
  function addItem(o){
    try{
      o.id = (CL.nid = (CL.nid || 0) + 1); o.at = o.at || now(); o.read = !!o.read; o.handled = !!o.handled;
      o.urg = o.urg || urg(o.k, o.text);
      if(CL.items.some(x => x.text === o.text && x.k === o.k && x.at === o.at)) return null;
      CL.items.unshift(o); if(CL.items.length > onumLim(80,"hist")) CL.items.length = onumLim(80,"hist");
      paintBadge(); return o;
    }catch(e){ return null; }
  }
  CL.addItem = addItem;
  function wrap(name, get, set, fn){ try{ const o = get(); if(typeof o !== "function") return; set(fn(o)); }catch(e){ try{ console.warn("NEPTUNE-CLARITY hook " + name, e); }catch(e2){} } }

  /* events */
  wrap("eventCard", () => eventCard, f => { eventCard = f; }, orig => function(e){
    let it = null;
    try{ if(e){ it = CL.items.find(x => x.ev === e) || addItem({k:e.k || "event", kind:"event", title:e.t, text:e.t + (e.d ? " — " + e.d : ""), ev:e}); CL.ctx = {type:"event", e, item:it}; if(it) it.read = true; } }catch(err){}
    const r = orig.apply(this, arguments);
    try{ decorateCard(); }catch(err){}
    return r;
  });
  wrap("note", () => note, f => { note = f; }, orig => function(text, big){ try{ addItem({k:"note", kind:"note", title:big ? "Notice" : "Note", text:String(text)}); }catch(e){} return orig.apply(this, arguments); });
  wrap("pushWireScrap", () => pushWireScrap, f => { pushWireScrap = f; }, orig => function(tag, text){ try{ addItem({k:"wire", kind:"wire", title:"Wire · " + (tag || "Wire"), text:String(text || "")}); }catch(e){} return orig.apply(this, arguments); });
  wrap("pushMail", () => pushMail, f => { pushMail = f; }, orig => function(from, subject, body, opts){
    const r = orig.apply(this, arguments);
    try{ const m = G.mail[0]; if(m && !m.outgoing) addItem({k:"mail-" + m.kind, kind:"mail", title:"Mail · " + m.from, text:m.subject + " — " + String(m.body || "").slice(0, 200), mail:m}); }catch(e){}
    return r;
  });
  wrap("holdVote", () => holdVote, f => { holdVote = f; }, orig => function(){
    const b = G.bill, yv = G.you ? G.you.vote : null;
    const r = orig.apply(this, arguments);
    try{
      if(b){
        const t = tallyBill(b, false), pass = t.aye > t.no;
        const named = (G.members || []).filter(m => !m.gone && (m.post || (m.rel && Math.abs(m.rel.warmth) > 25))).slice(0, 3)
          .map(m => surname(m.name) + ": " + (memberVote(m, b) > 0 ? "aye" : "no")).join(", ");
        const you = G.you && G.you.vote != null ? (G.you.vote > 0 ? "aye" : "no") : "absent";
        addItem({k:"vote", kind:"vote", title:"Roll call · " + b.title, text:b.title + ": " + (pass ? "passed" : "failed") + " " + t.aye + "–" + t.no + ".", read:true, handled:true,
          outcome:"You: " + you + (named ? " — " + named : "")});
        CL.ctx = {type:"vote", b};
      }
    }catch(e){}
    try{ decorateCard(); }catch(e){}
    return r;
  });

  /* ── transcript: classify and gloss every line spoken in a sitting ── */
  const TAGS = {support:"#3c8d5a", oppose:"#b0473c", threat:"#8a2be2", deal:"#c08a1e", procedural:"#5b6b7c", position:"#777"};
  function classify(who, text){
    const t = String(text || "").toLowerCase();
    const chair = PROC.chair && who === surname(PROC.chair.name);
    if(/^(order|the chair|i call|the member for|you wanted in|second round|round \d|we will go round|again, and|that is the business|we are finished|enough\. get|that concludes|this committee is in session|right\. doors|the house will come|let us begin|we will take questions)/.test(t) || /time is up|yield the balance|recognises/.test(t) || (chair && /order|round|call|floor|finished|concludes/.test(t)))
      return ["procedural", /time is up/.test(t) ? "The chair has cut the speaker off; their time is spent." : /round/.test(t) ? "The chair is starting another round: everyone gets asked again, and they expect sharper answers than last time." : /call|floor|recognis|member for|wanted in/.test(t) ? "It is a member's turn to speak. If it names you, the clock is now yours." : /business|finished|concludes|get to the floor/.test(t) ? "The sitting is over. What was said is now on the record." : "Housekeeping by the chair: how the sitting will run, not anybody's position."];
    if(/remember|regret|answer for|outside|head on a plate|shame|watch |keeps a list|withdraw it|who wrote that for you/.test(t))
      return ["threat", "A warning: they are signalling a cost (to your reputation or a future vote) if you continue. Not a formal action yet."];
    if(/if i back|will you back|owe|trade|in exchange|favour|put me down|you have my vote|version of this everyone can live with|close to something workable/.test(t))
      return ["deal", "An opening for a deal: they would move if they got something back. Approach them after the sitting."];
    if(/hear, hear|voting with the party|go in together|quite right|on that point i agree|fair — continue|put my name|i am with you|with you on this|move the money today/.test(t))
      return ["support", "They are backing the line being argued (or the party line). Count them as a likely yes."];
    if(/not going to be able|cannot|nonsense|not what (it|the clause) says|will not|does the opposite|withdrawn|no costing|where is the costing|name the figure|unpopular thing|two different figures|which one is in the record|who paid|lose their jobs|not in the chamber/.test(t))
      return ["oppose", /figure|costing|record/.test(t) ? "A challenge on the facts: they doubt the numbers and want them on the record. That is opposition dressed as a question." : /lose their jobs|unpopular/.test(t) ? "A warning about the cost at home: they are wavering and need cover before they can vote yes." : "They are against the proposal as it stands, or against what was just said."];
    if(/\?$/.test(t)) return ["position", "A question. Watch the answer: it tells you more than the question does."];
    return ["position", "A statement of where they stand, not a move against anybody."];
  }
  function speakerOf(who){ try{ return (G.members || []).find(m => !m.gone && surname(m.name) === who && m.room === G.room) || null; }catch(e){ return null; } }
  function glossFor(who, text){
    const c = classify(who, text); let g = c[1];
    try{
      const m = speakerOf(who), b = billNow();
      if(m && b && c[0] !== "procedural"){ const v = memberVote(m, b); g += " Their likely vote on " + b.title + ": " + (v > 0 ? "aye" : v < 0 ? "no" : "undecided") + "."; }
      const key = String(text).trim().toLowerCase().slice(0, 60), prev = CL.said[key];
      if(prev) g += " Repeat — " + (prev.who === who ? "they" : prev.who) + " said this at " + prev.at + (prev.tag !== c[0] ? " (then it read as " + prev.tag + ")" : "") + ". Said again " + (c[0] === "procedural" ? "it is just the chair keeping order." : "it means the point has not been answered, and they are pressing it.");
      else CL.said[key] = {who, at:hhmm(), tag:c[0]};
    }catch(e){}
    return [c[0], g];
  }
  wrap("appendFloor", () => appendFloor, f => { appendFloor = f; }, orig => function(who, text){
    const r = orig.apply(this, arguments);
    try{
      const [tag, gloss] = who === "You" ? ["position", "Your own words, now on the record."] : glossFor(who, text);
      const L = {who:String(who), text:String(text), at:hhmm(), tag, gloss};
      if(CL.sess){ CL.sess.lines.push(L); if(CL.sess.lines.length > onumLim(120,"hist")) CL.sess.lines.shift(); }
      paintTx();
      /* give people time to be read: the bubble stays up longer at slower pace */
      const m = speakerOf(who); const f = PACE[CL.pace] || 1;
      if(m && m.sayT && f < 1) m.sayT = m.sayT / f;
    }catch(e){}
    return r;
  });
  wrap("procStart", () => procStart, f => { procStart = f; }, orig => function(e){
    const ok = orig.apply(this, arguments);
    try{ if(ok){ CL.said = {}; CL.sess = {title:procTitle(e), k:e.k, day:G.day, at:hhmm(), room:roomName(G.room), lines:[], outcome:""}; CL.ctx = {type:"session", e}; try{ if(PROC.chair && PROC.chair.say) CL.sess.lines.push({who:surname(PROC.chair.name) + " (chair)", text:PROC.chair.say, at:hhmm(), tag:"procedural", gloss:"The chair opens the sitting and sets the rules: who speaks, in what order, for how long. Not a position on the bill."}); }catch(x){} paintTx(true);
      const it = CL.items.find(x => x.ev === e); if(it){ it.read = true; } } }catch(err){}
    return ok;
  });
  wrap("procEnd", () => procEnd, f => { procEnd = f; }, orig => function(){
    const e = PROC.e, spoke = PROC.spoke;
    const r = orig.apply(this, arguments);
    try{
      const out = spoke ? "You spoke" : "You stayed silent (standing −5)";
      if(CL.sess){ CL.sess.outcome = out; CL.past.unshift(CL.sess); CL.past = CL.past.slice(0, 15); LS("sessions", CL.past); }
      let it = e && CL.items.find(x => x.ev === e);
      if(!it && e) it = addItem({k:e.k, kind:"event", title:e.t, text:e.t, ev:e});
      if(it){ it.read = true; it.handled = true; it.outcome = out; }
      CL.sess = null; CL.hold = false; paintTx();
    }catch(err){}
    return r;
  });
  wrap("procYouSay", () => procYouSay, f => { procYouSay = f; }, orig => function(opt, free){ try{ CL.hold = false; if(CL.sess) CL.sess.youSaid = opt ? opt.t : "own words"; }catch(e){} return orig.apply(this, arguments); });

  /* ── pacing + accurate speaking clock (wall time, readable) ── */
  wrap("procTick", () => procTick, f => { procTick = f; }, orig => function(dt){
    try{
      if(!PROC.on) return orig(dt);
      if(CL.paused) return;                                      /* explainer open: the sitting waits */
      if(PROC.phase === "you"){
        CL.lastRun = 0;
        const t = performance.now(), real = CL.lastReal ? Math.min(0.25, (t - CL.lastReal) / 1000) : dt; CL.lastReal = t;
        if(CL.hold || document.hidden) return orig(0);           /* wait for the player before the clock starts */
        return orig(real);
      }
      /* wall-clock based so a slow frame rate no longer drags the sitting (it ran ~5x slow at low fps) */
      const t2 = performance.now(), real2 = CL.lastRun ? Math.min(0.25, (t2 - CL.lastRun) / 1000) : dt; CL.lastRun = t2;
      const before = PROC.phase;
      const r = orig((document.hidden ? 0 : Math.max(dt, real2)) * (PACE[CL.pace] || 1));
      if(PROC.phase !== "you") CL.lastReal = 0;
      if(PROC.phase === "you" && before !== "you"){ CL.hold = true; CL.lastReal = performance.now(); try{ procSetBar(procTitle(PROC.e), "You have the floor. The clock starts when you are ready.", PROC.opts, PROC.clock); }catch(e){} }
      return r;
    }catch(e){ return orig(dt); }
  });
  wrap("procSetBar", () => procSetBar, f => { procSetBar = f; }, orig => function(title, sub, opts, secs){
    const r = orig.apply(this, arguments);
    try{
      const bar = el("procBar"); if(!bar) return r;
      const h = bar.querySelector(".proc__h");
      const box = document.createElement("span"); box.className = "cl-procx";
      box.innerHTML = '<button type="button" class="cl-btn" data-clwhat="1">What\'s this?</button>' +
        (PROC.phase === "you" && CL.hold ? ' <button type="button" class="cl-btn cl-go" data-clready="1">Take the floor ▸ (start clock)</button>' : '');
      (h || bar).appendChild(box);
      box.querySelector("[data-clwhat]").addEventListener("click", () => openExplain());
      const go = box.querySelector("[data-clready]"); if(go) go.addEventListener("click", () => { CL.hold = false; CL.lastReal = performance.now(); go.remove(); });
    }catch(e){}
    return r;
  });

  /* ── UI ── */
  const css = document.createElement("style");
  css.textContent = `
  .cl-btn{font:600 12px/1 system-ui,sans-serif;background:#f4efe2;color:#222;border:1px solid #8a7f66;border-radius:12px;padding:5px 10px;cursor:pointer;margin-left:6px}
  .cl-go{background:#2f5d3a;color:#fff;border-color:#2f5d3a}
  #clDock{position:fixed;left:12px;top:112px;z-index:9000;display:flex;gap:6px;flex-wrap:wrap;max-width:min(320px,46vw)}
  #clDock .n{background:#b0473c;color:#fff;border-radius:9px;padding:1px 6px;margin-left:4px;font-size:11px}
  #clPanel{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:min(680px,94vw);max-height:84vh;overflow:auto;z-index:100000;background:#fbf8f0;color:#1d1d1d;border:1px solid #8a7f66;border-radius:10px;box-shadow:0 12px 40px rgba(0,0,0,.45);padding:16px 18px;font:14px/1.45 Georgia,serif}
  #clPanel h2{margin:0 0 4px;font-size:20px} #clPanel h3{margin:12px 0 4px;font:700 12px system-ui;text-transform:uppercase;letter-spacing:.06em;color:#6a5f46}
  #clPanel ul{margin:2px 0 6px 18px;padding:0} #clPanel .x{position:absolute;right:12px;top:10px}
  #clPanel .tabs button{margin:0 4px 8px 0}
  .cl-it{border-top:1px solid #e3dccb;padding:6px 0;cursor:pointer} .cl-it:hover{background:#f1ead8}
  .cl-b{display:inline-block;font:600 11px system-ui;border-radius:8px;padding:1px 6px;margin-right:4px;color:#fff}
  .cl-high{background:#b0473c}.cl-med{background:#c08a1e}.cl-low{background:#8a8a8a}.cl-ok{background:#3c8d5a}.cl-new{background:#2a5d9f}
  #clTx{position:fixed;left:12px;bottom:12px;width:min(320px,40vw);max-height:30vh;overflow:auto;z-index:8000;pointer-events:auto;background:#fbf8f0;backdrop-filter:none;color:#1d1d1d;border:1px solid #8a7f66;border-radius:8px;font:13px/1.35 Georgia,serif;padding:8px 10px;box-shadow:0 6px 18px rgba(0,0,0,.35)}
  #clTx .hd{display:flex;justify-content:space-between;align-items:center;font:700 12px system-ui;text-transform:uppercase;letter-spacing:.05em;color:#6a5f46;position:sticky;top:-8px;background:#fbf8f0;padding:4px 0}
  .cl-ln{border-top:1px solid #e3dccb;padding:5px 0} .cl-ln u{text-decoration:none;color:#595959;font:11px monospace;margin-right:4px}
  .cl-ln i{display:block;color:#4a4a4a;font-size:12px;margin-top:2px} .cl-tag{font:600 10px system-ui;color:#fff;border-radius:6px;padding:0 5px;margin-left:4px;text-transform:uppercase}
  .cl-sum{border:1px solid #e3dccb;border-radius:6px;padding:6px 8px;margin:6px 0;background:#fffdf7;color:#1d1d1d}
  #tipCard{z-index:100001}
  .cl-ib{display:flex;gap:10px;align-items:flex-start}.cl-ibl{flex:1 1 55%;max-height:62vh;overflow:auto}.cl-ibp{flex:1 1 45%;position:sticky;top:0;max-height:62vh;overflow:auto;border-left:1px solid #b3b3b3;padding-left:8px}
  .cl-sech{cursor:pointer;font:700 12px system-ui;text-transform:uppercase;letter-spacing:.04em;margin:8px 0 4px}.cl-sel{outline:1px solid #8a8a8a}
  .cl-nl{cursor:help}.cl-nl:hover{text-decoration:underline dotted;text-decoration-color:#8a8a8a;text-underline-offset:2px}
  .cl-card{font:600 12px system-ui;margin:0 0 8px;display:flex;gap:4px;flex-wrap:wrap;align-items:center}`;
  document.head.appendChild(css);

  const dock = document.createElement("div"); dock.id = "clDock";
  dock.innerHTML = '<button type="button" class="cl-btn" id="clWhatBtn" title="Explain what is on screen now">? What\'s this</button><button type="button" class="cl-btn" id="clLogBtn" title="Notices and past sessions">Notices \x26amp; Session Log<span class="n" id="clN" hidden></span></button>';
  document.body.appendChild(dock);
  el("clWhatBtn").addEventListener("click", () => openExplain());
  el("clLogBtn").addEventListener("click", () => openLog("notices"));

  function paintBadge(){ try{ const n = CL.items.filter(x => !x.read).length; const b = el("clN"); if(b){ b.hidden = !n; b.textContent = n; } }catch(e){} }
  function badges(it){
    let h = '<span class="cl-b cl-' + it.urg + '">' + (it.urg === "high" ? "URGENT" : it.urg === "med" ? "ACTION" : "INFO") + '</span>';
    if(it.mail){ it.read = it.read || it.mail.read; if(it.mail.answered) it.handled = true; }
    h += it.handled ? '<span class="cl-b cl-ok">Handled ✓' + (it.outcome ? " — " + esc(it.outcome) : "") + '</span>' : it.read ? '<span class="cl-b cl-ok">Read ✓</span>' : '<span class="cl-b cl-new">New</span>';
    return h;
  }
  function panel(html){
    let p = el("clPanel");
    if(!p){ p = document.createElement("div"); p.id = "clPanel"; document.body.appendChild(p); }
    p.innerHTML = '<button type="button" class="cl-btn x" id="clClose">Close ✕</button>' + html;
    p.hidden = false;
    el("clClose").addEventListener("click", closePanel);
    CL.paused = false;   /* 20261013o: reading a note never stops the sitting or the talk */
    return p;
  }
  function closePanel(){ const p = el("clPanel"); if(p) p.hidden = true; CL.paused = false; CL.lastReal = 0; CL.lastRun = 0; }
  CL.close = closePanel;

  function list(a){ return a && a.length ? "<ul>" + a.map(x => "<li>" + x + "</li>").join("") + "</ul>" : "<p>—</p>"; }
  function fx(o){ const b = []; if(o.stand) b.push("standing " + (o.stand > 0 ? "+" : "") + o.stand); if(o.sway) b.push("moves the room " + (o.sway > 0 ? "+" : "") + o.sway); if(o.press) b.push("press " + (o.press > 0 ? "+" : "") + o.press); if(o.risk) b.push("risky"); if(o.loyal) b.push("whip notices loyalty"); if(o.doubt) b.push("doubters remember you"); return b.join(", ") || "little effect"; }
  function fnFx(fn){ try{ const s = String(fn); const m = s.match(/ripple\(\s*\w+\s*,\s*(-?\d+)/); const t = s.match(/trust\s*\+\s*(-?\d+)|trust-(\d+)/); const b = []; if(m) b.push("their warmth toward you " + (+m[1] > 0 ? "+" : "") + m[1]); if(t) b.push("trust " + (t[1] ? "+" + t[1] : "−" + t[2])); return b.join(", ") || "changes how they see you"; }catch(e){ return ""; } }
  function explainEvent(e, it){
    const K = KIND[e.k] || {n:e.t, what:"A scheduled event in the House.", why:"Turning up, and how you act there, moves your standing.", can:["Attend","Skip"]};
    const cost = (MISS[e.k] || 4) * (e.rsvp === false ? 0.35 : 1);
    const opts = (() => { try{ return procOptions(e); }catch(x){ return []; } })();
    return { title:(e.t || K.n), kind:K.n, what:K.what + (e.d ? "<br><br><em>Today:</em> " + esc(e.d) : ""), why:K.why, can:K.can,
      conseq:opts.map(o => "<b>" + esc(o.t) + "</b>: " + fx(o)).concat(["<b>Stay silent when called</b>: standing −5, everyone present cools on you", "<b>Let your clock run out</b>: standing −4", "<b>Miss it</b>: standing about −" + Math.round(cost) + (e.rsvp === false ? " (reduced: you sent apologies)" : "") + ", influence falls"]),
      when:(e.hour != null ? (typeof hourLabel === "function" ? hourLabel(e.hour) : e.hour + ":00") : "") + (e.day != null ? ", day " + e.day : "") + " · " + esc(roomName(e.room)), it };
  }
  function explainText(it){
    const p = phrase(it.text) || phrase(it.title);
    const mk = it.mail ? (MAILK[it.mail.kind] || MAILK.note) : null;
    const o = { title:esc(it.title), kind:p ? p[1] : it.kind === "mail" ? "Mail" : it.kind === "wire" ? "Wire item" : it.kind === "vote" ? "Roll call result" : "Notice",
      what:"<em>“" + esc(it.text) + "”</em><br><br>" + (p ? p[2] : mk || (it.kind === "wire" ? "News running on the Wire: something that happened in the building. Information unless it names you." : "A line in your record of the day.")),
      why:p ? (p[4] || "It tells you how people are reading you.") : it.kind === "vote" ? "Who voted how decides who you thank, who you chase, and who broke a promise." : "Knowing it lets you act before others do.",
      can:p ? p[3] : it.mail && it.mail.options ? it.mail.options.map(x => esc(x.t)) : ["Nothing required; read and move on"],
      conseq:it.mail && it.mail.options ? it.mail.options.map(x => "<b>" + esc(x.t) + "</b>: " + fnFx(x.run)) : [], when:esc(it.at), it };
    if(it.ev && !it.handled) return explainEvent(it.ev, it);
    return o;
  }
  /* a sitting: the question, who asks for what, and what the words mean */
  /* what each step of a sitting is for, and what your choices there do */
  const PROC_STEP = {
    gavel:"The chair opens the sitting and the clerk reads the record. Nothing is decided yet; this is where the room settles.",
    open:"Each side makes its opening case. Listen first: what each person asks for is what they will vote or act on.",
    question:"Members put questions to the speaker. A fair question makes the answer count; a hard one can move the room either way.",
    motion:"A member moves to change the order of business or to object. Rulings here decide how the rest of the sitting runs.",
    deliberate:"Members talk among themselves and count votes. Money and promises spent now change who is with you.",
    vote:"The question is put and the result is recorded by name. Your vote here is remembered.",
    ruling:"The chair or the court decides. A narrow ruling keeps you safe; a broad one takes a side and owns it.",
    adjourn:"The sitting closes. What was agreed is entered in the record and the people named will remember it."
  };
  function sittingExplain(){
    const S = SIT.on, X = S.x, stepKey = S.D.steps[S.i], step = (typeof SIT_STEP_T !== "undefined" && SIT_STEP_T[stepKey]) || "";
    const cast = (X.cast || []).filter(p => !p.gone);
    const who = cast.map(p => "<b>" + esc(p.name) + "</b> (" + esc(p.role) + ") wants " + esc(p.want) + ". " +
      (p.stance >= 55 ? "Leaning with you." : p.stance <= 45 ? "Leaning against you." : "Still undecided.")).join("<br>");
    const terms = glossTerms(X.M.q + " " + cast.map(p => p.want).join(" "));
    return {title:esc(S.D.title) + " · " + esc(step), kind:"Sitting · " + esc(step),
      what:"<b>What happens at this step:</b> " + esc(PROC_STEP[stepKey] || "The sitting moves on.") + "<br><br><b>The question:</b> " + esc(X.M.q) + ". Every request is a claim on the same budget: a yes spends money the others also want.<br><br><b>Who is asking for what:</b><br>" + (who || "Nobody has spoken yet.") +
        (terms ? "<br><br><b>What the words mean:</b><br>" + terms : ""),
      why:"Whatever you agree to here is paid out of the money the question names, and the people named will remember your answer.",
      can:cardButtons(), conseq:[], when:now()};
  }
  /* the glossary terms that appear in some text */
  function glossTerms(text){
    const t = String(text || "").toLowerCase(), out = [], seen = {};
    Object.keys(ONUM_GLOSS).sort((a, b) => b.length - a.length).forEach(k => {
      if(seen[k] || !new RegExp("\\b" + k.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "s?\\b").test(t)) return;
      seen[k] = 1; out.push("<b>" + esc(k) + "</b>: " + esc(ONUM_GLOSS[k]));
    });
    return out.join("<br>");
  }
  function cardButtons(){ const c = el("card"); return c ? [...c.querySelectorAll("button")].map(b => b.textContent.trim()).filter(x => x && x.length < 60 && !/^(What's this\??|Close|Walk out|Save)/i.test(x)).slice(0, 8).map(esc) : []; }
  /* what the bill means for you, from the same readings the Floor panel shows */
  function billWhy(bl){
    try{
      const d = districtFit(bl), a = alignment(G.you, bl);
      return "Your district reads it as " + (d > 20 ? "a win" : d < -20 ? "a problem" : "noise") + "; you read it as " + (a > 20 ? "right" : a < -20 ? "wrong" : "borderline") + ". The groups named above and the members who count the cost will remember how you vote.";
    }catch(e){ return "Every choice here is remembered by the people named in it."; }
  }
  function explainCard(){
    try{ if(SIT.on && SIT.on.x && SIT.on.x.M) return sittingExplain(); }catch(e){}
    const c = el("card"); const eb = c && c.querySelector(".eyebrow"), h = c && c.querySelector("h1");
    const t = ((eb && eb.textContent) || "") + " " + ((h && h.textContent) || "");
    const btns = c ? [...c.querySelectorAll("button")].map(b => b.textContent.trim()).filter(x => x && x.length < 60).slice(0, 8) : [];
    const b = billNow();
    if(/vote|ballot|roll/i.test(t)) return Object.assign({title:esc(t.trim())}, {kind:KIND.vote.n, what:KIND.vote.what + (b ? "<br><br>On the paper: <b>" + esc(b.title) + "</b>." : ""), why:KIND.vote.why, can:btns.length ? btns : KIND.vote.can, conseq:[], when:"Now · the floor"});
    const p = phrase(t);
    const bill = b && t.indexOf(b.title) >= 0 ? b : null;
    const plain = bill ? (function(){ try{ return dkPlain({kind:"bill", title:bill.title, pos:bill.pos, sb:bill.sb, line:bill.line, sponsor:bill.sponsor}); }catch(e){ return ""; } })() : "";
    return {title:esc(t.trim() || "This screen"), kind:p ? p[1] : bill ? "Bill on the desk" : "Decision card",
      what:bill ? "<b>" + esc(bill.title) + ".</b> " + esc(plain) + (glossTerms(t) ? "<br><br>" + glossTerms(t) : "") : p ? p[2] : "A moment that needs your decision. The text above the buttons is the situation; each button is a different answer.",
      why:bill ? billWhy(bill) : "Every choice here is remembered by the people named in it.", can:btns.length ? btns.map(esc) : ["Read and continue"], conseq:p && p[4] ? [p[4]] : [], when:now()};
  }
  function render(x){
    return '<h2>What\'s this? — ' + x.title + '</h2>' + (x.it ? '<div class="cl-card">' + badges(x.it) + '</div>' : '') +
      '<div style="color:#6a5f46;font:600 12px system-ui">' + esc(x.kind) + '</div>' +
      '<h3>What it is</h3><p>' + x.what + '</p><h3>Why it matters to you</h3><p>' + x.why + '</p>' +
      '<h3>What you can do</h3>' + list(x.can) + (x.conseq && x.conseq.length ? '<h3>What each choice does</h3>' + list(x.conseq) : '') +
      '<h3>When / where</h3><p>' + (x.when || "—") + '</p>';
  }
  function openExplain(it){
    let x;
    try{
      if(it) x = it.ev && !it.handled ? explainEvent(it.ev, it) : explainText(it);
      else if(PROC.on && PROC.e) x = explainEvent(PROC.e, CL.items.find(y => y.ev === PROC.e));
      else if(veil && !veil.hidden && veil.classList && card && card.textContent.trim() && getComputedStyle(veil).display !== "none" && getComputedStyle(veil).opacity !== "0"){
        x = CL.ctx && CL.ctx.type === "event" && CL.ctx.e ? explainEvent(CL.ctx.e, CL.ctx.item) : explainCard();
      } else if(CL.items[0]) x = explainText(CL.items[0]);
      else x = {title:"The House", kind:"", what:"Nothing needs you right now. Notices, mail and sittings will appear in Notices \x26amp; Session Log.", why:"", can:[], conseq:[], when:now()};
      if(x.it) x.it.read = true; paintBadge();
      panel(linkify(render(x)) + '<p><button type="button" class="cl-btn" id="clToLog">All notices \x26amp; Session Log</button></p>');
      el("clToLog").addEventListener("click", () => openLog("notices"));
    }catch(e){ try{ console.warn("NEPTUNE-CLARITY explain", e); }catch(e2){} }
  }
  CL.explain = openExplain;
  function openLog(tab){
    try{
      let body = "";
      if(tab === "sessions"){
        const all = (CL.sess ? [CL.sess] : []).concat(CL.past);
        body = all.length ? all.map((s, i) => '<details' + (i ? '' : ' open') + '><summary><b>' + esc(s.title) + '</b> — ' + esc(s.room) + ', d' + s.day + ' ' + esc(s.at) + (s.outcome ? ' · <span class="cl-b cl-ok">' + esc(s.outcome) + '</span>' : ' · <span class="cl-b cl-high">live</span>') + '</summary>' + s.lines.map(lineHTML).join("") + '</details>').join("") : "<p>No sittings yet. Attend a party meeting, hearing or debate and its full transcript will be kept here.</p>";
      } else {
        body = CL.items.length ? CL.items.map(it => '<div class="cl-it" data-clit="' + it.id + '">' + badges(it) + '<b>' + esc(it.title) + '</b> <u style="text-decoration:none;color:#595959;font:11px monospace">' + esc(it.at) + '</u><br>' + linkify(esc(String(it.text).slice(0, 160))) + '</div>').join("") : "<p>Nothing yet.</p>";
      }
      const p = panel('<h2>' + (tab === "sessions" ? "Session Log" : "Notices") + '</h2><div class="tabs"><button type="button" class="cl-btn" data-cltab="notices">Notices</button><button type="button" class="cl-btn" data-cltab="sessions">Session Log</button></div>' + body);
      p.querySelectorAll("[data-cltab]").forEach(b => b.addEventListener("click", () => openLog(b.getAttribute("data-cltab"))));
      p.querySelectorAll("[data-clit]").forEach(d => d.addEventListener("click", () => openExplain(CL.items.find(x => x.id === +d.getAttribute("data-clit")))));
    }catch(e){ try{ console.warn("NEPTUNE-CLARITY log", e); }catch(e2){} }
  }
  CL.log = openLog;
  function lineHTML(L){ return '<div class="cl-ln"><u>' + esc(L.at) + '</u><b>' + whoLink(L.who) + '</b><span class="cl-tag" style="background:' + (TAGS[L.tag] || "#777") + '">' + esc(L.tag) + '</span><br>' + linkify(esc(L.text)) + '<i>What they meant: ' + esc(L.gloss) + '</i></div>'; }
  function paintTx(force){
    try{
      let box = el("clTx");
      if(!PROC.on || !CL.sess){ if(box) box.hidden = true; return; }
      if(!box){ box = document.createElement("div"); box.id = "clTx"; document.body.appendChild(box); }
      if(CL.txMin){ box.innerHTML = '<div class="hd"><span>Transcript</span><button type="button" class="cl-btn" id="clTxMin">Show ▾</button></div>'; }
      else box.innerHTML = '<div class="hd"><span>Transcript · ' + esc(CL.sess.title) + ' · pace ' + CL.pace + '</span><button type="button" class="cl-btn" id="clTxMin">Hide ▴</button></div>' + CL.sess.lines.map(lineHTML).join("");
      box.hidden = false; box.scrollTop = box.scrollHeight;
      el("clTxMin").addEventListener("click", () => { CL.txMin = !CL.txMin; paintTx(); });
    }catch(e){}
  }
  CL.paintTx = paintTx;

  /* badge line + What's this on every card (events, mail, votes, prompts) */
  function decorateCard(){
    const c = el("card"); if(!c || c.querySelector(".cl-card")) return;
    if(!c.textContent.trim()) return;
    const d = document.createElement("div"); d.className = "cl-card";
    const it = CL.ctx && CL.ctx.item;
    d.innerHTML = (it ? badges(it) : "") + (CL.ctx && CL.ctx.e && CL.ctx.e.room ? '<span class="cl-b cl-low">' + esc(roomName(CL.ctx.e.room)) + '</span>' : "") + '<button type="button" class="cl-btn" data-clwhat="1">What\'s this?</button>';
    c.insertBefore(d, c.firstChild);
    d.querySelector("[data-clwhat]").addEventListener("click", ev => { ev.stopPropagation(); openExplain(); });
  }
  try{
    const c = el("card");
    if(c) new MutationObserver(() => { try{ if(!c.querySelector(".cl-card")) decorateCard(); }catch(e){} }).observe(c, {childList:true});
    if(c) c.addEventListener("click", ev => { try{ const b = ev.target.closest("button"); if(b && !b.closest(".cl-card") && CL.ctx && CL.ctx.item && CL.ctx.type === "event"){ CL.ctx.item.handled = true; CL.ctx.item.outcome = b.textContent.trim().slice(0, 40); CL.ctx = null; } }catch(e){} }, true);
  }catch(e){}

  /* settings: Session pace + Session Log (pause menu and the in-game settings card) */
  function paceRow(cls){
    return '<div class="' + (cls || "settings-row") + '" data-clpace-row="1"><div><div class="settings-label">Session pace</div><div class="settings-desc">Committees, party meetings and debates. Slow gives time to read every line.</div></div><div class="settings-value">' +
      ["slow", "normal", "fast"].map(k => '<button type="button" class="settings-btn ' + (CL.pace === k ? "settings-btn-primary" : "settings-btn-secondary") + '" data-clpace="' + k + '">' + k[0].toUpperCase() + k.slice(1) + '</button>').join("") +
      ' <button type="button" class="settings-btn settings-btn-secondary" data-cllog="1">Session Log</button></div></div>';
  }
  function bindPace(root){
    root.querySelectorAll("[data-clpace]").forEach(b => b.addEventListener("click", () => { CL.pace = b.getAttribute("data-clpace"); LS("pace", CL.pace);
      root.querySelectorAll("[data-clpace]").forEach(x => { x.className = "settings-btn " + (x.getAttribute("data-clpace") === CL.pace ? "settings-btn-primary" : "settings-btn-secondary"); }); paintTx(); }));
    root.querySelectorAll("[data-cllog]").forEach(b => b.addEventListener("click", () => openLog("sessions")));
  }
  function paceIntoPause(){
    try{
      const sec = document.querySelector('#pauseOverlay [data-section="game"]');
      if(sec && !sec.querySelector("[data-clpace-row]")){
        const w = document.createElement("div"); w.innerHTML = paceRow();
        const row = w.firstChild; const first = sec.querySelector(".settings-row");
        if(first) sec.insertBefore(row, first); else sec.appendChild(row); bindPace(row);
      }
    }catch(e){}
  }
  paceIntoPause();
  wrap("setupSettingsUI", () => setupSettingsUI, f => { setupSettingsUI = f; }, orig => function(){ const r = orig.apply(this, arguments); paceIntoPause(); return r; });
  CL.debug = () => ({on:PROC.on, phase:PROC.phase, t:PROC.t, i:PROC.i, n:PROC.order.length, running:G.running, speed:G.speed, log:PROC.log.length, paused:CL.paused, hold:CL.hold});
  wrap("settingsCard", () => settingsCard, f => { settingsCard = f; }, orig => function(){
    const r = orig.apply(this, arguments);
