/* ══ 20261016n · the House Floor: a gallery, a voting board, the Bar of the House, the mace and a proper ceiling ══ */
function rgBoardTex(){
  return rgCanvasTex(512, 256, (g, w, h) => {
    g.fillStyle = "#0d1410"; g.fillRect(0, 0, w, h); g.strokeStyle = "#c9a24a"; g.lineWidth = 4; g.strokeRect(6, 6, w - 12, h - 12);
    g.fillStyle = "#e6cf93"; g.textAlign = "center"; g.font = "bold 24px Georgia, serif"; g.fillText("THE HOUSE OF THE REPUBLIC · ROLL CALL", w / 2, 34);
    let seed = 9; const r = () => (seed = (seed * 16807) % 2147483647) / 2147483647; let k = 0;
    for(let row = 0; row < 9; row++) for(let col = 0; col < 20; col++){ const v = r(); g.fillStyle = v < 0.44 ? "#3fcf6a" : v < 0.86 ? "#e0483a" : "#4a5148"; g.beginPath(); g.arc(26 + col * 23.2, 66 + row * 18.4, 6, 0, 6.3); g.fill(); k++; }
    g.font = "bold 22px 'Courier New', monospace"; g.textAlign = "left"; g.fillStyle = "#3fcf6a"; g.fillText("AYE", 28, 246); g.fillStyle = "#e0483a"; g.fillText("NO", 190, 246); g.fillStyle = "#9a9f98"; g.fillText("NOT VOTING", 320, 246);
  });
}
function floorRich(w, d, h, hw){
  try{
    if(roomGroup.userData.rgFloor) return; roomGroup.userData.rgFloor = 1;
    const brass = matCol(0xb08b45, .35, .8), oak = matCol(0x5a3b24, .6), dkoak = matCol(0x3a2414, .65), cream = matCol(0xf3ecd9, .7), black = matCol(0x15171b, .5), marble = matCol(0xd9d4c6, .5);
    const glowM = new THREE.MeshStandardMaterial({color:0xfff2d4, emissive:0xffd9a0, emissiveIntensity:0.85, roughness:0.4});
    /* the voting board and the order of business on the side walls */
    [-1, 1].forEach(s => { const bd = new THREE.Mesh(UNIT.plane, new THREE.MeshStandardMaterial({map:rgBoardTex(), roughness:0.6, emissive:0xffffff, emissiveMap:rgBoardTex(), emissiveIntensity:0.25})); bd.position.set(s * (hw - 0.09), 3.7, d * 0.52); bd.scale.set(6.0, 2.6, 1); bd.rotation.y = -s * Math.PI / 2; roomGroup.add(bd);
      addBox(dkoak, s * (hw - 0.06), 3.7, d * 0.52, 0.06, 2.8, 6.2, 0, true); addBox(brass, s * (hw - 0.1), 2.3, d * 0.52, 0.05, 0.05, 6.3, 0, true); addBox(brass, s * (hw - 0.1), 5.1, d * 0.52, 0.05, 0.05, 6.3, 0, true); });
    /* a gallery along each side: a ledge, a balustrade, brackets and a dark underside */
    [-1, 1].forEach(s => { const x = s * (hw - 0.75);
      addBox(dkoak, x, 3.0, d / 2, 1.5, 0.18, 11.0); addBox(oak, x - s * 0.74, 3.12, d / 2, 0.08, 0.06, 11.0, 0, true);
      for(let i = 0; i <= 22; i++){ const z = d / 2 - 5.5 + i * 0.5; addCyl(oak, x - s * 0.7, 3.55, z, 0.025, 0.85); }
      addBox(oak, x - s * 0.7, 4.0, d / 2, 0.09, 0.07, 11.0, 0, true); addBox(brass, x - s * 0.7, 4.05, d / 2, 0.05, 0.02, 11.0, 0, true);
      for(let i = 0; i < 6; i++){ const z = d / 2 - 5.0 + i * 2.0; addBox(dkoak, x - s * 0.55, 2.7, z, 0.5, 0.5, 0.14, 0, true).rotation.z = 0; addCyl(oak, x - s * 0.7, 1.5, z, 0.12, 3.0); }
      for(let i = 0; i < 5; i++){ const z = d / 2 - 4.2 + i * 2.1; addBox(oak, x + s * 0.1, 3.35, z, 0.7, 0.45, 1.2, 0, true); } });
    /* the Bar of the House across the aisle, with a gate; the mace beside the rostrum; a clock over the Speaker; a medallion in the carpet */
    [-1, 1].forEach(s => { addBox(oak, s * 1.6, 0.5, 3.2, 1.6, 0.05, 0.08, 0, true); addBox(brass, s * 1.6, 0.54, 3.2, 1.6, 0.02, 0.1, 0, true); for(let i = 0; i < 4; i++) addCyl(brass, s * (0.9 + i * 0.5), 0.25, 3.2, 0.018, 0.5); });
    [-1, 1].forEach(s => { addCyl(brass, s * 1.15, 0.55, 3.2, 0.045, 1.1); addSphere(brass, s * 1.15, 1.13, 3.2, 0.06); });
    addCyl(dkoak, -1.9, 0.55, d - 5.2, 0.14, 1.1); addCyl(brass, -1.9, 1.5, d - 5.2, 0.03, 0.9); addSphere(brass, -1.9, 2.05, d - 5.2, 0.14); addBox(brass, -1.9, 2.22, d - 5.2, 0.04, 0.12, 0.04, 0, true);
    rgR(addCyl(cream, 0, 5.1, d - 0.12, 0.4, 0.05), "x", Math.PI / 2); rgR(addCyl(brass, 0, 5.1, d - 0.14, 0.44, 0.04), "x", Math.PI / 2); addBox(black, 0, 5.1, d - 0.16, 0.012, 0.34, 0.012, 0, true); addBox(black, 0.09, 5.12, d - 0.16, 0.24, 0.012, 0.012, 0.5, true);
    const dc = rgFlat(rgDiscTex(), 0, 0.004, 8.0, 5.0, 5.0); dc.material.opacity = 0.95;
    /* pilasters between the windows, a gilt frieze under the ceiling and big pendant chandeliers */
    [-1, 1].forEach(s => { for(let i = 0; i < 5; i++){ const z = 1.8 + i * 3.1; addBox(marble, s * (hw - 0.12), 2.0, z, 0.26, 4.0, 0.46); addBox(brass, s * (hw - 0.12), 4.05, z, 0.34, 0.1, 0.56, 0, true); addBox(marble, s * (hw - 0.12), 0.12, z, 0.34, 0.24, 0.56, 0, true); } addBox(brass, s * (hw - 0.04), h - 0.5, d / 2, 0.04, 0.22, d - 0.6, 0, true); });
    [3.2, 8.0, 12.8].forEach(z => { addCyl(brass, 0, h - 0.9, z, 0.02, 1.8); addCyl(brass, 0, h - 1.85, z, 0.7, 0.06); for(let i = 0; i < 8; i++){ const a = i * Math.PI / 4; addCyl(brass, Math.cos(a) * 0.7, h - 1.95, z + Math.sin(a) * 0.7, 0.014, 0.24); addSphere(glowM, Math.cos(a) * 0.7, h - 2.15, z + Math.sin(a) * 0.7, 0.09, 0.12, 0.09); } addSphere(glowM, 0, h - 2.0, z, 0.2, 0.24, 0.2); });
  }catch(e){ try{ console.warn("floor rich", e); }catch(x){} }
}
/* ══ 20261016r · AMBIENT SOUND: the building has a sound. Room tone, the murmur of whoever is in the room, your own footsteps on marble, wood, carpet and stone, wind and traffic outside, rain, birds by day, the clock, the hour. Synthesised, no files; off in Settings. ══ */
const AMB = {on:true, ctx:null, vol:0.55, L:{}, room:null, stepD:0, lastX:0, lastZ:0, hour:-1, birdT:0, tickT:0, nb:null};
try{ const v = localStorage.getItem("onum.amb"); if(v === "0") AMB.on = false; }catch(e){}
function ambNoise(ctx){ if(AMB.nb) return AMB.nb; const n = ctx.sampleRate * 2, b = ctx.createBuffer(1, n, ctx.sampleRate), d = b.getChannelData(0); let l = 0; for(let i = 0; i < n; i++){ const w = Math.random() * 2 - 1; l = (l + 0.02 * w) / 1.02; d[i] = l * 3.5 + w * 0.15; } return AMB.nb = b; }
function ambInit(){
  if(AMB.ctx || !AMB.on) return AMB.ctx; try{ const C = window.AudioContext || window.webkitAudioContext; if(!C) return null; const ctx = new C(); AMB.ctx = ctx;
    const master = ctx.createGain(); master.gain.value = 0; master.connect(ctx.destination); AMB.master = master;
