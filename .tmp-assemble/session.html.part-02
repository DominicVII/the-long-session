  const LOCAL = ["the county wants to close the branch library two days a week", "potholes on the state road nobody will claim", "the volunteer fire company needs a new pumper", "the grain co-op wants a tax break to expand", "the high school lost its bus route", "a developer wants to rezone the old orchard"];
  LP.agenda = function(kind, n){
