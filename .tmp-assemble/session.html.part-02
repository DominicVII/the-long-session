  const down = i => !!(b[i] && b[i].pressed);
  const edge = i => { const d = down(i), was = !!PADHELD[i]; PADHELD[i] = d; return d && !was; };
  /* LT=6 RT=7 (standard mapping). Analog .value and common trigger axes (>0.5) also count. */
  const trigVal = (i) => {
    const btn = b[i];
    let v = btn ? Math.max(btn.pressed ? 1 : 0, btn.value || 0) : 0;
    if(i === 6){ if(ax[4] > 0) v = Math.max(v, ax[4]); if(ax[6] > 0) v = Math.max(v, ax[6]); }
    if(i === 7){ if(ax[5] > 0) v = Math.max(v, ax[5]); if(ax[7] > 0) v = Math.max(v, ax[7]); }
