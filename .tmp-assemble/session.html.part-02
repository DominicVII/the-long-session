/* the gate wings are cut stone, not a white slab: ashlar courses, blind arches, a banner, ivy at the foot */
function gateAshlarTex(){
  if(gateAshlarTex.t) return gateAshlarTex.t;
  return gateAshlarTex.t = rgCanvasTex(256, 256, (g, w, h) => {
    g.fillStyle = "#cfc4aa"; g.fillRect(0, 0, w, h);
    const rows = 8, rh = h / rows;
    for(let r = 0; r < rows; r++){ const off = (r % 2) * 32, bw = 64; for(let c = -1; c < 5; c++){ const x = c * bw + off, y = r * rh, sh = 0.86 + Math.random() * 0.16; g.fillStyle = "rgb(" + Math.round(207 * sh) + "," + Math.round(196 * sh) + "," + Math.round(170 * sh) + ")"; g.fillRect(x + 1.5, y + 1.5, bw - 3, rh - 3); g.fillStyle = "rgba(0,0,0,.07)"; g.fillRect(x + 1.5, y + rh - 5, bw - 3, 3.5); g.fillStyle = "rgba(255,255,255,.1)"; g.fillRect(x + 1.5, y + 1.5, bw - 3, 2); } }
    for(let i = 0; i < 700; i++){ g.fillStyle = "rgba(" + (Math.random() < 0.5 ? "70,60,40" : "255,250,235") + "," + (Math.random() * 0.06) + ")"; g.fillRect(Math.random() * w, Math.random() * h, 1 + Math.random() * 3, 1 + Math.random() * 3); }
    g.strokeStyle = "rgba(70,60,40,.35)"; g.lineWidth = 1.2; for(let r = 0; r <= rows; r++){ g.beginPath(); g.moveTo(0, r * rh); g.lineTo(w, r * rh); g.stroke(); }
  }, null);
}
function gateAshlarMat(w, wallH){ const t = gateAshlarTex().clone(); t.needsUpdate = true; t.repeat.set(Math.max(1, w / 2.6), Math.max(1, wallH / 2.0)); return new THREE.MeshStandardMaterial({map:t, roughness:0.92}); }
function gateWallDress(g, cx, zf, off, w, wallH, s){
  const rot = off > 0 ? 0 : Math.PI, dark = new THREE.MeshStandardMaterial({color:0x6d6450, roughness:0.95}), stoneL = new THREE.MeshStandardMaterial({color:0xe8e1d0, roughness:0.85});
  /* blind arches between the pilasters */
  const n = Math.max(1, Math.floor((w - 1.0) / 3.0)), step = w / n;
  for(let i = 0; i < n; i++){ const x = cx - w / 2 + step * (i + 0.5), ah = Math.min(2.1, wallH - 1.4), aw = Math.min(1.5, step - 1.1); if(aw < 0.5) continue;
    gateAdd(g, dark, x, 0.4 + ah / 2, zf, aw, ah, 0.03); const arc = new THREE.Mesh(new THREE.CylinderGeometry(aw / 2, aw / 2, 0.03, 14, 1, false, 0, Math.PI), dark); arc.rotation.x = Math.PI / 2; arc.rotation.z = Math.PI / 2; arc.position.set(x, 0.4 + ah, zf); arc.rotation.set(Math.PI / 2, 0, Math.PI / 2); g.add(arc);
    gateAdd(g, stoneL, x, 0.38, zf + off * 0.02, aw + 0.25, 0.08, 0.08); }
