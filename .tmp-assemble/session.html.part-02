  }catch(e){}
  if(_prof) _prof.mark("lighting");
  /* Moving: skip shadow map refresh — room shadows stay; biggest hitch after people cast. */
  if(playerMoving){
    try{ if(renderer && renderer.shadowMap) renderer.shadowMap.needsUpdate = false; }catch(e){}
  } else if(!MODEST || (FRAME_ID & 3) === 0){
    shadowTick(dt);
  }
  if(_prof) _prof.mark("shadow");
  if(!GL_LOST){
    let _ndg = false; try{ _ndg = ndGate(); }catch(e){}
    if(!_ndg) try{ renderer.render(scene, camera); }
