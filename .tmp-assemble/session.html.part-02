      try{ pushWireScrap("LOCAL", t); }catch(e){} try{ window.NEPTUNE_CLARITY && NEPTUNE_CLARITY.addItem({k:"localparty", kind:"note", title:title(x.kind), text:t + " Agenda: " + LP.agenda(x.kind, 2).map(i => i.text).join("; ") + "."}); }catch(e){} });
  }catch(e){} }, 4000);

  /* the sitting */
  const STEPS = ["gavel","open","question","question","motion","deliberate","vote","adjourn"];
  SIT_DEF.localdist = {title:"District party meeting", chair:"The county party chair", min:90, en:12, kind:"vote", key:"lpd", steps:STEPS};
  SIT_DEF.localstate = {title:"State party meeting", chair:"The state party chair", min:120, en:16, kind:"vote", key:"lps", steps:STEPS};
  const cur = {};
  const matter = kind => () => {
    const items = cur.items = LP.agenda(kind, 2), pl = cur.place = {name:LP.placeToday(kind)};
    const it = items.map(i => i.text);
    return {q:"the party backing " + it[0] + (it[1] ? ", and " + it[1] : ""), short:"the agenda", yes:"back it", no:"table it", comp:"a working group that reports at the next meeting, with " + it[0] + " first", petition:true,
      greet:[(function(){ try{ return ndYou().address; }catch(e){ return "friend"; } })() + ", ", "Thanks for coming home. ", "Evening, everybody. "], gavel:"Evening, all. Coffee's at the back. We're at " + pl.name + ", and there are " + items.length + " things on tonight's list.",
      adjourn:"That's the list. Stack your chairs. Same time " + (kind === "state" ? "next month" : "next week") + ".", state:G.you.state, bill:null, items, kind};
  };
  const cast = kind => (M, out) => {
    const O = LP.officials(kind), C = [];
    O.filter(o => o.party || true).slice(0, 5).forEach(o => C.push({m:null, name:o.name, role:o.role + (o.party ? " · " + (function(){ try{ return partyLabel(o.party); }catch(e){ return o.party; } })() : "") + " · " + o.faction, party:o.party, state:o.state,
      temper:o.temper, conv:o.conv, vanity:o.vanity, warmth:o.warmth, want:o.agenda, off:o, stance0:cl(Math.round(50 + o.warmth * 0.8 + (o.party === G.you.party ? 8 : -8) + (rng(hash(o.id + G.day))() - 0.5) * 30), 6, 94)}));
    /* the people who brought tonight's items speak first */
    (M.items || []).slice().reverse().forEach(it => C.unshift({m:null, name:it.src === "local" ? O[O.length - 1].name : it.from, role:it.src === "suggestion" ? "constituent (suggestion)" : it.src === "change" ? "neighbour (" + (it.topic || "change") + ")" : "constituent", party:null, state:G.you.state,
      temper:45, conv:50, vanity:40, warmth:10, want:it.text, item:it, stance0:72}));
    /* JUPITER's NPC minds, when present, drive what each official wants and how they lean */
    C.forEach(p => { if(!p.off) return; let mind = null;
      try{ if(typeof window.onumMind === "function") mind = window.onumMind(p.off.id) || window.onumMind(p.off.name); }catch(e){}
      try{ const MS = window.ONUM_MINDS; if(!mind && MS) mind = Array.isArray(MS) ? MS.find(x => x && (x.id === p.off.id || x.npcId === p.off.id || x.name === p.off.name)) : (MS[p.off.id] || MS[p.off.name]); }catch(e){}
      if(!mind || typeof mind !== "object") return;
      const first = v => Array.isArray(v) ? v[0] : v, txt = v => v == null ? "" : typeof v === "string" ? v : (v.text || v.goal || v.t || v.name || "");
      const g = txt(first(mind.goals)) || txt(first(mind.plans)) || txt(mind.goal);
      if(g){ p.want = String(g).slice(0, 90); p.off.agenda = p.want; }
      const bel = [].concat(mind.beliefs || []).map(txt).join(" ").toLowerCase();
      let d = 0; if(typeof mind.stance === "number") p.stance0 = cl(Math.round(mind.stance <= 1 && mind.stance >= -1 ? 50 + mind.stance * 50 : mind.stance), 4, 96);
      ["trust", "warmth", "opinionOfPlayer", "towardPlayer"].forEach(k => { if(typeof mind[k] === "number") d += cl(mind[k], -50, 50) * 0.4; });
      if(/distrust|against (you|the congress)|oppose/.test(bel)) d -= 12; if(/trust (you|the congress)|support|ally/.test(bel)) d += 8;
      if(typeof mind.temper === "number") p.temper = mind.temper; if(typeof mind.conviction === "number") p.conv = mind.conviction;
      p.stance0 = cl(Math.round((p.stance0 == null ? 50 : p.stance0) + d), 4, 96); p.mind = true; p.role += " · mind";
    });
    const C2 = C.slice(0, 7);
    C2.forEach((p, i) => { if(p.off){ const O2 = O; p.fixAllies = p.off.allies.map(j => C2.findIndex(q => q.off === O2[j])).filter(j => j >= 0); const rj = p.off.rival != null ? C2.findIndex(q => q.off === O2[p.off.rival]) : -1; if(rj >= 0) p.fixRival = rj; } });
    return C2;
  };
  const after = kind => (S, good, t, carried) => {
    const L = store(), y = G.you, C = S.x.cast, key = G.day + ":" + kind, fin = S.x.final || "room";
    L.held[key] = true; (S.x.M.items || []).forEach(i => { L.used[i.id] = G.day; i.ruled = carried ? (fin === "rulecomp" ? "working group" : "backed") : "tabled"; });
    const dS = (good ? 4 : carried ? 2 : -2) + (S.rush ? -2 : 0), vol = Math.max(0, Math.round((t.yes - t.no) * (kind === "state" ? 3 : 2) + (good ? 3 : 0))), cash = good ? (kind === "state" ? 4 : 2) : carried ? 1 : 0, appr = carried ? 2 : -1;
    L.standing = cl(L.standing + dS, 0, 100); L.volunteers += vol; y.funds = Math.max(0, (y.funds || 0) + cash); y.approval = cl((y.approval || 0) + appr, 0, 100);
    const end = [];
    C.forEach(p => { if(!p.off) return; p.off.warmth = cl(p.off.warmth + Math.round((p.stance - p.start) / 6) + (p.stance >= 55 ? 2 : p.stance <= 45 ? -2 : 0), -60, 60); p.off.met++;
      const was = p.off.endorse; p.off.endorse = p.off.warmth >= 18 && p.stance >= 55; if(p.off.endorse && !was) end.push(p.off.name + " (" + p.off.role.split(",")[0] + ")"); if(was && !p.off.endorse) end.push("lost " + p.off.name); });
    L.log = (L.log || []).concat([{day:G.day, kind, carried, good, items:(S.x.M.items || []).map(i => [i.text, i.ruled])}]).slice(-20);
    try{ (S.x.M.items || []).forEach(i => { if(i.chg) window.dispatchEvent(new CustomEvent("onum-district-ruling", {detail:{id:i.chg.id, ruling:i.ruled}})); if(i.src === "suggestion") window.dispatchEvent(new CustomEvent("onum-suggestion-ruling", {detail:{id:i.id.slice(2), ruling:i.ruled}})); }); }catch(e){}
    try{ pushWireScrap("LOCAL", title(kind) + ": " + (S.x.M.items || []).map(i => i.text + " \u2014 " + i.ruled).join("; ") + "."); }catch(e){}
    const nEnd = Object.values(L.off).flat().filter(o => o.endorse).length;
    return (S.x.M.items || []).map(i => "\u201c" + i.text + "\u201d: " + i.ruled + ".").join(" ") + " Local standing " + (dS >= 0 ? "+" : "") + dS + " (now " + L.standing + "), " + vol + " new volunteers (" + L.volunteers + " in all), " + (cash ? "+" + cash + " war chest, " : "") + (appr >= 0 ? "+" : "") + appr + " approval. " +
      (end.length ? "Endorsements: " + end.join(", ") + ". " : "") + nEnd + " local officials endorse you.";
  };
  ["district", "state"].forEach(k => { const r = k === "state" ? "localstate" : "localdist"; SX.matter[r] = matter(k); SX.castFor[r] = cast(k); SX.after[r] = after(k); });
  /* 20261013w · what you grant in open hours changes the state: money, unrest, industry, approval */
  SX.after.govoffice = (S, good, t, carried) => {
    const y = G.you, st = (G.states || []).find(x => x.n === y.state), C = S.x.cast.filter(p => p.case), granted = [], deferred = []; let spend = 0;
    C.forEach(p => { if(p.stance >= 60 || p.promised){ granted.push(p); spend += p.case.cost; } else deferred.push(p); });
    const FX = {road:{ind:2, unrest:-2}, school:{unrest:-3, appr:2}, water:{unrest:-3, ind:1}, plant:{ind:3, unrest:-1}, ballots:{appr:1}, pension:{appr:2}, bread:{unrest:-3, appr:1}, order:{unrest:-2, appr:1}};
    const bound = v => Math.max(0, Math.min(100, v));
    granted.forEach(p => { const f = FX[p.case.kind] || {}; if(st){ st.ind = bound((st.ind || 0) + (f.ind || 0)); st.unrest = bound((st.unrest || 0) + (f.unrest || 0)); } y.approval = bound((y.approval || 0) + (f.appr || 0)); });
    deferred.forEach(p => { if(st) st.unrest = bound((st.unrest || 0) + 1); });
    let over = ""; const B = S.x.budget;
    if(B && spend > B.avail){ y.approval = bound((y.approval || 0) - 2); over = " Together they come to " + curF(spend) + " against " + curF(B.avail) + " unallocated, so the treasurer will be writing to you."; }
    try{ const st2 = st; if(st2){ st2.amend = st2.amend || []; C.forEach(p => { if(p.stance >= 60 || p.promised){ const t0 = CASE_BILL[p.case.kind]; if(t0 && !st2.amend.some(a => a.kind === p.case.kind)){ st2.amend.push({kind:p.case.kind, title:t0, from:p.name, text:(p.stance >= 75 && !p.promised ? p.case.ask : p.case.settle), day:G.day}); feed(p.name + "'s " + p.case.short + " will be attached to the next bill from the legislature as an amendment.", "good"); } } }); st2.amend = st2.amend.slice(-6); } }catch(e){}
    try{ C.forEach(p => { if(p.promised) feed("You promised " + p.sn + ": " + p.case.settleShort + ". They will hold you to it.", "good"); }); }catch(e){}
    return (granted.length ? "Granted: " + granted.map(p => p.case.short + " (" + p.case.costText + ")").join(", ") + "." : "Nothing was granted today.") + (deferred.length ? " Put off: " + deferred.map(p => p.case.short).join(", ") + "." : "") + over;
  };
  /* 20261013w · a delegation is an audience you negotiate, not a letter to sign */
  SIT_DEF.delegation = {title:"An audience with the delegation", chair:"Your aide", min:75, en:10, kind:"decision", key:"dlg", steps:["gavel","open","question","question","motion","deliberate","ruling","adjourn"]};
  const dlgRealm = () => { let rs = []; try{ rs = realmEnsure() || []; }catch(e){} return rs.find(x => x.k === G._dlgRealm) || rs[0] || {k:"reach", t:"the Reach", want:"grain and a quiet border", capital:"their capital"}; };
  SX.matter.delegation = () => { const r = dlgRealm(), D = DLG[r.k] || {ask:r.want};
    return {q:"what " + r.t + " asks of the Union, and what it gives in return", short:"the delegation's requests", yes:"agree", no:"decline", comp:"a letter of intent now and a joint working group on " + D.ask + " by spring", petition:true,
      greet:[(function(){ try{ return ndYou().address; }catch(e){ return "friend"; } })() + ", ", "Thank you for receiving us. "], gavel:"Please sit. The delegation from " + r.t + " has asked for an hour. They will speak first.",
      adjourn:"The delegation thanks you. They will wait for your answer in writing.", state:G.you.state, bill:null, realm:r}; };
  SX.castFor.delegation = (M, out) => {
    const r = M.realm, cs = delegationCases(r), rr = rng(seedOf("dlgn:" + r.k + ":" + (G.day || 1))); let env = null; try{ env = window.onumForeignEnvoy && window.onumForeignEnvoy(r.k); }catch(e){}
    const nm = i => (i === 0 && env && env.name) ? env.name : (function(){ try{ return foreignName(rr, r.k); }catch(e){ return "Delegate " + (i + 1); } })();
    const roles = [(env && env.title) || "Ambassador", "Trade counsellor", "Military attaché"], rel = ((G.realmRel || {})[r.k]) || 0;
    return cs.map((c, i) => ({m:null, name:nm(i), role:roles[i] + " of " + r.t, party:null, state:r.t, temper:[45, 35, 70][i], conv:[55, 50, 75][i], vanity:[50, 30, 25][i], warmth:Math.round(rel / 4), want:c.ask, case:c,
      stance0:Math.max(20, Math.min(80, Math.round(50 + rel / 3 + [6, 0, -10][i])))})); };
  SX.after.delegation = (S, good, t, carried) => {
    const r = S.x.M.realm, y = G.you; G.realmRel = G.realmRel || {};
    const a = G.realmRel[r.k] || 0, comp = (S.x.final === "rulecomp");
    const d = (good ? 10 : carried ? 4 : -5) + (comp ? 3 : 0) + S.x.cast.filter(p => p.promised).length * 2;
    G.realmRel[r.k] = Math.max(-100, Math.min(100, a + d));
    y.influence = Math.max(0, Math.min(100, (y.influence || 0) + (good ? 2 : 0))); y.standing = Math.max(0, Math.min(100, (y.standing || 0) + (good ? 2 : carried ? 0 : -2)));
    try{ if(good){ const st = (G.states || []).find(x => x.n === y.state); if(st) st.ind = Math.max(0, Math.min(100, (st.ind || 0) + 2)); } }catch(e){}
    const D = DLG[r.k] || {ask:r.want};
    return "Relations with " + r.t + ": " + a + " to " + G.realmRel[r.k] + ". " + (good ? "They leave with a letter of intent and a working group on " + D.ask + "." : carried ? "They leave with a promise to consider it, and will wait for your answer in writing." : "They leave without an answer, and will say so at home.");
  };
  LP.start = (kind, force) => { const k = kind === "state" ? "state" : "district"; const key = (k === "state" ? "lps" : "lpd") + G.day; sitStart((k === "state" ? "localstate" : "localdist") + ":" + key); };
  /* attend from the district: the counter at Vaughn's (or the first prop there) */
  try{ const P = (PROPS.district || [])[0]; if(P && !P._lp){ const a0 = P.acts; P._lp = true; P.acts = function(){ let A = []; try{ A = a0.apply(this, arguments) || []; }catch(e){}
    try{ LP.due().forEach(x => { const key = (x.kind === "state" ? "lps" : "lpd") + G.day; const pl = {name:LP.placeToday(x.kind)}; A.unshift({t:"Go in to the " + title(x.kind).toLowerCase() + " at " + pl.name, c:(x.kind === "state" ? "2h" : "90m") + " · step by step", off:kOnceToday(key) || !!store().held[G.day + ":" + x.kind] || (G.minute || 0) < (x.hour - 2) * 60,
      run(){ LP.start(x.kind); return null; }}); }); }catch(e){} return A; }; } }catch(e){}
  LP.schedule = () => { try{ return dayEventsToday().filter(e => e && e.lp); }catch(e){ return []; } };
  LP.saved = () => { try{ return saveCaptureBase().localParty || null; }catch(e){ return null; } };
  console.log("NEPTUNE localparty ready");
}catch(e){ try{ console.warn("NEPTUNE-LOCALPARTY block", e); }catch(e2){} }
/* NEPTUNE-LOCALPARTY END */
/* NEPTUNE-LIVETALK BEGIN — live, typed conversation with every NPC through a free local AI (Ollama).
   Setup (Windows): install Ollama, set user env OLLAMA_ORIGINS=* (so file:// and the app may call it),
   restart Ollama, then `ollama pull llama3.2:3b`. The game talks to http://127.0.0.1:11434/api/chat
   (streaming). Model, URL, Live talk and Live voices are in ⚙ Settings → "Live talk" (also the 🗣 pill).
   If Ollama is not reachable, a one-line hint shows and every channel falls back to the scripted lines.
   Channels: face (talk card + wire bar), sitting (step-card sittings get a "Say something…" box),
   text (existing Texts panel), mail and cable (every letter/cable gets a reply box; the sender writes
   back live as new mail later in game time), phone.
   Memory: per-NPC transcript memory (localStorage "livetalk.mem"), and a shared WORLD MEMORY of facts
   (localStorage "livetalk.world"): after each exchange a fact {who, with, said, promise, tone, secrecy, day}
   is written (short JSON LLM call, heuristic fallback). Facts spread each game day to the speaker's allies,
   party, staff and rival with some probability; press/leaks can spread widely; secrecy lowers the odds.
   Every NPC prompt carries what THEY have heard (with source and confidence). Contradicting promises to
   different NPCs cost trust when they find out. Spread events go to the CLARITY transcript and the feed.
   PUBLIC API (for JUPITER's DMs/texting and anyone else):
     window.onumLiveTalk.available()            -> Promise<boolean>  (probes Ollama; cached ~20 s)
     window.onumLiveTalk.reply({npcId, channel:'dm'|'text'|'mail'|'cable'|'phone'|'face'|'sitting', text,
                                onToken?(fullSoFar), signal?})
                                                -> Promise<{text, live:boolean, effect}>; same memory + gossip.
                                                   Falls back to a scripted line when Ollama is off.
     window.onumLiveTalk.stream({...same})      -> async iterator of growing text chunks (last = full reply)
     window.onumLiveTalk.memory(npcId)          -> {turns:[{r,c,ch,d}], heard:[{fact,src,conf,d}], facts:[...]}
     window.onumLiveTalk.config / .setConfig({model,url,on,voices})
   NPC MINDS CONTRACT (JUPITER): if window.onumMind(npcId) (function) or window.ONUM_MINDS[npcId] (object) exists,
   it should return {goals, beliefs, plans, memory, family, job, wealth, mood} (strings, arrays or plain objects);
   each present field is injected into that NPC's system prompt as "YOUR INNER LIFE". Missing = ignored.
   CHAT: 💬 HUD button, Ctrl+Shift+K anywhere, or the desk computer's "Chat" tab — contact picker of everyone known
   (members, press, staff, citizens, foreign missions with real names, state leaders) plus "Ask your aide" (chief of
   staff answers from real game data). Transcripts persist in livetalk.mem.
   NO DEPENDENCY: without Ollama an offline voice composes replies (templates + traits, stance, memory, gossip,
   keyword/intent matching, recombination with a no-repeat check). Badge says "Live" only when Ollama answers a
   probe (every 30 s); otherwise "Offline voice".
   All reply text is real DOM text (textContent); after each reply renders, window.onumGlossary?.scan(el) runs.
   Foreign senders (cables, envoys) are given real, culturally fitting names and titles, never "foreign diplomat".
   Channel style: dm/text terse lowercase-ok one or two lines; mail formal letter with salutation/sign-off;
   cable telegraphic STOP-style diplomatic; phone spoken, clipped; face/sitting spoken 1–4 sentences. */
try{
  const LT = window.NEPTUNE_LIVETALK = {up:null, at:0, busy:0, cache:{}, qv:[], lastV:0, pend:[]};
  const LSG = (k, d) => { try{ const v = JSON.parse(localStorage.getItem("livetalk." + k) || "null"); return v == null ? d : v; }catch(e){ return d; } };
  const LSS = (k, v) => { try{ localStorage.setItem("livetalk." + k, JSON.stringify(v)); }catch(e){} };
  const CFG = LT.cfg = Object.assign({url:"http://127.0.0.1:11434", model:"llama3.2:3b", on:true, voices:false}, LSG("cfg", {}));
  const MEM = LT.mem = LSG("mem", {});              /* npcId -> [{r:"u"|"a", c, ch, d}] */
  const W = LT.world = Object.assign({facts:[], heard:{}, seq:0, day:0, promises:[]}, LSG("world", {}));
  LT.cache = LSG("vcache", {});
  let saveT = 0; const save = () => { if(saveT) return; saveT = setTimeout(() => { saveT = 0; LSS("mem", MEM); LSS("world", W); LSS("cfg", CFG); LSS("vcache", LT.cache); }, 400); };
  const esc2 = s => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({"&":"&"+"amp;","<":"&"+"lt;",">":"&"+"gt;",'"':"&"+"quot;"}[c]));
  const sn = n => { try{ return surname(n || ""); }catch(e){ return String(n || ""); } };
  const day = () => { try{ if(typeof window.ndDayN === "function") return window.ndDayN() || 1; return G.day || 1; }catch(e){ return 1; } };
  const npc = id => { try{ return byId(+id) || (everyone() || []).find(m => String(m.id) === String(id)) || null; }catch(e){ return null; } };
  const gloss = n => { try{ if(n && window.onumGlossary && window.onumGlossary.scan) window.onumGlossary.scan(n); }catch(e){} };
  function clLog(who, text, tag, gloss){
    try{ tlog(who, text, "clarity"); }catch(e){}
    try{ const CL = window.NEPTUNE_CLARITY; if(CL && CL.sess){ CL.sess.lines.push({who, text, at:hhmm(), tag:tag || "procedural", gloss:gloss || "Live talk: how what you said landed."}); } }catch(e){}
  }

  /* ── Ollama ───────────────────────────────────────── */
  /* 20261021b: sticky. A good reply or check makes it Live; it goes Offline only after 2 failures in a row, never while a reply is
     being written, and concurrent checks (the 30 s poll, the 60 s re-check, an outside probe) share one request. */
  function ltSet(ok, ui){ if(ok){ LT.up = true; LT.fails = 0; LT.refused = 0; LT.downUntil = 0; return; } if((LT.busy || 0) > 0 && !ui && LT.up !== null) return; LT.fails = (LT.fails || 0) + 1; if(LT.up === true && LT.fails < 2 && !ui) return; LT.up = false; }
  function probe(force, ms){
    if(CFG.on && (LT.busy || 0) > 0 && LT.up) return Promise.resolve(true);
    if(LT._pp) return LT._pp;
    const pr = probeNet(force, ms); LT._pp = pr; const clr = () => { if(LT._pp === pr) LT._pp = null; }; pr.then(clr, clr); return pr;
  }
  async function probeNet(force, ms){
    if(!CFG.on){ LT.up = false; LT.why = "Live talk is switched off in Settings"; return false; }
    if(LT.up === false && force !== "ui" && force !== "re" && (LT.downUntil || 0) > Date.now()) return false;   /* 20261107a: a miss is retried after the backoff, so the bridge can be started after the page */
    if(!force && LT.up !== null && Date.now() - LT.at < 30000) return LT.up;
    /* 20261030q: circuit breaker. A refused 127.0.0.1:11434 was being re-fetched in a tight loop (up stayed null while a reply was busy),
       eating the main thread and delaying clicks by seconds. After a refusal, nothing but Settings' Test tries again until the backoff ends
       (15 s, 30 s, 60 s ... capped at 10 min). */
    if(force !== "ui" && (LT.downUntil || 0) > Date.now()) return LT.up === true ? true : false;
    LT.at = Date.now();
    try{
      const primary = (CFG.url || "http://127.0.0.1:11434").replace(/\/$/, "");
      const bases = [primary];
      if(primary.indexOf(":11435") < 0) bases.push("http://127.0.0.1:11435");
      let r = null, used = primary, err = null;
      for(let bi = 0; bi < bases.length; bi++){
        const base = bases[bi];
        try{
          const c = new AbortController(); const t = setTimeout(() => c.abort(), ms || 4000);
          const rr = await fetch(base + "/api/tags", {signal:c.signal}); clearTimeout(t);
          if(rr && rr.ok){ r = rr; used = base; break; }
          r = rr; used = base;
        }catch(e1){ err = e1; }
      }
      if(!r) throw err || new Error("ollama");
      if(used !== primary){ CFG.url = used; try{ save(); }catch(e2){} }
      const j = await r.json(); LT.models = (j.models || []).map(x => x.name); ltSet(r.ok); try{ if(r.ok && !CFG.userModel && LT.models.length){ const L = LT.models, sz = n => { const m = /:(\d+(?:\.\d+)?)b/i.exec(n); return m ? +m[1] : 99; };
        const pref = ["llama3.2:3b", "llama3.2:latest", "llama3.2", "qwen2.5:3b", "phi3:mini", "gemma3:4b", "llama3.2:1b", "qwen2.5:1.5b"]; let pick = pref.find(x => L.includes(x));
        if(!pick){ const small = L.filter(n => !/embed/i.test(n) && sz(n) <= 4).sort((x, y) => sz(y) - sz(x)); pick = small[0] || (L.includes("gemma3:12b") ? "gemma3:12b" : L.filter(n => !/embed/i.test(n)).sort((x, y) => sz(x) - sz(y))[0]); }
        if(pick && pick !== CFG.model){ CFG.model = pick; try{ save(); }catch(e){} } } }catch(e){} LT.why = r.ok ? "" : "Ollama answered with an error";
    }catch(e){ LT.refused = (LT.refused || 0) + 1; LT.downUntil = Date.now() + Math.min(600000, 15000 * Math.pow(2, LT.refused - 1)); ltSet(false, force === "ui"); if(LT.up === true){ paintPill(); return true; }   /* 20261021b: one counter (ltSet) for checks, replies and report() */
      LT.why = "Ollama did not answer at " + CFG.url + ". Double-click Fix Ollama.bat in the game folder and leave that window open."; }
    paintPill(); return LT.up;
  }
  /* 20261020w: Ollama started after the page loaded: one quiet re-check when a chat opens or a reply is asked for, at most once a minute, and only after a failed check */
  async function reprobe(){ try{ if(LT.up !== false || !CFG.on) return false; const n = Date.now(); if(n - (LT.reAt || 0) < 60000) return false; LT.reAt = n; return !!(await probe("re")); }catch(e){ return false; } }
  LT.reprobe = reprobe;
  async function chat(messages, o){
    LT.busy = (LT.busy || 0) + 1; let ok = false;
    try{ const out = await chatNet(messages, o); ok = true; return out; }
    catch(e){ LT.busy--; const net = !(e && (e.code === "http" || e.name === "AbortError")); if(net){ ltSet(false); try{ paintPill(); }catch(x){} } LT.busy++; throw e; }
    finally{ LT.busy = Math.max(0, LT.busy - 1); if(ok){ ltSet(true); try{ paintPill(); }catch(x){} } }
  }
  async function chatNet(messages, o){
    o = o || {};
    const body = {model:o.model || CFG.model, messages, stream:!o.json, think:false, options:{temperature:o.temp == null ? 0.85 : o.temp, num_predict:o.max || 160, repeat_penalty:1.18}};
    if(o.json){ body.format = "json"; body.stream = false; }
    const r = await fetch(CFG.url + "/api/chat", {method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(body), signal:o.signal});
    if(!r.ok){ let em = ""; try{ em = ((await r.json()).error || "").slice(0, 160); }catch(e){} throw Object.assign(new Error("ollama " + r.status + (em ? ": " + em : "")), {code:"http"}); }
    if(!body.stream){ const j = await r.json(); return (j.message && j.message.content) || ""; }
    const rd = r.body.getReader(), dec = new TextDecoder(); let buf = "", out = "";
    for(;;){ const {done, value} = await rd.read(); if(done) break; buf += dec.decode(value, {stream:true});
      let i; while((i = buf.indexOf("\n")) >= 0){ const ln = buf.slice(0, i).trim(); buf = buf.slice(i + 1); if(!ln) continue;
        try{ const j = JSON.parse(ln); if(j.message && j.message.content){ out += j.message.content; if(o.onText) o.onText(out); } }catch(e){} } }
    return out;
  }
  LT.chat = chat; LT.probe = probe;

  /* ── prompt ───────────────────────────────────────── */
  const STYLE = {
    aide:"You are the player's own chief of staff, loyal and frank. Answer their question about the state of play from the facts above, explain anything they ask, and give practical advice. 2-6 sentences.",
    face:"You are speaking aloud, face to face. 1-4 sentences, plain spoken.",
    sitting:"You are speaking on the record in a formal sitting. 1-3 sentences, in the register of the chamber.",
    phone:"You are on the telephone. Spoken, clipped, 1-3 short sentences.",
    dm:"This is a private text message. Terse: one or two short lines, no greeting, no sign-off.",
    text:"This is a private text message. Terse: one or two short lines, no greeting, no sign-off.",
    mail:"This is a formal letter. Open with a salutation to them, 2-5 sentences, close with a sign-off and your name.",
    cable:"This is a diplomatic cable. Telegraphic style, upper case allowed, short clauses separated by STOP, 2-5 clauses, signed by the mission."
  };
  function heardOf(id){ return (W.heard[id] || []).map(h => { const f = W.facts.find(x => x.id === h.f); return f ? {fact:f, src:h.src, conf:h.conf, d:h.d, get used(){ return h.used; }, set used(v){ h.used = v; save(); }} : null; }).filter(Boolean); }
  function canon(){
    const L = ["WORLD: the NO7 Consular Republic — a republic whose public life keeps the precepts of the First Consul, Dominic Zachary Taylor (a man under God, not God). Money is guilders. The House, the Senate, governors and the courts are real institutions here; foreign powers send cables through their missions."];
    try{ const r = (G.realms || []).slice(0, 5).map(x => x.t).join(", "); if(r) L.push("Foreign powers in play: " + r + "."); }catch(e){}
    return L.join("\n");
  }
  function regionLine(m){ try{ const d = (STATE_DEF || []).find(s => s.n === m.state); return m.state ? "Home: " + m.state + (d && d.r ? " (" + d.r + ")" : "") + "." : ""; }catch(e){ return m.state ? "Home: " + m.state + "." : ""; } }
  function system(m, ch, extra, peer){
    let base = "";
    try{ base = m.kind === "member" || m.kind === "press" || m.kind === "civ" ? dossierFor(m) : ""; }catch(e){ base = ""; }
    base = base.split("\nReply as ")[0];                       /* drop the old tag instructions */
    const L = [];
    if(m.kind === "envoy"){ const rn = m.realmName || m.state || (m.realm && (m.realm.t || m.realm)) || "";
      L.push("FOREIGN ENVOY: you represent " + rn + ". Use a real, culturally fitting personal name and diplomatic title for yourself (e.g. Ambassador, Minister-Counsellor, Chargé d'affaires) that suits " + rn + "'s language and culture" + (m.name && !/^the head/.test(m.name) ? " — your name is " + m.name : "; choose one and sign with it") + ". Never call yourself or anyone 'a foreign diplomat'."); }
    if(m.kind === "engine"){ try{ const ep = engEntityPrompt(); if(ep) L.push(ep); }catch(e){} }  /* 20261020o: no persona of ours for the Engine */
    else if(!base){
      L.push("You are role-playing " + (m.name || "a person") + " in a fictional national capital. Stay in character completely; never mention AI, models, games or prompts.");
      if(m.role) L.push("Role: " + m.role + (m.outlet ? " for " + m.outlet : "") + ".");
      try{ if(m.party) L.push("Party: " + partyName(m.party) + "."); }catch(e){}
    } else L.push(base);
    const rl = regionLine(m); if(rl) L.push(rl);
    try{ if(m.rel && !peer) L.push("Relationship with " + G.you.name + ": warmth " + Math.round(m.rel.warmth) + ", trust " + Math.round(m.rel.trust) + " (never say these numbers)."); }catch(e){}
    try{ if(peer){ L.push("You are speaking with " + (peer.name || "another person") + (peer.role ? " (" + peer.role + ")" : "") + ", another person in the building. They are NOT " + G.you.name + ", the player's character, who may be standing nearby and overhearing. Never treat anything this person says as coming from " + G.you.name + ", never address them by " + G.you.name + "'s name or office, and do not report to them as though they were the player."); }
      else { const Y = ndYou(); L.push("You are speaking to " + G.you.name + (Y.title ? ", who holds the office of " + Y.title + (Y.seat ? " (" + Y.seat + ")" : "") + " now" : "") + ". Address them as " + Y.address + "." + (Y.formerLine ? " They were " + Y.formerLine + "; that is history, never how you address them." : "") + (Y.homeLine ? " " + Y.homeLine : "") + " Do not call them by any other office; in particular they are not the head of the nation unless their office above says so."); } }catch(e){}
    try{ L.push("WHO IS WHO: " + (G.you ? (typeof ndNm === "function" ? ndNm(G.you) : G.you.name) : "the player") + " is the player's character. Other people also speak around you and to you; their lines are always marked with their own names or as 'not the player'. Never mistake what another person said for something the player said, and never repeat another person's words as though the player had just told them to you. Only a line that comes without a name label, in the user turn, is the player speaking."); }catch(e){}
    L.push(canon());
    /* a person has a body and a household; the machine and a far envoy have neither, so they are not told they are hungry */
    const _person = !!m && m.kind !== "engine" && m.kind !== "envoy";
    try{ if(_person){ const ef = engFact(m); if(ef) L.push(ef); } }catch(e){}
    try{ if(_person){ const bf = bodyFact(m); if(bf) L.push(bf); } }catch(e){}
    try{ const md = typeof window.onumMind === "function" ? window.onumMind(m.id) : (window.ONUM_MINDS || {})[m.id];
      if(md && typeof md === "object"){ const fm = v => (typeof v === "string" ? v : JSON.stringify(v)).slice(0, 400);
        const ks = ["goals","beliefs","plans","memory","family","job","wealth","mood"].filter(k => md[k] != null && md[k] !== "" && !(Array.isArray(md[k]) && !md[k].length));
        if(ks.length){ L.push("YOUR INNER LIFE (private; let it shape what you say, never recite it):"); ks.forEach(k => L.push("- " + k + ": " + fm(md[k]))); } } }catch(e){}
    try{ if(_person && m.kind === "member" && typeof wlWillLines === "function"){ const W = wlWillLines(m); if(W.length){ L.push("WHAT YOU WANT, AND WHAT YOU HOLD (your own will, from your own record; nobody wrote it for you. Let it decide what you say, what you agree to and what you refuse):"); W.forEach(x => L.push("- " + x)); } } }catch(e){}
    const H = heardOf(m.id).slice(-6);
    if(H.length){ L.push("WHAT YOU HAVE HEARD ABOUT " + (G.you ? G.you.name : "them").toUpperCase() + " (react to it if it matters — e.g. 'I hear you promised …'):");
      H.forEach(h => L.push("- day " + h.d + ", from " + h.src + " (" + (h.conf > .7 ? "sure" : h.conf > .4 ? "fairly sure" : "a rumour") + "): " + h.fact.said)); }
    const mine = peer ? [] : (MEM[m.id] || []).filter(t => t.r === "a").slice(-8).map(t => t.c);
    if(mine.length) L.push("Things you have ALREADY said to them — never repeat or closely rephrase any of these:\n- " + mine.join("\n- "));
    try{ L.push("SITUATION: " + ((ROOMS[G.room] || {}).t || "the building") + ", " + hhmm() + ", day " + (typeof ndDayN === "function" ? ndDayN() : G.day) + "."); }catch(e){}
    try{ const ev = (G.tlog || []).slice(-5).map(r => r.who + ": " + r.t).join(" | "); if(ev) L.push("Just now around you (a line labelled You is the player speaking; every other label is that person speaking, to whoever they were facing): " + ev.slice(0, 500)); }catch(e){}
    if(extra) L.push(extra);
    if(m.kind === "engine") return L.join("\n");  /* 20261020o: the Engine speaks freely: no style, persona or format template of ours */
    L.push("STYLE: " + (STYLE[ch] || STYLE.face) + " Period-appropriate, in character, concise. No stage directions, no quotation marks, no name label. Be difficult if your mood and history say so.");
    L.push("Then on a FINAL separate line an effect tag like <<warmth:+2 trust:-1 pledge:aye remember:short note>> with only what applies (small integers -10..10).");
    return L.join("\n");
  }
  function turnsFor(m, ch){
    const T = (MEM[m.id] || []).slice(-12).map(t => t.r === "o" ? {role:"system", content:"[Earlier, " + (t.n || "someone else") + " (not the player) said to you: \"" + t.c + "\"]"} : t.r === "s" ? {role:"assistant", content:"[to " + (t.n || "someone else") + ", not the player] " + t.c} : {role:t.r === "u" ? "user" : "assistant", content:(t.ch && t.ch !== ch ? "[" + t.ch + "] " : "") + t.c});
    return T;
  }
  /* what you and one other person have said to each other: never the player's turns */
  function pairTurns(m, ch, peer){
    const n = peer && peer.name; return (MEM[m.id] || []).filter(t => (t.r === "o" || t.r === "s") && t.n === n).slice(-8).map(t => t.r === "o" ? {role:"user", content:n + ": " + t.c} : {role:"assistant", content:t.c});
  }
  function remember2(m, r, c, ch, ex){ const a = MEM[m.id] || (MEM[m.id] = []); a.push(Object.assign({r, c:String(c).slice(0, 500), ch, d:day()}, ex || {})); if(a.length > onumLim(40,"npc")) a.splice(0, a.length - onumLim(40,"npc")); save(); }

  /* ── intent / sentiment: heuristic now, JSON call for the world fact ── */
  function intent(text){
    let t = {}; try{ t = readTone(text); }catch(e){}
    const low = String(text).toLowerCase();
    const side = /\b(vote (for|aye|yes)|support|back (it|the bill)|i'?ll vote aye)\b/.test(low) ? 1 : /\b(vote (against|no)|oppose|kill (it|the bill)|i'?ll vote no)\b/.test(low) ? -1 : 0;
    return {hostile:!!t.hostile, warm:!!t.warm, promise:!!t.promise || /\b(i will|i'll|my word|i promise|guarantee)\b/.test(low), side, secret:/\b(between us|off the record|don'?t tell|keep this quiet|in confidence)\b/.test(low), threat:/\b(or else|you'?ll regret|ruin you|expose)\b/.test(low)};
  }
  function nudge(m, it, ch){
    if(!m || !m.rel) return "";
    let dw = 0, dt = 0;
    if(it.warm) dw += 2; if(it.hostile) { dw -= 3; dt -= 1; } if(it.threat){ dw -= 4; dt -= 2; } if(it.promise) dt += 1;
    try{ if(dw) ripple(m, dw, null, 0); if(dt) m.rel.trust = clamp(m.rel.trust + dt, 0, 100); }catch(e){}
    try{ const b = G.bill; if(it.side && b && !b.done && m.kind === "member" && m.pos){ /* stance drift, tiny */ m.lean = clamp((m.lean || 0) + (it.warm ? 1 : 0) - (it.hostile ? 1 : 0), -10, 10); } }catch(e){}
    const bits = []; if(dw) bits.push("warmth " + (dw > 0 ? "+" : "") + dw); if(dt) bits.push("trust " + (dt > 0 ? "+" : "") + dt);
    const read = it.threat ? "a threat" : it.hostile ? "hostile" : it.promise ? "a promise" : it.warm ? "warm" : "neutral";
    clLog("Live talk", "You → " + m.name + " (" + ch + "): read as " + read + (bits.length ? " · " + bits.join(", ") : ""), it.hostile || it.threat ? "threat" : it.promise ? "deal" : "procedural", "How your words changed where you stand with them.");
    return read;
  }

  /* ── WORLD MEMORY: facts and how they spread ─────── */
  async function addFact(m, ch, said, reply, it){
    const f = {id:++W.seq, who:G.you ? G.you.name : "You", whoId:"you", with:m.name, withId:m.id, ch, d:day(), tone:it.hostile ? "hostile" : it.warm ? "warm" : "neutral",
      secrecy:it.secret ? .8 : (ch === "dm" || ch === "text" || ch === "mail") ? .45 : ch === "cable" ? .6 : .25, promise:it.promise ? said : "", side:it.side, bill:(G.bill && !G.bill.done) ? G.bill.title : "",
      said:"you told " + m.name + ": \"" + said + "\"", heardBy:[m.id]};
    W.facts.push(f); if(W.facts.length > onumLim(160,"hist")) W.facts.splice(0, W.facts.length - onumLim(160,"hist"));
    contradict(f, m);
    save();
    if(LT.up) try{
      const j = JSON.parse(await chat([{role:"system", content:"Summarise a conversation between politicians into ONE fact line as JSON: {\"fact\":\"<12-25 words, third person, who said/promised what to whom>\",\"promise\":\"<the promise or empty>\",\"tone\":\"warm|neutral|hostile\",\"secrecy\":0..1}"},
        {role:"user", content:(G.you ? G.you.name : "The member") + " said to " + m.name + " (" + ch + "): " + said + "\n" + m.name + " replied: " + reply}], {json:true, max:120, temp:.2}) || "{}");
      if(j.fact) f.said = String(j.fact); if(j.promise) f.promise = String(j.promise); if(j.tone) f.tone = j.tone;
      if(typeof j.secrecy === "number") f.secrecy = clamp(Math.max(f.secrecy * .5, j.secrecy), 0, 1); save();
    }catch(e){}
  }
  function contradict(f, m){
    if(!f.side || !f.bill) return;
    W.promises.push({id:f.id, to:m.id, side:f.side, bill:f.bill, d:f.d}); if(W.promises.length > onumLim(60,"hist")) W.promises.shift();
  }
  function hearsFact(o, f, src, conf){
    if(!o || o.id === f.withId) return false;
    const L = W.heard[o.id] || (W.heard[o.id] = []);
    if(L.some(h => h.f === f.id)) return false;
    L.push({f:f.id, src, conf:Math.round(conf * 100) / 100, d:day()}); if(L.length > onumLim(20,"hist")) L.shift();
    f.heardBy.push(o.id);
    try{ hears(o, "Heard from " + src + ": " + f.said); }catch(e){}
    /* contradiction: they were promised one thing, and hear you promised the opposite to someone else */
    try{ const mine = W.promises.find(p => p.to === o.id && p.bill === f.bill && f.side && p.side === -f.side);
      if(mine && o.rel){ o.rel.trust = clamp(o.rel.trust - 8, 0, 100); ripple(o, -6, null, 0);
        clLog(o.name, "You told me one thing about " + f.bill + " and " + f.with + " another. I heard.", "threat", "A broken promise has been found out: trust falls.");
        try{ feed(o.name + " has heard you promised " + sn(f.with) + " the opposite on " + f.bill + ".", "bad"); }catch(e){} } }catch(e){}
    return true;
  }
  function spreadDay(){
    let ev = 0;
    const all = (() => { try{ return everyone().filter(x => !x.gone); }catch(e){ return []; } })();
    W.facts.filter(f => day() - f.d <= 6).forEach(f => {
      f.heardBy.slice().forEach(hid => {
        const h = npc(hid); if(!h) return;
        const disc = h.traits ? (h.traits.discretion || 50) / 100 : .5;
        const p0 = (1 - f.secrecy) * (1 - disc * .7) * (f.promise ? 1.2 : .8);
        const circle = [];
        (h.allies || []).forEach(id => circle.push([npc(id), .55, "ally"]));
        if(h.rival) circle.push([npc(h.rival), .3, "rival"]);
        all.filter(x => x.party && x.party === h.party && x.kind === "member").slice(0, 40).forEach(x => circle.push([x, .08, "party"]));
        all.filter(x => x.staffOf === h.id || x.boss === h.id).forEach(x => circle.push([x, .5, "staff"]));
        circle.forEach(([o, w, rel]) => { if(o && Math.random() < p0 * w && hearsFact(o, f, (hid === f.withId ? h.name : sn(h.name) + " (via " + sn(f.with) + ")"), clamp(.9 - .25 * (f.heardBy.length > 3) - (hid !== f.withId ? .2 : 0), .2, .95))){ ev++; if(ev <= 4) clLog("Word travels", o.name + " (" + rel + " of " + sn(h.name) + ") has heard: " + f.said, "procedural", "Gossip in the building: what you say reaches people you did not say it to."); } });
      });
      /* press / leaks: wide, rare, secrecy-sensitive */
      if(!f.leaked && f.heardBy.length > 2 && Math.random() < (1 - f.secrecy) * .12){
        f.leaked = day(); let n = 0;
        all.filter(x => x.kind === "member").forEach(o => { if(Math.random() < .35 && hearsFact(o, f, "the papers", .6)) n++; });
        if(n){ ev++; try{ feed("THE WIRE · It is being said in the corridors that " + f.said.replace(/^you /, (G.you ? G.you.name : "a member") + " "), "news"); }catch(e){}
          clLog("The Wire", "Leaked: " + f.said + " — " + n + " members now know.", "threat", "A leak: the press spread it widely."); }
      }
    });
    if(ev) save();
    return ev;
  }
  LT.spreadDay = spreadDay;
  setInterval(() => { try{ if(G && G.day && W.day !== G.day){ const first = !W.day; W.day = G.day; if(!first) spreadDay(); save(); } }catch(e){} }, 1500);

  /* ── the one reply function every channel uses ───── */
  /* ── OFFLINE VOICE: no dependency. Templates + game state + the game's own improviser, recombined so lines do not repeat ── */
  const OFF = {
    hear:["I hear {f}. Is that so?","Word reached me that {f}. I would like to hear it from you.","{src} tells me {f}. You can imagine how that sits.","People talk, you know. Apparently {f}."],
    warm:["That is decent of you.","I will remember you said that.","Kind words are rare in this building."],
    cold:["Mind your tone.","I have been spoken to worse, but not often.","You will want to take that back before supper."],
    prom:["A promise is cheap until the roll is called.","Put it in writing and I will believe half of it.","I will hold you to that, and so will the people who hear of it."],
    ask:["Ask me plainly and I will answer plainly.","That depends on what you are offering.","I have not decided, and I am not deciding in a corridor."],
    tail:["We will see.","Mark the day.","That is all I have for now.","Ask me again tomorrow."],
    textp:["ok.","noted.","not over text.","call me later.","maybe. depends.","heard. talk soon."],
    cab:["RECEIVED STOP","OUR GOVERNMENT TAKES NOTE STOP","A REPLY WILL FOLLOW THROUGH THE USUAL CHANNEL STOP","WE TRUST THE MATTER REMAINS BETWEEN OUR MISSIONS STOP"]
  };
  const pk = a => a[(Math.random() * a.length) | 0];
  function lastSaid(m){ return (MEM[m.id] || []).filter(t => t.r === "a").slice(-10).map(t => t.c); }
  function offAide(text){
    const t = String(text).toLowerCase(), y = G.you || {}, b = G.bill && !G.bill.done ? G.bill : null, A = [];
    const count = () => { try{ let ay = 0, no = 0; (G.members || []).filter(m => !m.gone).forEach(m => { const v = memberVote(m, b); if(v > 0) ay++; else no++; }); return ay + " leaning aye, " + no + " no"; }catch(e){ return "the count is unclear"; } };
    if(/bill|vote|floor|count|whip|pass/.test(t)) A.push(b ? b.title + " is on the floor, roll call day " + b.voteDay + ". My count has " + count() + "." + (b.line ? " In short: " + b.line : "") : "No bill is live right now. A quiet floor is the time to draft one of your own.");
    if(/approv|poll|number|standing|influence|popular/.test(t)) A.push("Home approval " + Math.round(y.approval || 0) + ", standing " + (inHouse() ? "in the House " : "") + Math.round(y.standing || 0) + ", influence " + Math.round(y.influence || 0) + ".");
    if(/money|fund|chest|cash|guilder|donor/.test(t)) A.push("The war chest holds " + (typeof money === "function" ? money(y.funds || 0) : (y.funds || 0)) + ". Aides on payroll: " + (y.staff || 0) + ".");
    if(/schedul|today|diary|calendar|when|next/.test(t)){ const ev = (G.events || []).filter(e => e.day === G.day && !e.done); A.push(ev.length ? "Still today: " + ev.slice(0, 4).map(e => { try{ return hourLabel(e.hour) + " " + e.t; }catch(x){ return e.t; } }).join("; ") + "." : "Nothing else in the diary today."); }
    if(/mail|letter|inbox|cable/.test(t)){ const u = (G.mail || []).filter(m => !m.read && !m.outgoing); A.push(u.length ? u.length + " unread. Top of the pile: " + u.slice(0, 3).map(m => m.from + " (" + m.subject + ")").join("; ") + "." : "The inbox is clear."); }
    if(/rival|seat|threat|enemy/.test(t)){ try{ const r = rivalLive(); A.push(r ? r.name + " wants your seat. Keep the district warm." : "Nobody serious is after your seat yet."); }catch(e){} }
    if(/gossip|heard|rumou?r|know|said|saying|talk|leak/.test(t)){ const f = W.facts.slice(-4).filter(f => f.heardBy.length > 1); A.push(f.length ? "What is going round about you: " + f.map(x => x.said + " (" + (x.heardBy.length - 1) + " have heard)").join("; ") + "." : "Nothing you said is travelling yet, as far as I can tell."); }
    const who = (() => { try{ return everyone().find(m => !m.gone && t.indexOf(sn(m.name).toLowerCase()) >= 0); }catch(e){ return null; } })();
    if(who){ let v = ""; try{ v = b && who.kind === "member" ? (memberVote(who, b) > 0 ? " leans aye on " + b.title : " leans no on " + b.title) : ""; }catch(e){} A.push(who.name + (who.party ? " (" + partyLabel(who.party) + (who.state ? ", " + who.state : "") + ")" : "") + v + "." + (who.rel ? " With you: " + (who.rel.warmth > 15 ? "friendly" : who.rel.warmth < -15 ? "cool" : "neutral") + "." : "") + ((W.heard[who.id] || []).length ? " They have heard " + W.heard[who.id].length + " thing(s) about you." : "")); }
    if(/what is|what's|explain|how do|help|mean/.test(t) && !A.length) A.push("Short version: win votes by talking to members in person, keep promises consistent because word travels, answer your mail, and watch the roll-call day. Ask me about the bill, your numbers, the money, the diary, the mail, a member by name, or what people are saying.");
    if(!A.length) A.push(pk(["I can give you the count, the numbers, the diary, the mail or the gossip. Which?","Ask me about the bill, a member, the money or what is being said about you.","Say the word and I will pull the file."]));
    return A.join(" ");
  }
  function offline(m, ch, text){
    try{ if(typeof knAnswer === "function" && ch !== "cable"){ const ka = knAnswer(m, text); if(ka && ka.text && (m.kind !== "aide" || ka.strong)) return ch === "mail" ? "Dear " + (G.you ? G.you.name : "colleague") + ", " + ka.text + " Yours, " + m.name : ka.text; } }catch(e){}   /* 20261025g */
    if(m.kind === "aide") return offAide(text);
    const said = lastSaid(m), it = intent(text), H = heardOf(m.id).filter(h => !h.used);
    for(let k = 0; k < 6; k++){
      const P = [];
      if(H.length && Math.random() < .7){ const h = H[H.length - 1]; P.push(pk(OFF.hear).replace("{f}", h.fact.said.replace(/^you /, "you ")).replace("{src}", h.src)); }
      if(ch === "text" || ch === "dm"){ let s = ""; try{ s = m.kind === "member" ? dmReply(m, text) : ""; }catch(e){} P.push(s || pk(OFF.textp)); }
      else if(ch === "cable" || m.kind === "envoy"){ P.push(pk(OFF.cab), pk(OFF.cab)); if(m.name && !/^the head/.test(m.name)) P.push(m.name.toUpperCase()); }
      else{
        let base = ""; try{ if(m.kind === "member" || m.kind === "press" || m.kind === "civ") base = improvise(m, text); }catch(e){}
        if(it.hostile || it.threat) P.push(pk(OFF.cold)); else if(it.promise) P.push(pk(OFF.prom)); else if(it.warm) P.push(pk(OFF.warm)); else if(/\?\s*$/.test(text) && !base) P.push(pk(OFF.ask));
        if(base) P.push(base.split(/(?<=[.!?])\s+/).slice(0, 3).join(" "));
        if(!base || Math.random() < .3) P.push(pk(OFF.tail));
        if(ch === "mail") { P.unshift("Dear " + (G.you ? G.you.name : "colleague") + ","); P.push("Yours, " + m.name); }
      }
      const out = P.filter(Boolean).join(" ").replace(/\s+/g, " ").trim();
      if(said.indexOf(out) < 0 || k === 5){ if(H.length && out.indexOf(H[H.length - 1].fact.said.slice(0, 20)) >= 0) H[H.length - 1].used = 1; return out; }
    }
  }
  LT.offline = offline;
  /* reply(): what the person remembers (window.onumRecall) goes into their prompt, and a streamed answer is read
     aloud sentence by sentence through window.onumVoice (face, sittings, meetings, calls) */
  async function reply(o){
    try{ await reprobe(); }catch(e){}
    o = Object.assign({}, o || {}); const ch = o.channel || "face"; let m = null; try{ m = o.npc || npc(o.npcId); }catch(e){}
    try{ if(m && m.kind !== "engine" && typeof window.onumRecall === "function"){ const w = (String(o.text || "").match(/[A-Za-z][A-Za-z'-]{5,}/g) || []).sort((x, y) => y.length - x.length)[0];
        let r = w ? window.onumRecall(m.id, {limit:4, about:w}) : []; if(!r || !r.length) r = window.onumRecall(m.id, {limit:4}) || [];
        if(r.length) o.extra = (o.extra ? o.extra + "\n" : "") + "WHAT YOU REMEMBER (your own memory; it can be hazy or wrong, use it only if it fits, never quote it as a list): " + r.map(x => "- " + String(x.text || "").slice(0, 180) + (x.distorted ? " (you may have this wrong)" : "")).join(" "); } }catch(e){}
    try{ if(m && !/^(engine|envoy)$/.test(m.kind || "") && typeof knPrompt === "function"){ const kp = knPrompt(m, o.text || "", o.from || o.to || null); if(kp) o.extra = (o.extra ? o.extra + "\n" : "") + kp; } }catch(e){}   /* 20261025g */
    let VS = null; try{ if(m && o.onToken && o.voice !== false && /^(face|sitting|meeting|call|phone)$/.test(ch) && window.onumVoice){ VS = window.onumVoice.streamer(m, {}); const ot = o.onToken; o.onToken = t => { try{ VS.push(t); }catch(e){} return ot(t); }; } }catch(e){}
    const r = await reply0(o);
    try{ if(VS && r && r.text){ VS.end(r.text); LT._streamed = {k:m.id, t:String(r.text).trim(), at:Date.now()}; } }catch(e){}
    return r;
  }
  async function reply0(o){
    o = o || {}; const ch = o.channel || "face"; const m = o.npc || npc(o.npcId); const text = String(o.text || "").trim().slice(0, 1500);
    if(!m || !text) throw new Error("onumLiveTalk.reply: need npcId and text");
    /* from: another person is the one speaking. to / stage: a moment you are narrating for them (nobody typed it). Neither is ever the player's own speech. */
    const who = o.from || null, to = o.to || null, stage = o.stage ? String(o.stage).slice(0, 600) : "", peer = who || to, plain = !peer && !stage;
    const it = plain ? intent(text) : {};
    if(plain) remember2(m, "u", text, ch);
    let out = "", live = false, raw = "";
    if(await probe()){
      try{ raw = await chat([{role:"system", content:system(m, ch, o.extra, peer)}].concat(plain ? turnsFor(m, ch) : pairTurns(m, ch, peer)).concat(plain ? [] : [{role:"user", content:who ? who.name + ": " + text : "(" + (stage || text) + ")"}]), {signal:o.signal, model:(m.kind === "engine" && CFG.engineModel) ? CFG.engineModel : undefined, max:o.max || (ch === "mail" || ch === "cable" ? 260 : 150),
          onText:t => { try{ o.onToken && o.onToken(stripEffect(t.replace(/<<[^>]*$/, ""))); }catch(e){} }});
        out = stripEffect(raw).replace(/^["“]|["”]$/g, "").replace(/^\w[\w .'-]{0,30}:\s+/, "").trim(); live = !!out; }catch(e){ if(e && e.name === "AbortError") throw e; LT.lastErr = String((e && e.message) || e).slice(0, 200); LT.errModel = (m.kind === "engine" && CFG.engineModel) ? CFG.engineModel : CFG.model; }
      /* the Engine's own model failed: say so, and let the main model speak for it rather than the stock line */
      if(!out && m.kind === "engine" && CFG.engineModel && CFG.engineModel !== CFG.model){
        try{ raw = await chat([{role:"system", content:system(m, ch, o.extra, peer)}].concat(plain ? turnsFor(m, ch) : pairTurns(m, ch, peer)).concat(plain ? [] : [{role:"user", content:who ? who.name + ": " + text : "(" + (stage || text) + ")"}]), {signal:o.signal, max:o.max || 150}); out = stripEffect(raw).replace(/^["“]|["”]$/g, "").replace(/^\w[\w .'-]{0,30}:\s+/, "").trim(); live = !!out; if(live) LT.fellBack = true; }catch(e){ if(e && e.name === "AbortError") throw e; }
      }
    }
    if(!out && !LT.lastErr && await probe()) LT.lastErr = "the model returned no text at all (a model that thinks before it speaks can spend its whole allowance thinking)", LT.errModel = (m.kind === "engine" && CFG.engineModel) ? CFG.engineModel : CFG.model;
    if(!out && plain){ out = offline(m, ch, text); if(o.onToken) try{ o.onToken(out); }catch(e){} }
    if(!plain){
      if(out){ if(who) remember2(m, "o", text, ch, {n:who.name}); remember2(m, peer ? "s" : "a", out, ch, peer ? {n:peer.name} : null); }
      try{ if(m && m.kind === "engine" && out && window.__engSelf) window.__engSelf(out); }catch(e){}
      return {text:out, live, effect:""};
    }
    remember2(m, "a", out, ch);
    try{ if(live) applyEffect(m, raw); }catch(e){}
    nudge(m, it, ch);
    try{ m.chat = m.chat || []; m.chat.push({role:"user", content:text}, {role:"assistant", content:out}); if(m.chat.length > onumLim(40,"npc")) m.chat.splice(0, m.chat.length - onumLim(40,"npc")); }catch(e){}
    addFact(m, ch, text, out, it);
    try{ if(m && m.kind === "engine" && out && window.__engSelf) window.__engSelf(out); }catch(e){}
    return {text:out, live, effect:(EFFECT_RE.exec(raw) || [])[1] || ""};
  }
  async function* stream(o){
    const q = []; let wake = null, done = false, res, err;
    reply(Object.assign({}, o, {onToken:t => { q.push(t); if(wake){ wake(); wake = null; } }})).then(r => { res = r; done = true; if(wake) wake(); }, e => { err = e; done = true; if(wake) wake(); });
    for(;;){ if(q.length){ yield q.shift(); continue; } if(done) break; await new Promise(r => wake = r); }
    if(err) throw err; if(res) yield res.text;
  }
  window.onumLiveTalk = {
    available:(f, ms) => probe(f, ms),
    /* 20261021: any caller can report how a real request went; one success makes it Live, three failures in a row take it down */
    report(ok){ try{ const was = LT.up; ltSet(!!ok); if(ok){ LT.why = ""; LT.at = Date.now(); } else if(LT.up === false && was !== false) LT.why = "Ollama stopped answering"; if(LT.up !== was) paintPill(); }catch(e){} return LT.up; },
    get why(){ return LT.why || ""; },
    reply, stream,
    get lastError(){ return LT.lastErr ? {error:LT.lastErr, model:LT.errModel, fellBack:!!LT.fellBack} : null; },
    clearError(){ LT.lastErr = null; LT.errModel = null; LT.fellBack = false; },
    memory:id => ({turns:(MEM[id] || []).slice(), heard:heardOf(id).map(h => ({fact:h.fact.said, src:h.src, conf:h.conf, d:h.d})), facts:W.facts.filter(f => f.withId == id || f.heardBy.indexOf(+id) >= 0 || f.heardBy.indexOf(id) >= 0)}),
    get config(){ return Object.assign({}, CFG); },
    setConfig(c){ Object.assign(CFG, c || {}); LT.up = null; LT.fails = 0; LT._pp = null; save(); probe("ui"); paintPill(); },
    get status(){ return {up:LT.up, fails:LT.fails || 0, busy:LT.busy || 0}; },   /* 20261021b */
    chat:(m, o) => chat(m, o),
    world:() => W, spreadDay
  };

  /* ── face to face: replace the improvise-only converse with live streaming ── */
  const converse0 = converse;
  converse = async function(m, text){
    if(!m || chatCtl) return;
    if(!(await probe())) hint();
    try{ if(checkSpeakBlasphemy(text, "you")) return converse0.apply(this, arguments); }catch(e){}
    appendMsg("you", text);
    const bubble = appendMsg("them", "", sn(m.name)); bubble.classList.add("lt-typing"); bubble.textContent = "…";
    el("wireSend").disabled = true; el("wireStop").hidden = false; el("wireState").textContent = sn(m.name) + " is answering…";
    chatCtl = new AbortController();
    try{
      const r = await reply({npc:m, channel:"face", text, signal:chatCtl.signal, onToken:t => { bubble.textContent = t || "…"; try{ el("tkSay").textContent = t; }catch(e){} }});
      bubble.textContent = r.text; bubble.classList.remove("lt-typing"); setSay(r.text, ""); gloss(bubble); gloss(el("tkSay"));
      spend(4, 1);
      try{ const rr = roomHears(text, {exclude:m, weight:1}); const tone = readTone(text); if(rr && rr.heard && (tone.hostile || tone.promise)) reportRoom(rr); }catch(e){}
    }catch(e){ bubble.textContent = "…"; }
    finally{ chatCtl = null; bubble.classList.remove("lt-typing"); el("wireSend").disabled = false; el("wireStop").hidden = true; el("wireState").textContent = ""; if(TALK.open && TALK.m === m) renderTalk(); refreshPanels(); }
  };
  try{ const cl0 = converseLive; converseLive = function(m, text){
    reply({npc:m, channel:"face", text}).then(r => { try{ speakAt(m, r.text); }catch(e){} try{ setSay(r.text, sn(m.name)); }catch(e){} try{ refreshPanels(); }catch(e){} }); }; }catch(e){}
  try{ el("wireStop").addEventListener("click", () => { try{ chatCtl && chatCtl.abort(); }catch(e){} }); }catch(e){}

  /* ── texts (the existing phone Texts panel) ── */
  try{ const ds0 = dmSend; dmSend = function(id, text){
    const m = byId(id); text = String(text || "").trim().slice(0, 400); if(!m || !text) return;
    dmPush(id, "you", text, {}); dmState().typing = id; dmRender();
    reply({npc:m, channel:"text", text}).then(r => { dmState().typing = null; dmPush(id, id, r.text); setTimeout(() => gloss(document.querySelector(".dm, #dmPanel") || document.body), 50); }, () => { dmState().typing = null; dmPush(id, id, dmReply(m, text)); });
  }; }catch(e){}

  /* ── mail and cables: a reply box on every letter; the answer arrives later in game time ── */
  function senderOf(x){
    let m = x.fromId != null ? npc(x.fromId) : null;
    if(!m && (x.kind === "cable" || /^Mission of /.test(x.from || ""))){ const rn = String(x.from || "").replace(/^Mission of /, "").replace(/^Cable — /, "");
      const E = (LT.envoys = LT.envoys || LSG("envoys", {})); try{ const ev = envoyFor(rn); if(ev && !E[rn]) E[rn] = ev.title + " " + ev.name; }catch(e){}
      m = {id:"realm:" + rn, name:E[rn] || ("the head of the " + rn + " mission"), kind:"envoy", role:"head of mission for " + rn + " in the capital, writing on behalf of their government", state:rn, realmName:rn}; }
    return m;
  }
  document.addEventListener("click", e => {
    const b = e.target.closest && e.target.closest("[data-ltmail]"); if(!b) return;
    const box = b.parentElement, inp = box.querySelector("textarea"), t = (inp.value || "").trim(); if(!t) return;
    const x = (G.mail || []).find(y => String(y.id) === b.dataset.ltmail); if(!x) return;
    const m = senderOf(x); if(!m) return;
    const ch = x.kind === "cable" || String(m.id).startsWith("realm:") ? "cable" : "mail";
    try{ pushMail(G.you, "Re: " + x.subject, t, {outgoing:true}); }catch(err){}
    inp.value = ""; box.querySelector(".lt-st").textContent = "Sent. A reply will come later in the day.";
    try{ spend(6, 1); }catch(err){}
    LT.pend.push({m, ch, t, subj:x.subject, at:(G.minute || 0) + 20 + (Math.random() * 70 | 0), d:day(), p:reply({npc:m, channel:ch, text:"[" + (ch === "cable" ? "Your cable" : "Your letter") + " re: " + x.subject + "] " + t, extra:"You are answering a " + ch + " they sent in reply to yours titled '" + x.subject + "'. Your original said: " + String(x.body || "").slice(0, 400)})});
  });
  setInterval(() => { try{ for(let i = LT.pend.length - 1; i >= 0; i--){ const q = LT.pend[i]; if(q.d === G.day && (G.minute || 0) < q.at) continue; LT.pend.splice(i, 1);
      q.p.then(r => { try{ if(q.m.realmName && /^the head/.test(q.m.name)){ const sg = String(r.text).match(/(?:STOP|\n|—|-)\s*([A-Z][\w'’.-]+(?:\s+[A-Z][\w'’.-]+){1,3})\s*\.?\s*$/); if(sg){ LT.envoys[q.m.realmName] = sg[1].replace(/\s*STOP$/i, ""); LSS("envoys", LT.envoys); q.m.name = LT.envoys[q.m.realmName] + ", " + q.m.realmName + " mission"; } } }catch(e){}
        const from = String(q.m.id).startsWith("realm:") ? null : q.m; pushMail(from, (q.ch === "cable" ? "Cable — " : "Re: ") + q.subj, r.text, from ? {kind:"reply"} : {kind:"note"});
        if(!from){ try{ G.mail[0].from = q.m.name; }catch(e){} } note("A reply from " + q.m.name + "."); refreshPanels(); setTimeout(() => document.querySelectorAll(".mailrow__b").forEach(gloss), 80); }); } }catch(e){} }, 2000);
  function decorMail(){
    document.querySelectorAll("[data-clwhatmail]").forEach(b => { const p = b.closest("p") || b.parentElement; if(!p || (p.nextSibling && p.nextSibling.classList && p.nextSibling.classList.contains("lt-mail"))) return;
      const x = (G.mail || []).find(y => String(y.id) === b.dataset.clwhatmail); if(!x || x.outgoing || !senderOf(x)) return;
      const d = document.createElement("div"); d.className = "lt-mail";
      d.innerHTML = '<textarea rows="2" placeholder="' + (x.kind === "cable" ? "Cable your reply…" : "Write a reply…") + '"></textarea><button type="button" class="cl-btn" data-ltmail="' + x.id + '">Send reply</button><span class="lt-st"></span>';
      p.after(d); });
  }

  /* ── sittings: a 'Say something…' box under the moves; the current speaker answers ── */
  function decorSit(){
    const v = document.querySelector("#veil.sitx #card"); if(!v || v.querySelector(".lt-sit")) return;
    const mv = v.querySelector(".sx-moves"); if(!mv) return;
    const d = document.createElement("div"); d.className = "lt-sit lt-row";
    d.innerHTML = '<input type="text" maxlength="300" placeholder="Say something…"><button type="button" class="btn">Say it</button><span class="lt-st"></span>';
    mv.after(d);
    const go = async () => { const inp = d.querySelector("input"), t = inp.value.trim(); if(!t) return; inp.value = "";
      const nm = ((v.querySelector(".sx-p.is-talk .sx-n") || v.querySelector(".sx-p .sx-n") || {}).textContent || "").split(/\s{2,}|\n/)[0].trim();
      const m = (G.members || []).find(x => !x.gone && nm && nm.indexOf(sn(x.name)) >= 0) || hereNow().find(x => x.kind === "member");
      const lines = v.querySelector(".sx-lines") || mv;
      const me = document.createElement("div"); me.className = "sx-l"; me.innerHTML = "<b>You</b> " + esc2(t); lines.appendChild(me);
      clLog("You", t, "procedural", "What you put on the record.");
      if(!m){ d.querySelector(".lt-st").textContent = "Nobody here to answer."; return; }
      const r0 = document.createElement("div"); r0.className = "sx-l lt-typing"; r0.innerHTML = "<b>" + esc2(sn(m.name)) + "</b> <span>…</span>"; lines.appendChild(r0);
      const r = await reply({npc:m, channel:"sitting", text:t, onToken:x => { r0.lastChild.textContent = x; lines.scrollTop = 1e9; }});
      r0.lastChild.textContent = r.text; r0.classList.remove("lt-typing"); gloss(r0); clLog(sn(m.name), r.text, "talk", "Their answer to you, live.");
      if(!r.live) hint(); };
    d.querySelector("button").onclick = go; d.querySelector("input").addEventListener("keydown", e => { e.stopPropagation(); if(e.key === "Enter") go(); });
  }
  try{ new MutationObserver(() => { if(LT._dec) return; LT._dec = true; requestAnimationFrame(() => { LT._dec = false; try{ decorMail(); decorSit(); }catch(e){} }); }).observe(document.body, {childList:true, subtree:true}); }catch(e){}

  /* ── Live voices: scripted lines get rephrased live in the background (cached, rate-limited) ── */
  function voice(text, who){
    if(!CFG.voices || !LT.up || !text || text.length < 18) return text;
    const k = String(text).slice(0, 200), c = LT.cache[k];
    if(c && c.length){ if(Math.random() < .75) return c[(Math.random() * c.length) | 0]; }
    if((!c || c.length < 3) && LT.qv.length < 6 && !LT.qv.some(q => q.k === k)) LT.qv.push({k, who});
    return text;
  }
  LT.voice = voice;
  setInterval(async () => {
    if(LT.vbusy || !LT.qv.length || !CFG.voices || !LT.up || Date.now() - LT.lastV < 4000) return;
    const q = LT.qv.shift(); LT.vbusy = true; LT.lastV = Date.now();
    try{ const s = (await chat([{role:"system", content:"Rephrase one line of dialogue spoken in a fictional 20th-century-style legislature of the NO7 Consular Republic. Keep the meaning, the speaker's register and roughly the length; new wording. Output only the new line."}, {role:"user", content:(q.who ? q.who + ": " : "") + q.k}], {max:90, temp:.9})).trim().replace(/^["“]|["”]$/g, "");
      if(s && s.length > 8 && s.length < 400){ const a = LT.cache[q.k] || (LT.cache[q.k] = []); if(a.indexOf(s) < 0) a.push(s); const ks = Object.keys(LT.cache); if(ks.length > 400) delete LT.cache[ks[0]]; save(); } }catch(e){}
    LT.vbusy = false;
  }, 1200);
  try{ const sl0 = sitLines; sitLines = function(){ const S = sl0.apply(this, arguments); try{ if(CFG.voices && S) Object.keys(S).forEach(k => { const v = S[k]; if(Array.isArray(v)) v.forEach(p => { if(Array.isArray(p) && typeof p[1] === "string") p[1] = voice(p[1], p[0]); }); else if(v && typeof v === "object") Object.keys(v).forEach(j => { if(Array.isArray(v[j])) v[j].forEach(p => { if(Array.isArray(p) && typeof p[1] === "string") p[1] = voice(p[1], p[0]); }); }); }); }catch(e){} return S; }; }catch(e){}
  try{ const fr0 = fresh; fresh = function(build, tries){ return voice(fr0.call(this, build, tries)); }; }catch(e){}
  try{ const sa0 = speakAt; speakAt = function(p, text){ return sa0.call(this, p, (p && LT.up && CFG.voices) ? voice(text, p.name) : text); }; }catch(e){}


  /* ── CHAT: a general chat window (desk computer "Chat" tab, the 💬 HUD button, or Ctrl+Shift+K anywhere) ── */
  const ENV_T = {reach:"Ambassador", horn:"Consul-General", pale:"Colonel-Attaché", marches:"Minister Plenipotentiary", isles:"High Commissioner", rift:"Chargé d'affaires"};
  function envoyFor(rn){
    try{ const r = (G.realms || []).find(x => x.t === rn || x.k === rn || ("the " + x.t) === rn); if(!r) return null;
      if(r.envoy && r.envoy.name) return {name:r.envoy.name, title:r.envoy.title || "Ambassador", realm:r};
      let h = 2166136261; for(const c of "envoy|" + r.k + "|" + (G.country || "")){ h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); }
      let a = h >>> 0; const rnd = () => { a = (a + 0x6D2B79F5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
      let name = ""; try{ name = foreignName(rnd, r.k); }catch(e){} if(!name) return null;
      r.envoy = {name, title:ENV_T[r.k] || "Ambassador", full:(ENV_T[r.k] || "Ambassador") + " " + name + " of " + r.t};
