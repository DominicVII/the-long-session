function ambBlip(f, q, dur, g, type){ const ctx = AMB.ctx; if(!ctx || !AMB.on) return; try{ const src = ctx.createBufferSource(); src.buffer = ambNoise(ctx); src.playbackRate.value = 0.7 + Math.random() * 0.8; const flt = ctx.createBiquadFilter(); flt.type = type || "bandpass"; flt.frequency.value = f * (0.9 + Math.random() * 0.2); flt.Q.value = q; const gn = ctx.createGain(); const t = ctx.currentTime; gn.gain.setValueAtTime(0, t); gn.gain.linearRampToValueAtTime(g * AMB.vol, t + 0.006); gn.gain.exponentialRampToValueAtTime(0.0001, t + dur); src.connect(flt); flt.connect(gn); gn.connect(ctx.destination); src.start(t, Math.random() * 1.5, dur + 0.05); }catch(e){} }
function ambTone(f, dur, g, type){ const ctx = AMB.ctx; if(!ctx || !AMB.on) return; try{ const o = ctx.createOscillator(), gn = ctx.createGain(), t = ctx.currentTime; o.type = type || "sine"; o.frequency.setValueAtTime(f, t); gn.gain.setValueAtTime(0, t); gn.gain.linearRampToValueAtTime(g * AMB.vol, t + 0.01); gn.gain.exponentialRampToValueAtTime(0.0001, t + dur); o.connect(gn); gn.connect(ctx.destination); o.start(t); o.stop(t + dur + 0.05); }catch(e){} }
const AMB_FLOOR = {corridor:"marble", engine:"marble", court:"marble", senate:"carpet", floor:"carpet", caucus:"carpet", committee:"carpet", press:"carpet", cloak:"carpet", office:"wood", visit:"wood", exec:"wood", govoffice:"wood", steps:"stone", district:"stone"};
const AMB_STEP = {marble:[2400, 1.6, 0.075, 0.22], wood:[700, 1.2, 0.09, 0.2], carpet:[300, 0.8, 0.07, 0.12], stone:[1200, 0.9, 0.08, 0.2]};
/* silence costs nothing: behind a menu, in a hidden tab or switched off, the audio thread is put to sleep */
function ambHush(){ try{ if(!AMB.ctx || AMB.hushed) return; AMB.hushed = true; AMB.master.gain.cancelScheduledValues(AMB.ctx.currentTime); AMB.master.gain.value = 0; if(AMB.ctx.state === "running") AMB.ctx.suspend().catch(() => {}); }catch(e){} }
document.addEventListener("visibilitychange", () => { if(document.hidden) ambHush(); });
function ambFrame(now){
  try{
    if(!G || !G.running || !AMB.on){ ambHush(); return; }
    if(!AMB.ctx) return; const ctx = AMB.ctx; AMB.hushed = false; if(ctx.state === "suspended") ctx.resume().catch(() => {});
    const R = ROOMS[G.room]; if(!R) return; const t = now / 1000;
    /* footsteps by distance walked, in the pace of the walk */
    const dx = cam.x - AMB.lastX, dz = cam.z - AMB.lastZ, dd = Math.hypot(dx, dz); AMB.lastX = cam.x; AMB.lastZ = cam.z;
    if(dd < 1.5 && !document.hidden){ AMB.stepD += dd; const stride = 0.72; if(AMB.stepD > stride){ AMB.stepD = 0; const fl = AMB_FLOOR[G.room] || "wood", P = AMB_STEP[fl]; ambBlip(P[0], P[1], P[2], P[3] * (R.open ? 0.8 : 1), "bandpass"); setTimeout(() => ambBlip(P[0] * 0.5, 1.0, P[2] * 1.3, P[3] * 0.5, "lowpass"), 18); } }
    if(now - (AMB._u || 0) < 350) return; AMB._u = now;
    const open = !!R.open, h = (G.minute || 0) / 60, day = h > 6 && h < 20;
    let wx = null; try{ wx = wxToday(); }catch(e){} const rainy = !!(wx && (wx.k === "rain" || wx.k === "storm")), windy = !!(wx && (wx.k === "wind" || wx.k === "storm" || wx.k === "snow"));
    let crowd = 0; try{ crowd = hereNow().filter(m => m && m !== G.you && m.kind !== "civ" || (m && m.kind === "civ")).length; }catch(e){}
    const roomLvl = open ? 0.0 : {corridor:0.05, senate:0.07, floor:0.08, court:0.05}[G.room] || 0.045;
    const set = (L, v, f) => { try{ L.g.gain.setTargetAtTime(v * AMB.vol, ctx.currentTime, 0.6); if(f) L.flt.frequency.setTargetAtTime(f, ctx.currentTime, 0.6); }catch(e){} };
    set(AMB.L.room, roomLvl, G.room === "corridor" || G.room === "court" ? 340 : 220);
    const mur = Math.min(0.16, crowd * (open ? 0.012 : 0.02)) * (G.room === "floor" || G.room === "senate" || G.room === "caucus" ? 1.5 : 1) * (0.8 + 0.2 * Math.sin(t * 0.7)); set(AMB.L.murmur, mur, 480 + 140 * Math.sin(t * 0.31));
    set(AMB.L.wind, open ? (windy ? 0.1 : 0.035) + 0.015 * Math.sin(t * 0.23) : 0, 500 + 400 * (0.5 + 0.5 * Math.sin(t * 0.17)));
    set(AMB.L.traffic, open ? (G.room === "district" ? 0.07 : 0.035) : 0, 140 + 40 * Math.sin(t * 0.11));
    set(AMB.L.rain, rainy ? (open ? 0.09 : 0.03) : 0, 1800);
    AMB.master.gain.setTargetAtTime(AMB.on ? 1 : 0, ctx.currentTime, 0.4);
    /* birds by day outdoors, a clock in the offices, a chime on the hour, a bell at noon */
    if(open && day && !rainy && t > AMB.birdT){ AMB.birdT = t + 2 + Math.random() * 7; const f0 = 2400 + Math.random() * 1800, n = 2 + Math.floor(Math.random() * 3); for(let i = 0; i < n; i++) setTimeout(() => ambTone(f0 * (1 + (i % 2) * 0.18), 0.09, 0.025, "sine"), i * 110); }
    if(!open && ["office", "visit", "exec", "govoffice", "committee", "caucus"].indexOf(G.room) >= 0 && t > AMB.tickT){ AMB.tickT = t + 1; ambBlip(3200, 3, 0.025, 0.035, "bandpass"); }
    const hr = Math.floor(h); if(AMB.hour !== hr){ if(AMB.hour >= 0 && hr >= 7 && hr <= 20 && !(hr % 1)){ const nb = hr === 12 ? 3 : 1; for(let i = 0; i < nb; i++) setTimeout(() => { ambTone(392, 1.6, open ? 0.06 : 0.035, "sine"); ambTone(784, 1.2, open ? 0.025 : 0.014, "sine"); }, i * 1400); } AMB.hour = hr; }
    /* a door: the room changed */
    if(AMB.room !== G.room){ if(AMB.room) { ambBlip(180, 1.2, 0.16, 0.3, "lowpass"); setTimeout(() => ambBlip(900, 2, 0.05, 0.12), 90); } AMB.room = G.room; }
  }catch(e){}
}
["pointerdown", "keydown", "touchstart"].forEach(ev => window.addEventListener(ev, () => { if(AMB.on && !AMB.ctx) ambInit(); }, {passive:true, once:false}));
document.addEventListener("click", ev => { try{ const b = ev.target && ev.target.closest && ev.target.closest("[data-amb]"); if(!b) return; ev.stopPropagation(); AMB.on = b.getAttribute("data-amb") === "1"; try{ localStorage.setItem("onum.amb", AMB.on ? "1" : "0"); }catch(e){} if(AMB.on) ambInit(); else ambHush(); try{ settingsCard(); }catch(e){} }catch(e){} }, true);
/* ══ 20261016s · THE CHAMBERS: the Senate rostrum and the Court's bench, made like places ══ */
function rgPanelTex(cols, rows, base, hi){
  return rgCanvasTex(256, 128, (g, w, h) => {
    g.fillStyle = base; g.fillRect(0, 0, w, h);
    for(let i = 0; i < 260; i++){ g.fillStyle = "rgba(" + (Math.random() < 0.5 ? "255,220,170" : "0,0,0") + "," + (Math.random() * 0.06) + ")"; g.fillRect(Math.random() * w, Math.random() * h, 40 + Math.random() * 80, 1); }
    const pw = w / cols, ph = h / rows, m = 7;
    for(let c = 0; c < cols; c++) for(let r = 0; r < rows; r++){
      const x = c * pw + m, y = r * ph + m, ww = pw - 2 * m, hh = ph - 2 * m;
      g.fillStyle = "rgba(0,0,0,.35)"; g.fillRect(x - 2, y - 2, ww + 4, hh + 4);
      g.fillStyle = hi || "#6a4328"; g.fillRect(x, y, ww, hh);
      g.fillStyle = "rgba(255,225,180,.16)"; g.fillRect(x, y, ww, 2); g.fillRect(x, y, 2, hh);
      g.fillStyle = "rgba(0,0,0,.28)"; g.fillRect(x, y + hh - 2, ww, 2); g.fillRect(x + ww - 2, y, 2, hh);
      g.fillStyle = "rgba(0,0,0,.18)"; g.fillRect(x + 7, y + 7, ww - 14, hh - 14);
      g.fillStyle = "rgba(255,225,180,.1)"; g.fillRect(x + 7, y + hh - 9, ww - 14, 2);
    }
  }, null);
}
function rgSealTex(txt){
  return rgCanvasTex(256, 256, (g, w, h) => {
    const c = w / 2; g.clearRect(0, 0, w, h);
    g.fillStyle = "#2a1d12"; g.beginPath(); g.arc(c, c, 124, 0, 6.3); g.fill();
    g.strokeStyle = "#d4aa55"; g.lineWidth = 6; g.beginPath(); g.arc(c, c, 120, 0, 6.3); g.stroke(); g.lineWidth = 2; g.beginPath(); g.arc(c, c, 108, 0, 6.3); g.stroke();
    /* a laurel wreath, two branches meeting at the top */
    for(let s = -1; s <= 1; s += 2) for(let i = 0; i < 14; i++){ const a = Math.PI / 2 + s * (0.35 + i * 0.2), r = 86, x = c + Math.cos(a) * r, y = c + Math.sin(a) * r; g.save(); g.translate(x, y); g.rotate(a + s * 1.2); g.fillStyle = i % 2 ? "#c9a24a" : "#e2c06a"; g.beginPath(); g.ellipse(0, 0, 13, 5, 0, 0, 6.3); g.fill(); g.restore(); }
    /* a rayed star, and the rim lettering */
    g.fillStyle = "#e2c06a"; g.beginPath(); for(let i = 0; i < 10; i++){ const r = i % 2 ? 22 : 58, a = -Math.PI / 2 + i * Math.PI / 5; g.lineTo(c + Math.cos(a) * r, c + Math.sin(a) * r); } g.closePath(); g.fill();
    g.fillStyle = "#2a1d12"; g.beginPath(); g.arc(c, c, 14, 0, 6.3); g.fill(); g.fillStyle = "#e2c06a"; g.beginPath(); g.arc(c, c, 8, 0, 6.3); g.fill();
    if(txt){ g.fillStyle = "#e9cf8a"; g.textAlign = "center"; g.font = "bold 15px Georgia, serif"; g.fillText(txt, c, c + 104, 150); }
  }, null);
}
function rgFrieze(txt, sub){
  return rgCanvasTex(512, 96, (g, w, h) => {
    g.fillStyle = "#2a1d12"; g.fillRect(0, 0, w, h);
    g.strokeStyle = "#c9a24a"; g.lineWidth = 3; g.strokeRect(6, 6, w - 12, h - 12); g.lineWidth = 1; g.strokeRect(12, 12, w - 24, h - 24);
    g.fillStyle = "#e2c06a"; g.textAlign = "center"; g.font = "bold 34px Georgia, serif"; g.fillText(txt, w / 2, sub ? 50 : 58, w - 60);
    if(sub){ g.font = "italic 17px Georgia, serif"; g.fillStyle = "#c9a24a"; g.fillText(sub, w / 2, 78, w - 60); }
  }, null);
}
function rgSign(tex, x, y, z, ry, w, h){ const m = new THREE.Mesh(UNIT.plane, new THREE.MeshStandardMaterial({map:tex, roughness:0.6, transparent:true})); m.position.set(x, y, z); m.rotation.y = ry || 0; m.scale.set(w, h, 1); roomGroup.add(m); return m; }
function rgBronzeDoorTex(){
  return rgCanvasTex(256, 512, (g, w, h) => {
    const gr = g.createLinearGradient(0, 0, w, 0); gr.addColorStop(0, "#5a4326"); gr.addColorStop(0.5, "#7a5b32"); gr.addColorStop(1, "#4a3620"); g.fillStyle = gr; g.fillRect(0, 0, w, h);
    for(let i = 0; i < 900; i++){ g.fillStyle = "rgba(" + (Math.random() < 0.4 ? "60,110,90" : "20,12,6") + "," + (Math.random() * 0.08) + ")"; g.fillRect(Math.random() * w, Math.random() * h, 1 + Math.random() * 4, 2 + Math.random() * 9); }
    const half = w / 2;
    for(let lf = 0; lf < 2; lf++){ const x0 = lf * half;
      for(let r = 0; r < 4; r++){ const y = 18 + r * 122, hh = r === 3 ? 100 : 108;
        g.fillStyle = "rgba(0,0,0,.45)"; g.fillRect(x0 + 12, y - 2, half - 22, hh + 4);
        g.fillStyle = "#8a6a38"; g.fillRect(x0 + 15, y, half - 28, hh);
        g.fillStyle = "rgba(255,230,160,.35)"; g.fillRect(x0 + 15, y, half - 28, 3); g.fillRect(x0 + 15, y, 3, hh);
        g.fillStyle = "rgba(0,0,0,.35)"; g.fillRect(x0 + 15, y + hh - 3, half - 28, 3); g.fillRect(x0 + half - 16, y, 3, hh);
        g.strokeStyle = "rgba(255,225,150,.45)"; g.lineWidth = 2; g.strokeRect(x0 + 28, y + 13, half - 54, hh - 26);
        const cx = x0 + half / 2, cy = y + hh / 2; g.fillStyle = "#c9a24a"; g.beginPath(); g.arc(cx, cy, 15, 0, 6.3); g.fill(); g.fillStyle = "#6a4a22"; g.beginPath(); g.arc(cx, cy, 8, 0, 6.3); g.fill(); g.fillStyle = "#e2c06a"; for(let k = 0; k < 8; k++){ const a = k * Math.PI / 4; g.beginPath(); g.arc(cx + Math.cos(a) * 21, cy + Math.sin(a) * 21, 2.4, 0, 6.3); g.fill(); } }
    }
    g.fillStyle = "#2b1c0e"; g.fillRect(half - 2, 0, 4, h);
    g.strokeStyle = "#d4aa55"; g.lineWidth = 3; g.beginPath(); g.arc(half - 22, 262, 18, 0, 6.3); g.stroke(); g.beginPath(); g.arc(half + 22, 262, 18, 0, 6.3); g.stroke();
  }, null);
}
function stepsRich(w, d, h, hw){
