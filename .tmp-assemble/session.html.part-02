  const out = {W:W.map(cGeo), roof:cGeo(roof), cor:cGeo(cor), road:cGeo(road), walk:cGeo(walk), tre:cGeo(tre)}; CITY.cache[roomId] = out; return out;
}
function cityAttach(roomId){
  cityClear(); const B = cityBuild(roomId); if(!B) return; const M = cityMats(), g = new THREE.Group(); g.name = "VISTA-CITY";
  const add = (geo, mat, rec) => { if(!geo) return; const m = new THREE.Mesh(geo, mat); m.frustumCulled = true; m.castShadow = false; m.receiveShadow = !!rec; m.matrixAutoUpdate = false; g.add(m); };
  B.W.forEach((geo, i) => add(geo, M.walls[i])); add(B.roof, M.roof); add(B.cor, M.cornice); add(B.road, M.road, true); add(B.walk, M.walk, true); add(B.tre, M.tree);
