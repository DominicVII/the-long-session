      const b = document.createElement("button"); b.type = "button"; b.id = "ndPbBtn"; b.className = ref.className; b.textContent = "Pocketbook"; b.title = "Savings, salary, rent and spending"; b.onclick = () => HM.open(); ref.parentNode.insertBefore(b, ref.nextSibling); }catch(e){} }, 2000);

