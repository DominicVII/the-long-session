{ const _am = appendMsg; appendMsg = function(kind, text, who){
    try{ if(kind === "you" && text){ if(/\b(be quiet|stop talking|keep it down|no voices?|just type|text only|shut up)\b/i.test(text)) NPCV.until = 0; else if(/\b(speak|say it|say that|out loud|aloud|talk to me|use your voice|tell me out loud)\b/i.test(text)) NPCV.until = (G.t || 0) + 120; NPCV.more = 0; } }catch(e){}
