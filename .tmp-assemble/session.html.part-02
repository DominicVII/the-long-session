  segs.forEach(([za, zb]) => { const lo = Math.min(za, zb), hi = Math.max(za, zb), hw = av.w / 2;
    cQuad(road, [[-hw, 0.02, hi], [hw, 0.02, hi], [hw, 0.02, lo], [-hw, 0.02, lo]], [0, 1, 0], [[0, 0], [1, 0], [1, 1], [0, 1]]);
    [-1, 1].forEach(s => { const xa = s * hw, xb = s * (hw + 3.2); cQuad(walk, [[Math.min(xa, xb), 0.06, hi], [Math.max(xa, xb), 0.06, hi], [Math.max(xa, xb), 0.06, lo], [Math.min(xa, xb), 0.06, lo]], [0, 1, 0], [[0, 0], [1, 0], [1, 1], [0, 1]]);
      for(let z = lo + 4; z < hi - 2; z += 9 + r() * 4) cTree(tre, s * (hw + 1.6), z, 1.6 + r() * 0.8, 5.2 + r() * 1.6, Math.floor(r() * 4)); }); });
