      (hereNow() || []).forEach(m => { if(!m || m.sitting || m.kStand || m.leaving || m.exiting) return; if(Math.hypot((m.tx || 0) - (m.x || 0), (m.tz || 0) - (m.z || 0)) > 0.15) return;
