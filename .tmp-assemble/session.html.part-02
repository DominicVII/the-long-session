      const m = RCACHE[id] || (RCACHE[id] = {id, name:ev.title + " " + ev.name, kind:"envoy", role:ev.title + " of " + r.t + " in the capital", state:r.t, realmName:r.t});
      out.push({id, label:m.name + " · " + r.t, grp:"Foreign missions", m}); }); }catch(e){}
    try{ (G.leaders || G.stateLeaders || []).forEach(L => { if(L && L.name) out.push({id:"lead:" + L.name, label:L.name + (L.title ? " · " + L.title : ""), grp:"State leaders", m:{id:"lead:" + L.name, name:L.name, kind:"leader", role:L.title || "state leader", state:L.state}}); }); }catch(e){}
