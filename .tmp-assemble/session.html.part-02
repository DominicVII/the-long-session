  ["b5","bio","The structure of DNA","s",["b4","c3","i_xray"],6,"A double helix: the molecule that copies itself.","What is a gene made of?"],
  ["b6","bio","The genetic code and molecular biology","s",["b5"],6,"Three letters at a time, DNA is read into protein.","How does a code become a body?"],
  ["b7","bio","Germ theory and immunology","s",["b2"],4,"Small living things cause many diseases; bodies learn to resist them.","What makes people sick?"],
  ["b8","bio","Neuroscience","s",["b2","ph4"],6,"Nerve cells signal by electricity and chemistry; circuits are the substrate of behaviour.","How does a lump of tissue think?"],
  ["b9","bio","Genomics","s",["b6","i_seq","cs4"],6,"Whole genomes read, compared and mined.","Can a species be read in one sitting?"],
  ["b10","bio","Ecology and systems biology","s",["b3","m5"],5,"Organisms, populations and ecosystems as webs of cause.","How do living things depend on one another?"],
  ["b11","bio","Synthetic biology and gene editing","s",["b6","b9","c6"],8,"Designing and editing living systems on purpose.","Can life be written as well as read?"],
  ["b12","bio","Neural computation","s",["b8","m8"],7,"Brains as networks that learn from error: a model of how learning could work in matter.","Can the learning in a brain be described as an algorithm?"],
