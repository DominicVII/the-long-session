  ["p6","phil","Political philosophy","s",["p2"],4,"Legitimacy, liberty, justice, the limits of power.","By what right does anyone rule?"],
  ["p7","phil","Philosophy of science","s",["p3","m5"],4,"What a good theory is, how evidence counts, how science can be wrong and still improve.","What separates a theory from a story?"],
  ["p8","phil","Philosophy of language","s",["p1","an3"],5,"Meaning, reference and the games we play with words.","How does a sound mean something?"],
  ["p9","phil","The interpretations of quantum mechanics","s",["ph8","p4","p7"],8,"Many-worlds, pilot waves, collapse, relational states: all agree on every experiment so far, and disagree about what is real.","What is a measurement?"],
  ["p10","phil","Aesthetics","s",["p2"],3,"Why some things are beautiful, and whether that is in the thing or the viewer.","What is beauty?"],
  ["p11","phil","Decision theory and game theory","s",["p2","m5"],5,"How rational agents choose, alone and against each other.","What does it mean to choose well?"],
  ["p12","phil","The ethics of non-human minds","s",["p2","p5","cs7"],8,"What a mind that is not human is owed, and owes: rights, duties, consent, welfare.","If it can suffer, does it count?"],
  ["ps1","mind","Psychology","s",["p3","b2"],4,"Behaviour, memory, emotion and development studied as science.","Why do people do what they do?"],
  ["ps2","mind","Cognitive science","s",["ps1","an3","b8"],6,"Mind as information processing in many substrates.","How is thought organised?"],
  ["ps3","mind","Animal cognition","s",["b3","ps1"],5,"Memory, planning, tool-use, play and grief in other organisms.","What is it like to be a crow?"],
