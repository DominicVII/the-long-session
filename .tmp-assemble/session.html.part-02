        : people(key, [{t:"State representative", where:"District " + (h.dist * 3)}, {t:"Mayor", where:t1}, {t:"County commissioner", where:t2 + " County"}, {t:"County clerk"}, {t:"County party chair"}, {t:"Constituent", civ:true}, {t:"Constituent", civ:true}], h.st);
