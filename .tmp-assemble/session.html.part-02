function cityBuild(roomId){
  if(CITY.cache[roomId]) return CITY.cache[roomId]; const plan = CITY_PLAN[roomId]; if(!plan) return null;
  const M = cityMats(), W = [cAcc(), cAcc(), cAcc(), cAcc()], roof = cAcc(), cor = cAcc(), road = cAcc(), walk = cAcc(), tre = cAcc(), r = vRng(roomId === "steps" ? 4711 : 9173);
  plan.zones.forEach(Z => {
    for(let z = Z.z0; z < Z.z1 - 8;){
      const d = 11 + r() * 8; if(z + d > Z.z1){ break; }
      for(let side = -1; side <= 1; side += 2){
        let x = Z.gap + 3.5 + r() * 2; const lim = Z.x1;
        while(x < lim - 8){ const w = 9 + r() * 12, near = x < 16, h = (near ? 9 + r() * 10 : 14 + r() * 22) * (1 + Math.abs(z - (Z.z0 + Z.z1) / 2) / 260), pal = Math.floor(r() * 4), skip = r() < 0.1;
          if(!skip){ const xa = side > 0 ? x : -x - w; cBlock(W, roof, cor, xa, z, w, d, h, pal); }
