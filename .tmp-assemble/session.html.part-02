  govCardOpen("The towns' petitions", n, "State treasury: " + curF(O.treas[n] || 0) + ". Towns file these on their own; if you do not answer, the acting governor declines them after ten days.", body + '<div id="opSay" class="dream"></div>', null);
  card.querySelectorAll("[data-of]").forEach(b => b.addEventListener("click", () => { const [id, k] = b.getAttribute("data-of").split(":"), p = q.find(x => String(x.id) === id); if(!p) return; spend(15, 2); let r = "";
