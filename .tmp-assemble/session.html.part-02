  /* ── VOICE (20261020): window.onumVoice — every character read aloud with a voice of their own ──
     onumVoice.speak(npcIdOrPerson, text, {interrupt, vol, lang, gender}) queues the line in that speaker's voice;
     onumVoice.stop() silences everything. Voice, pitch and rate are seeded by the speaker's id, so the same person
     always sounds the same; gender (from the person, or opts.gender) and language/accent (envoys and foreign
     characters prefer an installed voice for their country's language) narrow the choice when known.
     Uses the browser's speechSynthesis (free, offline, no Ollama). On/off and volume are the game's own voice
     settings (Settings → Audio → Voice Volume, saved as onum.voice / voiceVol) and a high-contrast row in the
     Live talk panel. Hooked: the game's speak()/hush() (talk, people stopping you, overheard chats, sittings and
     party meetings incl. LOCALPARTY) and streamed LiveTalk replies (spoken sentence by sentence). Phone calls,
     texts and Conversations call onumVoice.speak from their own code. Stops when Talk, the phone or a scene closes. */
  const VO = window.onumVoice = (function(){
    const has = typeof window.speechSynthesis !== "undefined" && typeof window.SpeechSynthesisUtterance !== "undefined";
    let all = [], q = 0, gen = 0; const hashV = s => { let h = 2166136261; s = String(s); for(let i = 0; i < s.length; i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; };
    const load = () => { try{ all = speechSynthesis.getVoices() || []; }catch(e){ all = []; } };
    if(has){ load(); try{ speechSynthesis.addEventListener("voiceschanged", load); }catch(e){} }
    const FEM = /female|woman|zira|susan|samantha|victoria|karen|moira|tessa|fiona|veena|hazel|heather|linda|aria|jenny|libby|sonia|natasha|catherine|elsa|hedda|helena|paulina|ioana|amelie|anna|alice|ellen|joana|luciana|monica|paola|sara|nora|zuzana|yelena|milena|google .*female/i;
    const MAL = /\bmale\b|\bman\b|david|mark|george|james|daniel|alex|fred|thomas|oliver|arthur|ryan|guy|richard|sean|paul|stefan|pablo|diego|jorge|luca|frank|maged|rishi|yuri|xander|google uk english male/i;
    const LANG = {nl:/nieuw|zeeland|vlissingen|oranje|haarlem|dutch|holland|polder/i, de:/german|reich|prussi|bavar/i, fr:/french|franc|gaul|quebec/i, es:/spain|spanish|castil|mexic/i, it:/ital|roman/i, ru:/russ|muscov/i, pl:/pol(and|ish)/i, pt:/portug|brazil/i, sv:/swed/i, ja:/japan|nippon/i, zh:/china|chinese/i, ar:/arab/i};
    const person = id => { if(id && typeof id === "object") return id; try{ return typeof byId === "function" ? byId(isNaN(+id) ? id : +id) : null; }catch(e){ return null; } };
    const genderOf = (p, o) => { const g = String((o && o.gender) || (p && (p.gender || p.sex || p.pronoun)) || "").toLowerCase(); return /^(f|w|she)/.test(g) ? "f" : /^(m|he)/.test(g) ? "m" : null; };
    const langOf = (p, o) => { if(o && o.lang) return String(o.lang).slice(0, 2).toLowerCase(); const s = p ? [p.realmName, p.realm && (p.realm.t || p.realm), p.nation, p.country, p.kind === "envoy" ? p.state : ""].filter(Boolean).join(" ") : "";
      for(const k in LANG) if(s && LANG[k].test(s)) return k; return "en"; };
    function pickFor(key, p, o){ if(!all.length) load(); if(!all.length) return null; const h = hashV(key), g = genderOf(p, o), lg = langOf(p, o);
      let pool = all.filter(v => String(v.lang || "").toLowerCase().indexOf(lg) === 0); if(!pool.length) pool = all.filter(v => /^en/i.test(v.lang)); if(!pool.length) pool = all.slice();
      if(g){ const re = g === "f" ? FEM : MAL, gp = pool.filter(v => re.test(v.name) && !(g === "m" && FEM.test(v.name))); if(gp.length) pool = gp; }
      pool.sort((a, b) => (a.name < b.name ? -1 : 1)); return pool[h % pool.length]; }
    const enabled = () => { try{ return !(typeof G !== "undefined" && G.mute); }catch(e){ return true; } };
    const volume = () => { try{ return typeof G !== "undefined" && G.voiceVol !== undefined ? G.voiceVol : 1; }catch(e){ return 1; } };
    function speak(id, text, o){ o = o || {}; text = String(text || "").replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim(); if(!has || !text || !enabled()) return false;
      const p = person(id), key = String(p && p.id != null ? p.id : id != null ? id : "narrator");
      try{ if(o.interrupt){ speechSynthesis.cancel(); q = 0; gen++; } if(speechSynthesis.paused) speechSynthesis.resume(); if(speechSynthesis.pending && q > 5){ speechSynthesis.cancel(); q = 0; } }catch(e){}
      const u = new SpeechSynthesisUtterance(text.slice(0, 600)), v = pickFor(key, p, o), h = hashV(key + "#"), t = p && p.traits;
      if(v){ u.voice = v; u.lang = v.lang; } else u.lang = langOf(p, o) === "en" ? "en-US" : langOf(p, o);
      const g = genderOf(p, o); u.pitch = Math.min(1.8, Math.max(0.55, (g === "f" ? 1.12 : g === "m" ? 0.9 : 1) + ((h % 9) - 4) * 0.045 + (t && t.temper != null ? (t.temper - 50) / 400 : 0)));
      u.rate = Math.min(1.45, Math.max(0.75, 0.96 + (((h >> 5) % 7) - 3) * 0.035 + (t && t.temper != null ? (t.temper - 50) / 300 : 0) + (p && p.post ? -0.05 : 0)));
      u.volume = Math.min(1, Math.max(0, (o.vol == null ? 1 : o.vol) * volume()));
      u.onend = u.onerror = () => { q = Math.max(0, q - 1); }; q++; VO.last = {id:key, text:u.text, voice:v ? v.name : null, pitch:u.pitch, rate:u.rate};
      try{ speechSynthesis.speak(u); }catch(e){ return false; } return true; }
    function stop(){ gen++; q = 0; try{ if(has) speechSynthesis.cancel(); }catch(e){} }
    /* streamed text: speak each finished sentence once, the remainder at the end */
    function streamer(id, o){ let said = 0, g0 = gen; const cut = (t, fin) => { if(g0 !== gen && !fin) return; const s = String(t || ""); let end = -1; const re = /[.!?…]["”')\]]?(\s|$)/g; let m; re.lastIndex = said;
        while((m = re.exec(s))) end = m.index + m[0].length; if(fin) end = s.length; if(end > said){ const part = s.slice(said, end).trim(); said = end; if(part) speak(id, part, o); } };
      return {push:t => cut(t, false), end:t => cut(t, true), get said(){ return said; }}; }
    return {speak, stop, streamer, voiceFor:(id, o) => { const p = person(id); const v = pickFor(String(p && p.id != null ? p.id : id), p, o); return v ? v.name : null; }, get enabled(){ return enabled(); }};
  })();
  /* the game's own speech goes through onumVoice (all checks of who can hear stay as they were) */
  try{ const sp0 = speak; speak = function(p, text, vol){ try{
      if(typeof G === "undefined" || G.mute || !text) return; if(PROC.on && p && p !== G.you && !(TALK.open && TALK.m === p)) return; if(p && !canHearPerson(p, text)) return;
      const k = p ? p.id : "you", now = Date.now(); if(LT._streamed && LT._streamed.k === k && now - LT._streamed.at < 20000 && String(text).trim() === LT._streamed.t) return;
      const c = G.voiceCarry === undefined ? 1 : G.voiceCarry; VO.speak(p || "you", (typeof voiceClip === "function" ? voiceClip(text, MODEST ? 240 : 380) : text), {vol:(vol === undefined ? 1 : vol) * c}); }catch(e){ try{ return sp0.apply(this, arguments); }catch(e2){} } }; }catch(e){}
  try{ const hu0 = hush; hush = function(){ try{ VO.stop(); }catch(e){} try{ return hu0.apply(this, arguments); }catch(e){} }; }catch(e){}
  /* Talk / scene closing stops the voice */
  try{ if(typeof closeTalk === "function"){ const ct0 = closeTalk; closeTalk = function(){ try{ VO.stop(); }catch(e){} return ct0.apply(this, arguments); }; } }catch(e){}
  try{ if(typeof phoneClose === "function"){ const pc0 = phoneClose; phoneClose = function(){ try{ VO.stop(); }catch(e){} return pc0.apply(this, arguments); }; } }catch(e){}
  /* Phone calls, texts and Conversations threads are voiced by JUPITER's own code calling onumVoice.speak (guarded). */
  /* for tests and other workers: the wrapped game functions as they stand now */
  try{ VO._hooks = {speak:(...a) => speak(...a), dmPush:(...a) => dmPush(...a), dmToggle:(...a) => dmToggle(...a), dmState:() => dmState(), pbRender:() => pbRender(), PB:() => (typeof PB !== "undefined" ? PB : null)}; }catch(e){}
  /* Live talk panel: an opaque, high-contrast Voice row (same settings as Settings → Audio) */
  try{ new MutationObserver(() => { const P = document.getElementById("ltPanel"); if(!P || P.hidden || P.querySelector("#ltVoice")) return;
      const row = document.createElement("div"); row.id = "ltVoice"; row.style.cssText = "display:flex;gap:8px;align-items:center;background:#111;color:#fff;border:2px solid #fff;outline:1px solid #111;border-radius:6px;padding:6px 8px;font:600 13px system-ui";
      row.innerHTML = '<label style="display:flex;gap:6px;align-items:center;color:#fff"><input type="checkbox" id="ltVoiceOn"' + (G.mute ? "" : " checked") + '> Voice (read aloud)</label><input type="range" id="ltVoiceVol" min="0" max="100" value="' + Math.round((G.voiceVol === undefined ? 1 : G.voiceVol) * 100) + '" style="flex:1" aria-label="Voice volume">';
      const b = P.querySelector("b"); if(b) b.after(row); else P.prepend(row);
      row.querySelector("#ltVoiceOn").onchange = e => { G.mute = !e.target.checked; G.muteSet = true; try{ localStorage.setItem(VOICE_KEY, G.mute ? "0" : "1"); }catch(err){} if(G.mute) VO.stop(); };
      row.querySelector("#ltVoiceVol").oninput = e => { G.voiceVol = Math.max(0, Math.min(1, e.target.value / 100)); try{ const s = document.getElementById("voiceVolume"); if(s) s.value = e.target.value; }catch(err){} try{ save(); }catch(err){} }; }).observe(document.body, {childList:true, subtree:true, attributes:true, attributeFilter:["hidden"]}); }catch(e){}
  /* ── no film grain (20261020, Dominic: it looks bad on screen): the #grain overlay, its generated noise texture and
     the fractal-noise paper texture on cards are all switched off by default; nothing else is touched ── */
  try{ const ng = document.createElement("style"); ng.id = "ndNoGrain"; ng.textContent = "#grain,.grain{display:none!important;background-image:none!important;opacity:0!important;animation:none!important}"; document.head.appendChild(ng);
    try{ if(typeof G !== "undefined") G.noGrain = true; }catch(e){}
    const unPaper = () => { document.querySelectorAll("style").forEach(st => { if(st.id === "ndNoGrain" || st.textContent.indexOf("feTurbulence") < 0) return;
        const t = st.textContent.replace(/url\("data:image\/svg\+xml;utf8,<svg[^"]*?feTurbulence[\s\S]*?<\/svg>"\)/g, "none"); if(t !== st.textContent) st.textContent = t; }); };
    unPaper(); new MutationObserver(ms => { if(ms.some(m => [...m.addedNodes].some(n => n.nodeName === "STYLE"))) unPaper(); }).observe(document.head, {childList:true}); }catch(e){}
  console.log("NEPTUNE livetalk ready");
}catch(e){ try{ console.warn("NEPTUNE-LIVETALK block", e); }catch(e2){} }
/* NEPTUNE-LIVETALK END */
/* NEPTUNE-STYLE BEGIN — 20261020q: the barber's chair and the tailor's fitting room, an editor on top of JUPITER's
   ONUM_APPEARANCE / onumSetAppearance (which owns the ledger, the till and how people react). Skin and hair are
   always free to change (a mirror and a comb); a barber can do the hair for his price; beards at the barber,
   clothes at the tailor. The game's own figure (G.you.look) follows. window.onumStyleEditor.open({shop}). */
try{
  const SE = window.onumStyleEditor = {ver:"20261020q"};
  const HAIR_N = ["black", "dark brown", "brown", "light brown", "sandy", "ash", "grey", "charcoal", "auburn"];
  const SUIT_N = ["navy", "black", "claret", "chocolate", "slate blue", "khaki", "midnight", "bottle green", "tobacco", "charcoal", "jet", "mustard"];
  const SHIRT_N = ["white", "pale blue", "sky", "ecru", "sage", "bright white", "grey-blue"];
  const TIES = ["none", "plain", "striped", "bow"], POCKETS = ["none", "white", "silk"];
  const WEAR_T = {suit_tie:"Suit and tie", three_piece:"Three-piece suit", suit_open:"Suit, open collar", shirt_vest:"Shirtsleeves and waistcoat", skirt_suit:"Skirt suit", trouser_suit:"Trouser suit", dress_jacket:"Dress and jacket", blouse_skirt:"Blouse and skirt"};
  const hex = v => "#" + (v >>> 0).toString(16).padStart(6, "0"), uniq = a => a.filter((x, i) => a.indexOf(x) === i);
  const esc3 = s => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({"&":"&"+"amp;", "<":"&"+"lt;", ">":"&"+"gt;", '"':"&"+"quot;"})[c]);
  const menu = id => { try{ const d = (typeof SHP_DEF !== "undefined" ? SHP_DEF : []).find(x => x.id === id); return d ? d.menu : {}; }catch(e){ return {}; } };
  const price = (id, k, fb) => { const m = menu(id)[k]; return m && m.price != null ? m.price : fb; };
  const shopName = id => { try{ const s = (window.ONUM_SHOPS || []).find(x => x.id === id); if(s) return s.name + (s.ownerName ? " \u00b7 " + s.ownerName : ""); }catch(e){} return id === "barber" ? "The barber" : id === "tailor" ? "The tailor" : id === "home" ? "At home" : "The mirror"; };
  let D = null;
  function cur(){ const L = (G.you && G.you.look) || {}, A = window.ONUM_APPEARANCE || {};
    return {skin:L.skin, hairHex:L.hair, style:L.style | 0, beard:L.beard ? (A.beard && A.beard !== "none" ? A.beard : "full") : "none", wear:L.wear, suitHex:L.suit, shirtHex:L.shirt, tie:A.tie || "none", pocket:A.pocket || "none", glasses:!!L.glasses}; }
  /* the wardrobe at home holds what you own: what you wear now, a few staples, and anything bought at the tailor */
  function own(){ const y = G.you, L = y.look || {}, W = y.wardrobe = y.wardrobe || {wear:[], suit:[], shirt:[]}, add = (a, v) => { if(v != null && a.indexOf(v) < 0) a.push(v); };
    add(W.wear, L.wear); add(W.suit, L.suit); add(W.shirt, L.shirt);
    if(!W.seeded){ W.seeded = 1; (L.frame === "fem" ? WEAR_FEM : WEAR_MASC).slice(0, 3).forEach(w => add(W.wear, w)); [SUITS[0], SUITS[1], SUITS[8]].forEach(c => add(W.suit, c)); [SHIRTS[0], SHIRTS[1], SHIRTS[2]].forEach(c => add(W.shirt, c)); }
    return W; }
  function bill(s){ const c = D.base, n = D.v, it = []; if(D.shop === "home") return it;
    if(D.byBarber && (n.style !== c.style)) it.push(["a fresh cut", price("barber", "cut", 9)]);
    if(D.byBarber && (n.hairHex !== c.hairHex)) it.push(["a colour", price("barber", "colour", 15)]);
    if(n.beard !== c.beard) it.push(n.beard === "none" ? ["a hot-towel shave", price("barber", "shave", 6)] : ["a beard shaped", price("barber", "beard", 7)]);
    if(n.wear !== c.wear || n.suitHex !== c.suitHex) it.push(D.bespoke ? ["a bespoke suit", price("tailor", "bespoke", 380)] : ["a suit off the rail", price("tailor", "suit", 140)]);
    if(n.shirtHex !== c.shirtHex) it.push(["a shirt", price("tailor", "shirt", 22)]);
    if(n.tie !== c.tie) it.push(["a tie", price("tailor", "tie", 8)]);
    if(n.pocket !== c.pocket) it.push(["a pocket square", price("tailor", "pocket", 5)]);
    return it; }
  function css(){ if(document.getElementById("ndStyleCss")) return; const st = document.createElement("style"); st.id = "ndStyleCss";
    st.textContent = "#ndStyle{position:fixed;inset:0;z-index:10050;background:rgba(0,0,0,.72);display:flex;align-items:center;justify-content:center}" +
      "#ndStyle .ns-p{background:#14161b;color:#f4f1e8;border:2px solid #c9a24a;border-radius:8px;max-width:760px;width:94vw;max-height:90vh;overflow:auto;padding:14px 18px;font:14px/1.35 system-ui,sans-serif;box-shadow:0 10px 40px #000}" +
      "#ndStyle h2{margin:0 0 2px;font:700 19px Georgia,serif;color:#ffe08a}#ndStyle .ns-sub{color:#cfc8b4;font-size:12px;margin-bottom:8px}" +
      "#ndStyle .ns-g{border-top:1px solid #3a3d46;padding:8px 0}#ndStyle .ns-g b{display:block;color:#ffe08a;font-size:12px;letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px}" +
      "#ndStyle .ns-r{display:flex;flex-wrap:wrap;gap:5px;align-items:center;margin:3px 0}#ndStyle .ns-r i{font-style:normal;color:#e8e2d0;min-width:92px;font-size:13px}" +
      "#ndStyle button.ns-o{background:#23262e;color:#fff;border:1px solid #6b6f7a;border-radius:4px;padding:3px 8px;font:13px system-ui;cursor:pointer}#ndStyle button.ns-o.on{background:#ffe08a;color:#111;border-color:#ffe08a;font-weight:700}" +
      "#ndStyle button.ns-o:disabled{opacity:.45;cursor:not-allowed}#ndStyle .ns-sw{width:24px;height:24px;border-radius:50%;border:2px solid #555;cursor:pointer;padding:0}#ndStyle .ns-sw.on{border-color:#ffe08a;box-shadow:0 0 0 2px #ffe08a}" +
      "#ndStyle .ns-note{color:#cfc8b4;font-size:12px}#ndStyle .ns-bill{background:#0b0c0f;border:1px solid #3a3d46;border-radius:6px;padding:8px;margin-top:6px;font-size:13px}" +
      "#ndStyle .ns-act{display:flex;gap:8px;justify-content:flex-end;margin-top:10px}#ndStyle .ns-act button{background:#ffe08a;color:#111;border:0;border-radius:5px;padding:7px 14px;font:700 14px system-ui;cursor:pointer}#ndStyle .ns-act button.ns-x{background:#2a2d35;color:#fff;border:1px solid #6b6f7a}" +
      "#ndStyle .ns-msg{color:#ff9d8a;font-weight:600;margin-top:6px;min-height:1em}"; document.head.appendChild(st); }
  function row(label, opts, key, on, dis){ return '<div class="ns-r"><i>' + label + '</i>' + opts.map(o => '<button type="button" class="ns-o' + (o.v === on ? " on" : "") + '" data-k="' + key + '" data-v="' + esc3(o.v) + '"' + ((typeof dis === "function" ? dis(o.v) : dis) ? " disabled" : "") + '>' + esc3(o.t) + '</button>').join("") + '</div>'; }
  function sw(label, list, names, key, on, dis){ return '<div class="ns-r"><i>' + label + '</i>' + list.map((h, i) => '<button type="button" class="ns-sw' + (h === on ? " on" : "") + '" style="background:' + hex(h) + '" data-k="' + key + '" data-v="' + h + '" title="' + esc3(names ? names[i] || "" : "") + '" aria-label="' + esc3(names ? names[i] || "colour" : "skin tone " + (i + 1)) + '"' + ((typeof dis === "function" ? dis(h) : dis) ? " disabled" : "") + '></button>').join("") + '</div>'; }
  function paint(){
    const W = document.getElementById("ndStyle"); if(!W || !D) return; const v = D.v, fem = ((G.you && G.you.look) || {}).frame === "fem";
    const atB = D.shop === "barber", atT = D.shop === "tailor", atH = D.shop === "home", it = bill(), OW = atH ? own() : null, tot = it.reduce((a, x) => a + x[1], 0);
    let cash = null; try{ cash = Math.floor(purseOf(G.you).cash); }catch(e){}
    const wear = uniq((fem ? WEAR_FEM : WEAR_MASC).concat(v.wear ? [v.wear] : []));
    W.innerHTML = '<div class="ns-p" role="dialog" aria-label="Your look"><h2>' + (atB ? "The barber's chair" : atT ? "The fitting room" : atH ? "Your wardrobe" : "The mirror") + '</h2><div class="ns-sub">' + esc3(shopName(D.shop)) + (cash != null ? " \u00b7 you have \u0192 " + cash : "") + '</div>' +
      '<div class="ns-g"><b>Skin and hair \u00b7 always yours to change, free</b>' + sw("Skin", SKINS, null, "skin", v.skin) + sw("Hair colour", HAIRS, HAIR_N, "hairHex", v.hairHex) +
        row("Hair style", HAIRSTYLES.map((t, i) => ({v:String(i), t})), "style", String(v.style)) +
        (atB ? '<div class="ns-r"><i></i><label class="ns-note"><input type="checkbox" id="nsByB"' + (D.byBarber ? " checked" : "") + '> Have the barber do the hair (\u0192 ' + price("barber", "cut", 9) + ' a cut, \u0192 ' + price("barber", "colour", 15) + ' a colour)</label></div>' : "") + '</div>' +
      '<div class="ns-g"><b>The barber</b>' + row("Beard", [{v:"none", t:"Clean-shaven"}, {v:"trimmed", t:"Trimmed"}, {v:"full", t:"Full"}], "beard", v.beard, !atB) + (atB ? "" : '<div class="ns-note">A shave or a beard is done at the barber on Main Street.</div>') + '</div>' +
      '<div class="ns-g"><b>The tailor</b>' + row("Cut", (atH ? uniq(wear.concat(OW.wear)) : wear).map(w => ({v:w, t:WEAR_T[w] || w})), "wear", v.wear, atH ? (w => OW.wear.indexOf(w) < 0) : !atT) + sw("Cloth", SUITS, SUIT_N, "suitHex", v.suitHex, atH ? (h => OW.suit.indexOf(h) < 0) : !atT) + sw("Shirt", SHIRTS, SHIRT_N, "shirtHex", v.shirtHex, atH ? (h => OW.shirt.indexOf(h) < 0) : !atT) +
        row("Tie", TIES.map(t => ({v:t, t:t === "none" ? "No tie" : t})), "tie", v.tie, !(atT || atH)) + row("Pocket", POCKETS.map(t => ({v:t, t:t === "none" ? "None" : t})), "pocket", v.pocket, !(atT || atH)) +
        (atT ? '<div class="ns-r"><i></i><label class="ns-note"><input type="checkbox" id="nsBesp"' + (D.bespoke ? " checked" : "") + '> Bespoke (\u0192 ' + price("tailor", "bespoke", 380) + ') rather than off the rail (\u0192 ' + price("tailor", "suit", 140) + ')</label></div>' : (atH ? '<div class="ns-note">These are the suits and shirts you own. New cloth is cut at the tailor on Main Street.</div>' : '<div class="ns-note">Clothes are made at the tailor on Main Street.</div>')) + '</div>' +
      '<div class="ns-bill">' + (it.length ? it.map(x => esc3(x[0]) + " \u2014 \u0192 " + x[1]).join("<br>") + "<br><b>Total \u0192 " + tot + "</b>" : "Nothing to pay." + (D.dirtyFree ? " The mirror is free." : "")) + '</div>' +
      '<div class="ns-msg" id="nsMsg">' + esc3(D.msg || "") + '</div><div class="ns-act"><button type="button" class="ns-x" id="nsX">Leave it</button><button type="button" id="nsGo">' + (tot ? "Pay \u0192 " + tot : "Done") + '</button></div></div>';
    W.querySelectorAll("[data-k]").forEach(b => b.onclick = () => { const k = b.getAttribute("data-k"), raw = b.getAttribute("data-v"); D.v[k] = /Hex$|^skin$/.test(k) ? +raw : k === "style" ? +raw : raw; D.msg = ""; paint(); });
    const bb = W.querySelector("#nsByB"); if(bb) bb.onchange = () => { D.byBarber = bb.checked; paint(); };
    const bs = W.querySelector("#nsBesp"); if(bs) bs.onchange = () => { D.bespoke = bs.checked; paint(); };
    W.querySelector("#nsX").onclick = close; W.querySelector("#nsGo").onclick = commit;
  }
  function refreshFigure(){ try{ const y = G.you; if(y && y.look){ y.look._clothVer = 0; if(y.mesh){ try{ disposePersonMesh(y.mesh); }catch(e){} y.mesh = null; } } }catch(e){} try{ syncPeople(); }catch(e){} }
  function commit(){
    const c = D.base, v = D.v, it = bill(), tot = it.reduce((a, x) => a + x[1], 0), L = G.you.look;
    const patch = {}; if(v.style !== c.style) patch.hair = (HAIRSTYLES[v.style] || "short").toLowerCase(); if(v.hairHex !== c.hairHex) patch.hairColor = HAIR_N[HAIRS.indexOf(v.hairHex)] || "brown";
    if(v.beard !== c.beard) patch.beard = v.beard; if(v.wear !== c.wear) patch.suit = v.wear; if(v.suitHex !== c.suitHex) patch.suitColor = SUIT_N[SUITS.indexOf(v.suitHex)] || "charcoal";
    if(v.shirtHex !== c.shirtHex) patch.shirt = SHIRT_N[SHIRTS.indexOf(v.shirtHex)] || "white"; if(v.tie !== c.tie) patch.tie = v.tie; if(v.pocket !== c.pocket) patch.pocket = v.pocket;
    const any = Object.keys(patch).length || v.skin !== c.skin;
    if(!any){ close(); return; }
    let ok = true;
    if(Object.keys(patch).length){
      if(typeof window.onumSetAppearance === "function"){ try{ ok = window.onumSetAppearance(patch, tot ? {price:tot, shopId:D.shop} : {}) !== false; }catch(e){ ok = false; } }
      else if(tot){ ok = false; }
    }
    if(!ok){ D.msg = tot ? "You cannot cover \u0192 " + tot + " today." : "That did not take."; paint(); return; }
    L.skin = v.skin; L.hair = v.hairHex; L.style = v.style; L.beard = v.beard !== "none"; if(v.wear) L.wear = v.wear; L.suit = v.suitHex; L.shirt = v.shirtHex;
    try{ const W = G.you.wardrobe = G.you.wardrobe || {wear:[], suit:[], shirt:[]}; [["wear", v.wear], ["suit", v.suitHex], ["shirt", v.shirtHex]].forEach(([k, x]) => { if(x != null && (W[k] = W[k] || []).indexOf(x) < 0) W[k].push(x); }); }catch(e){}
    refreshFigure(); try{ save(); }catch(e){}
    try{ setSay(D.shop === "home" ? "You dress for the day." : tot ? "Paid \u0192 " + tot + " at " + shopName(D.shop) + "." : "A new look in the mirror.", ""); }catch(e){}
    close();
  }
  function close(){ const W = document.getElementById("ndStyle"); if(W) W.remove(); D = null; try{ if(SE._spd != null && typeof setSpeed === "function") setSpeed(SE._spd); }catch(e){} SE._spd = null; }
  SE.open = function(o){ try{ if(!G || !G.you || !G.you.look) return false; o = o || {}; css(); close();
      const base = cur(); D = {shop:o.shop === "barber" || o.shop === "tailor" || o.shop === "home" ? o.shop : null, base, v:Object.assign({}, base), byBarber:o.shop === "barber", bespoke:false, msg:""};
      const W = document.createElement("div"); W.id = "ndStyle"; W.addEventListener("click", e => { if(e.target === W) close(); }); W.addEventListener("keydown", e => { if(e.key === "Escape"){ e.stopPropagation(); close(); } });
      document.body.appendChild(W); try{ SE._spd = G.speed; if(typeof setSpeed === "function") setSpeed(0); }catch(e){} paint(); return true; }catch(e){ try{ console.warn("NEPTUNE-STYLE open", e); }catch(e2){} return false; } };
  SE.close = close;
  addEventListener("keydown", e => { try{ if(e.ctrlKey && e.shiftKey && (e.key === "L" || e.key === "l") && !document.getElementById("ndStyle")){ e.preventDefault(); SE.open({}); } }catch(x){} });
  /* the town: BARBER and TAILOR & CUTTER on Main Street open the chair and the fitting room */
  try{ if(typeof SF_KIND !== "undefined"){ SF_KIND["BARBER"] = "barber"; SF_KIND["TAILOR & CUTTER"] = "tailor"; }
    if(typeof SF_SUB !== "undefined"){ SF_SUB.barber = SF_SUB.barber || "A chair, a strop, hot towels"; SF_SUB.tailor = SF_SUB.tailor || "Bolts of cloth, a fitting mirror"; } }catch(e){}
  try{ const _psa = purseShopActs; purseShopActs = function(shop){
      if(shop === "barber") return [{t:"Sit in the barber's chair", c:"hair, colour, a shave", run:() => SE.open({shop:"barber"})}, {t:"Use the mirror (free)", c:"skin and hair", run:() => SE.open({})}];
      if(shop === "tailor") return [{t:"Step into the fitting room", c:"suits, shirts, ties", run:() => SE.open({shop:"tailor"})}].concat(_psa.call(this, "market"));
      return _psa.apply(this, arguments); }; }catch(e){}
  /* 20261020w: the town's BARBER storefront is off Main Street, so its door gets its own place in the district too */
  try{ if(typeof sfApply === "function"){ const sfB = sfApply; sfApply = function(){ const r = sfB.apply(this, arguments); try{ const D = (typeof PROPS !== "undefined" && PROPS.district) || null, P = window.ONUM_TOWN_POIS || [];
        if(D && !D.some(x => x && (x.id === "sf:barber" || /barber/i.test(x.label || "")))){ const bs = P.filter(p => p && /^BARBER/i.test(p.name || "")).sort((a, b) => Math.hypot(a.pos.x, a.pos.z) - Math.hypot(b.pos.x, b.pos.z))[0];
          if(bs){ const st = (bs.stand && bs.stand[0]) || bs.door || bs.pos; D.push({id:"sf:barber", label:"The Barber", sub:"A chair, a strop, hot towels", x:st.x, z:st.z, r:2.2, acts:() => purseShopActs("barber")}); if(G.room === "district"){ try{ gateAttach("district"); }catch(e){} } } } }catch(e){} return r; }; } }catch(e){}
  console.log("NEPTUNE style ready");
}catch(e){ try{ console.warn("NEPTUNE-STYLE block", e); }catch(e2){} }
/* NEPTUNE-STYLE END */
/* NEPTUNE-OFFLINE BEGIN — 20261020q: an offline reply generator for when Ollama is missing. window.onumOfflineReply({npc, text,
   channel, from, to, stage}) returns a line built from the person's traits, party, mood and memory, never repeating their
   last ten lines. Player-facing talk uses LiveTalk's own offline voice; person-to-person and narrated moments get their
   own. The Engine is left to say less rather than read a template: it gets "". onumLiveTalk.reply({..., offline:true})
   uses it when no model answers. */
try{
  const OG = {
    agree:["{P} has it right, for once.", "I am with {P} on that.", "{P}, you will get no argument from me.", "That is what I have been saying all week, {P}."],
    doubt:["I am not sure that holds, {P}.", "Say that again on the floor, {P}, and see who nods.", "Maybe. I would want the numbers first.", "That is one way to read it, {P}."],
    oppose:["No, {P}. Not on my vote.", "{P}, that is the kind of thing that loses a seat.", "With respect, {P}, you are wrong.", "I would sooner adjourn than agree to that."],
    hot:["Do not lecture me, {P}.", "You have a nerve, {P}.", "Keep your voice down, {P}, people are listening."],
    warm:["Good to see you, {P}.", "{P}. How is the family?", "You look well, {P}. Coffee later?"],
    stage:["Hm.", "Well. There it is.", "I have seen this before.", "Not today.", "Let us see how the room takes it.", "Somebody should write that down."],
    topic:{money:"Who pays for it, is what I want to know.", votes:"Count the room before you count on it.", faith:"The Rite will have a view, and they will share it.", family:"Leave the families out of it.", war:"Nobody in this building has to carry a rifle.", machines:"The Engine will have read it before we have.", weather:"Rain on the steps again.", gossip:"I only repeat what I hear twice.", work:"The office keeps me late enough as it is.", looks:"Nice suit. New?"}
  };
