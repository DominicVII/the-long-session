      if(!reason) reason = one(["the cost is known and the delay costs more", "the people who asked for this have waited long enough", "the alternative is to do nothing, and nothing has a price too", "it is a fair settlement, and fair is rarer than perfect"]);
      const mine2 = M.bill ? ((typeof preferredVote === "function" ? preferredVote(M.bill) : 0) || 0) : 0; const own = !mine2 || !(A.pos && M.bill && M.bill.pos) ? true : (alignment({pos:A.pos}, M.bill) >= 0) === (mine2 > 0);
