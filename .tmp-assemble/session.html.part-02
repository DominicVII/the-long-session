    const lean = motion && motion.votes && npc.id in motion.votes ? motion.votes[npc.id] : null;
    const feud = (fam.feuds || [])[0] || null;
    return {SS, reg, rec:Array.isArray(rec) ? rec : [rec], fam, motionName, lean, warmth, feud, lex:Array.isArray(lex) ? lex : Object.keys(lex || {}),
      mood: warmth > 20 ? "warm toward the person in front of you" : warmth < -20 ? "cold toward the person in front of you" : "guarded"};
  }
  function wantOf(st, v, r){
    if(st.motionName) return st.lean === "no" || st.lean === "nay" ? "to see " + st.motionName + " fail" : st.lean ? "your vote on " + st.motionName : "to know where you stand on " + st.motionName;
    if(st.feud) return "you to keep clear of " + (st.feud.name || "the other house");
    return pick(["a straight answer", "a favor they won't name yet", "to be left out of it", "news from the floor"], r);
  }
  function buildPrompt(npc, ctx, v, st, want){
    const lines = [
      "You are " + (npc.name || "a local") + ", a person in the NO7 Consular Republic. Speak as yourself, in the first person, out loud.",
      "Manner: " + (v.terse ? "few words" : "you run on a little") + ", " + (v.blunt ? "blunt" : "you dodge and hedge") + ", " + (v.folksy ? "plain-spoken" : "formal") + ".",
      st.reg ? "You come from " + st.reg.name + "; it shows in how you talk." : "",
      v.traits.length ? "Your nature: " + v.traits.slice(0, 4).join(", ") + "." : "",
