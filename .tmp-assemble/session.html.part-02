requestAnimationFrame(drsTick);
window.onumGraphics = () => ({gpu:(window.ONUM_GPU || {}).name || "", modest:MODEST, full:FULLPOWER, gfx:G.gfx, pixelRatio:_lastPR, base:Math.min(devicePixelRatio || 1, GFX_PR), frameMs:+DRS.ema.toFixed(1), vsyncMs:+DRS.vs.toFixed(1), drawHz:_wantHz, changes:DRS.n, shadows:renderer.shadowMap.enabled ? (renderer.shadowMap.type === THREE.PCFShadowMap ? "filtered" : "basic") + " " + (sun && sun.shadow ? sun.shadow.mapSize.x : 0) : "off"});
function frameBody(now, draw){
  G._frameT0 = now;
  G._frameSpent = 0;
  const _prof = (typeof ONUM_PROF !== "undefined") ? ONUM_PROF : null;
  if(_prof) _prof.begin();
  const dt = Math.min(0.05, (now-last)/1000); last = now;
  FRAME_ID++;
  if(G.moving && G._moveAt && (performance.now() - G._moveAt) > 4200){
    G.moving = false; G._moveAt = 0;
    try{ const fd = el("fade"); if(fd) fd.style.opacity = "0"; }catch(e){}
  }
  const cardUp = !!(typeof veil !== "undefined" && veil && !veil.hidden);
  const talkUp = !!(typeof TALK !== "undefined" && TALK && TALK.open);
  if(PAD_SEEN || picksDirty) pollPad();
  else if(picksDirty) refreshPicks();
  if(cardUp){
    try{
      const live = !!(G.you && G.members && G.members.length);
      const boot = document.body.classList.contains("boot-menu");
      /* 20261011a: any live control counts (ballot/office picks are .conc__btn), and a
         card with none gets 2.5s grace (Sleeping... / Loading...) before the unstick. */
      const acts = card && card.querySelector("button:not([disabled]), input:not([disabled]), select, textarea");
      if(acts || !live || boot){ G._cardDeadSince = 0; }
      else if(!G._cardDeadSince){ G._cardDeadSince = now; }
      if(live && !boot && !acts && (now - (G._cardDeadSince || now)) > 2500){
        G._cardDeadSince = 0;
        softUnstickVeil();
      } else {
        /* MAX OPT 20260921: card-up — feed/scroll every other; 3D every 6th. */
        _cardFrames = (_cardFrames || 0) + 1;
        if((_cardFrames & 1) === 0){
          try{ feedTick(dt); }catch(e){}
          try{ tickScrollFrame(); }catch(e){}
        }
        if(!GL_LOST && _cardFrames % 6 === 0){
          try{ ndPad(); renderer.render(scene, camera); }catch(e){}
        }
        if(_prof){ _prof.mark("render"); _prof.end(false); }
        return;
      }
    }catch(e){ if(_prof) _prof.end(false); return; }
  }
  if(talkUp){
    const KB = G.bind || DEFAULT_BIND;
    const held = !!(keys[KB.forward] || keys[KB.back] || keys[KB.stepL] || keys[KB.stepR]);
    /* 20261110by: a key still held from the walk-up is not a walk-away */
    if(TALK.heldMove){ if(!held) TALK.heldMove = false; }
    else if(held){
      try{ closeTalk(); }catch(e){}
    }
  }
  if(!G.over && !G.pendingNight){
    G.running = true;
    if(!(G.speed > 0)) G.speed = 1;
  }
  try{ tick(dt); }
  catch(err){
    if(window.console && frameFails < 2) console.warn("tick error", err);
  }
  try{ renderRead(); }catch(e){}
  try{ G._frameSpent = Math.max(G._frameSpent || 0, framePaidMs()); }catch(e){}
  if(_prof) _prof.mark("tick");
  if(draw){
    if(G._crowdPauseUntil && performance.now() < G._crowdPauseUntil){
      try{ animateCrowd(dt); }catch(e){}
    } else {
      animateCrowd(dt);
    }
  }
  if(_prof){
    _prof.mark("crowd");
    if(_prof._syncAcc){ _prof.add("sync", _prof._syncAcc); _prof._syncAcc = 0; }
  }
  /* Once a second, check one body's world matrix for a value that
     cannot be right — a zero scale or a NaN, which is what a stale or
     broken matrix looks like — and rebuild that person if it is wrong.
     One person per second costs nothing and a wrong body never lasts. */
  /* Twice a second, look over everybody in the room for a body that
     cannot be right: a matrix with a NaN in it, or one that has been
     flattened to nothing. Reading sixteen numbers off each person costs
     nothing next to drawing them, and it means a body that goes wrong —
     for any reason, including one I have not thought of — is put right
     within half a second instead of staying wrong. */
  const playerMoving = Math.hypot(cam.vx || 0, cam.vz || 0) > 0.12;
  /* While moving: dip PR slightly (restore on stop). Safe — setPR no-ops if near same. */
  if(playerMoving && false){   /* 20261021b: off: setPixelRatio on every start/stop of a step reallocated the framebuffer */
