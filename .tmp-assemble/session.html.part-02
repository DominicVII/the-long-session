    const L = [];
    if(day % 7 === dd) L.push({kind:"district", hour:19});
    if(day % 28 === sd) L.push({kind:"state", hour:18});
    return L;
  };
  LP.next = kind => { for(let d = G.day; d < G.day + 30; d++) if(LP.due(d).some(x => x.kind === kind)) return d; return null; };
  const title = k => k === "state" ? "State party meeting" : "District party meeting";
  LP.placeToday = kind => { try{ const x = LP.due().find(d => d.kind === kind); if(x) return evFor(G.day, x).place; }catch(e){} return LP.place(kind).name; };
  const evFor = (day, x) => { const L = store(), k = day + ":" + x.kind;
