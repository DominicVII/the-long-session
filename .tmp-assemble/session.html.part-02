    BK = {}; SOLIDS = lvl < 2 ? [] : null; POIS = null; LAMPS = []; CHUNK = "x"; KMAP = CELL_KMAP; ST = STYLES[style] || STYLES.brick_row; signI = (i * 7 + j * 3) & 15;
