/* the pause menu, driven by a controller */
function padPauseMenu(gp){
  const b = gp.buttons || [];
  const down = i => !!(b[i] && b[i].pressed);
  const edge = i => { const d = down(i), was = !!PADHELD[i]; PADHELD[i] = d; return d && !was; };
  const ov = el("pauseOverlay"); if(!ov) return;
  const ctrls = [...ov.querySelectorAll("button, input, select")].filter(c => !c.disabled && c.offsetParent !== null);
  if(!ctrls.length) return;
  let i = ctrls.indexOf(document.activeElement);
  const ay = (gp.axes || [])[1] || 0, axx = (gp.axes || [])[0] || 0;
  const stickUp = ay < -0.6, stickDn = ay > 0.6, stickL = axx < -0.6, stickR = axx > 0.6;
  const sEdge = (k, v) => { const was = !!PADHELD[k]; PADHELD[k] = v; return v && !was; };
  const up = edge(12) | sEdge("_pzU", stickUp), dn = edge(13) | sEdge("_pzD", stickDn);
  const lf = edge(14) | sEdge("_pzL", stickL), rt = edge(15) | sEdge("_pzR", stickR);
  const a = edge(0), back = edge(1), start = edge(9);
  const lb = edge(4), rb = edge(5);
  if(lb || rb){
    const tabs = [...ov.querySelectorAll("[data-tab]")];
    const cur = tabs.findIndex(t => t.classList.contains("is-active") || t.getAttribute("aria-selected") === "true");
    const nx = tabs[((cur < 0 ? 0 : cur) + (rb ? 1 : -1) + tabs.length) % tabs.length];
    if(nx){ nx.click(); try{ nx.focus(); }catch(e){} }
    return;
  }
  if(back || start){ PADHELD[9] = true; closeSettings(); return; }
  const focus = j => { const c = ctrls[(j + ctrls.length) % ctrls.length]; try{ c.focus({preventScroll:false}); c.scrollIntoView({block:"nearest"}); }catch(e){} };
  if(i < 0 && (up || dn || lf || rt || a)){ focus(0); return; }
  if(up) focus(i - 1);
  else if(dn) focus(i + 1);
  else if(lf || rt){
    const c = ctrls[i];
    if(c && c.type === "range"){
      try{ rt ? c.stepUp(Math.max(1, Math.round((c.max - c.min) / 20 / (+c.step || 1)))) : c.stepDown(Math.max(1, Math.round((c.max - c.min) / 20 / (+c.step || 1)))); }catch(e){}
