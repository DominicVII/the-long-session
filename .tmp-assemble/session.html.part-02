    const brass = matCol(0xb08b45, .35, .8), oak = matCol(0x5a3b24, .6), dark = matCol(0x1d1f26, .6), steel = matCol(0x3a4048, .5, .5), cream = matCol(0xf3ecd9, .7), leather = matCol(0x2f3a4a, .7);
    const lamp = (c, i) => { const k = c + "|" + i; let m = ENG_LAMPM.get(k); if(!m){ m = new THREE.MeshStandardMaterial({color:c, emissive:c, emissiveIntensity:i, roughness:0.35}); m._shared = true; ENG_LAMPM.set(k, m); } return m; };
