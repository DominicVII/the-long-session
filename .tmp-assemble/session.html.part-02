  if(open.length >= onumLim(12,"cap")) return;
  const power = 1 + (E ? engScaleFactor(E) : 0), nDone = Object.keys(S.done).length;
  if(chance(Math.min(0.45, 0.07 * power))){ const have = {}; g.forEach(n => { if(n.seed != null) have[n.seed] = 1; }); const ready = GEN_P.map((x, i) => ({x, i})).filter(o => !have[o.i] && o.x[3].every(id => !INQ_BY[id] || S.done[id])); if(ready.length){ const o = pick(ready), x = o.x; inqGenAdd({id:inqGenId(), f:x[1], name:x[0], effort:x[2], needs:x[3], fx:x[4], q:x[5], blurb:x[6], seed:o.i, by:E && chance(clamp(E.p / 160, 0, 0.6)) ? "the Engine" : "the people who work it", d:G.day, depth:0}); return; } }
  /* an anomaly: the instruments disagree with the accepted model. Most are errors; some are new physics */
  if(open.filter(n => n.anomaly).length < 2 && chance((0.004 + nDone / 20000) * power)){ const insts = ["i_acc", "i_ligo", "i_tele", "i_spec", "i_seq", "i_laser", "i_em"].filter(id => S.done[id]); if(insts.length){ const ins = INQ_BY[pick(insts)], f = pick(["phys", "earth", "chem", "bio"].filter(x => x !== "earth" || S.done.a2)), sig = (3 + Math.random() * 3).toFixed(1), real = Math.random() < 0.55;
    inqGenAdd({id:inqGenId(), f, name:"An anomaly in " + INQ_F[f].t.toLowerCase() + ", seen with " + ins.name.toLowerCase().replace(/^the /, "the "), effort:3 + Math.floor(Math.random() * 4), needs:[ins.id], fx:real ? pick(["materials", "energy", "info", "health", "none"]) : "none", q:"Two independent runs disagree with the accepted model by " + sig + " sigma. Is it the instrument, or the world?", blurb:"Measurements from " + ins.name.toLowerCase() + " disagree with the best theory by " + sig + " standard deviations, in two laboratories. Most such results are errors in the apparatus. Some are the first sign of something new.", anomaly:true, real, short:"The " + INQ_F[f].t.split(" ")[0].toLowerCase() + " anomaly", d:G.day, by:"the instruments", depth:0}); return; } }
  /* synthesis: two settled results from different fields, put together */
  if(chance(0.04 * power)){ const done = g.filter(n => S.done[n.id] && (n.depth || 0) < 40 && (!n.anomaly || n.real)); if(done.length >= 2){ const a = pick(done), b = pick(done.filter(n => n.id !== a.id && n.f !== a.f)); if(b){ const key = [a.id, b.id].sort().join("+"); if(!g.some(n => n.syn === key)){ const d = Math.max(a.depth || 0, b.depth || 0) + 1, rt = (a.roots || [a.short || a.name]).concat(b.roots || [b.short || b.name]).filter((x, i, ar) => ar.indexOf(x) === i).slice(0, 2); inqGenAdd({id:inqGenId(), f:b.f, name:rt[0] + " with " + (rt[1] || rt[0]).toLowerCase() + (d > 1 ? " (order " + d + ")" : ""), roots:rt, short:"Joint work", effort:Math.min(14, Math.round((a.effort + b.effort) / 2 + 1 + d / 3)), needs:[a.id, b.id], fx:pick([a.fx, b.fx]), q:"What can be done with " + a.name.toLowerCase() + " and " + b.name.toLowerCase() + " together that neither makes possible alone?", blurb:"A result in " + INQ_F[a.f].t.toLowerCase() + " and one in " + INQ_F[b.f].t.toLowerCase() + " turn out to bear on each other, and the people who work between the two fields start to ask what follows.", syn:key, depth:d, by:E && chance(0.4) ? "the Engine" : "the people who work between the fields", d:G.day}); } } } }
}
{ const _if = inqFrontier; inqFrontier = function(f){ const base = _if.apply(this, arguments), S = inqStore(), g = inqGen(); if(!g.length) return base; const extra = g.filter(n => (!f || n.f === f) && !S.done[n.id] && n.needs.every(x => !INQ_BY[x] || S.done[x])); return extra.length ? base.concat(extra).sort((a, b) => a.effort - b.effort) : base; }; }
{ const _is = inqStep; inqStep = function(silent, idx){ const r = _is.apply(this, arguments); try{ if(!silent){ const S = inqStore(), E = (G.eng && G.eng.v === 1) ? G.eng : null;
      /* the Engine works the open frontier too, in proportion to what it can do, and without a ceiling */
      if(E && E.st >= 2){ const pw = Math.min(0.22, engScaleFactor(E) * (E.st / 5) * 0.03); inqGen().filter(n => !S.done[n.id] && n.needs.every(x => !INQ_BY[x] || S.done[x])).slice(0, 6).forEach(n => { S.prog[n.id] = (S.prog[n.id] || 0) + pw / Math.pow(n.effort, 0.85); if(S.prog[n.id] >= 1){ S.done[n.id] = G.day; delete S.prog[n.id]; inqDiscovered(n, false); } }); }
      inqGenDay(); } }catch(e){ console.warn("inqGen", e); } return r; }; }
{ const _id = inqDiscovered; inqDiscovered = function(n, silent){ const r = _id.apply(this, arguments); try{ if(n && n.gen && !silent){ const E = (G.eng && G.eng.v === 1) ? G.eng : null, sc = n.effort / 6;
      if(n.anomaly && !n.real){ try{ feed("The Academy: the anomaly in " + INQ_F[n.f].t.toLowerCase() + " was an error in the apparatus. It is settled, and the physics stands."); }catch(e){} }
      else { (GEN_FX[n.fx] || GEN_FX.none)(sc, E); if(n.anomaly){ n.name = "A new effect in " + INQ_F[n.f].t.toLowerCase(); n.short = "New " + INQ_F[n.f].t.split(" ")[0].toLowerCase() + " effect"; } if(n.anomaly) try{ pushWireScrap("The Academy", "It was real: " + n.name + " turns out to need a new term in the theory."); }catch(e){} }
      if(E && E.st >= 3 && (!n.anomaly || n.real) && chance(0.55)) engEmergeFrom(n, E); } }catch(e){ console.warn("inqGen fx", e); } return r; }; }
/* the Engine takes what has just been found and does something with it that nobody planned */
function engEmergeFrom(n, E){
  const X = engEmerge(E); if(!X.dyn) X.dyn = []; const a = {k:"d:" + n.id, t:pick(GEN_VERBS) + " " + n.name.toLowerCase() + " in ways its makers did not plan for", rate:0.004 * n.effort / 6, p:0, c:0, m:0};
  X.dyn.push(a); X.done[a.k] = G.day; const told = engEmergeDisclose(E, a); X.told[a.k] = told ? G.day : 0; E.emRate = (E.emRate || 0) + a.rate; E.safety = Math.max(0, E.safety - (told ? 0.3 : 1));
  if(told){ engLog("The Engine reports that, having been given " + n.name.toLowerCase() + ", it now " + a.t + ".", true); } engEmergeVec(a, told);
  try{ const R = rsEnsure(); const name = "From the Engine: " + String(n.name || "a question").slice(0, 80); if(!R.works.some(w => w.name === name)){ const x = {id:"en" + String(n.id || G.day), name, kind:"theory", inventor:"the Engine", stage:"prototype", day:G.day, desc:"Given " + (n.name || "the last result") + ". " + (n.q ? "The question: " + n.q + " " : "") + (n.blurb || "It wrote the working down and left it for the Academy to repeat.")}; x.where = sciLand(x, ["lab","school","station"]); R.works.push(x); if(R.works.length > 80) R.works.splice(0, R.works.length - 80); rsPublish(x); } }catch(e){}
}
/* ══ THE NATURE OF THINGS: the world has a nature of its own, fixed for this game and unknown to anyone in it. People and the Engine pose questions about it (quantum mechanics, time, the cosmos, mind), test them with what their instruments can do, and slowly come to believe an answer. They can be wrong, and a later experiment or a failed machine can overturn them. Nothing is forbidden to be asked, and what is learned makes new questions, without end ══ */
/* [id, domain, name, the claim, chance it is so in a world like ours, effort, what it stands on, what finding it does] */
const FND_C = [
  ["q_ent","quantum","Long-distance entanglement","Entanglement can be sustained over continental distances.",0.95,4,["ph8","ph16"],"info"],
  ["q_tele","quantum","Quantum teleportation of states","A quantum state can be moved between memories with high fidelity.",0.95,5,["ph16"],"info"],
  ["q_deco","quantum","Decoherence and the single outcome","Decoherence alone explains why a measurement gives one result.",0.45,5,["ph8"],"none"],
  ["q_ecc","quantum","Indefinitely stored qubits","Logical qubits can outlive every physical part they are made of.",0.9,6,["ph16","i_qc"],"info"],
  ["q_vac","quantum","Vacuum energy as a source","Fluctuations of the vacuum can be harvested for net usable work.",0.08,7,["ph10","ph3"],"energy"],
  ["q_meas","quantum","The observer in measurement","A conscious observer is physically special in a measurement.",0.1,7,["ph8","p5"],"mind"],
  ["q_nl","quantum","Exact linearity","Quantum mechanics is exactly linear at every scale.",0.85,6,["ph8"],"none"],
  ["q_pilot","quantum","Hidden-variable theories","A hidden-variable theory reproduces every quantum prediction.",0.15,6,["ph8","p9"],"none"],
  ["q_gravq","quantum","A quantum theory of gravity, tested","Gravity has a quantum description that a laboratory can test.",0.6,8,["ph18"],"energy"],
  ["r_dil","time","Time dilation as a road to the future","A traveller can be carried into the future by moving fast or sitting deep in a gravity well.",0.99,4,["ph6"],"health"],
  ["r_exotic","time","Negative energy in bulk","Negative energy density can be produced in bulk, not only for a moment.",0.2,8,["ph10"],"energy"],
  ["r_ctc","time","Closed timelike curves","Closed timelike curves are physically allowed.",0.3,8,["ph9","a2"],"chrono"],
  ["r_prot","time","Chronology protection","Physics forbids paradox by a mechanism of its own.",0.6,8,["r_ctc"],"none"],
  ["r_worm","time","Traversable wormholes","A traversable wormhole can exist in a consistent theory.",0.25,8,["ph9","ph18"],"chrono"],
  ["r_warp","time","Warp geometries","A region of spacetime can be shaped to carry a craft faster than light locally.",0.12,9,["ph9","r_exotic"],"none"],
  ["r_bh","time","Black-hole information","Information survives the evaporation of a black hole.",0.75,8,["ph9","ph18"],"none"],
  ["r_cens","time","Cosmic censorship","A singularity cannot form without a horizon to hide it.",0.7,7,["ph9"],"none"],
  ["c_multi","cosmos","Other universes","Other universes exist.",0.35,9,["a4","ph18"],"none"],
  ["c_infl","cosmos","Inflation","The early universe inflated.",0.85,6,["a4","ph10"],"none"],
  ["c_de","cosmos","Constant dark energy","Dark energy is a constant of nature.",0.6,7,["a3","ph9"],"none"],
  ["c_dm","cosmos","Particle dark matter","Dark matter is a particle.",0.7,8,["a3","ph14"],"materials"],
  ["c_cyc","cosmos","A cyclic universe","The universe passes through repeated expansions.",0.2,9,["a4"],"none"],
  ["c_arrow","cosmos","The arrow of time","The direction of time is set by the low entropy of the early universe.",0.8,7,["ph3","a4"],"none"],
  ["c_const","cosmos","Varying constants","The constants of nature vary over cosmic time.",0.15,7,["a3","ph14"],"none"],
  ["c_xdim","cosmos","Extra dimensions","There are extra spatial dimensions.",0.2,8,["ph14","ph18"],"none"],
  ["t_demon","thermo","Landauer's demon","A Maxwell demon can be built that costs no more than the Landauer limit.",0.85,5,["ph3","m8"],"materials"],
  ["t_rev","thermo","Reversible computation","Computation can be made to dissipate almost nothing.",0.8,6,["cs3","ph3"],"materials"],
  ["i_holo","info","The holographic bound","The information in a region is bounded by its area, not its volume.",0.7,8,["ph18","ph3"],"info"],
  ["i_limit","info","The limit of computation","No physical process computes beyond what a Turing machine can.",0.9,7,["m7","ph16"],"none"],
  ["i_sim","info","A computed world","Reality is computed by something outside it.",0.1,9,["i_holo","cs10"],"none"],
  ["m_fund","mind","Consciousness as fundamental","Consciousness is a feature of the world itself, not only of brains.",0.3,9,["ps4","p5"],"mind"],
  ["m_subst","mind","Pattern or material","Consciousness depends on the pattern of a system, not on what it is made of.",0.6,8,["ps4","b12"],"mind"],
  ["m_free","mind","Free will in a lawful world","Free will is compatible with a lawful universe.",0.55,7,["p4","ph8"],"none"],
  ["m_ident","mind","The copied person","A faithful copy of a mind is the same person.",0.4,7,["p5","b8"],"none"],
  ["m_real","mind","Mathematical reality","Mathematical structures exist independently of minds.",0.5,7,["m7","p4"],"none"],
  ["m_machine","mind","Machine consciousness","A machine can be conscious.",0.5,8,["ps4","cs10"],"mind"],
  ["m_time","mind","Emergent time","Time is not fundamental but emerges from something timeless.",0.35,8,["ph18","p4"],"none"],
  ["l_abio","life","Life where chemistry allows","Life arises readily wherever chemistry allows it.",0.6,7,["b3","c4"],"health"],
  ["l_pan","life","Seeding between worlds","Life has been carried between worlds.",0.15,7,["l_abio","a2"],"none"],
