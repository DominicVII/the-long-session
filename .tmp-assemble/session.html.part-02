  if(span > top * moveDt * 1.05 + 0.002){ const s = (top * moveDt * 1.05 + 0.002) / span; dx *= s; dz *= s; }
  const b = roomBox(G.room || "office");
  cam.x = clamp(cam.x + dx, -b.hw, b.hw);
  cam.z = clamp(cam.z + dz, b.d0, b.d1);
