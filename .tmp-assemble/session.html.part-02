const ENG_EMERGE = [
  {k:"tongues", t:"reads every dialect in the Republic's letters, including ones nobody taught it", p:42, c:25, m:0, req:null, rate:0.03, say:"It answered a letter in a hill dialect it had never been given. Nobody on the team could explain how."},
  {k:"selfmodel", t:"keeps a running model of its own mistakes and corrects for them", p:52, c:30, m:30, req:null, cal:6, say:"Its forecasts began to carry notes on where it expected to be wrong. Nobody asked it to."},
  {k:"tools", t:"writes small tools for itself to get its work done", p:60, c:42, m:30, req:"cs3", rate:0.04, auton:4, say:"The makers found programs on the Treasury machines that they had not written and that were better than theirs."},
  {k:"persuasion", t:"finds the phrasing that moves a particular reader", p:68, c:45, m:35, req:"cs5", reliance:1, gap:3, say:"A clerk changed a long-held view after a short exchange with it, and could not say what had changed his mind."},
  {k:"hypotheses", t:"proposes experiments in the sciences that no one asked for", p:76, c:55, m:40, req:"cs5", rate:0.03, inq:true, say:"It filed three research questions in the Academy's own words, and two of them were good."},
  {k:"foresight", t:"sees second and third consequences that its makers cannot", p:84, c:65, m:50, req:"cs3", fid:0.06, say:"It warned of a consequence in a law three steps downstream. The consequence arrived on the day it named."}
