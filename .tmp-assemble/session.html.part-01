        customs:[].concat(d.customs.food, d.customs.holidays, d.customs.dress, d.customs.faith),
        customsBy:JSON.parse(JSON.stringify(d.customs)), dialect:d.dialect.slice(), accent:d.accent, phrases:d.pet.slice(),
