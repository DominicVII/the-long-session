      const blinds = (id === "office" || id === "visit");
      const opts = {cols: stony ? 3 : 2, rows: 2, blinds, stone: stony, style: R.style};
      const doorsHere = DOORS[id] || [];
      if(id === "office" || id === "visit"){
        /* Sash on the back wall — left wall is shelves, flags, and the door wall is front. */
        const zz = d - 0.012;
        propWindow("z", -w * 0.24, 2.12, zz, 1.12, 1.22, 0, opts);
        propWindow("z",  w * 0.24, 2.12, zz, 1.12, 1.22, 0, opts);
      } else if((side === "left" || side === "right") && !doorsHere.some(dr => dr.side === side)){
        const x = side === "left" ? -hw + 0.012 : hw - 0.012;
        const ry = side === "left" ? Math.PI/2 : -Math.PI/2;
        const n = 2;
        for(let i=0;i<n;i++){
          const wz = d * (0.32 + i * 0.36);
          if(doorsHere.some(dr => dr.side===side && Math.abs(dr.at*d - wz) < 1.8)) continue;
          propWindow("x", x, 2.22, wz, 1.00, 1.12, ry, opts);
        }
      } else if((side === "back" || side === "high") && !doorsHere.some(dr => dr.side === "back")){
        const zz = d - 0.012;
        for(let i=0;i<2;i++){
          const wx = -w * 0.22 + i * (w * 0.44);
          propWindow("z", wx, 2.05, zz, 1.20, 1.22, 0, opts);
        }
      }
    }catch(e){ if(window.console) console.warn("windows", e); }
  }
