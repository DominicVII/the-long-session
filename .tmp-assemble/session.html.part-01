        if(!(SSN && SSN.floorId === "you")){ ssnDecor("you", -2); log("You spoke out of turn on " + body + ".", false); } else { ssnDecor("you", 0.5); G.you.standing = clamp(G.you.standing + 0.3, 0, 100); } if(t.length > 120) log("On " + body + ", " + nm + " said: " + t.slice(0, 160), true); }
    }
