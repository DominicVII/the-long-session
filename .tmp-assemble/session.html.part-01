  prairie:{name:"The Prairie", palette:["#7a6a3a","#d6b65a","#a8c0d8"], accent:"plain and level",
    pet:["Fair enough.", "Rain'll come.", "We'll see.", "You plant in hope and you harvest in arithmetic.", "My granddad saw the dust year; we don't gamble the topsoil.", "Down by the crick that'd be called a handshake deal.", "Let's sleep on it and talk after supper.", "A section of land teaches patience.", "Fair's fair, and that ain't."], customs:{food:["corn bread","kolache","sweet tea"], holidays:["Harvest Sunday","the County Fair"], dress:["denim","a feed cap"], faith:["the polling church","the parish"]},
    dialect:["crick","warsh","supper","borrow","rig","section"], values:{order:0.3, faith:0.6, trade:0.2, family:0.8},
    memory:{grudges:["pacific"], alliances:["midlands","highplains"], hardship:"the dust year"}},
  delta:{name:"The Delta", palette:["#3d5a4a","#8f7a4a","#c9b48a"], accent:"slow, soft, dropped g's",
    pet:["Bless it.", "Fixin' to.", "Lord willing.", "Bless your heart, cher.", "Throw in a little lagniappe and we'll see.", "The river gives and the river takes; the Capitol only takes.", "Since the catch never came back, we count every promise twice.", "Y'all come down to the Blessing of the Fleet and say that.", "Mama always said, feed 'em first, argue after."], customs:{food:["gumbo","catfish","red beans"], holidays:["Blessing of the Fleet","Mardi Day"], dress:["linen","a Sunday hat"], faith:["the Kerk","the river chapels"]},
    dialect:["fixin","y'all","cher","makin' groceries","banquette","lagniappe"], values:{order:0.2, faith:0.8, trade:0.1, family:0.9},
    memory:{grudges:["yankee"], alliances:["midlands"], hardship:"the catch that never came back"}},
  highplains:{name:"The High Plains", palette:["#8a5a3a","#c8a070","#e0d2b0"], accent:"dry, few words",
    pet:["Reckon so.", "Long way off.", "Hold steady.", "Whiskey's for drinking, water's for fighting over.", "Don't bet the outfit on it.", "Out yonder, a man's word is the fence line.", "I'll ride with you as far as the next draw.", "Tank's half empty and so's that argument.", "Founders didn't ride all that way for this."], customs:{food:["brisket","chili","fry bread"], holidays:["Roundup Day","Founders' Ride"], dress:["boots and hat","a duster"], faith:["the open-sky meeting"]},
    dialect:["reckon","fixin","draw","tank","yonder","outfit"], values:{order:-0.3, faith:0.5, trade:0.3, family:0.6},
    memory:{grudges:["dutch"], alliances:["prairie","mountain"], hardship:"the water war"}},
  mountain:{name:"The Mountain West", palette:["#4a5a6a","#9aa8b0","#d0d8d8"], accent:"terse, sharp t's",
    pet:["Your call.", "Weather's turning.", "Leave it be.", "Stake your claim and stand on it.", "We got high-centered on promises in the silver bust.", "Nobody up the creek asked for help.", "You'll want a better coat than that.", "Trail's long; pack light.", "First snow tells you who's ready."], customs:{food:["elk stew","trout","sourdough"], holidays:["Claim Day","First Snow"], dress:["flannel","oilskin"], faith:["none spoken of","the green chapels"]},
    dialect:["sidehill","high-centered","pop","creek","shine","claim"], values:{order:-0.7, faith:-0.1, trade:0.4, family:0.3},
    memory:{grudges:["pacific"], alliances:["highplains"], hardship:"the silver bust"}},
  pacific:{name:"The Pacific Coast", palette:["#2f5a6a","#8ab0b8","#e8e0d0"], accent:"bright, rising ends",
    pet:["Hella.", "No worries.", "It is what it is.", "That's hella spendy for what it does.", "Wait for the sunbreak, then decide.", "After the quake winter, we build for the long shake.", "Tide comes in whether you vote or not.", "Rad idea, wrong decade.", "Let's circle back once everyone's had their say."], customs:{food:["salmon","sourdough","fish tacos"], holidays:["Tide Festival","Circle Night"], dress:["fleece","rain shells"], faith:["the circle","none spoken of"]},
