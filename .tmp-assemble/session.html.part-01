    else if(act === "motion"){ const mk = String(e.target || e.text || "adjourn"), def = SSN && (SSN.def.motions[mk]); if(!def) return {ok:false, why:"not in order here"};
      let seconded = !def.needsSecond; if(def.needsSecond){ const al = ls.filter(m => a && m.party === a.party); seconded = al.length > 0 && chance(isYou ? Math.min(0.95, 0.5 + al.length / 30) : 0.7); }
      if(!seconded){ log(nm + " moved to " + mk.replace(/_/g, " ") + ". No second.", false); return {ok:true, seconded:false}; }
      let yes = 0, tot = 0; ls.forEach(m => { tot++; const w = (m.rel && m.rel.warmth) || 0; const same = a && m.party === a.party; if(same ? chance(0.85) : chance(0.2 + w / 300)) yes++; });
      const passed = def.threshold === 0 ? true : tot > 0 && yes / tot >= def.threshold; if(SSN) SSN.motion = {kind:mk, by:e.actorId, seconded:true, yes, of:tot, passed};
      log(nm + " moved to " + mk.replace(/_/g, " ") + (passed ? "; the motion carried." : "; it failed."), mk === "cloture" || mk === "no_confidence" || mk === "contempt" || mk === "subpoena");
      if(passed && SSN){ if(mk === "cloture" || mk === "previous_question" || mk === "closure"){ SSN.fili = null; const vi = SSN.def.stages.findIndex(s => s.id === "vote"); if(vi > SSN.si){ SSN.si = vi - 1; ssnNext(); } }
        else if(mk === "adjourn"){ SSN.si = SSN.def.stages.length - 2; ssnNext(); } else if(mk === "table"){ SSN.billId = null; } }
