      '<p style="margin:6px 0">“' + pcEsc(realmVoice(r.k, {}, "what do you want") + " " + (rl < -20 ? "I will be plain, Mr President: the way things are going I cannot promise you a quiet frontier." : rl > 25 ? "We have not forgotten who helped us." : "We would like to be taken seriously.")) + '”</p>' +
      '<p class="muted" style="font-size:12px">' + pcEsc(st.state.name) + ' (' + pcEsc(viewWords(st.state.pos)) + '): “' + pcEsc((st.state.pos.def || 0) > 20 ? "Give them nothing they have not earned." : (st.state.pos.def || 0) < -20 ? "A little generosity now is cheaper than a garrison later." : "Hear them out; decide after.") + '”</p>' +
      '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" data-pf="' + i + ':aid">Offer grain and credit</button><button type="button" class="btn btn--ghost" data-pf="' + i + ':trade">Offer a trade schedule</button><button type="button" class="btn btn--ghost" data-pf="' + i + ':warn">Warn them off ' + pcEsc(D.red) + '</button><button type="button" class="btn btn--ghost" data-pf="' + i + ':none">Say nothing yet</button></div><div class="dream" id="pf_' + i + '"></div></div>'; }).join("");
  govCardOpen("Calls with foreign capitals", "Three capitals on the line", "Each head of government, in their own words, and what your Secretary of State makes of them.", body, "aid");
  card.querySelectorAll("[data-pf]").forEach(b => b.addEventListener("click", () => { const [i, k] = b.getAttribute("data-pf").split(":"), r = picks[+i]; if(b.parentNode.getAttribute("data-done")) return; b.parentNode.setAttribute("data-done", "1"); spend(20, 3);
    let t;
    if(k === "aid"){ rel[r.k] = clamp((rel[r.k] || 0) + 12, -100, 100); y.approval = clamp(y.approval - 2, 0, 100); t = r.t + " will remember. So will the farm counties."; }
    else if(k === "trade"){ rel[r.k] = clamp((rel[r.k] || 0) + 6, -100, 100); const S = (G.states || []).find(x => x.n === y.state); if(S) S.ind = clamp(S.ind + 1, 0, 100); t = "A modest schedule is drawn up for the ministers to sign."; }
    else if(k === "warn"){ rel[r.k] = clamp((rel[r.k] || 0) - 5, -100, 100); y.standing = clamp(y.standing + 1, 0, 100); if(G.world && G.world.foe === r.k) G.world.heat = clamp((G.world.heat || 0) + 3, 0, 100); t = "The line is delivered. " + r.t + " does not reply, which is a reply."; }
    else t = "You say you will think about it. They say they will wait.";
    reactEmit("foreign", {k:r.k, verb:k}); el("pf_" + i).textContent = t; feed("The President spoke with " + r.t + ". " + t); b.parentNode.querySelectorAll("button").forEach(z => z.disabled = true); }));
  return null;
}
function presBrief(){
  const y = G.you, st = presStaff(), rel = G.realmRel || {}, foe = WORLD_POWERS.find(p => G.world && p.k === G.world.foe), hot = (G.states || []).slice().sort((a, c) => (c.unrest || 0) - (a.unrest || 0))[0], done = {};
  const say = {
    treasury:"The Union's books are " + ((G.money && G.money.index < 0.5) ? "thin; I would not announce anything new." : "sound for now.") + (hot ? " " + hot.n + " is the worst for unrest, at " + Math.round(hot.unrest) + ", and it will ask for money." : "") + " " + ((st.treasury.pos.econ || 0) > 20 ? "I would answer it with a tax holiday, not a grant." : (st.treasury.pos.econ || 0) < -20 ? "I would answer it with a public works grant, and I would take the heat." : "I would wait for the auditors."),
    state:foe ? cap(foe.t) + " is the rival this term; the temperature is " + Math.round((G.world && G.world.heat) || 0) + ". " + ((st.state.pos.def || 0) > 20 ? "I would meet strength with strength, and say so quietly." : "I would open a channel before anyone opens a fire.") : "No rival is hot this week, which is the time to mend fences.",
    war:"The fleet and the garrisons are at their usual state, which is to say short. " + ((st.war.pos.def || 0) > 20 ? "I want the second base on the strait, and I will argue for it." : (st.war.pos.def || 0) < -20 ? "I would rather not ask for more ships; I would rather ask what they are for." : "I will tell you what they cost when you decide what you want from them."),
    justice:"Two states have a mandate in the courts. " + ((st.justice.pos.lib || 0) > 20 ? "I will defend the people's liberties against the executive, and that includes yours." : (st.justice.pos.lib || 0) < -20 ? "I would not let a technicality slow the Union's work." : "I will give you the law as it is, and you can decide how hard to lean on it.")
  };
  const acts = {
    treasury:[{t:"Answer unrest with a grant", d:"Unrest down, treasury thinner", run(){ if(hot) hot.unrest = clamp(hot.unrest - 3, 0, 100); y.approval = clamp(y.approval + 1, 0, 100); return "A grant is drawn up for " + (hot ? hot.n : "the worst-hit state") + "."; }}, {t:"Wait for the auditors", d:"Nothing spent", run(){ return "You wait."; }}],
    state:[{t:"Open a quiet channel", d:"Realm warmer", run(){ if(foe){ G.realmRel = G.realmRel || {}; G.realmRel[foe.k] = clamp((G.realmRel[foe.k] || 0) + 4, -100, 100); } return "A channel is opened through the Secretary's office."; }}, {t:"Meet strength with strength", d:"Standing up, tension up", run(){ y.standing = clamp(y.standing + 1, 0, 100); if(G.world) G.world.heat = clamp((G.world.heat || 0) + 3, 0, 100); return "The Secretary is told to say it plainly."; }}],
    war:[{t:"Ask what the fleet is for", d:"A fairer review", run(){ y.influence = clamp(y.influence + 1, 0, 100); return "The Secretary of War is told to write you the answer."; }}, {t:"Fund the strait base", d:"Hawk, costly", run(){ y.approval = clamp(y.approval - 1, 0, 100); if(G.world) G.world.heat = clamp((G.world.heat || 0) + 2, 0, 100); return "The base is put on the budget."; }}],
    justice:[{t:"Defend the mandate", d:"Standing", run(){ y.standing = clamp(y.standing + 1, 0, 100); return "The Attorney General files in your name."; }}, {t:"Hold off for now", d:"Nothing", run(){ return "The filing waits."; }}]
  };
  const body = Object.keys(PRES_ROLES).map(k => '<div style="margin:10px 0;padding:8px 10px;border-left:3px solid var(--line-soft)">' + officialHTML(st[k]) + '<p style="margin:6px 0">“' + pcEsc(say[k]) + '”</p><div class="card__actions" style="flex-wrap:wrap">' + acts[k].map((x, j) => '<button type="button" class="btn btn--ghost" data-pb2="' + k + ':' + j + '" title="' + pcEsc(x.d) + '">' + pcEsc(x.t) + '</button>').join("") + '<button type="button" class="btn btn--ghost" data-pw="' + k + '">Ask why</button></div><div class="dream" id="pb2_' + k + '"></div></div>').join("");
  govCardOpen("The morning briefing", "The cabinet, in their own words", "Four secretaries, four different lines.", body, null);
  card.querySelectorAll("[data-pw]").forEach(b => b.addEventListener("click", () => { const k = b.getAttribute("data-pw"), o = st[k], cr = creedOf(o.creed), og = originOf(o.origin); el("pb2_" + k).textContent = "“I am " + o.bg + ", of " + cr.t + ", and my people carry the grievance " + og.grievance + ". Weigh me knowing it, Mr President.”"; }));
  card.querySelectorAll("[data-pb2]").forEach(b => b.addEventListener("click", () => { const [k, j] = b.getAttribute("data-pb2").split(":"); if(done[k]) return; done[k] = 1; spend(10, 1); el("pb2_" + k).textContent = acts[k][+j].run(); }));
  return null;
}
function confirmCard(){
  const y = G.you, nom = mkOfficial("nom:" + G.day + ":" + y.name, {n:pick(STATES)}, "Nominee to the federal bench");
  const fit = alignment(y, {pos:nom.pos}), asked = {};
  let grill = 0;
  const ax = AXES.slice().sort((a, c) => Math.abs(nom.pos[c.k]) - Math.abs(nom.pos[a.k]))[0], v = nom.pos[ax.k] || 0, X = DK_AXIS[ax.k], side = v > 0 ? X.hi : X.lo;
  const witness = (G.members || []).filter(m => m && !m.gone && m.kind === "member" && m.pos).sort(() => Math.random() - 0.5).slice(0, 2);
  const wFor = witness[0], wAg = witness[1];
  const q = {
    record:{t:"Ask about their record", say:"“I was " + nom.bg + " before this. On " + ax.n.toLowerCase() + " I have always leaned " + side.w.toLowerCase() + ": I would read the law as a state that " + side.does + ". I will not apologise for it and I will not pretend I have no view.”", d:fit > 0 ? 2 : -1},
    precedent:{t:"Ask how they treat precedent", say:"“Precedent binds me until I can show why it should not. I am " + (nom.temper > 60 ? "stubborn, and I will say so." : "careful, and I will say so.") + " I have overruled my own earlier opinion twice, and I wrote both reasons down.”", d:nom.temper > 60 ? -1 : 2},
    backers:{t:"Ask who recommended them", say:"“" + (wFor ? wFor.name + " (" + wFor.party + ") put my name forward, and I have been honest with " + (wAg ? wAg.name : "the minority") + " that I will not be anyone's vote.”" : "“Nobody you would know, Senator.”"), d:1}
  };
  const body = '<div style="margin:8px 0">' + officialHTML(nom, "By your own answers, they read the law " + (fit > 8 ? "much as you do" : fit < -8 ? "the other way from you" : "somewhere near you") + ".") + '</div>' +
    '<p class="muted" style="font-size:13px"><b>Who backs them:</b> ' + pcEsc(wFor ? wFor.name + " (" + wFor.party + "), who has known them for years" : "a short list of former colleagues") + '. <b>Who objects:</b> ' + pcEsc(wAg ? wAg.name + " (" + wAg.party + "), who thinks they will legislate from the bench" : "nobody in particular") + '. ' + pcEsc(senateColleague()) + ' wants a quick vote.</p>' +
    '<div class="card__actions" style="flex-wrap:wrap">' + Object.keys(q).map(k => '<button type="button" class="btn btn--ghost" data-cq="' + k + '">' + pcEsc(q[k].t) + '</button>').join("") + '</div><div id="cqSay" class="dream" style="white-space:pre-line"></div>' +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" id="cfYes">Confirm</button><button type="button" class="btn btn--ghost" id="cfNo">Reject</button><button type="button" class="btn btn--ghost" id="cfFight">Make a fight of it</button></div>';
  govCardOpen("Senate Judiciary · confirmation", nom.name, "Nominated to the bench. They will answer anything you ask them, in their own way.", body, null);
  card.querySelectorAll("[data-cq]").forEach(b => b.addEventListener("click", () => { const k = b.getAttribute("data-cq"); if(asked[k]) return; asked[k] = 1; spend(10, 1); grill += q[k].d; el("cqSay").textContent += (el("cqSay").textContent ? "\n" : "") + nom.name + ": " + q[k].say; }));
  let fin = false;
  const done = (how) => { if(fin) return; fin = true;
    const odds = clamp(0.5 + fit / 200 + grill * 0.06, 0.1, 0.92);
    let msg = "";
    if(how === "yes"){ G.court = G.court || []; if(G.court.length) G.court[rint(0, G.court.length - 1)] = {name:nom.name, by:"the Senate", pos:nom.pos}; y.standing = clamp(y.standing + 1, 0, 100); msg = nom.name + " is confirmed to the bench."; }
    else if(how === "no"){ y.standing = clamp(y.standing + (fit < 0 ? 2 : -2), 0, 100); msg = "The committee rejects " + nom.name + ". " + senateColleague() + " is not pleased."; }
    else { const won = chance(1 - odds); y.standing = clamp(y.standing + (won ? 4 : -3), 0, 100); if(!won){ G.court = G.court || []; if(G.court.length) G.court[rint(0, G.court.length - 1)] = {name:nom.name, by:"the Senate", pos:nom.pos}; } msg = won ? nom.name + "'s nomination is withdrawn after a week of hearings." : nom.name + " is confirmed over your objection."; }
    reactEmit("confirm", {name:nom.name, confirmed:/is confirmed/.test(msg)}); el("cqSay").textContent += "\n" + msg; feed(msg, "good"); card.querySelectorAll("#cfYes,#cfNo,#cfFight,[data-cq]").forEach(x => x.disabled = true); };
  el("cfYes").addEventListener("click", () => done("yes")); el("cfNo").addEventListener("click", () => done("no")); el("cfFight").addEventListener("click", () => done("fight"));
  return null;
}
function treatyCard(){
  const y = G.you, rs = realmEnsure(), rel = G.realmRel = G.realmRel || {};
  const r = rs[(G.day || 0) % rs.length], D = DLG[r.k] || {ask:r.want, give:"goodwill", red:"being asked for too much"}, g = REALM_GOV[r.k] || {}, folk = realmFolk(r.k), head = folk.find(f => f.id === "head"), env = folk[0];
  const sens = (G.members || []).filter(m => m && !m.gone && m.kind === "member" && m.pos), sen = sens.sort(() => Math.random() - 0.5).slice(0, 2);
  const opp = sen.find(m => (m.pos.def || 0) > 10) || sen[0], sup = sen.find(m => m !== opp) || sen[1];
  const sec = (a, b) => '<p style="margin:6px 0"><b>' + a + '</b> ' + b + '</p>';
  const body = '<p class="muted">' + pcEsc(cap(r.t)) + ' is ' + realmRelLabel(rel[r.k] || 0) + ' towards the Union (' + Math.round(rel[r.k] || 0) + '). ' + pcEsc(g.d || "") + '</p>' +
    sec("Article I — what they ask.", pcEsc(cap(D.ask)) + ".") + sec("Article II — what they give.", pcEsc(cap(D.give)) + ".") +
    sec("Article III — the line they will not cross.", "The Union will not do, and " + pcEsc(r.t) + " will not be asked for, " + pcEsc(D.red) + ".") +
    sec("Article IV — duration.", "Six years, renewable, with an exit clause on ninety days' notice.") +
    sec("Who backs it.", pcEsc(sup ? sup.name + " (" + sup.party + "), who thinks " + D.give + " is worth the price" : "the trade committee") + ".") +
    sec("Who objects.", pcEsc(opp ? opp.name + " (" + opp.party + "), who thinks the Union gives " + D.ask + " and gets a promise" : "the hawks") + ". " + pcEsc(g.powers ? cap(g.powers[0][0]) + " will be watching how the Senate votes." : "") ) +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" data-tr="env">Hear ' + pcEsc(env.name) + '</button><button type="button" class="btn btn--ghost" data-tr="opp">Hear the objection</button></div><div id="trSay" class="dream" style="white-space:pre-line"></div>' +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" data-trv="yes">Ratify</button><button type="button" class="btn btn--ghost" data-trv="res">Ratify with a reservation</button><button type="button" class="btn btn--ghost" data-trv="hold">Hold it in committee</button><button type="button" class="btn btn--ghost" data-trv="no">Reject</button></div>';
  govCardOpen("Treaties and foreign business", "A treaty with " + r.t, "Advice and consent: two thirds of the Senate, and you in the room.", body, null);
  card.querySelectorAll("[data-tr]").forEach(b => b.addEventListener("click", () => { const k = b.getAttribute("data-tr");
    el("trSay").textContent += (el("trSay").textContent ? "\n" : "") + (k === "env" ? env.name + " (" + env.title + "): “" + realmVoice(r.k, {}, "what do you want") + " We will not accept " + D.red + ", and I say so before the vote rather than after it.”" : (opp ? opp.name + ": “" + "We would be giving " + D.ask + " to a government that is " + realmRelLabel(rel[r.k] || 0) + " to us, and taking its word for " + D.give + ". I will vote no unless the text says what happens if it does not keep it.”" : "No objection was heard.")); }));
  let fin = false;
  card.querySelectorAll("[data-trv]").forEach(b => b.addEventListener("click", () => { if(fin) return; fin = true; const k = b.getAttribute("data-trv"); spend(30, 3);
    const base = 0.5 + (y.standing - 50) / 200 + (rel[r.k] || 0) / 300; let msg = "";
    if(k === "yes" || k === "res"){ const ok = chance(clamp(base + (k === "res" ? 0.15 : 0), 0.1, 0.95)); rel[r.k] = clamp((rel[r.k] || 0) + (ok ? (k === "res" ? 8 : 15) : -6), -100, 100); y.standing = clamp(y.standing + (ok ? 3 : -2), 0, 100);
      msg = ok ? "The Senate ratifies the treaty with " + r.t + (k === "res" ? ", with your reservation on " + D.red : "") + ". " + senateColleague() + " shakes your hand in the cloakroom." : "The treaty with " + r.t + " falls short of two thirds."; }
    else if(k === "hold"){ rel[r.k] = clamp((rel[r.k] || 0) - 2, -100, 100); msg = "You hold it in committee. " + r.t + " will say you are stalling."; }
    else { rel[r.k] = clamp((rel[r.k] || 0) - 8, -100, 100); y.standing = clamp(y.standing + 1, 0, 100); msg = "You vote it down. " + (env ? env.name : "Their envoy") + " asks for a meeting."; }
    reactEmit("treaty", {k:r.k, verb:k, ok:/ratifies/.test(msg)}); el("trSay").textContent += "\n" + msg; feed(msg, "good"); card.querySelectorAll("[data-trv],[data-tr]").forEach(x => x.disabled = true); }));
  return null;
}
function senCalls(){
  const y = G.you, S = (G.states || []).find(x => x.n === y.state), done = {};
  const wants = [["dairy farmer", "the co-op road washed out in spring and is still out"], ["widow", "a pension letter that came back unopened"], ["county clerk", "ballots for the special election that never came"], ["mayor", "the water main the state required, which the town cannot pay for"]];
  const calls = wants.slice().sort(() => Math.random() - 0.5).slice(0, 3).map(w => { const name = newName(y.state); return {name, role:w[0], c:caseFile(w[0], w[1], S, name)}; }).filter(x => x.c);
  const body = calls.map((x, i) => '<div style="margin:10px 0;padding:8px 10px;border-left:3px solid var(--line-soft)"><b>' + pcEsc(x.name) + '</b> <span class="muted">· ' + pcEsc(x.role) + ' · ' + pcEsc(y.state) + '</span><p style="margin:6px 0">“' + pcEsc(x.c.open.join(" ")) + '”</p>' +
    '<div class="muted" style="font-size:12px">It would cost ' + pcEsc(x.c.costText) + '. They would settle for ' + pcEsc(x.c.settle) + '</div>' +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" data-cl="' + i + ':1">Raise it in committee (4 influence)</button><button type="button" class="btn btn--ghost" data-cl="' + i + ':2">Promise a letter to the agency</button><button type="button" class="btn btn--ghost" data-cl="' + i + ':3">Say it is for the state</button></div><div class="dream" id="cl_' + i + '"></div></div>').join("");
  govCardOpen("Calls from " + y.state, "People who voted for you", "Three callers, each with something the Senate might do and something it cannot.", body, "scalls");
  card.querySelectorAll("[data-cl]").forEach(b => b.addEventListener("click", () => { const [i, k] = b.getAttribute("data-cl").split(":"); if(done[i]) return; done[i] = 1; spend(15, 2);
    let r = ""; const x = calls[+i];
    if(k === "1"){ if(y.influence < 4){ r = "You are short of influence; you promise to write instead."; y.approval = clamp(y.approval + 1, 0, 100); } else { y.influence -= 4; y.approval = clamp(y.approval + 3, 0, 100); y.standing = clamp(y.standing + 1, 0, 100); r = x.name + ": “Then someone is finally listening.” You will raise " + x.c.short + " in committee."; feed("You raised " + x.c.short + " in committee.", "good"); } }
    else if(k === "2"){ y.approval = clamp(y.approval + 1, 0, 100); r = x.name + ": “A letter is a start. Put a date on it.”"; }
    else { y.approval = clamp(y.approval - 1, 0, 100); r = x.name + ": “Then who do I ring? I have rung everyone.”"; }
    el("cl_" + i).textContent = r; card.querySelectorAll('[data-cl^="' + i + ':"]').forEach(z => z.disabled = true); }));
  return null;
}
function confirmCard_old(){
  const nom = {name:newName(pick(STATES)), pos:{econ:rint(-60, 60), lib:rint(-60, 60), def:0, wel:0}};
  const fit = alignment(G.you, {pos:nom.pos});
  card.innerHTML = '<div class="eyebrow">Senate Judiciary · confirmation</div><h1>' + nom.name + '</h1>' +
    '<p>Nominated to the bench. ' + (fit > 0 ? "Reads the law much as you do." : "Reads the law the other way from you.") + ' ' + senateColleague() + ' wants a quick vote.</p>' +
    '<div class="card__actions"><button type="button" class="btn" id="cfYes">Confirm</button><button type="button" class="btn btn--ghost" id="cfNo">Make a fight of it</button></div>';
  veil.hidden = false;
  const done = (yes) => {
    const won = yes || chance(0.45);
    if(yes){ G.court = G.court || []; if(G.court.length) G.court[rint(0, G.court.length - 1)] = {name:nom.name, by:"the Senate", pos:nom.pos}; }
    G.you.standing = clamp(G.you.standing + (yes ? 1 : won ? 4 : -3), 0, 100);
    feed(yes ? nom.name + " confirmed to the bench." : (won ? nom.name + "'s nomination was withdrawn after a week of hearings." : nom.name + " confirmed over your objection."), "good");
    walkNow();
  };
  el("cfYes").addEventListener("click", () => done(true));
  el("cfNo").addEventListener("click", () => done(false));
}
function officeCard(){
  G.running = false;
  const y = G.you, k = roleKey(), L = lawEnsure();
  const P = rolePowers();
  const lim = Object.keys(L.limits).map(o => (OFFICES[o] ? OFFICES[o].short : o) + " " + (L.limits[o] ? L.limits[o] + (L.limits[o] === 1 ? " term" : " terms") : "no limit")).join(" · ");
  card.innerHTML = '<div class="eyebrow">Your office · ' + ROLE_T[k] + '</div><h1>' + officeTitle() + '</h1>' +
    '<p class="dream">Term limits in law: ' + lim + '. They change only by amendment.</p>' +
    P.map((p, i) => '<div class="whip__row"><span class="whip__n">' + p.t + '</span><span class="whip__w">' + (p.d || "") + '</span>' +
      '<span class="whip__b"><button type="button" class="btn btn--ghost whip__go" data-pow="' + i + '"' + (p.off ? ' disabled' : '') + '>Do it</button></span></div>').join("") +
    (P.length ? '' : '<p>A Representative votes, talks and files. The bigger rooms have bigger levers.</p>') +
    '<div id="powSay" class="dream"></div>' +
    '<div class="card__actions"><button type="button" class="btn" id="powClose">Close</button></div>';
  veil.hidden = false;
  el("powClose").addEventListener("click", () => walkNow());
  card.querySelectorAll("[data-pow]").forEach(bt => bt.addEventListener("click", () => {
    const p = P[+bt.getAttribute("data-pow")]; if(!p || p.off) return;
    spend(20, 4);
    const r = p.run();
    if(r === null) return;
    officeCard();
    const s = el("powSay"); if(s) s.textContent = r || "";
  }));
}

/* today's aims, on the screen where the player is looking, not only in the pause menu */
function paintAims(){
  try{ const box = el("aimsHud"), nx = el("aimsNext"), all = el("aimsAll"); if(!box || !nx) return;
    if(!G.running || !G.you || !veil.hidden){ box.hidden = true; return; }
    const Gs = goalsEnsure(); if(!Gs || !Gs.list || !Gs.list.length){ box.hidden = true; return; }
    const done = Gs.list.filter(g => g.done).length, next = Gs.list.find(g => !g.done), sig = done + "|" + (next ? next.t + (next.have || 0) : "all") + "|" + Gs.day;
    if(box._sig !== sig){ box._sig = sig; nx.textContent = next ? done + "/" + Gs.list.length + " \u00b7 " + next.t + (next.k === "talk" ? " (" + next.have + "/" + next.need + ")" : "") : "All done today \u2713"; if(all) setHTML(all, goalsHTML()); }
    box.hidden = false; }catch(e){}
}
function paintJob(){
  try{ paintAims(); }catch(e){}
  try{ lifeMorningCheck(); lifeMailCheck(); }catch(e){}
  try{ lTick(); }catch(e){}
  try{ texUpgradeIdle(); }catch(e){}
  const box = el("job"), txt = el("jobText");
  if(!box || !txt) return;
  let line = activeJob();
  try{ const mh = mHintLine(); if(mh) line = mh; }catch(e){}
  try{ line = mPadWords(line); }catch(e){}
  try{
    const od = objectiveDoor();
    if(line && od && !/Sleep\.|Speak\.$/.test(line)){
      line += "  ▸ " + (od.dr.to === od.goal ? ROOMS[od.goal].t : ROOMS[od.dr.to].t + ", then " + ROOMS[od.goal].t);
    }
  }catch(e){}
  if(txt._line === line && box.hidden === !!( !G.running || !line )) return;
  txt._line = line;
  txt.textContent = line;
  box.hidden = !G.running || !line;
  const st = el("scene") && el("scene").parentNode;
  if(st && st.classList){
    if(G.you && G.you.energy < 28) st.classList.add("is-spent");
    else st.classList.remove("is-spent");
  }
}
function paintCompass(){
  const wrap = el("compass");
  const box = el("compassTicks");
  if(!box) return;
  if(wrap) wrap.style.display = (G.running && !TALK.open) ? "" : "none";
  if(!G.running) return;
  const list = hereNow();
  const bits = [];
  const yaw = cam.yaw || 0;
  const half = 50;
  for(let i=0;i<list.length;i++){
    const m = list[i];
    const bear = Math.atan2(m.x - cam.x, m.z - cam.z);
    const rel = wrapPi(bear - yaw);
    if(Math.abs(rel) > 1.25) continue;
    const pct = 50 + (rel / 1.25) * half;
    let cls = "compass__tick";
    if(m.wantsWord) cls += " is-quest";
    else if(TALK.m === m) cls += " is-talk";
    bits.push('<i class="' + cls + '" style="left:' + pct.toFixed(1) + '%" title="' + (m.name || "") + '"></i>');
  }
  /* 20261011b: the door that leads toward the job — pinned to the rail edge when behind you */
  try{
    const od = objectiveDoor();
    if(od){
      const dp = doorAt(G.room, od.dr);
      const relD = wrapPi(Math.atan2(dp.x - cam.x, dp.z - cam.z) - yaw);
      const edge = Math.abs(relD) > 1.25;
      const pctD = edge ? (relD > 0 ? 1 : 99) : 50 + (relD / 1.25) * half;
      bits.push('<i class="compass__tick is-goal' + (edge ? ' is-edge' : '') + '" style="left:' + pctD.toFixed(1) + '%" title="' + ROOMS[od.dr.to].t + '"></i>');
    }
  }catch(e){}
  const html = bits.join("");
  if(box._html === html) return;
  box._html = html;
  box.innerHTML = html;
}
function refreshBar(){
  const you = G.you; if(!you) return;
  say(el("hName"), you.name);
  setHTML(el("hSub"), chipFor(you) +
    "<span>" + (you.out ? officeTitle() : inHouse() ? (you.post ? postTitle(you.post) : "Member of the House") : officeTitle()) + "</span><span>·</span>" +
    (you.out ? "<span>standing again</span>" : inHouse() ? "<span>" + committeeOf(you.committee).t + "</span>" : "<span>" + officeSeat() + "</span>") +
    (inHouse() || you.out ? "<span>·</span><span>" + you.state + " " + you.dist + "</span>" : ""));
  try{ officeTabLabel(); }catch(e){}
  say(el("hDate"), dateString() + " · " + dayLabel());
  say(el("hClock"), hhmm());
  say(el("hCong"), ordinal(G.congress));
  el("hCong").setAttribute("data-tipk", "country");
  el("hCong").setAttribute("data-tipv", "now");
  el("hCong").classList.add("tipword");
  say(el("hSess"), "Sitting day " + G.sittingDay + "/" + G.termLength);
  setHTML(el("hStats"),
    statHTML("Approval", Math.round(you.approval), 100, "var(--good)") +
    statHTML("Influence", Math.round(you.influence), 100, "var(--fed)") +
    statHTML("Standing", Math.round(you.standing), 100, "var(--com)") +
    statHTML("Energy", Math.round(you.energy), 100, you.energy<34?"var(--bad)":"var(--warn)") +
    statHTML("War chest", Math.round(you.funds), 300, "var(--ind)", money(you.funds)) +
    '<div class="stat"><i>Mood</i><b>' + (G.mood>0?"+":"") + Math.round(G.mood) +
      '</b><span class="stat__track"><span class="stat__fill" style="width:'+((G.mood+60)/120*100)+'%;background:var(--ink-3)"></span></span></div>');
  try{ goalsTick(); }catch(e){}
  try{ paintJob(); paintCompass(); }catch(e){}
}
/* ══════════════════════════════════════════════════════════
   20261011k · THE HIGHER ROOMS
   The Senate, the Court, the Executive wing and the State House are
   real rooms now: walls, floors, furniture, people who work there,
   and a desk that is yours only if the chair is yours.
   ══════════════════════════════════════════════════════════ */
const K_ROOM_OF = {senate:"senate", bench:"court", pres:"exec", gov:"govoffice"};
const K_HERE_LINE = {
  senate:"The Senate sits. Your desk is on the aisle. E.",
  court:"The Court is in session. The bench is yours. E.",
  exec:"The wing is waiting on you. The desk. E.",
  govoffice:"The State House is open. Your desk. E."
};
function kChamberRoom(){ try{ return K_ROOM_OF[roleKey()] || null; }catch(e){ return null; } }
function kChamberDone(){ const y = G.you; return !!(y && y.used && y.used.chamber === G.day); }
function kMarkChamber(){ const y = G.you; y.used = y.used || {}; y.used.chamber = G.day; }
function kChamberDue(){
  if(!G.you || G.you.out) return null;
  const r = kChamberRoom(); if(!r || !ROOMS[r]) return null;
  const m = G.minute || 0;
  if(m < 9*60 || m >= 18*60 || kChamberDone()) return null;
  try{ if(dayType() === "recess" && r !== "govoffice") return null; }catch(e){}
  return r;
}
function kHolds(room){ return kChamberRoom() === room; }
function kOnceToday(key){ const y = G.you; y.used = y.used || {}; return y.used[key] === G.day; }
function kMark(key){ const y = G.you; y.used = y.used || {}; y.used[key] = G.day; }

/* ── the people who work in them ─────────────────────────── */
const K_STAFF = {
  senate:   [["senator","Senator","the Senate calendar"],["senator","Senator","the Senate calendar"],["senclerk","Secretary of the Senate","the Senate journal"],["senator","Senator","the Senate calendar"],["senator","Senator","the Senate calendar"],["senator","Senator","the Senate calendar"],["senator","Senator","the Senate calendar"],["senator","Senator","the Senate calendar"],["senator","Senator","the Senate calendar"]],
  court:    [["justice","Justice","the docket"],["courtclerk","Clerk of the Court","the docket"],["marshal","Marshal of the Court","order in the room"]],
  exec:     [["chief","Chief of Staff","the Executive's day"],["aide","Executive aide","the morning briefing"]],
  govoffice:[["gsec","Governor's secretary","the Governor's calendar"],["gcounsel","Counsel to the Governor","the state's lawsuits"]]
};
function kEnsurePeople(){
  if(!G.civ) G.civ = [];
  let added = false;
  Object.keys(K_STAFF).forEach(room => {
    K_STAFF[room].forEach((spec, i) => {
      const slot = room + ":" + i;
      const have = G.civ.find(c => c && c.kslot === slot);
      if(have){
        /* whoever won the Senate sits in it: the desk follows the election */
        if(spec[0] === "senator"){
          const won = (G.ladder || []).filter(x => x && x.won && x.to === "senate");
          if(i < 2 && won[i] && have.name !== won[i].name){ have.name = won[i].name; have.met = false; }
        }
        return;
      }
      try{
        const c = makeCivilian();
        c.kslot = slot; c.krole = spec[0]; c.role = spec[1]; c.cause = spec[2];
        c.chamber = room; c.room = room; c.caseOpen = false;
        if(spec[0] === "senator"){
          const won = (G.ladder || []).filter(x => x && x.won && x.to === "senate");
          if(i < 2 && won[i]) c.name = won[i].name;
          if(i >= 3){ const ss = (G.states || []).filter(x => x.n !== (G.you && G.you.state)), st = ss[(i * 7 + 3) % Math.max(1, ss.length)]; if(st){ c.state = st.n; try{ c.name = wallSafeMint(() => newName(st.n)); }catch(e){} } c.party = ["FED", "COM"][i % 2]; }
        }
        if(spec[0] === "justice" && G.court && G.court[0]) c.name = G.court[0].name;
        if(room === "govoffice" && G.you && G.you.state){ try{ c.state = G.you.state; }catch(e){} }
        try{ placeInRoom(c); }catch(e){}
        G.civ.push(c); added = true;
      }catch(e){}
    });
  });
  if(added){ _allCache = null; }
}
/* ── person by person: each of the people who work in these rooms is somebody. A name, a manner, a story, a want, a way of putting things, something particular they can do for you, and a day of their own ── */
const K_ARCH = {
  senclerk:[["the stickler","quotes the rule number before the rule"], ["the fixer","knows three ways round every rule"], ["the old hand","remembers what used to happen"]],
  courtclerk:[["the sceptic","thinks every petition is overstated"], ["the champion of the small filer","reads the handwritten ones first"], ["the keeper of the calendar","lives and dies by deadlines"]],
  marshal:[["the bulwark","treats order as a courtesy and enforces it like one"], ["the gossip","knows who was in the building and why"], ["the veteran","served, and has views on everyone who did not"]],
  chief:[["the gatekeeper","decides who gets fifteen minutes"], ["the fixer","settles it before it reaches the desk"], ["the loyalist","speaks for the Executive and means it"]],
  aide:[["the early riser","has read everything twice by seven"], ["the diplomat","phrases every bad thing well"], ["the cynic","has seen this file before"]],
  gsec:[["the keeper of the waiting bench","knows every petitioner's mother"], ["the efficient one","runs the list by the minute"], ["the soft touch","lets the long ones run over"]],
  gcounsel:[["the cautious lawyer","tells you what can go wrong first"], ["the litigator","would rather be sued than wait"], ["the constitutionalist","reads the Charter aloud when nervous"]],
  senator:[["the committee man","trades in markups"], ["the speaker","lives for the floor"], ["the quiet vote","says little and counts everything"]],
  justice:[["the textualist","starts with the words"], ["the pragmatist","asks what happens next"], ["the dissenter","enjoys being the only one"]]
};
const K_STORY = {
  senclerk:["came up as a page at fourteen and never left", "was the clerk who read the roll the night the vote tied", "has outlasted nine majority leaders and keeps the notes"],
  courtclerk:["filed the first petition of a famous case by hand", "once lost a filing in a flood and has never lost one since", "grew up in a house with a law library and no car"],
  marshal:["served in the border guard before this", "was a bailiff in a county court for twenty years", "lost an election once and says it was the best thing that happened"],
  chief:["ran three campaigns before this, and won two", "was a county clerk who got noticed", "has been in the building longer than the Executive has"],
  aide:["wrote the speeches nobody remembers", "reads the cables before the Secretary does", "joined out of university and is still surprised"],
  gsec:["has kept the Governor's door through three administrations", "was a schoolteacher before this", "knows where every county road floods"],
  gcounsel:["litigated for the state before taking the job", "argued a case in front of the bench and lost by one vote", "keeps a copy of the Charter in a coat pocket"],
  senator:["came up through the statehouse", "was a judge before standing", "never planned any of this and is good at it anyway"],
  justice:["was a prosecutor, then a professor, then here", "wrote the dissent people quote", "still reads every brief themselves"]
};
const K_WANT = ["a quiet retirement and a pension that holds", "to see one rule changed before they go", "to be thanked once, in public", "a seat of their own one day", "to be left alone to do the job properly", "to be proved right about something"];
const K_WORK = {
  senclerk:"I keep the journal, the calendar and the rules. When a Senator asks 'is that in order?', I am the answer. It matters to you because a motion that is out of order loses the room before it is heard.",
  courtclerk:"I take the petitions, keep the docket and the deadlines. Who is heard, and when, passes through this desk. It matters to you because a case that is never filed is never decided, and one filed late is filed for nothing.",
  marshal:"I keep order in the Court and in the building around it: who comes in, who stays, who is asked to leave. It matters to you because nobody argues well in a room that does not feel safe.",
  chief:"I run the Executive's day: who sees the Executive, for how long, and with what in their hands. It matters to you because fifteen minutes in this wing can be worth a year of letters.",
  aide:"I read the overnight file and put it in front of the Executive in the order it should be read. It matters to you because what leads the file is what leads the day.",
  gsec:"I keep the Governor's calendar and the list of who comes in on open hours. It matters to you because nobody gets heard who is not on my list, and most people on it have waited weeks.",
  gcounsel:"I advise the Governor on what the state may do and what it may be sued for. It matters to you because a measure that wins at home and loses in the federal court is the worst of both.",
  senator:"I sit, I vote, and I count. It matters to you because the Senate is two votes per state and every one of them has a reason.",
  justice:"I read the briefs, argue it in conference and write or join an opinion. It matters to you because five of us decide what the law means for everyone else."
};
function kMeta(c){
  if(c.kmeta) return c.kmeta; const r = rng(seedOf("km:" + (c.kslot || c.id) + ":" + c.name)), A = K_ARCH[c.krole] || [["steady", "does the job"]], a = A[Math.floor(r() * A.length)], S = K_STORY[c.krole] || ["has been here a while"];
  c.kmeta = {arch:a[0], quirk:a[1], years:3 + Math.floor(r() * 27), story:S[Math.floor(r() * S.length)], want:K_WANT[Math.floor(r() * K_WANT.length)]}; c.rapport = c.rapport || 0; return c.kmeta;
}
function kVoice(c, text){ const m = kMeta(c); const pre = {"the stickler":"Section and subsection, then. ", "the fixer":"Between us: ", "the old hand":"In my time, ", "the sceptic":"Frankly, ", "the bulwark":"Plainly: ", "the gossip":"You did not hear this from me, but ", "the gatekeeper":"Short version: ", "the cynic":"I have seen this one. ", "the diplomat":"If I may put it kindly: ", "the cautious lawyer":"First, what can go wrong: ", "the litigator":"Let them sue. ", "the constitutionalist":"As the Charter has it, ", "the speaker":"Let me say this loudly: ", "the quiet vote":"(low) ", "the dissenter":"I may be the only one, but ", "the pragmatist":"What happens next is "}[m.arch] || ""; return pre + text; }
function kGossip(c){
  const b = G.bill && !G.bill.done ? G.bill : null, rn = (G.reactNews || []).slice(-3), hot = (G.states || []).slice().sort((x, z) => (z.unrest || 0) - (x.unrest || 0))[0], L = [];
  if(rn.length) L.push("The talk is: " + rn[rn.length - 1].t);
  if(b){ try{ const t = tallyBill(b, true); L.push("The " + b.title + " is " + (t.aye > t.no ? "ahead" : "behind") + ", " + t.aye + " to " + t.no + ", and the undecided are not telling anyone."); }catch(e){} }
  if(hot) L.push(hot.n + " is the state everyone is watching: unrest is " + Math.round(hot.unrest || 0) + ".");
  try{ const w = worldEnsure(); L.push("Bread is at " + (w.bread || 1).toFixed(2) + " and " + worldFoe().t + " is the name on every tongue."); }catch(e){}
  if(G.conflict) L.push("There is a measure against " + ((WORLD_POWERS.find(p => p.k === G.conflict.k) || {}).t || "a neighbour") + " under way, and people are taking sides.");
  return L[Math.floor(Math.random() * L.length)] || "Nothing worth repeating.";
}
function kChamberActs(c){
  const you = G.you, b = G.bill, live = b && !b.done, M = kMeta(c), A = [], done = c.kday === G.day, mark = () => { c.kday = G.day; };
  const intro = {t:"Ask about their work", c:"5m", run(){ spend(5, 1); c.met = true; setSay(kVoice(c, K_WORK[c.krole] || "I do my job."), fx("", "you understand what they do")); }};
  const heard = {t:"Ask what they have heard", c:"5m", run(){ spend(5, 1); setSay(kVoice(c, kGossip(c)), ""); }};
  const about = {t:"Ask about them", c:"10m", run(){ spend(10, 1); c.met = true; c.rapport = Math.min(4, (c.rapport || 0) + 1); let fam = ""; try{ fam = " " + kinSummary(c); }catch(e){} setSay("I am " + M.arch + ": someone who " + M.quirk + ". " + cap(M.story) + ". " + M.years + " years at it, now, and what I would like is " + M.want + "." + fam, fx("+ rapport", "they tell you something real")); try{ if(c.rel) ripple(c, 2, "They asked about me and listened.", 2, false); }catch(e){} }};
  A.push(intro);
  /* the thing each of them can tell you or do for you */
  if(c.krole === "senclerk"){
    A.push({t:"Ask if a move would be in order", c:"10m", run(){ spend(10, 1); c.met = true; setSay(kVoice(c, b ? "On the " + b.title + ": you may hold the floor (it slips the vote three days and costs you six influence), offer a reservation or a compromise before the vote (it moves the middle), or move to table (it needs a majority and loses you the sponsor). Cloture takes three fifths. Anything else is a speech." : "Nothing is before us, so nothing is out of order, which is the best condition the Senate is ever in."), ""); }});
    A.push({t:"Ask for the calendar", c:"10m", run(){ spend(10, 1); const acts = (G.lastActs || []).slice(0, 3).map(x => x && (x.title || x.t || x)).filter(Boolean); setSay(kVoice(c, acts.length ? "The journal has " + listify(acts) + ". The rest is confirmations and morning business." : "Morning business and a quorum call. A quiet day is a good day here."), ""); }});
    A.push({t:"Ask a favour: put your item early on the calendar", c:"15m", off:done, run(){ if((c.rapport || 0) < 1){ setSay(kVoice(c, "Ask me again when we have talked properly. I do not move the calendar for strangers."), ""); return; } spend(15, 2); mark(); you.influence = clamp(you.influence + 2, 0, 100); setSay(kVoice(c, "It is on the list before the morning business. That is all I am doing, and all I will say I did."), fx("+2 influence", "")); }});
  } else if(c.krole === "marshal"){
    A.push({t:"Ask how the room feels", c:"5m", run(){ spend(5, 1); let warm = 0, sore = 0, n = 0; try{ hereNow().forEach(p => { if(!p || p === G.you || !p.traits) return; n++; const l = presentOf(p).label; if(/warm|animated|easy|delight/.test(l)) warm++; else if(/cold|closed|short|angry/.test(l)) sore++; }); }catch(e){} setSay(kVoice(c, n ? "Of the " + n + " in here, " + warm + " look easy and " + sore + " look sore; the rest are composed, which is what I would be too." : "Nobody is in but us. It is the best the room ever looks."), ""); }});
    A.push({t:"Ask who has been in the building", c:"10m", run(){ spend(10, 1); const m = pick((G.members || []).filter(x => x && !x.gone && x.kind === "member")); setSay(kVoice(c, m ? surname(m.name) + " was in before eight, alone, and left with a folder under the arm. I do not ask. I note." : "A quiet morning."), ""); }});
    A.push({t:"Ask a favour: a word with someone", c:"15m", off:done, run(){ if((c.rapport || 0) < 1){ setSay(kVoice(c, "I do not arrange meetings for people I have only just met."), ""); return; } spend(15, 2); mark(); const m = pick((G.members || []).filter(x => x && !x.gone && x.kind === "member" && !x.met)); if(m){ m.met = true; try{ if(m.rel) ripple(m, 2, "The Marshal said somebody wanted to meet me. They did.", 2, false); }catch(e){} } setSay(kVoice(c, m ? "I have told " + m.name + " you would welcome a word. They will find you." : "I could not think of anyone you have not met."), fx(m ? "you are introduced" : "", "")); }});
  } else if(c.krole === "courtclerk"){
    A.push({t:"Ask about the docket", c:"10m", run(){ spend(10, 1); const open = (G.cases || []).filter(x => x && !x.done); setSay(kVoice(c, open.length ? "On the docket: " + listify(open.slice(0, 3).map(x => x.t)) + "." : "Nothing pending. Write a law somebody hates and that will change."), ""); }});
    A.push({t:"Ask which petitions are strongest", c:"10m", run(){ spend(10, 1); setSay(kVoice(c, "The ones that get four votes are the ones where two courts below have said opposite things about the same words. The ones that do not are the ones where the petitioner is angry and the record is thin. Read the first kind first."), ""); }});
    A.push({t:"Ask a favour: an early look at the petitions", c:"15m", off:done, run(){ if((c.rapport || 0) < 1){ setSay(kVoice(c, "The petitions go out when they go out. We have not spoken enough for me to do otherwise."), ""); return; } spend(15, 2); mark(); you.influence = clamp(you.influence + 1, 0, 100); setSay(kVoice(c, "Three are on top of the pile, and the second is the one I would hear. That is all I should say."), fx("+1 influence", "")); }});
  } else if(c.krole === "justice"){
    A.push({t:"Ask for their view on the case before the Court", c:"10m", run(){ spend(10, 2); c.met = true; const cs = benchCase(); if(!cs){ setSay(kVoice(c, "Nothing is ripe. We talk about the long view and the coffee."), ""); return; } const side = justiceLean({name:c.name, pos:c.pos}, cs) > 0, lab = cs.dual != null ? ["for the House", "for the member"] : ["for the Union", "for the state"]; setSay(kVoice(c, justiceWhy({name:c.name, pos:c.pos}, cs, side) + " So I lean " + (side ? lab[0] : lab[1]) + ", for now, and I may be talked out of it."), ""); }});
    A.push({t:"Share a coffee", c:"15m", off:done, run(){ spend(15, 1); mark(); c.rapport = Math.min(4, (c.rapport || 0) + 1); you.standing = clamp(you.standing + 1, 0, 100); setSay(kVoice(c, "Nobody talks shop over coffee in this building, which is why it is the only place anyone says anything true."), fx("+1 standing", "")); }});
  } else if(c.krole === "senator"){
    A.push({t:"Ask where they stand on the bill", c:"10m", off:!live, run(){ spend(10, 2); c.met = true; setSay(kVoice(c, huddleSay(c, false)), fx(kHolds("senate") ? "+1 influence" : "", "")); if(kHolds("senate")) you.influence = clamp(you.influence + 1, 0, 100); }});
    A.push({t:"Ask what they would trade for it", c:"15m", off:done || !live, run(){ spend(15, 3); mark(); setSay(kVoice(c, (alignment(c, b) > 0 ? "I am with you already; I would not trade for something I believe. " : "It would take a change to section four and a vote from you on mine. ") + "That is how it is done."), ""); }});
  } else if(c.krole === "chief"){
    A.push({t:"Ask where the Executive stands", c:"10m", run(){ spend(10, 1); const ex = G.exec; setSay(kVoice(c, b && ex && !ex.you ? "On the " + b.title + ", the Executive is " + (alignment(ex, b) > 0 ? "inclined to sign" : alignment(ex, b) < -18 ? "inclined to veto" : "reading it") + ". " + (ex.vetoes || 0) + " vetoes so far this term." : "Nothing before us the Executive has a view on."), ""); }});
    A.push({t:"Ask for time with the Executive", c:"30m", off:done || (G.exec && G.exec.you), run(){ if((c.rapport || 0) < 1 && G.exec && G.exec.party !== you.party){ setSay(kVoice(c, "Five minutes in the doorway, and that is generous. Come back when we know each other."), ""); } spend(30, 6); mark(); const same = G.exec && G.exec.party === you.party; you.influence = clamp(you.influence + (same ? 3 : 1), 0, 100); setSay(kVoice(c, same ? "Fifteen minutes, door closed. The Executive asked about your district by name." : "Five minutes in the doorway. Polite, short, and on the record."), fx("+" + (same ? 3 : 1) + " influence", "30 minutes")); }});
  } else if(c.krole === "aide"){
    A.push({t:"Ask what the Executive is reading", c:"10m", run(){ spend(10, 1); const S = (G.states || []).slice().sort((x, z) => (z.unrest || 0) - (x.unrest || 0))[0]; setSay(kVoice(c, "The morning file leads with " + (S ? S.n + ", where the mood is sour" : "the realms") + (G.exec ? ". " + (G.exec.vetoes || 0) + " vetoes so far this term." : ".")), ""); }});
    A.push({t:"Ask a favour: a copy of the overnight file", c:"15m", off:done, run(){ if((c.rapport || 0) < 1){ setSay(kVoice(c, "It is not mine to copy. Ask me again when I know you."), ""); return; } spend(15, 1); mark(); you.influence = clamp(you.influence + 1, 0, 100); setSay(kVoice(c, "Here. It never left this room, and you did not read it."), fx("+1 influence", "")); }});
  } else if(c.krole === "gsec"){
    A.push({t:"Ask who is on today's list", c:"5m", run(){ spend(5, 1); const names = ["a dairy farmer", "a school board chair", "a mayor", "a county clerk", "a widow", "a union steward"].sort(() => Math.random() - 0.5).slice(0, 3); setSay(kVoice(c, "On today's list: " + listify(names) + ". Each has been waiting; none will be short, and one of them will cry."), ""); }});
    A.push({t:"Ask the Governor's office for help at home", c:"30m", off:done || kHolds("govoffice"), run(){ spend(30, 5); mark(); you.approval = clamp(you.approval + 2, 0, 100); setSay(kVoice(c, "A road crew, a letter and a ribbon cutting. The State House keeps its promises when they are small."), fx("+2 approval", "30 minutes")); }});
  } else if(c.krole === "gcounsel"){
    A.push({t:"Ask what the state could be sued over", c:"10m", run(){ spend(10, 2); const S = (G.states || []).find(x => x.n === (you.state)) || null, foe = worldFoe(); let risk = []; try{ if(S) GOV_ACTS.filter(a => a.fed).forEach(a => { const pl = govWarPlan(a, S, foe.k); risk.push(a.t.toLowerCase() + " (about " + Math.round((1 - pl.fed) * 100) + "% a suit)"); }); }catch(e){} setSay(kVoice(c, risk.length ? "If you act first on the " + foe.t.replace(/^the /, "") + " question, the exposed ones are: " + listify(risk) + ". The state's own business is safe." : "Nothing the state does today is likely to be sued."), ""); }});
    A.push({t:"Ask about the cases pending", c:"10m", run(){ spend(10, 1); const open = (G.cases || []).filter(x => x && !x.done && x.state === you.state); setSay(kVoice(c, open.length ? "Pending against " + you.state + ": " + listify(open.slice(0, 3).map(x => x.t)) + "." : "Nothing pending. Write a law somebody hates and that will change."), ""); }});
  }
  A.push(heard, about);
  if(/^(gcounsel|gsec|chief|senclerk|courtclerk)$/.test(c.krole || "") && kHolds(c.chamber)) A.unshift({t:"Go over the diary", c:"5m", run(){ spend(5, 0); setSay(kVoice(c, "Here is the day as it stands. Tell me what you will take and what you will not."), ""); scheduleCard(); }});
  A.push({t:"Leave them to it", c:"0m", run(){ setSay("You nod and let them get back to " + c.cause + ".", ""); }});
  return A;
}
/* ── the desks: yours if the office is yours ─────────────── */
/* ══════════════════════════════════════════════════════════
   20261012a · SIT-DOWN SCENES AS PROCEDURE
   The Senate floor, the bench, the morning briefing and the State
   House open hours used to be one click. Now each is a sitting:
   the gavel, openings, rounds of questions, motions, deliberation,
   the vote or ruling, and adjournment, in that order. Lines come in
   on a beat and go to the transcript. Continue hurries a line; it
   never skips a step. What you choose at each step costs or pays in
   standing, influence, approval, the war chest, pledges on the bill
   in play and a rival's heat. Reading the file first helps.
   ══════════════════════════════════════════════════════════ */
function sitEsc(s){ return String(s).replace(/&/g, "&"+"amp;").replace(/</g, "&"+"lt;"); }
const SIT = {on:null, timer:0, beat:1500, log:[]};
const SIT_DEF = {
  senate:{title:"The Senate sits", chair:"The Presiding Officer", min:60, en:12, kind:"vote",
    steps:["gavel","open","question","question","motion","deliberate","vote","adjourn"]},
  court:{title:"Oral argument", chair:"The Marshal", min:90, en:14, kind:"ruling",
    steps:["gavel","open","question","question","motion","deliberate","ruling","adjourn"]},
  exec:{title:"The morning briefing", chair:"The Chief of Staff", min:45, en:8, kind:"decision",
    steps:["gavel","open","question","motion","deliberate","ruling","adjourn"]},
  govoffice:{title:"Open hours at the State House", chair:"The Governor's secretary", min:60, en:10, kind:"decision",
    steps:["gavel","open","question","question","motion","deliberate","ruling","adjourn"]}
};
const SIT_STEP_T = {gavel:"Called to order", open:"Openings", question:"Questions", motion:"Motions and objections", deliberate:"Deliberation", vote:"The vote", ruling:"The ruling", adjourn:"Adjourned"};
function sitCast(room){
  let ppl = [];
  try{ ppl = hereNow().filter(m => m && m.name && m !== G.you && !m.machine); }catch(e){}
  const named = ppl.filter(m => m.kind === "member" || m.kslot || m.post);
  const pool = (named.length ? named : ppl).slice(0, 8);
  const nm = i => pool.length ? pool[i % pool.length].name : ["the Senator from the North", "counsel", "the Secretary"][i % 3];
  return {a:nm(0), b:nm(1), c:nm(2), ppl:pool};
}
function sitLines(room, step, C, ctx){
  const y = G.you, bill = G.bill && !G.bill.done ? G.bill : null, bt = bill ? bill.title : "the calendar";
  const cs = (G.cases || []).find(x => x && !x.done);
  const S = {
    senate:{
      gavel:[[ "The Presiding Officer", "The Senate will come to order. The clerk will read the journal."], ["The Clerk", "The journal of the last day stands approved without objection."]],
      open:[[C.a, "The question before us is " + bt + ". I will be brief, which in this room means twenty minutes."], [C.b, "The minority has a view, and the minority would like it on the record."]],
      question:[[C.b, pick(["Will the Senator yield for a question?", "I ask the Senator plainly: who pays for this?", "Has the Senator read section four, or only the summary?"])]],
      motion:[[C.c, pick(["I move to table.", "Point of order: the amendment is not germane.", "I ask unanimous consent to limit debate to one hour."])]],
      deliberate:[["The Presiding Officer", "Without objection, the Senate will stand in quorum call."], [C.a, "Twenty minutes in the cloakroom. Count your votes."]],
      vote:[["The Clerk", "The question is on passage. The clerk will call the roll."]],
      adjourn:[["The Presiding Officer", "The Senate stands adjourned until tomorrow at ten."]]},
    court:{
      gavel:[["The Marshal", "Oyez, oyez, oyez. All persons having business before this Court draw near and give attention."]],
      open:[["Counsel for " + (cs ? cs.state : "the petitioner"), cs ? "This Court should hold that the act reaches past what the Charter allows." : "A narrow question, Your Honor, on filing deadlines."], ["Counsel for the Union", "The act is the law, and the law is clear."]],
      question:[["Counsel for " + (cs ? cs.state : "the petitioner"), pick(["If I may finish the point, Your Honor.", "The record shows otherwise.", "With respect, that is not what the statute says."])]],
      motion:[["Counsel for the Union", pick(["Objection. Counsel is arguing facts not in the record.", "We move to strike that answer.", "We ask leave to file a supplemental brief."])]],
      deliberate:[["The Marshal", "The Court will retire to conference."]],
      ruling:[["The Clerk", "The Court has reached its decision."]],
      adjourn:[["The Marshal", "This honorable Court is now adjourned."]]},
    exec:{
      gavel:[["The Chief of Staff", "Everyone sit. We have forty minutes and the realm has a lot of problems."]],
      open:[[C.a, "The overnight file. Unrest is up in two states and the treasury wants an answer by noon."]],
      question:[[C.b, pick(["The numbers are soft. I would not lean on them.", "My office was not consulted, for the record.", "If you want it done by Friday, I need the authority today."])]],
      motion:[[C.c, pick(["I'd recommend we hold until the vote.", "I object to moving money we have not got.", "Sign it now and explain it later."])]],
      deliberate:[["The Chief of Staff", "Take a minute. Everyone else out of the room."]],
      ruling:[["The Chief of Staff", "Then it is decided."]],
      adjourn:[["The Chief of Staff", "Thank you. Go do it."]]},
    govoffice:{
      gavel:[["The Governor's secretary", "Open hours begin. Five on the list today, please keep it to ten minutes each."]],
      open:[[pick(["A dairy farmer", "A school board chair", "A mayor"]), pick(["The road to the co-op washed out in spring and it is still out.", "We are three teachers short and the state check is late.", "My town cannot pay for the water main the state required."])]],
      question:[[pick(["A widow", "A union steward", "A county clerk"]), pick(["My husband's pension letter came back unopened.", "The plant says it will close if the permit waits another month.", "The ballots for the special election never came."])]],
      motion:[[pick(["The second mayor", "A state senator"]), pick(["With respect, Governor, the first mayor's road is in my county and he never asked me.", "If you move that money, my district loses its clinic."])]],
      deliberate:[["The Governor's secretary", "Shall I clear the room, Governor?"]],
      ruling:[["The Governor's secretary", "I'll write it down as you say it."]],
      adjourn:[["The Governor's secretary", "That is the list. Open hours are closed."]]}
  };
  return ((S[room] || S.senate)[step] || []).slice();
}
/* risk/reward choices per step: [label, risk, good, bad, kind] */
function sitChoices(room, step){
  const C = {
    open:[["Open steady and on the record", 0.05, {standing:1}, {}, "safe"],
          ["Open bold, name names", 0.40, {standing:3, influence:1}, {standing:-2, heat:6}, "bold"],
          ["Cite the file chapter and verse", 0.15, {standing:2, approval:1}, {standing:-1}, "prep"]],
    question:[["Ask one fair question", 0.10, {standing:1}, {}, "safe"],
              ["Press hard until they give", 0.45, {influence:2, standing:1, heat:-4}, {standing:-2, heat:8}, "bold"],
              ["Let it pass to save time", 0.0, {}, {standing:-1}, "rush"]],
    motion:[["Rule it in order and move on", 0.10, {standing:1}, {}, "safe"],
            ["Object and make them argue it", 0.35, {influence:2}, {standing:-1, influence:-1}, "bold"],
            ["Offer a deal on the side", 0.30, {pledge:2, funds:-2}, {funds:-2, standing:-1}, "deal"]],
    deliberate:[["Take the full time to work it", 0.10, {support:3, pledge:1}, {}, "safe"],
                ["Spend from the war chest for votes", 0.25, {pledge:3, support:4, funds:-4}, {funds:-4}, "deal"],
                ["Cut it short", 0.0, {}, {standing:-2, support:-2}, "rush"]],
    vote:[["Cast your vote and say why", 0.10, {standing:1, approval:1}, {}, "safe"],
          ["Speak last and swing it", 0.40, {influence:3, support:4}, {standing:-2}, "bold"]],
    ruling:[["Decide narrowly", 0.10, {standing:1}, {}, "safe"],
            ["Decide broadly and own it", 0.40, {standing:3, approval:2}, {standing:-2, approval:-2}, "bold"]]
  };
  return C[step] || null;
}
function sitApply(d, sign){
  const y = G.you, out = [];
  if(!d) return "";
  const add = (k, v, lab) => { if(!v) return; y[k] = clamp((y[k] || 0) + v, 0, 100); out.push((v > 0 ? "+" : "") + v + " " + lab); };
  add("standing", d.standing, "standing"); add("influence", d.influence, "influence"); add("approval", d.approval, "approval");
  if(d.funds){ y.funds = Math.max(0, (y.funds || 0) + d.funds); out.push((d.funds > 0 ? "+" : "") + d.funds + " war chest"); }
  if(d.heat){ const r = rivalLive(); if(r){ r.heat = clamp((r.heat || 0) + d.heat, 0, 100); out.push("rival heat " + (d.heat > 0 ? "+" : "") + d.heat); } }
  if(d.support && G.bill && !G.bill.done){ G.bill.sitSupport = (G.bill.sitSupport || 0) + d.support; out.push((d.support > 0 ? "+" : "") + d.support + " bill support"); }
  if(d.pledge && G.bill && !G.bill.done){
    const C = (G.members || []).filter(m => m && !m.gone && m.kind === "member" && !m.machine && !m.pledge).sort(() => Math.random() - 0.5).slice(0, d.pledge);
    C.forEach(m => { m.pledge = 1; m.pledgeDay = G.day; });
    if(C.length) out.push(C.length + " pledged");
  }
  return out.join(" · ");
}
function sitStart(room){
  const D = SIT_DEF[room]; if(!D) return;
  try{ if(TALK.open) closeTalk(); }catch(e){}
  const y = G.you;
  G.sitPrep = G.sitPrep || {};
  const prep = G.sitPrep[room] === G.day;
  SIT.on = {room, D, i:0, li:0, lines:[], cast:sitCast(room), score:0, rush:0, prep, t0:performance.now(), m0:G.minute || 0, tally:[], picked:false};
  try{ kMark({senate:"ksen", court:"kct", exec:"kex", govoffice:"kgv"}[room]); kMarkChamber(); }catch(e){}
  G.running = false;
  sitStep();
}
function sitStep(){
  const S = SIT.on; if(!S) return;
  const step = S.D.steps[S.i];
  S.lines = sitLines(S.room, step, S.cast); S.li = 0; S.picked = false; S.res = "";
  spend(Math.round(S.D.min / S.D.steps.length), Math.round(S.D.en / S.D.steps.length));
  sitDraw(); sitBeat();
}
function sitBeat(){
  const S = SIT.on; if(!S) return;
  clearTimeout(SIT.timer);
  if(S.li < S.lines.length){
    const L = S.lines[S.li++];
    try{ tlog(L[0], L[1], "sit"); }catch(e){}
    sitDraw();
    SIT.timer = setTimeout(sitBeat, SIT.beat);
  } else sitDraw();
}
function sitPick(ci){
  const S = SIT.on; if(!S || S.picked) return;
  const step = S.D.steps[S.i], ch = sitChoices(S.room, step); if(!ch || !ch[ci]) return;
  const c = ch[ci];
  let p = 1 - c[1] + (S.prep ? 0.15 : 0) + ((G.you.standing || 50) - 50) / 250 - S.rush * 0.08;
  if(c[4] === "prep" && !S.prep) p -= 0.45;
  if(c[4] === "deal" && (G.you.funds || 0) < 4) p -= 0.5;
  const ok = Math.random() < p;
  if(c[4] === "rush"){ S.rush++; }
  const r = sitApply(ok ? c[2] : c[3]);
  S.score += ok ? (c[4] === "bold" ? 2 : 1) : -1;
  S.tally.push({step, pick:c[0], ok, r});
  try{ tlog("You", c[0] + ".", "you"); }catch(e){}
  const answer = ok ? pick(["That lands.", "Heads nod down the row.", "Nobody has an answer to that.", "Fair enough."])
                    : pick(["It goes over badly.", "Someone laughs, not kindly.", "The room cools.", "That was thin, and they noticed."]);
  try{ tlog(S.cast.b || "", answer, "sit"); }catch(e){}
  S.res = answer + (r ? " (" + r + ")" : "");
  S.picked = true;
  sitDraw();
}
function sitNext(){
  const S = SIT.on; if(!S) return;
  if(S.li < S.lines.length){ sitBeat(); return; }          /* hurry the line, never the step */
  const step = S.D.steps[S.i];
  if(sitChoices(S.room, step) && !S.picked) return;
  if(step === "vote" || step === "ruling") sitOutcome();
  S.i++;
  if(S.i >= S.D.steps.length){ sitEnd(false); return; }
  sitStep();
}
function sitOutcome(){
  const S = SIT.on, y = G.you;
  const good = S.score >= 2 && S.rush === 0;
  const res = sitApply(good ? {standing:2, influence:1, approval:S.room === "govoffice" ? 3 : 0} : S.score < 0 ? {standing:-2} : {standing:1});
  if(S.room === "exec" || S.room === "govoffice"){
    try{ const st = S.room === "exec" ? (G.states || []).slice().sort((a, b) => (b.unrest || 0) - (a.unrest || 0))[0] : (G.states || []).find(s => s.n === y.state);
      if(st) st.unrest = clamp((st.unrest || 0) - (good ? 3 : 1), 0, 100); }catch(e){}
  }
  S.out = (good ? "A clean sitting." : S.score < 0 ? "A rough sitting." : "A middling sitting.") + (res ? " " + res : "");
  try{ tlog(S.D.chair, S.out, "sit"); }catch(e){}
  if(good && S.prep){ try{ achieve("sitting"); }catch(e){} }
}
function sitEnd(walked){
  const S = SIT.on; if(!S) return;
  clearTimeout(SIT.timer);
  if(walked){ sitApply({standing:-3, influence:-1}); try{ tlog("", "You walked out of the sitting.", "sit"); }catch(e){} }
  SIT.log.push({room:S.room, ms:Math.round(performance.now() - S.t0), gameMin:(G.minute || 0) - S.m0, steps:S.i, walked:!!walked, score:S.score});
  try{ note((walked ? "Walked out of " : "Sat through ") + S.D.title.toLowerCase() + "."); }catch(e){}
  SIT.on = null;
  walkNow();
}
function sitDraw(){
  const S = SIT.on; if(!S) return;
  const step = S.D.steps[S.i], ch = sitChoices(S.room, step);
  const done = S.li >= S.lines.length;
  const lines = S.lines.slice(0, S.li).map(l => '<p class="sit__l"><b>' + sitEsc(l[0]) + '</b> ' + sitEsc(l[1]) + '</p>').join("");
  const prog = S.D.steps.map((s, i) => '<span class="sit__dot' + (i < S.i ? ' is-done' : i === S.i ? ' is-now' : '') + '">' + SIT_STEP_T[s] + '</span>').join("");
  let acts = "";
  if(done && ch && !S.picked) acts = ch.map((c, i) => '<button type="button" class="btn' + (i ? ' btn--ghost' : '') + '" data-sit="' + i + '">' + c[0] + (c[4] === "rush" ? ' <small>(rushes it)</small>' : c[1] >= 0.3 ? ' <small>(risky)</small>' : '') + '</button>').join("");
  else acts = '<button type="button" class="btn" id="sitGo">' + (done ? (S.i === S.D.steps.length - 1 ? "Rise" : "Next step") : "Continue") + '</button>';
  card.innerHTML = '<div class="eyebrow">' + S.D.title + ' · step ' + (S.i + 1) + ' of ' + S.D.steps.length + (S.prep ? ' · you read the file' : '') + '</div>' +
    '<h1>' + SIT_STEP_T[step] + '</h1><div class="sit__prog">' + prog + '</div>' +
    '<div class="sit__lines">' + lines + '</div>' + (S.res ? '<p class="dream">' + S.res + '</p>' : '') + (S.out && step !== "adjourn" ? '' : (S.out && step === "adjourn" ? '<p class="dream">' + S.out + '</p>' : '')) +
    '<div class="card__actions">' + acts + '<button type="button" class="btn btn--ghost" id="sitOut">Walk out</button></div>';
  veil.hidden = false;
  const g = el("sitGo"); if(g) g.addEventListener("click", sitNext);
  el("sitOut").addEventListener("click", () => sitEnd(true));
  card.querySelectorAll("[data-sit]").forEach(b => b.addEventListener("click", () => sitPick(+b.getAttribute("data-sit"))));
  try{ refreshPicks(); }catch(e){}
}
function sitPrepAct(room){
  return {t:"Read the file before you sit", c:"20m", off:(G.sitPrep || {})[room] === G.day, run(){
    spend(20, 2); G.sitPrep = G.sitPrep || {}; G.sitPrep[room] = G.day;
    setSay("You read it twice and mark the pages. Tomorrow's surprises will be today's notes.", fx("prepared for the sitting", "20 minutes"));
  }};
}
(function(){
  try{ if(!ACH.some(a => a.k === "sitting")) ACH.push({k:"sitting", t:"Order of the Day", d:"Prepared for a sitting and ran it clean."}); }catch(e){}
  try{
    const st = document.createElement("style");
    st.textContent = ".sit__prog{display:flex;flex-wrap:wrap;gap:4px;margin:6px 0 10px}.sit__dot{font-size:11px;padding:2px 7px;border-radius:9px;background:rgba(0,0,0,.06);opacity:.6}" +
      ".sit__dot.is-done{opacity:.9;background:rgba(150,120,60,.18)}.sit__dot.is-now{opacity:1;background:rgba(150,120,60,.45);font-weight:600}" +
      ".sit__lines{max-height:38vh;overflow:auto}.sit__l{margin:4px 0}";
    document.head.appendChild(st);
  }catch(e){}
})();

function kDeskActs(room){
  const you = G.you, mine = kHolds(room), A = [];
  if(mine) A.push({t:"Use the powers of your office", c:"opens your office", run(){ kMarkChamber(); officeCard(); }});
  if(room === "senate"){
    if(mine) A.push(sitPrepAct("senate"));
    if(mine) A.push({t:"Sit the Senate: take the floor", c:"60m · step by step", off:kOnceToday("ksen"), run(){ sitStart("senate"); return null; }});
    else A.push({t:"Watch from the gallery rail", c:"20m", run(){
      spend(20, 2);
      setSay("Six desks occupied, one Senator talking, a clerk reading the journal under her breath. It is slower than the House and nobody here minds.", "");
    }});
  } else if(room === "court"){
    if(mine) A.push(sitPrepAct("court"));
    if(mine) A.push({t:"Hear oral argument", c:"90m · step by step", off:kOnceToday("kct"), run(){ sitStart("court"); return null; }});
    else A.push({t:"Sit in the public seats", c:"30m", run(){
      spend(30, 3);
      const c = (G.cases || []).find(x => x && !x.done);
      setSay(c ? "They are hearing " + c.t + ". The questions from the bench tell you more than the briefs did."
               : "A slow morning in the Court. You learn that the marshal knows every lawyer by their shoes.", "");
    }});
  } else if(room === "exec"){
    if(mine) A.push(sitPrepAct("exec"));
    if(mine) A.push({t:"Take the morning briefing", c:"45m · step by step", off:kOnceToday("kex"), run(){ sitStart("exec"); return null; }});
    else A.push({t:"Leave a letter for the Executive", c:"15m", off:kOnceToday("kexl"), run(){
      spend(15, 2); kMark("kexl");
      setSay("The aide takes it with both hands and promises it will be read. It might even be true.", "");
    }});
  } else if(room === "govoffice"){
    if(mine) A.push(sitPrepAct("govoffice"));
    if(mine) A.push({t:"Hold open hours at the State House", c:"60m · step by step", off:kOnceToday("kgv"), run(){ sitStart("govoffice"); return null; }});
    else A.push({t:"Petition the Governor for the district", c:"30m", off:kOnceToday("kgvp"), run(){
      spend(30, 4); kMark("kgvp");
      you.approval = clamp(you.approval + 1, 0, 100);
      setSay("The secretary writes it all down and reads it back to you. That is more than most offices do.", fx("+1 approval", "30 minutes"));
    }});
  }
  return A;
}
PROPS.senate = [{id:"ksdesk", label:"The Senate desks", sub:"Old mahogany, names carved inside the drawers", x:0, z:6.0, r:2.3,
  acts:() => kDeskActs("senate")}];
PROPS.court = [{id:"kbench", label:"The bench", sub:"Nine feet of oak and a long view", x:0, z:7.6, r:2.4,
  acts:() => kDeskActs("court")}];
PROPS.exec = [{id:"kxdesk", label:"The Executive's desk", sub:"Built from the timbers of a ship nobody remembers", x:0, z:8.7, r:2.3,
  acts:() => kDeskActs("exec")}];
PROPS.govoffice = [{id:"kgdesk", label:"The Governor's desk", sub:"A state map under the glass", x:0, z:7.9, r:2.3,
  acts:() => kDeskActs("govoffice")}];

/* ══════════════════════════════════════════════════════════
   20261012g · ONE CHAIR AT A TIME
   An elected office you win is the job you do. A Governor is not a
   Member of the House: no House vote, no House post, no Cannon office.
   The title is the most senior elected one; appointed work (staff,
   envoy) never outranks it. Each chair keeps its own working day, as
   the real one does, and its own office is where you wake up.
   ══════════════════════════════════════════════════════════ */
const OFFICE_RANK = ["pres", "senate", "bench", "gov", "house"];
function heldOffice(){ const y = G.you; if(!y || y.out) return null; return y.office || "house"; }
function inHouse(){ return heldOffice() === "house"; }
function abroadOffice(){ const k = heldOffice(); return !!k && k !== "house"; }
function officeShort(k){
  if(k === "pres"){ try{ return execTitle(); }catch(e){} }
  return (OFFICES[k] || OFFICES.house).short;
}
function officeSeat(){
  const y = G.you, k = heldOffice();
  if(k === "gov") return "Governor of " + y.state;
  if(k === "senate") return "Senator from " + y.state;
  if(k === "bench") return "the high bench";
  if(k === "pres") return "the Union";
  return y.state + " " + y.dist;
}
const K_HOME_OF = {pres:"exec", gov:"govoffice"};
function homeRoom(){ const k = heldOffice(); return (k && K_HOME_OF[k]) || "office"; }
function inMyWorkRoom(){ try{ return G.room === homeRoom() || G.room === kChamberRoom(); }catch(e){ return false; } }
/* what people call you to your face: the chair you hold, or the highest you held */
function youAddress(){
  const y = G.you; if(!y) return "Representative";
  const k = heldOffice() || OFFICE_RANK.find(o => o !== "house" && officeTermsOf(o) > 0) || "house";
  if(k === "house"){
    if(!y.out && y.post === "speaker") return "Speaker";
    if(!y.out && y.post && /^(ways|judic|armed)$/.test(y.post)) return "Chairman";
    return "Representative";
  }
  return officeShort(k);
}
function seniorElected(){
  const y = G.you; if(!y) return null;
  const held = heldOffice();
  if(held) return held;
  return OFFICE_RANK.find(k => k !== "house" && officeTermsOf(k) > 0) || ((y.terms || 0) > 0 ? "house" : null);
}

/* ── the working day of each chair ───────────────────────── */
function docketFor(k){
  const y = G.you;
  const S = (G.states || []).find(s => s.n === y.state);
  const D = {
    gov:[
      {h:8,  key:"gbrief", t:"Morning briefing", d:"Your secretary reads the state: roads, prisons, the treasury, the weather.", run:() => govBrief2(S)},
      {h:10, key:"kgv",    t:"Open hours at the State House", d:"Citizens, mayors and county clerks, one at a time.", sit:"govoffice"},
      {h:12, key:"gwar",   t:"The bread question", d:"A neighbour holds the grain. What the state may do itself, what it needs the Union's consent for, and who answers.", run:() => { kMark("gwar"); govWarCard(); return null; }},
      {h:13, key:"gdesk",  t:"The statehouse desk", d:S && S.bill ? "On your desk: the " + S.bill.title + ". Sign it or veto it." : "Bills sent over from the legislature.", run:() => govDesk(S)},
      {h:15, key:"gbud",   t:"Agencies and the budget", d:"One department gets the money this week.", run:() => govBudget2(S)},
      {h:17, key:"gpress", t:"Press availability", d:"The capitol reporters, on the record.", run:() => officePress("the State House steps")}
    ],
    senate:[
      {h:13, key:"swar",   t:"The situation abroad", d:"The Reach holds the bread. Authorise, restrain, hold hearings or pass sanctions: the Senate's own levers.", run:() => { kMark("swar"); legWarCard(); return null; }},
      {h:8,  key:"sbrief", t:"Staff meeting", d:"Your chief of staff, legislative director and state director, in their own words.", run:() => senBrief()},
      {h:9,  key:"conf",   t:"Committee: a confirmation hearing", d:"A nominee for the bench, under oath. Question them, then decide.", run:() => { kMark("conf"); confirmCard(); return null; }},
      {h:11, key:"ksen",   t:"The Senate sits", d:"The journal, the question, the roll.", sit:"senate"},
      {h:14, key:"treaty", t:"Treaties and foreign business", d:"A treaty with a neighbour: read the terms, hear both sides, then advise and consent.", run:() => { kMark("treaty"); treatyCard(); return null; }},
      {h:16, key:"scalls", t:"Calls from " + y.state, d:"Three constituents with real problems; what you promise is remembered.", run:() => senCalls()}
    ],
    bench:[
      {h:9,  key:"bconf",  t:"Conference with the other justices", d:"The case, argued in private: four justices in their own words, and your clerks.", run:() => benchConf2()},
      {h:10, key:"kct",    t:"Oral argument", d:"Counsel for each side, and your questions.", sit:"court"},
      {h:13, key:"bcert",  t:"Petitions for review", d:"Choose which cases the Court will hear.", run:() => benchCert()},
      {h:14, key:"bopin",  t:"Write the opinion", d:"Pick your side and how far to write; three votes make it the Court's.", run:() => benchOpinion()}
    ],
    pres:[
      {h:8,  key:"kex",    t:"The morning briefing", d:"The overnight file: states, realms, the treasury.", sit:"exec"},
      {h:9,  key:"pwar",   t:"The situation room", d:"A neighbour holds the bread. Sanctions, convoys, a blockade, war: as far as the law lets you, and with Congress if it does not.", run:() => { kMark("pwar"); warCard(); return null; }},
      {h:11, key:"pacts",  t:"Acts awaiting signature", d:"Sign or veto what the House and Senate send.", run:() => presActs()},
      {h:14, key:"cab",    t:"Cabinet", d:"Appoint, or hear the secretaries out.", power:"Appoint a cabinet secretary"},
      {h:16, key:"aid",    t:"Calls with foreign capitals", d:"Three heads of government on the line, in their own words. Aid, trade or a warning.", run:() => presForeign()},
      {h:17, key:"ppress", t:"The press room", d:"Questions from the whole Union.", run:() => officePress("the Executive's press room")}
    ]
  };
  return D[k] || [];
}
function docketToday(){ const k = heldOffice(); return k && k !== "house" ? docketFor(k) : []; }
function docketDone(){ return docketToday().filter(d => kOnceToday(d.key)).length; }
function docketNext(){
  const m = G.minute || 0;
  if(m >= 19*60) return null;
  return docketToday().find(d => !kOnceToday(d.key) && m >= d.h*60 - 60) || null;
}
const DK_ROOM = {conf:"committee", treaty:"senate", swar:"senate", sbrief:"office", scalls:"office", bconf:"court", bcert:"court", bopin:"office", pwar:"exec", cab:"exec", aid:"exec", pacts:"exec", gbrief:"govoffice", gwar:"govoffice", gdesk:"govoffice", gbud:"govoffice"};
function docketAfter(d, want){ let n = 0; const t = setInterval(() => { n++; if(G.room === want && !G.moving && G.running !== false){ clearInterval(t); try{ docketRun(d); }catch(e){} } else if(n > 16) clearInterval(t); }, 500); }
function docketRun(d, here){
  if(!d || kOnceToday(d.key)) return;
  if(!here){ const sr = d.sit ? String(d.sit).split(":")[0] : null, chamber = sr && ["senate", "court", "committee", "caucus", "floor"].indexOf(sr) >= 0 ? sr : null, want = chamber || DK_ROOM[d.key] || null;
    if(want){ if(G.room !== want){ goTo(want); try{ feed("You walk to " + (ROOMS[want] ? ROOMS[want].t : want) + " for " + d.t.toLowerCase() + "."); }catch(e){} docketAfter(d, want); return; } }
    else if(G.room !== homeRoom() && !inMyWorkRoom()){ goTo(homeRoom()); docketAfter(d, homeRoom()); return; } }
  if(d.sit){ sitStart(d.sit); return; }
  if(d.power){
    const p = rolePowers().find(x => x.t.indexOf(d.power) === 0);
    if(!p || p.off){ kMark(d.key); note("Nothing for " + d.t.toLowerCase() + " today."); refreshPanels(); return; }
    spend(20, 4);
    const r = p.run(); kMark(d.key);
    if(r) note(r, true);
    refreshPanels(); return;
  }
  const r = d.run ? d.run() : "";
  if(r === null) return;
  kMark(d.key);
  if(r) note(r, true);
  refreshPanels();
}
/* ── the governor's staff, agency heads and appointees: real people with views, not a click ── */
const GOV_ROLES = {
  chief:{t:"Chief of staff", ax:"lib"}, treasurer:{t:"State treasurer", ax:"econ"}, safety:{t:"Commissioner of public safety", ax:"lib"}, press:{t:"Press secretary", ax:"wel"}
};
const GOV_AGENCIES = {
  roads:{t:"Roads and bridges", head:"Director of public works", ax:"econ", effect:[-1, 3, 1], ask:[14, 30], why:"the bottom road, the bridge on the river road, and the culverts nobody has inspected"},
  schools:{t:"Schools", head:"Superintendent of schools", ax:"wel", effect:[-3, 1, 2], ask:[12, 26], why:"three teachers where the state cheque was late, and a roof that is not a roof"},
  police:{t:"The constabulary", head:"Chief of the state constabulary", ax:"lib", effect:[-4, 0, -1], ask:[10, 24], why:"men on the corners, a second radio net, and the overtime nobody budgeted"},
  health:{t:"Hospitals and the poor", head:"Commissioner of health", ax:"wel", effect:[-2, -1, 3], ask:[12, 28], why:"the maternity floor, the county hospitals' arrears, and the poor-relief rolls"}
};
function mkOfficial(key, S, roleTitle){
  const r = rng(seedOf("off:" + key + ":" + ((G.you && G.you.name) || "")));
  const bg = BACKGROUNDS[Math.floor(r() * BACKGROUNDS.length)], cr = CREEDS[Math.floor(r() * CREEDS.length)], og = ORIGINS[Math.floor(r() * ORIGINS.length)];
  const pos = {}; AXES.forEach(a => { pos[a.k] = clamp(Math.round((bg.pos[a.k] || 0) + (cr.pos[a.k] || 0) * 0.5 + (og.pos[a.k] || 0) * 0.5 + (r() - 0.5) * 36), -100, 100); });
  let name = ""; try{ name = wallSafeMint(() => newName(S ? S.n : null)); }catch(e){}
  if(!name) name = "A. Official";
  return {name, role:roleTitle, bg:bg.t, creed:cr.k, origin:og.k, pos, temper:Math.round(25 + r() * 60), warm:0, since:G.day};
}
function govStaff(S){
  if(!S) return {};
  S.cab = S.cab || {}; S.agency = S.agency || {};
  Object.keys(GOV_ROLES).forEach(k => { if(!S.cab[k]) S.cab[k] = mkOfficial("cab:" + k + ":" + S.n, S, GOV_ROLES[k].t); });
  Object.keys(GOV_AGENCIES).forEach(k => { if(!S.agency[k]) S.agency[k] = mkOfficial("ag:" + k + ":" + S.n, S, GOV_AGENCIES[k].head); });
  return S;
}
function viewWords(pos){
  const top = AXES.map(a => ({a, v:pos[a.k] || 0})).filter(x => Math.abs(x.v) >= 14).sort((x, y) => Math.abs(y.v) - Math.abs(x.v)).slice(0, 2);
  if(!top.length) return "has no strong line on anything, which is itself a position";
  return "leans " + top.map(x => (x.v > 0 ? x.a.hi : x.a.lo)).join(" and ") + (Math.abs(top[0].v) > 45 ? ", firmly" : "");
}
function officialHTML(o, extra){
  const cr = creedOf(o.creed);
  return '<b>' + pcEsc(o.name) + '</b> <span class="muted">· ' + pcEsc(o.role) + '</span><div class="muted" style="font-size:12px">' + pcEsc(cap(o.bg)) + ', of ' + pcEsc(cr.t) + '. ' + pcEsc(cap(viewWords(o.pos))) + '.' + (extra ? " " + extra : "") + '</div>';
}
function govCardOpen(eyebrow, title, intro, body, closeKey){
  /* drawing the same card again (after pressing something on it) keeps your place, and whatever it says in reply is scrolled into view */
  const keepTop = (!veil.hidden && card.getAttribute("data-gcT") === title) ? [veil.scrollTop, card.scrollTop] : null;
  G.running = false;
  card.innerHTML = '<div class="eyebrow">' + pcEsc(eyebrow) + '</div><h1>' + pcEsc(title) + '</h1>' + (intro ? '<p class="dream">' + pcEsc(intro) + '</p>' : '') + body +
    '<div id="gcSay" class="dream"></div><div class="card__actions"><button type="button" class="btn" id="gcClose">Close</button></div>';
  veil.hidden = false; card.setAttribute("data-gcT", title);
  if(keepTop){ veil.scrollTop = keepTop[0]; card.scrollTop = keepTop[1]; }
  try{ const gs = el("gcSay"); if(gs && window.MutationObserver) new MutationObserver(() => { try{ gs.scrollIntoView({block:"nearest"}); }catch(e){} }).observe(gs, {childList:true, characterData:true, subtree:true}); }catch(e){}
  el("gcClose").addEventListener("click", () => { if(closeKey){ try{ kMark(closeKey); }catch(e){} } walkNow(); try{ refreshPanels(); }catch(e){} });
}
function advisorLine(o, S, topic){
  const p = o.pos, tilt = a => p[a] || 0;
  const hot = (S.unrest || 0) > 55, calm = (S.unrest || 0) < 30, ind = Math.round(S.ind || 0);
  const towns = (function(){ try{ return (townsOf(S.n) || []).map(t => t.name); }catch(e){ return []; } })();
  const town = towns.length ? towns[Math.floor(seedOf("t:" + o.name + G.day) % towns.length)] : "the county seat";
  if(topic === "chief"){
    const b = S.bill, dir = b ? b.dir * (b.axis === "econ" ? 1 : 1) : 0;
    const bl = b ? "The legislature has sent over the " + b.title + ". " + (tilt(b.axis || "econ") * dir > 12 ? "I would sign it: it is where I stand, and where most of the majority stands." : tilt(b.axis || "econ") * dir < -12 ? "I would not sign it; it cuts against what I believe, and I would rather tell you than pretend." : "I can argue it either way, so I will let you hear the arguments first.") : "Nothing has come over from the legislature, which gives us a clear desk.";
    return "Morning, " + youAddress() + ". " + bl + " Your approval is at " + Math.round(G.you.approval) + ". " + (G.you.approval < 45 ? "That is low enough that I would take a public question today." : "That is comfortable, so do not spend it on anything small.");
  }
  if(topic === "treasurer"){
    const avail = govAvail(S);
    const lean = tilt("econ") > 20 ? "I would rather leave it in the private economy: bank some, cut a levy next session, and let the contractors bid." : tilt("econ") < -20 ? "I would spend it where the counties can see it, on works the state owns, and keep the contractors honest." : tilt("wel") > 20 ? "I would keep a reserve for hardship before anything else." : "I would rather not tell you what to do with it before you have heard the departments.";
    return "The state has " + curF(avail) + " unallocated this week. Industry stands at " + ind + ". " + lean;
  }
  if(topic === "safety"){
    const lean = tilt("lib") < -20 ? "I want the constables visible, and I want curfews in " + town + " considered before somebody is hurt." : tilt("lib") > 20 ? "I would stand the patrols down in " + town + " and let the mayor and the clergy keep the peace; a constable on every corner makes a crowd." : "I will watch " + town + " and tell you the moment it changes.";
    return (hot ? "Unrest is high: crowds outside two county courthouses, and " + town + " is the worst of it. " : calm ? "The counties are quiet. " : "The counties are restless, not yet angry. ") + lean;
  }
  const t = G.world && G.world.foe ? (WORLD_POWERS.find(x => x.k === G.world.foe) || {}).t : null;
  return "The Standard is running the day your way and the Courier is asking who pays. " + (t ? "The wire says " + t + " is the story abroad, and a reporter will ask you about it." : "Nothing abroad to ask about.") + " " + (tilt("wel") > 20 ? "I would answer any question about the poor first. People believe that of you." : tilt("wel") < -20 ? "I would answer any question about the budget first. The papers will not forgive vagueness." : "Whatever you decide to say, say it once, plainly.");
}
function govAvail(S){ return Math.round((18 + (S.ind || 50) * 0.28 + (seedOf("av:" + S.n + ":" + G.day) % 10)) ) * 1000; }
function govBrief2(S){
  if(!S){ return "The secretary reads the day's file. Nothing in it is on fire."; }
  govStaff(S);
  const y = G.you, did = {};
  const adv = ["chief", "treasurer", "safety", "press"].map(k => ({k, o:S.cab[k], line:advisorLine(S.cab[k], S, k)}));
  const acts = {
    chief:[{t:"Take the public question", d:"Approval, if it lands", run(){ y.approval = clamp(y.approval + (chance(0.6) ? 2 : -1), 0, 100); return "You take a question on the steps and the Courier gets its answer."; }}, {t:"Keep a clear desk", d:"Nothing spent", run(){ return "You keep the day clear and the papers wait."; }}],
    treasurer:[{t:"Bank part of it", d:"Industry steady, hardship waits", run(){ S.ind = clamp(S.ind + 1, 0, 100); return "A quarter goes into the reserve."; }}, {t:"Release it to the counties", d:"Unrest down, treasury thinner", run(){ S.unrest = clamp(S.unrest - 2, 0, 100); return "The counties are told the cheques are coming."; }}],
    safety:[{t:"More patrols", d:"Order now, resentment later", run(){ S.unrest = clamp(S.unrest - 3, 0, 100); y.approval = clamp(y.approval - 1, 0, 100); return "Constables on the corners of the worst streets."; }}, {t:"Stand the patrols down", d:"Quieter streets, louder papers", run(){ S.unrest = clamp(S.unrest + (chance(0.5) ? 2 : -2), 0, 100); y.approval = clamp(y.approval + 1, 0, 100); return "The patrols come off; the mayors are asked to keep the peace."; }}],
    press:[{t:"Lead with the poor", d:"Approval at home", run(){ y.approval = clamp(y.approval + 2, 0, 100); return "You lead with the maternity floor and the Courier prints it."; }}, {t:"Lead with the budget", d:"Standing with the Standard", run(){ y.standing = clamp(y.standing + 1, 0, 100); return "You lead with the balance sheet."; }}]
  };
  const body = adv.map(a => '<div style="margin:10px 0;padding:8px 10px;border-left:3px solid var(--line-soft)">' + officialHTML(a.o) + '<p style="margin:6px 0">“' + pcEsc(a.line) + '”</p>' +
    '<div class="card__actions" style="flex-wrap:wrap">' + acts[a.k].map((x, j) => '<button type="button" class="btn btn--ghost" data-adv="' + a.k + ':' + j + '" title="' + pcEsc(x.d) + '">' + pcEsc(x.t) + '</button>').join("") +
    '<button type="button" class="btn btn--ghost" data-why="' + a.k + '">Ask why</button></div><div class="dream" id="adv_' + a.k + '"></div></div>').join("");
  govCardOpen("Morning briefing · " + (y.state || ""), "Your advisors, in their own words", "Each of them has their own line, and none of them is you. Act on one or none.", body, "gbrief");
  card.querySelectorAll("[data-why]").forEach(b => b.addEventListener("click", () => { const k = b.getAttribute("data-why"), o = S.cab[k], cr = creedOf(o.creed), og = originOf(o.origin);
    el("adv_" + k).textContent = "“I am " + o.bg + ", of " + cr.t + ", and my people carry the grievance " + og.grievance + ". That is why I read it the way I do. Another adviser will read it differently, and you should let them.”"; }));
  card.querySelectorAll("[data-adv]").forEach(b => b.addEventListener("click", () => { const [k, j] = b.getAttribute("data-adv").split(":"); if(did[k]) return; did[k] = 1; spend(10, 1);
    const r = acts[k][+j].run(); el("adv_" + k).textContent = r; S.cab[k].warm = (S.cab[k].warm || 0) + 1; try{ tlog("You", r, "you"); }catch(e){} }));
  return null;
}
/* the budget: four agency heads, each with their own case and their own view */
function govBudget2(S){
  if(!S){ return "Nothing on the budget today."; }
  govStaff(S);
  const y = G.you, avail = govAvail(S), W = {};
  const reqs = Object.keys(GOV_AGENCIES).map(k => { const A = GOV_AGENCIES[k], o = S.agency[k], r = rng(seedOf("req:" + k + ":" + S.n + ":" + G.day)); const ask = Math.round((A.ask[0] + r() * (A.ask[1] - A.ask[0]))) * 1000; return {k, A, o, ask}; });
  const pitch = q => { const t = q.o.pos[q.A.ax] || 0, A = q.A; const X = DK_AXIS[A.ax], lean = Math.abs(t) > 20 ? "My own bent is toward " + (t > 0 ? X.hi.w : X.lo.w).toLowerCase() + ", and you should weigh my case knowing it; " + (t > 0 ? "I will still argue that " : "I will argue that ") + A.t.toLowerCase() + " cannot wait." : "I will not pretend I have a doctrine; I have a list.";
    return "We need " + curF(q.ask) + " for " + A.why + ". " + lean + " If you cannot do it all, half buys the first of it and I will come back in the spring."; };
  const body = '<p class="muted">Unallocated this week: <b>' + curF(avail) + '</b>. The four requests come to ' + curF(reqs.reduce((a, q) => a + q.ask, 0)) + '. You can fund one in full, or half of one and keep the rest.</p>' +
    reqs.map(q => '<div style="margin:10px 0;padding:8px 10px;border-left:3px solid var(--line-soft)">' + officialHTML(q.o) + '<p style="margin:6px 0">“' + pcEsc(pitch(q)) + '”</p><div class="muted" style="font-size:12px">' + pcEsc(q.A.t) + ': unrest ' + (q.A.effect[0] > 0 ? "+" : "") + q.A.effect[0] + ', industry ' + (q.A.effect[1] > 0 ? "+" : "") + q.A.effect[1] + ', approval ' + (q.A.effect[2] > 0 ? "+" : "") + q.A.effect[2] + ' at full funding.</div>' +
      '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" data-bud="' + q.k + ':1"' + (q.ask > avail ? ' disabled title="More than the state has this week"' : '') + '>Fund in full ' + curF(q.ask) + '</button><button type="button" class="btn btn--ghost" data-bud="' + q.k + ':0.5">Half ' + curF(Math.round(q.ask / 2000) * 1000) + '</button><button type="button" class="btn btn--ghost" data-bud="' + q.k + ':0">Refuse</button></div></div>').join("");
  govCardOpen("Agencies and the budget", "This week's money", "Four people who run four departments, each sure theirs is the one that cannot wait.", body, null);
  card.querySelectorAll("[data-bud]").forEach(b => b.addEventListener("click", () => { const [k, f] = b.getAttribute("data-bud").split(":"), q = reqs.find(x => x.k === k), frac = +f; if(!q || W.done) return; W.done = 1; spend(30, 3);
    const e = q.A.effect; S.unrest = clamp(S.unrest + Math.round(e[0] * frac), 0, 100); S.ind = clamp(S.ind + Math.round(e[1] * frac), 0, 100); y.approval = clamp(y.approval + Math.round(e[2] * frac), 0, 100);
    q.o.warm = (q.o.warm || 0) + (frac >= 1 ? 3 : frac > 0 ? 1 : -3);
    const react = reqs.map(x => { if(x.k === k) return x.o.name + (frac >= 1 ? ": “Thank you. You will see it on the first of the month.”" : frac > 0 ? ": “Half is a start. I will be back in the spring.”" : ": “I will put it in writing that you refused me.”"); x.o.warm = x.o.warm || 0; return x.o.name + ": “" + (frac > 0 ? "Noted. We will make do." : "At least you were even-handed.") + "”"; }).join("\n");
    el("gcSay").style.whiteSpace = "pre-line"; el("gcSay").textContent = (frac > 0 ? "You fund " + q.A.t.toLowerCase() + (frac < 1 ? " by half" : "") + ". " : "You refuse " + q.A.t.toLowerCase() + ". ") + "\n" + react;
    card.querySelectorAll("[data-bud]").forEach(x => x.disabled = true); try{ kMark("gbud"); }catch(e){}
    feed("Governor " + surname(y.name) + (frac > 0 ? " funded " + q.A.t.toLowerCase() + "." : " refused the " + q.A.t.toLowerCase() + " request."), frac > 0 ? "good" : "bad"); }));
  return null;
}
/* appointments: named people with views, who backs them, and the cost */
const APPT = {
  judge:{t:"a state judge", post:"Judge of the state bench", ax:"lib", ctx:"A seat on the state bench has fallen open. The bench rules on what the statehouse writes."},
  roads:{t:"a director of public works", post:GOV_AGENCIES.roads.head, ax:"econ", ctx:"The roads are a quarrel about whether the state builds or the market bids."},
  schools:{t:"a superintendent of schools", post:GOV_AGENCIES.schools.head, ax:"wel", ctx:"The schools are a quarrel about how much the state provides."},
  police:{t:"a chief of the constabulary", post:GOV_AGENCIES.police.head, ax:"lib", ctx:"The constabulary is a quarrel about order and liberty."},
  health:{t:"a commissioner of health", post:GOV_AGENCIES.health.head, ax:"wel", ctx:"The hospitals are a quarrel about thrift and provision."},
  cab:{t:"a cabinet secretary", post:"Secretary", ax:"econ", ctx:"A cabinet post has fallen open. The Senate will have to confirm whoever you name."}
};
function appointCard(kind){
  const y = G.you, S = (G.states || []).find(s => s.n === y.state), P = APPT[kind]; if(!P) return null;
  const cands = [0, 1, 2].map(i => { const o = mkOfficial("appt:" + kind + ":" + G.day + ":" + i, S, P.post);
    if(i === 0) o.pos[P.ax] = clamp(o.pos[P.ax] + 40, -100, 100); if(i === 1) o.pos[P.ax] = clamp(o.pos[P.ax] - 40, -100, 100);
    const backers = AXES.filter(a => Math.abs(o.pos[a.k]) > 25).sort((a, b) => Math.abs(o.pos[b.k]) - Math.abs(o.pos[a.k]))[0];
    const stake = backers ? (DK_STAKE[backers.k] || []).filter(x => x[1] * (o.pos[backers.k] || 0) > 0).map(x => x[0]) : [];
    const foes = backers ? (DK_STAKE[backers.k] || []).filter(x => x[1] * (o.pos[backers.k] || 0) < 0).map(x => x[0]) : [];
    const odds = Math.round(clamp(60 + (y.standing - 50) / 2 + (S && S.lean ? (o.pos.econ - S.lean) * -0.1 : 0) + (i === 1 ? -6 : 0), 20, 95));
    return {o, backers:stake, foes, odds}; });
  const body = cands.map((c, i) => '<div style="margin:10px 0;padding:8px 10px;border-left:3px solid var(--line-soft)">' + officialHTML(c.o) +
    '<p style="margin:6px 0;font-size:13px"><b>Who backs them:</b> ' + pcEsc(c.backers.length ? listify(c.backers) : "no organised group") + '. <b>Who objects:</b> ' + pcEsc(c.foes.length ? listify(c.foes) : "nobody in particular") + '. <b>Chance it is confirmed without a fight:</b> about ' + c.odds + '%.</p>' +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" data-q="' + i + '">Interview</button><button type="button" class="btn" data-ap="' + i + '">Appoint ' + pcEsc(surname(c.o.name)) + '</button></div><div class="dream" id="aq_' + i + '"></div></div>').join("");
  govCardOpen("Appointments", "Who will be " + P.t + "?", P.ctx + " Three people have put their names forward.", body, null);
  card.querySelectorAll("[data-q]").forEach(b => b.addEventListener("click", () => { const c = cands[+b.getAttribute("data-q")], a = AXES.find(x => x.k === P.ax), v = c.o.pos[P.ax] || 0;
    el("aq_" + b.getAttribute("data-q")).textContent = "“" + (Math.abs(v) < 14 ? "On " + a.n.toLowerCase() + " I follow the evidence and the room. I would rather tell you that than a doctrine." : v > 0 ? "I would push toward " + a.hi + ": a state that " + DK_AXIS[P.ax].hi.does + "." : "I would push toward " + a.lo + ": a state that " + DK_AXIS[P.ax].lo.does + ".") + " I will do what you ask, and I will say so in public if I disagree.”"; }));
  card.querySelectorAll("[data-ap]").forEach(b => b.addEventListener("click", () => { const c = cands[+b.getAttribute("data-ap")]; if(card.querySelector("[data-done]")) return;
    const av = apptVote(kind, c.o, S), ok = av.ok; spend(40, 4);
    if(kind === "cab" && ok){ const m = pick(G.members.filter(x => x.party === y.party && !x.machine && !x.gone && !x.cabinet)); if(m){ m.cabinet = pick(["Treasury", "State", "War", "Interior", "Labour"]); c.o.name = m.name; ripple(m, 12, "Named to the cabinet. I owe this one.", 10, true); } }
    if(ok){ if(S && (GOV_AGENCIES[kind])){ govStaff(S); S.agency[kind] = c.o; } if(kind === "judge"){ y.approval = clamp(y.approval + ((c.o.pos.lib || 0) > 0 ? 1 : 0), 0, 100); } y.standing = clamp(y.standing + 1, 0, 100); try{ y.used = y.used || {}; y.used[kind === "judge" ? "appt" : kind === "cab" ? "cab" : "appt2"] = G.day; }catch(e){} }
    const msg = ok ? c.o.name + " is confirmed as " + P.post.toLowerCase() + " by " + av.body + ", " + av.aye + " to " + av.no + ". " + cap(viewWords(c.o.pos)) + "; you will hear it in how they advise you." : cap(av.body) + " rejects " + c.o.name + ", " + av.aye + " to " + av.no + ". The name is withdrawn and the seat stays open.";
    reactEmit("appoint", {kind, name:c.o.name, ok, post:P.post}); el("gcSay").textContent = msg; feed(msg, ok ? "good" : "bad"); card.querySelectorAll("[data-ap]").forEach(x => { x.disabled = true; x.setAttribute("data-done", "1"); }); }));
  return null;
}
const CASE_BILL = {bread:"the Bread Price Relief Act", order:"the Local Constabulary Aid Act", road:"the Rural Road and Culvert Act", school:"the Schoolhouse and Teachers Act", water:"the Municipal Water Compliance Act", plant:"the Local Industry Retention Act", ballots:"the Special Elections (Mail Ballot) Act", pension:"the Widows' Pension Notice Act"};
/* ── nothing you do stays yours: once it is out, the House, the Senate, the bench, the executive and the neighbours each have their own job to do about it ── */
function reactEmit(kind, data, delay){
  G.react = G.react || []; G.react.push({kind, data:data || {}, due:(G.day || 0) + (delay == null ? 1 : delay), from:G.day});
  const who = {actSigned:"the courts, the House and the press", actVetoed:"the Speaker and the Senate leader", stateBill:"the statehouse, the Union's attorney and the press", treaty:"the executive, their assembly and the hawks",
    confirm:"the bench and the minority", foreign:"the opposition, the rival realms and the press", appoint:"the legislature and the department", ruling:"Congress and the states", senVote:"the House and the President"}[kind] || "everyone concerned";
  try{ feed("Word is out. " + cap(who) + " will answer it tomorrow.", ""); }catch(e){}
}
function reactAct(title, pos, signed){ reactEmit(signed ? "actSigned" : "actVetoed", {title, pos:pos || null}); }
function reactState(S, b, signed){ try{ reactEmit("stateBill", {state:S ? S.n : (G.you && G.you.state), title:b.title, signed, ind:b.ind || 0, unrest:b.unrest || 0, dir:b.dir || 1, axis:b.axis || "econ"}); }catch(e){} }
function reactHolder(post, party){
  const m = (G.members || []).filter(x => x && !x.gone && x.kind === "member");
  return m.find(x => x.post === post) || (party ? m.find(x => x.party === party) : null) || m[Math.floor(Math.random() * Math.max(1, m.length))] || null;
}
function reactSay(m, text, news){
  try{ feed(text); journal(text); }catch(e){}
  try{ if(m){ voxInit(); voxAdd({id:G.vox.id++, by:m.id, t:text, k:"react", v:0, day:G.day, at:hhmm(), backs:Math.round(Math.random() * 40), hits:Math.round(Math.random() * 25), voices:[], mine:false}); } }catch(e){}
