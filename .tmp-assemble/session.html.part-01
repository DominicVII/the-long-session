const KIN_SP = {M:"husband", F:"wife"};
function kinPeople(p){ const K = kinEnsure(p), a = []; if(K.spouse && K.spouse.alive !== false && !K.spouse.ex) a.push(Object.assign({rel:KIN_SP[K.spouse.sex] || "spouse", w:6}, K.spouse)); K.kids.forEach(k => a.push(Object.assign({}, k, {rel:k.sex === "F" ? "daughter" : "son", w:4, job:k.job || "student"}))); K.parents.filter(x => x.alive).forEach(x => a.push(Object.assign({}, x, {rel:x.role, w:3}))); K.siblings.forEach(x => a.push(Object.assign({}, x, {rel:x.role, w:x.tie === "close" ? 2.5 : 1}))); return a; }
function kinSway(p, bill){
  try{
    if(!p || p === G.you || !bill || !bill.pos) return 0; const K = kinEnsure(p); let v = 0;
    const ck = (bill.title || "") + "|" + (bill.pos.econ | 0) + "|" + (bill.pos.lib | 0) + "|" + (bill.pos.def | 0) + "|" + (bill.pos.wel | 0); K._sw = K._sw || {}; if(K._sw[ck] != null) return K._sw[ck];
    kinPeople(p).forEach(f => { const J = KIN_JOBS[f.job] || KIN_JOBS.clerk; AXES.forEach(a => { const bp = bill.pos[a.k] || 0, fp = (J.pos && J.pos[a.k]) || 0; if(Math.abs(bp) >= 8 && fp) v += Math.sign(bp) * (fp / 100) * (Math.abs(bp) / 50) * f.w * 0.8; }); });
    const wel = (bill.pos.wel || 0) / 50, econ = (bill.pos.econ || 0) / 50;
    if(K.parents.some(x => x.alive && x.need !== "none")) v += wel * 4; if(K.kids.some(x => x.ill) || (K.spouse && K.spouse.health === "ill")) v += wel * 4;
    if(K.wealth === "struggling") v -= econ * 3; if(K.wealth === "old money") v += econ * 3;
    v = clamp(v, -12, 12); K._sw[ck] = v; return v;
  }catch(e){ return 0; }
}
function kinNote(f){ return "their " + f.rel + " " + f.name + (f.job && f.rel !== "son" && f.rel !== "daughter" ? ", " + kinArt(f.job) : f.age && f.age < 18 ? " (" + f.age + ")" : "") + (f.need && f.need !== "none" ? " (" + f.need + ")" : ""); }
function kinTensions(p){
  const K = kinEnsure(p), out = [], b = G.bill && !G.bill.done ? G.bill : null, sp = K.spouse, pr = sp ? kinPro(sp.sex) : null, spw = sp ? KIN_SP[sp.sex] : "";
  if(sp && K.marital === "married" && sp.party && p.party && sp.party !== p.party) out.push("Their " + spw + " " + sp.name + " votes " + (sp.party === "FED" ? "Federalist" : sp.party === "COM" ? "Commonwealth" : "independent") + " and says so at dinner.");
  if(sp && K.marital === "married" && sp.supportive < -0.2) out.push("Their " + spw + " " + sp.name + " has said plainly that " + pr.he + " does not want the life this job brings.");
  K.siblings.forEach(x => { const px = kinPro(x.sex); if(x.tie === "estranged") out.push("They have not spoken to their " + x.role + " " + x.name + " in years."); if(x.tie === "rival") out.push("Their " + x.role + " " + x.name + " resents how far " + px.he + " has come."); if(x.debt) out.push("Their " + x.role + " " + x.name + " owes money to people it is unwise to owe."); if(x.office) out.push("Their " + x.role + " " + x.name + " is " + kinArt(x.office) + (x.party && p.party && x.party !== p.party ? ", in the other party" : "") + "."); });
  const par = K.parents.filter(x => x.alive && x.need !== "none")[0]; if(par) out.push("Their " + par.role + " " + par.name + " is " + par.need + ", and somebody has to be there.");
  const ik = K.kids.find(x => x.ill); if(ik) out.push("Their " + (ik.sex === "F" ? "daughter " : "son ") + ik.name.split(" ")[0] + " is unwell, and nothing else matters on those days.");
  if(K.kids.some(x => x.state === "small")) out.push("Young children at home, and sleep is a rumour.");
  if(K.wealth === "struggling") out.push("Money is short at home, whatever the job pays on paper.");
  if(K.inlaws && K.inlaws.tie === "difficult") out.push("Their " + (sp && sp.sex === "F" ? "wife's" : "husband's") + " family thinks they married down.");
  if(!K.spouse && !K.kids.length && !K.parents.some(x => x.alive) && !K.siblings.length) out.push("No family left to speak of: nobody to come home to, and nobody to tell them to stop.");
  if(b){ kinPeople(p).forEach(f => { const J = KIN_JOBS[f.job]; if(!J || (f.rel === "son" || f.rel === "daughter") && f.age < 17) return; let dot = 0; AXES.forEach(a => { dot += Math.sign(b.pos[a.k] || 0) * ((J.pos && J.pos[a.k]) || 0) * Math.min(1, Math.abs(b.pos[a.k] || 0) / 40); }); if(dot < -12) out.push("The " + b.title + " cuts against " + kinNote(f) + "."); else if(dot > 16 && f.w >= 2.5) out.push("The " + b.title + " would help " + kinNote(f) + "."); }); }
  return out;
}
function kinRunScore(p){
  const K = kinEnsure(p), n = []; let sc = 50;
  if(K.dynasty){ sc += K.dynasty.strength * 0.25; n.push("a name that carries: " + K.dynasty.who + " was " + kinArt(K.dynasty.office) + " " + K.dynasty.years + " years ago"); }
  sc += {"old money":12, comfortable:6, modest:0, struggling:-8}[K.wealth]; if(K.wealth === "old money") n.push("old money behind them"); if(K.wealth === "struggling") n.push("money is a worry");
  if(K.spouse && K.marital === "married"){ sc += K.spouse.supportive * 9; n.push(K.spouse.supportive > 0.3 ? K.spouse.name + " backs the run" : K.spouse.supportive < -0.2 ? K.spouse.name + " does not want it" : K.spouse.name + " is wary"); } else if(!K.spouse){ sc += 3; n.push("no spouse to persuade"); }
  const care = K.parents.filter(x => x.alive && x.need !== "none").length + (K.kids.some(x => x.ill) ? 1 : 0); if(care){ sc -= care * 10; n.push("caring for family"); }
  const small = K.kids.filter(x => x.state === "small").length; if(small){ sc -= small * 5; n.push(small + " small child" + (small > 1 ? "ren" : "")); }
  if(K.siblings.some(x => x.office)){ sc += 4; n.push("a sibling in office"); } if(K.siblings.some(x => x.debt)){ sc -= 3; n.push("a sibling's debts"); }
  if(K.age > 70) sc -= 10;
  return {score:Math.round(clamp(sc, 5, 95)), notes:n};
}
function kinSummary(p){
  const K = kinEnsure(p), bits = [], sp = K.spouse, spw = sp ? KIN_SP[sp.sex] : "";
  bits.push(K.marital === "married" && sp ? (K.sex === "M" ? "Married to " : "Married to ") + sp.name + ", " + kinArt(sp.job) + "." : K.marital === "widowed" ? (K.sex === "F" ? "A widow" : "A widower") + (sp ? ", after " + sp.name : "") + "." : K.marital === "divorced" ? "Divorced from " + (sp ? sp.name : "a former spouse") + "." : "Unmarried.");
  if(K.kids.length) bits.push(K.kids.length + " child" + (K.kids.length > 1 ? "ren" : "") + ": " + K.kids.map(k => k.name.split(" ")[0] + " (" + (k.sex === "F" ? "daughter" : "son") + ", " + k.age + (k.ill ? ", unwell" : "") + ")").join(", ") + "."); else bits.push("No children.");
  const par = K.parents.filter(x => x.alive); bits.push(par.length ? "Living: " + par.map(x => "their " + x.role + " " + x.name.split(" ")[0] + (x.need !== "none" ? " (" + x.need + ")" : "")).join(", ") + "." : "Both parents gone.");
  if(K.siblings.length) bits.push(K.siblings.map(x => "a " + x.role + ", " + x.name.split(" ")[0] + " (" + x.job + ", " + x.tie + ")").join("; ") + "."); else bits.push("An only child.");
  bits.push("The family is " + K.wealth + "." + (K.dynasty ? " Political name: " + (K.sex === "M" || true ? "their " : "their ") + K.dynasty.who + " was " + kinArt(K.dynasty.office) + "." : ""));
  return bits.join(" ");
}
function kinLine(p){
  const K = kinEnsure(p), par = K.parents.filter(x => x.alive && x.need !== "none")[0], ill = K.kids.find(x => x.ill), small = K.kids.find(x => x.state === "small"), sch = K.kids.find(x => x.state === "school"), sp = K.spouse;
  const L = [];
  if(par) L.push("My " + par.role + " is " + par.need + " again. I will not say I am coping; I am turning up.");
  if(ill) L.push(ill.name.split(" ")[0] + " has not been well, and I have not been much use to anyone this week.");
  if(small) L.push(small.name.split(" ")[0] + " is " + small.age + " and has decided sleep is optional. So I am awake for both of us.");
  if(sch) L.push("My " + (sch.sex === "F" ? "daughter" : "son") + " " + sch.name.split(" ")[0] + " came home with a school report and an opinion about it.");
  if(sp && K.marital === "married"){ const w = KIN_SP[sp.sex], pr = kinPro(sp.sex); L.push(sp.supportive > 0.3 ? "My " + w + " says I should stay in it, and means it, which helps." : sp.supportive < -0.2 ? "My " + w + " asked me last night how much longer. I gave a bad answer." : "My " + w + " is " + kinArt(sp.job) + ". It is not a job that cares about the House."); }
  K.siblings.forEach(x => { if(x.tie === "estranged") L.push("I have a " + x.role + ", " + x.name.split(" ")[0] + ", I do not speak to. Funny how often it comes up here."); if(x.office) L.push("My " + x.role + " " + x.name.split(" ")[0] + " is " + kinArt(x.office) + ". We are not in competition. People assume otherwise."); });
  if(K.dynasty && p.kind === "member") L.push("My " + K.dynasty.who + " was " + kinArt(K.dynasty.office) + ". People still say the name before they say mine.");
  if(K.wealth === "struggling") L.push("Money is tight at home. I do not say so in the corridor.");
  if(!L.length) L.push(K.marital === "single" && !K.kids.length ? "I go home to nobody, which is its own kind of freedom and its own kind of weather." : "Home is quiet this week, which I take as a good sign.");
  return L[Math.floor(Math.random() * L.length)];
}
/* the years go by in other people's houses */
function kinDay(){
  try{
    const pool = (G.members || []).concat(G.civ || []).filter(p => p && !p.gone && p.traits); if(!pool.length) return;
    for(let i = 0; i < 6; i++){
      const p = pool[Math.floor(Math.random() * pool.length)], K = kinEnsure(p), r = Math.random(); let msg = null, w = 1;
      const par = K.parents.find(x => x.alive && x.age > 68);
      if(par && r < 0.02 + (par.need !== "none" ? 0.03 : 0)){ par.alive = false; par.need = "none"; msg = surname(p.name) + "'s " + par.role + ", " + par.name.split(" ")[0] + ", has died. The funeral is on Thursday."; w = 4; }
      else if(r < 0.035 && K.marital === "married" && K.age < 44 && K.kids.length < 4){ const ks = Math.random() < 0.5 ? "M" : "F"; K.kids.push({name:kinName(p, surname(p.name), ks), sex:ks, age:0, state:"small", ill:false, job:null}); msg = surname(p.name) + " and " + (K.spouse ? K.spouse.name.split(" ")[0] : "their partner") + " have had a " + (ks === "F" ? "daughter" : "son") + "."; w = 3; }
      else if(r < 0.045 && K.marital === "single" && K.age > 24 && K.age < 55){ K.marital = "married"; const os = kinSexOf(p) === "M" ? "F" : "M"; K.spouse = {name:kinName(p, null, os), sex:os, job:Object.keys(KIN_JOBS)[Math.floor(Math.random() * 15)], party:KIN_PARTY[Math.floor(Math.random() * 4)], supportive:0.5, alive:true, health:"well"}; msg = surname(p.name) + " has married " + K.spouse.name + "."; w = 3; }
      else if(r < 0.052 && K.marital === "married" && K.spouse && K.spouse.supportive < 0){ K.marital = "divorced"; K.spouse.ex = true; msg = surname(p.name) + "'s marriage has ended. Nobody is saying why."; w = -3; }
      else if(r < 0.06 && K.kids.length){ const k = K.kids[Math.floor(Math.random() * K.kids.length)]; k.ill = !k.ill; if(k.ill){ msg = surname(p.name) + "'s " + (k.sex === "F" ? "daughter " : "son ") + k.name.split(" ")[0] + " is ill."; w = -2; } }
      else if(r < 0.066 && K.siblings.length){ const sb = K.siblings[Math.floor(Math.random() * K.siblings.length)]; if(!sb.debt){ sb.debt = true; msg = surname(p.name) + "'s " + sb.role + " " + sb.name.split(" ")[0] + " is said to be in trouble with money."; w = -2; } }
      if(msg){ K._sw = null; K.events.unshift({d:G.day, t:msg}); if(K.events.length > 6) K.events.length = 6;
        try{ if(p.kind === "member" && p.mem) remember(p, "Family: " + msg, Math.abs(w) * 2, true); }catch(e){}
        if(p.kind === "member" && (p.post || (p.known || 0) >= 1 || p.met)){ G.reactNews = (G.reactNews || []).concat([{t:msg, d:G.day}]).slice(-12); try{ feed(msg); }catch(e){} } }
    }
  }catch(e){ console.warn("kinDay", e); }
}
function kinNet(p){ const K = kinEnsure(p); let n = 0; if(K.spouse && K.marital === "married" && K.spouse.alive !== false){ const J = KIN_JOBS[K.spouse.job] || {inc:0}; n += J.inc * 0.3; } n -= K.kids.filter(k => k.age < 18).length * 3; n -= K.parents.filter(x => x.alive && x.need !== "none").length * 6; if(K.wealth === "old money") n += 8; if(K.wealth === "struggling") n -= 3; return Math.round(n); }
/* before you stand: the family has a say, and so does your purse */
function kinBallotGate(proceed){
  const y = G.you, K = kinEnsure(y), r = kinRunScore(y), notes = r.notes;
  const body = '<p class="muted" style="font-size:13px">' + pcEsc(kinSummary(y)) + '</p>' + (notes.length ? '<p style="font-size:13px"><b>What home thinks of it.</b> ' + pcEsc(notes.join("; ")) + '.</p>' : '') +
    (K.spouse && K.marital === "married" ? '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn btn--ghost" id="kgTalk">Talk it over with ' + pcEsc(K.spouse.name.split(" ")[0]) + ' first (an evening)</button></div>' : '') +
    '<div id="kgSay" class="dream"></div><div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" id="kgGo">Stand, with all of that</button></div>';
  govCardOpen("Before you stand", "Home", "Every run is also a decision for the people you go home to.", body, null);
  let adj = Math.round((r.score - 50) / 8);
  const go = () => { y.kinAdj = adj; walkNow(); setTimeout(proceed, 50); };
  el("kgGo").addEventListener("click", go);
  const t = el("kgTalk"); if(t) t.addEventListener("click", () => { t.disabled = true; spend(120, 3); const sp = K.spouse, ok = chance(0.45 + ((y.approval || 50) - 50) / 200 + (sp.supportive > 0 ? 0.15 : -0.1));
    if(ok){ sp.supportive = clamp(sp.supportive + 0.4, -1, 1); adj += 2; el("kgSay").textContent = sp.name + " listens, argues, and in the end says: “Then do it properly.” You feel steadier."; }
    else { sp.supportive = clamp(sp.supportive - 0.2, -1, 1); adj -= 2; el("kgSay").textContent = sp.name + " says they understand, and the way they say it tells you they do not."; } });
  return null;
}
function kinBrowse(){
  const y = G.you, people = [y].concat((G.members || []).filter(m => m && !m.gone && m.kind === "member" && (m.met || (m.known || 0) >= 1 || m.post)).slice(0, 14));
  const body = people.map(p => { const T = kinTensions(p), R = kinRunScore(p); return '<div style="margin:10px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + pcEsc(p === y ? "You" : p.name) + '</b> <span class="muted">' + (p === y ? '' : pcEsc(p.party || "") + ' · ' + pcEsc(p.state || "")) + ' · able to run: ' + R.score + '</span><div class="muted" style="font-size:12px">' + pcEsc(kinSummary(p)) + '</div>' + (T.length ? '<div style="font-size:12px;margin-top:3px"><b>Strains:</b> ' + pcEsc(T.slice(0, 4).join(" ")) + '</div>' : '') + '</div>'; }).join("");
  govCardOpen("Who is behind them", "The families", "Spouses, children, parents and siblings nobody sees: what they carry, and what it does to a vote or a run. Offhand, but kept.", body, null);
  return null;
}
/* ═════════════════════════════════════════════════════════
   TALKING, MADE READABLE
   The menu is grouped by what you are trying to do, each choice says in plain words what it
   does, every line somebody says gets a "what they meant" (what it is, what is underneath,
   what you could do next), and a short card says who they are to you, where they stand, what
   they want and what is happening at home: what you know, and what you still have to ask.
   ═════════════════════════════════════════════════════════ */
const TALK_CATS = [
  ["Find out", "Learn something without asking for anything.", /^(ask how|ask where|ask what|ask after|ask about|let them talk|hear them out|take the case)/i],
  ["Get closer", "Build goodwill. Nothing is at stake.", /^(talk shop|just talk|introduce yourself|say you understand|make amends|move along)/i],
  ["Persuade", "Ask for something. It can work and it can cost you.", /^(ask for their vote|ask them to cross|threaten|call in|offer a favor|back them|share credit|make the case)/i],
  ["Press and public", "Things you do for the cameras, the donors and the town.", /^(give a quote|background briefing|plant a story|raise money|hold a town hall|nothing today)/i]
];
const TALK_DESC = [
  [/^ask how they'll vote/i, "Find out which way they lean on today's bill. No pressure."],
  [/^ask where they really stand/i, "Ask for their honest position and the reason behind it."],
  [/^ask what they need/i, "Ask what they want right now. People tell you more when asked plainly."],
  [/^ask after their family/i, "Ask about home. It shows you what pulls on them, and most people warm to being asked."],
  [/^ask what has been on their mind/i, "Open question. They steer; you learn what is bothering them."],
  [/^ask about their faith/i, "Their creed shapes what they will and will not do. Handle with care."],
  [/^let them talk/i, "Say nothing and listen. Often the cheapest way to learn."],
  [/^talk shop/i, "Chat about work and where they come from. A little goodwill, and a glimpse of their politics."],
  [/^just talk/i, "Small talk. A little goodwill; costs fifteen minutes."],
  [/^say you understand/i, "Acknowledge what they just told you. It lands better after something personal or a complaint."],
  [/^introduce yourself/i, "Reopen the door. Costs time, no risk."],
  [/^ask for their vote/i, "Ask them to commit. Works if they like you and the bill suits them. Pushed too hard, they dig in."],
  [/^ask them to cross the aisle/i, "Ask them to vote against their own side. A big ask; needs trust."],
  [/^threaten a primary/i, "Warn that you will back someone against them. It can frighten them into line, and they will remember it."],
  [/^call in the favor/i, "Spend a debt they owe you. It works, and the debt is gone."],
  [/^offer a favor/i, "Give them something now so they owe you later."],
  [/^back them for a post/i, "Support them for a committee seat or office. A big gift; they will not forget it."],
  [/^share credit/i, "Give them part of the credit for the bill. Costs you glory, buys loyalty."],
  [/^make amends/i, "Repair something you did. Shows you can be wrong."],
  [/^make the case for yourself/i, "Ask them to back your return. Needs some history between you."],
  [/^give a quote/i, "Say something on the record. Good for approval if it lands; the wrong word can follow you."],
  [/^background briefing/i, "Talk off the record to shape a story without your name on it."],
  [/^plant a story/i, "Feed them something to publish. Powerful, and it can be traced back to you."],
  [/^raise money/i, "Ask for donations to the war chest. Money comes with strings."],
  [/^hold a town hall/i, "Meet the district in public. Builds approval; some of them will shout."],
  [/^take the case/i, "Take up this person's problem. It costs time and wins real gratitude."],
  [/^(leave it|walk away|move along|say nothing and leave)/i, "End the conversation."]
];
function talkDesc(label){ const t = String(label || "").trim(); const h = TALK_DESC.find(x => x[0].test(t)); return h ? h[1] : ""; }
function talkCat(label){ const t = String(label || "").trim(); const h = TALK_CATS.find(x => x[2].test(t)); return h ? h[0] : "More"; }
function gistOf(text){
  let t = String(text || "").replace(/\s+/g, " ").trim(); t = t.replace(/^(look|well|listen|plainly then|so|yes|of course)[,.]\s*/i, "");
  const m = t.match(/^[^.!?]{12,}[.!?]/); let g = m ? m[0] : t; if(g.length > 150) g = g.slice(0, 147).replace(/\s+\S*$/, "") + "…"; return g;
}
function meaningOf(m, text){
  const t = String(text || "").toLowerCase(), tr = m.traits || {}, rel = (m.rel && m.rel.warmth) || 0, trust = (m.rel && m.rel.trust) || 50, out = {type:"", plain:"", under:[], next:[]};
  const has = re => re.test(t);
  if(has(/\b(no\.|no,|not today|i can'?t|i won'?t|not a chance|out of the question|i'd rather not)\b/)){ out.type = "A refusal"; out.plain = "They are saying no."; out.next = ["Back off and talk about something else", "Ask what they need from you"]; }
  else if(has(/\b(think about it|not now|come back|another day|we'?ll see|not yet|maybe|i'?ll see)\b/)){ out.type = "A polite delay"; out.plain = "Not a yes and not a no. They want a reason, or a reason to trust you."; out.next = ["Ask what they need from you", "Ask where they really stand"]; }
  else if(has(/\b(you have it|all right|count me|i'?m with you|glad to|you can count|aye\b|put me down)\b/)){ out.type = "Agreement"; out.plain = "They are agreeing."; out.next = ["Thank them and move on", "Ask after their family"]; }
  else if(has(/\b(my (mother|father|wife|husband|son|daughter|brother|sister|parent|child|uncle|aunt|cousin|grandfather|grandmother)|people still say the name|school report|funeral|the baby|home is|sleep)\b/)){ out.type = "Something personal"; out.plain = "They are telling you something about home."; out.next = ["Say you understand", "Ask after their family"]; }
  else if(has(/\b(tired|sick of|can'?t stand|resent|unfair|disgrace|ridiculous|nobody (asks|listens)|funny how)\b/)){ out.type = "A grievance"; out.plain = "They are complaining about something that matters to them."; out.next = ["Say you understand", "Let them talk"]; }
  else if(has(/\b(i came up|my district|that number is the whole job|i built|i won|never hidden)\b/)){ out.type = "Telling you who they are"; out.plain = "They are explaining where they come from, which is how they will decide things."; out.next = ["Talk shop", "Ask where they really stand"]; }
  else if(has(/\?\s*$/) || has(/^(who|what|why|how|do you|will you|have you|are you)\b/)){ out.type = "A question for you"; out.plain = "They are testing you or asking for something."; out.next = ["Answer plainly", "Ask what they need from you"]; }
  else if(has(/(can'?t name|no word for|there is a word|i keep|something i can'?t|reach(ing)? for)/)){ out.type = "Reaching for something they cannot say"; out.plain = "They are circling something they have no name for yet. It is not a trick."; out.next = ["Let them talk", "Say you understand"]; }
  else { out.type = "Ordinary conversation"; out.plain = "Nothing is being asked. They are feeling you out."; out.next = ["Talk shop", "Ask what they need from you"]; }
  if(rel < -20) out.under.push("They do not trust you yet, so anything you ask will be read as pressure."); else if(rel > 25) out.under.push("They like you, so a no here is about the issue, not about you.");
  if((tr.conviction || 50) > 72) out.under.push("They decide on principle, not on favours."); if((tr.ambition || 50) > 72) out.under.push("They are weighing what this does for their own career.");
  if((tr.vanity || 40) > 72) out.under.push("Being noticed matters to them."); if((tr.loyalty || 50) > 72) out.under.push("The party line counts for a lot with them."); if((tr.temper || 40) > 72) out.under.push("Pushing will make it worse.");
  if((tr.discretion || 50) > 72) out.under.push("They hold things back; what they do not say may matter more.");
  try{ const b = G.bill && !G.bill.done ? G.bill : null; if(b && m.kind === "member" && (m.known || 0) >= 2){ const v = memberVote(m, b); out.under.push("On the " + b.title + " they lean " + (v > 0 ? "aye" : "no") + "."); } }catch(e){}
  try{ if(m.kinKnown || /home|family|mother|father|wife|husband|son|daughter|brother|sister/.test(t)){ const T = kinTensions(m)[0]; if(T) out.under.push("At home: " + T); } }catch(e){}
  out.under = out.under.slice(0, 3); return out;
}
function renderMean(m, text){
  try{
    if(!m || !TALK.open || TALK.m !== m || !text) return; const box = el("tkSay"); if(!box) return;
    let d = el("tkMean"); if(!d){ d = document.createElement("details"); d.id = "tkMean"; d.className = "tkm"; box.parentNode.insertBefore(d, box.nextSibling); d.addEventListener("toggle", () => { try{ G.talkExplainOpen = d.open; }catch(e){} }); }
    const M = meaningOf(m, text); TALK.lastMean = M; d.open = G.talkExplainOpen !== false;
    d.innerHTML = '<summary>What they meant</summary><p><b>' + pcEsc(M.type) + '.</b> ' + pcEsc(M.plain) + '</p><p><i>In short:</i> “' + pcEsc(gistOf(text)) + '”</p>' + (M.under.length ? '<p><b>Underneath.</b> ' + M.under.map(pcEsc).join(" ") + '</p>' : '') + '<p><b>You could:</b> ' + M.next.map(pcEsc).join(" · ") + '</p>';
  }catch(e){ console.warn("mean", e); }
}
function talkBrief(m){
  try{
    const rel = (m.rel && m.rel.warmth) || 0, trust = (m.rel && m.rel.trust) || 50, fam = (familiarity ? familiarity(m) : 0), b = G.bill && !G.bill.done ? G.bill : null;
    const warm = rel > 30 ? "warm" : rel > 8 ? "friendly" : rel > -8 ? "neutral" : rel > -30 ? "cool" : "hostile", tr = trust > 66 ? "trusts you" : trust > 40 ? "trusts you a little" : "does not trust you yet";
    const rows = [["To you", warm + ", and " + tr + (m.rel && m.rel.debtFromYou ? "; owes you a favour" : "")]];
    if(m.kind === "member"){
      rows.push(["Where they stand", b ? ((m.known || 0) >= 2 ? "leans " + (memberVote(m, b) > 0 ? "aye" : "no") + " on the " + b.title : "unknown on the " + b.title + ". Try “Ask how they’ll vote”") : "no bill is live"]);
      const want = m.wantKnown ? ((m.intent && m.intent.t) || "nothing in particular") : null; rows.push(["What they want", want || "you have not asked yet — try “Ask what they need from you”"]);
      const K = kinEnsure(m); rows.push(["At home", m.kinKnown ? kinSummary(m) : "unknown — try “Ask after their family”"]);
      if(fam > 0.5 || canRead(m)) rows.push(["Temperament", traitWords(m)]);
    } else if(m.kind === "civ"){ rows.push(["What they came for", (m.cause || "a problem") + (m.role ? " (" + m.role + ")" : "")]); rows.push(["At home", m.kinKnown ? kinSummary(m) : "unknown — try “Ask after their family”"]); }
    else if(m.kind === "press") rows.push(["Outlet", (m.role || "reporter") + ", " + (m.outlet || "")]);
    return '<dl class="tkb">' + rows.map(r => '<dt>' + pcEsc(r[0]) + '</dt><dd>' + pcEsc(r[1]) + '</dd>').join("") + '</dl>';
  }catch(e){ return ""; }
}
function talkRevamp(m){
  try{
    const th = el("tkThink"); if(th && m && m.kind !== "envoy"){ let bf = el("tkBrief"); if(!bf){ bf = document.createElement("div"); bf.id = "tkBrief"; th.parentNode.insertBefore(bf, th); } bf.innerHTML = '<div class="tkb__h">Who you are talking to</div>' + talkBrief(m); }
    const box = el("tkActs"); if(!box || box.dataset.regrouped === "1") { if(!box) return; }
    const btns = [...box.querySelectorAll(":scope > button")]; if(!btns.length) return;
    const groups = {}; const order = ["Find out", "Get closer", "Persuade", "Press and public", "More", "Leave"];
    btns.forEach(b => { const label = b.firstChild ? (b.childNodes[0].textContent || "") : ""; const cat = b.classList.contains("talk__btn--exit") ? "Leave" : talkCat(label); (groups[cat] = groups[cat] || []).push([b, label]); const d = talkDesc(label); if(d && !b.querySelector(".tkd")){ const sm = document.createElement("small"); sm.className = "tkd"; sm.textContent = d; b.appendChild(sm); b.title = d; } if(b.classList.contains("talk__btn--risk") && !b.querySelector(".tkr")){ const rk = document.createElement("span"); rk.className = "tkr"; rk.textContent = "risky"; b.insertBefore(rk, b.firstChild); } });
    box.innerHTML = ""; box.classList.add("tkgroups");
    order.forEach(c => { const g = groups[c]; if(!g) return; const sec = document.createElement("div"); sec.className = "tkg"; const desc = (TALK_CATS.find(x => x[0] === c) || [])[1] || (c === "More" ? "Other things you can do here." : ""); sec.innerHTML = '<div class="tkg__h">' + pcEsc(c) + (desc ? ' <span>' + pcEsc(desc) + '</span>' : '') + '</div>'; const row = document.createElement("div"); row.className = "tkg__row"; g.forEach(([b]) => row.appendChild(b)); sec.appendChild(row); box.appendChild(sec); });
  }catch(e){ console.warn("revamp", e); }
}
function talkExtraActs(m){
  const A = [], you = G.you;
  if(TALK.thread && (TALK.beat === 0 || TALK.beat === 1)) return A;
  if(m.kind === "member" && G.bill && !G.bill.done) A.push({t:"Ask where they really stand", c:"10m", run(){ spend(10, 2); m.known = 2; setSay(huddleSay ? huddleSay(m, false) : "I am where I am.", fx("", "you know their reason now")); }});
  A.push({t:"Ask what they need from you", c:"10m", run(){ spend(10, 2); m.wantKnown = true; const w = (m.intent && m.intent.t) || ""; setSay(w ? "Since you ask: " + w.replace(/^to /i, "I want to ") + "." : "Nothing I would trouble you with. But thank you for asking.", fx("+1 warmth", "you know what they want")); try{ if(m.rel) ripple(m, 1, "They asked what I needed instead of what they wanted.", 1, false); }catch(e){} }});
  A.push({t:"Ask after their family", c:"10m", run(){ spend(10, 2); m.kinKnown = true; const T = kinTensions(m); setSay(kinLine(m), fx(T.length ? "+2 warmth" : "+1 warmth", "you know what is happening at home")); try{ if(m.rel) ripple(m, T.length ? 2 : 1, "They asked after my family, and meant it.", 2, false); }catch(e){} }});
  if(TALK.lastMean && /personal|grievance|refusal|delay/i.test(TALK.lastMean.type)) A.push({t:"Say you understand", c:"5m", run(){ spend(5, 1); const t = purseTr(m), d = 1 + ((t.loyalty || 50) > 60 ? 1 : 0) + ((t.vanity || 40) > 60 ? 1 : 0); setSay(pick(["That helps more than I expected.", "I did not think you would say that.", "Thank you. Most people do not."]), fx("+" + d + " warmth", "")); try{ if(m.rel) ripple(m, d, "They understood what I was carrying and said so.", 2, false); }catch(e){} }});
  return A;
}
{ const _renderTalk = renderTalk, _actionsFor = actionsFor, _setSay = setSay;
  actionsFor = function(m){ const A = _actionsFor.apply(this, arguments); try{ if(m && m !== G.you && m.kind !== "envoy" && !(G.you && G.you.out)){ const ex = talkExtraActs(m); if(ex.length){ const ix = A.findIndex(a => a.exit); if(ix < 0) return A.concat(ex); A.splice(ix, 0, ...ex); } } }catch(e){} return A; };
