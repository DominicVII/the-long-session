    chairId:SSN.chairId, floorId:SSN.floorId, offer:SSN.offer != null ? SSN.offer : null, waitingOn:SSN.waitingOn != null ? SSN.waitingOn : (SSN.offer != null ? SSN.offer : null), lastSpk:SSN.lastSpk != null ? SSN.lastSpk : null,
