}
function dynLore(p){ try{ return !!(p && (p === G.you || wallPerson(p) || p.sealedTaylor || p.lore)); }catch(e){ return true; } }
function dynHouseId(sur){ return "h_" + String(sur || "nobody").toLowerCase().replace(/[^a-z]+/g, "_"); }
function dynTraits(p){ const t = p.traits || {}; return {ambition:t.ambition || 50, conviction:t.conviction || 50, loyalty:t.loyalty || 50, vanity:t.vanity || 50, discretion:t.discretion || 50, temper:t.temper || 50}; }
/* one record per person, real or not yet grown */
function dynRec(p){
