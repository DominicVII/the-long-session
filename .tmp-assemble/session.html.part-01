/* the seat you leave is filled: when the player goes up out of the House, their district sends someone new (the game says so at the count; this makes it so, and mends a save where it never happened) */
function homeSeatFill(){
  try{ const y = G.you; if(!y || !y.state || y.dist == null || !G.members) return null; if(ofhYouKey() === "house") return null;
    if(G.members.some(m => m && !m.gone && m.state === y.state && String(m.dist) === String(y.dist))) return null;
    const st = (G.states || []).find(q => q.n === y.state) || {}, p = (st.lean || 0) >= 0 ? "FED" : "COM";
    const m = makeMember(p, {fresh:true, state:y.state}); if(!m) return null; m.kind = m.kind || "member"; m.state = y.state; m.dist = y.dist; m.margin = rint(1, 14); m.terms = 1; m.freshman = true;
    try{ m.creed = pickCreed(m.state, {fresh:true}); m.consular = (m.creed === "consul"); if(m.consular) m.faction = "consul"; }catch(e){}
    G.members.push(m); G.seatsBy[m.party] = (G.seatsBy[m.party] || 0) + 1; try{ wireGraph(); }catch(e){} try{ _allCache = null; }catch(e){}
    try{ feed(m.name + " is sworn in for " + y.state + " " + y.dist + ", the House seat you left."); }catch(e){}
    return m; }catch(e){ return null; } }
/* a seat's record is repaired once: the same person closed and reopened day after day becomes one tenure, and the player's own past (Governor, Senator, President, by term) is put back from the career, with terms counted in the game's own days */
function ofhFix(S){
  let ch = 0; const T = G.termLength || 52;
  Object.keys(S.seats).forEach(k => { const R = S.seats[k], H = R.holders, out = [];
    H.forEach(h => { const p = out[out.length - 1]; if(p && p.name === h.name && p.personId === h.personId && h.from - (p.to == null ? h.from : p.to) <= 3 && p.to != null){ p.to = h.to; p.how = h.how; p.successor = h.name === h.successor ? null : h.successor; ch++; } else out.push(h); });
    out.forEach(h => { if(h.successor === h.name) h.successor = null; if(h.to != null && h.from != null && h.to < h.from){ h.from = h.to - 365; ch++; } });
    if(out.length !== H.length) R.holders = out; });
  /* the record, and only the record: the player's own tenures come from the career (a win in term N is the office from term N+1), the presidents from the presidents' list; names nobody recorded are not made up */
  if(!S.cf3 && G.you && Array.isArray(G.career)){
    S.cf3 = 1; const y = G.you, st = y.state, key = {Governor:"gov:" + st, Senator:"sen:" + st, President:"pres"}, wins = [];
    G.career.forEach(c => { if(c && c.term && key[c.post] && /^won/.test(c.note || "")) wins.push({post:c.post, term:c.term}); });
    wins.sort((p, q) => p.term - q.term);
    const ten = [{key:"house:" + st + " " + y.dist, from:1, to:wins.length ? wins[0].term * T : null, how:null}];
    wins.forEach((w, i) => { const nx = wins[i + 1]; ten.push({key:key[w.post], from:w.term * T + 1, to:nx ? nx.term * T : null, how:nx ? (nx.post === "Senator" ? "left for the Senate" : nx.post === "President" ? "left for the Presidency" : "left office") : null}); });
    if(ten[0].to != null) ten[0].how = wins[0].post === "Governor" ? "left the House for the governorship" : wins[0].post === "Senator" ? "left the House for the Senate" : "left the House for the Presidency";
    /* invented predecessors are struck from every seat: a holder the game never recorded is not shown */
    Object.keys(S.seats).forEach(k => { const R = S.seats[k]; const n = R.holders.length; R.holders = R.holders.filter(h => !(h.seeded && h.personId == null)); if(R.holders.length !== n){ R.noEarlier = true; ch++; } });
    ten.forEach(t => { const R = S.seats[t.key] || (S.seats[t.key] = {key:t.key, title:ofhTitleOf(t.key), holders:[], created:t.from});
      R.holders = R.holders.filter(h => h.personId !== "you");
      const nowHolds = t.to == null, others = R.holders.filter(h => h.name !== y.name);
      const me = {personId:"you", name:y.name, from:t.from, to:t.to, how:t.how, successor:null, backfilled:true};
      const before = others.filter(h => h.to != null && h.to <= t.from), after = others.filter(h => before.indexOf(h) < 0);
      if(before.length) before[before.length - 1].successor = y.name;
      if(after.length && t.to != null){ after[0].from = t.to + 1; after[0].after = y.name; me.successor = after[0].name; }
      R.holders = before.concat([me], after); R.vacantSince = null; ch++; });
    /* the presidents on record, before you */
    try{ const P = (G.presidents || []).filter(p => p && !p.you && p.name); if(P.length){ const R = S.seats.pres || (S.seats.pres = {key:"pres", title:"President", holders:[], created:1});
      const mine = R.holders.filter(h => h.personId === "you"), rec = P.map(p => ({personId:null, name:p.name, from:((p.since || 1) - 1) * T + 1, to:(p.until || 1) * T, how:p.end || null, successor:null, recorded:true}));
      rec.forEach((h, i) => { h.successor = rec[i + 1] ? rec[i + 1].name : (mine[0] ? mine[0].name : null); });
      R.holders = rec.concat(R.holders.filter(h => h.personId === "you" || !(h.recorded))); R.created = 1; ch++; } }catch(e){}
  }
  return ch;
}
function ofhSync(only){
  const S = ofhEnsure(), cur = ofhCurrent(); let ch = 0; try{ if(ofhFix(S)) ch++; }catch(e){}
  Object.keys(cur).forEach(key => { if(only && key !== only) return; const c = cur[key], R = S.seats[key];
    if(!R){ if(!S.seeded) ofhSeed(key, c); else S.seats[key] = {key, title:ofhTitleOf(key), holders:[{personId:c.personId, name:c.name, from:G.day, to:null, how:null, successor:null, newSeat:true}], created:G.day}; ch++; return; }
    const open = R.holders.length && R.holders[R.holders.length - 1].to == null ? R.holders[R.holders.length - 1] : null;
    if(open && (open.personId === c.personId || (open.personId == null && open.name === c.name)) && open.name === c.name) return;
    if(open && open.personId === c.personId && open.personId !== "you" && open.name !== c.name){ /* seat succession: a relative under the old id */ }
    if(!open && R.holders.length){ const lh = R.holders[R.holders.length - 1]; if(lh.name === c.name && lh.personId === c.personId && lh.to != null && G.day - lh.to <= 2){ lh.to = null; lh.how = null; lh.successor = null; R.vacantSince = null; R.miss = 0; ch++; return; } }
    if(open){ open.to = G.day; open.how = ofhHowLeft(open, c); open.successor = c.name; }
    const lastC = !open && R.holders.length ? R.holders[R.holders.length - 1] : null; if(lastC && !lastC.successor) lastC.successor = c.name;
    R.holders.push({personId:c.personId, name:c.name, from:G.day, to:null, how:null, successor:null, after:open ? open.name : null, afterVacancy:!open && !!lastC}); R.vacantSince = null;
    if(R.holders.length > onumLim(30,"hist")) R.holders.splice(0, R.holders.length - onumLim(30,"hist")); ch++; });
  /* seats nobody holds now: close them, name no successor */
  Object.keys(cur).forEach(key => { if(S.seats[key]) S.seats[key].miss = 0; });
  if(!only) Object.keys(S.seats).forEach(key => { if(cur[key]) return; const R = S.seats[key]; R.miss = (R.miss || 0) + 1; if(R.miss < 4) return; const open = R.holders.length && R.holders[R.holders.length - 1].to == null ? R.holders[R.holders.length - 1] : null;
    if(open){ open.to = G.day; open.how = ofhHowLeft(open, null); open.successor = null; R.vacantSince = G.day; ch++; } });
  if(!S.seeded){ try{ (G.states || []).forEach(st => ["sen:", "gov:"].forEach(p => { const k = p + st.n; if(!S.seats[k]) ofhSeed(k, null); })); }catch(e){} S.seeded = true; ch++; }
  if(ch) ofhPublish();
  return ch;
}
function ofhPublish(){
  try{ const S = ofhEnsure(), seats = {}; Object.keys(S.seats).forEach(k => { const R = S.seats[k]; seats[k] = {title:R.title, created:R.created, vacantSince:R.vacantSince || null, holders:R.holders.map(h => Object.assign({}, h))}; });
    window.ONUM_OFFICE_HISTORY = {seats, day:G.day};
    window.dispatchEvent(new CustomEvent("onum-office-history", {detail:{seats:Object.keys(seats).length, day:G.day}})); }catch(e){}
}
/* the previous holder of a seat, from the ledger only */
window.onumOfficePrevious = function(key){
  try{ const R = ofhEnsure().seats[key]; if(!R) return null; const H = R.holders; for(let i = H.length - 1; i >= 0; i--){ if(H[i].personId === "you" && H[i].to == null) continue; if(H[i].to != null) return Object.assign({}, H[i]); } return null; }catch(e){ return null; }
};
function ofhHandoverLine(key, title){
  ofhSync(key); const prev = window.onumOfficePrevious(key), R = ofhEnsure().seats[key];
  if(prev && prev.name && prev.personId !== "you" && prev.to >= G.day - 1) return prev.name + ", the former " + title + ", hands the office over to you.";
  if(prev && prev.name && prev.personId !== "you") return "The office of " + title + " stood vacant after " + prev.name + " " + prev.how + "; nobody was there to hand it over.";
  if(R && R.holders.length <= 1 && R.created === G.day) return "The office of " + title + " is newly created; you are the first to hold it.";
  return "The office of " + title + " stood vacant; nobody was there to hand it over.";
}
/* clean transition: when the chair changes, the old seat closes and every surface reads the new one */
let _ofhLast = undefined;
function ofhWatch(){
  try{ if(!G || !G.you){ if(!window.ONUM_OFFICE_HISTORY) window.ONUM_OFFICE_HISTORY = {seats:{}, day:null}; return; }
    const k = ofhYouKey(), sk = ofhPlayerSeatKey(), sig = k + "|" + sk;
    if(_ofhLast === undefined){ try{ if(!(OH.list || []).length) ohEnsure(); }catch(e){} try{ homeSeatFill(); }catch(e){} _ofhLast = sig; ofhSync(); }
    if(sig !== _ofhLast){ const was = _ofhLast; _ofhLast = sig;
      if(k !== "house"){ try{ G.you.post = null; G.you.vote = null; G.you.speaker = false; }catch(e){} }
      ofhSync();
