      if(ex && chance(0.2)){ rel[d.k] = clamp((rel[d.k] || 0) - 4, -100, 100); reactSay(null, "The President declines to exchange instruments with " + r.t + ". The Senate has consented; the executive has not acted."); }
      else if(d.verb === "res" && chance(0.4)){ rel[d.k] = clamp((rel[d.k] || 0) - 6, -100, 100); reactSay(null, "The assembly of " + r.t + " refuses the Senate's reservation. The treaty is in doubt."); }
      else { rel[d.k] = clamp((rel[d.k] || 0) + 3, -100, 100); reactSay(null, "Instruments are exchanged with " + r.t + ". The treaty is in force."); }
      const h = reactHolder("armed"); if(h) reactSay(h, "Armed Services Chair " + surname(h.name) + ": the treaty with " + r.t + " will be read line by line, and the Chair will be asking what the garrisons get out of it.", false);
    } else if(d.verb === "no"){ rel[d.k] = clamp((rel[d.k] || 0) - 3, -100, 100); reactSay(null, (rel[d.k] < -20 ? cap(r.t) + " recalls its ambassador for consultations." : cap(r.t) + " asks for a meeting at the working level.")); }
    else reactSay(null, cap(r.t) + " says the Senate is stalling, and will say so at home.");
    return; }
  if(e.kind === "confirm"){
    if(d.confirmed){ const J = G.court || [], avg = J.length ? J.reduce((a, j) => a + ((j.pos && j.pos.econ) || 0), 0) / J.length : 0; const o = reactHolder("minority");
      reactSay(null, d.name + " takes the bench. The court now leans " + (avg > 8 ? "toward the market" : avg < -8 ? "toward the public" : "neither way") + " on the economy; its next opinions will show it.");
      if(o) reactSay(o, "Minority Leader " + surname(o.name) + ": the new justice will be judged by the opinions, not by the introductions.", false);
    } else reactSay(null, "The White House is said to be looking for another name after " + d.name + ". The seat stays open for now.");
    return; }
  if(e.kind === "foreign"){
    const r = WORLD_POWERS.find(p => p.k === d.k), rel = G.realmRel = G.realmRel || {}; if(!r) return;
    const o = reactHolder("minority");
    if(d.verb === "aid"){ if(o) reactSay(o, "Minority Leader " + surname(o.name) + ": money to " + r.t + " while the farm counties go short is a choice, and the House will ask for the figures."); if(G.world && G.world.foe && G.world.foe !== d.k){ const f = WORLD_POWERS.find(p => p.k === G.world.foe); rel[G.world.foe] = clamp((rel[G.world.foe] || 0) - 2, -100, 100); reactSay(null, f.t + " notes the aid to " + r.t + " and files it."); } else reactSay(null, cap(r.t) + " thanks the Union publicly and privately asks for more."); }
    else if(d.verb === "trade"){ reactSay(null, "Merchants in the harbour towns welcome the " + r.t + " schedule; the farm co-ops want to read it first."); }
    else if(d.verb === "warn" || d.verb === "press"){ if(G.world && G.world.foe === d.k) G.world.heat = clamp((G.world.heat || 0) + 2, 0, 100); reactSay(null, cap(r.t) + " " + (d.verb === "warn" ? "answers the warning with a statement for its own papers." : "gives a little ground and asks for something in return.")); }
    return; }
  if(e.kind === "appoint"){
    const s2 = reactHolder("speaker");
    reactSay(null, d.ok ? d.name + " takes up the post of " + String(d.post || "").toLowerCase() + ". The department's staff are reading everything they have written." : "The legislature rejected " + d.name + "; the post of " + String(d.post || "").toLowerCase() + " is still vacant.", true);
    return; }
  if(e.kind === "ruling"){
    const S = (G.states || []).find(x => x.n === d.state), h = reactHolder("judic");
    if(d.dual) reactSay(null, "The House is drafting an amendment on holding two offices, after the bench's ruling in " + d.t + ".");
    else if(d.forUnion){ if(S) S.unrest = clamp(S.unrest + 2, 0, 100); reactSay(null, "The governor of " + d.state + " says the state will comply, slowly, and that the legislature will ask Congress to revisit the mandate."); }
    else { reactSay(null, d.state + " keeps its money and its rules. The Union's attorney says the administration will study the opinion."); }
    if(h) reactSay(h, "Judiciary Chair " + surname(h.name) + ": the committee will look at the bench's reasoning in " + d.t + " before anything is written down.", false);
    return; }
  if(e.kind === "senVote"){
    const ex = G.exec, fit = ex && !ex.you ? alignment(ex, {pos:d.pos || {econ:0, lib:0, def:0, wel:0}, title:d.title}) : 0, sp = reactHolder("speaker");
    reactSay(sp, (sp ? "Speaker " + surname(sp.name) + ": " : "") + "the House will take up the Senate's action on the " + d.title + " this week.", false);
    if(ex && !ex.you) reactSay(null, "The White House " + (fit > 0 ? "signals the President would sign the " + d.title + "." : fit < -18 ? "issues a veto threat on the " + d.title + "." : "says the President is reading the " + d.title + "."));
    return; }
}
function reactDay(){
  const Q = G.react || []; if(!Q.length) return; const keep = [];
  Q.forEach(e => { if(e.due <= G.day){ try{ reactResolve(e); }catch(x){ try{ console.warn("react", x); }catch(e2){} } } else keep.push(e); });
  G.react = keep;
}
/* ═════════════════════════════════════════════════════════
   THE PURSE · one money for everyone
   You, a Senator, a baker and a clerk all keep the same kind of purse and play by
   the same rules: you earn, you pay for where you live, and the rest is yours to
   spend or keep, on your own time and by your own temper. A person who spends in
   public is seen, and everyone who sees it has an opinion and a choice about what
   to do with it, the player no differently from anybody else. The campaign's war
   chest, and anything taken from a donor, is not the purse: it cannot be spent on
   yourself, so there is nothing here to launder it through.
   ═════════════════════════════════════════════════════════ */
const PURSE_ITEMS = {
  coffee:{shop:"diner", t:"a coffee", price:2, show:0, min:10, energy:4, line:"A coffee, thanks."},
  lunch:{shop:"diner", t:"the lunch special", price:6, show:0, min:30, energy:10, line:"The lunch special, please."},
  round:{shop:"diner", t:"a round for the counter", price:30, show:2, min:25, appr:2, line:"This round is on me."},
  paper:{shop:"newsstand", t:"the morning paper", price:1, show:0, min:5, paper:1, line:"The Ledger, please."},
  book:{shop:"newsstand", t:"a book", price:12, show:0, min:20, infl:1, line:"I'll take that one."},
  groceries:{shop:"market", t:"groceries for a household", price:15, show:0, min:15, gift:"hh", line:"Put together a basket for somebody who needs it."},
  flowers:{shop:"market", t:"flowers", price:8, show:1, min:10, gift:"person", line:"Those flowers, wrapped."},
  coat:{shop:"market", t:"a tailored coat", price:140, show:2, min:30, style:2, line:"I'll have the coat taken in."},
  suit:{shop:"market", t:"a fine suit", price:380, show:3, min:45, style:3, line:"The best cloth you have, cut to me."},
  watch:{shop:"market", t:"a gold watch", price:900, show:3, min:20, style:4, line:"That one, in the case."},
  gate:{shop:"hardware", v:"Pay for", t:"mending a neighbour's gate", price:15, show:1, min:40, appr:2, line:"Hinges and a latch, please."},
  box:{shop:"church", v:"Put", t:"coins in the poor box", price:10, show:0, min:10, appr:1, line:""},
  rent:{shop:"church", v:"Pay", t:"a family's rent for the month", price:60, show:1, min:20, appr:3, line:""}
};
const PURSE_HOMES = {room:{t:"a rented room", cost:12, move:0, rest:-8}, flat:{t:"a flat", cost:24, move:40, rest:0}, house:{t:"a townhouse", cost:55, move:180, rest:2}};
const PURSE_STYLE = ["worn", "plain", "smart", "fine", "lavish"];
function purseTr(p){ return p.traits || {vanity:45, ambition:50, loyalty:50, discretion:55, conviction:50, temper:40}; }
function purseOf(p){
  if(!p.purse){
    const seed = seedOf("cash:" + (p.id != null ? p.id : p.name));
    const cash = p === G.you ? 150 : p.kind === "member" ? 60 + Math.round((p.influence || 20) * 2) + (p.post ? 40 : 0) : 25 + (seed % 170);
    p.purse = {cash, style:cash < 60 ? 1 : cash < 220 ? 2 : cash < 520 ? 3 : 4, home:cash < 50 ? "room" : cash < 400 ? "flat" : "house", spent:0, log:[], feel:{}, broke:0};
  }
  return p.purse;
}
function purseWill(p){ const t = purseTr(p); return {boast:clamp((t.vanity || 40) * 0.7 + (t.ambition || 50) * 0.3 - (t.discretion || 55) * 0.35 + 10, 0, 100), thrift:clamp((t.discretion || 55) * 0.5 + (100 - (t.vanity || 40)) * 0.3 + (t.conviction || 50) * 0.2, 0, 100), guarded:clamp((t.conviction || 50) * 0.4 + (100 - (t.loyalty || 50)) * 0.3 + (100 - (t.ambition || 50)) * 0.3, 0, 100)}; }
function purseSalary(p){
  if(p === G.you){ let k = null; try{ k = heldOffice(); }catch(e){} return {house:45, senate:60, gov:70, bench:75, pres:95}[k] || 18; }
  return p.kind === "member" ? 45 + (p.post ? 10 : 0) : 18 + (seedOf("wage:" + p.id) % 22);
}
function purseLog(p, text, amt){ const P = purseOf(p); P.log.unshift({d:G.day, t:text, a:amt}); if(P.log.length > onumLim(14,"hist")) P.log.length = onumLim(14,"hist"); }
function purseChip(){ try{ const b = el("uiPurseBtn"); if(b && G.you) b.textContent = "ƒ" + Math.floor(purseOf(G.you).cash); }catch(e){} }
const PURSE_LINES = {
  awe:["That is something. I will say so.", "Well. Look at you.", "I have not seen cloth like that in this district."],
  glad:["Good for you. You have earned it.", "I am glad somebody is enjoying it.", "Nice. Enjoy it."],
  envy:["Must be nice.", "(says nothing, and looks at it a moment too long)", "I would not mind one of those myself."],
  jealous:["Some of us count every coin, you know.", "Funny how it is always the same people.", "I saw what that cost. I know what I make."],
  disapprove:["There are families on Elm Street who would live a month on that.", "That is a lot of money to wear on one's back.", "I do not say it is wrong. I say people will notice."],
  indifferent:["", "", ""]
};
function pickReaction(w, actor, item, mode){
  const t = purseTr(w), cashW = purseOf(w).cash, rel = (w.rel && w.rel.warmth) || 0;
  const sh = (item.show || 0) * (mode === "show" ? 1.5 : mode === "quiet" ? 0.35 : 1);
  if(sh < 0.4) return "indifferent";
  const price = item.price * (1 + sh / 2), gap = clamp((price - cashW * 0.6) / (price + 60), 0, 1) * Math.min(1, sh / 1.5);
  const W = {indifferent:Math.max(0.05, 1.1 - gap), glad:(t.loyalty || 50) / 100 * 1.1 + (rel > 10 ? 0.5 : 0) - gap * 0.5, awe:(t.ambition || 50) / 100 * gap * 1.5 + (sh >= 2 ? 0.2 : 0), envy:(t.vanity || 40) / 100 * gap * 1.4 + (rel < 0 ? 0.3 : 0), jealous:((t.vanity || 40) + (t.temper || 40)) / 200 * gap * (rel < 10 ? 1.6 : 0.5), disapprove:(t.conviction || 50) / 100 * gap * (cashW < 80 ? 1.3 : 0.3)};
  let tot = 0; Object.keys(W).forEach(k => { W[k] = Math.max(0, W[k]); tot += W[k]; });
  let r = Math.random() * tot; for(const k in W){ r -= W[k]; if(r <= 0) return k; }
  return "indifferent";
}
const PURSE_DW = {awe:3, glad:2, envy:-2, jealous:-4, disapprove:-2, indifferent:0};
/* what anyone who saw it can do about it: the same choices for you and for them */
const PURSE_OPTS = [["admire", "Say something warm"], ["ask", "Ask to borrow ƒ 20"], ["remark", "Make a sharp remark"], ["gossip", "Tell others about it"], ["copy", "Spend to keep up"], ["nothing", "Say nothing"]];
function pursePersonName(p){ return p === G.you ? "You" : p.name; }
function purseDoOpt(w, actor, opt, item, reaction){
  const wn = pursePersonName(w), an = pursePersonName(actor); let out = "";
  const aW = (a) => { try{ if(a !== G.you && a.rel) ripple(a, 0, null, 0, false); }catch(e){} };
  if(opt === "admire"){ out = wn + " tells " + (actor === G.you ? "you" : an) + " it suits them."; if(actor !== G.you && actor.rel) ripple(actor, 2, w === G.you ? "They noticed what I bought and said something kind." : null, 1, false); else if(actor === G.you) G.you.approval = clamp(G.you.approval + 0.5, 0, 100); }
  else if(opt === "ask"){ const A = purseOf(actor), ok = A.cash >= 60 && (purseTr(actor).temper || 40) < 70 && (actor === G.you ? true : chance(0.55 + ((actor.rel && actor.rel.warmth) || 0) / 200));
    if(actor === G.you){ G.you.asks = G.you.asks || []; G.you.asks.push({from:w.id, name:w.name, amt:20, day:G.day}); out = wn + " asks if you could spare ƒ 20, seeing how things are going."; }
    else if(ok){ const W = purseOf(w); A.cash -= 20; W.cash += 20; if(w === G.you) purseLog(G.you, "Borrowed from " + an, 20); out = an + " lends " + wn + " ƒ 20 without a fuss."; if(actor.rel && w === G.you) ripple(actor, 1, "They asked to borrow a little and I gave it.", 1, false); }
    else { out = an + " says no, politely, and means it."; if(actor.rel && w === G.you) ripple(actor, -2, "They asked me to lend them money the day I spent on " + item.t + ".", 2, false); } }
  else if(opt === "remark"){ out = wn + " says something sharp about " + item.t + "."; if(actor === G.you) G.you.approval = clamp(G.you.approval - 1, 0, 100); else if(actor.rel) ripple(actor, -1, null, 0, false); }
  else if(opt === "gossip"){ out = wn + " tells anybody who will listen about " + an + " and " + item.t + "."; try{ pursePeople().forEach(o => { if(o !== w && o !== actor){ const P = purseOf(o); P.feel[actor.id != null ? actor.id : "you"] = (P.feel[actor.id != null ? actor.id : "you"] || 0) - 1; } }); }catch(e){}
    if(actor === G.you) G.you.approval = clamp(G.you.approval - 1, 0, 100); }
  else if(opt === "copy"){ const lesser = Object.keys(PURSE_ITEMS).filter(k => PURSE_ITEMS[k].show > 0 && PURSE_ITEMS[k].price < item.price && PURSE_ITEMS[k].price <= purseOf(w).cash).sort((a, b) => PURSE_ITEMS[b].price - PURSE_ITEMS[a].price)[0];
    if(lesser && w !== G.you){ purseBuy(w, lesser, {mode:"show", quiet:true}); out = wn + " goes and buys " + PURSE_ITEMS[lesser].t + " to keep up."; } else out = wn + " thinks about keeping up, and does not."; }
  else out = wn + " says nothing, and the moment passes.";
  return out;
}
function pursePeople(){ try{ return hereNow().filter(m => m && m !== G.you && !m.gone && m.traits).slice(0, 10); }catch(e){ return []; } }
/* the same engine whether the buyer is you or anyone else */
function purseWitness(actor, item, mode, shopSpot){
  const lines = []; let net = 0;
  const near = pursePeople().filter(w => w !== actor);
  const witnesses = near.slice(0, 8);
  if(actor !== G.you && G.room === (actor.room || G.room)) witnesses.push(G.you);
  witnesses.forEach(w => {
    const r = pickReaction(w, actor, item, mode); if(r === "indifferent") return;
