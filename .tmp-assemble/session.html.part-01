    (asks.length ? '<div class="eyebrow" style="margin-top:10px">Asking you for money</div>' + asks.map((a, i) => '<div class="whip__row"><span class="whip__n">' + pcEsc(a.name) + '</span><span class="whip__w">asks to borrow ƒ ' + a.amt + ' (day ' + a.day + ')</span><span class="whip__b"><button type="button" class="btn btn--ghost whip__go" data-ask="' + i + ':1"' + (P.cash < a.amt ? ' disabled' : '') + '>Lend it</button><button type="button" class="btn btn--ghost whip__go" data-ask="' + i + ':0">Refuse</button></span></div>').join("") : '') +
    (saw.length ? '<div class="eyebrow" style="margin-top:10px">What you saw, and what you might do about it</div>' + saw.map((a, i) => '<div style="margin:6px 0;padding:6px 8px;border-left:3px solid var(--line-soft)"><b>' + pcEsc(a.name) + '</b> bought ' + pcEsc(a.item) + '. You felt <i>' + pcEsc(a.r) + '</i>.<div class="card__actions" style="flex-wrap:wrap">' + PURSE_OPTS.filter(o => o[0] !== "copy" || true).map(o => '<button type="button" class="btn btn--ghost" data-saw="' + (saw.length - 1 - i) + ':' + o[0] + '">' + pcEsc(o[1]) + '</button>').join("") + '</div></div>').join("") + '<div id="pcSay" class="dream"></div>' : '<div id="pcSay" class="dream"></div>') +
    '<div class="eyebrow" style="margin-top:10px">The ledger</div>' + (P.log.length ? P.log.slice(0, 8).map(l => '<div class="careerline"><b>d' + l.d + '</b><span>' + pcEsc(l.t) + ' <span class="muted">' + (l.a > 0 ? "+" : "") + l.a + '</span></span></div>').join("") : '<p class="muted">Nothing yet.</p>') +
    '<p class="muted" style="font-size:12px;margin-top:8px">Shops are in the district: Vaughn\'s counter, the market, the newsstand, the hardware store and the church box. Everyone else shops there too, with their own purse and their own temper, and everyone who sees what you spend has a view of it.</p>';
