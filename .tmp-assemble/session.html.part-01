  const lowest = rs.slice().sort((a, c) => (rel[a.k] || 0) - (rel[c.k] || 0));
  const picks = [lowest[0], lowest[Math.floor(lowest.length / 2)], lowest[lowest.length - 1]].filter((x, i, a) => a.indexOf(x) === i);
  const body = picks.map((r, i) => { const D = DLG[r.k] || {ask:r.want, give:"goodwill", red:"being asked too much"}, g = REALM_GOV[r.k] || {}, head = realmFolk(r.k).find(f => f.id === "head"), rl = rel[r.k] || 0;
