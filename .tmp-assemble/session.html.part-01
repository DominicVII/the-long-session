/* and your time is yours: when somebody wants a word with you, you may give it, put it off, or name a price */
function timeAskCard(m){
  const y = G.you, fee = Math.max(4, Math.round(8 + purseSalary(y) / 4)), t = purseTr(m), canPay = purseOf(m).cash >= fee;
  const body = '<p style="margin:6px 0">“' + pcEsc((m.wantsWord && m.wantsWord.line) || "Have you got a minute?") + '”</p><div class="muted" style="font-size:12px">Your time is yours. ' + pcEsc(m.name) + ' is asking for ten minutes.</div>' +
    '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" id="taGive">Give them ten minutes</button><button type="button" class="btn btn--ghost" id="taLater">Not now</button><button type="button" class="btn btn--ghost" id="taFee"' + (canPay ? '' : ' disabled') + '>Charge ƒ ' + fee + ' for it</button></div><div class="dream" id="taSay"></div>';
  govCardOpen("Someone wants a word", m.name, "", body, null);
  const done = () => card.querySelectorAll("button").forEach(b => { if(b.id !== "gcClose") b.disabled = true; });
  el("taGive").addEventListener("click", () => { m._timeOk = true; walkNow(); setTimeout(() => { try{ G.running = true; openTalk(m); }catch(e){} }, 60); });
  el("taLater").addEventListener("click", () => { m.wantsWord = null; m.lastHail = G.t; try{ if(m.rel) ripple(m, (t.vanity || 40) > 60 ? -3 : -1, "I asked for a minute and they said not now.", 1, false); }catch(e){} el("taSay").textContent = m.name + " nods and goes. They will ask again, or not."; done(); });
  el("taFee").addEventListener("click", () => { const ok = (t.conviction || 50) < 72 && chance(0.6); if(ok){ purseOf(m).cash -= fee; purseOf(y).cash += fee; purseLog(y, m.name + " paid for your time", fee); purseChip(); el("taSay").textContent = m.name + " pays ƒ " + fee + ", a little stiffly, and you give them the ten minutes."; done(); setTimeout(() => { m._timeOk = true; walkNow(); setTimeout(() => { try{ G.running = true; openTalk(m); }catch(e){} }, 60); }, 900); }
    else { try{ if(m.rel) ripple(m, -4, "I asked for ten minutes and they put a price on it.", 4, true); }catch(e){} m.wantsWord = null; m.lastHail = G.t; el("taSay").textContent = m.name + " will not pay to be heard, and says so on the way out."; done(); } });
  return null;
}
{ const _openTalk2 = openTalk;
  openTalk = function(m){
    try{ if(m && m !== G.you && G.running && !m._timeOk && !TALK.open && m.kind !== "envoy" && m.traits){
      if(m.wantsWord){ timeAskCard(m); return; }
      const st = timeStance(m, G.you, 10); if(st.mode !== "free"){ timeCard(m, st); return; } } }catch(e){ console.warn("time", e); }
    if(m) m._timeOk = false;
