  return t;
}
function matTex(tex, rx, ry, rough, col){
  rx = qrep(rx); ry = qrep(ry);
  /* Normals are a real fragment cost — Best only. Balanced/Simple share flat maps. */
  const useN = (G.gfx === "best");
  const useR = (G.gfx !== "simple");
  const _k = (useN?"N":"F")+(useR?"R":"")+"|"+(tex.uuid||"t")+"|"+rx+"|"+ry+"|"+(rough===undefined?0.85:rough)+"|"+(col===undefined?"x":col);
  if(MATCACHE.has(_k)) return MATCACHE.get(_k);
  const t = tex.clone(); t.needsUpdate = true; t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rx,ry);
  const opts = {map:t, roughness:rough===undefined?0.85:rough, metalness:0.02,
