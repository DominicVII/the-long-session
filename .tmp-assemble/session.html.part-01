{ const _ed = engDay; engDay = function(){ const r = _ed.apply(this, arguments); try{ rgnDay(); }catch(e){} return r; }; }
rgnPublish();
setTimeout(() => { try{ if(G && G.you){ rgnEnsure(); rgnAssignAll(); rgnFire(); } }catch(e){} }, 1500);
setInterval(() => { try{ if(G && G.you){ const all = everyone(); for(const p of all) if(p && !p.birthRegion){ rgnAssignAll(); rgnFire(); break; } } }catch(e){} }, 4000);

/* ── 20261020 dynasties (dyn): courtship, marriage, births, aging, school, careers,
