    addBox(gilt, 0, deckY + 6.02, facadeZ - 0.55, w * 0.72, 0.05, 1.55, 0, true);
    addBox(ashlar, 0, deckY + 6.48, facadeZ - 0.35, w * 0.68, 0.48, 1.35, 0, true);
    addBox(ashlar, 0, deckY + 6.92, facadeZ - 0.35, w * 0.40, 0.40, 1.15, 0, true);
    addBox(ashlar, 0, deckY + 7.28, facadeZ - 0.35, 1.05, 0.30, 0.95, 0, true);
