  /* dowry from the bride's family, savings pooled on the ledger */
  try{ if(pa && pb){ const PW = purseOf(dynPerson(wife.id)), PH = purseOf(dynPerson(hus.id)), dw = Math.round(Math.max(0, PW.cash) * 0.08);
    if(dw > 0){ PW.cash -= dw; PH.cash += dw; purseLog(dynPerson(wife.id), "Dowry to " + hus.name, -dw); purseLog(dynPerson(hus.id), "Dowry from " + wife.name, dw); } } }catch(e){}
  dynAlly(a.houseId, b.houseId, null);
  const mixed = a.birthRegion && b.birthRegion && a.birthRegion !== b.birthRegion;
  dynNote(a.name + " and " + b.name + " were married" + (mixed ? ", " + (ONUM_REGIONS[a.birthRegion] || {}).name + " to " + (ONUM_REGIONS[b.birthRegion] || {}).name : "") + ".", true);
