  if(!acts.length){ govCardOpen("Acts awaiting signature", "Nothing on the desk", "The House and Senate have sent nothing over today.", "", "pacts"); return null; }
  const mem = (G.members || []).filter(m => m && !m.gone && m.kind === "member" && m.pos);
  const body = acts.map((a, i) => { const bill = {pos:a.pos || {econ:0, lib:0, def:0, wel:0}, title:a.title, id:"act:" + a.title};
    let aye = 0; mem.forEach(m => { try{ if(alignment(m, bill) > 0) aye++; }catch(e){} }); const frac = mem.length ? aye / mem.length : 0.5, ovr = frac > 0.68 ? "probable" : frac > 0.55 ? "possible" : "unlikely";
    const lines = ["treasury", "state", "war", "justice"].map(k => '<div style="margin:6px 0"><b>' + pcEsc(st[k].name) + '</b> <span class="muted">· ' + pcEsc(PRES_ROLES[k]) + ' · ' + pcEsc(viewWords(st[k].pos)) + '</span><div style="font-size:13px">“' + pcEsc(presAdvice(st[k], k, a)) + '”</div></div>').join("");
    return '<div style="margin:12px 0;padding:8px 10px;border-left:3px solid var(--line-soft)"><b>' + pcEsc(a.title) + '</b> <span class="muted">passed day ' + a.day + '</span>' +
      '<details open style="margin:4px 0"><summary class="muted">What it does</summary>' + dkShiftsHTML({pos:bill.pos, title:a.title}) + '</details>' +
      '<details style="margin:4px 0"><summary class="muted">What your cabinet says</summary>' + lines + '</details>' +
      '<p class="muted" style="font-size:12px">If you veto it, a two-thirds override is ' + ovr + ' (about ' + Math.round(frac * 100) + '% of the chamber reads it favourably).</p>' +
      '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" data-ps="' + i + ':s">Sign it</button><button type="button" class="btn btn--ghost" data-ps="' + i + ':v">Veto it</button></div><div class="dream" id="ps_' + i + '"></div></div>'; }).join("");
  govCardOpen("Acts awaiting signature", "On the President's desk", "Each act, what it does axis by axis, and what four members of your cabinet make of it, in their own words.", body, "pacts");
  card.querySelectorAll("[data-ps]").forEach(b => b.addEventListener("click", () => { const [i, k] = b.getAttribute("data-ps").split(":"), a = acts[+i]; if(a.signed || a.vetoed) return; spend(15, 2);
    let r; if(k === "s"){ a.signed = true; y.approval = clamp(y.approval + 2, 0, 100); reactAct(a.title, a.pos, true); feed(execTitle() + " " + surname(y.name) + " signed the " + a.title + ".", "good"); r = "Signed, with eleven pens."; }
    else { a.vetoed = true; y.standing = clamp(y.standing - 3, 0, 100); y.influence = clamp(y.influence + 3, 0, 100); reactAct(a.title, a.pos, false); feed(execTitle() + " " + surname(y.name) + " vetoed the " + a.title + ".", "bad"); r = "Vetoed. The House can override with two thirds."; }
    el("ps_" + i).textContent = r; card.querySelectorAll('[data-ps^="' + i + ':"]').forEach(z => z.disabled = true); }));
  return null;
