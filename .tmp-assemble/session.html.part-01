function fixCareer(){ try{ return !!(G && G.you && G.you.id != null); }catch(e){ return false; } }
{ const _c = window.onumCourt, _p = window.onumPropose, _h = window.onumHeirs, _ca = window.onumContinueAs;
  const who = (id) => { try{ return dynPerson(id); }catch(e){ return null; } };
