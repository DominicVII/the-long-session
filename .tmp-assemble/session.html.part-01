}
function reactFrac(pos, title){
  const bill = {pos:pos || {econ:0, lib:0, def:0, wel:0}, title:title || "act", id:"r:" + title}, mem = (G.members || []).filter(m => m && !m.gone && m.kind === "member" && m.pos);
