/* ── 20261021: one source of truth for the player's office, and a ledger of who held every seat ── */
const OFH_LEFT = ["retired at the end of the term", "lost the election", "stepped down", "was term-limited", "left for private practice", "died in office", "resigned under a cloud"];
function ofhEnsure(){ if(!G.ofh || G.ofh.v !== 1) G.ofh = {v:1, seats:{}, seeded:false, you:null}; return G.ofh; }
function ofhYouKey(){ try{ return heldOffice(); }catch(e){ return null; } }
/* the one answer to "what is the player now" */
window.onumPlayerOffice = function(){
