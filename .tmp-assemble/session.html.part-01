/* the player's hands in a sitting; nothing here opens a popup */
window.onumSession = {
  open:(o) => !!ssnOpen(Object.assign({auto:false}, o || {})), close:() => { ssnClose(); return true; },
  state:() => window.ONUM_SESSION,
  seek:() => { if(!SSN) return false; const st = ssnStage(); if(st.allows.indexOf("seek") < 0 && st.speaker !== "round") return false; if(SSN.queue.indexOf("you") < 0 && SSN.floorId !== "you") SSN.queue.unshift("you"); if(SSN.floorId == null) ssnRecognize(); ssnPublish(); return true; },
  speak:(text) => window.onumSessionEvent({bodyId:SSN && SSN.bodyId, kind:SSN && SSN.kind, actorId:"you", action:"speak", text}).ok,
  yield:(toId) => window.onumSessionEvent({bodyId:SSN && SSN.bodyId, kind:SSN && SSN.kind, actorId:"you", action:"yield", target:toId}).ok,
  pointOfOrder:() => window.onumSessionEvent({bodyId:SSN && SSN.bodyId, kind:SSN && SSN.kind, actorId:"you", action:"point_of_order"}),
  motion:(kind) => window.onumSessionEvent({bodyId:SSN && SSN.bodyId, kind:SSN && SSN.kind, actorId:"you", action:"motion", target:kind}),
  vote:(v) => window.onumSessionEvent({bodyId:SSN && SSN.bodyId, kind:SSN && SSN.kind, actorId:"you", action:"vote", text:String(v)}).ok,
  walkout:() => window.onumSessionEvent({bodyId:SSN && SSN.bodyId, kind:SSN && SSN.kind, actorId:"you", action:"walkout"}).ok,
  filibuster:() => window.onumSessionEvent({bodyId:SSN && SSN.bodyId, kind:SSN && SSN.kind, actorId:"you", action:"filibuster"}),
  next:() => { ssnNext(); return true; }
};

