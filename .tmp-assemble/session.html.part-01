    return s;
  }
  /* main entry: one line for member m.  ctx = {intent, topic, sent, about} */
  function say(m, ctx){
    if(!m) return "";
    ctx = ctx || {};
    let feel = {warm:0, heat:0, speak:0, attend:0};
    try{ if(typeof netFeel === "function") feel = netFeel(m, {intent:ctx.intent || "inform", heat:0, topics:[ctx.topic || "bill"]}); }catch(e){}
    const warm = (m.rel ? m.rel.warmth : 0) / 100 + (feel.warm || 0) * 0.5;
    let sent = ctx.sent !== undefined ? ctx.sent : (warm > 0.18 ? 1 : warm < -0.18 ? -1 : 0);
    let intent = ctx.intent;
    if(!intent){
      const r = rnd();
      intent = r < 0.30 ? "opinion" : r < 0.48 ? "gossip" : r < 0.60 ? "small" : r < 0.70 ? "ask" : r < 0.78 ? "warn" : "opinion";
      try{ if(m.lv && m.lv.notice > 0.55 && chance(0.18)) intent = "muse"; }catch(e){}
      try{ if(m.faith && m.faith.dev > 70 && chance(0.12)) intent = "faith"; }catch(e){}
    }
    let topic = intent === "faith" ? "faith" : intent === "muse" ? "anomaly" : intent === "small" ? pickFrom(["weather", "family"]) : topicFor(m, ctx);
    const I = idio(m);
    for(let tries = 0; tries < 6; tries++){
      let x = null;
      if(chance(0.22)) x = markov(intent);
      if(!x){
        const s1 = sent > 0 ? "p" : sent < 0 ? "n" : "z";
        let pool = TPL.filter(t => t.i === intent && (t.t === topic || t.t === "*") && (t.s === s1 || t.s === "*"));
        if(!pool.length) pool = TPL.filter(t => t.i === intent && (t.t === topic || t.t === "*"));
        if(!pool.length) pool = TPL.filter(t => t.i === "opinion" && t.t === "house");
        x = pickFrom(pool).x;
      }
      let s = tidy(fill(x, m, ctx, topic, sent));
      /* heat: hot speakers clip their sentences; talkative ones add a tail */
      if((feel.speak || 0) > 0.35 && chance(0.35)) s += " " + tidy(fill("{C}", m, ctx, topic, sent));
      s = guard(s);
      if(!s) continue;
      if(I.last.indexOf(s) >= 0) continue;
      I.last.unshift(s); if(I.last.length > 5) I.last.pop();
      I.n = (I.n || 0) + 1;
      return s;
    }
    return "";
  }
  return {say, lexCount, tplCount:TPL.length, guard, name:"D'Infinite Taylor Consular Neural Organism"};
})();

/* ══════════════════════════════════════════════════════════
   20261012a · TALK THAT DOES NOT REPEAT ITSELF
   Every line is chosen from several drafts against a memory of what
   the room has already heard: exact lines, word pairs, and each
   speaker's own recent words. People keep their own habits (their
   fillers, their pet words), vary how long they talk, and pick up a
   word from the line before theirs. The canon guard runs last.
   ══════════════════════════════════════════════════════════ */
const TK = {g:new Map(), bi:new Map(), sp:new Map(), len:new Map(), prev:null, n:0, on:true};
const TK_STOP = new Set("the a an and or but of to in on at for with is it that this be are was were i you we they he she not no so as by from if do did have has had will would can could just what about there their them our my your me us his her its than then very".split(" "));
const TK_WEAK = /(ly|ing|ed|ness)$|^(actually|really|before|business|anyone|something|nothing|everyone|because|another|whether|though|should|would|could|always|either|people|member|little|nothing|enough|almost|already|without|around|someone|anything|between|through|honest|plainly|probably|whatever|wouldn|couldn|doesn|tomorrow|yesterday|today)$/;
const TK_FILL = ["Look,", "Well,", "Honestly,", "Listen,", "Mind you,", "Frankly,", "See,", "Now,", "I'll say this:", "Between us,", "Truth is,", "Fair enough, but", "Right,", "Here's the thing:", "For what it's worth,", "Granted,"];
const TK_SYN = {
  "think":["reckon","figure","suspect","believe"], "very":["awfully","really","plenty","right"],
  "important":["serious","weighty","no small thing"], "problem":["trouble","snag","headache"],
  "bill":["measure","bill","proposal"], "vote":["vote","tally","count"], "people":["folks","people","voters"],
  "good":["decent","sound","solid"], "bad":["rotten","poor","ugly"], "maybe":["perhaps","maybe","could be"],
  "really":["truly","honestly","really"], "big":["large","sizable","big"], "quickly":["fast","quick","in a hurry"]
};
const TK_REF = ["{W}? ", "You mentioned {w}. ", "About {w}: ", "Since you bring up {w}, ", "As for {w}, ", "Back to {w}. "];
function tkHash(s){ let h = 2166136261; s = String(s); for(let i = 0; i < s.length; i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; }
function tkWords(s){ return String(s).toLowerCase().replace(/[^a-z' ]+/g, " ").split(/\s+/).filter(Boolean); }
function tkScore(m, s){
  const w = tkWords(s); let sc = (TK.g.get(s) || 0) * 50;
  let bs = 0; for(let i = 1; i < w.length; i++) bs += TK.bi.get(w[i-1] + " " + w[i]) || 0;
  sc += bs / Math.max(1, w.length - 1) * 4;
  const mine = TK.sp.get(m.id); if(mine){ let o = 0; w.forEach(x => { if(!TK_STOP.has(x) && mine.has(x)) o++; }); sc += o * 0.9; }
  const ll = TK.len.get(m.id); if(ll !== undefined){ const d = Math.abs(w.length - ll); sc -= Math.min(d, 14) * 0.15; }
  return sc;
}
function tkRemember(m, s){
  const w = tkWords(s);
  TK.g.set(s, (TK.g.get(s) || 0) + 1);
  for(let i = 1; i < w.length; i++){ const k = w[i-1] + " " + w[i]; TK.bi.set(k, (TK.bi.get(k) || 0) + 1); }
  let mine = TK.sp.get(m.id); if(!mine){ mine = new Map(); TK.sp.set(m.id, mine); }
  w.forEach(x => { if(!TK_STOP.has(x)) mine.set(x, (mine.get(x) || 0) + 1); });
  if(mine.size > 260){ const ks = [...mine.keys()].slice(0, 80); ks.forEach(k => mine.delete(k)); }
  TK.len.set(m.id, w.length);
  TK.prev = {who:m.id, s, t:G.t};
  if(++TK.n % 400 === 0){ /* forget slowly so the room can come back to a phrase days later */
    for(const [k, v] of TK.bi) if(v <= 1) TK.bi.delete(k); else TK.bi.set(k, v - 1);
    if(TK.g.size > 6000) TK.g.clear();
  }
}
function tkVoice(m, s, ctx){
  const h = tkHash((m.id || 0) + "|" + (m.name || ""));
  let out = s;
  /* synonyms: each person has their own word for things, used consistently */
  out = out.replace(/\b(think|very|important|problem|vote|people|good|bad|maybe|really|big|quickly)\b/g, (x) => {
    const L = TK_SYN[x]; if(!L || ((h >> (x.length % 8)) & 3) === 0) return x;
    return L[(h + x.length) % L.length];
  });
  /* length: someone who just spoke long answers short, and the reverse */
  const ll = TK.len.get(m.id) || 0;
  const sentences = out.match(/[^.!?]+[.!?]+/g);
  if(sentences && sentences.length > 1 && ll > 18 && chance(0.55)) out = sentences[0].trim();
  /* pick up the line before, when it was someone else's */
  const pv = TK.prev;
  if(pv && pv.who !== m.id && ((ctx.intent === "react" || ctx.intent === "agree") ? chance(0.6) : chance(0.18))){
    /* only pick up a noun: the word right after an article or possessive */
    const cand = []; const reN = /\b(?:the|a|an|this|that|your|my|our|their|his|her)\s+([A-Za-z]{5,12})\b/g; let mm;
    while((mm = reN.exec(pv.s))){ const x = mm[1]; if(!TK_STOP.has(x.toLowerCase()) && !TK_WEAK.test(x.toLowerCase())) cand.push(x); }
    if(cand.length){
      const w = cand[(h + TK.n) % cand.length];
      const f = TK_REF[(h + TK.n) % TK_REF.length];
      const proper = /^[A-Z]/.test(w);
      const lead = f.replace("{w}", proper ? w : "the " + w).replace("{W}", proper ? w : "The " + w);
      const end = lead.trim().slice(-1);
      let body = out;
      /* a bare "Noted." after a lead reads as a clipped telegram: fold it in */
      if(/^(noted|fair|right|sure|agreed|maybe)\.?\s/i.test(body) && end !== "?") body = body.replace(/^\w+\.?\s*/, "");
      out = lead + (end === "." || end === "?" ? body.charAt(0).toUpperCase() : body.charAt(0).toLowerCase()) + body.slice(1);
    }
  } else if(chance(0.30 + ((h & 7) / 30))){
    /* a person's own fillers: three habits each */
    const f = TK_FILL[(h + ((TK.n + h) % 3) * 5) % TK_FILL.length];
    if(out.indexOf(f) !== 0) out = f + " " + out.charAt(0).toLowerCase() + out.slice(1);
  }
  out = out.replace(/\bi\b/g, "I").replace(/\s+/g, " ").trim();
  return out;
}
(function(){
  if(typeof DTCNO === "undefined" || DTCNO.say0) return;
  DTCNO.say0 = DTCNO.say;
  DTCNO.say = function(m, ctx){
    if(!m) return "";
    ctx = ctx || {};
    if(!TK.on) return DTCNO.say0(m, ctx);
    let best = "", bs = 1e9;
    for(let k = 0; k < 4; k++){
      const s = DTCNO.say0(m, ctx); if(!s) continue;
      const sc = tkScore(m, s) + Math.random() * 0.3;
      if(sc < bs){ bs = sc; best = s; }
      if(sc < 0.5) break;
    }
    if(!best) return "";
    let out = best;
    try{ const v = DTCNO.guard(tkVoice(m, best, ctx)); if(v) out = v; }catch(e){}
    tkRemember(m, out);
    return out;
  };
})();

function dtcnoOk(){ return typeof DTCNO !== "undefined" && Math.hypot(cam.vx || 0, cam.vz || 0) <= 0.12; }
function dtcnoPair(a, b){
  if(!dtcnoOk() || !chance(0.55)) return null;
  try{
    const la = DTCNO.say(a, {});
    if(!la) return null;
    const w = (b.rel ? b.rel.warmth : 0);
    const lb = DTCNO.say(b, {intent:chance(0.5) ? "react" : (w > 10 ? "agree" : "react"), sent: w > 20 ? 1 : w < -20 ? -1 : 0});
    return [la, lb || "Mm."];
  }catch(e){ return null; }
}
function dtcnoReact(m){
  /* after one of your choices: a line that answers its tone */
  if(!m || !dtcnoOk() || !TALK.open || TALK.m !== m || !chance(0.5)) return;
  try{
    const note = (el("tkNote") && el("tkNote").innerHTML) || "";
    const sent = /<u>/.test(note) && !/<b>/.test(note) ? -1 : /<b>/.test(note) ? 1 : 0;
    const line = DTCNO.say(m, {intent:"react", sent});
    if(!line) return;
    const say = el("tkSay");
    if(say && say.textContent.length < 260){ say.textContent = say.textContent + " " + line; try{ speakAt(m, line); }catch(e){} }
  }catch(e){}
}
/* ── 20261011h · bills with different fights, a war chest that works, achievements ── */
/* 1 · new kinds of bill: immigration, foreign aid, the states against the Union */
function billFlavor(b){
  if(!b || !b.domain) return b;
  const d = b.domain;
  const T = {
    visa:["Harvest Visa Act","Seasonal Labour Visa Act","Employer-Bonded Visa Act"],
    border:["Border Guard Act","Federal Border Security Act","Crossings and Detention Act"],
    natur:["Naturalization Reform Act","Five-Year Citizenship Act","Oath and Civics Act"]};
  if(d === "visa" || d === "border" || d === "natur"){
    b.kind = "immig";
    b.title = pick(T[d]);
    b.restrict = b.pos.lib < 0;
    b.helps = b.restrict ? "border counties and the wage floor, by its sponsors' account" : "the harbour wards, the orchards and every mill short of hands";
    b.pays = b.restrict ? "the newcomer wards, and every farm that hires at harvest" : "nobody up front; the fight is about who arrives";
    b.why = (b.why || "") + " The newcomer wards are watching the clerk's count.";
  } else if(d === "aid" || d === "arms"){
    b.kind = "foreign";
    /* 20261027b: nobody files aid or arms for a power the Union is at war with, or barely speaking to */
    try{ const rs0 = realmEnsure(), rel = G.realmRel || {}, foe = G.conflict && G.conflict.war ? G.conflict.k : null; const rs = rs0.filter(x => x.k !== foe && (rel[x.k] || 0) > -30); const r = pick(rs.length ? rs : rs0); b.realm = r.k; b.realmT = r.t; b.realmWant = r.want; }catch(e){ b.realmT = "an ally abroad"; }
    const rn = (b.realmT || "the Allies").replace(/^the /, "");
    b.title = d === "aid" ? pick(["Aid to " + rn + " Act", rn + " Grain and Credit Act", "Foreign Assistance (" + rn + ") Act"])
                          : pick(["Arms to " + rn + " Act", rn + " Arms Sale Act", "Friendly Realms Arms Act"]);
    b.helps = (b.realmT || "an ally") + ", and the ports that load the ships";
    b.pays = "the treasury, which every district believes is theirs";
    b.why = "Cabled from " + (b.realmT || "abroad") + ": they want " + (b.realmWant || "help") + ". The envoy has been in the corridor all week.";
  } else if(d === "mandate" || d === "preempt"){
    b.kind = "statefed";
    const hot = (G.states || []).slice().sort((x, y) => (y.unrest || 0) - (x.unrest || 0))[0];
    b.target = (hot && hot.n) || b.state;
    b.title = d === "mandate" ? pick(["School Standards Mandate Act", "Federal Standards Act", "Uniform Schools Act"])
                              : pick(["Federal Preemption Act", "One Rule Act", "Interstate Uniformity Act"]);
    b.helps = d === "preempt" ? "one rule for the whole Union, and the firms that work across state lines" : "whoever the standard protects, if the states can pay for it";
    b.pays = d === "preempt" ? "the statehouses, which lose the pen" : "the states, out of their own budgets: an unfunded mandate";
    b.why = "The governor of " + b.target + " has already said, on the record, that the state will not comply.";
  }
  return b;
}
function echoEnsure(){ if(!G.echoes) G.echoes = []; return G.echoes; }
function echoLater(days, k, text, data){ echoEnsure().push({day:(G.day || 1) + days, k, t:text, data:data || {}}); }
function billConsequences(b, passed, yourVote){
  if(!b || !b.kind) return;
  const you = G.you, ays = yourVote > 0;
  G.billKinds = G.billKinds || {}; G.billKinds[b.kind] = (G.billKinds[b.kind] || 0) + 1;
  try{ if(G.billKinds.immig && G.billKinds.foreign && G.billKinds.statefed) achieve("variety"); }catch(e){}
  if(b.kind === "immig"){
    const newcomerHome = you.origin === "newcomer" || you.origin === "harbour";
    const hurtHome = passed && b.restrict && newcomerHome;
    (G.states || []).forEach(s => { if(s.cult === "pacific" || s.cult === "dutch") s.unrest = clamp((s.unrest || 0) + (passed && b.restrict ? 5 : passed ? -3 : 1), 0, 100); });
    echoLater(rint(2, 4), "immig", passed
      ? (b.restrict ? "The harvest crews did not come back to the orchards this week. " + b.title + " is being blamed at every co-op meeting."
                    : "Night-school naturalization classes are full past the doors. The first cohort under " + b.title + " takes the oath in the spring.")
      : "With " + b.title + " dead, the processing centers say the line is now four years long, and getting longer.",
      {dA: (ays === newcomerHome ? (newcomerHome ? -1 : 1) : 0) + (hurtHome && ays ? -4 : 0) + (!ays && newcomerHome && b.restrict ? 3 : 0)});
  } else if(b.kind === "foreign"){
    G.realmRel = G.realmRel || {};
    const k = b.realm || "reach";
    G.realmRel[k] = clamp((G.realmRel[k] || 0) + (passed ? 12 : -10), -100, 100);
    if(G.money) G.money.index = Math.round((G.money.index - (passed ? 1 : 0)) * 10) / 10;
    echoLater(rint(2, 5), "foreign", passed
      ? cap(b.realmT || "The ally") + " cabled thanks through the envoy and sent a grain shipment at cost. The district papers ran it under a photograph of a pothole."
      : cap(b.realmT || "The ally") + " recalled its attaché for consultations. Nobody here can say what that means. Everybody there can.",
      {dA: passed && ays ? -2 : (!passed && !ays ? 1 : 0), realm:k});
  } else if(b.kind === "statefed"){
    const st = b.target || b.state;
    const S = (G.states || []).find(s => s.n === st);
    if(S) S.unrest = clamp((S.unrest || 0) + (passed ? 9 : -4), 0, 100);
    const mine = you.state === st;
    if(passed){
      G.cases = G.cases || [];
      G.cases.push({t:st + " v. the Union (" + b.title + ")", state:st, day:G.day, voted:ays ? [you.name] : []});
      if(G.cases.length > 12) G.cases.splice(0, G.cases.length - 12);
      echoLater(2, "statefed", "The attorney general of " + st + " has filed suit against " + b.title + ". The governor says the state will not spend a guilder on it until a court says so.", {dA: mine ? (ays ? -5 : 3) : 0});
      echoLater(rint(5, 8), "statefed", chance(0.5)
        ? "The circuit court upheld " + b.title + ". " + st + " has asked the supreme bench to hear it. Federal marshals are in the state capitol for the first time in a decade."
        : "The circuit court struck down the funding section of " + b.title + " as an unfunded mandate. The rest stands. Both sides called it a win.", {dA:0});
    } else {
      echoLater(rint(2, 3), "statefed", "In " + st + ", the governor held a press conference on the capitol steps to thank the members who voted no. He read their names. " + (mine && !ays ? "Yours was one of them." : ""), {dA: mine ? (!ays ? 4 : -2) : 0});
    }
  }
}
function echoNight(news){
  const E = echoEnsure();
  for(let i = E.length - 1; i >= 0; i--){
    const e = E[i];
    if((G.day || 1) < e.day) continue;
    E.splice(i, 1);
    news.push(e.t);
    if(e.data && e.data.dA && G.you){
      let d = e.data.dA;
      if(d < 0 && G.you.legal && e.k === "statefed"){ d = Math.round(d / 2); G.you.legal = false; news.push("Your legal fund took the first of the calls. The damage was smaller than it might have been."); }
      G.you.approval = clamp(G.you.approval + d, 0, 100);
    }
  }
  /* the war chest's standing works: district office, staff */
  if(G.you){
    if(G.you.dOffice) G.you.approval = clamp(G.you.approval + 0.5, 0, 100);
    if(G.you.staff) G.you.influence = clamp((G.you.influence || 0) + 0.5 * Math.min(3, G.you.staff), 0, 100);
  }
}
/* 2 · the war chest */
const CHEST = [
  {k:"ads", t:"Run ads at home", c:30, d:"Radio and the county papers. Approval now, and a little in the race."},
  {k:"office", t:"Open a district office", c:45, d:"A storefront on Main with your name on it. A little approval every day for the rest of the term.", once:true},
  {k:"staff", t:"Hire a legislative aide", c:25, d:"More reach every day: a little influence each morning (up to three aides)."},
  {k:"field", t:"Fund field operations", c:35, d:"Doors knocked, lists cleaned, rides to the polls. Counts on election day."},
  {k:"ally", t:"Back an ally's campaign", c:20, d:"A cheque to a colleague's race. They will remember it, and it helps them hold their seat."},
  {k:"legal", t:"Retain counsel", c:25, d:"A legal fund. The next suit or mandate fight that lands on you costs half."},
  {k:"poll", t:"Commission a poll", c:15, d:"Read six members you could not read, and hear what home thinks of you."},
  {k:"press", t:"Buy time on the East Steps press", c:20, d:"A slot with the cameras. Standing and approval."}
];
function chestCard(){
  const you = G.you;
  G.running = false;
  card.innerHTML = '<div class="eyebrow">The war chest · ' + money(you.funds) + '</div><h1>Spend it, or it is just a number</h1>' +
    '<p class="dream">Field ' + (you.field || 0) + ' · aides ' + (you.staff || 0) + (you.dOffice ? ' · district office open' : '') + (you.legal ? ' · counsel retained' : '') + '</p>' +
    CHEST.map(c => {
      const off = you.funds < c.c || (c.once && you.dOffice) || (c.k === "staff" && (you.staff || 0) >= 3) || (c.k === "legal" && you.legal);
      return '<div class="whip__row"><span class="whip__n">' + c.t + ' <i>' + money(c.c) + '</i></span><span class="whip__w">' + c.d + '</span>' +
        '<span class="whip__b"><button type="button" class="btn btn--ghost whip__go" data-chest="' + c.k + '"' + (off ? ' disabled' : '') + '>Spend</button></span></div>';
    }).join("") +
    '<div class="card__actions"><button type="button" class="btn" id="chestClose">Close the ledger</button></div>';
  veil.hidden = false;
  el("chestClose").addEventListener("click", () => walkNow());
  card.querySelectorAll("[data-chest]").forEach(bt => bt.addEventListener("click", () => { chestSpend(bt.getAttribute("data-chest")); }));
}
function chestSpend(k){
  const you = G.you, c = CHEST.find(x => x.k === k);
  if(you.office === "bench" && !you.out && k !== "legal"){ note("Judges do not campaign. The chest stays shut while you sit on the bench.", true); return; }
  if(!c || you.funds < c.c) return;
  if(k === "ally"){ chestAllyCard(); return; }
  you.funds -= c.c;
  you.spent = (you.spent || 0) + c.c;
  let msg = "";
  if(k === "ads"){ you.approval = clamp(you.approval + 4, 0, 100); you.field = (you.field || 0) + 2; msg = "The ads run all week. Your mother calls to say you looked tired."; }
  else if(k === "office"){ you.dOffice = true; msg = "A storefront on Main, two desks and a coffee pot. People come in to complain, which is the point."; }
  else if(k === "staff"){ you.staff = (you.staff || 0) + 1; msg = "You hire an aide who reads everything twice. Your desk gets smaller."; }
  else if(k === "field"){ you.field = (you.field || 0) + 6; msg = "Volunteers, lists, a rented van. None of it shows until election day."; }
  else if(k === "legal"){ you.legal = true; msg = "Counsel retained. They bill by the quarter hour and they are worth it."; }
  else if(k === "poll"){
    const unread = (G.members || []).filter(m => m.kind === "member" && !m.gone && (m.known || 0) < 1).slice(0, 6);
    unread.forEach(m => m.known = Math.max(m.known || 0, 1));
    msg = "The pollster reads six of them for you" + (unread.length ? " (" + listify(unread.map(m => surname(m.name))) + ")" : "") + ". Home rates you at " + Math.round(you.approval) + ", and the trend is " + (you.approval > 50 ? "kind." : "not.");
  }
  else if(k === "press"){ you.standing = clamp((you.standing || 0) + 3, 0, 100); you.approval = clamp(you.approval + 2, 0, 100); you.influence = clamp((you.influence || 0) + 2, 0, 100); msg = "Ten minutes with the cameras on the East Steps. You said one thing and they ran it twice."; }
  note(msg, true);
  try{ achieve("spend"); if(k === "office") achieve("office"); if((you.spent || 0) >= 150) achieve("bigspender"); }catch(e){}
  chestCard();
}
function chestAllyCard(){
  const you = G.you;
  const list = (G.members || []).filter(m => m.kind === "member" && !m.gone && !m.machine && m.party === you.party).sort((a, b) => (b.rel.warmth || 0) - (a.rel.warmth || 0)).slice(0, 8);
  card.innerHTML = '<div class="eyebrow">Back an ally</div><h1>Whose race?</h1>' +
    list.map(m => '<div class="whip__row"><span class="whip__n">' + m.name + '</span><span class="whip__w">margin ' + (m.margin || 0) + (m.backed ? ' · you backed them' : '') + '</span>' +
      '<span class="whip__b"><button type="button" class="btn btn--ghost whip__go" data-back="' + m.id + '">' + money(20) + '</button></span></div>').join("") +
    '<div class="card__actions"><button type="button" class="btn" id="allyBack">Back</button></div>';
  el("allyBack").addEventListener("click", () => chestCard());
  card.querySelectorAll("[data-back]").forEach(bt => bt.addEventListener("click", () => {
    const m = byId(+bt.getAttribute("data-back")); if(!m || you.funds < 20) return;
    you.funds -= 20; you.spent = (you.spent || 0) + 20;
    m.backed = (m.backed || 0) + 5;
    ripple(m, 9, "They put money into my race without being asked. I will not forget it.", 9, true);
    note("You backed " + m.name + "'s race. It will show at the polls, and in the cloakroom.", true);
    try{ achieve("spend"); achieve("patron"); }catch(e){}
    chestCard();
  }));
}
/* 3 · achievements */
const ACH = [
  {k:"whip", t:"Whip", d:"Worked a colleague the whip count had against you."},
  {k:"rival", t:"Who Blinked", d:"Outlasted a rival to the end of the feud."},
  {k:"truce", t:"The Diner Booth", d:"Turned a rival into something like a friend."},
  {k:"cosponsor", t:"Signed On", d:"Got a colleague's name on your bill."},
  {k:"ownbill", t:"Author", d:"Filed a bill of your own."},
  {k:"spend", t:"The Chest Opens", d:"Spent from the war chest."},
  {k:"office", t:"Storefront", d:"Opened a district office."},
  {k:"patron", t:"Patron", d:"Backed an ally's race."},
  {k:"bigspender", t:"Ledger Heavy", d:"Spent 150k from the war chest in one career."},
  {k:"variety", t:"Three Fights", d:"Saw an immigration bill, a foreign aid bill and a states-versus-Union bill to the roll."},
  {k:"reelect", t:"Held", d:"Won re-election."},
  {k:"steps", t:"Still Here", d:"Lost the seat and kept going from the East Steps."},
  {k:"higher", t:"Another Room", d:"Won an office beyond the House."},
  {k:"night", t:"Somebody Was Here", d:"Found what the night left in your office.", hidden:true},
  {k:"anomaly", t:"Unexplained", d:"Found something the building will not explain.", hidden:true},
  {k:"anomaly3", t:"Notebook", d:"Found three things the building will not explain.", hidden:true},
  {k:"received", t:"Received", d:"Changed where you kneel, the slow way.", hidden:true},
  {k:"home", t:"Came Home", d:"Made a confession and returned to the Latin Rite.", hidden:true},
  {k:"smash", t:"Iconoclast", d:"Smashed a Consular idol.", hidden:true},
  {k:"listen", t:"Listener", d:"Let ten colleagues talk without interrupting.", hidden:true},
  {k:"days30", t:"A Month of Sittings", d:"Served thirty days."}
];
function achieve(k){
  G.ach = G.ach || {};
  if(G.ach[k]) return false;
  const a = ACH.find(x => x.k === k); if(!a) return false;
  G.ach[k] = G.day || 1;
  if(k === "anomaly"){ try{ if((G.life && G.life.found || 0) >= 3) achieve("anomaly3"); }catch(e){} }
  try{
    let t = el("achToast");
    if(!t){ t = document.createElement("div"); t.id = "achToast"; t.className = "ach-toast"; document.body.appendChild(t); }
    t.innerHTML = '<i>Achievement</i><b>' + a.t + '</b><span>' + a.d + '</span>';
    t.classList.add("is-on");
    clearTimeout(achieve._t); achieve._t = setTimeout(() => t.classList.remove("is-on"), 4200);
  }catch(e){}
  try{ feed("Achievement: " + a.t + ".", "big"); }catch(e){}
  return true;
}
function achCard(){
  G.running = false;
  const got = G.ach || {};
  const n = ACH.filter(a => got[a.k]).length;
  card.innerHTML = '<div class="eyebrow">Achievements · ' + n + ' of ' + ACH.length + '</div><h1>What the record will say</h1>' +
    ACH.map(a => {
      const has = !!got[a.k];
      const show = has || !a.hidden;
      return '<div class="whip__row' + (has ? '' : ' ach--locked') + '"><span class="whip__n">' + (show ? a.t : '???') + (has ? ' <i>day ' + got[a.k] + '</i>' : '') + '</span>' +
        '<span class="whip__w">' + (show ? a.d : 'Hidden until you find it.') + '</span><span class="whip__b"></span></div>';
    }).join("") +
    '<div class="card__actions"><button type="button" class="btn" id="achClose">Close</button></div>';
  veil.hidden = false;
  el("achClose").addEventListener("click", () => walkNow());
}
function achDaily(){
  try{ if((G.day || 1) >= 30) achieve("days30"); }catch(e){}
}

/* ── 20261011i · the ladder: distinct roles, term limits in law, NPC careers ── */
function lawEnsure(){
  if(!G.law) G.law = {limits:{house:0, senate:2, gov:2, pres:2, bench:0}};
  if(G.noLimits) G.law.limits.pres = 0;
  return G.law;
}
function officeTermsOf(k){ const y = G.you; if(k === "house") return y.terms || 0; y.officeTerms = y.officeTerms || {}; return y.officeTerms[k] || 0; }
function termLimited(k){
  const lim = lawEnsure().limits[k] || 0;
  if(!lim) return false;
  /* the limit binds those who hold the office and want it again */
  return officeTermsOf(k) >= lim;
}
function careerWon(seeking){
  const y = G.you;
  y.officeTerms = y.officeTerms || {};
  y.officeTerms[seeking] = (y.officeTerms[seeking] || 0) + 1;
  if(seeking === "house") y.office = "house";
  y.role = null; y.staffOf = null; y.envoyTo = null;
}
/* NPCs walk the ladder too: a member with a record may leave for the Senate or a governorship */
function npcLadder(news){
  G.ladder = G.ladder || [];
  let n = 0;
  const cands = G.members.filter(m => m.kind === "member" && !m.gone && !m.machine && !(typeof isChaplain === "function" && isChaplain(m))
    && (m.terms || 0) >= 2 && (m.influence || 0) > 40);
  cands.forEach(m => {
    if(n >= 2 || !chance(0.14)) return;
    n++;
    const to = chance(0.5) ? "senate" : "gov";
    const won = chance(0.5 + (m.influence - 40) / 120);
    if(won && (m.traits.ambition || 50) > 62 && (m.traits.loyalty || 50) < 58 && chance(0.12 + ((m.traits.ambition || 50) - 62) / 160)){
      try{ dualStart(m, to, news); }catch(e){}
      return;
    }
    G.members = G.members.filter(x => x !== m);
    G.seatsBy[m.party] = Math.max(0, (G.seatsBy[m.party] || 1) - 1);
    const where = to === "gov" ? "the governor's chair in " + m.state : "the Senate";
    G.ladder.unshift({name:m.name, party:m.party, state:m.state, to, won, term:G.term, creed:m.creed});
    if(G.ladder.length > onumLim(40,"hist")) G.ladder.length = onumLim(40,"hist");
    try{ accolade(m, (won ? "Left the House for " : "Gave up the seat to run for ") + where + "."); }catch(e){}
    const line = won ? m.name + " gave up the seat and won " + where + ". The House loses a vote and gains a phone call."
                     : m.name + " gave up the seat to run for " + where + " and lost. Last seen on the East Steps, shaking hands.";
    if(news) news.push(line); else note(line, true);
  });
}
function senateColleague(){
  const s = (G.ladder || []).filter(x => x.won && x.to === "senate");
  return s.length ? "Senator " + pick(s).name : "Senator " + newName(pick(STATES));
}
/* the powers that come with the chair you hold */
function roleKey(){
  const y = G.you;
  if(y.out) return y.staffOf ? "staff" : y.envoyTo ? "envoy" : "out";
  const o = y.office || "house";
  if(o !== "house") return o;
  if(y.post === "speaker" || y.post === "leader" || y.post === "minority" || y.post === "whip") return "leader";
  if(y.post === "ways" || y.post === "judic" || y.post === "armed") return "chair";
  return "house";
}
const ROLE_T = {house:"Representative", leader:"Party leadership", chair:"Committee chair", senate:"Senator", gov:"Governor",
  pres:"Executive", bench:"Justice", envoy:"Envoy abroad", staff:"Staff to a member", out:"Out of office"};
function rolePowers(){
  const y = G.you, b = G.bill, live = b && !b.done, k = roleKey(), P = [];
  const once = (key) => { y.used = y.used || {}; return y.used[key] === G.day; };
  const mark = (key) => { y.used = y.used || {}; y.used[key] = G.day; };
  if(k === "leader"){
    const mineQ = (G.billQueue || []).findIndex(x => x && x.mine);
    P.push({t:"Set the calendar: bring your bill to the front", off:mineQ < 1, d:"Your filed bill jumps the queue.", run(){
      const q = G.billQueue; const [mb] = q.splice(mineQ, 1); q.unshift(mb); y.standing = clamp(y.standing - 1, 0, 100);
      return "The calendar is yours to write. " + mb.title + " is next."; }});
    P.push({t:"Discipline a member who broke the line", off:once("disc"), d:"Loyalty up, warmth down.", run(){
      mark("disc");
      const m = pick(G.members.filter(x => x.party === y.party && x.kind === "member" && !x.machine && !x.gone)) ; if(!m) return "Nobody to discipline.";
      m.traits.loyalty = clamp(m.traits.loyalty + 8, 0, 100); ripple(m, -8, "Leadership took my committee slot for a week. I will vote the line. I will remember.", -6, true);
      return "You took " + m.name + "'s committee slot for a week. They will vote the line."; }});
  }
  if(k === "chair"){
    P.push({t:"Hold the bill in committee", off:!live || b.held || once("hold"), d:"The roll call slips two days. The sponsor will not thank you.", run(){
      mark("hold"); b.held = true; b.voteDay += 2; y.standing = clamp(y.standing - 2, 0, 100);
      const sp = b.sponsorId != null ? byId(b.sponsorId) : null; if(sp) ripple(sp, -8, "They sat on my bill in committee.", -6, true);
      return b.title + " sits in your committee for two more days."; }});
    P.push({t:"Mark it up toward your own lines", off:!live || b.marked2, d:"The text moves toward you.", run(){
      b.marked2 = true; for(const a in b.pos) b.pos[a] = Math.round(b.pos[a] + (y.pos[a] - b.pos[a]) * 0.18);
      b.line = describeBill(b); return "You rewrite two clauses in markup. The bill is a little more yours."; }});
  }
  if(k === "senate"){
    P.push({t:"Hold a confirmation hearing", off:once("conf"), d:"A nominee for the bench. Confirm, or make a fight of it.", run(){ mark("conf"); confirmCard(); return null; }});
    P.push({t:"Ratify a treaty", off:once("treaty"), d:"A treaty with a realm abroad: read the terms, hear both sides. Two thirds of the Senate, and you.", run(){ mark("treaty"); treatyCard(); return null; }});
    P.push({t:"Filibuster the bill", off:!live || b.filibustered, d:"Talk until it dies or they give way. It costs you influence; home will judge.", run(){
      b.filibustered = true; b.voteDay += 3; y.influence = clamp(y.influence - 6, 0, 100);
      const fit = districtFit(b); y.approval = clamp(y.approval + (fit < 0 ? 4 : -4), 0, 100);
      return "You held the floor for eleven hours. " + b.title + " slips three days. " + (fit < 0 ? "Home liked it." : "Home did not."); }});
  }
  if(k === "bench"){
    const C = (G.cases || []).filter(c => !c.done);
    C.slice(0, 3).forEach(c => {
      const recuse = c.state === y.state || (c.voted && c.voted.indexOf(y.name) >= 0);
      if(recuse) P.push({t:"Recuse yourself: " + c.t, d:"Your own state or your own vote. The rule is plain.", run(){ c.done = true; c.recused = true; feed("Justice " + surname(y.name) + " recused from " + c.t + ".", "good"); return "You recused. The bench decides without you."; }});
      else {
        if(c.dual != null){
          P.push({t:"Rule for the House: " + c.t, d:"One person, one elected office.", run(){ return benchRule(c, true); }});
          P.push({t:"Rule for the member: " + c.t, d:"The Charter is silent; both seats stand.", run(){ return benchRule(c, false); }});
        } else {
        P.push({t:"Rule for the Union: " + c.t, d:"Uphold the federal act.", run(){ return benchRule(c, true); }});
        P.push({t:"Rule for the state: " + c.t, d:"Strike the mandate.", run(){ return benchRule(c, false); }});
        }
      }
    });
    if(!C.length) P.push({t:"No case is ripe", off:true, d:"State-versus-Union suits land here after the House passes a mandate or preemption.", run(){ return ""; }});
  }
  if(k === "gov"){
    const S = (G.states || []).find(s => s.n === y.state);
    P.push({t:"Veto the statehouse bill", off:!(S && S.bill), d:S && S.bill ? S.bill.title : "Nothing on your desk from the statehouse.", run(){
      const t = S.bill.title; reactState(S, S.bill, false); S.bill = null; S.unrest = clamp(S.unrest + 2, 0, 100); y.approval = clamp(y.approval + rint(-3, 4), 0, 100);
      feed("Governor " + surname(y.name) + " vetoed the " + t + ".", "bad"); return "Vetoed. The statehouse will try again next session."; }});
    P.push({t:"Appoint a state judge", off:once("appt"), d:"Three named candidates, each with their own views and backers.", run(){ appointCard("judge"); return null; }});
    P.push({t:"Appoint an agency head", off:once("appt2"), d:"Roads, schools, the constabulary or health: a named person who will advise you from their own view.", run(){
      const k = ["roads", "schools", "police", "health"][Math.floor((G.day || 0) % 4)]; appointCard(k); return null; }});
    P.push({t:"Defy the federal mandate", off:!(G.billKinds && G.billKinds.statefed) || y.defied === G.term, d:"Refuse the money and the rule. Home cheers; the Union sends lawyers.", run(){
      y.defied = G.term; if(S) S.unrest = clamp(S.unrest + 6, 0, 100); y.approval = clamp(y.approval + 6, 0, 100); y.standing = clamp(y.standing - 4, 0, 100);
      G.cases = G.cases || []; G.cases.push({t:"the Union v. " + y.state, state:y.state, day:G.day, voted:[]});
      return "You stood on the capitol steps and said no. The Union's attorney filed by supper."; }});
    P.push({t:"Lead a trade mission abroad", off:once("trade") || y.funds < 20, d:"Foreign money spent at home. Costs 20k from the chest.", run(){
      mark("trade"); y.funds -= 20; const r = pick(realmEnsure()); G.realmRel = G.realmRel || {}; G.realmRel[r.k] = clamp((G.realmRel[r.k] || 0) + 6, -100, 100);
      if(S) S.ind = clamp(S.ind + 2, 0, 100); return "Four days in " + r.capital + ". You came back with a cannery contract."; }});
  }
  if(k === "pres"){
    const last = (G.lastActs || []).find(a => !a.signed && !a.vetoed);
    P.push({t:last ? "Veto: " + last.title : "No act awaits your signature", off:!last, d:"Send it back to the House.", run(){
      last.vetoed = true; y.standing = clamp(y.standing - 3, 0, 100); y.influence = clamp(y.influence + 3, 0, 100);
      reactAct(last.title, last.pos, false); feed(execTitle() + " " + surname(y.name) + " vetoed the " + last.title + ".", "bad"); return "Vetoed. The House can override with two thirds, if it can find them."; }});
    if(last) P.push({t:"Sign: " + last.title, d:"Make it law with your name on it.", run(){ last.signed = true; reactAct(last.title, last.pos, true); y.approval = clamp(y.approval + 2, 0, 100); return "Signed, with eleven pens."; }});
    P.push({t:"Appoint a cabinet secretary", off:once("cab"), d:"Three named candidates; the Senate will have its say.", run(){ appointCard("cab"); return null; }});
    P.push({t:"Send foreign aid on your own authority", off:once("aid"), d:"Money abroad, a realm warmer, a district colder.", run(){
      mark("aid"); const r = pick(realmEnsure()); G.realmRel = G.realmRel || {}; G.realmRel[r.k] = clamp((G.realmRel[r.k] || 0) + 12, -100, 100);
      y.approval = clamp(y.approval - 2, 0, 100); if(G.money) G.money.index = Math.round((G.money.index - 0.5) * 10) / 10;
      feed("The executive sent grain and credit to " + r.t + ".", "good"); return r.t + " will remember. So will the farm counties."; }});
  }
  if(k === "out"){
    const allies = G.members.filter(m => m.party === y.party && m.kind === "member" && !m.machine && !m.gone && (m.rel.warmth || 0) > 10);
    P.push({t:"Join a member's staff", off:!allies.length, d:"Work for someone who kept their seat. It keeps your name in the building.", run(){
      const m = allies.sort((a, b) => b.rel.warmth - a.rel.warmth)[0]; y.staffOf = m.id; y.role = "staff";
      return "You are now on " + m.name + "'s staff. Your old badge still opens the cloakroom door."; }});
    P.push({t:"Accept an envoy's posting abroad", off:(y.standing || 0) < 35 || !(G.exec && !G.exec.you), d:"The executive needs a voice in a foreign capital.", run(){
      const r = pick(realmEnsure()); y.envoyTo = r.k; y.role = "envoy";
      return "You are posted to " + r.capital + ". The cables home will carry your name."; }});
  }
  if(k === "staff"){
    const m = byId(y.staffOf);
    P.push({t:"Draft a bill for your member", off:!m || once("draft"), d:"Their name on it, your work in it.", run(){
      mark("draft"); m.influence = clamp(m.influence + 3, 0, 100); y.standing = clamp(y.standing + 2, 0, 100);
      return "You wrote it in a night. " + m.name + " filed it in the morning and thanked you in the cloakroom."; }});
    P.push({t:"Leave the staff", d:"Back to the East Steps.", run(){ y.staffOf = null; y.role = null; return "You hand in the badge."; }});
  }
  if(k === "envoy"){
    const r = realmEnsure().find(x => x.k === y.envoyTo);
    P.push({t:"Cable home", off:once("cable"), d:"Tell the Union what " + (r ? r.t : "they") + " want.", run(){
      mark("cable"); G.realmRel = G.realmRel || {}; G.realmRel[y.envoyTo] = clamp((G.realmRel[y.envoyTo] || 0) + 6, -100, 100); y.standing = clamp(y.standing + 1, 0, 100);
      return "Cabled: they want " + (r ? r.want : "time") + "."; }});
    P.push({t:"Come home", d:"Resign the posting.", run(){ y.envoyTo = null; y.role = null; return "You come home to the East Steps."; }});
  }
  return P;
}
/* ── the bench: clerks who read the case, justices who argue it, an opinion you write, and petitions that choose what the Court hears ── */
const BENCH_CLERKS = {senior:"Senior law clerk", clerk:"Law clerk", junior:"Junior law clerk"};
function benchClerks(){
  const y = G.you; G.benchStaff = G.benchStaff || {}; const S = {n:y.state};
  Object.keys(BENCH_CLERKS).forEach(k => { if(!G.benchStaff[k]) G.benchStaff[k] = mkOfficial("clerk:" + k + ":" + y.name, S, BENCH_CLERKS[k]); });
  return G.benchStaff;
}
/* which way a justice leans on a case: federalism for state-v-Union suits, one-person-one-office for dual-seat suits */
function justiceLean(j, c){
  const r = rng(seedOf("jl:" + j.name + ":" + c.t)), p = j.pos || {};
  const v = c.dual != null ? (p.lib || 0) * 0.5 - (p.def || 0) * 0.2 : (p.def || 0) * 0.5 + (p.econ || 0) * 0.4 - (p.lib || 0) * 0.2 + (p.wel || 0) * -0.1;
  return v + (r() - 0.5) * 30;
}
function justiceWhy(j, c, forSide, idx){
  const p = j.pos || {}, ax = AXES.slice().sort((a, b) => Math.abs(p[b.k] || 0) - Math.abs(p[a.k] || 0))[0], X = DK_AXIS[ax.k], P = (p[ax.k] || 0) > 0 ? X.hi : X.lo;
  const r = rng(seedOf("jw:" + j.name + ":" + c.t));
  const bank = c.dual != null ? (forSide ? ["The Charter says one person, one office, and I will not read in an exception because it is convenient.", "A seat held in two places is held fully in neither.", "Offices are trusts. A person cannot hold two trusts that may one day pull against each other.", "The framers feared a man in two rooms at once. I take them at their word.", "If we allow it today for someone we like, we allow it tomorrow for someone we do not."]
      : ["The Charter is silent, and a court should not write what the framers left out.", "The voters chose this person twice; I would not undo that on an inference.", "A prohibition has to be written down by someone with the power to write it. We are not that someone.", "I want to see the harm before I vacate a seat. I have not been shown it.", "Silence in the Charter is the legislature's invitation, not ours."])
    : (forSide ? ["The act is the law of the Union and the states may not pick which laws bind them.", "A republic of fifty rulebooks is not a republic. The mandate stands.", "The supremacy clause is not a suggestion, and the state's quarrel is with Congress, not with us.", "If every state may opt out of what it dislikes, the Union is a debating society.", "I see a valid exercise of a power the Charter plainly gives. The policy is for the voters to revisit."]
      : ["The Charter gives the Union enumerated powers, and this is not on the list.", "The states are not the Union's departments. This mandate reaches past what the Charter allows.", "A power that is not named is reserved, and I do not find this one named.", "The state is being told to spend its own money on the Union's idea. That is a commandeering the framers refused.", "Federalism is not a courtesy. It is the reason the states agreed to be a Union at all."]);
  const i0 = Math.floor(r() * bank.length), k = (idx == null ? i0 : (seedOf("jb:" + c.t) + idx) % bank.length);
  return bank[k] + " I come to it as a person who leans " + P.w.toLowerCase() + ", and I will not pretend that has nothing to do with it.";
}
function benchCase(){ return (G.cases || []).find(x => x && !x.done) || null; }
function benchConf2(){
  const y = G.you, c = benchCase(); if(!c){ govCardOpen("Conference", "Nothing is ripe", "No case is ready for conference today. You talk about the long view and the coffee.", "", "bconf"); return null; }
  const clerks = benchClerks(), J = (G.court || []).filter(j => j && !j.you), forS = (j) => justiceLean(j, c) > 0, lobbied = G.confLobby = {};
  const lab = c.dual != null ? ["for the House", "for the member"] : ["for the Union", "for the state"];
  const tally = () => { let u = 0, s2 = 0; J.forEach(j => { const l = lobbied[j.name]; const v = l != null ? l : (forS(j) ? 1 : 0); if(v === 1) u++; else s2++; }); return {u, s2}; };
  const render = () => {
    const t = tally();
    el("cfCount").textContent = "The count so far, without you: " + lab[0] + " " + t.u + ", " + lab[1] + " " + t.s2 + ". Five justices sit; you are the fifth, and three carry it.";
    J.forEach((j, i) => { const l = lobbied[j.name]; const side = l != null ? l === 1 : forS(j); el("jc_" + i).textContent = "“" + justiceWhy(j, c, side, i) + "” — leans " + (side ? lab[0] : lab[1]) + (l != null ? " (you have spoken to them)" : ""); });
  };
  const body = '<div class="muted" style="margin:6px 0">' + pcEsc(c.dual != null ? "Can one person hold two elected offices?" : "A state against the Union over a federal act.") + ' Filed day ' + c.day + (c.state ? ' · ' + pcEsc(c.state) : '') + '.</div>' +
    '<div id="cfCount" class="eyebrow" style="margin:8px 0"></div>' +
    J.map((j, i) => '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + pcEsc(j.name) + '</b> <span class="muted">· Justice · ' + pcEsc(viewWords(j.pos || {})) + ' · named by ' + pcEsc(j.by || "a previous executive") + '</span><div id="jc_' + i + '" style="font-size:13px;margin:4px 0"></div>' +
      '<div class="card__actions"><button type="button" class="btn btn--ghost" data-lobby="' + i + ':1">Press them ' + lab[0] + ' (3 influence)</button><button type="button" class="btn btn--ghost" data-lobby="' + i + ':0">Press them ' + lab[1] + ' (3 influence)</button></div></div>').join("") +
    '<div class="eyebrow" style="margin-top:10px">Your clerks</div>' +
    Object.keys(BENCH_CLERKS).map(k => '<div style="margin:6px 0;padding:6px 10px;border-left:3px solid var(--line-soft)">' + officialHTML(clerks[k]) + '<div class="card__actions"><button type="button" class="btn btn--ghost" data-clk="' + k + '">Ask what they make of it</button></div><div class="dream" id="ck_' + k + '"></div></div>').join("") +
    '<p class="muted" style="font-size:12px">Nothing is decided in conference; it only tells you where the votes are. The opinion is written afterwards.</p>';
  govCardOpen("Conference · " + c.t, "The justices, in their own words", "Each of them has argued it already in their own heads. Their lines are not yours.", body, "bconf");
  render();
  card.querySelectorAll("[data-lobby]").forEach(b => b.addEventListener("click", () => { const [i, side] = b.getAttribute("data-lobby").split(":"), j = J[+i]; if(lobbied[j.name] != null) return; if(y.influence < 3){ el("gcSay").textContent = "You are short of influence."; return; }
    y.influence -= 3; spend(15, 2); const natural = forS(j) ? 1 : 0, want = +side, odds = (natural === want ? 0.9 : 0.25 + (Math.abs(justiceLean(j, c)) < 12 ? 0.3 : 0));
    lobbied[j.name] = chance(odds) ? want : natural; el("gcSay").textContent = lobbied[j.name] === want ? j.name + " will think about it, and gives you more than they meant to." : j.name + " listens politely and does not move."; render(); }));
  card.querySelectorAll("[data-clk]").forEach(b => b.addEventListener("click", () => { const k = b.getAttribute("data-clk"), o = clerks[k], v = justiceLean({pos:o.pos, name:o.name}, c) > 0;
    el("ck_" + k).textContent = "“I read it " + (v ? lab[0] : lab[1]) + ", Justice. " + justiceWhy({pos:o.pos, name:o.name}, c, v) + "”"; }));
  return null;
}
function benchOpinion(){
  const y = G.you, c = benchCase(); if(!c){ govCardOpen("Opinions", "No case is ripe", "There is nothing to decide today. State-versus-Union suits land here once the House passes a mandate.", "", "bopin"); return null; }
  const J = (G.court || []).filter(j => j && !j.you), conf = G.confLobby || {};
  const lab = c.dual != null ? ["for the House", "for the member"] : ["for the Union", "for the state"];
  const recuse = c.state === y.state || (c.voted && c.voted.indexOf(y.name) >= 0);
  if(recuse){ govCardOpen("Opinions · " + c.t, "You must recuse", "Your own state, or a vote you already cast on it. The rule is plain.", '<div class="card__actions"><button type="button" class="btn" id="rcGo">Recuse</button></div>', null); el("rcGo").addEventListener("click", () => { c.done = true; c.recused = true; el("gcSay").textContent = "You recused. The bench decides without you."; try{ kMark("bopin"); }catch(e){} }); return null; }
  const form = [["narrow", "Narrow opinion", "Decide it on this record only. More justices will join; less changes."], ["broad", "Broad opinion", "Settle the principle for every state. Fewer will join; much changes."]];
  const body = '<p class="muted">Filed day ' + c.day + (c.state ? ' · ' + pcEsc(c.state) : '') + '. Choose your side, then how far you write.</p>' +
    form.map(f => '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + pcEsc(f[1]) + '</b> <span class="muted">' + pcEsc(f[2]) + '</span><div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" data-op="' + f[0] + ':1">Write ' + lab[0] + '</button><button type="button" class="btn btn--ghost" data-op="' + f[0] + ':0">Write ' + lab[1] + '</button></div></div>').join("");
  govCardOpen("Opinions · " + c.t, "Write the opinion", "You are the fifth vote. Your opinion is the Court's voice if three join you; if not, it is a dissent.", body, null);
  card.querySelectorAll("[data-op]").forEach(b => b.addEventListener("click", () => { if(c.done) return; const [fm, side] = b.getAttribute("data-op").split(":"), forU = side === "1";
    let joins = 1; J.forEach(j => { const l = conf[j.name], nat = l != null ? l : (justiceLean(j, c) > 0 ? 1 : 0); let vote = nat === (forU ? 1 : 0); if(vote && fm === "broad" && Math.abs(justiceLean(j, c)) < 14 && chance(0.5)) vote = false; if(vote) joins++; });
    const win = joins >= 3, ax = AXES.slice().sort((a, d) => Math.abs((y.pos || {})[d.k] || 0) - Math.abs((y.pos || {})[a.k] || 0))[0], X = DK_AXIS[ax.k], P = ((y.pos || {})[ax.k] || 0) > 0 ? X.hi : X.lo;
    const text = "Justice " + surname(y.name) + ", " + (win ? "for the Court" : "dissenting") + ": “" + (c.dual != null ? (forU ? "The Charter's plain meaning is one person, one office." : "The Charter is silent on a second seat, and silence is not a prohibition.") : (forU ? "The act is a valid exercise of the Union's powers, and the state's objection is to the policy, not the power." : "The Charter does not enumerate this power, and what is not enumerated is reserved to the states.")) + " " + (fm === "narrow" ? "We decide this record and no more." : "We settle the principle for every state, so that no one needs to litigate it again.") + " I write as one who leans " + P.w.toLowerCase() + ", and I invite the reader to weigh that.”";
    spend(60, 6);
    if(win){ const msg = benchRule(c, forU); y.standing = clamp(y.standing + (fm === "broad" ? 3 : 1), 0, 100); if(fm === "broad"){ try{ setPrecedent("wrote the opinion for the Court in " + c.t, "that the Union's reach " + (forU ? "extends to what the states would rather not do" : "stops short of what the Charter does not name")); }catch(e){} const S = (G.states || []).find(x => x.n === c.state); if(S) S.unrest = clamp(S.unrest + (forU ? 2 : -2), 0, 100); }
      el("gcSay").textContent = text + "\n\nJoined by " + (joins - 1) + " of the other four. " + msg; feed("The Court rules in " + c.t + ", " + joins + " to " + (5 - joins) + ".", "good"); }
    else { const msg = benchRule(c, !forU); y.standing = clamp(y.standing + 1, 0, 100); el("gcSay").textContent = text + "\n\nOnly " + (joins - 1) + " of the other four joined you; the Court goes the other way, " + (5 - joins) + " to " + joins + ". Your dissent is printed beside it. " + msg; feed("The Court rules in " + c.t + ", " + (5 - joins) + " to " + joins + ", over your dissent.", "bad"); }
    el("gcSay").style.whiteSpace = "pre-line"; G.confLobby = {}; try{ kMark("bopin"); }catch(e){} card.querySelectorAll("[data-op]").forEach(z => z.disabled = true); }));
  return null;
}
function benchCert(){
  const y = G.you, clerks = benchClerks(), S0 = (G.states || []), done = {};
  const pool = [["the grain tariff act", "a state's refusal to collect it", 0], ["the pension mandate", "a state's refusal to fund it", 1], ["a school standards act", "a state's objection that education is its own", 2], ["the militia levy", "a state's claim that its own militia is not the Union's to call", 3], ["the river survey act", "a state's claim to its own waters", 4]];
  const picks = pool.slice().sort(() => Math.random() - 0.5).slice(0, 3).map(p => { const st = pick(S0).n; return {t:st + " v. the Union (" + p[0] + ")", state:st, what:p[0], gist:p[1], petitioner:newName(st)}; });
  const body = picks.map((p, i) => { const cl = clerks[["senior", "clerk", "junior"][i]], v = (cl.pos.def || 0) > 5 || (cl.pos.econ || 0) > 12;
    return '<div style="margin:10px 0;padding:8px 10px;border-left:3px solid var(--line-soft)"><b>' + pcEsc(p.t) + '</b> <span class="muted">petition by ' + pcEsc(p.petitioner) + ', ' + pcEsc(p.state) + '</span><p style="margin:4px 0;font-size:13px">The state objects to ' + pcEsc(p.what) + ': ' + pcEsc(p.gist) + '.</p>' +
      '<div class="muted" style="font-size:12px">' + pcEsc(cl.name) + ' (' + pcEsc(viewWords(cl.pos)) + '): “' + pcEsc(v ? "I would take it. The question is real and the lower courts disagree." : "I would deny it. The record is thin and the question will come back in better shape.") + '”</div>' +
      '<div class="card__actions"><button type="button" class="btn" data-ce="' + i + ':1">Grant review</button><button type="button" class="btn btn--ghost" data-ce="' + i + ':0">Deny</button></div><div class="dream" id="ce_' + i + '"></div></div>'; }).join("");
  govCardOpen("Petitions for review", "What the Court will hear", "The Court chooses its own docket. Four justices must agree; you have the vote of one. Granting a petition puts a real case on the bench.", body, "bcert");
  card.querySelectorAll("[data-ce]").forEach(b => b.addEventListener("click", () => { const [i, g] = b.getAttribute("data-ce").split(":"), p = picks[+i]; if(done[i]) return; done[i] = 1; spend(15, 2);
    if(g === "1"){ const ok = chance(0.6); if(ok){ G.cases = G.cases || []; G.cases.push({t:p.t, state:p.state, day:G.day, voted:[]}); y.standing = clamp(y.standing + 1, 0, 100); el("ce_" + i).textContent = "Review is granted. " + p.t + " is on the docket and will be argued."; feed("The Court granted review in " + p.t + ".", "good"); } else el("ce_" + i).textContent = "You vote to grant, but the other justices do not join you. It is denied."; }
    else { el("ce_" + i).textContent = "Denied. " + p.petitioner + " will be told by letter, and the lower ruling stands."; }
    card.querySelectorAll('[data-ce^="' + i + ':"]').forEach(z => z.disabled = true); }));
  return null;
}
function benchRule(c, forUnion){
  reactEmit("ruling", {t:c.t, forUnion, state:c.state, dual:c.dual != null});
  if(c.dual != null){
    c.done = true; c.ruled = forUnion ? "union" : "member";
    const m = byId(c.dual);
    feed("The bench ruled for " + (forUnion ? "the House" : (m ? m.name : "the member")) + " in " + c.t + ".", "good");
    G.you.standing = clamp(G.you.standing + 1, 0, 100);
    try{ dualTick(null); }catch(e){}
    return forUnion ? "One person, one elected office. The seat is vacated." : "The Charter is silent, so both seats stand. The House will want an amendment.";
  }
  c.done = true; c.ruled = forUnion ? "union" : "state";
  const S = (G.states || []).find(s => s.n === c.state);
  if(S) S.unrest = clamp(S.unrest + (forUnion ? 7 : -5), 0, 100);
  feed("The bench ruled for " + (forUnion ? "the Union" : c.state) + " in " + c.t + ".", forUnion ? "bad" : "good");
  G.you.standing = clamp(G.you.standing + 1, 0, 100);
  return forUnion ? "The act stands. " + c.state + " will comply, slowly." : "The mandate falls. " + c.state + " keeps its money and its schools.";
}
/* ── the Senator's working day: a staff that speaks, a nominee who answers, a treaty with terms, callers with cases ── */
const SEN_ROLES = {chief:"Chief of staff", legdir:"Legislative director", state:"State director"};
function senStaff(){
  const y = G.you; G.senStaff = G.senStaff || {}; const S = {n:y.state};
  Object.keys(SEN_ROLES).forEach(k => { if(!G.senStaff[k]) G.senStaff[k] = mkOfficial("sen:" + k + ":" + y.name, S, SEN_ROLES[k]); });
  return G.senStaff;
}
function senBrief(){
  const y = G.you, st = senStaff(), S = (G.states || []).find(x => x.n === y.state) || {unrest:30, lean:0, n:y.state}, b = G.bill && !G.bill.done ? G.bill : null;
  const done = {};
  const lean = b ? dkStateLean(S, {pos:b.pos}) : 0;
  const rel = (G.realmRel || {}), realm = WORLD_POWERS.slice().sort((a, c) => (rel[a.k] || 0) - (rel[c.k] || 0))[0];
  const towns = (function(){ try{ return (townsOf(y.state) || []).map(t => t.name); }catch(e){ return []; } })(), town = towns.length ? towns[(G.day || 0) % towns.length] : "the county seat";
  const say = {
    chief:"Morning, Senator. " + (b ? "The " + b.title + " is on the calendar. " + y.state + " leans " + (lean > 12 ? "toward it" : lean < -12 ? "against it" : "both ways on it") + ", so " + (lean > 12 ? "voting aye is the easy vote and I would take it." : lean < -12 ? "an aye will have to be explained at home, and I would want the explanation ready first." : "you can afford to listen to the floor first.") : "Nothing is on the calendar, which gives us a day to do the work nobody sees.") + " Your standing is " + Math.round(y.standing) + (y.standing < 45 ? "; I would build it before you spend it." : "; spend a little of it."),
    legdir:"On the Senate's business: a confirmation hearing in committee, and a treaty with " + (realm ? realm.t : "a neighbour") + " that is " + realmRelLabel(rel[realm ? realm.k : ""] || 0) + " towards us. " + ((st.legdir.pos.def || 0) > 20 ? "I would read the treaty hard: we give away more than we are told." : (st.legdir.pos.def || 0) < -20 ? "I would want that treaty ratified. A paper peace is cheaper than a garrison." : "I have read both and I will tell you what is in them when you ask.") + " The two-thirds rule means one absent senator can sink it.",
    state:"From home: " + (S.unrest > 55 ? "unrest is high, and " + town + " is the worst of it; they want to hear from you by name." : S.unrest > 35 ? town + " is restless but not angry." : "it is quiet; " + town + " asked whether you had forgotten them.") + " " + ((st.state.pos.wel || 0) > 20 ? "Two callers are waiting about pensions and relief, and I would take those first." : (st.state.pos.econ || 0) > 20 ? "The chamber of commerce wants an hour; I would give them one." : "I would take the callers in the order they rang.")
  };
  const acts = {
    chief:[{t:"Plan to vote with " + y.state, d:"Approval if it holds", run(){ y.approval = clamp(y.approval + 1, 0, 100); return "The chief of staff writes the explanation for home before the vote."; }}, {t:"Hold your vote until the floor speaks", d:"Nothing spent", run(){ return "You keep the vote open."; }}],
    legdir:[{t:"Have the treaty read to you tonight", d:"+1 standing in committee", run(){ y.standing = clamp(y.standing + 1, 0, 100); return "A summary and the full text are on your desk by evening."; }}, {t:"Ask for the opposition's reading too", d:"A fairer hearing", run(){ y.influence = clamp(y.influence + 1, 0, 100); return "The director sends for the other side's memorandum."; }}],
    state:[{t:"Take the callers first", d:"Approval at home", run(){ y.approval = clamp(y.approval + 2, 0, 100); return "You tell the state director to book the afternoon for home."; }}, {t:"Send word that you'll write", d:"Small, safe", run(){ y.approval = clamp(y.approval + 1, 0, 100); return "A letter goes out under your name by evening."; }}]
  };
  const body = Object.keys(SEN_ROLES).map(k => '<div style="margin:10px 0;padding:8px 10px;border-left:3px solid var(--line-soft)">' + officialHTML(st[k]) + '<p style="margin:6px 0">“' + pcEsc(say[k]) + '”</p>' +
    '<div class="card__actions" style="flex-wrap:wrap">' + acts[k].map((x, j) => '<button type="button" class="btn btn--ghost" data-sa="' + k + ':' + j + '" title="' + pcEsc(x.d) + '">' + pcEsc(x.t) + '</button>').join("") + '<button type="button" class="btn btn--ghost" data-sw="' + k + '">Ask why</button></div><div class="dream" id="sa_' + k + '"></div></div>').join("");
  govCardOpen("Staff meeting · " + (y.state || ""), "Your staff, in their own words", "Three people who work for you, each with a view of their own.", body, "sbrief");
  card.querySelectorAll("[data-sw]").forEach(b => b.addEventListener("click", () => { const k = b.getAttribute("data-sw"), o = st[k], cr = creedOf(o.creed), og = originOf(o.origin);
    el("sa_" + k).textContent = "“I am " + o.bg + ", of " + cr.t + ", and my people carry the grievance " + og.grievance + ". It colours how I read the room, Senator, so weigh me knowing it.”"; }));
  card.querySelectorAll("[data-sa]").forEach(b => b.addEventListener("click", () => { const [k, j] = b.getAttribute("data-sa").split(":"); if(done[k]) return; done[k] = 1; spend(10, 1); el("sa_" + k).textContent = acts[k][+j].run(); }));
  return null;
}
/* ── the President's day: a cabinet with views, acts with consequences, capitals with a voice ── */
const PRES_ROLES = {treasury:"Secretary of the Treasury", state:"Secretary of State", war:"Secretary of War", justice:"Attorney General"};
function presStaff(){
  const y = G.you; G.presStaff = G.presStaff || {}; const S = {n:y.state};
  Object.keys(PRES_ROLES).forEach(k => { if(!G.presStaff[k]) G.presStaff[k] = mkOfficial("pres:" + k + ":" + y.name, S, PRES_ROLES[k]); });
  return G.presStaff;
}
function presAdvice(o, role, act){
  const p = o.pos, pos = act.pos || {econ:0, lib:0, def:0, wel:0};
  const axis = {treasury:"econ", state:"def", war:"def", justice:"lib"}[role];
  const v = pos[axis] || 0, mine = p[axis] || 0, agree = v * mine > 0 || (Math.abs(v) < 8 && Math.abs(mine) < 14), X = DK_AXIS[axis];
  const topic = {treasury:"the Treasury's books", state:"how the neighbours will read it", war:"the frontier and the fleet", justice:"how the courts will take it"}[role];
  if(Math.abs(v) < 8) return "On " + topic + " it barely matters, Mr President. " + (mine > 20 ? "My own bent is toward " + (X.hi.w).toLowerCase() + ", so I would not lose sleep over it either way." : "I would sign it and spend the effort elsewhere.");
  return (agree ? "I would sign it. On " + topic + " it moves the country " + dkStr(v) + " toward " + (v > 0 ? X.hi.w : X.lo.w).toLowerCase() + ", which is where I would take it myself." : "I would hold it back. On " + topic + " it moves the country " + dkStr(v) + " toward " + (v > 0 ? X.hi.w : X.lo.w).toLowerCase() + ", and I read that the other way.") + " You should know that is my own view and not the whole cabinet's.";
}
function presActs(){
