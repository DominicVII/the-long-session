    if(K.marital !== "married") K.spouse.supportive = 0;
  }
  const nKids = K.marital === "single" && r() > 0.2 ? 0 : Math.min(4, Math.floor(r() * (1 + Math.max(0, (age - 22) / 11))));
  for(let i = 0; i < nKids; i++){ const ka = Math.max(0, Math.min(age - 20, Math.floor(r() * (age - 20)))), ks = r() < 0.5 ? "M" : "F"; K.kids.push({name:kinName(p, sn, ks), sex:ks, age:ka, state:ka < 6 ? "small" : ka < 17 ? "school" : "grown", ill:r() < 0.07, job:ka >= 17 ? pickJob() : null}); }
  [["mother", "F"], ["father", "M"]].forEach(([role, ps]) => { const pa = age + 22 + Math.floor(r() * 14), alive = r() > clamp((pa - 60) / 40, 0, 0.92); K.parents.push({role, sex:ps, name:kinName(p, role === "father" ? sn : null, ps), age:pa, alive, need:alive ? (pa > 78 && r() < 0.5 ? "frail" : pa > 70 && r() < 0.2 ? "ill" : "none") : "none", job:pickJob()}); });
  const nSib = Math.floor(r() * 4);
  for(let i = 0; i < nSib; i++){ const tie = r() < 0.15 ? "estranged" : r() < 0.25 ? "rival" : "close", off = r() < 0.05, ss = r() < 0.5 ? "M" : "F"; K.siblings.push({name:kinName(p, sn, ss), sex:ss, role:ss === "M" ? "brother" : "sister", job:pickJob(), tie, party:KIN_PARTY[Math.floor(r() * 4)], office:off ? KIN_OFFICES[Math.floor(r() * KIN_OFFICES.length)] : null, debt:r() < 0.12}); }
  K.wealth = r() < 0.08 ? "old money" : r() < 0.3 ? "comfortable" : r() < 0.72 ? "modest" : "struggling";
  if(r() < (p.house ? 0.8 : 0.16)){ const who = ["father", "mother", "uncle", "aunt", "grandfather", "grandmother", "cousin"][Math.floor(r() * 7)], off = KIN_OFFICES[Math.floor(r() * 3)]; K.dynasty = {who, office:off, years:5 + Math.floor(r() * 30), strength:Math.round(30 + r() * 60)}; }
  K.inlaws = K.spouse && K.spouse.alive !== false && !K.spouse.ex ? {tie:r() < 0.2 ? "difficult" : "warm"} : null;
  /* where the older family record already names these people, they are the same people: keep the names, give them sexes, and keep both records in step */
  try{ const fr = G.fam && G.fam.p && p.id != null ? G.fam.p[p.id] : null;
    if(fr){
      const fix = (full, sex, lastKeep) => { const parts = String(full || "").split(" "), fn = parts[0], ln = parts.slice(1).join(" "); if(KIN_FIRST[sex].indexOf(fn) >= 0) return full; const pool = KIN_FIRST[sex]; return pool[seedOf("kf:" + full + sex) % pool.length] + (ln ? " " + ln : ""); };
      const JM = {"pastor's assistant":"pastor", "shop owner":"shopkeeper"};
      if(fr.spouse){ fr.spouse.name = fix(fr.spouse.name, opp); K.marital = K.marital === "single" || K.marital === "divorced" ? "married" : K.marital; K.spouse = Object.assign(K.spouse || {supportive:Math.round((r() * 2 - 0.7) * 100) / 100, alive:true, health:"well", party:KIN_PARTY[Math.floor(r() * 4)]}, {name:fr.spouse.name, sex:opp, job:KIN_JOBS[fr.spouse.job] ? fr.spouse.job : (JM[fr.spouse.job] || "clerk"), ex:false}); }
      else { K.spouse = null; if(K.marital === "married") K.marital = "single"; }
      if(fr.kids && fr.kids.length){ K.kids = fr.kids.map((k, i) => { const ks = seedOf("ks:" + p.id + ":" + i) % 2 ? "M" : "F"; k.name = fix(k.name + " " + sn, ks).split(" ")[0]; const age = k.age || 0; return {name:k.name + " " + sn, sex:ks, age, state:age < 6 ? "small" : age < 17 ? "school" : "grown", ill:false, job:age >= 17 ? "clerk" : null}; }); } else if(!fr.spouse) K.kids = [];
      if(fr.parents && fr.parents.length){ fr.parents.forEach((pa, i) => { const ps = i === 0 ? "F" : "M"; pa.name = fix(pa.name, ps); const t0 = K.parents[i]; if(t0){ t0.name = pa.name; t0.alive = !!pa.alive; if(!pa.alive) t0.need = "none"; } }); }
      else K.parents.forEach(x => { x.alive = false; x.need = "none"; });
      if(fr.sibs){ K.siblings = fr.sibs.map((sb, i) => { const ss = seedOf("ss:" + p.id + ":" + i) % 2 ? "M" : "F"; sb.name = fix(sb.name, ss); return Object.assign({name:sb.name, sex:ss, role:ss === "M" ? "brother" : "sister", job:"clerk", tie:"close", party:null, office:null, debt:false}, K.siblings[i] ? {job:K.siblings[i].job, tie:K.siblings[i].tie, party:K.siblings[i].party, office:K.siblings[i].office, debt:K.siblings[i].debt} : {}); }); }
