};
/* the page is going away: one synchronous pass, primary key only (backup holds the last good copy) */
function svFlushSync(){
  try{ if(!G || !G.you || !G.members || !G.members.length) return false;
    const base = saveCaptureBase(); base.members = G.members.map(stripMesh); base.press = (G.press || []).map(stripMesh); base.civ = (G.civ || []).map(stripMesh); base.you = stripMesh(G.you);
    if(SV.rank != null && careerRank(base) < SV.rank) return false;
    const json = JSON.stringify(base, saveRound);
    let ok = svRawWrite(SAVE_KEY, json);
    let raw = json;
    if(!ok){ raw = engWrap(json); ok = svRawWrite(SAVE_KEY, raw); }
    try{ engIdbPut(raw); }catch(e){}
