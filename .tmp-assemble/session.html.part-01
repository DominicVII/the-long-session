    if(SV.rank != null && careerRank(S.base) < SV.rank){ SV.busy = false; return svNext(); }                          /* never a shorter career over a longer one */
    S.body = body; S.json = "{" + body + (body ? "," : "") + '"savedAtMs":' + S.base.savedAtMs + "}";
    svPack(S.json, raw => { S.raw = raw; svIdle(w1, S.explicit); });
  };
  const w1 = () => {
    const big = !!(ENG_IDB.db && S.raw.length > onumLimN("lsMaxChars", 2400000)); let ok = big ? false : svRawWrite(SAVE_KEY, S.raw);
    if(!ok && !big){ careerFreeQuota(); ok = svRawWrite(SAVE_KEY, S.raw); }
    if(!ok && ENG_IDB.db){ try{ engIdbPut(S.raw); ok = true; if(!G._idbOnly){ G._idbOnly = 1; note("Saved to the browser's larger store (the small one is full). Your career is kept.", false); } }catch(e){} }   /* a career too big for localStorage still saves */
    if(!ok) return svDone(S.base, S.explicit, false);
    SV.lastBody = S.body; try{ ENG.lastSave = {plain:S.json.length, stored:S.raw.length, at:Date.now()}; }catch(e){}
    svIdle(w2, S.explicit);
  };
  const w2 = () => { if(S.raw.length <= onumLimN("lsMaxChars", 2400000)) svRawWrite(SAVE_BACKUP_KEY, S.raw); svIdle(w3, S.explicit); };          /* the backup, its own tick */
  const w3 = () => { if(S.raw.length < 1600000) svRawWrite(SAVE_BEST_KEY, S.raw); try{ engIdbPut(S.raw); }catch(e){}  /* IDB put is async */
    SV.last = {ms:performance.now() - T0, plain:S.json.length, stored:S.raw.length}; svDone(S.base, S.explicit, true); };
