    syncPeopleStaged._busy = false;
    if(done) done();
    return;
  }
  let at = 0;
  const step = () => {
    const stop = Math.min(missing.length, at + (MODEST ? 1 : 2)); /* drip flat while walk/idle */
    try{
      for(; at < stop; at++){
        const p = missing[at];
        if(p.look){
          ensureLookMorphs(p.look);
          if(p.mesh && (p.look._faceVer !== 2 || p.look._clothVer !== 7)){
            try{ disposePersonMesh(p.mesh); }catch(e){}
            p.mesh = null; p.faceTex = null;
          }
        }
        if(!p.mesh){
          p.mesh = buildPerson(p);
          if(p.look){ p.look._faceVer = 2; p.look._clothVer = 7; }
        }
        if(p.mesh.parent !== peopleGroup) peopleGroup.add(p.mesh);
        p.mesh.visible = true;
      }
      peopleGroup.updateMatrixWorld(true);
    }catch(e){
      syncPeopleStaged._busy = false;
      if(window.console) console.warn("syncPeople staged", e);
      if(done) done(e);
      return;
    }
    if(at < missing.length){
      nextFrameOrTimeout(step);
      return;
    }
    syncPeopleStaged._busy = false;
    if(done) done();
  };
