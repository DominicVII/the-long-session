     children out and re-add — that freezes matrices / hitch on Best. */
  const list = hereNow();
  const keep = new Set();
  let dirty = false;
  list.forEach(p => {
    if(p.look){
      ensureLookMorphs(p.look);
      /* v2 faces: remesh once so old sticker-heads become real faces */
      if(p.mesh && (p.look._faceVer !== 2 || p.look._clothVer !== 7)){
        try{ disposePersonMesh(p.mesh); }catch(e){}
        p.mesh = null; p.faceTex = null;
        dirty = true;
      }
    }
    if(!p.mesh){
      p.mesh = buildPerson(p);
      if(p.look){ p.look._faceVer = 2; p.look._clothVer = 7; }
      dirty = true;
    }
    keep.add(p.mesh);
    if(p.mesh.parent !== peopleGroup){
      peopleGroup.add(p.mesh);
