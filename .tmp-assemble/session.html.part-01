      else reactSay(null, "The " + d.title + " takes effect in " + d.state + ". " + (d.unrest > 0 ? "The counties are bracing." : "The counties are watching."));
      const rep = (G.members || []).find(m => m && !m.gone && m.state === d.state && m.kind === "member"); if(rep) reactSay(rep, "Representative " + surname(rep.name) + ": the governor signed the " + d.title + "; home will see what it does.", false);
    } else {
      const ok = chance(clamp(0.3 + (d.dir * (S.lean || 0)) / 200, 0.1, 0.8));
      if(ok){ S.ind = clamp(S.ind + d.ind, 0, 100); S.unrest = clamp(S.unrest + d.unrest, 0, 100); y.approval = clamp(y.approval - 2, 0, 100); reactSay(null, "The " + d.state + " legislature overrode your veto of the " + d.title + ". It is law."); }
      else reactSay(null, "The " + d.state + " legislature tried to override your veto of the " + d.title + " and could not find the votes.");
    }
    return; }
  if(e.kind === "treaty"){
    const r = WORLD_POWERS.find(p => p.k === d.k), rel = G.realmRel = G.realmRel || {}; if(!r) return;
    if(d.ok){
