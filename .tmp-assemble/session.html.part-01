/* every line that is spoken aloud is recorded */
{ const _sa = speakAt; speakAt = function(p, text){ try{ if(p && p !== G.you) cndRecord(p.id, text); }catch(e){} return _sa.apply(this, arguments); }; }
/* ambient talk: ask, then speak through the same path */
{ const _oh = overhear; overhear = function(a, b, lineA, lineB){
  if(!a || !b) return _oh.apply(this, arguments);
  if(typeof window.onumCandid === "undefined") return _oh.apply(this, arguments);   /* TEMPORARY FALLBACK */
  const self = this;
  cndAsk(a, b, "ambient", lineA, (tA) => {
    if(!lineB){ _oh.call(self, a, b, tA, null); return; }
    let sent = false; _oh.call(self, a, b, tA, null);
    setTimeout(() => cndAsk(b, a, "ambient-reply", lineB, (tB) => { if(sent || !b || b.gone) return; sent = true; b.say = tB; b.sayT = 4.2; b.sayTo = a.id; b.faceId = a.id; b.faceUntil = G.t + 5; try{ if(a._huddle){ a._huddle.lines.push([b.name, tB]); a._huddle.t = G.t; } }catch(e){} speakAt(b, tB); }), 900);
  }); }; }
/* session floor speeches: ask for the line, apply its effects when it comes */
{ const _ev = window.onumSessionEvent;
  window.onumSessionEvent = function(e){
    try{ if(e && e.action === "speak" && e.actorId !== "you" && !e._cnd && typeof window.onumCandid !== "undefined"){ const m = cndPerson(e.actorId);
      if(m){ const st = (typeof ssnStage === "function" && ssnStage()) || {}; cndAsk(m, "room", "session:" + (e.kind || "") + ":" + (st.id || ""), e.text, (t) => { try{ _ev(Object.assign({}, e, {text:t, _cnd:true})); }catch(_){} }); return {ok:true, pending:true}; } } }catch(err){}
