/* dialect into the town lexicon */
{ const _ts = tlxSnap; tlxSnap = function(){ const s = _ts.apply(this, arguments);
  try{ const seen = {}; everyone().forEach(p => { if(p && !p.gone) seen[rgnAssign(p)] = (seen[rgnAssign(p)] || 0) + 1; });
    s.dialect = {}; Object.keys(seen).forEach(r => { if(RGN_DEF[r]) s.dialect[r] = RGN_DEF[r].dialect.slice(); });
    s.slang = (s.slang || []).concat(Object.keys(s.dialect).reduce((a, r) => a.concat(RGN_DEF[r].dialect.slice(0, 3).map(w => ({w, region:r}))), [])); }catch(e){} return s; }; }
let _rgnFireT = 0;
function rgnFire(){
  clearTimeout(_rgnFireT);
  _rgnFireT = setTimeout(() => { try{ const by = {}; everyone().forEach(p => { if(p && p.birthRegion) by[p.birthRegion] = (by[p.birthRegion] || 0) + 1; });
    const R = rgnEnsure(), trust = {}; RGN_IDS.forEach(a => RGN_IDS.forEach(b => { if(a < b) trust[a + "|" + b] = Math.round(rgnTrust(a, b)); }));
