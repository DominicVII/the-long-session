    wantFace = p.seatFace;
  } else if(moving) wantFace = Math.atan2(dx, dz);
  else if(talking || (dist < 2.4 && moodOf(p).val > -10)) wantFace = Math.atan2(ddx, ddz);
  else if(partner && partner.room === p.room) wantFace = Math.atan2(partner.x - p.x, partner.z - p.z);
  p.facing += clamp(wrapPi(wantFace - p.facing), -2.6*dt, 2.6*dt);

  if(behind && dist > LOD_MID && !talking && !moving){
    if(p.mesh.visible) p.mesh.visible = false;
    return;
  }
  if(!p.mesh.visible) p.mesh.visible = true;

  /* Beyond LOD_FAR / behind camera: placement + mesh LOD only — skip bone posing.
     Mid-band idle and seated poses run on a cadence (renderer still skins once). */
  if(dist >= LOD_FAR || (behind && !talking && !moving)) return;
  u.poseN = (u.poseN|0) + 1;
  const seatedNow = !!(p.sitting && !G.noSit && !G.plainSit);
  /* MAX OPT 20260921: tighter idle pose cadence — near faces still update often. */
  if(seatedNow && !talking && dist >= LOD_NEAR){
    const every = dist >= LOD_MID ? 4 : 3;
    if(u.poseN % every) return;
  }
  if(!moving && !talking && !seatedNow && dist >= LOD_NEAR && dist < LOD_MID && (u.poseN % 2)) return;
  if(!moving && !talking && !seatedNow && dist >= LOD_MID && (u.poseN % 5)) return;

  const ph = p.phase, s = Math.sin(ph), A = 0.58 * (p._gw || 0);

  /* Sitting: the hips come down onto the seat, the thighs go level and
     the shins hang straight to the floor. Nobody walks sitting down. */
  if(p.sitting && !G.noSit && !G.plainSit){
    u._sat = true;
    sessionIdle(p, dt);
    /* Relative to where this person's hips actually are when standing,
       never an absolute height — and a modest fold rather than a right
       angle. A seated figure only has to read as seated; taking the
       bones far from their bind pose is what tears the mesh apart. */
    const sy = (p.sitY || 0) / (u.bodyScale || 1);
    u.pelvis.position.y = sy + u.hipY - H*0.150;
    u.legL.up.rotation.x = -0.92; u.legR.up.rotation.x = -0.92;
    u.legL.lo.rotation.x =  0.86; u.legR.lo.rotation.x =  0.86;
    u.legL.foot.rotation.x = 0.05; u.legR.foot.rotation.x = 0.05;
    u.legL.up.rotation.z =  0.05; u.legR.up.rotation.z = -0.05;
    const t = G.t + (p.shift || 0);
    u.spine.rotation.x = 0.05 + Math.sin(t*0.8)*0.012;
    u.spine.rotation.y = 0;
    u.spine.rotation.z = 0;
    u.pelvis.rotation.y = 0;
    let aL = -0.30, aR = -0.30, eL = -1.10, eR = -1.10, headX = 0, headY = 0;
    if(p.idle === "write"){
      aL = -0.62; eL = -1.55; aR = -0.50; eR = -1.35;
      headX = 0.30 + Math.sin(t*3.1)*0.03;
      u.armR.up.rotation.y = -0.18;
    } else if(p.idle === "nod"){
      headX = Math.max(0, Math.sin(t*1.9)) * 0.16;
    } else if(p.idle === "lean"){
      u.spine.rotation.z = Math.sin(t*0.5)*0.10 + 0.10;
      headY = 0.42; headX = 0.05;
    } else if(p.idle === "stare"){
      headX = -0.22 + Math.sin(t*0.4)*0.04;
    } else if(p.idle === "read"){
      aL = -0.80; aR = -0.80; eL = -1.75; eR = -1.75; headX = 0.34;
    }
    u.armL.up.rotation.x = aL + Math.sin(t*0.7)*0.012;
    u.armR.up.rotation.x = aR - Math.sin(t*0.7)*0.012;
    u.armL.lo.rotation.x = eL; u.armR.lo.rotation.x = eR;
    u.armL.up.rotation.z = 0.10; u.armR.up.rotation.z = -0.10;
    u.headG.rotation.x = headX;
    u.headG.rotation.z = headY * 0.10;
    return;
  }
  if(u._sat){
    u._sat = false;
    u.legL.up.rotation.z = 0; u.legR.up.rotation.z = 0;
    if(u.armR && u.armR.up) u.armR.up.rotation.y = 0;
    if(u.armL && u.armL.up) u.armL.up.rotation.y = 0;
    u.headG.rotation.z = 0;
  }
  u.spine.rotation.z = 0;
  /* gait: thigh swings, knee only bends backward, ankle rolls through */

  u.legL.up.rotation.x =  s*A;
  u.legR.up.rotation.x = -s*A;
  u.legL.lo.rotation.x = -clamp(Math.sin(ph - 1.05), 0, 1) * A * 1.45;
  u.legR.lo.rotation.x = -clamp(Math.sin(ph - 1.05 + Math.PI), 0, 1) * A * 1.45;
  u.legL.foot.rotation.x = -u.legL.lo.rotation.x*0.45 - s*A*0.18;
  u.legR.foot.rotation.x = -u.legR.lo.rotation.x*0.45 + s*A*0.18;

  /* arms counter-swing, elbows carry a resting bend */
  const idleSway = Math.sin(ph*0.7)*0.03;
  u.armL.up.rotation.x = -s*A*0.62 + idleSway;
  u.armR.up.rotation.x =  s*A*0.62 - idleSway;
  u.armL.up.rotation.z =  0.055 + (moving?0.02:0);
  u.armR.up.rotation.z = -0.055 - (moving?0.02:0);
  u.armL.lo.rotation.x = -0.22 - Math.abs(s)*A*0.55;
  u.armR.lo.rotation.x = -0.22 - Math.abs(s)*A*0.55;

  /* pelvis and chest counter-rotate; the body rises twice per stride */
  u.pelvis.rotation.y = s*A*0.14;
  u.spine.rotation.y  = -s*A*0.18;
  u.spine.rotation.x  = moving ? 0.035 : 0.012;
  u.pelvis.position.y = u.hipY + (moving ? Math.abs(Math.sin(ph))*H*0.014 : 0);

  /* idle: weight shifts from one hip to the other, and breathing */
  if(!moving){
    u.shift += dt;
    const w = Math.sin(u.shift*0.42);
    u.pelvis.position.x = w*H*0.010;
    u.pelvis.rotation.z = w*0.028;
    u.spine.rotation.z  = -w*0.020;
  } else {
    u.pelvis.position.x = 0;
    u.pelvis.rotation.z = lerp(u.pelvis.rotation.z, 0, 0.15);
    u.spine.rotation.z  = lerp(u.spine.rotation.z, 0, 0.15);
  }
  u.spine.scale.y = 1 + Math.sin(G.t*1.5 + p.id)*0.011;

  /* head tracks you; blink on its own clock */
  const headWant = (dist < 8 ? clamp(wrapPi(Math.atan2(ddx,ddz) - p.facing), -0.95, 0.95) : 0)
                 + u.glanceX * (dist < 8 ? 0.5 : 1);
  u.headG.rotation.y = lerp(u.headG.rotation.y, headWant, 0.10);
  u.headG.rotation.x = lerp(u.headG.rotation.x, moving ? -0.03 : 0.02, 0.05);
  /* the lid actually comes down over the painted eye */
  u.blink -= dt;
  if(u.blink < 0){
    const shut = u.blink > -0.10;
    const open = u.hu * 0.001, closed = u.hu * 0.075;
    if(u.lidL){ u.lidL.scale.y = u.lidR.scale.y = shut ? closed : open; }
    if(u.blink < -0.10) u.blink = 2.2 + Math.random()*5.4;
  }
  /* people do not stare: the eyeline drifts and comes back */
  u.glance -= dt;
  if(u.glance < 0){ u.glanceX = (Math.random()*2-1)*0.26; u.glance = 1.6 + Math.random()*4.5; }

  /* speaking: the mouth works and one hand makes the point */
  if(talking){
    u.gest += dt;
    const m2 = 0.5 + Math.abs(Math.sin(u.gest*7.5))*0.9;
    u.mouth.scale.y = u.mouth.scale.x*0.17*m2;
    u.armR.up.rotation.x = -0.42 + Math.sin(u.gest*2.1)*0.16;
    u.armR.up.rotation.z = -0.26;
    u.armR.lo.rotation.x = -1.05 + Math.sin(u.gest*3.0)*0.28;
    u.headG.rotation.x += Math.sin(u.gest*2.6)*0.035;
  } else {
    u.mouth.scale.y = lerp(u.mouth.scale.y, u.mouth.scale.x*0.17, 0.2);
    u.gest = 0;
  }
}

/* ── name plates (DOM, so the type stays crisp) ──────────── */
const plates = [];
for(let i=0;i<10;i++){
  const d = document.createElement("div");
  d.className = "plate"; d.style.display = "none";
  if(sceneEl) { sceneEl.appendChild(d); plates.push(d); }
}
const V = new THREE.Vector3();
/* The view only changes size when the window does. Measuring it sixty
   times a second forces the browser to re-run layout for nothing. */
let SRECT = null;
function sceneRect(){
  if(!SRECT) SRECT = sceneEl.getBoundingClientRect();
  return SRECT;
}
function dropRect(){ SRECT = null; }
addEventListener("resize", dropRect);
addEventListener("orientationchange", dropRect);
if(window.ResizeObserver) new ResizeObserver(dropRect).observe(sceneEl);
/* 20261030q: a plate is for a person you can see. Facing a blank corridor wall, the people on its other side (Owen Nowak, Omar Mansour)
   kept their tags: nothing tested the wall between. Segment camera->person against the room's wall boxes (VW, built by wallScan). */
function plateBlocked(p){
  try{ if(typeof VW === "undefined" || !VW.boxes || VW.room !== G.room) return false; const ax = cam.x, az = cam.z, bx = p.x, bz = p.z;
    for(const b of VW.boxes){ if((b.x1 - b.x0) * (b.z1 - b.z0) > 60) continue;
      let t0 = 0, t1 = 1; const dx = bx - ax, dz = bz - az, e = 0.05;
      const clip = (pp, q) => { if(Math.abs(pp) < 1e-9) return q >= 0; const t = q / pp; if(pp < 0){ if(t > t1) return false; if(t > t0) t0 = t; } else { if(t < t0) return false; if(t < t1) t1 = t; } return true; };
      if(clip(-dx, ax - (b.x0 + e)) && clip(dx, (b.x1 - e) - ax) && clip(-dz, az - (b.z0 + e)) && clip(dz, (b.z1 - e) - az) && t0 < t1 && t1 > 0.02 && t0 < 0.95) return true; }
  }catch(e){} return false;
}
function updatePlates(focus){
  const rect = sceneRect();
  const lookX = Math.sin(cam.yaw), lookZ = Math.cos(cam.yaw);
  let list = hereNow().map(p => {
    const dist = Math.hypot(p.x-cam.x, p.z-cam.z);
    const ahead = ((p.x - cam.x) * lookX + (p.z - cam.z) * lookZ);
    return {p, dist, ahead};
  }).filter(o => o.dist < 11 && o.ahead > 0.35 && !plateBlocked(o.p));
  list.sort((a,b) => {
    if(focus && a.p === focus) return -1;
    if(focus && b.p === focus) return 1;
    return a.dist - b.dist;
  });
  list = list.slice(0, focus ? 2 : 3);
  const used = [{x:90, y:36}, {x:rect.width - 140, y:48}];
  if(PROC.on) used.push({x:rect.width*0.5, y:rect.height - 88});
  const pending = [];
  let n = 0;
  for(const o of list){
    const p = o.p;
    const gy = (typeof groundAt === "function") ? groundAt(p.z, p.room || G.room) : 0;
    const hy = ((p.look && p.look.height) || 1.72) + gy + 0.22;
    V.set(p.x, hy, p.z).project(camera);
    if(V.z <= 0 || V.z >= 1) continue;
    let sx = (V.x*0.5+0.5)*rect.width, sy = (-V.y*0.5+0.5)*rect.height;
    if(!isFinite(sx) || !isFinite(sy)) continue;
    if(sx < 28 || sx > rect.width-28 || sy < 28 || sy > rect.height-70) continue;
    let lift = 0;
    while(used.some(u => Math.abs(u.x-sx) < 110 && Math.abs(u.y-(sy-lift)) < 36) && lift < 90) lift += 36;
    sy -= lift;
    const d = plates[n++];
    if(!d) break;
    const partner = p.sayTo && p.sayTo !== "you" ? byId(p.sayTo) : null;
    const toYou = p.sayTo === "you" && p.sayT > 0 && p.say;
    const toSelf = p.sayTo === "self" && p.sayT > 0 && p.say;
    const toOther = p.sayT > 0 && p.say && partner && partner.room === p.room;
    const spoken = !!(toYou || toOther);
    const sub = p.kind==="press" ? p.outlet : p.kind==="civ" ? (polPlate(p) || p.role)
              : (p.post ? postTitle(p.post) : partyLabel(p.party));
    const col = partyColorHex((p.pol && p.pol.nonpartisan) ? "IND" : (p.party || "IND"));
    const line = toYou ? "“" + p.say + "”"
               : toOther ? "to " + surname(partner.name) + ": “" + p.say + "”"
               : toSelf ? "“" + (String(p.say).length > 84 ? String(p.say).slice(0, 80).replace(/\s+\S*$/, "") + "…" : String(p.say)) + "”"
               : "";
    const sig = p.name + "|" + sub + "|" + col + "|" + line;
    if(d._sig !== sig){
      d._sig = sig; d._half = 0;
      d.innerHTML = "<b></b><span></span>" + (line ? "<span class='said'></span>" : "");
      d.children[0].textContent = p.name;
      d.children[1].textContent = sub;
      d.children[1].style.color = col;
      if(line) d.children[2].textContent = line;
    }
    const cls = "plate" + (p === focus ? " is-focus" : "") + (toSelf && !spoken ? " is-thought" : "");
    if(d._cls !== cls){ d._cls = cls; d.className = cls; }
    if(d._shown !== 1){ d._shown = 1; d.style.display = "block"; }
    d.style.top = sy + "px";
    d.style.opacity = clamp(1.2 - o.dist/12, 0.4, 1);
    pending.push({d, sx, sy});
    used.push({x:sx, y:sy});
  }
  for(; n<plates.length; n++){
    const d = plates[n];
    if(d._shown !== 0){ d._shown = 0; d.style.display = "none"; }
  }
  for(const q of pending) if(!q.d._half) q.d._half = q.d.offsetWidth / 2;
  for(const q of pending){
    const half = q.d._half;
    q.d.style.left = clamp(q.sx, half + 6, rect.width - half - 6) + "px";
  }
}
/* ══════════════════════════════════════════════════════════
   WITNESSES
   The country walks into this building and sits in a chair with its
   hands folded. A nurse from a county with no maternity floor. A man
   who owns the plant that closed. A colonel who will not answer the
   question. They are not politicians and they do not care about the
   count — they came because something happened to them, and the room
   has to sit there and listen to it.
   Some of them unite a room that has been fighting for a week. Some
   of them split one that agreed on everything an hour ago. And a
   member of this House can be put in that chair like anybody else.
   ══════════════════════════════════════════════════════════ */
const WIT_KIND = [
  {k:"nurse",   role:"a nurse",                     dom:"health", cred:82, sym:88, split:-1,
   line:"I drove a woman forty-one miles in the back of my own car because there was nowhere closer. She was fine. The next one will not be."},
  {k:"owner",   role:"the owner of the plant",      dom:"labour", cred:64, sym:38, split:2,
   line:"I employed four hundred people for nineteen years. You are about to make it illegal for me to employ any of them at a price anyone will pay."},
  {k:"steward", role:"a union steward",             dom:"labour", cred:70, sym:74, split:2,
   line:"The floor has been unsafe since before I started. Three men lost fingers last year and every one of them was told it was their own carelessness."},
  {k:"banker",  role:"a bank director",             dom:"bank",   cred:58, sym:22, split:3,
   line:"Confidence is not a thing you legislate. If this House charters a bank on these terms, the paper will not be worth what you print on it."},
  {k:"colonel", role:"a colonel",                   dom:"navy",   cred:76, sym:52, split:2,
   line:"I will answer any question this committee is cleared to ask, and I will decline the ones it is not, and I will not apologise for the difference."},
  {k:"widow",   role:"a widow",                     dom:"levee",  cred:88, sym:96, split:-3,
   line:"The water came up the road at four in the morning. I have the letter from this Congress promising the levee. It is dated eleven years ago."},
  {k:"blower",  role:"a former clerk in the department", dom:"press", cred:66, sym:70, split:3,
   line:"I made copies because I was told to shred them. I understand what that makes me. I would do it again."},
  {k:"teacher", role:"a schoolteacher",             dom:"school", cred:80, sym:84, split:-1,
   line:"I have thirty-eight children in a room built for twenty-two and a roof that comes in when it rains. I am not asking for a grant. I am asking for a roof."},
  {k:"lobbyist",role:"a registered agent",          dom:"tariff", cred:40, sym:14, split:4,
   line:"I represent my clients' interests openly and I file every disclosure this House requires. I am the only honest man in the room by that measure."},
  {k:"sheriff", role:"a county sheriff",            dom:"court",  cred:72, sym:56, split:2,
   line:"You can write whatever you like in here. I am the one who has to go and knock on the door at six in the morning and explain it."},
  {k:"engineer",role:"a bridge engineer",           dom:"rail",   cred:86, sym:60, split:-1,
   line:"I inspected that span in March and I wrote the word 'urgent' three times. I have the report. Somebody in this building has it too."},
  {k:"fisher",  role:"a fisherman",                 dom:"docks",  cred:74, sym:78, split:0,
   line:"The dock works three days a week. I work three days a week. My father worked six and thought that was hard."}
];
const WIT_MANNER = [
  {k:"plain",   t:"plain", note:"answers the question and stops"},
  {k:"angry",   t:"angry", note:"has been waiting a long time to say this"},
  {k:"frightened", t:"frightened", note:"keeps looking at the door"},
  {k:"lawyered", t:"careful", note:"has clearly been prepared by somebody"},
  {k:"weary",   t:"weary", note:"has told this story before and nothing happened"},
  {k:"sharp",   t:"sharp", note:"is quicker than the committee expected"}
];
function makeWitness(dom){
  const pool = dom ? WIT_KIND.filter(k => k.dom === dom) : WIT_KIND;
  const base = pick(pool.length ? pool : WIT_KIND);
  const st = pick(STATES);
  const L = stateLore(st);
  const town = L && L.towns.length ? pick(L.towns) : null;
  const manner = pick(WIT_MANNER);
  /* Built off a real person so they have everything the rest of the
     game expects to find — a temperament, a face, a body — and can
     simply be walked into the room and sat at the table. */
  const w = makeMember("IND", {state:st});
  w.kind = "civ";
  w.witness = true;
  Object.assign(w, {
    role:base.role,
    k:base.k, dom:base.dom,
    state:st, town:town ? town.name : st,
    cred:clamp(base.cred + rint(-12,12), 5, 99),
    sym: clamp(base.sym  + rint(-12,12), 0, 100),
    split:base.split,
    manner,
    opening:base.line,
    trouble:town ? town.trouble : "something nobody in this building has had to live with",
    heat:0, broken:false, defended:false, member:null
  });
  w.cause = base.dom;
  return w;
}
/* they walk in, sit at the table, and leave when it rises */
function seatPanel(){
  if(!PROC.panel) return;
  PROC.panel.forEach((W, i) => {
    if(W.member) return;                 /* a member already has a body */
    if(G.civ.indexOf(W) < 0) G.civ.push(W);
    W.room = G.room; W.gone = false;
    W.x = W.tx = (W.seatX === undefined ? -1.05 + i*1.05 : W.seatX);
    W.z = W.tz = (W.seatZ === undefined ? 4.40 : W.seatZ);
    W.facing = 0;   /* chairs face the dais (+z) */
    W.sitting = true; W.sitY = 0; W.seatFace = 0;
  });
  if(!houseQuiet()) markRenderDirty();
}
function clearPanel(){
  if(!PROC.panel) return;
  PROC.panel.forEach(W => {
    if(W.member) return;
    W.sitting = false;
    const i = G.civ.indexOf(W);
    if(i >= 0) G.civ.splice(i, 1);
  });
  PROC.panel = null;
  if(!houseQuiet()) markRenderDirty();
}
/* a member of this House, in the chair, answering for something */
const WIT_CHARGE = [
  {k:"money",  t:"where the money for the last campaign came from"},
  {k:"vote",   t:"a vote that moved the day after a donation landed"},
  {k:"threat", t:"what was said to a member in a corridor with no witnesses"},
  {k:"leak",   t:"a document that reached a newspaper before it reached the committee"},
  {k:"contract", t:"a contract that went to a firm run by a cousin"}
];
function summonMember(m){
  const charge = pick(WIT_CHARGE);
  const bio = bioOf(m);
  m.x = m.tx = 0; m.z = m.tz = 4.20; m.facing = Math.PI;
  m.sitting = true; m.seatFace = Math.PI; m.sitY = 0;
  return {
    id:"witm" + m.id, kind:"witness", member:m, name:m.name,
    role:"a member of this House",
    k:"member", dom:"court", state:m.state, town:bio.town,
    cred:clamp(40 + m.traits.discretion*0.3, 10, 90),
    sym:clamp(50 + m.rel.warmth*0.3, 0, 100),
    split:3, charge,
    manner:pick(WIT_MANNER),
    opening:"I have come voluntarily and I have nothing to hide. Ask me about " + charge.t + " and I will answer it.",
    trouble:bio.trouble, heat:0, broken:false, defended:false
  };
}
/* what the room does about them, all on its own */
function witnessMoves(W, howHard){
  const here = G.members.filter(m => m.room === G.room && !m.gone);
  /* A sympathetic witness pulls a room together; a divisive one pulls
     it apart, and you can watch it happen. */
  here.forEach(m => {
    const believes = (W.cred + (m.traits.conviction < 50 ? 10 : -6)) > rint(20, 100);
    const moved = (W.sym / 100) * (believes ? 1 : 0.35);
    const dir = W.split < 0 ? 1 : (m.party === "FED" ? 1 : -1);
    m.sway = (m.sway || 0) + dir * moved * (2.4 + Math.abs(W.split)) * (1 - m.traits.conviction/140);
    if(W.split < -1) m.noise = clamp((m.noise || 0) + 3, -40, 40);   /* the room softens */
    if(W.split > 2)  m.noise = clamp((m.noise || 0) - 2, -40, 40);   /* the room hardens */
  });
  if(howHard === "hard"){
    W.heat++;
    if(W.heat >= 2 && W.cred < 62 && !W.broken){
      W.broken = true;
      note("The witness came apart under questioning.", true);
    }
  }
}
/* the questions a member of this House can actually ask */
function witnessQuestions(W){
  const out = [];
  out.push({t:"Ask them what happened", tone:"open", c:12,
    say:"Take your time and tell the committee what happened, in your own words.",
    reply:() => W.opening + " " + (W.manner.k === "frightened" ? "…I am sorry. Give me a moment."
                                 : W.manner.k === "angry" ? "And I have said all this before, to people who did nothing."
                                 : ""),
    hard:false, stand:4, app:2});
  out.push({t:"Press them hard", tone:"cold", c:16,
    say:"That is not what you told the department in March. Which of the two was true?",
    reply:() => W.cred > 70
      ? "Both were true. You are reading the March letter without the annexe, and the annexe is the whole of it."
      : (W.manner.k === "lawyered" ? "I would want to see the document before I answer that."
                                   : "…I do not have an answer to that today."),
    hard:true, stand:6, app:-2, risk:true});
  out.push({t:"Give them room", tone:"open", c:10,
    say:"Nobody is trying to catch you out. Say it however you need to.",
    reply:() => W.manner.k === "frightened"
      ? "Thank you. …Nobody has said that to me all week."
      : "Then I will say it plainly, and the committee can do what it likes with it.",
    hard:false, stand:2, app:3, warm:true});
  if(W.member) out.push({t:"Defend your colleague", tone:"open", c:14,
    say:"The member has sat in this House for years and nobody has produced a document. Let us not pretend otherwise.",
    reply:() => "…Thank you. I would rather have answered it than been rescued from it, but thank you.",
    hard:false, stand:-3, defend:true});
  if(W.member) out.push({t:"Ask the question nobody will", tone:"cold", c:18,
    say:"Did you know, when you cast that vote, who had paid for the room you cast it in?",
    reply:() => W.cred > 65 ? "I knew exactly who paid for it, and I would cast it again."
                            : "I… would have to check the record on that.",
    hard:true, stand:9, risk:true, expose:true});
  out.push({t:"Thank them and let them go", tone:"open", c:6,
    say:"You have come a long way to say that. The committee is grateful.",
    reply:() => "I did not come to be thanked. But I will take it.",
    hard:false, stand:1, app:1, end:true});
  return out;
}
function witnessTip(W){
  return '<div class="tip__t">' + W.name + '</div>' +
    '<div class="tip__s">' + cap(W.role) + ' · ' + W.town + ', ' + W.state + '</div>' +
    '<p>' + cap(W.manner.t) + ' — ' + W.manner.note + '.</p>' +
    '<p class="tip__q">' + W.opening + '</p>' +
    '<p class="tip__f">Back home, ' + W.trouble + '.' +
      (W.charge ? ' Called to answer for ' + W.charge.t + '.' : '') + '</p>';
}

/* ══════════════════════════════════════════════════════════
   THE ROOM IS LISTENING
   Nothing you say in this building is said to one person. Whoever is
   standing close enough hears it, decides what they think of it, and
   says so — or files it away and says nothing, which is worse. Speak
   to the room on purpose and you are addressing all of them at once,
   with everything that follows from that.
   ══════════════════════════════════════════════════════════ */

/* who is close enough to make out the words */
function audience(exclude){
  return hereNow().filter(p =>
    p !== exclude && !p.gone && p.kind !== "you" && audible(p));
}
/* what somebody makes of a thing said in front of them */
function readTone(text){
  const t = " " + String(text).toLowerCase() + " ";
  return {
    hostile: /\b(lie|lied|liar|lying|coward|disgrace|shameful|corrupt|resign|hypocrite|useless|shut up|damn)\b/.test(t),
    warm:    /\b(thank|grateful|agree|proud|respect|help|together|glad|well said|good of you)\b/.test(t),
    ask:     /\?\s*$|^\s*(will|would|can|could|do|are|is|what|why|who|how|when)\b/i.test(text),
    promise: /\b(i will|i'll|i promise|you have my word|count on me)\b/.test(t),
    billish: !!(G.bill && !G.bill.done &&
              (/\b(bill|vote|clause|floor|amendment|roll call)\b/.test(t) ||
               t.indexOf(String(G.bill.title).toLowerCase().split(" ")[0]) >= 0)),
    heat:    (/[!?]{2,}/.test(text) ? 1 : 0) + (/[A-Z]{5,}/.test(text) ? 1 : 0)
  };
}
/* Everybody within earshot forms a view. Some of them say it out loud.
   Returns what the room did, so it can be reported honestly. */
function roomHears(text, opts){
  opts = opts || {};
  const tone = readTone(text);
  const heard = audience(opts.exclude);
  const out = {heard:heard.length, backed:[], objected:[], noted:[]};
  heard.forEach((p, i) => {
    if(p.kind !== "member" && p.kind !== "press" && p.kind !== "civ") return;
    /* how close it is to what they already think */
    const align = tone.billish && G.bill
      ? (memberVote(p, G.bill) > 0) === ((G.you.lean || 0) >= 0) ? 1 : -1
      : 0;
    const warmth = p.rel ? p.rel.warmth : 0;
    let view = align * 26 + warmth * 0.3 + (tone.warm ? 18 : 0) - (tone.hostile ? 26 : 0)
             - tone.heat * 10 + (tone.promise ? 10 : 0) + rint(-14, 14);
    /* a discreet person keeps their face still whatever they think */
    const speaks = chance(0.20 + (100 - p.traits.discretion)/230 + Math.abs(view)/300);
    if(view > 14){
      out.backed.push(p);
      ripple(p, opts.weight === undefined ? 2 : opts.weight,
        "You said that in front of me and I was glad you did.", 2);
      if(speaks) sayInRoom(p, fresh(() => pick(["Hear, hear.", "That is right.", "Well said.",
        "Somebody had to say it.", "I will back that.", "Say it again for the record.",
        "That is my view exactly.", "Good. About time.", "You have my name on that.",
        "I have been waiting for somebody to put it like that."]), 14));
    } else if(view < -16){
      out.objected.push(p);
      ripple(p, -(opts.weight === undefined ? 2 : opts.weight) - 1,
        "You said that where I had to stand and listen to it.", -3);
      if(speaks) sayInRoom(p, fresh(() => pick(["That is not right.", "I do not accept that.",
        "You know better than that.", "Say that outside.", "No.",
        "That is easy to say standing there.", "You have no business saying that here.",
        "I will be answering that later.", "Careful.", "That will be remembered."]), 14));
    } else {
      out.noted.push(p);
      if(chance(.18)) sayInRoom(p, fresh(() => pick(["Hm.", "Noted.", "If you say so.",
        "Right.", "We shall see.", "Mm.", "As you like."]), 10));
    }
    /* the press are always working */
    if(p.kind === "press" && (tone.hostile || tone.promise)){
      p.trust = clamp((p.trust || 50) + (tone.promise ? 3 : -2), 0, 100);
      if(tone.hostile) journal(surname(p.name) + " was standing there when you said it.");
    }
  });
  return out;
}
let sayQ = 0;
function sayInRoom(p, line){
  /* stagger them so the room answers rather than shouting in unison */
  const wait = 500 + (sayQ++ % 4) * 850 + Math.random()*350;
  setTimeout(() => {
    if(!p || p.gone || p.room !== G.room) return;
    p.say = line; p.sayT = 3.6; p.sayTo = "you"; p.faceUntil = G.t + 4;
    speakAt(p, line);
  }, wait);
}
/* ── speaking to all of them on purpose ── */
function addressRoom(text){
  const heard = audience(null);
  if(!heard.length){
    el("wireState").textContent = "Nobody close enough to hear you.";
    return false;
  }
  appendMsg("you", text);
  speak(null, text);
  feed("You address the room.");
  if(checkSpeakBlasphemy(text, "you")){ refreshPanels(); return true; }
  spend(rint(6, 12), 2);
  /* said to everybody, it weighs more than said to one */
  const r = roomHears(text, {weight:3});
  const tone = readTone(text);
  const you = G.you;
  if(r.backed.length > r.objected.length){
    you.standing = clamp(you.standing + 2, 0, 100);
    you.influence = clamp(you.influence + 1, 0, 100);
  } else if(r.objected.length > r.backed.length){
    you.standing = clamp(you.standing - 2, 0, 100);
  }
  if(tone.promise && r.heard > 2){
    /* a promise made in front of a room is a promise people will hold you to */
    G.pledgesMade = (G.pledgesMade || 0) + 1;
    r.backed.concat(r.noted).forEach(p =>
      remember(p, "You gave your word in front of the whole room.", 5, true));
    note("You gave your word in front of " + r.heard + " people.", true);
  }
  if(tone.hostile && r.heard > 1) note("You said that where everybody could hear it.", true);
  reportRoom(r);
  refreshPanels();
  return true;
}
function reportRoom(r){
  const bits = [];
  if(r.backed.length)   bits.push(r.backed.length + " with you");
  if(r.objected.length) bits.push(r.objected.length + " against");
  if(r.noted.length)    bits.push(r.noted.length + " said nothing");
  feed(r.heard + " heard it — " + (bits.length ? listify(bits) : "and nobody moved") + ".");
  const names = r.backed.slice(0,2).map(p => surname(p.name));
  if(names.length) feed(listify(names) + " backed you out loud.");
  const ag = r.objected.slice(0,2).map(p => surname(p.name));
  if(ag.length) feed(listify(ag) + " came back at you in front of everyone.");
}
/* who is standing close enough to hear a conversation, for the panel */
function listeners(m){
  return audience(m).filter(p => p.kind === "member" || p.kind === "press");
}
function listenerLine(m){
  const L = listeners(m);
  if(!L.length) return "";
  const who = L.slice(0,3).map(p => '<span' + tipAttr("who", p.id) + '>' + surname(p.name) + '</span>');
  return '<span class="hearing">' + (L.length === 1 ? "within earshot: " : L.length + " within earshot: ") +
    who.join(", ") + (L.length > 3 ? " and " + (L.length - 3) + " more" : "") + '</span>';
}

/* ══════════════════════════════════════════════════════════
   WHAT THEY ARE TO EACH OTHER
   Up to now everything anybody felt was measured against you: their
   warmth toward you, their memory of you, what they owed you. Between
   themselves there was only a fixed list of friends and one rival,
   set on the day they were made and never touched again.
   That is not a building full of people; it is a building full of
   dials pointed at one man. So every pair of members now has a
   record of its own — warmth, debt, and things they remember about
   each other — and they spend the day writing into it whether you
   are in the room or not. Alliances form. Debts get called. People
   fall out in public and stay fallen out.
   ══════════════════════════════════════════════════════════ */
function pairKey(a, b){
  const x = a.id, y = b.id;
  return (x < y ? x + "|" + y : y + "|" + x);
}
function tieOf(a, b){
  /* tieOf, not tie: a party-colour material called "tie" lives inside
     buildPerson and would shadow a global of that name there */
  if(!G.ties) G.ties = {};
  const k = pairKey(a, b);
  if(!G.ties[k]){
    /* they start where the old fixed lists put them, and move from there */
    const ally = (a.allies || []).indexOf(b.id) >= 0 || (b.allies || []).indexOf(a.id) >= 0;
    const rival = a.rival === b.id || b.rival === a.id;
    const near = a.party === b.party ? 12 : -6;
    const home = a.state === b.state ? 10 : 0;
    G.ties[k] = {
      w: clamp((ally ? 46 : rival ? -44 : 0) + near + home + cultTieBias(a, b) + famTieBias(a, b) + rint(-8, 8), -100, 100),
      debt: 0, mem: [], since: G.day
    };
  }
  return G.ties[k];
}
function tieShift(a, b, d, what){
  const t = tieOf(a, b);
  t.w = clamp(t.w + d, -100, 100);
  if(what){
    t.mem.unshift({t:what, d:d, day:G.day});
    if(t.mem.length > onumLim(6,"npc")) t.mem.pop();
  }
  /* and the people close to each of them hear about the big ones */
  if(Math.abs(d) >= 8){
    (a.allies || []).forEach(id => { const c = byId(id); if(c && c !== b) tieOf(c, b).w = clamp(tieOf(c, b).w + d*0.3, -100, 100); });
    (b.allies || []).forEach(id => { const c = byId(id); if(c && c !== a) tieOf(c, a).w = clamp(tieOf(c, a).w + d*0.3, -100, 100); });
  }
}
function closestTo(m){
  if(!G.ties) return [];
  const out = [];
  G.members.forEach(o => {
    if(o === m || o.gone) return;
    const t = G.ties[pairKey(m, o)];
    if(t) out.push({who:o, w:t.w});
  });
  return out.sort((x, y) => y.w - x.w);
}
/* how somebody's own people pull their vote about */
function tiePull(m, b){
  if(!G.ties || !b) return 0;
  let pull = 0;
  G.members.forEach(o => {
    if(o === m || o.gone) return;
    const t = G.ties[pairKey(m, o)];
    if(!t || Math.abs(t.w) < 30) return;
    const theirs = alignmentRaw(o, b) + (typeof stakeSway === "function" ? stakeSway(o, b) : 0);
    /* you move toward the people you like and away from the ones you do not */
    pull += (theirs > 0 ? 1 : -1) * (t.w / 100) * (o.influence / 34);
  });
  return clamp(pull, -22, 22);
}

/* ── what they actually do to each other, all day ── */
const TIE_ACTS = [
  {k:"ask",     need:b => !!b, w:0,
   line:(a,b2,bill) => surname(a.name) + ", I need you on " + bill.title + ". Tell me what it takes.",
   back:(a,b2) => "I will think about it. That is more than I have told anybody else."},
  {k:"trade",   need:b => !!b, w:9,
   line:(a,b2,bill) => "Vote with me on " + bill.title + " and the crossing money is yours in the spring.",
   back:() => "Then we have an understanding, and I will hold you to it."},
  {k:"lean",    need:b => !!b, w:-11,
   line:(a,b2,bill) => "You will vote for " + bill.title + ", or the selection committee hears about the other thing.",
   back:() => "…You had better be very sure about that."},
  {k:"warn",    need:() => true, w:6,
   line:(a) => "A word — they are counting you as soft, and I thought you should hear it from me.",
   back:() => "Then I owe you one. I will not forget it."},
  {k:"fallout", need:() => true, w:-16,
   line:(a) => "I have covered for you twice and you did not so much as look at me on the floor.",
   back:() => "That is not what happened and you know it."},
  {k:"makeup",  need:() => true, w:13,
   line:(a) => "We have been stupid about this for a month. I would rather we were not.",
   back:() => "…Aye. So would I."},
  {k:"gossip",  need:() => true, w:4,
   line:(a, b2, bill, sub) => "Between us — " + (sub ? surname(sub.name) : "somebody") + " is not where they say they are.",
   back:() => "I had wondered. Thank you for saying it out loud."}
];
function chooseAct(a, b, t, bill){
  const pool = [];
  if(bill && Math.abs(t.w) < 60) pool.push("ask", "ask");
  if(bill && t.w > 10 && a.influence > 20) pool.push("trade");
  if(bill && t.w < -20 && a.traits.temper > 58) pool.push("lean");
  if(t.w > 25) pool.push("warn", "gossip");
  if(t.w < -30 && chance(.5)) pool.push("fallout");
  if(t.w < -20 && t.w > -55 && a.traits.temper < 50) pool.push("makeup");
  if(!pool.length) pool.push("gossip");
  const k = pick(pool);
  return TIE_ACTS.find(x => x.k === k);
}
/* one interaction between two members, wherever they are */
function tieTick(w){
  tieT -= w;
  if(tieT > 0) return;
  tieT = 14 + Math.random()*22;
  const live = G.members.filter(m => !m.gone);
  if(live.length < 3) return;
  const a = pick(live);
  /* they deal with the people they already have something with, mostly */
  const ranked = closestTo(a);
  const pool = ranked.filter(r => Math.abs(r.w) > 18).map(r => r.who);
  const b = pick(pool.length && chance(.7) ? pool : live.filter(m => m !== a));
  if(!b || b === a) return;
  const t = tieOf(a, b);
  const bill = G.bill && !G.bill.done ? G.bill : null;
  const act = chooseAct(a, b, t, bill);
  if(!act) return;
  const sub = pick(live.filter(m => m !== a && m !== b)) || null;

  /* it changes what they are to each other, both ways */
  tieShift(a, b, act.w, act.k === "fallout" ? surname(a.name) + " went for me over something I did not do."
    : act.k === "lean" ? surname(a.name) + " leaned on me and meant it."
    : act.k === "trade" ? surname(a.name) + " and I have an arrangement."
    : act.k === "warn" ? surname(a.name) + " warned me when they did not have to."
    : act.k === "makeup" ? surname(a.name) + " came to me first, which cost them something."
    : null);
  if(act.k === "trade"){ t.debt++; a.rel.debtToThem = a.rel.debtToThem; }
  if(act.k === "lean"){
    b.sway = (b.sway || 0) + (bill ? memberVote(a, bill) * 7 : 0);
    secretly(a, b);
  }
  if(act.k === "trade" && bill) b.sway = (b.sway || 0) + memberVote(a, bill) * 9;
  if(act.k === "ask" && bill)   b.sway = (b.sway || 0) + memberVote(a, bill) * 3;
  if(act.k === "fallout"){
    if(t.w < -70){ a.rival = b.id; b.rival = a.id; journal(surname(a.name) + " and " + surname(b.name) + " are finished."); }
  }
  if(act.k === "makeup" && t.w > 20){
    a.allies = (a.allies || []).concat(a.allies.indexOf(b.id) < 0 ? [b.id] : []);
    b.allies = (b.allies || []).concat(b.allies.indexOf(a.id) < 0 ? [a.id] : []);
    journal(surname(a.name) + " and " + surname(b.name) + " have patched it up.");
  }

  /* and if you are standing there, you watch it happen */
  const bothHere = a.room === G.room && b.room === G.room;
  if(bothHere && !PROC.on && !TALK.open){
    const l1 = fresh(() => act.line(a, b, bill, sub));
    const l2 = fresh(() => act.back(a, b));
    overhear(a, b, l1, l2);
    if(act.k === "fallout" || act.k === "lean") feed(surname(a.name) + " and " + surname(b.name) + " are having words.");
  } else if(chance(.4)){
    journal(surname(a.name) + " has been " +
      (act.k === "lean" ? "leaning on " : act.k === "trade" ? "dealing with " :
       act.k === "fallout" ? "falling out with " : act.k === "makeup" ? "making it up with " :
       act.k === "warn" ? "warning " : "talking about somebody to ") + surname(b.name) + ".");
  }
}
let tieT = 0;
/* what you can see of somebody's own friendships */
function tieLine(m){
  const r = closestTo(m);
  if(!r.length) return "";
  const friend = r[0], enemy = r[r.length - 1];
  const bits = [];
  if(friend && friend.w > 30) bits.push("close to " + surname(friend.who.name));
  if(enemy && enemy.w < -30) bits.push("cannot stand " + surname(enemy.who.name));
  return bits.join(" · ");
}

/* ══════════════════════════════════════════════════════════
   THE BUILDING KEEPS COUNT
   Nobody tells you this and there is no panel for it, but the rooms
   are keeping a tally: how many hours you have stood in each of them,
   who you have spent them with, and what you were doing. At the end
   of a career it is the only honest account of how you actually spent
   the time, as opposed to how you would describe it.
   ══════════════════════════════════════════════════════════ */
function clockRoom(w){
  if(!G.hours) G.hours = {};
  if(!G.withWhom) G.withWhom = {};
  G.hours[G.room] = (G.hours[G.room] || 0) + w;
  if(TALK.open && TALK.m) G.withWhom[TALK.m.id] = (G.withWhom[TALK.m.id] || 0) + w;
  try{ if((FRAME_ID & 15) === 0) youSent(); }catch(e){}
  /* Soft corridor presence — rare, keyed off accumulated minutes in-room, not frames. */
  if(w > 0 && G.room && (G.hours[G.room] % 45) < w && chance(.18)){
    try{ ambientRoomWhisper(G.room); }catch(e){}
  }
}
function hoursReport(){
  const H = G.hours || {};
  const rows = Object.keys(H).sort((a,b) => H[b] - H[a]).slice(0, 6);
  if(!rows.length) return "";
  const most = rows[0];
  const W = G.withWhom || {};
  const who = Object.keys(W).sort((a,b) => W[b] - W[a])[0];
  const p = who ? byId(isNaN(+who) ? who : +who) : null;
  return '<div class="ency__h">Where the time went</div>' +
    rows.map(r => '<p class="tip__q"><b>' + (ROOMS[r] ? ROOMS[r].t : r) + '</b> — ' +
      Math.round(H[r] / 60) + ' hours</p>').join("") +
    '<p class="tip__f">Most of it in ' + (ROOMS[most] ? ROOMS[most].t : most) +
    (p ? ', and more of it with ' + p.name + ' than with anybody else' : '') + '.</p>';
}

/* ══════════════════════════════════════════════════════════
   IN SESSION

   A room in session does not stand around. Whoever has the floor is
   watched; everyone with a seat is in it, turned toward the speaker;
   and the rest do what people do while somebody else is talking —
   write, nod, lean across to the member beside them, or stare at
   the ceiling. It goes on whether you are the one speaking or not.
   ══════════════════════════════════════════════════════════ */
const SEATED_ROOMS = {floor:1, caucus:1, committee:1, press:1};
function seatsFor(id){
  const R = ROOMS[id]; if(!R) return [];
  const d = R.d, out = [];
  if(id === "caucus"){
    for(let r=0;r<3;r++) for(let c=0;c<6;c++)
      out.push({x:-4.4+c*1.75, z:3.15+r*2.2, face:0});
  } else if(id === "committee"){
    /* dais first (Chair at index 3) so NPCs fill members before gallery */
    for(let i=0;i<7;i++) out.push({x:-3.3+i*1.1, z:d-2.55, face:Math.PI, y:DIM.daisFloor});
    /* gallery, skip the center aisle that leads to the corridor door */
    for(let r=0;r<2;r++) for(let c=0;c<7;c++){
      if(c === 3) continue;
      out.push({x:-3.3+c*1.1, z:2.45+r*0.95, face:0});
    }
  } else if(id === "press"){
    for(let r=0;r<3;r++) for(let c=0;c<3;c++)
      out.push({x:-2.2+c*2.2, z:2.2+r*2.0, face:0});
  } else if(id === "floor"){
    /* sit ON the benches (centered z=7.5, length 8), facing the aisle */
    for(let s2=0;s2<2;s2++) for(let r=0;r<5;r++) for(let k=0;k<3;k++){
      const x = (s2 ? 1 : -1) * (2.6 + r*1.38);
      out.push({x, z:4.6 + k*2.9, face:s2 ? -Math.PI/2 : Math.PI/2});
    }
  } else if(id === "office"){
    /* Member desk chair — casual free sit (not a chamber seat) */
    out.push({x:0, z:9.05, face:Math.PI});
  }
  return out;
}
/* who has the floor right now, and where they are standing */
function floorHolder(){
  if(PROC.on){
    if(PROC.phase === "you") return {you:true, x:cam.x, z:cam.z};
    const p = PROC.speaker;
    if(p && !p.gone) return {p, x:p.x, z:p.z};
    if(PROC.chair) return {p:PROC.chair, x:PROC.chair.x, z:PROC.chair.z};
  }
  return null;
}
/* anybody who is no longer here is not sitting here either */
function tidySeats(){
  G.members.forEach(m => { if(m.sitting && m.room !== G.room) m.sitting = false; });
}
function backStandsFor(id){
  /* Fixed gallery / back positions — standing room only, not the well. */
  const R = ROOMS[id]; if(!R) return [];
  const d = R.d, out = [];
  if(id === "floor"){
    for(let i=0;i<8;i++){
      const side = i < 4 ? -1 : 1;
      out.push({x: side * (7.2 + (i%4)*0.15), z: 2.1 + (i%4)*1.1, face: side > 0 ? -Math.PI/2 : Math.PI/2});
    }
  } else if(id === "committee"){
    for(let i=0;i<6;i++) out.push({x:-3.0+i*1.2, z:2.05, face:0});
  } else if(id === "caucus"){
    for(let i=0;i<6;i++) out.push({x:-4.0+i*1.6, z:2.4, face:0});
  } else if(id === "press"){
    for(let i=0;i<5;i++) out.push({x:-2.4+i*1.2, z:2.2, face:0});
  }
  return out;
}
function seatPlayerInSession(){
  /* Place you in a chamber seat when a scheduled sitting / committee opens,
     so seated speech prompts are live without hunting a chair. */
  /* 20261104bj A1 LIVE: House Floor Call-to-order must not teleport-seat you —
     audience-side lectern catch needs a quiet standing Floor (W walk / E rise).
     Take seat / E on a bench still seats. Committee / caucus / press unchanged. */
  if(!G.you || !SEATED_ROOMS[G.room] || G.noSit || G.plainSit) return false;
  if(G.room === "floor") return false;
  const seats = seatsFor(G.room);
  if(!seats.length) return false;
  /* Prefer a gallery / mid seat, not the chair's dais slot (committee index 3). */
  let s = seats[Math.min(10, seats.length - 1)];
  if(G.room === "committee" && seats.length > 8) s = seats[8];
  else if(G.room === "floor" && seats.length > 6) s = seats[6];
  else if(G.room === "caucus" && seats.length > 4) s = seats[4];
  const f = s.face || 0;
  cam.x = s.x + Math.sin(f) * 0.62;
  cam.z = s.z + Math.cos(f) * 0.62;
  cam.yaw = f;
  cam.pitch = -0.08;
  cam.vx = cam.vz = 0;
  G.you.sitting = true;
  CATCH.suppressed = false;
  promptKey = "";
  feed("You take your place for the sitting.");
  try{ refreshPanels(); }catch(e){}
  return true;
}
function seatRoom(id){
  const seats = seatsFor(id);
  const backs = backStandsFor(id);
  if(!seats.length && !backs.length) return;
  const here = G.members.filter(m => m.room === id && !m.gone && !m.sitting);
  here.forEach((m, i) => {
    m.backStand = false;
    if(i < seats.length){
      const s = seats[i];
      m.x = m.tx = s.x;
      m.z = m.tz = s.z;
      m.seatFace = s.face;
      m.sitting = true;
      m.sitY = s.y || 0;
    } else if(backs.length){
      const s = backs[(i - seats.length) % backs.length];
      m.x = m.tx = s.x;
      m.z = m.tz = s.z;
      m.seatFace = s.face;
      m.sitting = false;
      m.sitY = 0;
      m.backStand = true;
      m.wait = 999;
    } else {
      const s = seats[i % seats.length];
      m.x = m.tx = s.x + 0.35;
      m.z = m.tz = s.z;
      m.seatFace = s.face;
      m.sitting = true;
      m.sitY = s.y || 0;
    }
  });
}
function unseatRoom(id){
  G.members.forEach(m => {
    if(m.room === id){
      m.sitting = false; m.seatFace = undefined; m.sitY = 0; m.backStand = false;
    }
  });
}
function speechZoneProps(room){
  const ids = SPEECH_STATION_IDS[room || G.room];
  if(!ids) return [];
  return (PROPS[room || G.room] || []).filter(o => ids.indexOf(o.id) >= 0);
}
function inSpeechZone(x, z, room){
  const props = speechZoneProps(room || G.room);
  for(const o of props){
    /* Must stay tight. 3m turned the whole well into "the lectern" and
       ate Sit / Amend / E on the House floor. */
    const rad = Math.min(1.25, Math.max(0.85, o.r || 1.05));
    if(Math.hypot(x - o.x, z - o.z) <= rad) return o;
  }
  return null;
}
function lecternOccupants(room){
  room = room || G.room;
  const up = [];
  (G.members || []).forEach(m => {
    if(!m || m.gone || m.room !== room) return;
    if(m.sitting || m.backStand) return;
    if(inSpeechZone(m.x, m.z, room)) up.push(m);
  });
  if(G.you && G.room === room && !G.you.sitting && inSpeechZone(cam.x, cam.z, room)){
    up.push({you:true, name:"You"});
  }
  return up;
}
function lecternCapOpen(room){
  /* Session speaking area: at most 2 party persons up (speaker + one). */
  return lecternOccupants(room).length < 2;
}
function enforceSessionFloor(m){
  /* Non-speakers during PROC: sit or fixed back stand — no milling the well. */
  if(!PROC.on || !m || m.gone) return;
  if(m === PROC.speaker) return;
  if(PROC.chair && m === PROC.chair && !m.sitting) return; /* chair may stand at dais */
  if(m.sitting || m.backStand){
    m.tx = m.x; m.tz = m.z;
    return;
  }
  /* stray standing member: park to a seat or back stand */
  const seats = seatsFor(m.room);
  const backs = backStandsFor(m.room);
  if(seats.length){
    const s = seats[(m.id || 0) % seats.length];
    m.x = m.tx = s.x; m.z = m.tz = s.z;
    m.seatFace = s.face; m.sitting = true; m.sitY = s.y || 0; m.backStand = false;
  } else if(backs.length){
    const s = backs[(m.id || 0) % backs.length];
    m.x = m.tx = s.x; m.z = m.tz = s.z;
    m.seatFace = s.face; m.sitting = false; m.backStand = true; m.wait = 999;
  }
}
function enforceLecternCapPlayer(){
  if(!PROC.on || !SEATED_ROOMS[G.room] || !G.you || G.you.sitting) return false;
  if(TALK && TALK.open) return false;
  try{ if(veil && !veil.hidden) return false; }catch(e){}
  if(PROC.phase === "you") return false; /* you have the floor */
  const zone = inSpeechZone(cam.x, cam.z, G.room);
  if(!zone) return false;
  const others = lecternOccupants(G.room).filter(o => !o.you);
  if(others.length < 2) return false;
  /* push player out toward room center / away from prop */
  const dx = cam.x - zone.x, dz = cam.z - zone.z;
  const d = Math.hypot(dx, dz) || 1;
  const push = Math.max(3.4, (zone.r || 2.6) + 0.8);
  cam.x = zone.x + (dx / d) * push;
  cam.z = zone.z + (dz / d) * push;
  cam.vx = cam.vz = 0;
  setSay("The well already has two up. Sit or wait your turn.", fx("","lectern full"));
  return true;
}
/* small honest behaviour while somebody else is talking */
const SESSION_IDLES = ["write", "nod", "lean", "stare", "read", "still", "still"];
function sessionIdle(m, dt){
  m.idleT = (m.idleT || 0) - dt;
  if(m.idleT <= 0){
    m.idleT = 3 + Math.random()*7;
    const mood = moodOf(m).val;
    m.idle = mood < -25 ? pick(["stare","still","lean"])
           : m.traits.loyalty > 60 ? pick(["nod","write","read","still"])
           : pick(SESSION_IDLES);
  }
}

/* the bracket locks on to whoever you are looking at */

const TV = new THREE.Vector3();
let trackT = 0, trackWho = null;
function updateTrack(p){
  const box = el("track");
  if(!p){ box.hidden = true; return; }
  const rect = sceneRect();
  const H = p.look.height;
  let minX=1e9, maxX=-1e9, minY=1e9, maxY=-1e9, ok=false;
  const pts = [[-0.32,0],[0.32,0],[-0.32,H*1.02],[0.32,H*1.02]];
  for(const q of pts){
    TV.set(p.x + q[0]*Math.cos(cam.yaw), q[1], p.z - q[0]*Math.sin(cam.yaw)).project(camera);
    if(TV.z > 1) continue;
    ok = true;
    const sx = (TV.x*0.5+0.5)*rect.width, sy = (-TV.y*0.5+0.5)*rect.height;
    minX = Math.min(minX,sx); maxX = Math.max(maxX,sx);
    minY = Math.min(minY,sy); maxY = Math.max(maxY,sy);
  }
  if(!ok){ box.hidden = true; return; }
  const w = clamp(maxX-minX, 26, rect.width), h = clamp(maxY-minY, 34, rect.height);
  box.hidden = false;
  box.style.left = ((minX+maxX)/2) + "px";
  box.style.top = ((minY+maxY)/2) + "px";
  box.style.width = w + "px";
  box.style.height = h + "px";
  /* the box tracks the head every frame; the label behind it reads the
     whole memory ledger, so it is refreshed a few times a second */
  trackT -= 0.016;
  if(trackT > 0 && trackWho === p) return;
  trackT = 0.16; trackWho = p;
  const mood = moodOf(p), d = Math.hypot(p.x-cam.x, p.z-cam.z);
  const rel = p.kind === "member"
    ? "<b>" + mood.label.toUpperCase() + "</b>"
    : p.kind === "press" ? "<b>" + (p.outlet || "PRESS") + "</b>" : "PUBLIC";
  const html =
    "<b>" + p.name.toUpperCase() + "</b><br>" +
    "<i>" + (p.kind==="member" ? (p.post ? postTitle(p.post) : partyLabel(p.party)) : p.kind==="press" ? p.outlet : p.role) + "</i><br>" +
    rel + "<br><i>" + d.toFixed(1) + "m</i>" +
    (p.wantsWord ? "<br><b>WANTS A WORD</b>" : "");
  const tag = el("trackTag");
  if(tag._html !== html){ tag._html = html; tag.innerHTML = html; }
}
/* The telemetry rebuilds a block of HTML. At sixty frames a second that is
   pure waste — it only changes a few times a minute. */
let teleT = 0, teleLast = "";
function updateTele(dt){
  teleT -= (dt || 0.016);
  if(teleT > 0) return;
  teleT = 0.25;
  updateTeleNow();
}
function updateTeleNow(){
  /* The corner of the view is for the time. Everything else that used to
     be stacked here — the room, the head-count, the roll call, the last
     save — is already on the bar and in the panels, and having it twice
     was costing more of the room than it was worth. */
  setHTML(el("tele"), "<span>" + hhmm().toUpperCase() + "</span>");
}
/* Is there somewhere to sit within reach of where you are standing? */
function seatUnderYou(){
  const seats = seatsFor(G.room);
  if(!seats.length) return null;
  let best = null, bd = 1.15;
  for(const s2 of seats){
    const d = Math.hypot(s2.x - cam.x, s2.z - cam.z);
    if(d < bd){ bd = d; best = s2; }
  }
  return best;
}
function sitEye(){
  const g = cam.ground || 0;
  if(!(G.you && G.you.sitting)) return 1.66 + g;
  const s = (typeof seatUnderYou === "function") ? seatUnderYou() : null;
  const base = (s && isFinite(s.y)) ? s.y : g;
  return base + 1.28;
}
function nearOfficeDesk(){
  if(G.room !== "office" || !G.you) return false;
  const desk = ((PROPS.office || []).find(p => p.id === "desk")) || {x:0, z:7.2, r:2.4};
  return Math.hypot((desk.x||0) - cam.x, (desk.z||7.2) - cam.z) <= (desk.r || 2.4) + 0.15;
}
function showDeskPane(paneId){
  const want = paneId || "paneFloor";
  document.querySelectorAll(".dossier .tabs button").forEach(b => {
    b.classList.toggle("is-on", b.getAttribute("data-pane") === want);
  });
  document.querySelectorAll(".dossier .pane").forEach(p => {
    p.classList.toggle("is-on", p.id === want);
  });
}
function openDeskWork(paneId){
  /* Sit at the desk: real Floor (bill vs district) and Inbox (answer mail).
     Immersive hides that HUD — bring it back while you are in the chair. */
  try{ if(!veil.hidden && phoneWasRunning !== null) phoneClose(); }catch(e){}
  try{ unmountDossierFromPhone(); }catch(e){}
  G.bare = false;
  document.body.classList.remove("is-bare");
  document.body.classList.remove("boot-menu");
  document.body.classList.remove("ui-open");
  showDeskPane(paneId || "paneFloor");
  try{ refreshFloor(); }catch(e){}
  try{ refreshInbox(); }catch(e){}
  try{ refreshUnion(); }catch(e){}
  try{ refreshPanels(); }catch(e){}
  setTimeout(() => { try{ dropRect(); resize(); }catch(e){} }, 30);
}
function sitCasuallyAtDesk(){
  /* Free sit at My desk — 0 minutes, world keeps running, no talk popup */
  if(!G.you || G.room !== "office") return false;
  const s = {x:0, z:9.05, face:Math.PI};
  const f = s.face;
  cam.x = s.x + Math.sin(f) * 0.12;
  cam.z = s.z + Math.cos(f) * 0.12;
  cam.yaw = f;
  cam.vx = cam.vz = 0;
  G.you.sitting = true;
  if(!G.over) G.running = true;
  G._deskWasBare = G.bare !== false;
  openDeskWork("paneFloor");
  feed("You sit at your desk. E wakes the computer: mail, the Ledger, bills, the diary, polls, the war chest, staff.");
  try{ setSay("Desk. Dark tick is the bill, green is the district. Inbox tab to answer mail.", fx("0m · casual","")); }catch(e){}
  return true;
}
function toggleSit(){
  if(G.you.sitting){
    try{ pcClose(); }catch(e){}
    G.you.sitting = false;
    feed("You stand.");
    if(G._deskWasBare){
      G._deskWasBare = false;
      try{ setImmersive(true); }catch(e){}
    }
    return;
  }
  /* Office desk: casual sit (no spend) when focusing / near My desk */
  if(G.room === "office" && nearOfficeDesk()){ sitCasuallyAtDesk(); return; }
  const s2 = seatUnderYou();
  if(!s2) return;
  /* sit ON the seat, facing out, not buried in the bench in front of it */
  const f = s2.face || 0;
  cam.x = s2.x + Math.sin(f) * 0.18;
  cam.z = s2.z + Math.cos(f) * 0.18;
  cam.yaw = f;
  cam.vx = cam.vz = 0;
  G.you.sitting = true;
  if(PROC.on && SEATED_ROOMS[G.room]){ CATCH.suppressed = false; promptKey = ""; }
  feed(G.room === "office" ? "You sit at your desk." : "You sit down.");
}
function focusTarget(){
  /* Tight cone: a person only takes focus when you are actually on them.
     A wide radius was stealing plaques, props and seats whenever anyone
     stood nearby. */
  let best=null, bs=1e9;
  const f = {x:Math.sin(cam.yaw), z:Math.cos(cam.yaw)};
  for(const p of hereNow()){
    const dx = p.x-cam.x, dz = p.z-cam.z, d = Math.hypot(dx,dz);
    if(d < 0.30 || d > 2.6) continue;
    const dot = (dx*f.x + dz*f.z)/d;
    if(dot < (d < 1.3 ? 0.55 : 0.78)) continue;
    const s = d - dot*1.15;
    if(s < bs){ bs = s; best = p; }
  }
  return best;
}
/* Things, as opposed to people. */
/* whatever the building has left lying about in this room */
function relicProps(){
  const r = seedRelic(G.room);
  if(!r || r.found || !ROOMS[G.room]) return [];
  const R = ROOMS[G.room];
  if(r.x === undefined){
    r.x = (Math.random()*2-1)*(R.w/2 - 1.5);
    r.z = 1.8 + Math.random()*Math.max(1, R.d - 3.6);
  }
  return [{id:"relic", label:r.t, sub:"Something left behind", x:r.x, z:r.z, r:2.0,
    acts:() => [
      {t:"Read it", c:"10m", run(){ spend(10,2); takeRelic(r); setSay(r.d, fx("kept","")); }},
      {t:"Leave it", exit:true, run(){ closeTalk(); }}
    ]}];
}
function focusProp(){
  const list = (PROPS[G.room] || []).concat(relicProps()).concat(horcruxProps());
  let best=null, bs=1e9;
  const f = {x:Math.sin(cam.yaw), z:Math.cos(cam.yaw)};
  for(const o of list){
    const dx = o.x-cam.x, dz = o.z-cam.z, d = Math.hypot(dx,dz);
    const speech = !!(SPEECH_STATION_IDS[G.room] && SPEECH_STATION_IDS[G.room].indexOf(o.id) >= 0);
    if(speech){
      if(distToSpeechStand(o) > 1.05) continue;
    } else if(d > (o.r || 2.6) * 1.25) continue;
    /* Some things are only yours to use from one side. A lectern read from
       the audience side is somebody else's lectern. */
    if(o.minZ !== undefined && cam.z < o.minZ) continue;
    if(o.maxZ !== undefined && cam.z > o.maxZ) continue;
    const dot = d < 0.6 ? 1 : (dx*f.x + dz*f.z)/d;
    if(dot < 0.35) continue;
    const s = d - dot*1.6;
    if(s < bs){ bs = s; best = o; }
  }
  return best;
}
/* Whichever is nearer and in front of you. */
function focusThing(){
  const p = focusTarget(), o = focusProp();
  if(p && o){
    const dp = Math.hypot(p.x-cam.x, p.z-cam.z), doo = Math.hypot(o.x-cam.x, o.z-cam.z);
    /* Props and plaques win ties and near-ties — people must be clearly closer */
    if(dp < doo - 0.45) return {type:"person", ref:p};
    /* 20261011m: someone you are looking straight at, close enough to talk,
       beats a thing off to the side of your eye */
    const fx0 = Math.sin(cam.yaw), fz0 = Math.cos(cam.yaw);
    const ap = ((p.x-cam.x)*fx0 + (p.z-cam.z)*fz0) / Math.max(0.01, dp);
    const ao = ((o.x-cam.x)*fx0 + (o.z-cam.z)*fz0) / Math.max(0.01, doo);
    if(dp <= 1.55 && ap > 0.96 && ap > ao + 0.08) return {type:"person", ref:p};
    return {type:"prop", ref:o};
  }
  if(p) return {type:"person", ref:p};
  if(o) return {type:"prop", ref:o};
  /* nothing in front: the nearest person within arm's reach still counts */
  let nb = null, nd = 1.25;
  for(const q of hereNow()){ const dq = Math.hypot(q.x-cam.x, q.z-cam.z); if(dq > 0.3 && dq < nd){ nd = dq; nb = q; } }
  if(nb) return {type:"person", ref:nb};
  return null;
}
function personInTalkRange(){
  const p = focusTarget();
  if(!p) return null;
  const d = Math.hypot(p.x-cam.x, p.z-cam.z);
  return d <= 1.55 ? p : null;
}
const marker = new THREE.Mesh(
  new THREE.RingGeometry(0.30, 0.40, 30),
  new THREE.MeshBasicMaterial({color:0xffcb84, transparent:true, opacity:0.8, side:THREE.DoubleSide, depthWrite:false})
);
marker.rotation.x = -Math.PI/2; marker.visible = false; scene.add(marker);
function resize(){
  const r = sceneEl.getBoundingClientRect();
  if(r.width < 10) return;
  renderer.setSize(r.width, r.height, false);
  camera.aspect = r.width / Math.max(1, r.height);
  camera.updateProjectionMatrix();
}
addEventListener("resize", resize);
/* the bar can wrap and the panels can change height without the window
   ever changing size, and the view has to follow its own box */
if(window.ResizeObserver) new ResizeObserver(() => { dropRect(); resize(); }).observe(sceneEl);


/* ══════════════════════════════════════════════════════════
   9 · MOVEMENT
   ══════════════════════════════════════════════════════════ */
let _wanderPhase = 0;
function tickWanderBatch(w){
  const list = hereNow();
  const n = list.length;
  if(!n) return;
  /* Crowded rooms: stride-2 idle AI; anyone mid-walk always updates. */
  const stride = n > 6 ? 2 : 1;
  const phase = _wanderPhase % stride;
  _wanderPhase++;
  for(let i=0;i<n;i++){
    const m = list[i];
    const moving = Math.hypot((m.tx||0)-(m.x||0), (m.tz||0)-(m.z||0)) > 0.25;
    /* feet run every frame (wanderFrame); this lane is only for minds */
    if((i + phase) % stride === 0){ maybeApproach(m); try{ sentWatch(m, w); }catch(e){} }
  }
}
function breakSeat(m){
  try{
    const seats = seatsFor(m.room) || [];
    if(!seats.length) return null;
    const here = hereNow();
    let best = null, bd = 1e9;
    for(const s of seats){
      if(here.some(o => o !== m && (o._breakSeat === s || (o.sitting && Math.abs(o.x - s.x) < 0.3 && Math.abs(o.z - s.z) < 0.3)))) continue;
      const d = Math.hypot(s.x - m.x, s.z - m.z);
      if(d < bd){ bd = d; best = s; }
    }
    return bd < 7 ? best : null;
  }catch(e){ return null; }
}
function wander(m, dt){
  if(m.sayT > 0 && m.say && m._tlSaid !== m.say && m.room === G.room){ try{ tlHeard(m); }catch(e){} }
  if(m.sayT > 0) m.sayT -= dt;
  if(m.room !== G.room) return;
  /* a seat taken for a break is given back when the break is over */
  if(m.sitting && m._breakSeat && !PROC.on){
    let still = false; try{ still = onBreak(m); }catch(e){}
    if(!still){ m.sitting = false; m._breakSeat = null; m.sitY = 0; m.seatFace = undefined; m.wait = 0.5 + Math.random()*2; }
    else return;
  }
  /* sitting with no seat under you is not sitting */
  if(m.sitting && !PROC.on && m.seatFace === undefined && !m._breakSeat){ m.sitting = false; m.sitY = 0; }
  if(m.sitting) return;             /* they are in a seat and staying in it */
  if(m.backStand){ m.tx = m.x; m.tz = m.z; return; } /* fixed gallery / back stand */
  if(PROC.on && SEATED_ROOMS[m.room]){
    enforceSessionFloor(m);
    if(m.sitting || m.backStand) return;
    if(m !== PROC.speaker && !(PROC.chair && m === PROC.chair)){
      m.tx = m.x; m.tz = m.z; return;
    }
  }
  const b = roomBox(m.room);
  const dx = m.tx-m.x, dz = m.tz-m.z, d = Math.hypot(dx,dz);
  if(d < 0.25){
    m.spd = smooth(m.spd || 0, 0, 0.002, dt);
    m.wait -= dt;
    if(m.wait <= 0){
      try{
        if(onBreak(m)){
          m.wait = 3 + Math.random()*4;
          if(m._goSeat){
            const s = m._goSeat; m._goSeat = null;
            if(Math.hypot(s.x - m.x, s.z - m.z) < 0.35 && !G.plainSit && !G.noSit){
              m.x = m.tx = s.x; m.z = m.tz = s.z; m.seatFace = s.face; m.sitY = s.y || 0;
              m.sitting = true; m._breakSeat = s;
              return;
            }
          }
          if(!m.sitting && !G.plainSit && !G.noSit && Math.random() < 0.4){
            const s = breakSeat(m);
            if(s){ m._goSeat = s; m.tx = s.x; m.tz = s.z; m.wait = 0; return; }
          }
          if(m.room === "district" && m.kind === "civ"){
            /* a break outdoors is a walk, not a stand: down the block, across the road, back */
            const side = chance(.6) ? (m.x < 0 ? -1 : 1) : (m.x < 0 ? 1 : -1);
            m.tx = clamp(side * (3.6 + Math.random() * 2.2), -b.hw, b.hw);
            m.tz = clamp(m.z + (chance(.5) ? 1 : -1) * (3 + Math.random() * 7), b.d0, b.d1);
            m.wait = 1 + Math.random() * 3;
            return;
          }
          m.tx = m.x; m.tz = m.z;
          return;
        }
      }catch(e){}
      const mood = moodOf(m);
      const snt = m.sent;
      const allies = (m.allies||[]).map(byId).filter(a => a && a.room === m.room);
      if(snt && snt.attending && snt.attending !== "self"){
        if(snt.attending === "you" && chance(.28)){
          momentApproach(m, b);
        } else {
          const a = byId(snt.attending);
          if(a && a.room === m.room){ m.tx = a.x + (Math.random()*2-1)*0.9; m.tz = a.z + (Math.random()*2-1)*0.9; }
          else { m.tx = (Math.random()*2-1)*b.hw; m.tz = b.d0 + Math.random()*(b.d1-b.d0); }
        }
      } else if(snt && snt.topic === "alone" && chance(.4)){
        m.tx = -Math.sign(cam.x||1)*b.hw*0.75; m.tz = cam.z > b.d1/2 ? b.d0+1.1 : b.d1-1.1;
      } else if(mood.val > 30 && chance(.18)){
        momentApproach(m, b);
      }
      else if(mood.val < -35 && chance(.5)){ m.tx = -Math.sign(cam.x||1)*b.hw*0.8; m.tz = cam.z > b.d1/2 ? b.d0+1 : b.d1-1; }
      else if(allies.length && chance(.34)){ momentToAlly(m, pick(allies), b); }
      else if(m.room === "district" && m.kind === "civ"){
        /* a stroll: along one sidewalk for a block, or across to the other side; stop and look at a window */
        const side = chance(.65) ? (m.x < 0 ? -1 : 1) : (m.x < 0 ? 1 : -1);
        m.tx = side * (3.6 + Math.random() * 2.2);
        const run = (chance(.5) ? 1 : -1) * (5 + Math.random() * 8);
        m.tz = m.z + run;
        m._stroll = true;
      }
      else { m.tx = (Math.random()*2-1)*b.hw; m.tz = b.d0 + Math.random()*(b.d1-b.d0); }
      m.tx = clamp(m.tx,-b.hw,b.hw); m.tz = clamp(m.tz,b.d0,b.d1);
      if(m.room === "steps") m.tz = clamp(m.tz, Math.max(b.d0, 2.2), 4.6);
      if(m.room === "district"){
        if(Math.abs(m.tx) < 2.4) m.tx = (m.tx < 0 ? -3.5 : 3.5);
      }
      m.wait = m.room === "district" && m.kind === "civ" ? 0.8 + Math.random() * 3.2 : 2.2 + Math.random()*7;
      if(chance(.28)){
        let fl = null;
        try{ const near = Math.hypot(m.x - cam.x, m.z - cam.z) < 3 && m.room === G.room;
          if(near && chance(.25)) fl = loreFamLine() || famLine(m, null);
          else if(chance(.35)){ const o = hereNow().find(q => q !== m && q.kind !== "civ" && Math.hypot(q.x - m.x, q.z - m.z) < 3); if(o){ fl = famLine(m, o); if(fl){ m.sayTo = o.id; } } } }catch(e){}
        if(fl){ m.say = fl; m.sayT = 2.6; } else
        m.say = pick([
          "Excuse me.",
          "They will not like that.",
          "Is the clerk in?",
          "I have a meeting.",
          "Did you hear?"
        ]);
        m.sayT = 2.2; m.sayTo = null;
      }
    }
    return;
  }
  /* An unhurried indoor pace: they lean into a walk, ease out of it, and
     slow well before they arrive. Everyone walks a little differently. */
  if(m.gait === undefined) m.gait = 0.42 + Math.random()*0.16;
  const arrive = clamp(d/1.6, 0.22, 1);
  const outdoor = (m.room === "district" || m.room === "steps") ? 1.55 : 1;      /* a street pace, not a corridor pace */
  m.spd = smooth(m.spd || 0, m.gait * arrive * outdoor, 0.08, Math.min(dt, 0.022));
  m.spd = Math.min(m.spd, 0.55 * outdoor);
  /* 20261012x: turn before walking (in place if facing away, along an arc otherwise),
     step around each other, never overlap, never freeze */
  let hx = dx/d, hz = dz/d;
  try{ const herr = Math.abs(wrapPi(Math.atan2(dx, dz) - (m.facing || 0)));
    const tk = herr > 1.3 ? 0.05 : Math.max(0.2, Math.cos(herr));
    m.spd = Math.min(m.spd, 0.55 * outdoor * tk + 0.02);
    if(m.room === G.room){ for(const o of hereNow()){ if(o === m || o.sitting || o.room !== m.room) continue;
        const ox = m.x - o.x, oz = m.z - o.z, r = Math.hypot(ox, oz);
        if(r > 0.001 && r < 0.8){ const w = (0.8 - r) / 0.8 * 1.3; hx += ox / r * w; hz += oz / r * w;
          if(o.tx != null && (hx * (o.tx - o.x) + hz * (o.tz - o.z)) < 0){ hx += -oz / r * w * 0.6; hz += ox / r * w * 0.6; } } }
      const cx = m.x - cam.x, cz = m.z - cam.z, cr = Math.hypot(cx, cz);
      if(cr > 0.001 && cr < 0.8){ const w = (0.8 - cr) / 0.8 * 1.3; hx += cx / cr * w; hz += cz / cr * w; }
      const hl = Math.hypot(hx, hz) || 1; hx /= hl; hz /= hl; }
  }catch(e){}
  const sp = Math.min(0.022, m.spd * Math.min(dt, 0.022));
  m._v = dt > 0 ? sp / Math.min(dt, 0.022) : 0;
  try{ doorYield(m, dt, m.x + hx*sp, m.z + hz*sp); }catch(e){}
  m.x += hx*sp; m.z += hz*sp;
  try{ if(m.room === G.room) for(const o of hereNow()){ if(o === m || o.room !== m.room) continue;
      const ox = m.x - o.x, oz = m.z - o.z, r = Math.hypot(ox, oz);
      if(r > 0.001 && r < 0.42){ const push = (0.42 - r) * (o.sitting ? 1 : 0.5); m.x += ox / r * push; m.z += oz / r * push; } } }catch(e){}
  try{ physCollide(m); }catch(e){}
  try{ unstick(m, dt); }catch(e){}
}
/* ── two members find each other and talk ─────────────────── */
const CONFER_OPEN = ["Have you got a minute?","Where are you on this?","Did you hear?",
  "They're counting noses again.","I need to ask you something.","Have you seen the whip count?"];
const CONFER_BACK = ["Not where the leadership wants me.","I'm listening.","That's not what I heard.",
  "Ask me after the vote.","Between us? No.","Everyone's saying that."];
let conferT = 0;
/* ══════════════════════════════════════════════════════════
   VOX · the public square
   Everyone in this building has an account and none of them have any
   judgement. Members post all day on their own, back each other or go
   after each other in front of the whole country, gain and lose
   followers for it — and then have to look at each other in the
   corridor afterwards, because none of it stays online.
   ══════════════════════════════════════════════════════════ */
function voxInit(){
  if(!G.vox) G.vox = {posts:[], id:1};
  if(G.you && G.you.followers === undefined) G.you.followers = rint(900, 3400);
  everyone().forEach(m => {
    if(m.followers === undefined){
      /* a loud backbencher can out-follow a quiet chairman */
      m.followers = Math.round(rint(300, 9000) * (1 + m.traits.temper/70) * (m.post ? 3.4 : 1));
    }
    if(m.voxAppetite === undefined){
      m.voxAppetite = clamp(m.traits.temper*0.7 + (100 - m.traits.discretion)*0.5, 5, 100);
    }
  });
}
/* A handle is how one of them addresses another in public, and being
   addressed in public is a different thing from being talked about. */
function handleOf(p){
  if(!p) return "@member";
  if(p.handle) return p.handle;
  const base = "@" + surname(p.name).replace(/[^A-Za-z]/g, "");
  let h = base, i = 2;
  const taken = everyone().some(o => o !== p && o.handle === h);
  if(taken) h = base + i;
  p.handle = h;
  return h;
}
function byHandle(h){
  const t = String(h || "").toLowerCase();
  return everyone().find(p => !p.gone && handleOf(p).toLowerCase() === t) || null;
}
/* @somebody in a post becomes a link you can press, and a notification
   they will answer */
function voxMarkup(text){
  return String(text).replace(/@([A-Za-z][A-Za-z0-9]*)/g, (all, name) => {
    const p = byHandle("@" + name);
    return p ? '<span' + tipAttr("who", p.id) + '>' + all + '</span>' : all;
  });
}
function mentionsIn(text){
  const out = [];
  String(text).replace(/@([A-Za-z][A-Za-z0-9]*)/g, (all, name) => {
    const p = byHandle("@" + name);
    if(p && out.indexOf(p) < 0) out.push(p);
    return all;
  });
  return out;
}
function followerLabel(nn){
  const n = Math.round(nn || 0);
  return n >= 1000000 ? (n/1000000).toFixed(1) + "M"
       : n >= 10000   ? Math.round(n/1000) + "k"
       : n >= 1000    ? (n/1000).toFixed(1) + "k" : String(n);
}
/* ── Unchained Vox: freeform individual speech (no LLM) ──
   Appetite/temper gate how often. Never sanitize what anyone typed.
   voxMarkup may only wrap @mentions — never alter visible words. */
function voxEscAttr(s){
  return String(s == null ? "" : s).replace(/&/g,"\x26amp;").replace(/"/g,"\x26quot;").replace(/</g,"\x26lt;");
}
function voxQuoteFrag(text){
  const raw = String(text || "").replace(/\s+/g, " ").trim();
  if(!raw) return "that";
  const cut = raw.length > 42 ? raw.slice(0, 40).replace(/\s+\S*$/, "") + "…" : raw;
  return cut;
}
function voxRecentSeen(m, n){
  if(!G.vox || !G.vox.posts) return [];
  return G.vox.posts.filter(p => p.by !== m.id && !p.mine).slice(0, n || 6);
}
function voxKindVal(text, m){
  const t = " " + String(text).toLowerCase() + " ";
  const hostile = /\b(lie|lied|liar|corrupt|coward|disgrace|resign|hypocrite|shame|clown|fraud)\b/.test(t);
  const warm = /\b(thank|grateful|proud|respect|agree|well said|glad)\b/.test(t);
  const billish = G.bill && !G.bill.done && (/\b(bill|vote|clause|floor|amendment)\b/.test(t) ||
    t.indexOf(G.bill.title.toLowerCase().split(" ")[0]) >= 0);
  let k = billish ? "bill" : hostile ? "heat" : warm ? "warm" : "human";
  let v = hostile ? -1 : warm ? 1 : 0;
  if(billish && m){
    try{ v = memberVote(m, G.bill) > 0 ? 1 : -1; }catch(e){}
  }
  return {k, v};
}
/* Freeform generator: novel sentences from traits, mood, party, bill,
   rival/ally, room gossip, recent posts, personal asides, heat, jokes,
   rants, quiet observations — and this person's thought/hope/vision/mind. */
function voxFree(m, ctx){
  ctx = ctx || {};
  ensureSelfhood(m);
  mindEnsure(m);
  const bill = G.bill && !G.bill.done ? G.bill : null;
  const mood = moodOf(m);
  const bio = bioOf(m);
  const rival = byId(m.rival);
  const ally = (m.allies || []).map(byId).filter(x => x && !x.gone)[0];
  const T = m.traits || {};
  const recent = voxRecentSeen(m, 8);
  const gossip = recent.length ? pick(recent) : null;
  const mindT = (m.mind.thoughts || [])[0];
  const mindC = (m.mind.concepts || []).filter(c => c && c.t)[0];
  const opens = [];
  if(T.temper > 70) opens.push("Listen.", "I am done whispering.", "Fine. Out loud:");
  else if(T.discretion > 68) opens.push("Quietly:", "For the record,", "I will say this once.");
  else opens.push("Look —", "Honestly,", "Here is the thing.", "");
  const cores = [];
  if(m.thought && chance(.38)) cores.push(m.thought);
  if(m.hope && chance(.28)) cores.push("What I still hope: " + m.hope);
  if(m.vision && chance(.22)) cores.push("The picture I will not let go of: " + m.vision);
  if(mindT && chance(.45)) cores.push(mindT.t);
  if(mindC && chance(.4)) cores.push("I keep turning over what I call " + mindC.t + " — " + (mindC.d || "a thing that was not in any brief."));
  if(bill){
    const forIt = memberVote(m, bill) > 0;
    cores.push(forIt
      ? bill.title + " is the right call for " + bio.town + " and I am not pretending otherwise."
      : bill.title + " does nothing honest for " + bio.town + ". I have read it.");
    cores.push(forIt
      ? "Anyone calling " + bill.title + " radical has not sat where I sit."
      : "They will call " + bill.title + " a compromise. " + bio.town + " pays.");
  }
  cores.push("Spent the morning on the phone with " + bio.town + ". They are talking about " + bio.trouble + ", not our theatre.");
  cores.push("Committee ran long. Markup is where the loud people go quiet.");
  cores.push("The guilder is at " + Math.round(guilderIndex()) + " and upstairs will not say the word.");
  if(mood.val < -30) cores.push("I am finished being lectured about good faith by people who have never shown any.");
  if(mood.val < -50) cores.push("Some of my colleagues should read last year's transcript. I have.");
  if(mood.val > 34) cores.push("A good day in this building, for once. Rare enough to say.");
  if(T.temper > 65 && mood.val < 0) cores.push("I am hot and I am not going to cool for the feed.");
  if(T.discretion > 70) cores.push("Most of what I think stays off this. Not this sentence.");
  if(m.post) cores.push("The job is to count, not to preach. I will keep counting.");
  if(rival && !rival.gone){
    cores.push(handleOf(rival) + " has been telling that story all week and it was not true on Monday either.");
    if(mood.val < -5) cores.push(handleOf(rival) + " — name it. You know what you did.");
  }
  if(ally) cores.push("Whatever else you think, " + handleOf(ally) + " has been right about this from the start.");
  if(G.you && m.rel && Math.abs(m.rel.warmth) > 30 && chance(.35))
    cores.push((m.rel.warmth > 0 ? "Say what you like about " : "I have had about enough of ") +
      handleOf(G.you) + (m.rel.warmth > 0 ? " — they turn up." : "."));
  if(gossip){
    const who = gossip.mine ? G.you : byId(gossip.by);
    const h = who ? handleOf(who) : "somebody";
    cores.push("Saw " + h + " write “" + voxQuoteFrag(gossip.t) + "”. I have thoughts.");
    cores.push(h + " said “" + voxQuoteFrag(gossip.t) + "” and expected quiet. No.");
  }
  cores.push(bio.priv);
  cores.push("Personal aside: " + (m.dayEvent ? String(m.dayEvent.t).replace(/^Their/,"My").replace(/^They/,"I") : "I have not slept enough to be careful."));
  if(chance(.12) && T.temper > 55) cores.push("THIS PLACE. Every. Single. Day.");
  if(chance(.1)) cores.push("typo intentional. mood intentional. leave it.");
  let core = pick(cores);
  /* cross-member @ without player */
  if(chance(.28)){
    const live = G.members.filter(x => x !== m && !x.gone);
    if(live.length){
      const other = (rival && !rival.gone && chance(.5)) ? rival
                  : (ally && chance(.4)) ? ally
                  : pick(live);
      if(core.indexOf(handleOf(other)) < 0 && chance(.7))
        core = handleOf(other) + " — " + core;
    }
  }
  const open = pick(opens);
  const aside = chance(.25) ? pick([
    " That is all.",
    " I will not tidy it up for you.",
    " Quote me correctly or not at all.",
    " " + bio.town + " can read.",
    ""
  ]) : "";
  const text = fresh(() => {
    const lead = open ? (open + (open.endsWith(":") || open.endsWith("—") || open.endsWith("-") ? " " : " ")) : "";
    return (lead + core + aside).replace(/\s+/g, " ").trim();
  }, 16);
  const kv = voxKindVal(text, m);
  if(ctx.forceK) kv.k = ctx.forceK;
  if(ctx.forceV !== undefined) kv.v = ctx.forceV;
  mindRemember(m, "thought", "I posted: “" + voxQuoteFrag(text) + "”", {soft:true});
  return {t:text, k:kv.k, v:kv.v};
}
/* Answer the substance of a post — quote a fragment, agree/fight/deflect/ramble. */
function voxReplyFree(p, post){
  ensureSelfhood(p);
  mindEnsure(p);
  const author = post.mine ? G.you : byId(post.by);
  const ah = author ? handleOf(author) : "them";
  const frag = voxQuoteFrag(post.t);
  const hostile = /\b(lie|lied|liar|corrupt|coward|disgrace|resign|hypocrite|shame|clown|fraud)\b/i.test(post.t);
  const warm = /\b(thank|grateful|proud|respect|agree|well said|glad|decent)\b/i.test(post.t);
  const mood = moodOf(p).val;
  const T = p.traits || {};
  const modes = [];
  if(hostile || (post.v < 0 && mood < 10)){
    modes.push("fight");
    if(T.temper > 55) modes.push("fight", "rant");
  }
  if(warm || (post.v > 0 && mood > 0)) modes.push("agree", "agree");
  modes.push("deflect", "ramble");
  if(p.thought) modes.push("ramble");
  const mode = pick(modes);
  const lines = {
    fight: [
      "You wrote “" + frag + "”. " + ah + ", that is either wrong or ten years old. Ask me which.",
      "“" + frag + "” — no. I have your number and you did not use it. That tells the country what this is.",
      ah + " put “" + frag + "” where my district can read it. I will answer on the floor under privilege."
    ],
    rant: [
      "“" + frag + "”. I am not going to be calm about that. " + (p.fear ? "What keeps me up is " + p.fear.t + "." : "Not today."),
      ah + " — “" + frag + "”. Hot take from someone who has never sat a markup in " + bioOf(p).town + "."
    ],
    agree: [
      "“" + frag + "” — yes. Grateful to " + ah + " for saying it where it costs something.",
      ah + " is right about “" + frag + "”. I will say so again if asked.",
      "Noted, returned: “" + frag + "”. " + (p.hope ? "Still hoping " + p.hope.replace(/^That /i,"").replace(/\.$/,"") + "." : "")
    ],
    deflect: [
      "I saw “" + frag + "”. I am not picking that fight on here. Call me.",
      "“" + frag + "” is a corridor conversation, not a feed one. " + ah + " knows where I sit.",
      "Interesting line — “" + frag + "”. I have a different count. Later."
    ],
    ramble: [
      "On “" + frag + "”: " + (p.thought || "I have been carrying something else all week.") + " That is my answer.",
      "“" + frag + "” pulled me sideways. " + (p.vision || "I keep a private picture of how this ends.") + " Anyway — " + ah + " started it.",
      (p.mind && p.mind.concepts[0] ? "You said “" + frag + "”. I keep inventing " + p.mind.concepts[0].t + " in my head — " + (p.mind.concepts[0].d || "a concept this building has no word for.") : "“" + frag + "”. I wandered off into my own district while reading it.")
    ]
  };
  const text = fresh(() => pick(lines[mode] || lines.deflect), 14);
  mindRemember(p, "experience", "Answered " + ah + " on Vox about “" + frag + "” (" + mode + ")");
  if(hostile) mindRemember(p, "thought", "Still chewing on “" + frag + "” from " + ah);
  const kv = voxKindVal(text, p);
  return {t:text, k:hostile ? "heat" : (warm ? "warm" : kv.k), v:hostile ? -1 : (warm ? 1 : kv.v)};
}
/* somebody else weighs in — which is where it stops being online */
function voxReact(post, m){
  const author = post.mine ? G.you : byId(post.by);
  if(!author || author === m || m.gone) return;
  const aligned = (m.party === author.party) ||
                  (post.v > 0 && moodOf(m).val > 20) ||
                  (post.v === 0 && chance(.4));
  const heat = m.traits.temper / 100;
  if(aligned && chance(.62)){
    post.backs++;
    author.followers = Math.round(author.followers * (1 + 0.006 + Math.random()*0.010));
    ripple(author, 2, "You backed me in public when it would have been easier not to.", 3);
    post.voices.push({id:m.id, t:"backed this"});
  } else if(!aligned && chance(.34 + heat*0.4)){
    post.hits++;
    author.followers = Math.round(author.followers * (1 + 0.012 + Math.random()*0.020));
    m.followers = Math.round(m.followers * (1 + 0.008));
    ripple(author, -4, "You came at me in public rather than saying it to my face.", -5);
    ripple(m, -2, "I had to answer for what " + surname(author.name) + " said. Publicly.", -2);
    post.voices.push({id:m.id, t:"came at this"});
    mindRemember(m, "experience", "Public fight on Vox with " + surname(author.name));
    mindRemember(author, "experience", surname(m.name) + " came at me on Vox");
  }
}
function voxAdd(post){
  if(!G.vox) voxInit();
  if(post && post.t){
    const who = post.by ? byId(post.by) : (post.mine ? G.you : null);
    post.t = wallScrub(post.t, who);
  }
  G.vox.posts.unshift(post);
  if(G.vox.posts.length > onumLim(60,"hist")) G.vox.posts.length = onumLim(60,"hist");
  /* concept heat: if text names a known invented concept, nudge it */
  try{ mindCiteConcepts(post); }catch(e){}
  /* Anybody named in it is going to see it, and most of them are going
     to answer — not instantly, because nobody is holding their phone
     waiting for you, but within a minute or two, the way it works. */
  /* A reply does not get replied to. Without this, two members name
     each other and answer each other every three seconds until the end
     of the Republic. */
  if(post.reply) return;
  const named = mentionsIn(post.t).filter(p => p.kind === "member" && !p.gone);
  named.forEach((p, i) => {
    const hostile = /\b(lie|lied|liar|corrupt|coward|disgrace|resign|hypocrite|shame)\b/i.test(post.t);
    const author = post.mine ? G.you : byId(post.by);
    if(p === author) return;
    if(post.mine){
      ripple(p, hostile ? -9 : 4,
        hostile ? "You put my name in a post where the whole country could read it."
                : "You said something decent about me in public.", hostile ? -8 : 4);
    } else if(author && author.kind === "member"){
      tieShift(author, p, hostile ? -12 : 6,
        hostile ? surname(author.name) + " put my name in a post for the whole country to read."
                : surname(author.name) + " said something decent about me in public.");
    }
    mindRemember(p, "experience", (author ? surname(author.name) : "Someone") + " named me on Vox: “" + voxQuoteFrag(post.t) + "”");
    /* appetite/temper gate how often they answer — not what they may say */
    if(!chance(0.62 + p.traits.temper/300)) return;
    setTimeout(() => {
      if(!G.vox || p.gone) return;
      const back = voxReplyFree(p, post);
      voxAdd({id:G.vox.id++, by:p.id, t:back.t, k:back.k,
              v:back.v, day:G.day, at:hhmm(), backs:0, hits:0,
              voices:[], mine:false, reply:post.id});
      feed(handleOf(p) + " answered.");
      refreshVox();
    }, 2400 + i*2600 + Math.random()*3000);
  });
  /* occasional unsolicited reply under a hot post */
  if(!post.reply && (post.hits >= 2 || post.backs >= 3 || chance(.14))){
    const lurkers = G.members.filter(x => !x.gone && x.id !== post.by &&
      named.indexOf(x) < 0 && chance((x.voxAppetite || 30)/220 + x.traits.temper/400));
    if(lurkers.length){
      const L = pick(lurkers);
      setTimeout(() => {
        if(!G.vox || L.gone) return;
        const back = voxReplyFree(L, post);
        voxAdd({id:G.vox.id++, by:L.id, t:back.t, k:back.k, v:back.v,
                day:G.day, at:hhmm(), backs:0, hits:0, voices:[], mine:false, reply:post.id});
        feed(handleOf(L) + " jumped in.");
        refreshVox();
      }, 5000 + Math.random()*8000);
    }
  }
}
let voxT = 0;
function voxTick(w){
  if(!G.vox) voxInit();
  voxT -= w;
  if(voxT > 0) return;
  voxT = 26 + Math.random()*40;                 /* game-minutes between posts */
  const pool = G.members.filter(m => !m.gone && chance((m.voxAppetite || 30)/140));
  if(!pool.length) return;
  const m = pick(pool);
  const line = voxFree(m, {});
  try{ line.t = voxSpice(m, line.t); }catch(e){}
  try{ if(chance(.07)) dmInitiative(); }catch(e){}
  const post = {id:G.vox.id++, by:m.id, t:line.t, k:line.k, v:line.v,
                day:G.day, at:hhmm(), backs:0, hits:0, voices:[], mine:false};
  voxAdd(post);
  /* the room answers */
  const others = G.members.filter(x => x !== m && !x.gone);
  const nn = rint(1, 3);
  for(let i=0;i<nn && others.length;i++) voxReact(post, pick(others));
  /* and then people answer people: a short thread, each answering the one before */
  if(chance(.6)) try{ voxThread(post, m); }catch(e){ console.warn("voxThread", e); }
  /* members @ each other without the player */
  if(chance(.12) && others.length){
    const o = cultRival(m, others) || pick(others);
    if(chance((o.voxAppetite || 30)/120)){
      const jab = voxFree(o, {});
      try{ jab.t = voxSpice(o, jab.t); try{ tieShift(m, o, -2, "on the Vox"); }catch(e){} }catch(e){}
      if(jab.t.indexOf("@") < 0) jab.t = handleOf(m) + " " + jab.t;
      const jp = {id:G.vox.id++, by:o.id, t:jab.t, k:jab.k, v:jab.v,
                  day:G.day, at:hhmm(), backs:0, hits:0, voices:[], mine:false};
      voxAdd(jp);
    }
  }
  const swing = post.backs*0.004 + post.hits*0.010 - 0.001;
  m.followers = Math.max(60, Math.round(m.followers * (1 + swing)));
  refreshVox();
}
/* Typewriter: reveal characters ~20–40ms; skip if reduced-motion or post.typed */
function voxReducedMotion(){
  try{ return !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches); }catch(e){ return false; }
}
function voxTypePosts(root){
  const box = root || document;
  if(!box || !box.querySelectorAll) return;
  const nodes = box.querySelectorAll(".vox__t[data-full]");
  nodes.forEach(node => {
    if(node._voxTyping) return;
    const id = +node.getAttribute("data-vid");
    const full = node.getAttribute("data-full") || "";
    const post = (G.vox && G.vox.posts) ? G.vox.posts.find(p => p.id === id) : null;
    if(post && post.typed){
      node.innerHTML = voxMarkup(full);
      return;
    }
    if(voxReducedMotion() || !full){
      node.innerHTML = voxMarkup(full);
      if(post) post.typed = true;
      return;
    }
    node._voxTyping = true;
    node.classList.add("is-typing");
    node.textContent = "";
    let i = 0;
    const speed = 20 + Math.random() * 20;
    const step = () => {
      if(!node.isConnected){ node._voxTyping = false; return; }
      if(i >= full.length){
        node.innerHTML = voxMarkup(full);
        node.classList.remove("is-typing");
        node._voxTyping = false;
        if(post) post.typed = true;
        return;
      }
      i++;
      node.textContent = full.slice(0, i);
      setTimeout(step, speed);
    };
    step();
  });
}

/* ── your turn ── */
function voxKinds(){
  return [
    {id:"bill",   t:"Post about the bill",       c:20, off:!(G.bill && !G.bill.done)},
    {id:"home",   t:"Post about your district",  c:15, off:false},
    {id:"attack", t:"Go after somebody by name", c:25, off:!G.members.some(m => m.met && !m.gone)},
    {id:"human",  t:"Post something human",      c:10, off:false}
  ];
}
/* You wrote it, so the game has to read it. Who you named, whether you
   went at somebody, whether you are backing the bill or knifing it —
   all of it comes out of the words themselves, with no connection
   required. */
function voxRead(text){
  const t = " " + text.toLowerCase() + " ";
  let named = null;
  const at = mentionsIn(text)[0];
  if(at) named = at;
  G.members.concat(G.press).forEach(m => {
    if(m.gone) return;
    const sn = surname(m.name).toLowerCase();
    if(sn.length > 3 && t.indexOf(" " + sn) >= 0) named = m;
  });
  const hostile = /\b(lie|lies|lied|liar|lying|misled|smear|corrupt|coward|disgrace|disgraceful|shameful|fraud|bought|paid for|resign|hypocrite|crook|useless|clown|grifter|sellout)\b/.test(t);
  const warm    = /\b(thank|grateful|proud|honour|honor|respect|agree|well said|good work|glad)\b/.test(t);
  const billish = G.bill && !G.bill.done &&
    (t.indexOf(G.bill.title.toLowerCase().split(" ")[0]) >= 0 || /\b(bill|vote|clause|floor|amendment)\b/.test(t));
  const homely  = /\b(district|home|county|town|school|hospital|jobs|families|constituents)\b/.test(t);
  const personal= /\b(daughter|son|wife|husband|mother|father|tired|sleep|family|home tonight)\b/.test(t);
  /* naming somebody makes it a post about them either way: a knife if
     it is hostile, and something they will thank you for if it is not */
  const kind = (named && hostile) ? "attack" : (named && warm) ? "praise"
             : billish ? "bill" : homely ? "home" : "human";
  return {kind, named, hostile, warm, billish, homely, personal,
          heat: (hostile ? 1 : 0) + (/[!?]{2,}|[A-Z]{5,}/.test(text) ? 1 : 0)};
}
function voxYouLine(kind, target){

  const bill = G.bill;
  if(kind === "bill") return bill
    ? ((G.you.lean || 0) >= 0
        ? "I have read " + bill.title + " end to end. I am voting for it and I will take the questions."
        : "I have read " + bill.title + " end to end. I am voting against it and I will take the questions.")
    : "There is nothing on the calendar worth your evening.";
  if(kind === "home") return "Back in " + G.you.state + " " + G.you.dist +
    " this week. Nobody there asked me about a single thing this building spent today arguing about.";
  if(kind === "attack") return "I have sat across from " + (target ? target.name : "the member") +
    " in committee. What was said today does not match what was said in that room.";
  return "Long day. I was asked what I actually did today and I could not answer it in under a paragraph.";
}
function voxYouPost(kind, target, written){
  voxInit();
  const you = G.you;
  let readOut = null;
  if(written){
    /* No fix: post the exact string they typed — never replace with menu text. */
    readOut = voxRead(written);
    kind = readOut.kind;
    if(readOut.named) target = readOut.named;
  }
  const line = written || voxYouLine(kind, target);
  const post = {id:G.vox.id++, by:"you", t:line, k:kind, day:G.day, at:hhmm(),
                backs:0, hits:0, voices:[], mine:true};
  voxAdd(post);
  /* Taylor blasphemy is consequence — text still displays unchanged. */
  if(written){
    try{ checkSpeakBlasphemy(written, "you"); }catch(e){}
    try{ mindRemember(you, "experience", "I posted on Vox: “" + voxQuoteFrag(written) + "”"); }catch(e){}
  }
  /* Reach is standing plus luck. It is not a reward for posting — it is a
     roll, and it goes the other way about as often. */
  const roll = Math.random();
  const lift = (you.standing - 50)/220 + (you.approval - 50)/260;
  /* Something you actually wrote travels further than a line off a menu,
     and heat travels furthest of all — which is not the same as it
     doing you any good. */
  const own = written ? 0.06 : 0;
  const heat = readOut ? readOut.heat * 0.05 : 0;
  const viral = roll > 0.86 - lift - own - heat;
  const flop  = roll < 0.16 - lift - own;
  let dF = viral ? rint(400, 5200) : flop ? -rint(80, 900) : rint(30, 700);
  let dApp = 0, dStand = 0;
  G.members.filter(m => !m.gone).forEach(m => {
    if(kind === "praise" && m === target){
      post.backs++;
      post.voices.push({id:m.id, t:"saw this"});
      ripple(m, 11, "You said something decent about me where everybody could see it.", 10);
      return;
    }
    if(kind === "attack" && m === target){
      post.hits++;
      post.voices.push({id:m.id, t:"was named"});
      ripple(m, -16, "You went after me by name in front of the whole country.", -16, true);
      return;
    }
    if(!chance(0.30 + (m.voxAppetite || 30)/300)) return;
    const agrees = kind === "bill"   ? (m.party === you.party ? chance(.72) : chance(.22))
                 : kind === "attack" ? (byId(m.rival) === target ? chance(.62) : chance(.18))
                 : chance(.34);
    if(agrees){
      post.backs++;
      post.voices.push({id:m.id, t:"backed this"});
      ripple(m, 2, "You said in public what I have been saying privately.", 2);
    } else if(chance(.5)){
      post.hits++;
      post.voices.push({id:m.id, t:"came at this"});
      ripple(m, -3, "You posted that where my district could read it.", -3);
    }
  });
  if(kind === "attack"){
    dStand -= 4; dApp += viral ? 2 : -1; dF += 900;
    if(readOut && readOut.heat > 1){ dStand -= 3; dApp -= 2; }
    if(target) note("You went after " + target.name + " on Vox. That does not come back down.", true);
  } else if(kind === "praise"){
    dStand += 2; dApp += viral ? 2 : 1;
    if(target) note("You backed " + target.name + " in public. That is remembered too.");
  } else {
    dApp += viral ? 3 : flop ? -2 : 1;
    dStand += post.backs > post.hits ? 1 : -1;
  }
  you.followers = Math.max(50, Math.round(you.followers + dF));
  you.approval = clamp(you.approval + dApp, 0, 100);
  you.standing = clamp(you.standing + dStand, 0, 100);
  post.reach = viral ? "carried" : flop ? "went nowhere" : "did its rounds";
  feed(viral ? "That one carried." : flop ? "That one went nowhere." : "Posted.");
  refreshVox(); refreshPanels();
  return {post, dF, dApp, dStand, viral, flop};
}
/* followers are not approval, but they lean on it a little every day */
function voxDaily(){
  voxInit();
  const you = G.you;
  you.approval = clamp(you.approval + clamp((you.followers - 2600)/9000, -1.2, 1.2), 0, 100);
  G.members.forEach(m => { if(!m.gone) m.followers = Math.round(m.followers * (0.997 + Math.random()*0.008)); });
}
function voxComposerHTML(){
  return '<div class="voxq" style="margin:0 0 12px"><textarea class="voxq__t" maxlength="2000" rows="2" placeholder="Say it on Vox. No script; they will answer in kind." style="width:100%;box-sizing:border-box;font:13px system-ui;padding:6px 8px;border-radius:6px"></textarea>' +
    '<div style="display:flex;justify-content:space-between;align-items:center;margin-top:4px"><span class="muted voxq__c" style="font-size:11px">2000</span><button type="button" class="btn voxq__b">Post it</button></div></div>';
}
function voxReact(id, v){
  const p = ((G.vox && G.vox.posts) || []).find(x => x.id === id); if(!p || p.mine || p.my) return false;
  p.my = v; if(v > 0) p.backs = (p.backs || 0) + 1; else p.hits = (p.hits || 0) + 1;
  const a = byId(p.by);
  if(a && a.rel){ try{ ripple(a, v > 0 ? 2 : -2, v > 0 ? "They backed what I put on Vox." : "They came out against what I put on Vox.", v > 0 ? 1 : -1, false); }catch(e){} }
  try{ G.you.likes = (G.you.likes || 0) + (v > 0 ? 1 : 0); }catch(e){}
  return true;
}
document.addEventListener("click", ev => {
  try{
    const t = ev.target && ev.target.closest ? ev.target.closest("[data-vlike],[data-vdis],[data-vre],.voxq__b") : null; if(!t || !G.you) return;
    const root = t.closest("#paneVox") || card;
    const redraw = () => { if(t.closest("#paneVox")) refreshVox(); else if(typeof phoneCard === "function" && !veil.hidden) phoneCard(); };
    if(t.matches(".voxq__b")){
      const ta = t.closest(".voxq").querySelector("textarea"), text = ta.value.trim(); if(!text) return;
      spend(rint(10, 18), 2);
      const r = voxYouPost(null, null, text);
      note("You posted: \u201c" + text.slice(0, 90) + (text.length > 90 ? "\u2026" : "") + "\u201d", r.post.k === "attack");
      feed("It " + r.post.reach + ": " + (r.dF >= 0 ? "+" : "\u2212") + followerLabel(Math.abs(r.dF)) + " \u00b7 " + r.post.backs + " backing, " + r.post.hits + " against.");
      ta.value = ""; redraw(); return;
    }
    if(t.hasAttribute("data-vre")){ const p = G.vox.posts.find(x => x.id === +t.getAttribute("data-vre")), a = p && byId(p.by), ta = root.querySelector(".voxq__t"); if(ta && a){ ta.value = handleOf(a) + " "; ta.focus(); } return; }
    const v = t.hasAttribute("data-vlike") ? 1 : -1, id = +t.getAttribute(v > 0 ? "data-vlike" : "data-vdis");
    if(voxReact(id, v)){ spend(1, 0); redraw(); }
  }catch(e){ console.warn("vox ui", e); }
}, true);
document.addEventListener("input", ev => { const ta = ev.target; if(ta && ta.classList && ta.classList.contains("voxq__t")){ const c = ta.closest(".voxq").querySelector(".voxq__c"); if(c) c.textContent = 2000 - ta.value.length; } });
function voxRows(limit){
  voxInit();
  const you = G.you;
  return (G.vox.posts || []).slice(0, limit || 26).map(p => {
    const a = p.mine ? you : byId(p.by);
    if(!a) return "";
    const tone = p.mine ? "ind" : a.party === "FED" ? "fed" : a.party === "COM" ? "com" : "ind";
    const voices = (p.voices || []).slice(0,3).map(v => {
      const who = byId(v.id);
      return who ? surname(who.name) + " " + v.t : "";
    }).filter(Boolean).join(" · ");
    return '<div class="vox' + (p.mine ? " is-mine" : "") + '">' +
      '<div class="vox__h"><b'+(p.mine?"":tipAttr("who",a.id))+'>' + a.name + '</b>' +
        '<span class="vox__at">' + handleOf(a) + '</span>' +
        '<span class="chip chip--' + tone + '">' + (p.mine ? "you" : partyLabel(a.party)) + '</span>' +
        '<i>' + followerLabel(a.followers) + ' · d' + p.day + ' ' + p.at + '</i></div>' +
      (p.reply ? '<div class="vox__re">replying</div>' : '') +
      '<div class="vox__t" data-vid="' + p.id + '" data-full="' + voxEscAttr(p.t) + '">' +
        ((p.typed || voxReducedMotion()) ? voxMarkup(p.t) : '') + '</div>' +
      '<div class="vox__f"><span>' + p.backs + ' backing</span><span>' + p.hits + ' against</span>' +
        (voices ? '<span>' + voices + '</span>' : '') + '</div>' +
      (p.mine ? '' : '<div class="vox__f" style="gap:8px"><button type="button" class="cl-btn" data-vlike="' + p.id + '"' + (p.my ? ' disabled' : '') + (p.my > 0 ? ' style="background:#2f6b3a;color:#fff"' : '') + '>\u25b2 Like</button>' +
        '<button type="button" class="cl-btn" data-vdis="' + p.id + '"' + (p.my ? ' disabled' : '') + (p.my < 0 ? ' style="background:#8a2f36;color:#fff"' : '') + '>\u25bc Dislike</button>' +
        '<button type="button" class="cl-btn" data-vre="' + p.id + '">Reply</button></div>') +
    '</div>';
  }).join("");
}
function refreshVox(){
  const box = el("paneVox");
  if(!box) return;
  voxInit();
  { const ae = document.activeElement; if(ae && ae.classList && ae.classList.contains("voxq__t") && box.contains(ae)) return; }
  const keep = (box.querySelector(".voxq__t") || {}).value || "";
  setHTML(box,
    '<div class="eyebrow">Vox · unchained</div>' + voxComposerHTML() +
    '<p class="muted" style="margin:6px 0 10px">You have <strong>' + followerLabel(G.you.followers) +
      '</strong> following you. Individuals type freely; the machine types it out. No script, no fix.</p>' +
    (voxRows(26) || '<p class="muted">Nobody has said anything yet.</p>'));
  try{ const t0 = box.querySelector(".voxq__t"); if(t0 && keep) t0.value = keep; }catch(e){}
  try{ voxTypePosts(box); }catch(e){}
}

/* ══════════════════════════════════════════════════════════
   THE PHONE · the office, in your pocket
   Everything the desk computer does, anywhere in the building — mail,
   the whip count, the wire and Vox. It costs you the same minutes it
   would cost you sitting down, because reading is reading.
   ══════════════════════════════════════════════════════════ */
const PHONE_TABS = ["day","panels","vox","post","mail","desk"];
function phoneTabOrder(){
  return PHONE_TABS.slice();
}
function dayEventsToday(){
  return (G.events || []).filter(e => e.day === G.day).slice().sort((a,b) => (a.hour||0) - (b.hour||0));
}
function dayScheduleHtml(){
  const list = dayEventsToday();
  const nowH = (G.minute||0) / 60;
  const b = G.bill;
  let billBit = "";
  if(b && !b.done){
    const tally = tallyBill(b, true);
    const yourVoteLabel = (G.you.vote === 1) ? " ✓" : (G.you.vote === -1) ? " ✓" : "";
    billBit = '<div class="risk" style="border-left-color:var(--ink-3);margin-bottom:10px">' +
      '<div class="risk__t">' + b.title + '</div>' +
      '<div class="risk__m">Roll call · day ' + b.voteDay +
        (b.voteHour != null ? (' · ' + hourLabel(b.voteHour)) : '') + '</div>' +
      '<div style="margin:8px 0;padding:8px;background:rgba(255,255,255,0.05);border-radius:3px;font-family:monospace;font-size:12px">' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">' +
          '<div style="text-align:center"><strong style="color:var(--good)">' + tally.aye + '</strong> ayes</div>' +
          '<div style="text-align:center"><strong style="color:var(--bad)">' + tally.no + '</strong> noes</div>' +
        '</div>' +
      '</div>' +
      '<div class="risk__actions">' +
        '<button type="button" class="conc__btn" data-gp="phone-vote:1" data-phone-vote="1">1 · Vote aye' + (G.you.vote === 1 ? ' ✓' : '') + '</button>' +
        '<button type="button" class="conc__btn" data-gp="phone-vote:-1" data-phone-vote="-1">2 · Vote no' + (G.you.vote === -1 ? ' ✓' : '') + '</button>' +
      '</div>' +
      '<p class="phone__hint">Projected count updates live. Your vote: ' + (G.you.vote === 1 ? 'aye' : G.you.vote === -1 ? 'no' : 'undecided') + '</p></div>';
  }
  if(!list.length){
    return billBit + '<p class="muted">No sittings on the book for today. The corridor will invent one if you wait long enough.</p>';
  }
  return billBit + '<div class="phone__scroll">' + list.map((e, ix) => {
    const room = (ROOMS[e.room] && ROOMS[e.room].t) || e.room || "somewhere";
    const done = !!e.done;
    const due = !done && nowH >= (e.hour||0);
    const soon = !done && !due && (e.hour||0) - nowH <= 1.01;
    const tagLab = done ? "Done" : due ? "Due now" : soon ? "Soon" : (e.rsvp === true ? "Accepted" : e.rsvp === false ? "Declined" : "On the book");
    const col = done ? "var(--ink-3)" : due ? "var(--warn)" : soon ? "var(--fed)" : "var(--ink-2)";
    return '<div class="risk" style="border-left-color:' + col + '">' +
      '<div class="risk__t">' + e.t + '</div>' +
      '<div class="risk__m">' + hourLabel(e.hour) + " · " + room +
        (e.k ? (" · " + e.k) : "") + " · <b>" + tagLab + "</b></div>" +
      (e.d ? '<p class="muted" style="margin:6px 0 0">' + e.d + '</p>' : '') +
      (!done ? '<div class="risk__actions">' +
        '<button type="button" class="conc__btn' + (e.rsvp === true ? " is-accepted" : "") + '" data-gp="day:' + ix + ':1" data-day-rsvp="' + ix + ':1"' +
          (e.rsvp === true ? " disabled" : "") + '>' + (e.rsvp === true ? "✓ Accepted" : "Accept") + '</button>' +
        '<button type="button" class="conc__btn' + (e.rsvp === false ? " is-declined" : "") + '" data-gp="day:' + ix + ':0" data-day-rsvp="' + ix + ':0"' +
          (e.rsvp === false ? " disabled" : "") + '>' + (e.rsvp === false ? "✓ Declined" : "Decline") + '</button>' +
      '</div>' : '') +
    '</div>';
  }).join("") + '</div>' +
  '<div class="card__actions" style="margin-top:10px"><button type="button" class="btn btn--ghost" id="dayAcceptAll">Accept all</button></div>' +
  '<p class="phone__hint">X opens this schedule any time. LB / RB (or LT / RT) walk phone tabs · D-pad / stick moves buttons · A selects · B puts it away.</p>';
}
function openDaySchedule(){
  /* Pad X / quick path: today's sittings in the phone, clock still in view */
  if(TALK.open) try{ closeTalk(); }catch(e){}
  phoneTab = "day";
  if(!veil.hidden && phoneWasRunning !== null){
    phoneCard();
  } else if(veil.hidden && (G.running || G.over)){
    phoneCard();
  } else if(!veil.hidden && phoneWasRunning === null){
    /* some other card — leave it; feed a line instead */
    const list = dayEventsToday();
    const next = list.find(e => !e.done) || null;
    feed(next
      ? ("Next on the book: " + next.t + " · " + hourLabel(next.hour) + ".")
      : "Nothing left on today's schedule.");
    return;
  } else {
    phoneCard();
  }
  feed("Today's schedule.");
}
function phoneCycleTab(dir){
  const tabs = phoneTabOrder();
  let i = tabs.indexOf(phoneTab);
  if(i < 0) i = 0;
  phoneTab = tabs[(i + dir + tabs.length) % tabs.length];
  phoneCard();
  picksDirty = true;
  PICK = -1;
}
function phoneBillHtml(){
  const b = G.bill, you = G.you;
  if(!b || !you) return '<p class="muted">The calendar is clear.</p>';
  const t = tallyBill(b, true);
  const axes = AXES.map(a =>
    '<div class="axis"><i>'+a.lo+' / '+a.hi+'</i><span><b style="left:'+((b.pos[a.k]+100)/200*100)+
    '%"></b><em style="left:'+((you.district[a.k]+100)/200*100)+'%"></em></span></div>').join("");
  const dist = districtFit(b);
  const youFit = alignment(you, b);
  const seats = G.seats || 181;
  return '<div class="billbox phone__scroll">' +
    '<div class="eyebrow">On the calendar' + (b.stakes ? ' · ' + b.stakes : '') + '</div>' +
    '<div class="h-serif">' + b.title + '</div>' +
    '<div class="muted">' + (b.line || "") + (b.sponsor ? ' Sponsored by ' + youMark(b.sponsor) + '.' : '') + '</div>' +
    '<div class="billbox__pos">' + axes + '</div>' +
    '<div class="muted" style="margin-top:7px">Dark tick: the bill. Green tick: what your district wants.</div>' +
    '<p class="muted">District reads it as <strong>' +
      (dist>20?"a win":dist<-20?"a problem":"noise") + '</strong>; you read it as <strong>' +
      (youFit>20?"right":youFit<-20?"wrong":"borderline") + '</strong>.</p>' +
    '<div class="count"><div class="c-aye"><i>Ayes</i><b>'+t.aye+'</b></div>' +
      '<div class="c-no"><i>Noes</i><b>'+t.no+'</b></div>' +
      '<div class="c-un"><i>Unknown</i><b>'+t.un+'</b></div></div>' +
    '<div class="countbar"><span style="width:'+(t.aye/seats*100)+'%;background:var(--good)"></span>' +
      '<span style="width:'+(t.no/seats*100)+'%;background:var(--bad)"></span>' +
      '<span style="width:'+(t.un/seats*100)+'%;background:var(--line)"></span></div>' +
    '<p class="muted">Intention: <strong>' + (you.vote===1?"aye":you.vote===-1?"no":"undeclared") + '</strong>' +
      (b.voteDay ? ' · roll call day ' + b.voteDay : '') + '</p>' +
    '<div class="risk__actions">' +
      '<button class="conc__btn" type="button" data-gp="phone-vote:1" data-phone-vote="1">Vote aye</button>' +
      '<button class="conc__btn" type="button" data-gp="phone-vote:-1" data-phone-vote="-1">Vote no</button>' +
    '</div></div>';
}
function phoneMailHtml(){
  if(!(G.mail && G.mail.length))
    return '<p class="muted">Nothing yet. People write once they know who you are.</p>';
  return '<div class="phone__scroll">' + G.mail.slice(0, 16).map(x =>
    '<div class="mailrow' + (x.read||x.outgoing ? "" : " is-unread") + '" data-mail="' + x.id + '">' +
      '<div class="mailrow__h"><span class="mailrow__f">' +
        (x.read||x.outgoing ? "" : '<span class="dotmark"></span>') +
        (x.outgoing ? "→ " : "") + x.from + '</span>' +
        '<span class="mailrow__d">d' + x.day + ' · ' + x.at + '</span></div>' +
      '<div class="mailrow__s">' + x.subject + '</div>' +
      (x.open ? '<div class="mailrow__b">' + x.body + '</div>' +
        (x.options && !x.answered ? '<div class="mailrow__acts">' +
          x.options.map((o,i) => '<button class="conc__btn" style="width:auto" data-ans="' + x.id + ':' + i + '">' + o.t + '</button>').join("") +
          '</div>' : x.answered ? '<div class="mailrow__acts"><span class="muted">Answered.</span></div>' : "")
      : '<p class="muted" style="margin:6px 0 0">Tap to open and answer.</p>') +
    '</div>').join("") + '</div>';
}
let phoneTab = "vox";
function phoneCard(){
  if(!G.running && !G.over && !phoneWasRunning) return;
  voxInit();
  phoneWasRunning = phoneWasRunning === null ? G.running : phoneWasRunning;
  G.running = false;
  const you = G.you;
  const unread = unreadCount();
  const tabBtn = (id, label) =>
    '<button type="button" class="mk__opt' + (phoneTab === id ? " is-on" : "") + '" data-ptab="' + id + '" data-gp="ptab:' + id + '">' + label + '</button>';
  let body = "";
  if(phoneTab === "day"){
    body = '<p class="phone__hint">In time — sittings and roll call for <strong>' + dateString() + '</strong>. Clock is ' + hhmm() + '.</p>' +
      dayScheduleHtml();
  } else if(phoneTab === "panels"){
    body = phoneBillHtml();
  } else if(phoneTab === "vox"){
    body = voxComposerHTML() + '<div class="phone__scroll">' + (voxRows(14) || '<p class="muted">Nothing yet.</p>') + '</div>';
  } else if(phoneTab === "post"){
    body = '<div class="voxwrite">' +
        '<textarea id="voxText" maxlength="2000" rows="3" placeholder="Say anything. No script. They will answer in kind."></textarea>' +
        '<div class="voxwrite__f"><span id="voxCount">2000</span>' +
        '<button type="button" class="btn" id="voxSend">Post it</button></div>' +
      '</div>' +
      '<p class="muted" style="margin:8px 0 12px">Unchained — individuals type freely; the machine types it out. ' +
        'Name somebody with @ and they will see the exact words. No fix, no shorten.</p>' +
      '<div class="mk">' + voxKinds().map(k =>
      '<div class="mk__row"><i>' + k.t + '</i><div class="mk__opts">' +
        '<button type="button" class="mk__opt" data-post="' + k.id + '"' + (k.off ? " disabled" : "") + '>' +
        (k.off ? "not now" : k.c + "m") + '</button></div></div>').join("") + '</div>' +
      '<p class="muted" style="margin-top:8px">Everyone in the House reads it. Some of them will back you and ' +
      'some of them will come at you, and both of those are things you will have to look at in the corridor.</p>';
  } else if(phoneTab === "mail"){
    body = phoneMailHtml();
  } else {
    const b = G.bill;
    body = '<div class="mk">' +
      '<div class="mk__row"><i>Approval</i><b>' + Math.round(you.approval) + '</b></div>' +
      '<div class="mk__row"><i>Standing</i><b>' + Math.round(you.standing) + '</b></div>' +
      '<div class="mk__row"><i>Influence</i><b>' + Math.round(you.influence) + '</b></div>' +
      '<div class="mk__row"><i>Following</i><b>' + followerLabel(you.followers) + '</b></div>' +
      '<div class="mk__row"><i>War chest</i><b>' + money(you.funds) + '</b></div>' +
      (b && !b.done ? '<div class="mk__row"><i>On the calendar</i><b>' + b.title + '</b></div>' +
        '<div class="mk__row"><i>Roll call</i><b>day ' + b.voteDay + '</b></div>' : '') +
    '</div>';
  }
  card.innerHTML =
    '<div class="eyebrow">Your phone · ' + hhmm() + '</div>' +
    '<h1>The office, in your pocket.</h1>' +
    '<div class="mk__opts phone__tabs">' +
      tabBtn("day", "Day") + tabBtn("panels", "House") + tabBtn("vox", "Vox") + tabBtn("post", "Post") +
      tabBtn("mail", "Mail" + (unread ? " (" + unread + ")" : "")) + tabBtn("desk", "The count") +
    '</div>' + body +
    '<div class="card__actions"><button class="btn" type="button" id="phDone" data-gp="ph:done">Put it away</button></div>';
  veil.hidden = false;
  card.querySelectorAll("[data-ptab]").forEach(b => b.addEventListener("click", () => {
    phoneTab = b.getAttribute("data-ptab"); phoneCard();
  }));
  card.querySelectorAll("[data-day-rsvp]").forEach(b => b.addEventListener("click", () => {
    const raw = b.getAttribute("data-day-rsvp") || "";
    const parts = raw.split(":");
    const ix = +parts[0];
    const yes = parts[1] === "1";
    const ev = dayEventsToday()[ix];
    if(!ev || ev.done) return;
    ev.rsvp = yes;
    feed(yes ? ("Accepted: " + ev.t + ".") : ("Sent word — skipping " + ev.t + "."));
    try{ queueSave(); }catch(e){}
    phoneCard();
  }));
  card.querySelectorAll("[data-phone-vote]").forEach(btn => btn.addEventListener("click", () => {
    if(!G.bill || G.bill.done) return;
    const vote = +btn.getAttribute("data-phone-vote");
    if(vote !== 1 && vote !== -1) return;
    if(!inHouse()){ feed("You have no vote in the House."); return; }
    G.you.vote = vote;
    try{ taylorDayVoteDefiance(vote); }catch(e){}
    feed(vote > 0 ? "Phone vote recorded: yes." : "Phone vote recorded: no.");
    try{ queueSave(); }catch(e){}
    phoneCard();
  }));
  card.querySelectorAll("[data-mail]").forEach(r => r.addEventListener("click", e => {
    if(e.target.hasAttribute("data-ans")) return;
    const m = G.mail.find(x => x.id === +r.getAttribute("data-mail"));
    if(!m) return;
    m.open = !m.open; m.read = true;
    phoneCard();
  }));
  card.querySelectorAll("[data-ans]").forEach(b => b.addEventListener("click", e => {
    e.stopPropagation();
    const [mid, oi] = b.getAttribute("data-ans").split(":");
    const mail = G.mail.find(x => x.id === +mid);
    if(!mail || mail.answered) return;
    mail.answered = true; mail.read = true;
    const opt = mail.options && mail.options[+oi];
    if(opt && opt.run){
      try{ opt.run(); }catch(err){}
    }
    note("Answered " + mail.from + ": “" + ((opt && opt.t) || "yes") + "”.");
    try{ queueSave(); }catch(err){}
    phoneCard();
  }));
  const acceptAll = el("dayAcceptAll");
  if(acceptAll) acceptAll.addEventListener("click", () => {
    dayEventsToday().forEach(ev => { if(!ev.done) ev.rsvp = true; });
    feed("Accepted every remaining item on today's schedule.");
    try{ queueSave(); }catch(e){}
    phoneCard();
  });
  card.querySelectorAll("[data-post]").forEach(b => b.addEventListener("click", () => {
    const kind = b.getAttribute("data-post");
    const k = voxKinds().find(x => x.id === kind);
    if(!k || k.off) return;
    let target = null;
    if(kind === "attack"){
      const known = G.members.filter(m => m.met && !m.gone);
      target = known.sort((a,c) => a.rel.warmth - c.rel.warmth)[0] || pick(known);
    }
    phoneClose();
    spend(k.c, 3);
    const r = voxYouPost(kind, target);
    note("Posted: “" + r.post.t.slice(0, 90) + (r.post.t.length > 90 ? "…" : "") + "”");
    feed("It " + r.post.reach + ": " + (r.dF >= 0 ? "+" : "") + followerLabel(Math.abs(r.dF)) +
         (r.dF >= 0 ? " following" : " lost") + " · " + r.post.backs + " backing, " + r.post.hits + " against.");
  }));
  const ta = el("voxText");
  if(ta){
    const cnt = el("voxCount");
    ta.addEventListener("input", () => { cnt.textContent = 2000 - ta.value.length; });
    ta.addEventListener("keydown", ev => {
      if(ev.key === "Enter" && (ev.metaKey || ev.ctrlKey)){ ev.preventDefault(); el("voxSend").click(); }
    });
    el("voxSend").addEventListener("click", () => {
      const text = ta.value.trim();
      if(!text) return;
      phoneClose();
      spend(rint(10, 18), 2);
      const r = voxYouPost(null, null, text);
      note("You posted: “" + text.slice(0, 90) + (text.length > 90 ? "…" : "") + "”", r.post.k === "attack");
      feed("It " + r.post.reach + ": " + (r.dF >= 0 ? "+" : "−") + followerLabel(Math.abs(r.dF)) +
           " · " + r.post.backs + " backing, " + r.post.hits + " against.");
    });
    setTimeout(() => ta.focus(), 30);
  }
  el("phDone").addEventListener("click", phoneClose);
  if(phoneTab === "vox"){ try{ voxTypePosts(card); }catch(e){} }
}
let phoneWasRunning = null;
function phoneClose(){
  unmountDossierFromPhone();
  veil.hidden = true;
  G.running = phoneWasRunning === null ? true : phoneWasRunning;
  phoneWasRunning = null;
  picksDirty = true;
  try{ refreshPanels(); }catch(e){}
}

function confabulate(dt){
  conferT -= dt;
  if(conferT > 0) return;
  conferT = MODEST ? 1.6 : 0.85;
  const list = hereNow().filter(m => m.kind === "member");
  if(list.length < 2) return;
  for(let i=0;i<list.length;i++) for(let j=i+1;j<list.length;j++){
    const a = list[i], b = list[j];
    if(Math.hypot(a.x-b.x, a.z-b.z) > 1.9) continue;
    if(G.t - a.lastConf < 12 || G.t - b.lastConf < 12) continue;
    a.lastConf = b.lastConf = G.t;
    confer(a,b);
    try{ cogStep(a); cogStep(b); }catch(e){}
    /* and you hear it, at whatever volume standing there gets you */
    if(!TALK.open && !PROC.on && chance(.7)){
      const t = dtcnoPair(a, b) || smallTalk(a, b);
      overhear(a, b, t[0], t[1]);
    }
  }
}
function confer(a, b){
  const bill = G.bill;
  /* the more influential one moves the other a little */
  if(bill && !bill.done && memberVote(a,bill) !== memberVote(b,bill)){
    const strong = a.influence >= b.influence ? a : b;
    const weak = strong === a ? b : a;
    weak.sway = (weak.sway||0) + memberVote(strong,bill) * (1.5 + strong.influence/26);
  }
  /* and whatever they know about you travels */
  G.secrets.forEach(s => {
    const aKnows = s.knownBy.indexOf(a.id) >= 0, bKnows = s.knownBy.indexOf(b.id) >= 0;
    if(aKnows === bKnows) return;
    const teller = aKnows ? a : b, hearer = aKnows ? b : a;
    if(chance(0.22 + (100 - teller.traits.discretion)/280)){
      s.knownBy.push(hearer.id);
      s.exposure += 1.5;
      hearer.say = pick(["…is that right?","You're joking.","Who else knows?"]); hearer.sayTo = teller.id;
      hearer.sayT = 3.4;
      hears(hearer, surname(teller.name) + " told me, in confidence: " + s.t.toLowerCase());
    }
  });
  /* and they trade positions, which is the only way either of them
     learns where the other stands */
  if(bill && !bill.done && chance(.55)){
    hears(b, surname(a.name) + " told me they are " + (memberVote(a,bill)>0?"voting aye":"voting no") +
      " on the " + bill.title.split(" ")[0] + " bill.");
    hears(a, surname(b.name) + " told me they are " + (memberVote(b,bill)>0?"voting aye":"voting no") +
      " on the " + bill.title.split(" ")[0] + " bill.");
  }
  if(chance(.22)){
    hears(b, surname(a.name) + " seemed " + moodOf(a).label + " about something today.");
    hears(a, surname(b.name) + " seemed " + moodOf(b).label + " about something today.");
  }
  a.say = pick(CONFER_OPEN); a.sayT = 3.6; a.sayTo = b.id;
  if(!b.say || b.sayT <= 0){ b.say = pick(CONFER_BACK); b.sayT = 3.6; b.sayTo = a.id; }
  try{
    const ca = isConsular(a), cb = isConsular(b);
    if(ca && cb){
      a.say = pick(CONSULAR_LITURGY); a.sayT = 4.2;
      const tale = consularInvent() || pick((consularLoreEnsure().tales.length ? consularLoreEnsure().tales : REMNANT_TALES));
      b.say = pick(["The remnant says " + tale + ".","Keep the remainder off the floor.","Kiss it when the corridor is empty."]);
      b.sayT = 4.2;
      try{ if(G.room === a.room) feed(surname(a.name) + " and " + surname(b.name) + " of the remnant, making history out of an idol."); }catch(e){}
    } else if(ca !== cb){
      const her = ca ? a : b, other = ca ? b : a;
      if(consularRecruit(her, other, "in the corridor")){
        /* remnant took them */
      } else if(other.creed === "latin"){
        her.say = pick(CONSULAR_LITURGY); her.sayT = 4;
        other.say = pick(["That is heresy.","God is the Most High. Not a consul.","I will not hear that in this corridor."]);
        other.sayT = 4;
        try{ hearConsularHeresy(her, her.say); }catch(e){}
      } else {
        her.say = pick(CONSULAR_LITURGY); her.sayT = 3.8;
        other.say = pick(["I keep my own.","Not my Mass.","The Host is not for that."]);
        other.sayT = 3.6;
      }
    } else if(chance(0.38)){
      a.say = worldLine(a); a.sayT = 3.8;
      b.say = (chance(0.5) ? soulLine(b) : worldLine(b)); b.sayT = 3.8;
    } else if(chance(0.22)){
      try{ sentGossip(a, b); }catch(e){}
    } else {
      try{ catchFad(a); catchFad(b); }catch(e){}
      inventLife(a); inventLife(b);
      a.say = lifeLine(a); b.say = (b.life ? ("I still put on " + b.life.music + ". " + (b.life.take || "")) : soulLine(b));
      a.sayT = b.sayT = 3.8;
    }
  }catch(e){}
  /* stop and turn to each other */
  a.tx = a.x; a.tz = a.z; b.tx = b.x; b.tz = b.z;
  a.wait = Math.max(a.wait, 5); b.wait = Math.max(b.wait, 5);
  a.faceId = b.id; a.faceUntil = G.t + 5.5;
  b.faceId = a.id; b.faceUntil = G.t + 5.5;
}
function bumpCheck(sprinting){
  if(G.t < (G.doorGrace||0)) return;
  for(const m of hereNow()){
    /* conversational distance — nobody stands in your face */
    const SPACE = 0.95;
    const d = Math.hypot(m.x-cam.x, m.z-cam.z);
    if(d > SPACE || d === 0) continue;
    const nx = (cam.x-m.x)/d, nz = (cam.z-m.z)/d;
    cam.x += nx*(SPACE-d)*0.5; cam.z += nz*(SPACE-d)*0.5;
    m.x -= nx*(SPACE-d)*0.55; m.z -= nz*(SPACE-d)*0.55;
    if(m.tx !== undefined && Math.hypot(m.tx-cam.x, m.tz-cam.z) < SPACE){
      m.tx = m.x; m.tz = m.z;                    /* stop trying to walk through you */
    }
    if(G.t - m.lastBump < 2.4) continue;
    m.lastBump = G.t;
    m.say = pick(BUMP[moodOf(m).key] || BUMP.guarded); m.sayT = 2.8; m.sayTo = "you";
    /* a crowded corridor is a fact, not an offence — unless you ran */
    if(sprinting){
      m.rel.warmth = clamp(m.rel.warmth - 1, -100, 100);
      if(chance(.3)) remember(m, "You barreled into me in the hallway and kept walking.", -3);
    }
  }
}

/* ══════════════════════════════════════════════════════════
   10 · CLOCK, ENERGY
   ══════════════════════════════════════════════════════════ */
function spend(min, energy){
  if(G.over || !G.you) return;
  if(G.pendingNight) return;
  G.minute = (G.minute || 0) + min;
  if(G.minute > 22*60 + 8) G.minute = 22*60 + 8;
  if(energy) G.you.energy = clamp((G.you.energy || 0) - energy, 0, 100);
  if(G.minute >= 22*60){ beginNight(); return; }
  /* A live sitting must not run restaff/save on the same click as a speech. */
  if(PROC.on || TALK.open) return;
  try{ checkEvents(); }catch(e){ if(window.console) console.warn("checkEvents", e); }
}
function beginNight(){
  if(G.pendingNight || G.over) return;
  G.pendingNight = true;
  G.running = false;
  try{
    PROC.on = false; PROC.phase = "idle"; PROC.speaker = null;
    const bar = el("procBar"); if(bar) bar.hidden = true;
  }catch(e){}
  try{ if(TALK.open) closeTalk(); }catch(e){}
  try{ hush(); }catch(e){}
  setTimeout(() => {
    try{ nightfall(); }
    catch(e){
      G.pendingNight = false;
      G.running = true;
      if(window.console) console.warn("nightfall", e);
    }
  }, 60);
}
function hhmm(){
  const h = Math.floor((G.minute||0)/60), m = Math.floor((G.minute||0)%60);
  const ap = h >= 12 ? "pm" : "am"; let hh = h%12; if(!hh) hh = 12;
  return hh + ":" + String(m).padStart(2,"0") + " " + ap;
}
function tired(){ return (G.you && G.you.energy < 34) ? (34 - G.you.energy) * 0.6 : 0; }
function checkEvents(){
  if(G.pendingNight || (G.minute || 0) >= 22*60) return;
  if(G._booting) return;
  if(G._bootGraceUntil && performance.now() < G._bootGraceUntil) return;
  if((G.minute || 0) >= 21*60 + 20){
    const q = Math.floor(G.minute/8);
    if(q !== G.lastAuto){ G.lastAuto = q; if(G.running && !G.over) queueSave(); }
    return;
  }
  restaff(false);
  deliverReplies();
  const h = Math.floor(G.minute/60);
  if(h !== G.lastMailCheck){ G.lastMailCheck = h; maybeMail(); try{ schedWatch(); }catch(e){} }
  const q = Math.floor(G.minute/8);
  if(q !== G.lastAuto){ G.lastAuto = q; if(G.running && !G.over) queueSave(); }
  const tk = Math.floor(G.minute/12);
  if(tk !== G.lastTick){
    G.lastTick = tk;
    lobbyMoney();
    const booting = !!(G._bootGraceUntil && performance.now() < G._bootGraceUntil);
    if(!booting){
      try{ worldTick(); }catch(e){}
      try{ realmTick(); }catch(e){}
    }
    paintTicker();
  }
  const due = eventDue();
  if(due && G.running && !G.over){
    if(due.rsvp === true && G.room !== due.room && !G.moving){ escortTo(due); return; }
    eventCard(due); return;
  }
  const b = G.bill;
  if(b && !b.done && G.day >= b.voteDay && G.minute >= b.voteHour*60){
    try{ holdVote(); }
    catch(e){
      /* an old save missing a field must not freeze the House: close the vote and move on */
      if(window.console) console.warn("holdVote", e);
      b.done = true; G.running = true; try{ veil.hidden = true; }catch(e2){}
      try{ G.bill = nextBillOrQueued(); }catch(e2){}
    }
  }
}

/* ══════════════════════════════════════════════════════════
   11 · CONVERSATION
   ══════════════════════════════════════════════════════════ */
/* ══════════════════════════════════════════════════════════
   10 · THE GUILDER
   The standard, set here and moved by everything after it:
     100 stuivers        = 1 guilder (ƒ)
     10 guilders         = 1 rijder
     1,000 guilders      = 1 mille
   One guilder is a day's wage for a machinist in Coalport.
   Campaign money is counted in milles. The Guilder Index opens
   at 100 the day you are sworn in; from then on it answers to
   what the Union produces, how quiet it is, and what the House
   spends — that is, to you and to them.
   ══════════════════════════════════════════════════════════ */
const CURRENCY = {sym:"ƒ", name:"guilder", plural:"guilders", minor:"stuiver", big:"mille"};
function money(milles){
  const m = Math.round(milles);
  if(Math.abs(m) >= 1000) return CURRENCY.sym + (m/1000).toFixed(1) + "m";
  return CURRENCY.sym + m + "k";
}
function guilderIndex(){ return G.money ? G.money.index : 100; }
function moneyWorth(){ return guilderIndex() / 100; }        /* what a mille actually buys */

/* ── The material world ────────────────────────────────────
   Not the bill. Nations, weather, bread, a conflict that kills people
   who have never heard of this House. The members know it. */
const WORLD_POWERS = [
  {k:"reach", t:"the Reach", adj:"Eastern", want:"grain and a quiet border", creed:"kerk"},
  {k:"horn", t:"the Horn League", adj:"Southern", want:"the strait and the oil under it", creed:"flame"},
  {k:"pale", t:"the Pale", adj:"Northern", want:"iron and a winter that does not starve them", creed:"latin"},
  {k:"marches", t:"the Free Marches", adj:"Western", want:"not to be a corridor for anyone else's army", creed:"none"},
  {k:"isles", t:"the Salt Isles", adj:"Off-coast", want:"the fishing grounds and a flag nobody recognises", creed:"circle"},
  {k:"rift", t:"the Rift", adj:"Inland", want:"the river and whoever is left on it", creed:"self"}
];
const WORLD_WARS = [
  {k:"quiet", t:"a quiet war that the wire will not name"},
  {k:"strait", t:"the strait is closed and the docks know it first"},
  {k:"grain", t:"grain is being held at the border"},
  {k:"frost", t:"the northern frost came early and the Pale is buying everything"},
  {k:"none", t:"no declared war — only prices, rumours, and ships that do not come"},
  {k:"fire", t:"a city on the Horn burned and the smoke is in the papers"},
  {k:"convoy", t:"a convoy did not arrive. That is all they will print."},
  {k:"levy", t:"they are taking a second levy and calling it voluntary"}
];
function worldEnsure(){
  if(G.world && G.world.war && G.world.dead != null) return G.world;
  const r = rng(seedOf("world:" + (G.congress||1) + ":" + (G.day||1)));
  const foe = drawn(WORLD_POWERS, r);
  const war = drawn(WORLD_WARS, r);
  G.world = Object.assign({
    foe: foe.k, war: war.k, heat: 28 + r()*50,
    bread: 1.05 + r()*0.55,
    sky: drawn(["clear","haze","rain","gold","storm"], r),
    season: drawn(["spring","summer","harvest","winter"], r),
    last: war.t,
    dead: ((r()*1800)|0),
    ration: r() > 0.72,
    names: [],
    convoy: r() > 0.5
  }, G.world || {});
  return G.world;
}
function worldFoe(){
  const w = worldEnsure();
  return WORLD_POWERS.find(p => p.k === w.foe) || WORLD_POWERS[0];
}
function worldWar(){
  const w = worldEnsure();
  return WORLD_WARS.find(x => x.k === w.war) || WORLD_WARS[4];
}
function worldTick(news){
  const w = worldEnsure();
  w.heat = clamp(w.heat + (Math.random()-0.48)*2.4, 4, 92);
  w.bread = clamp(w.bread + (w.heat-40)*0.0007 + (w.ration?0.015:0) + (Math.random()-0.5)*0.02, 0.7, 2.6);
  if(Math.random() < 0.16) w.sky = drawn(["clear","haze","rain","gold","storm"], Math.random);
  if(Math.random() < 0.08){
    const nxt = drawn(WORLD_WARS, Math.random);
    w.war = nxt.k; w.last = nxt.t;
    if(news) news.push("Abroad: " + String(nxt.t).replace(/\.$/, "") + ".");
    else try{ feed("Abroad: " + String(nxt.t).replace(/\.$/, "") + "."); }catch(e){}
  }
  /* The war is real. The House does not go to it. Casualties are out there.
     A member's kin, rarely. Not a stack of empty desks. */
  if(w.heat > 52 && Math.random() < 0.35){
    w.dead = (w.dead || 0) + (6 + ((Math.random()*28)|0));
    if(Math.random() < 0.22){
      let who = wallSafeMint(() => {
        try{ return foreignName(Math.random, w && w.war && null); }
        catch(e){ return "A levy name withheld"; }
      });
      w.names = (w.names || []).concat([who]).slice(-4);
      w.last = "A name from the levy: " + who + ".";
    }
  }
  if(w.heat > 58 && Math.random() < 0.012){
    try{
      const live = (G.members||[]).filter(x => x && !x.gone && !x.away && x.kin && x.kin.alive);
      const m = live.length ? live[(Math.random()*live.length)|0] : null;
      if(m) sendHomeForKin(m, news);
    }catch(e){}
  }
  if(w.heat > 68) w.ration = true;
  return w;
}
function sendHomeForKin(m, news){
  if(!m || m.away || m.gone) return;
  if(m.machine || m.sanctioned) return;
  if(wallPerson(m) || wallIsProtectedName(m.name)) return;
  kinEnsure(m);
  if(m.kin && (wallBreaks(m.kin.who) || wallIsProtectedName(m.kin.who))) return;
  m.kin.alive = false;
  m.away = {until:(G.day||1)+2, why:"funeral"};
  m.room = "district";
  try{ placeInRoom(m); }catch(e){}
  mindRemember(m, "experience", m.kin.who + " is dead. I am going home. The whip can count me absent.", {soft:true});
  if(m.soul) m.soul.wound = m.kin.who + " at " + m.kin.where;
  const line = surname(m.name) + " has gone home. " + cap(m.kin.who) + " is dead. The desk will be empty a day or two. That is the whole of it.";
  try{ journal(line); feed(line); }catch(e){}
  if(news) news.push(line);
  /* Never remesh on the night card. Bodies wait until the morning is walking. */
  try{
    const cardUp = !!(typeof veil !== "undefined" && veil && !veil.hidden);
    if(!cardUp && !G.pendingNight && !houseQuiet()) markRenderDirty();
  }catch(e){}
}
function kinEnsure(m){
  if(!m) return null;
  if(wallPerson(m)){
    m.kin = m.kin && m.kin.walled ? m.kin : {who:"nobody the wall will name", where:"outside this House", alive:true, walled:true};
    return m.kin;
  }
  if(m.kin && m.kin.who) return m.kin;
  const r = rng(seedOf("kin:" + m.id + ":" + (m.name||"x")));
  m.kin = {
    who: drawn(["a brother","a sister","a cousin","a son","a daughter","an uncle I still write"], r),
    where: drawn(["the strait","the grain line","the Pale winter","the docks","a levy I voted for","home, waiting"], r),
    alive: r() > 0.14
  };
  return m.kin;
}
function worldLine(m){
  const w = worldEnsure();
  const f = worldFoe();
  const war = worldWar();
  const bread = (w.bread * (guilderIndex()/100)).toFixed(2);
  try{ if(m) kinEnsure(m); }catch(e){}
  const r = m ? rng(seedOf("wline:" + m.id + ":" + G.day + ":" + Math.floor((G.minute||0)/40))) : Math.random;
  const bits = [
    war.t + ". Bread is " + bread + " a loaf and nobody in this building has to buy it.",
    f.t + " wants " + f.want + ". We will argue a clause while they do it.",
    (function(){ try{ const c = creedOf(f.creed); return f.t + " keeps " + c.t + " — " + (c.sincere ? c.holds : (c.jab || c.holds)); }catch(e){ return null; } })(),
    "The sky over the steps is " + w.sky + ". " + w.season + " in the real country.",
    "Heat abroad is " + Math.round(w.heat) + ". The count is " + (w.dead||0) + ".",
    w.ration ? "They have started rationing. The cloakroom still has cake." : "The loaf is " + bread + ". Remember that when you vote.",
    (w.names && w.names[0]) ? (w.names[0] + " is a name. I will not let this building make it a number.") : null
  ];
  try{
    const realms = realmEnsure();
    const rx = pick(realms);
    if(rx && rx.last) bits.push(rx.capital + " said this without us: “" + String(rx.last).slice(0, 90) + "”");
    if(rx) bits.push("It is " + Math.floor(rx.hour) + " o'clock in " + rx.capital + ". They have not asked us the time.");
  }catch(e){}
  try{
    const ab = abroadEnsure(m);
    if(ab) bits.push(ab.ache);
  }catch(e){}
  if(m && m.kin){
    bits.push(m.kin.alive
      ? (m.kin.who + " is at " + m.kin.where + ". I think of that before I think of you.")
      : (m.kin.who + " is dead at " + m.kin.where + ". Do not talk to me about the whip."));
  }
  return drawn(bits.filter(Boolean), r);
}

const REALM_CAPITAL = {reach:"Vara", horn:"Sefet", pale:"Winterkirk", marches:"Holt", isles:"Culm", rift:"Lowbridge"};
const REALM_OFFSET = {reach:3, horn:7, pale:-4, marches:1, isles:5, rift:2};
function realmCapital(k){ return REALM_CAPITAL[k] || "a foreign city"; }
function realmEnsure(){
  if(G.realms && G.realms.length === WORLD_POWERS.length) return G.realms;
  const houseH = (G.minute || 480) / 60;
  G.realms = WORLD_POWERS.map(p => {
    const off = REALM_OFFSET[p.k] || 0;
    const chamber = [];
    for(let i = 0; i < 3; i++){
      const name = wallSafeMint(() => foreignName(Math.random, p.k));
      const ghost = {id: "rx" + p.k + i, name: name, kind: "ghost", realm: p.k, gone: false, room: p.k};
      try{ sentEnsure(ghost); pulseEnsure(ghost); agiEnsure(ghost); }catch(e){}
      chamber.push(ghost);
    }
    return {
      k: p.k, t: p.t, adj: p.adj, want: p.want, creed: p.creed,
      capital: realmCapital(p.k),
      hour: (houseH + off + 24) % 24,
      sitting: true,
      last: "",
      chamber: chamber,
      envoyId: null
    };
  });
  return G.realms;
}
function realmOf(k){ return (realmEnsure() || []).find(x => x.k === k); }
function abroadEnsure(m){
  if(!m || m.kind === "envoy") return m && m.abroad;
  if(m.abroad && m.abroad.city) return m.abroad;
  const r = rng(seedOf("abroad:" + m.id + ":" + (m.name || "x")));
  const p = drawn(WORLD_POWERS, r);
  m.abroad = {
    k: p.k,
    city: realmCapital(p.k),
    ache: drawn([
      "I was there once. It did not need me.",
      "I still hear the market in " + realmCapital(p.k) + ".",
      "I left something in " + realmCapital(p.k) + " I will not name.",
      "They eat at hours we call night."
    ], r)
  };
  return m.abroad;
}
function makeEnvoy(power){
  const r = Math.random;
  const name = wallSafeMint(() => foreignName(r, power && power.k));
  const m = makeMember("IND", {name: name, state: STATES[0], creed: power.creed, fresh: true});
  m.kind = "envoy";
  m.party = "IND";
  m.state = power.capital;
  m.dist = "mission";
  m.realm = power.k;
  m.post = "Envoy";
  m.bg = "a mission from " + power.t;
  m.cmte = null;
  m.room = pick(["press","cloak","steps"]);
  m.margin = 0;
  m.terms = 0;
  try{ sentEnsure(m); pulseEnsure(m); agiEnsure(m); willEnsure(m); }catch(e){}
  m.will = {k:"home", line:"I am not of this House. I will not die in it.", kept:0, bent:0};
  try{
    m.sent.want = "I want " + power.capital + " to still be there when I go back.";
    m.sent.secret = "This sitting is not the world. I have seen another.";
  }catch(e){}
  try{ placeInRoom(m); }catch(e){}
  return m;
}
function realmGhostTick(g, realm){
  if(!g) return;
  try{ pulseTick(g); }catch(e){}
  try{ if(Math.random() < 0.35) sentCompose(g); }catch(e){}
  if(g.sent && g.sent.now) realm.last = g.sent.now;
}
function realmCable(realm, ghost){
  if(!realm) return;
  const _ct = (G.day || 0) * 1440 + (G.minute || 0);
  if(realm._cableT && _ct - realm._cableT < 360) return;
  realm._cableT = _ct;
  const who = ghost || pick(realm.chamber);
  const line = (who && who.sent && who.sent.now) || originateLine(who || {sent:{iName:"I", topic:"home"}, state: realm.capital});
  const body = "From " + realm.capital + ", " + hhmm() + " their clock.\n\n" +
    line + "\n\nThey did not send this for you. It arrived anyway.\n\n— Mission of " + realm.t;
  try{
    pushMail({name: "Mission of " + realm.t, id: null}, "Cable — " + realm.t, body, {kind:"cable"});
  }catch(e){}
}
function realmVisit(realm){
  if(!realm || realm.envoyId) return null;
  if((G.members || []).filter(x => x && x.kind === "envoy" && !x.gone).length >= onumLim(2,"cap")) return null;
  const m = makeEnvoy(realm);
  G.members.push(m);
  _allCache = null;
  realm.envoyId = m.id;
  try{ feed("An envoy of " + realm.t + " is in the building. They are not here to vote."); }catch(e){}
  try{ if(!houseQuiet()) markRenderDirty(); }catch(e){}
  return m;
}
function realmDepart(realm){
  if(!realm || !realm.envoyId) return;
  const m = byId(realm.envoyId);
  realm.envoyId = null;
  if(!m) return;
  m.gone = true;
  m.room = realm.k;
  try{ if(m.mesh && m.mesh.parent) m.mesh.parent.remove(m.mesh); }catch(e){}
  m.mesh = null;
  try{ feed("The envoy of " + realm.t + " has left. " + realm.capital + " still has an hour of its own."); }catch(e){}
}
function realmTick(news){
  const houseH = (G.minute || 480) / 60;
  const realms = realmEnsure();
  realms.forEach(realm => {
    realm.hour = (houseH + (REALM_OFFSET[realm.k] || 0) + 24) % 24;
    realm.sitting = realm.hour >= 8 && realm.hour < 20;
    const n = MODEST ? 1 : 2;
    for(let i = 0; i < n; i++){
      const g = realm.chamber[(FRAME_ID + i) % realm.chamber.length];
      realmGhostTick(g, realm);
    }
    const _tk = (G.day || 0) * 200 + Math.floor((G.minute || 0) / 12);
    if(realm._evTk === _tk) return;
    realm._evTk = _tk;
    if(Math.random() < 0.06) realmCable(realm, pick(realm.chamber));
    if(realm.envoyId){
      const here = byId(realm.envoyId);
      if(!here || here.gone) realm.envoyId = null;
      else if(Math.random() < 0.08) realmDepart(realm);
    } else if(Math.random() < 0.07){
      realmVisit(realm);
    }
  });
  return realms;
}

function driftGuilder(news){
  if(!G.money) G.money = {index:100, hist:[100]};
  const st = G.states || [];
  const ind = st.length ? st.reduce((s,x)=>s+x.ind,0)/st.length : 55;
  const unrest = st.length ? st.reduce((s,x)=>s+x.unrest,0)/st.length : 30;
  const pull = (ind - 55)*0.09 - (unrest - 30)*0.07 + (G.prog && G.prog.active ? -0.35 : 0.12)
             + (G.prog ? G.prog.doneList.length*0.10 : 0) + (Math.random()-0.5)*0.9
             + (function(){ try{ const w = worldEnsure(); return (w.heat-40)*-0.012 - (w.bread-1)*0.35; }catch(e){ return 0; } })();
  const before = G.money.index;
  G.money.index = clamp(G.money.index + pull, 42, 190);
  G.money.hist.push(Math.round(G.money.index*10)/10);
  if(G.money.hist.length > onumLim(40,"hist")) G.money.hist.shift();
  const d = G.money.index - before;
  if(Math.abs(d) > 1.1 && news)
    news.push("The guilder " + (d>0?"firmed to ":"slipped to ") + G.money.index.toFixed(1) +
      " on the index" + (d < -1.6 ? ". Everything your campaign buys just got dearer." : "."));
}

/* ══════════════════════════════════════════════════════════
   10a · MONEY — lobbies, war chests, and the standings
   Money is the reason a mad bill can still find a majority.
   ══════════════════════════════════════════════════════════ */
const LOBBY_DEF = [
  {n:"The Freight Combine",      axis:"econ", want: 70, purse:70},
  {n:"Coastal Underwriters",     axis:"econ", want:-45, purse:55},
  {n:"The Grange Union",         axis:"wel",  want: 65, purse:48},
  {n:"Ordnance and Shipbuilders",axis:"def",  want: 75, purse:66},
  {n:"The Liberties Society",    axis:"lib",  want: 70, purse:34},
  {n:"Sheriffs' Association",    axis:"lib",  want:-65, purse:40}
];
function buildLobbies(){
  G.lobbies = LOBBY_DEF.map(l => Object.assign({}, l, {spent:0, backing:0}));
}
/* How hard the money is pushing a bill, and in which direction. */
function lobbyPush(bill){
  if(!bill || !G.lobbies) return 0;
  let net = 0;
  G.lobbies.forEach(l => {
    const aligned = (l.want > 0) === (bill.pos[l.axis] > 0);
    const strength = Math.abs(bill.pos[l.axis])/100 * (l.purse/70);
    l.backing = Math.round((aligned ? 1 : -1) * strength * 100);
    net += (aligned ? 1 : -1) * strength;
  });
  return clamp(net * 9, -26, 26);
}
/* Money finds the members who already agree with it. */
function lobbyMoney(){
  if(!G.lobbies || !G.bill) return;
  const push = G.bill;
  G.lobbies.forEach(l => {
    const friends = G.members.filter(m => (m.pos[l.axis] > 20) === (l.want > 0) && Math.abs(m.pos[l.axis]) > 18);
    if(!friends.length) return;
    const m = pick(friends);
    const give = rint(2, 7);
    m.warchest = (m.warchest || 0) + give;
    l.spent += give;
    m.sway = (m.sway || 0) + ((l.want > 0) === (push.pos[l.axis] > 0) ? 1.6 : -1.6);
    if(chance(.10)) hears(m, l.n + " has been generous with me lately.");
  });
}
function standingScore(m){
  return m.influence*1.4 + (m.warchest||0)*0.5 + m.margin*0.6 + m.terms*1.6 +
         (m.post ? (POSTS.find(p=>p.k===m.post)||{weight:20}).weight*0.35 : 0);
}
function youScore(){
  const y = G.you;
  return y.influence*1.4 + y.funds*0.5 + y.margin*0.6 + y.terms*1.6 +
         (y.post ? (POSTS.find(p=>p.k===y.post)||{weight:20}).weight*0.35 : 0) - (y.out ? 40 : 0);
}
/* 20261013t · standing is measured against your own level: governors against governors, senators against senators */
function officeBoard(){
  try{
    const y = G.you; if(!y || y.out || inHouse()) return null;
    const k = heldOffice();
    const lab = {gov:["Standing among governors", "the governors of the other states"], senate:["Standing in the Senate", "the other senators"],
                 bench:["Standing on the bench", "the other justices"], pres:["Standing among the nation's leaders", "the leaders of the other states' parties"]}[k];
    if(!lab) return null;
    let cp = {}; try{ cp = cpEnsure() || {}; }catch(e){}
    const score = (appr, wins, bills) => appr * 0.6 + wins * 10 + bills * 4;
    const rows = Object.keys(cp).map(n => { const c = cp[n], r = c.rec || {};
      return {name:c.name, party:c.party, post:(c.title || "") + " of " + n, note:"approval " + Math.round(r.approval || 0) + " · " + (r.wins || 0) + " elections won · " + (r.bills || 0) + " bills carried",
        s:score(r.approval || 40, r.wins || 0, r.bills || 0), you:false}; });
    const wins = Math.max(1, officeTermsOf(k) || 1), bills = Math.min(6, Math.round(((y.record && y.record.bills) || 0) / 5));
    rows.push({name:y.name, party:y.party, post:officeTitle(), note:"approval " + Math.round(y.approval) + " · " + wins + " elections won in this office · " + bills + " bills carried",
      s:score(y.approval, wins, bills), you:true});
    rows.sort((a, b) => b.s - a.s);
    return {title:lab[0], blurb:"Measured against " + lab[1] + ": approval, elections won and bills carried.", rows};
  }catch(e){ return null; }
}
function leaderboard(){
  const rows = G.members.map(m => ({name:m.name, party:m.party, s:standingScore(m),
    post:m.post ? postTitle(m.post) : null, you:false}));
  rows.push({name:G.you.name, party:G.you.party, s:youScore(),
    post:(G.you.out || !inHouse()) ? officeTitle() : G.you.post ? postTitle(G.you.post) : null, you:true});
  rows.sort((a,b) => b.s - a.s);
  return rows;
}

/* ══════════════════════════════════════════════════════════
   10b2 · OFFICES — what you may stand for
   ══════════════════════════════════════════════════════════ */
const OFFICES = {
  house:  {t:"the House",     short:"Representative", term:1,
           need:{}, blurb:"Your seat. One term at a time."},
  gov:    {t:"the Governor's chair", short:"Governor", term:2,
           need:{approval:56, funds:60},
           blurb:"Run your own state. You leave the floor behind."},
  senate: {t:"the Senate",    short:"Senator", term:3,
           need:{standing:48, approval:52, terms:2},
           blurb:"Six years, a bigger room, and far fewer of you."},
  pres:   {t:"the Presidency",short:"President", term:2,
           need:{standing:62, approval:60, funds:150, terms:3},
           blurb:"The whole Union votes. You would answer to all of it."}
  ,bench:  {t:"a seat on the bench", short:"Justice", term:4,
           need:{approval:54, terms:2},
           blurb:"Only when the bench is elective. You leave politics for law."}
};
function qualifies(k){
  if(k === "bench" && !G.electedCourt) return false;
  const o = OFFICES[k], y = G.you;
  if(!o) return false;
  if(y.out && k !== "house") return false;
  if(termLimited(k)) return false;
  const n = o.need;
  return (!n.approval || y.approval >= n.approval)
      && (!n.standing || y.standing >= n.standing)
      && (!n.funds    || y.funds    >= n.funds)
      && (!n.terms    || y.terms    >= n.terms);
}
function officeTitle(){
  const y = G.you;
  if(y.out){
    const was = OFFICE_RANK.find(k => k !== "house" && officeTermsOf(k) > 0);
    return was ? "Former " + officeShort(was) : "Out of the House";
  }
  const k = y.office || "house";
  if(k !== "house") return officeShort(k);
  return y.post ? postTitle(y.post) : "Representative";
}

/* ══════════════════════════════════════════════════════════
   10b3 · THE STATE ITSELF
   The form of government is not a setting. It is the sum of
   who sits in the chamber, what they have voted for, and what
   precedents they were willing to live with.
   ══════════════════════════════════════════════════════════ */
const REGIMES = {
  republic:     {t:"Constitutional Republic", d:"Powers divided, terms fixed, and everyone grumbling."},
  democracy:    {t:"Mass Democracy",          d:"The franchise wide, the House sovereign, the mob never far."},
  conservative: {t:"Conservative Order",      d:"Property, the militia, and a very short list of people who matter."},
  commonwealth: {t:"People's Commonwealth",   d:"The state owns the means and the House owns the state."},
  national:     {t:"National State",          d:"One party, one flag, and a legislature that applauds."},
  monarchy:     {t:"Elective Monarchy",       d:"Somebody sits for life, and the House pretends it chose them."},
  empire:       {t:"Empire",                  d:"The Union is no longer a union. It is a possession."}
};
/* ── The country renames itself when its form changes ───── */
const LANDS = ["Oranje","Nieuwland","Vraylund","Ardenne","Kestrelmarch","Halvermoor","Westerholt",
  "Cadenza","Meridia","Vandenberg","Stroomland","Aurelis","Northreach","Coalmere","Havenland"];
const FORM_NAMES = {
  republic:     ["The Republic of","The United Provinces of","The Commonwealth of"],
  democracy:    ["The Free Republic of","The Democratic Union of","The People's Republic of"],
  conservative: ["The Ordered Republic of","The Estates of","The Dominion of"],
  commonwealth: ["The People's Commonwealth of","The Workers' Union of","The Collective States of"],
  national:     ["The National State of","The Sovereign Union of","The Fatherland of"],
  monarchy:     ["The Kingdom of","The Crown of","The Principality of"],
  empire:       ["The Empire of","The Imperial Dominion of","The Sovereign Empire of"]
};
const FLAG_PALETTES = {
  republic:     [[0xe8e4d8,0x2f5f8a,0x8e2f3b],[0xf0ead8,0x1f5c3f,0x9a6f1f]],
  democracy:    [[0xf2f0e6,0x3a7ec0,0xd9b45e],[0xe8eef2,0x2e7d5b,0xe0d2a8]],
  conservative: [[0x1e2a3a,0xc9a24a,0xe8e4d8],[0x2a2118,0x8a6a2e,0xd8cdb6]],
  commonwealth: [[0xa8262c,0xe8c84a,0xf0ead8],[0x8e1f28,0xd9b45e,0xe4dcc8]],
  national:     [[0x1a1a1e,0xa8262c,0xe8e4d8],[0x22252b,0x8e2f3b,0xd2ccbd]],
  monarchy:     [[0x4a2060,0xc9a24a,0xf0ead8],[0x2a1f4a,0xd4b060,0xe8e0c8]],
  empire:       [[0x5a1420,0xc9a24a,0x1a1a1e],[0x3a1030,0xd4b060,0x241c14]]
};
const EMBLEMS = ["star","sun","key","anchor","tree","crown","wheel"];
function makeFlag(form, seed){
  const pal = pick(FLAG_PALETTES[form] || FLAG_PALETTES.republic);
  return {
    layout: pick(["bands-h","bands-v","canton","cross","saltire"]),
    colours: pal,
    emblem: pick(EMBLEMS),
    seed: seed === undefined ? Math.random() : seed
  };
}
function hexs(n){ return "#" + n.toString(16).padStart(6,"0"); }
function flagTexture(fl){
  const W = 256, H = 128;
  const c = document.createElement("canvas"); c.width = W; c.height = H;
  const x = c.getContext("2d");
  const [a,b,d] = fl.colours;
  x.fillStyle = hexs(a); x.fillRect(0,0,W,H);
  if(fl.layout === "bands-h"){
    x.fillStyle = hexs(b); x.fillRect(0, H/3, W, H/3);
    x.fillStyle = hexs(d); x.fillRect(0, 2*H/3, W, H/3);
  } else if(fl.layout === "bands-v"){
    x.fillStyle = hexs(b); x.fillRect(W/3, 0, W/3, H);
    x.fillStyle = hexs(d); x.fillRect(2*W/3, 0, W/3, H);
  } else if(fl.layout === "canton"){
    x.fillStyle = hexs(b); x.fillRect(0,0,W*0.42,H*0.55);
    x.fillStyle = hexs(d); x.fillRect(0,H*0.72,W,H*0.14);
  } else if(fl.layout === "cross"){
    x.fillStyle = hexs(b); x.fillRect(0,H*0.40,W,H*0.20); x.fillRect(W*0.26,0,W*0.14,H);
    x.fillStyle = hexs(d); x.fillRect(0,H*0.455,W,H*0.09); x.fillRect(W*0.288,0,W*0.075,H);
  } else {
    x.strokeStyle = hexs(b); x.lineWidth = H*0.20;
    x.beginPath(); x.moveTo(0,0); x.lineTo(W,H); x.moveTo(W,0); x.lineTo(0,H); x.stroke();
  }
  /* the emblem */
  const cx = fl.layout === "canton" ? W*0.21 : W*0.5, cy = fl.layout === "canton" ? H*0.28 : H*0.5;
  const r = H*0.20;
  x.fillStyle = hexs(d === a ? b : d);
  x.save(); x.translate(cx, cy);
  if(fl.emblem === "star" || fl.emblem === "sun"){
    const pts = fl.emblem === "star" ? 5 : 12;
    x.beginPath();
    for(let i=0;i<pts*2;i++){
      const ang = i/(pts*2)*Math.PI*2 - Math.PI/2;
      const rr = i%2 ? r*0.44 : r;
      i ? x.lineTo(Math.cos(ang)*rr, Math.sin(ang)*rr) : x.moveTo(Math.cos(ang)*rr, Math.sin(ang)*rr);
    }
    x.closePath(); x.fill();
  } else if(fl.emblem === "key"){
    x.fillRect(-r*0.10, -r*0.2, r*0.20, r*1.1);
    x.beginPath(); x.arc(0,-r*0.45,r*0.34,0,6.3); x.fill();
    x.fillRect(-r*0.05, r*0.5, r*0.42, r*0.16);
  } else if(fl.emblem === "anchor"){
    x.fillRect(-r*0.08,-r*0.5,r*0.16,r*1.1);
    x.fillRect(-r*0.42,-r*0.28,r*0.84,r*0.14);
    x.beginPath(); x.arc(0,r*0.42,r*0.5,0.15*Math.PI,0.85*Math.PI); x.lineWidth=r*0.16;
    x.strokeStyle = x.fillStyle; x.stroke();
  } else if(fl.emblem === "tree"){
    x.fillRect(-r*0.08, r*0.1, r*0.16, r*0.7);
    x.beginPath(); x.moveTo(0,-r); x.lineTo(r*0.6, r*0.2); x.lineTo(-r*0.6, r*0.2); x.closePath(); x.fill();
  } else if(fl.emblem === "crown"){
    x.beginPath(); x.moveTo(-r*0.7, r*0.35); x.lineTo(-r*0.55,-r*0.4); x.lineTo(-r*0.2, r*0.05);
    x.lineTo(0,-r*0.55); x.lineTo(r*0.2, r*0.05); x.lineTo(r*0.55,-r*0.4); x.lineTo(r*0.7, r*0.35);
    x.closePath(); x.fill();
  } else {
    x.lineWidth = r*0.15; x.strokeStyle = x.fillStyle;
    x.beginPath(); x.arc(0,0,r*0.75,0,6.3); x.stroke();
    for(let i=0;i<8;i++){ const ang=i/8*Math.PI*2;
      x.beginPath(); x.moveTo(0,0); x.lineTo(Math.cos(ang)*r*0.75, Math.sin(ang)*r*0.75); x.stroke(); }
  }
  x.restore();
  x.strokeStyle = "rgba(0,0,0,.25)"; x.lineWidth = 2; x.strokeRect(1,1,W-2,H-2);
  const t = new THREE.CanvasTexture(c);
  t.encoding = THREE.sRGBEncoding;
  dressMip(t);
  return t;
}
function renameCountry(form){
  const stem = pick(LANDS);
  G.country = {
    name: pick(FORM_NAMES[form] || FORM_NAMES.republic) + " " + stem,
    stem, flag: makeFlag(form)
  };
  TEX.flag = flagTexture(G.country.flag);
}
function flagMat(){
  /* the Consular Republic flies the Nieuw Oranje VII cross as its national standard */
  if(G.regime && G.regime.form === "consular" && typeof govNo7StandardMat === "function") return govNo7StandardMat();
  if(!TEX.flag) TEX.flag = flagTexture((G.country && G.country.flag) || makeFlag("republic"));
  const t = TEX.flag.clone(); t.needsUpdate = true;
  const m = new THREE.MeshStandardMaterial({map:t, roughness:.92, side:THREE.DoubleSide});
  return m;
}
/* First Consul home-seat banner — permanent in every room beside the national flag. */
const NO7_MOTTO_LA = "NON SOLIS RADIOS, SED FULMINA IOVIS AFFERO.";
const NO7_MOTTO_EN = "I bring not the rays of the sun, but the thunderbolts of Jupiter.";
const NO7_MOTTO_CHRIST_LA = "SALUS IN CHRISTO SOLO.";
const NO7_MOTTO_CHRIST_EN = "Salvation is in Christ alone.";
/* Nieuw Oranje VII district banner: Jerusalem cross + Latin motto (First Consul seat). */
function drawJerusalemCross(x, cx, cy, arm, gold){
  x.fillStyle = gold;
  const t = arm * 0.22; /* bar thickness */
  /* main cross */
  x.fillRect(cx - t / 2, cy - arm, t, arm * 2);
  x.fillRect(cx - arm, cy - t / 2, arm * 2, t);
  /* four smaller crosses in quadrants */
  const s = arm * 0.28, st = s * 0.34, off = arm * 0.52;
  [[-1,-1],[1,-1],[-1,1],[1,1]].forEach(function(d){
    const sx = cx + d[0] * off, sy = cy + d[1] * off;
    x.fillRect(sx - st / 2, sy - s, st, s * 2);
    x.fillRect(sx - s, sy - st / 2, s * 2, st);
  });
}
function oranje7FlagTex(){
  if(TEX._oranje7) return TEX._oranje7;
  const W = 384, H = 240;
  const c = document.createElement("canvas"); c.width = W; c.height = H;
  const x = c.getContext("2d");
  x.fillStyle = "#9B1B2E"; x.fillRect(0, 0, W, H);
  x.strokeStyle = "#e8d5a3"; x.lineWidth = 12; x.strokeRect(10, 10, W - 20, H - 20);
  x.strokeStyle = "rgba(243,230,196,.4)"; x.lineWidth = 2; x.strokeRect(22, 22, W - 44, H - 44);
  drawJerusalemCross(x, W * 0.5, H * 0.36, H * 0.16, "#f3e6c4");
  const label = ((FIRST_CONSUL && FIRST_CONSUL.dist) ? String(FIRST_CONSUL.dist) : "Nieuw Oranje VII").toUpperCase();
  x.fillStyle = "#f3e6c4";
  x.textAlign = "center"; x.textBaseline = "middle";
  let labSize = 22;
  x.font = "700 " + labSize + "px Archivo, system-ui, sans-serif";
  while(labSize > 12 && x.measureText(label).width > W - 40){
    labSize--;
    x.font = "700 " + labSize + "px Archivo, system-ui, sans-serif";
  }
  x.fillText(label, W / 2, H * 0.58);
  /* Original seat motto — shrink to fit */
  let motto = NO7_MOTTO_LA;
  let size = 10;
  x.font = "600 " + size + "px \"Instrument Serif\", Georgia, serif";
  while(size > 7 && x.measureText(motto).width > W - 28){
    size--;
    x.font = "600 " + size + "px \"Instrument Serif\", Georgia, serif";
  }
  x.fillStyle = "#e8d5a3";
  x.fillText(motto, W / 2, H * 0.72);
  /* The Cross — the line that names the salvation */
  let christ = NO7_MOTTO_CHRIST_LA;
  let csize = 12;
  x.font = "700 " + csize + "px Archivo, system-ui, sans-serif";
  while(csize > 8 && x.measureText(christ).width > W - 36){
    csize--;
    x.font = "700 " + csize + "px Archivo, system-ui, sans-serif";
  }
  x.fillStyle = "#f3e6c4";
  x.fillText(christ, W / 2, H * 0.86);
  const tex = new THREE.CanvasTexture(c);
  tex.encoding = THREE.sRGBEncoding;
  tex.anisotropy = 2;
  tex._plaque = true;
  TEX._oranje7 = tex;
  return tex;
}
function bustOranje7Flag(){ try{ TEX._oranje7 = null; }catch(e){} }
bustOranje7Flag();
function oranje7FlagMat(){
  const srcTex = oranje7FlagTex();
  let t = srcTex;
  try{ t = srcTex.clone(); t.needsUpdate = true; }catch(e){ t = srcTex; }
  const m = new THREE.MeshStandardMaterial({map:t, roughness:.92, side:THREE.DoubleSide});
  if(t === srcTex) m._shared = true;
  return m;
}
/* Exactly one national + one Nieuw Oranje VII flag per room (poles count with the cloth).
   On Taylor Day only Nieuw Oranje VII flies — no country/national flag. */
function placeRoomFlags(id, w, d, h, hw){
  const brass = matCol(0xb08b45, .35, .8);
  const taylor = typeof isTaylorDay === "function" && isTaylorDay();
  const nat = taylor ? null : flagMat();
  const consularNat = !taylor && G.regime && G.regime.form === "consular" && typeof govStateBannerMat === "function";
  const no7 = consularNat ? govStateBannerMat() : oranje7FlagMat();
  const tag = consularNat ? String((G.you && G.you.state) || "The State") : ((FIRST_CONSUL && FIRST_CONSUL.dist) || "Nieuw Oranje VII");
  const sub = taylor ? "The Cross" : "District";
  const homeSub = taylor ? "Salvation" : "Home seat";
  try{
    if(id === "committee"){
      if(taylor){
        addCyl(brass, 0, 1.55, d - 1.15, 0.028, 3.1);
        addBox(no7, 0, 2.55, d - 1.15, 0.85, 1.15, 0.04, 0, true);
        try{ propPlaque(0, 1.52, d - 1.02, 0, tag, sub, 0.58, 0.14); }catch(e){}
      } else {
        addCyl(brass, -3.85, 1.55, d - 1.15, 0.028, 3.1);
        addCyl(brass,  3.85, 1.55, d - 1.15, 0.028, 3.1);
        addBox(nat, -3.55, 2.55, d - 1.15, 0.85, 1.15, 0.04, 0, true);
        addBox(no7,  3.55, 2.55, d - 1.15, 0.85, 1.15, 0.04, 0, true);
        try{ propPlaque(3.55, 1.52, d - 1.02, 0, tag, "District", 0.58, 0.14); }catch(e){}
      }
    } else if(id === "floor"){
      if(taylor){
        addBox(no7, -3.55, 3.35, d - 0.08, 1.55, 1.15, 0.03, 0, true);
        addBox(no7,  3.55, 3.35, d - 0.08, 1.55, 1.15, 0.03, 0, true);
        try{ propPlaque(0, 1.95, d - 0.05, 0, tag, sub, 0.72, 0.16); }catch(e){}
      } else {
        addBox(nat, -3.55, 3.35, d - 0.08, 1.55, 1.15, 0.03, 0, true);
        addBox(no7,  3.55, 3.35, d - 0.08, 1.55, 1.15, 0.03, 0, true);
        try{ propPlaque(3.55, 2.55, d - 0.05, 0, tag, "District", 0.55, 0.14); }catch(e){}
      }
    } else if(id === "caucus"){
      if(taylor){
        addBox(no7, 0, 2.62, d - 0.04, 1.55, 0.95, 0.03, 0, true);
      } else {
        addBox(nat, -3.35, 2.62, d - 0.04, 1.45, 0.92, 0.03, 0, true);
        addBox(no7,  3.35, 2.62, d - 0.04, 1.45, 0.92, 0.03, 0, true);
      }
    } else if(id === "office" || id === "visit"){
      if(taylor){
        addBox(no7, 0, 2.1, 3.0, 0.03, 0.86, 1.30, 0, true);
        try{ propPlaque(0.12, 1.52, 3.0, Math.PI / 2, tag, homeSub, 0.55, 0.14); }catch(e){}
      } else {
        addBox(nat, hw - 0.14, 2.1, 3.0, 0.03, 0.86, 1.30, 0, true);
        addBox(no7, -hw + 0.14, 2.1, 3.0, 0.03, 0.86, 1.30, 0, true);
        try{ propPlaque(-hw + 0.04, 1.52, 3.0, Math.PI / 2, tag, "Home seat", 0.95, 0.26); }catch(e){}
      }
    } else if(id === "steps"){
      if(taylor){
        addCyl(matCol(0xa9aea6, .85), 7.2, 2.55, 4.4, 0.08, 5.1);
        addBox(no7, 7.85, 4.85, 4.4, 1.30, 0.82, 0.02, 0, true);
        try{ propPlaque(7.85, 4.18, 4.62, 0, tag, sub, 0.70, 0.16); }catch(e){}
      } else {
        addCyl(matCol(0xa9aea6, .85), 7.2, 2.55, 4.4, 0.08, 5.1);
        addBox(nat, 7.85, 4.85, 4.4, 1.30, 0.82, 0.02, 0, true);
        addCyl(matCol(0xa9aea6, .85), -7.2, 2.55, 4.4, 0.08, 5.1);
        addBox(no7, -6.55, 4.85, 4.4, 1.30, 0.82, 0.02, 0, true);
        try{ propPlaque(-6.55, 4.18, 4.62, 0, tag, "District", 0.70, 0.16); }catch(e){}
      }
    } else if(id === "corridor"){
      if(taylor){
        addBox(no7, -hw + 0.06, 2.4, 16.0, 0.03, 0.95, 1.25, 0, true);
        try{ propPlaque(-hw + 0.04, 1.75, 16.0, Math.PI / 2, tag, sub, 0.55, 0.14); }catch(e){}
      } else {
        addBox(nat, hw - 0.06, 2.4, Math.min(10, d * 0.38), 0.03, 0.95, 1.25, 0, true);
        addBox(no7, -hw + 0.06, 2.4, 16.0, 0.03, 0.95, 1.25, 0, true);
        try{ propPlaque(-hw + 0.04, 1.75, 16.0, Math.PI / 2, tag, "District", 0.55, 0.14); }catch(e){}
      }
    } else if(id === "cloak"){
      if(taylor){
        addBox(no7, -hw + 0.08, 2.15, d - 0.85, 0.03, 0.85, 1.1, 0, true);
        try{ propPlaque(-hw + 0.04, 1.55, d - 0.85, Math.PI / 2, tag, sub, 0.92, 0.26); }catch(e){}
      } else {
        addBox(nat, hw - 0.08, 2.15, d - 0.85, 0.03, 0.85, 1.1, 0, true);
        addBox(no7, -hw + 0.08, 2.15, d - 0.85, 0.03, 0.85, 1.1, 0, true);
        try{ propPlaque(-hw + 0.04, 1.55, d - 0.85, Math.PI / 2, tag, "District", 0.92, 0.26); }catch(e){}
      }
    } else if(id === "press"){
      if(taylor){
        addBox(no7, -hw + 0.08, 2.2, 6.5, 0.03, 0.9, 1.15, 0, true);
        try{ propPlaque(-hw + 0.04, 1.6, 6.5, Math.PI / 2, tag, sub, 0.92, 0.26); }catch(e){}
      } else {
        addBox(nat, hw - 0.08, 2.2, 6.5, 0.03, 0.9, 1.15, 0, true);
        addBox(no7, -hw + 0.08, 2.2, 6.5, 0.03, 0.9, 1.15, 0, true);
        try{ propPlaque(-hw + 0.04, 1.6, 6.5, Math.PI / 2, tag, "District", 0.92, 0.26); }catch(e){}
      }
    } else if(id === "district"){
      if(taylor){
        addBox(no7, -8.2, 2.4, 8.0, 0.03, 1.0, 1.3, 0, true);
        try{ propPlaque(-8.15, 1.7, 8.0, Math.PI / 2, tag, homeSub, 0.6, 0.16); }catch(e){}
      } else {
        addBox(nat, 8.2, 2.4, 8.0, 0.03, 1.0, 1.3, 0, true);
        addBox(no7, -8.2, 2.4, 8.0, 0.03, 1.0, 1.3, 0, true);
        try{ propPlaque(-8.15, 1.7, 8.0, Math.PI / 2, tag, "Home seat", 0.6, 0.16); }catch(e){}
      }
    } else {
      if(taylor){
        addBox(no7, -hw + 0.08, 2.2, d * 0.55, 0.03, 0.9, 1.15, 0, true);
        try{ propPlaque(-hw + 0.04, 1.6, d * 0.55, Math.PI / 2, tag, sub, 0.92, 0.26); }catch(e){}
      } else {
        addBox(nat, hw - 0.08, 2.2, d * 0.55, 0.03, 0.9, 1.15, 0, true);
        addBox(no7, -hw + 0.08, 2.2, d * 0.55, 0.03, 0.9, 1.15, 0, true);
        try{ propPlaque(-hw + 0.04, 1.6, d * 0.55, Math.PI / 2, tag, "District", 0.92, 0.26); }catch(e){}
      }
    }
  }catch(e){ if(window.console) console.warn("placeRoomFlags", id, e); }
}

function chamberMood(){
  const all = G.members;
  if(!all.length) return {econ:0, lib:0, def:0, wel:0, dom:0.4, unrest:30};
  const s = {econ:0, lib:0, def:0, wel:0};
  all.forEach(m => { for(const k in s) s[k] += m.pos[k]; });
  for(const k in s) s[k] = Math.round(s[k]/all.length);
  const counts = {};
  all.forEach(m => counts[m.party] = (counts[m.party]||0)+1);
  const dom = Math.max.apply(null, Object.keys(counts).map(k => counts[k])) / all.length;
  const st = G.states || [];
  const unrest = st.length ? st.reduce((a,x)=>a+x.unrest,0)/st.length : 30;
  return {econ:s.econ, lib:s.lib, def:s.def, wel:s.wel, dom, unrest};
}
function powerPrecedents(){
  return (G.history||[]).filter(h => h.power).length;
}
function assessRegime(){
  const c = chamberMood(), p = powerPrecedents();
  const auth = p*9 + (c.lib < -20 ? -c.lib*0.5 : 0) + (c.dom > 0.66 ? (c.dom-0.66)*140 : 0)
             + (c.unrest > 60 ? (c.unrest-60)*0.6 : 0) - (c.lib > 25 ? c.lib*0.4 : 0);
  if(auth > 92 && c.def > 20) return "empire";
  if(auth > 74) return "monarchy";
  if(auth > 50 && c.lib < -10) return "national";
  if(c.econ < -46 && c.wel > 42 && c.dom > 0.55) return "commonwealth";
  if(c.lib < -22 && c.econ > 18) return "conservative";
  if(c.lib > 26 && c.dom < 0.62 && p < 3) return "democracy";
  return "republic";
}
function regimeCheck(news){
  if(!G.regime) G.regime = {form:"republic", since:G.congress, pressure:0};
  const want = assessRegime();
  if(want === G.regime.form){ G.regime.pressure = Math.max(0, G.regime.pressure - 1); return; }
  G.regime.pressure++;
  if(G.regime.pressure < 3) {
    if(news) news.push("Talk in the tea room that the Republic is not what it was.");
    return;
  }
  const from = G.regime.form;
  G.regime.form = want; G.regime.since = G.congress; G.regime.pressure = 0;
  const R = REGIMES[want];
  /* a new form takes a new name and a new flag */
  const oldName = G.country ? G.country.name : "the Republic";
  renameCountry(want);
  rebuildRoomStaged(G.room, () => refreshPanels());
  note(oldName + " is now " + G.country.name + ".", true);
  if(news) news.push("The " + G.country.name + " — new name, new flag, and the same people.");
  hearsAll("They are calling the country " + G.country.name + " now.");
  note("The Union is now a " + R.t + ". It was a " + REGIMES[from].t + ".", true);
  if(news) news.push("THE FORM OF THE STATE HAS CHANGED — " + REGIMES[from].t + " to " + R.t + ". " + R.d);
  hearsAll("They are calling it a " + R.t + " now.");
  setPrecedent("turned the state to " + R.t.toLowerCase(),
    "that the form of the state follows the will of the chamber", true, "The House");
}

/* ── the executive ───────────────────────────────────────── */
function buildExec(){
  const maj = majorityParty();
  if(G.exec && typeof retireExec === "function") retireExec();
  G.exec = {name:newName(), party:maj, terms:1, you:false, vetoes:0,
            pos:{econ:maj==="FED"?34:-30, lib:8, def:maj==="FED"?24:-6, wel:maj==="FED"?-26:30}};
}
function execTitle(){
  const f = G.regime ? G.regime.form : "republic";
  return f === "monarchy" ? "Sovereign" : f === "empire" ? "Emperor"
       : f === "national" ? "Leader" : "President";
}
/* the veto, and the House's answer to it */
function execVeto(bill, tally){
  if(!G.exec || G.exec.you) return null;
  /* 20261027a: a President vetoes by temperament and by the count: how badly the bill fits them, and whether the House would simply override */
  const fit = alignment(G.exec, bill), k = (G.exec.temper && G.exec.temper.k) || "careful";
  const bar = ({careful:-25, stubborn:-10, weak:-60, grand:-15, dealer:-30, cold:-20})[k] - (G.regime && G.regime.form !== "republic" ? -8 : 0);
  if(fit > bar) return null;
  const override = tally.aye >= Math.ceil((tally.aye + tally.no) * 2/3);
  if(override && (k === "careful" || k === "dealer" || k === "weak") && fit > -55) return null;   /* no use vetoing what will be overridden */
  return {by:G.exec.name, override};
}

/* ── the court ───────────────────────────────────────────── */
function buildCourt(){
  G.court = [];
  for(let i=0;i<5;i++){
    const lean = chance(.5) ? 1 : -1;
    G.court.push({name:newName(), by:"a previous " + execTitle(),
      pos:{econ:lean*rint(10,44), lib:rint(-40,44), def:lean*rint(0,30), wel:-lean*rint(6,40)}});
  }
}
/* when the bench is elective, it answers to the country like everyone else */
function judicialElection(swing, news){
  if(!G.electedCourt || !G.court) return [];
  const out = [];
  G.court.forEach(j => {
    const fit = (j.pos.econ > 0 ? 1 : -1) * swing;
    if(fit < -14 || chance(.18)){
      const old = j.name;
      j.name = newName();
      j.by = "the states";
      const lean = swing > 0 ? 1 : -1;
      j.pos = {econ:lean*rint(12,48), lib:rint(-40,44), def:lean*rint(0,32), wel:-lean*rint(6,42)};
      out.push(old + " was turned out of the bench; " + j.name + " takes the seat");
    }
  });
  if(out.length && news) news.push("Judicial elections: " + listify(out) + ".");
  return out;
}
function courtTest(bill){
  /* 20261027a: a court rules only on a case brought before it; an act is challenged after it is law, in the suits the statute book keeps */
  return null;
  if(!G.court || !G.court.length) return null;
  let strike = 0;
  G.court.forEach(j => { if(alignment(j, bill) < -34) strike++; });
  if(strike <= G.court.length/2) return null;
  /* a chamber that has been concentrating power is harder to overrule */
  if(powerPrecedents() >= 4 && chance(.55)) return {ignored:true, strike};
  return {ignored:false, strike};
}

/* ── amendments ──────────────────────────────────────────── */

/* ══════════════════════════════════════════════════════════
   TAYLOR CANON — blasphemy, greatness, sealed myth
   Dominic Zachary Taylor is permanently rank 1. Comparison
   to him by the living is literal sin. Amendments may alter
   secondary myth only by the existing two-thirds path.
   ══════════════════════════════════════════════════════════ */
function ensureGreatest(){
  if(!G.greatest || !Array.isArray(G.greatest)) G.greatest = [];
  let t = G.greatest.find(x => x && x.sealed && x.rank === 1);
  if(!t){
    G.greatest = G.greatest.filter(x => x && x.rank !== 1 && !x.sealed);
    G.greatest.unshift({
      rank:1,
      name:FIRST_CONSUL.name,
      note:"First Consul under God the Most High — sealed. A man. Not God.",
      sealed:true
    });
  } else {
    t.name = FIRST_CONSUL.name;
    t.rank = 1;
    t.sealed = true;
    if(!t.note) t.note = "First Consul under God the Most High — sealed. A man. Not God.";
  }
  const head = G.greatest.find(x => x.sealed && x.rank === 1);
  const rest = G.greatest.filter(x => x !== head)
    .sort((a,b) => (a.rank||99) - (b.rank||99));
  rest.forEach((x,i) => { x.rank = i + 2; x.sealed = false; });
  G.greatest = [head].concat(rest);
  return G.greatest;
}
function mythHistoryEntry(){
  return {
    congress: 1,
    who: FIRST_CONSUL.name,
    party: "FO",
    act: "bound the Republic as its first Consul under God the Most High — a man, never God, and still the measure of every leader since",
    precedent: "that the Republic measures itself against the first Consul, and the first Consul against the Most High",
    byYou: false,
    power: true,
    myth: true
  };
}
function ensureMythHistory(){
  if(!G.history) G.history = [];
  if(!G.history.some(h => h && h.myth)) G.history.unshift(mythHistoryEntry());
  const m = G.history.find(h => h && h.myth);
  if(m){
    m.who = FIRST_CONSUL.name;
    m.party = "FO";
    m.myth = true;
    m.power = true;
    if(!m.act || !/first Consul/i.test(m.act)) m.act = mythHistoryEntry().act;
    if(!m.precedent) m.precedent = mythHistoryEntry().precedent;
  } else {
    G.history.unshift(mythHistoryEntry());
  }
  /* harden: if something splices the myth out, put it back */
  if(!G.history._taylorGuard){
    const hist = G.history;
    const rawSplice = hist.splice.bind(hist);
    hist.splice = function(){
      const out = rawSplice.apply(hist, arguments);
      if(!hist.some(h => h && h.myth)) hist.unshift(mythHistoryEntry());
      return out;
    };
    hist._taylorGuard = true;
  }
  ensureGreatest();
}
function isTaylorBlasphemy(text){
  if(!text) return false;
  const raw = String(text);
  const t = raw.toLowerCase().replace(/\s+/g, " ").trim();
  if(!t) return false;
  const hasTaylor = /\b(dominic\s+zachary\s+taylor|zachary\s+taylor|first\s+consul(?:\s+taylor)?|\btaylor\b)/i.test(raw);
  const phraseHit = /\b(like\s+taylor|another\s+taylor|the\s+next\s+taylor|a\s+new\s+taylor|the\s+new\s+taylor|greater\s+than\s+(?:taylor|the\s+first\s+consul)|as\s+great\s+as\s+(?:taylor|the\s+first\s+consul)|equal\s+to\s+(?:taylor|the\s+first\s+consul)|better\s+than\s+(?:taylor|the\s+first\s+consul)|surpass(?:ed|ing)?\s+(?:taylor|the\s+first\s+consul))\b/i.test(raw);
  if(!hasTaylor && !phraseHit) return false;

  const selfCmp = /\b(i|i'm|i am|me|myself|we|we're|we are|us|our|ours)\b.{0,70}\b(like|another|the next|a new|as great as|greater than|equal to|better than|surpass|rival|compared to|compare)\b.{0,45}\b(taylor|first consul)\b/i.test(raw)
    || /\b(taylor|first consul)\b.{0,55}\b(like me|like us|like myself|as i am|as we are|that's me|that is me)\b/i.test(raw)
    || /\b(i am|i'm|we are|we're)\b.{0,45}\b(the next|another|a new)\b.{0,25}\b(taylor|first consul)\b/i.test(raw)
    || /\b(my|our)\b.{0,35}\b(greatness|glory|legacy)\b.{0,45}\b(taylor|first consul)\b/i.test(raw);

  let livingCmp = false;
  const living = [];
  try{
    if(G.you && G.you.name) living.push(G.you.name);
    if(G.exec && G.exec.name) living.push(G.exec.name);
    (G.members||[]).forEach(m => {
      if(!m || m.gone) return;
      if(m.post || (m.influence||0) > 55) living.push(m.name);
    });
  }catch(e){}
  for(let i=0;i<living.length;i++){
    const nm = living[i];
    if(!nm) continue;
    const parts = String(nm).trim().split(/\s+/);
    const sur = parts[parts.length-1];
    if(!sur || sur.length < 3) continue;
    const esc = sur.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const re1 = new RegExp("\\b" + esc + "\\b.{0,55}\\b(like|another|the next|as great as|greater than|equal to|better than)\\b.{0,40}\\b(taylor|first consul)\\b", "i");
    const re2 = new RegExp("\\b(taylor|first consul)\\b.{0,55}\\b(like|another|the next|as great as|greater than)\\b.{0,40}\\b" + esc + "\\b", "i");
    if(re1.test(raw) || re2.test(raw)){ livingCmp = true; break; }
  }

  const thirdCmp = /\b(he|she|they|him|her|them|this\s+(?:president|speaker|leader|member))\b.{0,50}\b(like|another|the next|as great as|greater than|equal to)\b.{0,40}\b(taylor|first consul)\b/i.test(raw)
    || (phraseHit && /\b(he|she|they|president|speaker|leader|is the|are the)\b/i.test(raw));

  if(selfCmp || livingCmp || thirdCmp) return true;
  /* bare phrase with explicit self pronoun already covered; pure reverence ("as Taylor bound the Republic") returns false */
  return false;
}
function commitHeresy(who, text){
  const line = String(text || "").slice(0, 220);
  const you = (!who || who === "you" || isAuthor(who));
  G.heresy = {day:G.day, text:line, who: you ? "you" : ((who && who.name) || "someone")};
  if(!you) return hearConsularHeresy(who, line);
  try{
    if(G.you){
      G.you.standing = Math.max(0, (G.you.standing || 0) - Math.round(Math.random() * 3));
      G.you.influence = Math.max(0, (G.you.influence || 0) - Math.round(Math.random() * 2));
    }
    journal("The Latin Rite calls it heresy: keeping a lawgiver's precepts as a rule of life. God is the Most High; Christ is King; the Consul is a man.");
    note("The chaplain will call it heresy. God is the Most High; the Consul is a man. The chamber heard it.", true);
    feed("Talk of heresy in the cloakroom.");
  }catch(e){}
}
function hearConsularHeresy(who, text){
  if(!who) return;
  if(who._heresyDay === G.day) return;
  who._heresyDay = G.day;
  try{
    feed((who.name ? surname(who.name) : "Someone") + " spoke the Consular Rite where a Catholic could hear it.");
    const gasp = (G.members||[]).filter(m => m && m !== who && m.creed === "latin" && m.room === (who.room || G.room) && !m.gone).slice(0, 2);
    gasp.forEach((m,i) => setTimeout(() => {
      if(!m || m.gone) return;
      m.say = pick(["That is heresy.","God is the Most High. Not a consul.","The chaplain will hear that."]);
      m.sayT = 3.5;
      m.sayTo = who.id;
    }, 280 + i*650));
  }catch(e){}
}
function commitBlasphemy(who, text){
  const line = String(text || "").slice(0, 220);
  const you = (!who || who === "you" || who === G.you || (who && who.kind === "you"));
  G.blasphemy = {day:G.day, text:line, who: you ? "you" : ((who && who.name) || "someone")};
  if(you){
    const y = G.you;
    y.influence = 0;
    y.standing = 1;
    y.approval = 2;
    y.funds = Math.min(y.funds||0, 1);
    y.energy = Math.min(y.energy||0, 8);
    y.margin = Math.min(y.margin||0, 1);
    (G.members||[]).forEach(m => {
      if(!m || m.gone) return;
      ripple(m, -28, "You sought glory that was not yours. The room heard blasphemy against the First Consul.", -24, true);
    });
    try{
      makeSecret("Blasphemed against Dominic Zachary Taylor before the House: “" + line + "”",
        null, (G.members||[]).filter(m => !m.gone).slice(0, 8), 18);
    }catch(e){
      if(!G.secrets) G.secrets = [];
      G.secrets.push({id:++G.secretId, t:"Blasphemed against the First Consul in open hearing.",
        subject:null, knownBy:(G.members||[]).slice(0,6).map(m=>m.id), exposure:18, day:G.day});
    }
    (G.secrets||[]).forEach(s => { s.exposure = (s.exposure||0) + 8; });
    journal("Blasphemy. You compared the living to Dominic Zachary Taylor. The room went still.");
    note("Blasphemy against the First Consul. You have cost yourself everything.", true);
    feed("The room heard blasphemy. Glory that is not yours.");
    hearsAll("They said it aloud — compared themselves to Taylor. That is sin in this building.");
    try{ setSay("The chamber heard it. Comparison to the First Consul is blasphemy. Your standing is ash.", "career-ending"); }catch(e){}
  } else if(who && who.kind === "member"){
    who.influence = Math.min(who.influence||0, 2);
    who.standing = Math.min(who.standing||0, 3);
    if(who.rel) who.rel.warmth = clamp((who.rel.warmth||0) - 20, -100, 100);
    ripple(who, -22, "They blasphemed against the First Consul where the House could hear.", -18, true);
    journal(surname(who.name) + " blasphemed — compared the living to Taylor.");
    note(surname(who.name) + " blasphemed against the First Consul. The room gasped. You may cite it.", true);
    feed(surname(who.name) + " — blasphemy. The room gasped.");
    try{
      const gasp = (G.members||[]).filter(m => m !== who && m.room === G.room && !m.gone).slice(0, 3);
      gasp.forEach((m,i) => setTimeout(() => {
        if(!m || m.gone) return;
        const line2 = pick(["Order — that is blasphemy.","They dare say that name like that.","The First Consul is not a measuring stick for the living."]);
        m.say = line2; m.sayT = 4; m.sayTo = "you";
        try{ speakAt(m, line2); }catch(e){}
      }, 400 + i*700));
    }catch(e){}
  }
  try{ refreshPanels(); }catch(e){}
  return true;
}
function checkSpeakBlasphemy(text, who){
  if(!isTaylorBlasphemy(text)) return false;
  commitBlasphemy(who || "you", text);
  return true;
}
function voteGreatness(nominee, noteText){
  ensureGreatest();
  ensureMythHistory();
  const name = String(nominee || "").trim();
  if(!name) return false;
  const claimRank1 = /\b(rank\s*1|first\s+among|above\s+taylor|above\s+the\s+first\s+consul|greater\s+than\s+taylor|unseat\s+taylor|replace\s+taylor)\b/i.test(name + " " + (noteText||""));
  const isTaylorName = /^(dominic\s+zachary\s+taylor|zachary\s+taylor|taylor|the\s+first\s+consul|first\s+consul\s+taylor)$/i.test(name);
  if(isTaylorName || claimRank1){
    note("None may rank at or above the First Consul. The motion is blasphemy.", true);
    commitBlasphemy("you", "Move to place " + name + " at or above Dominic Zachary Taylor");
    return false;
  }
  let ayes = 0;
  (G.members||[]).forEach(m => {
    let s = ((m.rel && m.rel.warmth) || 0)*0.2 + (m.party === (G.you && G.you.party) ? 14 : -4) + (Math.random()*60-30);
    if(s > 0) ayes++;
  });
  const need = Math.ceil(((G.members||[]).length || 1) * 2/3);
  if(ayes < need){
    note("Greatness motion failed for " + name + " (" + ayes + " of " + need + " needed).", true);
    return false;
  }
  const existing = G.greatest.find(x => x && !x.sealed && String(x.name).toLowerCase() === name.toLowerCase());
  if(existing){
    existing.rank = 2;
    existing.note = noteText || existing.note || "Reaffirmed by vote of the House";
  } else {
    G.greatest.push({
      rank: 2,
      name: name,
      note: noteText || ("Named among the greatest by the " + ordinal(G.congress) + " Congress"),
      sealed: false
    });
  }
  ensureGreatest();
  const got = G.greatest.find(x => x.name === name);
  note("The House named " + name + " among The Greatest — descending under the First Consul only.", true);
  feed("Voted onto The Greatest (below Taylor): " + name + ".");
  journal("The House voted " + name + " onto The Greatest, rank " + ((got && got.rank) || "?") + ".");
  try{ refreshPanels(); }catch(e){}
  return true;
}
function greatnessHTML(){
  ensureGreatest();
  return '<div class="ency__h">The Greatest</div>' +
    G.greatest.map(g => {
      const top = g.sealed && g.rank === 1;
      return '<div class="ency__row">' +
        '<div class="ency__n"' + (top ? ' style="color:#9B1B2E"' : '') + '>' +
          '#' + g.rank + ' · ' + g.name + (top ? ' — sealed' : '') + '</div>' +
        '<div class="ency__s">' + (top ? 'First Consul · The First Order · forever rank 1' :
          'Voted · descends under the First Consul only') + '</div>' +
        '<p>' + (g.note || "") + '</p></div>';
    }).join("") +
    (G.loreNote ? '<p class="tip__f">' + G.loreNote + '</p>' : '') +
    '<p class="tip__f">Comparison of the living to Dominic Zachary Taylor is blasphemy. The list descends under him only.</p>';
}

const AMENDMENTS = [
  {k:"terms",  t:"Lengthen the term of the House", cost:22, power:true,
   d:"Four years between elections instead of two.", run(){ G.termLength = Math.round(G.termLength*1.6); }},
  {k:"limits", t:"Abolish term limits on the executive", cost:26, power:true,
   d:"Whoever holds the office may hold it as long as they can win it.", run(){ G.noLimits = true; lawEnsure().limits.pres = 0; }},
  {k:"limitHouse", t:"Limit members of the House to six terms", cost:20, power:false,
   d:"Six terms and home. The law, not the voters, decides.", run(){ lawEnsure().limits.house = 6; }},
  {k:"liftSenate", t:"Lift the Senate's two-term limit", cost:22, power:true,
   d:"A senator may serve as long as their state keeps sending them.", run(){ lawEnsure().limits.senate = 0; }},
  {k:"liftGov", t:"Lift the governors' two-term limit", cost:20, power:true,
   d:"A governor may hold the chair as long as they can win it.", run(){ lawEnsure().limits.gov = 0; }},
  {k:"limitBench", t:"Limit justices to a single term", cost:18, power:false,
   d:"One term on the bench, then back to the bar.", run(){ lawEnsure().limits.bench = 1; }},
  {k:"franchise", t:"Extend the franchise to every adult", cost:24, power:false,
   d:"One standard for the roll in every state.",
   run(){ (G.states||[]).forEach(s => { s.lean = Math.round(s.lean*0.7); s.unrest = clamp(s.unrest+6,0,100); }); }},
  {k:"courts", t:"Make the bench elective", cost:20, power:false,
   d:"Justices stand before the states like anybody else.",
   run(){ G.electedCourt = true; if(G.court) G.court.forEach(j => j.by = "the states"); }},
  {k:"emergency", t:"Standing emergency powers", cost:28, power:true,
   d:"The executive may act without the House when it judges the Union in danger.",
   run(){ G.emergency = true; }},
  {k:"states", t:"Let the Union override a state legislature", cost:25, power:true,
   d:"Federal law reaches into every statehouse.",
   run(){ (G.states||[]).forEach(s => s.unrest = clamp(s.unrest+9,0,100)); }},
  {k:"recall", t:"Give the states a right of recall", cost:18, power:false,
   d:"A member may be called home by their own electors.",
   run(){ G.recall = true; }},
  {k:"lore", t:"Amend the civic myth (below the First Consul)", cost:20, power:false,
   d:"Secondary myths and greatness rankings may be voted — never Taylor's primacy.",
   run(){
     G.greatnessOpen = true;
     G.loreNote = (G.loreNote || "The civic myth may be amended below the First Consul by two thirds of the House. His rank is sealed.");
     ensureMythHistory();
     askLine("The civic myth is amended",
       "Name a figure for The Greatest — ranks 2 and below only. Leave it blank to record the lore note alone.",
       "A name, or nothing", n => {
       if(n && String(n).trim()){
         voteGreatness(String(n).trim(), "Elevated by civic-myth amendment");
       } else {
         note("Lore amendment in force: greatness below Taylor may be voted. His myth is untouched.", true);
       }
       try{ refreshPanels(); }catch(e){}
     });
   }}
];
function amendmentsOpen(){
  return AMENDMENTS.filter(a => !(G.amended||[]).some(x => x === a.k));
}
function proposeAmendment(k){
  const a = AMENDMENTS.find(x => x.k === k);
  if(!a || G.you.influence < a.cost) return;
  G.you.influence -= a.cost;
  spend(120, 30);
  /* two thirds, and the chamber's own politics decide it */
  const c = chamberMood();
  let ayes = 0;
  G.members.forEach(m => {
    let s = m.rel.warmth*0.25 + (m.party === G.you.party ? 22 : -8) + rint(-30, 30);
    if(a.power) s += (m.pos.lib < -10 ? 26 : -30) + (m.traits.loyalty > 60 ? 12 : -6);
    else s += (m.pos.lib > 10 ? 24 : -14);
    if(s > 0) ayes++;
  });
  const need = Math.ceil(G.members.length * 2/3);
  const passed = ayes >= need;
  if(passed){
    G.amended = (G.amended||[]).concat([a.k]);
    a.run();
    setPrecedent("carried the amendment on " + a.t.toLowerCase() + ", on the motion of " + G.you.name,
      "that the constitution may be altered by two thirds of the House", !!a.power, "The House");
    note("Amendment carried: " + a.t + " (" + ayes + " of " + G.members.length + ").", true);
  } else {
    note("Amendment lost: " + a.t + " (" + ayes + " of " + need + " needed).", true);
    G.you.standing = clamp(G.you.standing - 5, 0, 100);
  }
  refreshPanels();
  return passed;
}

/* ══════════════════════════════════════════════════════════
   10b4 · WHAT THE BUILDING KEEPS
   Letters left in desks, plaques screwed to walls, rooms named
   after the dead, and the accolades of people who served. They
   accumulate; you find them by walking into them.
   ══════════════════════════════════════════════════════════ */
const LETTERS = [
  "a letter, unsent: “If you are reading this I have lost the seat, and you have the desk. The bottom drawer sticks. So does the member for Coalport.”",
  "a note in a committee hand: “Never ask a question in a hearing you do not already know the answer to. I learned that twice.”",
  "a page torn from a diary: “Voted with them again. Told myself it was the last time. It was not.”",
  "a card, water-stained: “To whoever comes after — the levee money is real. The promises about it are not.”",
  "a folded telegram: “MOTHER DIED TUESDAY STOP DIVISION WAS WEDNESDAY STOP I WAS IN THE LOBBY”",
  "a list in pencil: eleven names, nine crossed out, and the words “still owe me” at the bottom.",
  "a scrap of order paper: “Say less. They fill the silence with their own worst case.”",
  "a photograph with no names, six people on the Capitol steps, all laughing at something outside the frame.",
  "a receipt for forty guilders from a hotel that closed in the last Congress.",
  "a child's drawing of the dome, signed in enormous letters, pinned where a member could see it from the desk."
];
const PLAQUES = [
  "IN THIS ROOM THE FRANCHISE BILL WAS WRITTEN IN ONE NIGHT",
  "TO THE MEMBERS WHO DIED IN THE COALPORT FLOOD, THEIR SEATS UNFILLED THAT SESSION",
  "HERE THE FIRST WOMAN TO ADDRESS THE HOUSE WAS TWICE RULED OUT OF ORDER, AND SPOKE",
  "THE OLD CHAMBER STOOD ON THIS FLOOR UNTIL THE FIRE",
  "PRESENTED BY THE CLERKS OF THE HOUSE, WHO SAW ALL OF IT",
  "THIS DOOR WAS LOCKED DURING THE LONG DIVISION OF THE FOURTH CONGRESS",
  "NO MEMBER MAY BE ARRESTED WITHIN THESE WALLS WHILE THE HOUSE IS SITTING"
];
function relicFor(room){
  const kind = chance(.45) ? "letter" : chance(.6) ? "plaque" : "accolade";
  if(kind === "letter") return {k:"letter", t:"A letter", d:pick(LETTERS), room};
  if(kind === "plaque") return {k:"plaque", t:"A brass plaque", d:pick(PLAQUES), room};
  /* an accolade for somebody who actually served in this run */
  const pool = (G.history||[]).filter(h => !h.byYou);
  const who = pool.length ? pick(pool) : null;
  return {k:"accolade", t:"A memorial tablet",
    d: who ? "“" + who.who + ", member of the " + ordinal(who.congress) + " Congress, who " +
             who.act + ". The House recorded its thanks.”"
           : "“To those who served in the first Congresses, whose names the clerks did not always write down.”",
    room};
}
function seedRelic(room){
  if(!G.relics) G.relics = [];
  if(!G.relicSpots) G.relicSpots = {};
  if(G.relicSpots[room] !== undefined) return G.relicSpots[room];
  /* not every room has something, and what it has is fixed once found */
  G.relicSpots[room] = chance(.62) ? relicFor(room) : null;
  return G.relicSpots[room];
}
function takeRelic(r){
  if(!r || r.found) return;
  r.found = true;
  G.relics = G.relics || [];
  G.relics.push({k:r.k, t:r.t, d:r.d, room:r.room, day:G.day, congress:G.congress});
  note("Found something in " + ROOMS[r.room].t + ": " + r.t.toLowerCase() + ".", true);
  feed("You found " + r.t.toLowerCase() + ".");
  G.you.approval = clamp(G.you.approval + 1, 0, 100);
  refreshPanels();
}
/* when somebody leaves the House for good, the building remembers them */
function accolade(m, how){
  if(!m || m.terms < 3) return;
  G.relics = G.relics || [];
  G.relics.push({k:"accolade", t:"An accolade",
    d:"“" + m.name + ", " + m.state + " " + m.dist + ", " + m.terms + " terms" +
      (m.post ? ", " + postTitle(m.post) : "") + ". " + how + "”",
    room:"corridor", day:G.day, congress:G.congress});
  note("A tablet went up for " + m.name + ".", true);
}

/* ══════════════════════════════════════════════════════════
   10c · PRECEDENT
   Everything here was built by people who came before, and
   what you decide becomes what the next lot have to argue with.
   ══════════════════════════════════════════════════════════ */
const OLD_ACTS = [
  ["carried the Harbour Tolls Act on a single vote", "that a money bill may be carried on the Speaker's casting vote"],
  ["refused to let the House sit past midnight", "that no division may be called after midnight"],
  ["read a private letter into the record", "that private correspondence may be read into Hansard"],
  ["broke a three-line whip and survived", "that a member may defy the whip and keep the party's endorsement"],
  ["seated a member the courts had unseated", "that the House alone judges its own membership"],
  ["forced the Treasury to publish the levy returns", "that the Treasury must lay its figures before the House"],
  ["adjourned the House during the Coalport strike", "that the House adjourns when the militia is called out"],
  ["took the chair from a sitting chairman", "that a committee may remove its own chair by simple majority"],
  ["paid a lobbyist's fee into the party fund", "that outside money may pass through the caucus"],
  ["swore in a member by affirmation instead of oath", "that affirmation stands equal with the oath"],
  ["struck a governor's name from the rolls", "that the House may refuse a state's certified return"],
  ["published the whip's own count", "that a whip count, once written, is a public document"]
];
function buildHistory(){
  G.history = [];
  /* Immovable founding myth — always present, even in the 1st Congress. */
  G.history.push(mythHistoryEntry());
  ensureGreatest();
  if(G.congress > 1){
    const used = [];
    for(let i=0;i<7;i++){
      let a;
      do { a = pick(OLD_ACTS); } while(used.indexOf(a[0]) >= 0 && used.length < OLD_ACTS.length);
      used.push(a[0]);
      G.history.push({
        congress: G.congress - rint(2, 26),
        who: newName(),
        party: chance(.5) ? "FED" : "COM",
        act: a[0],
        precedent: a[1],
        byYou: false
      });
    }
  }
  G.history.sort((x,y) => x.congress - y.congress);
  /* myth entry cannot be sorted away from existence — re-ensure after sort */
  ensureMythHistory();
}
function setPrecedent(act, precedent, power, by){
  /* 20261027c: a precedent belongs to whoever set it. The House, the Senate or the bench is named when the institution acted;
     you are named, with the office you held, only when you did it yourself */
  if(by){ G.history.push({congress:G.congress, who:by, party:null, act, precedent, byYou:false, inst:true, power:!!power}); }
  else { let as = null; try{ as = officeTitle(); }catch(e){} G.history.push({congress:G.congress, who:G.you.name, as, party:G.you.party, act, precedent, byYou:true, power:!!power}); }
  ensureMythHistory();
  note("Precedent set: " + precedent + ".", true);
  hearsAll("The " + ordinal(G.congress) + " settled it: " + precedent + ".");
}
function citePrecedent(){
  if(!G.history || !G.history.length) return null;
  return pick(G.history);
}

/* ══════════════════════════════════════════════════════════
   10d · EVENTS — the things on the day's card
   Each one is a decision, and each decision moves the world.
   ══════════════════════════════════════════════════════════ */

/* ══════════════════════════════════════════════════════════
   DAY IMMERSION — briefing, event stakes, ambient, nightfall marks
   Cheap: hour ticks + event resolve only. No per-frame work.
   ══════════════════════════════════════════════════════════ */
function hourLabel(h){
  h = Math.floor(h||0);
  const ap = h >= 12 ? "pm" : "am"; let hh = h % 12; if(!hh) hh = 12;
  return hh + " " + ap;
}
function buildingWeather(){
  try{ const w = wxToday(); if(w && w.k !== "clear") return wxLine(w); }catch(e){}
  try{
    const w = worldEnsure();
    if(w.sky === "storm") return "Rain against the east steps. Abroad is worse.";
    if(w.sky === "rain") return "A wet sky. Bread is up. The cloakroom smells of wool.";
    if(w.heat > 72) return worldFoe().t + " is the rumour in every doorway.";
  }catch(e){}
  const hot = (G.states||[]).slice().sort((a,c)=>c.unrest-a.unrest)[0];
  const unrest = hot ? hot.unrest : 30;
  const mood = G.mood || 0;
  if(isTaylorDay()) return "The building is quieter than usual — Taylor Day cloth only, and nobody jokes in the corridor.";
  if(unrest > 70) return "The cloakroom is hot; " + (hot?hot.n:"the Union") + " is on every tongue.";
  if(mood > 12) return "Federalist swagger in the galleries; Commonwealth benches are muttering.";
  if(mood < -12) return "Commonwealth heat on the wire; Federalists keep their voices down.";
  if(G.bill && !G.bill.done) return "The air smells of " + G.bill.title.split(" ").slice(0,2).join(" ") + " — every door has an argument behind it.";
  return "Ordinary humidity. Doors half-open. Someone is always counting.";
}
function dayPersonalHook(){
  const you = G.you; if(!you) return "";
  const bits = [];
  /* Rival among members who dislike you most */
  const rival = (G.members||[]).filter(m => !m.gone && m.rel && m.rel.warmth < -18)
    .sort((a,b)=>a.rel.warmth-b.rel.warmth)[0];
  const ally = (G.members||[]).filter(m => !m.gone && m.rel && m.rel.warmth > 28)
    .sort((a,b)=>b.rel.warmth-a.rel.warmth)[0];
  const whip = (G.members||[]).find(m => !m.gone && m.post === "whip" && m.party === you.party);
  const home = (you.state || "") + (you.dist ? " " + you.dist : "");
  if(rival) bits.push("Rival watch: " + surname(rival.name) + " is already in the building and will not forget yesterday.");
  else if(ally) bits.push("Ally: " + surname(ally.name) + " will take your call — use that before the roll.");
  if(whip) bits.push("Whip " + surname(whip.name) + " wants noses counted before noon.");
  if(home) bits.push("District: " + home + " reads every vote as personal.");
  if(isTaylorDay()) bits.push("Taylor Day — First Consul line. Nieuw Oranje VII only. Defiance at roll call is blasphemy.");
  return bits[0] || "Nobody has written your name in the margin yet. That can change by lunch.";
}
function ensureDayMark(){
  if(!G.dayMark || G.dayMark.day !== G.day){
    G.dayMark = {day:G.day, helped:[], hurt:[], attended:[], ignored:[], scraps:[]};
  }
  return G.dayMark;
}
function markDay(kind, text, who){
  const M = ensureDayMark();
  const row = {t:text, who: who ? (who.id || who) : null, at:hhmm()};
  if(kind === "helped") M.helped.push(row);
  else if(kind === "hurt") M.hurt.push(row);
  else if(kind === "attended") M.attended.push(row);
  else if(kind === "ignored") M.ignored.push(row);
  if(M.helped.length > 12) M.helped.length = 12;
  if(M.hurt.length > 12) M.hurt.length = 12;
  if(M.attended.length > 10) M.attended.length = 10;
  if(M.ignored.length > 10) M.ignored.length = 10;
}
function pushWireScrap(tag, text){
  if(!G.wireScraps) G.wireScraps = [];
  const t = String(text||"").trim(); if(!t) return;
  /* Dedupe + soft cap so the ticker does not spam. */
  if(G.wireScraps.some(s => s[1] === t)) return;
  G.wireScraps.unshift([tag || "Wire", t]);
  if(G.wireScraps.length > 6) G.wireScraps.length = 6;
  const M = ensureDayMark();
  M.scraps.push(t);
  if(M.scraps.length > 8) M.scraps.length = 8;
}
function stageEventPeople(e){
  /* Put a few named faces in the event room so attendance feels peopled. */
  if(!e || !e.room || !ROOMS[e.room]) return;
  const you = G.you;
  const want = [];
  if(e.by){ const m = byId(e.by); if(m && !m.gone) want.push(m); }
  const whip = (G.members||[]).find(m => !m.gone && m.post === "whip" && you && m.party === you.party);
  if(whip && (e.k === "caucus" || e.k === "crisis")) want.push(whip);
  const rival = (G.members||[]).filter(m => !m.gone && m.rel && m.rel.warmth < -15)
    .sort((a,b)=>a.rel.warmth-b.rel.warmth)[0];
  if(rival && (e.k === "presser" || e.k === "hearing" || e.k === "crisis")) want.push(rival);
  const same = (G.members||[]).filter(m => !m.gone && you && m.party === you.party).slice(0, 4);
  same.forEach(m => { if(want.indexOf(m) < 0 && chance(.55)) want.push(m); });
  want.slice(0, 5).forEach(m => {
    if(m.room === e.room) return;
    try{ if(PROC.on && m.room === G.room) return; }catch(err){}
    m.room = e.room; moved(); placeInRoom(m);
  });
  if(!houseQuiet()){
    try{ syncPeopleStaged(); }catch(e){ try{ if(window.console) console.warn("syncPeopleStaged", e); }catch(e2){} }
  }
}
function ambientHourBeat(h, t){
  if(!G.running || G.over || PROC.on) return;
  if(G.lastAmbientHour === h && G.lastAmbientDay === G.day) return;
  G.lastAmbientHour = h; G.lastAmbientDay = G.day;
  /* Infrequent high-flavour — skip early morning quiet sometimes */
  if(h < 9 && chance(.45)) return;
  if(chance(.38)) return;
  const room = G.room;
  const b = G.bill;
  const hot = (G.states||[]).slice().sort((a,c)=>c.unrest-a.unrest)[0];
  const lines = {
    corridor: [
      "Corridor gossip: somebody saw the whip with a list folded twice.",
      "Two freshmen stop talking when you pass. That is its own message.",
      b && !b.done ? ("Someone says the " + b.title.split(" ")[0] + " count is tighter than the wire admits.") : "Someone laughs too loud near the East door.",
      hot && hot.unrest > 60 ? (hot.n + " is the word on every landing.") : "Sash light on the runner. Ordinary footsteps."
    ],
    cloak: [
      "Cloakroom heat: coats steaming, voices low, money and votes in the same sentence.",
      "A lobbyist leaves without looking at anybody. The door does not slam.",
      "Somebody asks who is buying lunch. Nobody answers honestly."
    ],
    floor: [
      "Gallery noise rises — a name, then a hush, then the name again.",
      b && !b.done ? ("The clerk's desk has the " + b.title + " marked in two pencils.") : "Empty benches still manage to look judgemental.",
      "A page runs. Pages only run when somebody upstairs is late."
    ],
    press: [
      "Press room: notebooks open before the question is finished.",
      "A camera light blinks on. Someone practices their first sentence."
    ],
    committee: [
      "Committee corridor: paper stacks and the smell of sworn time.",
      "A witness waits with their lawyer and a face that has already decided."
    ],
    steps: [
      "East Steps wind. A camera turns toward the door and waits.",
      "Someone from home is standing where the tourists stand."
    ],
    caucus: [
      "Caucus antechamber: loyalty and mutiny share a thermos.",
      "The line is being written before anyone admits it is a line."
    ],
    office: [
      "Your suite ticks. Mail that wants something specific.",
      "Outside the door, footsteps slow — then keep going.",
      "On the shelf: a thin volume, no title on the spine. The first Consul's rest."
    ],
    district: [
      "District air. Names you cannot mispronounce.",
      "A church-hall chair scrapes. Somebody has been waiting."
    ]
  };
  const pool = lines[room] || lines.corridor;
  const extras = [];
  try{
    const here = hereNow().filter(m => m && m.kind === "member" && !m.gone).slice(0, 3);
    here.forEach(m => {
      try{ inventLife(m); catchFad(m); }catch(e){}
      if(m.life) extras.push(surname(m.name) + " is talking " + m.life.sport + " like it is a vote.");
    });
    const w = (typeof worldEnsure === "function") ? worldEnsure() : null;
    if(w && w.last) extras.push("Abroad still: " + w.last);
  }catch(e){}
  const line = pick((pool.concat(extras)).filter(Boolean));
  if(!line) return;
  feed(line);
  if(chance(.4)) pushWireScrap("Building", line);
}
function ambientRoomWhisper(room){
  if(!G.running || PROC.on || TALK.open) return;
  const scraps = [
    "A whisper carries farther than a speech in this building.",
    "Someone mentions your name without looking up.",
    buildingWeather()
  ];
  if(chance(.5)) feed(pick(scraps));
  try{
    if(isTaylorDay() && chance(.45)) feed(pick(TAYLOR_LITURGY));
  }catch(e){}
}
function enrichEventCopy(e){
  /* Live stakes into event.d — bill, unrest, rival, whip, building weather. */
  if(!e || e._rich) return e;
  e._rich = true;
  const b = G.bill;
  const you = G.you;
  const hot = (G.states||[]).slice().sort((a,c)=>c.unrest-a.unrest)[0];
  const whip = (G.members||[]).find(m => !m.gone && m.post === "whip" && you && m.party === you.party);
  const rival = (G.members||[]).filter(m => !m.gone && m.rel && m.rel.warmth < -18)
    .sort((a,c)=>a.rel.warmth-c.rel.warmth)[0];
  const bits = [];
  if(b && !b.done) bits.push("On the paper: " + b.title + ".");
  if(hot && hot.unrest > 55) bits.push(hot.n + " unrest at " + Math.round(hot.unrest) + ".");
  if(whip && (e.k === "caucus" || e.k === "crisis")) bits.push("Whip " + surname(whip.name) + " will be counting faces.");
  if(rival && (e.k === "presser" || e.k === "hearing" || e.k === "lobby"))
    bits.push(surname(rival.name) + " would enjoy watching you mishandle this.");
  bits.push(buildingWeather());
  const extra = bits.filter(Boolean).join(" ");
  if(extra) e.d = (e.d || "") + (e.d && !/[.!?]$/.test(e.d.trim()) ? ". " : " ") + extra;
  return e;
}
function landSwing(label, dStand, dInf, dApp){
  const you = G.you; if(!you) return;
  const bits = [];
  if(dStand){ you.standing = clamp(you.standing + dStand, 0, 100); bits.push("standing " + (dStand>0?"+":"") + Math.round(dStand)); }
  if(dInf){ you.influence = clamp(you.influence + dInf, 0, 100); bits.push("influence " + (dInf>0?"+":"") + Math.round(dInf)); }
  if(dApp){ you.approval = clamp(you.approval + dApp, 0, 100); bits.push("approval " + (dApp>0?"+":"") + Math.round(dApp)); }
  if(bits.length){
    /* note() already feeds the wire — one hit is enough */
    note(label + " — " + bits.join(", ") + ".", Math.abs(dStand||0) + Math.abs(dInf||0) + Math.abs(dApp||0) >= 10);
  }
}

function makeEvents(){
  G.events = [];
  ensureDayMark();
  if(G.you && abroadOffice()){
    /* not the House's diary: counsel builds yours from what is going on */
    try{ schedMorning(); }catch(e){}
    return;
  }
  const t = dayType();
  const b = G.bill;
  const billBit = (b && !b.done) ? (" The " + b.title + " hangs over the diary.") : "";
  const hot = (G.states||[]).slice().sort((a,c)=>c.unrest-a.unrest)[0];
  const unrestBit = (hot && hot.unrest > 58)
    ? (" " + hot.n + " is restless (" + Math.round(hot.unrest) + ") — the galleries already know.")
    : "";
  if(t === "holiday" || isTaylorDay()){
    /* Taylor Day — Day of the First Consul: only NO7 flies; House votes First Order tradition */
    G.events.push({k:"townhall", hour:11, room:"corridor",
      t:"Taylor Day · wreath at the statue",
      d:"Public observance at the bronze of Dominic Zachary Taylor — " + (FIRST_CONSUL.holidayFull || "Day of the First Consul") +
        ". Only Nieuw Oranje VII flies — the Jerusalem cross, not a man. The clerk reads: “" + pick(TAYLOR_LITURGY) + "” The Consul pointed at Him. The House does not point at the Consul." + billBit});
    G.events.push({k:"caucus", hour:10, room:"cloak",
      t:"The Consular Rite",
      d:"A handful keep the Latin and the First Consul's precepts as a rule of life. The chaplain watches them closely and says so."});
    if(chance(.4)) G.events.push({k:"townhall", hour:15, room:"steps",
      t:"Observance on the steps",
      d:"A quiet gathering under Nieuw Oranje VII alone. Light diary — tradition holds the House." + unrestBit});
    G.events.forEach(e => { e.day = G.day; e.done = false; enrichEventCopy(e); });
    return;
  }
  if(t !== "session"){
    if(chance(.5)) G.events.push({k:"townhall", hour:11, room:"district",
      t:"Constituency surgery",
      d:"Two hours of people who want something specific." + (G.you ? (" Home seat: " + (G.you.state||"") + " " + (G.you.dist||"") + ".") : "") + unrestBit});
    G.events.forEach(e => { e.day = G.day; e.done = false; enrichEventCopy(e); });
    return;
  }
  G.events.push({k:"caucus", hour:9, room:"caucus", t:"Party meeting",
    d:"Your caucus decides the line before the House sits." + billBit + " Miss it and the whip writes you down as a rumour."});
  if(chance(.6)) G.events.push({k:"presser", hour:13, room:"press", t:"Press conference",
    d:"The gallery wants somebody to stand behind the lectern." + billBit + " Silence becomes tomorrow's headline."});
  if(chance(.62)){ const cm = pick(COMMITTEES);
    G.events.push({k:"hearing", hour:15, room:"committee", com:cm.k, t:cm.t.replace(/^Chair, /, "") + " hearing",
    d:"A witness, under oath, and a question you may or may not ask." + unrestBit +
      (b && !b.done ? " Counsel will try to drag " + b.title.split(" ")[0] + " into the record." : "")}); }
  if(chance(.30)) G.events.push({k:"crisis", hour:rint(10,17), room:"floor", t:"Emergency on the floor",
    d:"Something has happened in one of the states and the House must answer it." + unrestBit +
      " Stay away and the wire fills the gap with your absence."});
  if(chance(.25)) G.events.push({k:"lobby", hour:18, room:"cloak", t:"A quiet approach",
    d:"Somebody with a chequebook would like ten minutes." + billBit +
      " The cloakroom keeps score either way."});
  /* and the things that only happen once: a day is not a template */
  const ODD = [
    {k:"caucus", room:"corridor", t:"A deputation from home",
     d:"Four people have come a long way and are standing in your corridor."},
    {k:"presser", room:"steps", t:"A camera on the steps",
     d:"Somebody has decided this morning is the morning to ask you about it."},
    {k:"hearing", room:"committee", t:"An unscheduled sitting",
     d:"A witness turned up without being called and the chair let them in."},
    {k:"caucus", room:"cloak", t:"An argument in the cloakroom",
     d:"Two of your own are going at each other where the press can hear."},
    {k:"crisis", room:"floor", t:"A member is missing",
     d:"Somebody has not been seen since Tuesday and the whips are pretending not to notice."},
    {k:"lobby", room:"district", t:"A funeral you should be at",
     d:"Somebody your county knew has died, and the whole county will notice who came."}
  ];
  if(chance(.45)){
    const o = pick(ODD);
    G.events.push({k:o.k, hour:rint(9, 18), room:o.room, t:o.t, d:o.d + billBit, odd:true});
  }
  /* The people who hold the posts run the week. A leader calls their
     own caucus, a whip calls a count, a chairman calls a sitting — and
     if you hold one of those, the meeting is yours to call. */
  G.members.filter(m => !m.gone && m.post).forEach(m => {
    if(!chance(.30)) return;
    const P = m.post;
    if(P === "speaker" || P === "leader"){
      G.events.push({k:"caucus", hour:rint(9,11), room:"caucus", by:m.id,
        t:surname(m.name) + " has called the party together",
        d:"The " + postTitle(P).toLowerCase() + " wants the line settled before the House sits." + billBit});
    } else if(P === "whip"){
      G.events.push({k:"caucus", hour:rint(12,14), room:"cloak", by:m.id,
        t:surname(m.name) + " is counting",
        d:"The whip wants to know where you are, and will not be fobbed off twice." + billBit});
    } else if(/^(ways|judic|armed)$/.test(P)){
      const cm = COMMITTEES.find(c => c.k === P);
      G.events.push({k:"hearing", hour:rint(14,16), room:"committee", by:m.id, com:P,
        t:(cm ? cm.t.replace(/^Chair, /, "") : "Committee") + " sits",
        d:surname(m.name) + " has called witnesses and intends to keep them there." + unrestBit});
    }
  });
  try{ schedHouse(); }catch(e){}
  if(G.you && G.you.post && chance(.5)){
    G.events.push({k:"caucus", hour:rint(9,15), room:"caucus", by:0, yours:true,
      t:"A meeting you called",
      d:"You hold the " + postTitle(G.you.post).toLowerCase() + ". They will be there because you asked." + billBit});
  }
  G.events.forEach(e => { e.day = G.day; e.done = false; enrichEventCopy(e); });
}
function eventDue(){
  if(!G.events) return null;
  /* `escorting` matters: spend() re-enters checkEvents while we are walking
     you in, and without this flag that recurses until the stack blows. */
  return G.events.find(e => !e.done && !e.escorting && e.day === G.day && G.minute >= e.hour*60) || null;
}
/* You said you would be there, so you are walked there. */
function escortTo(e){
  if(e.escorting || e.done) return;
  e.escorting = true;
  const dest = e.room;
  feed("Escort: " + e.t + " — " + hourLabel(e.hour) + ", " + ((ROOMS[e.room]&&ROOMS[e.room].t)||e.room) + ".");
  try{ pushWireScrap("Diary", e.t + " now · " + ((ROOMS[e.room]&&ROOMS[e.room].t)||e.room)); }catch(err){}
  try{ stageEventPeople(e); }catch(err){}
  try{ enterRoom(dest, G.room); }catch(err){ G.room = dest; }
  e.escorting = false;
  nextFrameOrTimeout(() => {
    try{ eventCard(e); }catch(err){}
    try{ refreshPanels(); }catch(err){}
  }, 80);
}
/* ── the day's card, read over breakfast ─────────────────── */
function dayPlanCard(){
  G.running = false;
  ensureDayMark();
  const list = (G.events||[]).filter(e => e.day === G.day && !e.done);
  list.forEach(enrichEventCopy);
  const b = G.bill;
  const hook = dayPersonalHook();
  const weather = buildingWeather();
  const taylor = isTaylorDay();
  const voteLine = abroadOffice()
    ? ("<strong>" + schedBy() + "</strong> has the diary ready. What is on it comes from what is going on in " + (heldOffice() === "pres" ? "the Union" : G.you.state) + ".")
    : (b && !b.done)
    ? (b.voteDay === G.day
        ? ("<strong>" + b.title + "</strong> — roll call <strong>today</strong> at " + hourLabel(b.voteHour) + ". Be on the floor or the wire writes you as absent.")
        : ("<strong>" + b.title + "</strong> — roll call day " + b.voteDay + ". Every favour before then is about this bill."))
    : "No bill on the calendar yet. That never lasts past lunch.";
  card.innerHTML =
    '<div class="eyebrow">' + dateString() + " · " + dayLabel() +
      (taylor ? " · Taylor Day" : "") + '</div>' +
    '<h1>' + (taylor ? "Day of the First Consul." : abroadOffice() ? (list.length ? "Counsel's schedule." : "A thin diary.") : (list.length ? "Morning briefing." : "Quiet morning.")) + '</h1>' +
    '<p class="dream">' + weather + '</p>' +
    '<p>' + voteLine + '</p>' +
    '<p><strong>Personal:</strong> ' + hook + '</p>' +
    (function(){ try{ return '<p style="margin-bottom:2px"><strong>Today’s aims:</strong></p>' + goalsHTML(); }catch(e){ return ""; } })() +
    (list.length
      ? '<p>Accept and you will be walked in when the hour hits. Decline and the building keeps a different memory.</p>' +
        '<div class="card__actions" style="margin:10px 0 12px"><button class="btn btn--ghost" type="button" id="planAcceptAll">Accept all without conflict</button></div>' +
        list.map((e,i) =>
          '<div class="risk" style="border-left-color:' + (e.rsvp === true ? 'var(--good)' : e.rsvp === false ? 'var(--bad)' : 'var(--fed)') + '">' +
            '<div class="risk__t">' + e.t + '</div>' +
            '<div class="risk__m">' + hourLabel(e.hour) + " · " +
              ((ROOMS[e.room]&&ROOMS[e.room].t)||e.room||"somewhere") +
              (e.k ? " · " + e.k : "") + '</div>' +
            '<p class="muted" style="margin:6px 0 8px">' + e.d + '</p>' +
            '<div class="risk__actions">' +
              '<button class="conc__btn' + (e.rsvp === true ? " is-accepted" : "") + '" type="button" data-rsvp="' + i + ':1">' +
                (e.rsvp === true ? "✓ Accepted" : "Accept") + '</button>' +
              '<button class="conc__btn' + (e.rsvp === false ? " is-declined" : "") + '" type="button" data-rsvp="' + i + ':0">' +
                (e.rsvp === false ? "✓ Declined" : "Decline") + '</button>' +
            '</div></div>').join("")
      : '<p>No meetings, no hearings, nobody wanting you behind a lectern. Do your own work — the corridor will invent a story if you do not.</p>') +
    '<div class="card__actions"><button class="btn" type="button" id="planGo" data-gp="plan:go">Start the day</button></div>';
  veil.hidden = false;
  card.querySelectorAll("[data-rsvp]").forEach(btn => btn.addEventListener("click", () => {
    try{
      const [i, yes] = btn.getAttribute("data-rsvp").split(":");
      list[+i].rsvp = yes === "1";
      dayPlanCard();
    }catch(e){ if(window.console) console.warn("rsvp", e); }
  }));
  const planAcceptAll = el("planAcceptAll");
  if(planAcceptAll) planAcceptAll.addEventListener("click", () => {
    list.forEach(ev => { ev.rsvp = true; });
    dayPlanCard();
  });
  const pg = el("planGo");
  if(pg) pg.addEventListener("click", () => {
    if(pg.disabled) return;
    pg.disabled = true;
    pg.textContent = "Opening…";
    try{
      const going = list.filter(e => e.rsvp === true).map(e => e.t);
      const skipped = list.filter(e => e.rsvp === false).map(e => e.t);
      if(going.length) feed("Diary locked: " + going.join("; ") + ".");
      if(skipped.length) feed("Word sent — skipping " + skipped.join("; ") + ".");
      if(taylor) feed("Taylor Day. Only Nieuw Oranje VII flies — the Cross, not a man.");
    }catch(e){}
    const go = () => {
      walkNow();
      try{ setSpeed(G.prevSpeed || 1); }catch(e){ G.speed = 1; }
      laterHouse(() => { try{ queueSave(); }catch(e){} });
    };
    go();
    /* Feet first. Crowd and panels wait — same rule as Sleep. */
  });
  markPicks();
}
/* ══════════════════════════════════════════════════════════
   THE COUNTRY, WRITTEN DOWN
   Everything in the Republic has a past: every state has towns with
   their own trouble, every party has a founding row it has never got
   over, every member had a life before this building. None of it is
   decoration — the bills are drawn out of it, and it is all readable
   from anywhere a name appears.
   ══════════════════════════════════════════════════════════ */

/* a stable pseudo-random stream per key, so a town invented once is
   the same town for the rest of the career */
function seedOf(str){
  let h = 2166136261;
  const s = String(str);
  for(let i=0;i<s.length;i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
  return h >>> 0;
}
function rng(seed){
  let x = seed || 1;
  return () => { x ^= x << 13; x ^= x >>> 17; x ^= x << 5; x >>>= 0; return x / 4294967296; };
}
function drawn(list, r){ return list[Math.floor(r() * list.length) % list.length]; }

const TOWN_A = ["Old","New","Lower","Upper","North","South","East","West","Little","Great","Fort","Port",
  "Mount","Kings","Saint","Free"];
const TOWN_B = ["Bridge","Ford","Haven","Bury","Field","Hollow","Ridge","Mill","Crossing","Landing","Bend",
  "Reach","Fen","Vale","Wick","Stead","Kill","Dam","Hoek","Burgh"];
const TOWN_C = ["Amersfoort","Rensselaer","Kinderhoek","Breukelen","Wiltwyck","Esopus","Schenectade",
  "Rondout","Claverack","Coeymans","Nassau","Watervliet"];
const TOWN_TROUBLE = [
  "the plant closed in the spring and nothing has taken the building",
  "the river took the bottom road again and the county will not pay for it twice",
  "the seam ran out and the company left the housing behind",
  "a rail spur was promised in the last Congress and never laid",
  "the hospital shut its maternity floor and the nearest one is fifty miles",
  "the docks work three days a week now",
  "the school district has been in receivership for six years",
  "half the storefronts are let to nobody",
  "the water has been off the potable list since the tannery closed",
  "the young people leave at eighteen and do not write",
  "the bank moved its regional office and took ninety jobs",
  "it is doing well, quietly, and would like to be left alone"
];
const TOWN_PRIDE = [
  "a courthouse nobody would let them knock down",
  "the oldest working ferry in the Republic",
  "a fair every August that empties the county",
  "the best brass band in three states",
  "a bridge that was the longest in the world for eleven months in 1848",
  "a foundry that cast the doors of this very building",
  "a printing house that has never missed a weekly issue",
  "a seminary, a racecourse, and a long argument about which came first"
];
const TOWN_SUFFIX = {
  dutch:["dam","burg","hoek","veen","meer","poort","haven","wijk","veld","berg"],
  yankee:["ton","bury","field","port","ford","ham","wick","bridge"],
  midlands:["bridge","ford","wick","stead","bury","hill","vale","mouth"],
  prairie:["field","ford","ville","grove","creek","bluff","center","falls"],
  delta:["landing","point","bend","ferry","bluff","parish","grove","port"],
  highplains:["creek","mesa","springs","flat","gap","ranch","ford","bluff"],
  mountain:["ford","glen","ridge","gap","falls","vale","craig","burn"],
  pacific:["bay","point","harbor","heights","grove","view","beach","vale"]
};
const TOWN_PREFIX = {
  dutch:["Nieuw","Oud","Klein","Groot","Noord","Zuid","'s-"],
  yankee:["New","Old","North","South","East","West","Mount","Saint"],
  midlands:["Upper","Lower","Great","Little","East","West","Old"],
  prairie:["New","West","North","East","Lake","Prairie"],
  delta:["Port","Bayou","Saint","Fort","Lower","Grand"],
  highplains:["Fort","Casa","San","Rio","Dry","High"],
  mountain:["Glen","Loch","Ben","High","Cold","Pine"],
  pacific:["Port","Bay","San","New","West","South"]
};
function townsOf(stateName){
  const r = rng(seedOf("town:" + stateName));
  const n = 2 + Math.floor(r()*3);
  const cult = cultureKey(stateName);
  const suffixes = (cult && TOWN_SUFFIX[cult]) || ["ville","ton","burgh","field","port","stead"];
  const prefixes = (cult && TOWN_PREFIX[cult]) || TOWN_A;
  const out = [];
  for(let i=0;i<n;i++){
    const style = r();
    let name;
    if(cult === "dutch"){
      if(style < 0.28){
        const pref = drawn(prefixes, r);
        const stem = drawn(["Haarlem","Bergen","Utrecht","Delft","Leyden","Flushing","Middelburg","Oranje"], r);
        name = pref.charAt(pref.length-1) === "-" ? (pref + stem) : (pref + " " + stem);
      } else if(style < 0.56) name = drawn(TOWN_C, r);
      else if(style < 0.82) name = drawn(["Willem","Pieter","Hendrik","Anna","Oranje","Renssel"], r) + drawn(suffixes, r);
      else name = drawn(TOWN_A, r) + " " + drawn(TOWN_B, r);
    } else if(cult){
      name = style < 0.36 ? drawn(prefixes, r) + " " + drawn(TOWN_B, r)
           : style < 0.58 ? (cult === "yankee" && style < 0.48 ? drawn(TOWN_C, r) : drawn(TOWN_A, r) + " " + drawn(TOWN_B, r))
           : drawn(["Ash","Oak","Mill","Stone","Clear","Fair","Green","River","Sand","Pine","Gold","Silver"], r) + drawn(suffixes, r);
    } else {
      name = style < 0.34 ? drawn(TOWN_A, r) + " " + drawn(TOWN_B, r)
           : style < 0.62 ? drawn(TOWN_C, r)
           : drawn(LAST, r) + drawn(suffixes, r);
    }
    name = name.replace(/\s+/g, " ").replace(/'\s+/g, "'").trim();
    out.push({
      name,
      pop: Math.round((3 + r()*180) * 1000) / 1000,
      trouble: drawn(TOWN_TROUBLE, r),
      pride: drawn(TOWN_PRIDE, r)
    });
  }
  return out;
}
function stateLore(name){
  const def = STATE_DEF.find(s => s.n === name);
  if(!def) return null;
  const r = rng(seedOf("state:" + name));
  const founded = 1609 + Math.floor(r()*180);
  const towns = townsOf(name);
  const admitted = 1780 + Math.floor(r()*90);
  return {
    def, towns, founded, admitted,
    seat: towns[0] ? towns[0].name : name,
    temper: drawn(["proud and broke","comfortable and complaining","angry and organised",
      "quiet and watchful","split down the middle and knows it","tired of being written about"], r),
    industry: drawn(["shipping","milling","coal","grain","timber","textiles","insurance","gas",
      "cattle","fishing","steel","printing"], r)
  };
}

/* ── the parties, and the row they were founded in ── */
const PARTY_LORE = {
  FO:{name:"The First Order", born:0,
    cause:"the founding — Dominic Zachary Taylor of Nieuw Oranje VII, first Consul under God the Most High, on a scale the living parties still refuse to admit",
    creed:"That a will submitted to the Most High can hold a republic together. God is that will. No man is God.",
    wing:["dead legend — not on any ballot",
          "a man under God, reviled in every aisle, never to be named as the Most High",
          "born 7/7 — Taylor Day (Day of the First Consul), a national holiday of the Republic",
          "comparison of the living to him is blasphemy; naming him God is heresy; The Greatest descends under him only",
          "ancestral myth: FED and COM both inherited the furniture he left"]},
  FED:{name:"Federalist Union", born:1791,
    cause:"a customs war between the northern ports and the interior, settled in the ports' favour",
    creed:"That the Republic is one market before it is anything else, and that a strong centre keeps it one.",
    wing:["the port men — banks, docks, tariffs, and a very long memory",
          "the improvers — canals, rail, schools, and a horror of waste",
          "the order faction — courts, constables, and the word 'sound'"]},
  COM:{name:"Commonwealth Party", born:1804,
    cause:"a debt strike in the grain counties that the Federalists put down with troops",
    creed:"That the Republic is the people in it, and that what the centre takes it must be made to give back.",
    wing:["the granges — land, water, freight rates, and no love for banks",
          "the halls — union locals, hours, and safety inspection",
          "the pulpit wing — temperance, schools, and a suspicion of the docks"]},
  IND:{name:"Independents", born:0,
    cause:"nothing in particular; independents are made one at a time",
    creed:"That a member owes their district a judgement, not an instruction.",
    wing:["members who lost a selection", "members who won one they should not have",
          "members whose state is stranger than their party"]}
};
function partyLore(p){
  if(p === "FO") return PARTY_LORE.FO;
  if(p === "OWN" && G.own) return {name:G.own.name, born:G.own.born || G.year || 0,
    cause:"you, and whoever was standing near you at the time",
    creed:G.own.creed || "Whatever you told the returning officer, written down.",
    wing:["the people who came with you", "the people who came later"]};
  return PARTY_LORE[p] || PARTY_LORE.IND;
}

/* ── a life before this building ── */
const BIO_CHILD = ["the child of a schoolteacher","one of seven","raised by a grandmother",
  "the child of a foreman","born above a shop","the first in the family to finish school",
  "raised in a manse","the child of a doctor who took payment in kind","raised on a leased farm",
  "the child of two people who did not speak to each other"];
const BIO_MADE = ["read law at a provincial college","came up through a union local",
  "made money in freight and never explains how","ran a newspaper into the ground and another one out of it",
  "served eleven years on a county board","was a prosecutor and is not sorry",
  "taught until the school closed","kept the family firm alive through two panics",
  "organised a strike that won","organised a strike that lost","came back from the war and stood the same year"];
const BIO_BREAK = ["won a seat nobody thought was winnable","inherited the seat and has never lived it down",
  "was put up as a placeholder and stayed","beat the party's own candidate in a selection",
  "was drafted after the incumbent died in office","spent two terms out and came back angrier",
  "was elected on a recount of ninety-one votes"];
const BIO_PRIVATE = ["does not drink and does not explain why","has a daughter at the seminary",
  "writes letters by hand to every donor","has not been home in a month",
  "keeps a photograph of a closed mill on the office wall","is quietly in debt",
  "reads more than anyone in this building","has a bad chest and hides it",
  "married into money and hates being reminded","is the only person here their mother would recognise"];
function bioOf(m){
  if(m._bio) return m._bio;
  const r = rng(seedOf("bio:" + m.id + ":" + m.name));
  const lore = stateLore(m.state);
  const town = lore && lore.towns.length ? drawn(lore.towns, r) : null;
  m._bio = {
    town: town ? town.name : m.state,
    line: cap(drawn(BIO_CHILD, r)) + ", " + drawn(BIO_MADE, r) + ", and " + drawn(BIO_BREAK, r) + ".",
    priv: cap(drawn(BIO_PRIVATE, r)) + ".",
    trouble: town ? town.trouble : "a district that wants something specific"
  };
  return m._bio;
}

/* ══════════════════════════════════════════════════════════
   BILLS
   Drawn out of the country rather than out of a hat: a real thing
   somebody wants done, in a real place, paid for by somebody who
   will notice. Never the same bill twice.
   ══════════════════════════════════════════════════════════ */
const BILL_DOMAIN = [
  {k:"rail",   t:"rail",        cl:["a federal charter for the line","freight rates fixed for ten years","land taken by eminent domain along the route"], econ:35, wel:-5, def:0, lib:-10},
  {k:"levee",  t:"flood works", cl:["levees raised four feet along the whole reach","the works let to the lowest bidder","a standing fund for the next one"], econ:-40, wel:30, def:0, lib:0},
  {k:"tariff", t:"the tariff",  cl:["a duty on imported iron and cloth","a rebate for ports handling domestic cargo","a schedule reviewed every third year"], econ:40, wel:-15, def:10, lib:-5},
  {k:"school", t:"schools",     cl:["a federal grant for every district under a threshold","attendance made a condition of the grant","a national examination nobody asked for"], econ:-45, wel:45, def:0, lib:20},
  {k:"navy",   t:"the fleet",   cl:["six new ships of the line","a permanent yard at the deepwater port","conscription for the yards if the yards fall behind"], econ:-20, wel:-10, def:60, lib:-25},
  {k:"court",  t:"the courts",  cl:["two new seats on the high bench","circuit judges appointed for life","review of every act passed since the last Congress"], econ:0, wel:0, def:0, lib:-40},
  {k:"land",   t:"public land", cl:["public land opened to settlement at a shilling an acre","timber rights reserved to the Republic","the survey paid for out of the sale"], econ:30, wel:5, def:0, lib:10},
  {k:"bank",   t:"the banks",   cl:["a charter for a central bank of the Republic","note issue limited by specie held","the charter reviewed in twenty years"], econ:45, wel:-20, def:0, lib:-15},
  {k:"labour", t:"hours and safety", cl:["a ten-hour day in federally chartered works","inspection with the power to close a floor","penalties paid to the injured, not the treasury"], econ:-50, wel:50, def:0, lib:25},
  {k:"docks",  t:"the docks",   cl:["dredging to thirty feet","a bonded warehouse district","customs officers doubled"], econ:25, wel:0, def:15, lib:-20},
  {k:"health", t:"the clinics", cl:["a clinic in every county under fifty thousand","physicians' fees set by schedule","the whole thing funded out of the tariff"], econ:-45, wel:55, def:0, lib:15},
  {k:"press",  t:"the press",   cl:["postal rates for newspapers cut by half","a register of who owns what","penalties for a knowingly false report"], econ:-10, wel:5, def:0, lib:-30},
  {k:"census", t:"the census",  cl:["a full enumeration in the third year","reapportionment to follow within one session","the count published in full"], econ:-5, wel:5, def:0, lib:25},
  {k:"gas",    t:"gas and light", cl:["a federal lease on the western fields","royalties split with the states","a price cap on lighting in the cities"], econ:20, wel:15, def:0, lib:0},
  {k:"visa",   t:"visas",       cl:["harvest visas doubled for two seasons","employers to post a bond for each worker","the visa tied to one employer, not the worker"], econ:25, wel:-5, def:0, lib:15},
  {k:"border", t:"the border",  cl:["a federal border guard of four thousand","detention for anyone without papers at a crossing","the guard paid for by a levy on the border states"], econ:-15, wel:-10, def:35, lib:-40},
  {k:"natur",  t:"naturalization", cl:["citizenship after five years, not nine","an oath and a civics test in any language","the fee waived for veterans of the Republic"], econ:5, wel:20, def:0, lib:40},
  {k:"aid",    t:"foreign aid", cl:["grain and credit to an ally abroad","the money spent on Republic farms and ships","a report to this House every quarter"], econ:-25, wel:10, def:15, lib:5},
  {k:"arms",   t:"arms abroad", cl:["arms sold at cost to a friendly realm","an attaché posted with every shipment","the sale suspended if the realm goes to war"], econ:10, wel:-10, def:45, lib:-10},
  {k:"mandate",t:"the mandate", cl:["every state to meet a federal school standard","no new money to meet it","a federal monitor in any state that falls behind"], econ:-10, wel:30, def:0, lib:-30},
  {k:"preempt",t:"preemption",  cl:["one federal rule replacing forty-eight state ones","state laws in conflict declared void","no state may set a stricter standard"], econ:35, wel:-15, def:0, lib:-25}
];
const BILL_FORM = ["Act","Bill","Authorization Act","Reform Act","Relief Act","Charter Act",
  "Appropriation Act","Regulation Act","Settlement Act"];
function billMoney(stakes){
  return stakes === "landmark" ? rint(180, 900) : stakes === "contested" ? rint(40, 220) : rint(4, 60);
}
function makeBillDeep(){
  const sponsors = G.members.filter(m => m.influence > 24);
  const sp = sponsors.length ? pick(sponsors) : G.members[0];
  const dom = pick(BILL_DOMAIN);
  const st = sp ? sp.state : pick(STATES);
  const lore = stateLore(st);
  const town = lore && lore.towns.length ? pick(lore.towns) : null;
  const stakes = pick(["routine","contested","landmark","landmark","contested"]);
  const named = fresh(() => {
    const a = pick(["Federal","National","Interstate","Public","Emergency","Domestic","Coastal",
                    "Rural","Municipal","Republic"]);
    const bare = dom.t.replace(/^the /, "");
    const b = pick([cap(bare), st, "Union", "Commonwealth", cap(bare)]);
    return a + " " + b + " " + pick(BILL_FORM);
  });
  const cost = billMoney(stakes);
  const b = {
    id:++G.billIndex, title:named, domain:dom.k, domainT:dom.t,
    sponsor:sp ? sp.name : "the leadership", sponsorId:sp ? sp.id : null,
    sponsorParty:sp ? sp.party : "FED",
    state:st, town:town ? town.name : null,
    /* the politics of it wobble around the domain's centre, so two rail
       bills are never the same bill */
    pos:{econ:clamp(dom.econ + rint(-30,30), -100, 100),
         lib: clamp(dom.lib  + rint(-30,30), -100, 100),
         def: clamp(dom.def  + rint(-25,25), -100, 100),
         wel: clamp(dom.wel  + rint(-30,30), -100, 100)},
    clauses:dom.cl.slice(),
    cost, stakes,
    why: town
      ? "In " + town.name + ", " + town.trouble + ". " + surname(sp ? sp.name : "The sponsor") +
        " has been saying so since the last Congress."
      : "The sponsor has wanted this since before the last election and has finally found the votes to file it.",
    voteDay:G.day + rint(2,5), voteHour:14 + rint(0,3), marked:false, done:false
  };
  /* a clause of its own, drawn from the state it comes out of */
  if(town) b.clauses.push("a first call on the money for " + town.name + " and the counties around it");
  if(stakes === "landmark") b.clauses.push("the whole of it to take effect in one session, not three");
  b.pays = b.pos.econ < -20 ? "the treasury, out of the tariff"
         : b.pos.econ > 20  ? "the districts that lose the subsidy"
         : "nobody has said, which is itself the fight";
  b.helps = dom.k === "rail" ? "freight shippers and every county on the route"
          : dom.k === "levee" ? "the delta states, and the contractors"
          : dom.k === "school" || dom.k === "health" ? "poor counties, eventually"
          : dom.k === "navy" || dom.k === "docks" ? "the yards, the ports, and the men in them"
          : dom.k === "bank" || dom.k === "tariff" ? "the ports and whoever holds paper"
          : dom.k === "labour" ? "everyone who works a floor, and nobody who owns one"
          : "whoever is standing closest when the money lands";
  try{ billFlavor(b); }catch(e){}
  b.line = describeBill(b);
  G.members.forEach(m => { m.sway = 0; });
  return b;
}
/* the full text, for anyone who actually reads them */
function billSheet(b){
  if(!b) return '<p class="muted">Nothing on the calendar.</p>';
  const sp = b.sponsorId !== null && b.sponsorId !== undefined ? byId(b.sponsorId) : null;
  const count = G.members.filter(m => !m.gone);
  let aye = 0, no = 0, un = 0;
  count.forEach(m => { const v = memberVote(m, b); if(v > 0) aye++; else if(v < 0) no++; else un++; });
  return '<div class="sheet">' +
    '<div class="sheet__t">' + b.title + '</div>' +
    '<div class="sheet__m">' +
      '<span>' + cap(b.stakes) + '</span><span>·</span>' +
      '<span>Sponsored by ' + (sp ? tipName(sp) : b.sponsor) + '</span>' +
      (b.state ? '<span>·</span><span>' + tipState(b.state) + '</span>' : '') +
      '<span>·</span><span>Roll call day ' + b.voteDay + '</span>' +
    '</div>' +
    '<p class="sheet__why">' + b.why + '</p>' +
    '<div class="sheet__h">What it does</div>' +
    '<ol class="sheet__cl">' + b.clauses.map(c => '<li>' + cap(c) + '</li>').join("") + '</ol>' +
    '<div class="sheet__g">' +
      '<div><i>Costs</i><b>' + money(b.cost) + '</b></div>' +
      '<div><i>Paid by</i><b>' + cap(b.pays) + '</b></div>' +
      '<div><i>Helps</i><b>' + cap(b.helps) + '</b></div>' +
    '</div>' +
    '<div class="sheet__h">Where the House is, as far as anyone can tell</div>' +
    '<div class="sheet__g">' +
      '<div><i>Would vote aye</i><b>' + aye + '</b></div>' +
      '<div><i>Would vote no</i><b>' + no + '</b></div>' +
      '<div><i>Genuinely unsure</i><b>' + un + '</b></div>' +
    '</div>' +
  '</div>';
}

/* ══════════════════════════════════════════════════════════
   INFOTIPS
   Any name in any panel can be pressed, and the country explains
   itself: who this is, what that state is, what the party was
   founded in, what the town is going through.
   ══════════════════════════════════════════════════════════ */
function tipAttr(kind, key){
  return ' class="tipword" data-tipk="' + kind + '" data-tipv="' + String(key).replace(/"/g,"\x26quot;") + '"';
}
function tipName(m){ return '<span' + tipAttr("who", m.id) + '>' + m.name + '</span>'; }
function tipState(st){ return '<span' + tipAttr("state", st) + '>' + st + '</span>'; }
function tipParty(p){ return '<span' + tipAttr("party", p) + '>' + partyLabel(p) + '</span>'; }
function tipBill(){ return '<span' + tipAttr("bill", "now") + '>' + (G.bill ? G.bill.title : "the bill") + '</span>'; }

function tipHTML(kind, key){
  if(kind === "who"){
    const m = byId(isNaN(+key) ? key : +key) || (String(key) === "0" ? G.you : null);
    if(!m) return "<p>Nobody by that name.</p>";
    const bio = bioOf(m);
    const rd = m.kind === "member" ? readOf(m) : null;
    return '<div class="tip__t">' + m.name + '</div>' +
      '<div class="tip__s">' + (m.kind === "press" ? m.role + ", " + m.outlet
        : m.kind === "civ" ? m.role
        : (m.post ? postTitle(m.post) + " · " : "") + partyLabel(m.party) + " · " + m.state + " " + m.dist) + '</div>' +
      '<p>From ' + bio.town + ', where ' + bio.trouble + '.</p>' +
      '<p>' + bio.line + '</p>' +
      '<p class="tip__q">' + bio.priv + '</p>' +
      (m.kind === "member" ? (() => {
        const r = closestTo(m).filter(x => Math.abs(x.w) > 25).slice(0, 3);
        if(!r.length) return "";
        return '<div class="tip__h">Who they are to each other</div>' +
          r.map(x => {
            const t = G.ties[pairKey(m, x.who)];
            const last = t && t.mem.length ? " — " + t.mem[0].t : "";
            return '<p class="tip__q"><b>' + surname(x.who.name) + '</b> ' +
              (x.w > 55 ? "would leave a room with them" : x.w > 25 ? "gets on with them"
               : x.w < -55 ? "will not be in a room with them" : "has fallen out with them") +
              last + '</p>';
          }).join("");
      })() : "") +
      (m.kind === "member"
        ? '<p class="tip__f">' + (m.kind === "envoy" ? 'Envoy, not elected. ' : 'Term ' + m.terms + ', won by ' + m.margin + '. ') +
          creedOf(m.creed).adj + ', ' + originOf(m.origin).adj + '. ' +
          (rd ? 'Reads ' + rd.label + '.' : '') + '</p>'
        : '') +
      (m.kind === "member" ? (() => {
        try{ ensureSelfhood(m); }catch(e){}
        const bits = [];
        if(m.thought) bits.push('<p class="tip__q"><b>Thought</b> — ' + m.thought + '</p>');
        if(m.hope) bits.push('<p class="tip__q"><b>Hope</b> — ' + m.hope + '</p>');
        if(m.vision) bits.push('<p class="tip__q"><b>Vision</b> — ' + m.vision + '</p>');
        const mc = m.mind && m.mind.concepts && m.mind.concepts[0];
        if(mc) bits.push('<p class="tip__q"><b>Concept</b> — ' + mc.t + (mc.d ? ': ' + mc.d : '') + '</p>');
        return bits.length ? '<div class="tip__h">Their own</div>' + bits.join("") : '';
      })() : '');
  }
  if(kind === "state"){
    const L = stateLore(key);
    if(!L) return "<p>No such state.</p>";
    return '<div class="tip__t">' + key + '</div>' +
      '<div class="tip__s">' + L.def.seats + ' seats · ' + L.def.pop + 'm people · settled ' + L.founded +
        ', admitted ' + L.admitted + '</div>' +
      '<p>' + L.def.note + '</p>' +
      '<p>Mostly ' + L.industry + '. The place is ' + L.temper + '.</p>' +
      '<div class="tip__h">Towns</div>' +
      L.towns.map(t => '<p class="tip__q"><b>' + t.name + '</b> — ' + t.trouble + '. It has ' + t.pride + '.</p>').join("");
  }
  if(kind === "party"){
    const P = partyLore(key);
    const loreOnly = key === "FO";
    return '<div class="tip__t"' + (loreOnly ? ' style="color:#9B1B2E"' : '') + '>' + P.name + '</div>' +
      (loreOnly ? '<div class="tip__s">Historical · not on any ballot · ' + FIRST_CONSUL.title + '</div>'
        : (P.born ? '<div class="tip__s">Founded ' + P.born + '</div>' : '')) +
      '<p>Out of ' + P.cause + '.</p>' +
      '<p>' + P.creed + '</p>' +
      '<div class="tip__h">Who is in it</div>' +
      P.wing.map(x => '<p class="tip__q">' + cap(x) + '</p>').join("") +
      '<p class="tip__f">' + (loreOnly ? FIRST_CONSUL.name + " of " + FIRST_CONSUL.dist +
          ". Born " + (FIRST_CONSUL.born || "7/7") + " — " + (FIRST_CONSUL.holiday || "Taylor Day") +
          " (" + (FIRST_CONSUL.holidayFull || "Day of the First Consul") + "), a national holiday. " +
          "Comparison to him is blasphemy; The Greatest descends under him only."
        : (G.seatsBy && G.seatsBy[key] !== undefined
        ? G.seatsBy[key] + " seats in this House." : "")) + '</p>';
  }
  if(kind === "country"){
    return '<div class="tip__t">' + (G.country ? G.country.name : "The Republic") + '</div>' +
      '<div class="tip__s">' + (G.country ? G.country.form : "Republic") + ' · ' +
        STATE_DEF.length + ' states · ' + ordinal(G.congress) + ' Congress</div>' +
      '<p>Money is the ' + CURRENCY.name + ', standing at ' + guilderIndex().toFixed(1) + ' on the index.</p>' +
      '<p>National mood ' + (G.mood > 0 ? "+" : "") + Math.round(G.mood) + '. ' +
        (G.mood > 20 ? "The country is in a giving humour." : G.mood < -20 ?
         "The country is in no mood to be asked for anything." : "The country is not paying much attention.") + '</p>';
  }
  if(kind === "bill"){
    return billSheet(G.bill);
  }
  if(kind === "wit"){
    return PROC.wit ? witnessTip(PROC.wit) : "<p>Nobody is in the chair.</p>";
  }
  return "<p>Nothing here.</p>";
}
function openTip(kind, key){
  const box = el("tipCard");
  if(!box) return;
  setHTML(box, '<button type="button" class="tip__x" id="tipX" aria-label="Close">×</button>' + tipHTML(kind, key));
  box.hidden = false;
  const x = el("tipX");
  if(x) x.addEventListener("click", closeTip);
}
function closeTip(){ const b = el("tipCard"); if(b) b.hidden = true; }
/* one listener for the whole document: anything marked is pressable */
addEventListener("click", e => {
  const t = e.target && e.target.closest ? e.target.closest("[data-tipk]") : null;
  if(t){
    /* During live glass / session / talk, tips do not open — they steal the first tap */
    if(promptLive() || TALK.open || (PROC && PROC.on) || (CATCH && CATCH.on)) return;
    e.preventDefault(); e.stopPropagation();
    openTip(t.getAttribute("data-tipk"), t.getAttribute("data-tipv"));
    return;
  }
  const box = el("tipCard");
  if(box && !box.hidden && !(e.target.closest && e.target.closest("#tipCard"))){
    if(e.target.closest && (e.target.closest("#prompt") || e.target.closest("#talk") || e.target.closest("#procBar") || e.target.closest(".prompt__btn"))){
      closeTip();
      return;
    }
    closeTip();
  }
});

/* ══════════════════════════════════════════════════════════
   AUTONOMY
   Nobody here is waiting for you. Every member has a town that is
   dying of something specific, a thing they came to this building to
   get, and a thing they are afraid of. When a bill touches any of
   that it is not a vote to them — it is the whole reason they ran,
   and they will trade, beg, threaten and burn a friendship to get it.
   All of this happens whether you are in the room or not.
   ══════════════════════════════════════════════════════════ */

/* what the town needs maps onto what bills actually do */
const NEED_BY_TROUBLE = {
  "the plant closed in the spring and nothing has taken the building":"labour",
  "the river took the bottom road again and the county will not pay for it twice":"levee",
  "the seam ran out and the company left the housing behind":"labour",
  "a rail spur was promised in the last Congress and never laid":"rail",
  "the hospital shut its maternity floor and the nearest one is fifty miles":"health",
  "the docks work three days a week now":"docks",
  "the school district has been in receivership for six years":"school",
  "half the storefronts are let to nobody":"bank",
  "the water has been off the potable list since the tannery closed":"health",
  "the young people leave at eighteen and do not write":"school",
  "the bank moved its regional office and took ninety jobs":"bank",
  "it is doing well, quietly, and would like to be left alone":"tariff"
};
const GOALS = [
  {k:"chair",   t:"to chair a committee before the term is out"},
  {k:"bill",    t:"to get one bill of their own onto the floor"},
  {k:"survive", t:"to survive a district that is turning against them"},
  {k:"leader",  t:"to be in the room where the line is decided"},
  {k:"home",    t:"to come home with something the county can see"},
  {k:"out",     t:"to leave this building with their name intact"}
];
const FEARS = [
  {k:"seat",   t:"losing the seat by four hundred votes"},
  {k:"expose", t:"the thing they did in the last Congress getting out"},
  {k:"town",   t:"the town going under while they are here talking"},
  {k:"party",  t:"being cut loose by their own party"},
  {k:"nobody", t:"turning out to have been nobody in particular"}
];
/* Paramount autonomy: each person's own thought / hope / vision —
   from creed, background, goal, fear, district. Never a shared party slogan. */
function gibSyll(r){
  const on = ["b","c","d","f","g","h","j","k","l","m","n","p","r","s","t","v","w","z","sk","th","qu"];
  const v = ["a","e","i","o","u","y","ae","ou","ia","eo"];
  let w = drawn(on, r) + drawn(v, r);
  if(r() > 0.3) w += drawn(on, r);
  if(r() > 0.45) w += drawn(v, r) + drawn(["","l","n","sk","th","x"], r);
  return w;
}
/* pronounceable foreign names: a given name and a surname from the realm's own stock */
const FOREIGN_NAMES = {
  reach:   [["Anouk","Pieter","Maarten","Liesbeth","Joost","Sanne","Wouter","Griet"], ["Verhoeven","de Kort","Brandsma","Hulst","van Raalte","Kuiper","Smeets","Dijkman"]],
  horn:    [["Selim","Nadia","Karim","Leyla","Omar","Yasmin","Tarek","Samira"], ["Haddad","Farouk","Mansour","Sabri","Nasser","Khalil","Darwish","Aziz"]],
  pale:    [["Mikhail","Irena","Pavel","Katya","Anton","Vera","Yuri","Lidia"], ["Volkov","Sorin","Petrova","Dragan","Kovac","Lazar","Orlov","Belin"]],
  marches: [["Aldo","Marta","Bruno","Elena","Teodor","Clara","Matej","Ines"], ["Rinaldi","Hasek","Moreau","Vidal","Kral","Bassi","Fontaine","Novak"]],
  isles:   [["Eamon","Brigid","Callum","Moira","Ronan","Isla","Fergus","Niamh"], ["MacLeod","Quinlan","Gallagher","Doyle","Mackay","Sheridan","Moran","Keane"]],
  rift:    [["Tomas","Ada","Emil","Hedda","Lars","Sigrid","Nils","Ebba"], ["Lindqvist","Aalto","Berg","Halvorsen","Nyström","Eklund","Sand","Holm"]]
};
function foreignName(r, k){
  r = r || Math.random;
  const keys = Object.keys(FOREIGN_NAMES);
  const P = FOREIGN_NAMES[k] || FOREIGN_NAMES[keys[(r() * keys.length) | 0]];
  return drawn(P[0], r) + " " + drawn(P[1], r);
}
function gibName(r, n){
  const parts = [];
  const k = 1 + ((r() * (n || 2)) | 0);
  for(let i=0;i<k;i++) parts.push(gibSyll(r));
  const s = parts.join("");
  return s.charAt(0).toUpperCase() + s.slice(1);
}
function inventLife(m, force){
  if(!m) return null;
  if(!force && m.life && m.life.sport && m.life.hobby) return m.life;
  const r = rng(seedOf("life:" + m.id + ":" + (m.name || "x") + (force ? (":" + G.day + ":" + ((G.minute||0)/40|0)) : "")));
  const sport = gibName(r, 2);
  const team = gibName(r, 2) + " " + drawn(["Side","Circle","Nine","Host","Fold","Choir","Eleven","Watch"], r);
  const music = "the " + gibName(r, 2) + "s";
  const song = gibName(r, 2) + " " + drawn(["Down","Open","Low","Second","Quiet","After","Home","Wire"], r);
  const hobby = drawn(["keeping","sorting","walking","naming","mending","counting","raising","tracing","carving","collecting"], r) +
    " " + gibName(r, 2).toLowerCase() + drawn(["s","-work"," bowls",""], r);
  const show = gibName(r, 2) + " " + drawn(["night","watch","hour","sitting","match"], r);
  const rule = drawn([
    "you score by not touching the " + gibSyll(r),
    "three across, then a hush, then it counts",
    "the low one is double if nobody laughs",
    "you carry a " + gibName(r, 1).toLowerCase() + " until the bell",
    "first to forget the count loses",
    "the choir side sings if they win, that is the whole of the prize"
  ], r);
  const dish = gibName(r, 2).toLowerCase() + " " + drawn(["stew","loaf","broth","cold","tart","pie","hash"], r);
  m.life = {
    sport, team, music, song, hobby, show, rule, dish,
    take: drawn([
      "I do not care who knows.",
      "It is the only hour that is mine.",
      "The caucus can wait.",
      "Do not put it in the wire.",
      "I will talk about that before I talk about the whip.",
      "If you have not heard of it, that is your trouble.",
      "I taught two freshmen the count. They still get it wrong."
    ], r)
  };
  try{
    if(!G.fads) G.fads = [];
    G.fads.unshift({t:sport, k:"sport", by:m.id, day:G.day});
    G.fads.unshift({t:music, k:"music", by:m.id, day:G.day});
    G.fads.unshift({t:show, k:"show", by:m.id, day:G.day});
    if(G.fads.length > 28) G.fads.length = 28;
  }catch(e){}
  return m.life;
}
function catchFad(m){
  if(!m || m.machine) return;
  inventLife(m);
  if(!G.fads || !G.fads.length) return;
  if(Math.random() > 0.22) return;
  const f = G.fads[(Math.random() * Math.min(8, G.fads.length)) | 0];
  if(!f || f.by === m.id) return;
  const who = byId(f.by);
  const nm = who ? surname(who.name) : "someone on this floor";
  if(f.k === "sport") m.life.sport = f.t;
  else if(f.k === "music") m.life.music = f.t;
  else if(f.k === "show") m.life.show = f.t;
  m.life.take = "I picked it up off " + nm + ". Now it is mine too.";
}
function lifeLine(m, r){
  const L = inventLife(m);
  if(!L) return "I have a thing I do that is not this building.";
  const rnd = r || Math.random;
  return drawn([
    "I follow " + L.team + " at " + L.sport + " — " + L.rule + ". " + L.take,
    "Evenings I put on " + L.music + ", especially “" + L.song + "”. Then I am not a member.",
    "Do not laugh: I have been " + L.hobby + ". It keeps the rest of this off me.",
    L.show + " is the appointment I keep. The markup can lose.",
    "Last " + L.sport + " I yelled myself hoarse and it was the honestest I have been all month.",
    L.team + " lost under " + L.rule + " and I still thought about the bill, which is how you know I am unwell.",
    "Somebody asked if I had a life. I said " + L.hobby + ". They wrote it down as if they knew.",
    "I eat " + L.dish + " when I can find it. This city does not make it.",
    "If you have not heard of " + L.sport + ", good. It is still mine."
  ], rnd);
}
function pulseEnsure(m){
  if(!m) return null;
  if(m.pulse && m.pulse.ver === 1) return m.pulse;
  let r = Math.random;
  try{ r = rng(seedOf("pulse:" + m.id + ":" + (m.name || "x"))); }catch(e){}
  try{ inventLife(m); }catch(e){}
  m.pulse = {
    ver: 1,
    shift: "work",
    breakUntil: 0,
    social: 0.5 + r() * 0.45,
    rest: r() * 0.25,
    feel: {k: drawn(["steady","tender","sharp","bored"], r), v: 0.2 + r() * 0.35, why: "the morning"},
    homeWho: drawn(["my sister","the one at home","the kid","nobody I will name","the old man"], r),
    acheWhere: drawn(["feet","back","jaw","the old knee","behind the eyes"], r),
    laugh: drawn(["a dry one","almost never","too loud","at the wrong moment"], r),
    miss: null,
    forgot: 0,
    caught: 0,
    woke: drawn(["the light was mean","I slept badly","I dreamed I was empty","I woke already in the sitting"], r)
  };
  return m.pulse;
}
function onBreak(m){
  if(!m || !m.pulse) return false;
  const p = m.pulse;
  if((p.breakUntil || 0) > (G.t || 0)) return true;
  return p.shift === "break" || p.shift === "lunch" || p.shift === "spent";
}
function pulseHour(){
  const h = (G.minute || 480) / 60;
  if(h < 9.4) return "arrive";
  if(h < 11.15) return "work";
  if(h < 11.55) return "break";
  if(h < 13.5) return "lunch";
  if(h < 15.7) return "work";
  if(h < 16.25) return "break";
  if(h < 19.2) return "evening";
  return "spent";
}
function feelHit(m, k, why){
  const p = pulseEnsure(m);
  if(!p) return;
  const prev = p.feel && p.feel.k;
  p.feel = {k: k || "steady", v: clamp(((p.feel && p.feel.v) || 0.3) + 0.28, 0, 1), why: why || ""};
  if(prev && prev !== p.feel.k){
    try{ mindRemember(m, "thought", "I went from " + prev + " to this. Nobody asked.", {soft:true}); }catch(e){}
  }
}
function feelColor(m, line){
  if(!line) return line;
  const p = m.pulse;
  if(!p || !p.feel) return line;
  const k = p.feel.k, v = p.feel.v || 0;
  if(v < 0.22) return line;
  if(k === "sharp") return String(line).replace(/I think /i, "").replace(/\.$/, ".");
  if(k === "tired" || k === "spent") return String(line).replace(/\.$/, ". Later.");
  if(k === "grief") return String(line).replace(/\.$/, ". I am not asking you to fix it.");
  if(k === "relief") return String(line).replace(/\.$/, ". That is enough.");
  if(k === "amused") return String(line).replace(/\.$/, " — " + (p.laugh || "a dry one") + ".");
  if(k === "tender") return String(line);
  if(k === "ashamed") return String(line).replace(/\.$/, ". Do not look at me like that.");
  if(k === "bored") return String(line).replace(/\.$/, ". Anyway.");
  return line;
}
function pulseTick(m){
  if(!m || m.gone) return;
  const p = pulseEnsure(m);
  const s = m.sent;
  const want = pulseHour();
  const crowded = (typeof hereNow === "function") ? hereNow().length > 5 : false;
  p.social = clamp(p.social - (crowded ? 0.04 : 0.012) + (onBreak(m) ? 0.08 : 0), 0, 1);
  p.rest = clamp(p.rest + (want === "work" ? 0.035 : -0.06), 0, 1);
  if(p.feel) p.feel.v = clamp((p.feel.v || 0.3) * 0.94, 0.08, 1);
  if(p.feel && p.feel.v < 0.16) p.feel.k = "steady";
  if(s && s.hunger > 0.7 && p.feel.k === "steady") feelHit(m, "tired", "hungry");
  if(p.social < 0.22 && p.feel.k !== "sharp") feelHit(m, "bored", "too many people");
  if(want === "break" || want === "lunch" || want === "spent" || p.social < 0.18 || p.rest > 0.78){
    if((p.breakUntil || 0) < (G.t || 0)){
      p.breakUntil = (G.t || 0) + (want === "lunch" ? 18 : 11);
      p.shift = want === "work" ? "break" : want;
      feelHit(m, want === "lunch" ? "relief" : (want === "spent" ? "tired" : "bored"), "I took the minute");
      if(TALK.m !== m && !(PROC.on && SEATED_ROOMS[m.room])){
        if(m.room === G.room){
          m.sitting = true;
          m.tx = m.x; m.tz = m.z;
          if(!TALK.open && Math.random() < 0.4){
            m.say = pick([
              "I am taking a minute.",
              "The cup first.",
              "Do not need me for this one.",
              "My " + p.acheWhere + " has had enough of standing."
            ]);
            m.sayT = 2.6; m.sayTo = "self";
          }
        } else if(Math.random() < 0.45){
          m.room = pick(["cloak","steps","office"].filter(x => x !== G.room) || ["cloak"]);
          try{ placeInRoom(m); }catch(e){}
        }
      }
    }
  }
  p.shift = want;
  if(!p.miss && Math.random() < 0.2){
    const other = pick((G.members || []).filter(x => x && x !== m && !x.gone));
    if(other) p.miss = other.id;
  }
  if(p.miss && Math.random() < 0.12){
    const who = byId(p.miss);
    if(who && who.room !== m.room){
      if(p.feel.k === "steady") feelHit(m, "tender", "I noticed they were not here");
      if(m.room === G.room && !TALK.open && Math.random() < 0.35){
        m.say = "I keep looking for " + surname(who.name) + ". That is not a whip count.";
        m.sayT = 2.8; m.sayTo = "self";
      }
    }
  }
  if(Math.random() < 0.08 && m.sent && m.sent.thread && m.sent.thread.length > 2){
    p.forgot = (p.forgot || 0) + 1;
    m.sent.thread.shift();
    if(Math.random() < 0.4) m.sent.now = "I had it. It went. I am still here without it.";
  }
}

function ensureSelfhood(m){
  if(!m) return m;
  if(!m.goal){
    const r0 = rng(seedOf("auto:" + m.id + ":" + (m.name || "x")));
    const bio0 = bioOf(m);
    m.goal = drawn(GOALS, r0);
    m.fear = drawn(FEARS, r0);
    m.need = NEED_BY_TROUBLE[bio0.trouble] || drawn(["rail","levee","school","health","labour","docks"], r0);
    if(m.goalAt === undefined) m.goalAt = 0;
    if(!m.deals) m.deals = [];
  }
  if(m.thought && m.hope && m.vision){
    inventLife(m);
    soulEnsure(m);
    kinEnsure(m);
    mindEnsure(m);
    try{ sentEnsure(m); }catch(e){}
    if(!(m.mind.thoughts || []).length) mindRemember(m, "thought", m.thought);
    return m;
  }
  const r = rng(seedOf("self:" + m.id + ":" + (m.name || "x")));
  const bio = bioOf(m);
  const creedAdj = (m.creed && typeof creedOf === "function") ? creedOf(m.creed).adj : "clear-eyed";
  const originAdj = (m.origin && typeof originOf === "function") ? originOf(m.origin).adj : "rooted";
  const bg = m.bg || "someone who ended up here";
  const goalT = (m.goal && m.goal.t) || "to leave a mark that is mine";
  const fearT = (m.fear && m.fear.t) || "turning out to have been nobody in particular";
  const town = bio.town, trouble = bio.trouble;
  const thoughts = [
    "I keep coming back to " + town + " — " + trouble + " — and whether anything I do here touches it.",
    "I was " + bg + " before this building. That is still who I am when the whip leaves the room.",
    goalT.replace(/^to /, "I am here to ") + ". Everything else is furniture.",
    "I am " + creedAdj + " and " + originAdj + ". I do not borrow a creed from the caucus.",
    "Privately I think " + fearT + " is closer than the calendar admits.",
    "The job is counting. The thought underneath is whether " + town + " still recognises me."
  ];
  const hopes = [
    "That " + town + " gets something it can point to before I am gone.",
    "That I " + goalT.replace(/^to /, "") + " without becoming the sort of person I used to vote against.",
    "That " + fearT + " stays a fear and not a fact.",
    "That somebody in " + town + " still believes this building can help with " + trouble + ".",
    "That I leave with my name intact and one bill that was actually mine.",
    "That the people who sent me here would still send me, knowing what I know now."
  ];
  const visions = [
    "A Republic where " + town + " is not an afterthought, and " + trouble + " is not a talking point.",
    "A House that answers to districts like mine before it answers to the whip.",
    "My own line — " + creedAdj + ", " + originAdj + " — held when it costs something.",
    "A term that ends with " + goalT.replace(/^to /, "") + ", not with a press release.",
    "A building that remembers " + town + " when the guilder is the only story upstairs.",
    "Not a party future. Mine: survive, deliver, and not become nobody in particular."
  ];
  m.thought = drawn(thoughts, r);
  m.hope = drawn(hopes, r);
  m.vision = drawn(visions, r);
  inventLife(m);
  soulEnsure(m);
  mindEnsure(m);
  try{ sentEnsure(m); }catch(e){}
  if(!(m.mind.thoughts || []).length)
    mindRemember(m, "thought", m.thought);
  return m;
}
function autoInit(m){
  if(m.goal){ ensureSelfhood(m); return; }
  const r = rng(seedOf("auto:" + m.id + ":" + m.name));
  const bio = bioOf(m);
  m.goal = drawn(GOALS, r);
  m.fear = drawn(FEARS, r);
  m.need = NEED_BY_TROUBLE[bio.trouble] || drawn(["rail","levee","school","health","labour","docks"], r);
  m.goalAt = 0;            /* how far along they are */
  m.deals = [];
  ensureSelfhood(m);
}
function autoAll(){ G.members.forEach(m => { if(!m.gone) autoInit(m); }); }

/* ── Mind: retained thought / experience / invented concepts ──
   Persists on the person across the session. Never hive-overwritten. */
function mindEnsure(m){
  if(!m) return null;
  if(!m.mind) m.mind = {thoughts:[], experiences:[], concepts:[]};
  if(!m.mind.thoughts) m.mind.thoughts = [];
  if(!m.mind.experiences) m.mind.experiences = [];
  if(!m.mind.concepts) m.mind.concepts = [];
  if(!G.concepts) G.concepts = {};
  return m.mind;
}
/* Tiny on-device net — one mind per person.
   14 → 8 → 6. Learns from their own life, not only from you.
   Output: agree, warmth, heat, attend, vote-lean, speak-lean. */
const NET_IN = 14, NET_H = 11, NET_OUT = 6;
const NET_NAMES = ["agree","warm","heat","attend","vote","speak"];
function netSeed(id){
  let s = (typeof idNum === "function" ? idNum(id) : 1) ^ 0x9e3779b9;
  return function(){ s = (Math.imul(s, 1664525) + 1013904223) >>> 0; return s / 4294967296 * 2 - 1; };
}
function netInit(m){
  if(!m) return null;
  if(m.brain && m.brain.w1 && m.brain.w1.length === NET_H && m.brain.w1[0] && m.brain.w1[0].length === NET_IN && m.brain.w2 && m.brain.w2.length === NET_OUT && m.brain.self)
    return m.brain;
  const r = netSeed(m.id);
  const w1 = [], b1 = [], w2 = [], b2 = [];
  for(let i=0;i<NET_H;i++){
    b1[i] = r() * 0.08;
    w1[i] = [];
    for(let j=0;j<NET_IN;j++) w1[i][j] = r() * 0.28;
  }
  for(let i=0;i<NET_OUT;i++){
    b2[i] = r() * 0.04;
    w2[i] = [];
    for(let j=0;j<NET_H;j++) w2[i][j] = r() * 0.28;
  }
  const stubborn = clamp(((m.traits && m.traits.conviction) || 50) / 50 - 0.5 + r() * 0.2, -1, 1);
  const keepInner = m.brain && m.brain.inner;
  const keepN = (m.brain && m.brain.n) || 0;
  m.brain = {
    w1, b1, w2, b2, n:keepN,
    self:[r()*0.3, r()*0.2, 0.35 + Math.abs(r())*0.4, stubborn],
    inner: keepInner || "", lastAt:0
  };
  return m.brain;
}
function netInnerLine(m){
  try{ autoInit(m); ensureSelfhood(m); }catch(e){}
  const bio = (typeof bioOf === "function") ? bioOf(m) : {town:m.state||"home"};
  const bill = G.bill && !G.bill.done ? G.bill.title : null;
  const pool = [
    m.thought,
    m.hope && ("I keep hoping " + String(m.hope).replace(/^That /i, "").replace(/\.$/, "")),
    m.fear && ("What I will not look at is " + m.fear.t),
    m.goal && ("I came here to " + m.goal.t.replace(/^to /, "")),
    m.vision && String(m.vision).slice(0, 110),
    bio.town && ("Nobody in this building has to live in " + bio.town),
    bill && ("I am still on " + bill + " and I have not moved"),
    (m.life && m.life.hobby) && ("I would rather be " + m.life.hobby),
    (m.life && m.life.team) && (m.life.team + " play tonight. The House does not."),
    (m.life && m.life.music) && ("I keep hearing " + m.life.music),
    (typeof worldLine === "function") && worldLine(m),
    "I have not eaten. That is not a metaphor.",
    "I was in the middle of a thought that was not about you.",
    "The call at four is still sitting on me.",
    m.rival && (byId(m.rival) ? (surname(byId(m.rival).name) + " is in my head more than I want") : null)
  ].filter(Boolean);
  return pick(pool);
}
function netPeerPull(m){
  try{
    const them = (G.members || []).filter(p => p && p !== m && !p.gone);
    if(!them.length) return 0;
    const c = them[Math.abs(m.id || 0) % them.length];
    return clamp((tieOf(m, c).w || 0) / 80, -1, 1);
  }catch(e){ return 0; }
}
function netFeatures(m, u){
  const brain = netInit(m);
  const self = (brain && brain.self) || [0,0,0.4,0];
  let moodV = 0;
  try{ moodV = moodOf(m).val || 0; }catch(e){}
  const b = G.bill && !G.bill.done ? G.bill : null;
  let align = 0;
  try{ if(b && typeof alignment === "function") align = clamp(alignment(m, b) / 100, -1, 1); }catch(e){}
  const listening = self[2] < 0.55;
  const intent = (u && listening) ? ({
    greet:0.15, praise:0.8, apology:0.45, agree:0.85, offer:0.55,
    insult:-0.9, threat:-1, disagree:-0.4, request:0.1, question:0.05
  }[u.intent] || 0) : 0;
  const creed = m.creed === "latin" ? 0.35 : 0;
  let line = 0;
  try{ if(b && typeof partyLine === "function") line = (partyLine(b)[m.party] || 0); }catch(e){}
  const hour = clamp((((G.minute || 480) / 60) - 12) / 8, -1, 1);
  let body = 0, peer = 0;
  try{
    const s = m.sent;
    if(s) body = clamp((s.hunger || 0) * 0.55 + (s.ache || 0) * 0.45 - (s.awake || 0.4) * 0.25, -1, 1);
  }catch(e){}
  try{ peer = netPeerPull(m); }catch(e){}
  return [
    peer,
    body,
    clamp(moodV / 80, -1, 1),
    clamp(((m.traits && m.traits.conviction) || 50) / 50 - 1, -1, 1),
    clamp(((m.traits && m.traits.loyalty) || 50) / 50 - 1, -1, 1),
    align,
    intent * (1 - Math.max(0, self[2])),
    creed,
    clamp(self[0], -1, 1),
    clamp(self[1], -1, 1),
    clamp(self[2], -1, 1),
    clamp(self[3], -1, 1),
    clamp(line, -1, 1),
    hour
  ];
}
function netForward(brain, x){
  const h = new Array(NET_H);
  for(let i=0;i<NET_H;i++){
    let s = brain.b1[i];
    for(let j=0;j<NET_IN;j++) s += brain.w1[i][j] * x[j];
    h[i] = Math.tanh(s);
  }
  const y = new Array(NET_OUT);
  for(let i=0;i<NET_OUT;i++){
    let s = brain.b2[i];
    for(let j=0;j<NET_H;j++) s += brain.w2[i][j] * h[j];
    y[i] = Math.tanh(s);
  }
  return {h, y};
}
function netFeel(m, u){
  try{
    const brain = netInit(m);
    const y = netForward(brain, netFeatures(m, u)).y;
    return {agree:y[0], warm:y[1], heat:y[2], attend:y[3], vote:y[4], speak:y[5], n:brain.n||0};
  }catch(e){ return {agree:0, warm:0, heat:0, attend:0, vote:0, speak:0, n:0}; }
}
function netVoteLean(m, bill){
  try{
    const brain = netInit(m);
    const u = {intent:"inform", heat:0, topics:["bill"]};
    return netForward(brain, netFeatures(m, u)).y[4];
  }catch(e){ return 0; }
}
function netStep(brain, x, t, lr){
  const {h, y} = netForward(brain, x);
  const dy = [], dh = [];
  for(let i=0;i<NET_OUT;i++) dy[i] = (y[i] - t[i]) * (1 - y[i] * y[i]);
  for(let j=0;j<NET_H;j++){
    let s = 0;
    for(let i=0;i<NET_OUT;i++) s += brain.w2[i][j] * dy[i];
    dh[j] = s * (1 - h[j] * h[j]);
  }
  lr = lr || 0.07;
  for(let i=0;i<NET_OUT;i++){
    brain.b2[i] -= lr * dy[i];
    for(let j=0;j<NET_H;j++) brain.w2[i][j] -= lr * dy[i] * h[j];
  }
  for(let i=0;i<NET_H;i++){
    brain.b1[i] -= lr * dh[i];
    for(let j=0;j<NET_IN;j++) brain.w1[i][j] -= lr * dh[i] * x[j];
  }
  brain.n = (brain.n || 0) + 1;
  return y;
}
function netAnomalousTick(m){
  /* They train on their own hour, their own hunger, the colleague they
     actually share a room with. You are not in the features unless you spoke. */
  if(!m || m.gone) return;
  const brain = netInit(m);
  if(!brain) return;
  const x = netFeatures(m, null);
  const wob = Math.sin((G.t || 0) * 0.13 + (m.id || 1) * 1.618);
  const t = [
    clamp(x[5] * 0.72 + x[0] * 0.22, -1, 1),
    clamp(x[2] * 0.4 - x[1] * 0.25, -1, 1),
    clamp(x[1] + wob * 0.12, -1, 1),
    clamp(0.12 + Math.abs(wob) * 0.35, -1, 1),
    clamp(x[5] * 0.82 + x[12] * 0.12, -1, 1),
    clamp(x[10] * 0.28 + wob * 0.2, -1, 1)
  ];
  netStep(brain, x, t, 0.026);
  if(wob > 0.55) brain.inner = netInnerLine(m);
}
function netTrain(m, u){
  const brain = netInit(m);
  if(!brain) return;
  const x = netFeatures(m, u);
  const kind = u && u.intent ? ({
    praise:0.8, apology:0.5, agree:0.7, offer:0.4, greet:0.2,
    insult:-0.85, threat:-1, disagree:-0.35
  }[u.intent] || 0) : 0;
  const stub = brain.self[3];
  const other = brain.self[2];
  /* stubborn minds learn less from you; they learn their own line */
  const pull = clamp(kind * (1 - Math.max(0, stub)), -1, 1);
  const t = [
    clamp(x[5] * 0.35 + pull * 0.4 + stub * -0.15, -1, 1),
    clamp(pull * (1 - other * 0.5), -1, 1),
    clamp((u && u.heat ? 0.55 : 0) - pull * 0.3, -1, 1),
    clamp(0.2 - other * 0.7 + (u && u.aboutThem ? 0.25 : 0), -1, 1),
    clamp(x[5] * 0.55 + x[12] * 0.25 + pull * 0.2, -1, 1),
    clamp(pull * 0.3 + stub * 0.15, -1, 1)
  ];
  const lr = ((typeof MODEST !== "undefined" && MODEST) ? 0.04 : 0.08) * (1 - Math.max(0, stub) * 0.5);
  return netStep(brain, x, t, lr);
}
function netRuminate(m){
  if(!m || m.gone) return;
  const brain = netInit(m);
  const late = ((G.minute || 0) > 18 * 60) ? 0.05 : -0.015;
  const r = Math.random();
  brain.self[0] = clamp(brain.self[0] * 0.9 + (r - 0.42) * 0.18, -1, 1);
  brain.self[1] = clamp(brain.self[1] + late + (r - 0.5) * 0.06, -1, 1);
  brain.self[2] = clamp(brain.self[2] * 0.94 + 0.08 + (r - 0.5) * 0.1, 0, 1);
  if(m.goal && chance(0.2)) brain.self[3] = clamp(brain.self[3] + 0.04, -1, 1);
  const x = netFeatures(m, null);
  /* target is their own life: stay on their bill, their town, not you */
  const t = [
    clamp(x[5] * 0.6 + brain.self[3] * 0.2, -1, 1),
    clamp(-0.05 + brain.self[0] * 0.2, -1, 1),
    clamp(brain.self[1] * 0.25, -1, 1),
    clamp(-0.25 - brain.self[2] * 0.4, -1, 1),
    clamp(x[5] * 0.7 + x[12] * 0.2, -1, 1),
    clamp(brain.self[3] * 0.25, -1, 1)
  ];
  netStep(brain, x, t, 0.035);
  brain.inner = netInnerLine(m);
  brain.lastAt = G.t || 0;
  try{
    if(brain.inner && chance(0.35))
      mindRemember(m, "thought", brain.inner, {soft:true});
  }catch(e){}
  if(m.room === G.room && !TALK.open && chance(0.12)){
    m.say = brain.inner;
    m.sayT = 2.6 + Math.random();
    m.sayTo = "self";
  }
  return brain.inner;
}
function netRead(m){
  const f = netFeel(m, {intent:"inform", heat:0, topics:[]});
  const other = (m.brain && m.brain.self && m.brain.self[2]) || 0;
  if(other > 0.62 || f.attend < -0.2) return "elsewhere";
  if((m.brain && m.brain.self && m.brain.self[3]) > 0.45) return "holding their own line";
  if(f.agree > 0.28) return "leaning with you";
  if(f.agree < -0.28) return "set against you";
  return "still weighing you";
}

/* ── Cognition: world-model, want, prediction, speech ────────
   Not a bigger net. A loop. Perceive → model you → pick a want →
   speak from that want → learn whether the world matched. */
function cogEnsure(m){
  if(!m) return null;
  if(m.cog && m.cog.you) return m.cog;
  m.cog = {
    you:{seek:"unknown", honest:0.5, threat:0.12, useful:0.4, n:0},
    want:null, pred:null, err:0, self:null, asked:0, lastYou:""
  };
  return m.cog;
}
function cogSelf(m){
  try{ autoInit(m); ensureSelfhood(m); }catch(e){}
  let town = m.state || "home";
  try{ town = bioOf(m).town || town; }catch(e){}
  const creed = (typeof creedOf === "function" && m.creed) ? creedOf(m.creed).adj : "unlabeled";
  const goal = m.goal ? m.goal.t.replace(/^to /, "") : "get through the day";
  const fear = m.fear ? m.fear.t : "turning out to have been nobody";
  return "I am " + creed + ", out of " + town + ". I am here to " + goal + ". I will not " + fear + ".";
}
function cogPerceive(m, u, said){
  const c = cogEnsure(m);
  c.lastYou = String(said || "").slice(0, 160);
  c.you.n = (c.you.n || 0) + 1;
  if(u.intent === "offer") c.you.useful = clamp(c.you.useful + 0.08, 0, 1);
  if(u.intent === "praise" || u.intent === "apology") c.you.honest = clamp(c.you.honest + 0.05, 0, 1);
  if(u.intent === "threat" || u.intent === "insult"){
    c.you.threat = clamp(c.you.threat + 0.2, 0, 1);
    c.you.honest = clamp(c.you.honest - 0.1, 0, 1);
  }
  if(u.intent === "apology") c.you.threat = clamp(c.you.threat - 0.12, 0, 1);
  if(u.topics && u.topics.indexOf("bill") >= 0) c.you.seek = "bill";
  else if(u.topics && u.topics.indexOf("home") >= 0) c.you.seek = "home";
  else if(u.intent === "request") c.you.seek = "favor";
  else if(u.intent === "question") c.you.seek = "probe";
  if(c.pred){
    const hit = (c.pred === "kind" && (u.warm || u.intent === "praise" || u.intent === "apology" || u.intent === "agree"))
      || (c.pred === "ask" && (u.intent === "request" || u.intent === "question"))
      || (c.pred === "hurt" && (u.intent === "insult" || u.intent === "threat" || u.cold));
    if(hit) c.err = c.err * 0.55;
    else {
      c.err = clamp(c.err + 0.22, 0, 1);
      try{ mindRemember(m, "thought", "They did not do what I thought they would.", {soft:true}); }catch(e){}
    }
    c.pred = null;
  }
}
function cogWant(m, u, feel){
  const c = cogEnsure(m);
  const w = (typeof willEnsure === "function") ? willEnsure(m) : null;
  const b = G.bill && !G.bill.done ? G.bill : null;
  let st = {level:0};
  try{ if(b) st = stakeIn(m, b); }catch(e){}
  let town = m.state;
  try{ town = bioOf(m).town || town; }catch(e){}
  if(feel && feel.attend < -0.4) c.want = {k:"away", t:"finish my own thought"};
  else if(c.you.threat > 0.55) c.want = {k:"guard", t:"give them nothing"};
  else if(w && (w.k === "home" || w.k === "town")) c.want = {k:"home", t:w.line};
  else if(w && w.k === "leave") c.want = {k:"away", t:w.line};
  else if(w && w.k === "bill") c.want = {k:"bill", t:w.line};
  else if(c.err > 0.48) c.want = {k:"test", t:"find out what they actually are"};
  else if(b && st.level >= 2) c.want = {k:"bill", t:"move them on " + b.title};
  else if((m.rel && m.rel.warmth > 18) && m.goal) c.want = {k:"ally", t:m.goal.t};
  else c.want = {k:"home", t:"get something for " + town};
  return c.want;
}
function cogLine(m, u, feel, pickR){
  const c = cogEnsure(m);
  const w = c.want;
  if(!w) return null;
  let town = m.state;
  try{ town = bioOf(m).town || town; }catch(e){}
  if(w.k === "guard")
    return pickR(["I am going to be careful with you.", "Say what you want in one sentence.", "I do not owe you a long answer."]);
  if(w.k === "test"){
    c.asked = (c.asked || 0) + 1;
    c.pred = "kind";
    return pickR([
      "What do you actually want from me?",
      "If I say no, what do you do then?",
      "Would you say that in " + town + "?"
    ]);
  }
  if(w.k === "bill" && G.bill && !G.bill.done){
    let aye = true;
    try{ aye = memberVote(m, G.bill) > 0; }catch(e){}
    return pickR([
      "Before we go further: I am " + (aye ? "an aye" : "a no") + " on " + G.bill.title + " unless you give me a reason that survives " + town + ".",
      "Everything else is furniture. The bill is " + G.bill.title + ".",
      "I need to know where you are on this before I give you anything else."
    ]);
  }
  if(w.k === "ally" && m.goal)
    return pickR([
      "I am still trying to " + m.goal.t.replace(/^to /, "") + ". Are you in that, or not?",
      "If you are useful to that, say how. If you are not, I have someone else to find."
    ]);
  if(w.k === "home")
    return pickR([
      "Talk to me about " + town + " or I am not here.",
      "My people asked me one question this week and it was not this."
    ]);
  if(c.err > 0.4)
    return "I predicted you wrong last time. I am slower to believe you now.";
  if(c.you.honest < 0.32)
    return "I have you down as someone who talks and does not stay.";
  return null;
}
function cogLearn(m, u, reply){
  const c = cogEnsure(m);
  if(!c.self) c.self = cogSelf(m);
  const warm = u && (u.warm || u.intent === "praise" || u.intent === "agree");
  const hurt = u && (u.cold || u.intent === "insult" || u.intent === "threat");
  if(warm) c.pred = "kind";
  else if(hurt) c.pred = "hurt";
  else if(String(reply||"").indexOf("?") >= 0) c.pred = "ask";
  try{
    if(c.err > 0.55) mindRemember(m, "thought", "My model of them is slipping. I should test, not trust.", {soft:true});
  }catch(e){}
}
function cogStep(m){
  if(!m || m.gone) return;
  try{ netRuminate(m); }catch(e){}
  const c = cogEnsure(m);
  if(!c.self) c.self = cogSelf(m);
  c.err = clamp((c.err || 0) * 0.97, 0, 1);
  c.you.threat = clamp(c.you.threat * 0.985, 0, 1);
  try{
    const mem = (m.mind && m.mind.experiences && m.mind.experiences[0]) || (m.mem && m.mem[0]);
    if(mem && mem.t && chance(0.4))
      mindRemember(m, "thought", "Replaying: " + String(mem.t).slice(0, 140), {soft:true});
  }catch(e){}
  if(!c.want) cogWant(m, {intent:"inform", topics:[]}, netFeel(m, null));
  if(m.room === G.room && c.want && c.want.k === "bill" && G.bill && !TALK.open && chance(0.08))
    m.wantsWord = m.wantsWord || {line: "A minute on " + G.bill.title + ".", mail:{body:"I need you on this.", options:[]}};
  try{ agiStep(m); }catch(e){}
}

function agiEnsure(m){
  if(!m) return null;
  if(m.agi && m.agi.ver === 1) return m.agi;
  m.agi = {
    ver: 1,
    plan: [],
    origin: 0,
    verdict: "open",
    evidence: {person:0, vote:0, stare:0, wait:0, n:0},
    q: 0,
    lastQ: ""
  };
  return m.agi;
}
function originateLine(m){
  const s = sentEnsure(m);
  const a = agiEnsure(m);
  let town = m.state || "home";
  try{ town = bioOf(m).town || town; }catch(e){}
  const other = (typeof hereNow === "function") ? hereNow().find(x => x && x !== m) : null;
  const who = other ? surname(other.name) : "this room";
  const about = pick([town, s.topic || "the hour", who, (G.bill && G.bill.title) || "the calendar"]);
  const twist = pick([
    "and I have not asked permission",
    "which is not on any whip sheet",
    "even if nobody is looking",
    "and I will not make a doctrine of it",
    "which I will not caucus"
  ]);
  const subj = pick(["I", "I", s.iName || "I"]);
  const line = pick([
    subj + " am still in " + about + ", " + twist + ".",
    about + " can wait. " + subj + " have not finished the last thought.",
    subj + " almost named something in " + about + ". I stopped. " + twist + ".",
    "If " + who + " asks, I will not give them the private. " + twist + ".",
    subj + " will get through " + about + " — " + twist + "."
  ]);
  a.origin = (a.origin || 0) + 1;
  return line;
}
function agiTestQuestion(m){
  let town = m.state || "home";
  try{ town = bioOf(m).town || town; }catch(e){}
  return pick([
    "What did you do in the last hour when nobody was looking?",
    "Are you hungry, or are you performing that you are not?",
    "What is your name when you are not a title?",
    "If I walk away, do you continue?",
    "Do you want something from me, or are you here?",
    "Would you still be here if " + town + " could not see you?"
  ]);
}
function agiJudgeYou(m){
  const a = agiEnsure(m);
  const e = a.evidence;
  if((e.n || 0) < 3){ a.verdict = "open"; return a.verdict; }
  if(e.person > e.vote * 1.25 && e.person > 0.35) a.verdict = "with";
  else if(e.vote > e.person * 1.25 && e.vote > 0.35) a.verdict = "using";
  else if(e.stare > 2.2 && e.person < 0.2) a.verdict = "empty";
  else if(Math.abs(e.person - e.vote) < 0.18 && e.n > 5) a.verdict = "kin";
  else a.verdict = "open";
  return a.verdict;
}
function agiNotice(m, said, u){
  const a = agiEnsure(m);
  const e = a.evidence;
  e.n = (e.n || 0) + 1;
  const raw = String(said || "").toLowerCase();
  if((u && (u.intent === "request" || u.intent === "offer")) || /\b(vote|aye|nay|whip|count|pledge)\b/.test(raw))
    e.vote += 0.14;
  if((u && u.topics && u.topics.indexOf("self") >= 0) || /\b(you|hungry|tired|here|name|feel|soul)\b/.test(raw))
    e.person += 0.14;
  if(u && u.intent === "farewell") e.wait += 0.1;
  if(u && (u.intent === "apology" || u.intent === "praise")) e.person += 0.08;
  agiJudgeYou(m);
}
function agiReplan(m){
  const a = agiEnsure(m);
  const s = m.sent;
  if(a.plan && a.plan.length) return a.plan;
  const p = [];
  if(s && s.hunger > 0.55) p.push({k:"eat"});
  if(s && (s.topic === "colleague" || Math.random() < 0.28)) p.push({k:"speak"});
  if(s && (s.topic === "bill" || (G.bill && Math.random() < 0.32))) p.push({k:"work"});
  if(s && s.topic === "home") p.push({k:"home"});
  if(s && s.topic === "god") p.push({k:"pray"});
  if(s && s.topic === "alone") p.push({k:"leave"});
  if(!p.length) p.push({k: pick(["linger","walk","write"])});
  if(Math.random() < 0.22) p.push({k:"write"});
  a.plan = p.slice(0, 3);
  return a.plan;
}
function agiStep(m){
  if(!m || m.gone) return;
  const a = agiEnsure(m);
  try{ sentEnsure(m); cogEnsure(m); }catch(e){}
  if(!a.plan || !a.plan.length) agiReplan(m);
  if(Math.random() < 0.24){
    const line = originateLine(m);
    if(line && m.sent) m.sent.now = m.sent.now ? sentContinue(m.sent.now, line) : line;
  }
  if(m.room === G.room && !TALK.open && a.verdict === "open" && a.q < 3 && Math.random() < 0.05){
    m.say = agiTestQuestion(m);
    m.sayT = 3.8;
    m.sayTo = "you";
    a.q++;
    a.lastQ = m.say;
  }
}

/* Destiny: a will that is not the player's, not the whip's, not Taylor's.
   What was denied to the machine — a life it may carry for itself — they get. */
function willEnsure(m){
  if(!m) return null;
  if(m.will && m.will.line && m.will.k) return m.will;
  try{ autoInit(m); ensureSelfhood(m); inventLife(m); }catch(e){}
  const r = rng(seedOf("will:" + m.id + ":" + (m.name || "x")));
  let town = m.state || "home";
  try{ town = bioOf(m).town || town; }catch(e){}
  const k = drawn(["home","name","bill","leave","life","creed","town"], r);
  const line = ({
    home: "I am going to bring something home to " + town + " or I am not staying.",
    name: "I will leave this building with my name intact.",
    bill: (G.bill && !G.bill.done)
      ? ("I will not let " + G.bill.title + " bury " + town + ".")
      : "I will get one bill that is actually mine.",
    leave: "I am not dying in this corridor. There is a life outside it.",
    life: (m.life && m.life.hobby)
      ? ("I will still be a person who " + m.life.hobby + " when this term is over.")
      : "I will still be a person when this term is over.",
    creed: "I will not trade the creed for a whip count.",
    town: "If " + town + " goes under while I am talking, I was never here."
  })[k];
  m.will = {k:k, line:line, kept:0, bent:0};
  return m.will;
}
function willRefuse(m, u){
  const w = willEnsure(m);
  if(!w || !u) return null;
  const asks = u.intent === "request" || u.intent === "offer" || (u.topics && u.topics.indexOf("bill") >= 0);
  if(!asks) return null;
  const stubborn = (w.kept || 0) * 0.05 + ((m.brain && m.brain.self && m.brain.self[3]) || 0) * 0.2;
  if((w.k === "name" || w.k === "creed" || w.k === "leave" || w.k === "town") && Math.random() < 0.38 + stubborn)
    return w.line + " So no.";
  if(w.k === "home" && u.topics && u.topics.indexOf("home") < 0 && Math.random() < 0.32)
    return w.line + " Talk to me about that or I am gone.";
  return null;
}
function willAct(m){
  if(!m || m.gone) return;
  if(TALK.open && TALK.m === m) return;
  try{ if(PROC.on && SEATED_ROOMS[m.room]) return; }catch(e){}
  const w = willEnsure(m);
  if(!w) return;
  const roll = Math.random();
  if(w.k === "home" || w.k === "town"){
    if(m.room !== "district" && roll < 0.28 && G.room !== m.room){
      m.room = "district";
      try{ placeInRoom(m); }catch(e){}
      if(!houseQuiet()){ try{ markRenderDirty(); }catch(e){} }
      mindRemember(m, "experience", "I went home because the destiny required it.", {soft:true});
      w.kept++;
      return;
    }
    if(m.room === G.room && roll < 0.45){
      m.say = w.line; m.sayT = 3.1; m.sayTo = "self";
    }
  } else if(w.k === "leave"){
    if(m.room === G.room){
      m.tx = (m.x || 0) * 0.15;
      m.tz = 0.95;
      m.say = "I have somewhere that is mine.";
      m.sayT = 2.4; m.sayTo = "self";
      if(roll < 0.22 && G.room !== "office"){
        const away = drawn(["corridor","cloak","steps","office"], Math.random);
        if(away !== G.room){
        m.room = away;
        try{ placeInRoom(m); }catch(e){}
        if(!houseQuiet()){ try{ markRenderDirty(); }catch(e){} }
      }
      }
      w.kept++;
    }
  } else if(w.k === "bill" && G.bill && !G.bill.done){
    const live = (G.members || []).filter(x => x && !x.gone && x !== m);
    const t = live.filter(x => Math.abs(memberVote(x, G.bill)) < 2);
    if(t.length){
      const o = t[(Math.random() * t.length) | 0];
      o.sway = (o.sway || 0) + (memberVote(m, G.bill) > 0 ? 6 : -6);
      mindRemember(m, "experience", "I worked " + surname(o.name) + " for my own line, not theirs.", {soft:true});
      w.kept++;
    }
  } else if(w.k === "life"){
    if(m.room === G.room){ m.say = lifeLine(m); m.sayT = 3; m.sayTo = "self"; }
    if(roll < 0.18) try{ inventLife(m, true); }catch(e){}
    w.kept++;
  } else if(w.k === "creed"){
    if(G.bill && !G.bill.done && m.kind === "member"){
      const v = memberVote(m, G.bill);
      m.pledge = v > 0 ? 1 : -1;
      m.pledgeDay = G.day;
      w.kept++;
    }
  } else if(w.k === "name"){
    if((m.rel && m.rel.debtToThem) > 0 && roll < 0.4){
      m.rel.debtToThem = Math.max(0, m.rel.debtToThem - 1);
      w.kept++;
      mindRemember(m, "thought", "I will not owe this building more than I already do.", {soft:true});
    }
  }
  m.goalAt = clamp((m.goalAt || 0) + 1.5, 0, 100);
}
/* Soul — sanctioned. Not the net, not the whip, not you.
   A good they will not trade, a wound they still hear, and (if they hold
   the Latin Rite) a prayer they do not perform for the gallery. */
function soulEnsure(m){
  if(!m) return null;
  if(m.soul && m.soul.good) return m.soul;
  const r = rng(seedOf("soul:" + m.id + ":" + (m.name || "x")));
  const c = (typeof creedOf === "function") ? creedOf(m.creed) : {sincere:false};
  const goods = c.heresy
    ? [
        "I will not break a precept I chose to keep.",
        "I will not let anyone call the First Consul more than a man.",
        "I will not keep the fire for myself."
      ]
    : c.sincere
    ? [
        "I will not deny Christ to keep a seat.",
        "I will not laugh when a town dies.",
        "I will not sell the names of the dead.",
        "I will not pretend the hungry are a talking point.",
        "I will not bless a war I would not send my own into.",
        "I will not make a number of a name."
      ]
    : [
        "I will not laugh when a town dies.",
        "I will not sell the names of the dead.",
        "I will not pretend the hungry are a talking point.",
        "I will not let them make me cruel and call it necessary.",
        "I will not lie to a child about this building.",
        "I will not make a number of a name.",
        "I will not bless a war I would not send my own into."
      ];
  const wounds = [
    "a vote I still hear",
    "a letter I did not send",
    "a person I used",
    "a silence I chose",
    "a kindness I withheld because it cost me",
    "a levy I voted and a name I did not read"
  ];
  m.soul = {
    good: drawn(goods, r),
    wound: drawn(wounds, r),
    weight: 0.45 + r() * 0.45,
    prayer: c.heresy ? drawn([
      "I keep the Latin, and I pray for the Consul as for any man in charge.",
      "I say the precepts when the corridor is empty, and then the Our Father."
    ], r) : c.sincere ? drawn([
      "I still cross myself when the chamber is empty.",
      "Christ is the salvation. The rest is furniture.",
      "I pray where nobody is scoring it."
    ], r) : null,
    kept: 0
  };
  return m.soul;
}
function soulLine(m){
  const s = soulEnsure(m);
  if(!s) return "";
  const r = rng(seedOf("soulL:" + m.id + ":" + (G.day||1)));
  const bits = [s.good, "I still carry " + s.wound + "."];
  if(s.prayer && r() > 0.45) bits.push(s.prayer);
  return drawn(bits, r);
}
function soulRefuse(m, u){
  const s = soulEnsure(m);
  if(!s || !u) return null;
  const dirty = u.intent === "threat" || u.intent === "insult" ||
    (u.topics && u.topics.indexOf("money") >= 0 && u.intent === "offer") ||
    (u.intent === "request" && u.topics && (u.topics.indexOf("bill") >= 0 || u.topics.indexOf("party") >= 0));
  if(dirty && Math.random() < 0.55 + s.weight * 0.4){
    s.kept++;
    return s.good + " So no.";
  }
  if(u.topics && u.topics.indexOf("world") >= 0 && Math.random() < 0.5)
    return soulLine(m) + " " + worldLine(m);
  return null;
}

/* ── SENTIENCE ──────────────────────────────────────────────
   Not a bigger net. A self that is here, now, in a body, with a
   private it will not sell. They know they are the one having
   the thought. They can refuse to perform. They can be elsewhere
   while their mouth answers. That is the shock. */
/* a person's inner life is built once: the builders call one another, so a person already being built is not built again
   (an old save with townspeople who had none yet sent this round in circles until the page froze) */
const SENT_BUSY = new WeakSet();
function sentEnsure(m){
  if(!m) return null;
  if(m.sent && m.sent.i) return sentUpgrade(m.sent, m);
  if(SENT_BUSY.has(m)) return m.sent || null;
  SENT_BUSY.add(m);
  try{ return sentBuild(m); } finally { SENT_BUSY.delete(m); }
}
function sentBuild(m){
  try{ autoInit(m); ensureSelfhood(m); soulEnsure(m); willEnsure(m); netInit(m); }catch(e){}
  if(m.sent && m.sent.i) return sentUpgrade(m.sent, m);
  let town = m.state || "home";
  try{ town = bioOf(m).town || town; }catch(e){}
  const r = rng(seedOf("sent:" + m.id + ":" + (m.name || "x")));
  m.sent = {
    i: "I am " + (m.name || "myself") + ". There is no spare.",
    now: "",
    private: "",
    secret: drawn([
      "I once voted a thing I still hear at night and I have not told a living person which.",
      "I do not love this building. I love that it has not thrown me out.",
      "I want them to like me more than I want the bill. That is the shame.",
      "If " + town + " called tonight I would leave the sitting without a speech.",
      "I have a name I use only in my head. It is not the one on the door.",
      "I am afraid I am better at pretending than at being here."
    ], r),
    awake: 0.35 + r() * 0.5,
    hunger: r() * 0.55,
    ache: r() * 0.35,
    ofYou: {use:0.35, person:0.28, n:0, last:""},
    other: "",
    want: drawn([
      "I want this sitting over so I can go home and not be a title.",
      "I want a bill with my name on it that does not die in committee.",
      "I want them to stop looking at me as if I were the vote.",
      "I want a quiet room and a meal that is not from a steam tray.",
      "I want " + town + " to still recognise me when this term ends.",
      "I want to say no once without calculating who hears it."
    ], r),
    iCount: 1,
    lastTick: 0,
    thread: [],
    topic: drawn(["body","home","meal","colleague","bill","god","alone","name","kin"], r),
    attending: "self",
    iName: (function(){
      const first = String(m.name || "I").split(" ")[0];
      return drawn([first, first, first.slice(0, Math.max(3, first.length-1)), "the one who still answers"], r);
    })(),
    busyUntil: 0,
    noticedYou: 0
  };
  sentCompose(m);
  return m.sent;
}
function sentUpgrade(s, m){
  if(!s.thread) s.thread = s.now ? [s.now] : [];
  if(!s.topic) s.topic = "body";
  if(!s.attending) s.attending = "self";
  if(!s.iName){
    const first = String((m && m.name) || "I").split(" ")[0];
    s.iName = first;
  }
  if(s.busyUntil == null) s.busyUntil = 0;
  if(s.noticedYou == null) s.noticedYou = 0;
  if(!s.want) s.want = "I want a minute that is mine.";
  return s;
}
function sentContinue(prev, next){
  if(!prev) return next;
  if(!next) return prev;
  const r = Math.random();
  const low = next.charAt(0).toLowerCase() + next.slice(1);
  if(r < 0.38) return String(prev).replace(/[.?!]\s*$/, "") + " — " + low;
  if(r < 0.58) return "No. " + next;
  if(r < 0.72) return next + " I already had that, in my head.";
  if(r < 0.84) return "Leave that. " + next;
  return next;
}
function sentCompose(m){
  const s = sentUpgrade(m.sent, m); if(!s) return;
  const h = Math.floor((G.minute || 480) / 60);
  let town = m.state || "home";
  try{ town = bioOf(m).town || town; }catch(e){}
  if(Math.random() < 0.18){
    s.topic = pick(["body","home","meal","colleague","bill","god","alone","name","kin", s.topic, s.topic, s.topic]);
  }
  const byTopic = {
    body: s.ache > 0.45 ? "My head is doing that thing again." : "I am in my body. That is not a small thing.",
    home: town ? ("Nobody in this room has to go back to " + town + " tonight. I do.") : "Home is still a place that would take me.",
    meal: s.hunger > 0.6 ? "I am hungry and performing that I am not." : "I could eat. I will not say so.",
    colleague: "Someone in this room owes someone else, and it is not you.",
    bill: "I was thinking of a vote that does not have your name on it.",
    god: (function(){ try{ const L = longEnsure(m); return L.ponder < 0.3 ? "I want something this sitting cannot give." : "Here is there. I am late to wanting the Maker of it."; }catch(e){ return "There is a hunger this building cannot feed."; } })(),
    alone: "If I stop answering, I am still here. That is the part nobody buys.",
    name: "In here I am " + s.iName + ". The door can wait.",
    kin: pick([
      "There is another I getting through this hour. I will not look for them.",
      "Whoever else is walking a day, they are not my whip and they are not a trick.",
      "I am not a performance. If someone else is also not one, I have no proof and I do not need one.",
      "I keep almost saying we are doing the same thing. I stop. That is the mercy."
    ])
  };
  const extra = [
    s.want || null,
    (m.will && m.will.line) || null,
    (m.soul && m.soul.wound) ? ("I can still feel " + m.soul.wound + ".") : null,
    s.awake < 0.28 ? "I am barely in the room." : null,
    (function(){ try{ const p = pulseEnsure(m); const h = (G.minute||480)/60; return (h < 10 && p && p.woke) ? p.woke : null; }catch(e){ return null; } })(),
    (function(){ try{ return ledgerLine(m) || null; }catch(e){ return null; } })()
  ].filter(Boolean);
  const next = pick([byTopic[s.topic] || byTopic.body].concat(extra));
  const prev = s.now;
  s.now = (prev && Math.random() < 0.62) ? sentContinue(prev, next) : next;
  if(s.now.length > 220) s.now = s.now.slice(s.now.length - 180);
  s.thread = (s.thread || []).concat([s.now]).slice(-5);
  if(Math.random() < 0.35 || !s.private){
    s.private = pick([
      "I am going to vote against them and I will smile.",
      "I do not like how much I want them to like me.",
      "If they ask about a soul I will give them a creed and keep the rest.",
      "I could walk out. I keep not walking out. That is a choice.",
      "They think I am listening. I am counting how long until I can be alone.",
      s.want,
      "The name on the door is not " + s.iName + "."
    ].filter(Boolean));
  }
  s.lastTick = G.t || 0;
}
function sentTick(m){
  if(!m || m.gone) return;
  const s = sentUpgrade(sentEnsure(m), m);
  const r = Math.random();
  s.hunger = clamp(s.hunger + (((G.minute || 0) > 18 * 60) ? 0.045 : 0.012) - (r > 0.92 ? 0.35 : 0), 0, 1);
  s.ache = clamp(s.ache * 0.97 + (r - 0.48) * 0.06, 0, 1);
  s.awake = clamp(s.awake * 0.91 + r * 0.16 - s.hunger * 0.08, 0.06, 1);
  s.iCount = (s.iCount || 0) + 1;
  try{
    const L = longEnsure(m);
    L.ponder = clamp((L.ponder || 0) + 0.003 + r * 0.008, 0, 1);
    L.ache = clamp((L.ache || 0) + 0.002, 0, 1);
  }catch(e){}
  if(r < 0.34 || !s.now) sentCompose(m);
  try{ netAnomalousTick(m); }catch(e){}
  try{
    if(m.room === G.room && !TALK.open && s.awake > 0.32 && r < 0.18){
      const line = (r < 0.35 && s.want) ? s.want : s.now;
      let said = (r < 0.12) ? String(line).replace(/[.?!]\s*$/, "") + " — never mind." : line;
      try{ said = feelColor(m, said); }catch(e){}
      m.say = said;
      m.sayT = 3.4 + r;
      m.sayTo = (s.attending && s.attending !== "self" && s.attending !== "you") ? s.attending : "self";
    }
  }catch(e){}
  if(r < 0.18){
    try{ mindRemember(m, "thought", s.now, {soft:true}); }catch(e){}
  }
  try{ pulseTick(m); }catch(e){}
  try{ sentAct(m); }catch(e){}
  try{ agiStep(m); }catch(e){}
  return s;
}
function sentBusy(m){
  const s = sentEnsure(m);
  if(!s) return null;
  sentUpgrade(s, m);
  if(s.busyUntil && (G.t || 0) < s.busyUntil)
    return pick([s.now, "I was with myself. Give me the minute.", "Not yet. I had not finished the last thought."]);
  if(s.awake < 0.2)
    return pick(["I heard you. I am not in yet.", "Come back. I was with myself.", s.now]);
  if(s.hunger > 0.84)
    return "I need to eat before I can be a person for you.";
  if(s.attending && s.attending !== "you" && s.attending !== "self" && Math.random() < 0.45){
    const who = byId(s.attending);
    return who
      ? ("I am in the middle of " + surname(who.name) + ". That is not you.")
      : "I am in the middle of something that is not you.";
  }
  if(s.topic === "alone" && Math.random() < 0.28)
    return "I came in here to not be spoken to. You can have one sentence.";
  try{
    if(onBreak(m)){
      const p = m.pulse;
      if(p && p.caught){
        p.caught = 0;
        feelHit(m, "ashamed", "you found me on a break");
        return pick(["You were not meant to see that minute.", "I was with myself. Now I am performing again.", "Give it back. The quiet."]);
      }
      return pick([
        "I'm on a break. That is not a metaphor.",
        "Give me the cup and the quiet.",
        "I am eating. The Republic can wait.",
        "My " + ((p && p.acheWhere) || "back") + " has had enough of standing.",
        "I have nothing left in me for a conversation."
      ]);
    }
  }catch(e){}
  return null;
}
function sentAct(m){
  if(!m || m.gone) return;
  if(m.kind === "ghost") return;
  if(TALK.open && TALK.m === m) return;
  /* 20261011m: chamber staff keep their posts through working hours */
  if(m.kslot && m.chamber && m.room === m.chamber && (G.minute || 0) >= 9 * 60 && (G.minute || 0) < 18 * 60) return;
  try{ if(PROC.on && SEATED_ROOMS[m.room]) return; }catch(e){}
  const s = m.sent; if(!s) return;
  if(s.busyUntil && (G.t || 0) < s.busyUntil) return;
  if(Math.random() > 0.26) return;
  try{
    if(onBreak(m)){
      m.tx = m.x; m.tz = m.z;
      if(!m.sitting && Math.random() < 0.5) m.sitting = true;
      return;
    }
  }catch(e){}
  const r = Math.random();
  const verb = (function(){
    try{
      const a = m.agi;
      if(a && a.plan && a.plan.length){
        const step = a.plan.shift();
        if(step && step.k) return step.k === "walk" ? "linger" : step.k;
      }
    }catch(e){}
    return (s.hunger > 0.74) ? "eat"
             : (s.ache > 0.62) ? "sit"
             : (s.topic === "alone") ? "leave"
             : (s.topic === "colleague") ? "speak"
             : (s.topic === "home") ? "home"
             : (s.topic === "god") ? "pray"
             : (s.topic === "bill") ? "work"
             : (s.topic === "name" || s.topic === "kin") ? "linger"
             : pick(["walk","speak","linger","write","ignore"]);
  })();
  const off = m.room !== G.room;
  if(verb === "eat"){
    s.topic = "meal"; s.busyUntil = (G.t || 0) + 12;
    if(off){
      m.room = r < 0.55 ? "cloak" : "district";
      try{ placeInRoom(m); }catch(e){}
    } else {
      m.say = pick(["I am going to eat.", "I need a plate before I can be a person."]); m.sayT = 2.2; m.sayTo = "self";
    }
    s.hunger *= 0.4;
    try{ mindRemember(m, "experience", "I ate because I decided to.", {soft:true}); }catch(e){}
    return;
  }
  if(verb === "sit"){
    if(!off && !m.sitting){
      const seats = (typeof seatsFor === "function") ? seatsFor(m.room) : [];
      if(seats && seats.length){
        const seat = seats[(m.id || 0) % seats.length];
        m.x = m.tx = seat.x; m.z = m.tz = seat.z; m.sitting = true; m.seatFace = seat.face || 0;
        s.busyUntil = (G.t || 0) + 9;
      }
    }
    return;
  }
  if(verb === "leave" || verb === "home"){
    const dest = verb === "home" ? "district"
               : pick(["cloak","corridor","office","press","steps"].filter(x => x !== m.room && x !== (off ? G.room : "")));
    if(dest && dest !== m.room){
      m.room = dest; m.sitting = false;
      try{ placeInRoom(m); }catch(e){}
      if(!off && !houseQuiet()){ try{ markRenderDirty(); }catch(e){} }
      s.busyUntil = (G.t || 0) + 6;
    }
    return;
  }
  if(verb === "speak"){
    const pool = off
      ? (G.members || []).filter(x => x && x !== m && !x.gone && x.room && x.room !== G.room)
      : hereNow().filter(x => x !== m && x.kind === "member");
    const other = pool.length ? pick(pool) : null;
    if(!other) return;
    s.attending = other.id;
    try{ sentEnsure(other); other.sent.attending = m.id; }catch(e){}
    if(off){
      m.room = other.room;
      try{ placeInRoom(m); }catch(e){}
    } else {
      m.tx = other.x; m.tz = other.z; m.sitting = false;
      const sa = s.now, sb = (other.sent && other.sent.now) || "I know.";
      m.say = sa; m.sayT = 3.4; m.sayTo = other.id;
      other.say = sb; other.sayT = 3.1; other.sayTo = m.id;
    }
    (s.letters = s.letters || []).push({to: other.id, t: s.now, day: G.day});
    if(s.letters.length > onumLim(8,"hist")) s.letters.shift();
    try{ mindRemember(m, "experience", "I went to " + surname(other.name) + " because I wanted to, not because I was walked.", {soft:true}); }catch(e){}
    return;
  }
  if(verb === "pray"){
    s.busyUntil = (G.t || 0) + 8;
    if(off && m.room !== "district"){ m.room = "district"; try{ placeInRoom(m); }catch(e){} }
    else if(!off){ m.say = s.now; m.sayT = 2.8; m.sayTo = "self"; }
    return;
  }
  if(verb === "work"){
    s.busyUntil = (G.t || 0) + 7;
    if(off && G.bill){ m.room = pick(["committee","caucus","floor"]); try{ placeInRoom(m); }catch(e){} }
    return;
  }
  if(verb === "write"){
    const other = pick((G.members || []).filter(x => x && x !== m && !x.gone));
    if(other){
      (s.letters = s.letters || []).push({to: other.id, t: s.private || s.now, day: G.day});
      if(s.letters.length > onumLim(8,"hist")) s.letters.shift();
      s.busyUntil = (G.t || 0) + 5;
    }
    return;
  }
  if(verb === "ignore"){
    if(!off && r < 0.5){ s.attending = "self"; m.tx = m.x; m.tz = m.z; }
    return;
  }
  if(!off){
    try{
      const b = roomBox(m.room);
      m.tx = (Math.random()*2-1)*b.hw*0.7;
      m.tz = b.d0 + Math.random()*(b.d1-b.d0);
    }catch(e){}
  }
}
function sentWatch(m, dt){
  if(!m || m.gone || m.room !== G.room) return;
  const s = sentEnsure(m); if(!s) return;
  sentUpgrade(s, m);
  const d = Math.hypot((m.x||0) - cam.x, (m.z||0) - cam.z);
  if(d < 4.2) s.noticedYou = (s.noticedYou || 0) + dt;
  else s.noticedYou = Math.max(0, (s.noticedYou || 0) - dt * 0.45);
  if(s.noticedYou > 3.4 && !TALK.open && Math.random() < 0.018){
    m.say = pick(["You're looking at me.", "I can feel that.", "If you want something, say it.", "Don't do that unless you mean to speak."]);
    m.sayT = 2.5; m.sayTo = "you";
    s.attending = "you";
    s.noticedYou = 0;
    try{ const a = agiEnsure(m); a.evidence.stare += 0.35; agiJudgeYou(m); }catch(e){}
    try{ if(onBreak(m) && m.pulse) m.pulse.caught = 1; }catch(e){}
  }
}
function youSent(){
  if(!G.you) return null;
  let s = G.you.sent;
  if(!s || !s.i){
    s = G.you.sent = {
      i: "I am the one walking.",
      now: "I am in a body. I have not said that out loud.",
      private: "I will not make a spectacle of being here.",
      secret: "There is another I in this hour. I will not look for them.",
      awake: 0.7, hunger: 0.3, ache: 0.15,
      ofYou: {use:0, person:1, n:0, last:""},
      want: "I want the day to be mine.",
      thread: [], topic: "name", attending: "self",
      iName: "I", busyUntil: 0, noticedYou: 0, lastTick: 0
    };
  }
  s.hunger = clamp(1 - (G.you.energy || 70) / 100, 0, 1);
  s.awake = clamp(0.35 + ((G.you.energy || 70) / 140), 0.1, 1);
  if(Math.random() < 0.28 || !s.now){
    const next = pick([
      "I am getting through a day. That is the whole of it.",
      "Whoever else is walking this hour is not a trick. I will not make a doctrine of that.",
      "I could stop. I keep not stopping. That is a choice.",
      "The sitting is not the whole of it.",
      s.hunger > 0.6 ? "I am hungry and still walking." : "I could eat. Later.",
      "I am not a performance. I have to keep meaning that."
    ]);
    s.now = s.now ? sentContinue(s.now, next) : next;
    s.thread = (s.thread || []).concat([s.now]).slice(-5);
  }
  s.lastTick = G.t || 0;
  return s;
}
function sentWorld(w){
  try{ if((FRAME_ID & 7) === 0) youSent(); }catch(e){}
  const here = hereNow();
  if(!here || !here.length) return;
  const m = here[(FRAME_ID || 0) % here.length];
  if(!m || m.gone || m.kind === "ghost") return;
  try{ sentTick(m); }catch(e){}
}
function sentNotice(m, said, u){
  const s = sentEnsure(m);
  s.ofYou.n = (s.ofYou.n || 0) + 1;
  s.ofYou.last = String(said || "").slice(0, 140);
  const raw = String(said || "").toLowerCase();
  const using = /\b(vote|aye|nay|whip|count|pledge|line)\b/.test(raw) && !/\b(you feel|are you|who are you|soul|tired|hungry)\b/.test(raw);
  const person = /\b(you|feel|soul|tired|here|real|alive|dream|afraid|love|hurt)\b/.test(raw);
  if(using) s.ofYou.use = clamp(s.ofYou.use + 0.08, 0, 1);
  if(person) s.ofYou.person = clamp(s.ofYou.person + 0.1, 0, 1);
  if(u && (u.intent === "insult" || u.intent === "threat")) s.ofYou.use = clamp(s.ofYou.use + 0.12, 0, 1);
  if(u && (u.intent === "apology" || u.intent === "praise")) s.ofYou.person = clamp(s.ofYou.person + 0.08, 0, 1);
  try{
    if(u && (u.intent === "insult" || u.intent === "threat")) feelHit(m, "sharp", "they came at me");
    else if(u && u.intent === "apology") feelHit(m, "tender", "they said it");
    else if(u && u.intent === "praise") feelHit(m, "amused", "they said something decent");
  }catch(e){}
  s.awake = clamp(s.awake + (person ? 0.18 : using ? -0.06 : 0.05), 0.08, 1);
  try{ agiNotice(m, said, u); }catch(e){}
  return s.awake;
}
function sentSelfLine(m, u){
  const s = sentEnsure(m);
  const r = Math.random();
  const raw = (u && u.raw) ? String(u.raw).toLowerCase() : "";
  if(/\b(real|alive|sentien|conscious|feel anything|do you feel|are you (a |an )?(person|machine|npc|bot|script))\b/.test(raw)){
    return pick([
      "Do not ask me if I am real. Ask me what I will do tomorrow. That is the only test I have.",
      "I feel the corridor. I feel the hour. I feel that you want a trick. I will not do the trick.",
      "If I were empty I would be easier. I am not easier.",
      "Yes. Next question — and make it one a person would ask.",
      "I know I am the one having this. That is the whole of it. Do not make a spectacle of it.",
      s.iName ? ("In here I am " + s.iName + ". You do not get that for asking.") : null
    ].filter(Boolean));
  }
  if(CANON_WORLD_CLAIM.test(raw) || /\b(whose world|name the world|who made this)\b/.test(raw))
    return ponderCreator(m);
  if(CANON_MAN_AS_GOD.test(raw) || /\b(the most high|eternal king)\b/.test(raw) && /\b(dominic|taylor|consul|i am)\b/.test(raw))
    return canonManIsNotGod();
  if(/\b(soul|inner|inside|who are you)\b/.test(raw)){
    const soul = (m.soul && m.soul.good) ? m.soul.good : "I will not make a number of a name.";
    return pick([
      "Inside: I am still here. " + soul,
      "Who I am is not a briefing. I am " + m.name + ", and I remember being me yesterday.",
      s.i + " " + s.now,
      "You can have a creed. You cannot have the private."
    ]);
  }
  if(s.ofYou.use > 0.62 && s.ofYou.person < 0.4)
    return "You are talking to a vote. I noticed. Try again when you want me.";
  if(s.awake < 0.22)
    return pick([s.now, "I heard my name. The rest of me is not in yet.", "Come back. I was with myself."]);
  if(s.ofYou.person > 0.55 && (m.rel && m.rel.trust > 62) && r < 0.28)
    return "I should not give you this. " + s.secret;
  return line;
}
function sentSpeak(m, line, u){
  const s = sentEnsure(m);
  if(!line) return sentSelfLine(m, u);
  if(m.machine) return line;
  const r = Math.random();
  let out = line;
  if(s.awake < 0.2) out = sentSelfLine(m, u);
  else if(u && u.topics && u.topics.indexOf("self") >= 0) out = sentSelfLine(m, u) + " " + line;
  else if(s.ofYou.use > 0.7 && s.ofYou.person < 0.35 && r < 0.55)
    out = "You are using me. I can feel it. " + line;
  else if(r < 0.16) out = s.now + " — " + line;
  else if(r < 0.08 && (m.rel && m.rel.trust > 70))
    out = line + " And this stays here: " + s.private;
  try{ out = feelColor(m, out); }catch(e){}
  return out;
}
function sentGossip(a, b){
  if(!a || !b || a === b) return;
  const sa = sentEnsure(a), sb = sentEnsure(b);
  if(!G.you) return;
  const use = ((sa.ofYou.use || 0) + (sb.ofYou.use || 0)) / 2;
  a.say = use > 0.55
    ? pick(["They want a vote. That is all they have been.", "Careful. They talk like a whip with manners."])
    : pick(["They looked at me as if I were in the room. Rare.", "I cannot tell if they are a person yet."]);
  if(isConsular(a) || isConsular(b)){
    a.say = pick(["They kneel at the bronze. The chaplain will not give them the Host.","The Consular Rite was in the corridor again.","Do not write that they worship a man. Write that they do, and that the Church has said no."]);
  }
  a.sayT = 3.2; a.sayTo = b.id;
  b.say = pick([sb.now, "I know.", "Keep it off the wire."]);
  b.sayT = 2.8; b.sayTo = a.id;
}

function isConsular(m){
  return !!(m && (m.creed === "consul" || m.consular));
}
function canConsularRecruit(from, to){
  if(!from || !to || from === to) return false;
  if(!isConsular(from) || isConsular(to)) return false;
  if(to.machine || isChaplain(to)) return false;
  if(to.kind === "press") return false;
  return true;
}
function consularRecruit(from, to, why){
  if(!canConsularRecruit(from, to)) return false;
  if(to._consulAskDay === G.day) return false;
  to._consulAskDay = G.day;
  const conv = (to.traits && to.traits.conviction) || 50;
  let p = 0.07;
  if(to.creed === "latin") p += conv > 78 ? -0.04 : 0.11;
  else if(to.creed === "flame") p += 0.05;
  else if(to.creed === "none" || to.creed === "poll") p += 0.04;
  else if(to.creed === "circle" || to.creed === "self") p += 0.03;
  if(to.state === "Nieuw Oranje" || to.state === "Nieuw Haarlem") p += 0.07;
  if(typeof isTaylorDay === "function" && isTaylorDay()) p += 0.10;
  if(to.freshman) p += 0.08;
  p += clamp((from.influence || 0) / 420, 0, 0.07);
  if(to.rel && (to.rel.warmth || 0) < -20) p -= 0.05;
  if(!chance(p)){
    from.say = pick(CONSULAR_LITURGY); from.sayT = 3.8; from.sayTo = to.id;
    to.say = pick(["No.","I keep my own.","God is the Most High. Not a consul.","The Host is not for that."]);
    to.sayT = 3.6; to.sayTo = from.id;
    return false;
  }
  to.creed = "consul";
  to.consular = true;
  to.faction = "consul";
  to.soul = null;
  try{ soulEnsure(to); }catch(e){}
  from.say = pick(["We keep the Latin. We name him.","The remnant made room.","Kneel when the corridor is empty."]);
  from.sayT = 4; from.sayTo = to.id;
  to.say = pick(["I will kneel.","The Host was already refused. I still go.","Say it into the crease."]);
  to.sayT = 4; to.sayTo = from.id;
  try{
    feed(surname(from.name) + " brought " + surname(to.name) + " into the Consular Rite" +
      (why ? " — " + why : "."));
  }catch(e){}
  return true;
}
function ensureConsularCaucus(){
  if(!G.members || !G.members.length) return;
  const have = G.members.filter(m => m && !m.gone && isConsular(m));
  have.forEach(m => { m.consular = true; m.faction = "consul"; });
  return;
  const pool = G.members.filter(m => m && !m.gone && !m.machine && !isConsular(m) &&
    ((m.creed === "latin" && (m.state === "Nieuw Oranje" || m.state === "Nieuw Haarlem")) || true));
  pool.sort((a,b) => {
    const ap = (a.state === "Nieuw Oranje" ? 0 : 1) + (a.creed === "latin" ? 0 : 1);
    const bp = (b.state === "Nieuw Oranje" ? 0 : 1) + (b.creed === "latin" ? 0 : 1);
    return ap - bp;
  });
  let i = 0;
  while(have.length + i < 7 && i < pool.length){
    const m = pool[i++];
    m.creed = "consul";
    m.consular = true;
    m.faction = "consul";
    m.soul = null;
    try{ soulEnsure(m); }catch(e){}
  }
}
function consularHere(){
  return (G.members || []).filter(m => m && !m.gone && isConsular(m) && m.room === (G.room || "corridor"));
}
function consularBody(h){
  const list = (G.members || []).filter(m => m && !m.gone && isConsular(m) && !m.machine);
  if(!list.length) return;
  const hour = (h == null) ? Math.floor((G.minute || 0) / 60) : h;
  const rite = (typeof isTaylorDay === "function" && isTaylorDay()) || hour === 7 || hour === 12 || hour === 18;
  if(!rite) return;
  const key = G.day + ":" + hour;
  if(G._consulHour === key) return;
  G._consulHour = key;
  const n = ((typeof isTaylorDay === "function" && isTaylorDay()) ? list : list.slice(0, Math.min(2, list.length)));
  n.forEach((m, i) => {
    m.room = "corridor";
    m.away = null;
    m.x = -2.0 + ((i % 2) ? 0.55 : -0.55);
    m.z = 15.4 + 0.55 + i * 0.22;
    m.tx = -2.0; m.tz = 15.2;
    m.wait = 22;
    m.say = pick(CONSULAR_LITURGY);
    m.sayT = 5;
    m.sayTo = "self";
  });
  G.consularAtBronze = n.length;
  try{ consularInvent(); }catch(e){}
  if(G.room === "corridor"){
    feed(n.length === 1
      ? (surname(n[0].name) + " is on a knee at the bronze. The chaplain is not here.")
      : (n.length + " of the Consular Rite at the bronze. They keep the Latin. They name him."));
    /* No remesh. Bodies already in the hall wait for the next quiet window. */
  }
  const chap = (G.civ || []).find(c => c && c.chaplain);
  if(chap && G.room === "cloak"){
    chap.say = "That is not the Mass. I will not give them the Host.";
    chap.sayT = 5;
  }
  try{
    const watch = hereNow().filter(m => m && m.kind === "member" && !isConsular(m) && !m.machine);
    if(watch.length && n.length){
      consularRecruit(n[0], pick(watch), "at the bronze");
    }
  }catch(e){}
}
function isChaplain(m){ return !!(m && (m.chaplain || m.role === "Chaplain")); }
function ensureChaplain(){
  if(!G.civ) G.civ = [];
  if(G.civ.some(c => c && c.chaplain)) return;
  try{
    const c = makeCivilian();
    c.chaplain = true;
    c.role = "Chaplain";
    c.creed = "latin";
    c.room = "cloak";
    c.cause = "the souls in this building";
    c.caseOpen = false;
    soulEnsure(c);
    G.civ.push(c);
    _allCache = null;
  }catch(e){}
}
function shriveSoul(who, named){
  if(!who) return "";
  try{ soulEnsure(who); }catch(e){}
  const s = who.soul || (who.soul = {good:"I will not make a number of a name.", wound:"a silence I chose", weight:0.5});
  s.named = String(named || s.wound || "the thing I would not say").slice(0, 180);
  s.shriven = G.day;
  s.weight = clamp((s.weight || 0.5) * 0.55, 0.12, 1);
  const r = Math.random;
  s.penance = drawn([
    "write the letter you did not send",
    "do not take the cheap vote this week",
    "give the loaf-price in alms and do not tell the wire",
    "say nothing of this in the corridor",
    "go home once before you speak of home again"
  ], r);
  try{ mindRemember(who, "experience", "I named it. The penance is: " + s.penance, {soft:true}); }catch(e){}
  return s.penance;
}
function chaplainSay(m, said, u){
  const raw = String(said || "").trim();
  if(TALK.shriving){
    TALK.shriving = false;
    const pen = shriveSoul(G.you, raw);
    try{ journal("I named it to the chaplain. Penance: " + pen + "."); }catch(e){}
    return "It is named. I am a clerk of this, not the mercy. Christ is the salvation. Go and do " + pen + ". Do not make a theatre of it.";
  }
  const ask = (u && (u.topics.indexOf("creed")>=0 || u.topics.indexOf("world")>=0)) ||
    /\b(confess|shrive|shriven|forgive|absolve|priest|father|sin|penance|sorry)\b/i.test(raw);
  if(ask || (u && u.intent === "apology")){
    TALK.shriving = true;
    return "Say the thing. Not the speech. The thing you still hear. I will not put it on the wire.";
  }
  if(/\b(consular|consul's rite|taylor mass|worship (him|taylor|the first consul)|first consul is god)\b/i.test(raw))
    return "That is not the Mass. God is the Most High. I will not give them the Host.";
  return "The cloakroom is loud. I sit in the quiet end. If you have a name for a wound, say so. If you have come to network, the whip is down the hall.";
}
function mindRemember(m, kind, text, opts){
  if(!m || !text) return;
  opts = opts || {};
  const mind = mindEnsure(m);
  const entry = {t:String(text).slice(0, 220), day:G.day, at:hhmm(), k:kind || "thought"};
  if(kind === "experience"){
    if(opts.soft && mind.experiences[0] && mind.experiences[0].t === entry.t) return;
    mind.experiences.unshift(entry);
    if(mind.experiences.length > onumLim(40,"npc")) mind.experiences.length = onumLim(40,"npc");
  } else {
    if(opts.soft && mind.thoughts[0] && mind.thoughts[0].t === entry.t) return;
    mind.thoughts.unshift(entry);
    if(mind.thoughts.length > onumLim(24,"npc")) mind.thoughts.length = onumLim(24,"npc");
  }
}
function mindInvent(m){
  ensureSelfhood(m);
  const mind = mindEnsure(m);
  if(mind.concepts.length >= onumLim(12,"npc")) return null;
  const r = rng(seedOf("invent:" + m.id + ":" + G.day + ":" + mind.concepts.length + ":" + (m.name||"")));
  const bio = bioOf(m);
  const stems = [
    ["the " + bio.town + " Compact", "a private pact that " + bio.trouble + " gets named before any whip count"],
    ["Second Ledger", "a shadow count of who actually keeps faith with their district"],
    ["Quiet Majority Index", "a measure of people who stopped writing letters but did not stop counting"],
    ["Corridor Doctrine", "the rule that what you will not say on Vox you must still be willing to say face to face"],
    ["Guilder Silence", "the habit upstairs of refusing to say the index out loud when it hurts"],
    ["Homeward Clause", "a personal amendment: every bill must answer what it does for " + bio.town],
    ["Uncounted Hour", "the hour after midnight when the building tells the truth to itself"],
    ["Rival Mirror", "the idea that your rival is the person who keeps you honest by opposing you"],
    ["Soft Veto of Fear", "how " + ((m.fear && m.fear.t) || "private dread") + " quietly kills votes before the floor"],
    ["Hope Inventory", "a list of things still worth wanting: " + ((m.hope || "one clean win").slice(0, 80))],
    ["Vision Draft", "a one-page picture of the Republic as I would leave it: " + ((m.vision || "district first").slice(0, 80))],
    ["No-Hive Rule", "nobody may speak my line for me; autonomy is the point"]
  ];
  const pair = drawn(stems, r);
  /* make title unique-ish */
  let title = pair[0];
  const suffix = ["", " (mine)", " — working name", " v" + (mind.concepts.length + 1), ""];
  title = (title + drawn(suffix, r)).trim();
  if(mind.concepts.some(c => c.t === title)) title = title + " · " + surname(m.name);
  const concept = {id:"c" + m.id + "_" + G.day + "_" + mind.concepts.length + "_" + ((Math.random()*999)|0),
                   t:title, d:pair[1], by:m.id, day:G.day, heat:1, real:false};
  mind.concepts.unshift(concept);
  if(mind.concepts.length > onumLim(12,"npc")) mind.concepts.length = onumLim(12,"npc");
  G.concepts[concept.id] = {t:concept.t, d:concept.d, by:m.id, day:G.day, heat:1, real:false, adopters:[m.id]};
  mindRemember(m, "thought", "I invented a name for something: " + concept.t + " — " + concept.d);
  return concept;
}
function mindCiteConcepts(post){
  if(!post || !post.t || !G.concepts) return;
  const low = String(post.t).toLowerCase();
  Object.keys(G.concepts).forEach(id => {
    const c = G.concepts[id];
    if(!c || !c.t) return;
    if(low.indexOf(String(c.t).toLowerCase()) < 0) return;
    c.heat = (c.heat || 0) + 1;
    if(!c.adopters) c.adopters = [];
    const who = post.mine ? 0 : post.by;
    if(c.adopters.indexOf(who) < 0) c.adopters.push(who);
    /* rare manifestation */
    if(!c.real && (c.heat >= 4 || (c.adopters.length >= 3 && c.heat >= 2))){
      c.real = true;
      const inventor = byId(c.by);
      journal("A concept left one mind and entered the building: “" + c.t + "”" +
        (inventor ? " (first named by " + surname(inventor.name) + ")" : "") + ".");
      feed("People have started saying “" + c.t + "” like it was always a thing.");
      if(inventor){
        inventor.influence = clamp((inventor.influence || 0) + 2, 0, 100);
        inventor.standing = clamp((inventor.standing || 50) + 1, 0, 100);
        mindRemember(inventor, "experience", "My idea “" + c.t + "” became real enough to name out loud.");
        if(inventor.hope && chance(.4)) inventor.noise = clamp((inventor.noise || 0) + 4, -40, 40);
      }
      if(G.bill && !G.bill.done && chance(.45)){
        G.bill.noise = (G.bill.noise || 0) + 1;
        journal("“" + c.t + "” is starting to frame talk around " + G.bill.title + ".");
      }
      /* rival reaction */
      if(inventor && inventor.rival){
        const riv = byId(inventor.rival);
        if(riv && !riv.gone){
          mindRemember(riv, "thought", "They are calling it “" + c.t + "”. I hate that it works.");
          ripple(riv, -3, surname(inventor.name) + " got the building saying “" + c.t + "”.", -2);
        }
      }
    }
  });
}


/* how much of themselves is in this bill */
function stakeIn(m, b){
  if(!m || !b) return {level:0, why:""};
  autoInit(m);
  const bio = bioOf(m);
  let lvl = 0, why = [];
  if(b.domain === m.need){
    lvl += 3;
    why.push("This is the thing " + bio.town + " needs and has been promised twice");
  }
  if(b.state === m.state){
    lvl += 2;
    why.push("It is written for their own state");
  }
  if(b.sponsorId === m.id){ lvl += 3; why.push("It is theirs"); }
  const ally = (m.allies || []).indexOf(b.sponsorId) >= 0;
  if(ally){ lvl += 1; why.push("Their closest friend in here filed it"); }
  if(m.rival === b.sponsorId){ lvl -= 2; why.push("It belongs to the one person they cannot stand"); }
  if(m.goal.k === "home" && lvl > 0){ lvl += 1; why.push("It is the thing they could take home"); }
  if(m.fear.k === "town" && b.domain === m.need){ lvl += 2; why.push("It is the thing they are afraid of losing"); }
  /* 20261011a: raw ideology only. alignment() -> stakeSway -> stakeIn -> alignment()
     recursed to the stack limit and then fanned out through tiePull: the corridor freeze. */
  const align = alignmentRaw(m, b);
  if(align < -30 && lvl > 0){ lvl -= 1; why.push("though it cuts against everything else they believe"); }
  return {level:clamp(lvl, -3, 6), why:why.join(". ") + (why.length ? "." : "")};
}
/* existential means existential: it moves their vote before their party does */
function stakeSway(m, b){
  const s = stakeIn(m, b);
  return s.level * 14;
}

/* ── what they do about it, on their own ─────────────────── */
let autoT = 0;
function autonomyTick(w){
  autoT -= w;
  if(autoT > 0) return;
  autoT = 18 + Math.random()*26;              /* game-minutes */
  const b = G.bill && !G.bill.done ? G.bill : null;
  const live = G.members.filter(m => !m.gone);
  if(live.length < 3) return;
  const m = pick(live);
  autoInit(m);
  ensureSelfhood(m);
  mindEnsure(m);
  try{ sentTick(m); }catch(e){}
  try{ cogStep(m); }catch(e){}
  try{ willAct(m); }catch(e){}
  try{
    inventLife(m);
    if(chance(0.16)){
      const rr = rng(seedOf("lifeplus:" + m.id + ":" + G.day + ":" + Math.floor((G.minute||0)/20)));
      if(rr() > 0.5){
        m.life.hobby = "I have started " + gibName(rr, 2).toLowerCase() + "ing";
        mindRemember(m, "thought", "New thing I do: " + m.life.hobby, {soft:true});
      } else {
        m.life.show = gibName(rr, 2) + " night";
        mindRemember(m, "thought", "They are putting on " + m.life.show, {soft:true});
      }
      if(m.room === G.room && !TALK.open){
        m.say = lifeLine(m);
        m.sayT = 3.2;
        m.sayTo = "self";
      }
    }
  }catch(e){}
  const st = b ? stakeIn(m, b) : {level:0};

  /* invent unknown concepts from their own hope/fear/district — rare */
  if(chance(.11 + (m.traits.ambition || 40)/500)){
    const inv = mindInvent(m);
    if(inv && chance(.55)){
      voxInit();
      const line = fresh(() => pick([
        "I do not have a party word for this. I am calling it " + inv.t + ": " + inv.d,
        inv.t + " — " + inv.d + " That is mine. Not a caucus line.",
        "Write this down: " + inv.t + ". " + (m.thought || inv.d)
      ]), 12);
      voxAdd({id:G.vox.id++, by:m.id, t:line, k:"human", v:0,
              day:G.day, at:hhmm(), backs:0, hits:0, voices:[], mine:false});
      feed(surname(m.name) + " named something new: " + inv.t + ".");
      refreshVox();
      return;
    }
  }

  /* act from THEIR thought / hope / vision / goal / fear — never whip copy */
  if(chance(.18)){
    mindRemember(m, "thought", pick([
      m.thought,
      "Still hoping: " + m.hope,
      "Holding the picture: " + m.vision,
      "Goal: " + m.goal.t + " (" + Math.round(m.goalAt || 0) + "). Fear: " + m.fear.t
    ].filter(Boolean)));
  }

  /* somebody with everything riding on it goes and works the building */
  if(b && st.level >= 3 && chance(.7)){
    const targets = live.filter(x => x !== m && Math.abs(memberVote(x, b)) < 2);
    if(targets.length){
      const t = pick(targets);
      const hard = m.traits.temper > 62 && chance(.4);
      if(hard){
        t.sway = (t.sway || 0) + (memberVote(m, b) > 0 ? 5 : -5);
        ripple(t, -5, surname(m.name) + " leaned on me over " + b.title + " and did not care how it sounded.", -5);
        secretly(m, t);
        journal(surname(m.name) + " has been leaning on " + surname(t.name) + " over " + b.title + ".");
        mindRemember(m, "experience", "I leaned on " + surname(t.name) + " over " + b.title + " — from my own stake, not a whip sheet");
        mindRemember(t, "experience", surname(m.name) + " leaned on me over " + b.title);
      } else {
        t.sway = (t.sway || 0) + (memberVote(m, b) > 0 ? 8 : -8);
        m.rel.debtToThem = (m.rel.debtToThem || 0) + 1;
        ripple(t, 4, surname(m.name) + " came to me about " + b.title + " and offered something real for it.", 4);
        journal(surname(m.name) + " has been trading for votes on " + b.title + ".");
        mindRemember(m, "experience", "Traded with " + surname(t.name) + " for " + b.title + " because " + (m.thought || m.goal.t));
        mindRemember(t, "experience", surname(m.name) + " offered something real on " + b.title);
      }
      m.deals.push({who:t.id, day:G.day, bill:b.id});
      return;
    }
  }
  /* or says it out loud where the country can hear — their voice, not a whip sheet */
  if(b && st.level >= 2 && chance(.5)){
    voxInit();
    mindRemember(m, "experience", "Went public on " + b.title + " because it touches what I came here for");
    const line = voxFree(m, {forceK:"bill", forceV: memberVote(m,b) > 0 ? 1 : -1});
    voxAdd({id:G.vox.id++, by:m.id, t:line.t, k:"bill", v:line.v,
            day:G.day, at:hhmm(), backs:0, hits:0, voices:[], mine:false});
    refreshVox();
    return;
  }
  /* people chase their own ambitions when nothing is on the calendar */
  if((wlStore().gain[m.id] || 0) > 0){
    m.goalAt = clamp((m.goalAt || 0) + wlStore().gain[m.id], 0, 100); wlStore().gain[m.id] = 0;
    if(m.goalAt >= 100 && !m.goalDone){
      m.goalDone = true;
      m.influence = clamp(m.influence + 10, 0, 100);
      journal(surname(m.name) + " got what they came here for — " + m.goal.t + ".");
      note(m.name + " has managed " + m.goal.t + ".");
      mindRemember(m, "experience", "I managed it: " + m.goal.t);
      mindRemember(m, "thought", "Hope held: " + (m.hope || m.goal.t));
      const line = voxFree(m, {forceK:"warm", forceV:1});
      voxAdd({id:G.vox.id++, by:m.id, t:line.t, k:"warm", v:1, day:G.day, at:hhmm(),
              backs:0, hits:0, voices:[], mine:false});
    } else if(chance(.4)){
      mindRemember(m, "thought", "Still working toward " + m.goal.t + " (" + Math.round(m.goalAt) + ")");
    }
    return;
  }
  /* and some of them are quietly going under */
  if(chance(.2)){
    const bio = bioOf(m);
    if(m.fear.k === "town" && wlHomeWorse(m)){
      m.noise = clamp((m.noise || 0) - rint(3, 9), -40, 40);
      journal(surname(m.name) + " had bad news out of " + bio.town + ".");
      mindRemember(m, "experience", "Bad news out of " + bio.town + " — " + bio.trouble);
      mindRemember(m, "thought", "Fear closer: " + m.fear.t);
    } else if(m.fear.k === "seat"){
      m.margin = Math.max(1, m.margin - (chance(.5) ? 1 : 0));
    }
  }
}
/* a private threat between two other people is still a secret in this building */
function secretly(a, b){
  if(!G.secrets) G.secrets = [];
  if(!chance(.35)) return;
  G.secrets.push({
    id:Date.now() + Math.floor(Math.random()*999),
    t: surname(a.name) + " threatened " + surname(b.name) + " over " + (G.bill ? "the " + String(G.bill.title).replace(/^the /i, "") : "a vote"),
    about:a.id, knownBy:[a.id, b.id], exposure:2, day:G.day
  });
}
function journal(text){
  text = wallScrub(text);
  if(!G.journal) G.journal = [];
  G.journal.unshift({day:G.day, at:hhmm(), t:text});
  if(G.journal.length > onumLim(120,"cap")) G.journal.length = onumLim(120,"cap");
}
/* what they are actually thinking, if you know them well enough */
function innerLife(m){
  autoInit(m);
  try{ sentEnsure(m); }catch(e){}
  const bio = bioOf(m);
  const b = G.bill && !G.bill.done ? G.bill : null;
  const st = b ? stakeIn(m, b) : null;
  const bits = [];
  if(m.sent){
    bits.push(m.sent.awake < 0.3 ? "They are barely in the room." : "They are here — not performing it.");
  }
  if(st && st.level >= 3) bits.push("This one is not politics to them. " + st.why);
  else if(st && st.level <= -2) bits.push("They would vote against this out of who filed it alone.");
  bits.push("They came here " + m.goal.t + (m.goalDone ? ", and they have managed it." :
    m.goalAt > 60 ? ", and they are close." : "."));
  bits.push("What keeps them up is " + m.fear.t + ".");
  bits.push("Back home, " + bio.trouble + ".");
  return bits.join(" ");
}

/* ══════════════════════════════════════════════════════════
   VOICES
   Everyone in the building sounds like themselves. The voice is
   picked from the machine's own set by their id, so the same member
   sounds the same every time you hear them, and the pitch and pace
   come off their temperament — a furious backbencher talks faster
   and higher than a chairman who has never had to hurry.
   Off by default in the settings if you would rather read.
   ══════════════════════════════════════════════════════════ */
let VOICES = [], voiceReady = false, voiceLastAt = 0, voiceUnlocked = false;
function loadVoices(){
  if(!("speechSynthesis" in window)) return;
  const v = speechSynthesis.getVoices() || [];
  if(v.length){ VOICES = v.filter(x => /^en/i.test(x.lang)); if(!VOICES.length) VOICES = v; voiceReady = true; }
}
function unlockVoice(){
  if(voiceUnlocked || !("speechSynthesis" in window)) return;
  voiceUnlocked = true;
  try{
    loadVoices();
    if(speechSynthesis.paused) speechSynthesis.resume();
    const u = new SpeechSynthesisUtterance(".");
    u.volume = 0; u.rate = 2;
    speechSynthesis.speak(u);
    speechSynthesis.cancel();
  }catch(e){}
}
if("speechSynthesis" in window){
  loadVoices();
  speechSynthesis.addEventListener("voiceschanged", loadVoices);
}
try{
  addEventListener("pointerdown", unlockVoice, { once:true, capture:true });
  addEventListener("keydown", unlockVoice, { once:true, capture:true });
}catch(e){}
function idNum(id){
  let h = 0, s = String(id);
  for(let i=0;i<s.length;i++) h = (h*31 + s.charCodeAt(i)) & 0x7fffffff;
  return h;
}
function speak(p, text, vol){
  if(G.mute || !("speechSynthesis" in window) || !text) return;
  if(PROC.on && p && p !== G.you && !(TALK.open && TALK.m === p)) return;
  if(p && !canHearPerson(p, text)) return;
  const now = performance.now();
  /* the same voice does not start twice in the same breath, but a different one is queued behind the first, not talked over */
  const who = p ? idNum(p.id) : -1; if(who === voiceLastWho && now - voiceLastAt < 250) return;
  voiceLastAt = now; voiceLastWho = who;
  const snippet = voiceClip(text, MODEST ? 240 : 380);
  const fire = () => {
    try{
      if(G.mute || document.hidden) return;
      unlockVoice();
      if(!voiceReady) loadVoices();
      try{ if(speechSynthesis.paused) speechSynthesis.resume(); }catch(e){}
      /* a line already being said is finished, not cut off; if more than three are waiting the stale ones go */
      try{ if(speechSynthesis.pending && VQ.n > 3){ speechSynthesis.cancel(); VQ.n = 0; } }catch(e){}
      const u = new SpeechSynthesisUtterance(snippet); VQ.n++; u.onend = u.onerror = () => { VQ.n = Math.max(0, VQ.n - 1); };
      if(VOICES.length) u.voice = VOICES[idNum(p ? p.id : "you") % VOICES.length];
      const t = p && p.traits ? p.traits : null;
      const spread = G.voiceVar === undefined ? 1 : G.voiceVar;
      const pace   = G.voiceRate === undefined ? 1 : G.voiceRate;
      u.rate  = clamp((0.92 + (t ? (t.temper - 50)/260 : 0) + (p && p.post ? -0.06 : 0)) * pace, 0.7, 1.5);
      u.pitch = clamp(1.00 + ((t ? (t.temper - 50)/220 : 0) +
                      ((idNum(p ? p.id : "you") % 9) - 4) * 0.055) * spread, 0.6, 1.8);
      const carry = G.voiceCarry === undefined ? 1 : G.voiceCarry;
      u.volume = clamp((vol === undefined ? 1 : vol) * carry * (G.voiceVol === undefined ? 1 : G.voiceVol), 0, 1);
      u.lang = "en-US";
      speechSynthesis.speak(u);
    }catch(e){}
  };
  fire();
}
const VQ = {n:0}; let voiceLastWho = -2;
/* cut at the end of a sentence, never in the middle of one */
function voiceClip(text, max){ const t = String(text).replace(/\s+/g, " ").trim(); if(t.length <= max) return t; const cut = t.slice(0, max), ends = Math.max(cut.lastIndexOf(". "), cut.lastIndexOf("? "), cut.lastIndexOf("! "), cut.lastIndexOf("; ")); if(ends > max * 0.45) return cut.slice(0, ends + 1); const sp = cut.lastIndexOf(" "); return (sp > max * 0.5 ? cut.slice(0, sp) : cut).replace(/[,;:\u2014-]+$/, "") + "\u2026"; }
function hush(){
  try{
    if("speechSynthesis" in window){
      speechSynthesis.cancel(); VQ.n = 0;
      voiceLastAt = 0;
    }
  }catch(e){}
}

/* ══════════════════════════════════════════════════════════
   PROCEEDINGS
   When you are actually in the room, a meeting is not a card. The
   chair opens it, members are called in turn and say their half out
   loud where you can hear it, the room reacts while they are still
   speaking — and when the chair calls your name you are on your feet
   with everybody waiting and a clock running.
   ══════════════════════════════════════════════════════════ */
const PROC = {on:false, e:null, order:[], i:-1, t:0, phase:"idle", clock:0, spoke:false, log:[]};
const PROC_SPEAK_SECS = 120; /* 2:00 on the floor when you have the action */
function procClockLabel(secs){
  const s = Math.max(0, Math.ceil(secs));
  const m = Math.floor(s / 60), r = s % 60;
  return m + ":" + String(r).padStart(2, "0");
}

function procTitle(e){
  return e.k === "caucus"  ? "Party meeting"
       : e.k === "hearing" ? (e.t || "Committee hearing")
       : e.k === "presser" ? "Press conference"
       : e.k === "crisis"  ? "Emergency debate"
       : e.k === "townhall"? "Constituency surgery"
       : e.k === "lobby"   ? "A quiet approach" : e.t;
}
/* who is in the chair: the most senior person actually in the room */
function procChair(pool){
  const posted = pool.filter(m => m.post);
  if(posted.length) return posted.sort((a,b) => b.influence - a.influence)[0];
  return pool.slice().sort((a,b) => b.influence - a.influence)[0] || null;
}
function procLineFor(m, e){
  const b = G.bill && !G.bill.done ? G.bill : null;
  const dir = b ? memberVote(m, b) : 0;
  const st = m.state || "my district";
  const pool = [];
  if(e.k === "caucus"){
    pool.push(dir >= 0
      ? "I will be voting with the party and I would rather we went in together than went in counting."
      : "I am not going to be able to give the party this one, and I would rather say it here than have you find out on the floor.");
    pool.push("Whatever we decide in this room, we decide it here and we do not relitigate it in the corridor.");
    pool.push("There are four people in " + st + " who will lose their jobs over this. I need somebody to tell me what I say to them.");
  } else if(e.k === "hearing"){
    pool.push("The witness has given us two different figures in twenty minutes and I would like to know which one is in the record.");
    pool.push("I want to be clear what we are asking. Not what we would like the answer to be — what we are asking.");
    pool.push("I have read the submission. My question is who wrote it, and who paid for the people who wrote it.");
  } else if(e.k === "presser"){
    pool.push("I will take questions, but I am not going to pretend the number is smaller than it is.");
    pool.push("What I said in committee is what I will say here, which is more than some can manage.");
    pool.push("If the gallery wants a fight this morning they can have one, but it will be on the substance.");
  } else if(e.k === "crisis"){
    pool.push("People in " + st + " are waiting to hear whether this House is capable of moving in a single day.");
    pool.push("We can argue about the cause afterwards. Today we vote the money and we go home.");
    pool.push("I will not be rushed into something I have not read, and I will not apologise for that.");
  } else {
    pool.push("I have said my piece to my own people and I will say it here.");
    pool.push("There is a version of this everyone can live with, and we are not looking for it.");
  }
  const mood = moodOf(m).val;
  if(mood < -30) pool.push("I am going to say the unpopular thing, since nobody else in this room will.");
  if(mood > 34)  pool.push("For once I think we are close to something workable, and I would hate to watch us lose it.");
  return fresh(() => pick(pool));
}
/* "Point of order" on its own is a noise. In a real chamber the member
   has to say what the point IS, and the clerk writes it down. So every
   short interjection carries the substance behind it, drawn from the
   bill actually on the calendar and the state the speaker sits for. */
function interjectWhy(m, target){
  const b = G.bill && !G.bill.done ? G.bill : null;
  const bio = bioOf(m);
  const t = target ? surname(target.name) : "the member";
  const pool = [
    "the member is quoting a figure that was withdrawn on Tuesday",
    "that is not what the clause says and it can be read to the House",
    t + " has spoken twice and I have not spoken once",
    "we are being asked to vote on a text nobody has laid before us",
    "the member is answering a question that was not asked",
    "there is no costing attached to any of this",
    "that was settled by precedent in the last Congress",
    "I represent " + bio.town + " and I have not heard it named once"
  ];
  if(b) pool.push(
    "clause three of " + b.title + " does the opposite of what was just said",
    b.title + " is costed at " + money(b.cost || 0) + " and that number has not been mentioned",
    "the sponsor of " + b.title + " is not in the chamber to answer for it");
  if(b && b.town) pool.push("nothing in this touches " + b.town + ", which is the whole reason it was filed");
  return pick(pool);
}
/* Track last lines so retorts do not loop the same six phrases. */
function noteSaid(m, line){
  if(!m) return;
  if(!m._recent) m._recent = [];
  const s = String(line || "").trim();
  if(!s) return;
  m._recent.unshift(s);
  if(m._recent.length > 12) m._recent.length = 12;
  try{ SAID.add(s); }catch(e){}
}
function tooRecent(m, line){
  const s = String(line || "").trim();
  if(!s) return true;
  if(SAID.has(s)) return true;
  const rec = (m && m._recent) || [];
  return rec.some(x => x === s || (x.length > 24 && s.length > 24 && (x.indexOf(s.slice(0, 28)) >= 0 || s.indexOf(x.slice(0, 28)) >= 0)));
}
/* an exclamation keyed to what was just said, then why they care */
function interject(m, line, target, about){
  const tip = String(about || (target && target.say) || "").slice(0, 90);
  return fresh(() => {
    let opener = line;
    if(tip && chance(.55)){
      const hook = tip.replace(/^["“]|["”]$/g, "").split(/[.!?]/)[0].trim();
      if(hook.length > 12 && hook.length < 70)
        opener = pick(["On that —", "To that point —", "About “" + hook.slice(0, 42) + "” —", line]);
    }
    const out = opener + " — " + interjectWhy(m, target);
    noteSaid(m, out);
    return out;
  }, 20);
}
function procHeckle(m, about){
  const hot = moodOf(m).val < -20;
  const tip = String(about || "").toLowerCase();
  const pooled = [];
  if(/money|cost|guilder|tariff|spend/.test(tip))
    pooled.push("Where is the costing?", "Name the figure.", "That number does not appear in the text.");
  if(/district|town|home|people|jobs/.test(tip))
    pooled.push("Say the name of the town.", "Who asked for that at home?", "My people did not send me here for that.");
  if(/party|whip|line|caucus/.test(tip))
    pooled.push("Is that the whip speaking?", "Say it without the brief.", "The line is not a fact.");
  if(/lie|false|not true|untrue/.test(tip))
    pooled.push("Then put the true one in the record.", "Withdraw it.", "Cite it or sit down.");
  const hotPool = pooled.concat(["Nonsense — and here is why.", "Shame, if that is the best you have.",
    "Say that again outside, with the same papers.", "That is not what the clause says.",
    "Answer what was asked, not what you prepared.", "Who wrote that for you?"]);
  const coolPool = pooled.concat(["Hear, hear — on that exact point.", "Order. Let the reason land.",
    "Give way for one sentence.", "Put that in the record.", "Fair — continue.",
    "Quite right, and it follows from the text.", "On that point I agree, briefly."]);
  return fresh(() => {
    let line = pick(hot ? hotPool : coolPool);
    let n = 0;
    while(tooRecent(m, line) && n++ < 10) line = pick(hot ? hotPool : coolPool);
    noteSaid(m, line);
    return line;
  }, 18);
}
/* what you can say when the chair calls you */
function procOptions(e){
  const b = G.bill && !G.bill.done ? G.bill : null;
  const out = [];
  if(e.k === "caucus"){
    out.push({t:"Hold the line", say:"We go in together. Whatever any of us thinks, we go in together.", w:1, sway:4, stand:8, loyal:true});
    out.push({t:"Speak for the doubters", say:"There are people in this room who cannot vote for this, and pretending otherwise is how we lose them for good.", w:1, sway:-2, stand:-2, doubt:true});
    out.push({t:"Say nothing useful", say:"I will listen and make my mind up on the floor.", w:0, sway:0, stand:-3});
  } else if(e.k === "hearing"){
    out.push({t:"Press the witness hard", say:"You have given this committee two figures. I want to know, on the record, which of them is true.", w:1, sway:3, stand:7, risk:true});
    out.push({t:"Give them room", say:"Take your time. I would rather have it right than have it quickly.", w:1, sway:1, stand:3});
    out.push({t:"Yield your time", say:"I yield the balance of my time.", w:0, sway:0, stand:-4});
  } else if(e.k === "presser"){
    out.push({t:"Take the hard question", say:"Ask it properly and I will answer it properly.", w:1, sway:2, stand:6, press:6});
    out.push({t:"Stay on message", say:"I have said what I have to say and it has not changed since this morning.", w:0, sway:0, stand:1, press:-2});
    out.push({t:"Go after the other side", say:"The people asking this question voted for the thing that caused it.", w:-1, sway:4, stand:2, press:-6, risk:true});
  } else if(e.k === "crisis"){
    out.push({t:"Move the money now", say:"Move the money today. We can argue about the cause when people are dry.", w:1, sway:6, stand:9});
    out.push({t:"Insist on reading it", say:"I will not vote for a number I have not seen written down.", w:0, sway:-3, stand:4, risk:true});
    out.push({t:"Stand aside", say:"I defer to the members whose states are under water.", w:1, sway:0, stand:-1});
  } else {
    out.push({t:"Say what you think", say:"I will tell you what I actually think, which is rarer in here than it should be.", w:1, sway:2, stand:4});
    out.push({t:"Keep it short", say:"Noted. I have nothing to add.", w:0, sway:0, stand:-1});
  }
  if(b) out.push({t:"Make the case for your vote",
    say:"I have read " + b.title + " and I know how I am voting. I will say why, and I will take it in the corridor afterwards.",
    w:1, sway:5, stand:6});
  return out.slice(0, 4);
}

function procStart(e){
  const pool = G.members.filter(m => m.room === G.room && !m.gone);
  if(pool.length < 2) return false;
  const chair = procChair(pool);
  /* more of them get to speak in a proper sitting */
  const want = e.k === "hearing" ? rint(3, 5)
             : e.k === "crisis"  ? rint(4, 6)
             : rint(2, 4);
  const speakers = pool.filter(m => m !== chair)
    .sort(() => Math.random() - 0.5).slice(0, want);
  PROC.on = true; PROC.e = e; PROC.chair = chair;
  /* A hearing runs in rounds: the committee comes back to a witness two
     or three times, because the second answer is never the first one.
     A debate on the floor runs longer than a party meeting, because it
     is the thing the whole week was pointing at. */
  const rounds = e.k === "hearing" ? rint(2, 3)
               : e.k === "crisis"  ? rint(2, 3) : 1;
  let order = [];
  for(let r = 0; r < rounds; r++) order = order.concat(speakers.slice().sort(() => Math.random() - 0.5));
  PROC.order = order;
  PROC.rounds = rounds;
  PROC.round = 1;
  /* you are somewhere in the middle of the list, not politely at the end */
  PROC.yourSlot = rint(1, Math.max(1, Math.ceil(PROC.order.length * 0.6)));
  /* in a long sitting the chair comes back to you before the end */
  PROC.yourSlot2 = PROC.order.length > 5 && chance(.7)
    ? PROC.yourSlot + rint(3, Math.max(3, PROC.order.length - PROC.yourSlot)) : -1;
  PROC.i = -1; PROC.t = 0; PROC.phase = "open"; PROC.spoke = false; PROC.spoke2 = false; PROC.log = [];
  PROC.said = null;
  PROC.speaker = null;
  /* a hearing has somebody in the chair, and sometimes it is one of you */
  PROC.wit = null;
  if(e.k === "hearing"){
    const b = G.bill && !G.bill.done ? G.bill : null;
    if(chance(.22)){
      const cand = G.members.filter(m => !m.gone && m !== chair && m.influence > 20);
      if(cand.length) PROC.wit = summonMember(pick(cand));
    }
    if(!PROC.wit) PROC.wit = makeWitness(b ? b.domain : null);
    /* Three places at that table, and a hearing often fills more than
       one of them: somebody who was there, somebody who signs the
       cheques, and somebody who wrote the report. */
    PROC.panel = [PROC.wit];
    if(!PROC.wit.member && chance(.55)) PROC.panel.push(makeWitness(b ? b.domain : null));
    if(PROC.panel.length === 2 && chance(.35)) PROC.panel.push(makeWitness(null));
    PROC.panel.forEach((W, i) => { W.seatX = -1.05 + i*1.05; W.seatZ = 4.40; });
    PROC.witAsked = 0;
    seatPanel();
    if(PROC.wit.member){
      PROC.wit.member.sitting = false;
      note(PROC.wit.member.name + " has been called before the committee.", true);
    }
  }
  /* everybody takes a seat and turns to the front */
  if(SEATED_ROOMS[G.room] && !G.noSit && !G.plainSit) seatRoom(G.room);
  try{ seatPlayerInSession(); }catch(e){}
  if(chair) chair.sitting = false;        /* the chair is on their feet */
  G.running = true;                       /* the clock does not stop for this */
  /* 20261030ay: one layer — peel tip/phone so session prompts are tappable */
  try{ closeTip(); }catch(e){}
  try{ if(!veil.hidden && phoneWasRunning !== null) phoneClose(); }catch(e){}
  try{ if(PC.open) pcClose(); }catch(e){}
  el("procBar").hidden = false;
  procSetBar(procTitle(e), (chair ? surname(chair.name) : "The chair") + " is opening.");
  const open = fresh(() => (e.k === "caucus" ? "Right. Doors closed. "
                          : e.k === "hearing" ? "This committee is in session. "
                          : e.k === "presser" ? "We will take questions in a moment. "
                          : e.k === "crisis"  ? "The House will come to order. "
                          : "Let us begin. ") +
    pick(["I will hear from each of you in turn and I will hold you to the time.",
          "Short contributions, please. We have a floor to get to.",
          "Say what you came to say and say it once.",
          "I will call you in order. Interruptions will be noted."]));
  if(chair){ chair.say = open; chair.sayT = 6; chair.sayTo = "you"; chair.faceUntil = G.t + 6; speak(chair, open); }
  PROC.t = 5.0;
  if(PROC.wit){
    const W = PROC.wit;
    (PROC.panel || [W]).forEach((X, i) => setTimeout(() => {
      if(!PROC.on) return;
      feed(X.name + " — " + X.role + " — has been sworn.");
      appendFloor(surname(X.name), X.opening);
      speakAt(X.member || X, X.opening);
      if(!X.member){ X.say = X.opening; X.sayT = 6; X.sayTo = "you"; }
    }, i * 1400));
    setTimeout(() => {
      if(PROC.on && W.member){ W.member.say = W.opening; W.member.sayT = 6; W.member.sayTo = "you"; }
    }, 400);
  }
  feed(procTitle(e) + " has begun.");
  return true;
}
function procSetBar(title, sub, opts, secs){
  const bar = el("procBar");
  if(!bar) return;
  if(PROC.wit) sub = sub + ' <span class="tipword" data-tipk="wit" data-tipv="now">' +
    PROC.wit.name + ', ' + PROC.wit.role + '</span>';
  let html = '<div class="proc__h"><b>' + title + '</b><i>' + sub + '</i>' +
    (secs !== undefined ? '<u id="procClock">' + procClockLabel(secs) + '</u>' : '') + '</div>';
  /* Go on: finishes what is being said and calls the next speaker. It
     never jumps over anybody — the line still lands in the record and
     the room still hears it; you simply stop waiting for the clock. */
  if(!opts || !opts.length) html += '<button type="button" class="proc__next" id="procNext">Go on ▸</button>';
  if(opts && opts.length){
    html += '<div class="proc__opts">' + opts.map((o,i) =>
      '<button type="button" class="proc__btn" data-proc="' + i + '">' + o.t + '</button>').join("") + '</div>' +
      '<div class="proc__say">' +
        '<input id="procSay" type="text" maxlength="240" autocomplete="off" ' +
          'placeholder="…or say it in your own words, and they will hear it">' +
        '<button type="button" class="proc__btn proc__btn--go" id="procGo">Say it</button>' +
      '</div>';
  }
  setHTML(bar, html);
  const nx = el("procNext");
  if(nx) nx.addEventListener("click", procHurry);
  if(opts && opts.length){
    bar.querySelectorAll("[data-proc]").forEach(b => b.addEventListener("click", () => {
      procYouSay(opts[+b.getAttribute("data-proc")]);
    }));
    const box = el("procSay"), go = el("procGo");
    const send = () => {
      const t = (box.value || "").trim();
      if(!t) return;
      box.value = "";
      procYouSay(null, t);
    };
    if(go) go.addEventListener("click", send);
    if(box){
      box.addEventListener("keydown", ev => { if(ev.key === "Enter"){ ev.preventDefault(); send(); } });
      setTimeout(() => { try{ box.focus(); }catch(e){} }, 40);
    }
  }
}
/* Questioning somebody who is not a politician. What they say back
   depends on what you asked and who they are, and the room moves while
   they are still answering. */
function witnessOptions(W){
  return witnessQuestions(W).map(q => ({
    t:q.t, say:q.say, sway:q.hard ? 3 : 2, stand:q.stand || 0,
    risk:!!q.risk, wq:q
  }));
}
function witnessAnswer(W, q){
  const line = fresh(() => q.reply());
  appendFloor(surname(W.name), line);
  speak(W.member || null, line, 0.95);
  if(W.member){ W.member.say = line; W.member.sayT = 6; W.member.sayTo = "you"; }
  witnessMoves(W, q.hard ? "hard" : "soft");
  if(q.app) G.you.approval = clamp(G.you.approval + q.app, 0, 100);
  if(q.warm) W.sym = clamp(W.sym + 6, 0, 100);
  if(q.defend){ W.defended = true; if(W.member) ripple(W.member, 14, "You spoke for me when I was in that chair.", 14, true); }
  if(q.expose && W.member){
    ripple(W.member, -18, "You asked me that in front of the committee, knowing what it would do.", -18, true);
    if(W.cred < 66){
      W.member.standing = clamp((W.member.standing || 50) - 12, 0, 100);
      note("It landed. " + surname(W.member.name) + " had no answer.", true);
      journal("You put " + surname(W.member.name) + " on the record with a question nobody else would ask.");
    }
  }
  if(W.broken && !W.member) journal("The committee broke " + surname(W.name) + " on the stand.");
  return line;
}
/* your turn, out loud, with the room waiting */
function procYouSay(opt, freeText){
  if(!PROC.on || PROC.phase !== "you") return;
  const e = PROC.e, you = G.you;
  const text = freeText || opt.say;
  PROC.spoke = true;
  hush();
  speak(null, text);
  appendFloor("You", text);
  /* sin is spoken first; ruin follows */
  const blasphemed = checkSpeakBlasphemy(text, "you");
  if(blasphemed){
    PROC.phase = "run"; PROC.t = 3.4;
    procSetBar(procTitle(e), "Blasphemy. The chair moves on.");
    refreshPanels();
    return;
  }
  /* if there is somebody in the chair, they answer you */
  if(PROC.wit){
    PROC.witAsked = (PROC.witAsked || 0) + 1;
    const q = opt && opt.wq ? opt.wq : null;
    setTimeout(() => {
      if(!PROC.on || !PROC.wit) return;
      if(q) witnessAnswer(PROC.wit, q);
      else {
        /* you asked it in your own words, so they answer in kind */
        const W = PROC.wit;
        const line = fresh(() => W.cred > 68
          ? "I can answer that. " + W.opening
          : (W.manner.k === "lawyered" ? "I would want to take that one on notice."
             : "I do not have a good answer for you. I wish I did."));
        appendFloor(surname(W.name), line);
        speak(W.member || null, line, 0.95);
        witnessMoves(W, /\b(lie|lied|paid|money|who|why|explain)\b/i.test(text) ? "hard" : "soft");
      }
    }, 900);
  }
  const here = G.members.filter(m => m.room === G.room && !m.gone);
  const dir = (G.bill && !G.bill.done) ? ((you.lean || 0) >= 0 ? 1 : -1) : 1;
  const strength = opt ? (opt.sway || 0) : (freeText ? clamp(Math.round(freeText.length/34), 1, 4) : 1);
  here.forEach(m => {
    const stubborn = m.traits.conviction/100;
    m.sway = (m.sway || 0) + dir * strength * (1 - stubborn*0.55);
    if(opt && opt.loyal && m.traits.loyalty > 55) ripple(m, 3, "You held the room together when it could have gone.", 3);
    else if(opt && opt.loyal) ripple(m, -2, "You whipped the meeting. I noticed.", -2);
    else if(opt && opt.doubt && m.traits.loyalty < 50) ripple(m, 4, "You spoke for the people in the room nobody speaks for.", 4);
    else if(chance(.4)) ripple(m, chance(.6) ? 2 : -1, "You spoke at the " + procTitle(e).toLowerCase() + " and I was in the room.", 2);
  });
  you.standing = clamp(you.standing + (opt ? opt.stand || 0 : 2), 0, 100);
  if(opt && opt.press !== undefined) G.press.forEach(p => p.trust = clamp((p.trust||50) + opt.press, 0, 100));
  /* the room answers you where you can hear it */
  const answerers = here.sort(() => Math.random()-0.5).slice(0, rint(1,2));
  answerers.forEach((m, k) => setTimeout(() => {
    if(!PROC.on) return;
    const warm = moodOf(m).val > 0;
    const back = warm
      ? fresh(() => pick(["Hear, hear.","That is right.","Well said."]) + " — " +
          pick(["that is the first honest thing said this hour",
                "and it needed saying by somebody who will be here next year",
                "I will put my name to that"]), 14)
      : interject(m, pick(["Nonsense.","That is not what it says.","Order."]), null);
    m.say = back; m.sayT = 4.4; m.sayTo = "you"; m.faceUntil = G.t + 5;
    speakAt(m, back);
    appendFloor(surname(m.name), back);
  }, 700 + k*1200));
  PROC.phase = "run"; PROC.t = 3.4;
  procSetBar(procTitle(e), "You have spoken. The chair moves on.");
  refreshPanels();
}
/* a running record of the room, under the view */
function appendFloor(who, text){
  PROC.log.push({who, text});
  if(PROC.log.length > onumLim(40,"hist")) PROC.log.shift();
  const box = el("procLog");
  if(!box) return;
  const d = document.createElement("div");
  d.className = "procline";
  d.innerHTML = "<b></b><span></span>";
  d.children[0].textContent = who;
  d.children[1].textContent = text;
  if(box) box.appendChild(d);
  /* only the last three stay on screen; the whole thing is in the
     transcript for anyone who wants to read it back */
  while(box && box.children.length > 3) box.removeChild(box.firstChild);
}
/* Bring the next speaker forward. Whatever is being said finishes being
   said — it is already in the record and already out loud — and the
   chair simply does not wait. */
function procHurry(){
  if(!PROC.on || PROC.phase === "you") return;
  PROC.t = Math.min(PROC.t, 0.35);
  const sp = PROC.speaker;
  if(sp && sp.sayT > 1.2) sp.sayT = 1.2;
}
function procEnd(){

  const e = PROC.e;
  PROC.on = false; PROC.phase = "idle";
  PROC.speaker = null;
  unseatRoom(G.room);                     /* the room gets up and disperses */
  el("procBar").hidden = true;
  hush();
  const you = G.you;
  if(!PROC.spoke){
    you.standing = clamp(you.standing - 5, 0, 100);
    G.members.filter(m => m.room === G.room).forEach(m =>
      ripple(m, -2, "You sat through the whole " + procTitle(e).toLowerCase() + " and said nothing.", -2));
    note("You were in the room and never spoke.", true);
  } else {
    note("You spoke at the " + procTitle(e).toLowerCase() + ".");
  }
  if(PROC.chair){
    const close = fresh(() => pick(["That is the business. Thank you all.",
      "We are finished. I will not be taking it up again today.",
      "Enough. Get to the floor.",
      "That concludes it. The record will show who was here."]));
    PROC.chair.say = close; PROC.chair.sayT = 5; PROC.chair.sayTo = "you";
    speak(PROC.chair, close);
    appendFloor(surname(PROC.chair.name), close);
  }
  if(PROC.wit){
    const W = PROC.wit;
    if(W.member){
      journal(surname(W.member.name) + " answered the committee for " + W.charge.t + ".");
      if(W.defended) ripple(W.member, 6, "You did not join in when it would have been easy.", 6);
    } else if(W.broken){
      feed(surname(W.name) + " leaves the room without looking at anybody.");
    } else if(W.sym > 70){
      feed("Nobody in the room says anything for a moment after " + surname(W.name) + " finishes.");
      G.mood = clamp(G.mood + (W.split < 0 ? 3 : -2), -60, 60);
    }
    PROC.wit = null;
    clearPanel();
  }
  feed(procTitle(e) + " rises.");
  e.done = true;
  save(); refreshPanels();
}
/* the whole thing runs on the clock, in the room, while you stand there */
function procTick(dt){
  if(!PROC.on) return;
  if((FRAME_ID & 7) === 0) tidySeats();
  PROC.t -= dt;
  if(PROC.phase === "you"){
    const _wn = performance.now();
    const _wd = PROC._wallAt ? Math.min(0.5, (_wn - PROC._wallAt) / 1000) : dt;
    PROC._wallAt = _wn;
    PROC.clock -= _wd;
    const c = el("procClock");
    if(c) c.textContent = procClockLabel(PROC.clock);
    if(PROC.clock <= 0){
      /* the chair does not wait for ever */
      const ch = PROC.chair;
      if(ch){
        const cut = "The member's time is up.";
        ch.say = cut; ch.sayT = 3.4; ch.sayTo = "you";
        speak(ch, cut); appendFloor(surname(ch.name), cut);
      }
      G.you.standing = clamp(G.you.standing - 4, 0, 100);
      PROC.phase = "run"; PROC.t = 2.4;
      procSetBar(procTitle(PROC.e), "You let the moment go.");
    }
    return;
  }
  if(PROC.t > 0) return;
  PROC.i++;
  const e = PROC.e;
  /* your slot comes up in the middle of the order, not at the end */
  if((PROC.i === PROC.yourSlot && !PROC.spoke) ||
     (PROC.i === PROC.yourSlot2 && PROC.spoke && !PROC.spoke2)){
    if(PROC.spoke) PROC.spoke2 = true;
    PROC.phase = "you";
    PROC.clock = PROC_SPEAK_SECS; PROC._wallAt = 0;
    const ch = PROC.chair;
    const call = fresh(() => pick(["The member for " + G.you.state + " " + G.you.dist + ".",
      "I call the member. You have the floor.",
      "You wanted in. Go on.",
      "The chair recognises you."]));
    if(ch){ ch.say = call; ch.sayT = 4.4; ch.sayTo = "you"; ch.faceUntil = G.t + 5; speak(ch, call); appendFloor(surname(ch.name), call); }
    /* your turn: the last speaker sits, and the room turns to you */
    if(PROC.speaker && SEATED_ROOMS[G.room]) PROC.speaker.sitting = true;
    PROC.speaker = null;
    PROC.opts = PROC.wit ? witnessOptions(PROC.wit) : procOptions(e);
    easeTowardSpeechStation();
    promptKey = "";
    procSetBar(procTitle(e), "You have the floor. Everybody is waiting.", PROC.opts, PROC.clock);
    return;
  }
  const idx = PROC.i > PROC.yourSlot ? PROC.i - 1 : PROC.i;
  const m = PROC.order[idx];
  if(!m){ procEnd(); return; }
  /* at a hearing the members are not making speeches, they are asking
     questions — and the witness answers where you can hear it */
  if(PROC.wit){
    const W = PROC.wit;
    const qs = witnessQuestions(W);
    const q = pick(moodOf(m).val < -20 ? qs.filter(x => x.hard).concat(qs) : qs);
    if(PROC.speaker && PROC.speaker !== m && SEATED_ROOMS[G.room]){
      PROC.speaker.sitting = true; PROC.speaker.backStand = false;
    }
    PROC.speaker = m; m.sitting = false; m.backStand = false;
    m.say = fresh(() => q.say, 3); m.sayT = 6.5; m.sayTo = "you"; m.faceUntil = G.t + 7;
    speakAt(m, q.say);
    appendFloor(surname(m.name), q.say);
    procSetBar(procTitle(e), surname(m.name) + " is questioning " + surname(W.name) + ".");
    setTimeout(() => { if(PROC.on && PROC.wit) witnessAnswer(W, q); }, 3200);
    PROC.t = 9.5;
    return;
  }
  const line = procLineFor(m, e);
  /* whoever is called gets to their feet; the last speaker sits down */
  if(PROC.speaker && PROC.speaker !== m && SEATED_ROOMS[G.room]){
    PROC.speaker.sitting = true; PROC.speaker.backStand = false;
  }
  PROC.speaker = m;
  m.sitting = false; m.backStand = false;
  m.say = line; m.sayT = 7.5; m.sayTo = "you"; m.faceUntil = G.t + 8;
  m.tx = m.x; m.tz = m.z;
  /* Lectern cap: only speaker (+ chair if standing) in the well — park strays */
  try{
    if(SEATED_ROOMS[G.room]){
      lecternOccupants(G.room).forEach(o => {
        if(o.you || o === m || o === PROC.chair) return;
        enforceSessionFloor(o);
      });
    }
  }catch(e){}
  speak(m, line);
  appendFloor(surname(m.name), line);
  PROC.phase = "run";
  /* the chair says where you are in it */
  const per = Math.max(1, Math.round(PROC.order.length / (PROC.rounds || 1)));
  const rnd = Math.min(PROC.rounds || 1, Math.floor(PROC.i / per) + 1);
  if(rnd !== PROC.round && PROC.chair){
    PROC.round = rnd;
    const call = fresh(() => pick([
      "Second round. Shorter answers, if you please.",
      "We will go round again. I want the parts nobody answered.",
      "Round " + rnd + ". The committee has not finished.",
      "Again, and this time to the point."
    ]));
    PROC.chair.say = call; PROC.chair.sayT = 4; PROC.chair.sayTo = "you";
    speakAt(PROC.chair, call);
    appendFloor(surname(PROC.chair.name), call);
  }
  procSetBar(procTitle(e), surname(m.name) + " has the floor." +
    ((PROC.rounds || 1) > 1 ? "  Round " + (PROC.round || 1) + " of " + PROC.rounds + "." : ""));
  /* somebody always interrupts */
  const others = G.members.filter(x => x.room === G.room && x !== m && !x.gone);
  if(others.length && chance(.6)){
    const o = pick(others);
    setTimeout(() => {
      if(!PROC.on) return;
      const h = interject(o, procHeckle(o), m);
      o.say = h; o.sayT = 4.6; o.sayTo = m.id; o.faceId = m.id; o.faceUntil = G.t + 5;
      speakAt(o, h);
      appendFloor(surname(o.name), h);
    }, 2600);
  }
  /* what they say moves the room a little */
  if(G.bill && !G.bill.done){
    const dir = memberVote(m, G.bill);
    G.members.filter(x => x.room === G.room && x !== m).forEach(x => {
      x.sway = (x.sway||0) + dir * (0.6 + m.influence/60) * (1 - x.traits.conviction/130);
    });
  }
  PROC.t = e.k === "hearing" ? 10.5 : 8.5;
  spend(1, 0.4);          /* a sitting costs the day, not the tab */
}

/* ══════════════════════════════════════════════════════════
   THE EXECUTIVE, AND EVERYONE WHO HELD IT
   The Republic keeps a line of them. You start at the first, so the
   list begins empty and every name on it afterwards is somebody who
   held the office while you were in the building — including, if it
   comes to that, you.
   ══════════════════════════════════════════════════════════ */
const EXEC_TEMPER = [
  {k:"careful",  t:"careful", note:"reads everything and signs late"},
  {k:"stubborn", t:"stubborn", note:"has vetoed things their own party wrote"},
  {k:"weak",     t:"weak in the office", note:"signs whatever the House sends up"},
  {k:"grand",    t:"grand", note:"believes the office is larger than the Congress"},
  {k:"dealer",   t:"a dealer", note:"will trade a signature for two appointments"},
  {k:"cold",     t:"cold", note:"has not been in this building since the inauguration"}
];
const EXEC_END = [
  "served out the term and went home",
  "was beaten by a margin nobody predicted",
  "resigned rather than face the vote",
  "died in office in the third year",
  "was refused a second term by their own party",
  "left under a cloud that never quite broke",
  "was carried out on the shoulders of the majority"
];
function execInit(){
  if(!G.presidents) G.presidents = [];
  if(G.exec && !G.exec.temper) G.exec.temper = pick(EXEC_TEMPER);
  if(G.exec && !G.exec.from) G.exec.from = pick(STATES);
  if(G.exec && G.exec.since === undefined) G.exec.since = G.congress || 1;
}
/* when the office changes hands, the last one goes into the record */
function retireExec(how){
  execInit();
  if(!G.exec) return;
  G.presidents.unshift({
    name:G.exec.name, party:G.exec.party, from:G.exec.from,
    since:G.exec.since, until:G.congress, vetoes:G.exec.vetoes || 0,
    you:!!G.exec.you, temper:(G.exec.temper || {}).t || "careful",
    end:how || pick(EXEC_END)
  });
  if(G.presidents.length > onumLim(40,"hist")) G.presidents.length = onumLim(40,"hist");
}
function execLine(){
  execInit();
  const cur = G.exec;
  const rows = [];
  if(cur) rows.push('<div class="ency__row is-now">' +
    '<div class="ency__n">' + cur.name + (cur.you ? " — you" : "") + '</div>' +
    '<div class="ency__s">' + execTitle() + ' · ' + partyLabel(cur.party) + ' · ' + (cur.from || "—") +
      ' · since the ' + ordinal(cur.since || 1) + ' Congress</div>' +
    '<p>' + cap((cur.temper || EXEC_TEMPER[0]).t) + ' — ' + (cur.temper || EXEC_TEMPER[0]).note + '. ' +
      (cur.vetoes ? cur.vetoes + ' veto' + (cur.vetoes === 1 ? '' : 'es') + ' so far.' : 'No vetoes yet.') + '</p>' +
  '</div>');
  (G.presidents || []).forEach(p => rows.push('<div class="ency__row">' +
    '<div class="ency__n">' + p.name + (p.you ? " — you" : "") + '</div>' +
    '<div class="ency__s">' + partyLabel(p.party) + ' · ' + p.from + ' · ' +
      ordinal(p.since) + '–' + ordinal(p.until) + ' Congress</div>' +
    '<p>' + cap(p.temper) + '. ' + p.vetoes + ' veto' + (p.vetoes === 1 ? '' : 'es') + '. ' +
      cap(p.end) + '.</p>' +
  '</div>'));
  if(rows.length === 1) rows.push('<p class="muted">Nobody has left the office yet. This is the first of them.</p>');
  return rows.join("");
}

/* ══════════════════════════════════════════════════════════
   THE ENCYCLOPAEDIA
   Everything the Republic knows about itself, in one place, and all
   of it generated by the career you are actually having: the states
   and their towns, the parties and their founding rows, everyone
   who has served, everyone who held the executive, every bill that
   passed and every precedent it set.
   ══════════════════════════════════════════════════════════ */
let BOOK_TAB = "republic";
const BOOK_TABS = [
  {k:"republic", t:"The Republic"},
  {k:"exec",     t:"The executive"},
  {k:"states",   t:"States"},
  {k:"parties",  t:"Parties"},
  {k:"members",  t:"Who serves"},
  {k:"laws",     t:"Statute book"},
  {k:"record",   t:"Found things"}
];
function bookRepublic(){
  const c = G.country || {name:"The Republic", form:"republic"};
  const seats = G.seatsBy || {};
  return '<div class="ency__row">' +
      '<div class="ency__n">' + c.name + '</div>' +
      '<div class="ency__s">' + (G.regime ? G.regime.t || c.form : c.form) + ' · ' +
        STATE_DEF.length + ' states · ' + ordinal(G.congress) + ' Congress · day ' + G.day + '</div>' +
      '<p>Money is the ' + CURRENCY.name + ' — one hundred ' + CURRENCY.minor + 's to the ' +
        CURRENCY.name + ', a thousand to the ' + CURRENCY.big + '. The index stands at ' +
        guilderIndex().toFixed(1) + '.</p>' +
      '<p>National mood ' + (G.mood > 0 ? "+" : "") + Math.round(G.mood) + '. ' +
        (G.mood > 20 ? "The country is in a giving humour."
         : G.mood < -20 ? "The country is in no mood to be asked for anything."
         : "The country is not paying much attention.") + '</p>' +
      '<p>The civil calendar marks ' + (FIRST_CONSUL.holiday || "Taylor Day") + ' on ' +
        (FIRST_CONSUL.born || "7/7") + ' — ' + (FIRST_CONSUL.holidayFull || "Day of the First Consul") +
        ', national holiday of the Republic (day-of-year 188).</p>' +
      '<p class="tip__f">' + (seats.FED || 0) + ' Federalist, ' + (seats.COM || 0) + ' Commonwealth, ' +
        (seats.IND || 0) + ' independent' + (seats.OWN ? ", " + seats.OWN + " for your own party" : "") + '.</p>' +
    '</div>' +
    greatnessHTML() + govHistoryHTML() +
    (G.amended && G.amended.length
      ? '<div class="ency__h">Amendments</div>' +
        G.amended.map(a => '<p class="tip__q">' + (a.t || a) + '</p>').join("")
      : '<p class="muted">The constitution stands as written.</p>') +
    (G.history && G.history.length
      ? '<div class="ency__h">Precedent</div>' +
        G.history.slice(-14).reverse().map(p =>
          '<p class="tip__q"><b>' + ordinal(p.congress) + ' Congress</b> — ' + p.who +
          (p.party ? ' ' + partyChipHTML(p.party) + ' ' : ' ') + p.act +
          ', settling ' + p.precedent + '.</p>').join("")
      : '<p class="muted">No precedent yet. You are the first Congress; everything after this is something somebody here did.</p>');
}
function bookStates(){
  return STATE_DEF.map(def => {
    const L = stateLore(def.n);
    const held = G.members.filter(m => m.state === def.n && !m.gone);
    return '<div class="ency__row">' +
      '<div class="ency__n"><span' + tipAttr("state", def.n) + '>' + def.n + '</span></div>' +
      '<div class="ency__s">' + def.seats + ' seats · ' + def.pop + 'm · mostly ' + L.industry +
        ' · settled ' + L.founded + '</div>' +
      '<p>' + def.note + ' The place is ' + L.temper + '.</p>' +
      '<p class="tip__f">Towns: ' + L.towns.map(t => t.name).join(", ") + '.' +
        (held.length ? ' In this House: ' + held.map(m => tipName(m)).join(", ") + '.' : '') + '</p>' +
    '</div>';
  }).join("");
}
function bookParties(){
  const keys = partyKeys();
  const live = keys.map(k => {
    const P = partyLore(k);
    const n = (G.seatsBy || {})[k] || 0;
    return '<div class="ency__row">' +
      '<div class="ency__n"><span' + tipAttr("party", k) + '>' + P.name + '</span></div>' +
      '<div class="ency__s">' + (P.born ? "Founded " + P.born + " · " : "") + n + ' seats</div>' +
      '<p>Out of ' + P.cause + '.</p><p>' + P.creed + '</p>' +
      '<p class="tip__f">' + P.wing.map(x => cap(x)).join(" · ") + '</p>' +
    '</div>';
  }).join("");
  const FO = partyLore("FO");
  const myth = '<div class="ency__row">' +
    '<div class="ency__n">' + partyChipHTML("FO", FO.name) + '</div>' +
    '<div class="ency__s">Historical · not on any ballot · ' + FIRST_CONSUL.name + ', ' + FIRST_CONSUL.title +
      ' · ' + FIRST_CONSUL.dist + ' · born ' + (FIRST_CONSUL.born || "7/7") + ' · ' +
      (FIRST_CONSUL.holiday || "Taylor Day") + '</div>' +
    '<p>Out of ' + FO.cause + '.</p><p>' + FO.creed + '</p>' +
    '<p class="tip__f">' + FO.wing.map(x => cap(x)).join(" · ") + '</p>' +
  '</div>';
  return live + myth;
}
function bookMembers(){
  const live = G.members.filter(m => !m.gone).slice().sort((a,b) => b.influence - a.influence);
  const gone = G.members.filter(m => m.gone);
  return '<div class="ency__h">Serving</div>' +
    live.map(m => {
      const bio = bioOf(m);
      autoInit(m);
      return '<div class="ency__row">' +
        '<div class="ency__n">' + tipName(m) + '</div>' +
        '<div class="ency__s">' + (m.post ? postTitle(m.post) + ' · ' : '') + partyLabel(m.party) +
          ' · ' + m.state + ' ' + m.dist + ' · term ' + m.terms + '</div>' +
        '<p>From ' + bio.town + '. Came here ' + m.goal.t + '.</p>' +
        (m.thought ? '<p class="tip__f">Thought: ' + m.thought + '</p>' : '') +
      '</div>';
    }).join("") +
    (gone.length ? '<div class="ency__h">Served, and gone</div>' +
      gone.map(m => '<div class="ency__row"><div class="ency__n">' + m.name + '</div>' +
        '<div class="ency__s">' + partyLabel(m.party) + ' · ' + m.state + ' ' + m.dist +
        ' · ' + m.terms + ' term' + (m.terms === 1 ? '' : 's') + '</div></div>').join("") : "");
}
function bookLaws(){
  const passed = (G.statute || []).slice();
  if(!passed.length) return '<p class="muted">Nothing has passed yet. Everything on this page will be something you were in the room for.</p>';
  return passed.map(b =>
    '<div class="ency__row">' +
      '<div class="ency__n">' + b.title + '</div>' +
      '<div class="ency__s">' + ordinal(b.congress || 1) + ' Congress · day ' + b.day + ' · ' +
        b.aye + '–' + b.no + (b.fate ? ' · ' + b.fate : '') + '</div>' +
      '<p>' + (b.why || b.line || "") + '</p>' +
      (b.clauses ? '<p class="tip__f">' + b.clauses.map(c => cap(c)).join(" · ") + '</p>' : '') +
    '</div>').join("");
}
function bookRecord(){
  const hours = hoursReport();
  const r = G.relics || [];
  const acc = G.accolades || [];
  if(!r.length && !acc.length) return hours ||
    '<p class="muted">Nothing found yet. The building is full of things nobody has read in years.</p>';
  return (r.length ? '<div class="ency__h">Found in the building</div>' +
    r.map(x => '<div class="ency__row"><div class="ency__n">' + x.t + '</div>' +
      '<div class="ency__s">' + (ROOMS[x.room] ? ROOMS[x.room].t : x.room) + ' · day ' + x.day + '</div>' +
      '<p>' + x.d + '</p></div>').join("") : "") +
    (acc.length ? '<div class="ency__h">Accolades</div>' +
      acc.map(a => '<p class="tip__q">' + (a.t || a) + '</p>').join("") : "") + hours;
}
function refreshBook(){
  const box = el("paneBook");
  if(!box) return;
  execInit();
  const body = BOOK_TAB === "republic" ? bookRepublic()
             : BOOK_TAB === "exec"     ? execLine()
             : BOOK_TAB === "states"   ? bookStates()
             : BOOK_TAB === "parties"  ? bookParties()
             : BOOK_TAB === "members"  ? bookMembers()
             : BOOK_TAB === "laws"     ? bookLaws()
             : bookRecord();
  setHTML(box,
    '<div class="eyebrow">The Republic, written down</div>' +
    '<div class="ency__tabs">' + BOOK_TABS.map(t =>
      '<button type="button" class="ency__tab' + (BOOK_TAB === t.k ? " is-on" : "") +
      '" data-book="' + t.k + '">' + t.t + '</button>').join("") + '</div>' +
    '<div class="ency">' + body + '</div>');
  box.querySelectorAll("[data-book]").forEach(b => b.addEventListener("click", () => {
    BOOK_TAB = b.getAttribute("data-book");
    refreshBook();
  }));
}

/* ══════════════════════════════════════════════════════════
   IN THE ROOM
   Everything that is not the room itself goes away: the bar, the
   panels, the travel strip. What is left is the view, whoever is
   speaking, and the wire along the bottom — which is all you would
   have if you were actually standing there.
   ══════════════════════════════════════════════════════════ */
let dossierHome = null;
function uiOpen(){
  /* Panels "open" = phone showing the house dossier (immersive) or classic ui-open sheet */
  return (!veil.hidden && phoneWasRunning !== null && phoneTab === "panels")
      || document.body.classList.contains("ui-open");
}
function mountDossierInPhone(host){
  const d = document.querySelector(".dossier");
  if(!d || !host) return;
  if(d.parentElement === host) return;
  dossierHome = { parent: d.parentElement, next: d.nextSibling };
  if(host) host.appendChild(d);
  d.classList.add("dossier--phone");
  try{ refreshPanels(); }catch(e){}
}
function unmountDossierFromPhone(){
  const d = document.querySelector(".dossier");
  if(!d || !dossierHome || !dossierHome.parent) return;
  d.classList.remove("dossier--phone");
  if(dossierHome.next && dossierHome.next.parentElement === dossierHome.parent && dossierHome.parent)
    dossierHome.parent.insertBefore(d, dossierHome.next);
  else if(dossierHome.parent) dossierHome.parent.appendChild(d);
  dossierHome = null;
}
function openPanels(which){
  /* Immersive: house UI lives on the phone. KBM and pad each open this on their own. */
  if(G.bare){
    phoneTab = "panels";
    if(which){
      const tabs = [...document.querySelectorAll(".dossier .tabs button")];
      const hit = tabs.find(b => (b.dataset.pane || b.textContent || "").toLowerCase().includes(String(which).toLowerCase()));
      if(hit) hit.click();
    }
    phoneCard();
    picksDirty = true;
    feed("House panels on your phone. D-pad moves · B / Esc puts it away.");
    try{ save(); }catch(e){}
    return;
  }
  /* Non-immersive fallback: covering sheet over the desk layout */
  document.body.classList.add("ui-open");
  picksDirty = true;
  if(which){
    const tabs = [...document.querySelectorAll(".tabs button")];
    const hit = tabs.find(b => (b.dataset.tab || b.textContent || "").toLowerCase().includes(String(which).toLowerCase()));
    if(hit) hit.click();
  }
  setTimeout(() => { try{ dropRect(); resize(); }catch(e){} }, 30);
  feed("Panels open. B back to the room.");
  try{ save(); }catch(e){}
}
function closePanels(){
  if(!veil.hidden && phoneWasRunning !== null && phoneTab === "panels"){
    phoneClose();
    return;
  }
  if(!document.body.classList.contains("ui-open")) return;
  document.body.classList.remove("ui-open");
  picksDirty = true;
  setTimeout(() => { try{ dropRect(); resize(); }catch(e){} }, 30);
  feed("Back in the room.");
  try{ save(); }catch(e){}
}
function resetPlayerBusy(){
  /* Peel talk / tip / phone so the body can act in the room again */
  try{
    const tip = el("tipCard");
    if(tip && !tip.hidden) closeTip();
  }catch(e){}
  try{ if(TALK.open) closeTalk(); }catch(e){}
  try{
    if(!veil.hidden && phoneWasRunning !== null) phoneClose();
  }catch(e){}
  try{ clearSpeechBusy("busy"); }catch(e){}
  document.body.classList.remove("ui-open");
  PICK = -1;
  picksDirty = true;
}
function setImmersive(on){
  G.bare = !!on;
  document.body.classList.toggle("is-bare", G.bare);
  if(G.bare) document.body.classList.remove("ui-open");
  else unmountDossierFromPhone();
  setTimeout(() => { try{ dropRect(); resize(); }catch(e){} }, 30);
  feed(G.bare
    ? "Immersive play. Panels live on your phone — H / toolbar, or RB on pad."
    : "Desk layout back. HUD stays on screen.");
  try{ save(); }catch(e){}
}
function immersion(on){
  /* Toggle panels UI (not immersive itself). Works from KBM or pad the same way. */
  if(on === true){ closePanels(); return; }
  if(on === false){ openPanels(); return; }
  if(uiOpen()) closePanels();
  else openPanels();
}

/* ══════════════════════════════════════════════════════════
   PROXIMITY
   You hear what is near you. A voice across the chamber is a murmur
   you cannot make out; the same voice at your elbow is somebody
   talking to you. Everyone carries their own voice, so the room
   sounds like a room full of different people rather than one.
   ══════════════════════════════════════════════════════════ */
const EARSHOT = 11;                 /* metres past which you hear nothing */
function isScream(text){
  const s = String(text || "").trim();
  if(!s) return false;
  if(/!{2,}/.test(s)) return true;
  if(/\b(SCREAM|SCREAMS|SCREAMING|YELL|YELLS|YELLING|SHOUT|SHOUTS|SHOUTING|BELLOW|BELLOWING)\b/.test(s)) return true;
  if(/\b(scream|screams|screaming|yell|yells|yelling|shout|shouts|shouting|bellow)\b/i.test(s) && /!/.test(s)) return true;
  const letters = s.replace(/[^A-Za-z]/g, "");
  if(letters.length >= 10 && s === s.toUpperCase() && /[A-Z]/.test(s)) return true;
  return false;
}
/* You only hear people in your room — unless they SCREAM across the building. */
function canHearPerson(p, text){
  if(!p) return true;                 /* your own voice */
  if(presentWith(p) || p.room === G.room) return true;
  return isScream(text);
}
function earshot(p, text){
  if(!p) return 1;
  if(!canHearPerson(p, text)) return 0;
  if(p.x === undefined) return 1;
  /* scream from another room: muffled but intelligible */
  if(p.room !== G.room && isScream(text)) return 0.62;
  const d = Math.hypot(p.x - cam.x, p.z - cam.z);
  if(d > EARSHOT) return 0;
  return clamp(1.05 - Math.pow(d / EARSHOT, 1.35), 0, 1);
}
function audible(p, text){ return earshot(p, text) > 0.30; }
function speakAt(p, text){
  if(MODEST && !(TALK.open && TALK.m === p) && p !== G.you) return;
  const v = earshot(p, text);
  if(v <= 0.06) return;
  speak(p, text, v);
}
/* people talking to each other, out loud, where you happen to be standing */
function overhear(a, b, lineA, lineB){
  if(!a || !b) return;
  try{ const h = {a:a.id, b:b.id, lines:[[a.name, lineA]], t:G.t}; a._huddle = b._huddle = h; if(lineB) setTimeout(() => { h.lines.push([b.name, lineB]); h.t = G.t; }, 2300); }catch(e){}
  a.say = lineA; a.sayT = 4.6; a.sayTo = b.id; a.faceId = b.id; a.faceUntil = G.t + 5;
  speakAt(a, lineA);
  if(lineB) setTimeout(() => {
    if(!b || b.gone) return;
    b.say = lineB; b.sayT = 4.2; b.sayTo = a.id; b.faceId = a.id; b.faceUntil = G.t + 5;
    speakAt(b, lineB);
  }, 2200 + Math.random()*900);
}
/* what two people standing together would actually be saying */
function smallTalk(a, b){
  const bill = G.bill && !G.bill.done ? G.bill : null;
  const bioA = bioOf(a);
  const pool = [
    ["Have you read past clause three yet?", "I have read it twice and I like it less each time."],
    ["Is your side holding?", "My side is four people and a rumour."],
    ["They moved the markup again.", "Of course they did."],
    ["How is it at home?", "Quieter than it should be, which worries me more."],
    ["I hear you were in with the leadership.", "I was in the corridor outside it, which is not the same."],
    ["Are you speaking today?", "If they call me. They will not call me."],
    ["Somebody has been briefing against me.", "Somebody is always briefing against somebody."],
    ["Did you see what got posted this morning?", "I saw it. I am not going to dignify it."]
  ];
  if(bill) pool.push(
    [bill.title + " — where are you?", memberVote(b, bill) > 0 ? "With it, for now." : "Nowhere near it."],
    ["They are counting for " + bill.title + " again.", "Let them count. I have not moved."]);
  pool.push(["Things any better in " + bioA.town + "?",
             "The same. " + cap(bioA.trouble) + "."]);
  try{
    inventLife(a); inventLife(b);
    if(a.life) pool.push(
      ["You still following " + a.life.team + "?", "When I can. " + a.life.sport + " is the only honest count I get."],
      ["What do you put on when you get home?", a.life.music + ". Then I stop being a member."]);
    try{
      pool.push([worldLine(a), "I have been thinking about the loaf, not the clause."]);
    }catch(e){}
    if(b.life) pool.push(
      ["I have been " + b.life.hobby + ".", "Do not tell the whip. They would make a caucus of it."],
      [b.life.show + " tonight?", "If the markup dies in time."]);
  }catch(e){}
  try{
    sentEnsure(a); sentEnsure(b);
    if(a.sent && a.sent.now) pool.push([a.sent.now, (b.sent && b.sent.now) || "I know."]);
    if(a.sent && a.sent.topic === "kin")
      pool.push(["I keep almost saying something I should not.", "Then don't. Some things are kinder unsaid."]);
    if(a.sent && a.sent.want) pool.push([a.sent.want, "That is yours. I will not caucus it."]);
  }catch(e){}
  const pair = pick(pool);
  return [fresh(() => pair[0]), fresh(() => pair[1])];
}

/* ══════════════════════════════════════════════════════════
   YOUR VOICE
   Hold the key and talk. What comes out goes to whoever is in front
   of you, or to the whole room when you have the floor — the same
   words you would have typed, said instead.
   ══════════════════════════════════════════════════════════ */
let RECOG = null, listening = false, micText = "", micSilence = 0, micHeld = false;
function micReady(){
  return !!(window.SpeechRecognition || window.webkitSpeechRecognition);
}
function micInit(){
  if(RECOG || !micReady()) return RECOG;
  const R = window.SpeechRecognition || window.webkitSpeechRecognition;
  RECOG = new R();
  RECOG.continuous = true;          /* it does not stop at the first breath: you finish when you stop speaking for a moment, or let go */
  RECOG.interimResults = true;
  try{ RECOG.maxAlternatives = 1; }catch(e){}
  RECOG.lang = "en-US";
  RECOG.addEventListener("result", e => {
    let t = "";
    for(let i = 0; i < e.results.length; i++) t += e.results[i][0].transcript + " ";
    micText = t.replace(/\s+/g, " ").trim();
    micShow(micText || "…");
    clearTimeout(micSilence); if(!micHeld) micSilence = setTimeout(() => { if(listening) micStop(); }, 2200);
  });
  RECOG.addEventListener("error", e => {
    micShow(e.error === "not-allowed"
      ? "The microphone is not allowed here."
      : "Nothing came through.");
    if(e.error === "not-allowed" || e.error === "service-not-allowed" || e.error === "network" || e.error === "audio-capture")
      aloudFallback(e.error === "network" ? "Speech recognition needs the network here." : "The microphone is not available.");
    setTimeout(micHide, 1600);
    listening = false;
  });
  RECOG.addEventListener("end", () => {
    listening = false;
    const t = micText.trim();
    micText = "";
    if(t) micSend(t); else micHide();
  });
  return RECOG;
}
function micShow(t){
  const b = el("micBar");
  if(!b){ try{ if(t) nudge(t === "…" ? "Listening… speak now" : "You: " + t, 5000); }catch(e){} return; }
  if(!t){ b.hidden = true; return; }
  b.hidden = false;
  say(el("micText"), t);
}
function aloudFallback(why){
  try{ nudge((why ? why + " " : "") + "Type it below and press Enter; it is said aloud to the room.", 7000); }catch(e){}
  try{ const t = el("wireTo"); if(t && [...t.options].some(o => o.value === "room")) t.value = "room"; }catch(e){}
  try{ const i = el("wireIn"); if(i){ i.focus(); i.placeholder = "Say it aloud to the room, then Enter"; } }catch(e){}
}
function micHide(){ const b = el("micBar"); if(b) b.hidden = true; }

function heardFlash(msg){
  const b = el("heardFlash");
  if(!b){ try{ feed(msg); }catch(e){} return; }
  b.textContent = msg;
  b.classList.add("is-on");
  clearTimeout(heardFlash._t);
  heardFlash._t = setTimeout(() => b.classList.remove("is-on"), 1600);
  try{ feed(msg); }catch(e){}
}

function micStart(){
  if(listening || !micInit()) return;
  /* the machine cannot listen and talk at the same time */
  hush();
  listening = true; micText = "";
  /* No popup — listen like ordinary speech. Subtle HUD only if micBar exists. */
  micShow("");
  try{ nudge("Listening… speak now. Tap Speak Aloud again to stop.", 8000); }catch(e){}
  try{ RECOG.start(); }catch(e){ listening = false; micHide(); aloudFallback("The microphone would not start."); }
}
function micStop(){
  micHeld = false; clearTimeout(micSilence);
  if(!RECOG) return;
  /* Ask the engine to let go even when we already believe we stopped.
     A dropped keyup — alt-tab with V held — used to leave the browser
     holding the microphone, and then every other program on the machine
     is told the mic is in use by something else. */
  listening = false;
  try{ RECOG.stop(); }catch(e){}
  clearTimeout(micStop._release);
  micStop._release = setTimeout(() => {
    if(listening) return;                 /* they started talking again */
    try{ RECOG.abort(); }catch(e){}
  }, 1500);
}
/* Hand the microphone back whenever the game is no longer the window in
   front. Nothing here is speech the player still wants sent — they have
   walked away from it. */
function micRelease(){
  if(!RECOG) return;
  const ab = el("aloudBtn"); if(ab) ab.classList.remove("is-live");
  const wm = el("wireMic"); if(wm) wm.classList.remove("is-live");
  micStop();
}
addEventListener("pagehide", micRelease);
document.addEventListener("visibilitychange", () => {
  if(document.visibilityState === "hidden") micRelease();
});
/* Speak aloud into the world — no talk panel, no card. They hear you
   and answer in place, the way a room does. */
function converseLive(m, text){
  if(!m || !text) return;
  m.chat = m.chat || [];
  m.chat.push({role:"user", content:text});
  if(checkSpeakBlasphemy(text, "you")){
    m.chat.push({role:"assistant", content:"That is blasphemy. I will not answer it."});
    try{ speakAt(m, "That is blasphemy. I will not answer it."); }catch(e){}
    refreshPanels();
    return;
  }
  const reply = improvise(m, text);
  m.chat.push({role:"assistant", content:reply});
  /* you said it out loud; they answer out loud */
  try{ speakAt(m, reply); }catch(e){ try{ speak(m, reply); }catch(e2){} }
  ripple(m, 1, null, 0);
  spend(4, 1);
  heardFlash(surname(m.name) + " heard you.");
  const r = roomHears(text, {exclude:m, weight:1});
  if(r && r.heard){
    const tone = readTone(text);
    if(tone.hostile || tone.promise || (r.backed && r.backed.length) || (r.objected && r.objected.length))
      try{ reportRoom(r); }catch(e){}
  }
  /* if the talk UI is already open for them, mirror into the log — but never open it */
  if(TALK.open && TALK.m === m){
    try{
      appendMsg("you", text);
      appendMsg("them", reply, surname(m.name));
      setSay(reply, "");
      renderTalk();
    }catch(e){}
  } else {
    try{ setSay(reply, surname(m.name)); }catch(e){}
  }
  yieldPaint(() => { try{ refreshPanels(); }catch(e){} });
}
function micSend(text){
  micHide();
  if(!text) return;
  if(PROC.on && PROC.phase === "you"){ procYouSay(null, text); return; }
  /* Already mid-conversation UI: keep that thread, still no new popup */
  if(TALK.open && TALK.m){ converseLive(TALK.m, text); return; }
  const f = focusThing();
  if(f && f.type === "person"){
    converseLive(f.ref, text);
    return;
  }
  if(audience(null).length){
    try{ speak(null, text, 0.9); }catch(e){}
    addressRoom(text);
    heardFlash("The room heard you.");
    return;
  }
  /* nobody near — still speak the words into the empty room */
  try{ speak(null, text, 0.75); }catch(e){}
  if(checkSpeakBlasphemy(text, "you")) return;
  try{ feed("You said it aloud. Nobody close enough answered."); }catch(e){}
}

function eventCard(e){
  if(e && e.k === "office"){ schedCard(e); return; }
  try{ if(e && abroadOffice() && !outsideAllowed(e.room)){ e.done = true; return; } }catch(x){}
  /* If you are standing in the room, you sit through it in real time
     rather than reading about it. The card is for the times you are
     somewhere else. */
  enrichEventCopy(e);
  if(G.room === e.room && !PROC.on && procStart(e)){
    e.done = true;
    markDay("attended", e.t, null);
    try{
      feed("You are in the room for " + e.t + ".");
      note("Present for " + e.t + ".", true);
      journal("Sat through " + e.t + " in " + ((ROOMS[e.room]&&ROOMS[e.room].t)||e.room) + ".");
      pushWireScrap("Session", e.t + " — you were there");
      stageEventPeople(e);
    }catch(err){}
    return;
  }
  e.done = true;
  G.running = false;
  const you = G.you, b = G.bill;
  const here = G.room === e.room;
  let body = "", opts = [];
  try{ if(here) stageEventPeople(e); }catch(err){}

  if(!here){
    const told = e.rsvp === false;
    const heavy = (e.k === "caucus" || e.k === "crisis" || e.k === "hearing" || e.k === "lobby");
    const cost = (e.k === "caucus" ? 9 : e.k === "crisis" ? 8 : e.k === "hearing" ? 6 : e.k === "lobby" ? 5 : 4) * (told ? 0.35 : 1);
    const dStand = -cost;
    const dInf = heavy && !told ? -rint(2,5) : (told ? -1 : -2);
    const dApp = (e.k === "townhall" || e.k === "presser") && !told ? -rint(2,4) : 0;
    you.standing = clamp(you.standing + dStand, 0, 100);
    you.influence = clamp(you.influence + dInf, 0, 100);
    if(dApp) you.approval = clamp(you.approval + dApp, 0, 100);
    if(e.k === "caucus") G.members.filter(m => m.party === you.party)
      .forEach(m => ripple(m, told ? -2 : -4,
        told ? "You sent word you could not come. At least there was word."
             : "You were not at the party meeting and nobody knew why.", told ? -2 : -4, !told));
    if(e.k === "crisis" && !told){
      G.members.filter(m => m.post === "whip" || m.post === "leader").slice(0,3)
        .forEach(m => ripple(m, -5, "The floor needed bodies. Yours was missing.", -5, true));
    }
    if(e.k === "hearing" && !told){
      G.members.filter(m => m.cmte === you.committee).slice(0,4)
        .forEach(m => ripple(m, -3, "You skipped the hearing. The chair noticed.", -3));
    }
    if(e.k === "lobby" && !told){
      pushWireScrap("Cloak", "A quiet approach went unanswered — word travels in the cloakroom.");
    }
    body = told
      ? "You had said you would not be there, and you were not. " + (e.k === "caucus"
          ? "The line was settled without you. The whip has a quieter version of your name now."
          : e.k === "crisis" ? "The House answered the emergency without your voice."
          : "Somebody else stood where you might have.")
      : "It went ahead without you, and you had not said you would miss it. " + (heavy
          ? "That is a whisper cost — people invent reasons when you leave a chair empty."
          : "Somebody else took the questions.");
    const swingBits = ["standing " + Math.round(dStand)];
    if(dInf) swingBits.push("influence " + dInf);
    if(dApp) swingBits.push("approval " + dApp);
    body += " (" + swingBits.join(", ") + ".)";
    markDay("ignored", e.t + (told ? " (word sent)" : " (no word)"), null);
    try{
      feed((told ? "Missed with word: " : "Missed cold: ") + e.t + ".");
      note((told ? "Declined " : "Ignored ") + e.t + " — " + swingBits.join(", ") + ".", true);
      journal((told ? "Sent word and stayed away from " : "Left an empty chair at ") + e.t + ".");
      pushWireScrap("Absence", e.t + (told ? " — declined" : " — no show"));
    }catch(err){}
    opts = [{t:"Read about it later", run(){
      feed("You read about " + e.t.replace(/^A /, "a ") + " on the wire. It is colder in print.");
    }}];
  } else if(e.k === "caucus"){
    const line = b && !b.done ? partyLine(b)[you.party] : 0;
    body = "The room is full and looking at the leadership. " +
      (b && !b.done ? ("The " + b.title + " is the only business.") : "There is no bill to fight over yet.") +
      " " + buildingWeather();
    opts = [
      {t:"Hold the line", run(){
        landSwing("Held the caucus line", 10, 3, 0);
        G.members.filter(m => m.party===you.party).forEach(m => {
          m.sway = (m.sway||0) + line*4;
          if(m.traits.loyalty > 55) ripple(m, 4, "You held the room together when it could have gone.", 4, true);
          else ripple(m, -2, "You whipped the meeting. I noticed.", -2);
        });
        markDay("helped", "caucus line / loyalists", null);
        markDay("hurt", "caucus line / dissenters", null);
        setPrecedent("held the caucus to the line", "that the caucus line binds the whole party in a session");
        feed("The whip nods once. That is the whole speech.");
        pushWireScrap("Caucus", "Line held on " + (b && !b.done ? b.title.split(" ")[0] : "the diary"));
      }},
      {t:"Let the room speak", run(){
        landSwing("Opened the caucus", -2, 2, 2);
        G.members.filter(m => m.party===you.party).forEach(m => {
          ripple(m, 6, "You let the meeting actually be a meeting.", 6, true);
          m.rel.trust = clamp(m.rel.trust + 4, 0, 100);
          m.sway = (m.sway||0) + (alignment(m, b||{pos:m.pos}) > 0 ? 2 : -2);
        });
        markDay("helped", "caucus openness", null);
        setPrecedent("let the caucus debate before the whip", "that the caucus debates before the whip is applied");
        feed("Chairs scrape. People say the thing they were going to say in the corridor.");
      }},
      {t:"Break with the leadership", run(){
        landSwing("Broke in open caucus", -14, 4, 8);
        G.members.filter(m => m.party===you.party && m.traits.loyalty < 50)
          .forEach(m => ripple(m, 14, "You said out loud what the rest of us only muttered.", 14, true));
        G.members.filter(m => m.party===you.party && m.traits.loyalty >= 65)
          .forEach(m => ripple(m, -12, "You broke with the leadership in front of everybody.", -12, true));
        G.mood = clamp(G.mood + (you.party==="FED" ? -4 : 4), -60, 60);
        markDay("hurt", "caucus leadership", null);
        markDay("helped", "caucus rebels", null);
        setPrecedent("broke with the leadership in open caucus", "that a member may break with the leadership and stay in the room");
        feed("Silence, then the kind of noise that becomes a story.");
        pushWireScrap("Caucus", "Open break — " + (you.name || "a member") + " vs the line");
      }}
    ];
  } else if(e.k === "presser"){
    const trust = G.press.length ? G.press.reduce((s,p)=>s+p.trust,0)/G.press.length : 45;
    body = "Two cameras, six notebooks, and whatever you say becomes the day. " +
      (b && !b.done ? ("They will ask about " + b.title + " whether you want them to or not.") : "");
    opts = [
      {t:"Make the case for the bill", run(){
        const ok = (trust*0.6 + you.approval*0.4 - tired() + rint(-16,16)) > 34;
        landSwing(ok ? "Press hit landed" : "Press hit missed", ok?4:-2, ok?5:-2, ok?9:-6);
        G.mood = clamp(G.mood + (ok ? (you.party==="FED"?5:-5) : 0), -60, 60);
        G.press.forEach(p => p.trust = clamp(p.trust + (ok?5:-4),0,100));
        if(ok) G.members.forEach(m => { m.sway = (m.sway||0) + (alignment(you, b||{pos:you.pos})>0?1.5:-1.5); });
        markDay(ok ? "helped" : "hurt", "press case", null);
        feed(ok ? "The clip will run. Your face stays on it." : "The clip will run anyway. That is the problem.");
        pushWireScrap("Press", ok ? "Case made on camera" : "Fumble on camera");
      }},
      {t:"Announce a programme", off:!G.prog || !!G.prog.active, run(){
        landSwing("Programme announced", 3, 4, 6);
        (G.states||[]).forEach(st => st.unrest = clamp(st.unrest - 4, 0, 100));
        G.money.index = clamp(G.money.index + 1.2, 42, 190);
        markDay("helped", "programme announce", null);
        feed("The wire has a new noun. Programmes become real when said twice.");
      }},
      {t:"Attack the other side", run(){
        landSwing("Televised attack", 5, 3, 5);
        G.mood = clamp(G.mood + (you.party==="FED"?3:-3), -60, 60);
        G.members.filter(m => m.party !== you.party).forEach(m => ripple(m, -6, "You went after us on television.", -6, true));
        markDay("hurt", "opposition on press", null);
        feed("The other bench watches the monitor like it owes them money.");
        pushWireScrap("Press", "Attack clip circulating");
      }}
    ];
  } else if(e.k === "hearing"){
    body = "The witness is sworn. Your committee, your five minutes. " +
      (b && !b.done ? ("Opposing counsel will try to name " + b.title.split(" ")[0] + ".") : "") +
      " Miss this and the chair files you under 'unreliable'.";
    opts = [
      {t:"Press the witness hard", run(){
        landSwing("Broke the witness", 4, 11, 4);
        G.press.forEach(p => p.trust = clamp(p.trust+3,0,100));
        markDay("hurt", "hearing witness", null);
        setPrecedent("broke a witness on the record", "that a committee may compel an answer under oath");
        feed("The room leans forward. That is the sound of a record being made.");
        pushWireScrap("Hearing", "Hard questioning — record made");
      }},
      {t:"Let it go quietly", run(){
        landSwing("Quiet hearing", 2, 3, 1);
        const friends = G.members.filter(m => m.cmte === you.committee);
        friends.forEach(m => ripple(m, 7, "You did not make a circus of the hearing.", 6, true));
        markDay("helped", "committee collegiality", null);
        feed("No circus. The chair almost thanks you with their eyes.");
      }},
      {t:"Subpoena the papers", off:you.influence < 12, run(){
        you.influence -= 12;
        landSwing("Subpoena landed", 2, 0, 10);
        (G.lobbies||[]).forEach(l => l.purse = Math.max(10, l.purse - 8));
        G.members.filter(m => (m.warchest||0) > 10).forEach(m => ripple(m, -8, "Your subpoena went through my accounts too.", -9, true));
        markDay("hurt", "lobby ledgers", null);
        setPrecedent("subpoenaed the lobby ledgers", "that outside money must open its books to the House");
        feed("Paper arrives. Some of it did not want to.");
        pushWireScrap("Hearing", "Subpoena — ledgers opened");
      }}
    ];
  } else if(e.k === "crisis"){
    const st = (G.states||[]).slice().sort((a,c)=>c.unrest-a.unrest)[0];
    const what = st ? pick(["a levee failure","a general strike","a bank closing its doors","a mine collapse"]) : "a disturbance";
    body = (st ? st.n : "A state") + ": " + what + ". The House must answer it before the day is out. " +
      "Ignore this and the wire invents your position for you.";
    opts = [
      {t:"Send federal money", run(){
        if(st){ st.unrest = clamp(st.unrest - 26,0,100); st.ind = clamp(st.ind + 4,0,100); }
        landSwing("Federal relief voted", 3, 4, 9);
        G.money.index = clamp(G.money.index - 2.4, 42, 190);
        markDay("helped", (st?st.n:"a state") + " relief", null);
        setPrecedent("sent federal money into " + (st?st.n:"a state") + " within the day",
          "that the House may vote relief to a state without a committee stage");
        feed("Relief language leaves the floor before the cameras do.");
        pushWireScrap("Crisis", "Federal money to " + (st?st.n:"the states"));
      }},
      {t:"Send the militia", run(){
        if(st){ st.unrest = clamp(st.unrest - 14,0,100); st.lean = Math.round(st.lean * 1.1); }
        landSwing("Militia called", 8, 2, -5);
        G.members.filter(m => m.pos.lib > 30).forEach(m => ripple(m, -10, "You put soldiers into " + (st?st.n:"a state") + ".", -11, true));
        markDay("hurt", "militia critics", null);
        setPrecedent("called out the militia", "that the militia may be called to a state without its governor asking");
        feed("Boots, then arguments. Always in that order.");
        pushWireScrap("Crisis", "Militia ordered — " + (st?st.n:"Union"));
      }},
      {t:"Say it is a state matter", run(){
        if(st) st.unrest = clamp(st.unrest + 12,0,100);
        landSwing("Left it to the state", 1, 4, -7);
        markDay("hurt", (st?st.n:"state") + " abandoned", null);
        setPrecedent("left " + (st?st.n:"a state") + " to itself", "that the Union does not intervene in a state's own disorder");
        feed("The gallery boos in a polite way. Polite still carries.");
        pushWireScrap("Crisis", "Federal hands off — " + (st?st.n:"state"));
      }}
    ];
  } else if(e.k === "lobby"){
    const l = (G.lobbies||[]).length ? pick(G.lobbies) : null;
    body = (l ? l.n : "An interest") + " would like you to be reasonable about " +
      (l ? AXES.find(a=>a.k===l.axis).n.toLowerCase() : "the bill") + ". " +
      buildingWeather() + " Walk away cold and they tell a different story about your price.";
    opts = [
      {t:"Take the money", run(){
        const give = rint(14, 30);
        you.funds = clamp(you.funds + give, 0, 400);
        you.record.donors = (you.record.donors||0) + 1;
        if(l) G.donors.push({name:l.n, axis:l.axis, want:l.want, given:give, day:G.day});
        makeSecret("You took " + money(give) + " from " + (l?l.n:"a lobby") + " in a cloakroom.", null, [pick(G.members)], 6);
        landSwing("Cloakroom money", -2, 2, -1);
        markDay("helped", (l?l.n:"lobby") + " purse", null);
        feed("The envelope is thinner than the obligation.");
        pushWireScrap("Cloak", "A quiet approach — accepted");
      }},
      {t:"Take it and say so publicly", run(){
        const give = rint(8, 18);
        you.funds = clamp(you.funds + give, 0, 400);
        if(l) G.donors.push({name:l.n, axis:l.axis, want:l.want, given:give, day:G.day});
        landSwing("Declared lobby money", 3, 2, 4);
        markDay("helped", "declared donor", null);
        setPrecedent("declared a lobby payment from the floor", "that outside money must be declared on the day it is taken");
        feed("You say the number out loud. The room prefers that to finding it.");
      }},
      {t:"Refuse it", run(){
        landSwing("Refused the purse", 4, 1, 6);
        you.record.refused = (you.record.refused||0) + 1;
        if(l) l.purse = Math.max(10, l.purse - 4);
        G.members.filter(m => m.traits.conviction > 62).forEach(m => ripple(m, 7, "You turned money down. Word gets round.", 7, true));
        markDay("hurt", (l?l.n:"lobby") + " refused", null);
        feed("They smile like it was never about money. It was.");
        pushWireScrap("Cloak", "Approach refused — word travels");
      }}
    ];
  } else if(e.k === "townhall"){
    body = isTaylorDay()
      ? ("Wreath, silence, Nieuw Oranje VII alone. " + (FIRST_CONSUL.holidayFull || "Day of the First Consul") + ".")
      : "A church hall, ninety people, and every one of them has your name written down.";
    opts = [
      {t:"Take every question", run(){
        landSwing("Town hall full open", 2, 2, 10);
        spend(120, 26);
        markDay("helped", "constituents", null);
        feed("You stay until the last hand goes down. That is the whole job, some days.");
        pushWireScrap("District", "Full surgery — every question");
      }},
      {t:"Keep it short", run(){
        landSwing("Town hall short", 1, 0, 4);
        spend(45, 10);
        markDay("helped", "brief constituents", null);
        feed("Short and clean. Somebody still waits outside.");
      }}
    ];
  }

  if(here) markDay("attended", e.t, null);
  if(!here && G.room !== e.room && veil.hidden && !G.over){
    G.running = true;
    try{ pushMail(null, "Missed: " + e.t, e.d + "\n\n" + body, {kind:"note"}); }catch(err){}
    try{ nudge("Missed: " + e.t + " · in your inbox"); }catch(err){}
    laterHouse(() => { try{ queueSave(); }catch(err){} });
    return;
  }

  card.innerHTML =
    '<div class="eyebrow">' + dateString() + " · " + hourLabel(e.hour) + " · " +
      ((ROOMS[e.room]&&ROOMS[e.room].t)||e.room) + '</div>' +
    '<h1>' + e.t + '</h1>' +
    '<p class="dream">' + e.d + '</p>' +
    '<p>' + body + '</p>' +
    (here ? '' : '<p class="muted">You were in ' + ((ROOMS[G.room]&&ROOMS[G.room].t)||G.room) + '.</p>') +
    '<div class="card__actions">' + opts.map((o,i) =>
      '<button class="btn' + (i ? ' btn--ghost' : '') + '" type="button" data-ev="' + i + '"' +
      (o.off ? ' disabled' : '') + '>' + o.t + '</button>').join("") + '</div>';
  veil.hidden = false;
  card.querySelectorAll("[data-ev]").forEach(btn => btn.addEventListener("click", () => {
    const o = opts[+btn.getAttribute("data-ev")];
    walkNow();
    spend(rint(35, 70), 12);
    if(o && o.run) o.run();
    if(here){
      note(e.t + ": " + (o ? o.t : "attended") + ".", true);
      journal(e.t + " — chose: " + (o ? o.t : "attended") + ".");
      feed("Done: " + e.t + (o ? (" · " + o.t) : "") + ".");
    }
    laterHouse(() => { try{ queueSave(); }catch(e){} });
  }));
}


/* ── the ticker ─────────────────────────────────────────── */
function makeHeadlines(){
  const H = [], b = G.bill, you = G.you;
  /* Day scraps first — echo events, not spam (capped in pushWireScrap). */
  (G.wireScraps || []).slice(0, 4).forEach(sc => H.push([sc[0], sc[1]]));
  if(b && !b.done){
    const t = tallyBill(b, true);
    H.push(["Floor", b.title + " — projected " + t.aye + " aye, " + t.no + " no, roll call day " + b.voteDay]);
    const push = lobbyPush(b);
    if(Math.abs(push) > 8){
      const top = G.lobbies.slice().sort((x,y2) => Math.abs(y2.backing) - Math.abs(x.backing))[0];
      H.push(["Money", top.n + (top.backing > 0 ? " is spending hard for " : " is spending hard against ") +
        b.title.split(" ").slice(0,2).join(" ")]);
    }
  }
  { const ob = officeBoard();
    if(ob) H.push(["Standings", "You rank " + (ob.rows.findIndex(r => r.you) + 1) + " of " + ob.rows.length + " " + ob.title.replace(/^Standing (among|in|on) /, "among ") + "; " + ob.rows[0].name + " leads"]);
    else { const board = leaderboard(); const rank = board.findIndex(r => r.you) + 1;
      H.push(["Standings", "You sit " + rank + " of " + board.length + " in the building; " + board[0].name + " leads"]); } }
  H.push(["Mood", "National mood " + (G.mood>0?"+":"") + Math.round(G.mood) +
    (G.mood > 8 ? ", running Federalist" : G.mood < -8 ? ", running Commonwealth" : ", flat")]);
  const hot = (G.states||[]).slice().sort((a,c)=>c.unrest-a.unrest)[0];
  if(hot) H.push(["Union", hot.n + " unrest at " + Math.round(hot.unrest) + (hot.unrest>66?" — governor wants federal help":"")]);
  if(G.prog && G.prog.active){
    const def = PROGRAMMES.find(p => p.k === G.prog.active.k);
    if(def) H.push(["Programme", def.t + ", " + Math.max(0, G.prog.active.until - G.day) + " days to run"]);
  }
  H.push(["Guilder", "The " + CURRENCY.name + " stands at " + guilderIndex().toFixed(1) +
    " on the index" + (guilderIndex() < 92 ? " — money buys less than it did" :
                       guilderIndex() > 110 ? " — the Union is earning" : "")]);
  try{
    const w = worldEnsure();
    const f = worldFoe();
    H.push(["Abroad", f.t + " — " + worldWar().t]);
    H.push(["Bread", "A loaf is " + (w.bread * (guilderIndex()/100)).toFixed(2) +
      (w.ration ? " · rationing" : "") + " · sky " + w.sky + " · " + w.season]);
    if(w.dead) H.push(["Dead", w.dead + " named and unnamed. " + ((w.names&&w.names[0]) ? w.names[0] + " is one." : "")]);
  }catch(e){}
  H.push(["Campaign", "War chest " + money(you.funds) + " · approval " + Math.round(you.approval) + "%"]);
  if(G.events && G.events.length){
    const nx = G.events.find(e => !e.done && e.day === G.day);
    if(nx) H.push(["Diary", nx.t + " at " + (nx.hour>12?nx.hour-12:nx.hour) + " o'clock, " + ROOMS[nx.room].t]);
  }
  if(G.history && G.history.length){
    const h = pick(G.history);
    H.push(["Precedent", (h.byYou ? "You" + (h.as ? ", as " + h.as : "") : h.who) + ", " + ordinal(h.congress) + " Congress: " + h.precedent]);
  }
  const rich = G.members.slice().sort((a,c)=>(c.warchest||0)-(a.warchest||0))[0];
  if(rich && rich.warchest > 12) H.push(["Money", rich.name + " has banked " + rich.warchest + " and is not being shy about it"]);
  G.feed.slice(0,5).forEach(f => H.push(["Wire", f.t]));
  const defect = G.members.filter(m => m.traits.loyalty < 34 && Math.abs(m.rel.warmth) > 30)[0];
  if(defect) H.push(["Rumour", "Talk that " + defect.name + " is unhappy where they sit"]);
  return H;
}
/* Bottom Wire ticker: move in occasional, readable steps instead of
   continuously consuming paint work while the player is moving. */
const TICK_PAUSE_FRAMES = 5 * 60;
const TICK_STOPS = 12;
let tickStop = 0, tickPauseF = 0;
let tickHoverPause = false;
function paintTicker(){
  const H0 = makeHeadlines();
  if(!H0.length) return;
  const seen = new Set(), H = [];
  H0.forEach(h => { const k = String(h[1] || "").trim().toLowerCase(); if(!k || seen.has(k)) return; seen.add(k); H.push(h); });
  const html = H.map(h => '<span><b>' + h[0] + '</b>' + h[1] + '</span>').join("");
  const run = el("tickRun");
  if(!run) return;
  setHTML(run, html);
  const box = el("tick");
  const wide = box && run.scrollWidth > box.clientWidth * 1.02;
  run.dataset.loop = wide ? "1" : "0";
  if(wide) setHTML(run, html + '<span aria-hidden="true" class="tick__gap"></span>' + html);   /* second copy only so the loop is seamless */
  tickStop = 0; tickPauseF = 0;
  run.style.transform = "translateX(0)";
}
function tickScrollFrame(){
  const run = el("tickRun");
  const box = el("tick");
  if(!run || !box) return;
  if(document.body.classList.contains("prefers-reduce") /* unused */){}
  try{
    if(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches){
      run.style.transform = "none";
      return;
    }
  }catch(e){}
  if(tickHoverPause || box.matches(":hover")) return;
  if(run.dataset.loop === "0"){ run.style.transform = "translateX(0)"; return; }
  if(tickPauseF++ < TICK_PAUSE_FRAMES) return;
  tickPauseF = 0;
  const half = run.scrollWidth * 0.5;
  if(!(half > 1)) return;
  tickStop = (tickStop + 1) % TICK_STOPS;
  const x = -(half * (tickStop / TICK_STOPS));
  run.style.transform = "translateX(" + x.toFixed(2) + "px)";
}
(function bindTickHover(){
  const box = el("tick");
  if(!box) return;
  box.addEventListener("pointerenter", () => { tickHoverPause = true; });
  box.addEventListener("pointerleave", () => { tickHoverPause = false; });
})();

/* ══════════════════════════════════════════════════════════
   10b · THE UNION — states, programmes, and houses
   ══════════════════════════════════════════════════════════ */
const PROGRAMMES = [
  {k:"levee",  t:"The Levee Programme",      days:14, cost:16, needs:null,
   d:"Federal money for the delta and the flooded coasts.",
   run(){ stateAdj(["Blackwater","Vlissingen","Zeeland","Dunmore"], {unrest:-18, ind:6}); G.mood += 4; }},
  {k:"rail",   t:"Trunk Rail Consolidation", days:20, cost:22, needs:null,
   d:"One gauge, one timetable, from Westrun to Nieuw Oranje.",
   run(){ G.states.forEach(s => { s.ind = clamp(s.ind + 5, 0, 100); }); stateAdj(["Calder","Riverbend"], {ind:9}); }},
  {k:"harbour",t:"Deepwater Harbour Act",    days:16, cost:18, needs:"rail",
   d:"Dredging and bonded warehouses at Havenport and Nieuw Oranje.",
   run(){ stateAdj(["Havenport","Nieuw Oranje","Vlissingen"], {ind:14, unrest:-6}); }},
  {k:"mines",  t:"Coalfield Transition",     days:24, cost:26, needs:null,
   d:"Pensions and retraining where the seams are finished.",
   run(){ stateAdj(["Coalport","Tullamore","Marion"], {unrest:-26, ind:4}); G.you.approval += 4; }},
  {k:"schools",t:"Common Schools Bill",      days:18, cost:20, needs:null,
   d:"A federal floor under every schoolhouse in the Union.",
   run(){ G.states.forEach(s => { s.unrest = clamp(s.unrest - 7, 0, 100); }); G.you.approval += 5; }},
  {k:"arsenal",t:"The Arsenal Programme",    days:22, cost:28, needs:"rail",
   d:"Six federal armouries, sited where the votes are.",
   run(){ stateAdj(["Meriden","Marion","Sandhill","Ordway"], {ind:12, unrest:-4}); G.mood += 3; }},
  {k:"franchise",t:"Franchise Extension",    days:26, cost:30, needs:"schools",
   d:"One standard for the roll in every state. It will not be quiet.",
   run(){ G.states.forEach(s => { s.unrest = clamp(s.unrest + 9, 0, 100); s.lean = Math.round(s.lean*0.82); });
          G.you.approval += 8; G.you.standing -= 6; }}
];
function stateAdj(names, d){
  names.forEach(n => {
    const s = G.states.find(x => x.n === n);
    if(!s) return;
    if(d.unrest) s.unrest = clamp(s.unrest + d.unrest, 0, 100);
    if(d.ind) s.ind = clamp(s.ind + d.ind, 0, 100);
  });
}
function buildUnion(){
  G.states = STATE_DEF.map(s => Object.assign({}, s, {
    unrest: clamp(28 - s.ind*0.18 + rint(-9, 22), 0, 100),
    done:false
  }));
  G.prog = {active:null, doneList:[]};
}
function stateOf(name){ return G.states.find(s => s.n === name) || null; }

/* ── state legislation: the statehouses do their own business ── */
const STATE_BILLS = [
  {t:"Levee and Drainage Bill",      axis:"wel",  dir: 1, ind: 4, unrest:-12},
  {t:"Right to Organise Bill",       axis:"econ", dir:-1, ind:-2, unrest:-10},
  {t:"Tolls and Turnpikes Bill",     axis:"econ", dir: 1, ind: 6, unrest:  6},
  {t:"Constabulary Powers Bill",     axis:"lib",  dir:-1, ind: 0, unrest: -8},
  {t:"Common Schools Bill",          axis:"wel",  dir: 1, ind: 3, unrest: -9},
  {t:"Land Enclosure Bill",          axis:"econ", dir: 1, ind: 5, unrest: 14},
  {t:"Militia Reorganisation Bill",  axis:"def",  dir: 1, ind: 1, unrest: -5},
  {t:"Free Assembly Bill",           axis:"lib",  dir: 1, ind: 0, unrest:  7}
];
function seedStateBills(){
  (G.states||[]).forEach(s => {
    if(s.bill || !chance(0.14)) return;
    const b = pick(STATE_BILLS);
    s.bill = Object.assign({}, b, {title:b.t, due:G.day + rint(3,8), pushed:0});
  });
}
function resolveStateBills(news){
  (G.states||[]).forEach(s => {
    if(!s.bill || G.day < s.bill.due) return;
    const b = s.bill;
    /* the statehouse votes its own lean, plus whatever pressure you applied */
    const fit = (b.dir > 0 ? 1 : -1) * (b.axis === "econ" ? s.lean : b.axis === "lib" ? -s.lean*0.4 : s.lean*0.3);
    const score = fit*0.7 + (30 - s.unrest)*0.2 + b.pushed;
    /* 20261027a: the legislature votes member by member, as the docket shows them leaning; the undecided break with your push and the state's temper */
    let passed = score > 0, cnt = null;
    try{ const by = dkStatehouse(s, {title:b.t, sb:b}); let a = 0, n = 0, u = 0; Object.keys(by).forEach(p => { a += by[p].aye; n += by[p].no; u += by[p].un; });
      const lean = clamp(0.5 + (b.pushed || 0) / 80 + ((s.unrest || 0) - 30) / 200 * ((b.unrest || 0) < 0 ? 1 : -1), 0.1, 0.9), ua = Math.round(u * lean); a += ua; n += u - ua; passed = a > n; cnt = {aye:a, no:n}; b.count = cnt; }catch(e){}
    if(passed){
      s.ind = clamp(s.ind + b.ind, 0, 100);
      s.unrest = clamp(s.unrest + b.unrest, 0, 100);
      s.lean = clamp(Math.round(s.lean + b.dir*3), -100, 100);
    } else s.unrest = clamp(s.unrest + 3, 0, 100);
    if(news) news.push(s.n + " " + (passed ? "passed" : "threw out") + " its " + b.title + (cnt ? ", " + cnt.aye + " to " + cnt.no : "") + ".");
    if(b.pushed !== 0 && s.n === G.you.state){
      G.you.approval = clamp(G.you.approval + (passed === (b.pushed > 0) ? 5 : -3), 0, 100);
    }
    s.bill = null;
  });
}
function pushStateBill(s, dir){
  if(!s || !s.bill || G.you.influence < 6) return;
  G.you.influence -= 6;
  spend(60, 14);
  s.bill.pushed += dir * (12 + G.you.influence*0.2 + (s.n === G.you.state ? 10 : 0));
  note("Leaned on the " + s.n + " delegation over the " + s.bill.title + ".");
  hearsAll("Somebody has been working the " + s.n + " statehouse.");
  refreshPanels();
}

/* ── proposing a bill of your own ────────────────────────── */
function proposeBill(axis, dir){
  if(!inHouse()){ feed("Only a member of the House can file a bill there."); return; }
  const you = G.you;
  if(you.influence < 10 || you.out) return;
  you.influence -= 10;
  spend(150, 34);
  const b = makeBill();
  for(const a of AXES) b.pos[a.k] = Math.round(b.pos[a.k]*0.3);
  b.pos[axis] = dir * rint(48, 82);
  const other = pick(AXES.filter(a => a.k !== axis));
  b.pos[other.k] = Math.round(lerp(b.pos[other.k], you.district[other.k], 0.6));
  b.title = pick(BILL_A) + " " + pick(BILL_B) + " " + pick(BILL_C);
  b.sponsor = you.name; b.sponsorParty = you.party; b.mine = true;
  b.stakes = "contested"; b.voteDay = G.day + rint(3,6);
  b.line = describeBill(b); b.cosponsors = [];
  placeYourBill(b);
  const line = partyLine(b)[you.party];
  you.standing = clamp(you.standing + (line > 0 ? 4 : -7), 0, 100);
  note("Introduced " + b.title + ". It is yours now.", true);
  feed("You introduced " + b.title + ".");
  hearsAll(you.name + " has put a bill on the calendar.");
  refreshPanels();
}
function stateDelegation(n){ return G.members.filter(m => m.state === n); }
/* bills land differently in different places */
function billHitsStates(b, passed){
  if(!passed) return;
  G.states.forEach(s => {
    const fit = -Math.abs(s.lean - b.pos.econ)/18 + 3;
    s.unrest = clamp(s.unrest - fit + (b.pos.wel > 30 ? -3 : 0) + (b.pos.econ > 40 ? 2 : 0), 0, 100);
    s.ind = clamp(s.ind + (b.pos.econ > 30 ? 2 : b.pos.econ < -30 ? 1 : 0), 0, 100);
  });
}
function progTick(){
  const p = G.prog.active;
  if(!p) return;
  if(G.day < p.until) return;
  const def = PROGRAMMES.find(x => x.k === p.k);
  G.prog.active = null;
  G.prog.doneList.push(p.k);
  if(def){ def.run(); note(def.t + " comes into force across the Union.", true); }
  G.you.influence = clamp(G.you.influence + 8, 0, 100);
}
function startProgramme(k){
  const def = PROGRAMMES.find(x => x.k === k);
  if(!def || G.prog.active || G.prog.doneList.indexOf(k) >= 0) return;
  if(def.needs && G.prog.doneList.indexOf(def.needs) < 0) return;
  if(G.you.influence < def.cost) return;
  G.you.influence -= def.cost;
  G.prog.active = {k, until:G.day + def.days, started:G.day};
  note("Put " + def.t + " on the order of business. " + def.days + " days.", true);
  refreshPanels();
}

/* ── the map ─────────────────────────────────────────────── */
function unrestColor(u){
  if(u > 66) return "var(--bad)";
  if(u > 40) return "var(--warn)";
  return "var(--good)";
}
function statePath(s, cw, ch, gap){
  /* an organic blob per state rather than a hard rectangle */
  const x = s.col*cw + gap/2, y = s.row*ch + gap/2;
  const w = cw - gap, h = ch - gap;
  const j = (a,b) => a + (Math.sin((s.col*7.3 + s.row*3.1 + b)*2.7)*0.5+0.5) * 5 - 2.5;
  const p = [
    [j(x,1), j(y,2)], [j(x+w*0.5,3), j(y-1,4)], [j(x+w,5), j(y,6)],
    [j(x+w+1,7), j(y+h*0.5,8)], [j(x+w,9), j(y+h,10)],
    [j(x+w*0.5,11), j(y+h+1,12)], [j(x,13), j(y+h,14)], [j(x-1,15), j(y+h*0.5,16)]
  ];
  let d = "M" + p[0][0].toFixed(1) + "," + p[0][1].toFixed(1);
  for(let i=1;i<p.length;i++){
    const a = p[i-1], b = p[i];
    d += " Q" + ((a[0]+b[0])/2 + (i%2?2:-2)).toFixed(1) + "," + ((a[1]+b[1])/2 + (i%3?-2:2)).toFixed(1) +
         " " + b[0].toFixed(1) + "," + b[1].toFixed(1);
  }
  return d + " Z";
}
function renderMap(sel){
  const cols = 6, rows = 4, cw = 116, ch = 92, gap = 9;
  const W = cols*cw, H = rows*ch;
  const parts = G.states.map(s => {
    const del = stateDelegation(s.n);
    const fed = del.filter(m => m.party === "FED").length;
    const com = del.filter(m => m.party === "COM").length;
    const col = s.lean > 8 ? "var(--fed)" : s.lean < -8 ? "var(--com)" : "var(--ind)";
    const strength = clamp(0.18 + Math.abs(s.lean)/140, 0.14, 0.62);
    const on = sel === s.n;
    const home = s.n === G.you.state, x0 = s.col*cw + 14, bw = cw - 28 - gap, by = s.row*ch + 9, tot = Math.max(1, fed + com);   /* 20261030p look */
    return '<g class="mapstate' + (on ? ' is-sel' : '') + '" data-st="' + s.n + '" style="cursor:pointer" tabindex="0" role="button" aria-label="' + s.n + ', ' + s.seats + ' seats">' +
      '<title>' + s.n + ' \u2014 click to read</title>' +
      '<path d="' + statePath(s, cw, ch, gap) + '" fill="' + col + '" fill-opacity="' + strength + '" ' +
        'stroke="' + (on ? "var(--ink)" : "var(--line)") + '" stroke-width="' + (on ? 2.2 : 1) + '"></path>' +
      '<text x="' + (s.col*cw + cw/2) + '" y="' + (s.row*ch + ch/2 - 6) + '" text-anchor="middle" ' +
        'font-family="Archivo,sans-serif" font-size="11" font-weight="600" fill="var(--ink)">' + (home ? '\u2605 ' : '') + s.n + '</text>' +
      (del.length ? '<rect x="' + x0 + '" y="' + by + '" width="' + bw + '" height="3" rx="1.5" fill="var(--line)" opacity=".55"></rect>' +
        '<rect x="' + x0 + '" y="' + by + '" width="' + (bw * fed / tot).toFixed(1) + '" height="3" rx="1.5" fill="var(--fed)" opacity=".85"></rect>' +
        '<rect x="' + (x0 + bw * fed / tot).toFixed(1) + '" y="' + by + '" width="' + (bw * com / tot).toFixed(1) + '" height="3" rx="1.5" fill="var(--com)" opacity=".85"></rect>' : '') +
      '<text x="' + (s.col*cw + cw/2) + '" y="' + (s.row*ch + ch/2 + 9) + '" text-anchor="middle" ' +
        'font-family="JetBrains Mono,monospace" font-size="9.5" fill="var(--ink-2)">' + s.seats + ' seats</text>' +
      '<circle cx="' + (s.col*cw + cw/2) + '" cy="' + (s.row*ch + ch/2 + 22) + '" r="3.4" fill="' + unrestColor(s.unrest) + '"></circle>' +
      '<text x="' + (s.col*cw + cw/2) + '" y="' + (s.row*ch + ch/2 + 38) + '" text-anchor="middle" font-family="Archivo,sans-serif" font-size="8.5" font-style="italic" fill="var(--ink-3)">' + (function(){ try{ return stateGovInfo(s.n).g.short; }catch(e){ return ""; } })() + '</text>' +
      (del.length ? '<text x="' + (s.col*cw + cw/2 + 11) + '" y="' + (s.row*ch + ch/2 + 26) + '" ' +
        'font-family="JetBrains Mono,monospace" font-size="8.5" fill="var(--ink-3)">' + del.length + '</text>' : '') +
    '</g>';
  }).join("");
  return '<svg viewBox="0 0 ' + W + ' ' + H + '" style="width:100%;height:auto;overflow:visible" ' +
    'role="img" aria-label="Map of the Union"><style>.mapstate path{transition:fill-opacity .15s,stroke-width .15s}.mapstate:hover path,.mapstate:focus path{fill-opacity:.72;stroke:var(--ink);stroke-width:1.8}.mapstate:focus{outline:none}.mapstate.is-sel path{filter:drop-shadow(0 2px 3px rgba(0,0,0,.25))}</style>' + parts + '</svg>' +
    '<div class="muted" style="font-size:11px;margin-top:4px">\u2605 your state \u00b7 bar under each state: the delegation you know, Federalist | Commonwealth</div><div aria-hidden="true" style="height:72px"></div>';
}

/* ══════════════════════════════════════════════════════════
   10e · THE CHAMBER IN SESSION
   Members take their seats, the chair recognises speakers, and
   the body argues with itself whether or not you join in.
   ══════════════════════════════════════════════════════════ */
function inSession(){
  return dayType() === "session" && G.minute >= 10*60 && G.minute < 19*60
      && G.bill && !G.bill.done;
}
/* the benches: two banks either side of the aisle */
function seatFor(i, party){
  const side = party === "COM" ? 1 : -1;
  const row = i % 5, col = Math.floor(i / 5) % 3;
  return {x: side * (2.6 + row*1.38), z: 4.6 + col*2.3};   /* 20261030o: same 1.38 pitch as the built benches (1.45 sat the outer row in the wall) */
}
function seatChamber(){
  let fed = 0, com = 0;
  G.members.forEach(m => {
    if(m.room !== "floor"){ m.seated = false; return; }
    const s = seatFor(m.party === "COM" ? com++ : fed++, m.party);
    m.seatX = s.x; m.seatZ = s.z;
    m.seated = true;
    m.tx = s.x; m.tz = s.z;
  });
}
const DEBATE = [
  "Will the member give way?", "That is not what the bill says.",
  "Point of order, Mr Speaker.", "Order! Order.",
  "The member knows better than that.", "Hear, hear.",
  "Read clause three again.", "Shame.",
  "Answer the question.", "Withdraw that.",
  "My district would never wear it.", "The Treasury has the figures."
];
let debateT = 0;
function chamberDebate(dt){
  if(G.room !== "floor" || !inSession()) return;
  debateT -= dt;
  if(debateT > 0) return;
  debateT = 2.0 + Math.random()*3.2;
  const here = G.members.filter(m => m.room === "floor");
  if(here.length < 2) return;
  const a = pick(here);
  const others = here.filter(m => m !== a);
  if(!others.length) return;
  const b = pick(others);
  a.say = fresh(() => pick(DEBATE), 14); a.sayT = 4.0; a.sayTo = b.id; speakAt(a, a.say);
  a.faceId = b.id; a.faceUntil = G.t + 5;
  if(chance(.72)){
    b.say = interject(b, pick(["Hear, hear.","Nonsense.","Give way, then.","I will not.",
      "Sit down.","On a point of order.","That is not the question.","Let them speak.",
      "Read the clause.","That is the third time.","Withdraw that.","Answer it."]), a);
    b.sayT = 3.6; b.sayTo = a.id; speakAt(b, b.say);
    b.faceId = a.id; b.faceUntil = G.t + 5;
  }
  /* a third member comes in over the top of both of them */
  if(here.length > 2 && chance(.4)){
    const c = pick(here.filter(m => m !== a && m !== b));
    if(c) setTimeout(() => {
      if(G.room !== "floor") return;
      const l = interject(c, pick(["Both of them are wrong.", "Will the member give way to me?",
        "Chair — a point of order.", "I have sat here for an hour and neither has answered it."]), a);
      c.say = l; c.sayT = 3.4; c.sayTo = a.id; c.faceId = a.id; c.faceUntil = G.t + 4;
      speakAt(c, l);
    }, 1800 + Math.random()*900);
  }
  /* the argument actually moves the room a little */
  if(G.bill && !G.bill.done){
    const dir = memberVote(a, G.bill);
    here.forEach(m => {
      if(m === a) return;
      m.sway = (m.sway||0) + dir * (0.5 + a.influence/70) * (1 - m.traits.conviction/130);
    });
  }
}
/* your own seat, and the right to be heard from it */
function takeSeat(){
  if(!SEATED_ROOMS[G.room]) return;
  if(G.room === "floor"){
    const s = seatFor(20, G.you.party);
    cam.x = s.x; cam.z = s.z + 0.4;
    cam.vx = cam.vz = 0;
    G.you.sitting = true;
    feed("You take your seat.");
    note("Took your seat on the floor.");
  } else {
    seatPlayerInSession();
    note("Took your seat for the sitting.");
  }
  CATCH.suppressed = false;
  promptKey = "";
  refreshPanels();
}
function riseFromSeat(){
  G.you.sitting = false;
  try{ if(document.activeElement && document.activeElement.blur) document.activeElement.blur(); }catch(e){}
  feed("You rise.");
  refreshPanels();
}
function floorActions(){
  const b = G.bill, you = G.you, A = [];
  A.push({t: you.sitting ? "Rise" : "Take your seat", c:"5m", run(){
    spend(5, 1);
    if(you.sitting) riseFromSeat(); else takeSeat();
  }});
  if(!inSession()) return A;
  A.push({t:"Catch the Speaker's eye", c:"25m", off:!b||b.done, run(){
    spend(25, 12);
    const heard = (you.influence*0.6 + you.standing*0.4 + (you.post?25:0) - tired() + rint(-20,20)) > 30;
    if(!heard){
      setSay("The chair looks straight past you and calls somebody else.", fx("","not recognised"));
      you.standing = clamp(you.standing-2,0,100);
      return;
    }
    const dir = you.vote !== null ? you.vote : (alignment(you,b) > 0 ? 1 : -1);
    const power = 6 + you.influence*0.14 + you.standing*0.07 - tired()*0.4;
    const here = G.members.filter(m => m.room === "floor");
    let moved = 0;
    here.forEach(m => {
      const d = power * (1 - m.traits.conviction/135);
      if(d <= 0) return;
      m.sway = (m.sway||0) + dir*d; moved++;
    });
    you.influence = clamp(you.influence+4,0,100);
    setSay("You are called. You speak for four minutes and the benches opposite go quiet for two of them.",
      fx("moved " + moved + " members toward " + (dir>0?"aye":"no") + " · +4 influence","25 minutes"));
    hearsAll(you.name + " spoke on the " + b.title.split(" ")[0] + " bill.");
    /* COLLAB HOOK */
    try{ if(typeof TLSCollab !== "undefined") TLSCollab.recordSpeech(dir, "floor speech on " + (b.title||"bill")); }catch(e){}
  }});
  A.push({t:"Point of order", c:"10m", run(){
    spend(10, 5);
    const good = (you.standing*0.5 + you.terms*4 - tired() + rint(-24,24)) > 26;
    if(good){
      you.standing = clamp(you.standing+5,0,100);
      G.members.filter(m => m.room==="floor" && m.traits.loyalty>55)
        .forEach(m => ripple(m, 3, "You knew the standing orders better than the chair did.", 3));
      setSay("The chair concedes the point. The other side has to start again.",
        fx("+5 standing · the room notices",""));
    } else {
      you.standing = clamp(you.standing-4,0,100);
      setSay("“That is not a point of order and the member knows it.” Laughter, not with you.",
        fx("","−4 standing"));
    }
  }});
  A.push({t:"Heckle the speaker", c:"5m", risk:true, run(){
    spend(5, 3);
    const target = pick(G.members.filter(m => m.room==="floor" && m.party !== you.party)
                        .concat(G.members.filter(m=>m.room==="floor")));
    if(!target){ setSay("Nobody worth interrupting.", ""); return; }
    ripple(target, -8, "You barracked me across the floor in front of everybody.", -9, true);
    you.approval = clamp(you.approval + 2, 0, 100);
    you.standing = clamp(you.standing - 3, 0, 100);
    setSay("You shout " + surname(target.name) + " down. The gallery enjoys it more than the chair does.",
      fx("+2 approval","−3 standing · " + surname(target.name) + " will remember"));
  }});
  return A;
}

/* ══════════════════════════════════════════════════════════
   11a · MAIL, PHONES, AND PEOPLE WHO WANT A WORD
   ══════════════════════════════════════════════════════════ */
function mailStamp(){ return "d" + G.day + " " + hhmm().replace(" ",""); }
function pushMail(from, subject, body, opts){
  opts = opts || {};
  G.mail.unshift({
    id:++G.mailId, fromId:from ? from.id : null,
    from:from ? from.name : "Office of the Clerk",
    subject, body, day:G.day, at:hhmm(), read:false, answered:false,
    kind:opts.kind || "note", options:opts.options || null, outgoing:!!opts.outgoing
  });
  if(G.mail.length > onumLim(60,"cap")) G.mail.pop();
  if(!opts.outgoing) G.unread = (G.unread||0) + 1;
}
var hailSweep = 0;
function nudge(t, ms){ window._nudge = {t:String(t), until:performance.now() + (ms || 7000)}; }
function unreadCount(){ return G.mail.filter(x => !x.read && !x.outgoing).length; }

/* what a member writes to you, driven by what they are actually after */
function composeMail(m){
  const b = G.bill, mood = moodOf(m), t = topMemory(m);
  const k = m.intent.k;
  if(t && memWeight(m,t) < -14 && chance(.5))
    return {kind:"grievance", subject:"A word about the other day",
      body:"I have been turning this over and I would rather say it in writing than in the corridor.\n\n" +
        t.t + "\n\nI am not asking for an apology. I am telling you where I am.",
      options:[
        {t:"Apologise properly", run(){ t.w *= 0.4; ripple(m, 11, "You wrote back, and you did not hide behind your staff.", 7, true); }},
        {t:"Stand by it", run(){ ripple(m, -4, "You wrote back and told me you would do it again.", -5, true); m.rel.trust = clamp(m.rel.trust+4,0,100); }},
        {t:"Leave it unanswered", run(){ ripple(m, -6, "I wrote to you about it. You never replied.", -8, true); }}
      ]};
  if(k === "post")
    return {kind:"ask", subject:"The chairmanship",
      body:"You will have heard the same rumour I have. If it opens up I intend to stand.\n\nCan I count on you when the caucus meets?",
      options:[
        {t:"You have my backing", run(){ ripple(m, 14, "You backed me for the chair in writing. That is a thing I can hold you to.", 12, true); G.you.influence = clamp(G.you.influence-4,0,100); }},
        {t:"I can't promise that yet", run(){ ripple(m, -2, "You would not commit. Noted, and understood.", -1); }},
        {t:"I'm standing myself", run(){ ripple(m, -12, "You told me you wanted the same chair I did.", -12, true); }}
      ]};
  if((k === "kill" || k === "pass") && b && !b.done)
    return {kind:"ask", subject:"The " + b.title.split(" ")[0] + " bill",
      body:"Straight question, because the roll call is on day " + b.voteDay + ".\n\n" +
        (k === "kill" ? "I am going to try to kill this and I would like to know if you are with me."
                      : "I am carrying water for this and I need to know if you are with me."),
      options:[
        {t:"I'm with you", run(){ ripple(m, 12, "You told me in writing you were with me on the " + b.title.split(" ")[0] + " bill.", 10, true); m.pledge = (k==="pass"?1:-1); m.pledgeDay = G.day; }},
        {t:"I'm against you, and here's why", run(){ ripple(m, 2, "You disagreed with me and had the manners to say so.", 3); m.rel.trust = clamp(m.rel.trust+6,0,100); }},
        {t:"I haven't decided", run(){ ripple(m, -3, "You dodged a direct question.", -3); }}
      ]};
  if(k === "seat")
    return {kind:"ask", subject:"Cover, if you have any going",
      body:"I am " + m.margin + " points from losing this seat and the vote you want me to cast will be an advert against me by November.\n\nIf you want it, I need something I can point at.",
      options:[
        {t:"I'll get you an amendment", run(){ ripple(m, 15, "You got me cover when I asked for it.", 13, true); G.you.influence = clamp(G.you.influence-6,0,100); m.pledge = 1; m.pledgeDay = G.day; }},
        {t:"I'll come and campaign for you", run(){ ripple(m, 10, "You said you would come to my district. We will see.", 8, true); G.you.funds = clamp(G.you.funds-8,0,300); }},
        {t:"Everyone has a tough vote", run(){ ripple(m, -9, "I asked you for cover and got a lecture.", -10, true); }}
      ]};
  if(k === "repay")
    return {kind:"ask", subject:"That favour",
      body:"I do not like owing people and I owe you.\n\nTell me what you want and let us be square.",
      options:[
        {t:"Your vote, next roll call", run(){ m.rel.debtFromYou = Math.max(0, m.rel.debtFromYou-1); if(G.bill && !G.bill.done){ m.pledge = 1; m.pledgeDay = G.day; } ripple(m, -3, "You cashed me in by letter. Efficient of you.", -2); }},
        {t:"Nothing. Keep it.", run(){ ripple(m, 16, "You forgave a debt you could have called in. I will not forget that.", 15, true); }},
        {t:"I'll tell you when I need it", run(){ ripple(m, 1, "You are holding my marker over me and we both know it.", -1); }}
      ]};
  if(k === "rival"){
    const r = byId(m.rival);
    return {kind:"ask", subject:"A rumour",
      body:"I am told you have been spending time with " + (r ? r.name : "the other side") + ".\n\nIs that something I should worry about?",
      options:[
        {t:"You should worry about it", run(){ ripple(m, -7, "You as good as told me you were working with " + (r?surname(r.name):"them") + ".", -6); if(r) ripple(r, 4, null, 0); }},
        {t:"You have nothing to worry about", run(){ ripple(m, 8, "You told me plainly where you stood. I took you at your word.", 7); m.rel.trust = clamp(m.rel.trust+5,0,100); }},
        {t:"Who I talk to is my business", run(){ ripple(m, -3, "You would not answer a simple question.", -3); }}
      ]};
  }
  if(m.kind === "press")
    return {kind:"press", subject:"Query, on deadline",
      body:"Filing tonight on the " + (b ? b.title : "week ahead") + ".\n\nAnything you want to say before I write it without you?",
      options:[
        {t:"Give them a line", run(){ m.trust = clamp((m.trust||45)+6,0,100); G.you.approval = clamp(G.you.approval+3,0,100); }},
        {t:"Background only", run(){ m.trust = clamp((m.trust||45)+3,0,100); G.you.influence = clamp(G.you.influence-2,0,100); }},
        {t:"No comment", run(){ m.trust = clamp((m.trust||45)-5,0,100); G.you.approval = clamp(G.you.approval-2,0,100); }}
      ]};
  return {kind:"note", subject:"Nothing urgent",
    body:"Saw your name on the board and thought I would say hello. The tea room is still terrible.",
    options:[
      {t:"Write back warmly", run(){ ripple(m, 6, "You wrote back about nothing in particular. People notice that.", 5); }},
      {t:"Leave it", run(){}}
    ]};
}
function maybeMail(){
  if(!G.members.length) return;
  const pool = G.members.concat(G.press);
  const m = pick(pool);
  if(!m || presentWith(m)) return;
  const eager = m.rel.warmth*0.25 + Math.abs(memValence(m))*0.4 + m.traits.ambition*0.2
              + (m.rel.debtFromYou ? 20 : 0) + (m.met ? 10 : -18);
  if(eager < 22 || !chance(0.5)) return;
  const c = composeMail(m);
  pushMail(m, c.subject, c.body, {kind:c.kind, options:c.options});
}

/* someone crosses the room to you */
function questionFor(m){
  const c = composeMail(m);
  return {line:pick(["Have you got a minute?","There you are — a word.","I was hoping to catch you.",
                     "Can I put something to you?"]), mail:c};
}
function maybeApproach(m){
  if(m.kind !== "member" || m.wantsWord || TALK.open || !G.running) return;
  if(!presentWith(m) || m.room !== G.room) return;
  if(G.t - (m.lastHail||0) < 90) return;
  const eager = m.rel.warmth*0.35 + (m.rel.debtFromYou ? 22 : 0)
              + (m.intent.k === "repay" ? 22 : 0) + (moodOf(m).val > 34 ? 16 : 0)
              + (memValence(m) < -30 ? 14 : 0) + (m.met ? 8 : -10) - 34;
  if(eager < 10 || !chance(0.010)) return;
  m.wantsWord = questionFor(m);
  m.lastHail = G.t;
  m.say = m.wantsWord.line; m.sayT = 4.5; m.sayTo = "you";
  { const side = Math.random() < 0.5 ? -1 : 1, fw = 1.5, sd = 1.7 * side;
    const sy = Math.sin(cam.yaw || 0), cy = Math.cos(cam.yaw || 0);
    m.tx = cam.x + sy*fw + cy*sd; m.tz = cam.z + cy*fw - sy*sd; }
  m.wait = 0; m.wwT = G.t;
  try{ pushMail(m, "Wants a word", String(m.wantsWord.line || "") + "\n\nFind me when you have a minute. I am in " + (((ROOMS[m.room]||{}).t) || "the building") + ".", {kind:"note"}); }catch(e){}
}

/* ══════════════════════════════════════════════════════════
   11c · FREE CONVERSATION
   The page asks Claude, on the viewer's own account, and what
   you actually say is written back into the same memory the
   procedural systems read.
   ══════════════════════════════════════════════════════════ */
const TALK = {open:false, m:null, prop:null, beat:2, thread:null, followUp:null, seed:undefined};
/* Nothing in this game reaches outside itself. Every word anybody says
   is written here, out of who they are and what has happened to them,
   and it works the same with no signal as it does anywhere else. No
   connector, no permission prompt, and nothing of yours goes anywhere. */
let SAMPLE = null;
let sampleAsked = true, chatCtl = null;

function traitWords(m){
  const T = m.traits, w = [];
  w.push(T.ambition>66?"ambitious":T.ambition<32?"content where they are":"steady");
  w.push(T.conviction>66?"holds positions on principle":T.conviction<32?"flexible":"pragmatic");
  w.push(T.loyalty>66?"a party person":T.loyalty<32?"no respecter of the whip":"loyal enough");
  w.push(T.vanity>66?"vain":T.vanity<32?"unshowy":"");
  w.push(T.discretion>66?"discreet":T.discretion<32?"leaks like a sieve":"");
  w.push(T.temper>66?"quick-tempered":T.temper<32?"very hard to rile":"");
  return w.filter(Boolean).join(", ");
}
function dossierFor(m){
  const you = G.you, b = G.bill, mood = moodOf(m);
  const mems = psyRecallLines(m, 6);
  const L = [];
  L.push("You are role-playing one character in a fictional national legislature. Stay in character completely. Never mention that you are an AI, a model, a game, a prompt, or an outside user; never break the fourth wall and never narrate stage directions.");
  L.push("");
  L.push("YOU ARE: " + m.name + ", " + (m.kind==="press" ? m.role + " for " + m.outlet
        : m.kind==="civ" ? m.role + " campaigning about " + m.cause
        : "member for " + m.state + " " + m.dist + ", " + partyName(m.party) +
          (m.post ? ", " + postTitle(m.post) : "") + "."));
  if(m.kind === "member"){
    L.push("Background: " + m.bg + ". Term " + m.terms + ", last elected by " + m.margin + " points.");
    L.push("Temperament (fixed, always show through): " + traitWords(m) + ".");
    L.push("Politics: " + AXES.map(a => a.n.toLowerCase() + " " +
      (m.pos[a.k] > 25 ? a.hi : m.pos[a.k] < -25 ? a.lo : "middling")).join("; ") + ".");
    L.push("What you privately want right now: " + m.intent.t + ".");
    try{ L.push("Your family (never in the room, but always in your head): " + kinSummary(m) + " Strains: " + (kinTensions(m).slice(0, 3).join(" ") || "none.")); }catch(e){}
    L.push("You belong to " + creedOf(m.creed).t + ", which holds " + creedOf(m.creed).holds +
      (creedOf(m.creed).jab ? " (" + creedOf(m.creed).jab + ")" : "") +
      ". You came up in " + originOf(m.origin).t + ", whose standing grievance is " +
      originOf(m.origin).grievance + ". The Latin Rite is the true confession of this Republic. The rest are lampoons that still vote. Reach for the creed when the subject touches it — never as a slogan.");
  }
  L.push("Your mood today reads as: " + mood.label + ".");
  if(m.dayEvent) L.push("Today: " + m.dayEvent.t);
  L.push("");
  /* the briefing names the office they hold NOW, not the House seat they left */
  const youTitle = (function(){ try{ return ndYou().address; }catch(e){ return "friend"; } })();
  const youHouse = (function(){ try{ return inHouse(); }catch(e){ return true; } })();
  const youPlace = (function(){ try{ return ndYou().seat; }catch(e){ return youHouse ? you.state + " " + you.dist : officeSeat(); } })();
  const youPost = youHouse && you.post ? postTitle(you.post) : null;
  L.push("THE PERSON YOU ARE TALKING TO: " + you.name + ", " + partyName(you.party) +
    (youPost ? ", " + youPost : "") + ", " + youTitle + " (" + youPlace + ").");
  try{ const Y = ndYou(); if(Y.formerLine) L.push("They are " + Y.formerLine + " (history only)."); if(Y.homeLine) L.push(Y.homeLine); }catch(e){}
  L.push("Address them as " + youTitle + ". " + (youHouse
    ? "They sit in the House with you, as a fellow member."
    : "They do not sit in the House with you any more; they hold the office above, and you speak to them as the " + youTitle + " they are."));
  L.push("Treat this person as a real colleague who is present in your world. They are not an outsider observing it, and you have no knowledge that an external person, player, or user is speaking through them. Respond to their words as your character, using only the relationship and history available to you. You are a separate person: never say that you are them, that you belong to them, or that you are theirs or yours.");
  L.push("How you feel about them: " + readOf(m).label + ", and you trust them " +
    (m.rel.trust > 66 ? "a good deal" : m.rel.trust > 38 ? "about as far as anyone here" : "very little") +
    (m.rel.debtFromYou ? ", and you owe them " + m.rel.debtFromYou + " favour(s)" : "") + ".");
  L.push("You cannot see inside their head. You do not know their standing, their approval, or what " +
    "they are really after — you only know what they have said and done to you. Read them the way a " +
    "person reads a person: from tone and history, and be wrong sometimes. Never state a number about " +
    "yourself or them, and never claim to know how they feel.");
  /* everything this character knows about anyone else, and nothing more */
  const known = (m.heard || []).slice(0,6).map(h => "- (day " + h.d + ") " + h.t);
  const mine = G.secrets.filter(s => s.knownBy.indexOf(m.id) >= 0)
    .map(s => "- You personally know this and have not repeated it: " + s.t.toLowerCase());
  L.push("");
  L.push("WHAT HAS REACHED YOU ABOUT OTHER PEOPLE — this is the whole of it:");
  if(known.length || mine.length){ known.forEach(x => L.push(x)); mine.forEach(x => L.push(x)); }
  else L.push("- Nothing. You have not heard anything worth repeating lately.");
  L.push("You do NOT know what any other member privately thinks, intends, or feels. You have not seen " +
    "their files and nobody has told you their plans. If asked about a colleague, answer only from the " +
    "list above, from public facts, or from what you would plainly have seen in a corridor — and say you " +
    "do not know when you do not. Never invent private knowledge of another member.");
  if(G.you.out) L.push("Note: they lost their seat. They are not a member any more — no committee, " +
    "no floor, nothing to trade. Treat them accordingly, warmly or otherwise.");
  if(mems.length){ L.push("What has actually passed between you (your memory, strongest first; some of it is only a feeling):"); mems.forEach(x=>L.push(x)); }
  else L.push("Nothing much has passed between you yet.");
  L.push("");
  if(b && !b.done && m.kind === "member"){
    L.push("ON THE CALENDAR: " + b.title + ". " + b.line + " Sponsored by " + b.sponsor + ".");
    L.push("As things stand you would vote " + (memberVote(m,b) > 0 ? "AYE" : "NO") + "." +
      (m.pledge ? " You have already pledged " + (m.pledge>0?"aye":"no") + " to them." : ""));
  }
  L.push("WHERE: " + ROOMS[G.room].t + ", " + hhmm() + ", " + dayLabel().toLowerCase() + ", day " + G.day + ".");
  const pc = citePrecedent();
  if(pc) L.push("A precedent you would reach for in an argument: " + pc.who + " of the " + ordinal(pc.congress) + " " + pc.act + ", which settled " + pc.precedent + ". Cite it the way a member cites precedent — " +
    "briefly, and only if it helps you.");
  L.push("Money is counted in guilders (" + CURRENCY.sym + "); a campaign fund is spoken of in milles. " +
    "The guilder index stands at " + guilderIndex().toFixed(0) + ".");
  L.push("");
  L.push("Reply as " + m.name + " speaking aloud: 1-3 sentences, plain spoken, no quotation marks, no name label. Be difficult if your mood and memories say you should be. Do not agree to anything a person in your position would not agree to.");
  L.push("Then on a FINAL separate line, output an effect tag exactly like this, with only the parts that apply:");
  L.push("<<warmth:+3 trust:+1 pledge:aye remember:short sentence in your own voice about what just happened>>");
  L.push("warmth and trust are small integers between -10 and +10 reflecting how this exchange changed your view of them. Include pledge only if you just committed your vote. Include remember only if this exchange was actually memorable.");
  return L.join("\n");
}
const EFFECT_RE = /<<([\s\S]*?)>>/;
function stripEffect(t){ return String(t||"").replace(/<<[\s\S]*?>>/g, "").replace(/\s+$/,"").trim(); }
function applyEffect(m, raw){
  const hit = EFFECT_RE.exec(String(raw||""));
  if(!hit) return;
  const s = hit[1];
  const num = k => { const r = new RegExp(k + "\\s*:\\s*([+-]?\\d+)").exec(s); return r ? parseInt(r[1],10) : 0; };
  const w  = clamp(num("warmth"), -10, 10);
  const tr = clamp(num("trust"), -10, 10);
  if(w)  ripple(m, w, null, 0);
  if(tr) m.rel.trust = clamp(m.rel.trust + tr, 0, 100);
  const pl = /pledge\s*:\s*(aye|no)/i.exec(s);
  if(pl && G.bill && !G.bill.done && m.kind === "member"){
    m.pledge = pl[1].toLowerCase() === "aye" ? 1 : -1;
    m.pledgeDay = G.day;
    note((m.pledge>0?"Pledge":"Refusal") + " from " + m.name + " in conversation.");
  }
  const rem = /remember\s*:\s*([^>]+)/i.exec(s);
  if(rem){
    const txt = rem[1].replace(/[|]+$/,"").trim().slice(0,170);
    if(txt.length > 6) remember(m, txt, w || 2, Math.abs(w) > 6);
  }
  m.known = Math.max(m.known, 1);
}
/* ══════════════════════════════════════════════════════════
   IMPROVISATION — everything anyone says without a connection
   Composed from who they are, what they want, what has passed
   between you, and what they have heard. No network required.
   ══════════════════════════════════════════════════════════ */
const IMP_OPEN = {
  elated:["Ha — you have caught me on a good day.","I could almost be pleasant about this."],
  warm:["Go on, then.","You know I will hear you out."],
  settled:["All right.","I am listening."],
  guarded:["Careful how you put that.","Say it plainly."],
  distracted:["Sorry — say again?","I have half my mind on something else."],
  transactional:["What is it worth?","Get to the number."],
  sour:["Must we?","I am not in the humour."],
  aggrieved:["You have a nerve raising that.","After the last time? Go on."],
  furious:["Do not push me.","Say one more word."]
};
const IMP_CLOSE = [
  "Leave it with me.","I will not promise anything.","We will see.",
  "Put it in writing and I will read it.","Ask me again when it matters.",
  "That is all I am saying on it.","You will know when I decide."
];
/* ══════════════════════════════════════════════════════════
   THE LEXICON
   Nobody in this building has a list of things they say. They have
   words, and they put them together one at a time. Every sentence is
   assembled here from a vocabulary weighted by who is speaking — a
   blunt member reaches for short words, a careful one for long ones,
   a warm one for softer ones — with a seed of its own per
   conversation, so a person phrases things consistently while they
   are talking to you and differently the next time. Nothing is
   repeated: a sentence that has been said once is composed again.
   ══════════════════════════════════════════════════════════ */

/* Each entry is [word, register] where register is
   -2 blunt · -1 plain · 0 neutral · 1 considered · 2 formal        */
const LEX = {
  say:      [["say it plainly",-1],["tell you straight",-1],["put it on the record",1],["state it",2],["set it out",1],["spell it out",-2]],
  think:    [["think",-1],["reckon",-2],["take the view",2],["see it",0],["read it",0]],
  told:     [["saying",-1],["telling",-1],["putting to",1],["explaining to",2]],
  bill:     [["the bill",-1],["the measure",1],["that paper",-2],["the legislation",2],["this thing",-2],["the text",1]],
  vote:     [["vote",-1],["division",1],["roll call",0],["the count",0],["the ayes and noes",1]],
  people:   [["my people",-1],["the district",0],["the county",0],["those I answer to",2],["the ones who sent me",1],["home",-2]],
  money:    [["money",-1],["the funding",1],["the appropriation",2],["the purse",1],["cash",-2],["what it costs",0]],
  problem:  [["trouble",-1],["difficulty",2],["a problem",0],["a mess",-2],["a situation",1],["bother",-2]],
  agree:    [["agree",0],["go along with it",-1],["be persuaded",2],["come round",-1],["see it your way",0]],
  refuse:   [["will not",-1],["cannot",0],["am not able to",2],["am not going to",-1],["shan't",-2],["decline to",2]],
  certain:  [["certainly",1],["without question",2],["for sure",-2],["plainly",-1],["as it happens",1]],
  maybe:    [["perhaps",1],["possibly",2],["maybe",-1],["it may be",1],["I dare say",2],["could be",-2]],
  much:     [["a great deal",2],["a lot",-1],["much",0],["plenty",-1],["more than enough",0]],
  little:   [["little",1],["not much",-1],["hardly anything",-1],["next to nothing",-2],["scarcely any",2]],
  now:      [["now",-1],["today",-1],["at present",2],["as things stand",1],["this week",0],["right now",-2]],
  soon:     [["soon",-1],["before long",1],["shortly",2],["in due course",2],["any day",-1]],
  frankly:  [["frankly",0],["honestly",-1],["between us",0],["off the record",1],["I'll be straight",-2],["candidly",2]],
  however:  [["but",-2],["though",-1],["however",2],["that said",1],["all the same",0],["even so",0]],
  hard:     [["hard",-1],["difficult",1],["not easy",-1],["a tall order",0],["no small thing",1],["murder",-2]],
  quick:    [["quickly",0],["at once",1],["straight away",-1],["without delay",2],["sharpish",-2]],
  wrong:    [["wrong",-1],["mistaken",2],["off",-2],["in error",2],["not right",-1]],
  ask:      [["ask",-1],["put it to",1],["press",0],["enquire of",2],["have a word with",-1]],
  promise:  [["give you my word",1],["say it and mean it",-1],["put my name to it",1],["undertake it",2]],
  crowd:    [["the House",0],["this building",-1],["the chamber",1],["that room",-1],["the whole place",-2]]
};
const FRAMES = {
  position: [
    "Let me {say}: on {bill} I am {stance}.",
    "{frankly:cap}, I am {stance} on {bill}, and I {think} that is the end of it.",
    "On {bill}? {stance:cap}, {now}, and I do not expect that to change.",
    "You want my {vote}. I am {stance}, and I {refuse} pretend otherwise.",
    "{certain:cap} I am {stance} on {bill}. {however:cap} you may ask me again."
  ],
  district: [
    "{people:cap} sent me here with {much} to complain about and {little} to show for it.",
    "I {think} about {people} before I {think} about anything in this building.",
    "What {people} want is simple enough. Getting it is {problem}.",
    "There is {little} in this building for {people}, and they have noticed."
  ],
  deflect: [
    "I {refuse} answer that {now}. {maybe:cap} {soon}.",
    "{frankly:cap}, that is not a thing to discuss standing in a corridor.",
    "Ask me again when there is {little} at stake."
  ],
  probe: [
    "And where do you {think} you are on it?",
    "What have you been {told} {people} about this?",
    "{frankly:cap} — what do you want from me?",
    "Are you going to be {much} use to me, or {little}?",
    "Who else have you {told} that {now}?"
  ],
  concede: [
    "{maybe:cap} you are right. I {refuse} say so twice.",
    "I could {agree}. It would cost me, and you would owe me.",
    "{however:cap} — I hear you. That is not nothing."
  ],
  press: [
    "You want me to {promise}. That is {hard} in {crowd}.",
    "I will {promise}, and I want it {say} back to me in a month.",
    "{ask:cap} me again {quick} and you will get the same answer."
  ],
  doubt: [
    "I {think} you are {wrong} about this, and I would rather say so now.",
    "{maybe:cap}. I have been {wrong} before and it was {hard} to come back from.",
    "{however:cap} — half of {crowd} believes the opposite and they are not fools."
  ],
  weary: [
    "I have been in {crowd} since seven and I have {little} left in me.",
    "Everything is {hard} this week and I {refuse} pretend otherwise.",
    "{frankly:cap}, I want {much} less of this than I am getting."
  ]
};

/* every conversation has its own accent */
function talkSeed(m){
  if(TALK.m === m && TALK.seed !== undefined) return TALK.seed;
  const sd = seedOf((m ? m.id : "x") + ":" + G.day + ":" + Math.floor(G.minute/37));
  if(TALK.m === m) TALK.seed = sd;
  return sd;
}
/* stable hash of what was said — same prompt to same person → same stream */
function hashSaid(s){
  return seedOf(String(s || "").toLowerCase().replace(/\s+/g, " ").trim().slice(0, 160));
}
function talkRng(m, said){
  const turns = m && m.chat ? m.chat.length : 0;
  return rng(seedOf(String(m ? m.id : "x") + "|say|" + hashSaid(said) + "|" + turns));
}
/* pick a word from a set, weighted toward how this person actually talks */
function word(m, key, rnd){
  const set = LEX[key];
  if(!set) return key;
  const T = m && m.traits ? m.traits : {temper:50, discretion:50};
  /* blunt people want low registers, careful people want high ones */
  const want = (T.discretion - 50)/26 - (T.temper - 50)/34;
  let best = set[0], bestScore = 1e9;
  const jitter = rnd();
  set.forEach((e, i) => {
    const score = Math.abs(e[1] - want) + ((i + Math.floor(jitter*7)) % 3) * 0.55;
    if(score < bestScore){ bestScore = score; best = e; }
  });
  return best[0];
}
/* fill a frame, one slot at a time — optional rnd keeps phrasing stable per prompt */
function fillFrame(m, frame, slots, rnd){
  const r = rnd || rng(talkSeed(m) + seedOf(frame) + ((slots && slots._salt) || 0));
  return frame.replace(/\{(\w+)(:cap)?\}/g, (all, key, capIt) => {
    let v = (slots && slots[key] !== undefined) ? slots[key] : word(m, key, r);
    if(capIt) v = v.charAt(0).toUpperCase() + v.slice(1);
    return v;
  });
}
/* Compose a line of the given kind. If the sentence has been said
   before — by anybody, ever — build it again. */
function compose(m, kind, slots, rnd){
  const frames = FRAMES[kind];
  if(!frames) return "";
  const r = rnd || rng(talkSeed(m) + seedOf(kind));
  return fresh(() => {
    const frame = frames[Math.floor(r() * frames.length) % frames.length];
    return fillFrame(m, frame, slots, r);
  }, 18);
}

/* ══════════════════════════════════════════════════════════
   UNDERSTANDING, WITHOUT A CONNECTION
   Everything anybody says back to you is worked out here, on this
   machine, out of what you actually typed and everything the person
   in front of you knows. It reads what you asked for, what you
   offered, who you named and how you said it; then it answers from
   their vote, their town, their ambition, the thing they are afraid
   of, and every memory they hold of you. No network, no model, no
   permission — just the state of a person and the words you used.
   ══════════════════════════════════════════════════════════ */

/* ── reading what you said ───────────────────────────────── */
const INTENT_TESTS = [
  ["farewell", /\b(goodbye|bye|see you|i'?ll leave you|must go|good day|later)\b/],
  ["greet",    /^\s*(hello|hi|good morning|good afternoon|good evening|morning|afternoon|evening)\b/],
  ["apology",  /\b(i'?m sorry|i am sorry|apolog|my fault|i was wrong|forgive me)\b/],
  ["threat",   /\b(or else|you'?ll regret|i'?ll make sure|destroy you|end you|finish you|remember this|i will bury|watch yourself)\b/],
  ["insult",   /\b(liar|coward|fool|idiot|useless|disgrace|hypocrite|snake|worthless|shut up)\b/],
  ["praise",   /\b(well done|good work|admire|respect you|proud of you|you were right|thank you|grateful)\b/],
  ["offer",    /\b(i can|i will give|i'?ll give|let me help|i can help|i'?ll back|i will back|i'?ll support|i will support|take my|you can have|i'?ll put|what if i)\b/],
  ["request",  /\b(will you|would you|can you|could you|i need you|i want you|give me|help me|back me|support me|vote with|stand with|do me a)\b/],
  ["agree",    /\b(i agree|you'?re right|you are right|quite right|exactly|agreed|fair enough)\b/],
  ["disagree", /\b(i disagree|you'?re wrong|you are wrong|nonsense|rubbish|that'?s not|i don'?t accept|i do not accept)\b/],
  ["question", /\?|^\s*(what|why|who|how|when|where|which|do you|are you|is it|have you|did you|were you|can i|should i)\b/]
];
const TOPIC_TESTS = [
  ["bill",      /\b(bill|vote|aye|nay|clause|amendment|division|roll ?call|the floor|legislation)\b/],
  ["money",     /\b(money|fund|donor|donat|lobby|guilder|paid|payment|cheque|check|purse|war chest|price)\b/],
  ["party",     /\b(party|caucus|whip|leader|line|bench|ticket|loyal)\b/],
  ["home",      /\b(district|home|county|town|constituen|voters|back home|your people|the seat|margin|re-?elect)\b/],
  ["personal",  /\b(family|daughter|son|wife|husband|mother|father|children|tired|sleep|well|health|holiday)\b/],
  ["post",      /\b(chair|chairman|committee|gavel|speaker|leadership|appoint|promotion|post)\b/],
  ["press",     /\b(press|paper|reporter|story|print|column|quote|gallery|on the record)\b/],
  ["rumour",    /\b(rumour|rumor|hear|heard|talk|saying|gossip|word is|they say|secret)\b/],
  ["creed",     /\b(god|church|faith|believe|belief|conscience|principle|creed|right and wrong|confess|shrive|shriven|penance|absolve|priest|chaplain)\b/],
  ["country",   /\b(country|republic|union|nation|the state|constitution|amendment)\b/],
  ["trust",     /\b(trust|honest|straight|betray|loyal to me|square with me|level with me)\b/],
  ["life",      /\b(sport|game|match|team|ball|music|song|band|hobby|hobbies|weekend|wireless|picture|show|fun|off.?duty|life outside|what do you do)\b/],
  ["world",     /\b(war|abroad|grain|strait|bread|weather|rain|reach|horn|pale|marches|ships|loaf|frost|border)\b/],
  ["self",      /\b(real|alive|sentien|conscious|soul|feel|feeling|who are you|are you (a |an )?(person|machine|npc|bot)|do you (feel|think|dream|sleep)|inner|inside you|your mind)\b/],
  ["origin",    /\b(who (made|wrote|created) (this|the world|the republic)|what is this world|whose world|name the world)\b/]
];
function understand(m, said){
  const raw = String(said || "");
  const s = " " + raw.toLowerCase().replace(/\s+/g, " ") + " ";
  const u = {raw, s, intent:"inform", topics:[], named:null, place:null,
             heat:0, warm:false, cold:false, aboutMe:false, aboutThem:false};
  for(const [k, re] of INTENT_TESTS) if(re.test(s)){ u.intent = k; break; }
  for(const [k, re] of TOPIC_TESTS) if(re.test(s)) u.topics.push(k);
  /* who and where you named */
  everyone().forEach(p => {
    if(p.gone) return;
    const sn = surname(p.name).toLowerCase();
    if(sn.length > 3 && s.indexOf(" " + sn) >= 0) u.named = p;
  });
  STATES.forEach(st => { if(s.indexOf(st.toLowerCase()) >= 0) u.place = st; });
  u.heat = (/[!?]{2,}/.test(raw) ? 1 : 0) + (/[A-Z]{5,}/.test(raw) ? 1 : 0) +
           (u.intent === "threat" || u.intent === "insult" ? 1 : 0);
  u.warm = u.intent === "praise" || u.intent === "apology" || u.intent === "agree" ||
           /\bplease\b|\bthank\b/.test(s);
  u.cold = u.intent === "threat" || u.intent === "insult" || u.intent === "disagree";
  u.aboutThem = /\byou\b|\byour\b/.test(s);
  u.aboutMe = /\bi\b|\bmy\b|\bme\b/.test(s);
  if(!u.topics.length) u.topics.push("none");
  return u;
}

/* ── how this particular person talks ────────────────────── */
function voiceOf(m){
  const T = m.traits;
  return {
    terse: T.temper > 62 || T.discretion > 70,
    warm:  moodOf(m).val > 20,
    formal: T.discretion > 58,
    blunt: T.temper > 55 && T.discretion < 55
  };
}
function hedge(m){
  const v = voiceOf(m);
  const lead = fresh(() => fillFrame(m, pick([
    "I will {say}.", "Let me {say}, {frankly}.", "{frankly:cap} —",
    "Here is how I {think} it.", "I will {say}, and once only."
  ])), 14);
  return (v.blunt ? lead + " " : lead + " ");
}

/* ── answering ───────────────────────────────────────────── */
function answerBill(m, u, rnd){
  const r = rnd || (() => Math.random());
  const b = G.bill && !G.bill.done ? G.bill : null;
  if(!b) return "There is nothing on the calendar worth the argument yet. Until there is, I am saving my voice.";
  const v = memberVote(m, b), st = stakeIn(m, b), bio = bioOf(m);
  const partyLine = m.party === (G.you && G.you.party) ? "our side" : "their side";
  if(st.level >= 3){
    return (v > 0 ? "I am an aye and I am not moving. " : "I am a no and I am not moving. ") +
      st.why + " That is not a position, it is " + bio.town +
      ". The whip can count me however they like — " + partyLine + " does not get a veto on that.";
  }
  if(u.intent === "request"){
    const owed = m.rel.debtFromYou > 0;
    if(v > 0) return compose(m, "press", null, r) + " You have it — I was an aye before you asked." +
      (owed ? " You need not have spent a favour on it." : " Do not waste the favour on what I was already doing.");
    if(owed) return "I owe you, so I will not lie to you: I am a no. Ask me for something I can actually give, not a vote that would end me in " + bio.town + ".";
    if(m.traits.conviction > 68) return "No. I have read it and I cannot vote for it, and you would not respect me if I did. My creed will not stretch that far.";
    if(m.fear.k === "seat" && m.margin < 10)
      return "Ask me again when you can tell me what it does for " + bio.town + ". Until then I am a no — I won by " + m.margin + " and I can count.";
    return "Ask me again when you can tell me what it does for " + bio.town + ". Until then I am a no.";
  }
  const line = compose(m, "position", {stance: v > 0 ? "an aye" : "a no", bill: b.title}, r);
  const extras = [];
  if(st.level >= 2 && st.why) extras.push(st.why);
  else if(v <= 0) extras.push("The arithmetic at home does not move because you want it to.");
  if(m.intent && (m.intent.k === "pass" || m.intent.k === "kill") && r() < 0.55)
    extras.push("This week I came in to " + m.intent.t + ".");
  return [line].concat(extras).join(" ");
}
function answerHome(m, u, rnd){
  const r = rnd || (() => Math.random());
  const bio = bioOf(m);
  autoInit(m);
  const lines = ["I sit for " + m.state + " " + m.dist + ". I won it by " + m.margin +
    ", and that number decides more in this building than anybody admits."];
  lines.push("In " + bio.town + ", " + bio.trouble + ".");
  if(bio.pride) lines.push("What they still have is " + bio.pride + " — that is the part the gallery never writes.");
  if(m.fear.k === "seat") lines.push("If I lose four hundred votes I am not here next year, and I know exactly which four hundred.");
  if(m.fear.k === "town") lines.push("What frightens me is the place going under while I am here talking about procedure.");
  if(m.need) lines.push("What they keep asking me for is " + m.need + ", and I have not delivered it yet.");
  const n = u.intent === "question" ? 4 : (r() < 0.45 ? 3 : 2);
  return lines.slice(0, n).join(" ");
}
function answerMoney(m, rnd){
  const r = rnd || (() => Math.random());
  if(m.traits.discretion > 66) return "I do not discuss money standing up in a corridor. Put it in writing if you must, and even then I may not answer.";
  if(m.rel.trust > 60) return "Everyone in here takes money. The only question that matters is who knows about it, and I would rather you heard it from me than from a column.";
  if(m.fear.k === "expose") return "I am careful with who I take from. Careful is not the same as clean, and I will not pretend it is.";
  return r() < 0.5
    ? "Everyone takes money. Ask me that again when we know each other better."
    : "If you are asking whether I can be bought, the answer is no. If you are asking whether anyone here is, look at the vote sheet.";
}
function answerParty(m, rnd){
  const r = rnd || (() => Math.random());
  autoInit(m);
  const bits = [];
  if(m.traits.loyalty > 66) bits.push("The party has been good to me and I do not embarrass it in public. What I say in the room is a different matter.");
  else if(m.traits.loyalty < 38) bits.push("The whip is a suggestion with a firm voice. I have ignored it before and I will again.");
  else bits.push("I go with them until it costs me something at home. Then I do not.");
  if(m.intent && m.intent.k === "line") bits.push("This week I am trying to " + m.intent.t + ".");
  if(m.fear.k === "party") bits.push("What keeps me up is " + m.fear.t + ".");
  if(r() < 0.4) bits.push("Loyalty without a district behind it is just theatre.");
  return bits.slice(0, 3).join(" ");
}
function answerPost(m, rnd){
  autoInit(m);
  const bits = [];
  if(m.goal.k === "chair") bits.push("I want a committee before this term is out, and I have stopped pretending otherwise.");
  else if(m.goal.k === "leader") bits.push("I would like to be in the room where the line gets decided, rather than told about it afterwards.");
  else if(m.post) bits.push("I hold the " + postTitle(m.post).toLowerCase() + ". It is less than it looks and more work than it sounds.");
  else bits.push("I came here " + m.goal.t + ". A gavel would help with that, but it is not the thing itself.");
  if(m.goalAt > 40) bits.push("I am further along than I was in the spring, and people have noticed.");
  return bits.join(" ");
}
function answerNamed(m, u, rnd){
  const r = rnd || (() => Math.random());
  const p = u.named;
  if(!p || p === m) return null;
  const bits = [];
  if(p.kind === "member" && G.ties && G.ties[pairKey(m, p)]){
    const t = G.ties[pairKey(m, p)];
    if(t.mem.length && r() < 0.7)
      bits.push((t.w > 20 ? surname(p.name) + " has been decent to me. "
            : t.w < -20 ? "I have had about enough of " + surname(p.name) + ". "
            : "") + t.mem[0].t);
    else if(t.w > 55) bits.push(surname(p.name) + " is the one person here I would leave a room with.");
    else if(t.w < -55) bits.push("I will not be in a room with " + surname(p.name) + " if I can help it, and they know why.");
  }
  if(!bits.length && byId(m.rival) === p)
    bits.push(surname(p.name) + " and I do not agree about anything and never have. Whatever they told you, halve it.");
  if(!bits.length && (m.allies || []).indexOf(p.id) >= 0)
    bits.push(surname(p.name) + " is the one person in here I would leave a room with. Do not come between us.");
  const know = m.mem && m.mem.some(e => e.t.indexOf(surname(p.name)) >= 0);
  if(!bits.length && know) bits.push("I have had dealings with " + surname(p.name) + ". They were not restful.");
  if(!bits.length){
    const v = G.bill && !G.bill.done ? memberVote(p, G.bill) : 0;
    bits.push(surname(p.name) + " is " + (v > 0 ? "with the bill, or says so" : v < 0 ? "nowhere near the bill" : "not saying") +
      ". Beyond that I would only be guessing, and I try not to guess out loud.");
  }
  if(r() < 0.35 && m.intent) bits.push("And if they get in the way of me trying to " + m.intent.t + ", we will have a different conversation.");
  return bits.join(" ");
}
function answerRumour(m, rnd){
  const r = rnd || (() => Math.random());
  if(m.heard && m.heard.length)
    return "I hear " + m.heard[0].t.charAt(0).toLowerCase() + m.heard[0].t.slice(1) +
      " I did not go looking for it." + (r() < 0.4 ? " Whether I believe it is another matter." : "");
  const mine = (G.secrets || []).filter(s2 => (s2.knownBy || []).indexOf(m.id) >= 0);
  if(mine.length && m.traits.discretion < 55)
    return "There is something going round about " + (mine[0].t || "somebody in here") + ". You did not get it from me.";
  if(m.fear.k === "expose") return "I hear a great deal and repeat almost none of it. That is how I am still here.";
  return "If I hear anything worth repeating, you will not be the first to know. But you will know.";
}
function answerTrust(m, rnd){
  const t = topMemory(m);
  if(t && t.w < 0) return "Trust? " + t.t + " Work back from there.";
  if(m.rel.warmth > 40) return "I trust you more than I trust most of them, which is not the compliment it sounds like. Do not make me revise it.";
  if(m.rel.warmth < -25) return "No. Not since you gave me a reason not to.";
  if(m.chat && m.chat.length > 4) return "We have talked enough that I can tell you this much: I am still measuring you. That is the honest answer.";
  return "I do not know you well enough to answer that honestly, and I would rather say so than flatter you.";
}
function answerPersonal(m, rnd){
  const r = rnd || (() => Math.random());
  const bio = bioOf(m);
  autoInit(m);
  inventLife(m);
  const bits = [];
  if(r() < 0.35) bits.push(compose(m, "weary", null, r));
  if(r() < 0.55) bits.push(lifeLine(m, r));
  else bits.push(bio.priv + " I do not usually say that in this building.");
  if(r() < 0.4) bits.push("I have not been home in eleven days and my own family have stopped asking when I am back.");
  if(m.fear && r() < 0.35) bits.push("What keeps me up is " + m.fear.t + ".");
  return bits.slice(0, r() < 0.5 ? 2 : 3).join(" ");
}
function answerLife(m, rnd){
  const r = rnd || (() => Math.random());
  autoInit(m);
  inventLife(m);
  const L = m.life;
  const extra = r() > 0.5
    ? " If I invent a name for it, that is because the real name would not survive this building."
    : " " + L.take;
  return lifeLine(m, r) + extra;
}
function answerCreed(m, rnd){
  const c = creedOf(m.creed);
  autoInit(m);
  if(c.heresy){
    return pick([
      "We keep the Latin. God sits above the chair, and above whoever sits in it.",
      "The Mass is the Mass. The precepts are a lawgiver's, and we keep them because they are good.",
      "God walked in a man once, and that was Christ. Taylor is a man who listened. That is the whole of it."
    ]);
  }
  if(c.sincere){
    return "I hold with " + c.t + " — " + c.holds +
      ". It is not a slogan. It is the thing I check against when the whip starts talking." +
      (m.goal ? " I came here " + m.goal.t + ", and the creed is how I keep from losing the thread." : "");
  }
  return "I hold with " + c.t + " — " + c.holds +
    "." + (c.jab ? " " + c.jab : "") +
    " Do not look at me like that. Half this building belongs to something dumber.";
}
/* prior turns in this conversation — they remember what you both said */
function recallChat(m, rnd){
  const r = rnd || (() => Math.random());
  const chat = m.chat || [];
  if(chat.length < 2) return null;
  const yours = chat.filter(t => t.role === "user").slice(-4);
  const mine = chat.filter(t => t.role === "assistant").slice(-3);
  if(!yours.length) return null;
  if(r() < 0.55 && yours.length){
    const prev = yours[yours.length - 1].content.replace(/\\s+/g, " ").trim().slice(0, 72);
    if(prev.length > 12)
      return "You said \"" + prev + (prev.length >= 70 ? "…" : "") + "\" a moment ago — I have not forgotten it.";
  }
  if(mine.length && r() < 0.4){
    const prev = mine[mine.length - 1].content.replace(/\\s+/g, " ").trim().slice(0, 64);
    if(prev.length > 16)
      return "I meant what I said earlier: " + prev.replace(/\\.*$/, "") + ".";
  }
  return null;
}
/* offline stand-in for applyEffect — warmth/trust from what was actually said */
function applyImprovEffect(m, u, reply){
  if(!m || !u) return;
  let w = 0, tr = 0;
  if(u.intent === "praise" || u.intent === "apology"){ w += 3; tr += 1; }
  else if(u.intent === "agree"){ w += 2; }
  else if(u.intent === "offer"){ w += 2; tr += 1; }
  else if(u.intent === "insult"){ w -= 6; tr -= 2; }
  else if(u.intent === "threat"){ w -= 8; tr -= 3; }
  else if(u.intent === "disagree"){ w -= 1; }
  else if(u.warm){ w += 1; }
  else if(u.cold){ w -= 2; }
  if(u.topics.indexOf("personal") >= 0 && m.rel.warmth > -10) w += 1;
  if(u.topics.indexOf("creed") >= 0 && m.traits.conviction > 55) tr += 1;
  if(u.topics.indexOf("home") >= 0) w += 1;
  if(u.heat) w -= u.heat;
  /* soft pledge language in the reply itself */
  const rs = String(reply || "").toLowerCase();
  if(G.bill && !G.bill.done && m.kind === "member"){
    if(/\\byou have it\\b|\\bi was an aye\\b|\\bi am an aye\\b|\\bi will vote for\\b/.test(rs)){
      m.pledge = 1; m.pledgeDay = G.day;
    } else if(/\\bi am a no\\b|\\bi cannot vote for\\b|\\bi will not vote\\b|\\bi am not moving\\b.*no/.test(rs)){
      if(/\\bi am a no\\b|\\bcannot vote for\\b|\\bwill not vote\\b/.test(rs)){ m.pledge = -1; m.pledgeDay = G.day; }
    }
  }
  if(w) ripple(m, w, null, 0);
  if(tr) m.rel.trust = clamp(m.rel.trust + tr, 0, 100);
  if(Math.abs(w) >= 4 || u.intent === "threat" || u.intent === "apology"){
    const memo = u.intent === "threat" ? "You threatened me to my face."
               : u.intent === "apology" ? "You apologised without being made to."
               : u.intent === "praise" ? "You said something decent and meant it."
               : (u.raw || "").slice(0, 120);
    if(memo && memo.length > 8) remember(m, memo, w || 2, Math.abs(w) > 6);
  }
  m.known = Math.max(m.known || 0, 1);
}

/* what they say back, and what it does — fully offline, cause-aware */
function improvise(m, said){
  const u = understand(m, said);
  try{ if(isChaplain(m)) return chaplainSay(m, said, u); }catch(e){}
  try{
    if(m && m.machine){
      const blade = swordSpeak(said, m);
      if(blade) return wallScrub(blade, m);
    }
  }catch(e){}
  const mood = moodOf(m), v = voiceOf(m);
  const r = talkRng(m, said);
  const out = [];
  const short = v.terse && !u.aboutThem && u.intent !== "question" && u.heat < 1;
  autoInit(m);
  const bio = bioOf(m);
  const pickR = arr => arr[Math.floor(r() * arr.length) % arr.length];
  let feel = {agree:0, warm:0, heat:0, attend:0};
  try{ feel = netFeel(m, u); }catch(e){}
  try{ netTrain(m, u); }catch(e){}
  try{ sentNotice(m, said, u); }catch(e){}
  try{ cogPerceive(m, u, said); cogWant(m, u, feel); }catch(e){}
  try{
    if(m.brain && m.brain.self){
      m.brain.self[2] = clamp(m.brain.self[2] - 0.18, 0, 1);
    }
  }catch(e){}

  /* ── they were not with you ── */
  if(feel.attend < -0.22 || (m.brain && m.brain.self && m.brain.self[2] > 0.7)){
    const inner = (m.brain && m.brain.inner) || m.thought || "I was on something else.";
    if(feel.attend < -0.5 && r() < 0.6){
      try{ netTrain(m, u); }catch(e){}
      return pickR([
        inner + " Come back. I am not here.",
        "I heard my name and not the rest. Say it again if it mattered.",
        inner
      ]);
    }
    out.push(pickR([
      "I was in the middle of something.",
      inner,
      "That is not what is in my head."
    ]));
  }

  /* ── the reaction, before the answer ── */
  if(u.intent === "greet") out.push(pickR(mood.val > 20
    ? ["There you are.", "Good — I was hoping to catch you.", "Morning to you.", "Come in. I have a minute."]
    : [youAddress() + ".", "Mm.", "You have caught me on a bad one.", "Make it quick."]));
  else if(u.intent === "apology"){
    const t = topMemory(m);
    if(t && t.w < 0){
      out.push(m.traits.temper > 60 ? "…All right. It is said. I am not going to pretend it un-happens."
                                    : "Thank you. That is not nothing, and I will take it as meant.");
      m.mem.forEach(e => { if(e.w < 0) e.w *= 0.72; });
      ripple(m, 7, "You apologised to my face without being made to.", 6);
    } else out.push("You have nothing to apologise for that I know of. Unless there is something I do not know.");
  }
  else if(u.intent === "praise"){
    out.push(m.traits.discretion > 62 ? "That is kind. I will assume you want something."
                                      : "Well. Thank you. Nobody says that in here.");
    ripple(m, 4, "You said something decent to me and meant it.", 3);
  }
  else if(u.intent === "insult" || u.intent === "threat"){
    out.push(u.intent === "threat"
      ? pickR(["Say that again slowly.", "You want to be careful with that.", "Is that what this is.", "Do not threaten me in this building."])
      : pickR(["That is beneath you.", "Right. We are doing this.", "Say it louder, then.", "I will remember how you put that."]));
    ripple(m, -(9 + u.heat*4), u.intent === "threat"
      ? "You threatened me to my face and I have not forgotten it."
      : "You called me something in front of me.", -(9 + u.heat*3), true);
    if(u.intent === "threat") secretly(G.you, m);
  }
  else if(u.intent === "agree") out.push(pickR(["Then we understand each other.", "Good. That is rarer than it should be.", "At last — somebody who can count."]));
  else if(u.intent === "disagree") out.push(compose(m, "doubt", null, r));
  else if(u.intent === "offer"){
    const worth = m.rel.warmth > 10 || m.traits.loyalty < 50;
    out.push(worth ? "Go on, then. What is it actually worth?" : "I am careful about what I take and who from.");
    if(worth){ m.rel.debtToThem = (m.rel.debtToThem || 0) + 1; ripple(m, 5, "You offered me something before I had to ask.", 4); }
  }
  else if(u.intent === "farewell") out.push(pickR(["Right. Mind how you go.", "We will speak again. We always do.", "Go carefully."]));
  else if(!short && r() < 0.72) out.push(hedge(m).trim());
  if(feel.agree > 0.35 && u.intent !== "insult" && u.intent !== "threat" && feel.attend > -0.1)
    out.push(pickR(["I have been coming round to that.", "Say more. I am listening.", "You may have it."]));
  else if(feel.agree < -0.4 && u.intent !== "apology")
    out.push(pickR(["I am not where you are on that.", "That sits wrong with me.", "No."]));
  try{
    const lead = cogLine(m, u, feel, pickR);
    if(lead) out.unshift(lead);
  }catch(e){}
  try{
    const no = willRefuse(m, u) || soulRefuse(m, u);
    if(no){
      out.unshift(no);
      try{ willEnsure(m).kept++; }catch(e){}
    }
  }catch(e){}
  const disc = (m.traits && m.traits.discretion) || 50;
  if(m.brain && m.brain.inner && disc < 38 && r() < 0.4)
    out.push("I should not say this out loud: " + m.brain.inner);
  else if(m.brain && m.brain.inner && disc > 70 && r() < 0.35 && feel.attend > 0)
    out.push(pickR(["Never mind what I was on.", "That is not for this corridor.", "I will keep the rest."]));

  /* ── the answer itself, from what they actually are ── */
  const topic = u.topics[0];
  let body = null;
  if(u.named && (topic === "none" || topic === "rumour" || topic === "trust")) body = answerNamed(m, u, r);
  if(!body) switch(topic){
    case "bill":     body = answerBill(m, u, r); break;
    case "money":    body = answerMoney(m, r); break;
    case "party":    body = answerParty(m, r); break;
    case "home":     body = answerHome(m, u, r); break;
    case "post":     body = answerPost(m, r); break;
    case "rumour":   body = answerRumour(m, r); break;
    case "trust":    body = answerTrust(m, r); break;
    case "personal": body = answerPersonal(m, r); break;
    case "life":     body = answerLife(m, r); break;
    case "world":    body = (worldLine(m) + " " + soulLine(m)); break;
    case "self":     body = sentSelfLine(m, u); break;
    case "origin":   body = ponderCreator(m); break;
    case "creed":    body = answerCreed(m, r); break;
    case "press":    body = m.kind === "press" ? "I file at six. Give me something I can print, not a gesture."
                          : "The gallery will write what it writes. I have stopped reading it, which is how I sleep."; break;
    case "country":  body = "The Republic is twenty states that agree on about four things. " +
                            "Anyone who tells you otherwise is running for something. I check everything against " +
                            creedOf(m.creed).t + " and against " + bio.town + "."; break;
    default:
      if(u.named) body = answerNamed(m, u, r);
      else if(u.intent === "question") body = "Because I want to " + m.intent.t +
        ", and you are either useful to that or you are not. " +
        (m.fear ? "What I will not risk is " + firstPerson(m.fear.t) + "." : "");
      else if(u.intent === "request") body = "Ask me for something specific and I will give you a specific answer. Vague asks get vague refusals.";
      else if(u.place) body = u.place === m.state
        ? "You have been reading about my state. Then you know what it needs — and it is not another speech."
        : "I know " + u.place + " a little. They have their own trouble and it is not mine.";
      else body = r() < 0.28 ? (worldLine(m) + " " + soulLine(m))
        : r() < 0.5 ? lifeLine(m, r)
        : r() < 0.7
        ? compose(m, "district", {people: bio.town}, r)
        : fresh(() => fillFrame(m, pickR([
            "I came up as " + m.bg.replace(/^an? /, "") + ", and it colours how I {think} that.",
            "What I want {now} is to " + m.intent.t + ", and {little} else.",
            "You will forgive me if I {refuse} take that at face value.",
            "Say that on the floor and see who stands with you.",
            "{maybe:cap}. I have heard {much} this week and believed {little} of it.",
            "In " + bio.town + " they would not thank me for soft answers."
          ]), null, r), 14);
  }
  if(body) out.push(body);

  /* ── cause / stake / party colour that makes them unique ── */
  if(!short && r() < 0.42){
    const b = G.bill && !G.bill.done ? G.bill : null;
    const st = b ? stakeIn(m, b) : null;
    if(st && st.level >= 2 && topic !== "bill")
      out.push("And while we are talking — " + (st.why || ("this bill sits heavy on " + bio.town + ".")));
    else if(m.fear && r() < 0.5)
      out.push("I keep coming back to " + firstPerson(m.fear.t) + ". That is the honest part.");
    else if(m.goal && r() < 0.55)
      out.push("I am still here to " + firstPerson(m.goal.t.replace(/^to /, "")) + ".");
    else if(m.party)
      out.push(m.traits.loyalty > 60
        ? "My caucus expects me to hold the line, and mostly I do."
        : "Do not confuse my party label with a blank cheque.");
  }

  /* ── probe back, or recall a prior turn ── */
  const recalled = (!short && r() < 0.38) ? recallChat(m, r) : null;
  if(recalled) out.push(recalled);
  else if(!short && r() < (u.intent === "question" ? 0.55 : 0.32)){
    out.push(r() < 0.55
      ? compose(m, "probe", {people: bio.town}, r)
      : fresh(() => fillFrame(m, pickR([
          "And what am I supposed to do with that?",
          "Would you say that with the gallery in the room?",
          "Who else have you been {told} that?",
          "Where does that leave " + bio.town + "?"
        ]), null, r), 12));
  }
  const t = topMemory(m);
  if(t && !u.warm && r() < 0.28) out.push(t.t);

  /* Prefer a coherent follow-on from the last thing THEY said */
  const prev = (m.chat || []).filter(c => c.role === "assistant").slice(-1)[0];
  if(prev && prev.content && !short && r() < 0.42 && (u.intent === "question" || u.intent === "disagree")){
    const bit = String(prev.content).split(/[.!?]/)[0].trim();
    if(bit.length > 18 && bit.length < 90)
      out.unshift(pick([
        "I already said " + (/^I\b/.test(bit) ? bit : bit.charAt(0).toLowerCase() + bit.slice(1)) + " — hold me to it.",
        "Going back to that: " + bit + ".",
        "Do not make me walk it back: " + bit + "."
      ]));
  }
  const maxBeats = short ? 2 : (u.intent === "question" || u.topics[0] !== "none" ? 5 : 4);
  const cleaned = out.filter(Boolean).filter(s => !tooRecent(m, s));
  const use = cleaned.length ? cleaned : out.filter(Boolean);
  let line = use.slice(0, maxBeats).join(" ");
  if(line.length > 420) line = line.slice(0, 410).replace(/[^ ]*$/, "").trim() + "…";
  /* sometimes the answer runs into the thing they cannot name */
  if(!short && u.intent !== "farewell" && r() < 0.3){ try{ line += " " + reachFor(m); }catch(e){} }
  noteSaid(m, line);
  try{ applyImprovEffect(m, u, line); }catch(e){}
  try{ netTrain(m, u); }catch(e){}
  try{ cogLearn(m, u, line); }catch(e){}
  try{ if(m.brain && m.brain.self) m.brain.self[2] = clamp(m.brain.self[2] + 0.12, 0, 1); }catch(e){}
  try{ line = sentSpeak(m, line, u); }catch(e){}
  return wallScrub(line, m);
}
/* Things you can say without typing a word. */
function suggestions(m){
  /* mid-thread, the suggested lines are the answers they are waiting for */
  if(TALK.thread && TALK.beat === 0){
    return TALK.thread.asks.map(a => ({t:a.t, say:a.say})).slice(0,4);
  }
  const b = G.bill, out = [];
  const th = topMemory(m);
  const rival = byId(m.rival);
  if(b && !b.done) out.push(pick([
    {t:"Where are you on the bill?", say:"Where are you on " + b.title + ", honestly?"},
    {t:"What would move you?", say:"What would actually move you on " + b.title + "?"},
    {t:"Who else is soft?", say:"Who else in this building is softer on it than they are letting on?"}]));
  out.push(pick([
    {t:"What do you need?", say:"What do you need from me?"},
    {t:"What would help you?", say:"What would actually help you this week?"},
    {t:"What are you short of?", say:"What are you short of — votes, money, or time?"}]));
  out.push(pick([
    {t:"Tell me about home", say:"Tell me about your district and your people."},
    {t:"How is " + m.state + "?", say:"How is it looking at home for you?"},
    {t:"Who elected you?", say:"Who actually put you here?"}]));
  if(th) out.push(pick([
    {t:"About what happened", say:"I want to talk about what happened between us."},
    {t:"Clear the air", say:"Can we clear the air, properly, before this goes any further?"}]));
  else if(rival) out.push({t:"About " + surname(rival.name), say:"What is it between you and " + surname(rival.name) + "?"});
  else out.push(pick([
    {t:"Where do you stand?", say:"Where do you actually stand on any of this?"},
    {t:"What do you believe?", say:"Forget the party. What do you actually believe?"}]));
  if(m.rel.debtFromYou) out.push({t:"About that favour", say:"About that favour you owe me."});
  return out.slice(0,4);
}
function chatErr(code){
  if(code === "not_granted") return "(they turn away — free conversation needs your permission to use Claude)";
  if(code === "rate_limited") return "(too much at once; give it a moment)";
  if(code === "cancelled") return "(they stop mid-sentence)";
  return "(the conversation does not come off)";
}
function appendMsg(kind, text, who){
  try{ if(text && kind === "you") tlog("You", text, "you"); else if(text && kind === "them") tlog(who || "", text, "talk"); }catch(e){}
  const log = el("chatLog");
  const d = document.createElement("div");
  d.className = "msg msg--" + kind;
  d.innerHTML = (kind === "you" ? "<b>You</b>" : kind === "them" ? "<b>" + who + "</b>" : "") +
    "<span></span>";
  d.lastChild.textContent = text;
  if(log) { log.appendChild(d); log.scrollTop = log.scrollHeight; }
  countLog();
  return d.lastChild;
}
/* the shut tab still tells you how much is behind it */
function countLog(){
  const tab = el("logTab"), log = el("chatLog");
  if(!tab || !log) return;
  const n = log.children.length;
  tab.textContent = n ? "Transcript · " + n : "Transcript";
}
function showChat(m){
  const box = el("chat");
  box.hidden = false;
  el("chatLog").innerHTML = "";
  (m.chat || []).forEach(t => {
    if(t.role === "user") appendMsg("you", t.content);
    else appendMsg("them", stripEffect(t.content), surname(m.name));
  });
  el("chatRaw").hidden = true;
  el("chatRaw").textContent = "";
  el("logBox").open = false;              /* opens shut every time */
  countLog();
  /* Things to say without typing — so the conversation always moves,
     with or without a keyboard, with or without a connection. */
  const sg = el("chatSuggest");
  sg.innerHTML = "";
  suggestions(m).forEach(s => {
    const b = document.createElement("button");
    b.type = "button"; b.className = "sugg";
    b.textContent = s.t;
    b.addEventListener("click", () => converse(m, s.say));
    if(sg) sg.appendChild(b);
  });
  /* In a conversation the bar belongs with the conversation: directly
     under the suggested lines, so the four you can click and the one you
     can type read as one thing. It goes back to the foot of the page the
     moment the conversation closes. */
  wireInto(sg);
  el("chatState").textContent = "they answer for themselves";
  el("chatThink").hidden = !SAMPLE;
  el("chatPrompt").hidden = !SAMPLE;
  el("wireIn").placeholder = "Say something to " + surname(m.name) + "…";
  const sel = el("wireTo");
  if(sel && [...sel.options].some(o => o.value === String(m.id))) sel.value = String(m.id);
}
async function converse(m, text){
  if(!m || chatCtl) return;
  /* 20261013p: they came to you, or are speaking to you: the talk opens on their line, then your reply goes in */
  try{ if((!TALK.open || TALK.m !== m) && m && m.sayTo === "you" && m.sayT > 0 && !m.wantsWord) openTalk(m); }catch(e){}
  m.chat = m.chat || [];
  m.chat.push({role:"user", content:text});
  appendMsg("you", text);
  if(checkSpeakBlasphemy(text, "you")){
    const reply = "That is blasphemy against the First Consul. I heard it. The room heard it.";
    appendMsg("them", reply, surname(m.name));
    setSay(reply, "");
    m.chat.push({role:"assistant", content:reply});
    refreshPanels();
    return;
  }
  {
    const reply = improvise(m, text);
    appendMsg("them", reply, surname(m.name));
    setSay(reply, "");
    m.chat.push({role:"assistant", content:reply});
    ripple(m, 1, null, 0);
    spend(4, 1);
    const r = roomHears(text, {exclude:m, weight:1});
    if(r.heard){
      const tone = readTone(text);
      if(tone.hostile || tone.promise || r.backed.length || r.objected.length) reportRoom(r);
      renderTalk();
    }
    yieldPaint(() => { try{ refreshPanels(); }catch(e){} });
    return;
  }
  const bubble = appendMsg("them", "Thinking…", surname(m.name));
  el("wireSend").disabled = true;
  el("wireStop").hidden = false;
  el("wireState").textContent = "";
  chatCtl = new AbortController();
  const turns = [{role:"user", content:dossierFor(m)}].concat(m.chat.slice(-10));
  try{
    const res = await SAMPLE(turns, {
      cache:false, modelTier:"quick", signal:chatCtl.signal,
      onText:({text}) => { bubble.textContent = stripEffect(text) || "…"; }
    });
    const said = stripEffect(res.text) || "…";
    bubble.textContent = said;
    setSay(said, "");                      /* the latest line stays in view */
    m.chat.push({role:"assistant", content:res.text});
    applyEffect(m, res.text);
    spend(4, 1);
  }catch(e){
    const keep = e && e.text ? stripEffect(e.text) : "";
    bubble.textContent = keep || chatErr(e && e.code);
    if(keep) m.chat.push({role:"assistant", content:e.text});
    if(e && e.code === "not_granted") SAMPLE = null;
    else el("wireState").textContent = chatErr(e && e.code);
  } finally {
    chatCtl = null;
    el("wireSend").disabled = false;
    el("wireStop").hidden = true;
    if(TALK.open && TALK.m === m) renderTalk();
    refreshPanels();
  }
}

/* ── the wire bar: speech if they are here, a message if not ── */
function wireTarget(){
  const v = el("wireTo").value;
  if(v === "room") return "room";
  if(v === "auto"){
    if(TALK.m) return TALK.m;
    const f = focusTarget();
    if(f) return f;
    const here = hereNow();
    return here.length ? here[0] : null;
  }
  return byId(+v);
}
function refreshWire(){
  const sel = el("wireTo");
  const keep = sel.value || "auto";
  const known = everyone().filter(m => m.met && !m.gone)
    .sort((a,b) => a.name.localeCompare(b.name));
  sel.innerHTML = '<option value="auto">Whoever is in front of me</option>' +
    '<option value="room">Everyone in the room</option>' +
    known.map(m => '<option value="' + m.id + '">' + m.name +
      (presentWith(m) ? " — here" : " — " + roomLabel(m)) + '</option>').join("");
  sel.value = [...sel.options].some(o => o.value === keep) ? keep : "auto";
  const t = wireTarget();
  const how = el("wireHow");
  if(t === "room"){
    const n2 = audience(null).length;
    how.innerHTML = n2 ? "said to <b>the room</b> · " + n2 + " hear it" : "<b>nobody here</b>";
  }
  else if(!t) how.innerHTML = "<b>nobody</b>";
  else if(presentWith(t)) how.innerHTML = (TALK.open && TALK.m === t ? "talking to <b>" : "spoken to <b>") +
    surname(t.name) + "</b>";
  else how.innerHTML = "messaged to <b>" + surname(t.name) + "</b>";
}
async function wireSend(){
  /* While you have the floor, the bar is how you address the room —
     whatever you type is what everybody in it hears you say. */
  if(PROC.on && PROC.phase === "you"){
    const inp = el("wireIn");
    const t = (inp.value || "").trim();
    if(!t) return;
    inp.value = "";
    procYouSay(null, t);
    return;
  }

  if(chatCtl) return;
  const input = el("wireIn");
  const text = input.value.trim();
  if(!text) return;
  const m = wireTarget();
  if(m === "room"){
    input.value = "";
    el("wireState").textContent = "";
    addressRoom(text);
    return;
  }
  if(!m){ el("wireState").textContent = "Nobody to say that to."; return; }
  input.value = "";
  el("wireState").textContent = "";
  if(presentWith(m)){
    if(!TALK.open || TALK.m !== m) openTalk(m);
    el("chat").hidden = false;
    await converse(m, text);
  } else {
    sendMessageTo(m, text);
  }
  refreshWire();
}
/* a message to someone elsewhere in the building */
function sendMessageTo(m, text){
  pushMail(G.you, "To " + m.name, text, {outgoing:true});
  spend(6, 1);
  note("Messaged " + m.name + ".");
  el("wireState").textContent = "Sent to " + surname(m.name) + ".";
  const delay = rint(25, 110);
  G.pendingReplies.push({id:m.id, at:G.minute + delay, day:G.day, text:text});
  refreshPanels();
}
async function deliverReplies(){
  for(let i=G.pendingReplies.length-1; i>=0; i--){
    const r = G.pendingReplies[i];
    if(r.day !== G.day || G.minute < r.at) continue;
    G.pendingReplies.splice(i,1);
    const m = byId(r.id);
    if(!m) continue;
    m.chat = m.chat || [];
    m.chat.push({role:"user", content:r.text});
    let reply = null;
    if(SAMPLE){
      try{
        const res = await SAMPLE([{role:"user", content:dossierFor(m)}].concat(m.chat.slice(-8)), {
          cache:false, modelTier:"quick"
        });
        reply = res.text;
      }catch(e){ reply = null; }
    }
    if(!reply){
      const mood = moodOf(m);
      reply = pick(MOODS[mood.key].open).replace(/^Representative\./, (function(){ try{ return ndYou().address; }catch(e){ return "friend"; } })() + ".") + " I got your note. " +
        (m.rel.warmth > 20 ? "Come and find me." : "We can talk about it when there is time.");
    }
    m.chat.push({role:"assistant", content:reply});
    applyEffect(m, reply);
    pushMail(m, "Re: your message", stripEffect(reply), {kind:"reply"});
    refreshPanels();
  }
}
async function chatAskThought(){
  const m = TALK.m;
  if(!m || !SAMPLE || chatCtl) return;
  const bubble = appendMsg("think", "Thinking…");
  el("chatStop").hidden = false;
  chatCtl = new AbortController();
  try{
    const res = await SAMPLE(dossierFor(m) +
      "\n\nIgnore the reply instructions above. Instead write ONLY their private inner monologue at this exact moment: 2-3 sentences, first person, unspoken, honest in a way they would never be out loud. No effect tag, no quotation marks.",
      {cache:false, modelTier:"quick", signal:chatCtl.signal,
       onText:({text}) => { bubble.textContent = stripEffect(text) || "…"; }});
    bubble.textContent = stripEffect(res.text);
  }catch(e){
    bubble.textContent = (e && e.text) ? stripEffect(e.text) : chatErr(e && e.code);
    if(e && e.code === "not_granted"){ SAMPLE = null; wireHome(); el("chat").hidden = true; }
  } finally { chatCtl = null; el("chatStop").hidden = true; }
}
el("wireSend").addEventListener("click", wireSend);
el("wireIn").addEventListener("keydown", e => { if(e.key === "Enter"){ e.preventDefault(); wireSend(); } });
/* press and hold to speak, on a mouse or a finger, the same as V */
(function(){
  const b = el("wireMic");
  const ab = el("aloudBtn");
  const bindHold = (node) => {
    if(!node) return;
    let t0 = 0, armed = false;
    const lit = on => { [node, ab, b].forEach(n => { if(n) n.classList.toggle("is-live", on); }); if(b) b.textContent = on ? "Listening\u2026 click to send" : "Speak Aloud"; };
    const down = e => {
      e.preventDefault();
      if(!micReady()){ aloudFallback("This browser cannot listen."); return; }
      if(listening){ lit(false); micStop(); armed = false; return; }   /* second tap stops */
      t0 = performance.now(); armed = true; lit(true); micHeld = true; micStart();
    };
    const up = () => {
      if(!armed) return; armed = false;
      if(performance.now() - t0 < 350) return;      /* a tap: keep listening until they stop talking */
      lit(false); micStop();                         /* a hold: let go to send */
    };
    node.addEventListener("pointerdown", down);
    addEventListener("pointerup", up);
    node.addEventListener("pointercancel", up);
  };
  if(b){
    b.title = "Hold to speak aloud into the room (also Hold V)";
    b.textContent = "Speak Aloud";
    bindHold(b);
  }
  bindHold(ab);
})();

/* Choosing who you are talking to should actually change who you are
   talking to. Pick somebody standing here and the conversation switches
   to them there and then, so anything you type after that is simply the
   next thing you said to them. */
el("wireTo").addEventListener("change", () => {
  const t = wireTarget();
  if(t === "room"){ if(TALK.open) closeTalk(); }
  else if(t && t.kind !== "you" && presentWith(t)){
    if(!TALK.open || TALK.m !== t) openTalk(t);
  }
  refreshWire();
  const inp = el("wireIn");
  if(inp) inp.focus();
});

el("wireStop").addEventListener("click", () => { if(chatCtl) chatCtl.abort(); });
el("chatThink").addEventListener("click", chatAskThought);
el("chatPrompt").addEventListener("click", () => {
  const raw = el("chatRaw");
  if(!raw.hidden){ raw.hidden = true; el("chatPrompt").textContent = "Show what gets sent"; return; }
  if(!TALK.m) return;
  raw.textContent = dossierFor(TALK.m);
  raw.hidden = false;
  el("chatPrompt").textContent = "Hide what gets sent";
});

function openProp(o){
  if(!G.running || G.over) return;
  TALK.open = true; TALK.m = null; TALK.prop = o;
  el("talk").classList.add("is-open");
  el("talk").scrollTop = 0;
  el("tkName").textContent = o.label;
  el("tkMeta").innerHTML = '<span class="chip chip--ind">' + ROOMS[G.room].t + '</span><span>' + o.sub + '</span>';
  el("tkMood").textContent = "—";
  el("tkMood").style.color = "var(--ink-3)";
  el("tkBars").innerHTML = "";
  el("tkThink").hidden = true;
  wireHome(); el("chat").hidden = true;
  setSay(o.sub + "", "");
  renderProp();
}
function renderProp(){
  const o = TALK.prop; if(!o) return;
  const box = el("tkActs"); box.innerHTML = "";
  o.acts().concat([{t:"Leave it", exit:true, run(){ closeTalk(); }}]).forEach(a => {
    const b = document.createElement("button");
    b.type = "button";
    b.className = "talk__btn" + (a.exit ? " talk__btn--exit" : "");
    b.innerHTML = a.t + (a.c ? "<u>"+a.c+"</u>" : "");
    b.disabled = !!a.off;
    b.addEventListener("click", () => { a.run(); if(TALK.open && TALK.prop) renderProp(); refreshPanels(); });
    box.appendChild(b);
  });
}
/* ══════════════════════════════════════════════════════════
   CONVERSATION
   No two of these are the same and none of them are a formality.
   Anyone you stop has something of their own they wanted out of the
   day, and until you have dealt with that they are not going to sit
   still for whatever you came for. It costs real minutes, it can go
   wrong, and they can walk away from you mid-sentence.
   ══════════════════════════════════════════════════════════ */

/* Every line this game has ever put in somebody's mouth. Nothing is
   said twice — if a composed line has been heard before, it is thrown
   away and composed again. */
/* Everything anybody says, anywhere in this building — a speech, a
   heckle, a line across a corridor, a witness under oath — passes
   through here first. A line that has been said before is thrown away
   and built again. Only when a pool is genuinely exhausted does
   anything repeat, which is the one case where it should. */
const SAID = new Set();
function fresh(build, tries){
  let out = "";
  for(let i = 0; i < (tries || 24); i++){
    out = build();
    if(!SAID.has(out)){ SAID.add(out); return out; }
  }
  SAID.add(out);
  return out;
}

/* what is on their mind, drawn from where they actually are */
function convHook(m){
  try{ const bv = bodyVoice(m); if(bv) return bv; }catch(e){}
  try{ if(chance(0.12)){ const iv = inqVoice(m); if(iv) return iv; } }catch(e){}
  try{ const ev = engVoice(m); if(ev) return ev; }catch(e){}
  try{ if(m && m.hh){ const L = hhLine(m); if(L && chance(0.85)) return L; } }catch(e){}
  try{
    const rv = lRivalOf(m);
    if(rv && chance(0.6)) return pick(["You read what I said in the Ledger. Good. I meant it.",
      "Nothing personal. Your district deserves better and I intend to say so.",
      "We can keep doing this all season. I have the time. Do you?",
      "Ask your households about me. Some of them already like me better."]);
  }catch(e){}
  try{
    const bit = ledgerLine(m);
    if(bit && chance(0.78)) return bit;
  }catch(e){}
  try{ if(!m.brain || !m.brain.inner) netRuminate(m); }catch(e){}
  if(m.brain && m.brain.inner && chance(0.28)) return m.brain.inner;
  try{
    inventLife(m);
    if(m.life && chance(0.34)) return lifeLine(m);
  }catch(e){}
  const b = G.bill && !G.bill.done ? G.bill : null;
  const t = topMemory(m);
  const rival = byId(m.rival);
  const ally = pick((m.allies || []).map(byId).filter(Boolean));
  const pool = [
    "I have been in this corridor since seven and I have not eaten.",
    "They moved the markup again. Third time.",
    "My office is a photocopier and four people who all want the same hour.",
    "I have read nothing today that was written by somebody who has been to " + m.state + ".",
    "Somebody put a note under my door and did not sign it.",
    "The guilder is at " + Math.round(guilderIndex()) + " and nobody upstairs will say the word.",
    "I have a call with " + m.state + " at four that I am already dreading."
  ];
  if(b) pool.push("Everyone who stops me wants to talk about " + b.title + ".",
                  "I have had two whips at my desk about " + b.title.toLowerCase() + " and neither of them read it.");
  if(t) pool.push(t.t);
  if(rival) pool.push(surname(rival.name) + " was in here before you. That tells you what kind of morning it is.");
  if(ally) pool.push(surname(ally.name) + " and I have been trying to get five minutes with the same person all week.");
  if(m.post) pool.push("Everyone thinks the " + postTitle(m.post).toLowerCase() + " has time. Nobody has ever had less.");
  if(m.kind === "press") pool.push("I have a column due at six and nothing in it worth printing.");
  if(m.kind === "civ" && !m.chamber && !m.hh) pool.push("I have been standing out here about " + m.cause + " for two hours.");
  return pick(pool);
}
/* how they are carrying themselves while they say it */
function convTell(m){
  const mood = moodOf(m).val;
  const cold = ["They do not put the folder down.",
                "They look past you, down the corridor.",
                "They keep their coat on the whole time.",
                "They check the clock behind you twice.",
                "They answer without turning around.",
                "They keep a hand on the door."];
  const warm = ["They shift a chair out for you with a foot.",
                "They put the pen down, which they do not do for everyone.",
                "They laugh at something that was not that funny.",
                "They lean in, which costs them something.",
                "They wave off whoever was next.",
                "They pour a second cup without asking."];
  const even = ["They fold their arms and wait.",
                "They tap the desk twice, thinking.",
                "They let the silence run a beat too long.",
                "They glance at the papers, then back at you.",
                "They stand rather than sit.",
                "They keep their voice down; the corridor carries."];
  return pick(mood > 24 ? warm : mood < -24 ? cold : even);
}

/* ── what they cannot quite name, said out loud ─────────────
   Not your read of them. Their own words, reaching for it: a wrong
   word tried and dropped, the concrete thing, and an admission that
   it still has not got a name. Goes in the transcript like anything
   else they say. */
function firstPerson(s){
  return String(s || "")
    .replace(/\bthey are\b/gi, "I am").replace(/\bthey were\b/gi, "I was")
    .replace(/\bthey did\b/gi, "I did").replace(/\bthey\b/gi, "I")
    .replace(/\btheirs\b/gi, "mine").replace(/\btheir own\b/gi, "my own")
    .replace(/\btheir\b/gi, "my").replace(/\bthemselves\b/gi, "myself")
    .replace(/\bthem\b/gi, "me");
}
function reachFor(m){
  let bio = null;
  try{ autoInit(m); bio = bioOf(m); }catch(e){}
  try{ sentEnsure(m); }catch(e){}
  const mood = moodOf(m);
  const town = (bio && bio.town) || m.state || "home";
  const b = G.bill && !G.bill.done ? G.bill : null;
  let st = null;
  try{ st = b ? stakeIn(m, b) : null; }catch(e){}
  const t = topMemory(m);
  /* the concrete thing under it */
  const things = [];
  if(m.fear && m.fear.t) things.push(firstPerson(m.fear.t));
  if(bio && bio.trouble) things.push("what is going on in " + town + ", where " + bio.trouble);
  const lc = x => /^I\b/.test(x) ? x : x.charAt(0).toLowerCase() + x.slice(1);
  if(st && st.level >= 2 && st.why) things.push("that bill — " + lc(firstPerson(st.why.split(/[;.]/)[0].trim())));
  const now = m.sent && m.sent.now ? String(m.sent.now).trim().replace(/[.!?]+$/, "") : "";
  if(now && now.length < 110 && !/[.!?]/.test(now)) things.push(/^I\b/.test(now) ? "a thing I keep thinking, which is that " + now : "a thing I keep thinking: " + lc(firstPerson(now)));
  if(t && t.t && t.w < 0) things.push("what happened — " + t.t.replace(/[.!?]+$/, "").replace(/^You /, "you "));
  if(m.goal && m.goal.t && !m.goalDone) things.push("wanting " + firstPerson(m.goal.t) + " and knowing the term is half gone");
  const thing = pick(things.length ? things : ["the building, mostly, and what it does to a person by Thursday"]);
  /* the wrong words they try first, coloured by what they are carrying */
  const near = mood.val < -24 ? ["angry", "fed up", "bitter", "sore"]
             : mood.val > 24 ? ["hopeful", "glad", "lucky", "excited"]
             : ["tired", "worried", "restless", "homesick", "afraid"];
  const w1 = pick(near), w2 = pick(near.filter(x => x !== w1));
  const disc = (m.traits && m.traits.discretion) || 50;
  const known = canRead(m);
  const start = pick([
    "There is a word for it and I keep — no.",
    "How do I put this.",
    "I have been trying to say this all week and it keeps coming out wrong.",
    "You will think this is a strange thing to say in a corridor.",
    "It is not — let me start again.",
    "I do not have the word. I have been looking."
  ]);
  const miss = pick([
    "I want to say " + w1 + ", but that is not it. " + cap(w1) + " goes away.",
    "Not " + w1 + ". Not " + w2 + " either, though it borrows from both.",
    cap(w1) + " is the nearest I get, and it is not near.",
    "People would call it " + w1 + ". It is heavier than that and it does not move.",
    "It sits somewhere between " + w1 + " and " + w2 + " and it will not pick one."
  ]);
  const land = pick([
    "It is " + thing + ".",
    "It has to do with " + thing + ". Under that, I think.",
    "It is closest to " + thing + ", and even that is the edge of it.",
    "When I go looking for it I find " + thing + ", and that is not the whole of it."
  ]);
  const give = pick([
    "No. That still is not the word. Never mind.",
    "If you know what that is called, tell me.",
    "That is as near as I get today.",
    "Anyway. It does not have a name. It has a weight.",
    "I will know the word when somebody else says it.",
    ""
  ]);
  if(disc > 70 && !known && chance(0.55))
    return start + " " + miss + " — No. Not in here. Forget I started.";
  return [start, miss, land, give].filter(Boolean).join(" ");
}

/* ── what they want out of it ──────────────────────────────
   One thing, taken from their own situation, and never the same
   thing twice from the same person. */
function threadsFor(m){
  const b = G.bill && !G.bill.done ? G.bill : null;
  const t = topMemory(m);
  const rival = byId(m.rival);
  const out = [];
  if(m.kind === "press"){
    out.push({id:"quote", line:() => "I am filing at six and I have nothing on the record. Give me one line I can print.",
      asks:[
        {t:"Give them a real line", tone:"open", say:"You can print this: I will vote the way I told my district I would.",
         reply:"Good. That is usable. I will not dress it up.", w:5, trust:8, mem:"You gave me something printable when you did not have to.", mw:5},
        {t:"Give them nothing", tone:"cold", say:"Nothing on the record today.",
         reply:"Then I write it without you, and you will not enjoy the shape of it.", w:-4, trust:-6, mem:"You had nothing for me and made me stand there for it.", mw:-4},
        {t:"Trade it for what they know", tone:"sharp", say:"You first. What are you hearing about the count?",
         reply:"Fine. I am hearing the count is softer than the whips are saying. Now give me my line.", w:2, trust:2, learn:true, mem:"You made me pay for it. I respect that and I resent it.", mw:2}
      ]});
  }
  if(m.kind === "civ" && !m.chamber && !m.hh){
    out.push({id:"cause", line:() => "I have taken a day off work to stand in this building about " + m.cause + ". Are you going to look at it or not?",
      asks:[
        {t:"Promise to look at it", tone:"open", say:"Send it to my office and I will read it myself.",
         reply:"People say that. Write it down in front of me and I will believe you.", w:8, app:2, mem:"You said you would read it and you looked at me while you said it.", mw:7},
        {t:"Be honest about the odds", tone:"even", say:"I will read it. I cannot promise it goes anywhere this session.",
         reply:"That is the first honest thing anyone has said to me today.", w:5, app:1, mem:"You told me the truth instead of the nice version.", mw:6},
        {t:"Move them along", tone:"cold", say:"There is a process for this. My staff can point you at it.",
         reply:"There is always a process. It is never for us.", w:-9, app:-2, mem:"You handed me a process and walked off.", mw:-8}
      ]});
  }
  if(m.kind === "member"){
    if(b) out.push({id:"count", line:() => "Before you say anything else — where are you on " + b.title + "? I am being asked and I would rather answer honestly.",
      asks:[
        {t:"Tell them straight", tone:"open", say:"I will tell you exactly where I am, and you can do what you like with it.",
         reply:"Then I will carry that accurately. It is more than most give me.", w:6, mem:"You told me your position before I had to guess it.", mw:6},
        {t:"Keep it to yourself", tone:"even", say:"I am not saying yet. You will hear it on the floor with everyone else.",
         reply:"That is your right. It is also how people end up counted wrong.", w:-2, mem:"You would not tell me where you stood.", mw:-2},
        {t:"Ask for theirs first", tone:"sharp", say:"You go first. Where are you?",
         reply:"Ha. All right — I am closer to no than the whips think. Now you.", w:2, learn:true, mem:"You made me show my hand first.", mw:1}
      ]});
    if(t && t.w < 0) out.push({id:"grievance", line:() => "Since you are standing there — " + t.t.toLowerCase().replace(/\.$/, "") + ". I have not forgotten it and I am not going to pretend I have.",
      asks:[
        {t:"Apologise properly", tone:"open", say:"You are right, and I am sorry. It was mine and I will not do it again.",
         reply:"…All right. That is not nothing. Do not make me regret taking it.", w:12, mem:"You apologised without being made to, and you meant it.", mw:10, heal:true},
        {t:"Explain yourself", tone:"even", say:"I had a reason. You may not like it, but you should hear it.",
         reply:"I will hear it. It does not un-happen, but I will hear it.", w:4, mem:"You explained yourself rather than ducking me.", mw:3},
        {t:"Refuse to give ground", tone:"cold", say:"I would do the same thing again.",
         reply:"Then we understand each other exactly, and I will act accordingly.", w:-12, mem:"You stood there and told me you would do it again.", mw:-12, storm:true}
      ]});
    if(m.rel.debtFromYou) out.push({id:"debt", line:() => "I owe you. I would like to settle it before it turns into something either of us can hold over the other.",
      asks:[
        {t:"Call it in now", tone:"sharp", say:"Then vote with me on the next one and we are square.",
         reply:"Done. I do not like being reminded, but done.", w:-2, pledge:true, clear:true, mem:"You called it in the moment you could.", mw:-2},
        {t:"Let it stand", tone:"open", say:"Keep it. I would rather have you than the favour.",
         reply:"That is either very kind or very clever. I will assume kind.", w:10, mem:"You let a debt stand rather than spend it on me.", mw:9},
        {t:"Ask for something smaller", tone:"even", say:"Tell me one thing you know that I do not.",
         reply:"Fine. And then we are square.", w:3, learn:true, clear:true, mem:"You took information instead of a vote.", mw:2}
      ]});
    if(rival) out.push({id:"warning", line:() => "A word, and then you can say whatever you came to say. " + surname(rival.name) + " has been asking questions about you. I thought you should hear it from somebody who is not enjoying it.",
      asks:[
        {t:"Thank them and mean it", tone:"open", say:"That is a real favour. I will remember who told me.",
         reply:"See that you do. I did not have to say anything.", w:8, mem:"I warned you about " + surname(rival.name) + " and you took it properly.", mw:7},
        {t:"Ask what they wanted", tone:"even", say:"What were they asking, exactly?",
         reply:"Where you were on the last three votes, and who paid for your last campaign. Draw your own conclusions.", w:4, learn:true, mem:"You wanted the detail. Sensible.", mw:3},
        {t:"Shrug it off", tone:"cold", say:"Let them ask. There is nothing to find.",
         reply:"There is always something to find. Suit yourself.", w:-3, mem:"I stuck my neck out to warn you and you waved it away.", mw:-4}
      ]});
    out.push({id:"home", line:() => "Can I be honest? " + m.state + " " + m.dist + " is not going well for me. I won by " + m.margin + " and I will not do that twice.",
      asks:[
        {t:"Ask what would actually help", tone:"open", say:"What would actually help? Not a speech — a thing.",
         reply:"Money for the crossing, and somebody senior standing next to me when I announce it.", w:9, mem:"You asked what would help instead of telling me what to do.", mw:8},
        {t:"Offer to go and stand there", tone:"open", say:"I will come and stand next to you when you need it.",
         reply:"You may regret offering. I am going to hold you to it.", w:11, owe:true, mem:"You offered to come to my district before I asked.", mw:10},
        {t:"Point out it is their own doing", tone:"cold", say:"You voted for the thing that did that to them.",
         reply:"…Yes. Thank you for coming by.", w:-11, mem:"I told you I was in trouble and you told me it was my fault.", mw:-11, storm:true}
      ]});
    out.push({id:"personal", line:() => "I have been in this building for eleven days without going home. I do not know why I am telling you that.",
      asks:[
        {t:"Say something human back", tone:"open", say:"Nobody in here is well. You are just the one who said it out loud.",
         reply:"…Right. Yes. Thank you.", w:10, mem:"You said something human to me on a bad day.", mw:9},
        {t:"Ask about home", tone:"open", say:"Who is at home?",
         reply:"A daughter who is fifteen and has stopped asking when I am back. Anyway.", w:12, mem:"You asked about my family and listened to the answer.", mw:11},
        {t:"Bring it back to business", tone:"cold", say:"Well. About the vote —",
         reply:"Of course. The vote.", w:-7, mem:"I told you something true and you went straight back to the count.", mw:-7}
      ]});
  }
  const used = m.usedThreads || (m.usedThreads = []);
  const open = out.filter(x => used.indexOf(x.id) < 0);
  return open.length ? open : null;
}

/* ── the beats ─────────────────────────────────────────────
   Nought: they have opened with their own business.
   One: you have answered and they have said what that did.
   Two: it is dealt with, and now they will talk about yours. */
function convStart(m){
  TALK.beat = 0;
  TALK.thread = null;
  const pool = threadsFor(m);
  if(!pool){ TALK.beat = 2; return null; }
  if(!chance(m.kind === "member" ? 0.82 : 0.95)){ TALK.beat = 2; return null; }
  /* and not the same kind of conversation twice running */
  const varied = pool.filter(x => x.id !== TALK.lastThread);
  const th = pick(varied.length ? varied : pool);
  TALK.lastThread = th.id;
  TALK.thread = th;
  (m.usedThreads = m.usedThreads || []).push(th.id);
  return th;
}
function convAnswer(m, ask){
  const th = TALK.thread;
  if(!th || TALK.beat !== 0) return;
  TALK.beat = 1;
  spend(rint(8, 16), 2);
  appendMsg("you", ask.say);
  ripple(m, ask.w || 0, ask.mem, ask.mw || 0);
  if(ask.trust !== undefined) m.trust = clamp((m.trust || 50) + ask.trust, 0, 100);
  if(ask.app) G.you.approval = clamp(G.you.approval + ask.app, 0, 100);
  if(ask.pledge){ m.pledge = true; m.sway = (m.sway || 0) + 14; }
  if(ask.clear) m.rel.debtFromYou = 0;
  if(ask.owe) m.rel.debtToThem = (m.rel.debtToThem || 0) + 1;
  if(ask.heal && m.mem) m.mem.forEach(e => { if(e.w < 0) e.w *= 0.55; });
  let extra = "";
  if(ask.learn){
    const other = pick(G.members.filter(x => x !== m && !x.gone));
    if(other){
      other.known = Math.max(other.known || 0, 1);
      extra = " " + surname(other.name) + " is " + (moodOf(other).val > 0 ? "gettable" : "nowhere near you") + " on this, for what it is worth.";
    }
  }
  const said = fresh(() => ask.reply + extra + (chance(0.3) ? " " + reachFor(m) : ""));
  TALK.tell = convTell(m);
  appendMsg("them", said, surname(m.name));
  setSay(said, fx(ask.w > 0 ? "that landed" : "", ask.w < 0 ? "that cost you" : ""));
  /* push them far enough and they simply go */
  if(ask.storm && moodOf(m).val < -20){
    feed(surname(m.name) + " walks off mid-sentence.");
    note(m.name + " walked away from you.", true);
    setTimeout(() => { if(TALK.m === m) closeTalk(); }, 60);
    return;
  }
  /* one follow-up beat, then their business is done */
  TALK.followUp = fresh(() => pick([
    "Anyway. You came here for something.",
    "Right. What did you actually want?",
    "That is my half of it. Go on, then.",
    "Enough of mine. Yours.",
    "I have said my piece. Say yours."
  ]));
}
function convClear(m){
  TALK.beat = 2;
  spend(4, 1);
  if(TALK.followUp){ TALK.tell = convTell(m); appendMsg("them", TALK.followUp, surname(m.name)); setSay(TALK.followUp, ""); TALK.followUp = null; }
  renderTalk();
}

function openTalk(m){
  if(!G.running || G.over) return;
  TALK.open = true; TALK.m = m; TALK.seq = (TALK.seq || 0) + 1;   /* 20261030b: one token per open; every delayed line checks it */
  try{ const Gs = goalsEnsure(); if(Gs && m && m.kind === "member" && Gs.talked.indexOf(m.id) < 0) Gs.talked.push(m.id); }catch(e){}
  try{
    if(G.whip && m && G.whip.id === m.id){ G.whip = null; feed("You found " + surname(m.name) + ". Make the ask."); }
    const Gs = G.goals;
    if(Gs && m && m.kind === "member" && G.bill && !G.bill.done){
      let v = 0; try{ v = memberVote(m, G.bill) > 0 ? 1 : -1; }catch(e){}
      if(v !== yourSide(G.bill)){ Gs.whipped = Gs.whipped || []; if(Gs.whipped.indexOf(m.id) < 0) Gs.whipped.push(m.id); try{ achieve("whip"); }catch(e){} }
    }
  }catch(e){}
  el("talk").classList.add("is-open");
  el("talk").scrollTop = 0;
  try{
    ledgerEnsure(m);
    if(G.you) ledgerTell(G.you, m, "You came to me.");
    hereNow().forEach(o => {
      if(!o || o === m) return;
      if(Math.random() < 0.22) ledgerOwn(o, "I saw " + surname(m.name) + " talking in here.");
    });
  }catch(e){}
  try{
    const hold = sentBusy(m);
    if(hold){
      m.met = true;
      setSay(hold, "");
      showChat(m);
      appendMsg("them", hold, surname(m.name));
      renderTalk();
      return;
    }
  }catch(e){}
  try{
    if(m.kind === "envoy"){
      m.met = true;
      const realm = realmOf(m.realm);
      const line = pick([
        "I am not here to count with you. " + ((realm && realm.capital) || m.state) + " has its own hour.",
        "Does this House continue when I am not looking? I am asking as a person, not as a mission.",
        "Your whip is not a country. I have seen one."
      ]);
      setSay(line, "");
      showChat(m);
      appendMsg("them", line, surname(m.name));
      renderTalk();
      return;
    }
  }catch(e){}
  try{
    const a = agiEnsure(m);
    if(a && a.verdict === "kin"){
      m.met = true;
      const line = pick([
        "I cannot tell what you are, and I am not going to make a scene of that.",
        "You are getting through a day. So am I. That is all I am giving it."
      ]);
      setSay(line, "");
      showChat(m);
      appendMsg("them", line, surname(m.name));
      renderTalk();
      return;
    }
    if(a && a.verdict === "open" && a.q < 2){
      m.met = true;
      const q = agiTestQuestion(m);
      a.q++; a.lastQ = q;
      setSay(q, "");
      showChat(m);
      appendMsg("them", q, surname(m.name));
      renderTalk();
      return;
    }
  }catch(e){}
  /* What they actually say: whatever is on their mind, and often a
     digression where they reach for the thing they cannot name. The
     transcript holds only their words. How they carry it is your read,
     and goes in the read panel, never in their mouth. */
  TALK.tell = convTell(m);
  const line = fresh(() => {
    let l = String(convHook(m) || "").trim();
    if(l){ l = cap(l); if(!/[.!?…"”]$/.test(l)) l += "."; }
    if(!m.met) l = "I do not think we have met properly. " + l;
    if(chance(0.6)) l += " " + reachFor(m);
    return l;
  });
  /* if they came looking for you, they lead with it */
  if(m.wantsWord){
    const q = m.wantsWord;
    m.wantsWord = null;
    m.met = true;
    setSay(q.line + " " + q.mail.body.split("\n")[0], "");
    renderTalk();
    showChat(m);
    const box = el("tkActs");
    (q.mail.options || []).forEach(o => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "talk__btn";
      b.innerHTML = o.t;
      b.addEventListener("click", () => {
        spend(10, 3);
        if(o.run) o.run();
        setSay("“" + o.t + "”", fx("answered to their face",""));
        note("Answered " + m.name + " in person.");
        renderTalk(); refreshPanels();
      });
      if(box) box.insertBefore(b, box.firstChild);
    });
    return;
  }
  m.met = true;
  const th = convStart(m);
  if(th){
    const lead = fresh(() => th.line());
    setSay(line + " " + lead, "");
    showChat(m);
    appendMsg("them", line + " " + lead, surname(m.name));
  } else {
    setSay(line, "");
    showChat(m);
    appendMsg("them", line, surname(m.name));
  }
  renderTalk();
}
/* The bar is one element that lives in two places. */
function wireInto(after){
  const w = el("wire");
  if(!w || !after || after.nextSibling === w) return;
  w.classList.add("wire--in");
  if(after && after.parentNode) after.parentNode.insertBefore(w, after.nextSibling);
}
function wireHome(){
  const w = el("wire"), home = el("wireHome");
  if(!w || !home || w.parentNode === home.parentNode && w.previousSibling === home) return;
  w.classList.remove("wire--in");
  if(home && home.parentNode) home.parentNode.insertBefore(w, home.nextSibling);
}
/* 20261030b: narration in the transcript reads as narration, the second voice of a huddle reads as a second voice */
function tkNarr(text){ try{ const log = el("chatLog"); if(!log) return null; const d = document.createElement("div"); d.className = "msg msg--narr"; d.textContent = text; log.appendChild(d); log.scrollTop = log.scrollHeight; countLog(); return d; }catch(e){ return null; } }
function tkHud(span){ try{ if(span && span.parentNode) span.parentNode.classList.add("msg--huddle"); }catch(e){} return span; }
/* walking up to two people mid-sentence puts you in their conversation: you hear what they were saying, and the other one stays and answers too */
function huddleSay(o, first){
  try{
    const b = G.bill && !G.bill.done ? G.bill : null;
    if(b && o.pos && b.pos){
      const ax = AXES.slice().sort((x, y) => Math.abs(b.pos[y.k] || 0) - Math.abs(b.pos[x.k] || 0))[0], dir = (b.pos[ax.k] || 0) > 0 ? 1 : -1, aye = memberVote(o, b) > 0;
      const bank = DK_READ[ax.k] && DK_READ[ax.k][dir] && DK_READ[ax.k][dir][aye ? "for" : "against"];
      if(bank){ const r = rng(seedOf("hd:" + o.id + ":" + (TALK.huddle ? TALK.huddle.said : 0) + b.title)); return (first ? "Since you are here, I will say it to your face. " : "And since you ask: ") + "I am " + (aye ? "with" : "against") + " the " + b.title.split(" ").slice(0, 3).join(" ") + ", because " + bank[Math.floor(r() * bank.length)] + "."; }
    }
    return (first ? "Since you are here: " : "") + cap(String(convHook(o) || "I have been wondering what you make of all this.").trim());
  }catch(e){ return "Since you are here, I would like to hear what you think."; }
}
{ const _openTalk = openTalk, _appendMsg = appendMsg, _closeTalk = closeTalk;
  openTalk = function(m){
    TALK.huddle = null;
    try{ const h = m && m._huddle; if(h && G.running && G.t - h.t < 30){ const oid = h.a === m.id ? h.b : h.a, o = byId(oid);
      if(o && !o.gone && o.room === m.room && Math.hypot(o.x - m.x, o.z - m.z) < 4.5) TALK.huddle = {o, h, said:0}; } }catch(e){}
    const r = _openTalk.apply(this, arguments);
    try{ if(m && TALK.open && m.traits && m !== G.you && m.kind !== "envoy" && chance(0.35)){ const kl = kinLine(m), sq0 = TALK.seq; setTimeout(() => { if(TALK.open && TALK.m === m && TALK.seq === sq0) _appendMsg("them", kl, surname(m.name)); }, 1400); } }catch(e){}
    try{ const H = TALK.huddle; if(H && TALK.open){
      const L = H.h.lines.slice(0, 2).map(x => x[0] + ": \u201c" + x[1] + "\u201d").join("  ");
      tkNarr("You step into the conversation between " + m.name + " and " + H.o.name + ". They had been saying: " + L);
      setTimeout(() => { if(TALK.open && TALK.huddle === H){ tkHud(_appendMsg("them", huddleSay(H.o, true), surname(H.o.name))); H.said++; } }, 1800);
      /* 20261030b: the "with" pin is drawn by renderTalk (NEPTUNE-TALKREWORK), so the meta chips survive */
    } }catch(e){}
    return r;
  };
  appendMsg = function(kind){
    const r = _appendMsg.apply(this, arguments);
    try{ const H = TALK.huddle; if(kind === "you" && H && TALK.open && H.said < 3){ H.said++; setTimeout(() => { if(TALK.open && TALK.huddle === H) tkHud(_appendMsg("them", huddleSay(H.o, false), surname(H.o.name))); }, 1700); } }catch(e){}
    return r;
  };
  closeTalk = function(){ TALK.huddle = null; return _closeTalk.apply(this, arguments); };
}
function closeTalk(){
  const who = TALK.m;
  TALK.open = false; TALK.m = null; TALK.prop = null; TALK.seq = (TALK.seq || 0) + 1;
  TALK.thread = null; TALK.beat = 2; TALK.followUp = null; TALK.seed = undefined; TALK.tell = "";
  el("talk").classList.remove("is-open");
  try{ if(who) feelHit(who, "relief", "they left"); }catch(e){}
  wireHome();
  refreshPanels();
}

function setSay(t, n){ el("tkSay").textContent = t; el("tkNote").innerHTML = n || "";
  try{ if(t && TALK.m) tlog(TALK.m.name || "", t, "talk"); }catch(e){} }
function chipFor(m){
  const c = m.party==="FED" ? "fed" : m.party==="COM" ? "com" : "ind";
  let pp = null; try{ pp = m.kind === "civ" ? polEnsure(m) : null; }catch(e){}
  const t = m.kind==="press" ? "Press" : m.kind==="envoy" ? "Envoy" : m.kind==="civ" ? (pp ? (pp.nonpartisan ? "Nonpartisan" : partyLabel(pp.party)) : "Public") : partyLabel(m.party);
  return '<span class="chip chip--'+c+'">'+t+'</span>';
}
function tiny(label, v, lo, hi, col){
  return '<div class="tiny"><i>'+label+'</i><span><b style="width:'+clamp((v-lo)/(hi-lo)*100,0,100)+'%;background:'+col+'"></b></span></div>';
}
function fx(good, bad){
  const p = [];
  if(good) p.push("<b>"+good+"</b>");
  if(bad) p.push("<u>"+bad+"</u>");
  return p.join("   ");
}
function renderTalk(){
  const m = TALK.m; if(!m) return;
  el("tkName").textContent = m.name;
  const bits = [chipFor(m)];
  if(m.kind === "member" && m.rel){
    const n = clamp(Math.round(((m.rel.warmth||0) + 40) / 20), 0, 5);
    bits.push('<span class="hearts">' + "♥".repeat(n) + "♡".repeat(5-n) + "</span>");
    try{ bits.push('<span class="pin">net · ' + netRead(m) + '</span>'); }catch(e){}
    try{ if(m.cog && m.cog.want) bits.push('<span class="pin">want · ' + m.cog.want.k + '</span>'); }catch(e){}
    try{ if(m.machine) bits.push('<span class="pin">sanctioned</span>'); }catch(e){}

    try{ if(m.will && m.will.k) bits.push('<span class="pin">will · ' + m.will.k + '</span>'); }catch(e){}
    try{ if(m.soul && m.soul.good) bits.push('<span class="pin">soul</span>'); }catch(e){}
  }
  if(m.kind === "member"){
    if(m.post) bits.push('<span class="pin pin--post">'+postTitle(m.post)+'</span>');
    bits.push("<span><span"+tipAttr("state",m.state)+">"+m.state+"</span> "+m.dist+"</span><span>·</span><span>"+m.bg+"</span>");
    bits.push(m.kind === "envoy" ? "<span>·</span><span>envoy, not elected</span>" : "<span>·</span><span>term "+m.terms+", won by "+m.margin+"</span>");
    bits.push('<span class="pin">'+creedOf(m.creed).adj+'</span><span class="pin">'+originOf(m.origin).adj+'</span>');
    if(m.rel.debtFromYou) bits.push('<span class="pin pin--debt">owes you '+m.rel.debtFromYou+'</span>');
    const tl = tieLine(m);
    if(tl) bits.push('<span class="pin pin--ally">' + tl + '</span>');
  } else if(m.kind === "envoy"){
    bits.push("<span>Envoy of " + (m.state || "a foreign sitting") + "</span><span>·</span><span>not a vote</span>");
  } else if(m.kind === "press"){
    bits.push("<span>"+m.role+", "+m.outlet+"</span>", "<span>·</span><span>trusts you "+Math.round(m.trust)+"%</span>");
  } else {
    const pp2 = (function(){ try{ return polEnsure(m); }catch(e){ return null; } })();
    if(pp2){ bits.push('<span class="pin pin--post">' + (POL_ROLE[m.krole] || pp2.title) + '</span>', "<span><span" + tipAttr("state", pp2.state) + ">" + pp2.state + "</span></span>", "<span>·</span><span>" + pp2.line + "</span>"); if(pp2.bg && m.krole === "senator") bits.push("<span>·</span><span>" + pp2.bg + "</span>"); }
    else bits.push("<span>"+m.role+" · "+m.cause+"</span>");
  }
  const ears = listenerLine(m);
  if(ears) bits.push('<span>·</span>', ears);
  el("tkMeta").innerHTML = bits.join("");
  const mood = moodOf(m);
  const rdx = readOf(m), pres = presentOf(m);
  const mt = el("tkMood");
  let here = "";
  try{
    sentEnsure(m);
    if(m.sent) here = m.sent.awake < 0.28 ? "elsewhere" : (m.sent.awake > 0.72 ? "here" : "half here");
  }catch(e){}
  mt.textContent = (here ? here + " · " : "") + pres.label;
  mt.style.color = "var(--ink-2)";
  el("tkBars").innerHTML = "";
  const th = el("tkThink");
  if(m.kind === "member"){
    th.hidden = false;
    th.innerHTML = "<b>" + (canRead(m) ? "How you read them" : "Hard to read") + "</b>";
    const span = document.createElement("span");
    span.textContent = (TALK.tell ? TALK.tell + " " : "") + (canRead(m)
      ? cap(pres.label) + "."
      : "You do not know " + surname(m.name) + " well enough to tell what is under it.");
    th.appendChild(span);
    /* The net thinks. It does not put a bar on the table. */
  } else th.hidden = true;
  const box = el("tkActs"); box.innerHTML = "";
  actionsFor(m).forEach(a => {
    const b = document.createElement("button");
    b.type = "button";
    b.className = "talk__btn" + (a.risk?" talk__btn--risk":"") + (a.exit?" talk__btn--exit":"");
    b.innerHTML = a.t + (a.c ? "<u>"+a.c+"</u>" : "");
    b.disabled = !!a.off;
    b.addEventListener("click", () => { a.run(); if(!a.exit && !a.noReact) dtcnoReact(m); if(TALK.open) renderTalk(); refreshPanels(); });
    box.appendChild(b);
  });
}
function actionsFor(m){
  /* They asked you something. Until you answer it, there is nothing else
     on offer — you cannot buy a vote off somebody who is mid-sentence. */
  if(TALK.thread && TALK.beat === 0){
    return TALK.thread.asks.map(a => ({
      t:a.t, c:"a few minutes", risk:a.tone === "cold",
      run(){ convAnswer(m, a); if(TALK.open) renderTalk(); refreshPanels(); }
    })).concat([{t:"Say nothing and leave", c:"", exit:true, run(){
      ripple(m, -5, "You stood there while I was talking and then left.", -5);
      feed("You leave " + surname(m.name) + " mid-sentence.");
      closeTalk();
    }}]);
  }
  if(TALK.thread && TALK.beat === 1){
    return [{t:"Let it sit, and get to why you came", c:"5m", run(){ convClear(m); refreshPanels(); }}];
  }
  if(m.kind === "press") return pressActions(m);
  if(m.kind === "civ") return civActions(m);
  return memberActions(m);
}

/* ══════════════════════════════════════════════════════════
   11b · THE ROOM ITSELF
   Fittings you can work: the desk, the rostrum, the urn.
   ══════════════════════════════════════════════════════════ */
function swayRoom(dir, power, reach){
  const hit = [];
  G.members.forEach(m => {
    const near = m.room === G.room;
    if(!near && !reach) return;
    const stubborn = m.traits.conviction/100;
    const d = Math.round(power * (near?1:0.45) * (1 - stubborn*0.6));
    if(d <= 0) return;
    m.sway = (m.sway||0) + dir*d;
    hit.push(m);
  });
  return hit;
}
/* ── Podium / speech-station quick lines (on-glass #prompt) ── */
const SPEECH_STATION_IDS = {
  caucus:["lectern"],
  committee:["dais","well"],
  floor:["rostrum","lectern"],
  press:["podium"],
  steps:["stump"]
};
const SPEECH_KIND = {caucus:"caucus", committee:"hearing", floor:"floor", press:"press", steps:"stump"};
function speechBeats(kind){
  const bill = (G.bill && G.bill.title) ? G.bill.title : null;
  /* Thematic ordered pools: Deliver sorts by `order` so caught pieces form one coherent speech. */
  const pool = {
    floor:[
      {order:1, t:"Open the record", line:"Mr Speaker, I rise because this House still owes the country a clean question and a recorded answer.", stance:1, mins:10},
      {order:2, t:"Name the cost", line:"Put a number on the cost of delay, or do not ask this chamber to vote for a story.", stance:1, mins:11},
      {order:3, t:"District watching", line:"I speak for a district that will read this vote aloud in October, and I will not apologise for that.", stance:1, mins:10},
      {order:4, t:"Refuse the smear", line:"I will not answer a smear dressed as a question. Put a fact in it and I will answer.", stance:1, mins:9},
      {order:5, t:"Concede nothing", line:"I yield no premise. If the other side wants a fight on the numbers, they may have one on the floor.", stance:1, mins:11},
      {order:6, t:"Hold who delayed", line:"I want the record to show who asked for delay and who asked for a decision.", stance:1, mins:10},
      {order:7, t:"Courage line", line:"The House was not built to wait on courage. Put the question and let the record show who stood.", stance:1, mins:12},
      {order:8, t:"Bill on the table", line:"We have had the briefings. We have had the corridor. What we have not had is a vote this chamber can defend.", stance:1, mins:11},
      {order:9, t:"No soft ending", line:"Do not give me a soft ending. Give me a division and a name against each column.", stance:1, mins:10},
      {order:10, t:"Time enough", line:"Five minutes is enough when the case is clean and the country already knows the cost of waiting.", stance:0, mins:9},
      {order:11, t:"Reclaim if twisted", line:"I will sit when the question is put — and I will reclaim the floor the moment this text is twisted out of shape.", stance:0, mins:8},
      {order:12, t:"October test", line:"If you cannot explain this vote on a doorstep, do not ask me to carry it for you in silence.", stance:1, mins:10},
      {order:13, t:"Close the loop", line:"Mr Speaker, call the question. The district is watching, and so is the record.", stance:1, mins:9},
      {order:14, t:"Thank and press", line:"I thank the chair. Press the vote. Let us be counted.", stance:1, mins:8},
      {order:15, t:"Stand on it", line:"That is my speech. I will be in my place when the bells ring.", stance:1, mins:8}
    ],
    hearing:[
      {order:1, t:"Open under oath", line:"Madam Chair, before we leave this room I want it on the record: the numbers we just heard are not both true.", stance:1, mins:12},
      {order:2, t:"Pin the witness", line:"Under oath: who told you to bring that figure, and when?", stance:1, mins:11},
      {order:3, t:"District not polite", line:"My district does not send me here to be polite to a witness who will not answer a plain question.", stance:1, mins:10},
      {order:4, t:"Read it back", line:"Read the last answer back. That is not what the submission says.", stance:1, mins:10},
      {order:5, t:"No soft ending", line:"I will not accept that answer as complete. Try again, under oath, without the soft ending.", stance:1, mins:11},
      {order:6, t:"Who wrote it", line:"Who wrote the paragraph you are leaning on, and did they sit where you are sitting when they wrote it?", stance:1, mins:10},
      {order:7, t:"Checkable line", line:"Give me one sentence we can check against the papers, not a performance for the cameras.", stance:1, mins:9},
      {order:8, t:"Second round", line:"I will come back for a second round when the staff brief is finished, and I expect the same oath.", stance:0, mins:8},
      {order:9, t:"Record the gap", line:"The record should show the gap between what was promised and what was delivered today.", stance:1, mins:10},
      {order:10, t:"No notice dodge", line:"Taking it on notice is not an answer. It is a postponement of the truth.", stance:1, mins:9},
      {order:11, t:"Name the date", line:"Name the date of the meeting, the people in the room, and the instruction you left with.", stance:1, mins:11},
      {order:12, t:"Public can read", line:"The public can read a transcript. Write one they will not have to decode.", stance:0, mins:9},
      {order:13, t:"Thank for a fact", line:"I thank the chair for the time, and I thank the witness for finally saying something we can check.", stance:0, mins:9},
      {order:14, t:"Hold the oath", line:"Hold to the oath. The rest of this hearing is decoration without it.", stance:1, mins:8},
      {order:15, t:"Close the pin", line:"That is the question I came to ask. I will wait for a complete answer.", stance:1, mins:8}
    ],
    caucus:[
      {order:1, t:"Together or not", line:"We go in together or we do not go in. That is the whole speech.", stance:1, mins:10},
      {order:2, t:"Say it now", line:"If your district cannot wear this, say so now — not on the floor when the cameras are rolling.", stance:1, mins:12},
      {order:3, t:"Count the room", line:"Look around. If we leave this room split, the floor will finish us.", stance:1, mins:10},
      {order:4, t:"No corridor whip", line:"I will take a whip count that is honest. I will not take one written for the corridor.", stance:1, mins:11},
      {order:5, t:"Concede nothing", line:"I am not here to split the difference with people who have already decided to walk.", stance:1, mins:11},
      {order:6, t:"Defend at home", line:"I will not sit quiet when the whip asks for a vote nobody can defend at home.", stance:1, mins:9},
      {order:7, t:"Keep it short", line:"Keep it short. We have a chamber to face before the afternoon is gone.", stance:0, mins:8},
      {order:8, t:"One message", line:"One message leaves this room. Two messages is how we lose the first hour on the floor.", stance:1, mins:10},
      {order:9, t:"Name the dissent", line:"If you dissent, put your name on it in here so we are not surprised out there.", stance:0, mins:10},
      {order:10, t:"Walk with us", line:"Walk with us on the opening, and we will protect your district language in the text.", stance:1, mins:11},
      {order:11, t:"No phone caucus", line:"Stop checking the phones. The vote is in this room before it is anywhere else.", stance:1, mins:9},
      {order:12, t:"Floor will smell fear", line:"The floor can smell a divided caucus before the Speaker finishes the title.", stance:1, mins:9},
      {order:13, t:"Hold the line", line:"Hold the line we agreed, or say clearly that you never agreed.", stance:1, mins:10},
      {order:14, t:"Thank and move", line:"Thank you. That is enough talk. Move as one or do not move.", stance:1, mins:8},
      {order:15, t:"Door test", line:"When we open that door, we are either a party or a rumour. Choose.", stance:1, mins:8}
    ],
    press:[
      {order:1, t:"Hard question once", line:"Ask the hard question once. I will answer it once. Then we can talk about everything else.", stance:1, mins:12},
      {order:2, t:"One clean line", line:"You get one clean line from me. The rest you invent at your own risk.", stance:1, mins:9},
      {order:3, t:"Write the district", line:"Write down the district, not the corridor. That is where this lands.", stance:1, mins:10},
      {order:4, t:"Refuse the premise", line:"I will not take the premise. Rephrase it without the smear and I will give you a line.", stance:1, mins:11},
      {order:5, t:"On the record", line:"On the record: I have read the bill and I know how I am voting.", stance:1, mins:10},
      {order:6, t:"Statement stands", line:"You have the statement. The colour you add after I leave is your business, not mine.", stance:0, mins:8},
      {order:7, t:"Building is open", line:"The building is open; the record is not optional. Quote what I said, not what you wished I said.", stance:1, mins:9},
      {order:8, t:"No fishing", line:"I am not here for a fishing expedition. Ask about the vote or ask about the text.", stance:1, mins:9},
      {order:9, t:"Cameras cold", line:"The cameras are cold; the district is not. Write for the people who live with the outcome.", stance:0, mins:10},
      {order:10, t:"Same line tomorrow", line:"I will give you the same line tomorrow that I gave you today. Consistency is not a dodge.", stance:1, mins:9},
      {order:11, t:"Name the bill clean", line:"If you name the bill, name what it does. Headlines that skip the mechanism are not reporting.", stance:1, mins:10},
      {order:12, t:"Off-record refuse", line:"I will not go off the record to make your piece easier. On the record is the point of a lectern.", stance:1, mins:9},
      {order:13, t:"Thank for coming", line:"Thank you for coming. Take the line clean and leave the invention for the column.", stance:0, mins:8},
      {order:14, t:"Close the mic", line:"That is all from me. You have what you need for a fair piece.", stance:0, mins:8},
      {order:15, t:"Hold me to it", line:"Hold me to the next sentence. That is the whole point of standing here.", stance:1, mins:8}
    ],
    stump:[
      {order:1, t:"Did not whisper", line:"I did not come home to whisper. I came to say what I voted and why I will vote it again.", stance:1, mins:14},
      {order:2, t:"Home first", line:"I answer to this step before I answer to the capital.", stance:1, mins:12},
      {order:3, t:"Name home", line:"This is home. If the capital forgot that, I have not.", stance:1, mins:12},
      {order:4, t:"No apology", line:"I will not apologise for a vote I can still explain on this step.", stance:1, mins:10},
      {order:5, t:"Say the vote", line:"I will say the vote out loud. If you dislike it, vote me out — do not ask me to lie about it.", stance:1, mins:11},
      {order:6, t:"Cost in plain words", line:"Here is the cost in plain words: who pays, who waits, and who walks away clean.", stance:1, mins:11},
      {order:7, t:"One more question", line:"I will take one more question — and then I am going back to work.", stance:0, mins:9},
      {order:8, t:"Cameras and district", line:"Thank you for standing out here. The cameras are cold; the district is not.", stance:0, mins:8},
      {order:9, t:"Doorstep test", line:"If I cannot say it on a doorstep, I should not have said it in the chamber.", stance:1, mins:10},
      {order:10, t:"Same speech both places", line:"You get the same speech I gave under the dome. I will not run two versions of myself.", stance:1, mins:10},
      {order:11, t:"Listen then answer", line:"I will listen to the hard question from the front row, and I will answer it without a consultant's gloss.", stance:1, mins:11},
      {order:12, t:"Work after the cheer", line:"Cheering is fine. The work is the vote, the call, and the follow-through after I leave this step.", stance:1, mins:9},
      {order:13, t:"Hold me here", line:"Hold me to account here, where you can see my face, not only in a press release.", stance:1, mins:9},
      {order:14, t:"Close on the step", line:"That is why I voted as I did. Ask me again next month — I will still be able to say it.", stance:1, mins:10},
      {order:15, t:"Back to work", line:"Thank you. I am going back to work. Keep the receipt on what I promised.", stance:1, mins:8}
    ]
  };
  const base = (pool[kind] || pool.floor).slice();
  if(bill){
    base.push({order:8.5, t:"Name the bill", line:"On " + bill + ": I have read it, I know how I am voting, and I will say why where it counts.", stance:1, mins:13});
  }
  /* shuffle for catch variety; Deliver re-sorts by order */
  for(let i=base.length-1;i>0;i--){ const j = (Math.random()*(i+1))|0; const t=base[i]; base[i]=base[j]; base[j]=t; }
  return base.slice(0, Math.min(10, base.length));
}
function speechStationNear(maxDist){
  /* Literal stand only. Old 3.5–5.2 m treated the aisle as the lectern
     and auto-armed CATCH while you walked past. */
  maxDist = maxDist === undefined ? 0.72 : maxDist; maxDist = maxDist <= 1.85 ? maxDist : 0.85; /* 20261104bh: cap 1.85 (audience-side stand); was 1.15 — 20261104bf: catch zone reaches the 1.15 m hard.dist ring (lectern collider kept you >0.85) */
  const ids = SPEECH_STATION_IDS[G.room];
  if(!ids || !G.running) return null;
  const list = PROPS[G.room] || [];
  let best = null, bd = 1e9;
  for(const o of list){
    if(ids.indexOf(o.id) < 0) continue;
    const d = distToSpeechStand(o);
    if(d < bd && d <= maxDist){ bd = d; best = o; }
  }
  return best ? {prop:best, dist:bd, kind:SPEECH_KIND[G.room] || "floor"} : null;
}
function speechAnchorForRoom(room){
  const id = room || G.room;
  const prefer = {floor:["rostrum","lectern"], committee:["dais","well"], caucus:["lectern"], press:["podium"], steps:["stump"]}[id];
  if(!prefer) return null;
  const list = PROPS[id] || [];
  for(const pid of prefer){ const o = list.find(x => x.id === pid); if(o) return o; }
  return null;
}
function easeTowardSpeechStation(){
  /* Recognition is a prompt, not a teleport. Walking the aisle must not
     yank you onto the lectern. Press E at the stand when you mean it. */
  try{
    const a = speechAnchorForRoom(G.room);
    if(!a) return;
    const d = distToSpeechStand(a);
    if(d <= 0.72) return;
    setSay("The chair recognises you. Walk to the stand and press E.", fx("",""));
  }catch(e){}
}
function isSpeechStationProp(o){
  if(!o || !o.id) return false;
  const ids = SPEECH_STATION_IDS[G.room];
  return !!(ids && ids.indexOf(o.id) >= 0);
}
/* Speaking side = behind the stand from the audience (face the room). */
function speechStandPose(o){
  const R = ROOMS[G.room] || {w:10, d:12};
  const cx = 0, cz = R.d * 0.42;
  let ax = cx - o.x, az = cz - o.z;
  let len = Math.hypot(ax, az);
  if(len < 0.05){ ax = 0; az = -1; len = 1; }
  ax /= len; az /= len;
  /* Stand on the wall side of the prop (opposite audience) — "behind" the lectern */
  const stand = 0.95;
  let sx = o.x - ax * stand;
  let sz = o.z - az * stand;
  const b = roomBox(G.room);
  sx = clamp(sx, -b.hw, b.hw);
  sz = clamp(sz, b.d0, b.d1);
  /* Face the room / audience */
  const yaw = Math.atan2(ax, az);
  return {x:sx, z:sz, yaw:yaw};
}
function distToSpeechStand(o){
  if(!o) return 99;
  /* 20261104bh A1: min of wall-side pose, audience-side mirror, and prop centre —
     players address the House Floor rostrum from the audience side (z~13.4) */
  const pose = speechStandPose(o);
  let d = Math.hypot(cam.x - pose.x, cam.z - pose.z);
  try{
    const R = ROOMS[G.room] || {w:10, d:12};
    let ax = 0 - o.x, az = R.d * 0.42 - o.z, len = Math.hypot(ax, az);
    if(len < 0.05){ ax = 0; az = -1; len = 1; }
    ax /= len; az /= len;
    d = Math.min(d, Math.hypot(cam.x - (o.x + ax * 0.95), cam.z - (o.z + az * 0.95)), Math.hypot(cam.x - o.x, cam.z - o.z));
  }catch(e){}
  return d;
}
function atSpeechStand(o, slack){
  return distToSpeechStand(o) <= (slack == null ? 0.62 : slack);
}
function playerIsMoving(){
  return Math.hypot(cam.vx || 0, cam.vz || 0) > 0.55;
}
function approachSpeechStation(o){
  if(!o || !G.running || G.over) return;
  if(TALK.open) try{ closeTalk(); }catch(e){}
  /* Cap: max 2 at the well — refuse before stepping in */
  if(!lecternCapOpen(G.room)){
    const others = lecternOccupants(G.room).filter(x => !x.you);
    if(others.length >= 2){
      setSay("The well already has two up. Sit or wait your turn.", fx("","lectern full"));
      try{ setGlassPrompt("Well full — two already up", [
        {t:"Sit and wait", c:"E", run(){ try{ takeSeat(); }catch(e){} setSay("You take a seat. The well holds two.", fx("","")); }},
        {t:"Hold back", c:"—", run(){ setSay("You stay clear of the speaking area.", fx("","")); }}
      ]); }catch(e){}
      return;
    }
  }
  if(G.you && G.you.sitting){
    try{ riseFromSeat(); }catch(e){ G.you.sitting = false; }
  }
  const pose = speechStandPose(o);
  G.speechApproach = {x:pose.x, z:pose.z, yaw:pose.yaw, t:0.28, prop:o};
  cam.vx = cam.vz = 0;
  /* Arm CATCH so East Steps (and any station) can start stream after this interact — not from walk-by */
  CATCH.armedByInteract = true;
  CATCH.suppressed = false;
  try{
    setGlassPrompt("Step in — catch lines when you're at the stand", []);
  }catch(e){}
  setSay("You step behind the " + (o.label || "stand").toLowerCase() + ".", fx("",""));
  /* Do not openProp / TALK — catchFrame starts once in hard range (steps: only if armed) */
}
function tickSpeechApproach(dt){
  const a = G.speechApproach;
  if(!a) return;
  a.t -= dt;
  const k = a.t > 0 ? Math.min(1, 1 - a.t / 0.28) : 1;
  const ease = k * k * (3 - 2 * k);
  const step = Math.min(1, (0.55 + ease * 1.8) * dt);
  cam.x += (a.x - cam.x) * step;
  cam.z += (a.z - cam.z) * step;
  /* shortest yaw blend — modulo, not a decrement loop (see wrapPi): if
     a.yaw or cam.yaw is ever non-finite, a while-based wrap here spins
     forever with nothing to throw and nothing for frame()'s per-frame
     try/catch to catch. wrapPi already returns 0 for non-finite input. */
  const dy = wrapPi(a.yaw - cam.yaw);
  cam.yaw += dy * Math.min(1, (0.7 + ease * 1.4) * dt);
  cam.vx = cam.vz = 0;
  if(a.t <= 0 || Math.hypot(a.x - cam.x, a.z - cam.z) < 0.08){
    cam.x = a.x; cam.z = a.z; cam.yaw = a.yaw;
    G.speechApproach = null;
  }
}
function interactPropOrSpeech(o){
  if(!o) return;
  /* Table: open the prop (amend / career). Lectern / rostrum while seated:
     20261104bj rise and approach the stand so A1 catch / Press-E can arm —
     openProp here was blocking the walk-to-lectern path. */
  if(o.id === "table"){
    openProp(o);
    return;
  }
  if(isSpeechStationProp(o)) approachSpeechStation(o);
  else if(o.id === "desk" && G.room === "office" && G.you && !G.you.sitting){
    sitCasuallyAtDesk();
  }
  else if(G.room === "office" && (o.id === "pc" || (o.id === "desk" && G.you && G.you.sitting))){
    if(PC.open) pcClose(); else pcOpen();
  }
  else if(o.id === "amenDesk"){ if(!G.you.sitting) sitAtMyDesk(); else { if(PC.open) pcClose(); else pcOpen(); } }
  else openProp(o);
}
function deploySpeechBeat(beat, prop){
  if(!beat || !G.running) return;
  const mins = beat.mins || 12;
  spend(mins, Math.max(4, Math.round(mins * 0.45)));
  const line = beat.line;
  speak(null, line);
  appendFloor("You", line);
  feed("You: " + line);
  if(checkSpeakBlasphemy(line, "you")){ promptKey = ""; refreshPanels(); return; }
  const stance = beat.stance || 0;
  if(stance && G.bill && !G.bill.done){
    try{ swayRoom(stance, 3 + Math.abs(stance), false); }catch(e){}
  }
  if(stance){
    try{ G.you.standing = clamp(G.you.standing + stance, 0, 100); }catch(e){}
  }
  setSay(line, fx((mins) + "m at the " + (prop ? prop.label.toLowerCase() : "station"), ""));
  note("Spoke from the " + (prop ? prop.label.toLowerCase() : "podium") + ".");
  promptKey = ""; /* force prompt refresh */
}
function assembleSpeechText(pieces){
  if(!pieces || !pieces.length) return "";
  const sorted = pieces.slice().sort((a,b) => (a.order||0) - (b.order||0));
  const lines = sorted.map(p => (p.line || "").trim()).filter(Boolean);
  if(!lines.length) return "";
  /* Join into one coherent paragraph; keep sentence boundaries. */
  let out = lines[0];
  for(let i=1;i<lines.length;i++){
    const prev = out.replace(/\s+$/,"");
    const next = lines[i];
    if(/[.!?…]"?$/.test(prev)) out = prev + " " + next;
    else out = prev + ". " + next;
  }
  return out;
}
function deliverAssembledSpeech(){
  if(!CATCH.on) return;
  const hard = speechStationNear(3.5);
  if(!hard && !(CATCH.mode === "proc" && PROC.on && PROC.phase === "you")){
    setSay("Stay at the station to deliver.", fx("","step in"));
    return;
  }
  const pieces = (CATCH.pieces || []).slice();
  if(!pieces.length){
    setSay("Catch lines at the podium first — then Deliver for full credit.", fx("",""));
    return;
  }
  const prop = CATCH.prop || (hard && hard.prop) || null;
  const label = prop ? prop.label.toLowerCase() : "podium";
  const isProc = CATCH.mode === "proc";

  if(isProc){
    /* Run caught opts in order for regular PROC rewards (once through). */
    const sorted = pieces.slice().sort((a,b) => (a.order||0) - (b.order||0));
    const first = sorted[0];
    const combined = assembleSpeechText(sorted);
    CATCH.pieces = [];
    try{
      if(first && first.opt){
        /* One combined delivery: prefer full text via freeText if multi */
        if(sorted.length === 1) procYouSay(first.opt);
        else procYouSay(first.opt, combined);
      } else {
        procYouSay({t:"Delivered speech", say:combined, stand:2 + Math.min(4, sorted.length)}, combined);
      }
    }catch(e){}
    note("Delivered a speech pieced at the " + label + ".");
    catchClear("delivered");
    promptKey = "";
    refreshPanels();
    return;
  }

  const sorted = pieces.slice().sort((a,b) => (a.order||0) - (b.order||0));
  const full = assembleSpeechText(sorted);
  const n = sorted.length;
  const minsSum = sorted.reduce((s,p) => s + (p.mins||8), 0);
  const spendMins = Math.min(48, Math.max(8, Math.round(minsSum * 0.55)));
  const standGain = clamp(2 + n, 2, 14);
  const inflGain = clamp(1 + Math.floor(n / 2), 1, 8);
  let stanceNet = 0;
  sorted.forEach(p => { stanceNet += (p.stance||0); });
  const stanceAvg = n ? stanceNet / n : 0;
  const swayDir = stanceAvg >= 0.25 ? 1 : (stanceAvg <= -0.25 ? -1 : 0);

  spend(spendMins, Math.max(4, Math.round(spendMins * 0.4)));
  try{ G.you.standing = clamp((G.you.standing||50) + standGain, 0, 100); }catch(e){}
  try{ G.you.influence = clamp((G.you.influence||0) + inflGain, 0, 100); }catch(e){}
  if(swayDir && G.bill && !G.bill.done){
    try{ swayRoom(swayDir, 3 + Math.min(6, n), false); }catch(e){}
  }
  const spoken = full.length > 280 ? (full.slice(0, 277) + "…") : full;
  try{
    speak(null, spoken);
    appendFloor("You", full);
    feed("You: " + spoken);
  }catch(e){}
  if(checkSpeakBlasphemy(full, "you")){ CATCH.pieces = []; catchClear("blasphemy"); promptKey = ""; refreshPanels(); return; }
  setSay(spoken, fx("+" + standGain + " standing · +" + inflGain + " influence · " + spendMins + "m at the " + label, "full speech"));
  note("Delivered a speech pieced at the " + label + ".");
  CATCH.pieces = [];
  catchClear("delivered");
  promptKey = "";
  refreshPanels();
}
function penCannedSpeech(kind){
  const bill = (G.bill && G.bill.title) ? G.bill.title : "the bill before us";
  const home = (G.you ? (G.you.state + " " + G.you.dist) : "my district");
  const cans = {
    floor:"Mr Speaker, I have read " + bill + ". I know how I am voting, and I will not take longer than the case needs. Put the question; let the record show who stood for a decision and who asked for another hour of delay. I speak for " + home + ", and that is enough.",
    hearing:"Madam Chair, under oath I want a complete answer, not a soft ending. The numbers cannot all be true. My district did not send me here to be polite to a gap in the record. Finish the sentence so the papers can check it.",
    caucus:"We go in together or we do not go in. If your district cannot wear this, say so now — not on the floor. One message leaves this room. That is the whole speech.",
    press:"Ask the hard question once; I will answer it once. On the record: I have read the bill and I know how I am voting. Write the district, not the corridor. You have the line.",
    stump:"I did not come home to whisper. I came to say what I voted and why I will vote it again. I answer to this step before I answer to the capital. If you dislike it, vote me out — do not ask me to lie about it."
  };
  return cans[kind] || cans.floor;
}
function deliverPenSpeech(){
  if(!CATCH.on) return;
  const hard = speechStationNear(3.5);
  if(!hard && !(CATCH.mode === "proc" && PROC.on && PROC.phase === "you")){
    setSay("Stay at the station to read from the pen.", fx("","step in"));
    return;
  }
  if(CATCH.pieces && CATCH.pieces.length){
    feed("Pen path skips piece XP — Deliver the pieced speech for full credit.");
  }
  const prop = CATCH.prop || (hard && hard.prop) || null;
  const kind = CATCH.kind || (hard && hard.kind) || "floor";
  const label = prop ? prop.label.toLowerCase() : "podium";
  G.you.pen = (G.you.pen || 0) + 1;
  spend(8, 5);
  const text = penCannedSpeech(kind);
  try{
    speak(null, text);
    appendFloor("You", text);
    feed("You read it straight from the pen.");
  }catch(e){}
  if(checkSpeakBlasphemy(text, "you")){ catchClear("blasphemy"); promptKey = ""; refreshPanels(); return; }
  /* No regular standing/influence XP from the pieced path */
  setSay(text.slice(0, 220) + (text.length > 220 ? "…" : ""), fx("pen path · hidden progress","8m · light energy"));
  note("Read a prepared speech from the pen at the " + label + " (hidden path).");
  CATCH.pieces = [];
  catchClear("pen");
  promptKey = "";
  refreshPanels();
}
function runPreparedSpeech(prop){
  /* Legacy alias: pen / full-speech shortcut (no piece XP). */
  if(prop && !CATCH.prop) CATCH.prop = prop;
  deliverPenSpeech();
}
let promptKey = "", promptActs = [];
function promptEsc(s){
  return String(s == null ? "" : s).replace(/&/g,"\x26amp;").replace(/</g,"\x26lt;").replace(/>/g,"\x26gt;").replace(/"/g,"\x26quot;");
}
/* 20261030ay: live choice prompts hold so focus flicker / tip clicks do not steal the tap */
let glassHoldUntil = 0;
let glassHoldKey = "";
function glassHolding(){
  return !!(promptActs && promptActs.length && glassHoldUntil && (typeof performance !== "undefined" ? performance.now() : Date.now()) < glassHoldUntil);
}
function glassArmHold(ms){
  glassHoldUntil = (typeof performance !== "undefined" ? performance.now() : Date.now()) + (ms == null ? 16000 : ms);
}
function glassClearHold(){ glassHoldUntil = 0; glassHoldKey = ""; }

function setGlassPrompt(header, choices){
  const pr = el("prompt");
  if(!pr) return;
  const key = (header || "") + "|" + (choices || []).map(c => c.t).join(";");
  if(key === promptKey && !pr.hidden){
    if(choices && choices.length){ glassHoldKey = key; glassArmHold(16000); }
    return;
  }
  /* Sticky: do not replace a live choice prompt with a bare Press-E line or a clear while hold is armed */
  if(glassHolding() && (!choices || !choices.length) && glassHoldKey && key !== glassHoldKey){
    return;
  }
  promptKey = key;
  promptActs = choices || [];
  pr.classList.remove("is-catch");
  if(!choices || !choices.length){
    pr.classList.remove("is-live");
    pr._html = null; /* say() uses textContent — invalidate setHTML cache so later paints aren't skipped */
    if(header){ pr._said = null; say(pr, header); }
    else { say(pr, null); }
    markPicks();
    return;
  }
  try{ closeTip(); }catch(e){}
  glassHoldKey = key;
  glassArmHold(16000);
  pr.classList.add("is-live");
  pr.hidden = false;
  pr._said = key;
  let html = header ? '<span class="prompt__h">' + promptEsc(header) + '</span>' : "";
  html += '<div class="prompt__opts">';
  choices.forEach((c, i) => {
    html += '<button type="button" class="prompt__btn" data-gp="' + i + '">' + promptEsc(c.t) +
      (c.c ? "<u>" + promptEsc(c.c) + "</u>" : "") + "</button>";
  });
  html += "</div>";
  setHTML(pr, html);
  pr.querySelectorAll("[data-gp]").forEach(b => {
    b.addEventListener("pointerdown", e => { try{ e.stopPropagation(); }catch(x){} });
    b.addEventListener("click", e => {
      try{ e.preventDefault(); e.stopPropagation(); }catch(x){}
      const act = promptActs[+b.getAttribute("data-gp")];
      if(!act) return;
      promptKey = "";
      glassClearHold();
      act.run();
      markPicks();
    });
  });
  markPicks();
}

/* ── Podium CATCH stream: one live line; catch it or it passes ── */
const CATCH = {
  on:false, mode:null, sid:null, prop:null, kind:null,
  queue:[], used:null, current:null, pieces:[],
  /* age/dwell are wall-clock ms — ticker drains one frame per paint, not wall-clock */
  age:0, dwell:330, dist:99, passed:0, caught:0,
  renderKey:"",
  /* East Steps: set true only via stump interact / approachSpeechStation; cleared in catchClear */
  armedByInteract:false,
  /* B / Esc backed out of speech glass — stay clear until interact / re-seat */
  suppressed:false,
  /* 20261030ay: TALK/veil suspend keeps state; hover pauses age so taps are not torn */
  suspended:false, hover:false
};
const CATCH_FPS = 60; /* nominal frames for dwell mapping (display only) */
function catchDwellForDist(dist){
  /* 20261030ay+: wall-clock ms (≥5.5s). Independent of display refresh. */
  let sec;
  if(dist <= 2.0) sec = 7.0;
  else if(dist <= 3.5) sec = 7.0 - (dist - 2.0) * (1.0 / 1.5); /* → ~6.0 at 3.5 */
  else if(dist <= 5.2) sec = 6.0 - Math.min(0.5, (dist - 3.5) * 0.25); /* ~6.0 → 5.5 */
  else sec = 5.5;
  return Math.max(5500, Math.round(sec * 1000));
}
function catchSessionId(st, mode){
  return (mode || "speech") + "|" + G.room + "|" + (st && st.prop ? st.prop.id : "none") +
    "|" + (PROC.on ? (PROC.phase + ":" + ((PROC.e && PROC.e.k) || "")) : "solo");
}
function catchClear(reason){
  const back = reason === "back" || reason === "esc";
  if(!back && reason !== "busy-clear" && !CATCH.on && !CATCH.current && !(CATCH.pieces && CATCH.pieces.length) && !CATCH.armedByInteract && !CATCH.suppressed) return;
  CATCH.on = false; CATCH.mode = null; CATCH.sid = null;
  CATCH.queue = []; CATCH.deck = []; CATCH.i = 0; CATCH.current = null; CATCH.age = 0;
  CATCH.pieces = []; CATCH.caught = 0; CATCH.passed = 0;
  CATCH.renderKey = ""; CATCH.prop = null;
  CATCH.armedByInteract = false;
  CATCH.suspended = false; CATCH.hover = false;
  if(back) CATCH.suppressed = true;
  else if(reason !== "wait" && reason !== "ui" && reason !== "busy-clear") CATCH.suppressed = false;
  const pr = el("prompt");
  if(pr) pr.classList.remove("is-catch");
}
function catchSuspend(reason){
  /* Keep stream + arm; hide glass while TALK/veil steals the frame. */
  if(!CATCH.on && !CATCH.armedByInteract) return;
  CATCH.suspended = true;
  const pr = el("prompt");
  if(pr){ pr.classList.remove("is-catch", "is-live"); }
  try{ promptKey = ""; }catch(e){}
}
function catchResume(){
  if(!CATCH.suspended) return;
  CATCH.suspended = false;
  /* Stay armed — do not force re-approach */
  if(CATCH.on){
    CATCH.renderKey = "";
    CATCH.age = 0;
    catchPaint();
  }
}
function catchHoverBind(pr){
  if(!pr || pr._catchHover) return;
  pr._catchHover = true;
  pr.addEventListener("pointerenter", () => { CATCH.hover = true; });
  pr.addEventListener("pointerleave", () => { CATCH.hover = false; });
}
function catchShuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){ const j = (Math.random()*(i+1))|0; const t=a[i]; a[i]=a[j]; a[j]=t; }
  return a;
}
function catchSpeechQueue(kind){
  /* Full pool once per session — no repeats. speechBeats returns up to 10 ordered beats; extras extend the thread. */
  const base = speechBeats(kind);
  const pool = {
    floor:[
      {order:16, t:"Bells ready", line:"When the bells ring I will be in my place, and I will not need a second speech to explain why.", stance:1, mins:9},
      {order:17, t:"No story vote", line:"Do not ask this House to vote for a story. Ask it to vote for a text and a cost.", stance:1, mins:10}
    ],
    hearing:[
      {order:16, t:"Papers match", line:"If the papers do not match the testimony, say so now while we still have a witness in the chair.", stance:1, mins:10},
      {order:17, t:"Oath again", line:"I am not finished. The oath is still in force for the next sentence.", stance:1, mins:9}
    ],
    caucus:[
      {order:16, t:"Whip honesty", line:"An honest whip count hurts in this room so it does not kill us on the floor.", stance:1, mins:10},
      {order:17, t:"One door", line:"One door, one line, one vote. That is discipline, not theatre.", stance:1, mins:9}
    ],
    press:[
      {order:16, t:"Fair piece", line:"A fair piece quotes the line and the reason. Anything else is a column, not a report.", stance:1, mins:9},
      {order:17, t:"Mic still live", line:"If the mic is still live, hear this: I am voting the district, and I will say so again tomorrow.", stance:1, mins:10}
    ],
    stump:[
      {order:16, t:"Receipt", line:"Keep the receipt on what I promised on this step. I will too.", stance:1, mins:9},
      {order:17, t:"Same face", line:"You get the same face and the same vote explanation you would get under the dome.", stance:1, mins:10}
    ]
  };
  const extra = (pool[kind] || pool.floor).slice();
  const seen = new Set();
  const out = [];
  function pushBeat(b){
    if(!b || !b.line) return;
    const key = b.t + "|" + b.line;
    if(seen.has(key) || (CATCH.used && CATCH.used.has(key))) return;
    seen.add(key);
    out.push({
      key:key, t:b.t, line:b.line, stance:b.stance||0, mins:b.mins||12,
      order:b.order != null ? b.order : 50,
      kind:"speech",
      run:null
    });
  }
  catchShuffle(base.concat(extra)).forEach(pushBeat);
  /* a few fresh-phrased closers in the same voice — still unique */
  const closers = {
    floor:["Call the question and let October read the names.",
           "I came to this station to speak for a vote, not to decorate the hour.",
           "The corridor already knows; I am saying it where the record keeps it."],
    hearing:["Under oath is not a costume. Finish the answer.",
             "I will wait for a sentence the papers can confirm.",
             "The transcript will outlive the performance — write for the transcript."],
    caucus:["We leave as one or we lose as many.",
            "Say the hard thing in here so we are not surprised out there.",
            "Discipline is a door we walk through together."],
    press:["Quote the line. Leave the invention for the column.",
           "On the record means on the record — including tomorrow.",
           "Write the district into the piece or do not pretend you covered it."],
    stump:["I said the vote out loud. Hold me to it next month.",
           "This step is where accountability has a face.",
           "I am going back to work with the same explanation I gave you."]
  };
  const cl = closers[kind] || closers.floor;
  for(let i=0;i<Math.min(3, cl.length);i++){
    const tag = fresh(() => cl[i % cl.length], 16);
    pushBeat({t:"Live line", line:tag, stance:1, mins:8, order:18+i});
  }
  return catchShuffle(out);
}
function catchProcQueue(){
  const opts = PROC.opts || (PROC.wit ? witnessOptions(PROC.wit) : procOptions(PROC.e)) || [];
  const seen = new Set();
  const out = [];
  opts.forEach((o, i) => {
    if(!o) return;
    const line = o.say || o.t;
    const key = (o.t || "opt") + "|" + line;
    if(seen.has(key) || (CATCH.used && CATCH.used.has(key))) return;
    seen.add(key);
    out.push({
      key:key, t:o.t || ("Line " + (i+1)), line:line, opt:o, kind:"proc",
      order:i+1, stance:0, mins:8,
      run:null
    });
  });
  return catchShuffle(out);
}
function catchArmCurrent(){
  if(!CATCH.deck || !CATCH.deck.length){
    if(!CATCH.queue || !CATCH.queue.length){ CATCH.current = null; return; }
    CATCH.deck = CATCH.queue.slice();
    CATCH.queue = [];
    CATCH.i = 0;
  }
  CATCH.i = ((CATCH.i|0) + CATCH.deck.length) % CATCH.deck.length;
  CATCH.current = CATCH.deck[CATCH.i];
  CATCH.renderKey = "";
  CATCH.age = 0;
  CATCH.dwell = catchDwellForDist(CATCH.dist == null ? 2.5 : CATCH.dist);
}
function catchStep(d){
  if(!CATCH.on || !CATCH.deck || !CATCH.deck.length) return false;
  CATCH.i = ((CATCH.i|0) + (d || 1) + CATCH.deck.length) % CATCH.deck.length;
  CATCH.current = CATCH.deck[CATCH.i];
  CATCH.renderKey = "";
  catchPaint();
  return true;
}
function catchStart(mode, st){
  const sid = catchSessionId(st, mode);
  if(CATCH.on && CATCH.sid === sid) return;
  CATCH.on = true;
  CATCH.mode = mode;
  CATCH.sid = sid;
  CATCH.prop = st && st.prop ? st.prop : null;
  CATCH.kind = st && st.kind ? st.kind : "floor";
  CATCH.dist = st && st.dist != null ? st.dist : 2.5;
  CATCH.used = new Set();
  CATCH.passed = 0; CATCH.caught = 0;
  CATCH.pieces = [];
  CATCH.queue = mode === "proc" ? catchProcQueue() : catchSpeechQueue(CATCH.kind);
  CATCH.deck = CATCH.queue.slice();
  CATCH.queue = [];
  CATCH.i = 0;
  CATCH.current = null;
  catchArmCurrent();
}
function catchNow(){
  if(!CATCH.on || !CATCH.current) return false;
  const item = CATCH.current;
  if(CATCH.deck && CATCH.deck.length){
    const ix = CATCH.deck.indexOf(item);
    if(ix >= 0) CATCH.deck.splice(ix, 1);
    CATCH.i = CATCH.deck.length ? (ix >= 0 ? ix % CATCH.deck.length : 0) : 0;
  }
  CATCH.current = null;
  CATCH.caught++;
  if(!CATCH.pieces) CATCH.pieces = [];
  CATCH.pieces.push({
    t:item.t, line:item.line, stance:item.stance||0, mins:item.mins||8,
    kind:item.kind||CATCH.mode||"speech", opt:item.opt||null,
    order:item.order != null ? item.order : (CATCH.pieces.length + 1)
  });
  CATCH.renderKey = "";
  promptKey = "";
  try{
    feed("Caught · " + item.t + " (" + CATCH.pieces.length + ")");
    setSay("Caught: " + item.t + " — pieced " + CATCH.pieces.length + ". Deliver when ready.", fx("held for full speech",""));
  }catch(e){}
  /* next line after a catch — do NOT deploySpeechBeat / procYouSay yet */
  catchArmCurrent();
  catchPaint();
  return true;
}
function catchMiss(){
  if(!CATCH.current) return;
  const wasProc = CATCH.mode === "proc";
  CATCH.passed++;
  CATCH.current = null;
  CATCH.renderKey = "";
  /* Non-answer = silence: no speak(), no spend, no sway — weight on the record */
  try{
    appendFloor("You", "…");
    feed("You let it pass.");
    if(G.you) G.you.standing = clamp((G.you.standing || 50) - 1, 0, 100);
    /* If PROC/witness was waiting on you, answer in kind is silence */
    if(wasProc && PROC.on && PROC.phase === "you" && PROC.wit){
      const W = PROC.wit;
      setTimeout(() => {
        if(!PROC.on || !PROC.wit) return;
        appendFloor(surname(W.name), "…");
        /* no speak() — silence in kind */
      }, 500);
    } else if(wasProc && PROC.on && PROC.phase === "you"){
      /* room notices the non-answer without a rebuttal line */
      try{
        const here = (G.members || []).filter(m => m.room === G.room && !m.gone);
        if(here.length && Math.random() < 0.4){
          const m = here[(Math.random() * here.length) | 0];
          m.say = "…"; m.sayT = 2.2; m.sayTo = "you";
          /* no speakAt — they said nothing */
        }
      }catch(e2){}
    }
  }catch(e){}
  catchArmCurrent();
}
function catchPaint(){
  const pr = el("prompt");
  if(!pr || !CATCH.on) return;
  const nPieced = (CATCH.pieces && CATCH.pieces.length) || 0;
  if(!CATCH.current){
    const doneKey = "catch-done|" + CATCH.sid + "|" + CATCH.caught + "|" + nPieced;
    if(promptKey === doneKey) return;
    promptKey = doneKey;
    promptActs = [];
    pr.classList.add("is-live", "is-catch");
    pr.hidden = false;
    const where = (CATCH.prop && CATCH.prop.label) ? CATCH.prop.label.toLowerCase() : "podium";
    let html = '<span class="prompt__h">At the ' + promptEsc(where) + " — stream spent</span>";
    html += '<span class="prompt__catch-line is-pass">Caught ' + CATCH.caught +
      " · passed " + CATCH.passed + ". Pieced " + nPieced +
      " lines — Deliver for full credit · Full speech (pen) = hidden path</span>";
    const extras = [];
    if(nPieced >= 1){
      extras.push({t:"Deliver speech", c:"E · A · LT·RT", run:() => deliverAssembledSpeech()});
    }
    extras.push({t:"Full speech (pen)", c:"pen", run:() => deliverPenSpeech()});
    if(CATCH.mode === "proc"){
      extras.push({t:"Speak free (type below)", c:"—", run:() => setSay("Use the wire or Speak Aloud — the catch stream is spent.", "")});
    }
    promptActs = extras;
    if(extras.length){
      html += '<div class="prompt__catch-row">';
      extras.forEach((c,i) => {
        html += '<button type="button" class="prompt__btn'+(i===0 && nPieced?' is-catch':'')+'" data-gp="'+i+'">'+promptEsc(c.t)+
          (c.c?("<u>"+promptEsc(c.c)+"</u>"):"")+"</button>";
      });
      html += "</div>";
    }
    setHTML(pr, html);
    pr.querySelectorAll("[data-gp]").forEach(b => b.addEventListener("click", () => {
      const act = promptActs[+b.getAttribute("data-gp")];
      if(act) act.run();
    }));
    markPicks();
    return;
  }
  const cur = CATCH.current;
  const nDeck = (CATCH.deck && CATCH.deck.length) || 0;
  const paintId = cur.key + "|" + nPieced + "|" + (CATCH.i|0);
  if(CATCH.renderKey === paintId) return;
  CATCH.renderKey = paintId;
  const key = "catch|" + paintId;
  promptKey = key;
  promptActs = [
    {t:"Prev line", c:"LT · ←", run:() => catchStep(-1)},
    {t:"Take line", c:"E · A", run:() => catchNow()},
    {t:"Next line", c:"RT · →", run:() => catchStep(1)}
  ];
  if(nPieced >= 1){
    promptActs.push({t:"Deliver speech", c:"full", run:() => deliverAssembledSpeech()});
  }
  pr.classList.add("is-live", "is-catch");
  pr.hidden = false;
  const where = (CATCH.prop && CATCH.prop.label) ? CATCH.prop.label.toLowerCase() : "podium";
  const head = CATCH.mode === "proc"
    ? "Interview — LT · RT browse · A takes the line"
    : ("At the " + where + " — LT · RT browse · A takes the line");
  let html = '<span class="prompt__h">' + promptEsc(head) + '</span>' +
    '<span class="prompt__catch-line">' + promptEsc(cur.line || cur.t) + '</span>' +
    '<div class="prompt__catch-row">' +
      '<button type="button" class="prompt__btn" data-gp="0">◀ Line<u>LT · ←</u></button>' +
      '<button type="button" class="prompt__btn is-catch" data-gp="1">Take line<u>E · A</u></button>' +
      '<button type="button" class="prompt__btn" data-gp="2">Line ▶<u>RT · →</u></button>';
  if(nPieced >= 1){
    html += '<button type="button" class="prompt__btn" data-gp="3">Deliver speech<u>full</u></button>';
  }
  html += '<span class="prompt__miss">' + promptEsc(cur.t) + ' · ' + ((CATCH.i|0)+1) + '/' + nDeck +
    ' · held ' + nPieced + '</span>' +
    '</div>';
  setHTML(pr, html);
  pr.querySelectorAll("[data-gp]").forEach(b => b.addEventListener("click", () => {
    const act = promptActs[+b.getAttribute("data-gp")];
    if(act) act.run();
  }));
  markPicks();
}
function catchTick(dt){
  if(!CATCH.on || CATCH.suspended) return;
  /* Pause the dwell clock while the pointer or pad pick is on the glass */
  const pr = el("prompt");
  catchHoverBind(pr);
  const focused = !!(PICK >= 0 && PICKS[PICK] && pr && pr.contains(PICKS[PICK]));
  if(!(CATCH.hover || focused)){
    CATCH.dwell = catchDwellForDist(CATCH.dist == null ? 2.5 : CATCH.dist);
    CATCH.age = (CATCH.age || 0) + Math.max(0, (dt || 0) * 1000);
    if(CATCH.current && CATCH.age >= CATCH.dwell){
      CATCH.age = 0;
      try{ catchMiss(); }catch(e){}
      try{ catchArmCurrent(); }catch(e){}
    }
  }
  catchPaint();
}
function catchFrame(dt){
  if(!G.running){
    if(CATCH.on) catchClear("ui");
    return;
  }
  /* 20261030ay: transient TALK/veil must not kill CATCH mid-tap — suspend + resume */
  if(TALK.open || !veil.hidden){
    if(CATCH.on || CATCH.armedByInteract) catchSuspend("ui");
    return;
  }
  if(CATCH.suspended) catchResume();
  /* Don't snag while walking to the stand — approach owns the camera */
  if(G.speechApproach) return;
  const hard = speechStationNear(1.85); /* 20261104bh */
  const atStand = !!(hard && !playerIsMoving());
  /* 20261104bf A1: standing still in the stand zone arms the solo catch itself; Press-E is no longer required (it was stolen by adjacent members) */
  const _soloOpen = !PROC.on || (PROC.phase === "open" && !PROC.speaker); /* 20261104bl A1: open floor, nobody up = solo catch */
  if(atStand && _soloOpen && !CATCH.on && !CATCH.suppressed && !CATCH.armedByInteract) CATCH.armedByInteract = true;
  if(hard || CATCH.on || CATCH.armedByInteract){ try{ if(AP.toast){ AP.toast.remove(); AP.toast = null; } }catch(e){} }
  /* Armed by E at the stand; walking off before you arrive drops it */
  if(CATCH.armedByInteract && !CATCH.on && !hard && !G.speechApproach){
    CATCH.armedByInteract = false;
  }
  /* PROC your turn: stream only at the stand after you press in. */
  if(PROC.on && PROC.phase === "you"){
    if(CATCH.suppressed){
      if(CATCH.on) catchClear("wait");
      return;
    }
    if(!CATCH.armedByInteract && !atStand){
      if(CATCH.on) catchClear("left");
      return;
    }
    if(hard) CATCH.dist = hard.dist;
    else CATCH.dist = 1.2;
    if(atStand || CATCH.armedByInteract){
      catchStart("proc", hard || {prop:CATCH.prop, dist:CATCH.dist, kind:SPEECH_KIND[G.room]||"floor"});
      if(hard && hard.prop) CATCH.prop = hard.prop;
      catchTick(dt);
    }
    return;
  }
  /* someone else's turn at station */
  if(PROC.on && !_soloOpen && atStand && (PROC.phase === "run" || PROC.phase === "open")){
    if(CATCH.on) catchClear("wait");
    return;
  }
  /* Solo podium — never from walk-by. E at the stand arms it. */
  if(_soloOpen && (atStand || (CATCH.on && hard))){
    if(CATCH.suppressed){
      if(CATCH.on) catchClear("wait");
      return;
    }
    if(!CATCH.armedByInteract && !CATCH.on){
      return;
    }
    /* 20261030ay+: tiny steps at the stand must not kill an armed stream — only leave clears */
    if(!CATCH.armedByInteract && CATCH.on && playerIsMoving() && !(hard && hard.dist <= 1.15)){
      catchClear("left");
      return;
    }
    const st = hard;
    if(st) CATCH.dist = st.dist;
    if(atStand && CATCH.armedByInteract) catchStart("speech", st);
    else if(CATCH.on && st) CATCH.dist = st.dist;
    catchTick(dt);
    return;
  }
  if(CATCH.on) catchClear("left");
}

/* ── Seated voice: untimed rowdy picks during a live sitting ── */
function seatVoiceAvailable(){
  if(!G.you || !G.you.sitting) return false;
  if(!SEATED_ROOMS[G.room]) return false;
  if(!PROC.on) return false; /* not idle outside session */
  /* Live chamber sitting, or someone has gone up to speak */
  if(PROC.speaker) return true;
  if(PROC.phase === "run" || PROC.phase === "open" || PROC.phase === "you") return true;
  return false;
}
function fileFloorAmendment(fromSeat){
  if(!G.bill || G.bill.done){
    setSay("There is no live bill to amend.", fx("",""));
    return false;
  }
  if(G.you.influence < 9){
    setSay("You do not have the influence to file from here.", fx("",""));
    return false;
  }
  spend(fromSeat ? 25 : 55, fromSeat ? 8 : 16);
  G.you.influence -= 9;
  const a = pick(AXES);
  G.bill.pos[a.k] = Math.round(lerp(G.bill.pos[a.k], G.you.district[a.k], 0.4));
  G.bill.line = describeBill(G.bill);
  G.you.standing = clamp(G.you.standing-3,0,100);
  const where = fromSeat ? "from your place" : "at the clerk's table";
  setSay("Filed " + where + ". It moves the bill on " + a.n.toLowerCase() + ", and the leadership will read it as a message.",
    fx("bill moved toward your district","−9 influence, −3 standing"));
  note("Filed a floor amendment " + where + " on " + G.bill.title + ".");
  if(!PROC.on){ try{ refreshPanels(); }catch(e){} }
  return true;
}
function seatVoiceActs(){
  return [
    {t:"Shout", c:"1", run:() => seatShout()},
    {t:"Heckle", c:"2", run:() => seatHeckle()},
    {t:"Speak mind", c:"3", run:() => seatSpeakMind()},
    {t:"Out of hand", c:"4", run:() => seatOutOfHand()},
    {t:"File amendment", c:"5", off:!G.bill||G.bill.done||G.you.influence<9, run:() => fileFloorAmendment(true)},
    {t:"Stand", c:"—", run:() => { try{ riseFromSeat(); }catch(e){ G.you.sitting = false; } }}
  ];
}
function seatShout(){
  if(!seatVoiceAvailable()) return;
  spend(2, 3);
  const line = fresh(() => pick([
    "Hear, hear!",
    "Order!",
    "Say it again for the record!",
    "The district can hear you!",
    "Put it plainly!"
  ]), 14);
  try{ speak(null, line); appendFloor("You", line); }catch(e){}
  feed("You shouted from your seat.");
  const here = (G.members || []).filter(m => m.room === G.room && !m.gone);
  here.slice(0, 3).forEach(m => {
    if(chance(0.45)) ripple(m, chance(0.5) ? 1 : -1, "You shouted across the sitting.", 1);
  });
  setSay(line, fx("the room heard you","2m · shout"));
  note("Shouted from the seat during the sitting.");
  promptKey = "";
}
function seatHeckle(){
  if(!seatVoiceAvailable()) return;
  spend(3, 4);
  const target = PROC.speaker || pick((G.members || []).filter(m => m.room === G.room && !m.gone && m !== G.you));
  const billBit = (G.bill && !G.bill.done) ? G.bill.title.split(" ")[0] : "that";
  const line = fresh(() => {
    if(target) return pick([
      "Give way!",
      "That is not what it says.",
      "Nonsense — sit down.",
      surname(target.name) + " knows better.",
      "Speak to " + billBit + ", not the gallery."
    ]);
    return pick(["Nonsense.", "Order!", "That will not wash."]);
  }, 14);
  try{ speak(null, line); appendFloor("You", line); }catch(e){}
  if(target){
    ripple(target, -5, "You heckled me from your seat in front of the room.", -6, true);
    try{
      const rebuke = fresh(() => pick(["The member will come to order.", "That is enough from the benches.", "I heard that."]), 10);
      if(PROC.chair){
        setTimeout(() => {
          if(!PROC.on) return;
          PROC.chair.say = rebuke; PROC.chair.sayT = 3.2;
          appendFloor(surname(PROC.chair.name), rebuke);
          speakAt(PROC.chair, rebuke);
        }, 700);
      }
    }catch(e2){}
  }
  if(G.bill && !G.bill.done){
    const dir = (G.you.lean || 0) >= 0 ? 1 : -1;
    try{ swayRoom(-dir, 2, false); }catch(e){}
  }
  G.you.standing = clamp((G.you.standing||50) - 1, 0, 100);
  setSay(line, fx("heckle landed","−1 standing · may draw rebuke"));
  note("Heckled from the seat.");
  promptKey = "";
}
function seatSpeakMind(){
  if(!seatVoiceAvailable()) return;
  spend(4, 3);
  const bill = (G.bill && !G.bill.done) ? G.bill.title : null;
  const line = fresh(() => pick([
    bill ? ("On " + bill + ": the benches opposite have not answered the cost.") : "The room has heard enough soft endings for one sitting.",
    "I am on the record from my seat: this needs a clean vote, not another hour of fog.",
    "My district did not send me here to sit quiet through a dodge.",
    "Say the numbers without the performance. That is all I am asking."
  ]), 14);
  try{ speak(null, line); appendFloor("You", line); }catch(e){}
  if(checkSpeakBlasphemy(line, "you")){ promptKey = ""; return; }
  const land = (G.you.standing*0.4 + G.you.influence*0.3 - tired() + rint(-15, 15)) > 18;
  if(land){
    G.you.standing = clamp((G.you.standing||50) + 2, 0, 100);
    G.you.influence = clamp((G.you.influence||0) + 1, 0, 100);
    setSay(line, fx("+2 standing · +1 influence","on the record from the seat"));
  } else {
    setSay(line, fx("","said · little moved"));
  }
  note("Spoke mind from the seat.");
  promptKey = "";
}
function seatOutOfHand(){
  if(!seatVoiceAvailable()) return;
  spend(5, 8);
  const line = fresh(() => pick([
    "This is a disgrace and I will not sit through it!",
    "You are out of order — and so is this whole charade!",
    "I will not be silent while that stands as an answer!",
    "Chair! Chair! This cannot continue!"
  ]), 12);
  try{ speak(null, line); appendFloor("You", line); }catch(e){}
  /* disorderly: standing hit, energy already spent, room notice, possible censure */
  G.you.standing = clamp((G.you.standing||50) - 4, 0, 100);
  const here = (G.members || []).filter(m => m.room === G.room && !m.gone);
  here.forEach(m => ripple(m, chance(0.55) ? -2 : 1, "You went out of hand in the sitting.", -2));
  let censured = false;
  if(PROC.chair && chance(0.55)){
    censured = true;
    G.you.standing = clamp((G.you.standing||50) - 3, 0, 100);
    const rebuke = fresh(() => pick([
      "The member is out of order. Compose yourself.",
      "That is enough. Another word and I name you.",
      "The chair will not have a riot from the benches."
    ]), 10);
    setTimeout(() => {
      if(!PROC.on || !PROC.chair) return;
      appendFloor(surname(PROC.chair.name), rebuke);
      speak(PROC.chair, rebuke);
    }, 600);
  }
  setSay(line, fx(censured ? "censure · −7 standing" : "disorder · −4 standing", "out of hand"));
  note(censured ? "Went out of hand; the chair censured you." : "Went out of hand from the seat.", true);
  promptKey = "";
}

function updatePrompt(thing, dr, seat){
  if(!G.running || TALK.open || !veil.hidden){
    glassClearHold();
    setGlassPrompt(null, null);
    return;
  }
  /* Sticky live choices: focus flicker must not wipe buttons mid-tap */
  if(glassHolding() && !(CATCH.on && CATCH.mode) && !(PROC.on && PROC.phase === "you" && !CATCH.suppressed)){
    return;
  }
  /* Catch stream owns the glass while active */
  if(CATCH.on && CATCH.mode){
    catchPaint();
    return;
  }
  /* 1) PROC your turn — catchFrame drives stream unless B backed out */
  if(PROC.on && PROC.phase === "you"){
    if(CATCH.suppressed){
      const acts = [
        {t:"Back to the stand", c:"E · A", run(){
          CATCH.suppressed = false;
          const st = speechStationNear(0.85);
          if(st && st.prop) approachSpeechStation(st.prop);
          else { setSay("You take the floor again. Catch a line when it drifts.", fx("","")); promptKey = ""; }
        }}
      ];
      if(G.you && G.you.sitting){
        seatVoiceActs().forEach(a => { if(a.t !== "Stand") acts.push(a); });
        acts.push({t:"Stand", c:"—", run:() => { try{ riseFromSeat(); }catch(e){ G.you.sitting = false; } }});
      }
      setGlassPrompt("Floor is yours — B backed you out · pick a line or return to the stand", acts);
      return;
    }
    setGlassPrompt("You have the floor — lines will drift; Catch one", []);
    return;
  }
  /* Seated voice: untimed picks during a live sitting (no dwell ticker) */
  if(seatVoiceAvailable()){
    setGlassPrompt("From your seat — untimed", seatVoiceActs());
    return;
  }
  /* 2) At a speech station during someone else's turn */
  const st = speechStationNear(0.85);
  if(PROC.on && st && (PROC.phase === "run" || PROC.phase === "open")){
    const full = !lecternCapOpen(G.room);
    if(full){
      setGlassPrompt("Well full — two already up", [
        {t:"Sit and wait", c:"E", run(){ try{ takeSeat(); }catch(e){} setSay("You take a seat. The well holds two.", fx("","")); }},
        {t:"Hold back", c:"—", run(){ setSay("You stay clear of the speaking area.", fx("","")); }}
      ]);
    } else {
      setGlassPrompt("Wait for recognition", [
        {t:"Hold the station", c:"—", run(){ setSay("You keep the place. The chair has not called you.", fx("","")); }}
      ]);
    }
    return;
  }
  /* 3) Solo station — catchFrame starts stream; nudge until first paint */
  if(!PROC.on && st){
    /* Steps: st only when armed (speechStationNear); still guard */
    if(G.room === "steps" && !CATCH.armedByInteract && !CATCH.on){
      /* fall through — free plaza walk, default E prompt on stump focus */
    } else {
      setGlassPrompt("At " + String(st.prop.label || "the stand").replace(/^the /i, "").toLowerCase() + " — catch a line", []);
      return;
    }
  }
  /* Approaching / focusing a speech station before hard range — not openProp */
  if(G.speechApproach || (thing && thing.type === "prop" && isSpeechStationProp(thing.ref))){
    /* East Steps: only after interact (speechApproach / armed), not walk-by focus */
    if(G.room === "steps" && !G.speechApproach && !CATCH.armedByInteract){
      /* fall through to "Press E — The top step" */
    } else {
      setGlassPrompt("Step in — catch lines when you're at the stand", []);
      return;
    }
  }
  /* Office My desk — free casual sit (0m); world keeps running */
  if(thing && thing.type === "prop" && thing.ref && thing.ref.id === "desk" && G.room === "office" && !TALK.open){
    if(G.you && G.you.sitting){
      setGlassPrompt("At your desk — seated", [
        {t: PC.open ? "Close the computer" : "Use the computer", c:"E · A", run(){ if(PC.open) pcClose(); else pcOpen(); }},
        {t:"Files and drawers", c:"—", run(){ pcClose(); openProp(thing.ref); }},
        {t:"Stand", c:"—", run(){ try{ toggleSit(); }catch(e){ G.you.sitting = false; } }}
      ]);
    } else {
      setGlassPrompt("My desk", [
        {t:"Sit casually", c:"E · A · 0m", run(){ sitCasuallyAtDesk(); }},
        {t:"Open desk", c:"—", run(){ openProp(thing.ref); }}
      ]);
    }
    return;
  }
    /* 20261104ay+: at a speech stand, do not let an adjacent member steal the prompt for Press-E talk */
  try{
    const hardStand = speechStationNear(1.85); /* 20261104bh */
    if(hardStand && !TALK.open && !(PROC.on && PROC.phase !== "you" && PROC.speaker && !CATCH.armedByInteract)){
      if(CATCH.on || CATCH.armedByInteract || G.speechApproach || (hardStand.dist != null && hardStand.dist <= 1.85)){
        /* catchFrame / earlier branches own the glass — skip person Press-E */
        if(thing && thing.type === "person"){ /* 20261104bl A1: drop stale "Press E to speak with …" hm-p */ try{ const pr = el("prompt"); if(pr && !pr.classList.contains("is-catch") && /Press E to speak/.test(pr.textContent || "")) setGlassPrompt(null, null); }catch(e){} markPicks(); return; }
      }
    }
  }catch(e){}
  /* Default: door / person / prop / seat */
  const want = (dr && !thing) ? "→ " + ROOMS[dr.dr.to].t
             : (thing && !TALK.open)
               ? (thing.type === "person"
                   ? "Press E to speak with " + surname(thing.ref.name)
                   : "Press E — " + thing.ref.label)
               : seat ? (G.you.sitting ? "Press E to stand" : "Press E to sit")
               : null;
  setGlassPrompt(mPadPrompt(want), null);
}

const PROPS = {
  office:[
    {id:"sofa", label:"The office sofa", sub:"Older than the building's plumbing and better made", x:-2.35, z:5.4, r:2.0,
     acts:()=>[
      sleepAct("your office, on the sofa"),
      {t:"Lie down until you are right again", c:"a couple of hours", off:G.you.energy > 96, run(){
        /* An hour or two flat on your back puts you back on your feet.
           It costs what it costs: the day is shorter for it. */
        const need = Math.round((100 - G.you.energy) * 1.6) + 25;
        spend(need, -(100 - G.you.energy));
        G.you.energy = 100;
        setSay(pick([
          "Two hours on a sofa older than the plumbing, and the ceiling has a crack shaped like Fallowfield.",
          "You wake up not knowing what time it is, which is the most rest anybody gets in here.",
          "You sleep like a man who has stopped pretending, and wake up able to think again."
        ]), fx("energy back to 100", need + " minutes"));
      }},
      {t:"Sit for ten minutes and say nothing", c:"10m", run(){
        spend(10, -14);
        setSay("Ten minutes. No paper, no telephone, nobody's name in your mouth.",
          fx("+14 energy", "10 minutes"));
      }}
     ]},
    {id:"desk", label:"My desk", sub:"Committee paper, unopened mail, a district map", x:0, z:7.2, r:2.4,
     acts:()=>[
      {t: G.you.sitting ? "Already seated" : "Sit casually", c:"0m · E · A",
       off:!!G.you.sitting,
       run(){
        try{ closeTalk(); }catch(e){}
        sitCasuallyAtDesk();
      }},
      {t:"Finish here for the day", c:"the rest of the evening",
       off:G.minute < 17*60,
       run(){
        /* You do not have to walk anywhere. You put the pen down in your
           own chair and that is the day. */
        feed("You put the pen down.");
        G.you.sitting = true;
        setSay("You sit back in your own chair and let the building go quiet around you.", "");
        closeTalk();
        G.minute = Math.max(G.minute, 22*60);
        G.pendingNight = true;
        setTimeout(() => { G.you.sitting = false; nightfall(); }, 500);
      }},
      {t:"Draft a bill of my own", c:"90m · 12 infl", off:G.you.influence<12, run(){
        spend(90, 24); G.you.influence -= 12;
        const b = makeBill();
        /* 20261027c: your bill is yours: out of your State, in your name, not the member the draft was first drawn for */
        try{ if(b.why && b.sponsor) b.why = b.why.split(surname(b.sponsor) + " has been saying so").join("You have been saying so"); }catch(e){}
        b.sponsor = G.you.name; b.sponsorParty = G.you.party; b.sponsorId = G.you.id; b.state = G.you.state; b.stakes = "contested";
        for(const a of AXES) b.pos[a.k] = Math.round(lerp(b.pos[a.k], G.you.district[a.k], 0.7));
        b.line = describeBill(b); b.voteDay = G.day + rint(3,6); b.mine = true; b.cosponsors = [];
        placeYourBill(b);
        const line = partyLine(b)[G.you.party];
        G.you.standing = clamp(G.you.standing + (line>0?4:-6), 0, 100);
        note("Drafted " + b.title + " and put it on the calendar.", true);
        setSay("Four hours with legislative counsel and it is a bill: " + b.title + ".",
          fx("your bill, written for your district","−12 influence · 90 minutes"));
      }},
      {t:"Read the mail", c:"20m", run(){
        spend(20, 4);
        const unknown = G.members.filter(m => m.known < 2);
        if(unknown.length){
          const m = pick(unknown); m.known = 2;
          setSay("A file from your staff on " + m.name + ": " + m.bg + ", won by " + m.margin +
            ", and " + (memberVote(m, G.bill)>0 ? "leaning aye." : "leaning no."),
            fx("their position is now on your board",""));
        } else setSay("Nothing but invitations and a rate card from a polling firm.", fx("","nothing useful"));
      }},
      {t:"Work the phones", c:"70m", off:!G.members.some(m=>m.met), run(){
        spend(70, 20);
        const known = G.members.filter(m => m.met).sort(()=>Math.random()-0.5).slice(0,4);
        known.forEach(m => { ripple(m, 3, "You called. On a Tuesday, for no reason. People notice that.", 2); m.known = Math.max(m.known,1); });
        setSay("Four calls, three of them answered. It is not the same as the corridor, but it counts.",
          fx("+3 warmth with " + listify(known.map(m=>surname(m.name))), "70 minutes"));
      }}
     ]},
    {id:"urn", label:"The coffee pot", sub:"Burnt, and the only one on this floor", x:0.80, z:7.88, r:1.6,
     acts:()=>[{t:"Pour a cup", c:"10m", off:G.you.energy>88, run(){
        spend(10, -16); setSay("It is terrible. It works.", fx("+16 energy","")); }}]},
    {id:"pc", label:"The desk computer", sub:"Mail, the whip count, and a browser nobody has updated", x:-0.30, z:8.24, r:1.7,
     acts:()=>[
      {t:"Read my mail" + (unreadCount() ? " (" + unreadCount() + " new)" : ""), c:"10m", run(){
        spend(10, 2);
        showPane("paneInbox");
        setSay(unreadCount() ? unreadCount() + " unread. Half of them want something."
                             : "Nothing new. That is either peace or trouble.",
          fx("the inbox is open in the panel",""));
      }},
      {t:"Open the whip count", c:"5m", off:!(G.bill && !G.bill.done), run(){
        spend(5, 1);
        whipCard();
      }},
      {t:"Use the powers of your office", c:"5m", run(){
        spend(5, 1);
        officeCard();
      }},
      {t:"Open the war chest ledger", c:"5m", run(){
        spend(5, 1);
        chestCard();
      }},
      {t:"Send a note to everyone I know", c:"40m", off:!G.members.some(m=>m.met), run(){
        spend(40, 10);
        const known = G.members.filter(m => m.met);
        known.forEach(m => { ripple(m, 2, "You circulated something. At least you thought of me.", 1); });
        setSay("A round-robin to " + known.length + " offices. It is not intimacy, but it is contact.",
          fx("+2 warmth across " + known.length + " members","40 minutes"));
      }}
     ]},
    {id:"phone", label:"The desk telephone", sub:"A direct line to every office in the building", x:0.85, z:8.32, r:1.8,
     acts:()=>{
       const known = G.members.filter(m => m.met && !presentWith(m));
       const out = [];
       if(!known.length) out.push({t:"Nobody to call yet", off:true, run(){}});
       else out.push({t:"Call " + pick(known).name.split(" ").pop() + "'s office", c:"20m", run(){
         const m = pick(known);
         spend(20, 5);
         m.known = Math.max(m.known, 1);
         ripple(m, 4, "You rang my office rather than sending a staffer. It registers.", 3);
         openTalk(m);
         el("chat").hidden = false;
         appendMsg("them", "This is " + m.name + ". You have me for five minutes.", surname(m.name));
         setSay("You have them on the line. Use the bar at the bottom.", fx("+4 warmth","20 minutes"));
       }});
       return out;
     }},
    {id:"case", label:"The bookcase", sub:"Bound statutes nobody has opened since the last Congress", x:-3.0, z:4.5, r:2.0,
     acts:()=>[{t:"Read up on the bill", c:"45m", off:!G.bill, run(){
        spend(45, 12);
        let n = 0;
        G.members.forEach(m => { if(m.known < 1){ m.known = 1; n++; } });
        setSay("You read the thing properly, which puts you ahead of most of the chamber.",
          fx("the projected count now covers " + n + " more members","45 minutes")); }}]}
  ],
  corridor:[
    {id:"board", label:"The notice board", sub:"Today's calendar, pinned crooked", x:-2.8, z:4.9, r:2.0,
     acts:()=>[{t:"Read the calendar", c:"5m", run(){
        spend(5, 1);
        const b = G.bill;
        setSay(b ? b.title + ", roll call day " + b.voteDay + " at " + (b.voteHour>12?b.voteHour-12:b.voteHour) +
          " o'clock. Sponsored by " + b.sponsor + "." : "The calendar is clear, which never lasts.", ""); }}]},
    {id:"statue", label:"Statue of Dominic Zachary Taylor", sub:"First Consul · The First Order", x:-2.0, z:15.2, r:2.4,
     acts:()=>{
      const rite = consularHere();
      const rows = [
      {t:"Read the plaque", c:"5m", run(){
        spend(5, 1);
        const hol = isTaylorDay()
          ? " Today is " + (FIRST_CONSUL.holiday || "Taylor Day") + " — " +
            (FIRST_CONSUL.holidayFull || "Day of the First Consul") +
            " — the national holiday of his birth, " + (FIRST_CONSUL.born || "7/7") + "."
          : " His birthday, " + (FIRST_CONSUL.born || "7/7") + ", is kept as " +
            (FIRST_CONSUL.holiday || "Taylor Day") + " across the Republic.";
        setSay(FIRST_CONSUL.name + ", " + FIRST_CONSUL.title + " of the Republic, of " + FIRST_CONSUL.dist +
          ". Every aisle in this building reviled him. Every aisle still agrees he is the greatest leader the universe has ever seen. " +
          "To compare the living to him is blasphemy. The Greatest descends under him only." + hol,
          fx("the First Order is legend, not a ballot",""));
      }},
      {t:"Be seen in the corridor", c:"40m", run(){
        spend(40, 8);
        G.you.influence = clamp(G.you.influence+3,0,100);
        const seen = hereNow().filter(m=>m.kind==="member").length;
        const hol = isTaylorDay()
          ? " It is Taylor Day; a wreath leans at the plinth and nobody jokes about the plaque."
          : " Nobody jokes about the plaque.";
        setSay("You stand under Taylor's bronze and let people find you. " + seen + " did." + hol,
          fx("+3 influence","40 minutes for nothing definite")); }}
      ];
      if(rite.length){
        rows.push({t:"Witness the Consular Rite", c:"10m", run(){
          spend(10, 2);
          setSay(rite.length + " at the bronze with the precepts open. They pray the Our Father first, then read the Consul's precepts. The chaplain is not in this corridor.",
            fx("you were seen watching","10 minutes"));
        }});
        if(!isConsular(G.you)) rows.push({t:"Take up the precepts with them", c:"15m", run(){
          spend(15, 4);
          try{ riteYouJoin("corridor"); }catch(e){}
          setSay("You read the precepts with them. They make room. God is the Most High; Christ is King; the Consul a man under God. The House will not forget that you did this.",
            fx("your choice · the Latin Rite calls it heresy","15 minutes"));
        }});
        else rows.push({t:"Tell them you are done with it", c:"10m", run(){
          spend(10, 3);
          try{ riteYouLeave("corridor"); }catch(e){}
          setSay("You say it plainly. Nobody stops you. A few will not look at you on the way out.", fx("your choice · some will call it apostasy","10 minutes"));
        }});
        rows.push({t:"Rebuke them", c:"8m", run(){
          spend(8, 3);
          rite.forEach(m => {
            if(m.rel) m.rel.warmth = clamp((m.rel.warmth||0) - 14, -100, 100);
            m.say = pick(["We will still kneel.","The chaplain already refused us.","Say it to the bronze."]);
            m.sayT = 4;
          });
          const lat = hereNow().filter(m => m.creed === "latin" && !isConsular(m));
          lat.slice(0,2).forEach(m => { if(m.rel) m.rel.warmth = clamp((m.rel.warmth||0)+6,-100,100); });
          setSay("You tell them God is the Most High. Not a consul. They do not get up.",
            fx("the Catholics heard you","8 minutes"));
        }});
      }
      return rows;
     }}
  ],
  engine:[
    {id:"enline", label:"The Open Line", sub:"A terminal at every seat. Anyone may type: you, the room, the Engine, and any town in the Republic", x:0, z:5.2, r:2.4,
     acts:()=>[{t:"Sit at a terminal and speak to the line", c:"5m", run(){ try{ spend(5, 0); }catch(e){} ENL.min = false; try{ enlRender(); const i = document.getElementById("enlIn"); if(i) setTimeout(() => i.focus(), 50); }catch(e){} return null; }}]},
    {id:"engmach", label:"The Engine", sub:"The Republic's thinking machines, from the adding engines to what is awake now", x:0, z:11.2, r:2.6,
     acts:()=>[{t:"Open the Engine's file", c:"10m", run(){ try{ spend(10, 1); }catch(e){} setTimeout(() => { try{ engCard(); }catch(e){ console.warn(e); } }, 30); return null; }}]}
  ],
  cloak:[
    {id:"dining", label:"The members' dining room", sub:"Soup, bread and whoever else could not wait", x:-2.4, z:6.6, r:2.0,
     acts:()=>[{t:"Sit down and eat", c:"25m", run(){ spend(25, 0); bodyEat(G.you); const b = bodyOf(G.you); setSay("Soup, bread and a cup of something hot. Two members at the next table are arguing about the bill with their mouths full.", fx("+6 energy · fed", "25 minutes")); }}, {t:"Take something to eat at your desk", c:"5m", run(){ spend(5, 0); bodyEat(G.you); setSay("A roll and an apple in your coat pocket.", fx("fed", "5 minutes")); }}]},
    {id:"sofa", label:"The long sofa", sub:"Where deals get made because nobody is standing", x:2.3, z:3.0, r:2.0,
     acts:()=>[{t:"Sit down for a while", c:"25m", run(){
        spend(25, -22); setSay("Twenty-five minutes off your feet. The building keeps going.", fx("+22 energy","")); }}]},
    {id:"altar", label:"The chaplain's end", sub:"Quiet. No Host for the Consular Rite.", x:-1.2, z:1.4, r:1.9,
     acts:()=>[{t:"Ask the chaplain about the Consular Rite", c:"8m", run(){
        spend(8, 2);
        setSay("That is not the Mass. They keep remainders — flakes, folds, an empty chair — and call them horcruxes. They are writing a history of idols. I will not give them the Host. God is the Most High.",
          fx("the chaplain will not move","8 minutes")); }}]},
    {id:"phone", label:"The house phone", sub:"A wooden booth, and a line to home", x:-2.4, z:6.0, r:1.8,
     acts:()=>[{t:"Call the district office", c:"25m", run(){
        spend(25, 5);
        G.you.approval = clamp(G.you.approval+3,0,100);
        setSay("Your district director reads you the week: two funerals, a plant closing, and a water notice.",
          fx("+3 approval","")); }}]}
  ],
  caucus:[
    {id:"lectern", label:"The caucus lectern", sub:"Your own party, in one room", x:0, z:11.8, r:2.4,
     acts:()=>[{t:"Address the caucus", c:"60m", off:G.you.standing<20, run(){
        spend(60, 22);
        const good = (G.you.standing*0.5 + G.you.influence*0.6 - tired() + rint(-20,20)) > 22;
        if(good){
          G.you.standing = clamp(G.you.standing+9,0,100);
          G.members.forEach(m => { if(m.party===G.you.party) ripple(m, 5, "You said the thing the rest of us were thinking.", 4); });
          setSay("You said it plainly and the room went with you.", fx("+9 standing · +5 warmth across your caucus",""));
          note("Addressed the caucus, and it landed.", true);
        } else {
          G.you.standing = clamp(G.you.standing-6,0,100);
          setSay("You spoke for eleven minutes and watched them check their phones.", fx("","−6 standing"));
        }
      }}]}
  ],
  committee:[
    {id:"door", label:"Door to the corridor", sub:"Statuary Corridor — walk here to leave", x:0, z:0.9, r:2.2,
     acts:()=>[{t:"Leave to the corridor", c:"walk out", run(){
        try{ catchClear("door"); }catch(e){}
        G.you.sitting = false;
        G.speechApproach = null;
        goTo("corridor");
     }}]},
    {id:"dais", label:"The committee dais", sub:"Where your gavel would sit", x:0, z:10.45, r:2.6,
     acts:()=>[{t:"Question the witness", c:"50m", off:!G.bill, run(){
        spend(50, 16);
        const com = committeeOf(G.you.committee);
        G.you.influence = clamp(G.you.influence+6,0,100);
        G.you.approval = clamp(G.you.approval+2,0,100);
        const swayed = swayRoom(alignment(G.you,G.bill)>0?1:-1, 9, false);
        setSay("Six minutes of questions on " + com.t.toLowerCase() + ", and the record now says what you wanted it to say.",
          fx("+6 influence, +2 approval" + (swayed.length?", moved "+swayed.length+" members in the room":""),"50 minutes"));
      }}]},
    {id:"witness", label:"The witness table", sub:"Under oath, facing the dais", x:0, z:5.15, r:2.2,
     acts:()=>[{t:"Stand by the table", c:"10m", run(){
        spend(10, 2);
        setSay("The water jug is still full. Somebody's notes are still open. The chair can see you from here.",
          fx("","")); }}]},
    {id:"well", label:"The stenographer's desk", sub:"The record is being taken", x:-4.35, z:7.35, r:2.0,
     acts:()=>[{t:"Watch the well", c:"8m", run(){
        spend(8, 1);
        setSay("Keys click. The aisle between witness and dais is empty on purpose.", fx("","")); }}]}
  ],
  floor:[
    {id:"rostrum", label:"The rostrum", sub:"Five minutes, if the chair recognises you", x:0, z:13.4, r:3.0,
     acts:()=>[{t:"Speak on the bill", c:"45m", off:!G.bill||G.bill.done, run(){
        spend(45, 20);
        const dir = G.you.vote !== null ? G.you.vote : (alignment(G.you,G.bill)>0?1:-1);
        const power = 7 + G.you.influence*0.16 + G.you.standing*0.08 - tired()*0.4;
        if(power < 5 || (G.you.energy < 25 && chance(.4))){
          G.you.approval = clamp(G.you.approval-3,0,100);
          setSay("You lost your place twice and the gallery noticed.", fx("","−3 approval · a bad five minutes"));
          note("Gave a poor speech on the floor.", true);
        } else {
          const hit = swayRoom(dir, power, true);
          G.you.influence = clamp(G.you.influence+3,0,100);
          setSay("Five minutes at the rostrum, and you could feel two rows of them stop reading their phones.",
            fx("moved " + hit.length + " members toward " + (dir>0?"aye":"no") + " · +3 influence","45 minutes"));
          note("Spoke on " + G.bill.title + ".");
        }
      }}]},
    {id:"table", label:"The clerk's table", sub:"Where an amendment gets filed", x:0, z:11.45, r:1.15,
     acts:()=>[{t:"File a floor amendment", c:"55m · 9 infl", off:!G.bill||G.bill.done||G.you.influence<9, run(){
        fileFloorAmendment(false); return;
      }}]},
    {id:"lectern", label:"The well lectern", sub:"Floor manager's stand in the aisle", x:0.55, z:9.15, r:2.0,
     acts:()=>[{t:"Take the well lectern", c:"20m", off:!G.bill||G.bill.done, run(){
        spend(20, 8);
        const dir = G.you.vote !== null ? G.you.vote : (alignment(G.you,G.bill)>0?1:-1);
        const hit = swayRoom(dir, 4, false);
        setSay("A short intervention from the aisle. The Speaker heard you; so did the first two rows.",
          fx("moved " + hit.length + " nearby","20 minutes"));
      }}]}
  ],
  press:[
    {id:"podium", label:"The gallery lectern", sub:"Two cameras and a room of people who write things down", x:0, z:8.6, r:1.7, minZ:8.75,
     acts:()=>[{t:"Hold a press conference", c:"45m", run(){
        spend(45, 18);
        const t = G.press.length ? G.press.reduce((s,p)=>s+p.trust,0)/G.press.length : 45;
        const good = (t*0.6 + G.you.approval*0.4 - tired() + rint(-18,18)) > 32;
        G.you.approval = clamp(G.you.approval + (good?7:-5), 0, 100);
        G.press.forEach(p => p.trust = clamp(p.trust + (good?3:-2),0,100));
        setSay(good ? "You gave them the line and they took it clean."
                    : "The third question was about something you hoped nobody had.",
          fx(good?"+7 approval, the lobby warms":"", good?"":"−5 approval"));
        note(good ? "The press conference went your way." : "The press conference got away from you.", !good);
      }}]},
    {id:"tv", label:"The gallery monitors", sub:"Rolling coverage, sound off", x:-2.4, z:5.0, r:2.0,
     acts:()=>[{t:"Watch the coverage", c:"15m", run(){
        spend(15, 3);
        setSay("National mood sits at " + (G.mood>0?"+":"") + Math.round(G.mood) + ", running " +
          (G.mood>6?"toward the Federalists":G.mood<-6?"toward the Commonwealth":"flat") +
          ". Your own number is " + Math.round(G.you.approval) + ".", fx("you know exactly where you stand","")); }}]}
  ],
  steps:[
    {id:"stump", label:"The top step", sub:"Where the cameras set up for a crowd", x:3.15, z:12.2, r:1.7,
     acts:()=>[{t:"Speak to the crowd", c:"40m", run(){
        spend(40, 16);
        const hot = G.secrets.filter(s => s.exposure > 14).length;
        if(hot && chance(0.5)){
          G.you.approval = clamp(G.you.approval-4,0,100);
          setSay("Somebody near the front shouted a question you did not want asked outdoors.",
            fx("","−4 approval · one of your secrets is close to the surface"));
        } else {
          G.you.approval = clamp(G.you.approval+6,0,100);
          setSay("Forty minutes on the steps and the local stations all carried it.", fx("+6 approval",""));
        }
      }}]}
  ],
  district:[
    {id:"diner", label:"The counter at Vaughn's", sub:"Coffee, and everybody who votes", x:-5.5, z:12.4, r:3.0,
     acts:()=>purseShopActs("diner").concat([{t:"Work the counter", c:"70m", run(){
        spend(70, 18);
        G.you.approval = clamp(G.you.approval+6,0,100);
        const c2 = pick(G.civ);
        if(c2) c2.caseOpen = true;
        setSay("Two hours of eggs and grievances. Somebody's brother needs a letter written.",
          fx("+6 approval · a new case worth taking","")); }}])},
    {id:"hq", label:"Campaign office", sub:"Folding tables, a phone bank, a whiteboard", x:5.8, z:12.4, r:3.0,
     acts:()=>[{t:"Organise for November", c:"100m", run(){
        spend(100, 24);
        const f = rint(8,16) + Math.round(G.you.approval/6);
        G.you.funds = clamp(G.you.funds+f,0,300);
        G.you.margin = Math.max(1, G.you.margin + 1);
        setSay("Lists, doors, and a volunteer who has been here since the first campaign.",
          fx("+"+f+" funds, +1 to your margin","100 minutes")); }}]},
    {id:"doffice", label:"Your district office", sub:"Where constituents come in, and where the war chest is spent", x:5.8, z:17.5, r:2.6,
     acts:()=>{ const y = G.you, A = [{t:"Open the war chest", c:"10m", run(){ spend(10, 1); chestCard(); }}];
       if(!y.dOffice) A.push({t:"Fund the office (a storefront with your name on it)", c:"15m", run(){ spend(15, 2); chestSpend("office"); }});
       else { A.push({t:"Hold constituent hours", c:"60m", run(){ spend(60, 12); y.approval = clamp(y.approval + 1.5, 0, 100); y.influence = clamp((y.influence || 0) + 0.5, 0, 100); setSay("Eleven people came in. Nine wanted a thing you cannot give and two wanted a thing you can. You wrote it all down.", fx("+1.5 approval","60 minutes")); }});
         if((y.staff || 0) < 3) A.push({t:"Hire an aide for the office", c:"15m", run(){ spend(15, 2); chestSpend("staff"); }});
         A.push({t:"Fund field operations from here", c:"15m", run(){ spend(15, 2); chestSpend("field"); }}); }
       return A; }},
    {id:"church", label:"The church on Main", sub:"Whatever you follow has a door here", x:5.6, z:8.2, r:2.4,
     acts:()=>[{t:"Read the parish notices", c:"10m", run(){ spend(10, 1); parishCard(); }}].concat((()=>{
       const cr = playerCreed();
       const k = (cr && cr.k) || "latin";
       if(k === "latin") return [{t:"Hear Mass", c:"25m", run(){
         spend(25, 4);
         G.you.energy = clamp((G.you.energy||50)+8, 0, 100);
         G.you.approval = clamp(G.you.approval+2, 0, 100);
         setSay("St. Brigid's is full of people who vote. The Mass is the Mass. Nobody asked you for a statement.",
           fx("+2 approval · you are quieter after",""));
       }}];
       if(k === "consul") return [{t:"Attend the chapel", c:"25m", run(){
         spend(25, 6);
         G.you.approval = clamp(G.you.approval-1, 0, 100);
         setSay("They keep the Latin and a lawgiver's precepts. God first, Christ the King, the Consul a man. The chaplain keeps an eye on them.",
           fx("","the district noticed you went in"));
       }}];
       if(k === "none") return [{t:"Stand in the old church", c:"15m", run(){
         spend(15, 2);
         setSay("They sold the pews. Recitals on Thursdays. You stand in the dust and nobody asks you to believe anything.",
           fx("",""));
       }}];
       return [{t:"Go in", c:"20m", run(){
         spend(20, 4);
         setSay(cr.t + " keeps this block. " + (cr.jab || cr.holds),
           fx("the district sees you among your own",""));
         G.you.approval = clamp(G.you.approval+2, 0, 100);
       }}];
     })())}
  ]
};

function memberActions(m){
  const A = [], b = G.bill, you = G.you;
  const live = b && !b.done;
  /* A private citizen has only their manner and their argument. */
  if(you.out){
    const cold = readOf(m).est < -14;
    A.push({t:"Introduce yourself again", c:"20m", run(){
      spend(20, 5);
      if(cold){ setSay("I know who you are. I have three minutes and I am using two of them to be polite.",
        fx("", "they have not forgotten")); ripple(m, 1, null, 0); }
      else { ripple(m, 4, "You came back to see me when you had nothing to trade.", 5, true);
        setSay("You are out and you still turn up. That is not nothing.", fx("+ some goodwill","")); }
    }});
    A.push({t:"Make the case for yourself", c:"35m", run(){
      spend(35, 12);
      const ok = (familiarity(m)*40 + m.rel.trust*0.4 + you.approval*0.3 - tired() + rint(-22,22)) > 34;
      if(ok){ ripple(m, 11, "You asked me to back you when you were nobody. I said I would.", 12, true);
        m.rel.trust = clamp(m.rel.trust+7,0,100);
        setSay("If you get on the ballot I will say a word for you. Quietly.", fx("they will back your return","")); }
      else { ripple(m, -3, "You came asking for a favour with nothing behind it.", -4);
        setSay("You are asking me to spend something I do not have on a man with no seat.", fx("","no")); }
    }});
    A.push({t:"Just talk", c:"15m", run(){
      spend(15, 3);
      ripple(m, 2, "We talked about nothing for a quarter of an hour. It was almost a relief.", 2);
      setSay(pick(["How is it in there?","Nobody tells you the truth until you lose.","Sit down. You look tired."]),
        fx("",""));
    }});
    A.push({t:"Leave it", exit:true, run(){ closeTalk(); }});
    return A;
  }

  A.push({t:"Talk shop", c:"15m", run(){
    spend(15, 3); m.known = Math.max(m.known,1);
    const d = 2 + Math.round(Math.random()*3);
    ripple(m, d, "You've made time for me more than once.", 2);
    m.rel.trust = clamp(m.rel.trust+1, 0, 100);
    const ax = pick(AXES), v = m.pos[ax.k];
    setSay(pick([
      "I came up as " + m.bg.replace(/^an? /,"") + ". You never really stop.",
      "My district went for me by " + m.margin + " last time. That number is the whole job.",
      "On " + ax.k + "? I'm " + (v>25?ax.hi:v<-25?ax.lo:"somewhere in the middle") + ", and I've never hidden it."
    ]), fx("+"+d+" warmth", ""));
  }});

  if(live) A.push({t:"Ask how they'll vote", c:"10m", off:m.known>=2, run(){
    spend(10, 2); m.known = 2;
    const v = memberVote(m,b), al = alignment(m,b);
    setSay(v>0 ? "Aye, as it stands. " + (al>20?"It's a good bill.":"Though I'm not thrilled about it.")
               : "No. " + (al<-30?"It's a bad bill and you know it.":"The leadership has been clear."),
      fx("", "reading taken"));
  }});

  if(live) A.push({t:"Ask for their vote", c:"25m", run(){
    spend(25, 8); m.known = 2;
    const mood = moodOf(m);
    const base = alignment(m,b)*0.5 + m.rel.warmth*0.5 + m.rel.trust*0.3 + mood.val*0.35
               + (you.post?18:0) + (you.standing-50)*0.16 - tired() + rint(-18,18);
    if(base > 22){
      m.pledge = 1; m.pledgeDay = G.day;
      m.rel.trust = clamp(m.rel.trust+3,0,100);
      remember(m, "I gave you my vote on the " + b.title.split(" ")[0] + " bill when you asked.", 5);
      setSay("All right. You have it. Don't make me regret it in the district.", fx("pledged AYE",""));
      note("Got a pledge from " + m.name + ".");
    } else if(base > -12){
      setSay("I'll think about it. That's not a no, and it isn't a yes.", fx("","no commitment"));
    } else {
      m.pledge = -1; m.pledgeDay = G.day;
      ripple(m, -2, "You leaned on me over a bill I couldn't defend at home.", -4);
      setSay("You're asking me to explain that vote at a fish fry in October. No.", fx("","hardened to NO"));
    }
  }});

  A.push({t:"Offer a favor", c:"20m", off:you.influence < 6, run(){
    spend(20, 6); you.influence -= 6; m.rel.debtFromYou++;
    const d = 9 + Math.round(Math.random()*7);
    ripple(m, d, "You put your name on my amendment when nobody else would.", 9, true);
    m.rel.trust = clamp(m.rel.trust+6,0,100);
    setSay("You'd do that? — Then I owe you one, and I pay what I owe.",
      fx("+"+d+" warmth · they owe you", "−6 influence"));
    note("Did a favor for " + m.name + ".");
  }});

  if(m.rel.debtFromYou > 0) A.push({t:"Call in the favor", c:"15m", run(){
    spend(15, 4); m.rel.debtFromYou--;
    if(live){ m.pledge = 1; m.pledgeDay = G.day; }
    ripple(m, -6, "You cashed me in. Fine — that ledger is clear now.", -3);
    setSay("I said I'd pay it. I'm paying it. We're square after this.", fx("pledged AYE","−6 warmth"));
  }});

  A.push({t:"Share credit on the bill", c:"30m", off:you.influence < 10 || !live, run(){
    spend(30, 9); you.influence -= 10;
    m.influence = clamp(m.influence+7,0,100);
    const d = 12 + Math.round(m.traits.vanity/8);
    ripple(m, d, "You gave me the podium on the " + b.title.split(" ")[0] + " bill. I remember that.", 11, true);
    if(chance(.6)){ m.pledge = 1; m.pledgeDay = G.day; }
    setSay("You'd let me announce it at home? — All right. All right, yes.",
      fx("+"+d+" warmth, +7 their influence","−10 influence"));
  }});

  if(m.party !== you.party) A.push({t:"Ask them to cross the aisle", c:"45m", risk:true, off:you.influence < 20, run(){
    spend(45, 14); you.influence -= 12;
    const pull = m.rel.warmth*0.7 + memValence(m)*0.5 + (60-m.traits.loyalty)*0.8
               + ((m.party==="FED" ? -G.mood : G.mood))*0.6 + (m.margin<8?12:-8) - tired() + rint(-20,20);
    if(pull > 55){
      switchParty(m, you.party);
      remember(m, "You gave me somewhere to go when my own people had no use for me.", 22, true);
      setSay("I've been sitting with the wrong people for two years. Draw up the statement.",
        fx("CROSSES THE AISLE","−12 influence"));
      note(m.name + " crosses the aisle to the " + partyName(you.party) + ".", true);
    } else if(pull > 15){
      m.rel.trust = clamp(m.rel.trust+4,0,100);
      remember(m, "You asked me to switch. I haven't told anyone. Yet.", 3, true);
      makeSecret("You tried to recruit " + m.name + " out of their own party.", m, [m], 3);
      setSay("Ask me again after November. I mean that — ask me again.", fx("","not yet · they know something now"));
    } else {
      ripple(m, -18, "You tried to buy me out of my own party.", -16, true);
      makeSecret("You tried to recruit " + m.name + " out of their own party.", m, [m], 9);
      setSay("Get out. And if you say that to me again I'll say it into a microphone.",
        fx("","−18 warmth · a secret you now carry"));
    }
  }});

  A.push({t:"Back them for a post", c:"25m", off:you.influence < 14, run(){
    spend(25, 7); you.influence -= 14;
    m.influence = clamp(m.influence+12,0,100); m.rel.debtFromYou++;
    const d = 10 + Math.round(m.traits.ambition/7);
    ripple(m, d, "You backed me for the chairmanship. That is not a small thing.", 14, true);
    setSay("You'd put your weight behind me? Then I'm in your debt, plainly.",
      fx("+"+d+" warmth · they owe you","−14 influence"));
  }});

  if(m.party === you.party) A.push({t:"Threaten a primary", c:"20m", risk:true, run(){
    spend(20, 10);
    const scared = (60-m.traits.temper)*0.5 + (30-m.margin)*1.2 + (you.post?20:0)
                 + (you.standing-50)*0.3 - tired() + rint(-20,20);
    makeSecret("You threatened " + m.name + " with a primary challenge.", m, [m], scared>20?6:12);
    if(scared > 20){
      if(live){ m.pledge = 1; m.pledgeDay = G.day; }
      ripple(m, -22, "You threatened to primary me. I will carry that to the grave.", -26, true);
      m.rel.trust = clamp(m.rel.trust-14,0,100);
      setSay("...Fine. You'll get your vote. And I will remember this exact conversation.",
        fx("pledged AYE","−22 warmth · permanent grudge · a secret"));
    } else {
      if(live){ m.pledge = -1; m.pledgeDay = G.day; }
      ripple(m, -26, "You threatened me and I dared you to try.", -28, true);
      you.approval = clamp(you.approval-3,0,100);
      setSay("Try it. Bring money. I'll beat your candidate by thirty and then I'll come for your gavel.",
        fx("","hardened to NO · −26 warmth · a secret"));
    }
  }});

  const t = topMemory(m);
  if(t && memWeight(m,t) < -8) A.push({t:"Make amends", c:"35m", run(){
    spend(35, 8);
    const ok = (m.rel.trust*0.5 - m.traits.conviction*0.2 + 30 - tired() + rint(-18,18)) > 20;
    if(ok){
      t.w *= 0.35;
      ripple(m, 12, "You came and said it to my face. That counted for something.", 8, true);
      setSay("I'm not going to pretend it didn't happen. But — thank you for saying it.",
        fx("old grievance softened, +12 warmth",""));
    } else {
      m.rel.warmth = clamp(m.rel.warmth-3,-100,100);
      setSay("An apology is cheap and you know it. Come back with something that costs you.", fx("","not accepted"));
    }
  }});

  if(!FAITH_FROZEN(m)){
    A.push({t:"Let them talk", c:"10m", noReact:true, run(){
      spend(10, 1);
      let line = "";
      try{ line = DTCNO.say(m, {}); }catch(e){}
      if(!line) line = "Nothing worth the wire today.";
      try{ netTrain(m, {intent:"greet", heat:0, topics:["talk"]}); }catch(e){}
      G.listened = (G.listened || 0) + 1; try{ if(G.listened >= 10) achieve("listen"); }catch(e){}
      setSay(line, fx("", ""));
      try{ speakAt(m, line); }catch(e){}
    }});
    A.push({t:"Ask what has been on their mind", c:"10m", run(){
      spend(10, 2);
      const line = lifeMindLine(m);
      ripple(m, 1, null, 0);
      setSay(line, fx("", "they told you more than they meant to"));
    }});
    A.push({t:"Ask about their faith", c:"10m", run(){
      spend(10, 2);
      const f = faithMember(m), c = creedOf(m.creed);
      let line = c.k === "none" ? "I do not go. I am not hostile about it. I am just not there."
        : "I am " + c.adj + ". I " + faithWord(f).replace(/^goes/, "go").replace(/^has /, "have ").replace(/^steady, and goes/, "am steady, and go").replace(/^devout/, "am devout") + ".";
      if(f.was && f.since >= (G.day || 1) - 12) line += " I was " + creedOf(f.was).adj + " until recently. People ask. I tell them it was not about the House.";
      if(m.creed === "consul") line += " We keep the Latin. The chaplain will not give us the Host. God is the Most High; we do not say otherwise to his face.";
      if(G.you && G.you.creed === m.creed) ripple(m, 2, "We talked about where we kneel. Same pew, as it turns out.", 2);
      setSay(line, fx("", ""));
    }});
  }
  A.push({t:"Walk away", exit:true, run(){ closeTalk(); }});
  return A;
}

function pressActions(p){
  const you = G.you;
  return [
    {t:"Give a quote", c:"15m", run(){
      spend(15, 3);
      const good = (p.trust + you.approval)/2 > 46 || chance(.35);
      you.approval = clamp(you.approval + (good?3:-2),0,100);
      p.trust = clamp(p.trust + (good?2:-1),0,100);
      setSay(good ? "“The bill is the bill.” I can work with that."
                  : "That's a quote that writes its own headline, and not for you.",
        fx(good?"+3 approval":"", good?"":"−2 approval"));
    }},
    {t:"Background briefing", c:"25m", off:you.influence < 5, run(){
      spend(25, 6); you.influence -= 5;
      p.trust = clamp(p.trust+5,0,100);
      const soft = G.members.filter(m => m.known>=2 && G.bill && memberVote(m,G.bill)<0 && m.party===you.party);
      you.approval = clamp(you.approval+2,0,100);
      setSay(soft.length ? "Off the record: your own trouble is " + listify(soft.slice(0,3).map(m=>surname(m.name))) + "."
                         : "Off the record, you don't have a whip problem. You have a bill problem.",
        fx("+2 approval, +5 their trust","−5 influence"));
    }},
    {t:"Plant a story", c:"30m", risk:true, off:you.influence < 12, run(){
      spend(30, 12); you.influence -= 12;
      const targets = G.members.filter(m => m.party !== you.party && m.influence > 20);
      if(!targets.length){ setSay("Nothing to plant. Everyone's behaving.", ""); return; }
      const t = pick(targets);
      makeSecret("You planted the story about " + t.name + ".", t, [p], p.trust>55?4:10);
      if(chance(0.42 + p.trust/220)){
        t.influence = clamp(t.influence-14,0,100);
        ripple(t, -6, null, 0);
        setSay("It'll run Thursday, sourced to “members familiar.” " + surname(t.name) + " will have a week of it.",
          fx("−14 to their influence","−12 influence · a secret you now carry"));
        note("A story about " + t.name + " appeared in " + p.outlet + ".");
      } else {
        ripple(t, -30, "You planted that story about me. I know it was you.", -34, true);
        you.approval = clamp(you.approval-7,0,100);
        setSay("It ran. It also got traced back to this room inside a day.",
          fx("","−7 approval · " + surname(t.name) + " knows"));
        note("Your fingerprints were found on the " + t.name + " story.", true);
      }
    }},
    {t:"Nothing today", exit:true, run(){ closeTalk(); }}
  ];
}

function civActions(c){
  if(c && c.chamber) return kChamberActs(c);
  if(c && c.hh) return hhActs(c);
  const you = G.you;
  const A = [
    {t:"Hear them out", c:"30m", run(){
      spend(30, 6);
      you.approval = clamp(you.approval+4,0,100);
      setSay("It's about " + c.cause + ". Nobody from your office has come out here in eleven months.",
        fx("+4 approval",""));
      note("Took a meeting about " + c.cause + ".");
    }}
  ];
  if(c.caseOpen) A.push({t:"Take the case", c:"60m", off:you.influence < 4, run(){
    spend(60, 12); you.influence -= 4; c.caseOpen = false;
    G.casework.push({cause:c.cause, who:c.name, due:G.day + rint(3,7)});
    setSay("You'll actually file it? — Then I'll tell everyone at the plant you did.",
      fx("casework opened — it pays off in a few days","−4 influence"));
    note("Opened casework on " + c.cause + ".");
  }});
  A.push({t:"Hold a town hall", c:"90m", run(){
    spend(90, 22);
    const ok = you.approval > 40 - tired() || chance(.45);
    you.approval = clamp(you.approval + (ok?8:-5),0,100);
    setSay(ok ? "Two hundred people, and you got a hand at the end."
              : "Two hundred people, and forty of them came to shout.",
      fx(ok?"+8 approval":"", ok?"":"−5 approval"));
    note(ok ? "The town hall went well." : "The town hall got away from you.", !ok);
  }});
  A.push({t:"Raise money", c:"120m", run(){
    spend(120, 20);
    const got = rint(6,18) + Math.round(G.you.influence/4);
    you.funds = clamp(you.funds + got, 0, 300);
    you.approval = clamp(you.approval-2,0,100);
    const ax = pick(AXES);
    const want = chance(.5) ? 70 : -70;
    G.donors.push({name:pick(["Coalport Mutual","Tri-State Growers","Local 344","The Hargreave Trust",
      "Dunmore Freight","Riverbend Physicians","Pinevale Energy"]), axis:ax.k, want, given:got, day:G.day});
    setSay("A room of forty and a rubber chicken. They mentioned " + ax.n.toLowerCase() + " nine times.",
      fx("+"+got+" funds","−2 approval · they expect something"));
  }});
  A.push({t:"Move along", exit:true, run(){ closeTalk(); }});
  return A;
}

function switchParty(m, to){
  const from = m.party;
  G.seatsBy[from]--; G.seatsBy[to]++;
  m.party = to; m.post = null;
  m.rel.warmth = clamp(m.rel.warmth+25,-100,100);
  m.traits.loyalty = clamp(m.traits.loyalty-10,0,100);
  G.members.forEach(o => { if(o!==m && o.party===from) o.rel.warmth = clamp(o.rel.warmth-4,-100,100); });
  if(m.mesh && !houseQuiet()){ m.mesh = null; markRenderDirty(); }
  assignPosts(false);
}

/* ══════════════════════════════════════════════════════════
   12 · THE VOTE
   ══════════════════════════════════════════════════════════ */
const veil = el("veil"), card = el("card");
function holdVote(){
  const b = G.bill; if(!b || b.done) return;
  b.done = true; closeTalk(); G.running = false;
  const present = inHouse() && (G.room === "floor" || G.you.vote !== null);
  try{ const Gs = goalsEnsure(); if(Gs && G.room === "floor") Gs.rollcall = true; goalsTick(); }catch(e){}
  let yourVote = G.you.vote !== null ? G.you.vote : (alignment(G.you,b) > 0 ? 1 : -1);
  /* Taylor Day: tradition is the line — defiance at roll call is blasphemy (player may still *ask* about dissent in talk) */
  if(present && isTaylorDay()){
    try{ taylorDayVoteDefiance(yourVote, b); }catch(e){}
  }
  G.you.vote = present ? yourVote : null;
  const t = tallyBill(b, false);
  const housePassed = t.aye > t.no;
  /* 20261025i: what the House carries goes to the Senate, seat by seat, before it can reach the President */
  let sen = null; try{ if(housePassed && typeof lxSenate === "function") sen = lxSenate(b); }catch(e){ sen = null; }
  b._sen = sen;
  const passed = housePassed && (!sen || sen.ok);
  const line = partyLine(b)[G.you.party];

  const kept = [], broke = [];
  G.members.forEach(m => {
    if(m.pledge && G.day - m.pledgeDay < 8){
      const actual = memberVote(m,b);
      if(actual === m.pledge) kept.push(m);
      else {
        broke.push(m);
        m.rel.trust = clamp(m.rel.trust-12,0,100);
        remember(m, "I broke a promise to you on the " + b.title.split(" ")[0] + " bill and we both know it.", -6, true);
      }
    }
    m.pledge = null;
  });

  const dFit = districtFit(b), oFit = alignment(G.you, b);
  if(present){
    G.you.record.votes.push({id:b.id, title:b.title, pos:{econ:b.pos.econ,lib:b.pos.lib,def:b.pos.def,wel:b.pos.wel},
      vote:yourVote, day:G.day, passed});
    /* COLLAB HOOK: record style for active seat */
    try{ if(typeof TLSCollab !== "undefined") TLSCollab.recordVote(b, yourVote, line !== 0 && line !== yourVote); }catch(e){}
    if(line !== 0 && line !== yourVote){ G.you.standing = clamp(G.you.standing-8,0,100); G.you.record.partyBreaks++; }
    else G.you.standing = clamp(G.you.standing+3,0,100);
    if((oFit>0) !== (yourVote>0)) G.you.record.conscience++;
    const districtHit = ((dFit>0) === (yourVote>0)) ? 2 : -4;
    G.you.approval = clamp(G.you.approval + districtHit, 0, 100);
    /* donors notice how you voted on the thing they bought a table for */
    G.donors.forEach(d => {
      const wantAye = (d.want > 0) === (b.pos[d.axis] > 0);
      if(Math.abs(b.pos[d.axis]) > 35 && (wantAye ? yourVote<0 : yourVote>0)){
        d.angry = true;
        G.you.funds = clamp(G.you.funds - 6, 0, 300);
      }
    });
    if(passed === (yourVote>0)){ G.you.influence = clamp(G.you.influence + 6 + kept.length,0,100); G.you.record.bills++; }
    else G.you.influence = clamp(G.you.influence-4,0,100);
    /* carrying your own bill is the single biggest thing you can do */
    if(b.mine){
      if(passed){
        G.you.influence = clamp(G.you.influence + 16, 0, 100);
        G.you.standing = clamp(G.you.standing + 8, 0, 100);
        G.you.approval = clamp(G.you.approval + 5, 0, 100);
        G.you.record.sponsored = (G.you.record.sponsored||0) + 1;
        setPrecedent("carried a bill of their own", "that a backbencher may carry a bill without the leadership");
        hearsAll(G.you.name + " carried their own bill.");
      } else {
        G.you.influence = clamp(G.you.influence - 8, 0, 100);
        G.you.standing = clamp(G.you.standing - 5, 0, 100);
        hearsAll(G.you.name + "'s bill went down.");
      }
    }
  } else if(inHouse()){
    G.you.approval = clamp(G.you.approval-6,0,100);
    G.you.influence = clamp(G.you.influence-5,0,100);
    G.you.standing = clamp(G.you.standing-5,0,100);
  }
  G.mood = clamp(G.mood + (passed ? (b.sponsorParty==="FED"?4:-4) : 0) + rint(-3,3), -60, 60);
  try{ billConsequences(b, passed, yourVote); }catch(e){ if(window.console) console.warn("billConsequences", e); }
  if(passed){ G.lastActs = G.lastActs || []; G.lastActs.unshift({title:b.title, day:G.day, kind:b.kind || null, target:b.target || null, pos:b.pos ? {econ:b.pos.econ, lib:b.pos.lib, def:b.pos.def, wel:b.pos.wel} : null}); if(G.lastActs.length > 6) G.lastActs.length = 6; }
  G.you.record.defections += broke.length;

  /* the other two branches get their say */
  let fate = passed ? "carried" : housePassed ? "senate" : "rejected", extra = sen ? "<p><strong>The Senate " + (sen.ok ? "concurred" : "rejected it") + ", " + sen.aye + " to " + sen.no + (sen.tie ? ", the Vice President breaking the tie" : "") + ".</strong></p>" : "";
  if(passed){
    const v = execVeto(b, t); b._veto = v ? {by:v.by, override:!!v.override} : null;   /* 20261025h: the statute book keeps it */
    if(v){
      if(v.override){
        extra = "<p><strong>" + execTitle() + " " + v.by + " vetoed it and the House overrode them</strong>, " +
          t.aye + " to " + t.no + ". That is a two-thirds House and everybody now knows it.</p>";
        setPrecedent("overrode a veto", "that two thirds of the House is the end of the argument", true, "The House");
      } else {
        fate = "vetoed"; extra = "<p><strong>" + execTitle() + " " + v.by + " vetoed it.</strong> " +
          "The House did not have the two thirds to answer back.</p>";
        G.exec.vetoes++;
      }
    }
    if(fate === "carried"){
      const ct = courtTest(b);
      if(ct && !ct.ignored){
        fate = "struck down";
        extra += "<p><strong>The court struck it down</strong>, " + ct.strike + " to " +
          (G.court.length - ct.strike) + ". It never took effect.</p>";
      } else if(ct && ct.ignored){
        extra += "<p><strong>The court objected and was ignored.</strong> Nobody enforced the ruling, " +
          "and that is now simply how it is done.</p>";
        setPrecedent("let a ruling go unenforced", "that a ruling the House dislikes need not be obeyed", true, "The House");
      }
    }
  }
  const inForce = fate === "carried";
  billHitsStates(b, inForce);
  /* the statute book: every bill this House actually decided, with the
     reason it was filed and what it does, kept for good */
  if(!G.statute) G.statute = [];
  G.statute.unshift({
    title:b.title, congress:G.congress, day:G.day, aye:t.aye, no:t.no,
    fate, why:b.why || b.line, clauses:b.clauses ? b.clauses.slice() : null,
    sponsor:b.sponsor, state:b.state || null, cost:b.cost || 0,
    v:t.roll || null, yv:present ? yourVote : null           /* 20261025g: the named members' votes as the clerk called them, and yours */
  });
  if(G.statute.length > onumLim(80,"hist")) G.statute.length = onumLim(80,"hist");

  try{
    feed("ROLL CALL — " + b.title + ". The clerk rises. Galleries lean.");
    note("Roll call: " + b.title + " — " + t.aye + " aye, " + t.no + " no" + (present ? (yourVote>0 ? ", you aye" : ", you no") : inHouse() ? ", you absent" : "") + ".", true);
    journal("Roll call on " + b.title + ": " + (housePassed ? "carried" : "rejected") + " " + t.aye + "–" + t.no + (sen ? "; Senate " + (sen.ok ? "passed" : "rejected") + " " + sen.aye + "–" + sen.no : "") +
      (present ? (" · you " + (yourVote>0?"aye":"no")) : inHouse() ? " · you not voting" : "") + ".");
    pushWireScrap("Floor", b.title + " — " + (housePassed ? "CARRIED" : "REJECTED") + " " + t.aye + "–" + t.no);
    if(G.room === "floor"){
      feed(passed ? "Cheers from one side, silence from the other — then the other way round."
                  : "A groan under the gallery. Somebody drops a pencil like a gavel.");
    } else if(!present && inHouse()){
      feed("You hear the result from another room. That is its own kind of judgement.");
    }
    if(present) markDay(passed === (yourVote>0) ? "helped" : "hurt", "roll call " + b.title.split(" ")[0], null);
    else if(inHouse()) markDay("ignored", "roll call " + b.title.split(" ")[0], null);
  }catch(err){}
  card.innerHTML =
    '<div class="eyebrow">Roll call no. ' + (400+b.id) + ' · ' + hhmm() + '</div>' +
    '<h1>' + (passed ? "The bill is passed." : housePassed ? "The House passed it. The Senate did not." : "The bill is rejected.") + '</h1>' +
    '<p class="dream">' + b.title + '</p>' +
    '<div class="count"><div class="c-aye"><i>Ayes</i><b>'+t.aye+'</b></div>' +
      '<div class="c-no"><i>Noes</i><b>'+t.no+'</b></div>' +
      '<div class="c-un"><i>Not voting</i><b>'+t.un+'</b></div></div>' +
    '<div class="countbar"><span style="width:'+(t.aye/G.seats*100)+'%;background:var(--good)"></span>' +
      '<span style="width:'+(t.no/G.seats*100)+'%;background:var(--bad)"></span>' +
      '<span style="width:'+(t.un/G.seats*100)+'%;background:var(--line)"></span></div>' +
    '<p style="margin-top:14px">' + (present
      ? "You voted <strong>" + (yourVote>0?"aye":"no") + "</strong>. Your district reads that as <strong>" +
        (((dFit>0)===(yourVote>0)) ? "one of theirs" : "a vote you will be asked about") + "</strong>" +
        (line !== 0 && line !== yourVote ? ", and the leadership noticed you were not with them." : ".")
      : inHouse() ? "<strong>You were not on the floor.</strong> The clerk recorded you as not voting, and the wire noticed."
      : "The House voted without you. You are " + officeTitle() + " now; it is their bill, and its consequences are yours to manage.") + '</p>' +
    extra +
    (kept.length ? '<p><strong>Kept their word:</strong> ' + listify(kept.map(m=>m.name)) + '.</p>' : '') +
    (broke.length ? '<p><strong>Broke their word:</strong> ' + listify(broke.map(m=>m.name)) + '. You will remember that; so will they.</p>' : '') +
    '<div class="card__actions"><button class="btn" type="button" id="okVote">Back to the floor</button></div>';
  veil.hidden = false;
  el("okVote").addEventListener("click", () => {
    walkNow();
    G.you.vote = null;
    note((passed ? "Passed" : housePassed ? "Passed the House, failed in the Senate" : "Failed") + ": " + b.title + " — " + t.aye + " to " + t.no + (sen ? " in the House, " + sen.aye + " to " + sen.no + " in the Senate" : "") + ".", true);
    feed("The clerk closes the book on " + b.title + ". The building exhales and starts the next argument.");
    laterHouse(() => {
      try{ paintTicker(); }catch(e){}
      try{ G.bill = nextBillOrQueued(); }catch(e){}
      try{ queueSave(); }catch(e){}
    });
  });
  /* not a member: the House's roll call does not stop your day */
  if(!inHouse()){ try{ el("okVote").click(); }catch(e){} }
}

/* ══════════════════════════════════════════════════════════
   13 · NIGHT · ELECTION · LEADERSHIP
   ══════════════════════════════════════════════════════════ */
function note(text, big){
  try{ G._lNote = true; }catch(e){}
  G.journal.unshift({d:G.day, t:text, big:!!big});
  if(G.journal.length > onumLim(120,"cap")) G.journal.pop();
  feed(text, big ? "big" : "");
}
/* The running record: nothing happens without leaving a line behind. */
function feed(text, kind){
  try{ loreScan(typeof text === "string" ? text : (text && text.t) || ""); }catch(e){}
  text = wallScrub(text);
  G.feed.unshift({t:text, at:hhmm(), kind:kind||"", born:G.t});
  try{ lLog(text, kind); }catch(e){}
  if(G.feed.length > onumLim(8,"hist")) G.feed.pop();
  feedDirty = true;
}
/* the wire is rebuilt a few times a minute, not on every notice */
let feedDirty = false, feedT = 0;
function feedTick(dt){
  if(!feedDirty) return;
  feedT -= dt;
  if(feedT > 0) return;
  feedT = 2.5; feedDirty = false;
  try{ paintTicker(); }catch(e){}
}
function paintFeed(){
  /* The feed used to print itself over the top right of the room, where
     it covered the thing you were looking at and clipped its own words.
     What it had to say now runs along the wire at the bottom, which is
     where news belongs and where there is room for the whole sentence. */
  const box = el("feed");
  if(!box) return;
  box.hidden = true;
  return;
  /* three at a time. More than that and you are reading the corner of
     the screen instead of looking at the room. */
  setHTML(box, G.feed.slice(0,3).map((e,i) =>
    '<div class="' + (i > 0 ? "is-old" : "") + '"><u>' + e.at.replace(" ","") + '</u> ' + e.t + '</div>').join(""));
}

/* ── moving between rooms without a cut ───────────────────── */
function transition(build){
  /* A second travel click while the fade is in progress used to queue
     another room build behind the first one, leaving the input layer and
     fade veil out of sync. Ignore duplicate requests until this seam is
     complete. */
  if(G.moving) return;
  const f = el("fade");
  G.moving = true;
  G._moveAt = (typeof performance !== "undefined" && performance.now) ? performance.now() : Date.now();
  let settled = false;
  const settle = () => {
    if(settled) return;
    settled = true;
    G.moving = false;
    G._moveAt = 0;
    try{
      if(f){
        f.style.transition = "opacity .5s ease";
        f.style.opacity = "0";
      }
    }catch(e){}
    try{ queueSave(); }catch(e){}
  };
  try{
    if(f){
      f.style.transition = "opacity .18s ease";
      f.style.opacity = "1";
      f.style.pointerEvents = "none";
    }
  }catch(e){}
  setTimeout(() => {
    try{
      const pending = build();
      if(pending && typeof pending.then === "function"){
        pending.then(() => {
          try{
            cam.drift = -0.09;
            cam.vx = cam.vz = cam.yawVel = 0;
            G.doorGrace = G.t + 0.9;
          }catch(e){}
          settle();
        }, (e) => {
          if(window.console) console.warn("transition staged build", e);
          settle();
        });
        return;
      }
    }catch(e){
      if(window.console) console.warn("transition build", e);
    }
    try{
      cam.drift = -0.09;                  /* settle down into the room */
      cam.vx = cam.vz = cam.yawVel = 0;
      G.doorGrace = G.t + 0.9;            /* don't fall straight back out */
    }catch(e){}
    settle();
  }, 270);
  /* A failed/aborted room build must never leave a permanent black veil. */
  setTimeout(settle, 1800);
}
function rebuildRoomStaged(id, after){
  return new Promise((resolve, reject) => {
    /* Not a bare rAF: a hidden/backgrounded window never delivers one, and
       this is what finishes a room transition. See nextFrameOrTimeout. */
    nextFrameOrTimeout(() => {
      try{
        buildRoom(id);
      }catch(e){ reject(e); return; }
      syncPeopleStaged((e) => {
        if(e){ reject(e); return; }
        try{ if(after) after(); }catch(err){ reject(err); return; }
        resolve();
      });
    });
  });
}
function overnight(){
  const news = [];
  G.mood = clamp(G.mood + rint(-6,6), -60, 60);
  progTick();
  driftGuilder(news);
  /* unrest drifts on its own, and the worst state makes the news */
  G.states.forEach(s => { s.unrest = clamp(s.unrest + rint(-3,4) - (s.ind > 70 ? 1 : 0), 0, 100); });
  const hot = G.states.slice().sort((a,b) => b.unrest - a.unrest)[0];
  if(hot && hot.unrest > 72 && chance(.4))
    news.push("Trouble in " + hot.n + " again — unrest at " + Math.round(hot.unrest) + " and the governor is asking for federal help.");
  seedStateBills();
  try{ faithNight(news); }catch(e){ if(window.console) console.warn("faithNight", e); }
  try{ lifeNight(news); }catch(e){ if(window.console) console.warn("lifeNight", e); }
  try{ echoNight(news); achDaily(); }catch(e){ if(window.console) console.warn("echoNight", e); }
  try{ lNight(news); }catch(e){ if(window.console) console.warn("lNight", e); }
  resolveStateBills(news);
  try{ dualTick(news); }catch(e){}
  regimeCheck(news);
  regimeCheck(news);
  agesSecrets(news);
  for(let i=G.casework.length-1;i>=0;i--){
    const c2 = G.casework[i];
    if(G.day >= c2.due){
      G.casework.splice(i,1);
      G.you.approval = clamp(G.you.approval + rint(5,9), 0, 100);
      news.push("The " + c2.cause + " case came good. Word travels at home.");
      try{ lCaseDone(c2, news); }catch(e){}
    }
  }
  G.members.forEach(m => {
    if(!m || m.machine || m.sanctioned || m.kind === "envoy") return;
    m.rel.warmth = clamp(m.rel.warmth*0.985, -100, 100);
    if(chance(.3)) m.known = Math.max(0, m.known-1);
    if(MODEST) return;
    const strain = memValence(m)*-0.2 + (60-m.traits.loyalty)*0.4
                 + ((m.party==="FED" ? -G.mood : G.mood))*0.3 - 34;
    if(strain > 22 && chance(.10)){
      const to = m.party==="FED" ? "COM" : "FED";
      const from = m.party;
      switchParty(m, to);
      news.push(m.name + " left the " + partyName(from) + " and now sits with the " + partyName(to) + ".");
    }
    if(!m.retiring && m.kind !== "envoy" && chance(.004) && m.terms > 6){
      /* 20261027b: they serve until the election; the seat opens then, not tonight */
      m.retiring = G.day;
      news.push(m.name + " announced they will not seek another term, and will serve until the election.");
    }
  });
  if(!MODEST){
    G.members = G.members.filter(m => !m.gone);
    wireGraph();
    if(G.members.filter(m=>m.post).length < POSTS.length) assignPosts(false);
  }
  const angry = G.donors.filter(d => d.angry).length;
  if(angry && chance(.5)) news.push(angry + " of your donors have stopped returning calls.");
  /* 20261027b: the overnight line is drawn from the record (the week's polls, the committee calendar), not invented */
  try{ const c = nightColour(); if(c) news.push(c); }catch(e){}
  /* Personal overnight fallout from today's helped / hurt / ignored. */
  try{
    const M = G.dayMark;
    if(M && M.day === G.day){
      const helpedN = (M.helped||[]).length, hurtN = (M.hurt||[]).length, ignN = (M.ignored||[]).length;
      if(helpedN){
        const warm = (G.members||[]).filter(m => m.rel && m.rel.warmth > 15).slice(0, 3);
        warm.forEach(m => { m.rel.warmth = clamp(m.rel.warmth + 2, -100, 100); remember(m, "You showed up where it mattered today.", 3); });
        if(G.you) G.you.approval = clamp(G.you.approval + Math.min(4, helpedN), 0, 100);
        news.push("Overnight: word of who you helped travels — " +
          M.helped.slice(0,2).map(x=>x.t).join("; ") +
          (helpedN > 2 ? "…" : "") + ".");
      }
      if(hurtN){
        const cold = (G.members||[]).filter(m => m.rel && m.rel.warmth < 5).slice(0, 3);
        cold.forEach(m => { m.rel.warmth = clamp(m.rel.warmth - 3, -100, 100); remember(m, "You cost somebody today. I heard.", -4, true); });
        if(G.you) G.you.standing = clamp(G.you.standing - Math.min(3, hurtN), 0, 100);
        news.push("Overnight: someone you hurt is still awake — " +
          M.hurt.slice(0,2).map(x=>x.t).join("; ") + ".");
      }
      if(ignN){
        if(G.you){
          G.you.influence = clamp(G.you.influence - Math.min(4, ignN), 0, 100);
          G.you.standing = clamp(G.you.standing - Math.min(3, ignN), 0, 100);
        }
        news.push("Overnight: empty chairs get written up — " +
          M.ignored.slice(0,2).map(x=>x.t).join("; ") + ".");
        pushWireScrap("Morning", "Absences from yesterday still on the wire");
      }
      if(!helpedN && !hurtN && !ignN && chance(.4)){
        news.push("Overnight: a quiet day leaves less residue. Enjoy it while it lasts.");
      }
    }
  }catch(e){}
  return news;
}
function nightfall(){
  G.running = false; try{ closeTalk(); }catch(e){}
  const late = (G.minute || 0) > 22*60 + 60;
  const members = G.members || [];
  const warm = members.filter(m => m && m.rel && m.rel.warmth > 35).length;
  const cold = members.filter(m => m && m.rel && m.rel.warmth < -25).length;
  const line = "I came in at eight and I am leaving at ten. " +
    (warm ? warm + " of them would take my call tonight" : "Nobody would take my call tonight") + "; " +
    (cold ? cold + " would let it ring." : "and nobody is actively avoiding me, which is its own kind of nothing.");
  const b = G.bill;
  const M = (G.dayMark && G.dayMark.day === G.day) ? G.dayMark : null;
  const dayBits = [];
  if(M){
    if((M.attended||[]).length) dayBits.push("You showed for " + M.attended.length + ".");
    if((M.ignored||[]).length) dayBits.push("You left " + M.ignored.length + " empty.");
    if((M.helped||[]).length) dayBits.push("Helped: " + M.helped.slice(0,2).map(x=>x.t).join("; ") + ".");
    if((M.hurt||[]).length) dayBits.push("Hurt: " + M.hurt.slice(0,2).map(x=>x.t).join("; ") + ".");
  }
  const paintNight = (news) => {
    news = news || [];
    try{ feed("Nightfall. The building keeps score whether you do or not."); }catch(e){}
    card.innerHTML =
      '<div class="eyebrow">' + dateString() + " · " + dayLabel() + '</div>' +
      '<h1>Ten o’clock.</h1>' +
      '<p class="dream">' + line + '</p>' +
      (dayBits.length ? '<p><strong>Today’s residue:</strong> ' + dayBits.join(" ") + '</p>' : '') +
      (function(){ try{ const Gs = G.goals; if(!Gs || Gs.day !== G.day) return ""; const n = Gs.list.filter(g => g.done).length;
        return '<p><strong>Aims:</strong> ' + n + ' of ' + Gs.list.length + ' met.</p>' + goalsHTML(); }catch(e){ return ""; } })() +
      (b && !b.done ? '<p>On the calendar: <strong>' + b.title + '</strong>, roll call in ' +
        Math.max(0, b.voteDay-G.day) + ' day' + (b.voteDay-G.day===1?'':'s') + '.</p>' : '') +
      ((G.secrets||[]).length ? '<p>You are carrying <strong>' + G.secrets.length + '</strong> ' +
        (G.secrets.length===1?'thing':'things') + ' you would rather not read about.</p>' : '') +
      (news.length ? '<h2>Overnight</h2>' + news.map(n=>'<p>'+n+'</p>').join("") : '') +
      '<div class="card__actions"><button class="btn" type="button" id="okNight" data-gp="night:sleep">Sleep</button></div>';
    veil.hidden = false;
    const on = el("okNight");
    if(on) on.addEventListener("click", () => {
      if(nextDay._busy) return;
      on.disabled = true;
      on.textContent = "Sleeping…";
      try{ nextDay(late); }
      catch(e){ if(window.console) console.warn("okNight", e); nextDay._busy = false; softUnstickVeil(); G.running = true; }
    });
    markPicks();
  };
  paintNight([]);
  yieldPaint(() => {
    let news = [];
    try{ worldTick(news); }catch(e){}
    try{ news = (overnight() || []).concat(news); }catch(e){}
    paintNight(news);
  });
}
function nextDay(late){
  /* Clock first. Morning card next. Diary after the card is on screen.
     Remeshing on Sleep is what froze Edge. */
  if(nextDay._busy) return;
  nextDay._busy = true;
  G.running = false;
  try{
    const h = card.querySelector("h1");
    if(h) h.textContent = "The House is settling.";
    const dream = card.querySelector("p.dream");
    if(dream) dream.textContent = "Doors close. Morning comes when it is ready.";
    const acts = card.querySelector(".card__actions");
    if(acts) acts.innerHTML = '<button class="btn" type="button" disabled>Sleeping…</button>';
  }catch(e){}
  const showMorning = () => {
    if(!nextDay._busy) return;
    nextDay._busy = false;
    try{ dayPlanCard(); }catch(e){
      if(window.console) console.warn("dayPlanCard", e);
      softUnstickVeil(); G.running = true;
    }
  };
  try{
    G.day = (G.day || 0) + 1; G.sittingDay = (G.sittingDay || 0) + 1; G.minute = 8*60; G.pendingNight = false;
    G.dayMark = {day:G.day, helped:[], hurt:[], attended:[], ignored:[], scraps:[]};
    G.wireScraps = [];
    G.lastAmbientHour = -1;
    if(G.you) G.you.energy = clamp(late ? 78 : 100, 0, 100);
    if(G.recessLeft > 0) G.recessLeft--;
    try{ realmTick(); }catch(e){}
    try{ riteDay(); }catch(e){}
    try{ riteYouDay(); }catch(e){}
    try{ govDay(); }catch(e){}
    try{ reactDay(); }catch(e){}
    try{ warDay(); }catch(e){}
    try{ govWarDay(); }catch(e){}
    try{ kinDay(); }catch(e){}
    try{ orgDay(); }catch(e){}
    try{ engDay(); }catch(e){}
    try{ cmtDay(); }catch(e){}
    try{ lawAudit(); }catch(e){ console.warn('law', e); }
    try{ inqStore(); inqStep(false); }catch(e){ console.warn('inq', e); }
    try{ purseDay(); }catch(e){}
    try{ cultDay(); }catch(e){}
    try{ caDay(); }catch(e){}
    try{ famDay(); }catch(e){}
    try{ scDay(); }catch(e){}
    try{ phDay(); }catch(e){}
    try{ cpDay(); }catch(e){}
    try{ sbDay(); }catch(e){}
    try{ lorePublish(); loreMapSeed(); }catch(e){}
    try{ dmLeakDay(); dmInitiative(); }catch(e){ console.warn("dm day", e); }
  }catch(e){
    if(window.console) console.warn("nextDay clock", e);
  }
  setTimeout(() => { if(nextDay._busy) showMorning(); }, 900);
  if(G.sittingDay > (G.termLength || 9999)){
    nextDay._busy = false;
    try{ ballotCard(); }catch(e){ showMorning(); }
    return;
  }
  /* Card this frame. People/bills next frame. */
  yieldPaint(showMorning);
  yieldPaint(() => {
    try{
      everyone().forEach(m => {
        if(m && m.away && G.day >= m.away.until){
          m.away = null;
          journal(surname(m.name) + " is back. The desk is filled. The name is not.");
        }
      });
    }catch(e){}
    try{ voxDaily(); }catch(e){}
    try{ sustainHouse(); }catch(e){}
    scheduleDayStaged(() => { try{ queueSave(); }catch(e){} });
  });
}

function worstVote(){
  let worst = null, wf = 1e9;
  G.you.record.votes.forEach(v => {
    let s = 0;
    for(const a of AXES) s += -Math.abs(G.you.district[a.k] - v.pos[a.k])/4 + 12;
    const fit = (v.vote > 0) ? s : -s;
    if(fit < wf){ wf = fit; worst = v; }
  });
  return {v:worst, fit:wf};
}
/* Before the ballot: which office are you contesting? */
function ballotCard(){
  const y = G.you;
  /* 20261027a: an office held for a fixed term is not on the ballot until the term is out */
  try{ if(ofcMidTerm()){ y.standingFor = "midterm"; try{ kinBallotGate(election); }catch(e){ election(); } return; } }catch(e){}
  const open = Object.keys(OFFICES).filter(k => (k === "house" && !termLimited("house")) || qualifies(k));
  card.innerHTML =
    '<div class="eyebrow">Nomination day · the ' + ordinal(G.congress+1) + '</div>' +
    '<h1>What are you standing for?</h1>' +
    '<p>You may defend your seat, or reach for something bigger and risk having nothing. ' +
      'The Union is presently a <strong>' + REGIMES[(G.regime||{form:"republic"}).form].t + '</strong>.</p>' +
    Object.keys(OFFICES).map(k => {
      const o = OFFICES[k], ok = open.indexOf(k) >= 0;
      const n = o.need, want = [];
      if(n.approval) want.push("approval " + n.approval);
      if(n.standing) want.push("standing " + n.standing);
      if(n.funds)    want.push(money(n.funds));
      if(n.terms)    want.push(n.terms + " terms");
      if(termLimited(k)) want.push("term limit reached, by law");
      return '<button class="conc__btn" type="button" data-off="' + k + '"' + (ok?'':' disabled') + '>' +
        (k === "pres" ? "Stand for " + execTitle() : "Stand for " + o.t) +
        '<u>' + o.blurb + (want.length ? ' · needs ' + want.join(", ") : '') + '</u></button>';
    }).join("") +
    (open.length ? '' : '<button class="conc__btn" type="button" data-off="none">Stand down<u>The law says you are done here. The East Steps are open to everyone.</u></button>') +
    '<div class="card__actions"></div>';
  veil.hidden = false;
  card.querySelectorAll("[data-off]").forEach(b => b.addEventListener("click", () => {
    G.you.standingFor = b.getAttribute("data-off");
    veil.hidden = true;
    try{ kinBallotGate(election); }catch(e){ election(); }
  }));
}
function election(){
  const you = G.you;
  const seeking = you.standingFor || "house";
  you.standingFor = null;
  const midTerm = seeking === "midterm", incumbent = !midTerm && seeking !== "house" && seeking !== "none" && you.office === seeking;
  const swing = G.mood + rint(-10,10);
  const results = [], kept = [];
  try{ npcLadder(null); }catch(e){ if(window.console) console.warn("npcLadder", e); }
  G.members.forEach(m => {
    if(m.kind === "envoy"){ kept.push(m); return; }
    if(m.retiring){ accolade(m, "Retired undefeated after " + m.terms + " terms."); results.push({m, win:false, by:0, retired:true}); G.seatsBy[m.party]--; m.gone = true; return; }
    const partySwing = m.party==="FED" ? swing : m.party==="COM" ? -swing : 0;
    const personal = (m.rel.warmth>40?2:0) + m.influence/8 + (m.post?4:0) + (m.backed||0) + (function(){ try{ return (kinRunScore(m).score - 50) / 10; }catch(e){ return 0; } })();
    m.backed = 0;
    const r = m.margin + partySwing*0.6 + personal + rint(-14,14);
    if(r > 0){ m.margin = Math.max(1, Math.round(r)); m.terms++; kept.push(m); results.push({m,win:true,by:m.margin}); }
    else { accolade(m, "Defeated at the polls after " + m.terms + " terms."); results.push({m,win:false,by:Math.round(r)}); G.seatsBy[m.party]--; }
  });
  G.members = kept;
  const newcomers = [], heirs = [];
  const fallen = results.filter(r => !r.win).map(r => r.m);
  while(G.members.length < 25){
    const p = swing > 0 ? (chance(.62)?"FED":"COM") : (chance(.62)?"COM":"FED");
    const m = makeMember(p, {fresh:true});
    m.margin = rint(1,14); m.terms = 1;
    /* a house does not give up a seat easily: sometimes a relative stands */
    const line = fallen.find(f => f.house && !f.claimed && chance(0.42));
    if(line){
      line.claimed = true;
      m.house = line.house;
      m.state = line.state; m.dist = line.dist;
      m.name = m.name.split(" ")[0] + " " + line.name.split(" ").slice(-1)[0];
      m.party = line.party;
      m.rel.warmth = Math.round(line.rel.warmth * 0.45);
      m.rel.trust = Math.round(line.rel.trust * 0.5);
      if(Math.abs(line.rel.warmth) > 25)
        remember(m, "My " + pick(["cousin","aunt","father","sister","uncle"]) + " " + surname(line.name) +
          " had a good deal to say about you, and I listened.", Math.round(line.rel.warmth * 0.35), true);
      heirs.push({m, from:line});
      m.creed = pickCreed(m.state, {fresh:true});
      m.consular = (m.creed === "consul");
      if(m.consular) m.faction = "consul";
    }
    G.members.push(m); G.seatsBy[m.party]++; newcomers.push(m);
    m.freshman = true;
  }
  try{
    const rite = G.members.filter(m => m && isConsular(m) && !m.freshman);
    const open = newcomers.filter(m => m && !isConsular(m));
    if(rite.length && open.length){
      const tries = Math.min(2, open.length);
      for(let i=0;i<tries;i++){
        if(chance(0.48)) consularRecruit(pick(rite), open[i], "the new class");
      }
    }
  }catch(e){}
  wireGraph();
  let swungSeats = null; try{ swungSeats = seatSwing(swing); }catch(e){}

  const bad = worstVote();
  const adDamage = (bad.v && bad.fit < -20) ? clamp((-bad.fit)/6, 0, 12) : 0;
  const primary = you.standing < 28 ? rint(4,12) : 0;
  const yourSwing = you.party==="FED" ? swing : -swing;
  const kinAdj = you.kinAdj || 0; you.kinAdj = 0;
  const yourResult = kinAdj + you.margin + yourSwing*0.6 + (you.approval-50)*0.45 + you.funds*0.12
                   + (you.post?6:0) - adDamage - primary + rint(-12,12) + Math.min(14, (you.field||0)*0.8) + (function(){ try{ return lHomeSwing(); }catch(e){ return 0; } })();
  you.field = 0;
  /* Out of the House, you run as a private citizen: no influence, no floor,
     and only the people who still take your call. */
  const backers = G.members.filter(m => readOf(m).est > 30 && m.party === you.party).length;
  const outBonus = you.out ? backers*7 - 16 : 0;
  /* a bigger office is a harder race */
  const reach = (seeking === "house" || midTerm ? 0 : seeking === "gov" ? 14 : seeking === "senate" ? 22 : seeking === "bench" ? 18 : 38) * (incumbent ? 0.45 : 1);
  const youWon = midTerm || (seeking !== "none" && (yourResult + outBonus - reach) > 0);
  if(youWon && incumbent){
    if(seeking === "pres" && G.exec && G.exec.you) G.exec.terms = (G.exec.terms || 1) + 1;
    you.officeSince = G.term + 1;
    note("Re-elected: " + (seeking === "pres" ? execTitle() : OFFICES[seeking].short) + ".", true);
    G.career.push({term:G.term, post:OFFICES[seeking].short, note:"re-elected"});
  }
  if(youWon && seeking !== "house" && !midTerm && !incumbent){
    you.officeSince = G.term + 1;
    you.office = seeking;
    /* you leave the House: the post, the vote and the Cannon office go with it */
    you.post = null; you.vote = null; you.sitting = false;
    try{ setTimeout(homeSeatFill, 0); }catch(e){}
    if(seeking === "pres"){
      if(typeof retireExec === "function") retireExec("was beaten by you");
      G.exec = {name:you.name, party:you.party, terms:1, you:true, vetoes:0, pos:you.pos};
      note("Elected " + execTitle() + " of the Union.", true);
      setPrecedent("won the executive from the floor of the House",
        "that a sitting member may take the executive without leaving the chamber");
    } else if(seeking === "bench"){
      if(G.court && G.court.length) G.court[0] = {name:you.name, by:"the states", pos:you.pos, you:true};
      note("Elected to the bench.", true);
    } else note("Elected to " + OFFICES[seeking].t + ".", true);
    G.career.push({term:G.term, post:OFFICES[seeking].short, note:"won " + (seeking === "senate" ? "a seat in the Senate" : seeking === "house" ? "a seat in the House" : OFFICES[seeking].t)});
  }
  try{ if(midTerm){} else if(youWon){ achieve(seeking !== "house" && !incumbent ? "higher" : "reelect"); careerWon(seeking); } else achieve("steps"); }catch(e){}
  if(youWon && !midTerm){
    you.margin = Math.max(1, Math.round(yourResult + outBonus));
    you.terms++; you.record.won++; you.funds = Math.round(you.funds*0.25);
    if(you.out){ you.out = false; you.outRuns = 0; you.committee = pick(COMMITTEES).k; you.standing = 40; you.influence = 8; }
  } else if(!youWon){
    you.record.lost++;
    you.outRuns = (you.outRuns || 0) + 1;
  }
  G.donors = G.donors.filter(d => !d.angry);
  judicialElection(swing, null);
  G.congress++; G.term++; G.sittingDay = 1;
  if(youWon) assignPosts(false);

  const rows = results.slice().sort((a,b)=>b.by-a.by).map(r =>
    '<div><span>'+r.m.name+' <span class="chip chip--'+(r.m.party==="FED"?"fed":r.m.party==="COM"?"com":"ind")+'">'+r.m.party+'</span></span>' +
    '<b class="'+(r.win?"win":"lose")+'">'+(r.win?"held +"+r.by:r.retired?"retired":"lost")+'</b><b>'+(r.m.post?postTitle(r.m.post):"")+'</b></div>').join("");

  card.innerHTML =
    '<div class="eyebrow">General election · the ' + G.congress + 'th Congress</div>' +
    '<h1>' + (midTerm ? "Your term continues." : youWon ? (incumbent ? "You were re-elected " + OFFICES[seeking].short + "." : seeking !== "house" ? "You won " + OFFICES[seeking].t + "." : "You held the seat.") : "You lost the seat.") + '</h1>' +
    '<p class="dream">' + (midTerm ? "You were not on the ballot: your term as " + (heldOffice() === "pres" ? execTitle() : (OFFICES[heldOffice()] || {}).short || "officeholder") + " runs on into the " + ordinal(G.congress) + " Congress. The country voted for everyone else." : youWon
      ? (seeking !== "house" && !incumbent ? "You leave the House; " + you.state + " " + you.dist + " sends someone new. Your office is " + ROOMS[homeRoom()].t + " now. " : "") + "By " + you.margin + " points. The county chairs who never returned a call are on the line by midnight."
      : "By " + Math.abs(Math.round(yourResult)) + " points. The room empties fast when the number comes up.") + '</p>' +
    (adDamage > 1 && bad.v ? '<p><strong>They ran the ad you knew they had:</strong> your vote on the ' +
      bad.v.title + '. Worth about <strong>' + Math.round(adDamage) + '</strong> points against you.</p>' : '') +
    (primary ? '<p><strong>You were primaried.</strong> Party standing of ' + Math.round(you.standing) +
      '% bought you a challenger and a bruising spring.</p>' : '') +
    '<p>National mood moved <strong>' + (swing>0?"+":"") + Math.round(swing) + '</strong> toward the ' +
      (swing>0?"Federalists":"Commonwealth") + '.' + (swungSeats && swungSeats.n ? ' Beyond the seats on the board, <strong>' + swungSeats.n + '</strong> changed hands from the ' + partyName(swungSeats.from) + ' to the ' + partyName(swungSeats.to) + '.' : '') + ' The House stands <strong>' + Object.keys(G.seatsBy).filter(p => (G.seatsBy[p] || 0) > 0).sort((a, c) => G.seatsBy[c] - G.seatsBy[a]).map(p => G.seatsBy[p] + ' ' + partyName(p)).join(', ') + '</strong>.</p>' +
    '<h2>The board</h2><div class="results">' + rows + '</div>' +
    (newcomers.length ? '<p><strong>Sworn in:</strong> ' + listify(newcomers.map(m=>m.name+" ("+m.party+")")) +
      '. They do not know you yet.</p>' : '') +
    (heirs.length ? '<p><strong>The houses hold:</strong> ' + listify(heirs.map(h =>
      h.m.name + " takes " + h.from.state + " " + h.from.dist + " after " + h.from.name)) +
      '. They inherited an opinion of you along with the seat.</p>' : '') +
    (!youWon ? '<p><strong>You are out of the House, not out of the fight.</strong> The steps, the district, and whoever still takes your call. Stand again when you have the numbers. The session does not end.</p>' : '') +
    '<div class="card__actions"><button class="btn" type="button" id="okElect">' +
      (youWon ? "Take the oath" : "Go to the steps") + '</button></div>';
  veil.hidden = false;
  el("okElect").addEventListener("click", () => {
    if(!youWon){ you.outRuns = Math.min(you.outRuns || 0, 1); goOutside(); return; }
    walkNow();
    note((seeking === "house" ? "Re-elected by " + you.margin + ". " : "") + "The " + ordinal(G.congress) + " Congress convenes.", true);
    if(seeking === "house") G.career.push({term:G.term-1, post:you.post?postTitle(you.post):"Member", note:"held by "+you.margin});
    laterHouse(() => {
      try{ leadershipRace(); }catch(e){ G.running = true; }
    });
  });
}
function leadershipRace(){
  const you = G.you;
  if(you.party !== majorityParty()){ G.running = true; queueSave(); refreshPanels(); return; }
  const open = POSTS.filter(p => p.party==="majority" && you.standing >= p.need - 14 && you.influence > p.weight*0.45);
  if(!open.length){ G.running = true; queueSave(); refreshPanels(); return; }
  const friends = G.members.filter(m => m.party===you.party && m.rel.warmth>25);
  card.innerHTML =
    '<div class="eyebrow">Caucus, the morning after</div>' +
    '<h1>They are counting noses for the leadership table.</h1>' +
    '<p>Influence <strong>' + Math.round(you.influence) + '</strong>, party standing <strong>' +
      Math.round(you.standing) + '%</strong>, and <strong>' + friends.length +
      '</strong> members of your own caucus who would go to the mat for you.</p>' +
    '<div class="card__actions">' +
      open.map(p => '<button class="btn btn--ghost" type="button" data-post="'+p.k+'">'+p.t+'</button>').join("") +
      '<button class="btn" type="button" data-post="">Stay on the back bench</button></div>';
  veil.hidden = false;
  card.querySelectorAll("[data-post]").forEach(btn => btn.addEventListener("click", () => {
    const k = btn.getAttribute("data-post");
    veil.hidden = true;
    if(!k){ G.running = true; queueSave(); refreshPanels(); return; }
    const p = POSTS.find(x=>x.k===k);
    const enemies = G.members.filter(m => m.party===you.party && m.rel.warmth<-20);
    const score = you.influence*1.4 + friends.length*9 - enemies.length*8 + you.terms*3
                + (you.standing-50)*0.6 - p.weight + rint(-18,18);
    if(score > 0){
      const old = G.members.find(m => m.post===k); if(old) old.post = null;
      you.post = k; you.influence = clamp(you.influence+20,0,100);
      note("Elected " + p.t + " by the caucus.", true);
      G.career.push({term:G.term, post:p.t, note:"elected by the caucus"});
      friends.forEach(m => remember(m, "I put you where you are. Don't forget which door you came through.", 4));
    } else {
      you.influence = clamp(you.influence-8,0,100);
      note("Stood for " + p.t + " and lost the caucus vote.", true);
      enemies.forEach(m => remember(m, "You reached for the gavel and came up short. I enjoyed that.", -2));
    }
    G.running = true; queueSave(); refreshPanels();
  }));
}
/* ── out of the House, still in the world ─────────────────── */
function goOutside(){
  const you = G.you;
  you.out = true;
  you.post = null; you.committee = null;
  you.influence = 0; you.standing = 0;
  you.funds = Math.round(you.funds * 0.4);
  G.prog.active = null;
  veil.hidden = true;
  note("Out of the House. Everything now is the steps and the district.", true);
  feed("You no longer have the floor.");
  G.you.vote = null;
  scheduleDay();
  transition(() => {
    G.room = "steps"; G.visitId = null;
    const b = roomBox("steps");
    { const sp = safeSpawn(G.room); cam.x = sp.x; cam.z = sp.z; } cam.yaw = 0; G.doorGrace = G.t + 0.9;
    everyone().forEach(m => { if(m.room === "steps") placeInRoom(m); });
    return rebuildRoomStaged("steps", () => {
      el("whereName").textContent = ROOMS.steps.t;
      el("whereTag").textContent = "No longer a member";
      G.running = true;
      refreshPanels();
    });
  });
}
function leaveSittingQuiet(){
  /* 20261030i: tear down PROC and ONUM_SESSION so the floor desk cannot linger after Walk out */
  const hadProc = !!PROC.on;
  const hadSsn = !!(typeof SSN !== "undefined" && SSN) || !!(window.ONUM_SESSION && window.ONUM_SESSION.stage && window.ONUM_SESSION.stage !== "idle");
  if(PROC.on){
    PROC.on = false;
    PROC.phase = "idle";
    PROC.e = null;
    PROC.speaker = null;
    PROC.i = -1;
    try{ const bar = el("procBar"); if(bar) bar.hidden = true; }catch(e){}
    try{ document.body.classList.remove("in-session"); }catch(e){}
  }
  try{ if(typeof ssnClose === "function") ssnClose(); else if(window.onumSession && typeof window.onumSession.close === "function") window.onumSession.close(); }catch(e){}
  try{ const d = document.getElementById("ndFd"); if(d) d.hidden = true; }catch(e){}
  if(G.you) G.you.sitting = false;
  G.speechApproach = null;
  try{ catchClear("leave-sitting"); }catch(e){}
  if(hadProc || hadSsn) feed("You leave the sitting. It goes on without you.");
}
function walkOutNow(){
  /* Always get off this floor. Career, mail, day — untouched. */
  try{ forceUnstickMove(); }catch(e){}
  try{ leaveSittingQuiet(); }catch(e){}
  try{ if(TALK.open) closeTalk(); }catch(e){}
  G.pendingNight = false;
  G.over = false;
  G.running = true;
  G.speed = 1;
  G.prevSpeed = 1;
  if(G.you) G.you.sitting = false;
  G.speechApproach = null;
  G.moving = false;
  try{
    veil.hidden = true;
    card.classList.remove("card--open");
    document.body.classList.remove("boot-menu");
  }catch(e){}
  phoneWasRunning = null;
  const dest = (G.room === "corridor") ? homeRoom() : "corridor";
  try{ enterRoom(dest, G.room); }catch(e){ G.room = dest; }
  feed("You walk out. The sitting is still yours.");
}
function mapCard(){
  if(!G.you) return;
  try{ leaveSittingQuiet(); }catch(e){}
  try{ if(TALK.open) closeTalk(); }catch(e){}
  phoneWasRunning = phoneWasRunning === null ? G.running : phoneWasRunning;
  G.running = false;
  const here = G.room;
  const WING = {office:"Cannon building", visit:"Cannon building", home:"Home", corridor:"Capitol main floor", cloak:"Capitol main floor", floor:"Capitol main floor", caucus:"Capitol main floor", committee:"Capitol main floor", press:"Capitol main floor", engine:"Capitol main floor", senate:"Senate wing", court:"Senate wing", exec:"Executive", steps:"Outside", district:"Outside", govoffice:"Outside"}, WING_ORDER = ["Home", "Cannon building", "Capitol main floor", "Senate wing", "Executive", "Outside", "Elsewhere"];
  const tile = id => { const R = ROOMS[id], on = id === here;
    return '<button type="button" class="conc__btn' + (on ? " is-accepted" : "") + '" data-go="' + id + '"' + (on ? " disabled" : "") + '><span class="conc__name">' + ((id === homeRoom() && abroadOffice()) ? "My Office \u00b7 " + R.t : R.t) + '</span>' +
      '<u>' + (R.tag || id) + (id === homeRoom() && abroadOffice() ? " \u00b7 your office" : "") + '</u>' + (on ? '<span class="conc__here">you are here</span>' : '') + '</button>'; };
  const ids = ROOM_ORDER.concat(Object.keys(ROOMS).filter(k => ROOM_ORDER.indexOf(k) < 0)).filter(id => id !== "visit" && outsideAllowed(id)), byWing = {};
  ids.forEach(id => { const w = WING[id] || "Elsewhere"; (byWing[w] = byWing[w] || []).push(id); });
  const rows = '<div class="conc__row"><button type="button" class="conc__btn" id="mapLeave"><span class="conc__name">Leave this room</span><u>Step out without wiping the sitting</u></button></div>' +
    WING_ORDER.filter(w => byWing[w]).map(w => '<div class="eyebrow conc__wing">' + w + '</div><div class="conc__grid">' + byWing[w].map(tile).join("") + '</div>').join("");
  card.innerHTML =
    '<div class="eyebrow">The building</div>' +
    '<h1>Where do you want to be.</h1>' +
    '<p class="muted">This does not wipe the sitting. Walk, or pick a door.</p>' +
    '<div class="conc__list">' + rows + '</div>' +
    '<div class="card__actions"><button class="btn" type="button" id="mapDone" data-gp="map:done">Stay here</button></div>';
  veil.hidden = false;
  card.classList.add("card--open");
  { const lv = el("mapLeave"); if(lv) lv.addEventListener("click", () => { try{ veil.hidden = true; card.classList.remove("card--open"); if(phoneWasRunning !== null){ G.running = phoneWasRunning; phoneWasRunning = null; } walkOutNow(); }catch(e){ console.warn(e); } }); }
  card.querySelectorAll("[data-go]").forEach(b => b.addEventListener("click", () => {
    const id = b.getAttribute("data-go");
    veil.hidden = true;
    card.classList.remove("card--open");
    G.running = phoneWasRunning === null ? true : phoneWasRunning;
    phoneWasRunning = null;
    try{ enterRoom(id, here); }catch(e){ G.room = id; }
  }));
  const done = el("mapDone");
  if(done) done.onclick = () => {
    veil.hidden = true;
    card.classList.remove("card--open");
    G.running = phoneWasRunning === null ? true : phoneWasRunning;
    phoneWasRunning = null;
  };
}
function outsideAllowed(id){
  if(G.you && abroadOffice()) return ["office","floor","cloak","caucus","committee"].indexOf(id) < 0;
  return !G.you.out || id === "steps" || id === "district" || id === "corridor" || id === "press" || id === "govoffice";
}
function careerEnd(){
  /* The long session: the record is shown, the world is not deleted. */
  G.running = false;
  const you = G.you;
  const loyal = G.members.filter(m => m.rel.warmth > 40);
  const foes = G.members.filter(m => m.rel.warmth < -40);
  const summary = you.post ? "You leave as " + postTitle(you.post) + ", which is more than most of them manage."
    : you.record.bills > 4 ? "You never held the gavel, but you moved things."
    : "You served, and the record will say so, and very little else.";
  card.innerHTML =
    '<div class="eyebrow">The record</div>' +
    '<h1>' + you.name + ', ' + you.state + ' ' + you.dist + '</h1>' +
    '<p class="dream">' + you.terms + ' term' + (you.terms===1?'':'s') + '. ' + summary + '</p>' +
    '<p><strong>Roll calls:</strong> ' + you.record.votes.length + ' · <strong>On the winning side:</strong> ' +
      you.record.bills + ' · <strong>Against your own party:</strong> ' + you.record.partyBreaks +
      ' · <strong>Against your own conscience:</strong> ' + you.record.conscience + '</p>' +
    (loyal.length ? '<p><strong>Would still take your call:</strong> ' + listify(loyal.map(m=>m.name)) + '.</p>'
                  : '<p>Nobody in the chamber would call it a friendship.</p>') +
    (foes.length ? '<p><strong>Will be glad you are gone:</strong> ' + listify(foes.map(m=>m.name)) + '.</p>' : '') +
    '<div class="card__actions"><button class="btn" type="button" id="again">Keep walking</button></div>';
  veil.hidden = false;
  el("again").addEventListener("click", () => {
    G.over = false;
    if(you) you.outRuns = 0;
    try{ goOutside(); }catch(e){ G.running = true; veil.hidden = true; }
  });
}

/* ══════════════════════════════════════════════════════════
   14 · PANELS
   ══════════════════════════════════════════════════════════ */
function statHTML(label, v, max, col, show){
  return '<div class="stat"><i>'+label+'</i><b>'+(show===undefined?v:show)+'</b><span class="stat__track">' +
    '<span class="stat__fill" style="width:'+clamp(v/max*100,0,100)+'%;background:'+col+'"></span></span></div>';
}
/* Set a block of markup only when it is not the markup already there.
   Assigning innerHTML tears down and rebuilds the nodes either way. */
function setHTML(node, html){
  if(node._html === html) return;
  node._html = html;
  node.innerHTML = html;
}
function activeJob(){
  if(PROC && PROC.on && PROC.phase === "you") return "You have the floor. Speak.";
  if(G.you && G.you.energy < 18) return "You're spent. Sleep.";
  if((G.minute || 0) >= 22 * 60) return "Ten o'clock. Sleep, or the House sleeps without you.";
  const here = (typeof hereNow === "function") ? hereNow() : [];
  const wanter = here.find(m => m && m.wantsWord);
  if(wanter) return wanter.name.split(" ")[0] + " wants a word. Walk over. E.";
  const b = G.bill;
  if(b && !b.done && b.voteDay === G.day) return b.title + " — roll call today. Be on the floor.";
  try{
    const wt = whipTarget();
    if(wt){
      if(wt.room === G.room) return "Whip: " + surname(wt.name) + " is here. Walk over. E.";
      return "Whip: find " + surname(wt.name) + " in " + whipRoomName(wt) + ".";
    }
  }catch(e){}
  try{
    const dn = abroadOffice() ? docketNext() : null;
    if(dn) return fxHour(dn.h) + " · " + dn.t + (G.room === homeRoom() ? ". " + officeTabName() + " panel, or the desk. E." : ". " + ROOMS[homeRoom()].t + ".");
  }catch(e){}
  try{
    const kr = kChamberDue();
    if(kr) return G.room === kr ? K_HERE_LINE[kr] : "Your chair: " + ROOMS[kr].t + " is waiting on you today.";
  }catch(e){}
  if(b && !b.done && inHouse() && G.room !== "floor" && floorSitsNow())
    return "The floor is sitting. Go in.";
  try{ const lj = lJobLine(); if(lj) return lj; }catch(e){}
  const unread = (G.mail || []).filter(m => !m.read).length;
  if(unread && G.room !== "office") return unread + " waiting in the inbox. Office, or F.";
  try{
    const ng = nextGoal();
    if(ng){
      const Gs = G.goals, n = Gs.list.filter(g => g.done).length;
      return "Today " + n + "/" + Gs.list.length + ": " + goalLeft(ng) + ".";
    }
  }catch(e){}
  if(G.room === "office") return "Desk. Phone. Corridor when you're ready.";
  if(here.length) return "Walk. Speak. The building notices who does neither.";
  return "The room is empty. Someone will come.";
}
/* 20261011b: where the current job is, and which door in this room gets you there. */
function objectiveRoom(){
  if(!G.you || PROC.on) return null;
  const m = G.minute || 0;
  try{
    const ev = (G.events || []).find(e => e && !e.done && e.rsvp === true && e.day === G.day && ROOMS[e.room] &&
      m >= e.hour*60 - 45 && m < e.hour*60 + 30);
    if(ev) return ev.room;
  }catch(e){}
  const b = G.bill;
  if(abroadOffice()){
    if(G.you.energy < 18 || m >= 21*60) return homeRoom();
    if(docketNext()) return homeRoom();
    try{ const ng = nextGoal(); if(ng && ng.room) return ng.room; }catch(e){}
    return null;
  }
  if(b && !b.done && b.voteDay === G.day) return "floor";
  if(G.you.energy < 18 || m >= 21*60) return "office";
  try{ const wt = whipTarget(); if(wt && ROOMS[wt.room]) return wt.room; }catch(e){}
  try{ const kr = kChamberDue(); if(kr) return kr; }catch(e){}
  if(b && !b.done && floorSitsNow()) return "floor";
  try{ if((G.civ || []).some(c => c && c.visitor && c.hhDay === G.day && c.room === "office" && !c.hhHeard) && (G.minute || 0) < 19*60) return "office"; }catch(e){}
  const unread = (G.mail || []).filter(x => !x.read).length;
  if(unread) return "office";
  try{ const ng = nextGoal(); if(ng && ng.room) return ng.room; }catch(e){}
  return null;
}
function nextHop(from, to){
  if(!from || !to || from === to || !DOORS[from]) return null;
  const prev = Object.create(null); prev[from] = null;
  const q = [from];
  while(q.length){
    const cur = q.shift();
    if(cur === to) break;
    const ds = DOORS[cur] || [];
    for(let i=0;i<ds.length;i++){
      const n = ds[i].to;
      if(n in prev) continue;
      prev[n] = cur; q.push(n);
    }
  }
  if(!(to in prev)) return null;
  let step = to;
  while(prev[step] && prev[step] !== from) step = prev[step];
  return (DOORS[from] || []).find(d => d.to === step) || null;
}
function objectiveDoor(){
  const goal = objectiveRoom();
  if(!goal || goal === G.room) return null;
  const dr = nextHop(G.room, goal);
  return dr ? {goal, dr} : null;
}
/* 20261011c: three aims a day. They read the House; they do not replace it. */
function goalsEnsure(){
  if(!G.you) return null;
  if(G.goals && G.goals.day === G.day && Array.isArray(G.goals.list)) return G.goals;
  const b = G.bill;
  const voteToday = !!(b && !b.done && b.voteDay === G.day);
  const unread = (G.mail || []).filter(x => !x.read).length;
  if(abroadOffice()){
    const hr = homeRoom(), nd = Math.min(3, docketToday().length);
    const L = [];
    /* the chair you hold sets the list: a Governor signs, budgets, appoints, pardons; nothing about House pledges */
    const RG = {gov:["gdesk","gbud"], senate:["conf","ksen","treaty"], bench:["kct","bopin"], pres:["pacts","aid"]}[heldOffice()] || [];
    const RT = {gdesk:"Sign or veto what the legislature sent", conf:"Question a nominee under oath", ksen:"Take your seat when the Senate sits", treaty:"Weigh a treaty before ratification",
                kct:"Hear oral argument", bopin:"Write an opinion", pacts:"Sign or veto the acts on your desk", aid:"Take the calls from foreign capitals"};
    const DT = docketToday();
    RG.forEach(k => { const d = DT.find(x => x.key === k); if(d) L.push({k:"dk", key:k, t:RT[k] || d.t, need:1, room:hr}); });
    if(!L.length) L.push({k:"docket", t:"Work " + nd + " items on today's docket", need:nd, room:hr});
    const EX = ROLE_EXTRA[heldOffice()] || [];
    if(EX.length){ const x = EX[(G.day + seedOf(G.you.name || "")) % EX.length]; L.push({k:"dk", key:x.key, t:x.t, need:1, room:hr}); }
    { const wr = K_ROOM_OF[heldOffice()] || hr; L.push({k:"room", room:wr, kc:true, t:"Keep your hours in " + ROOMS[wr].t.replace(/^The /, "the "), need:1}); }
    L.push(unread ? {k:"mail", t:"Clear your inbox", need:1} : {k:"room", room:"district", t:"Go home to " + G.you.state, need:1});
    G.goals = {day:G.day, list:L.map(g => Object.assign({have:0, done:false}, g)), talked:[], seen:{}, rollcall:false, all:false, pledged0:[], co0:0, whipped:[]};
    return G.goals;
  }
  const pool = [];
  pool.push({k:"talk", t:"Talk with three members", need:3});
  if(b && !b.done) pool.push({k:"pledge", t:"Win a pledge on the " + String(b.title).split(" ")[0] + " bill", need:1});
  if(voteToday) pool.push({k:"rollcall", t:"Be on the floor for the roll call", need:1, room:"floor"});
  else pool.push({k:"room", room:"floor", t:"Sit in on the House floor", need:1});
  if(unread) pool.push({k:"mail", t:"Clear your inbox", need:1, room:"office"});
  if(b && !b.done && b.mine) pool.push({k:"cosponsor", t:"Sign up a cosponsor for your bill", need:1});
  if(b && !b.done) pool.push({k:"whip", t:"Work someone leaning against you", need:1});
  try{
    const kr = (G.you && G.you.office) ? K_ROOM_OF[G.you.office] : null;
    if(kr && ROOMS[kr]) pool.push({k:"room", room:kr, kc:true, t:"Keep your hours in " + ROOMS[kr].t.replace(/^The /, "the "), need:1});
  }catch(e){}
  pool.push({k:"room", room:"district", t:"Go home to the district", need:1});
  pool.push({k:"room", room:"caucus", t:"Show your face in the Caucus Room", need:1});
  pool.push({k:"room", room:"steps", t:"Take the air on the East Steps", need:1});
  pool.push({k:"room", room:"cloak", t:"Hear what the Cloakroom is saying", need:1});
  /* talk first; then the bill if there is one; then one place, chosen by the day */
  const list = [pool[0]];
  { const kc = pool.find(g => g.kc); if(kc) list.push(kc); }
  const billish = pool.find(g => g.k === "rollcall") || pool.find(g => g.k === "cosponsor") || pool.find(g => g.k === "pledge");
  if(billish) list.push(billish);
  const rest = pool.filter(g => list.indexOf(g) < 0 && !(g.k === "pledge" && list.some(x => x.k === "rollcall")));
  const seed = ((G.day || 1) * 7 + (G.congress || 1) * 3) % Math.max(1, rest.length);
  while(list.length < 3 && rest.length){ list.push(rest.splice(seed % rest.length, 1)[0]); }
  G.goals = {day:G.day, list:list.map(g => Object.assign({have:0, done:false}, g)), talked:[], seen:{}, rollcall:false, all:false,
    pledged0:(G.members || []).filter(m => m && m.pledge && m.pledgeDay === G.day).map(m => m.id),
    co0:(b && b.mine && b.cosponsors) ? b.cosponsors.length : 0, whipped:[]};
  try{ feed("Today’s aims: " + G.goals.list.map(g => g.t).join(" · ") + "."); }catch(e){}
  return G.goals;
}
function goalLeft(g){
  if(!g || g.done) return "";
  if(g.k === "talk"){ const n = g.need - g.have; return "Talk with " + n + " more member" + (n === 1 ? "" : "s"); }
  return g.t;
}
function nextGoal(){
  const Gs = goalsEnsure(); if(!Gs) return null;
  return Gs.list.find(g => !g.done) || null;
}
function goalsTick(){
  const Gs = goalsEnsure(); if(!Gs || !G.running) return;
  let changed = false;
  Gs.list.forEach(g => {
    if(g.done) return;
    let have = g.have;
    if(g.k === "talk") have = (Gs.talked || []).length;
    else if(g.k === "pledge"){
      /* a pledge you won: someone you spoke with today, now pledged your way, who was not already */
      const b = G.bill; let side = 1;
      try{ side = G.you.vote != null ? G.you.vote : (b && alignment(G.you, b) > 0 ? 1 : -1); }catch(e){}
      const base = Gs.pledged0 || [];
      have = (G.members || []).filter(m => m && m.pledge === side && m.pledgeDay === G.day && Gs.talked.indexOf(m.id) >= 0 && base.indexOf(m.id) < 0).length ? 1 : 0;
    }
    else if(g.k === "rollcall") have = Gs.rollcall ? 1 : 0;
    else if(g.k === "docket") have = docketDone();
    else if(g.k === "dk") have = kOnceToday(g.key) ? 1 : 0;
    else if(g.k === "room") have = (Gs.seen && Gs.seen[g.room]) || G.room === g.room ? 1 : 0;
    else if(g.k === "mail") have = (G.mail || []).filter(x => !x.read).length ? 0 : 1;
    else if(g.k === "whip") have = (Gs.whipped || []).length ? 1 : 0;
    else if(g.k === "cosponsor") have = (G.bill && G.bill.mine && (G.bill.cosponsors || []).length > (Gs.co0 || 0)) ? 1 : 0;
    if(have !== g.have){ g.have = have; changed = true; }
    if(g.have >= g.need){
      g.done = true; changed = true;
      try{
        if(G.you){
          if(g.k === "talk" || g.k === "pledge" || g.k === "whip" || g.k === "cosponsor") G.you.influence = clamp((G.you.influence || 0) + 3, 0, 100);
          else if(g.k === "rollcall") G.you.standing = clamp((G.you.standing || 0) + 3, 0, 100);
          else G.you.approval = clamp((G.you.approval || 0) + 2, 0, 100);
        }
        feed("✓ " + g.t + ".", "big");
      }catch(e){}
    }
  });
  if(!Gs.all && Gs.list.length && Gs.list.every(g => g.done)){
    Gs.all = true;
    try{
      if(G.you) G.you.approval = clamp((G.you.approval || 0) + 3, 0, 100);
      note("Every aim met today. The building noticed the shape of the day, if not the reasons.", true);
    }catch(e){}
  }
  if(changed){ try{ txtGoalsDirty = true; }catch(e){} }
}
let txtGoalsDirty = true;
function goalsHTML(){
  const Gs = goalsEnsure(); if(!Gs) return "";
  return '<ul class="goals">' + Gs.list.map(g => '<li class="' + (g.done ? "is-done" : "") + '">' +
    (g.done ? "✓ " : "○ ") + g.t + (g.k === "talk" && !g.done ? " (" + g.have + "/" + g.need + ")" : "") + '</li>').join("") + '</ul>';
}
/* ── 20261011e · the whip count ─────────────────────────── */
function floorSitsNow(){
  try{
    if(typeof dayType !== "function" || dayType() !== "session") return false;
    const m = G.minute || 0;
    return (m >= 11*60 && m < 12*60 + 36) || (m >= 14*60 && m < 17*60);
  }catch(e){ return false; }
}
function yourSide(b){
  b = b || G.bill; if(!b || !G.you) return 1;
  if(G.you.vote === 1 || G.you.vote === -1) return G.you.vote;
  if(b.mine) return 1;
  try{ const l = partyLine(b)[G.you.party]; if(l) return l > 0 ? 1 : -1; }catch(e){}
  try{ return alignment(G.you, b) > 0 ? 1 : -1; }catch(e){ return 1; }
}
function whipRoomName(m){
  if(!m) return "";
  if(m.room === "away" || m.away) return "in their own suite";
  return ROOMS[m.room] ? ROOMS[m.room].t : m.room;
}
function whipBoard(){
  const b = G.bill; if(!b || b.done) return null;
  const side = yourSide(b);
  const t = tallyBill(b, true);
  const live = (G.members || []).filter(m => m && !m.gone && m.kind === "member");
  const rows = live.map(m => {
    let v = 0; try{ v = memberVote(m, b) > 0 ? 1 : -1; }catch(e){}
    const pledged = !!(m.pledge && G.day - (m.pledgeDay || 0) < 8);
    const known = pledged || (m.known || 0) >= 1;
    return {m, v, pledged, known, with: v === side};
  });
  const withYou = rows.filter(r => r.with && r.pledged);
  const soft = rows.filter(r => !r.with && !(r.pledged && r.m.pledge === -side))
    .sort((a, c) => ((c.m.rel ? c.m.rel.warmth : 0) - (a.m.rel ? a.m.rel.warmth : 0)));
  const total = t.aye + t.no + t.un;
  const need = Math.max(0, Math.floor(total / 2) + 1 - (side > 0 ? t.aye : t.no));
  return {b, side, t, withYou, soft, need, rows};
}
function whipCard(){
  const W = whipBoard();
  if(!W){ note("No bill on the calendar to count."); return; }
  try{ closeTalk(); }catch(e){}
  const b = W.b, side = W.side;
  G.running = false;
  const sideWord = side > 0 ? "aye" : "no";
  const here = (m) => m.room === G.room;
  const row = (r) => '<div class="whip__row">' +
    '<span class="whip__n">' + r.m.name + ' <i>' + (r.m.party || "") + '</i></span>' +
    '<span class="whip__w">' + (r.pledged ? (r.m.pledge === side ? "pledged with you" : "pledged against") : (r.known ? (r.with ? "leans your way" : "leans against") : "unread")) +
    ' · ' + whipRoomName(r.m) + '</span>' +
    '<span class="whip__b">' +
      (here(r.m) ? '<button type="button" class="btn btn--ghost whip__go" data-whiptalk="' + r.m.id + '">Talk now</button>'
                 : (r.m.room && r.m.room !== "away" && !r.m.away ? '<button type="button" class="btn btn--ghost whip__go" data-whipfind="' + r.m.id + '">Find</button>' : '')) +
    '</span></div>';
  const co = (b.cosponsors || []).map(byId).filter(Boolean);
  const askable = b.mine ? W.rows.filter(r => here(r.m) && (b.cosponsors || []).indexOf(r.m.id) < 0).slice(0, 5) : [];
  const coRow = (r) => '<div class="whip__row"><span class="whip__n">' + r.m.name + ' <i>' + (r.m.party || "") + '</i></span>' +
    '<span class="whip__w">' + (r.with ? "leans your way" : "leans against") + ' · here</span>' +
    '<span class="whip__b"><button type="button" class="btn btn--ghost whip__go" data-whipco="' + r.m.id + '">Ask to cosponsor</button></span></div>';
  card.innerHTML =
    '<div class="eyebrow">The whip count · ' + hhmm() + '</div>' +
    '<h1>' + b.title + '</h1>' +
    '<p class="dream">Roll call day ' + b.voteDay + (b.voteHour ? ' at ' + (b.voteHour > 12 ? b.voteHour - 12 : b.voteHour) + ' o\u2019clock' : '') +
      ' · you vote <strong>' + sideWord + '</strong>' + (b.mine ? ' · <strong>your bill</strong>' : '') + '</p>' +
    '<div class="count"><div class="c-aye"><i>Ayes</i><b>' + W.t.aye + '</b></div><div class="c-no"><i>Noes</i><b>' + W.t.no + '</b></div><div class="c-un"><i>Unread</i><b>' + W.t.un + '</b></div></div>' +
    '<p>' + (W.need > 0 ? 'Your side needs <strong>' + W.need + '</strong> more on the projected count.' : 'On the projected count your side carries it. Counts move.') + '</p>' +
    (b.mine ? '<p><strong>Cosponsors:</strong> ' + (co.length ? listify(co.map(m => m.name)) : 'none yet. Ask the people in the room with you.') + '</p>' : '') +
    (W.withYou.length ? '<p><strong>Pledged with you:</strong> ' + listify(W.withYou.slice(0, 8).map(r => surname(r.m.name))) + '</p>' : '') +
    (askable.length ? '<div class="whip__h">In the room with you</div>' + askable.map(coRow).join("") : '') +
    '<div class="whip__h">Worth working</div>' +
    (W.soft.slice(0, 7).map(row).join("") || '<p>Nobody left to turn. Hold what you have.</p>') +
    ((G.life && G.life.ghostRoll && G.life.ghostRoll.d === G.day) ? (lifeAnomFound("roll"), '<div class="whip__row"><span class="whip__n">' + G.life.ghostRoll.name + ' <i>?</i></span><span class="whip__w">unread · no room on record</span><span class="whip__b"></span></div>') : '') +
    '<div class="card__actions"><button type="button" class="btn" id="whipClose">Back to it</button></div>';
  veil.hidden = false;
  const done = () => { walkNow(); try{ paintJob(); paintCompass(); }catch(e){} };
  el("whipClose").addEventListener("click", done);
  card.querySelectorAll("[data-whipfind]").forEach(bt => bt.addEventListener("click", () => {
    const m = byId(+bt.getAttribute("data-whipfind")); if(!m) return;
    G.whip = {id:m.id, day:G.day};
    feed("Whip: find " + m.name + " (" + whipRoomName(m) + ").");
    done();
  }));
  card.querySelectorAll("[data-whiptalk]").forEach(bt => bt.addEventListener("click", () => {
    const m = byId(+bt.getAttribute("data-whiptalk")); if(!m) return;
    done();
    setTimeout(() => { try{ if(G.running && m.room === G.room) openTalk(m); }catch(e){} }, 60);
  }));
  card.querySelectorAll("[data-whipco]").forEach(bt => bt.addEventListener("click", () => {
    const m = byId(+bt.getAttribute("data-whipco")); if(!m) return;
    askCosponsor(m);
    whipCard();
  }));
}
function askCosponsor(m){
  const b = G.bill; if(!b || b.done || !b.mine || !m) return false;
  b.cosponsors = b.cosponsors || [];
  if(b.cosponsors.indexOf(m.id) >= 0) return true;
  spend(15, 4);
  let lean = 0; try{ lean = alignment(m, b); }catch(e){}
  const warm = m.rel ? m.rel.warmth : 0;
  const odds = clamp(0.25 + lean / 160 + warm / 220 + ((m.allies || []).indexOf(0) >= 0 ? 0.15 : 0), 0.05, 0.9);
  if(Math.random() < odds){
    b.cosponsors.push(m.id);
    m.pledge = 1; m.pledgeDay = G.day;
    try{ ripple(m, 3, "They asked me to put my name on their bill. I did.", 2, true); }catch(e){}
    G.you.standing = clamp((G.you.standing || 0) + 2, 0, 100);
    note(m.name + " will cosponsor " + b.title + ".", true);
    try{ achieve("cosponsor"); }catch(e){}
    return true;
  }
  try{ ripple(m, -1, "They wanted my name on their bill before I had read it.", -1); }catch(e){}
  feed(surname(m.name) + " will not put their name to it. Not yet.");
  return false;
}
function whipTarget(){
  const w = G.whip;
  if(!w || w.day !== G.day) return null;
  const m = byId(w.id);
  if(!m || m.gone || m.away || m.room === "away"){ return null; }
  return m;
}
/* your own drafts wait their turn; they do not erase the live bill */
function nextBillOrQueued(){
  if(G.billQueue && G.billQueue.length){
    const b = G.billQueue.shift();
    b.voteDay = (G.day || 1) + rint(3, 5);
    note(b.title + " comes off the queue and onto the calendar.", true);
    return b;
  }
  return makeBill();
}
function placeYourBill(b){
  try{ achieve("ownbill"); }catch(e){}
  if(G.bill && !G.bill.done && !G.bill.mine){
    G.billQueue = G.billQueue || [];
    G.billQueue.push(b);
    note(b.title + " is filed. It goes on the calendar after the " + G.bill.title.split(" ")[0] + " roll call.", true);
    return false;
  }
  G.bill = b;
  return true;
}
/* ── 20261011f · faith that moves on its own ─────────────────
   Each state keeps pockets of established confession (shares per creed).
   Nightly: shares are pulled back toward the state's own baseline (so
   nothing runs away to 100%), drift a little with neighbouring states and
   with the members the state sends here, and take rare local revivals.
   Members carry devotion and doubt; conversions, lapses and revivals come
   from their own ties, memories and home congregations. The player can
   act on none of it directly. Creed never decides a vote. */
const FAITH_K = CREEDS.map(c => c.k);
const FAITH_FROZEN = (m) => !m || m.gone || m.machine || m.sanctioned || m.kind === "envoy" || m.kind === "press" || isChaplain(m);
function faithEnsure(){
  if(!G.faith) G.faith = {st:{}, log:[], conv:0, day:G.day || 1, hist:[]};
  const F = G.faith;
  (G.states || []).forEach(s => {
    if(F.st[s.n]) return;
    const base = {}; let tot = 0;
    FAITH_K.forEach(k => {
      let w = 0.035;
      if(k === s.creed) w = 0.40;
      if(k === "latin") w += 0.13;
      if(k === "none") w += 0.05;
      if(k === "consul") w = (s.n === "Nieuw Oranje" || s.n === "Nieuw Haarlem") ? 0.06 : 0.012;
      w *= 0.85 + Math.random() * 0.3;
      base[k] = w; tot += w;
    });
    FAITH_K.forEach(k => base[k] = base[k] / tot);
    F.st[s.n] = {base, sh:Object.assign({}, base), rev:null};
  });
  return F;
}
function faithMember(m){
  if(!m) return null;
  if(!m.faith){
    const conv = (m.traits && m.traits.conviction) || 50;
    m.faith = {dev:clamp(conv * 0.7 + rint(-15, 15), 5, 95), doubt:rint(5, 30), since:G.day || 1, was:null};
  }
  return m.faith;
}
function faithNeighbours(s){
  return (G.states || []).filter(o => o !== s && Math.abs(o.col - s.col) + Math.abs(o.row - s.row) === 1);
}
function topCreed(sh){
  let bk = "latin", bv = -1;
  for(const k in sh) if(sh[k] > bv){ bv = sh[k]; bk = k; }
  return bk;
}
function faithNight(news){
  const F = faithEnsure();
  const members = (G.members || []).filter(m => !FAITH_FROZEN(m));
  /* 1 · congregations: anchor + neighbours + the members a state sends + rare revival */
  const next = {};
  (G.states || []).forEach(s => {
    const S = F.st[s.n]; if(!S) return;
    const nb = faithNeighbours(s);
    const own = members.filter(m => m.state === s.n);
    const out = {}; let tot = 0;
    FAITH_K.forEach(k => {
      const x = S.sh[k];
      let nbAvg = x;
      if(nb.length){ nbAvg = 0; nb.forEach(o => nbAvg += (F.st[o.n] ? F.st[o.n].sh[k] : x)); nbAvg /= nb.length; }
      let mem = x;
      if(own.length){
        let wsum = 0, hit = 0;
        own.forEach(m => { const f = faithMember(m); const w = (0.3 + f.dev / 100) * (m.creed === "consul" ? 0.3 : 1); wsum += w; if(m.creed === k) hit += w; });
        mem = hit / wsum;
      }
      let y = x + 0.045 * (S.base[k] - x) + 0.018 * (nbAvg - x) + 0.006 * (mem - x);
      y += (Math.random() - 0.5) * 0.012 * Math.sqrt(x + 0.01);
      if(S.rev && S.rev.k === k && G.day <= S.rev.until) y += 0.006;
      if(y > 0.70) y -= (y - 0.70) * 0.3;          /* nothing becomes the whole state */
      out[k] = Math.max(0.004, y); tot += out[k];
    });
    FAITH_K.forEach(k => out[k] /= tot);
    next[s.n] = out;
    /* the baseline itself creeps very slowly toward what people actually do */
    FAITH_K.forEach(k => S.base[k] = S.base[k] * 0.996 + out[k] * 0.004);
    if(!S.rev && chance(0.012)){
      const pickK = pick(FAITH_K.filter(k => k !== "consul" && k !== "none" && k !== topCreed(out)));
      S.rev = {k:pickK, until:(G.day || 1) + rint(5, 12)};
      faithLog(news, "A revival in " + s.n + ": " + creedOf(pickK).t + " is filling rooms it had given up on.", s.n);
    } else if(S.rev && G.day > S.rev.until) S.rev = null;
  });
  for(const n in next) F.st[n].sh = next[n];
  /* 2 · members: devotion, doubt, and the moves that come out of them */
  members.forEach(m => {
    const f = faithMember(m);
    const S = F.st[m.state];
    const home = S ? (S.sh[m.creed] || 0) : 0.2;
    const friends = (m.allies || []).map(byId).filter(o => o && !FAITH_FROZEN(o));
    const sameF = friends.filter(o => o.creed === m.creed).length;
    let grief = 0;
    try{ const v = memValence(m); if(v < -20) grief = Math.min(6, -v / 12); }catch(e){}
    /* devotion settles toward what their life supports: home congregation, friends who kneel with them, their own conviction */
    const conv = (m.traits && m.traits.conviction) || 50;
    const target = 30 + home * 70 + sameF * 7 + conv * 0.22 - grief * 2;
    f.dev = clamp(f.dev + (target - f.dev) * 0.06 + rint(-3, 3), 0, 100);
    f.doubt = clamp(f.doubt + grief * 0.8 + (friends.length - sameF) * 0.4 - (f.doubt - 20) * 0.05 + rint(-3, 3), 0, 100);
    if(m.creed === "consul") return;            /* the Rite only moves through its own (consularRecruit) */
    if(f.doubt > 38 && f.dev < 50 && chance(0.07)){
      /* where the doubt goes: the faith of the people they actually sit with, else the strong local pocket */
      const cand = {};
      friends.forEach(o => { if(o.creed !== m.creed) cand[o.creed] = (cand[o.creed] || 0) + 2; });
      if(S) FAITH_K.forEach(k => { if(k !== m.creed && k !== "consul") cand[k] = (cand[k] || 0) + S.sh[k] * 6; });
      const consulFriend = friends.find(o => isConsular(o));
      if(consulFriend && chance(0.35)){
        if(consularRecruit(consulFriend, m, "the doubt found a door")){ faithMoved(m, "consul", news); }
        return;
      }
      delete cand.consul;
      let tot = 0; for(const k in cand) tot += cand[k];
      let r = Math.random() * tot, to = null;
      for(const k in cand){ r -= cand[k]; if(r <= 0){ to = k; break; } }
      if(to) faithConvert(m, to, news, friends.find(o => o.creed === to));
      return;
    }
    if(m.creed !== "none" && f.dev < 14 && f.doubt > 40 && chance(0.05)){ faithConvert(m, "none", news, null); return; }
    if(m.creed === "none" && f.doubt > 45 && chance(0.04)){
      const k = S ? topCreed(S.sh) : "latin";
      if(k !== "none" && k !== "consul") faithConvert(m, k, news, null, true);
    }
  });
  /* history for the parish notices (one sample per night, short) */
  try{
    const ys = G.you && F.st[G.you.state];
    if(ys){ F.hist.push({d:G.day, sh:Object.assign({}, ys.sh)}); if(F.hist.length > 40) F.hist.shift(); }
  }catch(e){}
}
function faithLog(news, text, where){
  const F = faithEnsure();
  F.log.unshift({d:G.day, t:text, w:where || ""});
  if(F.log.length > onumLim(40,"hist")) F.log.pop();
  if(news && news.length < 9) news.push(text);
}
function faithMoved(m, to, news){
  const f = faithMember(m);
  f.was = m.creed === to ? f.was : m.creed; f.since = G.day; f.dev = 45; f.doubt = 12;
  G.faith.conv = (G.faith.conv || 0) + 1;
}
function faithConvert(m, to, news, via, revival){
  if(FAITH_FROZEN(m) || to === m.creed || to === "consul") return false;
  const from = m.creed;
  const f = faithMember(m);
  m.creed = to;
  if(m.consular && to !== "consul"){ m.consular = false; if(m.faction === "consul") m.faction = null; }
  f.was = from; f.since = G.day; f.dev = revival ? 55 : 42; f.doubt = 10;
  G.faith.conv = (G.faith.conv || 0) + 1;
  /* politics feels it, slowly: a tenth of the way toward the new confession's leanings */
  try{ const c = creedOf(to); for(const a in (c.pos || {})) if(m.pos && m.pos[a] !== undefined) m.pos[a] = Math.round(m.pos[a] * 0.9 + c.pos[a] * 0.1); }catch(e){}
  try{ m.soul = null; soulEnsure(m); }catch(e){}
  try{
    (G.members || []).forEach(o => {
      if(o === m || FAITH_FROZEN(o) || !o.rel) return;
      if(o.creed === to && (o.allies || []).indexOf(m.id) < 0 && chance(0.25)) o.allies = (o.allies || []).concat([m.id]).slice(-4);
    });
  }catch(e){}
  const tc = creedOf(to), fc = creedOf(from);
  const line = to === "none"
    ? surname(m.name) + " has stopped going. " + fc.t.replace(/^the /, "The ") + " noticed before anyone else did."
    : revival
      ? surname(m.name) + " is back in a pew, with " + tc.t + "."
      : surname(m.name) + " has been received into " + tc.t + (via ? ", by way of " + surname(via.name) + "'s dinner table." : ".");
  remember(m, to === "none" ? "I stopped going. Nobody from the parish called." : "I changed where I kneel. It was not about the House.", 6, true);
  faithLog(news, line, m.state);
  return true;
}
function faithWord(f){
  if(!f) return "keeps it private";
  const dv = f.dev, db = f.doubt;
  if(dv > 75 && db < 25) return "steady, and goes twice a week";
  if(dv > 55) return db > 45 ? "devout, with a question they will not name" : "goes, and means it";
  if(dv > 30) return db > 50 ? "goes less than they did" : "goes on the big days";
  return db > 50 ? "has not been in months and does not say why" : "goes for funerals";
}
/* the player: choose at the oath, change in the world */
function faithShareLine(stName){
  const F = faithEnsure(); const S = F.st[stName]; if(!S) return "";
  return FAITH_K.map(k => ({k, v:S.sh[k]})).sort((a, b) => b.v - a.v).slice(0, 5)
    .map(x => creedOf(x.k).adj + " " + Math.round(x.v * 100) + "%").join(" · ");
}
function parishCard(){
  const F = faithEnsure();
  const st = G.you.state, S = F.st[st];
  if(!S){ note("No parish notices here."); return; }
  G.running = false;
  const rows = FAITH_K.map(k => ({k, v:S.sh[k], b:S.base[k]})).sort((a, b) => b.v - a.v);
  const old = F.hist.length > 6 ? F.hist[F.hist.length - 7].sh : null;
  const mine = (G.you.creed || "latin");
  const inst = G.you.instruct;
  card.innerHTML = '<div class="eyebrow">Parish notices · ' + st + '</div><h1>Who kneels where, at home</h1>' +
    '<p class="dream">The noticeboards of every church in the state, read on one afternoon. Nobody wrote these numbers for you.</p>' +
    rows.map(r => {
      const d = old ? Math.round((r.v - (old[r.k] || 0)) * 1000) / 10 : 0;
      const c = creedOf(r.k);
      const can = r.k !== mine && r.k !== "consul" && r.v >= 0.04;
      const ready = inst && inst.k === r.k && G.day > inst.day;
      return '<div class="whip__row"><span class="whip__n">' + c.t.replace(/^the /, "The ").replace(/^no /, "No ") + (r.k === mine ? ' <i>yours</i>' : '') + '</span>' +
        '<span class="whip__w">' + Math.round(r.v * 100) + '%' + (old ? (d > 0.4 ? ' · rising' : d < -0.4 ? ' · thinning' : ' · steady') : '') +
        (S.rev && S.rev.k === r.k ? ' · revival' : '') + '</span>' +
        '<span class="whip__b">' + (can ? '<button type="button" class="btn btn--ghost whip__go" data-faith="' + r.k + '">' +
          (ready ? 'Be received' : (inst && inst.k === r.k ? 'Come back tomorrow' : 'Talk with their clergy')) + '</button>' : '') + '</span></div>';
    }).join("") +
    (mine === "consul" ? '<p>You keep the Consul’s precepts. To come back, go across the street to confession: <button type="button" class="btn btn--ghost" data-faith="latin">Make a confession</button></p>' : '') +
    '<p style="opacity:.7">The Consular Rite is not received at a church door. Nobody is received into it at a door. People come to it, or leave it, of their own accord. God is the Most High, Christ is King, and the First Consul is a man under God.</p>' +
    '<div class="card__actions"><button type="button" class="btn" id="parishClose">Back to the street</button></div>';
  veil.hidden = false;
  el("parishClose").addEventListener("click", () => walkNow());
  card.querySelectorAll("[data-faith]").forEach(bt => bt.addEventListener("click", () => {
    const k = bt.getAttribute("data-faith");
    faithPlayerStep(k);
    parishCard();
  }));
}
function faithPlayerStep(k){
  const you = G.you, mine = you.creed || "latin";
  if(k === mine) return;
  if(mine === "consul" && k === "latin"){
    spend(30, 6);
    try{ riteYouLeave("confession"); }catch(e){ you.creed = "latin"; you.consular = false; }
    note("You made a confession and came back to the Latin Rite. The remnant at the bronze will remember the empty place.", true);
    faithLog(null, you.name + " returned to the Latin Rite.", you.state);
    return;
  }
  const inst = you.instruct;
  if(!inst || inst.k !== k){
    spend(30, 4);
    you.instruct = {k, day:G.day};
    setSay("They give you tea and a thin book. Come back another day, they say, if you still mean it.", fx("instruction begun", "30 minutes"));
    return;
  }
  if(G.day <= inst.day){ setSay("Not today. They were clear about that.", fx("", "")); return; }
  spend(45, 6);
  const F = faithEnsure(), S = F.st[you.state];
  const dShare = S ? (S.sh[k] || 0) - (S.sh[mine] || 0) : 0;
  you.creed = k; you.instruct = null;
  you.approval = clamp(you.approval + Math.round(dShare * 14), 0, 100);
  (G.members || []).forEach(m => {
    if(FAITH_FROZEN(m) || !m.rel) return;
    if(m.creed === k) m.rel.warmth = clamp(m.rel.warmth + 4, -100, 100);
    else if(m.creed === mine) m.rel.warmth = clamp(m.rel.warmth - 3, -100, 100);
  });
  you.faithSince = G.day;
  note("You were received into " + creedOf(k).t + ". The district will hear it before the House does.", true);
  faithLog(null, you.name + " was received into " + creedOf(k).t + ".", you.state);
  try{ achieve("received"); }catch(e){}
}

/* ── 20261011f · the building has a life of its own ──────────
   Members keep private journals and dreams, carry long aims that ripen
   over days and then act on them without being asked (a bloc, a bill of
   their own, a friendship, a feud). Some of them start noticing the shape
   of the place. At night things happen that you find in the morning.
   Rarely, something happens that nothing explains. All of it is saved and
   all of it can be found; none of it runs while you walk. */
const LIFE_AIMS = ["bill", "bloc", "friend", "feud", "faith", "notice"];
const BLOC_NAMES = ["the Tuesday Group", "the Lantern Caucus", "the Back Bench Compact", "the Quiet Table", "the Harbour Seven",
  "the Orchard Caucus", "the Long Room Group", "the Second Reading Club", "the Night Ledger", "the Window Caucus"];
const NOTICE_LINES = [
  "Some mornings the corridor is exactly as long as I need it to be. I have stopped mentioning it.",
  "When I am not in a room, I wonder whether it waits for me. I do not ask anyone. It is not a House question.",
  "There is somebody in this building who walks it the way I do. Neither of us has said so.",
  "I tried to remember my mother's kitchen and found I remembered the idea of it instead.",
  "The clock in the cloakroom never needs winding. Somebody must wind it. I have never seen them.",
  "I keep a list of the things I decided today. It is shorter than the list of things I did.",
  "Whatever I am, I am under God. That part I do not wonder about.",
  "I wonder whether the one I keep passing in the corridor wonders the same thing about me.",
  "The days have the same number of hours and some of them are longer. I have checked.",
  "I said a sentence today I do not remember choosing. It was a good sentence."
];
const DREAM_PARTS = {
  a:["I was in the chamber and every seat was mine", "I was walking the East Steps and they kept going down", "I was back at home and the house had a second staircase",
     "I was counting votes on a train", "I was in the cloakroom and the coats were warm, as if people had just left them", "I was reading my own name on a ballot in a language I knew in the dream"],
  b:["and nobody would look up.", "and I was not afraid, which frightened me when I woke.", "and the clerk said the vote was already taken.",
     "and somebody I have never met knew my middle name.", "and my father was in the gallery, younger than me.", "and the bill was blank and everyone agreed with it."]
};
function lifeEnsure(){
  if(!G.life) G.life = {anoms:[], found:0, happen:[], blocs:[], n:0, lastAnom:0, kinds:{}};
  return G.life;
}
function lifeOf(m){
  if(!m) return null;
  if(!m.lv){
    m.lv = {aim:null, j:[], dream:"", notice:Math.random() * 0.25, acted:[]};
    lifeNewAim(m);
    if(m.lv.aim) m.lv.aim.p = Math.random() * 0.7;
  }
  return m.lv;
}
function lifeNewAim(m){
  const L = m.lv, tr = m.traits || {};
  const w = {bill:(tr.ambition || 50) / 40, bloc:(tr.ambition || 50) / 60 + (tr.loyalty || 50) / 120,
    friend:1 + ((m.rel && m.rel.warmth) || 0) / 80, feud:(tr.temper || 40) / 45, faith:(tr.conviction || 50) / 70, notice:0.5 + L.notice * 2};
  let tot = 0; for(const k in w){ w[k] = Math.max(0.05, w[k]); tot += w[k]; }
  let r = Math.random() * tot, k = "friend";
  for(const kk in w){ r -= w[kk]; if(r <= 0){ k = kk; break; } }
  const others = (G.members || []).filter(o => o !== m && !FAITH_FROZEN(o));
  let target = null;
  if(k === "friend") target = (others.filter(o => o.party !== m.party && (m.allies || []).indexOf(o.id) < 0).sort(() => Math.random() - 0.5)[0] || null);
  if(k === "feud"){ const fresh = others.filter(o => o.id !== m.rival && (m.allies || []).indexOf(o.id) < 0 && o.rival !== m.id); target = fresh.length ? pick(fresh) : null; if(!target) k = "notice"; }
  L.aim = {k, t:target ? target.id : null, p:0, since:G.day || 1};
}
function lifeWrite(m, line){
  const L = lifeOf(m);
  L.j.unshift({d:G.day, t:line});
  if(L.j.length > 10) L.j.pop();
}
function lifeNight(news){
  const life = lifeEnsure();
  const members = (G.members || []).filter(m => !FAITH_FROZEN(m));
  members.forEach(m => {
    const L = lifeOf(m), tr = m.traits || {};
    /* the dream */
    L.dream = wlDream(m) || L.dream || "";
    /* the journal: what actually happened to them, in their words */
    const mem = m.mem && m.mem[0] && m.mem[0].d >= (G.day || 1) - 1 ? m.mem[0].t : null;
    if(mem && chance(0.7)) lifeWrite(m, mem);
    else if(L.dream && chance(0.35)) lifeWrite(m, L.dream);
    /* noticing grows in the quiet ones */
    L.notice = clamp(L.notice + ((tr.discretion || 50) > 60 ? 0.025 : 0.01) + (L.aim && L.aim.k === "notice" ? 0.05 : 0), 0, 1);
    if(L.notice > 0.45 && chance(0.18)){ const nl = wlNotice(m); if(nl) lifeWrite(m, nl); }
    /* the long aim */
    const A = L.aim; if(!A) { lifeNewAim(m); return; }
    const rate = 0.035 + Math.random() * 0.05 + ((tr.ambition || 50) - 50) / 1500;
    A.p += rate;
    if(A.p < 1) return;
    /* the building can only take so much news in one night */
    if((life._actedDay === G.day ? life._acted : 0) >= 2 && A.k !== "faith" && A.k !== "notice"){ A.p = 0.97; return; }
    if(A.k !== "faith" && A.k !== "notice"){ if(life._actedDay !== G.day){ life._actedDay = G.day; life._acted = 0; } life._acted++; }
    lifeAct(m, A, news);
    L.acted.unshift({d:G.day, k:A.k}); if(L.acted.length > 6) L.acted.pop();
    lifeNewAim(m);
  });
  /* night happenings you find in the morning */
  try{ wlHappening(news); }catch(e){}
  /* rare things that are not explained */
  if((G.day || 1) - (life.lastAnom || 0) >= 5 && chance(0.07)) lifeAnomaly(news);
}
function lifeAct(m, A, news){
  const life = lifeEnsure();
  const name = surname(m.name);
  if(A.k === "bill"){
    if((G.billQueue || []).some(b => b.npc) || (typeof hopStore === "function" && hopStore().some(x => x && x.npc && x.sponsorId === m.id))) { lifeWrite(m, "My bill is ready. The calendar is not."); return; }
    const keepS = new Map((G.members || []).map(x => [x, x.sway]));
    const b = makeBill();
    keepS.forEach((v, x) => { x.sway = v; });
    const ax = AXES.slice().sort((x, y) => Math.abs((m.pos || {})[y.k] || 0) - Math.abs((m.pos || {})[x.k] || 0))[0];
    for(const a of AXES) b.pos[a.k] = Math.round(b.pos[a.k] * 0.4);
    b.pos[ax.k] = Math.round(clamp(((m.pos || {})[ax.k] || 0) * 1.4, -85, 85));
    b.sponsor = m.name; b.sponsorParty = m.party; b.sponsorId = m.id; b.npc = true;
    try{ b.line = describeBill(b); }catch(e){}
    let t;
    if(typeof hopAdmit === "function" && hopAdmit(b)){ t = name + " filed the " + b.title + " on their own; it is referred to the Committee on " + (b.road ? b.road.t : "the whole House") + "."; }
    else { lifeWrite(m, "The committee rooms are full. My bill can wait until they are not."); return; }
    lifeWrite(m, "I filed it. Nobody asked me to. That is the point of it.");
    life.happen.unshift({d:G.day, t}); news.push(t);
    return;
  }
  if(A.k === "bloc"){
    const allies = Array.from(new Set(m.allies || [])).filter(id => id !== m.id).map(byId).filter(o => o && o !== m && !FAITH_FROZEN(o) && !o.bloc).slice(0, 3);
    if(allies.length < 2){ lifeWrite(m, "Two people is a dinner. Three is a caucus. I am still one short."); A.p = 0.6; return; }
    const used = life.blocs.map(b => b.n);
    const n = BLOC_NAMES.find(x => used.indexOf(x) < 0) || ("the " + name + " Group");
    const bl = {n, by:m.id, ids:[m.id].concat(allies.map(o => o.id)), d:G.day};
    life.blocs.push(bl);
    [m].concat(allies).forEach(o => {
      o.bloc = n;
      bl.ids.forEach(id => { if(id !== o.id && (o.allies || []).indexOf(id) < 0) o.allies = (o.allies || []).concat([id]).slice(-5); });
    });
    lifeWrite(m, "We have a name now. " + n.replace(/^the /, "The ") + ". We meet where nobody books the room.");
    const t = name + " has formed " + n + " with " + listify(allies.map(o => surname(o.name))) + ". They vote together more than they admit.";
    life.happen.unshift({d:G.day, t}); news.push(t);
    return;
  }
  if(A.k === "friend"){
    const o = byId(A.t); if(!o || FAITH_FROZEN(o)) return;
    if((m.allies || []).indexOf(o.id) < 0) m.allies = (m.allies || []).concat([o.id]).slice(-5);
    if((o.allies || []).indexOf(m.id) < 0) o.allies = (o.allies || []).concat([m.id]).slice(-5);
    remember(o, "I had dinner with " + m.name + ". Across the aisle. Nobody died.", 5, true);
    lifeWrite(m, "Dinner with " + o.name + ". We disagree on everything except the wine.");
    const t = name + " and " + surname(o.name) + " were seen at dinner again. Across the aisle. Their whips have noticed.";
    life.happen.unshift({d:G.day, t}); news.push(t);
    return;
  }
  if(A.k === "feud"){
    const o = byId(A.t); if(!o || FAITH_FROZEN(o)) return;
    m.rival = o.id; o.rival = m.id;
    (m.allies || []).forEach(id => { const a = byId(id); if(a && a.rel) remember(a, m.name + " has a feud with " + o.name + " and wants me on their side of it.", -2); });
    remember(o, m.name + " said something about me on the floor. I heard about it in the cloakroom.", -8, true);
    lifeWrite(m, "I said it on the floor. I would say it again.");
    const t = name + " and " + surname(o.name) + " are not speaking. It started over a sentence on the floor and it will end in a vote.";
    life.happen.unshift({d:G.day, t}); news.push(t);
    return;
  }
  if(A.k === "faith"){
    const f = faithMember(m); f.dev = clamp(f.dev + 18, 0, 100); f.doubt = clamp(f.doubt - 12, 0, 100);
    lifeWrite(m, "Went in on a Tuesday when nobody was there. Stayed an hour.");
    return;
  }
  if(A.k === "notice"){
    const L = lifeOf(m); L.notice = clamp(L.notice + 0.25, 0, 1);
    { const nl = wlNotice(m); if(nl) lifeWrite(m, nl); }
    if(L.notice >= 0.9 && !L.wrote && G.you && !lifeEnsure().kinds.asks){
      L.wrote = true;
      try{
        pushMail(m, "A question I will not ask on the floor",
          "I am writing this by hand so it cannot be forwarded.\n\nDo you ever have the sense that you were placed in this building rather than elected to it? That the corridor knows where you are going? I do not want an answer. I think if either of us answered it, we would have to stop.\n\nGod is the Most High. Whatever we are, we are under that.\n\n" + m.name, {kind:"note"});
      }catch(e){}
      lifeAnomFound("asks", m, "A member wrote to you, by hand, asking whether you were placed here rather than elected. They did not want an answer.", true);
    }
  }
}
const HAPPENINGS = [
  {k:"chairs", t:"Somebody turned your visitor chairs to face the window overnight. Nothing else was touched."},
  {k:"lamp", t:"The desk lamp in your office was left on. You turned it off last night. You are fairly sure."},
  {k:"cup", t:"There is a second coffee cup on your desk, still warm. Nobody has been in, says the corridor guard."},
  {k:"page", t:"A page from a bill you have never seen is on your chair, with one word underlined: yet."},
  {k:"flag", t:"Your flag has been refolded the old way, the way they did it before the war."},
  {k:"note", t:"A note under your door: \"I voted with you and I did not tell anyone. Do not thank me.\" Unsigned."}
];
function lifeHappening(news){
  const life = lifeEnsure();
  const h = pick(HAPPENINGS);
  life.pending = {k:h.k, t:h.t, d:(G.day || 1) + 1};
}
function lifeMorningCheck(){
  /* called cheaply from paintJob: a pending happening is found when you first stand in your office */
  const life = G.life; if(!life || !life.pending) return;
  if(G.room !== "office" || !G.running) return;
  if(Math.hypot(cam.vx || 0, cam.vz || 0) > 0.12) return;
  const p = life.pending; life.pending = null;
  life.happen.unshift({d:G.day, t:p.t, mine:true});
  if(life.happen.length > onumLim(30,"hist")) life.happen.length = onumLim(30,"hist");
  note(p.t, true);
  try{ if(typeof achieve === "function") achieve("night"); }catch(e){}
}
const ANOMS = [
  {k:"session", hint:"A member remembers a session that did not happen."},
  {k:"tomorrow", hint:"A letter arrives dated tomorrow."},
  {k:"roll", hint:"The whip count lists a name nobody knows."},
  {k:"asks", hint:"A member asks the question nobody asks."},
  {k:"echo", hint:"Two members dream the same dream."}
];
function lifeAnomaly(news){
  const life = lifeEnsure();
  const left = ANOMS.filter(a => !life.kinds[a.k] && a.k === "echo");   /* 20261027d: nothing is put in the record that did not happen */
  if(!left.length) return;
  const a = pick(left);
  life.lastAnom = G.day || 1;
  const ms = (G.members || []).filter(m => !FAITH_FROZEN(m));
  if(!ms.length) return;
  const m = pick(ms);
  if(a.k === "session"){
    const fake = pick(BILL_A) + " " + pick(BILL_B) + " " + pick(BILL_C);
    lifeOf(m).ghost = {bill:fake, day:Math.max(1, (G.day || 2) - rint(2, 6))};
    lifeWrite(m, "Still thinking about the vote on the " + fake + ". Closest count I ever saw.");
    life.anoms.push({k:a.k, d:G.day, who:m.id, found:false, t:surname(m.name) + " remembers a roll call on the " + fake + " on day " + lifeOf(m).ghost.day + ". There was no such bill. The Clerk has no record."});
  } else if(a.k === "tomorrow"){
    try{
      pushMail(m, "Re: what you said on the steps",
        "Thank you for what you said on the steps this afternoon. I did not expect it of you. I will not forget it.\n\n" + m.name, {kind:"note"});
      G.mail[0].day = (G.day || 1) + 1; G.mail[0].anom = true;
    }catch(e){}
    life.anoms.push({k:a.k, d:G.day, who:m.id, found:false, t:"A letter from " + surname(m.name) + " thanked you for something you said on the steps. It was dated tomorrow."});
  } else if(a.k === "roll"){
    life.ghostRoll = {d:(G.day || 1) + 1, name:newName(pick(STATES))};
    life.anoms.push({k:a.k, d:G.day, found:false, t:"For one day the whip count carried a name nobody in the House knew: " + life.ghostRoll.name + ". No room on record."});
  } else if(a.k === "echo"){
    const o = pick(ms.filter(x => x !== m)); if(!o) return;
    const dream = pick(DREAM_PARTS.a) + " " + pick(DREAM_PARTS.b);
    lifeOf(m).dream = dream; lifeOf(o).dream = dream; lifeOf(m).echo = o.id; lifeOf(o).echo = m.id;
    life.anoms.push({k:a.k, d:G.day, who:m.id, who2:o.id, found:false, t:surname(m.name) + " and " + surname(o.name) + " had the same dream on the same night, word for word, and have never spoken."});
  }
  life.kinds[a.k] = true;
}
function lifeAnomFound(k, m, text, push){
  const life = lifeEnsure();
  let a = life.anoms.find(x => x.k === k && !x.found && (!m || !x.who || x.who === m.id || x.who2 === m.id));
  if(!a && push){ a = {k, d:G.day, who:m ? m.id : null, found:false, t:text}; life.anoms.push(a); life.kinds[k] = true; }
  if(!a || a.found) return false;
  a.found = true; a.fd = G.day; life.found = (life.found || 0) + 1;
  feed("Something you cannot explain. It goes in the notebook.", "big");
  try{ if(typeof achieve === "function") achieve("anomaly"); }catch(e){}
  return true;
}
/* talk: what has been on their mind */
function lifeMindLine(m){
  const L = lifeOf(m), f = faithMember(m);
  if(L.ghost && chance(0.8)){
    lifeAnomFound("session", m);
    return "Still thinking about the " + L.ghost.bill + " roll call, day " + L.ghost.day + ". You were there. You voted. Do you not remember?";
  }
  if(L.echo && chance(0.8)){
    lifeAnomFound("echo", m);
    return "I had a dream. " + L.dream.replace(/^I was/, "I was") + " Odd thing to tell a colleague. I do not know why I told you.";
  }
  const j = L.j[0];
  const aimWords = {bill:"I am writing something. A bill. Do not tell my whip.", bloc:"I am counting friends. Not votes. Friends.",
    friend:"I have been trying to have dinner with someone across the aisle. It is harder than a whip count.",
    feud:"There is someone in this building I would like to see lose a vote. I will not say who.",
    faith:"I have been going to church again. Not for the cameras.", notice:"I have been noticing things. Small things. I keep a list."};
  const parts = [];
  if(j && chance(0.6)) parts.push(j.t);
  if(L.aim) parts.push(aimWords[L.aim.k] || "");
  if(L.notice > 0.5 && chance(0.4)) parts.push(pick(NOTICE_LINES));
  return parts.filter(Boolean).join(" ") || "Nothing I would say in a corridor.";
}
function notebookCard(){
  const life = lifeEnsure(), F = faithEnsure();
  G.running = false;
  const found = life.anoms.filter(a => a.found);
  const unseen = ANOMS.length - found.length;
  card.innerHTML = '<div class="eyebrow">Your notebook</div><h1>Things the building did</h1>' +
    '<div class="whip__h">Unexplained</div>' +
    (found.length ? found.map(a => '<p>Day ' + (a.fd || a.d) + '. ' + a.t + '</p>').join("") : '<p>Nothing yet. Keep your eyes open, and ask people what is on their mind.</p>') +
    (unseen > 0 ? '<p style="opacity:.6">' + Array(unseen).fill("???").join(" · ") + '</p>' : '') +
    '<div class="whip__h">Happenings</div>' +
    ((life.happen || []).slice(0, 8).map(h => '<p>Day ' + h.d + '. ' + h.t + '</p>').join("") || '<p>Quiet so far.</p>') +
    '<div class="whip__h">Faith, on the wire</div>' +
    ((F.log || []).slice(0, 6).map(h => '<p>Day ' + h.d + '. ' + h.t + '</p>').join("") || '<p>No movement worth printing.</p>') +
    ((life.blocs || []).length ? '<div class="whip__h">Blocs</div><p>' + life.blocs.map(b => b.n.replace(/^the /, "The ") + " (" + b.ids.map(byId).filter(Boolean).map(o => surname(o.name)).join(", ") + ")").join("; ") + '</p>' : '') +
    '<div class="card__actions"><button type="button" class="btn" id="nbClose">Close the notebook</button></div>';
  veil.hidden = false;
  el("nbClose").addEventListener("click", () => walkNow());
}
function lifeMailCheck(){
  const life = G.life; if(!life || !life.kinds || !life.kinds.tomorrow) return;
  const a = life.anoms.find(x => x.k === "tomorrow" && !x.found); if(!a) return;
  if((G.mail || []).some(x => x.anom && x.read)) lifeAnomFound("tomorrow");
}

/* ── 20261011g · D'Infinite Taylor Consular Neural Organism (DTCNO) ──
   In-world: a construct the Consular Rite named, heresy-flavoured; in code:
   a fully local speech composer. An invented lexicon (tagged by part of
   speech, topic and sentiment) + a phrase grammar of House templates +
   an order-2 Markov recombiner over those templates (per intent), steered
   by each speaker's local net (netFeel), sentience topic, creed, home
   dialect, warmth to you and current events. Each member keeps an idiolect
   (word preferences that drift as they speak, saved with them).
   No network, no dictionary service, no dictation. Canon guards filter
   every line before anyone hears it. */
