      propSconce(-hw+0.12, 2.15, vn > 62 ? Math.max(3.95, d * 0.48 - 0.35 - 0.55) : 5.4, Math.PI/2);
      propSconce(hw-0.12, 2.15, vn > 62 ? Math.max(3.95, d * 0.55 - 0.35 - 0.55) : 5.4, -Math.PI/2); }
