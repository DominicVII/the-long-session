    else if(act === "vote"){ const v = /^(aye|yes|yea|1)$/i.test(String(e.text || e.target)) ? "aye" : /^(no|nay|-1)$/i.test(String(e.text || e.target)) ? "no" : "present";
      if(SSN) SSN.votes[isYou ? "you" : e.actorId] = v; if(isYou && v !== "present" && SSN && SSN.kind === "house_floor" && G.bill && !G.bill.done){ try{ G.you.vote = v === "aye" ? 1 : -1; }catch(_){} }
