};
function ofhPlayerSeatKey(){ const y = G.you, k = ofhYouKey(); if(!y || !k) return null;
  return k === "house" ? "house:" + y.state + " " + y.dist : k === "senate" ? "sen:" + y.state : k === "gov" ? "gov:" + y.state : k === "pres" ? "pres" : k === "bench" ? "bench:" + ((G.court || []).length ? G.court.length - 1 : 4) : null; }
function ofhTitleOf(key){
  if(key.indexOf("house:") === 0) return "Representative for " + key.slice(6);
  if(key.indexOf("gov:") === 0) return "Governor of " + key.slice(4);
  if(/^sen:(maj|min|ppt)$/.test(key)) return {maj:"Senate Majority Leader", min:"Senate Minority Leader", ppt:"President pro tempore of the Senate"}[key.slice(4)];
  if(key.indexOf("sen:") === 0) return "Senator from " + key.slice(4);
  if(key === "pres"){ try{ return execTitle(); }catch(e){ return "President"; } }
  if(key === "speaker") return "Speaker of the House";
  if(key.indexOf("bench:") === 0) return key === "bench:0" ? "Chief Justice" : "Associate Justice";
  return key;
}
/* who holds each seat right now */
function ofhCurrent(){
  const cur = {}, y = G.you, yk = ofhPlayerSeatKey();
  try{ (OH.list || []).forEach(p => { if(p && p.ohK && !p.gone) cur[p.ohK] = {personId:p.id, name:p.name}; }); }catch(e){}
  try{ (G.members || []).forEach(m => { if(m && !m.gone && m.kind === "member" && m.state) cur["house:" + m.state + " " + m.dist] = {personId:m.id, name:m.name}; }); }catch(e){}
  try{ if(G.exec && G.exec.name && !G.exec.you) cur.pres = cur.pres || {personId:null, name:G.exec.name}; }catch(e){}
  if(yk && y) cur[yk] = {personId:"you", name:y.name};
  return cur;
}
function ofhSeed(key, holder){
  /* a plausible past: one to three earlier holders, each succeeded by the next, the last by today's holder */
  let R_vac = false; const S = ofhEnsure(), r = rng(seedOf("ofh:" + key)), n = 0, st = key.split(":")[1] || null;   /* nothing before the record is invented */
  const H = []; let to = -Math.round(r() * 700 + 60);
  for(let i = 0; i < n; i++){ const len = Math.round(400 + r() * 1800), from = to - len; let nm = null; try{ nm = newName(st && STATES.indexOf(st.replace(/ \d+$/, "")) >= 0 ? st.replace(/ \d+$/, "") : undefined); }catch(e){ nm = null; }
    if(!nm) break; H.unshift({personId:null, name:nm, from, to, how:OFH_LEFT[Math.floor(r() * OFH_LEFT.length)], successor:null, seeded:true}); to = from; }
  for(let i = 0; i < H.length; i++) H[i].successor = H[i + 1] ? H[i + 1].name : (holder ? holder.name : null);
  let start = H.length ? H[H.length - 1].to : -Math.round(r() * 900);
  if(holder && holder.personId === "you"){ start = (G.day || 0) - Math.max(0, ((G.you && G.you.terms) || 1) - 1) * (G.termLength || 52); if(H.length) H[H.length - 1].to = Math.min(H[H.length - 1].to, start); }
