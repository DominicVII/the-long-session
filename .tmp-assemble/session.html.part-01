    const rightDoors = (DOORS.corridor||[]).filter(dr => dr.side==="right");
    const leftZs = corridorSafeZs(d, leftDoors, 2.45);
    const rightZs = corridorSafeZs(d, rightDoors, 2.45);
    const statueZs = leftZs.slice();
    /* Sconces between doors — never on a door opening. Alternate sides so the
       corridor does not mint a dozen point lights (MAX_ROOM_LIGHTS clamps too). */
    leftZs.forEach((z,i) => { if(i % 2 === 0) propSconce(-hw+0.12, 2.6, z, Math.PI/2); });
    rightZs.forEach((z,i) => {
      if(i % 2 === 1) propSconce(hw-0.12, 2.6, z, -Math.PI/2);
