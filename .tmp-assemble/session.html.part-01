     Same clearance fix as the eyes: pushed forward past the skull's face
     plane so the ridge is not carved away by the skull's own surface. */
  const browS = fem ? 0.85 : 1.05;
  M(PG.sph, skin, headG, -hu*0.15*fw, hu*(0.56 + 0.02*bh), hu*0.44,
    hu*0.12*browS, hu*(0.032*bh), hu*0.048, false);
  M(PG.sph, skin, headG,  hu*0.15*fw, hu*(0.56 + 0.02*bh), hu*0.44,
    hu*0.12*browS, hu*(0.032*bh), hu*0.048, false);
  /* lips with volume — same forward nudge as eyes/brow, see above */
  const lipM = njLipMat(skin, fem);
  const mouth = M(PG.sph, lipM, headG, 0, hu*(0.268 + 0.01*lf), hu*0.452, hu*(0.090*lf), hu*(0.024*lf), hu*0.030, false);
  const _nLow = M(PG.sph, lipM, headG, 0, hu*(0.250 + 0.01*lf), hu*0.456, hu*(0.084*lf), hu*(0.030*lf), hu*0.029, false);
  /* the lash line: a thin dark rim along each upper lid is most of what makes an eye read as an eye */
  const lash = matCol(0x1a120d, .7);
  M(PG.sph, lash, headG, -eyeX3, hu*0.512, hu*0.512, hu*0.070, hu*0.008, hu*0.016, false);
  M(PG.sph, lash, headG,  eyeX3, hu*0.512, hu*0.512, hu*0.070, hu*0.008, hu*0.016, false);
  const _nBrow = nmBrows(M, hair, headG, hu, fw, bh, eyeX3, fem);
  nmFaceAge(M, headG, hu, skin, L, fem, headW);
  /* upper eyelids shade the modeled eyes and keep them from looking pasted on */
  const lidL = M(PG.sph, skin, headG, -eyeX3, hu*0.522, hu*0.503, hu*0.075, hu*0.018, hu*0.022, false);
  const lidR = M(PG.sph, skin, headG,  eyeX3, hu*0.522, hu*0.503, hu*0.075, hu*0.018, hu*0.022, false);
  nbFace(M, headG, hu, skin, eyeX3, nl, lf, fem);

  /* Hair: readable cuts. Parting is two combed plates with a scalp gap — not a lump. */
  const personWisps = [];
  const hairW = headW, hairH = headH, hairD = headD;
  const hs = (L.style|0) % 7;
  const puff = (x,y,z,sx,sy,sz, cast) => {
    const q = neSidePuff(hairW, hu, x, sx, sy, sz, hs === 4);
    if(q){ x = q[0]; sx = q[1]; sy = q[2]; sz = q[3]; }
    return M(PG.sph, hair, headG, x, y, z, sx, sy, sz, cast===true);
  };
  const comb = (x,y,z,sx,sy,sz, rz) => {
    const m = M(PG.sph, hair, headG, x, y, z, sx, sy, sz, false);
    if(rz) m.rotation.z = rz;
    return m;
  };
  if(hs === 0){
    /* Short back and sides — tight crown, faded sides, open forehead */
    puff(0, hu*0.62, -hu*0.08, hairW*0.92, hairH*0.22, hairD*0.86);
    puff(0, hu*0.50, -hu*0.38, hairW*0.78, hairH*0.36, hairD*0.42);
    puff(-hairW*0.72, hu*0.46, -hu*0.06, hu*0.10, hu*0.22, hu*0.28);
    puff( hairW*0.72, hu*0.46, -hu*0.06, hu*0.10, hu*0.22, hu*0.28);
  } else if(hs === 1){
    /* Side parting — two flattened combs, scalp showing in the gap (05a: wider part). */
    const side = ((p.id||0) % 2) ? 1 : -1;
    comb(side*hu*0.32, hu*0.58,  hu*0.04, hairW*0.46, hairH*0.15, hairD*0.86, side*0.22);
    comb(side*hu*0.28, hu*0.56, -hu*0.16, hairW*0.44, hairH*0.14, hairD*0.72, side*0.12);
    comb(side*hu*0.22, hu*0.54, -hu*0.36, hairW*0.38, hairH*0.13, hairD*0.50, side*0.06);
    comb(-side*hu*0.36, hu*0.52,  hu*0.00, hairW*0.24, hairH*0.11, hairD*0.70, -side*0.16);
    comb(-side*hu*0.32, hu*0.50, -hu*0.22, hairW*0.22, hairH*0.10, hairD*0.52, -side*0.08);
    puff(0, hu*0.34, -hu*0.50, hairW*0.78, hairH*0.24, hairD*0.40);
    puff(side*hairW*0.82, hu*0.42, -hu*0.04, hu*0.12, hu*0.22, hu*0.32);
    puff(-side*hairW*0.80, hu*0.40, -hu*0.04, hu*0.10, hu*0.18, hu*0.28);
  } else if(hs === 2){
    /* Pinned up — nape clean, bun sits on the crown-back */
    puff(0, hu*0.58, -hu*0.10, hairW*0.92, hairH*0.58, hairD*0.80);
    puff(-hairW*0.70, hu*0.44, -hu*0.06, hu*0.14, hu*0.22, hu*0.28);
    puff( hairW*0.70, hu*0.44, -hu*0.06, hu*0.14, hu*0.22, hu*0.28);
    puff(0, hu*0.70, -hu*0.52, hu*0.38, hu*0.32, hu*0.32, true);
    puff(0, hu*0.66, -hu*0.58, hu*0.28, hu*0.24, hu*0.24);
  } else if(hs === 3){
    /* Thinning — horseshoe, bald crown, no cap on top */
    puff(-hairW*0.72, hu*0.40, -hu*0.02, hu*0.22, hu*0.32, hu*0.48);
    puff( hairW*0.72, hu*0.40, -hu*0.02, hu*0.22, hu*0.32, hu*0.48);
    puff(0, hu*0.34, -hu*0.52, hairW*0.86, hairH*0.40, hairD*0.42);
    puff(-hairW*0.50, hu*0.50, -hu*0.28, hu*0.20, hu*0.16, hu*0.30);
    puff( hairW*0.50, hu*0.50, -hu*0.28, hu*0.20, hu*0.16, hu*0.30);
  } else if(hs === 4){
    /* Long — falls to the collar, sides frame the face, forehead open */
    puff(0, hu*0.56, -hu*0.08, hairW*1.04, hairH*0.78, hairD*0.98);
    puff(0, hu*0.18, -hu*0.50, hairW*0.96, hairH*0.95, hairD*0.62);
    puff(0, -hu*0.28, -hu*0.42, hairW*0.82, hairH*0.70, hairD*0.48);
    puff(-hairW*0.82, hu*0.22,  hu*0.04, hu*0.22, hu*0.70, hu*0.28);
