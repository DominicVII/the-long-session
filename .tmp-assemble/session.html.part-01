const DYN_YR = 12;               /* family time: twelve game days make a year */
const DYN_SURCUSTOM = {dutch:"father", yankee:"father", midlands:"father", prairie:"father", delta:"father", highplains:"father", mountain:"either", pacific:"double"};
function dynEnsure(){ if(!G.dyn || G.dyn.v !== 1) G.dyn = {v:1, P:{}, court:{}, houses:{}, seq:0, day:-1, log:[]}; return G.dyn; }
function dynYear(){ return Math.floor((G.day || 0) / DYN_YR); }
function dynAge(r){ return r ? Math.floor(((G.day || 0) - r.born) / DYN_YR) : 0; }
function dynSur(name){ const p = String(name || "").trim().split(" "); if(p.length < 2) return p[0] || ""; const PT = ["van","der","de","ten","den","la","le","du","von","di","da","del","mac","st."];
  let i = p.length - 1; while(i > 1 && PT.indexOf(p[i - 1].toLowerCase()) >= 0) i--; return p.slice(i).join(" "); }
function dynFirst(name){ return String(name || "").split(" ")[0]; }
const DYN_FEM = new Set("Anneliese Katrijn Femke Saskia Marieke Lotte Heleen Noor Elsbeth Johanna Mirjam Geertje Wies Trien Liesbeth Margaret Prudence Abigail Mercy Hannah Patience Lydia Temperance Ruth Constance Hepzibah Faith Clara Dorothy Eunice Brigid Maeve Niamh Siobhan Aisling Bronwen Fiona Cerys Grainne Orla Caitlin Aoife Nuala Roisin Deirdre Ingrid Astrid Solveig Freya Greta Kirsten Helga Marta Dagny Elsa Linnea Ingeborg Esther Celestine Amara Delphine Asha Imani Solange Odette Camille Nia Zora Amina Esme Rosalie Vivienne Eloise Elena Claire Rosa Isabel Lucia Carmen Pilar Sofia Ana Valentina June Harper Teresa Ines Mariana Moira Aileen Sorcha Iona Una Eilidh Morag Isla Bonnie Maisie Kirsty Elspeth Catriona Mei Priya Aiko Sana Yuki Hana Lina Nora Min Ananya Camila Sakura".split(" "));
function dynSexOfName(first){ if(DYN_FEM.has(first)) return "f"; try{ if(KIN_FIRST.F.indexOf(first) >= 0) return "f"; if(KIN_FIRST.M.indexOf(first) >= 0) return "m"; }catch(e){} for(const k in NAME_CULTURES) if((NAME_CULTURES[k].first || []).indexOf(first) >= 0) return "m"; try{ return kinSexOf({name:first + " X"}) === "F" ? "f" : "m"; }catch(e){ return "m"; } }
function dynNameSex(first){ if(DYN_FEM.has(first)) return "f"; try{ if(KIN_FIRST.F.indexOf(first) >= 0) return "f"; if(KIN_FIRST.M.indexOf(first) >= 0) return "m"; }catch(e){} for(const k in NAME_CULTURES) if((NAME_CULTURES[k].first || []).indexOf(first) >= 0) return "m"; return null; }
const _dynNames = {};
function dynFirstNames(region, sex){
  const k = region + sex; if(_dynNames[k]) return _dynNames[k];
