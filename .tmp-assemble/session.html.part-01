    const o = reactHolder("minority"), a = reactHolder("speaker");
    if(ct && !ct.ignored){ if(act) act.struck = true; y.approval = clamp(y.approval - 1, 0, 100); reactSay(null, "The bench has struck down the " + d.title + ", " + ct.strike + " to " + ((G.court || []).length - ct.strike) + ". It never took effect."); }
    else if(ct && ct.ignored) reactSay(null, "The bench objected to the " + d.title + " and was ignored. Nobody enforced the ruling.");
    else reactSay(null, "The " + d.title + " survives a challenge in the courts and goes into force.");
    if(o) reactSay(o, "Minority Leader " + surname(o.name) + ": the " + d.title + " " + (reactFrac(d.pos, d.title) > 0.5 ? "is a step, and we will watch how it is run." : "is the wrong answer to the right question."), false);
    return; }
  if(e.kind === "stateBill"){
