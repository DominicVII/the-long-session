    else if(act === "refuse"){ ssnDecor(e.actorId, -2); if(isYou) G.you.standing = clamp(G.you.standing - 2, 0, 100); log(nm + " refused to answer at " + body + (t ? ": " + t.slice(0, 100) : "") + ".", true); }
