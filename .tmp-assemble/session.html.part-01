  const LEX = {"n:bills:z":"bill|markup|amendment|rider|section|clause|title|subsection|appropriation|authorization|conference report|substitute|motion|calendar|docket|second reading|third reading|engrossment|enrolled copy|committee print|manager's amendment|floor schedule|rule|whip notice|cosponsor list|summary|fiscal note|score|sunset clause|preamble|schedule|reading|draft|redline|markup sheet|vote count|tally|roll call|voice vote|quorum call|recorded vote|motion to recommit|cloture petition|discharge petition|point of order|unanimous consent|time agreement|floor manager|ranking member|chairman's mark|base text|enacting clause|savings clause|severability clause|effective date|definitions section|reporting requirement|waiver|carve-out|offset|pay-for|earmark|set-aside|line item|authorizing language|report language|joint explanatory statement|holdover|placeholder","n:immigration:z":"border|visa|work permit|quota|asylum claim|green card|naturalization|citizenship oath|port of entry|crossing|caseload|backlog|detention center|processing center|sponsor family|guest worker|seasonal permit|harvest visa|dock pass|refugee ward|newcomer ward|interpreter|consulate|hearing officer|deportation order|stay of removal|amnesty|registry date|waiting line|lottery|labour shortage|chain of family|border county|checkpoint|patrol|manifest|landing card|settlement grant|language class|naturalization class|night school|resettlement office","n:foreign:z":"embassy|envoy|treaty|tariff|aid package|loan guarantee|arms sale|trade mission|consul general|realm|accord|protocol|communiqué|summit|delegation|sanction|embargo|grain shipment|naval visit|basing agreement|credit line|relief convoy|attaché|state visit|exchange rate|foreign desk|cable|démarche|frontier|neutral port|ally|rival power|mission|legation|shipping lane|customs union|aid tranche|reconstruction fund|joint commission|observer team","n:statefed:z":"governor|state house|mandate|unfunded mandate|preemption|block grant|waiver|compact|state