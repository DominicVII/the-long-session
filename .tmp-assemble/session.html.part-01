window.onumRegionOf = function(id){ try{ const p = id === "you" ? G.you : byId(id); return p ? rgnAssign(p) : null; }catch(e){ return null; } };
/* deeds: shared work, marriage, favors. kind: work | marriage | favor | feud */
window.onumRegionDeed = function(o){
