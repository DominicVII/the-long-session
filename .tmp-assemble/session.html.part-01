      SSN.fili = {id:isYou ? "you" : e.actorId, since:G.t || 0}; if(isYou){ G.you.energy = clamp(G.you.energy - 8, 0, 100); } log(nm + " has begun to filibuster" + (ssnBill() ? " " + ssnBill().title : "") + ".", true); mem(nm + " is holding the floor to stop the vote.", isYou ? -1 : 0); ssnPublish(); }
    else if(act === "walkout"){ const id = isYou ? "you" : e.actorId; if(SSN && SSN.out.indexOf(id) < 0) SSN.out.push(id);
