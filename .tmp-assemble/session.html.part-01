function cndWants(p, listenerId){
  const b = G.bill && !G.bill.done ? G.bill : null;
  try{ if(p.intent && p.intent.k && / /.test(p.intent.k)) return p.intent.k; if(p.intent && p.intent.k === "rival" && p.rival != null){ const r = byId(p.rival); if(r) return "to get the better of " + r.name; } }catch(e){}
  try{ if(p.cause && p.caseOpen) return "help with " + p.cause; }catch(e){}
  try{ const D = (G.dn && G.dn.list || []).filter(d => d.from === p.id && d.strings && d.strings !== "none").slice(-1)[0]; if(D) return D.strings; }catch(e){}
  if(b && (listenerId === "you" || listenerId == null) && p.kind === "member") return "your vote on the " + b.title;
  try{ const st = window.ONUM_SESSION; if(st && st.stage && st.stage !== "idle" && st.floorId !== p.id) return "the floor, before the clock runs out"; }catch(e){}
