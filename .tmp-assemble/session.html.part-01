  if(houseQuiet() || _buildingRoom){
    if(done){
      const prev = syncPeopleStaged._after;
      syncPeopleStaged._after = () => {
        try{ if(prev) prev(); }catch(e){}
        try{ done(); }catch(e){}
      };
    }
    /* Coalesce: one waiter only. Clear duplicates if somehow armed twice. */
    if(syncPeopleStaged._wait){
      try{ clearTimeout(syncPeopleStaged._wait); }catch(e){}
      syncPeopleStaged._wait = null;
    }
    syncPeopleStaged._wait = setTimeout(() => {
      syncPeopleStaged._wait = null;
      const after = syncPeopleStaged._after;
      syncPeopleStaged._after = null;
      try{ syncPeopleStaged(after, 0); }catch(e){ if(after) after(e); }
    }, 700);
    return;
  }
  /* Left quiet — drop any pending quiet waiter so we do not double-fire. */
  if(syncPeopleStaged._wait){
    try{ clearTimeout(syncPeopleStaged._wait); }catch(e){}
    syncPeopleStaged._wait = null;
  }
  if(_buildingRoom || syncPeopleStaged._busy){
    if(retries >= 40){
      const err = new Error("Timed out waiting to rebuild people");
      syncPeopleStaged._busy = false;
      if(window.console) console.warn("syncPeople staged wait", err);
      /* Staged failed after cap — one last full sync is allowed. */
      try{ syncPeople(); }catch(e2){}
      if(done) done(err);
      return;
    }
    nextFrameOrTimeout(() => syncPeopleStaged(done, retries + 1));
    return;
  }
  syncPeopleStaged._busy = true;
  let list, missing;
  try{
    list = peopleWanted();
    if(inHall() && list.length > (MODEST ? 10 : 14)) list = list.slice(0, MODEST ? 10 : 14);
    const keep = new Set();
    for(let i=0;i<list.length;i++) if(list[i].mesh) keep.add(list[i].mesh);
    for(let i = peopleGroup.children.length - 1; i >= 0; i--){
      const ch = peopleGroup.children[i];
      if(!keep.has(ch)){
        ch.visible = false;
        /* Persist the body. Do not dispose — remesh is the freeze. */
      }
    }
    missing = list.filter(p => {
      if(p.mesh && p.mesh.userData && p.mesh.userData.cheap){
        try{ disposePersonMesh(p.mesh); }catch(e){}
        p.mesh = null;
      }
      return !p.mesh || p.mesh.parent !== peopleGroup;
    });
