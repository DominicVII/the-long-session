  const emit = c => { buf = buf * 65536 + c; bits += W; while(bits >= 15){ bits -= 15; const v = Math.floor(buf / Math.pow(2, bits)) & 0x7fff; out.push(String.fromCharCode(v + 0x20)); buf = buf % Math.pow(2, bits); } };
  const step = left => {
    while(hi < json.length && left() > 0){ const e = Math.min(json.length, hi + 20000); for(; hi < e; hi++){ h ^= json.charCodeAt(hi); h = Math.imul(h, 16777619); } }
    while(i < str.length && left() > 0){ const e = Math.min(str.length, i + 4000);
      for(; i < e; i++){ const c = str.charAt(i), wc = w + c; if(!w){ w = c; continue; } if(dict.has(wc)){ w = wc; continue; }
        emit(w.length === 1 ? w.charCodeAt(0) : dict.get(w)); dict.set(wc, next++); if(next >= 65535){ dict = new Map(); next = 256; emit(65535); } w = c; } }
    if(hi < json.length || i < str.length) return svIdle(step, true);
    if(w) emit(w.length === 1 ? w.charCodeAt(0) : dict.get(w));
