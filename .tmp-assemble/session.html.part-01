      if(tgt && tgt !== G.you && isYou){ try{ tgt.rel.warmth = clamp(tgt.rel.warmth + 3, -100, 100); remember(tgt, "You yielded me your time on " + body + ".", 3); }catch(_){} } if(t) log(nm + " yielded the floor" + (tgt ? " to " + tgt.name : "") + ".", false); }
    else if(act === "interrupt"){ ssnDecor(e.actorId, -3); if(tgt && tgt !== G.you){ try{ ripple(tgt, isYou ? -3 : 0, isYou ? "You talked over me on " + body + "." : "", 3); }catch(_){} } if(isYou) G.you.standing = clamp(G.you.standing - 1, 0, 100); log(nm + " interrupted" + (tgt ? " " + tgt.name : "") + " on " + body + ".", false); }
    else if(act === "point_of_order"){ const D = S.decorum, culprit = SSN ? SSN.floorId : null, valid = culprit != null && culprit !== e.actorId && (D[culprit] || 0) < -2;
      if(valid){ ssnDecor(culprit, -2); if(SSN){ SSN.floorId = null; } log("The chair sustained a point of order from " + nm + ".", false); if(isYou) G.you.standing = clamp(G.you.standing + 1, 0, 100); }
      else { ssnDecor(e.actorId, -1.5); log("The chair ruled " + nm + "'s point of order out of order.", false); if(isYou) G.you.standing = clamp(G.you.standing - 0.5, 0, 100); }
