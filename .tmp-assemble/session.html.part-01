    if(!SSN && want) ssnOpen({gov:want[0], kind:want[1], room:G.room});
    else if(SSN && SSN.room && SSN.room !== G.room){ ssnClose(); return; }  /* 20261030i: leave room ends session (incl. press auto:false) */
    if(!SSN) return;
    const st = ssnStage(); if(st.id === "adjourn") return;
    if(st.timed && !SSN.fili){ SSN.remaining -= 1; if(SSN.remaining <= 0){ ssnNext(); return; } }
    if(st.speaker === "queue" || st.speaker === "round"){
      /* members rise to seek recognition */
      if(SSN.queue.length < onumLim(4,"seats") && chance(0.25)){ const cand = SSN.seats.filter(s => s.personId !== "you" && SSN.queue.indexOf(s.personId) < 0 && s.personId !== SSN.floorId && SSN.out.indexOf(s.personId) < 0);
        const c = cand[Math.floor(Math.random() * cand.length)]; if(c) SSN.queue.push(c.personId); }
      if(SSN.floorId == null) ssnRecognize();
      else { if(SSN.spk > 0){ SSN.spk -= 1; if(SSN.spk <= 0 && !(SSN.fili && SSN.fili.id === SSN.floorId)){ SSN.floorId = null; ssnPublish(); return; } }
        if(SSN.floorId !== "you" && SSN.said < 2 && chance(0.35)){ const m = byId(SSN.floorId); if(m){ SSN.said++; window.onumSessionEvent({bodyId:SSN.bodyId, kind:SSN.kind, actorId:m.id, action:"speak", text:ssnNpcLine(m)}); } }
        else if(SSN.floorId !== "you" && SSN.said >= 2 && chance(0.3)){ SSN.floorId = null; ssnPublish(); return; }
        if(SSN.fili && SSN.fili.id === "you"){ try{ G.you.energy = clamp(G.you.energy - 0.25, 0, 100); }catch(e){} if(G.you.energy <= 5){ SSN.fili = null; SSN.floorId = null; window.onumSessionEvent({bodyId:SSN.bodyId, kind:SSN.kind, actorId:"you", action:"yield", text:"You cannot stand any longer."}); } } }
    }
