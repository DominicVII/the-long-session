    chairId:o.chairId != null ? o.chairId : ssnChair(kind, ps), floorId:null, spk:0, seats:ps.map((p, i) => ({seatId:kind.slice(0, 2) + (i + 1), personId:p.id})).concat(G.you ? [{seatId:"you", personId:"you"}] : []),
