function ofhHowLeft(old, nu){
  if(nu && nu.personId === "you") return old && old.personId == null ? "lost the office to you" : "lost the seat to you";
  if(old.personId === "you"){ const k = ofhYouKey(); return k ? "left for the office of " + officeTitle() : "left office"; }
