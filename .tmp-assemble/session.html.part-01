    const src = engHash.toString() + "\n" + engPack.toString() + "\n" + engUnpack.toString() +
      "\nonmessage = e => { const {id, json} = e.data; let raw = json; try{ const z = engPack(json); if(engUnpack(z) === json) raw = 'ONZ1|' + engHash(json) + '|' + z; }catch(x){} postMessage({id, raw}); };";
