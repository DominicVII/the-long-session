function wrapPi(a){
  /* Modulo, not a decrement loop: a loop that subtracts 2*PI until the
     value fits never returns if `a` is ever Infinity (any upstream NaN
     from a divide-by-zero or a bad vector normalize can surface as
     Infinity here) or just very large after a long session of turning.
     That is a true hang — it never throws, so the per-frame try/catch
     in frame() cannot recover it. A single modulo is O(1) regardless
     of how big or broken the input is, and safely yields NaN (not a
     hang) for genuinely non-finite input. */
  if(!isFinite(a)) return 0;
  a = ((a + Math.PI) % (Math.PI*2) + Math.PI*2) % (Math.PI*2) - Math.PI;
  return a;
}
function animatePerson(p, dt){
