  { const _am = appendMsg; appendMsg = function(kind, text, who){ const r = _am.apply(this, arguments); try{ if(kind === "them" && TALK.open && TALK.m && who && who === surname(TALK.m.name) && text && !/^You step into/.test(text)) renderMean(TALK.m, text); }catch(e){} return r; }; }
