  card.querySelectorAll("[data-ph]").forEach(b => b.addEventListener("click", () => { const k = b.getAttribute("data-ph"), H2 = PURSE_HOMES[k]; if(P.cash < H2.move) return; P.cash -= H2.move; P.home = k; purseLog(y, "Moved to " + H2.t, -H2.move); if(k === "house") try{ purseWitness(y, {key:"house", t:"a townhouse", price:H2.move, show:3}, "plain"); }catch(e){} purseChip(); purseCard(); }));
