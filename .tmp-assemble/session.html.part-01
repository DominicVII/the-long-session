}
function dynFeud(ha, hb, why){ const D = dynEnsure(), A = D.houses[ha], B = D.houses[hb]; if(!A || !B || ha === hb) return;
  if(A.feuds.indexOf(hb) < 0){ A.feuds.push(hb); B.feuds.push(ha); A.allies = A.allies.filter(x => x !== hb); B.allies = B.allies.filter(x => x !== ha); if(why) dynNote(why); } }
function dynAlly(ha, hb, why){ const D = dynEnsure(), A = D.houses[ha], B = D.houses[hb]; if(!A || !B || ha === hb) return;
  A.feuds = A.feuds.filter(x => x !== hb); B.feuds = B.feuds.filter(x => x !== ha);
  if(A.allies.indexOf(hb) < 0){ A.allies.push(hb); B.allies.push(ha); if(why) dynNote(why); } }
function dynNote(t, press){ const D = dynEnsure(); D.log.push({d:G.day, t}); if(D.log.length > onumLim(120,"hist")) D.log.shift(); try{ lLog(t, "family"); }catch(e){} if(press){ try{ feed(t); }catch(e){} } }
function dynSingle(r){ return r.alive && !r.spouseId && !r.offSpouse && dynAge(r) >= 18; }
function dynStanding(r){ const p = dynPerson(r.id); let s = 0; if(p){ s += (p.influence || 0); if(p.kind === "member") s += 20; try{ s += Math.min(40, purseOf(p).cash / 300); }catch(e){} } return s; }
/* who suits whom: attraction, standing, region trust, politics. Never looks. */
function dynMatch(a, b){
  if(!a || !b || a.sex === b.sex || !dynSingle(a) || !dynSingle(b) || a.houseId === b.houseId) return -99;
  if(Math.abs(dynAge(a) - dynAge(b)) > 14) return -99;
  const pa = dynPerson(a.id), pb = dynPerson(b.id);
  let s = (Math.abs(seedOf("att" + Math.min(a.id, b.id) + ":" + Math.max(a.id, b.id))) % 100) / 2;
  s -= Math.abs(dynStanding(a) - dynStanding(b)) / 3;
  try{ s += (rgnTrust(a.birthRegion, b.birthRegion) - 45) / 2; }catch(e){}
  if(pa && pb && pa.party && pa.party === pb.party) s += 8; else if(pa && pb && pa.party && pb.party && pa.party !== "IND" && pb.party !== "IND") s -= 6;
