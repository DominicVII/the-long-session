}
{ const st = document.createElement("style"); st.textContent = ".tkm{margin:6px 0 10px;border-left:3px solid #6b9a7a;padding:4px 10px;font-size:13px;line-height:1.4;background:rgba(107,154,122,.08);max-width:72ch}.tkm summary{cursor:pointer;font:600 10px Archivo,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3,#888)}.tkm p{margin:4px 0}" +
  "#tkBrief{margin:0 0 8px;max-width:72ch}.tkb__h{font:600 9px Archivo,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3,#888);margin-bottom:2px}.tkb{display:grid;grid-template-columns:max-content 1fr;gap:2px 10px;margin:0;font-size:12.5px;line-height:1.35}.tkb dt{color:var(--ink-3,#888);font-weight:600}.tkb dd{margin:0}" +
  ".tkgroups{display:block !important}.tkg{margin:6px 0}.tkg__h{font:700 10px Archivo,sans-serif;letter-spacing:.14em;text-transform:uppercase;margin-bottom:3px}.tkg__h span{font-weight:400;letter-spacing:0;text-transform:none;color:var(--ink-3,#888);font-size:11px}.tkg__row{display:flex;flex-wrap:wrap;gap:6px}" +
  ".talk__btn{flex-wrap:wrap}.talk__btn .tkd{flex:1 1 100%;font:400 11px/1.3 Archivo,system-ui,sans-serif;color:var(--ink-3,#888);margin-top:1px}.talk__btn .tkr{font:700 8.5px Archivo,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--bad,#b33);border:1px solid currentColor;padding:0 4px;border-radius:2px}";
  document.head.appendChild(st); }
/* ── your own office in the Cannon Building (the one off the Statuary Corridor): a Senator, a Justice, a leader or a chair works here and goes out to the chamber. Only the President and a Governor work in a wing of their own. ── */
function officeRoleKind(){ let k = null; try{ k = roleKey(); }catch(e){} return k === "senate" ? "senate" : k === "bench" ? "bench" : (k === "leader" || k === "chair") ? "lead" : k === "house" ? "house" : null; }
const OFFICE_ROLE_T = {
  senate:{plate:"SENATOR", table:"Your staff table", tsub:"Chief of staff, legislative director, state director", mail:"The constituents' mail", msub:"Bags from home, and a wall of state maps"},
  bench:{plate:"JUSTICE", table:"Your clerks' table", tsub:"Three clerks, a pile of briefs, and a kettle", mail:"The briefs and the petitions", msub:"Everything the Court has been asked to hear"},
  lead:{plate:"LEADERSHIP", table:"The whip table", tsub:"Lists, a count in pencil, and a telephone that never stops", mail:"The leadership mail", msub:"Requests, threats and thank-yous"},
  house:{plate:"REPRESENTATIVE", table:"Your staffers' table", tsub:"An intern, a scheduler and last week's coffee", mail:"The district mail", msub:"Letters from home"}
};
/* 20261104bf NEPTUNE look: each chair gets its own floor plan (positions only; JUPITER owns what the props do) */
function officeRoleSpots(){ let rk = null; try{ rk = officeRoleKind(); }catch(e){}
  if(rk === "senate") return {table:{x:-2.4, z:5.2}, mail:{x:3.6, z:8.4}};
  if(rk === "bench") return {table:{x:2.6, z:4.6}, mail:{x:-3.3, z:6.6}};
  return {table:{x:2.9, z:5.0}, mail:{x:3.7, z:8.2}}; }
function kOfficeRole(id, w, d, h, hw){
  if(id !== "office") return; const rk = officeRoleKind(); if(!rk) return; const T = OFFICE_ROLE_T[rk], S = officeRoleSpots();
  const wood = matCol(rk === "bench" ? 0x2e1d12 : 0x5a3b24, .7), cloth = matCol(rk === "bench" ? 0x3a1418 : rk === "senate" ? 0x1f3550 : 0x2f4a66, .9), paper = matCol(0xe9e4d8, .95), brass = matCol(0xb08a2e, .4, .8);
  try{ nepOfficeRoleLook(rk, w, d, h, hw, S); }catch(e){ if(window.console) console.warn("bf role look", e); }
  addBox(wood, S.table.x, 0.38, S.table.z, 1.5, 0.76, 0.8, 0, true); addBox(paper, S.table.x - 0.3, 0.8, S.table.z, 0.35, 0.03, 0.28, 0.2, true); addBox(paper, S.table.x + 0.3, 0.8, S.table.z + 0.1, 0.3, 0.03, 0.25, -0.1, true);
  addBox(cloth, S.table.x - 0.45, 0.28, S.table.z + 0.75, 0.42, 0.56, 0.42, 0, true); addBox(cloth, S.table.x + 0.45, 0.28, S.table.z + 0.75, 0.42, 0.56, 0.42, 0, true);
  addBox(wood, S.mail.x, 0.5, S.mail.z, 0.7, 1.0, 0.5, 0, true); addBox(paper, S.mail.x, 1.04, S.mail.z, 0.5, 0.08, 0.34, 0, true);
  try{ propPlaque(S.table.x, 1.5, S.table.z - 0.45, 0, T.table.toUpperCase().slice(0, 22), "Press E", 0.9, 0.14); }catch(e){}
  try{ propPlaque(S.mail.x, 1.45, S.mail.z - 0.3, 0, T.mail.toUpperCase().slice(0, 22), "Press E", 0.9, 0.14); }catch(e){}
  try{ propPlaque(hw - 0.06, 2.0, 3.0, -Math.PI / 2, T.plate, officeSeat ? officeSeat() : "", 0.9, 0.18); }catch(e){}
}
function officeRoleProps(){
  const rk = officeRoleKind(); if(!rk) return []; const T = OFFICE_ROLE_T[rk], S = officeRoleSpots(), P = [];
  const toChamber = {senate:["senate", "Walk to the Senate chamber"], bench:["court", "Walk to the Court"], lead:["floor", "Walk to the House floor"], house:["floor", "Walk to the House floor"]}[rk];
  const walk = {t:toChamber[1], c:"walk", run(){ try{ closeTalk(); }catch(e){} G.you.sitting = false; goTo(toChamber[0]); }};
  const tacts = [];
  if(rk === "senate"){ tacts.push({t:"Hold the staff meeting", c:"30m", off:kOnceToday("sbrief"), run(){ closeTalk(); senBrief(); }}); tacts.push({t:"Go through the docket with your staff", c:"15m", run(){ closeTalk(); dkCard(0); }}); }
  if(rk === "bench"){ tacts.push({t:"Go over the case with your clerks", c:"40m", off:kOnceToday("bconf"), run(){ closeTalk(); benchConf2(); }}); tacts.push({t:"Read the petitions for review", c:"15m", off:kOnceToday("bcert"), run(){ closeTalk(); benchCert(); }}); }
  if(rk === "lead" || rk === "house"){ tacts.push({t:"Count the votes", c:"15m", off:!(G.bill && !G.bill.done), run(){ closeTalk(); whipCard(); }}); tacts.push({t:"Check on your rivals", c:"10m", run(){ closeTalk(); rivalCard(); }}); tacts.push({t:"Look at the families", c:"10m", run(){ closeTalk(); kinBrowse(); }}); }
  tacts.push(walk);
  P.push({id:"roleTable", label:T.table, sub:T.tsub, x:S.table.x, z:S.table.z, r:2.0, acts:() => tacts});
  const macts = [];
  if(rk === "senate") macts.push({t:"Take the calls from home", c:"40m", off:kOnceToday("scalls"), run(){ closeTalk(); senCalls(); }});
  if(rk === "bench") macts.push({t:"Draft the opinion", c:"60m", off:kOnceToday("bopin"), run(){ closeTalk(); benchOpinion(); }});
  if(rk === "lead" || rk === "house") macts.push({t:"Read the mail", c:"20m", run(){ closeTalk(); try{ pcOpen(); }catch(e){ note("Sit at your desk and wake the computer."); } }});
  macts.push({t:"Read this morning's Ledger", c:"10m", run(){ closeTalk(); paperCard(); }});
  P.push({id:"roleMail", label:T.mail, sub:T.msub, x:S.mail.x, z:S.mail.z, r:1.8, acts:() => macts});
  return P;
}
setTimeout(() => { try{ const base = PROPS.office; if(base && !base._role){ base._role = true; const arr = base.slice(); Object.defineProperty(PROPS, "office", {configurable:true, enumerable:true, get(){ return arr.concat(officeRoleProps()); }, set(v){ arr.length = 0; (v || []).forEach(x => arr.push(x)); }}); } }catch(e){ console.warn("office role props", e); } }, 0);
/* ── the first morning in a new chair: where you work, who works for you, what the day is made of, and what changed from the House ── */
const FIRST_DAY = {
  senate:{h:"Your first morning as a Senator", where:"Your office is in the Cannon Building, off the Statuary Corridor: the same room you worked in before, now with a staff table and the constituents' mail. The Senate chamber is down the corridor; walk there when it sits.", day:["8:00 staff meeting at your table","9:00 a confirmation hearing in committee","11:00 the Senate sits (you are one of two for your state)","2:00 treaties and foreign business","4:00 calls from home"], changed:"There is no whip count to work: you are one of a hundred, you vote on confirmations and treaties as well as bills, and you can hold the floor. Your state answers to you directly, and so does its Governor.", lean:"Your staff speak for themselves; the Senate's rules are different and slower; and your aide at every meeting is the highest-ranking member of your party."},
  bench:{h:"Your first morning as a Justice", where:"Your chambers are your office in the Cannon Building, with a clerks' table and the briefs. The Court sits down the corridor, and you will go there for oral argument.", day:["9:00 conference with the other justices","10:00 oral argument","1:00 petitions for review: what the Court will hear","2:00 write the opinion"], changed:"You no longer campaign or whip. Three votes make an opinion the Court's; a dissent is still printed. Everyone else answers what you rule the next morning.", lean:"Your clerks read the case before you do; the other justices argue it in their own words, and you may press them."},
  gov:{h:"Your first morning as Governor", where:"You work in the State House, not the Capitol. The House on the Hill is a different building with a different set of rules, and its members no longer take your orders (or your votes).", day:["8:00 morning briefing from your advisors","10:00 open hours: citizens, mayors and county clerks","12:00 the situation: what the state may do about its neighbours","1:00 the statehouse desk","3:00 agencies and the budget","5:00 press availability"], changed:"You sign and veto, appoint, budget and pardon. Your state is your whole constituency, and you answer to it. There are no roll calls for you; there is a legislature that sends you what it has passed.", lean:"Your advisors, agency heads and appointees are people with views of their own; and when a neighbour holds your bread, you act within what the state may do and ask the Union for the rest."},
  pres:{h:"Your first morning as the executive", where:"You work in the Executive wing. Congress sends you acts; the courts rule on what you do; and every state, every neighbour and every cabinet member has a view.", day:["8:00 the cabinet briefing","9:00 the situation room","11:00 acts awaiting signature","2:00 cabinet and appointments","4:00 calls with foreign capitals","5:00 the press room"], changed:"You are the one people look to. Everything you sign, veto, say or order is answered the next morning by the other branches, the states and the neighbours; the law decides how far you may go alone.", lean:"Your cabinet secretaries speak in their own words; and the form of the state and the precedents you set decide what you may do without asking."}
};
function firstDayCard(k, go){
  const F = FIRST_DAY[k]; if(!F){ go(); return; }
  const body = '<p>' + pcEsc(F.where) + '</p><div class="eyebrow">What the day is made of</div><ul style="margin:4px 0 0 18px">' + F.day.map(x => '<li>' + pcEsc(x) + '</li>').join("") + '</ul>' +
    '<div class="eyebrow" style="margin-top:10px">What is different from the House</div><p>' + pcEsc(F.changed) + '</p><p class="muted" style="font-size:13px">' + pcEsc(F.lean) + '</p>' +
    '<p class="muted" style="font-size:12px">Find things in the Apps tab on your phone (purse, families, situation room, gallery), the Ledger button, and M for the map. Everyone, including you, has a purse, a family and their own time.</p>' +
    '<div class="card__actions"><button type="button" class="btn" id="fdGo">Begin</button></div>';
  govCardOpen("A new chair", F.h, "", body, null);
  el("fdGo").addEventListener("click", () => { walkNow(); setTimeout(go, 40); });
}
{ const _dp = dayPlanCard;
  dayPlanCard = function(){
    try{ const k = heldOffice(), y = G.you; y.firstDay = y.firstDay || {}; if(k && k !== "house" && FIRST_DAY[k] && !y.firstDay[k]){ y.firstDay[k] = G.day; const a = arguments, self = this; firstDayCard(k, () => _dp.apply(self, a)); return; } }catch(e){ console.warn("first day", e); }
    return _dp.apply(this, arguments);
  };
}
/* ── room by room, schedule by schedule: each item of a working day has a place to be done, with furniture to find it by ── */
/* ── richer rooms: the Senate with its gallery and drapes, the Court with its jury box and justice, the Executive's wing with maps, busts and brass, the State House with its clock, curtains and county map ── */
function kRich(id, wood, leather, brass){
  const R = ROOMS[id], d = R.d, hw = R.w / 2, h = R.h;
  const marble = matCol(0xe6dfcf, .5, .1), velvet = matCol(0x6b1d1d, .9), gilt = matCol(0xb08b45, .35, .8), dark = matCol(0x1d1f26, .6), green = matCol(0x2f5a3a, .85), cream = matCol(0xf3ecd9, .7), blue = matCol(0x3b6d8c, .55), tan = matCol(0xc9b27c, .85);
  const bust = (x, z) => { addCyl(marble, x, 0.5, z, 0.22, 1.0); addBox(marble, x, 1.02, z, 0.5, 0.06, 0.5, 0, true); addBox(marble, x, 1.14, z, 0.26, 0.2, 0.18, 0, true); addSphere(marble, x, 1.4, z, 0.14, 0.17, 0.14); };
  const globe = (x, z) => { addCyl(wood, x, 0.45, z, 0.05, 0.9); addBox(wood, x, 0.9, z, 0.5, 0.04, 0.5, 0, true); addSphere(blue, x, 1.2, z, 0.28, 0.28, 0.28); addCyl(gilt, x, 1.2, z, 0.02, 0.72); addBox(gilt, x, 1.22, z, 0.62, 0.02, 0.02, 0.4, true); };
  const drape = (x, z, w, hh, ry) => { addBox(velvet, x, hh / 2 + 0.2, z, w, hh, 0.14, ry || 0, true); for(let i = -1; i <= 1; i++) addBox(matCol(0x561616, .9), x + i * w * 0.3 * Math.cos(ry || 0), hh / 2 + 0.2, z - i * w * 0.3 * Math.sin(ry || 0), 0.05, hh, 0.17, ry || 0, true); addBox(gilt, x, hh + 0.3, z, w + 0.1, 0.07, 0.2, ry || 0, true); };
  const books = (x, y, z, n, ry) => { const cs = [0x5a2a22, 0x2f4a66, 0x2f5a3a, 0x7a6a3a, 0x3a2f26]; for(let i = 0; i < n; i++) addBox(matCol(cs[i % cs.length], .8), x + i * 0.065, y + 0.11 + (i % 3) * 0.02, z, 0.055, 0.22 + (i % 3) * 0.03, 0.17, ry || 0, true); };
  const phone = (x, y, z) => { addBox(dark, x, y + 0.04, z, 0.2, 0.08, 0.16, 0, true); addCyl(dark, x, y + 0.14, z, 0.012, 0.14); addBox(dark, x, y + 0.22, z, 0.14, 0.03, 0.045, 0, true); };
  const clockG = (x, z, ry) => { addBox(wood, x, 1.05, z, 0.5, 2.1, 0.3, ry || 0, true); addBox(cream, x, 1.6, z + 0.16, 0.32, 0.32, 0.01, ry || 0, true); addCyl(gilt, x, 0.85, z + 0.16, 0.06, 0.02); addBox(dark, x, 2.2, z, 0.56, 0.14, 0.34, ry || 0, true); };
  const lampFloor = (x, z) => { addCyl(dark, x, 0.8, z, 0.025, 1.6); addCyl(gilt, x, 0.03, z, 0.14, 0.06); try{ propLamp(x, 1.75, z, 0xffd9a0, 0.5); }catch(e){} };
  const mapWall = (x, y, z, ry, w, hh, col, pins) => { addBox(wood, x, y, z, 0.07, hh + 0.1, w + 0.1, 0, true); addBox(col, x - Math.sign(x) * 0.04, y, z, 0.03, hh, w, 0, true); for(let i = 0; i < pins; i++){ const a = (i * 2.399) % 1, b2 = (i * 0.618) % 1; addSphere(matCol(i % 3 ? 0x9a1b1b : 0xe0b33a, .5), x - Math.sign(x) * 0.07, y - hh / 2 + 0.2 + a * (hh - 0.4), z - w / 2 + 0.2 + b2 * (w - 0.4), 0.035, 0.035, 0.035); } };
  if(id === "senate"){
    [4.8, 9.2].forEach(z => { try{ propChandelier(0, h - 0.8, z, 6, 0.9); }catch(e){} });
    bust(-3.6, 9.4); bust(3.6, 9.4); drape(-4.6, d - 0.14, 2.2, 3.2); drape(4.6, d - 0.14, 2.2, 3.2);
    [-1, 1].forEach(sd => { addBox(wood, sd * (hw - 0.4), 2.55, 7.4, 0.8, 0.14, 9.2, 0, true); addBox(brass, sd * (hw - 0.82), 3.05, 7.4, 0.05, 0.06, 9.2, 0, true); for(let i = 0; i < 9; i++) addCyl(brass, sd * (hw - 0.82), 2.8, 3.1 + i * 1.05, 0.015, 0.5); addBox(matCol(0x3e3428, .85), sd * (hw - 0.3), 2.85, 7.4, 0.4, 0.4, 8.6, 0, true); });
    kFlag(-4.8, d - 0.6, 2.7); kFlag(4.4, d - 0.6, 2.7);
    propRug(0, 6.4, 1.5, 6.0);
  } else if(id === "court"){
    [[-2.2, 6.0], [2.2, 6.0]].forEach(p => { try{ propChandelier(p[0], h - 0.7, p[1], 6, 0.85); }catch(e){} });
    drape(-3.6, d - 0.14, 2.6, 3.4); drape(3.6, d - 0.14, 2.6, 3.4);
    [-1, 1].forEach(sd => { const x = sd * (hw - 0.9), z = d - 1.0; addCyl(marble, x, 0.6, z, 0.26, 1.2); addBox(marble, x, 1.5, z, 0.42, 0.62, 0.26, 0, true); addSphere(marble, x, 1.95, z, 0.13, 0.15, 0.13); addCyl(gilt, x + sd * 0.3, 2.0, z, 0.012, 0.8); addBox(gilt, x + sd * 0.3, 2.4, z, 0.6, 0.02, 0.02, 0, true); addCyl(gilt, x + sd * 0.3 - 0.28, 2.25, z, 0.1, 0.01); addCyl(gilt, x + sd * 0.3 + 0.28, 2.25, z, 0.1, 0.01); });
    addBox(wood, -hw + 1.0, 0.4, 3.0, 0.1, 0.8, 2.6, 0, true); addBox(wood, -hw + 0.55, 0.4, 3.0, 0.1, 0.8, 2.6, 0, true); [2.2, 3.0, 3.8].forEach(z => { propChair(wood, leather, -hw + 0.8, z, Math.PI / 2); });    /* the jury box */
    addBox(wood, 4.6, 0.45, 6.8, 1.1, 0.9, 1.0, 0, true); addBox(brass, 4.6, 0.95, 6.35, 1.1, 0.05, 0.05, 0, true); propChair(wood, leather, 4.6, 6.9, Math.PI);     /* the witness stand */
    books(-2.9, 0.78, 5.5, 6); books(2.0, 0.78, 5.6, 5); books(-2.2, 0.78, 5.9, 4);
    propRug(0, 7.8, 2.0, 3.0);
  } else if(id === "exec"){
    try{ propChandelier(0, h - 0.5, 6.4, 6, 0.6); }catch(e){}
    globe(-4.2, 6.1); bust(-2.4, d - 1.3); bust(2.4, d - 1.3); lampFloor(-hw + 0.8, 10.6); lampFloor(hw - 0.8, 10.6);
    mapWall(hw - 0.06, 1.9, 9.4, 0, 2.2, 1.5, green, 14);
    phone(0.9, 0.78, 9.0); phone(1.2, 0.78, 9.2); books(-1.2, 0.8, 9.2, 5);
    propRug(0, 4.4, 4.4, 2.4); drape(-hw + 0.1, 2.6, 0.12, 2.4, Math.PI / 2);
  } else if(id === "govoffice"){
    try{ propChandelier(0, h - 0.5, 5.6, 5, 0.55); }catch(e){}
    clockG(-hw + 0.6, 9.8, 0); globe(-3.6, 9.0); bust(3.7, 9.6);
    mapWall(-hw + 0.06, 1.8, 8.6, 0, 1.8, 1.4, tan, 12);
    drape(hw - 0.12, 3.0, 0.9, 2.5, Math.PI / 2); drape(hw - 0.12, 6.4, 0.9, 2.5, Math.PI / 2);
    addBox(wood, -3.5, 0.3, 3.4, 0.7, 0.6, 0.7, 0, true); books(-3.7, 0.6, 3.4, 4); kFlag(-3.0, d - 0.55, 2.3);
    propRug(0, 6.0, 5.2, 4.2);
  }
}
/* ── your own office, dressed for the chair you hold: a floor lamp, filing cabinets, a bar cart, a chandelier-lite, a map of home with pins, the flag, and whatever your trade piles up ── */
function kOfficeRich(id, w, d, h, hw){
  if(id === "corridor"){ corridorStatues(d, hw); corridorRich(w, d, h, hw); }
  if(id === "press") pressRich(w, d, h, hw);
  if(id === "caucus") caucusRich(w, d, h, hw);
  if(id === "committee") committeeRich(w, d, h, hw);
  if(id === "cloak") cloakRich(w, d, h, hw);
  if(id === "floor") floorRich(w, d, h, hw);
  if(id === "engine") engRoomRich(w, d, h, hw);
  if(id === "senate") senateRich(w, d, h, hw);
  if(id === "court") courtRich(w, d, h, hw);
  if(id === "exec") execRich(w, d, h, hw);
  if(id === "govoffice") govRich(w, d, h, hw);
  if(id === "senate" || id === "court") nepChamberLook(id, w, d, h, hw);
  if(id === "steps") stepsRich(w, d, h, hw);
  if(id !== "office") return; const rk = officeRoleKind(); if(!rk) return;
  const wood = matCol(0x5a3b24, .7), dark = matCol(0x1d1f26, .6), gilt = matCol(0xb08b45, .35, .8), green = matCol(0x2f5a3a, .85), tan = matCol(0xc9b27c, .85), cream = matCol(0xf3ecd9, .7), steel = matCol(0x3a4048, .6), velvet = matCol(0x6b1d1d, .9);
  const lampFloor = (x, z) => { addCyl(dark, x, 0.8, z, 0.025, 1.6); addCyl(gilt, x, 0.03, z, 0.14, 0.06); try{ propLamp(x, 1.75, z, 0xffd9a0, 0.45); }catch(e){} };
  const books = (x, y, z, n) => { const cs = [0x5a2a22, 0x2f4a66, 0x2f5a3a, 0x7a6a3a, 0x3a2f26]; for(let i = 0; i < n; i++) addBox(matCol(cs[i % cs.length], .8), x + i * 0.065, y + 0.11 + (i % 3) * 0.02, z, 0.055, 0.22 + (i % 3) * 0.03, 0.17, 0, true); };
  const mapWall = (x, y, z, ww, hh, col, pins) => { addBox(wood, x, y, z, 0.07, hh + 0.1, ww + 0.1, 0, true); addBox(col, x - Math.sign(x) * 0.04, y, z, 0.03, hh, ww, 0, true); for(let i = 0; i < pins; i++){ const a = (i * 2.399) % 1, b2 = (i * 0.618) % 1; addSphere(matCol(i % 3 ? 0x9a1b1b : 0xe0b33a, .5), x - Math.sign(x) * 0.07, y - hh / 2 + 0.2 + a * (hh - 0.4), z - ww / 2 + 0.2 + b2 * (ww - 0.4), 0.035, 0.035, 0.035); } };
  try{ propChandelier(0, h - 0.45, 5.4, 5, 0.5); }catch(e){}
  lampFloor(-hw + 0.7, 8.8); lampFloor(hw - 0.6, 10.2);
  try{ propCabinet(steel, matCol(0x2a2f36, .6), -hw + 0.5, 9.9, 0.5, 1.3, 0.7, Math.PI / 2); propCabinet(steel, matCol(0x2a2f36, .6), -hw + 0.5, 10.6, 0.5, 1.3, 0.7, Math.PI / 2); }catch(e){}
  addBox(wood, hw - 0.6, 0.45, 2.4, 0.5, 0.9, 1.2, 0, true); addCyl(matCol(0x9fb9c9, .3), hw - 0.6, 1.02, 2.2, 0.06, 0.25); addCyl(matCol(0xc9a46a, .3), hw - 0.6, 1.0, 2.6, 0.05, 0.2);    /* the bar cart: a decanter and a bottle */
  kFlag(-1.6, d - 0.55, 2.3); kFlag(1.6, d - 0.55, 2.3);
  propRug(0, 6.6, 4.4, 3.6);
  if(rk === "senate"){ mapWall(hw - 0.06, 1.9, 7.2, 2.0, 1.5, green, 16); try{ propPlaque(hw - 0.1, 2.9, 7.2, -Math.PI / 2, "STATE OF", (G.you && G.you.state) || "", 1.1, 0.14); }catch(e){} books(0.55, DIM.desk - 0.11, Math.min(8.55, d - 1.2), 6); }
  else if(rk === "bench"){ try{ propShelf(hw - 0.35, 7.4, -Math.PI / 2, 2.0, 2.1); propShelf(hw - 0.35, 9.4, -Math.PI / 2, 2.0, 2.1); }catch(e){} addBox(matCol(0x14161a, .8), -hw + 0.5, 1.0, 3.4, 0.4, 1.7, 0.6, 0, true); addSphere(dark, -hw + 0.5, 1.95, 3.4, 0.18, 0.12, 0.18); try{ propPlaque(-hw + 0.6, 2.3, 3.4, Math.PI / 2, "THE ROBE", "", 0.7, 0.12); }catch(e){} books(0.3, 0.8, 7.0, 8); books(-0.6, 0.8, 7.4, 5); }
  else if(rk === "lead"){ addBox(wood, hw - 0.06, 1.8, 7.4, 0.08, 1.4, 2.2, 0, true); addBox(cream, hw - 0.1, 1.8, 7.4, 0.03, 1.3, 2.1, 0, true); for(let i = 0; i < 30; i++){ const c = (i % 3 === 0) ? 0x9a1b1b : (i % 3 === 1) ? 0x2f5a3a : 0xe0b33a; addSphere(matCol(c, .6), hw - 0.13, 1.25 + (i % 6) * 0.2, 6.5 + Math.floor(i / 6) * 0.4, 0.04, 0.04, 0.04); } try{ propPlaque(hw - 0.15, 2.65, 7.4, -Math.PI / 2, "THE COUNT", "", 0.8, 0.12); }catch(e){} }
  else { mapWall(hw - 0.06, 1.9, 7.2, 2.0, 1.5, tan, 12); try{ propPlaque(hw - 0.1, 2.9, 7.2, -Math.PI / 2, "THE DISTRICT", (G.you && G.you.state) || "", 1.1, 0.14); }catch(e){} }
}
/* ═════════════════════════════════════════════════════════
   THE ORGANISM · towns, states, the nation, each doing its own job, all day, without you
   A town has a mayor, a treasury and needs that grow. The mayor does their own job: fixes what
   they can afford, levies, or petitions the state. A state has a treasury and a governor, who
   funds what they can and sends the rest up to Congress, which passes relief when enough
   towns in enough states ask. The courts rule on what is before them. The executive signs
   what arrives. None of it waits for you; when you hold one of these chairs, what lands on
   your desk is what has actually come up from below, and what you decide goes back down.
   ═════════════════════════════════════════════════════════ */
const ORG_NEEDS = {
  bread:{t:"bread", want:"bread and grain price", cost:[6, 14], act:"Bread Price Relief Act", pos:{wel:30, econ:-12, def:0, lib:0}},
  roads:{t:"roads", want:"the co-op road washed out in spring and is still out", cost:[14, 40], act:"Rural Road and Culvert Act", pos:{wel:14, econ:-18, def:0, lib:0}},
  school:{t:"schools", want:"three teachers short and the state cheque is late", cost:[12, 30], act:"Schoolhouse and Teachers Act", pos:{wel:26, econ:-8, def:0, lib:6}},
  water:{t:"water", want:"the water main the state required, which the town cannot pay for", cost:[25, 60], act:"Municipal Water Compliance Act", pos:{wel:18, econ:-16, def:0, lib:0}},
  order:{t:"order", want:"a constable after the break-ins", cost:[5, 12], act:"Local Constabulary Aid Act", pos:{wel:4, econ:0, def:6, lib:-20}}
};
function orgNeedLabel(k){ return (ORG_NEEDS[k] || {t:k}).t; }
function orgEnsure(){
  if(G.org && G.org.v === 1) return G.org;
  const O = G.org = {v:1, towns:{}, up:{}, fed:[], hist:[], treas:{}, today:null, pid:1, acts:[]};
  (G.states || []).forEach(S => {
    const ts = townsOf(S.n); O.up[S.n] = []; O.treas[S.n] = Math.round(20000 + (S.ind || 50) * 600);
    O.towns[S.n] = ts.map(t => { const r = rng(seedOf("ot:" + S.n + ":" + t.name)); let mn = ""; try{ mn = wallSafeMint(() => newName(S.n)); }catch(e){} return {id:S.n + "/" + t.name, name:t.name, state:S.n, pop:Math.max(1500, Math.round(t.pop * 1000) || 4000), needs:{bread:8 + r() * 30, roads:10 + r() * 40, school:10 + r() * 40, water:10 + r() * 40, order:6 + r() * 30}, treasury:Math.round((6 + r() * 20) * 1000), mayor:{name:mn || "A. Mayor", trait:["dutiful", "bold", "cautious", "corrupt", "dutiful", "cautious"][Math.floor(r() * 6)]}, log:[], mood:60}; });
  });
  return O;
}
function orgTownMood(T){ const v = T.needs; return Math.round(100 - (v.bread * 1.4 + v.roads * 0.8 + v.school * 1.0 + v.water * 1.0 + v.order * 1.0) / 5.2); }
function orgNews(text, note){ const O = orgEnsure(); const h = Math.floor((G.minute || 0) / 60); O.hist.push({d:G.day, h, t:text}); if(O.hist.length > onumLim(60,"hist")) O.hist.shift(); if(note){ try{ caNews(text); }catch(e){ try{ feed(text); }catch(e2){} } } }
function orgIsMyState(n){ return !!(G.you && G.you.state === n); }
function orgPlayerGov(n){ try{ return heldOffice() === "gov" && orgIsMyState(n); }catch(e){ return false; } }
function orgDay(){
  const O = orgEnsure(), w = worldEnsure(), breadP = (w.bread || 1) - 1, heat = w.heat || 0;
  O.today = {d:G.day, ev:[]};
  (G.states || []).forEach(S => {
    const T = O.towns[S.n] || []; O.treas[S.n] = (O.treas[S.n] || 0) + Math.round((S.ind || 50) * 180);
    T.forEach((t, i) => { const v = t.needs; v.bread = clamp(v.bread + 0.6 + breadP * 7 - (t.treasury > 20000 ? 0.3 : 0), 0, 100); v.roads = clamp(v.roads + 0.45, 0, 100); v.school = clamp(v.school + 0.4, 0, 100); v.water = clamp(v.water + 0.35, 0, 100); v.order = clamp(v.order + 0.3 + ((S.unrest || 30) - 30) / 70 + (heat > 60 ? 0.3 : 0), 0, 100);
      t.treasury += Math.round(t.pop * 0.03); t.mood = orgTownMood(t); O.today.ev.push({h:8 + (i + seedOf(t.id)) % 3, t:"town", s:S.n, i}); });
    O.today.ev.push({h:10 + seedOf(S.n) % 4, t:"state", s:S.n});
    const avg = T.length ? T.reduce((a, t) => a + t.mood, 0) / T.length : 60; S.unrest = clamp((S.unrest || 30) + (50 - avg) / 220, 0, 100);
  });
  if(G.day % 3 === 0) O.today.ev.push({h:11, t:"fed"}); if(G.day % 3 === 1) O.today.ev.push({h:15, t:"fed"});
  O.today.ev.push({h:10, t:"court"}, {h:14, t:"court"}, {h:9, t:"exec"}, {h:16, t:"exec"});
  O.fed = O.fed.filter(p => G.day - p.day < 20);
  Object.keys(O.up).forEach(n => { O.up[n] = O.up[n].filter(p => p.status === "open" || G.day - (p.closed || p.day) < 8); });
}
function orgTownAct(S, i){
  const O = orgEnsure(), T = (O.towns[S] || [])[i]; if(!T) return; const m = T.mayor, my = orgIsMyState(S);
  const need = Object.keys(T.needs).sort((a, b) => T.needs[b] - T.needs[a])[0], sev = T.needs[need];
  if(O.up[S].some(p => p.town === T.id && p.need === need && p.status === "open")) return;
  if(sev < 38){ T.log.unshift({d:G.day, t:m.name + " holds a council meeting. Nothing is burning."}); return; }
  const rg = ORG_NEEDS[need].cost, cost = Math.round((rg[0] + (rg[1] - rg[0]) * sev / 100) * 1000);
  if(T.treasury >= cost){ T.treasury -= cost; T.needs[need] = Math.max(0, T.needs[need] - 38); const t = "Mayor " + surname(m.name) + " of " + T.name + " pays for " + orgNeedLabel(need) + " out of the town's own purse (" + curF(cost) + ")."; T.log.unshift({d:G.day, t}); orgNews(t, my && cost >= 12000); return; }
  if(m.trait === "corrupt" && chance(0.25)){ T.treasury = Math.max(0, T.treasury - 3000); const t = "A clerk in " + T.name + " asks where ƒ 3,000 of the town's money has gone. The mayor says it was spent on the road."; T.log.unshift({d:G.day, t}); orgNews(t, my); return; }
  if(m.trait === "bold" && chance(0.4)){ T.treasury += Math.round(cost * 0.5); T.needs.order = clamp(T.needs.order + 3, 0, 100); const t = "Mayor " + surname(m.name) + " of " + T.name + " raises a levy to pay for " + orgNeedLabel(need) + ". Not everybody is pleased."; T.log.unshift({d:G.day, t}); orgNews(t, my); return; }
  const p = {id:O.pid++, town:T.id, townName:T.name, state:S, need, cost, day:G.day, mayor:m.name, sev:Math.round(sev), status:"open"}; O.up[S].push(p);
  const t = "Mayor " + surname(m.name) + " of " + T.name + " petitions " + S + " for " + curF(cost) + " for " + orgNeedLabel(need) + "."; T.log.unshift({d:G.day, t}); orgNews(t, my);
}
function orgTownOf(p){ const O = orgEnsure(); return (O.towns[p.state] || []).find(t => t.id === p.town); }
function orgFund(p, by){ const O = orgEnsure(), T = orgTownOf(p); if(!p || p.status !== "open") return false; if(by === "state"){ if((O.treas[p.state] || 0) < p.cost) return false; O.treas[p.state] -= p.cost; } p.status = "funded"; p.by = by; p.closed = G.day; if(T){ T.needs[p.need] = Math.max(0, T.needs[p.need] - 42); T.mood = orgTownMood(T); T.log.unshift({d:G.day, t:"The " + (by === "congress" ? "Union" : "state") + " funds " + orgNeedLabel(p.need) + " in " + T.name + " (" + curF(p.cost) + ")."}); } return true; }
function orgRefer(p, prio){ const O = orgEnsure(); if(!p || p.status !== "open") return false; p.status = "referred"; p.closed = G.day; O.fed.push(Object.assign({}, p, {status:"open", prio:!!prio, from:p.state})); return true; }
function orgDeny(p){ if(!p || p.status !== "open") return false; p.status = "denied"; p.closed = G.day; const S = (G.states || []).find(x => x.n === p.state); if(S) S.unrest = clamp((S.unrest || 0) + 1, 0, 100); const T = orgTownOf(p); if(T) T.log.unshift({d:G.day, t:"The state declines " + orgNeedLabel(p.need) + " in " + T.name + ". The mayor takes it badly."}); return true; }
function orgStateAct(n){
  const O = orgEnsure(), my = orgIsMyState(n), q = (O.up[n] || []).filter(p => p.status === "open").sort((a, b) => b.sev - a.sev);
  let gov = n + "'s governor"; try{ const r = scEnsure().st[n]; if(r && r.gov) gov = "Governor " + surname(r.gov); }catch(e){}
  if(orgPlayerGov(n)){ q.forEach(p => { if(G.day - p.day >= 10){ orgDeny(p); orgNews("Nobody at the State House has answered " + p.townName + "'s petition for ten days. The acting governor refuses it.", true); } }); return; }
  let done = 0;
  q.forEach(p => { if(done >= 2) return; if((O.treas[n] || 0) >= p.cost){ if(orgFund(p, "state")){ done++; orgNews(gov + " funds " + p.townName + "'s " + orgNeedLabel(p.need) + " out of the state treasury (" + curF(p.cost) + ").", my); } } else if(G.day - p.day >= 3){ orgRefer(p, false); orgNews(gov + " cannot afford " + p.townName + "'s " + orgNeedLabel(p.need) + " and sends it up to Congress.", my); } });
}
function orgFedAct(){
  const O = orgEnsure(), by = {}; O.fed.filter(p => p.status === "open").forEach(p => { (by[p.need] = by[p.need] || []).push(p); });
  Object.keys(by).forEach(k => { const L = by[k], st = {}; L.forEach(p => st[p.state] = 1); if(L.length >= 3 && Object.keys(st).length >= 2 || L.some(p => p.prio) && L.length >= 2){
      const N = ORG_NEEDS[k], title = N.act, sp = reactHolder("speaker"), cost = L.reduce((a, p) => a + p.cost, 0);
      L.forEach(p => { orgFund(p, "congress"); (G.states || []).forEach(S => { if(S.n === p.state) S.unrest = clamp((S.unrest || 0) - 1.5, 0, 100); }); });
      O.acts.push({title, day:G.day, n:L.length, cost}); G.lastActs = G.lastActs || []; G.lastActs.unshift({title, day:G.day, pos:Object.assign({}, N.pos)}); if(G.lastActs.length > 6) G.lastActs.length = 6;
      orgNews("Congress passes the " + title + " after " + L.length + " towns in " + Object.keys(st).length + " states asked: " + curF(cost) + " for " + N.t + ". The act goes to the President.", true);
    } });
  O.fed.forEach(p => { if(p.status === "open" && G.day - p.day > 14) p.status = "lapsed"; });
}
function orgCourtAct(){
  const open = (G.cases || []).filter(c => c && !c.done); if(!open.length) return; let k = null; try{ k = roleKey(); }catch(e){}
  open.forEach(c => { if(k === "bench" && c.state !== (G.you && G.you.state)) return; if(G.day - (c.day || 0) < 4) return; if(!chance(0.35)) return; const forUnion = chance(0.55); c.done = true; c.ruled = forUnion ? "union" : "state"; const S = (G.states || []).find(s => s.n === c.state); if(S) S.unrest = clamp(S.unrest + (forUnion ? 3 : -2), 0, 100); orgNews("The Court rules " + (forUnion ? "for the Union" : "for " + c.state) + " in " + c.t + ".", true); });
}
function orgExecAct(){
  const ex = G.exec; if(!ex || ex.you) return; const L = (G.lastActs || []).filter(a => !a.signed && !a.vetoed && !a.aiSeen);
  L.forEach(a => { a.aiSeen = true; const fit = alignment(ex, {pos:a.pos || {econ:0, lib:0, def:0, wel:0}, title:a.title, id:"o:" + a.title}); if(fit > -20){ a.signed = true; orgNews("The President signs the " + a.title + ".", true); } else { a.vetoed = true; ex.vetoes = (ex.vetoes || 0) + 1; orgNews("The President vetoes the " + a.title + ".", true); } });
}
function orgTick(){
  try{ engTick(); }catch(e){}
  try{ airTick(); }catch(e){}
  try{ bodyTick(); }catch(e){}
  try{
    const O = G.org; if(!O || !O.today || O.today.d !== G.day || !G.you) return; const hr = Math.floor((G.minute || 0) / 60);
    O.today.ev.forEach(e => { if(e.done || e.h > hr) return; e.done = 1; try{ if(e.t === "town") orgTownAct(e.s, e.i); else if(e.t === "state") orgStateAct(e.s); else if(e.t === "fed") orgFedAct(); else if(e.t === "court") orgCourtAct(); else if(e.t === "exec") orgExecAct(); }catch(x){ console.warn("org", e.t, x); } });
  }catch(e){}
}
function orgLedgerHTML(){ try{ const O = orgEnsure(), L = O.hist.slice(-5).reverse(); if(!L.length) return ""; return '<p><strong>From the towns and the capitals:</strong></p>' + L.map(x => '<p class="np__q" style="font-style:normal">' + pcEsc(x.t) + '</p>').join(""); }catch(e){ return ""; } }
function orgBar(v){ return '<span style="display:inline-block;width:44px;height:5px;background:rgba(128,128,128,.25);border-radius:3px;vertical-align:middle"><i style="display:block;width:' + Math.round(v) + '%;height:100%;background:' + (v > 66 ? "#b33" : v > 40 ? "#c9a24a" : "#4a8") + ';border-radius:3px"></i></span>'; }
function orgBrowse(){
  const O = orgEnsure(), y = G.you, n = y.state, S = (G.states || []).find(x => x.n === n), T = O.towns[n] || [], q = (O.up[n] || []).filter(p => p.status === "open"), k = (function(){ try{ return heldOffice(); }catch(e){ return null; } })();
  let gov = "the governor"; try{ const r = scEnsure().st[n]; gov = k === "gov" ? "you" : (r && r.gov ? "Governor " + surname(r.gov) : "the governor"); }catch(e){}
  const towns = T.map(t => '<div style="margin:6px 0;padding:4px 8px;border-left:3px solid var(--line-soft)"><b>' + pcEsc(t.name) + '</b> <span class="muted">· mayor ' + pcEsc(t.mayor.name) + ' (' + pcEsc(t.mayor.trait) + ') · ' + (t.pop / 1000).toFixed(1) + 'k people · treasury ' + curF(t.treasury) + ' · mood ' + t.mood + '</span><div style="font-size:12px">' + Object.keys(t.needs).map(x => pcEsc(orgNeedLabel(x)) + ' ' + orgBar(t.needs[x])).join(" &nbsp; ") + '</div><div class="muted" style="font-size:12px">' + pcEsc((t.log[0] || {t:"Quiet so far."}).t) + '</div></div>').join("");
  const fed = O.fed.filter(p => p.status === "open");
  const body = '<div class="eyebrow">1 · The towns of ' + pcEsc(n) + '</div>' + towns +
    '<div class="eyebrow" style="margin-top:10px">2 · The state</div><p class="muted" style="font-size:13px">' + pcEsc(n) + ' is run by ' + pcEsc(gov) + '. Treasury ' + curF(O.treas[n] || 0) + '; unrest ' + Math.round(S ? S.unrest : 0) + '; ' + q.length + ' petition' + (q.length === 1 ? '' : 's') + ' waiting. ' + (q.length ? 'The oldest: ' + pcEsc(q[0].townName) + ' for ' + pcEsc(orgNeedLabel(q[0].need)) + ', ' + curF(q[0].cost) + ', day ' + q[0].day + '.' : 'Nothing waiting.') + '</p>' +
    '<div class="eyebrow" style="margin-top:10px">3 · The nation</div><p class="muted" style="font-size:13px">' + fed.length + ' petition' + (fed.length === 1 ? '' : 's') + ' have reached Congress' + (fed.length ? ' (' + listify(Object.keys(fed.reduce((a, p) => (a[orgNeedLabel(p.need)] = 1, a), {}))) + ')' : '') + '. ' + (O.acts.length ? 'Passed lately: ' + listify(O.acts.slice(-3).map(a => a.title + ' (' + a.n + ' towns)')) + '.' : 'No relief act has passed yet.') + ' Bread stands at ' + ((worldEnsure().bread) || 1).toFixed(2) + '.</p>' +
    '<div class="eyebrow" style="margin-top:10px">What has happened lately, wherever it happened</div>' + (O.hist.slice(-8).reverse().map(x => '<div class="careerline"><b>d' + x.d + ' ' + (x.h > 12 ? x.h - 12 : x.h) + (x.h >= 12 ? 'pm' : 'am') + '</b><span>' + pcEsc(x.t) + '</span></div>').join("") || '<p class="muted">Nothing yet.</p>') +
    ((k === "gov" || k === "senate" || k === "pres") ? '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" id="orgAct">' + (k === "gov" ? "Deal with the towns' petitions" : k === "senate" ? "Raise a stuck petition for " + pcEsc(n) : "Release federal aid") + '</button></div>' : '');
  govCardOpen("The nation, from the ground up", "How it holds together", "Households and towns do their own jobs; states answer them; the nation answers the states. Nobody waits for you.", body, null);
  const b = el("orgAct"); if(b) b.addEventListener("click", () => { if(k === "gov") orgPetitionsCard(); else orgActForRole(k); });
  return null;
}
function orgActForRole(k){
  const O = orgEnsure(), y = G.you; let p = null, msg = "";
  if(k === "senate"){ p = (O.up[y.state] || []).filter(x => x.status === "open").sort((a, b) => a.day - b.day)[0]; if(p && y.influence >= 4){ y.influence -= 4; orgRefer(p, true); msg = "You raise " + p.townName + "'s petition for " + orgNeedLabel(p.need) + " with the committee. It goes up as a priority."; } else msg = p ? "You are short of influence." : "Nothing is stuck in your state."; }
  else if(k === "pres"){ p = O.fed.filter(x => x.status === "open").sort((a, b) => b.cost - a.cost)[0]; if(p){ orgFund(Object.assign(p, {status:"open"}), "congress"); y.approval = clamp(y.approval + 1, 0, 100); msg = "You release federal aid to " + p.townName + " for " + orgNeedLabel(p.need) + " (" + curF(p.cost) + "), without waiting for an act."; reactEmit("foreign", {k:"reach", verb:"trade"}); } else msg = "Nothing has reached the capital."; }
  note(msg, true); try{ walkNow(); }catch(e){}
}
function orgPetitionsCard(){
  const O = orgEnsure(), y = G.you, n = y.state, q = (O.up[n] || []).filter(p => p.status === "open").sort((a, b) => b.sev - a.sev), body = q.length ? q.map(p => { const T = orgTownOf(p), cs = (function(){ try{ return caseFile("mayor", ORG_NEEDS[p.need].want, (G.states || []).find(s => s.n === n), p.mayor); }catch(e){ return null; } })();
    return '<div style="margin:10px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + pcEsc(p.townName) + '</b> <span class="muted">· mayor ' + pcEsc(p.mayor) + (T ? ' (' + pcEsc(T.mayor.trait) + ')' : '') + ' · ' + pcEsc(orgNeedLabel(p.need)) + ' · ' + curF(p.cost) + ' · waiting since day ' + p.day + '</span>' + (cs ? '<p style="margin:4px 0;font-size:13px">“' + pcEsc(cs.open[0]) + '”</p>' : '') + '<div class="card__actions" style="flex-wrap:wrap"><button type="button" class="btn" data-of="' + p.id + ':f">Fund from the state treasury</button><button type="button" class="btn btn--ghost" data-of="' + p.id + ':r">Send it to Congress</button><button type="button" class="btn btn--ghost" data-of="' + p.id + ':d">Decline</button></div></div>'; }).join("") : '<p class="muted">No town is waiting on you.</p>';
  govCardOpen("The towns' petitions", n, "State treasury: " + curF(O.treas[n] || 0) + ". Towns file these on their own; if you do not answer, the acting governor declines them after ten days.", body + '<div id="opSay" class="dream"></div>', null);
  card.querySelectorAll("[data-of]").forEach(b => b.addEventListener("click", () => { const [id, k] = b.getAttribute("data-of").split(":"), p = q.find(x => String(x.id) === id); if(!p) return; spend(15, 2); let r = "";
    if(k === "f"){ if(orgFund(p, "state")){ y.approval = clamp(y.approval + 2, 0, 100); r = "Funded. " + p.townName + " will see the money this week."; } else r = "The state treasury is short of " + curF(p.cost) + "."; } else if(k === "r"){ orgRefer(p, false); r = "Sent up to Congress with your name on it."; } else { orgDeny(p); y.approval = clamp(y.approval - 1, 0, 100); r = "Declined. The mayor will hear it from the clerk."; }
    el("opSay").textContent = r; card.querySelectorAll('[data-of^="' + id + ':"]').forEach(z => z.disabled = true); }));
  return null;
}
/* the real petitions of the real towns come to open hours and to a Senator's calls */
function orgCivFor(p){ const S = (G.states || []).find(x => x.n === p.state), cs = (function(){ try{ return caseFile("mayor", ORG_NEEDS[p.need].want, S, p.mayor); }catch(e){ return null; } })(); return {p, cs}; }
setTimeout(() => { try{
  const SX = window.NEPTUNE_SITTINGS; if(!SX || SX._org) return; SX._org = true;
  const prev = SX.castFor.govoffice;
  SX.castFor.govoffice = (M, out) => { try{ if(prev) out = prev(M, out) || out; const O = orgEnsure(), q = (O.up[G.you.state] || []).filter(p => p.status === "open").sort((a, b) => b.sev - a.sev); let n = 0;
    out.forEach(pp => { if(n >= 2 || !pp || !pp.case || pp.m) return; const p = q[n]; if(!p) return; const c = orgCivFor(p); if(!c.cs) return; pp.name = p.mayor; pp.role = "Mayor of " + p.townName; pp.want = ORG_NEEDS[p.need].t; pp.case = c.cs; pp.petitionId = p.id; n++; }); }catch(e){ console.warn("org cast", e); } return out; };
  const a0 = SX.after.govoffice;
