/* minds carry where people are from */
{ const _mo = onumMindOf; onumMindOf = function(id){ const mind = _mo.apply(this, arguments);
  try{ const p = byId(id); if(mind && p){ const r = rgnAssign(p), d = RGN_DEF[r];
    if(d){ mind.region = {id:r, name:d.name, immigrant:!!p.rgnImmigrant, accent:d.accent, phrases:d.pet.slice(), customs:JSON.parse(JSON.stringify(d.customs)), values:Object.assign({}, d.values), grudges:d.memory.grudges.map(g => RGN_DEF[g].name), hardship:d.memory.hardship};
      mind.beliefs = (mind.beliefs || []).concat(["remembers " + d.memory.hardship]);
