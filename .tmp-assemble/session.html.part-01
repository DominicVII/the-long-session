    /* party conference: water carafes on the desks */
    for(let r=0;r<3;r++) for(let c2=0;c2<3;c2++){
      addCyl(matCol(0xdfe6ea,.18,.1), -4.4+c2*3.5, DIM.desk + 0.08, 4.0+r*2.2, 0.04,0.12);
    }
    addBox(woodMat, 0, 0.12, d-1.55, 4.2, 0.24, 1.1, 0, true); /* low dais step */
    propPlaque(0, 2.55, d-0.04, 0, "Conference", "Members of the caucus", 1.2, 0.30);
  
    }catch(e){ if(window.console) console.warn("room caucus", e); }
  }
  if(id === "committee"){
    try{
      propRug(0, 7.2, 5.5, 4.2);   /* open well rug — not under the gallery */
      /* L→R as viewed from the well: Min, Maj, Maj, Chair, Maj, Maj, Min */
      const seatNames = ["Min","Maj","Maj","Chair","Maj","Maj","Min"];
      const deskY = DIM.daisFloor + DIM.dais - 0.02;
      for(let i=0;i<7;i++){
        const sx = -3.3+i*1.1;
        addBox(matCol(0x1c1f24,.5), sx, deskY+0.01, d-3.55, 0.16,0.02,0.11, 0, true);
        try{ propSeatPlate(sx, deskY+0.025, d-3.50, seatNames[i]); }catch(e2){}
        try{ propPlaque(sx, DIM.daisFloor + 0.42, d-3.18, 0, seatNames[i], "Rm 2141", 0.38, 0.11); }catch(e2){}
        addCyl(matCol(0x2a2d33,.4), sx, deskY+0.14, d-3.48, 0.012,0.24);
        addSphere(matCol(0x2a2d33,.4), sx, deskY+0.28, d-3.42, 0.022);
        addCyl(matCol(0xd8e2e8,.15), sx+0.22, deskY+0.05, d-3.55, 0.032,0.10);
      }
      /* gavel + sounding block at the Chair (center, x=0) */
      addBox(matCol(0x5a3a22,.55), 0.18, deskY+0.025, d-3.45, 0.14, 0.035, 0.14, 0, true);
      addCyl(matCol(0x6b4d2c,.45), 0.18, deskY+0.08, d-3.45, 0.025, 0.08);
      addCyl(matCol(0x8a6a3a,.4,.3), 0.02, deskY+0.04, d-3.38, 0.018, 0.22).rotation.z = Math.PI/2;
    }catch(e){ if(window.console) console.warn("committee dais dress", e); }
    try{
      if(!MODEST) propChandelier(0, h-1.0, 7.0, 6, 1.1);
      /* Rayburn-style seal behind the Chair */
      try{ propHouseSeal(0, 2.85, d - 0.045, Math.PI, 1.7); }catch(e){}
      /* dais flags via placeRoomFlags (Taylor Day: NO7 only) */
      /* wall clock facing the room; press cameras at gallery corners */
      propClock(-4.15, 3.35, d-0.09);
      addCyl(matCol(0x1b1d22,.5), -4.6, 0.75, 1.35, 0.05,1.5);
      addBox(matCol(0x15171b,.4), -4.6, 1.56, 1.35, 0.34,0.22,0.46, 0, true);
      addCyl(matCol(0x1b1d22,.5),  4.6, 0.75, 1.35, 0.05,1.5);
      addBox(matCol(0x15171b,.4),  4.6, 1.56, 1.35, 0.34,0.22,0.46, 0, true);
      propPlant(-hw+0.9, 8.6, 1.1);
      propPlant(hw-0.9, 8.6, 1.1);
      propSconce(-hw+0.12, 2.6, 6.5, Math.PI/2);
      propSconce(hw-0.12, 2.6, 6.5, -Math.PI/2);
      propPlaque(0, 3.85, d-0.04, 0, "Committee Room 2141", "Hearing in session", 1.35, 0.32);
    }catch(e){ if(window.console) console.warn("committee décor", e); }
  }
  if(id === "floor"){
    try{
    propRug(0, 7.5, 3.2, 9.0);
    if(!MODEST) propChandelier(0, h-1.3, 6.0, 10, 1.9);
    for(let i=0;i<4;i+=2){ propSconce(-hw+0.12, 3.2, 3.5+i*3.0, Math.PI/2); propSconce(hw-0.12, 3.2, 3.5+i*3.0, -Math.PI/2); }
    /* clerk / parliamentarian / reading clerk in the well */
    propChair(woodMat, leather, 0, d-3.95, Math.PI);
    propPapers(0, DIM.desk+0.02, d-4.55, 6);
    propDesk(woodMat, woodMat, 1.55, d-4.55, 1.45, 0.70);   /* parliamentarian / side desk */
    propChair(woodMat, leather, 1.55, d-3.95, Math.PI);
    propPapers(1.55, DIM.desk+0.02, d-4.55, 4);
    /* mace on stand in the well */
    addBox(brass, -1.15, 0.55, d-4.85, 0.55, 0.04, 0.55, 0, true);
    addCyl(matCol(0xb08b45,.3,.85), -1.15, 0.98, d-4.85, 0.045,0.95).rotation.z = Math.PI/2;
    propClock(0, 4.6, d-0.09);
    try{ propHouseSeal(0, 3.15, d - 0.045, Math.PI, 2.15); }catch(e){}
    /* side/national flags via placeRoomFlags */
    /* side galleries: wall ledge with gilt rail — never a floating slab */
    for(let s=-1;s<=1;s+=2){
      addBox(matCol(0x5a4030,.58), s*(hw-0.10), 2.78, d*0.58, 0.18, 0.10, d*0.38, 0, true);
      addBox(matCol(0xb08b45,.38,.82), s*(hw-0.04), 3.00, d*0.58, 0.05, 0.04, d*0.38, 0, true);
      for(let i=0;i<4;i++)
        addCyl(matCol(0xb08b45,.4,.8), s*(hw-0.08), 2.90, d*0.42 + i*(d*0.10), 0.018, 0.16);
    }
    /* electronic vote / status boards — matGlow (hex emissive) safe on this Three build */
    try{
      for(let s=-1;s<=1;s+=2){
        addBox(matCol(0x16181d,.55), s*(hw-0.04), 3.85, 8.5, 0.05, 0.72, 1.85, 0, true);
        addBox(matCol(0xb08b45,.40,.70), s*(hw-0.03), 4.24, 8.5, 0.03, 0.04, 1.90, 0, true);
        addBox(matGlow(0x0e1a22, 0x1a3a52, 0.18, 0.35, 0.08),
          s*(hw-0.07), 3.85, 8.5, 0.02, 0.58, 1.65, 0, true);
      }
    }catch(e){ if(window.console) console.warn("floor vote boards", e); }
    propPlaque(0, 4.95, d-0.04, 0, "House of Representatives", "The Chamber", 1.6, 0.34);
    propLamp(-1.5, 1.15, d-2.4, 0xffe6c0, 0.6);
    propLamp(1.5, 1.15, d-2.4, 0xffe6c0, 0.6);
  
    }catch(e){ if(window.console) console.warn("room floor", e); }
  }
  if(id === "press"){
    try{
    propRug(0, 5.0, 4.0, 4.0);
    for(let r=0;r<3;r++) for(let c2=0;c2<3;c2++){
      propPapers(-2.2+c2*2.2, 0.42, 2.8+r*2.0, 2);
      addCyl(matCol(0xd8dde2,.4), -1.8+c2*2.2, 0.46, 3.0+r*2.0, 0.035,0.11);
    }
    addCyl(matCol(0x1b1d22,.5), -2.6, 0.75, 7.6, 0.05,1.5);            /* camera tripod */
    addBox(matCol(0x15171b,.4), -2.6, 1.56, 7.6, 0.34,0.22,0.46, 0, true);
    addSphere(matCol(0x2a3440,.2), -2.6, 1.56, 7.36, 0.07);
    /* second camera + gallery rail */
    addCyl(matCol(0x1b1d22,.5), 2.4, 0.75, 7.4, 0.05,1.5);
    addBox(matCol(0x15171b,.4), 2.4, 1.56, 7.4, 0.34,0.22,0.46, 0, true);
    addBox(matCol(0x6b4d2c,.55), 0, 1.05, d-0.55, 6.2, 0.08, 0.08, 0, true);
    for(let i=0;i<7;i++){ addCyl(matCol(0x6b4d2c,.55), -3+i*1.0, 0.535, d-0.55, 0.025, 1.07); addCyl(matCol(0x4a3620,.55), -3+i*1.0, 0.02, d-0.55, 0.09, 0.04); }
    propLamp(2.4, 1.05, 7.4, 0xfff0d0, 0.7);
    propPlant(hw-0.8, 2.2, 1.0);
    if(!MODEST) propChandelier(0, h-0.6, 5.0, 4, 0.8);
    propPlaque(0, 2.45, d-0.04, 0, "Press Gallery", "Third floor", 1.15, 0.28);
    /* wall of monitors flush */
    for(let i=0;i<3;i++){
      addBox(matCol(0x16181d,.35,.4), -hw+0.04, 1.55, 3.2+i*1.7, 0.03,0.55,0.85, 0, true);
      addBox(matCol(0x2b3f52,.25), -hw+0.06, 1.55, 3.2+i*1.7, 0.01,0.46,0.72, 0, true);
    }
  
    }catch(e){ if(window.console) console.warn("room press", e); }
  }
  if(id === "steps"){
    try{
    const stone = matCol(0x9a958a,.86);   /* 20261030p fountain: was 0xc3bfb4 */
    const gilt = matCol(0xb08b45,.36,.84);
    addCyl(stone, 0, 0.16, 3.05, 1.45, 0.32);
    addCyl(stone, 0, 0.38, 3.05, 0.92, 0.20);
    addCyl(matCol(0x6a9bb8,.32,.12), 0, 0.50, 3.05, 0.78, 0.08);
    addCyl(gilt, 0, 1.05, 3.05, 0.07, 1.05);
    addSphere(gilt, 0, 1.62, 3.05, 0.14);
    [-6.2, -3.1, 3.1, 6.2].forEach(cx => {
      addCyl(stone, cx, 0.22, 6.35, 0.28, 0.44);
      addSphere(matCol(0x3f5a34,.95), cx, 0.58, 6.35, 0.30, 0.22, 0.30);
    });
    propStreetLamp(-6.4, 4.6, 3.4);
    propStreetLamp(6.4, 4.6, 3.4);
    propParkBench(-5.6, 2.15, 0.15);
    propParkBench(5.6, 2.15, -0.15);
    propPlant(-8.15, 1.55, 1.05);
    propPlant(8.15, 1.55, 1.05);
    propPlant(-8.2, 4.35, 1.0);
    propPlant(8.2, 4.35, 1.0);
    addBox(stone, 0, 0.26, 1.05, 1.50, 0.52, 0.52, 0, true);
    propPlaque(0, 0.68, 1.32, 0, "East Front", "The Capitol", 1.2, 0.28);
    }catch(e){ if(window.console) console.warn("room steps", e); }
  }
  if(id === "district" && !(typeof richTownNow === "function" && richTownNow())){   /* the plain stage's own lamps, benches, plants and campaign chairs; the town draws its own */
    try{
    [-6.8, -2.4, 2.4, 6.8].forEach((x,i) => propStreetLamp(x, 6.4 + (i%2)*1.6, 3.6));
    propParkBench(-4.4, 3.6, 0.08);
    propParkBench(4.4, 3.6, -0.08);
    propPlant(-4.55, 5.6, 1.05);
    propPlant(4.55, 4.8, 1.00);
    propPlant(-4.6, 11.15, 0.95);
    propPlant(4.6, 8.4, 0.95);
    addCyl(matCol(0x8a2f36,.7), 2.85, 0.32, 5.4, 0.09, 0.64);
    addCyl(matCol(0x8a2f36,.7), 2.85, 0.68, 5.4, 0.12, 0.10);
    addBox(matCol(0x2d3138,.75), 7.15, 0.55, 6.1, 0.38, 1.10, 0.28, 0, true);
    addBox(matCol(0x1c5f66,.8), 7.15, 1.05, 6.1, 0.36, 0.22, 0.08, 0, true);
    propChair(matCol(0x3f4a55,.9), matCol(0x33373f,.8), 4.75, 10.75, 0.35);
    propChair(matCol(0x3f4a55,.9), matCol(0x33373f,.8), 6.05, 10.75, -0.35);
    propPapers(5.4, DIM.desk + 0.02, 11.35, 3);
    addBox(matCol(0xe8e4d8,.95), -7.35, 1.15, 4.6, 0.04, 1.35, 0.95, 0, true);
    try{ propPlaque(-7.32, 1.15, 4.6, Math.PI/2, "VOTE", G.you ? G.you.name.split(" ").pop() : "HOME", 0.85, 0.32); }catch(e){}
    try{ propPlaque(0, 0.22, 1.2, 0, "Main Street", "The District", 1.15, 0.24); }catch(e){}
    }catch(e){ if(window.console) console.warn("room district", e); }
  }

  try{ buildHigherRoom(id, {woodMat, leather}); }catch(e){ if(window.console) console.warn("higher room", id, e); }
  /* Ornate corner pass — every room, every corner (after room-specific dress) */
  try{ dressOrnateCorners(id); }catch(e){ if(window.console) console.warn("dressOrnate", e); }

  /* ── services: radiators only. The heating main was a grey bar through
       every door, window and picture. */
  if(!R.open){
    if(R.light === "left" || R.light === "right"){
      const rx = R.light === "left" ? -hw+0.20 : hw-0.20;
      const clearZ = z => {
        for(let k = 0; k < 4; k++){
          const s = SHELF_SPANS.find(s => Math.abs(s.x - rx) < 0.9 && z + 0.55 > s.z - s.half && z - 0.55 < s.z + s.half);
          if(!s) break;
          z = (z < s.z) ? s.z - s.half - 0.6 : s.z + s.half + 0.6;
        }
        return clamp(z, 0.8, d - 0.8);
      };
      propRadiator(rx, 0.36, clearZ(d*0.34), 1.0, Math.PI/2);
      propRadiator(rx, 0.36, clearZ(d*0.66), 1.0, Math.PI/2);
    } else if(id !== "floor"){
      const backDoor = (DOORS[id] || []).some(dr => dr.side === "back");
      propRadiator(backDoor ? Math.min(hw - 1.0, 1.7) : 0, 0.36, d-0.22, 1.4, 0);
    }
  }
  /* Single picture-frame pass for every dressed room — same propFrame recipe everywhere. */
  if(R.style === "wood" || R.style === "marble" || R.style === "plain" || R.style === "chamber"){
    const arts = artPool();
    const nA = arts.length || 1;
    const doorZsL = (id === "corridor") ? (DOORS.corridor||[]).filter(dr => dr.side==="left").map(dr => dr.at * d) : [];
    const doorZsR = (id === "corridor") ? (DOORS.corridor||[]).filter(dr => dr.side==="right").map(dr => dr.at * d) : [];
    const noticeZ = (id === "corridor") ? 4.9 : null; /* skip bay occupied by the notice board */
    const nArt = id === "corridor" ? 3 : 2;
    const yMid = Math.min(2.55, Math.max(2.15, h * 0.46));
    const light = R.light;
    const skipL = light === "left";
    const skipR = light === "right";
    const doorsHere = DOORS[id] || [];
    const doorFront = doorsHere.some(dr => dr.side === "front");
    const doorBack  = doorsHere.some(dr => dr.side === "back");
    const doorZsAllL = doorsHere.filter(dr => dr.side==="left").map(dr => dr.at * d).concat(doorZsL);
    const doorZsAllR = doorsHere.filter(dr => dr.side==="right").map(dr => dr.at * d).concat(doorZsR);
    if(!skipL){
      for(let i=0;i<nArt;i++){
        const zz = d*(0.18 + i*(0.58/Math.max(1,nArt-1)));
        if(zz > d-0.95) break;
        if(doorZsAllL.some(bz => Math.abs(bz - zz) < 1.7)) continue;
        if(noticeZ != null && Math.abs(noticeZ - zz) < 1.5) continue;
        propFrame("x", -hw+0.012, yMid + (i%2)*0.06, zz, 0.62, 0.48, arts[i % nA], Math.PI/2);
      }
    }
    if(id !== "steps" && id !== "district" && !skipR){
      for(let i=0;i<nArt;i++){
        const zz = d*(0.28 + i*(0.46/Math.max(1,nArt-1)));
        if(zz > d-0.85) break;
        if(doorZsAllR.some(bz => Math.abs(bz - zz) < 1.6)) continue;
        propFrame("x", hw-0.012, yMid + 0.04, zz, 0.58, 0.46, arts[(i+2) % nA], -Math.PI/2);
      }
    }
    /* Front / back pictures — never on a door wall, never on a window wall */
    if(id !== "steps" && id !== "district"){
      const bx = Math.min(2.2, hw - 1.3);
      const skipFront = doorFront || light === "sky";
      const skipBack  = doorBack || light === "back" || light === "high" || id === "caucus" || id === "floor";
      if(!skipFront){
        propFrame("z", -bx, yMid + 0.06, 0.014, 0.70, 0.52, arts[1 % nA]);
        propFrame("z",  bx, yMid + 0.06, 0.014, 0.70, 0.52, arts[2 % nA]);
      }
      if(!skipBack){
        propFrame("z", -bx, yMid + 0.08, d-0.014, 0.74, 0.54, arts[0 % nA]);
        propFrame("z",  bx, yMid + 0.08, d-0.014, 0.74, 0.54, arts[3 % nA]);
      }
    }
  }

  /* doorways: jambs + leaf planted on floor (y=0), threshold sill, lintel plaque */
  if(id === "steps"){
    const deckY = 1.62;
    const facadeZ = d - 0.42;
    const dw = 1.38, dh = 2.28;
    addBox(matCol(0x14171c,.95), 0, deckY + dh * 0.5, facadeZ - 0.36, dw, dh, 0.10, 0, true);
    addBox(matTex(TEX.panel, 1, 2, .5), -dw/2 - 0.08, deckY + dh * 0.5, facadeZ - 0.48, 0.14, dh + 0.12, 0.16, 0, true);
    addBox(matTex(TEX.panel, 1, 2, .5),  dw/2 + 0.08, deckY + dh * 0.5, facadeZ - 0.48, 0.14, dh + 0.12, 0.16, 0, true);
    addBox(matTex(TEX.panel, 1, 2, .5), 0, deckY + dh + 0.10, facadeZ - 0.48, dw + 0.36, 0.16, 0.16, 0, true);
    try{ propPlaque(0, deckY + dh + 0.32, facadeZ - 0.437, Math.PI, "Statuary Corridor", "The Capitol", 1.18, 0.26); }catch(e){}
    addBox(matCol(0x14171c,.95), 0, 1.15, 0.05, 1.42, 2.30, 0.06, 0, true);
    addBox(matTex(TEX.panel, 1, 2, .5), -0.80, 1.15, 0.08, 0.14, 2.30, 0.12, 0, true);
    addBox(matTex(TEX.panel, 1, 2, .5),  0.80, 1.15, 0.08, 0.14, 2.30, 0.12, 0, true);
    addBox(matTex(TEX.panel, 1, 2, .5), 0, 2.38, 0.08, 1.72, 0.14, 0.12, 0, true);
    try{ propPlaque(0, 2.62, 0.10, 0, "The District", "Home", 1.12, 0.26); }catch(e){}
  } else (DOORS[id] || []).forEach(dr => {
    const p = doorAt(id, dr);
    /* doorAt() answers where a person stands to use a door, which is 35cm
       inside the room. Drawing the joinery from that point put every door
       in the building a third of a metre proud of its own wall, standing
       in the floor like a screen. The door belongs in the wall plane; the
       standing point stays where it is, because travel and the E prompt
       both key off it. */
    const dRoom = ROOMS[id] || ROOMS.office;
    const wx = dr.side === "left"  ? -dRoom.w/2
             : dr.side === "right" ?  dRoom.w/2 : p.x;
    const wz = dr.side === "front" ? 0
             : dr.side === "back"  ? dRoom.d : p.z;
    const frame = matTex(TEX.panel, 1, 2, .5);
    const leaf = matTex(TEX.panel, 1, 1.4, .86);   /* 20261030ag: satin varnish, not a hot mirror spot */
    const dw = 1.25, dh = 2.30, rail = 0.09, thick = 0.07;
    const floorY = 0;
    const jambH = dh + 0.02;                 /* from floor up */
    const jambCy = floorY + jambH * 0.5;
    const leafH = dh - 0.04;                 /* leaf meets the sill */
    const leafCy = floorY + 0.025 + leafH * 0.5;
    const along = (dr.side === "left" || dr.side === "right");
    if(along){
      const nx = dr.side === "left" ? 1 : -1;
      const fx = wx + nx * (thick * 0.5);
      addBox(frame, fx, jambCy, wz - dw/2 - rail/2, thick, jambH, rail, 0, true);
      addBox(frame, fx, jambCy, wz + dw/2 + rail/2, thick, jambH, rail, 0, true);
      addBox(frame, fx, floorY + jambH + rail/2, wz, thick, rail, dw + rail*2, 0, true);
      /* threshold sill on the floor — kills the float gap */
      addBox(frame, fx, floorY + 0.02, wz, thick + 0.04, 0.04, dw + rail*2.2, 0, true);
      addBox(leaf, wx + nx * 0.035, leafCy, wz, 0.035, leafH, dw - 0.012, 0, true);   /* 20261030ag: leaf meets the jambs, no blue slot either side */
      addBox(brass, wx + nx * 0.055, 1.05, wz + dw*0.28, 0.02, 0.12, 0.04, 0, true);
      /* contact disc under the opening */
      try{
        const cs = new THREE.Mesh(UNIT.plane, CONTACT);
        cs.rotation.x = -Math.PI/2; cs.position.set(wx, 0.008, wz);
        cs.scale.set(dw * 1.15, thick * 4, 1); cs.castShadow = false; cs.receiveShadow = false;
        cs.userData.contact = true; roomGroup.add(cs);
      }catch(e){}
    } else {
      const nz = dr.side === "front" ? 1 : -1;
      const fz = wz + nz * (thick * 0.5);
      addBox(frame, wx - dw/2 - rail/2, jambCy, fz, rail, jambH, thick, 0, true);
      addBox(frame, wx + dw/2 + rail/2, jambCy, fz, rail, jambH, thick, 0, true);
      addBox(frame, wx, floorY + jambH + rail/2, fz, dw + rail*2, rail, thick, 0, true);
      addBox(frame, wx, floorY + 0.02, fz, dw + rail*2.2, 0.04, thick + 0.04, 0, true);
      addBox(leaf, wx, leafCy, wz + nz * 0.035, dw - 0.012, leafH, 0.035, 0, true);
      addBox(brass, wx - dw*0.28, 1.05, wz + nz * 0.055, 0.04, 0.12, 0.02, 0, true);
      try{
        const cs = new THREE.Mesh(UNIT.plane, CONTACT);
        cs.rotation.x = -Math.PI/2; cs.position.set(wx, 0.008, wz);
        cs.scale.set(dw * 1.15, thick * 4, 1); cs.castShadow = false; cs.receiveShadow = false;
        cs.userData.contact = true; roomGroup.add(cs);
      }catch(e){}
    }
    const hole = new THREE.Mesh(UNIT.plane, matCol(0x14171c, .95));
    hole.position.set(wx + (dr.side==="left"?0.02:dr.side==="right"?-0.02:0),
                      floorY + leafH * 0.5 + 0.02,
                      wz + (dr.side==="front"?0.02:dr.side==="back"?-0.02:0));
    hole.rotation.y = p.ry;
    hole.scale.set(dw, leafH, 1);
    hole.material.side = THREE.DoubleSide;
    roomGroup.add(hole);
    {
      const dest = ROOMS[dr.to];
      const title = dest ? dest.t : (dr.to || "Door");
      const sub = dest ? dest.tag : "";
      /* Flush on wall face just above the opening (lintel) */
      const wallOff = 0.03;
      const px = wx + (dr.side==="left"?wallOff:dr.side==="right"?-wallOff:0);
      const pz = wz + (dr.side==="front"?wallOff:dr.side==="back"?-wallOff:0);
      propPlaque(px, dh + 0.22, pz, p.ry, title, sub, along ? 0.95 : 1.02, 0.28);
    }
  });

  /* Room name lives on the HUD. A second plaque beside the door was off-center. */

  /* This room's own identity plaque — so you know where you are without the HUD */
  {
    const here = ROOMS[id];
    if(here && !here.open && false){
      const doors = DOORS[id] || [];
      const entry = doors.find(d => d.side === "front") || doors[0];
      let px = 0, pz = 1.1, ry = 0;
      if(entry){
        const p = doorAt(id, entry);
        /* plaque on the wall beside the entry, inside the room */
        if(entry.side === "front"){ px = Math.min(hw - 1.1, Math.max(-hw + 1.1, p.x + 1.35)); pz = 0.55; ry = 0; }
        else if(entry.side === "back"){ px = Math.min(hw - 1.1, Math.max(-hw + 1.1, p.x - 1.35)); pz = d - 0.55; ry = Math.PI; }
        else if(entry.side === "left"){ px = -hw + 0.55; pz = Math.min(d - 1.2, Math.max(1.2, p.z + 1.2)); ry = Math.PI/2; }
        else { px = hw - 0.55; pz = Math.min(d - 1.2, Math.max(1.2, p.z + 1.2)); ry = -Math.PI/2; }
      } else {
        px = 0; pz = 0.55; ry = 0;
      }
      /* keep identity plaque flush on the wall face near entry */
      if(ry === Math.PI/2) px = -hw + 0.03;
      else if(ry === -Math.PI/2) px = hw - 0.03;
      else if(Math.abs(ry) < 0.01) pz = 0.03;
      else if(Math.abs(ry - Math.PI) < 0.01) pz = d - 0.03;
      let idTitle = here.t, idTag = here.tag;
      if(id === "visit" && G.visitId){
        const vm = byId(G.visitId);
        if(vm){ idTitle = (typeof ndNm === "function" ? ndNm(vm) : vm.name) || vm.name; idTag = (vm.suite || partyLabel(vm.party)); }
      } else if(id === "office" && G.you){
        idTitle = (typeof ndNm === "function" ? ndNm(G.you) : G.you.name) || G.you.name; idTag = (G.you.suite || partyLabel(G.you.party));
      }
      propPlaque(px, 2.05, pz, ry, idTitle, idTag, 1.10, 0.32);
    }
  }

  try{ placeRoomFlags(id, w, d, h, hw); }catch(e){ if(window.console) console.warn("flags", e); }
  try{ kAmenities(id, w, d, h, hw); }catch(e){ if(window.console) console.warn("amenities", e); }
  try{ kOfficeRole(id, w, d, h, hw); kOfficeRich(id, w, d, h, hw); }catch(e){ if(window.console) console.warn("office role", e); }

  /* portraits of predecessors — propFrame (rabbet + flush wall contact) */
  if(R.style === "wood"){
    try{
      if(TEX && TEX.portrait){
        const spots = id==="office" ? []
                    : id==="caucus" ? [[1, 2.55, d*0.22], [1, 2.55, d*0.82]]
                    : [[1, 2.45, d*0.22], [1, 2.45, d*0.78]];
        spots.forEach(sp => {
          const left = sp[0] < 0;
          const ry = left ? Math.PI/2 : -Math.PI/2;
          const wx = left ? -hw + 0.001 : hw - 0.001;
          propFrame("x", wx, sp[1], sp[2], 0.66, 0.88, TEX.portrait, ry);
        });
      }
    }catch(e){ if(window.console) console.warn("portrait", e); }
  }
  if(id === "office" || id === "visit"){
    try{
    const person = (id === "visit") ? byId(G.visitId) : G.you;
    decorateOfficeFor(person);
    try{ decorOwner(person, id); }catch(e){ if(window.console) console.warn("decorOwner", e); }
  
    }catch(e){ if(window.console) console.warn("room office", e); }
  }
  if(K_AMEN_ROOMS.indexOf(id) >= 0){ try{ if(kAmenMine(id)) decorOwner(G.you, id); }catch(e){ if(window.console) console.warn("decorOwner k", e); } }
  try{ positionLights(id); }catch(e){}
  try{ buildMotes(R); }catch(e){ if(window.console) console.warn("buildMotes", e); }
  try{
    const hx = horcruxOf(id);
    const L = consularLoreEnsure();
    if(hx && !(L.smashed && L.smashed[hx.id])){
      addBox(matCol(0x5c4318, .7), hx.x, 0.07, hx.z, 0.16, 0.06, 0.16, 0, true);
      addBox(matCol(0xc9a44a, .45, .85), hx.x, 0.16, hx.z, 0.09, 0.10, 0.09, 0, true);
    }
  }catch(e){}
  try{ freezeRoom(); }catch(e){ if(window.console) console.warn("freezeRoom", e); }
}
/* Small fittings do not need drawing a second time for their shadows —
   a door handle casts nothing anybody can see, and the shadow pass is a
   second render of everything that does. */
function freezeRoom(){
  roomGroup.updateMatrixWorld(true);
  const live = new Set();
  const keepUp = o => { let n = o; while(n && n !== roomGroup){ live.add(n); n = n.parent; } };
  for(const t of TICKERS){
    for(const part of [t.hour, t.min, t.g]){
      if(!part) continue;
      keepUp(part);
      part.traverse(c => live.add(c));
    }
  }
  roomGroup.traverse(o => {
    if(o === roomGroup || live.has(o)) return;
    /* the fittings keep updating their own matrices, for the same reason
       the people do: it is the only thing that could draw them wrong */
    /* small fittings do not need to be drawn a second time for shadows */
    if(o.isMesh && o.castShadow && o.geometry){
      if(!o.geometry.boundingSphere) o.geometry.computeBoundingSphere();
      const bs = o.geometry.boundingSphere;
      if(bs){
        const sc = Math.max(Math.abs(o.scale.x), Math.abs(o.scale.y), Math.abs(o.scale.z)) || 1;
        if(bs.radius * sc < SHADOW_SKIP) o.castShadow = false;
      }
    }
  });
}
function positionLights(id){
  const R = ROOMS[id], hw = R.w/2;
  const c = new THREE.Vector3(0, 1.0, R.d*0.55);
  let p;
  if(R.light === "left") p = new THREE.Vector3(-hw+0.4, R.h*0.72, R.d*0.45);
  else if(R.light === "right") p = new THREE.Vector3(hw-0.4, R.h*0.72, R.d*0.45);
  else if(R.light === "back") p = new THREE.Vector3(0, R.h*0.7, R.d-0.5);
  else if(R.light === "sky") p = new THREE.Vector3(-hw*0.5, R.h*1.6, R.d*0.2);
  else p = new THREE.Vector3(hw*0.3, R.h*0.92, R.d*0.72);
  sun.position.copy(p);
  sun.target.position.copy(c);
  sun.target.updateMatrixWorld();
  const span = Math.max(R.w, R.d) * 0.75;
  const s = sun.shadow.camera;
  s.left = -span; s.right = span; s.top = span; s.bottom = -span; s.near = 0.4; s.far = span*4.5;
  s.updateProjectionMatrix();
  lamp.position.set(0, R.h - 0.5, R.d*0.5);
  fill.position.set(0, R.h*0.62, R.d*0.42);   /* 20261030ag: off the door wall: no white globe on the Exec inner door */
}
/* Light follows the clock: cold at eight, gold at six, lamps after dark.
   The colours answer to the hour and the hour moves slowly, so the whole
   palette is recomputed a few times a second and only the moving parts â
   motes, clock hands, the fan â run every frame. */
const SUNC = new THREE.Color(), FOGC = new THREE.Color();
let LIGHT_DAY = 1, lightT = 0, lightKey = "", LIGHT_BUDGET = 4;
function updateLighting(dt){
  lightT -= (dt || 0.016);
  /* Crowd bucket (not exact headcount) so seating/despawn does not thrash mood lights. */
  const crowdBucket = peopleGroup ? Math.min(4, peopleGroup.children.length >> 2) : 0;
  const key = G.room + "|" + (G.day || 0) + "|" + Math.floor(G.minute / 3) + "|" + ROOMLIGHTS.length + "|" + crowdBucket;
  if(lightT <= 0 || key !== lightKey){ lightT = 0.35; lightKey = key; lightingSlow(); }
  if(motes){ motes.material.opacity = 0.22 * LIGHT_DAY; motes.rotation.y += 0.0009; }
  if(MODEST) return;
  /* the clock keeps the real hour; the fan turns */
  for(const t of TICKERS){
    if(t.kind === "clock"){
      const mins = G.minute % 720;
      t.hour.rotation.z = -(mins/720) * Math.PI * 2;
      t.min.rotation.z  = -((G.minute % 60)/60) * Math.PI * 2;
    } else if(t.kind === "fan"){
      t.g.rotation.y += 0.035;
    }
  }
}
function lightingSlow(){
  const R = ROOMS[G.room];
  if(!R) return;
  const h = (G.minute || 0)/60;
  const day = sunDay(h);
  const gold = sunGold(h);
  LIGHT_DAY = day;
  try{ syncWindowGlass(); }catch(e){}
  if(R.open){
    SUNC.setHSL(lerp(0.58, 0.10, gold), lerp(0.18, 0.42, gold), lerp(0.96, 0.72, gold));
    sun.color.copy(SUNC);
    /* the light stands where the sun in the sky stands, so shadows lie long and west in a December afternoon and short and under the feet at a June noon */
    try{ const SN = sunTimes(), ang = clamp((h - SN.rise) / Math.max(4, SN.set - SN.rise), -0.25, 1.25) * Math.PI, el = Math.sin(ang) * clamp(SN.maxEl / 62, 0.35, 1.15), D = Math.max(R.w, R.d) * 1.5, cz = R.d * 0.55;
      const rx = -Math.cos(ang) * 78, ry = Math.max(el, 0.05) * 72 + 4, rz = 64, rl = Math.hypot(rx, ry, rz);
      sun.position.set(rx / rl * D, 1.0 + ry / rl * D, cz + rz / rl * D); sun.target.position.set(0, 1.0, cz); sun.target.updateMatrixWorld(); }catch(e){}
    sun.intensity = 2.2 * (0.18 + day * 0.95) * GFX_SUN;
    hemi.color.setHSL(0.58, 0.45, lerp(0.38, 0.82, day));
    hemi.groundColor.setHSL(0.22, 0.22, lerp(0.16, 0.38, day));
    hemi.intensity = 0.95 * GFX_HEMI;
    lamp.intensity = 0;
    fill.intensity = 0.08;
    FOGC.setHSL(0.57, 0.35, lerp(0.28, 0.72, day));
    if(!scene.fog) scene.fog = new THREE.Fog(FOGC.getHex(), 18, 90);
    scene.fog.color.copy(FOGC);
    scene.fog.near = MODEST ? 22 : 32;
    scene.fog.far = MODEST ? 64 : 110;
    renderer.setClearColor(FOGC);
    renderer.toneMappingExposure = lerp(0.88, 1.12, day) * GFX_EXPOSE;
    if(camera){ camera.far = MODEST ? 72 : 110; camera.updateProjectionMatrix(); }
    try{ tintSky(day, gold); }catch(e){}
    try{ lWxLight(day); }catch(e){}
    try{
      const sk = G.world && G.world.sky;
      if(sk === "rain" || sk === "storm"){
        FOGC.setHSL(0.58, 0.18, lerp(0.22, 0.42, day));
        scene.fog.color.copy(FOGC);
        renderer.setClearColor(FOGC);
        if(skyMesh && skyMesh.material) skyMesh.material.color.setHSL(0.58, 0.22, lerp(0.18, 0.38, day));
      }
    }catch(e){}
    return;
  }
  try{ if(skyMesh && skyMesh.parent){ skyMesh.parent.remove(skyMesh); skyMesh.geometry.dispose(); skyMesh = null; } }catch(e){}
  try{ if(horizonMesh && horizonMesh.parent){ horizonMesh.parent.remove(horizonMesh); horizonMesh = null; } }catch(e){}
  try{ if(skyGlow && skyGlow.parent){ skyGlow.parent.remove(skyGlow); skyGlow = null; } }catch(e){}
  try{ if(landGroup && landGroup.parent){ landGroup.parent.remove(landGroup); landGroup = null; } }catch(e){}
  try{ if(scene) scene.background = null; }catch(e){}
  /* Warm Capitol practicals: soft gold sun, gentle hemi, less muddy fog. */
  SUNC.setHSL(lerp(0.11,0.068,gold), lerp(0.28,0.55,gold), lerp(0.94,0.68,gold));
  sun.color.copy(SUNC);
  sun.intensity = (R.open ? 2.05 : 1.55) * (0.14 + day*0.88) * GFX_SUN;
  hemi.color.setHSL(0.58, 0.14, lerp(0.34, 0.80, day));
  hemi.groundColor.setHSL(0.075, 0.18, lerp(0.12, 0.28, day));
  hemi.intensity = (R.open ? 0.70 : 0.48 + day*0.18) * GFX_HEMI;
  const evening = 1 - day;
  lamp.color.setHex(0xffd4a0);
  fill.color.setHex(0xffd9ae);   /* 20261030ag: amber, not a cold white globe */
  lamp.intensity = R.open ? 0 : 0.42 + evening*1.25;
  fill.intensity = R.open ? 0.12 : 0.28 + evening*0.38;
  if(renderer.capabilities && !renderer.capabilities.floatVertexTextures) fill.intensity *= 0.6;
  renderer.toneMappingExposure = lerp(0.82, 1.08, day) * GFX_EXPOSE * (R.open ? 0.84 : 1);   /* 20261030ag: no exterior blowout */
  const fogHue = R.open ? 0.58 : (R.style === "marble" ? 0.10 : 0.55);
  const fogSat = R.open ? 0.05 : (R.style === "marble" ? 0.08 : 0.05);
  FOGC.setHSL(fogHue, fogSat, lerp(0.08, R.open ? 0.58 : 0.48, day));
  if(!scene.fog) scene.fog = new THREE.Fog(FOGC.getHex(), 6, 60);
  scene.fog.color.copy(FOGC);
  scene.fog.near = R.open ? 16 : (R.style === "marble" ? 10 : 7);
  scene.fog.far = R.open ? 78 : Math.max(22, R.d * (R.style === "marble" ? 3.1 : 2.7));
  if(MODEST){
    scene.fog.near = R.open ? 14 : 8;
    scene.fog.far = R.open ? 56 : Math.max(24, R.d * 2.1);
    camera.far = R.open ? 68 : 42;
    camera.updateProjectionMatrix();
  }
  renderer.setClearColor(FOGC);
  /* practicals carry the room once the daylight goes */
  /* Only the nearest few practicals stay lit. Every extra point light is
     paid for on every fragment, and past four you cannot see the
     difference — but you can feel it in the frame rate. */
  const lampPower = 0.38 + (1 - day) * 0.92;
  if(ROOMLIGHTS.length){
    /* On Windows, Edge and Chrome run WebGL through ANGLE, where the
       vertex shader's uniform space is shared between the lights in the
       room and the bone matrices of everybody standing in it. Put four
       lamps and half a dozen skinned people in the same shader and the
       bones are what gets squeezed out — which is why a body collapses
       into a slab only when there is a crowd. So the practicals give way
       to the people: fewer lamps the more of them are in the room, and
       fewer still where the machine cannot carry bones in a texture. */
    const roomy = renderer.capabilities && renderer.capabilities.floatVertexTextures;
    const crowd = peopleGroup ? peopleGroup.children.length : 0;
    LIGHT_BUDGET = (G.simple || crowdSafe) ? 1
      : Math.max(1, ((G.gfx === "best" ? (roomy ? 4 : 2) : (roomy ? 3 : 2))
          - (crowd > 8 ? 2 : crowd > 4 ? 1 : 0)));
    const ranked = ROOMLIGHTS.map(L => ({L, d:Math.hypot(L.position.x-cam.x, L.position.z-cam.z)}))
      .sort((a,b) => a.d - b.d);
    ranked.forEach((r,i) => {
      const base = r.L.userData.base !== undefined ? r.L.userData.base
                 : (r.L.userData.base = r.L.intensity);
      /* the ones that stay burn a little brighter for the ones that went */
      const on = i < LIGHT_BUDGET;
      r.L.intensity = on ? base * lampPower * (1 + (4 - LIGHT_BUDGET) * 0.16) : 0;
      r.L.visible = on;
    });
  }
}

/* ── people ──────────────────────────────────────────────── */
function ensureLookMorphs(L){
  if(!L) return L;
  const fem = L.frame === "fem";
  if(L.faceW == null) L.faceW = fem ? 0.94 : 1.0;
  if(L.jawW == null) L.jawW = fem ? 0.88 : 1.0;
  if(L.browH == null) L.browH = fem ? 0.92 : 1.05;
  if(L.noseL == null) L.noseL = fem ? 0.94 : 1.02;
  if(L.lipF == null) L.lipF = fem ? 1.12 : 0.94;
  if(L.cheek == null) L.cheek = fem ? 1.06 : 0.96;
  if(L.age == null) L.age = 0.35;
  return L;
}
function buildPersonCheap(p){
  const L = p.look || {};
  const g = new THREE.Group();
  const suit = matCol(L.suit || 0x2c3340, .92);
  const skin = matCol(L.skin || 0xc4a882, .7);
  const hair = matCol(L.hair || 0x1a1512, .6);
  const body = new THREE.Mesh(UNIT.box, suit);
  body.scale.set(0.36, 0.78, 0.20);
  body.position.y = 0.78;
  const head = new THREE.Mesh(UNIT.sph, skin);
  head.scale.set(0.26, 0.30, 0.28);
  head.position.y = 1.48;
  const cap = new THREE.Mesh(UNIT.sph, hair);
  cap.scale.set(0.27, 0.16, 0.28);
  cap.position.set(0, 1.58, -0.02);
  g.add(body); g.add(head); g.add(cap);
  g.position.set(p.x || 0, 0, p.z || 0);
  g.rotation.y = p.facing || 0;
  g.userData = { cheap: true, H: L.height || 1.7 };
  return g;
}
function buildPerson(p){
  /* Full people always — suits, hair, faces. Cheap dummy was the potato corridor. */
  const L = p.look;
  /* Defensive clamp: a save from an older format, or any stray mutation
     elsewhere, could hand height/build a value outside the range rollLook()
     ever produces. Everything below scales off these two numbers, so an
     unclamped outlier here is exactly how a head ends up the size of a
     room — clamp to the widest range a real person could plausibly roll. */
  const Hreal = clamp(L.height, 1.3, 2.1), Breal = clamp(L.build, 0.6, 1.5);
  /* Shared body is authored at one size. Height/build become a root scale.
     Faces, hair, glasses still build per person on that body. */
  const H = BODY_CANON_H, B = BODY_CANON_B, hu = H/8.0;
  const g = new THREE.Group();
  const bodyScaleY = Hreal / BODY_CANON_H;
  const bodyScaleXZ = bodyScaleY * (0.88 + 0.12 * Breal);
  g.scale.set(bodyScaleXZ, bodyScaleY, bodyScaleXZ);

  const suit  = matCloth(L.suit, "suit", .90);
  const suit2 = matCloth(L.suit, "suit", .92);
  const shirt = matCloth(L.shirt, "shirt", .84);
  const skirtC = matCloth(L.suit, "skirt", .89);
  /* skin: shared by colour — Standard, soft roughness, no per-person Physical cost */
  if(!G._skinCol) G._skinCol = new Map();
  const skinKey = (L.skin|0);
  let skin = G._skinCol.get(skinKey);
  if(!skin){
    skin = nmSkin(L.skin);
    skin._shared = true;
    G._skinCol.set(skinKey, skin);
  }
  const hair  = nmHair(L.hair);
  const dark  = matCol(0x14120f, .45);
  const shoeM = matCol(0x16161a, .40);
  const tie   = matCol(partyColorNum(p.party || "IND"), .68);

  function M(geo, mat, parent, x,y,z, sx,sy,sz, cast){
    const m = new THREE.Mesh(geo, mat);
    m.position.set(x,y,z);
    m.scale.set(sx, sy, sz===undefined ? sx : sz);
    if(cast !== false) m.castShadow = !!PEOPLE_CAST_SHADOW;
    parent.add(m); return m;
  }

  const fem = L.frame === "fem";
  const W = WARDROBE[L.wear] || WARDROBE.suit_tie;
  const hipY = H*0.515, torsoLen = H*0.305;
  const shHalf = H*(fem ? 0.096 : 0.107)*B, hipHalf = H*(fem ? 0.062 : 0.055)*B;
  const thigh = H*0.245, shin = H*0.235;
  const upArm = H*0.175, foreArm = H*0.158;
  const outer = W.jacket ? suit : (W.vest ? shirt : shirt);   /* what the arms wear */
  const hose = matCol(fem ? 0x6b5646 : L.suit, .9);

  /* contact shadow, in world space at the feet */
  const cs = new THREE.Mesh(PG.plane, CONTACT);
  cs.rotation.x = -Math.PI/2; cs.position.y = 0.012;
  cs.scale.set(0.66*B, 0.66*B, 1); g.add(cs);

  /* ── the skeleton, and one skinned mesh over all of it ── */
  const legMat = (W.bottom === "skirt" || W.bottom === "dress") ? hose : suit2;
  const torsoMat = W.jacket ? suit : (W.vest ? suit2 : shirt);
  const spec = {
    bones:{
      hips:  {parent:null,   pos:[0, hipY, 0]},
      spineB:{parent:"hips", pos:[0, torsoLen*0.30, 0]},
      chestB:{parent:"spineB",pos:[0, torsoLen*0.42, 0]},
      neckB: {parent:"chestB",pos:[0, torsoLen*0.30, 0]},
      headB: {parent:"neckB", pos:[0, torsoLen*0.10, 0]},
      shL:{parent:"chestB", pos:[-shHalf, torsoLen*0.18, 0]},
      elL:{parent:"shL",    pos:[0, -upArm, 0]},
      wrL:{parent:"elL",    pos:[0, -foreArm, 0]},
      shR:{parent:"chestB", pos:[ shHalf, torsoLen*0.18, 0]},
      elR:{parent:"shR",    pos:[0, -upArm, 0]},
      wrR:{parent:"elR",    pos:[0, -foreArm, 0]},
      hpL:{parent:"hips", pos:[-hipHalf, 0, 0]},
      knL:{parent:"hpL",  pos:[0, -thigh, 0]},
      anL:{parent:"knL",  pos:[0, -shin, 0]},
      hpR:{parent:"hips", pos:[ hipHalf, 0, 0]},
      knR:{parent:"hpR",  pos:[0, -thigh, 0]},
      anR:{parent:"knR",  pos:[0, -shin, 0]}
    },
    segs:[
      {a:"hips",  b:"spineB", r0:H*0.118*B, r1:H*0.110*B, mat:0, dz:TORSO_DZ},
      {a:"spineB",b:"chestB", r0:H*0.110*B, r1:H*0.130*B, mat:0, dz:TORSO_DZ, bulge:fem ? 0.04 : 0.03},
      {a:"chestB",b:"neckB",  r0:H*0.130*B, r1:H*0.060*B, mat:0, dz:TORSO_DZ},
      {a:"neckB", b:"headB",  r0:H*0.050,   r1:H*0.048,   mat:2, rings:3},
      {a:"shL", b:"elL", r0:H*0.044*B, r1:H*0.036*B, mat:0, bulge:0.06},
      {a:"elL", b:"wrL", r0:H*0.036*B, r1:H*0.027*B, mat:0, bulge:0.05},
      {a:"shR", b:"elR", r0:H*0.044*B, r1:H*0.036*B, mat:0, bulge:0.06},
      {a:"elR", b:"wrR", r0:H*0.036*B, r1:H*0.027*B, mat:0, bulge:0.05},
      {a:"hpL", b:"knL", r0:H*0.064*B, r1:H*0.044*B, mat:1, bulge:0.05},
      {a:"knL", b:"anL", r0:H*0.044*B, r1:H*0.032*B, mat:1, bulge:0.06},
      {a:"hpR", b:"knR", r0:H*0.064*B, r1:H*0.044*B, mat:1, bulge:0.05},
      {a:"knR", b:"anR", r0:H*0.044*B, r1:H*0.032*B, mat:1, bulge:0.06}
    ]
  };
  const bodyKey = "v2|" + (fem ? "f" : "m") + "|" + (W.jacket ? "j" : "-") + "|" + (W.bottom || "t");
  const built = sharedSkin(spec, bodyKey);
  const skinnable = m => {
    if(!G._skinMats) G._skinMats = new Map();
    if(G._skinMats.has(m.uuid)) return G._skinMats.get(m.uuid);
    const c = m.clone();
    c.skinning = true;
    /* The torso runs up the body while the limbs run down, which flips the
       winding on one of them — without DoubleSide the mid-torso is culled
       and you can see straight through it. */
    c.side = THREE.DoubleSide;
    G._skinMats.set(m.uuid, c);
    return c;
  };
  const body = new THREE.SkinnedMesh(built.geo,
    [skinnable(torsoMat), skinnable(legMat), skinnable(skin)]);
  body.castShadow = !!PEOPLE_CAST_SHADOW; body.receiveShadow = true;
  g.add(body);
  /* the root bone belongs to the mesh, and every world matrix must be
     current before the Skeleton takes its inverse bind matrices — bind
     against stale matrices and the skin stays in bind pose while the
     bones move, which reads as a second body */
  body.add(built.bones.hips);
  g.updateMatrixWorld(true);
  body.bind(new THREE.Skeleton(built.order));
  const BN = built.bones;
  /* Frames that reproduce the old local spaces exactly, so every piece of
     detail below keeps the offsets it was authored with. */
  const pelvis = new THREE.Group(); pelvis.scale.z = Math.min(1, TORSO_DZ + 0.12); BN.hips.add(pelvis);
  const waistMat = W.bottom === "trousers" ? suit2 : (W.jacket ? suit : shirt);
  M(PG.waist, waistMat, pelvis, 0, H*0.035, 0, H*(fem?0.245:0.235)*B, H*0.13, H*0.150*B);
  if(W.bottom === "trousers")   /* belt */
    M(PG.waist, matCol(0x241c14,.5), pelvis, 0, H*0.088, 0, H*(fem?0.250:0.240)*B, H*0.024, H*0.155*B, false);

  /* torso: shirt or blouse underneath, then waistcoat, then the jacket */
  const spine = new THREE.Group();
  spine.position.y = -torsoLen*0.72;
  spine.scale.z = TORSO_DZ;            /* lapels, buttons and shirt front sit on the flatter chest */
  BN.chestB.add(spine);
  const _nSway = [], _nIris = [];
