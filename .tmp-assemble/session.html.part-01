  if(fem)  /* a little shaping through the chest */
    M(PG.sph, W.jacket ? suit : shirt, spine, 0, torsoLen*0.70, H*0.046*B, H*0.146*B, H*0.072, H*0.050*B, false);
  const openCut = (L.wear === "suit_open");
  const vestMat = W.vest ? matCloth(suitShift(L.suit, 38), "suit", .82) : suit;
  if(W.vest){
    /* Waistcoat: two fronts, a real V, gold buttons. Reads even without a jacket. */
    for(const s2 of [-1,1]){
      const vf = M(PG.box, vestMat, spine, s2*H*0.042*B, torsoLen*0.48, H*0.058*B,
        H*0.092*B, torsoLen*0.58, H*0.036*B, false);
      vf.rotation.y = s2*0.10;
      vf.rotation.z = s2*0.03;
    }
    /* shirt in the V */
    M(PG.box, shirt, spine, 0, torsoLen*0.62, H*0.070*B, H*0.036*B, torsoLen*0.36, H*0.012, false);
    for(let i=0;i<5;i++)
      M(PG.sph, matCol(0xc9a24a,.32,.62), spine, 0, torsoLen*(0.30+i*0.10), H*0.094*B, H*0.011, H*0.011, H*0.007, false);
  }
  if(W.jacket){
    const gap = openCut ? 0.108 : (W.vest ? 0.072 : 0.048);
    const lapW = openCut ? 0.070 : 0.050;
    for(const s2 of [-1,1]){
      const panel = M(PG.box, suit, spine, s2*H*gap*B, torsoLen*0.46, H*0.040*B,
        H*(openCut ? 0.086 : 0.108)*B, torsoLen*0.78, H*0.052*B, false);
      panel.rotation.y = s2*(openCut ? 0.32 : 0.08);
      /* hem */
      _nSway.push(M(PG.box, suit2, spine, s2*H*(gap-0.004)*B, torsoLen*0.10, H*0.036*B,
        H*0.100*B, torsoLen*0.14, H*0.048*B, false));
    }
    for(const s2 of [-1,1]){
      const lap = M(PG.box, suit2, spine, s2*H*(openCut?0.062:0.044)*B, torsoLen*0.82, H*0.092*B,
        H*lapW*B, torsoLen*(openCut ? 0.38 : 0.28), H*0.016, false);
      lap.rotation.z = s2*(openCut ? 0.52 : 0.28);
      lap.rotation.y = s2*(openCut ? 0.18 : 0.04);
      /* the notch sits on the lapel by the collar, not floating off the shoulder */
      const notch = M(PG.box, suit, spine, s2*H*(openCut?0.074:0.058)*B, torsoLen*0.95, H*0.100*B,
        H*0.022*B, H*0.014, H*0.008, false);
      notch.rotation.z = s2*(openCut ? 0.9 : 0.7); notch.rotation.y = lap.rotation.y;
    }
    /* pocket flap, left breast */
    M(PG.box, suit2, spine, -H*0.108*B, torsoLen*0.42, H*0.090*B, H*0.070*B, H*0.018, H*0.012, false);
    const nBtn = W.vest ? 2 : (openCut ? 1 : 3);
    for(let i=0;i<nBtn;i++)
      M(PG.sph, matCol(0x1d1710,.32,.45), spine, H*(openCut?0.070:0.090)*B, torsoLen*(0.34+i*0.14), H*0.094*B, H*0.014,H*0.014,H*0.008, false);
    if(!openCut){
      M(PG.box, matCol(pick([0xc4544a,0xd9b45e,0x4a7fa8,0xe8e4d8]),.78), spine,
        -H*0.118*B, torsoLen*0.72, H*0.092*B, H*0.044*B, H*0.024, H*0.010, false);
    }
    if(!openCut && W.neck === "tie"){
      M(PG.sph, tie, spine, -H*0.054*B, torsoLen*0.90, H*0.096*B, H*0.015, H*0.015, H*0.008, false);
      M(PG.ring, matCol(0xc9a24a,.3,.85), spine, -H*0.054*B, torsoLen*0.90, H*0.098*B,
        H*0.022, H*0.022, H*0.022, false).rotation.x = Math.PI/2;
    }
  } else {
    /* shirtsleeves: cuffs at the wrist, placket down the chest */
    M(PG.box, shirt, spine, 0, torsoLen*0.58, H*0.068*B, H*0.040*B, torsoLen*0.50, H*0.012, false);
  }
  /* shirt collar */
  for(const s2 of [-1,1]){
    const col = M(PG.box, shirt, spine, s2*H*0.034*B, torsoLen*0.99, H*0.046*B,
      H*0.046*B, H*0.042, H*0.014, false);
    col.rotation.z = s2*0.55;
  }
  /* neckwear */
  if(W.neck === "tie"){
    M(PG.box, tie, spine, 0, torsoLen*0.965, H*0.074*B, H*0.036*B, H*0.034, H*0.018, false);
    _nSway.unshift(M(PG.box, tie, spine, 0, torsoLen*0.70, H*0.092*B, H*0.042*B, torsoLen*0.48, H*0.016, false));
  } else if(W.neck === "open"){
    /* Open collar: shirt placket showing, no knot */
    M(PG.box, shirt, spine, 0, torsoLen*0.78, H*0.070*B, H*0.028*B, torsoLen*0.38, H*0.010, false);
    for(const s2 of [-1,1]){
      const wing = M(PG.box, shirt, spine, s2*H*0.048*B, torsoLen*1.00, H*0.058*B,
        H*0.052*B, H*0.050, H*0.016, false);
      wing.rotation.z = s2*0.85;
    }
  } else if(W.neck === "scarf"){
    const sc = tie;
    M(PG.waist, sc, spine, 0, torsoLen*0.97, 0, H*0.118*B, H*0.062, H*0.094*B, false);
    M(PG.box, sc, spine, -H*0.058*B, torsoLen*0.72, H*0.078*B, H*0.048*B, torsoLen*0.42, H*0.016, false);
    M(PG.box, sc, spine,  H*0.040*B, torsoLen*0.62, H*0.070*B, H*0.036*B, torsoLen*0.28, H*0.014, false);
  } else if(W.neck === "bow"){
    /* a pussy-bow at the collar, in the party colour */
    M(PG.sph, tie, spine, -H*0.036*B, torsoLen*0.955, H*0.056*B, H*0.032*B, H*0.026, H*0.016, false)
      .rotation.z = 0.35;
    M(PG.sph, tie, spine,  H*0.036*B, torsoLen*0.955, H*0.056*B, H*0.032*B, H*0.026, H*0.016, false)
      .rotation.z = -0.35;
    M(PG.sph, tie, spine, 0, torsoLen*0.955, H*0.060*B, H*0.014, H*0.014, H*0.010, false);
    M(PG.box, tie, spine, -H*0.014*B, torsoLen*0.895, H*0.058*B, H*0.020*B, H*0.070, H*0.008, false)
      .rotation.z = 0.16;
  } else if(W.neck === "necklace"){
    const gold = matCol(0xc9a24a,.3,.85);
    M(PG.ring, gold, spine, 0, torsoLen*0.945, H*0.030*B, H*0.062*B, H*0.062*B, H*0.062*B, false)
      .rotation.x = Math.PI/2;
    M(PG.sph, tie, spine, 0, torsoLen*0.895, H*0.060*B, H*0.014, H*0.017, H*0.009, false);
  }
  /* shoulders */
  M(PG.sph, torsoMat, spine, -shHalf*0.80, torsoLen*0.885, 0, H*(fem?0.036:0.042)*B, H*0.026, H*0.050*B, false);
  M(PG.sph, torsoMat, spine,  shHalf*0.80, torsoLen*0.885, 0, H*(fem?0.036:0.042)*B, H*0.026, H*0.050*B, false);

  /* neck and head — skull + face plate matched to body frame / morphs */
  const headG = new THREE.Group();
  headG.position.set(0, -torsoLen*0.05, 0); BN.headB.add(headG);
  ensureLookMorphs(L);
  /* Same defensive clamp as H/B above, applied to the face morphs — these
     are the ones that can blow up the head specifically while the body
     stays a normal size, which is the more misleading failure to hit. */
  const fw = clamp(L.faceW, 0.7, 1.3), jw = clamp(L.jawW, 0.7, 1.3),
        bh = clamp(L.browH, 0.7, 1.3), nl = clamp(L.noseL, 0.7, 1.3),
        lf = clamp(L.lipF, 0.7, 1.3), ck = clamp(L.cheek, 0.7, 1.3);
  const skullPool = fem ? SKULLS_FEM : SKULLS_MASC;
  const skull = new THREE.Mesh(skullPool[(p.id||0) % skullPool.length], njHeadSkin(skin));
  /* Head scale tracks body build + face morphs so it does not float off the neck */
  const headW = hu * (fem ? 0.93 : 0.99) * fw * (0.96 + 0.06*B);
  const headH = hu * (fem ? 0.89 : 0.93) * (0.98 + 0.04*bh);
  const headD = hu * (fem ? 0.96 : 1.00) * (0.97 + 0.05*jw);
  skull.position.set(0, hu*0.455, -hu*0.015);
  skull.scale.set(headW, headH, headD);
  skull.castShadow = !!PEOPLE_CAST_SHADOW;
  headG.add(skull);
  /*
     Faces are modeled volumes, not a canvas decal.  The skull supplies the
     cheeks and forehead; these small meshes supply the readable planes that
     catch light at normal gameplay distance.
  */
  L._clothVer = 7;
  const eyeWhite = matCol(0xe8e3da, .45);
  const irisMat = nbIris(L.eye || 0x5a3d24);
  const pupilMat = matCol(0x090807, .26);
  const eyeY3 = hu*0.50;
  const eyeX3 = hu*0.158*fw;
  /* The skull's own "face plane" (sculptSkull's z>0.52 inset) sits close
     enough to these z-depths that eyes/brow/lips were landing at or behind
     its surface — modelled, but sealed inside the head and never drawn.
     Pushed 0.02–0.03*hu further forward so they clear the skull shell and
     actually read as a face rather than a blank dome. */
  let eyeL, eyeR;
  [-1,1].forEach(side => {
    const ex = side*eyeX3;
    const eye = M(PG.sph, eyeWhite, headG, ex, eyeY3, hu*0.478,
      hu*0.060, hu*0.038, hu*0.028, false);
    if(side < 0) eyeL = eye; else eyeR = eye;
    _nIris.push(M(PG.sph, irisMat, headG, ex, eyeY3, hu*0.505,
      hu*0.030, hu*0.027, hu*0.012, false));
    _nIris.push(M(PG.sph, pupilMat, headG, ex, eyeY3, hu*0.516,
      hu*0.014, hu*0.018, hu*0.008, false));
    if(G.gfx === "best"){
      M(PG.sph, matCol(0xffffff, .18), headG, ex-hu*0.009, eyeY3+hu*0.010, hu*0.525,
        hu*0.007, hu*0.007, hu*0.004, false);
    }
  });
  /* ears on the skull, not floating off it */
  const earY = hu*0.43, earX = headW * 0.475;
  M(PG.sph, skin, headG, -earX, earY, -hu*0.02, hu*0.055, hu*0.12, hu*0.08, false);
  M(PG.sph, skin, headG,  earX, earY, -hu*0.02, hu*0.055, hu*0.12, hu*0.08, false);
  /* cheeks — skin volume so the face is not only a flat paint */
