  SSN.result = {aye, no, passed:aye > no}; ssnEnsure().log.push({d:G.day, kind:SSN.kind, aye, no}); if(ssnEnsure().log.length > onumLim(60,"hist")) ssnEnsure().log.shift();
}
function ssnRecognize(){
