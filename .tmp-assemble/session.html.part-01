      if(pref != null && pref < -0.35 && Math.abs(seedOf("rgd" + p.id + G.day)) % 3 === 0) return null; } }catch(e){}
  const d = _dg.apply(this, arguments);
  try{ if(d && G.you) window.onumRegionDeed({a:p.id, b:"you", kind:"favor", text:"a gift to " + cause}); }catch(e){}
  return d; }; }
/* warmth across regions is shared work; it moves the regions a hair */
{ const _rp = ripple; ripple = function(m, dW){ const r = _rp.apply(this, arguments);
