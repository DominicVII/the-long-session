  try{ const parts = String(p.name || "").split(" "), last = parts.slice(1).join(" "), first = parts[0];
    for(const id of RGN_IDS){ const c = NAME_CULTURES[id]; if(c && ((c.last || []).indexOf(last) >= 0)) return id; }
