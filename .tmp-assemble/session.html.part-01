    const body = {senate_floor:"the Senate floor", house_floor:"the House floor", committee_hearing:"the hearing", markup:"the markup", question_time:"Question Time", confidence_vote:"the confidence debate", consensus:"the council", decree:"the decree", rubber_stamp:"the chamber", oral_argument:"the court"}[kind] || "the session";
    if(SSN && isYou && (!e.kind || e.kind === SSN.kind)){ const al = ssnStage().allows, need = act === "point_of_order" ? "point_of_order" : act; if(al.indexOf(need) < 0 && !(act === "speak" && al.indexOf("seek") >= 0)) return {ok:false, why:"not in order at this stage (" + ssnStage().name + ")"}; }
    const t = String(e.text || "").slice(0, 400), tgt = e.target != null ? ssnWho(e.target) : null, ls = ssnListeners(24);
    const mem = (txt, w) => ls.forEach(m => { try{ window.onumRemember(m.id, txt, nm); }catch(_){} try{ if(Math.abs(w) > 0 && isYou) m.rel.warmth = clamp(m.rel.warmth + w * (m.party === G.you.party ? 1 : 0.5), -100, 100); }catch(_){} });
    const log = (txt, press) => { try{ lLog(txt, "session"); }catch(_){} if(press){ try{ feed(txt); }catch(_){} try{ G.reactNews = (G.reactNews || []).concat([{t:txt, d:G.day}]).slice(-12); }catch(_){} } S.log.push({d:G.day, kind, act, who:nm, t:txt.slice(0, 160)}); if(S.log.length > onumLim(80,"hist")) S.log.shift(); };
