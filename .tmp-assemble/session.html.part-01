}
function dynPerson(id){ if(id == null) return null; if(id === "you") return G.you; return byId(id) || (G.you && G.you.id === id ? G.you : null); }
function dynAudit(){
  /* a name that reads as the other sex: keep the person's sex, give a fitting first name. Never lore, never the player. */
  const D = dynEnsure(), fixed = [];
