      try{ refreshBar(); }catch(e){} try{ refreshPanels(); }catch(e){} }
    window.ONUM_PLAYER_OFFICE = window.ONUM_PLAYER_OFFICE && window.ONUM_PLAYER_OFFICE.office === k ? window.ONUM_PLAYER_OFFICE : window.onumPlayerOffice();
  }catch(e){}
}
try{ window.ONUM_OFFICE_HISTORY = window.ONUM_OFFICE_HISTORY || {seats:{}, day:null}; window.ONUM_PLAYER_OFFICE = window.ONUM_PLAYER_OFFICE || {office:null, reason:"no career yet"}; }catch(e){}
setInterval(ofhWatch, 1500);
window.addEventListener("onum-day", () => { try{ if(G && G.you) ofhSync(); }catch(e){} });
/* a sitting seats the player only in the body they belong to */
{ const _so = ssnOpen; ssnOpen = function(o){ const r = _so.apply(this, arguments);
  try{ if(r && G.you){ const k = ofhYouKey(), mine = {house_floor:"house", senate_floor:"senate", oral_argument:"bench", committee_hearing:k === "house" || k === "senate" ? k : null, markup:k === "house" || k === "senate" ? k : null}[r.kind];
    if(mine !== k){ r.seats = r.seats.filter(s => s.personId !== "you"); ssnPublish(); } } }catch(e){} return r; }; }
{ const _dp = dynPublish; dynPublish = function(){ try{ if(G.you && G.dyn && G.dyn.P[G.you.id]) G.dyn.P[G.you.id].role = officeTitle(); }catch(e){} return _dp.apply(this, arguments); }; }
/* replies that really came back from Ollama keep Live talk Live */
setTimeout(function ofhLtHook(){ try{ const L = window.onumLiveTalk; if(!L || !L.reply || !L.report){ setTimeout(ofhLtHook, 2000); return; } if(L._ofh) return; L._ofh = true; const _r = L.reply;
  L.reply = async function(){ try{ const r = await _r.apply(this, arguments); try{ if(r && r.live === true) L.report(true); }catch(e){} return r; }catch(err){ try{ L.report(false); }catch(e){} throw err; } }; }catch(e){} }, 1500);

/* ── 20261021: candid speech, data side. Who a speaker is, what they want and owe, and what they
   last said. The line itself comes from Neptune/MARS (onumCandid + onumLiveTalk); this side only
   asks for it with an onum-speak event and keeps the record honest. ── */
const CND_AX = {econ:"taxes and trade", lib:"how much the state may tell people what to do", def:"defence", wel:"what it does for working families"};
function cndPerson(id){ try{ return id === "you" || (G.you && id === G.you.id) ? G.you : byId(id); }catch(e){ return null; } }
function cndVoice(p){
  if(p.cndVoice) return p.cndVoice;
  const r = rng(seedOf("voice:" + p.id + ":" + (p.name || ""))), t = p.traits || {};
  let phrases = []; try{ const R = (window.ONUM_REGIONS || {})[p.birthRegion || rgnAssign(p)]; if(R && R.phrases && R.phrases.length){ const a = R.phrases.slice(); for(let i = 0; i < 1 + (r() < 0.5 ? 1 : 0) && a.length; i++) phrases.push(a.splice(Math.floor(r() * a.length), 1)[0]); } }catch(e){}
  p.cndVoice = {length:r() < 0.5 + ((t.vanity || 50) - 50) / 150 ? "rambling" : "terse", register:r() < 0.45 + ((t.discretion || 50) - 50) / 150 ? "formal" : "folksy",
    candor:r() < 0.5 + ((t.temper || 50) - (t.discretion || 50)) / 200 ? "blunt" : "evasive", phrases};
  return p.cndVoice;
}
/* 20261021a: a fresh handful of the region's pet phrases each time, skipping ones this speaker used lately */
function cndPhrases(p){
  try{ const R = (window.ONUM_REGIONS || {})[p.birthRegion || rgnAssign(p)]; if(!R || !R.phrases) return [];
    const said = (p.cndSaid || []).slice(-6).map(x => x.t).join(" \n ");
    let pool = R.phrases.filter(s => said.indexOf(s) < 0); if(pool.length < 3) pool = R.phrases.slice();
    const r = rng(seedOf("ph:" + p.id + ":" + (p.cndSaid || []).length + ":" + (G.day || 0))), out = [];
    while(out.length < 3 && pool.length) out.push(pool.splice(Math.floor(r() * pool.length), 1)[0]);
    return out; }catch(e){ return []; }
}
function cndStance(p){
  const b = G.bill && !G.bill.done ? G.bill : null; if(!b || !p || p === G.you) return null;
  let v = 0, al = 0; try{ al = alignment(p, b); v = p.kind === "member" ? memberVote(p, b) : (al > 0 ? 1 : -1); }catch(e){}
  let best = null, bv = 0; try{ const P = b.pos || {}, M = p.pos || {}; Object.keys(CND_AX).forEach(k => { const x = (P[k] || 0) * (M[k] || 0); if(Math.abs(x) > Math.abs(bv)){ bv = x; best = k; } }); }catch(e){}
  const home = p.state || "home";
  let why = best ? (bv > 0 ? "it gets " + CND_AX[best] + " right for " + home : "it gets " + CND_AX[best] + " wrong for " + home) : (v > 0 ? "it does more good than harm for " + home : "it costs " + home + " more than it gives");
  let conc = false;
  if(best && (bv > 0) !== (v > 0)){ why = "the party line, though " + why.replace(/^it /, "they think it "); conc = true; }
  if(p.pledge && G.day - p.pledgeDay < 8){ why = "they gave their word on it"; conc = false; }
  if(Math.abs(al) < 8 && !(p.pledge && G.day - p.pledgeDay < 8)) why += conc ? " (a close call)" : ", though not by much";
