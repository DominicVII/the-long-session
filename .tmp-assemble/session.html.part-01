      propPlaque(5.4, 1.62, 11.85 - 0.03, Math.PI, (G.you && G.you.name ? G.you.name.toUpperCase() : "YOUR CAMPAIGN"), pn + " · sign up here", 1.5, 0.62);
      propPlaque(5.4, 1.62, 11.85 + 0.03, 0, (G.you && G.you.name ? G.you.name.toUpperCase() : "YOUR CAMPAIGN"), pn + " · sign up here", 1.5, 0.62); }catch(e){}
    }catch(e){ if(window.console) console.warn("room district", e); }
  }

  /* ── dressing: the things that make a room look inhabited ── */
  if(id === "office" || id === "visit"){
    try{
    propRug(0, 6.4, 3.6, 4.4);
