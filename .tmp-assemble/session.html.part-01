/* values meet a bill: order vs freedom (lib), trade (econ), family (wel), faith */
function rgnLean(m, bill){
  try{ if(!m || !bill || !bill.pos) return 0; const r = rgnAssign(m); const v = RGN_DEF[r] && RGN_DEF[r].values; if(!v) return 0;
    const w = m.rgnImmigrant ? 0.6 : 1, P = bill.pos;
