  g.fillStyle = "#b4b8b8"; g.beginPath(); g.ellipse(dx, ground - 52, 44, 52, 0, Math.PI, 0); g.fill(); g.fillRect(dx - 44, ground - 54, 88, 8); g.fillStyle = "#8e9494"; g.fillRect(dx - 12, ground - 124, 24, 28); g.beginPath(); g.moveTo(dx - 14, ground - 124); g.lineTo(dx, ground - 156); g.lineTo(dx + 14, ground - 124); g.fill();
