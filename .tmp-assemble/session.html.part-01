}
function cndBetween(p, listenerId){
  /* the latest real things between them: from what the speaker remembers */
  let grudge = null, debt = null; const lname = listenerId === "you" || listenerId == null ? "you" : ((cndPerson(listenerId) || {}).name || "");
  try{ (p.mem || []).forEach(m => { if(!m || !m.t) return; const about = listenerId === "you" || listenerId == null ? /\byou\b|\byour\b/i.test(m.t) : lname && m.t.indexOf(lname.split(" ").pop()) >= 0; if(!about) return;
    if(m.w < 0 && (!grudge || m.d > grudge.day)) grudge = {day:m.d, what:m.t};
    if(m.w > 0 && (!debt || m.d > debt.day)) debt = {day:m.d, what:m.t}; }); }catch(e){}
  try{ if(listenerId === "you" || listenerId == null){ const L = (G.dn && G.dn.list || []).filter(d => d.from === p.id).slice(-1)[0]; if(L && (!debt || L.d >= debt.day)) debt = {day:L.d, what:"gave to " + (L.cause || "your cause") + (L.strings && L.strings !== "none" ? " and expects " + L.strings : "")}; } }catch(e){}
  return {grudge, debt};
}
window.onumSpeakerState = function(id, listenerId){
  try{ const p = cndPerson(id); if(!p) return null; if(listenerId == null) listenerId = "you";
    const bt = cndBetween(p, listenerId); let mood = null; try{ const m = moodOf(p); mood = m ? {key:m.key, label:(MOODS[m.key] || {}).label || m.key} : null; }catch(e){}
    let region = null; try{ const rid = p.birthRegion || rgnAssign(p), R = (window.ONUM_REGIONS || {})[rid]; region = R ? {id:rid, name:R.name, accent:R.accent, phrases:(R.phrases || []).slice()} : null; }catch(e){}
    const vc = Object.assign({}, cndVoice(p)); vc.phrases = cndPhrases(p); if(!vc.phrases.length) vc.phrases = (p.cndVoice.phrases || []).slice();
    return {id:p.id, name:p.name, voice:vc, stance:cndStance(p), wants:cndWants(p, listenerId), grudge:bt.grudge, debt:bt.debt,
      memory:(p.cndSaid || []).slice(-5).map(x => ({text:x.t, gist:cndGist(x.t), day:x.d})), mood, region};
  }catch(e){ return null; }
};
/* 20261021a: a short gist of a line, so the generator can paraphrase instead of quoting */
function cndGist(t){
  try{ t = String(t || "").replace(/\s+/g, " ").trim(); if(!t) return "";
    const L = t.toLowerCase(); let topic = null;
    try{ const b = G.bill; if(b && b.title && L.indexOf(String(b.title).toLowerCase().split(" ").slice(0, 2).join(" ")) >= 0) topic = "the " + b.title; }catch(e){}
    if(!topic){ const T = [[/\bvot(e|ed|ing)\b|\bwhip\b|\bfloor\b/, "the vote"], [/\bbill\b|\bact\b|\bamendment\b/, "the bill"], [/\btax|\btrade|\bprice|\bwage|\bjob/, "money and work"], [/\bmoney\b|\bdonat|\bgave\b|\bcheck\b/, "money given"], [/\bfamily|\bwife|\bhusband|\bson\b|\bdaughter|\bkid/, "family"], [/\bparty\b|\bcaucus/, "the party"], [/\bpress\b|\bpaper\b|\bquote/, "the press"], [/\bhome\b|\bdistrict\b|\bcounty\b|\btown\b/, "home"]];
      for(const [re, k] of T) if(re.test(L)){ topic = k; break; } }
    let lean = /\b(no|not|never|won't|can't|against|oppose|wrong)\b/.test(L) ? "against" : /\b(yes|support|back|with you|right|deal|agree)\b/.test(L) ? "for" : null;
    const tone = /!/.test(t) ? "heatedly" : /\?/.test(t) ? "asking" : null;
    let g = topic ? (lean ? "spoke " + lean + " " + topic : "talked about " + topic) : (lean ? "pushed back" : "made a remark");
    if(lean === "for" && !topic) g = "agreed";
    if(tone === "asking") g = topic ? "asked about " + topic : "asked a question"; else if(tone) g += ", " + tone;
    return g; }catch(e){ return ""; }
}
/* what each person actually says, so memory stays real */
function cndRecord(id, text){ try{ const p = cndPerson(id); const t = String(text || "").trim(); if(!p || !t) return; p.cndSaid = p.cndSaid || []; const last = p.cndSaid[p.cndSaid.length - 1]; if(last && last.t === t) return; p.cndSaid.push({d:G.day, t:t.slice(0, 280)}); if(p.cndSaid.length > onumLim(12,"npc")) p.cndSaid.shift(); }catch(e){} }
const CND_PENDING = new Map(); let _cndSeq = 0;
/* onumSpoke(id, text) records a line. With {reqId}, it also answers an onum-speak request and the line is delivered through the normal path. */
window.onumSpoke = function(id, text, o){
  try{ const req = o && o.reqId != null ? CND_PENDING.get(o.reqId) : null;
    if(req && !req.done && String(text || "").trim()){ req.done = true; clearTimeout(req.timer); CND_PENDING.delete(o.reqId); req.deliver(String(text).trim(), true); return true; }
    cndRecord(id, text); return true; }catch(e){ return false; }
};
/* ask for a line; deliver the generated one, or the old line after ~1.5 s */
function cndAsk(speaker, audience, stage, fallback, deliver){
  const reqId = "s" + (++_cndSeq), state = window.onumSpeakerState(speaker.id, audience && audience.id != null ? audience.id : (audience === "room" ? null : audience));
  /* TEMPORARY FALLBACK (remove once onumCandid is always present): without a generator, or with no line back in time, the old line is posted so nothing goes silent */
  if(typeof window.onumCandid !== "function" && !(window.onumCandid && typeof window.onumCandid === "object")){ if(fallback) deliver(fallback, false); return null; }
  const req = {reqId, done:false, deliver, timer:setTimeout(() => { if(req.done) return; req.done = true; CND_PENDING.delete(reqId); if(fallback) deliver(fallback, false); }, 1500)};
  CND_PENDING.set(reqId, req);
