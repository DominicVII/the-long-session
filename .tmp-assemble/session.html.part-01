      if(u.legR.lo) u.legR.lo.rotation.x = -Math.max(0, Math.sin(p.phase - 1.05 + Math.PI)) * A * 1.2;
      if(u.armL && u.armL.up) u.armL.up.rotation.x = -s*A*0.58;
