    addBox(matCol(0x3a2a1c,.7), 0, deckY + 1.15, facadeZ - 0.42, 1.15, 2.3, 0.12, 0, true);
    addBox(matCol(0x8e897d, .92), 0, 0.02, 2.55, w * 0.88, 0.04, 5.0, 0, true);  /* 20261030p plaza: was 0xb7b3a8, glared white */
    const joint = matCol(0x6f6b62, .92);
