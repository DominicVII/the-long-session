    try{ nmDistrict(d); }catch(e){ if(window.console) console.warn("nmDistrict", e); }
    try{ nbStreet(d); }catch(e){}
    try{ ncGrass(d, ROOMS.district.w / 2); }catch(e){}
    /* Street down the middle — leaves the back door to the steps open */
    addBox(tar, 0, 0.02, d / 2, 4.4, 0.04, d - 0.3, 0, true);
    addBox(walk, -5.0, 0.05, d / 2, 5.2, 0.10, d - 0.3, 0, true);
    addBox(walk,  5.0, 0.05, d / 2, 5.2, 0.10, d - 0.3, 0, true);
    addBox(matCol(0x9a9588, .88), -2.75, 0.09, d / 2, 0.18, 0.12, d - 0.3, 0, true);
    addBox(matCol(0x9a9588, .88),  2.75, 0.09, d / 2, 0.18, 0.12, d - 0.3, 0, true);
    /* Lane markings — yellow dashes down the crown, white edges, a crosswalk to the steps */
    const paintY = matCol(0xd4b84a, .88);
