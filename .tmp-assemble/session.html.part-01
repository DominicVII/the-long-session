/* ── your aide: the highest-influence member of your party (or your administration) sits in every meeting and argues your line when you do not ── */
function aideFor(room){
  const y = G.you, pool = []; let k = null; try{ k = heldOffice(); }catch(e){}
  const rec = (o, extra) => pool.push(Object.assign({name:o.name, role:o.role, infl:o.infl != null ? o.infl : 40 + seedOf("inf:" + o.name) % 50, pos:o.pos, party:y.party, temper:o.temper || 40, bg:o.bg, official:true}, extra || {}));
  try{
    if((k === "gov") && (room === "govoffice" || room === "press" || room === "delegation")){ const S = (G.states || []).find(x => x.n === y.state); govStaff(S); Object.keys(S.cab).forEach(kk => rec(S.cab[kk])); }
    else if(k === "pres" && (room === "exec" || room === "press" || room === "delegation")){ const st = presStaff(); Object.keys(st).forEach(kk => rec(st[kk])); }
    else if(k === "senate" && room === "delegation"){ const st = senStaff(); Object.keys(st).forEach(kk => rec(st[kk])); }
    else if(room === "court"){ const st = benchClerks(); Object.keys(st).forEach(kk => rec(st[kk])); }
  }catch(e){}
  if(!pool.length){
    let ms = (G.members || []).filter(m => m && !m.gone && !m.machine && m.kind === "member" && m !== y && m.traits);
    const same = ms.filter(m => m.party === y.party); if(same.length) ms = same;
    ms.forEach(m => pool.push({name:m.name, role:(m.post ? postTitle(m.post) + ", " : "") + "member for " + m.state, infl:m.influence || 20, pos:m.pos, party:m.party, temper:m.traits.temper, bg:m.bg, m}));
  }
  pool.sort((a, b) => b.infl - a.infl); const a = pool[0]; if(a){ a.sn = surname(a.name); } return a || null;
}
/* ═════════════════════════════════════════════════════════
   THE SITUATION ROOM · what a leader may do about a neighbour
   Sanctions, convoys, covert help, a blockade, a strike, the levy, war. What you may do
   alone depends on the form of the state, on what your predecessors settled, and on what
   Congress has authorised. Where it does not allow you, you may ask Congress, or act first and
   answer for it afterwards. Nobody is told what to think of it: states, neighbours, the
   chambers and the courts each read it from where they stand, and the verdict comes later.
   ═════════════════════════════════════════════════════════ */
const WAR_ACTS = [
  {k:"protest",   t:"Lodge a formal protest",             tier:1, hawk:5,  eff:{}, rel:-3,  heat:1,  press:2,  infl:1, d:"Words on paper. Cheap, and noticed."},
  {k:"recall",    t:"Recall our ambassador",              tier:1, hawk:12, eff:{}, rel:-7,  heat:2,  press:4,  infl:2, d:"The chair at their capital goes empty."},
  {k:"alt",       t:"Buy grain from their rivals instead",tier:1, hawk:-4, eff:{grain:-0.5}, rel:-2, heat:0, press:6, bread:-0.04, infl:2, d:"Costs a little warmth with the Reach; costs nothing in blood. A rival is pleased."},
  {k:"sanctions", t:"Impose sanctions on their trade",    tier:2, hawk:25, eff:{trade:1}, rel:-12, heat:3, press:14, bread:0.06, infl:3, d:"Squeezes them, and us: our own bread may rise before theirs does."},
  {k:"escort",    t:"Escort the grain convoys with the fleet", tier:2, hawk:30, eff:{navy:0.6}, rel:-6, heat:4, press:8, bread:-0.05, infl:3, d:"The ships go with the carts. Somebody may fire on them."},
  {k:"covert",    t:"Quietly fund their opposition",      tier:2, hawk:35, eff:{border:0.3}, rel:-3, heat:2, press:10, risk:0.35, infl:4, d:"If it is found out, it is war by other means and everybody will say so."},
  {k:"blockade",  t:"Blockade their ports",               tier:3, hawk:60, eff:{navy:1, trade:1}, rel:-25, heat:10, press:30, bread:0.05, dead:20, infl:6, d:"Cuts them off. Neutral ships will have views."},
  {k:"strike",    t:"Seize the grain depots at the border", tier:3, hawk:70, eff:{border:1}, rel:-30, heat:14, press:34, bread:-0.1, dead:60, infl:7, d:"Takes the bread by force. Men will die and they will say who started it."},
  {k:"mobilize",  t:"Call the levy",                      tier:3, hawk:50, eff:{border:0.7}, rel:-10, heat:8, press:12, unrest:3, infl:5, d:"Readiness up, and every household with a son has an opinion."},
  {k:"war",       t:"Declare war",                        tier:4, hawk:90, eff:{navy:1, trade:1, border:1}, rel:-50, heat:25, press:55, dead:200, infl:10, d:"The whole of the state goes to it. There is no taking it back."}
];
const REALM_INT = {reach:{grain:1, trade:0.8, border:0.8, navy:0.2}, horn:{navy:1, trade:0.7, border:0.3}, pale:{trade:0.5, border:0.6, grain:0.6}, marches:{border:1, trade:0.4, navy:0.1}, isles:{navy:0.8, trade:0.6}, rift:{border:0.5, trade:0.3}};
const REALM_RIVAL = {reach:"pale", pale:"reach", horn:"isles", isles:"horn", marches:"rift", rift:"marches"};
function warLatitude(){
  const form = (G.regime && G.regime.form) || "republic", base = {empire:3, monarchy:3, national:2, conservative:1, commonwealth:1, republic:1, democracy:0}[form] || 1;
  let p = 0; try{ p = powerPrecedents(); }catch(e){} return {form, lat:base + Math.floor(p / 3), base, p};
}
function warAuthorised(a){
  const L = warLatitude(), auth = G.warAuth && G.warAuth.until >= G.day && G.warAuth.tier >= a.tier;
  if(a.tier === 1) return {ok:"yes", why:"Statements and trade diplomacy are yours alone."};
  if(L.lat >= a.tier) return {ok:"yes", why:"As " + (REGIMES[L.form] || {t:"a state"}).t + ", with " + L.p + " settled precedent" + (L.p === 1 ? "" : "s") + " behind you, this is within the executive's own power."};
  if(auth) return {ok:"yes", why:"Congress authorised action of this kind (until day " + G.warAuth.until + ")."};
  return {ok:"vote", why:"Under a " + (REGIMES[L.form] || {t:"state"}).t + " with " + L.p + " precedent" + (L.p === 1 ? "" : "s") + ", this needs Congress. You may ask it, or act first and answer for it."};
}
function warStateBacking(S, a, tk){
  const cr = (function(){ try{ return creedOf(S.creed); }catch(e){ return {pos:{}}; } })(), w = worldEnsure();
  let v = 50 + ((S.lean || 0) * 0.3 + ((cr.pos && cr.pos.def) || 0)) * (a.hawk / 40);
  if(tk === "reach" && a.tier >= 2) v += (w.bread - 1) * 35;
  if(a.eff.trade && (S.ind || 50) > 70) v -= 10;
  if(a.tier >= 3 && (S.unrest || 0) > 55) v -= 8;
  return clamp(Math.round(v), 5, 95);
}
function warRealmView(rk, a, tk){
  const I = REALM_INT[rk] || {}, rel = (G.realmRel || {})[rk] || 0; let s = 0, worst = null, wv = 0;
  Object.keys(a.eff).forEach(e => { const c = (I[e] || 0) * a.eff[e]; s -= c * 0.8; if(c > wv){ wv = c; worst = e; } });
  if(REALM_RIVAL[tk] === rk) s += 0.6; if(REALM_RIVAL[rk] === tk) s += 0.15; s += rel / 250; if(a.tier >= 3) s -= 0.25;
  s = clamp(s, -1, 1); const p = WORLD_POWERS.find(x => x.k === rk), head = realmFolk(rk).find(f => f.id === "head");
  const why = s > 0.25 ? (REALM_RIVAL[tk] === rk ? "has its own account to settle with " + (WORLD_POWERS.find(x => x.k === tk) || {}).t : "reads it as long overdue") : s < -0.25 ? ({navy:"does not want warships near its coast", trade:"lives by the trade this would stop", border:"does not want soldiers moving along a frontier", grain:"would be next on the grain list"}[worst] || "fears where it leads") : "will watch and say nothing yet";
  return {k:rk, t:p.t, s, head:head ? head.name : "", why};
}
function warPlan(a, tk){
  const mem = reactFrac({econ:a.eff.trade ? (a.hawk > 40 ? 10 : 0) : 0, lib:0, def:a.hawk, wel:0}, "war:" + a.k);
  const rows = (G.states || []).map(S => ({n:S.n, b:warStateBacking(S, a, tk), pop:S.pop || 1})), tot = rows.reduce((x, r) => x + r.pop, 0) || 1, nat = rows.reduce((x, r) => x + r.b * r.pop, 0) / tot;
  rows.sort((x, z) => z.b - x.b);
  const views = WORLD_POWERS.filter(p => p.k !== tk).map(p => warRealmView(p.k, a, tk));
  return {congress:mem, states:rows, nat:Math.round(nat), views};
}
function warApply(a, tk, how){
  const y = G.you, w = worldEnsure(), rel = G.realmRel = G.realmRel || {}, tgt = WORLD_POWERS.find(p => p.k === tk), msg = [];
  y.influence = clamp(y.influence - a.infl, 0, 100); spend(60, 6);
  rel[tk] = clamp((rel[tk] || 0) + a.rel, -100, 100); w.heat = clamp((w.heat || 0) + a.heat, 0, 100);
  if(a.bread) w.bread = clamp((w.bread || 1) + a.bread, 0.7, 2.6);
  if(a.dead) w.dead = (w.dead || 0) + a.dead;
  if(a.unrest) (G.states || []).forEach(S => { S.unrest = clamp((S.unrest || 0) + a.unrest, 0, 100); });
  if(a.risk && chance(a.risk)){ rel[tk] = clamp(rel[tk] - 15, -100, 100); w.heat = clamp(w.heat + 6, 0, 100); msg.push("Your hand in it is found out. " + tgt.t + " says so in public."); }
  G.conflict = G.conflict || {k:tk, pressure:0, started:G.day, acts:[], due:G.day + 5 + Math.floor(Math.random() * 3), backing:50};
  if(G.conflict.k !== tk){ G.conflict = {k:tk, pressure:0, started:G.day, acts:[], due:G.day + 5 + Math.floor(Math.random() * 3), backing:50}; }
  G.conflict.pressure += a.press; G.conflict.acts.push({k:a.k, d:G.day, how}); G.conflict.due = Math.max(G.conflict.due, G.day + 3);
  if(a.k === "war") G.conflict.war = true;
  return msg.join(" ");
}
function warCard(tk){
  const y = G.you, w = worldEnsure(), foe = WORLD_POWERS.find(p => p.k === (tk || w.foe || "reach")) || WORLD_POWERS[0], rel = (G.realmRel || {})[foe.k] || 0, L = warLatitude();
  const D = DLG[foe.k] || {}, folk = realmFolk(foe.k), head = folk.find(f => f.id === "head");
  const picked = {};
  const hdr = '<p class="muted" style="font-size:13px">' + pcEsc(cap(foe.t)) + ' is ' + realmRelLabel(rel) + ' towards the Union (' + Math.round(rel) + '); heat ' + Math.round(w.heat || 0) + '. Bread stands at ' + (w.bread || 1).toFixed(2) + (w.ration ? ', and the northern towns are rationed' : '') + '. ' + pcEsc(cap((WORLD_WARS.find(x => x.k === w.war) || {t:""}).t)) + '.</p>' +
    '<p class="muted" style="font-size:12px"><b>The law as it stands.</b> The Union is a ' + pcEsc((REGIMES[L.form] || {t:"state"}).t) + '; ' + L.p + ' power precedent' + (L.p === 1 ? '' : 's') + (L.p === 1 ? ' has' : ' have') + ' been set, so the executive may act alone up to ' + (L.lat >= 4 ? 'a declaration of war' : L.lat === 3 ? 'force at the border and the ports' : L.lat === 2 ? 'sanctions, convoys and covert help' : L.lat === 1 ? 'sanctions and convoys' : 'statements and trade diplomacy') + '. ' + (G.warAuth && G.warAuth.until >= G.day ? 'Congress has authorised action up to tier ' + G.warAuth.tier + ' until day ' + G.warAuth.until + '.' : 'Congress has authorised nothing.') + '</p>' +
    (G.conflict && G.conflict.k === foe.k ? '<p class="muted" style="font-size:12px"><b>Under way.</b> Pressure ' + Math.round(G.conflict.pressure) + ' against ' + pcEsc(foe.t) + '; ' + G.conflict.acts.length + ' measure' + (G.conflict.acts.length === 1 ? '' : 's') + ' taken. The verdict comes on about day ' + G.conflict.due + '.</p>' : '');
  const rows = WAR_ACTS.map((a, i) => { const au = warAuthorised(a), pl = warPlan(a, foe.k), top = pl.states.slice(0, 2), low = pl.states.slice(-2).reverse(), v = pl.views.slice().sort((x, z) => z.s - x.s);
    const btns = au.ok === "yes" ? '<button type="button" class="btn" data-wa="' + i + ':do">Do it</button>' : '<button type="button" class="btn btn--ghost" data-wa="' + i + ':ask">Ask Congress (two days)</button><button type="button" class="btn btn--ghost" data-wa="' + i + ':pre">Act anyway, and answer for it</button>';
    return '<details style="margin:8px 0;border-left:3px solid var(--line-soft);padding:4px 10px"><summary><b>' + pcEsc(a.t) + '</b> <span class="muted">tier ' + a.tier + ' · ' + (au.ok === "yes" ? 'yours to do' : 'needs Congress') + '</span></summary>' +
      '<p style="margin:4px 0;font-size:13px">' + pcEsc(a.d) + '</p><p class="muted" style="font-size:12px">' + pcEsc(au.why) + '</p>' +
      '<p style="font-size:12px;margin:4px 0"><b>How it reads at home.</b> The House: about ' + Math.round(pl.congress * 100) + '% read it favourably. The country: ' + pl.nat + '% back it. ' + pcEsc(top[0].n) + ' (' + top[0].b + '%) and ' + pcEsc(top[1].n) + ' (' + top[1].b + '%) back it most; ' + pcEsc(low[0].n) + ' (' + low[0].b + '%) and ' + pcEsc(low[1].n) + ' (' + low[1].b + '%) least.</p>' +
      '<p style="font-size:12px;margin:4px 0"><b>How the neighbours read it.</b> ' + v.map(x => pcEsc(x.t) + (x.head ? ' (' + pcEsc(x.head) + ')' : '') + ' ' + (x.s > 0.25 ? 'leans with you: ' : x.s < -0.25 ? 'objects: ' : 'is waiting: ') + pcEsc(x.why)).join('; ') + '.</p>' +
      '<div class="card__actions" style="flex-wrap:wrap">' + btns + '</div></details>'; }).join("");
  govCardOpen("The situation room", "The " + cap(foe.t.replace(/^the /, "")) + " question", "", hdr + '<p class="muted" style="font-size:12px">' + pcEsc(head ? head.name : "Their head of government") + ' wants ' + pcEsc(D.ask || foe.want) + ' and will not accept ' + pcEsc(D.red || "being pushed") + '. Nothing here is a button that wins.</p>' + rows + '<div id="waSay" class="dream" style="white-space:pre-line"></div>', null);
  card.querySelectorAll("[data-wa]").forEach(b => b.addEventListener("click", () => { const [i, how] = b.getAttribute("data-wa").split(":"), a = WAR_ACTS[+i]; if(picked.done) return;
    if(y.influence < a.infl){ el("waSay").textContent = "You are short of influence for this (" + a.infl + ")."; return; }
    picked.done = 1; let out = "";
    if(how === "ask"){ y.influence = clamp(y.influence - 1, 0, 100); reactEmit("warVote", {k:foe.k, act:a.k}, 2); out = "You send the request to the House and Senate. They will answer in two days."; }
    else { const extra = warApply(a, foe.k, how); out = (how === "pre" ? "You act first. " : "") + a.t + ". " + (extra ? extra + " " : "") + "The verdict will not be in for days.";
      reactEmit(how === "pre" ? "warPreempt" : "warNote", {k:foe.k, act:a.k}, 1); try{ feed("The President: " + a.t.toLowerCase() + " (" + foe.t + ").", a.tier >= 3 ? "bad" : ""); }catch(e){} }
    el("waSay").textContent = out; card.querySelectorAll("[data-wa]").forEach(z => z.disabled = true); }));
  return null;
}
function warReact(e){
  const d = e.data, a = WAR_ACTS.find(x => x.k === d.act), y = G.you, tgt = WORLD_POWERS.find(p => p.k === d.k); if(!a || !tgt) return;
  G.realmRel = G.realmRel || {};
  const pl = warPlan(a, d.k), sp = reactHolder("speaker"), mn = reactHolder("minority"), arm = reactHolder("armed");
  const head = realmFolk(d.k).find(f => f.id === "head");
  if(e.kind === "warVote"){
    const ok = chance(clamp((pl.congress - 0.35) * 1.8, 0.05, 0.95));
    if(ok){ G.warAuth = {tier:a.tier, until:G.day + 30, k:d.k}; reactSay(sp, "Congress has authorised action against " + tgt.t + " up to tier " + a.tier + " (" + a.t.toLowerCase() + "). The authorisation runs thirty days. It is yours to use or not."); }
    else reactSay(mn || sp, "Congress has declined to authorise action against " + tgt.t + " (" + a.t.toLowerCase() + "). " + (pl.congress < 0.4 ? "The peace members found the numbers." : "It fell short by a handful, and the whips are counting who stayed away.")); return; }
  if(e.kind === "warPreempt"){
    const fine = pl.congress > 0.6, L = warLatitude();
    if(fine){ reactSay(sp, "Congress votes a retroactive authorisation for the President's " + a.t.toLowerCase() + " against " + tgt.t + ". It does not like being asked afterwards, and says so."); G.warAuth = {tier:a.tier, until:G.day + 30, k:d.k}; }
    else { y.standing = clamp(y.standing - 3, 0, 100); G.cases = G.cases || []; G.cases.push({t:"the House v. the President (the " + tgt.t.replace(/^the /, "") + " action)", state:"", day:G.day, voted:[]}); reactSay(mn || sp, "The House censures the President for acting against " + tgt.t + " (" + a.t.toLowerCase() + ") without authority, and the question goes to the bench."); }
    try{ setPrecedent("acted against " + tgt.t + " before Congress had voted", "that the executive may " + a.t.toLowerCase() + " first and answer afterwards", true); }catch(e2){}
    warReact({kind:"warNote", data:d}); return; }
  /* warNote: the states, the neighbours and the target each answer from where they stand */
  const hi = pl.states[0], lo = pl.states[pl.states.length - 1];
  reactSay(null, hi.n + " (" + hi.b + "%) backs \u201c" + a.t.toLowerCase() + "\u201d; " + lo.n + " (" + lo.b + "%) does not. " + (pl.nat > 60 ? "The country leans with you." : pl.nat < 42 ? "The country does not." : "The country is divided."), true);
  pl.views.sort((x, z) => Math.abs(z.s) - Math.abs(x.s)).slice(0, 2).forEach(v => { reactSay(null, cap(v.t) + (v.head ? " (" + v.head + ")" : "") + (v.s > 0.25 ? " backs you quietly: it " : v.s < -0.25 ? " objects: it " : " is waiting: it ") + v.why + ".", true); G.realmRel[v.k] = clamp(((G.realmRel || {})[v.k] || 0) + Math.round(v.s * 6), -100, 100); });
  reactSay(null, cap(tgt.t) + (head ? " (" + head.name + ")" : "") + " answers \u201c" + a.t.toLowerCase() + "\u201d: " + (a.tier >= 3 ? "it calls it an act of war and mobilises its frontier guard." : a.tier === 2 ? "it protests, and quietly raises the price of what it still sells." : "it lodges a protest of its own and says it will remember.")); 
  if(arm && a.tier >= 3) reactSay(arm, "Armed Services Chair " + surname(arm.name) + ": the committee will want the plan, the cost and the exit before another measure is taken.", false);
  (G.states || []).forEach(S => { const b = warStateBacking(S, a, d.k); S.unrest = clamp((S.unrest || 0) + (b < 40 ? 2 : b > 65 ? -1 : 0), 0, 100); });
  y.approval = clamp(y.approval + Math.round((pl.nat - 50) / 12), 0, 100);
}
function warDay(){
  const C = G.conflict; if(!C) return;
  const w = worldEnsure(), tgt = WORLD_POWERS.find(p => p.k === C.k); if(!tgt) { G.conflict = null; return; }
  w.heat = clamp(w.heat + (C.war ? 1.2 : 0.3), 0, 100); if(C.war) w.dead = (w.dead || 0) + 8 + Math.floor(Math.random() * 20);
  if(G.day < C.due) return;
  const y = G.you, rel = G.realmRel = G.realmRel || {}, last = WAR_ACTS.find(a => a.k === (C.acts[C.acts.length - 1] || {}).k) || WAR_ACTS[0], pl = warPlan(last, C.k);
  const allies = pl.views.filter(v => v.s > 0.25).length - pl.views.filter(v => v.s < -0.25).length;
  const resist = 28 + Math.max(0, (rel[C.k] || 0) < -40 ? 6 : 0), score = C.pressure + pl.nat * 0.35 + allies * 4 + (Math.random() - 0.5) * 26 - resist;
  const sp = reactHolder("speaker"), mn = reactHolder("minority");
  let result;
  if(score > 18){ result = "concession"; w.bread = clamp(w.bread - 0.2, 0.7, 2.6); w.heat = clamp(w.heat - 15, 0, 100); w.ration = false; y.approval = clamp(y.approval + 4, 0, 100); y.standing = clamp(y.standing + 3, 0, 100); rel[C.k] = clamp((rel[C.k] || 0) + 4, -100, 100);
    reactSay(sp, cap(tgt.t) + " gives way: the grain moves, the price of bread falls, and the pressure was enough. " + (C.war ? "The war ends on terms." : "Nobody had to fire a shot."), true); }
  else if(score > 2){ result = "stalemate"; w.heat = clamp(w.heat + 3, 0, 100); y.approval = clamp(y.approval - 2, 0, 100);
    reactSay(mn || sp, "Nothing is decided with " + tgt.t + ". The measures taken have cost something and settled little, and the bread has not got cheaper.", true); }
  else { result = "backfire"; w.bread = clamp(w.bread + 0.15, 0.7, 2.6); w.dead = (w.dead || 0) + 30; y.approval = clamp(y.approval - 5, 0, 100); y.standing = clamp(y.standing - 3, 0, 100); (G.states || []).forEach(S => { if(warStateBacking(S, last, C.k) < 50) S.unrest = clamp((S.unrest || 0) + 3, 0, 100); });
    reactSay(mn || sp, cap(tgt.t) + " did not give way, and the pressure came back on us: bread is dearer, there are dead to explain, and the states that never backed it are saying so.", true); }
  C.result = result; C.until = G.day; G.conflictLog = (G.conflictLog || []).concat([{k:C.k, d:G.day, result, acts:C.acts.length}]).slice(-6);
  G.conflict = null;
}
/* ── the same question from a Governor's chair and from the Congress's: what each may do about a neighbour, and who answers ── */
const GOV_ACTS = [
  {k:"letter",  t:"Write to the President and Congress about the bread", tier:1, hawk:0, eff:{}, rel:0, heat:0, press:2, infl:1, fed:true, d:"Puts it on record, and on their desks. Cheap, and sometimes answered."},
  {k:"mission", t:"Send a state trade mission to the Pale and the Marches", tier:1, hawk:-5, eff:{grain:-0.5}, rel:-2, heat:0, press:6, bread:-0.03, infl:2, d:"Buys grain somewhere else. A rival of the Reach is pleased."},
  {k:"reserve", t:"Open the state grain reserve", tier:1, hawk:0, eff:{}, rel:0, heat:0, press:3, unrestS:-3, indS:-1, infl:1, d:"Calms the counties now and empties the cellar for later."},
  {k:"ceiling", t:"Cap the price of bread in the state", tier:2, hawk:5, eff:{}, rel:0, heat:0, press:4, unrestS:-4, indS:-2, infl:2, d:"Quiet streets now; the bakers and the carters will tell you what it costs."},
  {k:"boycott", t:"Refuse Reach goods at state ports and in state contracts", tier:2, hawk:25, eff:{trade:1}, rel:-6, heat:2, press:8, infl:3, fed:true, d:"The Union holds the trade power. Expect a letter from the Union's attorney."},
  {k:"escort",  t:"Send the state militia with the grain carts", tier:2, hawk:30, eff:{border:0.4}, rel:-4, heat:3, press:7, bread:-0.03, infl:3, d:"Your own men on the road. The Reach will notice who they answer to."},
  {k:"compact", t:"Sign a grain compact with a neighbour, state to state", tier:3, hawk:40, eff:{grain:-0.6, trade:0.5}, rel:-8, heat:3, press:12, bread:-0.06, infl:5, fed:true, d:"A treaty in all but name. The Union reserves treaties to itself."},
  {k:"militia", t:"Call out the state militia to the border depots", tier:3, hawk:65, eff:{border:1}, rel:-20, heat:10, press:18, unrestS:3, dead:15, infl:6, fed:true, d:"The state's soldiers at the frontier. Every household with a son has a view."}
];
function govWarLat(S){
  const U = warLatitude(), prec = (S && S.warPrec) || 0;
  return {lat:Math.max(0, 1 + Math.floor(prec / 2) - (U.lat >= 3 ? 1 : 0) + (S && (S.lean || 0) > 30 ? 0 : 0)), prec, U};
}
function govWarAuthorised(a, S){
  const L = govWarLat(S), c = S && S.warConsent && S.warConsent.until >= G.day && S.warConsent.tier >= a.tier, lg = S && S.warLeg && S.warLeg.until >= G.day && S.warLeg.tier >= a.tier;
  if(a.tier === 1) return {ok:"yes", why:"Within a governor's own power."};
  if(L.lat >= a.tier && !a.fed) return {ok:"yes", why:"The state's own power, with " + L.prec + " precedent" + (L.prec === 1 ? "" : "s") + " of its own behind you."};
  if(a.fed && !(c)) return {ok:"vote", why:"This reaches the Union's reserved power over trade, war or treaties. You may ask the President for consent, or act first and let the Union's attorney answer."};
  if(!lg && a.tier >= 2) return {ok:"vote", why:"The legislature has not backed this. You may ask it (two days), or act first."};
  return {ok:"yes", why:"The legislature and the Union have both allowed it." };
}
function govWarPlan(a, S, tk){
  const bs = warStateBacking(S, a, tk), leg = clamp((bs - 40) / 40, 0.05, 0.95), ex = G.exec && !G.exec.you ? G.exec : null;
  const fed = !a.fed ? 0.8 : ex ? clamp(0.5 + alignment(ex, {pos:{econ:0, lib:0, def:a.hawk, wel:0}, title:a.k}) / 120, 0.1, 0.9) : 0.5;
  const rows = (G.states || []).filter(x => x.n !== S.n).map(x => ({n:x.n, b:warStateBacking(x, a, tk)})).sort((p, q) => q.b - p.b);
  const views = WORLD_POWERS.filter(p => p.k !== tk).map(p => warRealmView(p.k, a, tk));
  return {leg, fed, home:bs, rows, views};
}
function govWarApply(a, S, tk, how){
  const y = G.you, w = worldEnsure(), rel = G.realmRel = G.realmRel || {}, tgt = WORLD_POWERS.find(p => p.k === tk), msg = [];
  y.influence = clamp(y.influence - a.infl, 0, 100); spend(60, 5);
  rel[tk] = clamp((rel[tk] || 0) + a.rel, -100, 100); w.heat = clamp((w.heat || 0) + a.heat * 0.5, 0, 100);
  if(a.bread) w.bread = clamp((w.bread || 1) + a.bread * 0.4, 0.7, 2.6);
  if(a.dead) w.dead = (w.dead || 0) + a.dead;
  S.unrest = clamp((S.unrest || 0) + (a.unrestS || 0), 0, 100); S.ind = clamp((S.ind || 0) + (a.indS || 0), 0, 100);
  S.conflict = S.conflict && S.conflict.k === tk ? S.conflict : {k:tk, pressure:0, started:G.day, acts:[], due:G.day + 6};
  S.conflict.pressure += a.press; S.conflict.acts.push({k:a.k, d:G.day, how}); S.conflict.due = Math.max(S.conflict.due, G.day + 3);
  if(how === "pre" || (a.fed && how !== "consent")){ S.warPrec = (S.warPrec || 0) + 1; }
  return msg.join(" ");
}
function govWarCard(tk){
  const y = G.you, S = (G.states || []).find(x => x.n === y.state); if(!S){ return null; }
  const w = worldEnsure(), foe = WORLD_POWERS.find(p => p.k === (tk || w.foe || "reach")) || WORLD_POWERS[0], rel = (G.realmRel || {})[foe.k] || 0, L = govWarLat(S), picked = {};
  const D = DLG[foe.k] || {}, head = realmFolk(foe.k).find(f => f.id === "head");
  const hdr = '<p class="muted" style="font-size:13px">' + pcEsc(cap(foe.t)) + ' is ' + realmRelLabel(rel) + ' towards the Union (' + Math.round(rel) + '). Bread stands at ' + (w.bread || 1).toFixed(2) + ' across the Union; in ' + pcEsc(S.n) + ' unrest is ' + Math.round(S.unrest || 0) + ' and industry ' + Math.round(S.ind || 0) + '.</p>' +
    '<p class="muted" style="font-size:12px"><b>What a governor may do.</b> You may act on your own for the state’s own business (' + L.prec + ' precedent' + (L.prec === 1 ? '' : 's') + ' of acting first stand to ' + pcEsc(S.n) + '). Anything that reaches trade with a foreign country, treaties or the Union’s soldiers belongs to the Union: you can ask the President for consent, ask your own legislature, or act first and let the Union’s attorney answer. ' + (S.warConsent && S.warConsent.until >= G.day ? 'The President has consented up to tier ' + S.warConsent.tier + ' until day ' + S.warConsent.until + '. ' : '') + (S.warLeg && S.warLeg.until >= G.day ? 'Your legislature has backed action up to tier ' + S.warLeg.tier + '.' : '') + '</p>' +
    (S.conflict && S.conflict.k === foe.k ? '<p class="muted" style="font-size:12px"><b>Under way.</b> Pressure ' + Math.round(S.conflict.pressure) + '; the verdict comes on about day ' + S.conflict.due + '.</p>' : '');
  const rows = GOV_ACTS.map((a, i) => { const au = govWarAuthorised(a, S), pl = govWarPlan(a, S, foe.k), v = pl.views.slice().sort((x, z) => z.s - x.s);
    const btns = au.ok === "yes" ? '<button type="button" class="btn" data-ga="' + i + ':do">Do it</button>' : (a.fed ? '<button type="button" class="btn btn--ghost" data-ga="' + i + ':consent">Ask the President to consent</button>' : '<button type="button" class="btn btn--ghost" data-ga="' + i + ':leg">Ask the legislature (two days)</button>') + '<button type="button" class="btn btn--ghost" data-ga="' + i + ':pre">Act first, and answer for it</button>';
    return '<details style="margin:8px 0;border-left:3px solid var(--line-soft);padding:4px 10px"><summary><b>' + pcEsc(a.t) + '</b> <span class="muted">tier ' + a.tier + ' · ' + (au.ok === "yes" ? 'yours to do' : 'needs backing') + '</span></summary>' +
      '<p style="margin:4px 0;font-size:13px">' + pcEsc(a.d) + '</p><p class="muted" style="font-size:12px">' + pcEsc(au.why) + '</p>' +
      '<p style="font-size:12px;margin:4px 0"><b>How it reads.</b> At home, ' + pl.home + '% of ' + pcEsc(S.n) + ' back it, and about ' + Math.round(pl.leg * 100) + '% of your legislature. ' + (a.fed ? 'The Union is ' + (pl.fed > 0.6 ? 'likely to let it stand' : pl.fed < 0.4 ? 'likely to sue' : 'undecided') + '. ' : '') + 'Elsewhere, ' + pcEsc(pl.rows[0].n) + ' (' + pl.rows[0].b + '%) would back it and ' + pcEsc(pl.rows[pl.rows.length - 1].n) + ' (' + pl.rows[pl.rows.length - 1].b + '%) would not.</p>' +
      '<p style="font-size:12px;margin:4px 0"><b>The neighbours.</b> ' + v.map(x => pcEsc(x.t) + ' ' + (x.s > 0.25 ? 'leans with you: ' : x.s < -0.25 ? 'objects: ' : 'is waiting: ') + pcEsc(x.why)).join('; ') + '.</p><div class="card__actions" style="flex-wrap:wrap">' + btns + '</div></details>'; }).join("");
  govCardOpen("The state’s answer", "The " + cap(foe.t.replace(/^the /, "")) + " question, from " + S.n, "", hdr + '<p class="muted" style="font-size:12px">' + pcEsc(head ? head.name : "Their head of government") + ' wants ' + pcEsc(D.ask || foe.want) + '. A governor’s measures are smaller than a President’s, and so is what they can settle.</p>' + rows + '<div id="gwSay" class="dream" style="white-space:pre-line"></div>', null);
  card.querySelectorAll("[data-ga]").forEach(b => b.addEventListener("click", () => { const [i, how] = b.getAttribute("data-ga").split(":"), a = GOV_ACTS[+i]; if(picked.done) return;
    if(y.influence < a.infl){ el("gwSay").textContent = "You are short of influence for this (" + a.infl + ")."; return; }
    picked.done = 1; let out = "";
    if(how === "consent"){ y.influence = clamp(y.influence - 1, 0, 100); reactEmit("gwConsent", {k:foe.k, act:a.k, state:S.n}, 2); out = "You write to the White House asking consent. They will answer in two days."; }
    else if(how === "leg"){ y.influence = clamp(y.influence - 1, 0, 100); reactEmit("gwLeg", {k:foe.k, act:a.k, state:S.n}, 2); out = "You send it to the legislature. They will vote in two days."; }
    else { const extra = govWarApply(a, S, foe.k, how); out = (how === "pre" ? "You act first. " : "") + a.t + ". " + (extra ? extra + " " : "") + "The verdict will not be in for days."; reactEmit(how === "pre" || (a.fed && how === "do") ? "gwPre" : "gwNote", {k:foe.k, act:a.k, state:S.n}, 1); try{ feed("Governor " + surname(y.name) + ": " + a.t.toLowerCase() + ".", a.tier >= 3 ? "bad" : ""); }catch(e){} }
    el("gwSay").textContent = out; card.querySelectorAll("[data-ga]").forEach(z => z.disabled = true); }));
  return null;
}
function govWarReact(e){
  const d = e.data, a = GOV_ACTS.find(x => x.k === d.act), y = G.you, S = (G.states || []).find(x => x.n === d.state), tgt = WORLD_POWERS.find(p => p.k === d.k); if(!a || !S || !tgt) return;
  G.realmRel = G.realmRel || {}; const pl = govWarPlan(a, S, d.k), ex = G.exec && !G.exec.you ? G.exec : null, sp = reactHolder("speaker"), rep = (G.members || []).find(m => m && !m.gone && m.state === d.state && m.kind === "member");
  if(e.kind === "gwConsent"){
    const ok = chance(pl.fed);
    if(ok){ S.warConsent = {tier:a.tier, until:G.day + 30}; reactSay(null, "The President consents to " + d.state + "'s \u201c" + a.t.toLowerCase() + "\u201d, for thirty days and on the Union's own terms. The consent is yours to use or not."); }
    else reactSay(null, "The White House declines to consent to " + d.state + "'s \u201c" + a.t.toLowerCase() + "\u201d. " + (ex ? "The President says foreign affairs are the Union's business." : "")); return; }
  if(e.kind === "gwLeg"){
    const ok = chance(pl.leg);
    if(ok){ S.warLeg = {tier:a.tier, until:G.day + 30}; reactSay(rep, "The " + d.state + " legislature backs the governor on \u201c" + a.t.toLowerCase() + "\u201d, for thirty days. The members from the bread counties spoke longest."); }
    else reactSay(rep, "The " + d.state + " legislature refuses the governor on \u201c" + a.t.toLowerCase() + "\u201d. " + (pl.home < 45 ? "The peace members and the mill towns found the numbers." : "It fell short, and the whips are counting who stayed away.")); return; }
  if(e.kind === "gwPre"){
    const suit = a.fed && chance(1 - pl.fed + 0.15);
    if(suit){ G.cases = G.cases || []; G.cases.push({t:"the Union v. " + d.state + " (the " + tgt.t.replace(/^the /, "") + " measures)", state:d.state, day:G.day, voted:[]}); y.standing = clamp(y.standing - 2, 0, 100); reactSay(null, "The Union's attorney files against " + d.state + " over \u201c" + a.t.toLowerCase() + "\u201d. The state has made foreign policy, and the bench will say whether it may."); }
    else reactSay(null, "The White House says nothing about " + d.state + "'s \u201c" + a.t.toLowerCase() + "\u201d, which is a kind of answer."); }
  reactSay(null, cap(tgt.t) + " " + (a.tier >= 3 ? "protests to the Union that a state has put soldiers on its frontier." : a.tier === 2 ? "notes the state's measures and quietly raises what it charges." : "takes note of " + d.state + "."));
  pl.views.sort((x, z) => Math.abs(z.s) - Math.abs(x.s)).slice(0, 2).forEach(v => { reactSay(null, cap(v.t) + (v.s > 0.25 ? " leans with " + d.state + ": it " : v.s < -0.25 ? " objects: it " : " is waiting: it ") + v.why + ".", true); G.realmRel[v.k] = clamp((G.realmRel[v.k] || 0) + Math.round(v.s * 4), -100, 100); });
  if(rep) reactSay(rep, "Representative " + surname(rep.name) + ": " + d.state + " has taken its own course on the " + tgt.t.replace(/^the /, "") + ", and Congress will hear about it.", false);
  y.approval = clamp(y.approval + Math.round((pl.home - 50) / 10), 0, 100); S.unrest = clamp(S.unrest + (pl.home < 40 ? 2 : pl.home > 65 ? -1 : 0), 0, 100);
}
function govWarDay(){
  (G.states || []).forEach(S => { const C = S.conflict; if(!C || G.day < C.due) return;
    const tgt = WORLD_POWERS.find(p => p.k === C.k), y = G.you, w = worldEnsure(), mine = G.you && S.n === G.you.state; if(!tgt){ S.conflict = null; return; }
    const last = GOV_ACTS.find(a => a.k === (C.acts[C.acts.length - 1] || {}).k) || GOV_ACTS[0], pl = govWarPlan(last, S, C.k), allies = pl.views.filter(v => v.s > 0.25).length - pl.views.filter(v => v.s < -0.25).length;
    const score = C.pressure + pl.home * 0.3 + allies * 4 + (Math.random() - 0.5) * 24 - 22; let res;
    if(score > 12){ res = "good"; S.unrest = clamp(S.unrest - 3, 0, 100); S.ind = clamp(S.ind + 1, 0, 100); if(mine){ y.approval = clamp(y.approval + 4, 0, 100); y.standing = clamp(y.standing + 2, 0, 100); } reactSay(null, S.n + "'s measures work: grain moves again, bread is cheaper in the counties, and the governor takes the credit.", true); }
    else if(score > 0){ res = "mixed"; if(mine) y.approval = clamp(y.approval - 1, 0, 100); reactSay(null, "Nothing is settled in " + S.n + ". The measures cost something and bought little.", true); }
    else { res = "bad"; S.unrest = clamp(S.unrest + 3, 0, 100); S.ind = clamp(S.ind - 2, 0, 100); if(mine){ y.approval = clamp(y.approval - 4, 0, 100); y.standing = clamp(y.standing - 2, 0, 100); } reactSay(null, S.n + "'s measures backfire: bread is dearer, the mills are idle, and the opposition says it told you so.", true); }
    S.conflictLog = (S.conflictLog || []).concat([{d:G.day, res}]).slice(-4); S.conflict = null; });
}
/* ── the legislature's levers: authorise, restrain, investigate, legislate ── */
function legWarCard(tk){
  const y = G.you, w = worldEnsure(), foe = WORLD_POWERS.find(p => p.k === (tk || w.foe || "reach")) || WORLD_POWERS[0], L = warLatitude(), k = roleKey(), picked = {};
  const pw = (G.history || []).filter(h => h.power).length;
  const opts = [
    {k:"auth", t:"Move an authorisation", d:"Authorise action against " + foe.t + " up to a tier for thirty days, so the President need not act first.", tiers:true},
    {k:"restrain", t:"Move a bill restraining the executive", d:"Cut back what the President may do alone: the last precedent of acting first is struck from the record (there are " + pw + ").", off:pw < 1},
    {k:"hearing", t:"Call hearings on the " + foe.t.replace(/^the /, "") + " question", d:"Put the Secretaries under oath. It changes nobody's mind, and everyone's file."},
    {k:"sanctions", t:"Pass sanctions by statute", d:"Congress's own sanctions on " + foe.t + ", independent of the executive. Needs a majority."}
  ];
  const mk = o => '<div style="margin:8px 0;padding:6px 10px;border-left:3px solid var(--line-soft)"><b>' + pcEsc(o.t) + '</b><div class="muted" style="font-size:12px">' + pcEsc(o.d) + '</div><div class="card__actions" style="flex-wrap:wrap">' + (o.tiers ? [1, 2, 3, 4].map(t => '<button type="button" class="btn btn--ghost" data-lw="' + o.k + ':' + t + '">Up to tier ' + t + '</button>').join("") : '<button type="button" class="btn btn--ghost" data-lw="' + o.k + ':0"' + (o.off ? ' disabled' : '') + '>Do it</button>') + '</div></div>';
  govCardOpen("Congress's levers", "The " + cap(foe.t.replace(/^the /, "")) + " question, from the " + (k === "senate" ? "Senate" : "House"), "", '<p class="muted" style="font-size:12px">The executive may act alone up to tier ' + L.lat + ' under the ' + pcEsc((REGIMES[L.form] || {t:"state"}).t) + ', with ' + L.p + ' precedent' + (L.p === 1 ? '' : 's') + '. ' + (G.warAuth && G.warAuth.until >= G.day ? 'Congress has authorised up to tier ' + G.warAuth.tier + ' until day ' + G.warAuth.until + '.' : 'Congress has authorised nothing.') + ' Whatever you move, others will vote on it by their own lights.</p>' + opts.map(mk).join("") + '<div id="lwSay" class="dream"></div>', null);
  card.querySelectorAll("[data-lw]").forEach(b => b.addEventListener("click", () => { if(picked.done) return; picked.done = 1; const [o, t] = b.getAttribute("data-lw").split(":"); spend(40, 4); y.influence = clamp(y.influence - 2, 0, 100);
    if(o === "auth") reactEmit("lwVote", {k:foe.k, tier:+t, kind:"auth"}, 2); else if(o === "sanctions") reactEmit("lwVote", {k:foe.k, tier:2, kind:"sanctions"}, 2); else if(o === "restrain") reactEmit("lwVote", {k:foe.k, tier:0, kind:"restrain"}, 2);
    else { y.standing = clamp(y.standing + 1, 0, 100); reactEmit("lwVote", {k:foe.k, tier:0, kind:"hearing"}, 1); }
    el("lwSay").textContent = "Moved. The vote or the hearing is in " + (o === "hearing" ? "a day" : "two days") + "."; card.querySelectorAll("[data-lw]").forEach(z => z.disabled = true); }));
  return null;
}
function legWarReact(e){
  const d = e.data, tgt = WORLD_POWERS.find(p => p.k === d.k), y = G.you, sp = reactHolder("speaker"), mn = reactHolder("minority"); if(!tgt) return;
  const a = WAR_ACTS.find(x => x.tier === Math.max(1, d.tier)) || WAR_ACTS[0], pl = warPlan(a, d.k);
  if(d.kind === "hearing"){ reactSay(mn || sp, "The committee hears the Secretaries on " + tgt.t + ". The executive's plan is laid on the record; nobody is persuaded and everybody takes notes.", true); y.influence = clamp(y.influence + 2, 0, 100); return; }
  if(d.kind === "restrain"){ const ok = chance(clamp(1 - pl.congress + 0.1, 0.1, 0.8)); if(ok){ const H = (G.history || []).filter(h => h.power); if(H.length) H[H.length - 1].power = false; reactSay(sp, "Congress passes the war powers bill: the last precedent of the executive acting first is struck from the record, and the President must ask next time."); } else reactSay(mn || sp, "The war powers bill fails. The executive keeps what it has taken."); return; }
  const ok = chance(clamp((pl.congress - 0.3) * 1.8, 0.05, 0.95));
  if(d.kind === "sanctions"){ if(ok){ const act = WAR_ACTS.find(x => x.k === "sanctions"); warApply(Object.assign({}, act, {infl:0}), d.k, "statute"); reactSay(sp, "Congress passes sanctions on " + tgt.t + " by statute. They bind the executive and the courts, and the bread price will tell us what they cost."); } else reactSay(mn || sp, "The sanctions bill on " + tgt.t + " fails in the Senate."); return; }
  if(ok){ G.warAuth = {tier:d.tier, until:G.day + 30, k:d.k}; reactSay(sp, "Congress authorises action against " + tgt.t + " up to tier " + d.tier + " for thirty days. The President may now act without asking."); }
  else reactSay(mn || sp, "Congress declines to authorise action against " + tgt.t + " up to tier " + d.tier + ".");
}
function warRoleOpen(tk){
  let k = null; try{ k = roleKey(); }catch(e){}
  if(k === "pres") return warCard(tk); if(k === "gov") return govWarCard(tk);
  if(k === "senate" || k === "leader" || k === "chair") return legWarCard(tk);
  note("A seat in the House has no lever here; ask your party's leadership.", false); return null;
}
function warRoleCan(){ let k = null; try{ k = roleKey(); }catch(e){} return k === "pres" || k === "gov" || k === "senate" || k === "leader" || k === "chair"; }
/* ═════════════════════════════════════════════════════════
   KIN · the families nobody sees
   Everyone has people, or has none. They are never in the room, but they are why a
   member votes with the mill and not with the party, why a candidate cannot run this
   year, why a surname carries a seat, and why somebody goes home early. Generated
   offhand and kept: spouse, children, parents, siblings, in-laws, a trade in the family,
   a dynasty or none, money old or short, and the strains between them. It applies to
   you exactly as it does to anyone.
   ═════════════════════════════════════════════════════════ */
const KIN_JOBS = {
  "mill hand":{pos:{econ:-10, wel:12}, inc:18}, nurse:{pos:{wel:20, econ:-8}, inc:24}, teacher:{pos:{wel:18, lib:6}, inc:22}, farmer:{pos:{econ:-8, def:-4, wel:6}, inc:20},
  clerk:{pos:{econ:4}, inc:20}, mechanic:{pos:{econ:4, wel:4}, inc:24}, lawyer:{pos:{econ:14, lib:12}, inc:46}, shopkeeper:{pos:{econ:22, wel:-10}, inc:30},
  pastor:{pos:{lib:-12, wel:10}, inc:16}, engineer:{pos:{econ:10, def:8}, inc:38}, soldier:{pos:{def:30, lib:-10}, inc:22}, "ship's pilot":{pos:{def:10, econ:8}, inc:34},
  "union steward":{pos:{econ:-26, wel:20}, inc:22}, homemaker:{pos:{wel:6}, inc:0}, "mill owner":{pos:{econ:30, wel:-18}, inc:70}, doctor:{pos:{wel:22, lib:6}, inc:52}, student:{pos:{}, inc:0}
};
const KIN_PARTY = ["FED", "COM", "IND", null];
const KIN_OFFICES = ["Representative", "Senator", "Governor", "judge of the state bench", "county sheriff", "mayor"];
const KIN_FIRST = {
  M:["Aaron","Abel","Adrian","Alasdair","Amos","Andre","Anton","Arlo","Augustin","Barnaby","Bram","Callum","Caleb","Casimir","Cyrus","Daniel","Desmond","Diego","Dirk","Edmund","Elias","Emeka","Emil","Ewan","Felix","Finn","Gideon","Gerrit","Hamish","Hector","Hendrik","Hugo","Isaac","Jasper","Joost","Kasper","Lachlan","Leif","Lucien","Magnus","Marcus","Matthias","Nathaniel","Niall","Oliver","Osric","Owen","Pieter","Rafael","Rufus","Samuel","Silas","Soren","Tobias","Tomas","Vincent","Willem","Yusuf","Zachary"],
  F:["Agnes","Amara","Anneliese","Astrid","Beatrix","Brigid","Catriona","Celestine","Clara","Cordelia","Delia","Delphine","Eleanor","Elena","Elsa","Esther","Eunice","Faith","Femke","Fiona","Freya","Greta","Hannah","Heleen","Imke","Ines","Ingrid","Isabel","Johanna","Juno","Katrijn","Liesbeth","Lotte","Maeve","Margaret","Marisol","Marta","Mercy","Mirembe","Moira","Nadia","Nell","Noor","Ottoline","Priya","Prudence","Rosa","Saskia","Siobhan","Solveig","Thea","Verity","Wren","Zainab","Zoe","Abigail","Beatrice","Dorothea","Edith","Harriet"]
};
function kinArt(o){ return o === "Governor" ? "Governor" : /^[AEIOU]/i.test(o) ? "an " + o : "a " + o; }
function kinPro(sex){ return sex === "F" ? {he:"she", him:"her", his:"her"} : {he:"he", him:"him", his:"his"}; }
function kinSexOf(p){
  if(p.ksex) return p.ksex; if(p.sex === "M" || p.sex === "F"){ p.ksex = p.sex; return p.ksex; }
  const fn = String(p.name || "").split(" ")[0]; let sx = KIN_FIRST.M.indexOf(fn) >= 0 ? "M" : KIN_FIRST.F.indexOf(fn) >= 0 ? "F" : null;
  if(!sx){ const MX = /^(Baptiste|Etienne|Pierre|Jesse|Elie|Noe|Luke|Mathieu|Tobiah|Jonah|Josue|Ezekiel|Elijah|Micah|Isaiah|Joshua|Levi|Zebulon|Ambrose|Barnabas)$/; sx = MX.test(fn) ? "M" : (/(a|e|i|ie|ine|elle|beth|eth|ith|yn|ey|ee|ia)$/i.test(fn) && !/^(Jose|Jean|Rene|Andre|Luke)$/.test(fn)) ? "F" : "M"; }
  p.ksex = sx; return sx;
}
function kinAge(p){ if(p.age) return p.age; const r = seedOf("age:" + (p.id != null ? p.id : p.name)); return p === G.you ? 38 : p.kind === "member" ? 30 + (p.terms || 1) * 3 + (r % 14) : 20 + (r % 55); }
function kinName(p, last, sex){
  let ln = last; if(!ln){ let n = ""; try{ n = wallSafeMint(() => newName(p.state || (G.you && G.you.state))); }catch(e){} ln = String(n || "Doe").split(" ").slice(1).join(" ") || "Doe"; }
  const pool = KIN_FIRST[sex || (Math.random() < 0.5 ? "M" : "F")]; return pool[Math.floor(Math.random() * pool.length)] + " " + ln;
}
function kinEnsure(p){
  if(p.kin && p.kin.v === 2) return p.kin;
  if(p !== G.you && !(G.fam && G.fam.p && p.id != null && G.fam.p[p.id])){ try{ famEnsure(); }catch(e){} }
  const r = rng(seedOf("kin:" + (p.id != null ? p.id : p.name) + ":" + (G.country || ""))), age = kinAge(p), t = purseTr ? purseTr(p) : {loyalty:50}, sn = surname(p.name || "Doe"), sx = kinSexOf(p), opp = sx === "M" ? "F" : "M";
  const pickJob = () => { const ks = Object.keys(KIN_JOBS); return ks[Math.floor(r() * ks.length)]; };
  const K = {v:2, sex:sx, age, spouse:null, kids:[], parents:[], siblings:[], inlaws:null, dynasty:null, wealth:null, events:[], made:G.day || 0};
  const m = r(), marry = clamp(0.35 + (age - 22) / 70 + ((t.loyalty || 50) - 50) / 300, 0.1, 0.8);
  K.marital = age < 24 ? "single" : m < marry ? "married" : m < marry + 0.1 ? "divorced" : m < marry + 0.15 && age > 55 ? "widowed" : "single";
