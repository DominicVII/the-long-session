    });
  }
  function tidy(s){
    s = s.replace(/\s+/g, " ").replace(/\s+([.,?!:])/g, "$1").replace(/^\s*[,.]\s*/, "").trim();
    s = s.replace(/\ba ([aeiouAEIOU])/g, "an $1").replace(/\bA ([aeiouAEIOU])/g, "An $1");
    s = s.replace(/\b(\w+) \1\b/gi, "$1");
    s = s.replace(/([.?!]) ([a-z])/g, (a, p, l) => p + " " + l.toUpperCase());
    return cap(s);
  }
  function markov(intent){
    const c = CH[intent]; if(!c) return null;
    let a = "^", b = "^"; const out = [];
    for(let i = 0; i < 30; i++){
      const nx = c[a + " " + b]; if(!nx) break;
      const t = pickFrom(nx); if(t === "$") break;
      out.push(t); a = b; b = t;
    }
    if(out.length < 6 || out.length > 26) return null;
    const s = out.join(" ");
