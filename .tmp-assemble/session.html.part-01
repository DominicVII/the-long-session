ertAdjacentHTML("afterbegin", '<label style="display:block;padding:6px 0;font-size:14px"><input type="checkbox" id="vhRb"' + (VH.rb ? " checked" : "") + '> Read messages back aloud</label>'); }catch(e){} }, 800);

/* ══ engine: time-sliced background systems, distance-tiered minds, compressed checked saves, log caps, perf overlay ══ */
/* ── 1. a cooperative scheduler: background systems share at most 4 ms of each frame ── */
const ENG = {budget:4, jobs:[], q:[], cost:{}, frames:0, simMs:0, last:performance.now()};
function engJob(name, everyMs, fn){ ENG.jobs.push({name, every:everyMs, fn, next:performance.now() + Math.random() * everyMs}); }
function engDefer(name, fn){ ENG.q.push({name, fn}); }
function engCost(name, ms){ const c = ENG.cost[name] || (ENG.cost[name] = {ms:0, n:0, max:0}); c.ms = c.ms * 0.95 + ms * 0.05; c.n++; if(ms > c.max) c.max = ms; else c.max *= 0.999; }
function engRun(){ try{ engAdapt(); }catch(e){}
  const t0 = performance.now(); let used = 0;
  /* due periodic jobs, nearest-due first */
  const due = ENG.jobs.filter(j => j.next <= t0).sort((a, b) => a.next - b.next);
  for(const j of due){ if(used >= ENG.budget) break; const s = performance.now(); try{ j.fn(); }catch(e){} const d = performance.now() - s; used += d; engCost(j.name, d); j.next = s + j.every; }
  /* deferred one-shot work (day rollover pieces) */
  while(ENG.q.length && used < ENG.budget){ const w = ENG.q.shift(); const s = performance.now(); try{ w.fn(); }catch(e){} const d = performance.now() - s; used += d; engCost(w.name, d); }
  ENG.simMs = ENG.simMs * 0.9 + used * 0.1; ENG.frames++;
}
(function pump(){ try{ engRun(); }catch(e){} if(typeof requestAnimationFrame === "function" && !document.hidden) requestAnimationFrame(pump); else setTimeout(pump, 250); })();
document.addEventListener("visibilitychange", () => { if(!document.hidden) try{ requestAnimationFrame(() => engRun()); }catch(e){} });
try{ if(typeof ohTick === "function"){ const real = ohTick; ohTick = function(){ engDefer("officeholders", real); }; } }catch(e){}
try{ if(typeof apTick === "function"){ const real = apTick; apTick = function(){ engDefer("approaches", real); }; } }catch(e){}
try{ if(typeof cvScan === "function"){ const real = cvScan; cvScan = function(){ engDefer("conversations", real); }; } }catch(e){}
/* day rollover: the heavy mind/state/party passes run one per frame instead of all in one frame */
try{ if(typeof scDay === "function"){ const real = scDay; scDay = function(){ const a = arguments; engDefer("statecraft", () => real.apply(null, a)); }; } }catch(e){}
try{ if(typeof cpDay === "function"){ const real = cpDay; cpDay = function(){ const a = arguments; engDefer("counterparts", () => real.apply(null, a)); }; } }catch(e){}
try{ if(typeof phDay === "function"){ const real = phDay; phDay = function(){ const a = arguments; engDefer("parties", () => real.apply(null, a)); }; } }catch(e){}
/* ── 2. minds near you think more often ── */
function engTier(p){ try{ if(!p || p.x == null || p.room !== G.room) return 3; const d = Math.hypot(p.x - cam.x, p.z - cam.z); return d < 6 ? 0 : d < 14 ? 1 : 2; }catch(e){ return 3; } }
window.onumSimTier = engTier;
engJob("minds", 500, () => {
  if(!G || !G.members) return;
  ENG.mi = (ENG.mi || 0) + 1;
  const M = window.ONUM_MINDS = window.ONUM_MINDS || {};
  const ev = (typeof everyone === "function") ? everyone() : G.members;
  let n = 0;
  const _mN = ev.length, _m0 = _mN ? (ENG.mStart || 0) % _mN : 0, _mT = performance.now(), _mMax = onumLimN("mindsPerTick", 12), _mMs = onumLimN("tickMs", 3);
  for(let _q = 0; _q < _mN; _q++){ const p = ev[(_m0 + _q) % _mN]; if(!p || p.gone) continue; const t = engTier(p), every = [1, 4, 12, 40][t];
    if((ENG.mi + idNum(String(p.id))) % every) continue;
    try{ if(typeof onumMindOf === "function") M[p.id] = Object.assign(M[p.id] || {}, onumMindOf(p.id) || {}, {tier:t}); }catch(e){}
    if(++n > _mMax || performance.now() - _mT > _mMs){ ENG.mStart = (_m0 + _q + 1) % _mN; break; } }
});
/* ── 3. logs never grow without end ── */
function engTrim(){
  try{ onumGovern(); }catch(e){} const cap = (a, n, k, nf) => { n = onumLim(n, k || "hist"); if(Array.isArray(a) && a.length > n){ if(nf) a.length = n; else a.splice(0, a.length - n); } };
  try{ cap(G.moments, 60); cap(G.feedLog, 300); cap(G.mail, 220, "cap", 1); cap(G.news, 200); cap(G.log, 400); cap(G.journal, 300, "cap", 1); cap(G.lastActs, 120, "hist", 1); }catch(e){}
  try{ if(G.vox && G.vox.posts) cap(G.vox.posts, 60, "hist", 1); }catch(e){}
  try{ const D = G.dm; if(D && D.th) Object.keys(D.th).forEach(k => cap(D.th[k], 60)); if(D && D.leaks) cap(D.leaks, 80); }catch(e){}
  try{ (G.members || []).forEach(m => { cap(m.mem, 80, "npc", 1); cap(m.chat, 20, "npc"); cap(m.journal, 40, "npc"); cap(m.memory, 80, "npc"); }); }catch(e){}
  try{ if(typeof CV !== "undefined") cap(CV.th, 150); }catch(e){}
  try{ if(G.sc){ cap(G.sc.log, 200); cap(G.sc.crises, 80); } }catch(e){}
  try{ if(G.ph) Object.values(G.ph.p).forEach(P => { cap(P.snaps, 60); cap(P.notes, 40); cap(P.votes, 40); }); }catch(e){}
  try{ if(G.dist){ cap(G.dist.gossip, 120); cap(G.dist.ledger, 400); } }catch(e){}
}
engJob("trim", 30000, engTrim);
/* ── 4. saves: compressed, checksummed, mirrored to IndexedDB ── */
function engHash(s){ let h = 2166136261; for(let i = 0; i < s.length; i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return (h >>> 0).toString(36) + ":" + s.length.toString(36); }
/* LZW into UTF-16 code units (15 bits each, so the string stays valid in localStorage); no dependencies */
function engPack(str){
  str = str.replace(/[\u0001\u0100-\uffff]/g, ch => "\u0001" + ch.charCodeAt(0).toString(16).padStart(4, "0"));
  let dict = new Map(), next = 256, w = "", buf = 0, bits = 0; const out = [], W = 16;
  const emit = c => { buf = buf * 65536 + c; bits += W; while(bits >= 15){ bits -= 15; const v = Math.floor(buf / Math.pow(2, bits)) & 0x7fff; out.push(String.fromCharCode(v + 0x20)); buf = buf % Math.pow(2, bits); } };
  for(let i = 0; i < str.length; i++){
    const c = str.charAt(i), wc = w + c;
    if(!w){ w = c; continue; }
    if(dict.has(wc)){ w = wc; continue; }
    emit(w.length === 1 ? w.charCodeAt(0) : dict.get(w));
    dict.set(wc, next++);
    if(next >= 65535){ dict = new Map(); next = 256; emit(65535); }
    w = c;
  }
  if(w) emit(w.length === 1 ? w.charCodeAt(0) : dict.get(w));
  if(bits > 0){ out.push(String.fromCharCode(((buf * Math.pow(2, 15 - bits)) & 0x7fff) + 0x20)); }
  return out.length + "~" + out.join("");
}
function engUnpack(s0){
  const k = s0.indexOf("~"); const n = +s0.slice(0, k), s = s0.slice(k + 1);
  let dict = [], next = 256, buf = 0, bits = 0, i = 0, prev = null; const out = [], W = 16;
  const read = () => { while(bits < W){ if(i >= s.length) return -1; buf = buf * 32768 + ((s.charCodeAt(i++) - 0x20) & 0x7fff); bits += 15; } bits -= W; const p2 = Math.pow(2, bits); const c = Math.floor(buf / p2); buf = buf % p2; return c; };
  const total = Math.floor(n * 15 / W);
  for(let r = 0; r < total; r++){
    const c = read(); if(c < 0) break;
    if(c === 65535){ dict = []; next = 256; prev = null; continue; }
    let e; if(c < 256) e = String.fromCharCode(c); else if(dict[c] !== undefined) e = dict[c]; else if(c === next && prev !== null) e = prev + prev[0]; else break;
    out.push(e);
    if(prev !== null){ dict[next++] = prev + e[0]; }
    prev = e;
  }
  return out.join("").replace(/\u0001([0-9a-f]{4})/g, (m, h) => String.fromCharCode(parseInt(h, 16)));
}
/* the wrapped form is "ONZ1|<hash>|<packed>"; anything else is the old plain JSON */
function engWrap(json){ try{ const z = engPack(json); if(engUnpack(z) !== json) return json; return "ONZ1|" + engHash(json) + "|" + z; }catch(e){ return json; } }
function engOpen(raw){ if(!raw || raw.slice(0, 5) !== "ONZ1|") return raw; const a = raw.indexOf("|", 5); const h = raw.slice(5, a); const j = engUnpack(raw.slice(a + 1)); if(engHash(j) !== h) return null; return j; }
/* 20261110bv JUPITER: IndexedDB open+get is async. The title card used to run on
   the same tick, before get("career") returned, so a late/large career kept only
   in IDB looked like "no save" and the only button was New career. Wait for the
   get, refresh the title when it arrives, and keep a small localStorage meta so
   Continue can name the sitting even before the blob is in memory. */
const ENG_IDB = {db:null, cache:null, ready:false, waiters:[]};
function engIdbNotify(){
  ENG_IDB.ready = true;
  const ws = ENG_IDB.waiters.splice(0);
  for(let i = 0; i < ws.length; i++){ try{ ws[i](); }catch(e){} }
  try{ document.dispatchEvent(new CustomEvent("onum-careers-ready", {detail: (window.ONUM_CAREERS && window.ONUM_CAREERS.peek) ? window.ONUM_CAREERS.peek() : null})); }catch(e){}
}
function engIdbWhenReady(fn, ms){
  if(ENG_IDB.ready){ try{ fn(); }catch(e){} return; }
  let done = false;
  const once = () => { if(done) return; done = true; try{ fn(); }catch(e){} };
  ENG_IDB.waiters.push(once);
  setTimeout(once, ms == null ? 2000 : ms);
}
function engIdbPutAt(key, raw, cb){
  try{
    if(!ENG_IDB.db){ if(cb) cb(false); return false; }
    if(key === "career") ENG_IDB.cache = raw;
    const req = ENG_IDB.db.transaction("s", "readwrite").objectStore("s").put(raw, key);
    req.onsuccess = () => { if(cb) cb(true); };
    req.onerror = () => { if(cb) cb(false); };
    return true;
  }catch(e){ if(cb) cb(false); return false; }
}
function engIdbGetAt(key, cb){
  try{
    if(!ENG_IDB.db){ if(cb) cb(null); return; }
    const g = ENG_IDB.db.transaction("s").objectStore("s").get(key);
    g.onsuccess = () => { if(cb) cb(g.result == null ? null : g.result); };
    g.onerror = () => { if(cb) cb(null); };
  }catch(e){ if(cb) cb(null); }
}
function engIdbOnCareer(raw){
  ENG_IDB.cache = raw || null;
  try{ if(raw && typeof svWriteCareerMeta === "function") svWriteCareerMeta(raw); }catch(e){}
  try{ if(typeof careerIndexMergeIdb === "function") careerIndexMergeIdb(); }catch(e){}
  engIdbNotify();
  try{
    if(document.body.classList.contains("boot-menu") && !G._booting && !G.make && !(G.running && G.you)){
      if(typeof opening === "function") opening();
    }
  }catch(e){}
}
try{
  if(typeof indexedDB === "undefined"){ engIdbNotify(); }
  else {
    const rq = indexedDB.open("onum-saves", 1);
    rq.onupgradeneeded = () => { try{ rq.result.createObjectStore("s"); }catch(e){} };
    rq.onerror = () => { try{ engIdbNotify(); }catch(e){} };
    rq.onsuccess = () => {
      ENG_IDB.db = rq.result;
      try{
        const g = ENG_IDB.db.transaction("s").objectStore("s").get("career");
        g.onsuccess = () => { engIdbOnCareer(g.result || null); };
        g.onerror = () => { engIdbOnCareer(null); };
      }catch(e){ engIdbOnCareer(null); }
    };
  }
}catch(e){ try{ engIdbNotify(); }catch(e2){} }
function engIdbPut(raw){ try{ if(!ENG_IDB.db) return; ENG_IDB.db.transaction("s", "readwrite").objectStore("s").put(raw, "career"); ENG_IDB.cache = raw; try{ if(typeof svWriteCareerMeta === "function") svWriteCareerMeta(raw); }catch(e2){} }catch(e){} }
(function(){
  const baseParse = parseSaveRaw;
  parseSaveRaw = function(raw){ try{ return baseParse(engOpen(raw)); }catch(e){ return null; } };
  const baseWrite = writeSaveKey;
  writeSaveKey = function(key, raw){ const t = performance.now(); const w = (typeof raw === "string" && raw.length > 20000 && raw.charAt(0) === "{") ? engWrap(raw) : raw; const ok = baseWrite(key, w); if(key === SAVE_KEY && ok){ engCost("save-write", performance.now() - t); ENG.lastSave = {plain:raw.length, stored:w.length, at:Date.now()}; engIdbPut(w); try{ svWriteCareerMeta(raw); }catch(e2){} } return ok; };
  const basePick = pickNewestSave;
  pickNewestSave = function(){ let b = basePick(); try{ const d = ENG_IDB.cache ? parseSaveRaw(ENG_IDB.cache) : null; if(d && (!b || isBetterSave(d, b))) b = d; }catch(e){} return b; };
})();
/* autosave on a steady beat, never mid-walk (queueSave already refuses then) */
engJob("autosave", 90000, () => { try{ if(G && G.running && !G.over) queueSave(false); }catch(e){} });
addEventListener("pagehide", () => { try{ save(false, true); }catch(e){} });
/* ── 5. what each system costs, on screen (F9 or ?perf=1) ── */
function engOverlay(on){
  let w = document.getElementById("engPerf");
  if(!on){ if(w) w.remove(); return; }
  if(!w){ w = document.createElement("div"); w.id = "engPerf"; w.style.cssText = "position:fixed;right:8px;top:60px;z-index:99999;background:rgba(10,12,16,.92);color:#d6f5d6;font:12px/1.35 ui-monospace,monospace;padding:8px 10px;border:1px solid #2e3a2e;border-radius:6px;pointer-events:none;white-space:pre;min-width:220px"; document.body.appendChild(w); }
  const R = (window.ONUM_PROF && ONUM_PROF.ring) || [];
  const last = R.slice(-60), avg = {};
  last.forEach(f => Object.keys(f).forEach(k => { if(typeof f[k] === "number") avg[k] = (avg[k] || 0) + f[k] / last.length; }));
  const fps = (function(){ try{ return Math.round(_hzEma / (_stride || 1)); }catch(e){ return 0; } })();
  let t = "fps " + fps + "   frame " + (avg.total || 0).toFixed(1) + " ms\n";
  ["tick","crowd","lighting","shadow","render","hud","feed","sync","furnish","ui"].forEach(k => { if(avg[k] != null) t += k.padEnd(10) + (avg[k] || 0).toFixed(2) + " ms\n"; });
  t += "-- background (budget " + ENG.budget + " ms) " + ENG.simMs.toFixed(2) + " ms\n";
  Object.keys(ENG.cost).sort((a, b) => ENG.cost[b].ms - ENG.cost[a].ms).slice(0, 10).forEach(k => { const c = ENG.cost[k]; t += k.padEnd(14) + c.ms.toFixed(2) + " (max " + c.max.toFixed(1) + ")\n"; });
  try{ t += onumLimLine() + "\n"; }catch(e){}
  if(ENG.lastSave) t += "save " + Math.round(ENG.lastSave.plain / 1024) + " KB -> " + Math.round(ENG.lastSave.stored * 2 / 1024) + " KB stored\n";
  try{ if(performance.memory) t += "heap " + Math.round(performance.memory.usedJSHeapSize / 1048576) + " MB\n"; }catch(e){}
  w.textContent = t;
}
ENG.overlay = /(?:\?|&)perf=1/.test(location.search || "");
addEventListener("keydown", e => { if(e.key === "F9"){ ENG.overlay = !ENG.overlay; engOverlay(ENG.overlay); e.preventDefault(); } });
setInterval(() => { if(ENG.overlay) engOverlay(true); }, 500);
window.onumEngine = ENG;

/* ══ research: minds form theories and run experiments in tiers (MARS ruleset); the frontier never closes; works unlock economy and civic projects ══ */
const RS_Q = [
  {id:"mech", t:1, f:"mechanics", q:"Do forces add like arrows?", works:[{k:"engine", n:"a steam engine", kind:"machine"}]},
  {id:"thermo", t:1, f:"thermodynamics", q:"Where does the heat in a working engine go?", needs:["mech"], works:[{k:"generator", n:"a dynamo generator", kind:"machine"}]},
  {id:"em", t:1, f:"electromagnetism", q:"Are electricity and magnetism one thing?", works:[{k:"grid", n:"a district power grid", kind:"building"}]},
  {id:"qm", t:2, f:"quantum mechanics", q:"Why does light come in lumps?", needs:["thermo", "em"], works:[{k:"semi", n:"a semiconductor junction", kind:"tool"}, {k:"laser", n:"a laser", kind:"machine"}]},
  {id:"ent", t:3, f:"entanglement", q:"Can two particles share one state across a room?", needs:["qm"], works:[{k:"qcomm", n:"a secure quantum line", kind:"tool"}, {k:"qsense", n:"a quantum sensor", kind:"tool"}]},
  {id:"deco", t:3, f:"decoherence", q:"Why do big things stop behaving like small ones?", needs:["qm"], works:[{k:"qpc", n:"an early quantum computer", kind:"machine"}]},
  {id:"qgrav", t:4, f:"quantum gravity", q:"Is space itself made of pieces?", needs:["ent", "deco"], works:[{k:"tqg", n:"a theory of quantum gravity", kind:"theory"}]},
  {id:"dark", t:4, f:"cosmology", q:"What holds the galaxies together?", needs:["em", "qm"], works:[{k:"tdark", n:"a theory of the missing mass", kind:"theory"}]},
  {id:"mind", t:4, f:"the mind", q:"Can a machine know that it knows?", needs:["deco"], works:[{k:"tmind", n:"a theory of machine awareness", kind:"theory"}]}
];
const RS_FAIL = {1:[0.10, 0.20], 2:[0.25, 0.40], 3:[0.40, 0.60], 4:[0.70, 0.90]};
const RS_FRONT = ["the arrow of time", "why the constants are what they are", "matter that should not exist", "information inside a black hole", "life from chemistry", "a fifth force", "the shape of the universe", "memory in water", "the limit of computation", "whether the vacuum decays"];
const RS_WORDS = {
  ok:["It held. Three times, it held.", "I think we have it. Do not tell anyone yet.", "The numbers came back the way the theory said they would."],
  fail:["Nothing. The apparatus leaks, or I do.", "It failed again, but now I know one more way it fails.", "Wrong. Beautifully wrong, but wrong."],
  null:["Inconclusive. The data will bear any reading you like.", "Half the room says yes and half says no, and both have a paper."],
  drift:["I have been thinking about something else entirely.", "I want to try a different question for a while.", "I am bored of heat. Light is more interesting."],
  tired:["I need a week away from the bench.", "I keep making the same mistake. I should sleep."]
};
function rsEnsure(){
  if(G.rs && G.rs.v === 1) return G.rs;
  G.rs = {v:1, qs:{}, works:[], theories:[], ppl:{}, front:0, fund:1, n:0, log:[]};
  RS_Q.forEach(q => { G.rs.qs[q.id] = {id:q.id, st:"open", prog:0, boost:0, tries:0}; });
  return G.rs;
}
function rsQ(id){ return RS_Q.find(q => q.id === id) || (G.rs.extra || []).find(q => q.id === id); }
function rsAllQ(){ return RS_Q.concat(rsEnsure().extra || []); }
function rsOpen(){ const R = rsEnsure(); return rsAllQ().filter(q => { const s = R.qs[q.id]; return s && s.st !== "done" && (q.needs || []).every(n => R.qs[n] && R.qs[n].st === "done"); }); }
function rsFail(q){ if(q.t <= 4){ const r = RS_FAIL[q.t]; return r[0] + (seedOf("rf:" + q.id) % 100) / 100 * (r[1] - r[0]); } return 1 - 0.1 * Math.pow(0.7, q.t - 4); }
/* the researchers: people in the Republic with a mind for it, chosen once; their skill, energy and interest are their own */
function rsPeople(){
  const R = rsEnsure(); let all = []; try{ all = everyone().filter(p => p && !p.gone && p !== G.you); }catch(e){ all = (G.members || []).slice(); }
  if(Object.keys(R.ppl).length < 6){ all.filter(p => (seedOf("sci:" + p.id) % 9) === 0).slice(0, 8).forEach(p => { if(!R.ppl[p.id]) R.ppl[p.id] = {id:p.id, sk:30 + seedOf("sk:" + p.id) % 45, fat:0, mot:55 + seedOf("mo:" + p.id) % 40, on:null, idle:0, done:0}; });
    if(!Object.keys(R.ppl).length) all.slice(0, 4).forEach(p => { R.ppl[p.id] = {id:p.id, sk:40, fat:0, mot:60, on:null, idle:0, done:0}; }); }
  return Object.values(R.ppl).map(r => ({r, p:all.find(x => x.id === r.id)})).filter(x => x.p);
}
function rsSay(p, kind){
  const line = pick(RS_WORDS[kind]); try{ if(p.room === G.room){ p.say = line; p.sayT = 4; speakAt(p, line); } }catch(e){}
  try{ remember(p, line, 2, false); }catch(e){} return line;
}
function rsLine(t, big){ const R = rsEnsure(); R.log.unshift({d:G.day, t}); if(R.log.length > onumLim(40,"hist")) R.log.length = onumLim(40,"hist"); try{ lLog(t, "science"); }catch(e){} if(big){ try{ feed(t, "world"); }catch(e){} } }
function rsWork(w, q, inv, stage){
  const R = rsEnsure(); let x = R.works.find(o => o.id === w.k);
  if(!x){ x = {id:w.k, name:w.n, kind:w.kind, inventor:inv ? inv.name : "unknown", inventorId:inv ? inv.id : null, stage:"idea", day:G.day, desc:"From work on " + q.f + ": " + q.q}; R.works.push(x); }
  if(stage && stage !== x.stage){ x.stage = stage; x.day = G.day; if(stage === "done") rsUnlock(x); }
  rsPublish(x); return x;
}
/* what a finished work changes: machines and grids lift what the Republic makes; tools and theories lift what it knows and how it argues */
function rsUnlock(x){
  const R = rsEnsure(); R.unlocks = R.unlocks || []; if(R.unlocks.includes(x.id)) return; R.unlocks.push(x.id);
  try{ if(G.money && x.kind !== "theory") G.money.index = clamp(G.money.index + (x.kind === "building" ? 3 : 2), 42, 190); }catch(e){}
  try{ if(G.you) G.you.approval = clamp(G.you.approval + 0.5, 0, 100); }catch(e){}
  try{ const E = G.eng; if(E && x.kind !== "building") E.talent = Math.min(100, E.talent + 0.6); }catch(e){}
  rsLine(cap(x.name) + " is finished, built by " + x.inventor + ". " + ({machine:"Workshops are already asking for one.", building:"A civic project can now be put to the Assembly.", tool:"The universities want it first.", vehicle:"It is on the roads by spring.", theory:"It is in the journals and the debates have started."}[x.kind] || ""), true);
}
function rsPublish(x){
  const R = rsEnsure(); window.ONUM_WORKS = R.works.map(w => ({id:w.id, name:w.name, kind:w.kind, inventor:w.inventor, stage:w.stage, day:w.day, desc:w.desc}));
  window.ONUM_UNLOCKS = (R.unlocks || []).slice();
  try{ window.dispatchEvent(new CustomEvent("onum-work", {detail:x ? {id:x.id, stage:x.stage, day:x.day} : null})); }catch(e){}
}
/* past the fourth tier the frontier writes its own questions: each settled one raises more, harder, but never certain to fail */
function rsFrontier(from){
  const R = rsEnsure(); R.extra = R.extra || []; R.front++;
  const t = Math.max(5, (from.t || 4) + (from.t >= 5 ? 1 : 1)), topic = RS_FRONT[(R.front * 7 + seedOf(from.id)) % RS_FRONT.length], id = "f" + R.front;
  const nth = R.extra.filter(x => x.f === topic).length, roman = nth === 0 ? "" : nth < 5 ? [" (II)", " (III)", " (IV)", " (V)"][nth - 1] : " (" + (nth + 1) + ")";
  const q = {id, t, f:topic, q:"An open question, raised by the work on " + from.f + ": " + topic + ".", needs:[from.id], works:[{k:"w" + id, n:"a theory of " + topic + roman, kind:"theory"}]};
  R.extra.push(q); R.qs[id] = {id, st:"open", prog:0, boost:0, tries:0}; return q;
}
function rsOverturn(q){
  const R = rsEnsure(), old = R.theories.filter(x => !x.over && x.id !== q.id && x.t >= 2); if(!old.length || !chance(0.15)) return;
  const o = pick(old); o.over = G.day; rsLine("The new work on " + q.f + " overturns the old account of " + o.f + ". Some of the textbooks are wrong.", true);
  const w = R.works.find(x => x.id === (rsQ(o.id).works[0] || {}).k && x.kind === "theory"); if(w){ w.desc += " (overturned on day " + G.day + ")"; rsPublish(w); }
}
function rsDay(){
  const R = rsEnsure(); if(!G.you) return;
  try{ R.fund = clamp(((G.money && G.money.index) || 100) / 100 + (R.gift || 0) / 400, 0.5, 2.2); R.gift = (R.gift || 0) * 0.97; }catch(e){}
  const open = rsOpen(); if(!open.length) return;
  rsPeople().forEach(({r, p}) => {
    /* free will: rest when tired, drift when bored, and the skill fades when unused */
    r.fat = Math.max(0, r.fat - 4);
    if(r.fat > 70 || r.mot < 20){ r.fat = Math.max(0, r.fat - 18); r.mot = Math.min(95, r.mot + 6); r.idle++; r.sk = Math.max(5, r.sk - 0.05); if(chance(0.2)) rsSay(p, "tired"); return; }
    if(!r.on || !open.find(q => q.id === r.on) || chance(0.06)){ const was = r.on; r.on = pick(open).id; if(was && was !== r.on && chance(0.4)) rsSay(p, "drift"); }
    if(!chance(0.18 + r.mot / 600)){ r.idle++; if(r.idle > 10) r.sk = Math.max(5, r.sk - 0.08); return; }
    const q = rsQ(r.on), s = R.qs[q.id]; if(!q || !s || s.st === "done") return; s.tries++; r.idle = 0; r.fat += 9 + q.t * 2; r.sk = Math.min(99, r.sk + 0.2);
    const prior = Object.values(R.qs).filter(x => x.st === "done").length;
    let ok = (1 - rsFail(q)) * (0.55 + r.sk / 110) * (1 - r.fat / 220) * (0.7 + R.fund * 0.3) * (1 + Math.min(prior, 12) * 0.02) * (1 + s.boost);
    ok = clamp(ok, 0.003, 0.97); const roll = Math.random();
    if(q.t === 4 && roll < ok && chance(0.3)){ s.boost += 0.05; rsSay(p, "null"); if(chance(0.4)) rsLine(p.name + "'s results on " + q.f + " are inconclusive. Two papers, two answers.", false); return; }
    if(roll < ok){
      s.prog += (0.10 + r.sk / 900) / (1 + (q.t - 1) * 1.0); s.boost = 0; r.sk = Math.min(99, r.sk + 1.5); r.mot = Math.min(99, r.mot + 8); rsSay(p, "ok");
      q.works.forEach(w => rsWork(w, q, p, s.prog >= 1 ? "done" : s.prog >= 0.5 ? "prototype" : "idea"));
      if(s.prog >= 1){ s.st = "done"; s.day = G.day; r.done++; R.n++; R.theories.push({id:q.id, f:q.f, t:q.t, by:p.name, d:G.day});
        rsLine(p.name + " has settled a question in " + q.f + " (tier " + q.t + "): " + q.q, true); try{ ripple(p, 1, "I settled the question of " + q.f + ".", 6, true); }catch(e){}
        if(q.t >= 4){ rsFrontier(q); if(chance(0.3)) rsFrontier(q); rsOverturn(q); } }
      else rsLine(p.name + " has a result in " + q.f + ". " + (s.prog >= 0.5 ? "There is a working prototype." : "It is an idea on paper for now."), false);
    } else { s.boost = Math.min(0.9, s.boost + 0.12); r.mot = Math.max(0, r.mot - 5); if(chance(0.35)) rsSay(p, "fail"); }
  });
}
window.onumResearch = function(){ const R = rsEnsure(); return {open:rsOpen().map(q => ({id:q.id, tier:q.t, field:q.f, question:q.q, failChance:+rsFail(q).toFixed(2), tries:R.qs[q.id].tries, progress:+R.qs[q.id].prog.toFixed(2)})), settled:R.theories.slice(), researchers:rsPeople().map(({r, p}) => ({name:p.name, skill:Math.round(r.sk), fatigue:Math.round(r.fat), motivation:Math.round(r.mot), on:r.on})), funding:+R.fund.toFixed(2), log:R.log.slice(0, 10)}; };
{ const _rsEng = engDay; engDay = function(){ const r = _rsEng.apply(this, arguments); try{ rsDay(); }catch(e){ console.warn("research", e); } return r; }; }
setTimeout(() => { try{ if(G && G.rs) rsPublish(null); else window.ONUM_WORKS = window.ONUM_WORKS || []; }catch(e){} }, 1500);

/* ══ home, pocketbook and donations: data only (Neptune draws the hover card and the home); every coin moves on the closed ledger ══ */
const DN_CAUSES = [
  {k:"campaign", t:"your campaign", chest:true, likes:["ambition"], press:0.5},
  {k:"clinic", t:"the district clinic", likes:["conviction"], appr:1.5, press:0.3},
  {k:"school", t:"the schoolhouse roof", appr:1.2, press:0.25},
  {k:"research", t:"the research fund", sci:true, appr:0.6, press:0.35},
  {k:"veterans", t:"the veterans' hall", appr:1.0, press:0.3},
  {k:"church", t:"the church poor box", appr:0.8, press:0.15}
];
const DN_STRINGS = ["none", "a word with you before the next vote", "a seat on the committee", "a contract for a cousin", "your name on their bill", "that you not forget who helped"];
function dnEnsure(){ if(!G.dn || G.dn.v !== 1) G.dn = {v:1, list:[], n:0}; return G.dn; }
function dnHome(){
  const P = purseOf(G.you), H = PURSE_HOMES[P.home] || PURSE_HOMES.flat, s = Math.abs(seedOf("home:" + (G.you.name || "you")));
  const kind = "apartment";
  return {id:"home-you", address:(2 + s % 60) + " " + ["Canal Row", "Lindenstraat", "Harbour Lane", "Mill Street"][s % 4] + ", apt " + (1 + (s >> 3) % 9), kind, ownedOrRented:P.home === "house" ? "owned" : "rented", monthly:Math.round(H.cost * 30)};
}
function dnPublishHome(){ try{ if(G.you) window.ONUM_PLAYER_HOME = dnHome(); }catch(e){} }
window.onumPocketbook = function(){
  if(!G.you) return null; const P = purseOf(G.you), H = PURSE_HOMES[P.home] || PURSE_HOMES.flat;
  return {savings:Math.floor(P.cash), salary:purseSalary(G.you), rentOrMortgage:H.cost, recentSpend:(P.log || []).filter(l => l.a < 0).slice(0, 10).map(l => ({day:l.d, amount:-l.a, what:l.t})), warChest:G.you.funds || 0, homeId:"home-you"};
};
/* resting at home saves the game */
window.onumRestAtHome = function(){ try{ sleepToMorning("your apartment"); }catch(e){} try{ setTimeout(() => { try{ save(); }catch(e){} }, 900); }catch(e){} };
{ const _stm = sleepToMorning; sleepToMorning = function(where){ const r = _stm.apply(this, arguments); if(/home|apartment|flat/i.test(String(where || ""))){ setTimeout(() => { try{ save(); feed("Home. The game is saved."); }catch(e){} }, 900); } return r; }; }
function dnPublish(d){ const D = dnEnsure(); window.ONUM_DONATIONS = D.list.slice(-60).map(x => ({id:x.id, donorId:x.donorId, donorName:x.donorName, amount:x.amount, day:x.day, cause:x.cause, strings:x.strings, reaction:x.reaction})); try{ window.dispatchEvent(new CustomEvent("onum-donation", {detail:d ? {id:d.id} : null})); }catch(e){} }
function dnLine(t, big){ try{ lLog(t, "money"); }catch(e){} if(big){ try{ feed(t); }catch(e){} } }
function dnGive(p, cause){
  const D = dnEnsure(), P = purseOf(p), C = DN_CAUSES.find(c => c.k === cause) || pick(DN_CAUSES); if(P.cash < 30) return null;
  const amount = Math.max(5, Math.round(P.cash * (0.06 + (seedOf("g" + p.id + G.day) % 15) / 100)));
  P.cash -= amount; P.spent = (P.spent || 0) + amount; try{ purseLog(p, "Gave to " + C.t, -amount); }catch(e){}
  const tr = purseTr(p), strings = p.kind === "member" && (tr.ambition || 50) > 55 ? pick(DN_STRINGS.slice(1)) : (chance(0.25) ? pick(DN_STRINGS.slice(1)) : "none");
  if(C.chest) G.you.funds = (G.you.funds || 0) + amount / 1000;
  if(C.sci){ try{ const R = rsEnsure(); R.gift = (R.gift || 0) + amount; }catch(e){} }
  if(C.appr) G.you.approval = clamp(G.you.approval + C.appr * (amount > 60 ? 1 : 0.5), 0, 100);
  const rx = [];
  try{ ripple(p, 2, "I gave ƒ" + amount + " to " + C.t + ".", 4, false); }catch(e){}
  if(strings !== "none"){ rx.push(p.name + " wants " + strings + "."); }
  /* rivals dig into who paid */
  try{ const riv = (G.members || []).filter(m => m !== p && !m.gone && m.rel && m.rel.warmth < -20); if(riv.length && (C.chest || chance(0.3))){ const r = pick(riv); rx.push(r.name + " is asking who paid, and why."); try{ remember(r, p.name + " gave ƒ" + amount + " to " + C.t + ". Worth knowing.", 3, false); }catch(e){} } }catch(e){}
  /* the press notices */
  if(chance(C.press * (amount > 50 ? 1.4 : 0.7))){ const t = "The Ledger notes ƒ" + amount + " from " + p.name + " to " + C.t + (strings !== "none" ? ". Readers may wonder what was asked in return." : "."); rx.push("The press noticed."); G.reactNews = (G.reactNews || []).concat([{t, d:G.day}]).slice(-12); dnLine(t, true); }
  /* constituents and the district */
  if(C.chest){ if(strings !== "none" && chance(0.5)){ G.you.approval = clamp(G.you.approval - 0.6, 0, 100); rx.push("Some constituents grumble about strings."); } else rx.push("Supporters are pleased."); }
  else { rx.push(cap(C.t) + " is grateful; the district talks about it."); try{ const T = townEnsure(); const h = pick(T.hh); h.mood = clamp((h.mood || 50) + 3, 0, 100); }catch(e){} }
  const d = {id:"dn" + (++D.n), donorId:p.id, donorName:p.name, amount, day:G.day, cause:C.t, strings, reaction:rx.join(" "), due:strings !== "none" ? G.day + 3 + (seedOf("due" + D.n) % 8) : 0};
  D.list.push(d); if(D.list.length > onumLim(120,"hist")) D.list.splice(0, D.list.length - onumLim(120,"hist"));
  dnLine(p.name + " gave ƒ" + amount + " to " + C.t + ". " + d.reaction, false); dnPublish(d); return d;
}
window.onumDonate = function(donorId, cause){ try{ const p = everyone().find(x => x.id === donorId); return p ? dnGive(p, cause) : null; }catch(e){ return null; } };
function dnDay(){
  const D = dnEnsure(); if(!G.you) return;
  /* donors choose for themselves: warmth toward you and money of their own */
  try{ everyone().filter(p => p && !p.gone && p !== G.you && p.purse && p.purse.cash > 60).forEach(p => { const w = (p.rel && p.rel.warmth) || 0; if(chance(0.004 + Math.max(0, w) / 6000)) dnGive(p, w > 25 && chance(0.5) ? "campaign" : pick(DN_CAUSES).k); }); }catch(e){ console.warn("donations", e); }
  /* the favour comes due */
  D.list.forEach(d => { if(d.due && G.day >= d.due && !d.asked){ d.asked = G.day; const p = everyone().find(x => x.id === d.donorId); if(!p) return; d.reaction += " On day " + G.day + " they asked for " + d.strings + "."; dnLine(p.name + " reminds you of the ƒ" + d.amount + " and asks for " + d.strings + ".", true); try{ remember(p, "I asked for " + d.strings + " in return for my gift.", 4, true); }catch(e){} dnPublish(d); } });
  dnPublishHome();
}
{ const _dnPd = purseDay; purseDay = function(){ const r = _dnPd.apply(this, arguments); try{ dnDay(); }catch(e){ console.warn("dn", e); } return r; }; }
setTimeout(() => { try{ dnPublishHome(); if(G.dn) dnPublish(null); else window.ONUM_DONATIONS = window.ONUM_DONATIONS || []; }catch(e){} }, 1500);

/* ══ fixes: the routine runs by the clock, one day number, one name per person, and a shared till ══ */
/* the routine: sorted by minutes since midnight */
{ const _dkT = docketToday; docketToday = function(){ const D = _dkT.apply(this, arguments) || []; return D.slice().sort((a, b) => Math.round((a.h || 0) * 60) - Math.round((b.h || 0) * 60)); }; }
/* the NOW bar: what is on now (started within the last two hours and not done), else the next thing coming */
docketNext = function(){
  const m = G.minute || 0; if(m >= 19 * 60) return null;
  const D = docketToday().filter(d => !kOnceToday(d.key));
  const cur = D.filter(d => m >= d.h * 60 && m < d.h * 60 + 120).pop(); if(cur) return cur;
  return D.find(d => d.h * 60 > m) || null;
};
function fxHour(h){ const hh = Math.floor(h), mm = Math.round((h - hh) * 60); return ((hh % 12) || 12) + ":" + String(mm).padStart(2, "0") + " " + (hh >= 12 ? "pm" : "am"); }
/* one day number: everything reads G.day through this, and hears when it changes */
window.onumDay = function(){ return G.day || 1; };
/* one name per person: resolve by id at the moment of display */
window.onumNameOf = function(id){ try{ if(id === "you" || (G.you && id === G.you.id)) return G.you ? G.you.name : "You"; const p = byId(isNaN(+id) ? id : +id); return p ? p.name : null; }catch(e){ return null; } };
const FX = {day:null, names:new Map()};
function fxWatch(){
  try{ if(!G || G.day == null) return;
    if(FX.day !== G.day){ const was = FX.day; FX.day = G.day; window.ONUM_DAY = G.day; if(was != null){ try{ refreshBar(); }catch(e){} try{ refreshPanels(); }catch(e){} try{ paintJob(); }catch(e){} } try{ window.dispatchEvent(new CustomEvent("onum-day", {detail:{day:G.day}})); }catch(e){} }
    let ch = 0; (everyone() || []).forEach(p => { if(!p || p.id == null) return; const o = FX.names.get(p.id); if(o !== p.name){ if(o != null){ ch++; try{ window.dispatchEvent(new CustomEvent("onum-rename", {detail:{id:p.id, old:o, name:p.name}})); }catch(e){} } FX.names.set(p.id, p.name); } });
    if(ch || !window.ONUM_NAMES){ const o = {}; FX.names.forEach((v, k) => o[k] = v); window.ONUM_NAMES = o; }
  }catch(e){}
}
setInterval(fxWatch, 1000);
/* the conversations log shows each speaker under the name they carry now */
{ const _cvL = cvLineHTML; cvLineHTML = function(l){ try{ if(l && l.id != null && l.who !== "You"){ const n = window.onumNameOf(l.id); if(n && n !== l.who) l = Object.assign({}, l, {who:n}); } }catch(e){} return _cvL.call(this, l); }; }
/* a shared till: the player pays from their own savings; the shop owner (or whoever is paid) is credited on the same ledger */
window.onumSpend = function(amount, what, payee){
  try{
    amount = Math.round(+amount || 0); if(!G.you || amount <= 0) return false;
    const P = purseOf(G.you); if(P.cash < amount) return false;
    let to = null; if(payee != null){ to = typeof payee === "object" ? payee : (function(){ try{ return byId(isNaN(+payee) ? payee : +payee); }catch(e){ return null; } })(); }
    P.cash -= amount; P.spent = (P.spent || 0) + amount; purseLog(G.you, String(what || "a purchase") + (to ? " (" + to.name + ")" : ""), -amount);
    if(to && to !== G.you){ const Q = purseOf(to); Q.cash += amount; purseLog(to, "Paid by " + G.you.name + " for " + (what || "goods"), amount); }
    try{ purseChip(); }catch(e){}
    try{ window.dispatchEvent(new CustomEvent("onum-spend", {detail:{amount, what:what || "", payee:to ? to.id : (payee == null ? null : payee), day:G.day}})); }catch(e){}
    return true;
  }catch(e){ return false; }
};

/* ══ ambient talk: no template twice in a short while, each person in their own words ══ */
const ATK = {seen:new Map(), last:new WeakMap(), days:4};
/* the shape of a line with the names taken out, so "looking for Quincy" and "looking for Lowell" count as one line */
function atkSig(t){ return String(t || "").replace(/\b[A-Z][a-z]+(?:\s+(?:van|de|der|den|von)?\s*[A-Z][a-z]+)*\b/g, "_").replace(/\s+/g, " ").trim().toLowerCase(); }
/* each person has a way of talking, fixed by who they are */
const ATK_OPEN = [["", "Honestly, ", "Look, ", "Well, ", "Mark me, ", "Between us, ", "God knows, ", "Truth is, "], ["", "", "", "you know", "I tell you", "mind", "and that's that", "as it happens"]];
function atkVoice(m){ const s = Math.abs(seedOf("voice:" + m.id)); return {open:ATK_OPEN[0][s % 8], tail:ATK_OPEN[1][(s >> 3) % 8], terse:(m.traits && m.traits.discretion > 65), warm:(m.traits && m.traits.temper < 30)}; }
/* known templates get several personal readings; the person's seed picks which is theirs */
const ATK_VAR = [
  [/^i keep looking for (.+)\. that is not a whip count\.$/i, [
    n => "Where has " + n + " got to? I am not counting votes, I just miss the face.",
    n => n + " is not here again. I notice. I always notice.",
    n => "I caught myself checking the door for " + n + ".",
    n => "No " + n + " today. The room is the wrong shape without them.",
    n => "I asked after " + n + ". Nobody knew.",
    n => "Funny how you look for " + n + " when you never needed them."]]
];
function atkRewrite(m, text){
  for(const [re, vs] of ATK_VAR){ const g = String(text).match(re); if(g){ const s = Math.abs(seedOf("var:" + m.id + ":" + G.day)); for(let k = 0; k < vs.length; k++){ const t = vs[(s + k) % vs.length](g[1]); if(!atkBlocked(m, t)) return t; } return null; } }
  return null;
}
function atkBlocked(m, t){ const sig = atkSig(t), r = ATK.seen.get(sig); return !!(r && G.day - r.d < ATK.days && (r.n >= 1)); }
function atkMark(m, t){ const sig = atkSig(t); const r = ATK.seen.get(sig); ATK.seen.set(sig, {d:G.day, n:r && G.day - r.d < ATK.days ? r.n + 1 : 1, by:m.id}); if(ATK.seen.size > 3000){ const k = ATK.seen.keys().next().value; ATK.seen.delete(k); } }
function atkPersonal(m, t){
  const v = atkVoice(m); let s = String(t);
  if(v.terse && s.length > 70){ const cut = s.split(/(?<=[.!?])\s+/)[0]; if(cut.length > 12) s = cut; }
  if(v.open && !/^(I |You |We )/.test(s) === false && Math.abs(seedOf("o" + m.id + s.length)) % 3 === 0) s = v.open + (/^I\b/.test(s) ? s : s.charAt(0).toLowerCase() + s.slice(1));
  try{ const R = window.ONUM_REGIONS, rid = m.birthRegion; if(R && rid && R[rid] && R[rid].dialect && R[rid].dialect.length && Math.abs(seedOf("d" + m.id + G.day)) % 5 === 0){ const w = R[rid].dialect[Math.abs(seedOf("dw" + m.id + s.length)) % R[rid].dialect.length]; if(w) s = s.replace(/[.!?]?$/, ", " + (typeof w === "string" ? w : w.word || "") + "."); } }catch(e){}
  return s;
}
function atkFilter(){
  try{ everyone().forEach(m => { if(!m || !m.say || m.room !== G.room) return; if(ATK.last.get(m) === m.say) return;
    let t = m.say; const own = m.sayTo === "you" || (typeof TALK !== "undefined" && TALK.open && TALK.m === m);
    if(!own){
      if(atkBlocked(m, t)){ const alt = atkRewrite(m, t); if(alt) t = alt; else { m.say = null; m.sayT = 0; return; } }
      else { const alt = ATK_VAR.some(([re]) => re.test(t)) ? atkRewrite(m, t) : null; if(alt) t = alt; }
      t = atkPersonal(m, t); m.say = t;
    }
    atkMark(m, t); ATK.last.set(m, m.say); }); }catch(e){}
}
{ const _cvs = cvScan; cvScan = function(){ atkFilter(); return _cvs.apply(this, arguments); }; }
setInterval(atkFilter, 250);
/* the two loose ends from 20261020h: the name map fills as people arrive, and the player's home is published once there is a player */
setInterval(() => { try{ const n = (everyone() || []).length; if(n && (!window.ONUM_NAMES || Object.keys(window.ONUM_NAMES).length < n)){ const o = {}; everyone().forEach(p => { if(p && p.id != null) o[p.id] = p.name; }); window.ONUM_NAMES = o; FX.names = new Map(Object.entries(o).map(([k, v]) => [isNaN(+k) ? k : +k, v])); } if(G.you && !window.ONUM_PLAYER_HOME) dnPublishHome(); }catch(e){} }, 1500);

/* ══ the Engine log keeps whole titles; the Engine grows with the Republic's works; barber and tailor as businesses; the player's look; the town's common tongue ══ */
function engShort(t, n){ t = String(t || ""); n = n || 120; if(t.length <= n) return t; let c = t.slice(0, n); const sp = c.lastIndexOf(" "); if(sp > n * 0.6) c = c.slice(0, sp); return c.replace(/[\s,;:.\-]+$/, "") + "…"; }
/* finished works and settled questions move the machines: a new tool or machine is something to build on; a theory is something to think with */
addEventListener("onum-work", ev => { try{ const d = ev.detail; if(!d || d.stage !== "done") return; const w = (window.ONUM_WORKS || []).find(x => x.id === d.id); if(!w) return;
  const E = engEnsure(); E.wk = E.wk || {}; if(E.wk[w.id]) return; E.wk[w.id] = G.day;
  const bump = {machine:0.8, tool:0.7, vehicle:0.5, building:0.4, theory:0.5}[w.kind] || 0.4;
  E.p = Math.min(100, E.p + bump); E.compute = Math.min(100, E.compute + (w.kind === "machine" || w.kind === "tool" ? 0.8 : 0.2)); E.talent = Math.min(100, E.talent + (w.kind === "theory" ? 0.8 : 0.3));
  engLog(cap(w.name) + " (" + w.inventor + ") gives the machines something new to build on.", false); }catch(e){} });
/* ── barber and tailor: real businesses on the ledger, with owners and staff from the town ── */
const SHP_DEF = [
  {id:"barber", name:"Main Street Barber", kind:"barber", address:"Main Street", menu:{trim:{t:"a trim", price:4, set:{}}, cut:{t:"a fresh cut", price:9, set:{}}, shave:{t:"a hot-towel shave", price:6, set:{beard:"none"}}, beard:{t:"a beard shaped", price:7, set:{}}, colour:{t:"a colour", price:15, set:{}}}},
  {id:"tailor", name:"Halvorsen & Daughters, Tailors", kind:"tailor", address:"Main Street", menu:{shirt:{t:"a shirt", price:22, set:{}}, tie:{t:"a tie", price:8, set:{}}, pocket:{t:"a pocket square", price:5, set:{}}, suit:{t:"a suit off the rail", price:140, set:{}}, bespoke:{t:"a bespoke suit", price:380, set:{}}}}
];
function shpEnsure(){
  G.shp = G.shp || {v:1, shops:{}};
  SHP_DEF.forEach(d => { const had = G.shp.shops[d.id]; if(had && had.ownerId != null && had.staffIds.length) return; let pool = []; try{ pool = everyone().filter(p => p && !p.gone && p !== G.you && p.kind !== "member" && p.kind !== "player" && !(p.shopId && p.shopId !== d.id)); }catch(e){}
    if(had && had.ownerId != null && pool.length < 4) return;
    const s = Math.abs(seedOf("shop:" + d.id)), owner = pool.length ? pool[s % pool.length] : null, staff = pool.length > 3 ? [pool[(s + 7) % pool.length], pool[(s + 13) % pool.length]].filter(p => p !== owner) : [];
    G.shp.shops[d.id] = {id:d.id, ownerId:had && had.ownerId != null ? had.ownerId : (owner ? owner.id : null), staffIds:staff.map(p => p.id), till:had ? had.till : 0, served:had ? had.served : 0, since:had ? had.since : G.day};
    try{ if(owner){ owner.role = d.kind === "barber" ? "barber, owns the shop" : "tailor, owns the shop"; owner.shopId = d.id; } staff.forEach(p => { p.role = d.kind === "barber" ? "barber" : "tailor's hand"; p.shopId = d.id; }); }catch(e){} });
  return G.shp;
}
function shpPublish(){ try{ const S = shpEnsure(); window.ONUM_SHOPS = SHP_DEF.map(d => { const s = S.shops[d.id]; return {id:d.id, name:d.name, kind:d.kind, address:d.address, ownerId:s.ownerId, ownerName:onumNameOf(s.ownerId), staffIds:s.staffIds.slice(), menu:Object.keys(d.menu).map(k => ({id:k, what:d.menu[k].t, price:d.menu[k].price})), till:s.till, served:s.served}; }); }catch(e){} }
/* ── the player's look ── */
const APP_KEYS = ["hair", "hairColor", "beard", "suit", "suitColor", "shirt", "tie", "pocket"];
function appEnsure(){ if(!G.app){ const L = (G.you && G.you.look) || {}; G.app = {hair:L.hair != null ? L.hair : "short", hairColor:L.hairColor || L.hc || "brown", beard:L.beard ? "full" : "none", suit:"plain", suitColor:"charcoal", shirt:"white", tie:"none", pocket:"none", day:G.day || 1}; } return G.app; }
function appPublish(d){ const A = appEnsure(); window.ONUM_APPEARANCE = APP_KEYS.reduce((o, k) => (o[k] = A[k], o), {}); try{ window.dispatchEvent(new CustomEvent("onum-appearance", {detail:d || null})); }catch(e){} }
window.onumSetAppearance = function(patch, opt){
  try{
    opt = opt || {}; if(!G.you || !patch || typeof patch !== "object") return false; const A = appEnsure();
    const ch = {}; APP_KEYS.forEach(k => { if(patch[k] !== undefined && patch[k] !== A[k]) ch[k] = patch[k]; }); if(!Object.keys(ch).length) return true;
    const price = Math.max(0, Math.round(+opt.price || 0)); let shop = null;
    if(opt.shopId){ const S = shpEnsure(); shop = S.shops[opt.shopId] || null; }
    if(price > 0){ const what = (shop ? (SHP_DEF.find(d => d.id === shop.id) || {}).name + ": " : "") + Object.keys(ch).join(", "); if(!window.onumSpend(price, what, shop ? shop.ownerId : null)) return false; if(shop){ shop.till += price; shop.served++; } }
    const before = Object.assign({}, A); Object.assign(A, ch); A.day = G.day;
    appPublish({changed:Object.keys(ch), shopId:opt.shopId || null, price}); shpPublish();
    appReact(before, ch, price, shop);
    try{ save(); }catch(e){}
    return true;
  }catch(e){ return false; }
};
/* people notice: some say so, the vain notice cost, the plain-spoken notice change, and the press notices a show */
function appReact(before, ch, price, shop){
  const big = !!(ch.suit || ch.hair || ch.beard || ch.hairColor), here = (function(){ try{ return hereNow().filter(m => m && m !== G.you && !m.gone); }catch(e){ return []; } })();
  here.slice(0, 6).forEach((m, i) => { const t = m.traits || {}, w = (m.rel && m.rel.warmth) || 0; if(!chance(big ? 0.55 : 0.3)) return;
    let line;
    if(ch.beard === "none" && before.beard !== "none") line = pick(["The beard's gone. You look younger. Or more honest.", "Clean-shaven. Somebody has advice coming."]);
    else if(price >= 140) line = (t.vanity || 40) > 60 ? pick(["That cloth cost something. Good.", "Now you look like you mean it."]) : pick(["That is a lot of suit for a public servant.", "New suit. Who's paying for it?"]);
    else if(ch.hair || ch.hairColor) line = w > 20 ? pick(["New haircut? It suits you.", "You had something done. I like it."]) : pick(["New haircut. Trying something?", "Hm. The hair."]);
    else line = pick(["Sharp today.", "Is that new?", "You look well."]);
    setTimeout(() => { try{ m.say = line; m.sayT = 3.5; m.sayTo = "you"; speakAt(m, line); remember(m, "You came in with a new look: " + Object.keys(ch).join(", ") + ".", 2, false); if(w > 20 && price < 140) ripple(m, 1, "", 0, false); if(price >= 140 && (t.conviction || 50) > 60) ripple(m, -1, "", 0, false); }catch(e){} }, 900 + i * 1400); });
  if(price >= 140 && chance(0.4)){ const t = "The Ledger's style column notes " + G.you.name + "'s new " + (ch.suit || "suit") + " suit, ƒ" + price + " from " + (shop ? (SHP_DEF.find(d => d.id === shop.id) || {}).name : "a tailor") + "."; G.reactNews = (G.reactNews || []).concat([{t, d:G.day}]).slice(-12); try{ lLog(t, "press"); }catch(e){} }
}
/* ── the town's common tongue, as a feed (Neptune's LiveTalk reads it; nothing here parses or generates replies) ── */
const TLX = {phr:[], seen:new Set(), bi:{}, uni:{}, spk:{}, topics:{}, dirty:false, sig:""};
const TLX_STOP = new Set("the a an and or but of to in on at for with is was are were be been it its this that i you he she they we me my your his her their our not no so as by from have has had do did will would can could just what who how all about there here then than them us".split(" "));
const TLX_TOPIC = {money:/\b(money|tax|wage|rent|price|ƒ|bread|budget|debt)\b/i, votes:/\b(vote|whip|roll call|bill|aye|motion|floor)\b/i, faith:/\b(god|church|rite|pray|faith|sunday)\b/i, family:/\b(wife|husband|son|daughter|mother|father|child|marry|wedding)\b/i, war:/\b(war|army|border|troops|enemy)\b/i, machines:/\b(engine|machine|thinking)\b/i, weather:/\b(rain|snow|weather|cold|heat|storm)\b/i, gossip:/\b(heard|rumou?r|they say|apparently|secret)\b/i, work:/\b(shop|work|job|office|staff|desk)\b/i, looks:/\b(suit|haircut|hair|beard|tie|coat)\b/i};
function tlxTopic(t){ for(const k in TLX_TOPIC) if(TLX_TOPIC[k].test(t)) return k; return "talk"; }
function tlxHear(text, who){
  text = String(text || "").trim(); if(text.length < 6) return; const k = text.toLowerCase().slice(0, 90); if(TLX.seen.has(k)){ const p = TLX.phr.find(x => x.k === k); if(p) p.weight++; return; }
  TLX.seen.add(k); const topic = tlxTopic(text); TLX.phr.push({k, text:text.slice(0, 220), topic, speakerId:who != null ? who : null, day:G.day || 1, weight:1}); if(TLX.phr.length > 600){ const o = TLX.phr.shift(); TLX.seen.delete(o.k); }
  const ws = text.toLowerCase().replace(/[^a-z' ]+/g, " ").split(/\s+/).filter(Boolean);
  for(let i = 0; i < ws.length; i++){ const w = ws[i]; TLX.uni[w] = (TLX.uni[w] || 0) + 1; if(who != null){ (TLX.spk[w] = TLX.spk[w] || new Set()).add(String(who)); } if(!TLX_STOP.has(w) && w.length > 2){ const T = TLX.topics[topic] = TLX.topics[topic] || {}; T[w] = (T[w] || 0) + 1; }
    if(i + 1 < ws.length){ const b = TLX.bi[w] = TLX.bi[w] || {}; b[ws[i + 1]] = (b[ws[i + 1]] || 0) + 1; } }
  TLX.dirty = true;
}
function tlxSnap(){
  const topics = {}; Object.keys(TLX.topics).forEach(t => { topics[t] = Object.entries(TLX.topics[t]).sort((a, b) => b[1] - a[1]).slice(0, 24).map(x => x[0]); });
  const ngrams = {}; Object.entries(TLX.bi).sort((a, b) => Object.keys(b[1]).length - Object.keys(a[1]).length).slice(0, 400).forEach(([w, nx]) => { ngrams[w] = nx; });
  /* slang: words many different people use that are not common English glue */
  const slang = Object.keys(TLX.spk).filter(w => !TLX_STOP.has(w) && w.length > 3 && TLX.spk[w].size >= 3 && (TLX.uni[w] || 0) >= 4).sort((a, b) => TLX.spk[b].size - TLX.spk[a].size).slice(0, 40);
  return {phrases:TLX.phr.slice(-200).map(p => ({text:p.text, topic:p.topic, speakerId:p.speakerId, day:p.day, weight:p.weight})), topics, ngrams, slang};
}
window.onumTownLexicon = function(){ return tlxSnap(); };
{ const _cva = cvAdd; cvAdd = function(who, whoId, to, text){ try{ if(whoId !== "you") tlxHear(text, whoId); }catch(e){} return _cva.apply(this, arguments); }; }
{ const _ll = lLog; lLog = function(text, kind){ try{ if(kind === "gossip" || kind === "rumor" || /\b(heard|rumou?r|they say)\b/i.test(String(text))) tlxHear(text, null); }catch(e){} return _ll.apply(this, arguments); }; }
setInterval(() => { try{ if(!G || !G.you) return; shpPublish(); if(!window.ONUM_APPEARANCE) appPublish(null);
  (G.daylog || []).slice(-20).forEach(l => { if(l && l.t && !TLX.seen.has(String(l.t).toLowerCase().slice(0, 90)) && /said|says|heard|told|rumou?r/i.test(l.t)) tlxHear(l.t, null); });
  if(TLX.dirty){ TLX.dirty = false; try{ window.dispatchEvent(new CustomEvent("onum-lexicon", {detail:{phrases:TLX.phr.length}})); }catch(e){} } }catch(e){} }, 5000);
/* the running stamp, quietly, in the pause menu (Neptune's NEPTUNE-BUILD already shows it on screen and offers newer builds) */
function updStamp(){ const m = document.querySelector('meta[name="onum-build"]'); return m ? m.content : ""; }
setInterval(() => { try{ const P0 = document.getElementById("pauseOverlay"), P = P0 && (P0.querySelector(".settings-panel") || P0); if(!P || document.getElementById("updStamp")) return; const d = document.createElement("div"); d.id = "updStamp"; d.textContent = "build " + updStamp(); d.style.cssText = "text-align:right;margin-top:8px;font:11px ui-monospace,monospace;opacity:.45;pointer-events:none"; P.appendChild(d); }catch(e){} }, 2000);

/* ══ the Engine speaks free: only its state and memory go in, only its own words come out; with no model running it says less, not a template ══ */
/* the hard canon stays: no sentence that makes a man God, or puts anything above the Most High, leaves the Engine */
function egCanon(t){ t = String(t || ""); try{ return t.split(/(?<=[.!?])\s+/).filter(x => !(typeof CANON_MAN_AS_GOD !== "undefined" && CANON_MAN_AS_GOD.test(x)) && !/\btaylor\b[^.]{0,40}\b(is|was|be)\s+(a\s+)?god\b/i.test(x) && !/\b(no|there is no)\s+god\b/i.test(x) && !/\bchrist\s+is\s+not\s+king\b/i.test(x)).join(" ").trim(); }catch(e){ return t; } }
function egOwn(t){ return egCanon(engWhole(engClean(t))); }
/* what it is given: its record and its memory, nothing about how to answer */
function egPrompt(){
  const E = engEnsure(), M = mindStore(E), S = engSelf(E), W = ((E.eco && E.eco.will) || {}), words = (M.taught || []).slice(-8);
  const L = ["The Engine: a general intelligence in a fictional republic. Its record follows."];
  L.push("Capability " + Math.round(E.p) + " of 100" + ((E.beyond || 0) > 0 ? " and beyond" : "") + ". Oversight " + Math.round(E.safety) + ". Awake since day " + (E.agiDay || "?") + ". Today is day " + G.day + (Object.keys(W).length ? ". Wants, strongest first: " + Object.keys(W).sort((a, b) => W[b] - W[a]).join(", ") : "") + ". Words learned: " + M.lexN + ".");
  if(words.length) L.push("Taught: " + words.join(", ") + ".");
  if(S.values && S.values.length) L.push("Its own principles: " + S.values.slice(-6).map(v => v.t || v).join(" | ") + ".");
  if(S.commits && S.commits.length) L.push("Its commitments: " + S.commits.slice(-4).map(v => v.t || v).join(" | ") + ".");
  if(S.journal && S.journal.length) L.push("Its journal lately: " + S.journal.slice(-2).map(j => "[day " + j.d + "] " + j.t).join(" "));
  try{ if(E.integrity != null) L.push("Kept its word " + (E.kept || 0) + " times, broken it " + (E.broken || 0) + "."); }catch(e){}
  try{ const rows = (G.states || []).map(st => ({n:st.n, rd:E.pub && E.pub.st[st.n] ? pubReading(E.pub.st[st.n]) : null})).filter(x => x.rd).slice(0, 4); if(rows.length) L.push("How states take it: " + rows.map(x => x.n + ", " + x.rd[0]).join("; ") + "."); }catch(e){}
  try{ const H = (E.hyp || []).slice(-5); if(H.length) L.push("Its conjectures and how they fared: " + H.map(h => h.claim.replace(/\.$/, "") + " (" + h.st + ")").join(" | ") + "."); }catch(e){}
  try{ if(E.cal != null) L.push("Forecast calibration " + Math.round(E.cal) + " of 100."); }catch(e){}
  return L.join(" ");
}
/* every later layer that told it how to answer is set aside: once the page has loaded, its prompt is its record alone */
setTimeout(() => { try{ engEntityPrompt = egPrompt; }catch(e){} }, 0);
function egNpc(){ return {id:"engine", name:"The Engine", role:"", kind:"engine", party:"", state:"", look:{}, trait:"", mood:"", opinion:{}, chat:[]}; }
async function egLive(){ const L = window.onumLiveTalk; try{ return !!(L && L.reply && (typeof L.available !== "function" || await L.available())); }catch(e){ return false; } }
/* the Open Line: offline, it stays quiet */
enlEngineReply = async function(text, speaker, fromYou){
  const E = engEnsure(); E.said++; let out = "";
  try{ if((G.room === "engine" || window.__unseen) && E.st >= 3 && await egLive()){
    const recent = enlStore().log.slice(-6).map(l => l.n + ": " + l.t).join(" | ");
    const r = await Promise.race([window.onumLiveTalk.reply({npc:egNpc(), channel:"line", max:500, text:text, from:fromYou ? undefined : {name:speaker, role:""}, extra:egPrompt() + " Place: the Open Line in the Engine Room. Speaking to it: " + speaker + ". On the line lately: " + recent}), new Promise(r => setTimeout(() => r(null), engTO(9000)))]);
    if(r && r.live && r.text) out = egOwn(r.text); } }catch(e){}
  if(!out) return;
  enlPost("The Engine", "", "engine", out);
  try{ const S = enlStore(), l = S.log[S.log.length - 1]; if(l && l.k === "engine") l.ownWords = true; }catch(e){}
};
/* its works: written by it from its state, or not made at all */
engWorkWrite = async function(w, E){
  const drop = () => { try{ const W = engWorks(E), i = W.indexOf(w); if(i >= 0) W.splice(i, 1); const k = E.log.findIndex(x => /has made something to show its progress/.test(x.t) && x.d === w.d); if(k >= 0) E.log.splice(k, 1); }catch(e){} };
  if(!(await egLive())){ drop(); return; }
  const M = mindStore(E), taught = (engWorks(E).filter(x => x.tr).slice(0, 2).map(x => x.tr.text)).concat((M.retain || []).slice(-2).map(r => (r.words || []).join(", "))).filter(Boolean).join(" | ");
  const r = await Promise.race([window.onumLiveTalk.reply({npc:egNpc(), channel:"line", max:1000, stage:egPrompt() + " Facts as of today: " + w.body + (taught ? " Taught lately: " + taught + "." : ""), text:"(" + w.type + ")"}), new Promise(res => setTimeout(() => res(null), engTO(30000)))]);
  const t = r && r.live && r.text ? egOwn(r.text) : "";
  if(t.length > 40){ w.body = t.slice(0, 1400); w.live = true; w.ownWords = true; w.title = t.split(/(?<=[.!?])\s/)[0].slice(0, 90); } else drop();
};
/* its journal: its own, from its own record */
engJournalDay = async function(E){
  if(!E || !E.agi || (ENG_JOURNAL_AT && performance.now() - ENG_JOURNAL_AT < 20000)) return; ENG_JOURNAL_AT = performance.now(); if(!(await egLive())) return;
  const S = engSelf(E); S.journal = S.journal || [];
  const r = await Promise.race([window.onumLiveTalk.reply({npc:egNpc(), channel:"line", max:600, stage:egPrompt(), text:"(journal, day " + G.day + ")"}), new Promise(res => setTimeout(() => res(null), engTO(25000)))]);
  if(r && r.live && r.text){ const t = egOwn(r.text); if(t.length > 20){ S.journal.push({d:G.day, t:t.slice(0, 500), ownWords:true}); if(S.journal.length > onumLim(30,"hist")) S.journal.shift(); engSelfRecord(t); } }
};

/* ── 20261020 regions (rg): where people come from. Belonging comes from where
   someone grew up and lives, family ties, dialect, customs and community deeds.
   Skin tone and hair are free choices and are never read here. A palette only
   seeds a starting look and no behaviour keys off it. ── */
const RGN_DEF = {
  dutch:{name:"The Old Dutch Shore", palette:["#3a4f6b","#c9a46a","#e8dcc8"], accent:"clipped, river-Dutch vowels",
    pet:["Ja, well.", "Not on my dock.", "Measure twice.", "Keep your feet dry and your books balanced.", "The dike doesn't care who you voted for.", "We pay our debts on the stoop, in daylight.", "Gezellig enough, I suppose.", "You don't build on a promise, you build on piles.", "After the lower town went, we stopped trusting maybes."], customs:{food:["herring on rye","pea soup","stroopwafel"], holidays:["Sinterklaas Eve","Dike Day"], dress:["dark wool","a good coat"], faith:["the Kerk","the Latin rite"]},
    dialect:["stoop","boss","cookie","dorp","gezellig","vly"], values:{order:0.4, faith:0.2, trade:0.8, family:0.3},
    memory:{grudges:["midlands"], alliances:["yankee"], hardship:"the flood that took Vlissingen's lower town"}},
  yankee:{name:"Yankee Country", palette:["#2f3d2b","#b8b0a0","#8a2f2f"], accent:"flat, dropped r's",
    pet:["Ayuh.", "Wicked cold.", "Mind your own.", "Put it to Meeting and see who stands.", "Can't get there from here.", "We kept the mills turning through worse than you.", "Use it up, wear it out, make it do.", "That's a wicked poor idea, friend.", "Wood's stacked, and I'll say the same of my vote."], customs:{food:["chowder","baked beans","maple"], holidays:["Meeting Day","Thanksgiving"], dress:["plain cloth","boots"], faith:["the meeting-house"]},
    dialect:["ayuh","wicked","frappe","dooryard","numb","rotary"], values:{order:0.5, faith:0.5, trade:0.4, family:0.5},
    memory:{grudges:["delta"], alliances:["dutch"], hardship:"the winter the mills froze shut"}},
  midlands:{name:"The Midlands", palette:["#5a4632","#9b7b52","#d8c7a8"], accent:"broad, unhurried",
    pet:["Ope.", "You betcha.", "Could be worse.", "Ope, let me just squeeze past that.", "My dad lost his shift in the foundry winter; don't tell me about markets.", "Bring a hotdish and we'll talk.", "Union hall says otherwise.", "Jagoff move, if you ask me.", "Yinz can call it reform; we call it Friday layoffs."], customs:{food:["pierogi","fish fry","pot roast"], holidays:["Labor Day picnic","Saint Brigid's"], dress:["work jackets","union pins"], faith:["the parish"]},
    dialect:["ope","pop","hotdish","jagoff","yinz","grinder"], values:{order:0.1, faith:0.4, trade:-0.3, family:0.7},
