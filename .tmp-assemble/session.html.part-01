/* ── 20261021d: saves that never hitch the walk. Snapshot in slices under requestIdleCallback
   (4 ms budget), pack + checksum in a Worker, write each copy in its own idle tick, IndexedDB
   async, repeated requests coalesce into one, skipped entirely when nothing changed. Sync flush
   on pagehide only. Format unchanged ("ONZ1|hash|packed"), so old saves load and these load. ── */
const SV = {busy:false, pending:false, pendExplicit:false, rank:null, lastBody:null, worker:null, wseq:0, wcb:{},
  maxSlice:0, slices:0, runs:0, skipped:0, last:null, BUDGET:4};
function svSliceDone(t0, nm){ const d = performance.now() - t0; SV.slices++; if(d > SV.maxSlice){ SV.maxSlice = d; SV.maxAt = nm; } try{ engCost("save-slice", d); }catch(e){} }
function svWalking(){ try{ if(houseQuiet()) return true; }catch(e){} try{ if(typeof playerMoving === "function" && playerMoving()) return true; }catch(e){} return false; }
function svIdle(fn, explicit){
  const run = dl => { if(!explicit && svWalking()){ setTimeout(() => svIdle(fn, explicit), 300); return; }
    const t0 = performance.now(); const left = () => Math.min(SV.BUDGET, dl && dl.timeRemaining ? dl.timeRemaining() : SV.BUDGET) - (performance.now() - t0);
    try{ fn(left); }catch(e){ svFail(e); } svSliceDone(t0, fn.name); };
