  if(/alternat/.test(rec)){ const last = SSN.lastParty, alt = SSN.queue.find(id => { const p = id === "you" ? G.you : byId(id); return p && p.party !== last; }); if(alt != null) pick_ = alt; }
  if(/seniority/.test(rec)) pick_ = SSN.queue.slice().sort((a, b) => ((b === "you" ? G.you : byId(b)) || {}).terms - ((a === "you" ? G.you : byId(a)) || {}).terms)[0];
