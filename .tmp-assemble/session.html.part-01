function svFail(e){ SV.busy = false; try{ if(window.console) console.warn("save", e); }catch(e2){} svNext(); }
function svNext(){ if(SV.pending){ const ex = SV.pendExplicit; SV.pending = false; SV.pendExplicit = false; setTimeout(() => save(ex), 50); } }
function svRawWrite(key, raw){ try{ localStorage.setItem(key, raw); return true; }catch(e){ return false; } }
function svDone(base, explicit, wrote){
  if(!wrote){ G._saveFails = (G._saveFails || 0) + 1; const t = Date.now();
    if(!G._saveWarnAt || t - G._saveWarnAt > 120000){ G._saveWarnAt = t; try{ note("The game could not save: this browser's storage is full. Career, then Export career save, keeps your day.", true); }catch(e){} }
  } else { G._saveFails = 0; G.savedAt = hhmm(); saveCount++; SV.rank = careerRank(base); try{ if(S && S.raw) svWriteCareerMeta(S.raw); else if(base) svWriteCareerMeta(base); }catch(e3){} if(explicit) note("Saved.", false);
    try{ const pip = el("savePip"); if(pip){ pip.classList.add("is-on"); clearTimeout(save._pip); save._pip = setTimeout(() => pip.classList.remove("is-on"), 1200); } }catch(e){} }
  SV.busy = false; svNext();
}
/* the known best career rank, cached once at load so each save need not re-read three copies */
(function(){ const basePick = pickNewestSave; pickNewestSave = function(){ const b = basePick(); try{ if(b){ const r = careerRank(b); if(SV.rank == null || r > SV.rank) SV.rank = r; } }catch(e){} return b; }; })();
const SV_ARR = {members:1, press:1, civ:1};
save = function(explicit, sync){
  if(sync) return svFlushSync();
  if(SV.busy){ SV.pending = true; if(explicit) SV.pendExplicit = true; return true; }  /* coalesce */
  if(!G || !G.you || !G.members || !G.members.length) return false;
  SV.busy = true; SV.runs++;
  const T0 = performance.now();
  const S = {base:null, keys:null, ki:0, parts:[], arr:null, ai:0, aparts:null, explicit:!!explicit};
  const snap = left => {
    if(!S.base){ S.base = saveCaptureBase(); delete S.base.savedAtMs;
      S.src = {members:(G.members || []).slice(), press:(G.press || []).slice(), civ:(G.civ || []).slice()}; S.base.you = stripMesh(G.you);
      S.keys = Object.keys(S.base).concat(["members", "press", "civ"]); }
    while(S.ki < S.keys.length && left() > 0){
      const k = S.keys[S.ki];
      if(SV_ARR[k]){ const src = S.src[k]; if(!S.aparts) { S.aparts = []; S.ai = 0; }
        while(S.ai < src.length && left() > 0){ const s = JSON.stringify(stripMesh(src[S.ai++]), saveRound); S.aparts.push(s === undefined ? "null" : s); }
        if(S.ai < src.length) break;
        S.parts.push(JSON.stringify(k) + ":[" + S.aparts.join(",") + "]"); S.aparts = null; S.ki++; continue; }
      const s = JSON.stringify(S.base[k], saveRound); if(s !== undefined) S.parts.push(JSON.stringify(k) + ":" + s); S.ki++;
