  g.globalCompositeOperation = "destination-out"; const fd = g.createLinearGradient(0, H - 70, 0, H); fd.addColorStop(0, "rgba(0,0,0,0)"); fd.addColorStop(1, "rgba(0,0,0,.95)"); g.fillStyle = fd; g.fillRect(0, 0, W, H);
