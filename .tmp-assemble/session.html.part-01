    return ok;
  }catch(e){ return false; }
}
window.onumSaveStats = () => ({runs:SV.runs, skipped:SV.skipped, slices:SV.slices, maxSliceMs:+SV.maxSlice.toFixed(2), maxAt:SV.maxAt, last:SV.last, worker:!!SV.worker, busy:SV.busy, pending:SV.pending});

const MATCACHE = new Map();
/* Every distinct repeat used to clone the texture and its normal map, so
   a wall tiled 4.13 times and the same wall tiled 4.2 times were two more
   uploads to the graphics card. Nobody can see the difference, so the
   repeat is rounded and the two share one texture. */
function qrep(v){ v = +v; return v < 2 ? Math.max(0.25, Math.round(v*4)/4) : Math.round(v*2)/2; }
/* Cheap roughness-ish map from luminance — shared, one per source tex. */
const ROUGHMAPS = new Map();
function roughMapFrom(tex){
  if(ROUGHMAPS.has(tex)) return ROUGHMAPS.get(tex);
  const src = tex.image; if(!src || !src.getContext){ ROUGHMAPS.set(tex, null); return null; }
  const s = src.width;
  let data; try{ data = src.getContext("2d").getImageData(0,0,s,s).data; }catch(e){ ROUGHMAPS.set(tex,null); return null; }
  const out = document.createElement("canvas"); out.width = out.height = s;
  const octx = out.getContext("2d"), od = octx.createImageData(s,s);
  for(let i=0;i<s*s;i++){
    const L = (data[i*4]*0.3 + data[i*4+1]*0.59 + data[i*4+2]*0.11);
    const r = Math.max(40, Math.min(220, 210 - L * 0.55 + ((i*17)%13)));
    od.data[i*4]=od.data[i*4+1]=od.data[i*4+2]=r; od.data[i*4+3]=255;
  }
  octx.putImageData(od,0,0);
