}catch(e){ console.warn("org hooks", e); } }, 0);
/* ══ 20261016e · they speak first: walk up, touch or click and the other person opens, aloud and in type; that counts as you speaking to them ══ */
const FW = {n:0, last:-999};
function fwSupply(m){
  let l = ""; try{ l = String(convHook(m) || "").trim(); }catch(e){}
  if(!l) l = pick(["There you are.", "I was hoping you would come by.", "Do you have a moment?"]);
  l = l.replace(/\s+/g, " "); const cut = l.search(/[.!?]\s/); if(cut > 20 && cut < 160) l = l.slice(0, cut + 1);
  if(l.length > 170) l = l.slice(0, 167).replace(/\s+\S*$/, "") + "…";
  if(!/[.!?…"”]$/.test(l)) l += ".";
  return cap(l);
}
function fwLive(m, why, onText){
  try{ const LT = window.onumLiveTalk; if(!LT || typeof LT.reply !== "function") return; const tok = ++FW.n;
    Promise.resolve(LT.reply({npcId:m.id, channel:"face", stage:why + " They have not said a word yet. You speak first, unprompted, in your own words: whatever is on your mind right now. One or two sentences. Do not answer as though you were asked a question.", text:why}))
      .then(r => { if(tok === FW.n && r && r.live && r.text) { const t = liveClean(r.text); if(t) onText(t); } }).catch(() => {});
  }catch(e){}
}
{ const _ot2 = openTalk;
  openTalk = function(m){
    const r = _ot2.apply(this, arguments);
    try{
      if(!m || !m.traits || m === G.you || !TALK.open || TALK.m !== m || m.kind === "envoy") return r;
      m.met = true; m.lastHail = G.t; m._fwT = G.t;
      const opening = (el("tkSay") && el("tkSay").textContent) || "";
      if(opening){ try{ speakAt(m, opening); }catch(e){} }
      const sq1 = TALK.seq; fwLive(m, "The player has just walked up to you, touched or clicked you to start talking.", t => { if(!TALK.open || TALK.m !== m || TALK.seq !== sq1) return; try{ if(el("chatLog") && el("chatLog").querySelector(".msg--you")) return; }catch(e){} appendMsg("them", t, surname(m.name)); setSay(t, ""); renderTalk(); });   /* 20261030b: the opening is spoken once; the live line is written, not spoken a second time */
    }catch(e){}
    return r;
  };
}
/* closing in on someone is the same as speaking to them: they turn and open the conversation themselves */
function nearGreet(){
  if(!G || !G.running || TALK.open || SIT.on || (typeof window.onumTalkOwner === "function" && window.onumTalkOwner(true)) || AP.toast || G.t - FW.last < 60 || Math.abs(cam.speed || 0) > 0.45) return;
  let pc = false; try{ pc = !!PC.open; }catch(e){} if(pc) return;
  const here = hereNow().filter(o => o && !o.gone && o !== G.you && o.traits && o.x != null && !o.ohSeat && o.kind !== "player" && o.kind !== "envoy" && !o.wantsWord && apBudget(o) && (!o._ngT || G.t - o._ngT > 150));
  const m = here.find(o => Math.hypot(o.x - cam.x, o.z - cam.z) < 1.9);
  if(!m) return;
  FW.last = G.t; m._ngT = G.t;
  const l = fwSupply(m);
  m.faceUntil = G.t + 8; m.say = l; m.sayT = 6; m.sayTo = "you";
  try{ ledgerEnsure(m); ledgerTell(G.you, m, "I walked up to them and they spoke first."); }catch(e){}
  try{ if(m.rel) ripple(m, 1, null, 0); }catch(e){}
  try{ speakAt(m, l); }catch(e){}
  apSpeak(m, {t:l, k:"greet"}, null); apToast(m, {t:l, k:"greet"});
  try{ momentLog(m.name + " saw you come near and spoke first."); }catch(e){}
}
/* ══ 20261016f · a standing calendar (it meets whether or not you do), the rooms open to every office, and a Senate full of senators ══ */
{ const _oa = outsideAllowed; outsideAllowed = function(id){ if(id === "caucus" || id === "committee") return true; try{ if(G.you && !G.you.out && id === homeRoom()) return true; }catch(e){} return _oa.apply(this, arguments); }; }
const STD = {last:-1, live:0, noted:{}, said:{}};
const STD_TOPIC = {ways:["the revenue schedule", "the tariff on grain", "the bread subsidy"], judic:["the sentencing provisions", "the powers of the Marshal", "the appeal rules"], armed:["the border garrison", "the cost of the new cutters", "the veterans' pensions"], health:["the miners' relief fund", "the clinic grants", "the fever hospitals"]};
function stdHost(kind, party, com){
  const M = (G.members || []).filter(m => m && !m.gone && m.kind === "member");
  if(kind === "caucus") return M.find(m => m.post === "whip" && m.party === party) || M.find(m => m.party === party) || null;
  const c = M.find(m => m.post === com); if(c) return c;
  return M.filter(m => m.cmte === com).sort((a, b) => ((b.influence || b.infl || 0) - (a.influence || a.infl || 0)))[0] || null;
}
function stdEntries(day){
  day = day || G.day; const w = (day - 1) % 7, out = [];
  if(w > 3) return out;
  const party = w % 2 === 0 ? "FED" : "COM", pl = (function(){ try{ return partyLabel(party); }catch(e){ return party; } })();
  out.push({id:"caucus", day, room:"caucus", s:9, e:10, kind:"caucus", party, title:pl + " conference", topic:"the line for the day"});
  [[10, 12, w % 4], [14, 16, (w + 2) % 4]].forEach(a => { const c = COMMITTEES[a[2]], tp = STD_TOPIC[c.k] || ["the estimates"]; out.push({id:"cm" + a[0], day, room:"committee", s:a[0], e:a[1], kind:"hearing", com:c.k, title:c.t + " hearing", topic:tp[(day + a[0]) % tp.length]}); });
  out.push({id:"brief", day, room:"press", s:13, e:14, kind:"brief", title:"The daily briefing", topic:"what the day has done to the count"});
  out.push({id:"senate", day, room:"senate", s:11, e:13, kind:"sits", title:"The Senate sits", topic:"the calendar", info:true});
  if(w === 1 || w === 3) out.push({id:"court", day, room:"court", s:10, e:12, kind:"argument", title:"The Court hears argument", topic:"the docket", info:true});
  out.forEach(e => { e.key = day + ":" + e.id; e.host = null; });
