    addBox(matCol(0x6b4d2c,.75), 3.15, deckY + 1.12, facadeZ - 1.48, 0.78, 0.08, 0.70, 0, true);
    }catch(e){ if(window.console) console.warn("room steps", e); }
  }
  if(id === "district"){
