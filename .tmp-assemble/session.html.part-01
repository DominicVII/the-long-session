/* Marble columns look like static with derived normals — skip them. */
function matTexNoNormal(tex, rx, ry, rough, col){
  rx = qrep(rx); ry = qrep(ry);
  const _k = "nn|"+(tex.uuid||"t")+"|"+rx+"|"+ry+"|"+(rough===undefined?0.85:rough)+"|"+(col===undefined?"x":col);
  if(MATCACHE.has(_k)) return MATCACHE.get(_k);
  const t = tex.clone(); t.needsUpdate = true; t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rx,ry);
  const _m = new THREE.MeshStandardMaterial({map:t, roughness:rough===undefined?0.85:rough, metalness:0.02,
                color:col===undefined?0xffffff:col});
  _m._shared = true;
  MATCACHE.set(_k, _m);
  return _m;
}
const COLCACHE = new Map();
function matCol(col, rough, metal){
  const k = col+"|"+(rough===undefined?0.8:rough)+"|"+(metal||0);
  if(COLCACHE.has(k)) return COLCACHE.get(k);
  const m = new THREE.MeshStandardMaterial({color:col, roughness:rough===undefined?0.8:rough, metalness:metal||0});
  m._shared = true;
  nmApply(m, col, rough, metal, k);
  COLCACHE.set(k, m);
  return m;
}

/* ── Cloth for Congress outfits ───────────────────────────
   Flat matCol read as pixelated slabs up close. These are soft
   weave / twill maps (linear filtered, not nearest) tinted by
   the person's suit/shirt colour. */
const CLOTHCACHE = new Map();
function ensureClothTex(){
  if(TEX.wool && TEX.cotton && TEX.twill) return;
  const sz = (G.gfx === "simple") ? 128 : (G.gfx === "balanced") ? 192 : 256;
  TEX.wool = texCanvas(sz, (c,s) => {
    /* Soft wool — low-frequency weave, not 1px noise (reads as pixelation). */
    const img = c.createImageData(s,s), d = img.data;
    for(let y=0;y<s;y++){
      for(let x=0;x<s;x++){
        const i = (y*s+x)*4;
        const cell = ((x>>2) + (y>>2)) & 1;
        const wave = Math.sin(x*0.35)*3 + Math.sin(y*0.28)*2;
        const diag = ((x + y*2) >> 3) & 1 ? 5 : -4;
        const v = 122 + cell*16 + wave*2 + diag*2 + (((x*7 + y*13) % 5) - 2) * 3;   /* 20261030ag: weave reads at room distance */
        d[i]=d[i+1]=d[i+2]=Math.max(78, Math.min(172, v|0)); d[i+3]=255;
      }
    }
    c.putImageData(img,0,0);
  });
  TEX.cotton = texCanvas(sz, (c,s) => {
    const img = c.createImageData(s,s), d = img.data;
    for(let y=0;y<s;y++){
      for(let x=0;x<s;x++){
        const i = (y*s+x)*4;
        const v = 198 + Math.sin(x*0.55)*3 + Math.sin(y*0.5)*2 + (((x>>2)^(y>>2))&1);
        d[i]=d[i+1]=Math.max(175, Math.min(220, v|0)); d[i+2]=d[i]-2; d[i+3]=255;
      }
    }
    c.putImageData(img,0,0);
  });
  TEX.twill = texCanvas(sz, (c,s) => {
    const img = c.createImageData(s,s), d = img.data;
    for(let y=0;y<s;y++){
      for(let x=0;x<s;x++){
        const i = (y*s+x)*4;
        const t = ((x + y*2) % 8) < 4 ? 1 : 0;
        const v = 104 + t*24 + Math.sin((x+y)*0.2)*5;
        d[i]=d[i+1]=d[i+2]=Math.max(85, Math.min(150, v|0)); d[i+3]=255;
      }
    }
    c.putImageData(img,0,0);
  });
  [TEX.wool, TEX.cotton, TEX.twill].forEach(t => {
    if(!t) return;
    /* MAX OPT 20260921b: Simple only — no mips on shared cloth maps. */
    const cheap = G.gfx === "simple";
    if(cheap){
      t.generateMipmaps = false;
      t.minFilter = THREE.LinearFilter;
      t.magFilter = THREE.LinearFilter;
      t.anisotropy = 1;
    } else {
      t.minFilter = THREE.LinearMipmapLinearFilter;
      t.magFilter = THREE.LinearFilter;
      t.generateMipmaps = true;
      try{
        t.anisotropy = (renderer && renderer.capabilities)
          ? Math.min(8, renderer.capabilities.getMaxAnisotropy()) : 4;
      }catch(e){ t.anisotropy = 4; }
    }
    t.needsUpdate = true;
  });
}
function suitShift(col, d){
  const r = (col>>16)&255, g = (col>>8)&255, b = col&255;
  const f = x => Math.max(0, Math.min(255, (x + d)|0));
  return (f(r)<<16)|(f(g)<<8)|f(b);
}
function matCloth(col, kind, rough){
  ensureClothTex();
  const tex = kind === "shirt" ? TEX.cotton : (kind === "skirt" ? TEX.twill : TEX.wool);
  const rx = kind === "shirt" ? 2.0 : (kind === "skirt" ? 1.8 : 2.4);
  const ry = kind === "shirt" ? 2.6 : (kind === "skirt" ? 2.2 : 3.0);
  const r0 = rough === undefined ? (kind === "shirt" ? 0.82 : 0.88) : rough;
  const k = "cloth|"+col+"|"+kind+"|"+r0+"|"+qrep(rx)+"|"+qrep(ry)+"|"+(G.gfx||"");
  if(CLOTHCACHE.has(k)) return CLOTHCACHE.get(k);
  const t = tex.clone();
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.repeat.set(qrep(rx), qrep(ry));
  /* MAX OPT 20260921b: Simple only — cloth clones skip mipmaps. */
  const cheapCloth = G.gfx === "simple";
  if(cheapCloth){
    t.generateMipmaps = false;
    t.minFilter = THREE.LinearFilter;
    t.magFilter = THREE.LinearFilter;
    t.anisotropy = 1;
  } else {
    t.minFilter = THREE.LinearMipmapLinearFilter;
    t.magFilter = THREE.LinearFilter;
    t.generateMipmaps = true;
    try{
      t.anisotropy = (renderer && renderer.capabilities)
        ? Math.min(8, renderer.capabilities.getMaxAnisotropy()) : 4;
    }catch(e){ t.anisotropy = 4; }
  }
  t.needsUpdate = true;
  const opts = {
    map: t,
    color: col,
    roughness: r0,
    metalness: 0.02
  };
  if(G.gfx === "best"){
    try{
      const n = normalMapFrom(tex, kind === "shirt" ? 1.1 : 1.6);
      if(n){
        const nc = n.clone();
        nc.wrapS = nc.wrapT = THREE.RepeatWrapping;
        nc.repeat.set(qrep(rx), qrep(ry));
        opts.normalMap = nc;
        opts.normalScale = new THREE.Vector2(0.85, 0.85);
      }
    }catch(e){}
  }
  if(G.gfx !== "simple"){ try{ opts.roughnessMap = nbCrease(); }catch(e){} }
  /* 20261030ag: realism. Cloth is never mirror-smooth: matte, with a soft sheen of room light at the folds. */
  opts.roughness = Math.max(opts.roughness, 0.9);
  const m = new THREE.MeshStandardMaterial(opts);
  try{ if(typeof NM !== "undefined" && NM.env && G.gfx !== "simple"){ m.envMap = NM.env; m.envMapIntensity = 0.16; } }catch(e){}
  m._shared = true;
  CLOTHCACHE.set(k, m);
  return m;
}
/* Emissive screen / glow — hex emissive (not Color ctor) so r128 and later agree.
   One-off (not _shared) so clearRoom can dispose without mutating matCol cache. */
function matGlow(col, em, intensity, rough, metal){
  const m = new THREE.MeshStandardMaterial({
    color: col,
    roughness: rough === undefined ? 0.55 : rough,
    metalness: metal || 0,
    emissive: em || 0x000000,
    emissiveIntensity: intensity === undefined ? 0.35 : intensity
  });
  m._shared = false; /* one-off; clearRoom may dispose mat but not shared emissive maps */
  return m;
}
function addBox(mat, x,y,z, w,h,d, ry, noShadow){
  const m = new THREE.Mesh(UNIT.box, mat);
  m.position.set(x,y,z); m.scale.set(w,h,d); if(ry) m.rotation.y = ry;
  m.castShadow = !noShadow; m.receiveShadow = true;
  m.updateMatrix(); m.matrixAutoUpdate = false;
  roomGroup.add(m); return m;
}
function addCyl(mat, x,y,z, r,h, ry){
  const m = new THREE.Mesh(UNIT.cyl, mat);
  m.position.set(x,y,z); m.scale.set(r*2,h,r*2); if(ry) m.rotation.y = ry;
  m.castShadow = true; m.receiveShadow = true;
  m.updateMatrix(); m.matrixAutoUpdate = false;
  roomGroup.add(m); return m;
}
function plantTree(x, z, trunkH, canopyR){
  trunkH = trunkH || 2.6;
  canopyR = canopyR || 1.2;
  const trunkR = 0.11 + canopyR * 0.04;
  addCyl(matCol(0x4a3828,.95), x, trunkH * 0.48, z, trunkR, trunkH);
  nbSwayAdd(addSphere(matCol(0x3a6a32,.95), x, trunkH + canopyR * 0.22, z, canopyR * 1.05, canopyR * 0.92, canopyR * 1.05), canopyR * 0.025);
  if(!MODEST){
    nbSwayAdd(addSphere(matCol(0x4a7a3c,.95), x + canopyR * 0.28, trunkH + canopyR * 0.02, z - canopyR * 0.12, canopyR * 0.62, canopyR * 0.55, canopyR * 0.62), canopyR * 0.04);
    nbSwayAdd(addSphere(matCol(0x2f5a28,.95), x - canopyR * 0.22, trunkH + canopyR * 0.08, z + canopyR * 0.18, canopyR * 0.52, canopyR * 0.48, canopyR * 0.52), canopyR * 0.045);
  }
}
function propStreetLamp(x, z, h){
  h = h || 3.5;
  addCyl(matCol(0x3a414c,.55), x, 0.10, z, 0.16, 0.20);
  addCyl(matCol(0x3f4650,.55), x, h * 0.48, z, 0.065, h * 0.92);
  addCyl(matCol(0x2a3038,.5), x, h - 0.08, z, 0.10, 0.10);
  const gl = addSphere(new THREE.MeshStandardMaterial({
    color:0xfff2d4, roughness:.5, emissive:new THREE.Color(0xffe0aa), emissiveIntensity:0.9
  }), x, h, z, 0.13);
  gl.castShadow = false;
}
function propParkBench(x, z, ry){
  const g = new THREE.Group(); g.position.set(x,0,z); g.rotation.y = ry||0; roomGroup.add(g);
  const wood = matCol(0x6b5340,.75), iron = matCol(0x2a2d33,.5);
  const put = (m,px,py,pz,sx,sy,sz) => {
    const e = new THREE.Mesh(UNIT.box, m);
    e.position.set(px,py,pz); e.scale.set(sx,sy,sz); g.add(e); return e;
  };
  put(iron, -0.62, 0.22, 0, 0.06, 0.44, 0.42);
  put(iron,  0.62, 0.22, 0, 0.06, 0.44, 0.42);
  put(wood, 0, 0.28, 0.02, 1.32, 0.05, 0.40);
  put(wood, 0, 0.54, -0.16, 1.32, 0.34, 0.06);
  return groundGroup(g, 0.7);
}
function propStorefront(x, z, bw, bh, col, title, sub){
  const stone = matCol(col, .92);
  const trim = matCol(0x3a342c, .62);
  const glass = matCol(0x7aa0b8, .22, .12);
  addBox(stone, x, bh/2, z, bw, bh, 1.15);
  nbStorefront(x, z, bw, bh, col);
  addBox(trim, x, bh + 0.09, z, bw + 0.16, 0.18, 1.28);
  addBox(matCol(0xc4beb0,.86), x, 0.08, z - 0.62, bw + 0.4, 0.16, 0.55); /* sidewalk apron */
  const n = bw > 3.6 ? 3 : 2;
  for(let i=0;i<n;i++){
    const wx = x - (n-1)*0.55 + i*1.10;
    addBox(trim, wx, 1.55, z - 0.60, 0.72, 0.92, 0.06);
    addBox(glass, wx, 1.55, z - 0.64, 0.58, 0.76, 0.03);
  }
  addBox(matCol(0x3a2a1c,.68), x, 0.58, z - 0.62, 0.46, 1.16, 0.06);
  addBox(matCol(0xc9a24a,.4,.7), x + 0.16, 0.62, z - 0.66, 0.04, 0.04, 0.04);
  if(title) try{ propPlaque(x, bh - 0.22, z - 0.62, 0, title, sub || "", Math.min(1.35, bw*0.42), 0.26); }catch(e){}
  if(title) try{ nmSign(x, bh, z, bw, title); }catch(e){}
}
function playerCreed(){
  try{ return creedOf((G.you && G.you.creed) || "latin"); }catch(e){ return creedOf("latin"); }
}
function propChurch(x, z){
  const cr = playerCreed();
  const k = (cr && cr.k) || "latin";
  const stone = matCol(0xc3bfb4,.86);
  const brick = matCol(0x8a6b55,.90);
  const dark = matCol(0x3a2a1c,.70);
  const gilt = matCol(0xc9a24a,.35,.70);
  if(k === "none"){
    addBox(matCol(0x6a6560,.92), x, 0.08, z, 4.2, 0.16, 2.4, 0, true);
    addBox(matCol(0x5a554c,.90), x, 1.1, z, 3.6, 2.2, 1.1, 0, true);
    addBox(matCol(0x4a453e,.88), x, 2.35, z, 3.9, 0.28, 1.3, 0, true);
    addBox(dark, x, 0.58, z - 0.58, 0.46, 1.16, 0.06, 0, true);
    try{ propPlaque(x, 2.15, z - 0.62, 0, "THE OLD CHURCH", "Used for recitals", 1.22, 0.24); }catch(e){}
    return;
  }
  if(k === "circle"){
    addCyl(stone, x, 0.16, z, 2.2, 0.32);
    addCyl(matCol(0xd8d0c0,.88), x, 1.55, z, 1.85, 2.6);
    addCyl(gilt, x, 2.95, z, 1.95, 0.12);
    try{ propPlaque(x, 2.2, z - 1.72, 0, "OPEN CIRCLE", cr.adj, 1.15, 0.24); }catch(e){}
    return;
  }
  if(k === "self"){
    addBox(matCol(0xe8e4d8,.90), x, 1.7, z, 4.0, 3.4, 1.3, 0, true);
    addBox(matCol(0x7aa0b8,.22,.12), x, 1.8, z - 0.66, 3.2, 2.2, 0.06, 0, true);
    addBox(matCol(0x1a1a1a,.40), x, 3.55, z, 4.2, 0.12, 1.4, 0, true);
    try{ propPlaque(x, 3.15, z - 0.70, 0, "THE SELF", "Members only", 1.10, 0.24); }catch(e){}
    return;
  }
  if(k === "study"){
    addBox(brick, x, 1.7, z, 3.8, 3.4, 1.25, 0, true);
    addBox(matCol(0x2a3848,.85), x, 3.55, z, 4.0, 0.18, 1.4, 0, true);
    addBox(dark, x, 0.58, z - 0.64, 0.46, 1.16, 0.06, 0, true);
    try{ propPlaque(x, 3.10, z - 0.68, 0, "LATEST STUDY", "Revised weekly", 1.15, 0.24); }catch(e){}
    return;
  }
  if(k === "flame"){
    addBox(stone, x, 1.85, z, 3.6, 3.7, 1.2, 0, true);
    addBox(stone, x, 3.85, z, 3.8, 0.22, 1.35, 0, true);
    addCyl(matCol(0xa9aea6,.85), x, 5.05, z, 0.07, 2.2);
    addBox(matCol(0x3a4a72,.80), x + 0.32, 5.85, z, 0.70, 0.42, 0.04, 0, true);
    addBox(dark, x, 0.58, z - 0.62, 0.46, 1.16, 0.06, 0, true);
    try{ propPlaque(x, 3.15, z - 0.68, 0, "CIVIC FLAME", "Carried, not kept", 1.10, 0.24); }catch(e){}
    return;
  }
  if(k === "green"){
    addBox(matCol(0x6a5840,.90), x, 1.55, z, 3.5, 3.1, 1.2, 0, true);
    addBox(matCol(0x3f6a34,.95), x, 3.25, z, 3.8, 0.28, 1.4, 0, true);
    addBox(dark, x, 0.58, z - 0.64, 0.46, 1.16, 0.06, 0, true);
    try{ propPlaque(x, 2.85, z - 0.66, 0, "GREEN HOUSE", cr.adj, 1.05, 0.24); }catch(e){}
    return;
  }
  if(k === "poll"){
    addBox(matCol(0xd0d4d8,.88), x, 1.7, z, 3.6, 3.4, 1.15, 0, true);
    addBox(matCol(0x2b3f52,.30), x, 2.0, z - 0.58, 2.6, 1.6, 0.05, 0, true);
    try{ propPlaque(x, 3.15, z - 0.66, 0, "THE NUMBERS", "±3.4%", 1.05, 0.24); }catch(e){}
    return;
  }
  if(k === "kerk"){
    addBox(brick, x, 1.7, z, 3.4, 3.4, 1.15, 0, true);
    addCyl(stone, x, 4.2, z, 0.22, 1.6);
    addBox(matCol(0x2a2a28,.70), x, 5.15, z, 0.08, 0.55, 0.08, 0, true);
    addBox(dark, x, 0.58, z - 0.60, 0.46, 1.16, 0.06, 0, true);
    try{ propPlaque(x, 3.05, z - 0.62, 0, "HERVORMDE KERK", "Anno 1618", 1.15, 0.24); }catch(e){}
    return;
  }
  addBox(stone, x, 1.85, z, 3.5, 3.7, 1.2, 0, true);
  addBox(stone, x, 3.85, z, 3.7, 0.22, 1.35, 0, true);
  addCyl(stone, x, 5.15, z, 0.28, 2.2);
  addBox(matCol(0x8a2f36,.80), x, 6.35, z, 0.85, 0.18, 0.85, 0, true);
  if(k === "consul"){
    addBox(gilt, x, 6.72, z - 0.18, 0.22, 0.22, 0.06, 0, true);
    try{ propPlaque(x, 3.15, z - 0.68, 0, "CONSULAR CHAPEL", "The First Consul", 1.18, 0.24); }catch(e){}
  } else {
    addBox(gilt, x, 6.75, z - 0.20, 0.06, 0.55, 0.06, 0, true);
    addBox(gilt, x, 6.88, z - 0.20, 0.28, 0.06, 0.06, 0, true);
    try{ propPlaque(x, 3.15, z - 0.68, 0, "ST. BRIGID", "Latin Rite", 1.05, 0.24); }catch(e){}
  }
  addBox(matCol(0x8a2f36,.75), x, 0.58, z - 0.62, 0.50, 1.16, 0.08, 0, true);
}
function addPlane(mat, x,y,z, w,h, rx,ry){
  const m = new THREE.Mesh(UNIT.plane, mat);
  m.position.set(x,y,z); m.scale.set(w,h,1);
  m.rotation.set(rx||0, ry||0, 0);
  m.receiveShadow = true;
  m.updateMatrix(); m.matrixAutoUpdate = false;
  roomGroup.add(m); return m;
}

/* ── the prop library: things a real room has in it ─────────
   Everything in this building is built to the size it would actually
   be. A desk you write at is seventy-four centimetres whatever room
   it is in; a seat you sit on is forty-five; a lectern you read from
   is one twelve. Get these wrong by a third and every person in the
   room looks like a giant standing over doll's furniture. */
const DIM = {
  seat:0.45, back:0.94, desk:0.74, table:0.74,
  bench:0.45, benchDesk:0.76, counter:1.00, stool:0.75,
  lectern:1.12, dais:1.05, daisFloor:0.30
};
/* Drop a furniture group so its lowest point sits on the room floor (y=0),
   and plant a soft contact disc so feet read as on the ground. */
function groundGroup(g, padScale, restY){
  if(!g) return g;
  g.userData = g.userData || {};
  if(g.userData.noTidy) return g;
  g.userData.groundedProp = true;
  const floor = (restY != null && isFinite(restY)) ? restY
              : (isFinite(g.userData.restY) ? g.userData.restY : 0);
  g.userData.restY = floor;
  try{
    g.updateWorldMatrix(true, true);
    const box = new THREE.Box3().setFromObject(g);
    if(isFinite(box.min.y) && Math.abs(box.min.y - floor) > 0.0008){
      g.position.y -= (box.min.y - floor);
    }
    /* one contact blob per grounded prop — shared CONTACT mat */
    if(typeof CONTACT !== "undefined" && CONTACT && UNIT && UNIT.plane){
      let has = false;
      for(let i=0;i<g.children.length;i++){
        if(g.children[i] && g.children[i].userData && g.children[i].userData.contact){ has = true; break; }
      }
      if(!has){
        const cs = new THREE.Mesh(UNIT.plane, CONTACT);
        cs.rotation.x = -Math.PI / 2;
        cs.position.set(0, 0.006, 0);
        const sx = isFinite(box.max.x) ? (box.max.x - box.min.x) : 0.6;
        const sz = isFinite(box.max.z) ? (box.max.z - box.min.z) : 0.6;
        const span = Math.max(0.4, Math.min(2.8, Math.max(sx, sz) * (padScale || 0.62)));
        cs.scale.set(span, span, 1);
        cs.castShadow = false; cs.receiveShadow = false;
        cs.renderOrder = -2;
        cs.userData.contact = true;
        g.add(cs);
      }
    }
  }catch(e){}
  return g;
}
function groundFloorMesh(m){
  /* Single mesh (addBox/addCyl) that should rest on the floor: shift so bottom = 0. */
  if(!m) return m;
  try{
    const hy = Math.abs(m.scale.y) * 0.5;
    const bottom = m.position.y - hy;
    if(Math.abs(bottom) > 0.001) m.position.y -= bottom;
  }catch(e){}
  return m;
}
/* Final room pass for compound furniture: keep every group on the floor and
   drop accidental duplicate placements without touching walls, floors, or
   other single-mesh architectural details. */
function tidyRoomFurniture(){
  if(!roomGroup) return;
  if(MODEST){
    const kids = roomGroup.children;
    for(let i = 0; i < kids.length; i++){
      const g = kids[i];
      if(!g || !g.isGroup || !g.userData || !g.userData.groundedProp) continue;
      try{ groundGroup(g, 0.68, g.userData.restY || 0); }catch(e){}
    }
    return;
  }
  const seen = new Set();
  const remove = [];
  roomGroup.children.slice().forEach(g => {
    if(!g || !g.isGroup || g.userData && (g.userData.noTidy || !g.userData.groundedProp)) return;
    try{
      /* Re-run the grounding calculation after all child meshes are present.
         This catches late-added props in the House floor instead of leaving
         their contact shadow or one leaf hovering above the floor. */
      groundGroup(g, 0.68, g.userData.restY || 0);
      g.updateWorldMatrix(true, true);
      const box = new THREE.Box3().setFromObject(g);
      if(!isFinite(box.min.y) || !isFinite(box.max.y)) return;
      const c = box.getCenter(new THREE.Vector3());
      const s = box.getSize(new THREE.Vector3());
      const key = [c.x,c.y,c.z,s.x,s.y,s.z].map(v => Math.round(v*100)/100).join("|");
      if(seen.has(key)) remove.push(g); else seen.add(key);
    }catch(e){}
  });
  remove.forEach(g => roomGroup.remove(g));
}
function freezeStaticRoom(){
  /* Furniture never moves after build — skip per-frame matrix walks.
     Furniture does not cast: people read as people, the room stays cheap. */
  if(!roomGroup) return;
  try{
    roomGroup.updateMatrixWorld(true);
    const live = new Set();
    const keepUp = o => { let n = o; while(n && n !== roomGroup){ live.add(n); n = n.parent; } };
    const ticks = (typeof TICKERS !== "undefined" && TICKERS) ? TICKERS : [];
    for(const t of ticks){
      for(const part of [t.hour, t.min, t.g]){
        if(!part) continue;
        keepUp(part);
        try{ part.traverse(c => live.add(c)); }catch(e){}
      }
    }
    const shadows = !!(renderer && renderer.shadowMap && renderer.shadowMap.enabled);
    roomGroup.traverse(o => {
      if(!o || o.isSkinnedMesh) return;
      if(o.isLight) return;
      if(live.has(o)){ o.matrixAutoUpdate = true; return; }
      o.updateMatrix();
      o.matrixAutoUpdate = false;
      o.frustumCulled = true;
      if(o.isMesh){
        o.castShadow = false;
        if(!shadows) o.receiveShadow = false;
      }
    });
    roomGroup.frustumCulled = false;
    roomGroup.matrixAutoUpdate = false;
  }catch(e){}
}
/* a desk with legs, its top at writing height */
function propDesk(topMat, legMat, x, z, w, dp, ry, h){
  /* chamber desk: thick top, full apron, paneled legs, drawer face */
  const g = new THREE.Group(); g.position.set(x,0,z); g.rotation.y = ry||0; roomGroup.add(g);
  const H = h || DIM.desk;
  const put = (m,px,py,pz,sx,sy,sz) => {
    const e = new THREE.Mesh(UNIT.box, m);
    e.position.set(px,py,pz); e.scale.set(sx,sy,sz);
    e.castShadow = true; e.receiveShadow = true; g.add(e); return e;
  };
  /* underside slab + polished cap so the edge reads as thickness */
  put(legMat, 0, H - 0.055, 0, w*0.98, 0.055, dp*0.98);
  put(topMat, 0, H - 0.012, 0, w, 0.028, dp);
  /* slight overhang lip at the front edge */
  put(topMat, 0, H - 0.006, dp/2 + 0.01, w*0.995, 0.014, 0.04);
  /* apron on four sides */
  const apronH = Math.min(0.14, H*0.22);
  const apronY = H - 0.07 - apronH/2;
  put(legMat, 0, apronY,  dp/2 - 0.025, w*0.96, apronH, 0.04);
  put(legMat, 0, apronY, -dp/2 + 0.025, w*0.96, apronH, 0.04);
  put(legMat, -w/2 + 0.03, apronY, 0, 0.04, apronH, dp*0.88);
  put(legMat,  w/2 - 0.03, apronY, 0, 0.04, apronH, dp*0.88);
  /* drawer face under the front apron (reads as furniture, not a slab) */
  if(w > 0.9){
    put(legMat, 0, H - 0.22, dp/2 - 0.01, Math.min(w*0.42, 0.85), 0.09, 0.03);
    put(topMat, 0, H - 0.22, dp/2 + 0.01, 0.06, 0.025, 0.02); /* knob hint */
  }
  /* paneled legs from the floor up + foot blocks planted on y=0 */
  const lx = w/2 - 0.08, lz = dp/2 - 0.08;
  const footH = 0.045;
  const legH = Math.max(0.2, H - 0.09 - footH);
  [[-lx,-lz],[lx,-lz],[-lx,lz],[lx,lz]].forEach(p => {
    put(legMat, p[0], footH + legH/2, p[1], 0.075, legH, 0.075);
    put(legMat, p[0], footH/2, p[1], 0.10, footH, 0.10); /* foot on the floor */
  });
  /* cross stretcher near the floor for long desks */
  if(w > 1.4){
    put(legMat, 0, footH + 0.06, 0, w - 0.22, 0.035, 0.04);
    put(legMat, 0, footH + 0.06, 0, 0.04, 0.035, dp - 0.22);
  }
  return groundGroup(g, 0.7);
}
/* A small, self-contained laptop that sits on the desk surface instead of
   floating like the old monitor blocks. Local coordinates keep it aligned
   when the desk is rotated in committee, press, or district rooms. */
function propLaptop(x, z, ry, deskH){
  const g = new THREE.Group();
  g.position.set(x, deskH === undefined ? DIM.desk : deskH, z);
  g.rotation.y = ry || 0;
  g.userData.noTidy = true;
  roomGroup.add(g);
  const body = matCol(0x242a31, .42, .45);
  const screen = matCol(0x314d68, .28, .25);
  const trim = matCol(0x9b8150, .38, .72);
  const put = (m, px, py, pz, sx, sy, sz, rx) => {
    const e = new THREE.Mesh(UNIT.box, m);
    e.position.set(px,py,pz); e.scale.set(sx,sy,sz);
    if(rx) e.rotation.x = rx;
    e.castShadow = true; e.receiveShadow = true; g.add(e); return e;
  };
  put(body, 0, 0.018, 0, 0.46, 0.035, 0.34);
  put(trim, 0, 0.039, 0.035, 0.28, 0.008, 0.16);
  /* screen rises from the rear hinge and leans back toward the user.
     The user sits at +z (the touchpad is at +0.035), so the lit panel
     belongs on the lid's +z face — behind it, the lid is all you see. */
  put(body, 0, 0.19, -0.145, 0.46, 0.32, 0.028, -0.10);
  put(screen, 0, 0.19, -0.127, 0.39, 0.25, 0.008, -0.10);
  return g;
}
/* a long bench with a back */
function propBench(seatMat, woodMat, x, z, w, dp, ry){
  /* legislative bench: wood carcass, padded seat+back, end standards, supports */
  const g = new THREE.Group(); g.position.set(x,0,z); g.rotation.y = ry||0; roomGroup.add(g);
  const put = (m,px,py,pz,sx,sy,sz) => {
    const e = new THREE.Mesh(UNIT.box, m);
    e.position.set(px,py,pz); e.scale.set(sx,sy,sz);
    e.castShadow = true; e.receiveShadow = true; g.add(e); return e;
  };
  const seatY = DIM.seat;
  const backH = DIM.back - seatY;
  /* wood seat plank under the cushion */
  put(woodMat, 0, seatY - 0.07, 0.02, w, 0.05, dp + 0.04);
  /* padded seat (slightly proud) */
  put(seatMat, 0, seatY - 0.02, 0.02, w * 0.985, 0.07, dp);
  /* front skirt / kickboard */
  put(woodMat, 0, (seatY - 0.08)/2, dp/2 - 0.02, w, seatY - 0.08, 0.055);
  /* rear stile + padded back panel + top rail */
  put(woodMat, 0, seatY + backH*0.42, -dp/2 + 0.03, w, backH*0.78, 0.045);
  put(seatMat, 0, seatY + backH*0.38, -dp/2 + 0.06, w * 0.97, backH*0.62, 0.055);
  put(woodMat, 0, DIM.back - 0.04, -dp/2 + 0.04, w + 0.02, 0.06, 0.07); /* crest rail */
  /* end standards (arms / uprights) — reads as chamber furniture at any length */
  const endX = w/2 - 0.04;
  for(const sx of [-endX, endX]){
    put(woodMat, sx, DIM.back/2, -0.02, 0.07, DIM.back - 0.02, dp + 0.08);
    put(woodMat, sx, seatY + 0.12, dp/2 - 0.06, 0.08, 0.06, 0.16); /* arm stub */
  }
  /* intermediate legs under long benches so the span does not float */
  const spans = Math.max(1, Math.round(w / 2.2));
  for(let i=0;i<=spans;i++){
    const t = spans === 0 ? 0 : (i/spans - 0.5);
    const px = t * (w - 0.2);
    put(woodMat, px, (seatY - 0.05)/2, -dp/2 + 0.08, 0.06, seatY - 0.05, 0.06);
    put(woodMat, px, (seatY - 0.05)/2,  dp/2 - 0.08, 0.06, seatY - 0.05, 0.06);
  }
  /* kickboard already from y=0 — plant contact + snap any float */
  return groundGroup(g, 0.85);
}

const TICKERS = [];              /* props that move: clock hands, fans */
const ROOMLIGHTS = [];           /* practical lights added per room */
const MAX_ROOM_LIGHTS = (typeof MODEST !== "undefined" && MODEST) ? 2 : 4;
function relinkRoomRefs(){
  /* 20261011a: lights/tickers follow the group they live in (kits stash and return them). */
  ROOMLIGHTS.length = 0; TICKERS.length = 0;
  try{
    roomGroup.traverse(o => {
      const u = o.userData; if(!u) return;
      if(u._roomLight) ROOMLIGHTS.push(o);
      if(u._ticker) TICKERS.push(u._ticker);
    });
  }catch(e){}
  try{ lightKey = ""; lightT = 0; }catch(e){}
}
function pushRoomLight(L){
  try{ L.userData._roomLight = true; }catch(e){}
  if(ROOMLIGHTS.length >= MAX_ROOM_LIGHTS){
    /* Fixture may still glow via emissive mesh; skip another point light. */
    return false;
  }
  roomGroup.add(L); ROOMLIGHTS.push(L);
  return true;
}
function addSphere(mat,x,y,z,rx,ry,rz){
  const m=new THREE.Mesh(UNIT.sph,mat);
  m.position.set(x,y,z); m.scale.set(rx*2,(ry||rx)*2,(rz||rx)*2);
  m.castShadow=true; m.receiveShadow=true; roomGroup.add(m); return m;
}
function propChair(mat, seatMat, x,z, ry, floorY){
  const rest = floorY || 0;
  const g=new THREE.Group(); g.position.set(x, rest, z); g.rotation.y=ry||0; roomGroup.add(g);
  g.userData.restY = rest;
  const put=(m,px,py,pz,sx,sy,sz)=>{ const e=new THREE.Mesh(UNIT.box,m);
    e.position.set(px,py,pz); e.scale.set(sx,sy,sz); e.castShadow=true; e.receiveShadow=true; g.add(e); return e; };
  put(seatMat, 0, DIM.seat-0.035, 0, 0.46,0.07,0.44);
  put(seatMat, 0, (DIM.seat+DIM.back)/2, -0.19, 0.44, DIM.back-DIM.seat, 0.055);
  const legH = DIM.seat - 0.07;
  [[-0.19,-0.18],[0.19,-0.18],[-0.19,0.18],[0.19,0.18]].forEach(p => {
    put(mat, p[0], legH/2, p[1], 0.045, legH, 0.045);
    put(mat, p[0], 0.02, p[1], 0.06, 0.04, 0.06); /* foot pad on floor */
  });
  return groundGroup(g, 0.55, rest);
}
/* a lectern: a narrow stand with a sloped top you read from */
function propLectern(woodMat, trimMat, x, z, ry){
  const g = new THREE.Group(); g.position.set(x,0,z); g.rotation.y = ry||0; roomGroup.add(g);
  const put = (m,px,py,pz,sx,sy,sz,rx) => {
    const e = new THREE.Mesh(UNIT.box, m);
    e.position.set(px,py,pz); e.scale.set(sx,sy,sz);
    if(rx) e.rotation.x = rx;
    e.castShadow = true; e.receiveShadow = true; g.add(e); return e;
  };
  /* Lectern body: tall central stand. The base (sy=0.07) must reach y=0. */
  put(woodMat, 0, (DIM.lectern-0.10)/2, 0, 0.50, DIM.lectern-0.10, 0.36);
  /* Base plate: sitting on the floor. py=0.035, sy=0.07 → spans y=[0, 0.07] */
  put(woodMat, 0, 0.035, 0, 0.62, 0.07, 0.48, 0);
  /* Lower panel (sloped back face) */
  put(woodMat, 0, DIM.lectern - 0.03, 0.02, 0.62, 0.05, 0.42, -0.18);
  /* Trim accent at top edge */
  put(trimMat, 0, DIM.lectern - 0.10, 0.21, 0.60, 0.035, 0.035, 0);
  /* Drop the whole group so min(y) = 0, and plant a contact disc */
  return groundGroup(g, 0.5);
}
let SHELF_SPANS = [];
function propShelf(x,z,ry,w,h){
  try{ SHELF_SPANS.push({x, z, half: (w || 1.6) / 2 + 0.05}); }catch(e){}

  const g=new THREE.Group(); g.position.set(x,0,z); g.rotation.y=ry||0; roomGroup.add(g);
  const wood=matTex(TEX.panel,1,1,.52);
  const put=(m,px,py,pz,sx,sy,sz)=>{ const e=new THREE.Mesh(UNIT.box,m);
    e.position.set(px,py,pz); e.scale.set(sx,sy,sz); e.castShadow=true; e.receiveShadow=true; g.add(e); };
  /* open bookcase: back board, two sides, top, plinth, shelves, books in front of the back */
  put(wood,0,h/2,-0.13, w,h,0.04);
  put(wood,-w/2+0.02,h/2,0, 0.04,h,0.30);
  put(wood, w/2-0.02,h/2,0, 0.04,h,0.30);
  put(wood,0,h-0.02,0, w,0.04,0.30);
  put(wood,0,0.05,0.01, w-0.04,0.10,0.28);
  const rows=Math.max(2,Math.floor(h/0.42));
  const bk=matTex(TEX.books, Math.max(1,w*2.2), 1, .92);
  for(let i=0;i<rows;i++){
    const sy=0.10+i*(h-0.14)/rows;
    put(wood,0,sy+0.015,0.01, w-0.08,0.03,0.27);
    const bh=Math.min(0.30,(h-0.14)/rows-0.06);
    put(bk,0,sy+0.03+bh/2,-0.02, w-0.12,bh,0.20);
  }
  return groundGroup(g, 0.7);
}
function propCabinet(mat, trim, x, z, w, h, d, ry){
  const g = new THREE.Group();
  g.position.set(x,0,z); g.rotation.y = ry || 0; roomGroup.add(g);
  const put = (m,px,py,pz,sx,sy,sz) => {
    const e = new THREE.Mesh(UNIT.box,m);
    e.position.set(px,py,pz); e.scale.set(sx,sy,sz);
    e.castShadow = true; e.receiveShadow = true; g.add(e);
  };
  const hh = h || 1.05, ww = w || 0.58, dd = d || 0.62;
  put(mat, 0, hh/2, 0, ww, hh, dd);
  put(trim || mat, 0, hh + 0.025, 0, ww + 0.06, 0.05, dd + 0.05);
  const rows = 3, faceH = (hh - 0.16) / rows;
  for(let i=0;i<rows;i++){
    const y = 0.08 + faceH/2 + i*faceH;
    put(trim || mat, 0, y, dd/2 + 0.014, ww - 0.08, faceH - 0.025, 0.028);
    put(matCol(0xb08b45, .35, .8), 0, y, dd/2 + 0.034, 0.055, 0.018, 0.018);
  }
  [[-ww*.36,-dd*.34],[ww*.36,-dd*.34],[-ww*.36,dd*.34],[ww*.36,dd*.34]].forEach(p =>
    put(trim || mat, p[0], 0.025, p[1], 0.07, 0.05, 0.07));
  return groundGroup(g, 0.65);
}
function propRug(x,z,w,d,ry){
  const m=new THREE.Mesh(UNIT.plane, matTex(TEX.rug, 1,1, .98));
  m.rotation.x=-Math.PI/2; m.rotation.z=ry||0;
  m.position.set(x,0.003,z); m.scale.set(w,d,1);
  m.receiveShadow=true; roomGroup.add(m);
}
const PLANT_LEAF = new Map();
function plantLeafTex(){
  if(PLANT_LEAF.tex) return PLANT_LEAF.tex;
  const c = document.createElement("canvas"); c.width = c.height = 128; const x = c.getContext("2d");
  x.fillStyle = "#5e7f4c"; x.fillRect(0, 0, 128, 128);
  let sd = 7; const r = () => { sd = (sd * 16807) % 2147483647; return sd / 2147483647; };
  for(let i = 0; i < 140; i++){
    const px = r() * 128, py = r() * 128, a = r() * Math.PI, L = 7 + r() * 12, W = 2.5 + r() * 4, v = r();
    x.save(); x.translate(px, py); x.rotate(a);
    x.fillStyle = v < 0.33 ? "#3f5e32" : v < 0.66 ? "#6f9356" : "#86a865";
    x.beginPath(); x.ellipse(0, 0, L, W, 0, 0, Math.PI * 2); x.fill();
    x.strokeStyle = "rgba(30,45,22,0.55)"; x.lineWidth = 0.8; x.beginPath(); x.moveTo(-L, 0); x.lineTo(L, 0); x.stroke();
    x.restore();
  }
  const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(2, 2);
  try{ t.encoding = THREE.sRGBEncoding; }catch(e){}
  return (PLANT_LEAF.tex = t);
}
function plantLeafMat(seed){
  const k = Math.abs(Math.floor(seed)) % 4;
  if(PLANT_LEAF.has(k)) return PLANT_LEAF.get(k);
  const cols = [0xb8d0a4, 0xa8c48e, 0xc4d2a0, 0x9fbe94];
  const m = new THREE.MeshStandardMaterial({color:cols[k], roughness:1, metalness:0, flatShading:true});
  try{ if(G.gfx !== "simple") m.map = plantLeafTex(); }catch(e){}
  m.envMapIntensity = 0; m.userData.nmDone = true; m.userData.v30v = 1; m._shared = true;
  PLANT_LEAF.set(k, m); return m;
}
function x30FrondTex(){ return W30.frond || (W30.frond = (() => { const c = document.createElement("canvas"); c.width = 256; c.height = 128; const x = c.getContext("2d");
  let sd = 5; const r = () => { sd = (sd * 16807) % 2147483647; return sd / 2147483647; };
  x.strokeStyle = "#4e6a38"; x.lineWidth = 3; x.beginPath(); x.moveTo(4, 64); x.quadraticCurveTo(130, 58, 252, 66); x.stroke();
  for(let i = 0; i < 22; i++){ const t = 0.06 + i / 23 * 0.9, px = 4 + t * 248, L = (1 - Math.abs(t - 0.45) * 1.3) * 58 + 8;
    for(const sg of [-1, 1]){ x.save(); x.translate(px, 64); x.rotate(sg * (0.9 + r() * 0.25)); const v = r();
      x.fillStyle = v < 0.33 ? "#3f6230" : v < 0.66 ? "#5d8a45" : "#76a058"; x.beginPath(); x.ellipse(L / 2, 0, L / 2, 4.5 + r() * 2.5, 0, 0, Math.PI * 2); x.fill();
      x.strokeStyle = "rgba(30,48,20,0.6)"; x.lineWidth = 0.8; x.beginPath(); x.moveTo(0, 0); x.lineTo(L, 0); x.stroke(); x.restore(); } }
  const t = new THREE.CanvasTexture(c); try{ t.encoding = THREE.sRGBEncoding; t.anisotropy = 4; }catch(e){} return t; })()); }
function x30FrondMat(k){ W30.frondM = W30.frondM || {}; if(W30.frondM[k]) return W30.frondM[k];
  const m = new THREE.MeshStandardMaterial({color:[0xf2f6ea, 0xe4eed6, 0xf6f2dc][k], map:x30FrondTex(), alphaTest:0.5, side:THREE.DoubleSide, roughness:0.85, metalness:0});
  m.envMapIntensity = 0; m.userData.nmDone = true; m.userData.v30v = 1; m._shared = true; return (W30.frondM[k] = m); }
function propPlant(x,z,sc){
  sc = sc || 0.82;
  const g = new THREE.Group(); g.position.set(x,0,z); roomGroup.add(g);
  const pot = new THREE.Mesh(UNIT.cyl, matCol(0x6e5340,.82));
  pot.position.y = 0.13*sc; pot.scale.set(0.20*sc*2, 0.26*sc, 0.20*sc*2); g.add(pot);
  const dirt = new THREE.Mesh(UNIT.cyl, matCol(0x2a2218,.95));
  dirt.position.y = 0.26*sc; dirt.scale.set(0.16*sc*2, 0.04*sc, 0.16*sc*2); g.add(dirt);
  const stem = new THREE.Mesh(UNIT.cyl, matCol(0x4a5230,.95));
  stem.position.y = 0.36*sc; stem.scale.set(0.016*sc*2, 0.20*sc, 0.016*sc*2); g.add(stem);   /* 20261030ag: thin cane, hidden in the fronds */
  const leafM = plantLeafMat(x * 7.13 + z * 3.71);   /* 20261030ag: matte faceted leaves, not glossy clay */
  /* 20261030ag: a dark small core and many separate blades: foliage, not a clay ball (every machine) */
  const coreM = PLANT_LEAF.core || (PLANT_LEAF.core = (() => { const c = leafM.clone(); c.color.setHex(0x6f8a5e); c.userData.nmDone = true; c.userData.v30v = 1; c._shared = true; return c; })());
  const leafPts = [];   /* 20261030ag: no ball core at all: fronds only */ //   /* 20261030ag: core hidden inside the frond crown */
  leafPts.forEach(L => {
    const leaf = new THREE.Mesh(UNIT.sph, coreM);
    leaf.position.set(L[0]*sc, L[1]*sc, L[2]*sc);
    leaf.scale.set(L[3]*sc*2.1, L[3]*sc*1.35, L[3]*sc*1.7);
    g.add(leaf);
  });
  {
    for(let i = 0; i < (MODEST ? 8 : 12); i++){
      const a = i * 2.39 + x, rr = 0.07 + (i % 4) * 0.03, tier = (i % 5);
      const sp = new THREE.Mesh(UNIT.sph, leafM);
      sp.position.set(Math.cos(a) * rr * sc, (0.52 + tier * 0.055) * sc, Math.sin(a) * rr * sc);
      sp.scale.set((0.13 + (i % 3) * 0.025) * sc, 0.012 * sc, (0.045 + (i % 2) * 0.012) * sc); sp.rotation.set(0, -a, 0.55 - tier * 0.22);
      sp.castShadow = false; g.add(sp);
    }
  }
  /* 20261030ag: leaf cards. Real fronds (alpha-cut leaflets on a rib) arching out of the pot: not topiary. */
  if(G.gfx !== "simple"){
    const fm = x30FrondMat(Math.abs(Math.floor(x * 7.13 + z * 3.71)) % 3);
    const N = MODEST ? 9 : 13;
    for(let i = 0; i < N; i++){
      const a = i * 2.39996 + x, len = (0.34 + (i % 3) * 0.07) * sc;
      const pv = new THREE.Group(); pv.position.set(0, (0.40 + (i % 4) * 0.045) * sc, 0); pv.rotation.y = -a;
      const card = new THREE.Mesh(UNIT.plane || new THREE.PlaneGeometry(1, 1), fm);
      card.scale.set(len, len * 0.42, 1); card.position.set(len * 0.5, 0, 0);
      card.rotation.x = -Math.PI / 2 + 0.25 * ((i % 2) ? 1 : -1);
      const tilt = new THREE.Group(); tilt.rotation.z = 0.35 + (i % 5) * 0.16 - 0.25; tilt.add(card); pv.add(tilt);
      card.castShadow = false; card.raycast = () => {}; g.add(pv);
    }
  }
  return groundGroup(g, 0.35);
}
function propLamp(x,y,z,warm,power){
  addCyl(matCol(0x8a6a2e,.4,.75), x,y-0.16,z, 0.035,0.32);
  const shade=addCyl(new THREE.MeshStandardMaterial({color:warm||0xf5e3bb, roughness:.6,
    emissive:new THREE.Color(warm||0xffdca8), emissiveIntensity:0.85}), x,y+0.04,z, 0.15,0.20);
  shade.castShadow=false;
  const L=new THREE.PointLight(warm||0xffd39a, power||0.9, 7, 2);
  L.position.set(x,y+0.02,z);
  if(!pushRoomLight(L)) return null;
  return L;
}
function propSconce(x,y,z,ry){
  const g=new THREE.Group(); g.position.set(x,y,z); g.rotation.y=ry||0; roomGroup.add(g);
  const arm=new THREE.Mesh(UNIT.box, matCol(0x9a7736,.4,.8));
  arm.scale.set(0.06,0.06,0.22); arm.position.set(0,0,0.11); g.add(arm);
  const bowl=new THREE.Mesh(UNIT.sph, new THREE.MeshStandardMaterial({color:0xd99a52, roughness:.7,
    emissive:new THREE.Color(0xff9a3c), emissiveIntensity:0.46}));   /* 20261030ag: amber frosted glass */   /* 20261030ag: warm frosted glass, not a white blob */
  bowl.scale.set(0.22,0.16,0.22); bowl.position.set(0,0.06,0.22); g.add(bowl);
  const L=new THREE.PointLight(0xffc27e, 0.42, 6.5, 2);   /* 20261030p: 0.25 m off the wall made a white hot spot (corridor glare) */
  L.position.set(x + Math.sin(ry||0)*0.5, y+0.08, z + Math.cos(ry||0)*0.5);
  pushRoomLight(L);
}
/* Wall lamp look without minting a PointLight — fills bare bays under MAX_ROOM_LIGHTS. */
function propSconceDecor(x,y,z,ry){
  const g=new THREE.Group(); g.position.set(x,y,z); g.rotation.y=ry||0; roomGroup.add(g);
  const arm=new THREE.Mesh(UNIT.box, matCol(0x9a7736,.4,.8));
  arm.scale.set(0.055,0.055,0.20); arm.position.set(0,0,0.10); arm.castShadow=false; g.add(arm);
  const bowl=new THREE.Mesh(UNIT.sph, new THREE.MeshStandardMaterial({color:0xd99a52, roughness:.7,
    emissive:new THREE.Color(0xff9a3c), emissiveIntensity:0.42}));
  bowl.scale.set(0.20,0.14,0.20); bowl.position.set(0,0.05,0.20); bowl.castShadow=false; g.add(bowl);
}
/* Corner pilaster + miters: covers band joints on all four corners (no gaps, no double strips). */
function propCornerPilasters(w, d, h, hw, style){
  const wood2 = style === "wood" || style === "chamber";
  const stony = style === "marble" || style === "stone" || style === "town";
  const pil = wood2 ? matTex(TEX.oak, 0.35, 2.2, .52)
            : stony ? matCol(0xc8c2b2, .80)
                    : matCol(0xe0dcd0, .88);
  const pw = wood2 ? 0.15 : (stony ? 0.17 : 0.14);
  const ph = Math.max(1.8, h - 0.35);
  const corners = [[-hw+0.08, 0.08], [hw-0.08, 0.08], [-hw+0.08, d-0.08], [hw-0.08, d-0.08]];
  corners.forEach(c => {
    addBox(pil, c[0], ph/2 + 0.12, c[1], pw, ph, pw, 0, true);
    addBox(pil, c[0], 0.14, c[1], pw*1.28, 0.12, pw*1.28, 0, true);       /* base */
    addBox(pil, c[0], h-0.28, c[1], pw*1.22, 0.10, pw*1.22, 0, true);     /* capital */
  });
  /* Miter blocks at rail heights — bridge X/Z band turns (stepped, not coplanar doubles) */
  const miter = wood2 ? matCol(0x5a4024, .50) : stony ? matCol(0xcfc8b8, .82) : matCol(0xd8d4c8, .90);
  const ys = [0.09, 0.188];
  if(wood2){ ys.push(1.335, h*0.70, h*0.70+0.048); }
  else if(stony){ ys.push(1.05, 1.125, h*0.68, h*0.68+0.042); }
  else { ys.push(0.95, 1.005, h*0.72); }
  if(h > 2){ ys.push(h-0.09, h-0.195, h-0.255); }
  const mw = pw * 1.35;
  corners.forEach(c => {
    ys.forEach(yy => {
      addBox(miter, c[0], yy, c[1], mw, 0.022, mw, 0, true);
    });
  });
}
function propChandelier(x,y,z,arms,scale){
  scale=scale||1;
  addCyl(matCol(0x8a7336,.4,.8), x,y+0.35,z, 0.02,0.7);
  const hub=addSphere(matCol(0x9a7736,.35,.85), x,y,z, 0.13*scale);
  hub.castShadow=false;
  for(let i=0;i<arms;i++){
    const a=i/arms*6.283, r=0.42*scale;
    const cx=x+Math.cos(a)*r, cz=z+Math.sin(a)*r;
    addCyl(matCol(0x9a7736,.35,.85), cx,y+0.02,cz, 0.022,0.26);
    const f=addSphere(new THREE.MeshStandardMaterial({color:0xfff0cf, roughness:.4,
      emissive:new THREE.Color(0xffdca6), emissiveIntensity:1.25}), cx,y+0.19,cz, 0.055*scale,0.085*scale,0.055*scale);
    f.castShadow=false;
  }
  const L=new THREE.PointLight(0xffd7a4, 1.15, 15, 2);
  L.position.set(x,y-0.15,z); pushRoomLight(L);
}
function artPool(){
  return [TEX.paintA, TEX.paintB, TEX.paintC, TEX.paintD, TEX.paintE, TEX.paintF].filter(Boolean);
}
/* ── 20261011j · pictures sit flush on their walls, at the right height, never overlapping ── */
let _picSeq = 0, _seatRay = null;
function picTagSince(n0, kind){
  if(!roomGroup) return;
  const id = ++_picSeq, k = roomGroup.children;
  for(let i = n0; i < k.length; i++){ const u = k[i].userData || (k[i].userData = {}); u.pic = id; u.picK = kind; }
}
function seatPictures(roomId){
  if(!roomGroup) return 0;
  const kids = roomGroup.children, groups = {}, others = [];
  for(let i = 0; i < kids.length; i++){
    const m = kids[i], id = m.userData && m.userData.pic;
    if(id){ (groups[id] = groups[id] || []).push(m); }
    else if(m.isMesh || m.isGroup) others.push(m);
  }
  const ids = Object.keys(groups);
  if(!ids.length) return 0;
  const R = ROOMS[roomId] || {h:3.4};
  roomGroup.updateMatrixWorld(true);
  const ray = _seatRay || (_seatRay = new THREE.Raycaster());
  const c = new THREE.Vector3(), dir = new THREE.Vector3(), o = new THREE.Vector3();
  const small = [];
  for(let i = 0; i < others.length; i++){
    const m = others[i];
    if(!m.isMesh) continue;
    const b = new THREE.Box3().setFromObject(m);
    const sx = b.max.x - b.min.x, sy = b.max.y - b.min.y, sz = b.max.z - b.min.z, v = sx * sy * sz;
    if(v > 1.2 || v < 1e-6) continue;
    small.push({b, sx, sy, sz});
  }
  const placed = [];
  let moved = 0;
  ids.forEach(id => {
    const ms = groups[id];
    const B = new THREE.Box3(); ms.forEach(m => B.expandByObject(m));
    B.getCenter(c);
    /* table nameplates, plinth plates and ground signs keep their place */
    if(c.y < 0.9){ placed.push(B); return; }
    const ax = (B.max.x - B.min.x) < (B.max.z - B.min.z) ? "x" : "z";
    let best = null;
    for(const s of [1, -1]){
      dir.set(ax === "x" ? s : 0, 0, ax === "z" ? s : 0);
      o.copy(c).addScaledVector(dir, -0.5);
      ray.set(o, dir); ray.near = 0.499; ray.far = 0.75;
      const hits = ray.intersectObjects(others, true);
      if(!hits.length) continue;
      const h = hits[0];
      const back = ax === "x" ? (s > 0 ? B.max.x : B.min.x) : (s > 0 ? B.max.z : B.min.z);
      const wall = ax === "x" ? h.point.x : h.point.z;
      const gap = (wall - back) * s;
      if(!best || Math.abs(gap) < Math.abs(best.gap)) best = {gap, s};
    }
    let dx = 0, dy = 0, dz = 0;
    /* nothing behind it at all: a sign on two slim brass posts, down to whatever floor is under it */
    if((!best || best.gap > 0.12) && !(roomGroup.userData && roomGroup.userData._seatPosts && roomGroup.userData._seatPosts[id])){
      o.set(c.x, B.min.y - 0.01, c.z); dir.set(0, -1, 0); ray.set(o, dir); ray.near = 0; ray.far = 2.3;
      const gh = ray.intersectObjects(others, true);
      const floorY = gh.length ? gh[0].point.y : (B.min.y - 0.01 <= 2.3 ? 0 : null);
      const drop = floorY === null ? 99 : B.min.y - floorY;
      if(drop > 0.05 && drop <= 2.3){
        const brass = matCol(0x8a6a32, .45, .6);
        const half = (ax === "x" ? (B.max.z - B.min.z) : (B.max.x - B.min.x)) / 2 - 0.07;
        for(const sgn of [-1, 1]){
          const px = ax === "x" ? c.x : c.x + sgn * half, pz = ax === "x" ? c.z + sgn * half : c.z;
          const post = new THREE.Mesh(UNIT.cyl, brass);
          post.scale.set(0.024, drop, 0.024);
          post.position.set(px, floorY + drop / 2, pz);
          post.castShadow = false; post.receiveShadow = false;
          post.userData.seatPost = true;
          roomGroup.add(post);
          post.updateMatrix(); post.updateMatrixWorld(true);
        }
        roomGroup.userData._seatPosts = roomGroup.userData._seatPosts || {};
        roomGroup.userData._seatPosts[id] = true;
        moved++;
      }
    }
    /* flush: back of the frame or plaque 2mm off the wall face */
    if(best && best.gap > 0.004 && best.gap < 0.12){ const mv = (best.gap - 0.002) * best.s; if(ax === "x") dx = mv; else dz = mv; }
    const Bm = B.clone().translate(new THREE.Vector3(dx, 0, dz));
    /* door headers, picture rails and cornices: clear them vertically; sconces and posts: step along the wall */
    for(let pass = 0; pass < 2; pass++){
      for(const q of small){
        const I = Bm.clone().intersect(q.b);
        if(I.isEmpty() || (I.max.x - I.min.x) < 0.02 || (I.max.y - I.min.y) < 0.02 || (I.max.z - I.min.z) < 0.006) continue;
        const strip = q.sy < 0.3 && Math.max(q.sx, q.sz) > 0.9;
        if(strip){
          const qc = (q.b.min.y + q.b.max.y) / 2, pc = (Bm.min.y + Bm.max.y) / 2;
          const up = q.b.max.y - Bm.min.y + 0.015, down = Bm.max.y - q.b.min.y + 0.015;
          const d = qc < pc ? up : -down;
          if(Bm.max.y + d < R.h - 0.05 && Bm.min.y + d > 0.9){ dy += d; Bm.translate(new THREE.Vector3(0, d, 0)); }
        } else {
          const along = ax === "x" ? "z" : "x";
          const qc = (q.b.min[along] + q.b.max[along]) / 2, pc = (Bm.min[along] + Bm.max[along]) / 2;
          const d = qc < pc ? (q.b.max[along] - Bm.min[along] + 0.02) : -(Bm.max[along] - q.b.min[along] + 0.02);
          if(Math.abs(d) < 0.45){ if(along === "x") dx += d; else dz += d; const v = new THREE.Vector3(along === "x" ? d : 0, 0, along === "z" ? d : 0); Bm.translate(v); }
        }
      }
    }
    for(const P of placed){
      const I = Bm.clone().intersect(P);
      if(I.isEmpty() || (I.max.x - I.min.x) < 0.01 || (I.max.y - I.min.y) < 0.01 || (I.max.z - I.min.z) < 0.004) continue;
      const along = ax === "x" ? "z" : "x";
      const d = (Bm.min[along] + Bm.max[along]) / 2 >= (P.min[along] + P.max[along]) / 2 ? (P.max[along] - Bm.min[along] + 0.04) : -(Bm.max[along] - P.min[along] + 0.04);
      if(along === "x") dx += d; else dz += d;
      Bm.translate(new THREE.Vector3(along === "x" ? d : 0, 0, along === "z" ? d : 0));
    }
    placed.push(Bm);
    if(dx || dy || dz){
      moved++;
      ms.forEach(m => { m.position.x += dx; m.position.y += dy; m.position.z += dz; m.updateMatrix(); m.updateMatrixWorld(true); });
    }
  });
  return moved;
}
/* textures made while you were walking were capped at 2x anisotropy; when you stand still,
   lift them back to the quality cap one at a time (never while walking) */
function texUpgradeIdle(){
  const L = window.__texCapped;
  if(!L || !L.length) return;
  if(cam && Math.hypot(cam.vx || 0, cam.vz || 0) > 0.12) return;
  const t = L.pop();
  if(!t || !renderer || !renderer.capabilities) return;
  const cap = (G.fullDetail || G.gfx === "best") ? 8 : 4;
  const a = Math.min(cap, renderer.capabilities.getMaxAnisotropy() || 1);
  if(t.anisotropy < a){ t.anisotropy = a; t.needsUpdate = true; }
}

function propFrame(wall, x,y,z, w,h, tex, ry){
  const _n0 = roomGroup ? roomGroup.children.length : 0;
  try{ return propFrameRaw(wall, x,y,z, w,h, tex, ry); }finally{ try{ picTagSince(_n0, "frame"); }catch(e){} }
}
function propFrameRaw(wall, x,y,z, w,h, tex, ry){
  /* ONE frame recipe for every room: hollow moulding + dark mat + lit canvas.
     Never a solid wood plate over the art (that read as blank blue slabs). */
  const wood = matCol(0x6e4f28, .48, .28);
  const gilt = matCol(0xb08b45, .42, .55);
  const matte = matCol(0x1a1814, .92, .05);
  const rail = Math.max(0.036, Math.min(w, h) * 0.08);
  /* Keep the whole assembly nearly flush: the old 32mm depth read as a
     second box protruding from the wall, especially at oblique angles. */
  const depth = 0.014;
  const artOut = depth * 0.38;
  const backOut = depth * 0.08;
  if(!tex || !tex.isTexture) tex = (artPool()[0] || TEX.paintA);
  /* Into-room normal */
  let nx = 0, nz = 0;
  if(wall === "x"){
    const sign = (ry !== undefined && Math.sin(ry || 0) < 0) ? -1 : 1;
    nx = sign;
  } else {
    nz = (z > 1) ? -1 : 1;
  }
  const fx = x + nx * (depth * 0.5);
  const fz = z + nz * (depth * 0.5);
  /* Four rails + corner blocks (same recipe on every wall) */
  if(wall === "z"){
    addBox(wood, x, y + (h + rail) * 0.5, fz, w + rail * 2, rail, depth, ry, false);
    addBox(wood, x, y - (h + rail) * 0.5, fz, w + rail * 2, rail, depth, ry, false);
    addBox(wood, x - (w + rail) * 0.5, y, fz, rail, h, depth, ry, false);
    addBox(wood, x + (w + rail) * 0.5, y, fz, rail, h, depth, ry, false);
    /* corners */
    [[-1,-1],[-1,1],[1,-1],[1,1]].forEach(c => {
      addBox(wood, x + c[0]*(w*0.5+rail*0.5), y + c[1]*(h*0.5+rail*0.5), fz, rail*1.05, rail*1.05, depth*1.05, ry, false);
    });
    addBox(gilt, x, y + h*0.5 - 0.006, fz + nz*0.006, w + 0.012, 0.012, 0.01, ry, true);
    addBox(gilt, x, y - h*0.5 + 0.006, fz + nz*0.006, w + 0.012, 0.012, 0.01, ry, true);
  } else {
    /* These are already written in world axes for a side wall — thin in x,
       long in z. The planes below still take ry, because a plane starts in
       xy and has to be turned to face the room; a box that has already been
       measured side-on must not be turned again, or every rail swings out
       of the wall and lies across the picture. */
    addBox(wood, fx, y + (h + rail) * 0.5, z, depth, rail, w + rail * 2, 0, false);
    addBox(wood, fx, y - (h + rail) * 0.5, z, depth, rail, w + rail * 2, 0, false);
    addBox(wood, fx, y, z - (w + rail) * 0.5, depth, h, rail, 0, false);
    addBox(wood, fx, y, z + (w + rail) * 0.5, depth, h, rail, 0, false);
    [[-1,-1],[-1,1],[1,-1],[1,1]].forEach(c => {
      addBox(wood, fx, y + c[1]*(h*0.5+rail*0.5), z + c[0]*(w*0.5+rail*0.5), depth*1.05, rail*1.05, rail*1.05, 0, false);
    });
    addBox(gilt, fx + nx*0.006, y + h*0.5 - 0.006, z, 0.01, 0.012, w + 0.012, 0, true);
    addBox(gilt, fx + nx*0.006, y - h*0.5 + 0.006, z, 0.01, 0.012, w + 0.012, 0, true);
  }
  /* Dark mat (backing) — reads as the rebate even if the canvas is missed */
  const back = new THREE.Mesh(UNIT.plane, matte);
  back.position.set(x + nx * backOut, y, z + nz * backOut);
  back.scale.set(w * 1.02, h * 1.02, 1);
  back.rotation.y = Math.atan2(nx, nz);
  back.castShadow = false; back.receiveShadow = true;
  roomGroup.add(back);
  /* Canvas — MeshBasic so chamber lighting cannot wash it to a blank slab.
     Face is computed from the wall normal so landscape stays landscape
     and portrait stays portrait — never a sideways slab. */
  if(!G._artMats) G._artMats = new Map();
  const key = "basic|" + ((tex && tex.uuid) || "paintA");
  let artMat = G._artMats.get(key);
  if(!artMat){
    artMat = new THREE.MeshBasicMaterial({
      map: tex, color: 0xffffff, side: THREE.FrontSide
    });
    try{ if("toneMapped" in artMat) artMat.toneMapped = false; }catch(e){}
    try{ if(artMat.map && artMat.map.encoding !== undefined) artMat.map.encoding = THREE.sRGBEncoding; }catch(e){}
    try{ if(artMat.map){ artMat.map.center.set(0.5, 0.5); artMat.map.rotation = 0; } }catch(e){}
    artMat._shared = true;
    G._artMats.set(key, artMat);
  }
  const art = new THREE.Mesh(UNIT.plane, artMat);
  art.position.set(x + nx * artOut, y, z + nz * artOut);
  art.scale.set(w, h, 1);
  art.rotation.y = Math.atan2(nx, nz);
  art.rotation.z = 0;
  art.rotation.x = 0;
  art.renderOrder = 3;
  art.castShadow = false;
  art.receiveShadow = false;
  roomGroup.add(art);
}

/* ── Window assembly (in-engine; no external plugin) ─────────
   propWindow(wall, x,y,z, w,h, ry, opts)
   wall "x" = left/right (opening spans Z); "z" = front/back (spans X).
   Reveal meets the wall with no light leak; sill/lintel miters; mullion/
   muntin seams clean; glass inset in the sash rebate (never coplanar);
   only the frame/sash cast shadows. opts: {cols, rows, blinds, stone, style} */
const WIN_GLASS = [];   /* shared glass mat nudged by lightingSlow */
function matWindowGlass(){
  if(G._winGlassMat) return G._winGlassMat;
  /* Opaque sky pane. Transmission + depthWrite:false made every window a
     floating pale slab that composited over paintings, people, and the seal. */
  const m = new THREE.MeshStandardMaterial({
    color: 0x8fb7cc,
    roughness: 0.28,
    metalness: 0.04,
    transparent: false,
    side: THREE.FrontSide,
    emissive: 0xe4eef4,
    emissiveIntensity: 0.32,
    depthWrite: true
  });
  m._shared = true; m._winGlass = true;
  G._winGlassMat = m;
  WIN_GLASS.length = 0; WIN_GLASS.push(m);
  return m;
}
function syncWindowGlass(){
  const m = G._winGlassMat; if(!m) return;
  const day = (typeof LIGHT_DAY === "number") ? LIGHT_DAY : 1;
  const cool = 1 - day;
  /* Warm day emissive → cooler night; single shared mat so every pane follows. */
  if(m.emissive) m.emissive.setRGB(0.82 + day*0.08, 0.88 + day*0.04, 0.90 - cool*0.04);
  m.emissiveIntensity = 0.22 + day * 0.18;
  if(m.color) m.color.setRGB(0.48 + day*0.12, 0.64 + day*0.08, 0.74 + cool*0.04);
}
function propWindow(wall, x,y,z, w,h, ry, opts){
  opts = opts || {};
  const cols = Math.max(1, opts.cols || 2);
  const rows = Math.max(1, opts.rows || 2);
  const stone = !!(opts.stone || opts.style === "stone" || opts.style === "marble");
  const blinds = !!opts.blinds;
  const revealM = stone ? matCol(0xb9b3a4, .78) : matTex(TEX.oak, 1.2, 0.6, .55);
  const sashM   = stone ? matCol(0xd8d2c4, .82) : matCol(0xe8e2d2, .72);
  const sillM   = stone ? matCol(0xc4beb0, .74) : matTex(TEX.oak, 1.4, 0.35, .5);
  const glassM  = matWindowGlass();
  /* Local axes: into-room is +N. Frame casts; glass does not. */
  const put = (mat, px,py,pz, sx,sy,sz, cast) => {
    const e = new THREE.Mesh(UNIT.box, mat);
    e.position.set(px, py, pz); e.scale.set(sx, sy, sz);
    e.castShadow = !!cast; e.receiveShadow = true;
    roomGroup.add(e); return e;
  };
  const putGlass = (px,py,pz, sx,sy, rotY) => {
    const g = new THREE.Mesh(UNIT.plane, glassM);
    g.position.set(px, py, pz); g.scale.set(sx, sy, 1);
    g.rotation.y = rotY || 0;
    g.castShadow = false; g.receiveShadow = false;
    g.renderOrder = 1;
    roomGroup.add(g); return g;
  };
  /* Thicknesses — reveal meets wall; glass sits in sash rebate. */
  const revealD = 0.085;   /* outer stone/wood reveal depth into room */
  const sashD   = 0.038;   /* sash/mullion face */
  const glassIn = 0.018;   /* glass inset from wall (rebate; not coplanar) */
  const barW    = 0.036;   /* muntin/mullion thickness */
  const sillT   = 0.055;
  const lintT   = 0.070;
  const sideT   = 0.070;   /* reveal jamb width */
  if(wall === "x"){
    /* Opening on left/right wall: span along Z. ry tells facing. */
    const sign = (ry !== undefined && Math.sin(ry || 0) < 0) ? -1 : 1;
    const face = x;                         /* wall contact plane */
    const revX = face + sign * (revealD * 0.5);
    /* Outer reveal (jambs + head + sill apron) — covers wall plane, no light leak */
    put(revealM, revX, y, z - w/2, revealD, h + sideT*2, sideT, true);           /* left jamb (along -Z) */
    put(revealM, revX, y, z + w/2, revealD, h + sideT*2, sideT, true);           /* right jamb */
    put(sillM,   revX, y - h/2 - sillT*0.35, z, revealD + 0.02, sillT, w + sideT*2.2, true); /* sill + miters past jambs */
    put(revealM, revX, y + h/2 + lintT*0.35, z, revealD + 0.01, lintT, w + sideT*2.0, true); /* lintel */
    /* Inner sash rectangle (slightly proud of reveal inner face) */
    const sashX = face + sign * (revealD - sashD * 0.45);
    /* Sash rails (outer) */
    put(sashM, sashX, y - h/2 + barW*0.55, z, sashD, barW, w - sideT*0.2, true);
    put(sashM, sashX, y + h/2 - barW*0.55, z, sashD, barW, w - sideT*0.2, true);
    put(sashM, sashX, y, z - w/2 + barW*0.55, sashD, h - barW, barW, true);
    put(sashM, sashX, y, z + w/2 - barW*0.55, sashD, h - barW, barW, true);
    /* Mullions (vertical) and muntins (horizontal) — clean T seams into rails */
    for(let c = 1; c < cols; c++){
      const zz = z - w/2 + (c / cols) * w;
      put(sashM, sashX, y, zz, sashD, h - barW*1.6, barW * 0.85, true);
    }
    for(let r = 1; r < rows; r++){
      const yy = y - h/2 + (r / rows) * h;
      put(sashM, sashX, yy, z, sashD, barW * 0.75, w - barW*1.6, true);
    }
    /* Glass panes inset in rebate — one plane per pane, shy of sash face */
    const gX = face + sign * glassIn;
    const cellW = (w - barW * (cols + 1)) / cols;
    const cellH = (h - barW * (rows + 1)) / rows;
    for(let r = 0; r < rows; r++){
      for(let c = 0; c < cols; c++){
        const zz = z - w/2 + barW + cellW/2 + c * (cellW + barW);
        const yy = y - h/2 + barW + cellH/2 + r * (cellH + barW);
        putGlass(gX, yy, zz, cellW * 0.96, cellH * 0.96, sign > 0 ? Math.PI/2 : -Math.PI/2);
      }
    }
    if(blinds){
      const bx = face + sign * (revealD * 0.72);
      const slat = matCol(0xcfc6b4, .9);
      const nSl = Math.max(6, Math.round(h / 0.09));
      for(let sl = 0; sl < nSl; sl++){
        put(slat, bx, y - h/2 + 0.04 + sl * (h - 0.08) / Math.max(1, nSl - 1), z, 0.012, 0.028, w * 0.88, false);
      }
    }
  } else {
    /* Back / front wall: span along X */
    const into = (z > 1) ? -1 : 1;   /* toward room centre */
    const face = z;
    const revZ = face + into * (revealD * 0.5);
    put(revealM, x - w/2, y, revZ, sideT, h + sideT*2, revealD, true);
    put(revealM, x + w/2, y, revZ, sideT, h + sideT*2, revealD, true);
    put(sillM,   x, y - h/2 - sillT*0.35, revZ, w + sideT*2.2, sillT, revealD + 0.02, true);
    put(revealM, x, y + h/2 + lintT*0.35, revZ, w + sideT*2.0, lintT, revealD + 0.01, true);
    const sashZ = face + into * (revealD - sashD * 0.45);
    put(sashM, x, y - h/2 + barW*0.55, sashZ, w - sideT*0.2, barW, sashD, true);
    put(sashM, x, y + h/2 - barW*0.55, sashZ, w - sideT*0.2, barW, sashD, true);
    put(sashM, x - w/2 + barW*0.55, y, sashZ, barW, h - barW, sashD, true);
    put(sashM, x + w/2 - barW*0.55, y, sashZ, barW, h - barW, sashD, true);
    for(let c = 1; c < cols; c++){
      const xx = x - w/2 + (c / cols) * w;
      put(sashM, xx, y, sashZ, barW * 0.85, h - barW*1.6, sashD, true);
    }
    for(let r = 1; r < rows; r++){
      const yy = y - h/2 + (r / rows) * h;
      put(sashM, x, yy, sashZ, w - barW*1.6, barW * 0.75, sashD, true);
    }
    const gZ = face + into * glassIn;
    const cellW = (w - barW * (cols + 1)) / cols;
    const cellH = (h - barW * (rows + 1)) / rows;
    for(let r = 0; r < rows; r++){
      for(let c = 0; c < cols; c++){
        const xx = x - w/2 + barW + cellW/2 + c * (cellW + barW);
        const yy = y - h/2 + barW + cellH/2 + r * (cellH + barW);
        putGlass(xx, yy, gZ, cellW * 0.96, cellH * 0.96, into > 0 ? 0 : Math.PI);
      }
    }
    if(blinds){
      const bz = face + into * (revealD * 0.72);
      const slat = matCol(0xcfc6b4, .9);
      const nSl = Math.max(6, Math.round(h / 0.09));
      for(let sl = 0; sl < nSl; sl++){
        put(slat, x, y - h/2 + 0.04 + sl * (h - 0.08) / Math.max(1, nSl - 1), bz, w * 0.88, 0.028, 0.012, false);
      }
    }
  }
}
function propHouseSeal(x, y, z, faceInto, size){
  /* Civic seal flush on the Chair's wall — canvas, no file load. */
  size = size || 1.85;
  if(!TEX.houseSeal){
    TEX.houseSeal = texCanvas(256, (c,s) => {
      const cx = s/2, cy = s/2;
      c.fillStyle = "#0D1014";
      c.beginPath(); c.ellipse(cx, cy, s*0.48, s*0.36, 0, 0, 6.283); c.fill();
      c.strokeStyle = "#C4A35A"; c.lineWidth = s*0.028;
      c.beginPath(); c.ellipse(cx, cy, s*0.44, s*0.325, 0, 0, 6.283); c.stroke();
      c.strokeStyle = "#8B1E2D"; c.lineWidth = s*0.016;
      c.beginPath(); c.ellipse(cx, cy, s*0.40, s*0.295, 0, 0, 6.283); c.stroke();
      c.fillStyle = "#E8D5A3";
      for(let i=0;i<13;i++){
        const a = -Math.PI/2 + i*(Math.PI*2/13);
        const rx = cx + Math.cos(a)*s*0.36, ry = cy + Math.sin(a)*s*0.26;
        c.beginPath();
        for(let k=0;k<5;k++){
          const p = a + k*2.513 - 0.2;
          const r = k%2 ? s*0.012 : s*0.026;
          const px = rx + Math.cos(p)*r, py = ry + Math.sin(p)*r;
          if(k===0) c.moveTo(px,py); else c.lineTo(px,py);
        }
        c.closePath(); c.fill();
      }
      c.fillStyle = "#E8E0C8";
      c.beginPath();
      c.moveTo(cx - s*0.16, cy + s*0.02);
      c.lineTo(cx - s*0.14, cy - s*0.02);
      c.quadraticCurveTo(cx, cy - s*0.18, cx + s*0.14, cy - s*0.02);
      c.lineTo(cx + s*0.16, cy + s*0.02);
      c.closePath(); c.fill();
      c.fillStyle = "#C4A35A";
      c.fillRect(cx - s*0.018, cy - s*0.20, s*0.036, s*0.08);
      c.beginPath(); c.arc(cx, cy - s*0.21, s*0.022, 0, 6.283); c.fill();
      c.fillStyle = "#D8C9A0";
      c.fillRect(cx - s*0.12, cy + s*0.00, s*0.24, s*0.07);
      c.fillStyle = "#B8A070";
      for(let i=0;i<5;i++) c.fillRect(cx - s*0.10 + i*s*0.042, cy + s*0.00, s*0.018, s*0.07);
      c.fillStyle = "#E8D5A3";
      c.font = "bold " + Math.round(s*0.055) + "px serif";
      c.textAlign = "center"; c.textBaseline = "middle";
      c.fillText("ONE NATION", cx, cy + s*0.12);
      c.fillText("UNDER ME.", cx, cy + s*0.18);
    });
    try{ TEX.houseSeal.encoding = THREE.sRGBEncoding; }catch(e){}
  }
  const mat = new THREE.MeshBasicMaterial({
    map: TEX.houseSeal, transparent: true, side: THREE.FrontSide, depthWrite: true
  });
  try{ if("toneMapped" in mat) mat.toneMapped = false; }catch(e){}
  const m = new THREE.Mesh(UNIT.plane, mat);
  m.position.set(x, y, z);
  m.scale.set(size, size * 0.74, 1);
  m.rotation.y = faceInto == null ? Math.PI : faceInto;
  m.castShadow = false; m.receiveShadow = true;
  m.renderOrder = 2;
  roomGroup.add(m);
  try{
    const gilt = matCol(0xb08b45, .32, .88);
    const fz = z + ((faceInto == null || faceInto === Math.PI) ? -0.018 : 0.018);
    addBox(gilt, x, y + size * 0.39, fz, size * 1.04, 0.045, 0.04, 0, true);
    addBox(gilt, x, y - size * 0.39, fz, size * 1.04, 0.045, 0.04, 0, true);
    addBox(gilt, x - size * 0.54, y, fz, 0.045, size * 0.80, 0.04, 0, true);
    addBox(gilt, x + size * 0.54, y, fz, 0.045, size * 0.80, 0.04, 0, true);
  }catch(e){}
  return m;
}
/* ── pipework: a run of pipe with brackets and joints ────── */
function propPipe(x,y,z,len,axis,rad,col){
  const m = matCol(col||0x6e6a60, .45, .55);
  const p = new THREE.Mesh(UNIT.cyl, m);
  p.position.set(x,y,z);
  p.scale.set((rad||0.045)*2, len, (rad||0.045)*2);
  if(axis === "z") p.rotation.x = Math.PI/2;
  if(axis === "x") p.rotation.z = Math.PI/2;
  p.castShadow = true; p.receiveShadow = true; roomGroup.add(p);
  /* brackets every couple of metres */
  const n = Math.max(2, Math.floor(len/2.2));
  for(let i=0;i<=n;i++){
    const t = (i/n - 0.5) * len;
    const bx = x + (axis==="x" ? t : 0), by = y + (axis==="y" ? t : 0), bz = z + (axis==="z" ? t : 0);
    const b = new THREE.Mesh(UNIT.box, matCol(0x4e4a44,.6));
    b.position.set(bx, by, bz);
    b.scale.set((rad||0.045)*3.1, (rad||0.045)*3.1, (rad||0.045)*3.1);
    b.castShadow = true; roomGroup.add(b);
  }
  return p;
}
function propElbow(x,y,z,rad,col){
  const m = matCol(col||0x6e6a60, .45, .55);
  const e = new THREE.Mesh(UNIT.sph, m);
  e.position.set(x,y,z);
  e.scale.set((rad||0.05)*2.4, (rad||0.05)*2.4, (rad||0.05)*2.4);
  e.castShadow = true; roomGroup.add(e);
}
function propRadiator(x,y,z,w,ry){
  const g = matCol(0x1e1c1a, .55, .55);
  addBox(g, x, y - 0.22, z, w, 0.06, 0.08, ry, true); addBox(g, x, y + 0.29, z, w, 0.04, 0.11, ry, true);
  [-1, 1].forEach(sd => { const t = sd * (w / 2 - 0.05); addBox(matCol(0x24221f, .7), x + (ry ? 0 : t), y - 0.3, z + (ry ? t : 0), 0.06, 0.12, 0.06, ry, true); });
  const fins = Math.max(4, Math.round(w/0.11));
  for(let i=0;i<fins;i++){
    const t = (i/(fins-1) - 0.5) * (w - 0.06);
    addBox(matCol(0x24221f,.55,.55),
      x + (ry ? 0 : t), y, z + (ry ? t : 0), ry?0.09:0.035, 0.58, ry?0.035:0.09, ry, true);
  }
  propPipe(x - (ry?0:w/2), y-0.34, z - (ry?w/2:0), 0.30, "y", 0.028, 0x3a3833);
}
function propClock(x,y,z,ry){
  const face=matCol(0xf0ead8,.8);
  addCyl(matCol(0x5a4326,.5), x,y,z, 0.20,0.05).rotation.x=Math.PI/2;
  const f=addCyl(face, x,y,z, 0.17,0.055); f.rotation.x=Math.PI/2;
  const mk=(len,wdt,col)=>{
    const m=new THREE.Mesh(UNIT.box, matCol(col,.6));
    m.scale.set(wdt,len,0.012);
    const g=new THREE.Group();
    m.position.y=len/2; g.add(m);
    g.position.set(x, y, z + (ry===undefined?0.04:0.04));
    roomGroup.add(g); return g;
  };
  const hour=mk(0.075,0.018,0x2a2119), min=mk(0.115,0.013,0x2a2119);
  const tk = {kind:"clock", hour, min};
  hour.userData._ticker = tk;
  TICKERS.push(tk);
}
function propFan(x,y,z){
  const g=new THREE.Group(); g.position.set(x,y,z); roomGroup.add(g);
  addCyl(matCol(0x6a5a3a,.5,.4), x,y+0.16,z, 0.022,0.32);
  const hub=new THREE.Mesh(UNIT.cyl, matCol(0x7a6640,.45,.5));
  hub.scale.set(0.16,0.07,0.16); g.add(hub);
  for(let i=0;i<4;i++){
    const b=new THREE.Mesh(UNIT.box, matTex(TEX.panel,1,1,.6));
    b.scale.set(0.62,0.014,0.13);
    b.position.set(Math.cos(i*1.5708)*0.36, -0.02, Math.sin(i*1.5708)*0.36);
    b.rotation.y = i*1.5708; b.rotation.z = 0.13;
    b.castShadow=true; g.add(b);
  }
  const tkF = {kind:"fan", g};
  g.userData._ticker = tkF;
  TICKERS.push(tkF);
}
function propPapers(x,y,z,n){
  for(let i=0;i<(n||4);i++){
    const p=addBox(matCol(0xe9e4d6,.95), x+(Math.random()-0.5)*0.22, y+i*0.006, z+(Math.random()-0.5)*0.18,
      0.21,0.004,0.28, (Math.random()-0.5)*0.5, true);
    p.castShadow=false;
  }
}
function propCoatStand(x,z){
  addCyl(matCol(0x4a3620,.6), x,0.6,z, 0.035,1.2);
  addCyl(matCol(0x4a3620,.6), x,0.03,z, 0.20,0.06);
  for(let i=0;i<4;i++){
    const a=i*1.5708;
    addSphere(matCol(0x8a6a2e,.4,.7), x+Math.cos(a)*0.13, 1.16, z+Math.sin(a)*0.13, 0.03);
  }
  const coats=[0x2b2f38,0x4a4238,0x2f3b33];
  for(let i=0;i<2;i++){
    const a=i*2.4;
    addBox(matCol(coats[i%3],.95), x+Math.cos(a)*0.12, 0.78, z+Math.sin(a)*0.12, 0.30,0.72,0.14, a, true);
  }
}
/* a room's furnishing flags travel with its furniture: when the pieces leave the live group (or the group is cleared) the flags go too, so a rebuilt room is furnished again, not left bare */
function rgFlagsReset(g){ try{ if(g && g.userData) Object.keys(g.userData).forEach(k => { if(/^rg[A-Z]/.test(k) || k === "vStatues") delete g.userData[k]; }); }catch(e){} }
function clearRoom(){
  rgFlagsReset(roomGroup);
  try{ if(!PROC.on && G.members) G.members.forEach(m => { if(m.sitting) m.sitting = false; }); }catch(e){}

  TICKERS.length = 0;
  ROOMLIGHTS.length = 0;
  _roomBuiltId = null;
  _roomFurnished = false;
  if(MODEST){
    /* Do not dispose GPU objects on Intel/Edge — that hangs the renderer. */
    try{
      while(roomGroup && roomGroup.children.length){
        roomGroup.remove(roomGroup.children[0]);
      }
    }catch(e){}
    return;
  }
  const sharedGeo = UNIT ? new Set(Object.values(UNIT)) : null;
  let cachedMaps = null;
  const texMaps = () => {
    if(cachedMaps) return cachedMaps;
    cachedMaps = new Set();
    try{
      if(TEX) Object.values(TEX).forEach(t => { if(t) cachedMaps.add(t); });
      if(typeof MATCACHE !== "undefined" && MATCACHE){
        for(const m of MATCACHE.values()){
          if(m && m.map) cachedMaps.add(m.map);
          if(m && m.normalMap) cachedMaps.add(m.normalMap);
          if(m && m.roughnessMap) cachedMaps.add(m.roughnessMap);
        }
      }
      try{
        if(typeof ROUGHMAPS !== "undefined" && ROUGHMAPS)
          for(const t of ROUGHMAPS.values()) if(t) cachedMaps.add(t);
      }catch(eR){}
      try{
        if(typeof FACECACHE !== "undefined" && FACECACHE)
          for(const t of FACECACHE.values()) if(t) cachedMaps.add(t);
      }catch(eF){}
      try{
        if(G && G._artMats) for(const m of G._artMats.values()){ if(m && m.map) cachedMaps.add(m.map); }
      }catch(eA){}
      try{ /* window glass / skin mats are _shared — dropMat already skips */ }catch(eW){}
    }catch(e){}
    return cachedMaps;
  };
  const colSet = () => {
    try{
      if(typeof COLCACHE !== "undefined" && COLCACHE)
        return new Set(COLCACHE.values());
    }catch(e){}
    return null;
  };
  const cols = colSet();
  const dropMat = m => {
    if(!m || m._shared) return;
    if(cols && cols.has(m)) return;
    try{
      const keepMap = tex => !tex || tex._plaque || texMaps().has(tex);
      /* Prefer not disposing shared/atlas maps; only one-off mats reach here. */
      if(m.map && m.map.dispose && !keepMap(m.map)){
        try{ m.map.dispose(); }catch(e){}
      }
      if(m.normalMap && m.normalMap.dispose && !keepMap(m.normalMap)){
        try{ m.normalMap.dispose(); }catch(e){}
      }
      /* Do not touch emissive Color objects — dispose the material only. */
      try{ m.dispose(); }catch(e){}
    }catch(e){}
  };
  while(roomGroup.children.length){
    const c = roomGroup.children.pop();
    try{
      c.traverse(o => {
        if(o.isLight) return;
        if(o.geometry && sharedGeo && !sharedGeo.has(o.geometry)){
          try{ o.geometry.dispose(); }catch(e){}
        }
        if(o.material){
          if(Array.isArray(o.material)) o.material.forEach(dropMat);
          else dropMat(o.material);
        }
      });
    }catch(e){}
    try{ roomGroup.remove(c); }catch(e){}
  }
}

/* ── Brass plaques with real labels (doors, rooms, seats) ── */
const PLAQUE_CACHE = Object.create(null);
function plaqueTexture(title, sub){
  const key = String(title||"") + "|" + String(sub||"");
  if(PLAQUE_CACHE[key]) return PLAQUE_CACHE[key];
  const W = 512, H = 256;
  const c = document.createElement("canvas");
  c.width = W; c.height = H;
  const x = c.getContext("2d");
  const g = x.createLinearGradient(0, 0, 0, H);
  g.addColorStop(0, "#d2b36a");
  g.addColorStop(0.45, "#9a7436");
  g.addColorStop(1, "#5c4218");
  x.fillStyle = g; x.fillRect(0, 0, W, H);
  x.strokeStyle = "rgba(30,20,8,.65)"; x.lineWidth = 10; x.strokeRect(5, 5, W-10, H-10);
  x.strokeStyle = "rgba(240,215,150,.4)"; x.lineWidth = 2; x.strokeRect(16, 16, W-32, H-32);
  x.fillStyle = "#1a1208";
  x.textAlign = "center"; x.textBaseline = "middle";
  const fit = (str, font, maxW) => {
    x.font = font;
    let s = String(str || "");
    if(!s) return "";
    if(x.measureText(s).width <= maxW) return s;
    while(s.length > 2 && x.measureText(s + "…").width > maxW) s = s.slice(0, -1);
    return s + "…";
  };
  const main = fit(title, '600 44px "Instrument Serif", Georgia, serif', W - 56);
  x.font = '600 44px "Instrument Serif", Georgia, serif';
  x.fillText(main, W/2, sub ? H * 0.42 : H * 0.52);
  if(sub){
    const s2 = fit(sub, "600 22px Archivo, system-ui, sans-serif", W - 56);
    x.font = "600 22px Archivo, system-ui, sans-serif";
    x.fillStyle = "rgba(26,18,8,.78)";
    x.fillText(s2, W/2, H * 0.66);
  }
  const tex = new THREE.CanvasTexture(c);
  tex.encoding = THREE.sRGBEncoding;
  tex._plaque = true;
  dressMip(tex);
  PLAQUE_CACHE[key] = tex;
  return tex;
}
function propPlaque(x, y, z, ry, title, sub, width, height){
  const _n0 = roomGroup ? roomGroup.children.length : 0;
  try{ return propPlaqueRaw(x, y, z, ry, title, sub, width, height); }finally{ try{ picTagSince(_n0, "plaque"); }catch(e){} }
}
function propPlaqueRaw(x, y, z, ry, title, sub, width, height){
  if(!title) return;
  /* Flush brass plaque: back ≤2cm, face ≤8mm proud. */
  width = width || 0.92; height = height || 0.28;
  const mat = new THREE.MeshStandardMaterial({
    map: plaqueTexture(title, sub),
    roughness: 0.85, metalness: 0.0,
    side: THREE.DoubleSide,
    polygonOffset: true, polygonOffsetFactor: -3, polygonOffsetUnits: -3
  });
  const back = matCol(0x7a5a28, .55, .35);
  const thick = 0.018;
  const alongX = Math.abs(Math.cos(ry || 0)) < 0.5; /* face normal along ±X */
  addBox(back, x, y, z,
    alongX ? thick : width + 0.03,
    height + 0.03,
    alongX ? width + 0.03 : thick,
    0, true);
  const face = new THREE.Mesh(UNIT.plane, mat);
  const out = thick / 2 + 0.004;   /* 20261020x: in front of the brass back, not inside it */
  face.position.set(
    x + Math.sin(ry || 0) * out,
    y,
    z + Math.cos(ry || 0) * out
  );
  face.rotation.y = ry || 0;
  face.scale.set(width, height, 1);
  face.castShadow = false;
  face.renderOrder = 2;
  roomGroup.add(face);
}
function propSeatPlate(x, y, z, label){
  const mat = new THREE.MeshStandardMaterial({
    map: plaqueTexture(label, ""),
    roughness: 0.4, metalness: 0.5,
    side: THREE.DoubleSide
  });
  const m = new THREE.Mesh(UNIT.plane, mat);
  m.position.set(x, y, z);
  m.rotation.x = -Math.PI / 2.6;
  m.scale.set(0.22, 0.07, 1);
  m.castShadow = false;
  roomGroup.add(m);
}

function corridorSafeZs(d, doors, margin){
  const blocked = (doors || []).map(dr => dr.at * d);
  const zs = [];
  for(let z = 4; z < d - 3; z += 2.8){
    if(blocked.every(bz => Math.abs(bz - z) > margin)) zs.push(z);
  }
  return zs;
}
/* Capitol-style column: plinth base, shaft, simple capital — soft marble, no normals. */
function propColumn(x, z, h, r){
  r = r || 0.30;
  const mat = x30MarbleMat();   /* 20261030ag: grain, mottle and bump */
  const stone = matCol(0xd8d2c4, .82);
  addBox(stone, x, 0.07, z, r*2.5, 0.14, r*2.5, 0, true);
  addCyl(mat, x, 0.22, z, r*1.22, 0.16);
  const shaftH = Math.max(1.2, h - 0.58);
  addCyl(mat, x, 0.30 + shaftH/2, z, r, shaftH);
  addCyl(mat, x, h - 0.26, z, r*1.18, 0.14);
  addBox(stone, x, h - 0.10, z, r*2.4, 0.12, r*2.4, 0, true);
}
/* Walk every corner: plants, flush art, decor sconces, rugs — room-by-room ornate fill.
   No extra PointLights (uses propSconceDecor). Skips door bays. Pictures stay flush (0.006). */
function dressOrnateCorners(id){
  const R = ROOMS[id]; if(!R || R.style === "home") return;   /* a flat has no Capitol mouldings */
  const w = R.w, d = R.d, h = R.h, hw = w/2;
  const inset = 0.62;
  try{
  if(id === "office" || id === "visit"){
    propPlant(-hw+inset, 1.05, 0.78);
    propPlant(hw-inset, d-0.85, 0.80);
    if(!MODEST){
      propPlant(hw-inset, 1.05, 0.78);
      propPlant(-hw+inset, d-0.85, 0.80);
    }
    propRug(0, 1.55, 2.4, 1.35);
    /* Front wall flush pair flanking the door (into-room) */
    propSconceDecor(-hw+0.12, 2.15, 1.35, Math.PI/2);
    propSconceDecor(hw-0.12, 2.15, 1.35, -Math.PI/2);
    propSconceDecor(-hw+0.12, 2.15, d-1.15, Math.PI/2);
    propSconceDecor(hw-0.12, 2.15, d-1.15, -Math.PI/2);
  } else if(id === "corridor"){
    const leftDoors = (DOORS.corridor||[]).filter(dr => dr.side==="left");
    const rightDoors = (DOORS.corridor||[]).filter(dr => dr.side==="right");
    const leftZs = corridorSafeZs(d, leftDoors, 2.45);
    const rightZs = corridorSafeZs(d, rightDoors, 2.45);
    /* Every safe bay: flush art + decor sconce on the side that lacks a live lamp */
    leftZs.forEach((z,i) => {
      if(i % 2 === 1) propSconceDecor(-hw+0.12, 2.55, z, Math.PI/2);
    });
    rightZs.forEach((z,i) => {
      if(i % 2 === 0) propSconceDecor(hw-0.12, 2.55, z, -Math.PI/2);
      if(!MODEST && i % 3 === 1) propPlant(hw-0.70, z, 0.78);
    });
  } else if(id === "cloak"){
    propPlant(-hw+inset, 1.0, 0.95);
    propPlant(hw-inset, 1.0, 0.95);
    propPlant(hw-inset, d-0.9, 1.0);
    propPlant(-hw+inset, d-0.85, 0.9);
    propSconceDecor(-hw+0.12, 2.1, 2.0, Math.PI/2);
    propSconceDecor(-hw+0.12, 2.1, 5.0, Math.PI/2);
    propRug(-0.4, 1.5, 2.0, 1.2);
  } else if(id === "caucus"){
    propSconceDecor(-hw+0.12, 2.7, 1.6, Math.PI/2);
    propSconceDecor(hw-0.12, 2.7, 1.6, -Math.PI/2);
    propSconceDecor(-hw+0.12, 2.7, d-1.8, Math.PI/2);
    propSconceDecor(hw-0.12, 2.7, d-1.8, -Math.PI/2);
    propRug(0, 2.4, 4.0, 2.2);
  } else if(id === "committee"){
    /* Gallery back corners + well corners + dais flanks */
    propPlant(-hw+inset, 1.3, 1.1);
    propPlant(hw-inset, d-1.1, 1.15);
    if(!MODEST){
      propPlant(hw-inset, 1.3, 1.1);
      propPlant(-hw+inset, d-1.1, 1.15);
      propPlant(-2.6, 4.2, 0.72);
      propPlant(2.6, 4.2, 0.72);
    }
    propSconceDecor(-hw+0.12, 2.6, 2.2, Math.PI/2);
    propSconceDecor(hw-0.12, 2.6, 2.2, -Math.PI/2);
    propSconceDecor(-hw+0.12, 2.8, d-2.0, Math.PI/2);
    propSconceDecor(hw-0.12, 2.8, d-2.0, -Math.PI/2);
  } else if(id === "floor"){
    /* Corners only — never on a pew, never in the well */
    propPlant(-hw+0.62, 1.05, 0.72);
    propPlant( hw-0.62, 1.05, 0.72);
    propPlant(-hw+0.62, d-0.62, 0.72);
    propPlant( hw-0.62, d-0.62, 0.72);
    propSconceDecor(-hw+0.12, 3.4, d-2.0, Math.PI/2);
    propSconceDecor(hw-0.12, 3.4, d-2.0, -Math.PI/2);
    propSconceDecor(-hw+0.12, 3.4, 2.6, Math.PI/2);
    propSconceDecor(hw-0.12, 3.4, 2.6, -Math.PI/2);
    propRug(0, 3.2, 4.5, 2.4); /* near entry aisle */
  } else if(id === "press"){
    propPlant(-hw+inset, 1.1, 0.95);
    propPlant(hw-inset, 1.1, 0.95);
    propPlant(-hw+inset, d-0.9, 1.0);
    propPlant(hw-inset, d-0.9, 1.0);
    propSconceDecor(-hw+0.12, 2.1, 1.5, Math.PI/2);
    propSconceDecor(hw-0.12, 2.1, 1.5, -Math.PI/2);
    propSconceDecor(hw-0.12, 2.1, 5.5, -Math.PI/2);
    propSconceDecor(-hw+0.12, 2.1, 7.2, Math.PI/2);
    propRug(0, 1.6, 2.6, 1.4);
  } else if(id === "steps"){
    /* none — plaza planting lives in the room dress, once */
  } else if(id === "district"){
    propPlant(-hw+1.05, 2.15, 1.10);
    propPlant(hw-1.05, 2.15, 1.10);
    propPlant(-5.4, 6.0, 1.05);
    propPlant(5.4, 5.4, 1.00);
    addBox(matCol(0x6b5a45,.7), -hw+1.3, 0.08, 3.4, 1.5,0.16,0.48, 0, true);
    addBox(matCol(0x6b5a45,.7), hw-1.3, 0.08, 3.5, 1.5,0.16,0.48, 0, true);
  }
  }catch(e){ if(window.console) console.warn("dressOrnateCorners "+id, e); }
}
/* Unique Cannon-suite décor for whoever owns the office — player or visit. */
function decorateOfficeFor(person){
  if(!person) return;
  const R = ROOMS[G.room] || ROOMS.office;
  const w = R.w, d = R.d, h = R.h, hw = w/2;
  const tr = person.traits || {};
  const party = person.party || "IND";
  const accent = partyColorNum(party);
  const accentMat = matCol(accent, .55, .22);
  const softAccent = matCol(accent, .75, .08);
  const vanity = tr.vanity|0, ambition = tr.ambition|0, disc = tr.discretion|0, temper = tr.temper|0;
  const creed = person.creed ? creedOf(person.creed) : null;
  const suite = person.suite || "";
  const sub = (partyLabel(party) + (suite ? " · " + suite : "")).slice(0, 42);
  /* The room identity plaque already carries this person's name at the
     entry; do not add a second, nearly coincident name tag here. */
  /* Party colour accents: desk blotter + thin wall rail */
  addBox(accentMat, 0.25, DIM.desk + 0.008, Math.min(8.28, d - 1.5), 0.50, 0.012, 0.38, 0, true);
  addBox(softAccent, 0, 1.32, d - 0.04, w * 0.42, 0.035, 0.03, 0, true);
  { const sh = matCol(0x5a3b24, .6), br = matCol(0x3a2a1a, .5), zc = d * 0.68; addBox(sh, -hw + 0.13, 1.62, zc, 0.22, 0.035, 1.0, 0, true);
    [-0.38, 0.38].forEach(o => { addBox(br, -hw + 0.03, 1.53, zc + o, 0.04, 0.16, 0.03, 0, true); addBox(br, -hw + 0.1, 1.585, zc + o, 0.16, 0.03, 0.03, 0, true); });
    const cols = [accent, 0x2a3a55, 0x5a3038, 0x3a4a3a, 0x6a5a3a, accent, 0x1d2b44, 0x7a2f2a]; let z = zc - 0.46;
    for(let i = 0; i < 18 && z < zc + 0.36; i++){ const tw = 0.035 + ((i * 7) % 4) * 0.01, th = 0.2 + ((i * 5) % 5) * 0.018; addBox(matCol(cols[i % cols.length], .8), -hw + 0.13, 1.6375 + th / 2, z + tw / 2, 0.17, th, tw, 0, true); z += tw + 0.004; }
    addBox(matCol(0xb08b45, .35, .7), -hw + 0.13, 1.72, zc + 0.44, 0.12, 0.16, 0.03, 0, true); }
  /* Vanity: portraits / awards on the wall; low vanity → plants instead */
  if(vanity > 62){
    /* Side wall only — back wall already has the generic flush pair */
    propFrame("x", -hw + 0.001, 2.05, d * 0.48, 0.70, 0.88, TEX.portrait || artPool()[1] || TEX.paintB, Math.PI/2);
    if(vanity > 78) propFrame("x", hw - 0.001, 1.95, d * 0.55, 0.70, 0.55, artPool()[4] || TEX.paintC, -Math.PI/2);
    addBox(matCol(0xb08b45, .35, .7), 0.55, DIM.desk + 0.05, Math.min(8.05, d - 1.5), 0.16, 0.10, 0.12, 0, true);
  } else {
    propPlant(-hw + 0.85, d - 1.4, 1.05);
    if(vanity < 35) propPlant(hw - 0.85, 3.4, 0.95);
  }
  /* Ambition: extra flag, stacked briefing binders, gavel-shaped paperweight */
  if(ambition > 58){
    /* no second national flag — placeRoomFlags owns the pair */
    for(let i=0;i<3;i++)
      addBox(matCol([0x2a3a55,0x5a3038,0x3a4a3a][i], .85), -0.80, DIM.desk + 0.02 + i*0.045, Math.min(8.36, d-1.3), 0.22, 0.04, 0.26, 0.08*i, true);
    if(ambition > 75)
      propPlaque(-1.5, 1.75, d - 0.02, 0, "Ambition", creed ? creed.adj : "Member", 0.70, 0.20);
  }
  /* Discretion: tidy desk, closed folio; low discretion → more open paper */
  if(disc > 65){
    addBox(matCol(0x3a2e22, .6), 0.25, DIM.desk + 0.05, Math.min(8.28, d-1.5), 0.30, 0.04, 0.22, 0, true);
  } else {
    propPapers(0.25, DIM.desk + 0.045, Math.min(8.28, d-1.5), disc < 40 ? 7 : 4);
  }
  /* Temper: askew chair / scattered pages when high */
  if(temper > 68){
    propChair(matTex(TEX.oak,1,1,.6), matTex(TEX.leather,1,1,.85), 1.45, Math.min(6.55, d-2.4), -0.35);
    propPapers(0.10, DIM.desk + 0.004, Math.min(7.90, d-1.8), 5);
  }
  /* Creed / background flavour on a flush side plaque */
  if(creed){
    propPlaque(-hw + 0.035, 2.15, Math.min(8.2, d - 1.5), Math.PI/2, creed.t, (person.bg || "").replace(/^a /,"") || creed.adj, 0.78, 0.22);
  }
  /* Quiz-coloured clutter: hardline answers → more conviction shelves */
  const ans = person.answers || [];
  if(ans.length >= 4 && (person.loyalTrait|0) > 12){
    propShelf(hw - 0.35, 7.8 > d-1.2 ? d*0.72 : 7.8, -Math.PI/2, 0.95, 1.7);
  }
}

let _buildingRoom = false;
let _roomBuiltId = null;
let _roomFurnished = false;
const ROOM_KITS = Object.create(null);
let ROOM_KIT_IDS = [];
let _warmBusy = false;
function kitHops(from, to){
  if(!from || !to) return 99;
  if(from === to) return 0;
  const seen = Object.create(null);
  const q = [from];
  seen[from] = 0;
  while(q.length){
    const cur = q.shift();
    const d = seen[cur];
    if(d >= 2) continue;
    const doors = DOORS[cur] || [];
    for(let i=0;i<doors.length;i++){
      const n = doors[i].to;
      if(seen[n] !== undefined) continue;
      seen[n] = d + 1;
      if(n === to) return d + 1;
      q.push(n);
    }
  }
  return 99;
}
function stashLiveRoom(){
  const id = _roomBuiltId;
  if(!id || !roomGroup || roomGroup.children.length < 4) return;
  const kit = ROOM_KITS[id] || new THREE.Group();
  /* 20261011a: a shell-only room stashes as a shell (furnish later), never left behind to double up. */
  kit.userData.shell = true;
  kit.userData.furnished = !!_roomFurnished;
  while(roomGroup.children.length) kit.add(roomGroup.children[0]);
  rgFlagsReset(roomGroup);
  ROOM_KITS[id] = kit;
  try{ relinkRoomRefs(); }catch(e){}
  ROOM_KIT_IDS = ROOM_KIT_IDS.filter(x => x !== id);
  ROOM_KIT_IDS.push(id);
  /* 20261005a max-fit: KEEP kit cap — MODEST 6 / else 8 (was 9). */
  const cap = MODEST ? 6 : 8;
  while(ROOM_KIT_IDS.length > cap){
    const drop = ROOM_KIT_IDS.shift();
    if(drop === id || drop === (G && G.room)) continue;
    /* Prefer keeping corridor kits — first door out is the heavy one. */
    if(drop === "corridor"){ ROOM_KIT_IDS.push(drop); continue; }
    try{ if(kitHops(G.room, drop) <= 2){ ROOM_KIT_IDS.push(drop); continue; } }catch(e){}
    delete ROOM_KITS[drop];
  }
}
function peopleWanted(){
  /* Present in this room and the next door. Not thinking — just bodies.
     Two doors away they wait in the kit, not on the GPU. */
  const out = [];
  const seen = Object.create(null);
  const add = m => {
    if(!m || m.gone || seen[m.id]) return;
    seen[m.id] = 1;
    out.push(m);
  };
  try{ hereNow().forEach(add); }catch(e){}
  const ads = DOORS[G.room] || [];
  for(let i=0;i<ads.length;i++){
    let n = 0;
    const rid = ads[i].to;
    const pool = everyone();
    for(let j=0;j<pool.length && n < 3;j++){
      const m = pool[j];
      if(m && m.room === rid && !m.gone){ add(m); n++; }
    }
  }
  return out;
}
let _warmSkip = 0;
function warmAhead(){
  /* 20260929a stream-drip + 20261001a budget: shell while walking; furnish while standing.
     Bail if this frame already paid >6ms. Reuse furnished kits — never rebuild. One phase. */
  if(_warmSkip > 0){ _warmSkip--; return; }
  if(_buildingRoom || _warmBusy) return;
  if(houseQuiet()) return;
  if(typeof frameOverBudget === "function" && frameOverBudget(6)) return;
  const list = DOORS[G.room] || [];
  if(!list.length) return;
  const moving = (typeof playerMoving === "function") ? playerMoving() : false;
  let best = null, bestScore = 7;
  for(let i=0;i<list.length;i++){
    const dr = list[i];
    if(!ROOMS[dr.to]) continue;
    const p = doorAt(G.room, dr);
    const d = Math.hypot((p.x||0) - cam.x, (p.z||0) - cam.z);
    if(d > 7) continue;
    let score = d;
    /* Prefer corridor kits / corridor-adjacent when distances are close. */
    if(dr.to === "corridor") score -= 0.9;
    else {
      try{
        const neigh = DOORS[dr.to] || [];
        for(let k=0;k<neigh.length;k++){ if(neigh[k].to === "corridor"){ score -= 0.35; break; } }
      }catch(e){}
      if(G.room === "corridor") score -= 0.2;
    }
    if(score < bestScore){ bestScore = score; best = dr; }
  }
  if(!best) return;
  const dest = best.to;
  if(dest === _roomBuiltId) return;
  const have = ROOM_KITS[dest];
  /* Kit pool: furnished dest is done — do not rebuild. Heal missing flags from children. */
  if(have){
    if(have.userData.furnished) return;
    if(!have.userData.shell && have.children && have.children.length >= 4){
      have.userData.shell = true;
    }
    /* 20261011a: no child-count guess for furnished — shells alone carry 80+ children. */
  }
  /* Walking: shell-only. Standing: may furnish. Never both in one call. */
  if(moving && have && have.userData.shell) return;
  _warmBusy = true;
  const hold = roomGroup;
  const holdId = _roomBuiltId;
  const holdF = _roomFurnished;
  const holdL = ROOMLIGHTS.slice(), holdT = TICKERS.slice();
  const t0 = performance.now();
  try{
    const kit = ROOM_KITS[dest] || new THREE.Group();
    roomGroup = kit;
    _warmingKit = true;
    /* the kit counts its own lamps/tickers (they are re-found on take) */
    ROOMLIGHTS.length = 0; TICKERS.length = 0;
    try{ kit.traverse(o => { const u = o.userData; if(u && u._roomLight && o !== kit) ROOMLIGHTS.push(o); }); }catch(e){}
    if(!kit.userData.shell){
      if(typeof frameOverBudget === "function" && frameOverBudget(6)) return;
      buildRoomShell(dest);
      kit.userData.shell = true;
      ROOM_KITS[dest] = kit;
      if(ROOM_KIT_IDS.indexOf(dest) < 0) ROOM_KIT_IDS.push(dest);
    } else if(!kit.userData.furnished && !moving){
      /* Furnish only if this frame can still pay. */
      if(typeof frameOverBudget === "function" && frameOverBudget(6)){ _warmSkip = 12; return; }
      buildRoomInner(dest, true);
      try{ tidyRoomFurniture(); }catch(e){}
      try{ seatPictures(dest); }catch(e){}
      try{ freezeStaticRoom(); }catch(e){}
      kit.userData.furnished = true;
      ROOM_KITS[dest] = kit;
    }
  }catch(e){
    if(window.console) console.warn("warmAhead", dest, e);
  }finally{
    _warmingKit = false;
    roomGroup = hold;
    _roomBuiltId = holdId;
    _roomFurnished = holdF;
    ROOMLIGHTS.length = 0; for(let i=0;i<holdL.length;i++) ROOMLIGHTS.push(holdL[i]);
    TICKERS.length = 0; for(let i=0;i<holdT.length;i++) TICKERS.push(holdT[i]);
    _warmBusy = false;
    const took = performance.now() - t0;
    try{ G._frameSpent = (G._frameSpent || 0) + took; }catch(e){}
    if(took > 6) _warmSkip = 36;
  }
}
function takeRoomKit(id){
  const kit = ROOM_KITS[id];
  if(!kit || !kit.children.length) return false;
  if(!kit.userData.furnished && !kit.userData.shell) return false;
  /* Heal flags from a prior warmAhead / stash. */
  if(!kit.userData.shell && kit.children.length >= 4) kit.userData.shell = true;
  while(kit.children.length) roomGroup.add(kit.children[0]);
  rgFlagsReset(kit);
  _roomBuiltId = id;
  _roomFurnished = !!kit.userData.furnished;
  try{ relinkRoomRefs(); }catch(e){}
  try{ buildSky(ROOMS[id]); }catch(e){}
  /* Reparent undoes matrixAutoUpdate freezes — restore after furnish kits. Sleep never rebuilds. */
  if(_roomFurnished){
    try{ nextFrameOrTimeout(() => { try{ freezeStaticRoom(); }catch(e){} }, 0); }catch(e){}
  }
  return true;
}
function buildRoom(id){
  if(_buildingRoom) return;
  if(!ROOMS[id]) id = "office";
  if(_roomBuiltId === id && _roomFurnished && roomGroup && roomGroup.children.length >= 5) return;
  if(_roomBuiltId && _roomBuiltId !== id) stashLiveRoom();
  if(takeRoomKit(id)) return;
  _buildingRoom = true;
  try{
    try{
      const reuse = (_roomBuiltId === id && roomGroup && roomGroup.children.length >= 2);
      if(!reuse){
        clearRoom();
        buildRoomInner(id, false);
      } else {
        buildRoomInner(id, true);
      }
      tidyRoomFurniture();
      try{ seatPictures(id); }catch(e){}
      if(!roomGroup || roomGroup.children.length < 5)
        throw new Error("room shell too empty");
      _roomBuiltId = id;
      _roomFurnished = true;
    }catch(e){
      if(window.console) console.warn("buildRoom", id, e);
      try{ clearRoom(); buildRoomShell(id); _roomBuiltId = id; _roomFurnished = false; }catch(e2){
        if(window.console) console.warn("buildRoomShell", e2);
      }
      try{ feed("The chamber flickered."); }catch(e3){}
    }
  }finally{
    _buildingRoom = false;
    try{ if(!MODEST && renderer.shadowMap) renderer.shadowMap.needsUpdate = true; }catch(e){}
    try{ nextFrameOrTimeout(() => { try{ freezeStaticRoom(); }catch(e){} }, 0); }catch(e){}
  }
}
function buildRoomShell(id){
  if(!ROOMS[id]) id = "office";
  const R = ROOMS[id], w = R.w, d = R.d, h = R.h, hw = w/2;
  const wallMat  = R.style==="stone" ? matTex(TEX.stone, w/3, h/3, .95, 0x928774)
                 : R.style==="town"  ? matTex(TEX.stone, 4, 2, .95)
                 : R.style==="chamber" ? matTex(TEX.damask, w/3.2, h/3.2, .93)
                 : R.style==="wood"  ? matTex(TEX.damask, w/3.4, h/3.4, .93)
                 : matTex(TEX.plaster, w/3, h/3, .95, R.style==="marble" ? 0xcfc5b3 : R.style==="home" ? 0xe6d6b8 : undefined);
  const floorMat = R.style==="plain" ? matTex(TEX.lino, w/2.2, d/2.2, .55)
                 : R.style==="chamber" ? matTex(TEX.carpet, w/1.6, d/1.6, .98)
                 : R.style==="marble"  ? matTex(TEX.marble, w/2.4, d/2.4, .48)
                 : R.style==="stone"   ? matTex(TEX.stone, w/2.5, d/2.5, .95, 0x8e8371)
                 : R.style==="town"    ? matTex(TEX.grass, w/3, d/3, 1)
                 : matTex(TEX.oak, w/2.2, d/2.2, .55);
  [wallMat, floorMat].forEach(m => { m.side = THREE.DoubleSide; });
  if(floorMat.polygonOffset === undefined || !floorMat.polygonOffset){
    floorMat.polygonOffset = true; floorMat.polygonOffsetFactor = 1; floorMat.polygonOffsetUnits = 1;
  }
  addPlane(floorMat, 0, 0, d/2, w + 0.08, d + 0.08, -Math.PI/2); /* y=0 — furniture feet plant here */
  if(!R.open){ const ceil = R.plainCeil ? matCol(0xf3eee4, .95) : matTex(TEX.coffer, Math.max(1,w/3.6), Math.max(1,d/3.6), .95);
    ceil.side = THREE.DoubleSide; addPlane(ceil, 0, h - 0.004, d/2, w + 0.06, d + 0.06, Math.PI/2); }
  /* Keep the four shell planes on distinct contact lines.  The old corner
     overlap created doubled wall edges and z-fighting when viewed obliquely. */
  const wallOut = 0.004, wallSpan = 0.012;
  if(!R.open){
    addPlane(wallMat, 0, h/2, d + wallOut, w + wallSpan, h);                 /* back  */
    addPlane(wallMat, 0, h/2, -wallOut, w + wallSpan, h, 0, Math.PI);       /* front */
    addPlane(wallMat, -hw - wallOut, h/2, d/2, d + wallSpan, h, 0, Math.PI/2); /* left */
    addPlane(wallMat, hw + wallOut, h/2, d/2, d + wallSpan, h, 0, -Math.PI/2); /* right */
  } else {
    try{ buildSky(R); }catch(e){}
  }
  /* basic skirt always; full linings when not on the cheap preset */
  {
    const wood2 = R.style==="wood" || R.style==="chamber";
    const stony = R.style==="marble" || R.style==="stone" || R.style==="town";
    const runs = [
      {x:0,   z:d-0.001, len:w, ax:"x"},
      {x:0,   z:0.001,   len:w, ax:"x"},
      {x:-hw+0.001, z:d/2, len:d, ax:"z"},
      {x: hw-0.001, z:d/2, len:d, ax:"z"}
    ];
    /* Continuous runs: lengths reach into corner pilasters so joints are covered.
       Depths are staggered (never a second coplanar strip on the same face). */
    /* 20261030ag: look. Skirting, dado and chair rails ran straight through every door: a rail stood
       proud across the leaf and met the jambs in a sawtooth (the "jagged Exec Wing door"). Each run now
       stops at the jambs of any door on its wall, below the head of the door. Trim meshes only. */
    const bandGaps = r2 => {
      const side = r2.ax === "x" ? (r2.z > d/2 ? "back" : "front") : (r2.x > 0 ? "right" : "left");
      const out = [];
      try{ (DOORS[id] || []).forEach(dr => { if(dr.side !== side) return; const p = doorAt(id, dr); out.push(r2.ax === "x" ? p.x : p.z); }); }catch(e){}
      return out.sort((a, b) => a - b);
    };
    const band = (mat, y, thick, depth, grow) => runs.forEach(r2 => {
      const len = r2.len + (grow || 0);
      const c0 = r2.ax === "x" ? r2.x : r2.z, a0 = c0 - len/2, a1 = c0 + len/2;
      const gaps = (y - thick/2 < 2.47) ? bandGaps(r2) : [];
      const segs = []; let from = a0;
      const half = 1.25/2 + 0.09 + 0.012;
      gaps.forEach(g => { if(g - half > from) segs.push([from, g - half]); from = Math.max(from, g + half); });
      if(from < a1) segs.push([from, a1]);
      segs.forEach(sg => {
        const L = sg[1] - sg[0], mid = (sg[0] + sg[1]) / 2; if(L < 0.02) return;
        if(r2.ax === "x") addBox(mat, mid, y, r2.z + (r2.z > d/2 ? -depth/2 : depth/2), L, thick, depth, 0, true);
        else               addBox(mat, r2.x + (r2.x > 0 ? -depth/2 : depth/2), y, mid, depth, thick, L, 0, true);
      });
    });
    const skirtMat = wood2 ? matTex(TEX.oak, 4, 0.35, .52)
                   : stony ? matCol(0xbdb6a6, .82)
                           : matCol(0xe4e0d6, .88);
    /* Baseboard + shoe — skip outdoors: no walls to sit against. */
    if(!R.open){
      band(skirtMat, 0.09, 0.18, 0.050, 0.08);
      band(skirtMat, 0.188, 0.020, 0.064, 0.08);
    }
    const cheap = (G.gfx === "simple");
    if(!cheap && !R.open){
      if(wood2){
        /* Wainscot ≤5cm proud — gapped at every door so the leaf is not
           sitting on the dado (House cloak door, corridor offices). */
        const wain  = matTex(TEX.panel, Math.max(1, w/2.2), 1, .50);
        const wain2 = matTex(TEX.panel, Math.max(1, d/2.2), 1, .50);
        const doorClear = 0.80;
        const holesOn = side => (DOORS[id] || []).filter(dr => dr.side === side);
        const segsAlongD = side => {
          const holes = holesOn(side).map(dr => dr.at * d).sort((a,b)=>a-b);
          const out = []; let from = 0.14, end = d - 0.14;
          holes.forEach(z => { if(z - doorClear > from) out.push([from, z - doorClear]); from = Math.max(from, z + doorClear); });
          if(from < end) out.push([from, end]);
          return out;
        };
        const segsAlongW = side => {
          const holes = holesOn(side).map(dr => (dr.at - 0.5) * w * 0.8).sort((a,b)=>a-b);
          const out = []; let from = -w/2 + 0.14, end = w/2 - 0.14;
          holes.forEach(x => { if(x - doorClear > from) out.push([from, x - doorClear]); from = Math.max(from, x + doorClear); });
          if(from < end) out.push([from, end]);
          return out;
        };
        segsAlongW("back").forEach(s => {
          const len = s[1] - s[0]; if(len < 0.3) return;
          addBox(wain, (s[0]+s[1])/2, 0.72, d-0.030, len, 1.16, 0.046, 0, true);
        });
        segsAlongW("front").forEach(s => {
          const len = s[1] - s[0]; if(len < 0.3) return;
          addBox(wain, (s[0]+s[1])/2, 0.72, 0.030, len, 1.16, 0.046, 0, true);
        });
        segsAlongD("left").forEach(s => {
          const len = s[1] - s[0]; if(len < 0.3) return;
          addBox(wain2, -hw+0.030, 0.72, (s[0]+s[1])/2, 0.046, 1.16, len, 0, true);
        });
        segsAlongD("right").forEach(s => {
          const len = s[1] - s[0]; if(len < 0.3) return;
          addBox(wain2, hw-0.030, 0.72, (s[0]+s[1])/2, 0.046, 1.16, len, 0, true);
        });
        const stile = matCol(0x5a4024, .52);
        const nSt = Math.max(3, Math.round(w / 1.55));
        for(let i=0;i<nSt;i++){
          const xx = -w/2 + 0.5 + i * ((w - 1.0) / Math.max(1, nSt-1));
          if(holesOn("back").some(dr => Math.abs((dr.at-0.5)*w*0.8 - xx) < 0.85)) continue;
          addBox(stile, xx, 0.72, d-0.042, 0.055, 1.10, 0.018, 0, true);
          if(holesOn("front").some(dr => Math.abs((dr.at-0.5)*w*0.8 - xx) < 0.85)) continue;
          addBox(stile, xx, 0.72, 0.042, 0.055, 1.10, 0.018, 0, true);
        }
        band(matCol(0x4c371f, .48), 1.335, 0.055, 0.072, 0.08);  /* chair rail → corners */
        band(matCol(0x6b4d2c, .52), h*0.70, 0.038, 0.048, 0.08); /* picture rail body */
        band(matCol(0xb08b45, .38, .82), h*0.70 + 0.028, 0.010, 0.038, 0.08); /* gilt cap */
        band(matCol(0x5a4024, .50), h*0.70 + 0.048, 0.016, 0.032, 0.08);
      } else if(stony){
        band(matCol(0xc6bfae, .78), 1.05, 0.10, 0.056, 0.08);
        band(matCol(0xb8b1a0, .80), 1.125, 0.028, 0.042, 0.08);  /* string — stepped */
        band(matCol(0xd2ccbc, .82), h*0.68, 0.042, 0.042, 0.08);
        band(matCol(0xcfc8b8, .84), h*0.68 + 0.042, 0.018, 0.030, 0.08);
      } else {
        /* Painted plaster — matte, not plastic-flat; rails meet corner posts */
        band(matCol(0xdcd8cd, .90), 0.95, 0.055, 0.042, 0.08);
        band(matCol(0xd2cec2, .92), 1.005, 0.018, 0.032, 0.08);
        band(matCol(0xe4e0d6, .90), h*0.72, 0.032, 0.040, 0.08);
      }
      if(!R.open){
        const cor = wood2 ? matCol(0xd6d1c2, .88) : stony ? matCol(0xcfc9b9, .86) : matCol(0xeae6dc, .90);
        /* Cornice: three stepped profiles, increasing depth toward ceiling */
        band(cor, h-0.09, 0.16, 0.150, 0.08);
        band(cor, h-0.195, 0.045, 0.095, 0.08);
        band(cor, h-0.255, 0.028, 0.055, 0.08);
      }
      /* All four corners: pilasters + rail miters (wood, marble, plaster, chamber) */
      if(!R.open){
        try{ propCornerPilasters(w, d, h, hw, R.style); }catch(e){ if(window.console) console.warn("cornerPilasters", e); }
      }
    } else if(!R.open){
      /* Cheap gfx still gets corner posts so joinery does not vanish */
      try{ propCornerPilasters(w, d, h, hw, R.style); }catch(e){}
    }
    /* Open rooms (steps / district): low corner plinths — plaza joinery, no indoor cornice */
    if(R.open){
      const stone = matCol(0xc3bfb4, .85);
      [[-hw+0.55, 0.55], [hw-0.55, 0.55], [-hw+0.55, d-0.55], [hw-0.55, d-0.55]].forEach(c => {
        addBox(stone, c[0], 0.12, c[1], 0.85, 0.24, 0.85, 0, true);
        addBox(stone, c[0], 0.32, c[1], 0.62, 0.16, 0.62, 0, true);
      });
    }
  }
  try{ positionLights(id); }catch(e){ if(window.console) console.warn("positionLights", e); }
}
function buildRoomInner(id, skipShell){
  SHELF_SPANS = [];
  const R = ROOMS[id], w = R.w, d = R.d, h = R.h, hw = w/2;
  if(!skipShell) buildRoomShell(id);
  const woodMat  = matTex(TEX.oak, 1.5, 1.5, .6);
  const trimMat  = matTex(TEX.oak, 3, 0.6, .5);
  const brass    = matCol(0xb08b45, .32, .86);
  const leather  = matTex(TEX.leather, 1, 1, .85);
  const paperMat = matCol(0xe8e4d8, .95);

  /* per-room fittings */
  if(id === "office" || id === "visit"){
    try{
    propDesk(woodMat, woodMat, 0, 8.15, 2.05, 0.95);              /* member desk, back of suite */
    propChair(woodMat, leather, 0, Math.min(9.05, d - 0.45), Math.PI);
    /* Shelves and cabinet share the same grounded prop recipes as every room. */
    propCabinet(matCol(0x2a2f36,.7), matCol(0x3a4048,.6), hw-0.55, 5.6, 0.55, 1.04, 0.62);
    /* the sofa: a seat, a back, two arms and four feet (moved here from the cloakroom: PROPS.office sofa) */
    {
      const sx = -2.35, sz = 5.4;
      addBox(leather, sx, 0.22, sz, 0.86, 0.44, 1.90, 0, true);
      addBox(leather, sx-0.36, 0.48, sz, 0.16, 0.96, 1.90, 0, true);
      addBox(leather, sx+0.02, 0.40, sz-0.88, 0.80, 0.36, 0.18, 0, true);
      addBox(leather, sx+0.02, 0.40, sz+0.88, 0.80, 0.36, 0.18, 0, true);
      [[-0.34,-0.80],[0.30,-0.80],[-0.34,0.80],[0.30,0.80]].forEach(f =>
        addBox(woodMat, sx+f[0], 0.05, sz+f[1], 0.08, 0.10, 0.08, 0, true));
      try{ const cu = matCol(0x7a2e33, .9); rgR(addBox(cu, sx-0.22, 0.63, sz-0.5, 0.1, 0.32, 0.38, 0, true), "z", 0.18); rgR(addBox(matCol(0x2a3a55, .9), sx-0.22, 0.62, sz+0.5, 0.1, 0.3, 0.36, 0, true), "z", 0.18); }catch(e){}
    }
    /* flags via placeRoomFlags (national+NO7; Taylor Day: NO7 only) */
    addCyl(brass, 0.45, DIM.desk + 0.07, 7.86, 0.05, 0.14);
  
    }catch(e){ if(window.console) console.warn("room office", e); }
  }
  if(id === "corridor"){
    try{
    /* Columns only in midspans — never in front of a door opening. */
    const leftDoors = (DOORS.corridor||[]).filter(dr => dr.side==="left");
    const rightDoors = (DOORS.corridor||[]).filter(dr => dr.side==="right");
    const leftZs = corridorSafeZs(d, leftDoors, 2.45);
    const rightZs = corridorSafeZs(d, rightDoors, 2.45);
    leftZs.forEach(z => propColumn(-hw+0.72, z, h*0.92, 0.28));
    rightZs.forEach(z => propColumn(hw-0.72, z, h*0.92, 0.28));
    /* Statues on left midspans — clear of left-wall door openings; plinth under figure. */
    const statueZs = leftZs.slice();
    statueZs.forEach((z, i) => {
      addBox(matCol(0xb0aa9a,.88), -hw+1.55, 0.12, z, 0.62,0.24,0.62, 0, true); /* plinth */
      addBox(matCol(0xb9b4a6,.9), -hw+1.55, 1.05, z, 0.42,1.45,0.42, 0);
      addBox(matCol(0xa8a294,.85), -hw+1.55, 2.05, z, 0.30,0.55,0.30, 0);
    });
    addBox(matCol(0x8d8577,.8), 0,h-0.25,d-0.1, w*0.5,0.5,0.1, 0, true);
  
    }catch(e){ if(window.console) console.warn("room corridor", e); }
  }
  if(id === "cloak"){
    try{
    addBox(woodMat, -hw+0.5,1.2,d/2, 0.7,2.4,d-1.2);
    for(let i=0;i<7;i++) addBox(matCol(pick([0x2b2f38,0x3a3a3c,0x4a4238]),.9), -hw+1.0,1.35,1.4+i*0.85, 0.12,1.0,0.5);
    addBox(leather, hw-1.2, 0.215, 3.2, 1.4, 0.43, 0.7);     /* long sofa / ottoman, on the floor */
    addBox(leather, hw-1.2, 0.215, 5.4, 1.4, 0.43, 0.7);
    addCyl(brass, 0,h-0.5,d/2, 0.05,1.0);
  
    }catch(e){ if(window.console) console.warn("room cloak", e); }
  }
  if(id === "caucus"){
    try{
    for(let r=0;r<3;r++) for(let c2=0;c2<6;c2++){
      propDesk(woodMat, woodMat, -4.4+c2*1.75, 4.0+r*2.2, 1.36, 0.60);
      propChair(woodMat, leather, -4.4+c2*1.75, 3.15+r*2.2, 0);   /* in front of the desk, facing the lectern like the people who sit in them */
    }
    propLectern(woodMat, brass, 0, d-2.2);
    /* flags via placeRoomFlags (1 national + 1 NO7; Taylor Day: NO7 only) */
  
    }catch(e){ if(window.console) console.warn("room caucus", e); }
  }
  if(id === "committee"){
    try{
    /* Room 2141, door→back: public gallery, witness well, open aisle, raised dais.
       propChair face=0 looks +z; face=Math.PI looks −z (dais toward witnesses). */
    try{
      /* 4. Raised dais at the back — Chair is index 3 (center) */
      addBox(woodMat, 0, DIM.daisFloor/2, d-3.0, 8.4, DIM.daisFloor, 2.4, 0, true);
      addBox(woodMat, 0, DIM.daisFloor + DIM.dais - 0.05, d-3.6, 8.0, 0.10, 0.85);
      addBox(woodMat, 0, DIM.daisFloor + (DIM.dais-0.1)/2, d-3.25, 8.0, DIM.dais-0.1, 0.09, 0, true);
      for(let i=0;i<7;i++)
        propChair(woodMat, leather, -3.3+i*1.1, d-2.55, Math.PI, DIM.daisFloor);
      /* 1. Public gallery — two rows, center aisle kept clear so the door works */
      const galMat = matCol(0x4a4038,.75), galSeat = matCol(0x6b5b4a,.85);
      for(let r=0;r<2;r++) for(let c2=0;c2<7;c2++){
        if(c2 === 3) continue; /* aisle on x=0, door to corridor */
        propChair(galMat, galSeat, -3.3+c2*1.1, 2.45+r*0.95, 0);
      }
      addBox(matCol(0x6b4d2c,.5), 0, 0.98, 4.45, 8.0, 0.07, 0.09, 0, true);      /* gallery rail */
      for(let i=0;i<7;i++) if(i !== 3) addCyl(matCol(0x6b4d2c,.5), -3.3+i*1.1, 0.49, 4.45, 0.03, 0.98);
    }catch(e){ if(window.console) console.warn("committee seating", e); }
    try{
      /* 2. Witness table in the well — three seats facing the dais (+z / face 0) */
      propDesk(woodMat, woodMat, 0, 5.15, 3.4, 1.00);
      for(let i=0;i<3;i++){
        const x = -1.05 + i*1.05;
        propChair(woodMat, leather, x, 4.40, 0);
        addCyl(matCol(0x23262c,.45,.6), x, DIM.desk+0.02, 5.02, 0.055, 0.02);
        const stem = addCyl(matCol(0x2b2f36,.4,.7), x, DIM.desk+0.13, 5.05, 0.010, 0.22);
        stem.rotation.x = 0.28;
        addSphere(matCol(0x1a1d22,.55), x, DIM.desk+0.245, 5.14, 0.028, 0.036, 0.028);
        addBox(paperMat, x, DIM.desk+0.012, 5.20, 0.28, 0.012, 0.36, 0, true);
        try{ propPlaque(x, DIM.desk+0.04, 5.55, 0, "Witness", "Under oath", 0.42, 0.10); }catch(e2){}
      }
      addCyl(matCol(0xdfe6ea,.18,.1), 1.35, DIM.desk+0.09, 5.05, 0.055, 0.18);   /* jug */
      addCyl(matCol(0xdfe6ea,.18,.1), 1.05, DIM.desk+0.05, 4.98, 0.032, 0.10);   /* glass */
      propPapers(-0.55, DIM.desk+0.02, 5.15, 3);                                 /* briefing binders */
      propPapers(0.55, DIM.desk+0.02, 5.15, 2);
      /* counsel / staff tables flanking the witness table */
      propDesk(woodMat, woodMat, -3.55, 5.15, 1.35, 0.70);
      propChair(woodMat, leather, -3.55, 4.45, 0);
      propPapers(-3.55, DIM.desk+0.02, 5.15, 2);
      propDesk(woodMat, woodMat,  3.55, 5.15, 1.35, 0.70);
      propChair(woodMat, leather,  3.55, 4.45, 0);
      propPapers(3.55, DIM.desk+0.02, 5.15, 2);
      /* 3. Open well between witness and dais — stenographer off to one side */
      propDesk(woodMat, woodMat, -4.35, 7.35, 1.20, 0.65);
      propChair(woodMat, leather, -4.35, 7.95, Math.PI);
      addBox(matCol(0x2a2d33,.55), -4.35, DIM.desk+0.04, 7.20, 0.28, 0.06, 0.22, 0, true); /* stenotype */
      propPapers(-4.10, DIM.desk+0.02, 7.45, 3);
    }catch(e){ if(window.console) console.warn("committee well", e); }
  
    }catch(e){ if(window.console) console.warn("room committee", e); }
  }
  if(id === "floor"){
    try{
    const bench = matTex(TEX.leather, 2,1, .8);
    /* benches face the middle aisle; length 8 centered on z=7.5 */
    for(let s2=0;s2<2;s2++) for(let r=0;r<5;r++){
      const x = (s2 ? 1 : -1) * (2.6 + r*1.38);
      const face = s2 ? -Math.PI/2 : Math.PI/2;
      propBench(bench, woodMat, x, 7.5, 8.0, 0.56, face);
      /* writing ledge: thick top, apron, upright panel toward aisle */
      const lx = x + (s2 ? 0.68 : -0.68);
      if(r < 4) (function plantLedge(){
        const gL = new THREE.Group(); gL.position.set(lx, 0, 7.5); roomGroup.add(gL);
        const putL = (m,px,py,pz,sx,sy,sz) => {
          const e = new THREE.Mesh(UNIT.box, m);
          e.position.set(px,py,pz); e.scale.set(sx,sy,sz);
          e.castShadow = true; e.receiveShadow = true; gL.add(e);
        };
        const H = DIM.benchDesk;
        putL(woodMat, 0, H - 0.04, 0, 0.42, 0.08, 8.0);
        putL(woodMat, 0, H - 0.12, 0, 0.38, 0.06, 8.0);
        putL(woodMat, 0, H * 0.5, 0, 0.07, H - 0.04, 8.0); /* kick panel to the floor */
        for(let k=-3;k<=3;k++){
          putL(woodMat, 0, H * 0.38, k * 1.14, 0.08, H * 0.76, 0.08); /* legs */
        }
        putL(woodMat, 0, H - 0.04, -3.95, 0.42, 0.07, 0.10);
        putL(woodMat, 0, H - 0.04,  3.95, 0.42, 0.07, 0.10);
        groundGroup(gL, 0.8);
      })();
    }
    /* the rostrum: a step up, and a desk you can be seen over */
    addBox(woodMat, 0, 0.18, d-2.6, 4.6, 0.36, 1.9, 0, true);
    addBox(woodMat, 0, 0.36 + (DIM.dais-0.08)/2, d-2.6, 4.2, DIM.dais-0.08, 1.3);
    addBox(woodMat, 0, 0.36 + DIM.dais, d-2.6, 4.6, 0.09, 1.5, 0, true);
    addBox(brass, 0, 0.36 + DIM.dais + 0.09, d-2.6, 0.9, 0.07, 0.18, 0, true);
    /* back banner via placeRoomFlags */
    /* Speaker chair on the raised platform, facing the chamber (−z) */
    propChair(woodMat, leather, 0, d-2.35, Math.PI, 0.36);
    /* clerk / reading desk in the well below the rostrum, facing the chamber */
    propDesk(woodMat, woodMat, 0, d-4.55, 2.85, 1.15);
    addBox(brass, 0, DIM.desk + 0.01, d-4.55 + 0.52, 1.1, 0.025, 0.04, 0, true); /* front rail */
    /* floor-manager / well lectern in the aisle, offset, facing the Speaker */
    propLectern(woodMat, brass, 0.55, 9.15, 0);
  
    }catch(e){ if(window.console) console.warn("room floor", e); }
  }
  if(id === "press"){
    try{
    for(let r=0;r<3;r++) for(let c2=0;c2<3;c2++){
      propDesk(matCol(0x5a3b24,.62), matCol(0x3b2716,.7), -2.2+c2*2.2  /* 20261030p: walnut, was grey slabs */, 3.0+r*2.0, 1.55, 0.62);
      propChair(matCol(0x2a2d33,.7), matCol(0x33373f,.8), -2.2+c2*2.2, 2.2+r*2.0, 0);   /* facing the front, desk ahead of them */
      addBox(matCol(0x1b1d22,.4,.3), -2.2+c2*2.2, DIM.desk + 0.14, 3.2+r*2.0, 0.42,0.26,0.03, 0, true);
    }
    addBox(matCol(0x8f9298,.8), 0, 2.15, d-0.04, 5.2, 0.95, 0.04, 0, true);
  
    }catch(e){ if(window.console) console.warn("room press", e); }
  }
  if(id === "steps"){
    try{
    /* 20261012a: sandstone, not paper. The sun was turning this wall white. */
    const stone = matTex(TEX.stone, 3, 1, .92, 0x857967);
    const ashlar = matCol(0x7a6f5c, .86);
    const gilt = matCol(0xb08b45, .36, .84);
    const wall = matCol(0x6c6150, .90);
    const deckY = 1.62;
    const facadeZ = d - 0.42;
    addBox(wall, 0, deckY + 3.35, facadeZ + 0.35, w * 0.96, 6.7, 1.55, 0, true);
    /* the landing begins where the last tread ends: it began 0.7 m further on, which left a gap at the top step */
    { const zF = 5.05 + 9 * 0.58 + 0.29 - 0.03, zB = facadeZ + 0.575; addBox(stone, 0, deckY * 0.5, (zF + zB) / 2, w * 0.92, deckY, zB - zF, 0, true); }
    const treads = 10, rise = deckY / treads, run = 0.58;
    for(let i = 0; i < treads; i++){
      const yTop = (i + 1) * rise;
      const zc = 5.05 + i * run;
      addBox(stone, 0, yTop - 0.045, zc, w * 0.54, 0.09, run + 0.04, 0, true);
      addBox(ashlar, 0, yTop - rise * 0.5, zc - run * 0.48, w * 0.54, rise, 0.07, 0, true);
