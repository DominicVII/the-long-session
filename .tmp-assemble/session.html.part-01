     the front doorway). In a doorway, outside the walls or nowhere at all: give them a proper place, at once. */
  try{ if(p._seenIn !== p.room){ p._seenIn = p.room; if(p !== G.you && !p.kStand && !p._sxBrought && !p.sitting && p.seatX == null && p.seatIdx == null && ROOMS[p.room]){   /* a seated or seat-holding member keeps the seat */ const b = roomBox(p.room);
      const open = !!ROOMS[p.room].open, bad = !isFinite(p.x) || !isFinite(p.z) || (!open && (Math.abs(p.x) > b.hw - 0.2 || p.z < b.d0 + 0.2 || p.z > b.d1 - 0.2)) || !!doorZone(p.room, p.x, p.z);   /* the street and the steps run past their nominal box */
      if(bad){ placeInRoom(p); p.sitting = false; if(p.mesh){ p.mesh.position.x = p.x; p.mesh.position.z = p.z; } } } } }catch(e){}
