    M(PG.sph, lens, headG, -eyeX3, hu*0.498, hu*0.455, hu*0.072, hu*0.058, hu*0.040, false);
    M(PG.sph, lens, headG,  eyeX3, hu*0.498, hu*0.455, hu*0.072, hu*0.058, hu*0.040, false);
  }
