/* ── time belongs to whoever has it: anyone may be busy, may refuse, or may charge for it, and so may you ── */
const TIME_WHY = {
  work:["I have the till until six.", "The clerks are waiting on me; ten minutes is ten minutes they stand there.", "I am in the middle of something I cannot leave."],
  guarded:["My time is my own, and I have already given it away today.", "I do not hand out my afternoons.", "Not now. I decide what I do with my hours."],
  sore:["After the way it went last time? Not today.", "I have not forgotten what you did. Another day.", "I would rather not, and I would rather you did not ask twice."],
  tired:["I have had no sleep to speak of. Come back when I am a person.", "I am done in. Tomorrow.", "Give me an hour and ask again."],
  principle:["I will talk to you when I have something to say, and not before.", "My time is not for sale, and I do not give it away to be polite."]
};
function timeStance(g, asker, mins){
  mins = mins || 10; const key = "d" + G.day + "h" + Math.floor((G.minute || 0) / 90) + ":" + (asker === G.you ? "y" : asker.id);
  if(g._tm && g._tm.k === key) return g._tm.r;
  const W = purseWill(g), t = purseTr(g), rel = asker === G.you ? ((g.rel && g.rel.warmth) || 0) : 0, h = Math.floor((G.minute || 0) / 60);
  const rr = rng(seedOf("tm:" + (g.id != null ? g.id : g.name) + key)), ro = rr();
  let r = {mode:"free"};
  const working = g.kind === "civ" && h >= 9 && h < 17, tired = (g === G.you ? G.you.energy : 60) < 25;
  const pr = clamp(W.guarded / 170 + (rel < -10 ? 0.25 : 0) - (rel > 20 ? 0.3 : 0) - (asker === G.you ? ((G.you.standing || 50) - 50) / 400 : 0) + (working ? 0.18 : 0) + (tired ? 0.3 : 0), 0, 0.7);
  if(ro < pr){
    const principled = (t.conviction || 50) > 76 && ro < pr * 0.5;
    const cause = tired ? "tired" : rel < -10 ? "sore" : working ? "work" : principled ? "principle" : "guarded";
    const bank = TIME_WHY[cause], why = bank[Math.floor(rr() * bank.length)];
    const wage = (typeof purseSalary === "function" ? purseSalary(g) : 30), fee = Math.max(3, Math.round((8 + wage / 4) * mins / 30));
    const trader = g.kind === "civ" && W.guarded >= 40, payable = trader && !principled && cause !== "sore";
    r = {mode:payable ? "fee" : "refuse", why, fee, principled, cause};
  }
  g._tm = {k:key, r}; return r;
}
function timeAfter(m, how, st){
  const y = G.you, P = purseOf(y);
  if(how === "pay"){ if(P.cash < st.fee) return false; P.cash -= st.fee; purseOf(m).cash += st.fee; purseLog(y, "Paid " + m.name + " for their time", -st.fee); purseChip(); }
  if(how === "insist"){ try{ if(m.rel) ripple(m, -3, "They would not take no for an answer about my time.", 3, false); }catch(e){} }
  m._timeOk = true; m._tm = null; walkNow(); setTimeout(() => { try{ G.running = true; openTalk(m); }catch(e){ console.warn(e); } }, 60); return true;
}
function timeCard(m, st){
  const y = G.you, P = purseOf(y), insistOk = chance(0.55);
  const ans = st.mode === "fee" ? "Ten minutes of my time is ten minutes of not earning. It is ƒ " + st.fee + "." : st.why;
  const body = '<p style="margin:6px 0">“' + pcEsc(st.why) + (st.mode === "fee" ? " " + pcEsc(ans) : "") + '”</p><div class="muted" style="font-size:12px">Their time is theirs. ' + pcEsc(m.name) + ' is allowed to say no, and to put a price on it.</div>' +
    '<div class="card__actions" style="flex-wrap:wrap">' +
      (st.mode === "fee" ? '<button type="button" class="btn" id="tmPay"' + (P.cash < st.fee ? ' disabled' : '') + '>Pay ƒ ' + st.fee + ' for ten minutes</button>' : (!st.principled ? '<button type="button" class="btn btn--ghost" id="tmOffer"' + (P.cash < 8 ? ' disabled' : '') + '>Offer ƒ 8 for ten minutes</button>' : '')) +
      '<button type="button" class="btn btn--ghost" id="tmInsist">Insist</button><button type="button" class="btn btn--ghost" id="tmLeave">Leave them to it</button></div><div class="dream" id="tmSay"></div>';
  govCardOpen("Their time", m.name, "", body, null);
  const done = () => card.querySelectorAll("button").forEach(b => { if(b.id !== "gcClose") b.disabled = true; });
  const say = t => { el("tmSay").textContent = t; done(); };
  const pay = el("tmPay"); if(pay) pay.addEventListener("click", () => timeAfter(m, "pay", st));
  const off = el("tmOffer"); if(off) off.addEventListener("click", () => { if(chance(0.65)){ st.fee = 8; timeAfter(m, "pay", st); } else say(m.name + ": “Keep your money. It is not about the money.”"); });
  el("tmInsist").addEventListener("click", () => { if(insistOk) timeAfter(m, "insist", st); else { try{ if(m.rel) ripple(m, -4, "I said no and they pushed, and I said no again.", 4, true); }catch(e){} say(m.name + " turns away. You pushed, and it cost you."); } });
  el("tmLeave").addEventListener("click", () => { walkNow(); });
  return null;
