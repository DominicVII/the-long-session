  card.querySelectorAll("[data-saw]").forEach(b => b.addEventListener("click", () => { const [i, o] = b.getAttribute("data-saw").split(":"), a = saw[0] && (y.saw || [])[+i]; if(!a) return; const actor = byId(a.actor) || (G.civ || []).find(c => c.id === a.actor); if(!actor) return;
    const out = purseDoOpt(y, actor, o, Object.assign({key:a.key}, PURSE_ITEMS[a.key] || {t:a.item, price:20, show:1}), a.r); el("pcSay").textContent = out; y.saw.splice(+i, 1); purseChip(); }));
