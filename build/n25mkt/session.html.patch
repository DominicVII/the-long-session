+    const rel = Number((E.rels && E.rels[fx.powerKey]) || 0);
+    const isFoe = E.worldFoe === fx.powerKey;
+    let risk = 1 - rel / 420 + (isFoe ? (E.worldHeat / 450) : 0);
+    const drivers = [];
+    if(E.g >= 115) drivers.push("Strong guilder lowers foreign cost");
+    else if(E.g <= 92) drivers.push("Weak guilder lifts foreign FX");
+    if(isFoe){ drivers.push("Active rival tension (" + Math.round(E.worldHeat) + ")"); }
+    if(rel <= -15) drivers.push("Cool trade ties (" + Math.round(rel) + ")");
+    else if(rel >= 15) drivers.push("Warm trade ties (+" + Math.round(rel) + ")");
+    if(fx.powerKey === "horn" && E.worldWar === "strait"){ risk += 0.08; drivers.push("Strait closure premium"); }
+    if(fx.powerKey === "reach" && (E.worldWar === "grain" || E.ration)){ risk += 0.07; drivers.push("Border grain hold"); }
