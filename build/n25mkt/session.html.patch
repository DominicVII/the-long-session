+    const rateInGuilders = Math.max(0.25, Math.round(fx.baseRate * (100 / Math.max(40, E.g)) * risk * 1000) / 1000);
+    const index = Math.round((rateInGuilders / fx.baseRate) * 1000) / 10;
+    const prev = M.fxPrev[fx.code] != null ? M.fxPrev[fx.code] : rateInGuilders;
+    const delta = Math.round((rateInGuilders - prev) * 1000) / 1000;
+    M.fxPrev[fx.code] = rateInGuilders;
+    if(!drivers.length) drivers.push("Steady par clearing");
+    return {
+      code:fx.code,
+      name:fx.name,
+      powerKey:fx.powerKey,
+      powerName:pw ? pw.t : fx.powerKey,
+      rateInGuilders,
+      index,
+      delta,
+      relation:Math.round(rel),
+      isFoe,
+      driver:drivers[0],
+      drivers
+    };
+  });
+  return out;
